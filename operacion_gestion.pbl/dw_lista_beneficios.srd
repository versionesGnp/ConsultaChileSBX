 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"beneficios_complementario~" )  TABLE(NAME=~"beneficios_complementario_det~" ) COLUMN(NAME=~"beneficios_complementario.codigo~") COLUMN(NAME=~"beneficios_complementario.descripcion~") COLUMN(NAME=~"beneficios_complementario.estado~") COLUMN(NAME=~"beneficios_complementario_det.codigo_beneficio~") COLUMN(NAME=~"beneficios_complementario_det.descripcion~")    JOIN (LEFT=~"beneficios_complementario.codigo~"    OP =~"=~"RIGHT=~"beneficios_complementario_det.codigo~" )WHERE(    EXP1 =~"~~~"BENEFICIOS_COMPLEMENTARIO~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~":codigo~" ) ) ARG(NAME = ~"codigo~" TYPE = number) " arguments=(("codigo", number))  sort="beneficios_complementario_codigo A beneficios_complementario_det_codigo_beneficio A " )
