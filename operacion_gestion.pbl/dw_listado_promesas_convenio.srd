 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cadena~" )  TABLE(NAME=~"cliente~" )  TABLE(NAME=~"oferta_v~" )  TABLE(NAME=~"pago_oferta~" )  TABLE(NAME=~"convenio_retiro~" )  TABLE(NAME=~"cod_parq~" )  TABLE(NAME=~"cadena_mora~" )  TABLE(NAME=~"supervisor~" ) COLUMN(NAME=~"oferta_v.cod_convenio~") COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"cadena.serie~") COLUMN(NAME=~"cadena.numero~") COLUMN(NAME=~"oferta_v.fecha~") COLUMN(NAME=~"cod_parq.nombre~") COLUMN(NAME=~"cliente.rut~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"oferta_v.cta_pag_s~") COLUMN(NAME=~"cadena_mora.mora_cred~") COLUMN(NAME=~"oferta_v.cta_pag_m~") COLUMN(NAME=~"cadena_mora.mora_mant~") COLUMN(NAME=~"pago_oferta.nro_cuotas~") COLUMN(NAME=~"convenio_retiro.glosa~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"oferta_v.cod_age~") COLUMN(NAME=~"oferta_v.cod_sup~") COLUMN(NAME=~"supervisor.cod_jefe~")    JOIN (LEFT=~"cadena.rut~"    OP =~"=~"RIGHT=~"cliente.rut~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"oferta_v.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"oferta_v.nro_oferta~" )    JOIN (LEFT=~"oferta_v.serie~"    OP =~"=~"RIGHT=~"pago_oferta.serie~" )    JOIN (LEFT=~"oferta_v.nro_oferta~"    OP =~"=~"RIGHT=~"pago_oferta.nro_oferta~" )    JOIN (LEFT=~"oferta_v.ult_folio~"    OP =~"=~"RIGHT=~"pago_oferta.folio~" )    JOIN (LEFT=~"oferta_v.cod_convenio~"    OP =~"=~"RIGHT=~"convenio_retiro.cod_convenio~" )    JOIN (LEFT=~"cadena.cod_parque~"    OP =~"=~"RIGHT=~"cod_parq.codigo~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"cadena_mora.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"cadena_mora.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"cadena_mora.numero~" )    JOIN (LEFT=~"oferta_v.cod_sup~"    OP =~"=~"RIGHT=~"supervisor.cod_sup~" )WHERE(    EXP1 =~"~~~"OFERTA_V~~~".~~~"BENEFICIO_COMPLEMENTARIO~~~"~"   OP =~"=~"    EXP2 =~"'6'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"OFERTA_V~~~".~~~"COD_CONVENIO~~~"~"   OP =~"=~"    EXP2 =~":cod_convenio~" ) ) ARG(NAME = ~"cod_convenio~" TYPE = number) " arguments=(("cod_convenio", number)) )
