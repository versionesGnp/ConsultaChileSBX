 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"encargados~" ) COLUMN(NAME=~"encargados.nombre~") COLUMN(NAME=~"encargados.depto~") COLUMN(NAME=~"encargados.vacuna_primera_dosis~") COLUMN(NAME=~"encargados.vacuna_primera_fecha~") COLUMN(NAME=~"encargados.vacuna_segunda_dosis~") COLUMN(NAME=~"encargados.vacuna_segunda_fecha~") COLUMN(NAME=~"encargados.contagio_covid~") COLUMN(NAME=~"encargados.contagio_fecha~") COLUMN(NAME=~"encargados.rut~") COLUMN(NAME=~"encargados.cod_parque_ubicacion~")WHERE(    EXP1 =~"~~~"ENCARGADOS~~~".~~~"CONTAGIO_COVID~~~"~"   OP =~"<>~"    EXP2 =~"0~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"ENCARGADOS~~~".~~~"VACUNA_PRIMERA_FECHA~~~"~"   OP =~"is not~"    EXP2 =~"null~" ) ) "  sort="nombre A " )
