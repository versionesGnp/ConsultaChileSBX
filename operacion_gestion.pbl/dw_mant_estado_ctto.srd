 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cadena~" ) COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"cadena.serie~") COLUMN(NAME=~"cadena.numero~") COLUMN(NAME=~"cadena.estado~")WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~":ls_base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":ls_serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":ll_numero~" ) ) ARG(NAME = ~"ls_base~" TYPE = string)  ARG(NAME = ~"ls_serie~" TYPE = string)  ARG(NAME = ~"ll_numero~" TYPE = number) " arguments=(("ls_base", string),("ls_serie", string),("ll_numero", number)) )
