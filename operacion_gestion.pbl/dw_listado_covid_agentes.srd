table(column=(type=char(20) updatewhereclause=yes name=nombre dbname="agentes.nombre" )
 column=(type=char(50) updatewhereclause=yes name=a_paterno dbname="agentes.a_paterno" )
 column=(type=char(50) updatewhereclause=yes name=a_materno dbname="agentes.a_materno" )
 column=(type=char(5) updatewhereclause=yes name=cod_sup dbname="agentes.cod_sup" )
 column=(type=decimal(4) updatewhereclause=yes name=vacuna_primera_dosis dbname="agentes.vacuna_primera_dosis" values="NO	0/SI	1/" )
 column=(type=datetime updatewhereclause=yes name=vacuna_primera_fecha dbname="agentes.vacuna_primera_fecha" )
 column=(type=decimal(4) updatewhereclause=yes name=vacuna_segunda_dosis dbname="agentes.vacuna_segunda_dosis" values="NO	0/SI	1/" )
 column=(type=datetime updatewhereclause=yes name=vacuna_segunda_fecha dbname="agentes.vacuna_segunda_fecha" )
 column=(type=decimal(4) updatewhereclause=yes name=contagio_covid dbname="agentes.contagio_covid" )
 column=(type=datetime updatewhereclause=yes name=contagio_fecha dbname="agentes.contagio_fecha" )
 column=(type=decimal(0) updatewhereclause=yes name=rut dbname="agentes.rut" )
 column=(type=decimal(4) updatewhereclause=yes name=cod_parque dbname="agentes.cod_parque" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"agentes~" ) COLUMN(NAME=~"agentes.nombre~") COLUMN(NAME=~"agentes.a_paterno~") COLUMN(NAME=~"agentes.a_materno~") COLUMN(NAME=~"agentes.cod_sup~") COLUMN(NAME=~"agentes.vacuna_primera_dosis~") COLUMN(NAME=~"agentes.vacuna_primera_fecha~") COLUMN(NAME=~"agentes.vacuna_segunda_dosis~") COLUMN(NAME=~"agentes.vacuna_segunda_fecha~") COLUMN(NAME=~"agentes.contagio_covid~") COLUMN(NAME=~"agentes.contagio_fecha~") COLUMN(NAME=~"agentes.rut~") COLUMN(NAME=~"agentes.cod_parque~")WHERE(    EXP1 =~"~~~"AGENTES~~~".~~~"CONTAGIO_COVID~~~"~"   OP =~"<>~"    EXP2 =~"0~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"AGENTES~~~".~~~"VACUNA_PRIMERA_FECHA~~~"~"   OP =~"is not~"    EXP2 =~"null~" ) ) "  sort="nombre A a_paterno A a_materno A " )
