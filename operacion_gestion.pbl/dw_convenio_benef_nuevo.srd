 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"convenio_retiro~" ) COLUMN(NAME=~"convenio_retiro.cod_convenio~") COLUMN(NAME=~"convenio_retiro.glosa~") COLUMN(NAME=~"convenio_retiro.moneda~") COLUMN(NAME=~"convenio_retiro.valor~") COLUMN(NAME=~"convenio_retiro.direccion~") COLUMN(NAME=~"convenio_retiro.fono~") COLUMN(NAME=~"convenio_retiro.notas~") COLUMN(NAME=~"convenio_retiro.vigencia_descripcion~") COLUMN(NAME=~"convenio_retiro.vigencia_codigo~") COLUMN(NAME=~"convenio_retiro.contacto~") COLUMN(NAME=~"convenio_retiro.estado~") COLUMN(NAME=~"convenio_retiro.rut_empresa~") COLUMN(NAME=~"convenio_retiro.dv_empresa~") COLUMN(NAME=~"convenio_retiro.rut_contacto~") COLUMN(NAME=~"convenio_retiro.dv_contacto~") COLUMN(NAME=~"convenio_retiro.email_contacto~") COLUMN(NAME=~"convenio_retiro.fecha_ctto~") COLUMN(NAME=~"convenio_retiro.cod_nivel~") COLUMN(NAME=~"convenio_retiro.empresas_anexas~") COMPUTE(NAME=~"'N' as c_estado~") COLUMN(NAME=~"convenio_retiro.vigencia_convenio~") COLUMN(NAME=~"convenio_retiro.cod_agente~") COLUMN(NAME=~"convenio_retiro.cod_sup~")WHERE(    EXP1 =~"~~~"CONVENIO_RETIRO~~~".~~~"COD_CONVENIO~~~"~"   OP =~"=~"    EXP2 =~":cod_convenio~" ) ) ARG(NAME = ~"cod_convenio~" TYPE = number) " update="CONVENIO_RETIRO" updatewhere=0 updatekeyinplace=yes arguments=(("cod_convenio", number)) )
