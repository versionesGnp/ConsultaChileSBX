table(column=(type=char(5) update=yes updatewhereclause=yes key=yes name=cod_sup dbname="supervisor.cod_sup" dbalias=".cod_sup" )
 column=(type=char(5) update=yes updatewhereclause=yes name=cod_jefe dbname="supervisor.cod_jefe" dbalias=".cod_jefe" )
 column=(type=char(20) update=yes updatewhereclause=yes name=nombre dbname="supervisor.nombre" dbalias=".nombre" )
 column=(type=char(50) updatewhereclause=yes name=a_paterno dbname="supervisor.a_paterno" dbalias=".a_paterno" )
 column=(type=char(50) updatewhereclause=yes name=a_materno dbname="supervisor.a_materno" dbalias=".a_materno" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"supervisor~" ) COLUMN(NAME=~"supervisor.cod_sup~") COLUMN(NAME=~"supervisor.cod_jefe~") COLUMN(NAME=~"supervisor.nombre~") COLUMN(NAME=~"supervisor.a_paterno~") COLUMN(NAME=~"supervisor.a_materno~")WHERE(    EXP1 =~"(~~~"SUPERVISOR~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'A'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"SUPERVISOR~~~".~~~"COD_SUP~~~"~"   OP =~"not like~"    EXP2 =~"'U%'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"SUPERVISOR~~~".~~~"CANAL~~~"~"   OP =~"=~"    EXP2 =~"'NF')~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"(~~~"SUPERVISOR~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'A'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"SUPERVISOR~~~".~~~"COD_SUP~~~"~"   OP =~"not like~"    EXP2 =~"'U%'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"SUPERVISOR~~~".~~~"CANAL~~~"~"   OP =~"=~"    EXP2 =~"'UG')~" ) ) " update="SUPERVISOR" updatewhere=1 updatekeyinplace=no  sort="a_paterno A " )
