 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"beneficios_complementario~" )  TABLE(NAME=~"beneficios_complementario_det~" ) COLUMN(NAME=~"beneficios_complementario.codigo~") COLUMN(NAME=~"beneficios_complementario.descripcion~") COLUMN(NAME=~"beneficios_complementario_det.codigo_beneficio~") COLUMN(NAME=~"beneficios_complementario_det.descripcion~") COMPUTE(NAME=~"0 as estado_reg~")    JOIN (LEFT=~"beneficios_complementario.codigo~"    OP =~"=~"RIGHT=~"beneficios_complementario_det.codigo~" )WHERE(    EXP1 =~"~~~"BENEFICIOS_COMPLEMENTARIO_DET~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~":ll_codigo~" ) ) ARG(NAME = ~"ll_codigo~" TYPE = number) " arguments=(("ll_codigo", number))  sort="beneficios_complementario_codigo A beneficios_complementario_det_codigo_beneficio A " )
