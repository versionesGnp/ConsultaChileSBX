table(column=(type=char(20) updatewhereclause=yes name=nombre dbname="agentes.nombre" )
 column=(type=char(50) updatewhereclause=yes name=a_paterno dbname="agentes.a_paterno" )
 column=(type=char(50) updatewhereclause=yes name=a_materno dbname="agentes.a_materno" )
 column=(type=char(5) updatewhereclause=yes name=cod_sup dbname="agentes.cod_sup" )
 column=(type=decimal(0) updatewhereclause=yes name=rut dbname="agentes.rut" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=vacuna_primera_dosis dbname="agentes.vacuna_primera_dosis" values="NO	0/SI	1/" )
 column=(type=datetime update=yes updatewhereclause=yes name=vacuna_primera_fecha dbname="agentes.vacuna_primera_fecha" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=vacuna_segunda_dosis dbname="agentes.vacuna_segunda_dosis" values="NO	0/SI	1/" )
 column=(type=datetime update=yes updatewhereclause=yes name=vacuna_segunda_fecha dbname="agentes.vacuna_segunda_fecha" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=contagio_covid dbname="agentes.contagio_covid" )
 column=(type=datetime update=yes updatewhereclause=yes name=contagio_fecha dbname="agentes.contagio_fecha" )
 column=(type=char(20) updatewhereclause=yes name=supervisor_nombre dbname="supervisor.nombre" )
 column=(type=char(50) updatewhereclause=yes name=supervisor_a_paterno dbname="supervisor.a_paterno" )
 column=(type=char(50) updatewhereclause=yes name=supervisor_a_materno dbname="supervisor.a_materno" )
 column=(type=char(5) updatewhereclause=yes key=yes name=agentes_cod_age dbname="agentes.cod_age" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=agentes_cod_parque dbname="agentes.cod_parque" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"agentes~" )  TABLE(NAME=~"supervisor~" ) COLUMN(NAME=~"agentes.nombre~") COLUMN(NAME=~"agentes.a_paterno~") COLUMN(NAME=~"agentes.a_materno~") COLUMN(NAME=~"agentes.cod_sup~") COLUMN(NAME=~"agentes.rut~") COLUMN(NAME=~"agentes.vacuna_primera_dosis~") COLUMN(NAME=~"agentes.vacuna_primera_fecha~") COLUMN(NAME=~"agentes.vacuna_segunda_dosis~") COLUMN(NAME=~"agentes.vacuna_segunda_fecha~") COLUMN(NAME=~"agentes.contagio_covid~") COLUMN(NAME=~"agentes.contagio_fecha~") COLUMN(NAME=~"supervisor.nombre~") COLUMN(NAME=~"supervisor.a_paterno~") COLUMN(NAME=~"supervisor.a_materno~") COLUMN(NAME=~"agentes.cod_age~") COLUMN(NAME=~"agentes.cod_parque~")    JOIN (LEFT=~"agentes.cod_sup~"    OP =~"=~"RIGHT=~"supervisor.cod_sup~" )WHERE(    EXP1 =~"~~~"AGENTES~~~".~~~"RUT~~~"~"   OP =~"=~"    EXP2 =~":ll_rut~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"AGENTES~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'A'~" ) ) ARG(NAME = ~"ll_rut~" TYPE = number) " update="AGENTES" updatewhere=0 updatekeyinplace=yes arguments=(("ll_rut", number)) )
