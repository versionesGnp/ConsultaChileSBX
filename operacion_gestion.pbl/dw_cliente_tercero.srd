 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cliente_terceros~" ) COLUMN(NAME=~"cliente_terceros.base~") COLUMN(NAME=~"cliente_terceros.serie~") COLUMN(NAME=~"cliente_terceros.numero~") COLUMN(NAME=~"cliente_terceros.rut_titular~") COLUMN(NAME=~"cliente_terceros.dv_titular~") COLUMN(NAME=~"cliente_terceros.rut_tercero~") COLUMN(NAME=~"cliente_terceros.dv_rut~") COLUMN(NAME=~"cliente_terceros.nombres_tercero~") COLUMN(NAME=~"cliente_terceros.apellido_p_tercero~") COLUMN(NAME=~"cliente_terceros.apellido_m_tercero~") COLUMN(NAME=~"cliente_terceros.tipo_via~") COLUMN(NAME=~"cliente_terceros.direccion~") COLUMN(NAME=~"cliente_terceros.numero_particular~") COLUMN(NAME=~"cliente_terceros.block_particular~") COLUMN(NAME=~"cliente_terceros.poblacion~") COLUMN(NAME=~"cliente_terceros.sector~") COLUMN(NAME=~"cliente_terceros.comuna~") COLUMN(NAME=~"cliente_terceros.ciudad~") COLUMN(NAME=~"cliente_terceros.fono_particular~") COLUMN(NAME=~"cliente_terceros.celular~") COLUMN(NAME=~"cliente_terceros.observacion~") COLUMN(NAME=~"cliente_terceros.parentesco~") COLUMN(NAME=~"cliente_terceros.email~") COLUMN(NAME=~"cliente_terceros.correlativo_ingreso~") COLUMN(NAME=~"cliente_terceros.depto_tercero~") COMPUTE(NAME=~"'' c_cliente~")WHERE(    EXP1 =~"~~~"CLIENTE_TERCEROS~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":ls_base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CLIENTE_TERCEROS~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":ls_serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CLIENTE_TERCEROS~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":ll_numero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CLIENTE_TERCEROS~~~".~~~"CORRELATIVO_INGRESO~~~"~"   OP =~"=~"    EXP2 =~":ll_corr~" ) ) ARG(NAME = ~"ls_base~" TYPE = string)  ARG(NAME = ~"ls_serie~" TYPE = string)  ARG(NAME = ~"ll_numero~" TYPE = number)  ARG(NAME = ~"ll_corr~" TYPE = number) " update="CLIENTE_TERCEROS" updatewhere=0 updatekeyinplace=yes arguments=(("ls_base", string),("ls_serie", string),("ll_numero", number),("ll_corr", number)) )
