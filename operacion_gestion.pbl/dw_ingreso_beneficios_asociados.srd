 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"tipo_promocion_asociados~" )  TABLE(NAME=~"beneficios_complementario_det~" ) COLUMN(NAME=~"tipo_promocion_asociados.correlativo~") COLUMN(NAME=~"tipo_promocion_asociados.cod_beneficio~") COLUMN(NAME=~"tipo_promocion_asociados.cod_benef_detalle~") COLUMN(NAME=~"tipo_promocion_asociados.estado~") COLUMN(NAME=~"tipo_promocion_asociados.fecha_creacion~") COLUMN(NAME=~"tipo_promocion_asociados.base~") COLUMN(NAME=~"tipo_promocion_asociados.serie~") COLUMN(NAME=~"tipo_promocion_asociados.numero~") COLUMN(NAME=~"tipo_promocion_asociados.fecha_uso~") COLUMN(NAME=~"tipo_promocion_asociados.tipo_cob~") COLUMN(NAME=~"tipo_promocion_asociados.folio~") COLUMN(NAME=~"tipo_promocion_asociados.cod_caja~") COLUMN(NAME=~"tipo_promocion_asociados.usuario~") COLUMN(NAME=~"beneficios_complementario_det.descripcion~") COLUMN(NAME=~"tipo_promocion_asociados.pie_pactado~") COLUMN(NAME=~"tipo_promocion_asociados.cod_convenio~")    JOIN (LEFT=~"tipo_promocion_asociados.cod_beneficio~"    OP =~"=~"RIGHT=~"beneficios_complementario_det.codigo~" )    JOIN (LEFT=~"tipo_promocion_asociados.cod_benef_detalle~"    OP =~"=~"RIGHT=~"beneficios_complementario_det.codigo_beneficio~" )WHERE(    EXP1 =~"~~~"TIPO_PROMOCION_ASOCIADOS~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":as_base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"TIPO_PROMOCION_ASOCIADOS~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":as_serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"TIPO_PROMOCION_ASOCIADOS~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":al_numero~" ) ) ARG(NAME = ~"as_base~" TYPE = string)  ARG(NAME = ~"as_serie~" TYPE = string)  ARG(NAME = ~"al_numero~" TYPE = number) " update="TIPO_PROMOCION_ASOCIADOS" updatewhere=0 updatekeyinplace=yes arguments=(("as_base", string),("as_serie", string),("al_numero", number))  sort="cod_beneficio A cod_benef_detalle A " )
