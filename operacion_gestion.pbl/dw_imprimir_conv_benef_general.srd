 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"convenio_retiro~" )  TABLE(NAME=~"convenio_retiro_det~" )  TABLE(NAME=~"beneficios_complementario~" ) COLUMN(NAME=~"convenio_retiro.cod_convenio~") COLUMN(NAME=~"convenio_retiro.glosa~") COLUMN(NAME=~"convenio_retiro_det.cod_beneficio~") COLUMN(NAME=~"convenio_retiro_det.cod_beneficio_det~") COLUMN(NAME=~"convenio_retiro_det.descripcion~") COLUMN(NAME=~"beneficios_complementario.descripcion~") COLUMN(NAME=~"convenio_retiro.cod_nivel~")    JOIN (LEFT=~"convenio_retiro.cod_convenio~"    OP =~"=~"RIGHT=~"convenio_retiro_det.cod_convenio~" )    JOIN (LEFT=~"convenio_retiro_det.cod_beneficio~"    OP =~"=~"RIGHT=~"beneficios_complementario.codigo~" )) ORDER(NAME=~"convenio_retiro.cod_convenio~" ASC=yes ) "  sort="convenio_retiro_cod_convenio A convenio_retiro_det_cod_beneficio A convenio_retiro_det_cod_beneficio_det A " )
