table(column=(type=char(1) updatewhereclause=yes key=yes name=cadena_codigo dbname="cadena.codigo" )
 column=(type=char(1) updatewhereclause=yes key=yes name=cadena_serie dbname="cadena.serie" )
 column=(type=decimal(4) updatewhereclause=yes key=yes name=cadena_numero dbname="cadena.numero" )
 column=(type=char(1) updatewhereclause=yes name=cadena_estado dbname="cadena.estado" )
 column=(type=char(1) update=yes updatewhereclause=yes name=cadena_estado_titulo dbname="cadena.estado_titulo" )
 column=(type=char(40) updatewhereclause=yes name=cliente_nombre dbname="cliente.nombre" )
 column=(type=char(40) updatewhereclause=yes name=cliente_a_paterno dbname="cliente.a_paterno" )
 column=(type=char(40) updatewhereclause=yes name=cliente_a_materno dbname="cliente.a_materno" )
 column=(type=decimal(4) updatewhereclause=yes name=cadena_cod_parque dbname="cadena.cod_parque" )
 column=(type=char(20) updatewhereclause=yes name=estado_sigla_estado dbname="estado.sigla_estado" )
 column=(type=char(20) updatewhereclause=yes name=cod_parq_nombre dbname="cod_parq.nombre" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cadena~" )  TABLE(NAME=~"cliente~" )  TABLE(NAME=~"estado~" )  TABLE(NAME=~"cod_parq~" ) COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"cadena.serie~") COLUMN(NAME=~"cadena.numero~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"cadena.estado_titulo~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cadena.cod_parque~") COLUMN(NAME=~"estado.sigla_estado~") COLUMN(NAME=~"cod_parq.nombre~")    JOIN (LEFT=~"cadena.rut~"    OP =~"=~"RIGHT=~"cliente.rut~" )    JOIN (LEFT=~"estado.cod_estado~"    OP =~"=~"RIGHT=~"cadena.estado~" )    JOIN (LEFT=~"cadena.cod_parque~"    OP =~"=~"RIGHT=~"cod_parq.codigo~" )WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~":ls_base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":ls_serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":ll_numero~" ) ) ARG(NAME = ~"ls_base~" TYPE = string)  ARG(NAME = ~"ls_serie~" TYPE = string)  ARG(NAME = ~"ll_numero~" TYPE = number) " update="CADENA" updatewhere=1 updatekeyinplace=yes arguments=(("ls_base", string),("ls_serie", string),("ll_numero", number)) )
