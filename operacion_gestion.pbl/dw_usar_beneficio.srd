 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"tipo_promocion_asociados~" ) COLUMN(NAME=~"tipo_promocion_asociados.correlativo~") COLUMN(NAME=~"tipo_promocion_asociados.cod_beneficio~") COLUMN(NAME=~"tipo_promocion_asociados.cod_benef_detalle~") COLUMN(NAME=~"tipo_promocion_asociados.estado~") COLUMN(NAME=~"tipo_promocion_asociados.fecha_creacion~") COLUMN(NAME=~"tipo_promocion_asociados.base~") COLUMN(NAME=~"tipo_promocion_asociados.serie~") COLUMN(NAME=~"tipo_promocion_asociados.numero~") COLUMN(NAME=~"tipo_promocion_asociados.fecha_uso~") COLUMN(NAME=~"tipo_promocion_asociados.tipo_cob~") COLUMN(NAME=~"tipo_promocion_asociados.folio~") COLUMN(NAME=~"tipo_promocion_asociados.cod_caja~") COLUMN(NAME=~"tipo_promocion_asociados.usuario~") COMPUTE(NAME=~"'' as estado_reg~")WHERE(    EXP1 =~"~~~"TIPO_PROMOCION_ASOCIADOS~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":ls_base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"TIPO_PROMOCION_ASOCIADOS~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":ls_serie~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"TIPO_PROMOCION_ASOCIADOS~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":ll_numero~" ) ) ARG(NAME = ~"ls_base~" TYPE = string)  ARG(NAME = ~"ls_serie~" TYPE = string)  ARG(NAME = ~"ll_numero~" TYPE = number) " update="TIPO_PROMOCION_ASOCIADOS" updatewhere=1 updatekeyinplace=no arguments=(("ls_base", string),("ls_serie", string),("ll_numero", number)) )
