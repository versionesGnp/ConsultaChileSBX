 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"convenio_retiro~" )  TABLE(NAME=~"convenio_retiro_det~" )  TABLE(NAME=~"beneficios_complementario~" )  TABLE(NAME=~"convenio_retiro_nivel~" ) COLUMN(NAME=~"convenio_retiro.cod_convenio~") COLUMN(NAME=~"convenio_retiro.glosa~") COLUMN(NAME=~"convenio_retiro_det.cod_beneficio~") COLUMN(NAME=~"convenio_retiro_det.cod_beneficio_det~") COLUMN(NAME=~"convenio_retiro_det.descripcion~") COLUMN(NAME=~"beneficios_complementario.descripcion~") COLUMN(NAME=~"convenio_retiro.cod_nivel~") COLUMN(NAME=~"convenio_retiro_nivel.descripcion~") COLUMN(NAME=~"convenio_retiro.empresas_anexas~")    JOIN (LEFT=~"convenio_retiro.cod_convenio~"    OP =~"=~"RIGHT=~"convenio_retiro_det.cod_convenio~" )    JOIN (LEFT=~"convenio_retiro_det.cod_beneficio~"    OP =~"=~"RIGHT=~"beneficios_complementario.codigo~" )    JOIN (LEFT=~"convenio_retiro.cod_nivel~"    OP =~"=~"RIGHT=~"convenio_retiro_nivel.cod_nivel~" )WHERE(    EXP1 =~"~~~"CONVENIO_RETIRO~~~".~~~"COD_CONVENIO~~~"~"   OP =~"=~"    EXP2 =~":ll_cod_convenio~" ) ) ARG(NAME = ~"ll_cod_convenio~" TYPE = number) " arguments=(("ll_cod_convenio", number))  sort="convenio_retiro_det_cod_beneficio_det A " )
