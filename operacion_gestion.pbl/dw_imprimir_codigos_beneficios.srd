table(column=(type=decimal(4) updatewhereclause=yes name=convenio_retiro_cod_convenio dbname="convenio_retiro.cod_convenio" dbalias=".cod_convenio" )
 column=(type=char(1000) updatewhereclause=yes name=convenio_retiro_glosa dbname="convenio_retiro.glosa" dbalias=".glosa" )
