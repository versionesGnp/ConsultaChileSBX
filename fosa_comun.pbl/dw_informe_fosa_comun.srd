 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"fosa_comun~" ) COLUMN(NAME=~"fosa_comun.cod_parque~") COLUMN(NAME=~"fosa_comun.area~") COLUMN(NAME=~"fosa_comun.sector~") COLUMN(NAME=~"fosa_comun.sepultura~") COLUMN(NAME=~"fosa_comun.base_origen~") COLUMN(NAME=~"fosa_comun.serie_origen~") COLUMN(NAME=~"fosa_comun.numero_origen~") COLUMN(NAME=~"fosa_comun.llave_fallecido~") COLUMN(NAME=~"fosa_comun.nombre_fallecido~") COLUMN(NAME=~"fosa_comun.ap_paterno_fallecido~") COLUMN(NAME=~"fosa_comun.ap_materno_fallecido~") COLUMN(NAME=~"fosa_comun.fecha_traslado~") COLUMN(NAME=~"fosa_comun.cod_parque_origen~") COLUMN(NAME=~"fosa_comun.area_origen~") COLUMN(NAME=~"fosa_comun.sector_origen~") COLUMN(NAME=~"fosa_comun.sepultura_origen~") COLUMN(NAME=~"fosa_comun.nro_resolucion~") COLUMN(NAME=~"fosa_comun.fecha_resolucion~") COLUMN(NAME=~"fosa_comun.nro_acta~") COLUMN(NAME=~"fosa_comun.codigo_capataz~") COLUMN(NAME=~"fosa_comun.correlativo~") COLUMN(NAME=~"fosa_comun.niveles~") COLUMN(NAME=~"fosa_comun.base~") COLUMN(NAME=~"fosa_comun.serie~") COLUMN(NAME=~"fosa_comun.numero~") COLUMN(NAME=~"fosa_comun.estado_reg~") COLUMN(NAME=~"fosa_comun.cod_registro~") COLUMN(NAME=~"fosa_comun.observacion~")WHERE(    EXP1 =~"~~~"FOSA_COMUN~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FOSA_COMUN~~~".~~~"AREA~~~"~"   OP =~"=~"    EXP2 =~":area~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FOSA_COMUN~~~".~~~"SECTOR~~~"~"   OP =~"=~"    EXP2 =~":sector~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FOSA_COMUN~~~".~~~"SEPULTURA~~~"~"   OP =~"=~"    EXP2 =~":sepultura~" ) ) ARG(NAME = ~"parque~" TYPE = number)  ARG(NAME = ~"area~" TYPE = string)  ARG(NAME = ~"sector~" TYPE = string)  ARG(NAME = ~"sepultura~" TYPE = string)  ARG(NAME = ~"fecha_hoy~" TYPE = date) " update="FOSA_COMUN" updatewhere=1 updatekeyinplace=no arguments=(("parque", number),("area", string),("sector", string),("sepultura", string),("fecha_hoy", date))  sort="correlativo A niveles A " )
