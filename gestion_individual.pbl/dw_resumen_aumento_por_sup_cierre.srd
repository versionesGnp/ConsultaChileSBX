 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"agentes~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"jefe_ventas~" )  TABLE(NAME=~"supervisor~" )  TABLE(NAME=~"anexo_aumento~" )  TABLE(NAME=~"pago_aumento~" ) COLUMN(NAME=~"agentes.cod_sup~") COLUMN(NAME=~"agentes.cod_age~") COLUMN(NAME=~"agentes.fecha_ini~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"jefe_ventas.jefe_ventas~") COLUMN(NAME=~"jefe_ventas.nombre~") COLUMN(NAME=~"jefe_ventas.a_paterno~") COLUMN(NAME=~"jefe_ventas.a_materno~") COLUMN(NAME=~"agentes.nombre~") COLUMN(NAME=~"agentes.a_paterno~") COLUMN(NAME=~"agentes.a_materno~") COLUMN(NAME=~"supervisor.nombre~") COLUMN(NAME=~"supervisor.a_paterno~") COLUMN(NAME=~"supervisor.a_materno~") COLUMN(NAME=~"agentes.fecha_fin~") COLUMN(NAME=~"agentes.estado~") COLUMN(NAME=~"agentes.clasificacion~") COLUMN(NAME=~"supervisor.fecha_ing~") COLUMN(NAME=~"supervisor.fecha_fin~") COLUMN(NAME=~"supervisor.estado~") COLUMN(NAME=~"supervisor.cod_sup~") COLUMN(NAME=~"supervisor.clasifica~") COLUMN(NAME=~"anexo_aumento.serie_m~") COLUMN(NAME=~"anexo_aumento.nro_aumento~") COLUMN(NAME=~"pago_aumento.fecha~") COLUMN(NAME=~"anexo_aumento.cod_agente~") COLUMN(NAME=~"anexo_aumento.cod_super~") COLUMN(NAME=~"anexo_aumento.tot_pagado~") COLUMN(NAME=~"anexo_aumento.cta_pag_m~") COLUMN(NAME=~"anexo_aumento.estado_comi~") COLUMN(NAME=~"anexo_aumento.fecha_ingreso~") COLUMN(NAME=~"anexo_aumento.fecha_com~") COLUMN(NAME=~"anexo_aumento.porce_age~") COLUMN(NAME=~"anexo_aumento.u_folio~") COLUMN(NAME=~"anexo_aumento.u_fecha~") COLUMN(NAME=~"pago_aumento.precio~") COLUMN(NAME=~"pago_aumento.pie~") COLUMN(NAME=~"pago_aumento.valor_cuota~") COLUMN(NAME=~"pago_aumento.nro_cuotas~") COLUMN(NAME=~"pago_aumento.uf_dia~") COLUMN(NAME=~"pago_aumento.moneda~") COLUMN(NAME=~"pago_aumento.fecha_prim~")    JOIN (LEFT=~"agentes.cod_sup~"    OP =~"=~"RIGHT=~"supervisor.cod_sup~" )    JOIN (LEFT=~"supervisor.cod_jefe~"    OP =~"=~"RIGHT=~"jefe_ventas.jefe_ventas~" )    JOIN (LEFT=~"anexo_aumento.serie_m~"    OP =~"=~"RIGHT=~"pago_aumento.serie_m~" )    JOIN (LEFT=~"anexo_aumento.nro_aumento~"    OP =~"=~"RIGHT=~"pago_aumento.nro_aumento~" )    JOIN (LEFT=~"anexo_aumento.ult_folio~"    OP =~"=~"RIGHT=~"pago_aumento.folio~" )    JOIN (LEFT=~"anexo_aumento.serie_m~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"anexo_aumento.nro_aumento~"    OP =~"=~"RIGHT=~"cadena.numero~" )    JOIN (LEFT=~"anexo_aumento.cod_agente~"    OP =~"=~"RIGHT=~"agentes.cod_age~" )    JOIN (LEFT=~"anexo_aumento.cod_jef~"    OP =~"=~"RIGHT=~"jefe_ventas.jefe_ventas~" )    JOIN (LEFT=~"anexo_aumento.cod_super~"    OP =~"=~"RIGHT=~"supervisor.cod_sup~" )WHERE(    EXP1 =~"((~~~"ANEXO_AUMENTO~~~".~~~"CIERRE_VENTA~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"ANEXO_AUMENTO~~~".~~~"CIERRE_VENTA~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin ))~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'A'  )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"SUPERVISOR~~~".~~~"COD_SUP~~~"~"   OP =~"=~"    EXP2 =~":cod)~" ) ) ORDER(NAME=~"agentes.estado~" ASC=yes ) ARG(NAME = ~"fecha_ini~" TYPE = datetime)  ARG(NAME = ~"fecha_fin~" TYPE = datetime)  ARG(NAME = ~"cod~" TYPE = string)  ARG(NAME = ~"empresa~" TYPE = number) " arguments=(("fecha_ini", datetime),("fecha_fin", datetime),("cod", string),("empresa", number))  sort="supervisor_cod_sup A anexo_aumento_cod_agente A " )
