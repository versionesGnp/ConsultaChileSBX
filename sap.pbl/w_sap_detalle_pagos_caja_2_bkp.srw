public function double wf_valor_servicio (long al_folio, string as_tipo_cob, string as_tipo_mov, string as_cod_otros, datetime adt_fec_pago);double	ldb_monto

//wf_valor_servicio(:al_folio,:as_tipo_cob,:as_tipo_mov,:as_cod_otros,:adt_fec_pago)

DECLARE funcion_servicio PROCEDURE FOR F_SAP_VALOR_SERV(:al_folio,:as_tipo_cob,:as_tipo_mov,:as_cod_otros,:adt_fec_pago);
EXECUTE funcion_servicio;
if sqlca.sqlcode=0 then
	fetch funcion_servicio into :ldb_monto;
	close funcion_servicio;
end if
ldb_monto					= round(ldb_monto,4)
if isnull(ldb_monto) then ldb_monto=0
return ldb_monto
end function

public function double wf_valor_cuota (string as_base, string as_serie, double adb_numero, string as_tipo_mov, string as_tipo_deuda, long al_nro_cuota);double	ldb_valor_cuota

//wf_valor_cuota(ls_base,ls_serie,ll_numero,ls_tipo_mov,ls_tipo_deuda,ll_nro_cuota)

DECLARE funcion_cuota PROCEDURE FOR F_SAP_VALIDA_CTAS_PAG (:as_base,:as_serie,:adb_numero,:as_tipo_mov,:as_tipo_deuda,:al_nro_cuota);
EXECUTE funcion_cuota;
if sqlca.sqlcode=0 then
	fetch funcion_cuota into :ldb_valor_cuota;
	close funcion_cuota;
end if

if isnull(ldb_valor_cuota) then ldb_valor_cuota=0
return	ldb_valor_cuota
end function

public function double wf_valor_pie (long al_tipo, string as_base, string as_serie, double adb_numero, long al_folio, string as_tipo_mov, datetime adt_fec_pago, double adb_monto_uf, long al_posic);double ldb_valor_cuota,ll_tipo

//wf_valor_pie(ls_base,ls_serie,ll_numero,ll_folio,ls_tipo_mov,ldt_fec_pago,ls_moneda,ldb_valor_uf,ll_monto_uf)

DECLARE funcion_valor_pie PROCEDURE FOR F_SAP_MONTO_PIE (:al_tipo,:as_base,:as_serie,:adb_numero,:al_folio,:adt_fec_pago,:adb_monto_uf,:al_posic);

EXECUTE funcion_valor_pie;
if sqlca.sqlcode=0 then
	fetch funcion_valor_pie into :ldb_valor_cuota;
		if isnull(ldb_valor_cuota) or ldb_valor_cuota=0 then
			ldb_valor_cuota		= adb_monto_uf
		end if
	close funcion_valor_pie;
end if

if isnull(ldb_valor_cuota) then ldb_valor_cuota=0
Return ldb_valor_cuota
end function

