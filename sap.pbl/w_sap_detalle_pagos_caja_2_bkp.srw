event clicked;if dw_debe.visible=true then
	dw_debe.visible			= false
	dw_ingreso.visible	= true
	cb_revisar.text				= 'Volver'
else
	dw_debe.visible			= true
	dw_ingreso.visible	= false
	cb_revisar.text				= 'Rev. PAGOS'
end if
end event

type cb_envio from commandbutton within tabpage_1
integer x = 3977
integer y = 1632
integer width = 489
integer height = 112
integer taborder = 210
integer textsize = -8
integer weight = 700
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string text = "Envio Centraliz."
end type

event clicked;long		ll_tot_reg,ll_indi,ll_count,ll_item,ll_estado_sap,ll_pos,ll_tot_filas,ll_indi_det,ll_estado,ll_folio_det,ll_rut_det,ll_nro_envio,ll_count_sap
String		ls_caja,ls_moneda,ls_sociedad,ls_ref_cont1,ls_caja_consulta,ls_tipo_cob_det,ls_caja_det,ls_waers
date		ldt_fecha_pago,MIAR
Datetime	ldt_fecha_det
Double	ll_total_debe,ll_total_haber
long		ret
Inet		iinet_base

if dw_debe.rowcount() > 0 and dw_haber.rowcount() > 0 then
//	if tab_1.tabpage_2.dw_cliente_rezago.rowcount() > 0 then
//		messagebox("Advertencia","Debe Procesar Cliente Rezago - CLIENTE FI")
//	else
		MIAR 						= DATE(EM_1.TEXT)
		ll_pos						= pos(ddplb_caja.text,'-')
		ls_caja_consulta		= trim(mid(ddplb_caja.text,1,(ll_pos - 1)))
		ll_total_debe			= dw_debe.getitemnumber(1,'c_suma_total')
		ll_total_haber			= dw_haber.getitemnumber(1,'c_suma_total')
		if ll_total_debe > 0 and ll_total_haber > 0 and ll_total_debe = ll_total_haber then
			ll_tot_reg				= dw_cabecera.rowcount()
			if ll_tot_reg > 0  then
				ll_indi					= dw_cabecera.getrow()
				ls_moneda			= dw_cabecera.getitemstring(ll_indi,'moneda')
				ls_sociedad			= dw_cabecera.getitemstring(ll_indi,'sociedad')
				ll_item				= dw_cabecera.getitemnumber(ll_indi,'item')
				ls_ref_cont1			= dw_cabecera.getitemstring(ll_indi,'ref_caja_contable1')
				ldt_fecha_pago		= date(dw_cabecera.getitemdatetime(ll_indi,'fecha_pago'))
				ls_caja				= dw_cabecera.getitemstring(ll_indi,'cod_caja')
				ll_estado_sap		= dw_cabecera.getitemnumber(ll_indi,'estado_sap')
				ll_nro_envio			= dw_cabecera.getitemnumber(ll_indi,'nro_envio')
				if ll_estado_sap = 3 then
					UPDATE 	"SAP_CABECERA_PAGOS"  
					SET 		"ESTADO_SAP" = 2  
					WHERE ( "SAP_CABECERA_PAGOS"."FECHA_PAGO" = :ldt_fecha_pago ) AND  
							  ( "SAP_CABECERA_PAGOS"."SOCIEDAD" = :ls_sociedad ) AND  
							  ( "SAP_CABECERA_PAGOS"."MONEDA" = :ls_moneda ) AND  
							  ( "SAP_CABECERA_PAGOS"."REF_CAJA_CONTABLE1" = :ls_ref_cont1 ) AND  
							  ( "SAP_CABECERA_PAGOS"."ESTADO_SAP" = :ll_estado_sap ) AND  
							  ( "SAP_CABECERA_PAGOS"."COD_CAJA" = :ls_caja ) AND  
							  ( "SAP_CABECERA_PAGOS"."ITEM" = :ll_item )  AND 
							  ( "SAP_CABECERA_PAGOS"."NRO_DOC_CONTABLE_SAP" IS NULL ) AND
							  ( "SAP_CABECERA_PAGOS"."NRO_ENVIO" = :ll_nro_envio )
					USING		sqlca;
					if sqlca.sqlcode=0 then
						commit;
						ll_count ++
					else
						rollback;
						messagebox("Advertencia","No Actualizó Estado SAP_CABECERA_PAGOS"+sqlca.sqlerrtext)
					end if
				elseif ll_estado_sap = 4 then
					UPDATE 	"SAP_CABECERA_PAGOS"  
					SET 		"ESTADO_SAP" = 2  
					WHERE ( "SAP_CABECERA_PAGOS"."FECHA_PAGO" = :ldt_fecha_pago ) AND  
							  ( "SAP_CABECERA_PAGOS"."SOCIEDAD" = :ls_sociedad ) AND  
							  ( "SAP_CABECERA_PAGOS"."MONEDA" = :ls_moneda ) AND  
							  ( "SAP_CABECERA_PAGOS"."REF_CAJA_CONTABLE1" = :ls_ref_cont1 ) AND  
							  ( "SAP_CABECERA_PAGOS"."ESTADO_SAP" = :ll_estado_sap ) AND  
							  ( "SAP_CABECERA_PAGOS"."COD_CAJA" = :ls_caja ) AND  
							  ( "SAP_CABECERA_PAGOS"."ITEM" = :ll_item )  AND 
							  ( "SAP_CABECERA_PAGOS"."NRO_DOC_CONTABLE_SAP" IS NULL ) AND
							  ( "SAP_CABECERA_PAGOS"."NRO_ENVIO" = :ll_nro_envio )
					USING		sqlca;
					if sqlca.sqlcode=0 then
						commit;
						ll_count ++
					else
						rollback;
						messagebox("Advertencia","No Actualizó Estado SAP_CABECERA_PAGOS"+sqlca.sqlerrtext)
					end if
				end if
				ret			= GetContextService("Internet", iinet_base)
				if ret = -1 then
					messagebox('No hay servicio','No hay servidor disponible de internet',stopsign!)
					return
				end if			
				if gs_conexion = "Parque El Prado" then
					if gs_sap_conex='P' then
						ret			= iinet_base.HyperlinkToURL("http://50.50.50.192/nusoap/cpagos3.php?conexion=P")
					elseif gs_sap_conex='Q' then
						ret			= iinet_base.HyperlinkToURL("http://50.50.50.192/nusoap/cpagos3.php?conexion=QP")
					elseif gs_sap_conex='R' then
						ret			= iinet_base.HyperlinkToURL("http://50.50.50.192/nusoap/cpagos3.php?conexion=RP")
					end if
				else
					if gs_sap_conex='P' then
						ret			= iinet_base.HyperlinkToURL("http://50.50.50.192/nusoap/cpagos3.php?conexion=F")
					elseif gs_sap_conex='Q' then
						ret			= iinet_base.HyperlinkToURL("http://50.50.50.192/nusoap/cpagos3.php?conexion=QF")
					elseif gs_sap_conex='R' then
						ret			= iinet_base.HyperlinkToURL("http://50.50.50.192/nusoap/cpagos3.php?conexion=RF")
					end if
				end if
				f_reg_x_segundo('CTTO',13000000)
				if ll_item = 1 then
					ls_waers		= 'CLP'
				else
					ls_waers		= 'UF'
				end if
				SELECT 	count(SAPABAP1.ZV_PAGO.MANDT)
				INTO		:ll_count_sap
				FROM 	SAPABAP1.ZV_PAGO  
    				WHERE 	SAPABAP1.ZV_PAGO.XBLNR = :ls_ref_cont1 AND
					 		SAPABAP1.ZV_PAGO.WAERS = :ls_waers 
				USING	Trans_hana;
				if ll_count_sap > 0 then
					UPDATE 		"INGRESO"  
					SET 			"ESTADO_PAGO_SAP" = 0  
					WHERE 	  ( "INGRESO"."FECHA_PAGO" = :ldt_fecha_pago ) AND  
								  ( "INGRESO"."COD_CAJA" = :ls_caja )
					USING		sqlca;
					if sqlca.sqlcode=0 then
						commit;
						UPDATE 		"DOCUMENTOS"  
						SET 			"ESTADO_PAGO_SAP" = 0  
						WHERE 	  ( "DOCUMENTOS"."FECHA_PAGO" = :ldt_fecha_pago ) AND  
									  ( "DOCUMENTOS"."COD_CAJA" = :ls_caja )
						USING		sqlca;
						if sqlca.sqlcode=0 then
							commit;
						else
							rollback;
							messagebox("Advertencia","No Actualizó ESTADO_PAGO_SAP en DOCUMENTOS Caja: "+ls_caja+' del '+string(ldt_fecha_pago,'dd/mm/yyyy')+" SQL: "+sqlca.sqlerrtext)
						end if
					else
						rollback;
						messagebox("Advertencia","No Actualizó ESTADO_PAGO_SAP en INGRESO Caja: "+ls_caja+' del '+string(ldt_fecha_pago,'dd/mm/yyyy')+" SQL: "+sqlca.sqlerrtext)
					end if
				else
					f_reg_x_segundo('CTTO',10000000)
					if ll_item = 1 then
						ls_waers		= 'CLP'
					else
						ls_waers		= 'UF'
					end if
					SELECT 	count(SAPABAP1.ZV_PAGO.MANDT)
					INTO		:ll_count_sap
					FROM 	SAPABAP1.ZV_PAGO  
					WHERE 	SAPABAP1.ZV_PAGO.XBLNR = :ls_ref_cont1 AND
								SAPABAP1.ZV_PAGO.WAERS = :ls_waers 
					USING	Trans_hana;
					if ll_count_sap > 0 then
						UPDATE 		"INGRESO"  
						SET 			"ESTADO_PAGO_SAP" = 0  
						WHERE 	  ( "INGRESO"."FECHA_PAGO" = :ldt_fecha_pago ) AND  
									  ( "INGRESO"."COD_CAJA" = :ls_caja )
						USING		sqlca;
						if sqlca.sqlcode=0 then
							commit;
							UPDATE 		"DOCUMENTOS"  
							SET 			"ESTADO_PAGO_SAP" = 0  
							WHERE 	  ( "DOCUMENTOS"."FECHA_PAGO" = :ldt_fecha_pago ) AND  
										  ( "DOCUMENTOS"."COD_CAJA" = :ls_caja )
							USING		sqlca;
							if sqlca.sqlcode=0 then
								commit;
							else
								rollback;
								messagebox("Advertencia","No Actualizó ESTADO_PAGO_SAP en DOCUMENTOS Caja: "+ls_caja+' del '+string(ldt_fecha_pago,'dd/mm/yyyy')+" SQL: "+sqlca.sqlerrtext)
							end if
						else
							rollback;
							messagebox("Advertencia","No Actualizó ESTADO_PAGO_SAP en INGRESO Caja: "+ls_caja+' del '+string(ldt_fecha_pago,'dd/mm/yyyy')+" SQL: "+sqlca.sqlerrtext)
						end if
					else
						if ll_item = 1 then
							UPDATE 	"SAP_CABECERA_PAGOS"  
							SET 		"ESTADO_SAP" = 3  
							WHERE ( "SAP_CABECERA_PAGOS"."FECHA_PAGO" = :ldt_fecha_pago ) AND  
									  ( "SAP_CABECERA_PAGOS"."SOCIEDAD" = :ls_sociedad ) AND  
									  ( "SAP_CABECERA_PAGOS"."MONEDA" = :ls_moneda ) AND  
									  ( "SAP_CABECERA_PAGOS"."REF_CAJA_CONTABLE1" = :ls_ref_cont1 ) AND  
									  ( "SAP_CABECERA_PAGOS"."ESTADO_SAP" = :ll_estado_sap ) AND  
									  ( "SAP_CABECERA_PAGOS"."COD_CAJA" = :ls_caja ) AND  
									  ( "SAP_CABECERA_PAGOS"."ITEM" = :ll_item )  AND 
									  ( "SAP_CABECERA_PAGOS"."NRO_DOC_CONTABLE_SAP" IS NULL ) AND
									  ( "SAP_CABECERA_PAGOS"."NRO_ENVIO" = :ll_nro_envio )
							USING		sqlca;
							if sqlca.sqlcode=0 then
								commit;
							else
								rollback;
								messagebox("Advertencia","No Actualizó Estado SAP_CABECERA_PAGOS Item 1"+sqlca.sqlerrtext)
								ll_count		= ll_count - 1
							end if
						elseif ll_item = 2 then
							UPDATE 	"SAP_CABECERA_PAGOS"  
							SET 		"ESTADO_SAP" = 4  
							WHERE ( "SAP_CABECERA_PAGOS"."FECHA_PAGO" = :ldt_fecha_pago ) AND  
									  ( "SAP_CABECERA_PAGOS"."SOCIEDAD" = :ls_sociedad ) AND  
									  ( "SAP_CABECERA_PAGOS"."MONEDA" = :ls_moneda ) AND  
									  ( "SAP_CABECERA_PAGOS"."REF_CAJA_CONTABLE1" = :ls_ref_cont1 ) AND  
									  ( "SAP_CABECERA_PAGOS"."ESTADO_SAP" = :ll_estado_sap ) AND  
									  ( "SAP_CABECERA_PAGOS"."COD_CAJA" = :ls_caja ) AND  
									  ( "SAP_CABECERA_PAGOS"."ITEM" = :ll_item )  AND 
									  ( "SAP_CABECERA_PAGOS"."NRO_DOC_CONTABLE_SAP" IS NULL ) AND
									  ( "SAP_CABECERA_PAGOS"."NRO_ENVIO" = :ll_nro_envio )
							USING		sqlca;
							if sqlca.sqlcode=0 then
								commit;
							else
								rollback;
								messagebox("Advertencia","No Actualizó Estado SAP_CABECERA_PAGOS Item 2"+sqlca.sqlerrtext)
								ll_count		= ll_count - 1
							end if
						end if	
						messagebox('Advertencia','Sobrepaso Tiempo de Espera Definido, para Crear Asiento Contable SAP',stopsign!)
						if dw_cabecera.rowcount() = 1 then cb_limpiar.triggerevent(clicked!)
						return
					end if
				end if
				if tab_1.tabpage_1.dw_cabecera.retrieve(ls_caja_consulta,MIAR) > 0 then
					tab_1.tabpage_1.dw_cabecera.scrolltorow(1)
					tab_1.tabpage_1.dw_cabecera.setfocus()
					ll_item			= tab_1.tabpage_1.dw_cabecera.getitemnumber(1,'item')
					tab_1.tabpage_1.dw_debe.retrieve(ls_caja,MIAR,ll_item)
					tab_1.tabpage_1.dw_haber.retrieve(ls_caja,MIAR,ll_item)
				else
					tab_1.tabpage_1.dw_debe.reset()
					tab_1.tabpage_1.dw_haber.reset()
				end if
				if ll_count > 0 then
					messagebox("Generar Centralización SAP","Generación Exitosa") 
					UPDATE	"INGRESO"  
     				SET 		"REZAGO" = ' '
					WHERE	"INGRESO"."CONTRATO" > 0 and
								"INGRESO"."REZAGO" = 'S' and
								"INGRESO"."FECHA_PAGO" > to_date('01/04/2016','dd/mm/yyyy')
					USING	sqlca;
					if sqlca.sqlcode=0 then
						commit;
					else
						rollback;
					end if
				end if
			end if
		else
			messagebox("Advertencia","Recuerde que Suma Total Debe y Haber deben ser Iguales")
		end if
//	end if
end if
end event

