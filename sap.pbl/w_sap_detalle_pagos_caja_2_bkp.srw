type dw_cliente_rezago from datawindow within tabpage_2
integer x = 27
integer y = 108
integer width = 4471
integer height = 1488
integer taborder = 30
string title = "none"
string dataobject = "dw_numero_cliente_ampliacion_rezago"
boolean hscrollbar = true
boolean vscrollbar = true
boolean hsplitscroll = true
borderstyle borderstyle = stylelowered!
end type

event clicked;String		ls_columna,ls_texto
Long		ll_tot_reg,ll_indi

ls_columna														= dwo.name
ll_tot_reg														= dw_cliente_rezago.rowcount()

if row > 0 then
	This.SelectRow(0, false)
	This.SelectRow(row, true)
else
	if ls_columna = 't_marca' and ll_tot_reg > 0 then 
		ls_texto													= dw_cliente_rezago.object.t_marca.text
		if ls_texto = 'Marcar Todos' then
			for ll_indi=1 to ll_tot_reg
				dw_cliente_rezago.setitem(ll_indi,'estado_reg',0)
			next
			dw_cliente_rezago.object.t_marca.text		= 'Desmarcar Todos'
		elseif ls_texto = 'Desmarcar Todos' then
			for ll_indi=1 to ll_tot_reg
				dw_cliente_rezago.setitem(ll_indi,'estado_reg',1)
			next
			dw_cliente_rezago.object.t_marca.text		= 'Marcar Todos'
		end if
		dw_cliente_rezago.accepttext()
	end if
end if
end event

event rowfocuschanged;if getrow() > 0 then
	This.SelectRow(0, false)
	This.SelectRow(getrow(), true)
end if
end event

