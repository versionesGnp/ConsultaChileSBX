type cb_generar_cliente from commandbutton within tabpage_2
integer x = 3808
integer y = 1632
integer width = 690
integer height = 112
integer taborder = 200
integer textsize = -9
integer weight = 400
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string text = "Generar Cliente SAP"
end type

event clicked;string		ls_dv,ls_grupo_cta,ls_sociedad,ls_tipo_vta,ls_uso,ls_origen_vta,ls_string,ls_rut_sap,ls_ok,ls_nro_sap,ls_rut,ls_tipo_cliente,ls_organizacion,ls_cod_pago,&
			ls_des_grupo_cta,ls_des_sociedad,ls_des_origen,ls_des_tipo_vta,ls_soc_amplia,ls_tipo_vta_amplia,ls_pasa='N' 
long 		ret,ll_tot_reg,ll_fila,ll_res,ll_indi,ll_graba=0,ll_no_graba,ll_cta,ll_estado_reg,ll_folio
double	ldb_rut,ldb_tot_porc=0,ldb_tot_porc_aux=0,ldb_seg
datetime	ldt_fecha_pago

Inet  iinet_base
ret = GetContextService("Internet", iinet_base)
dw_cliente_rezago.accepttext()
ll_tot_reg									= dw_cliente_rezago.rowcount()
if ll_tot_reg=0 then
	messagebox("Advertencia","No Registra Cliente para Carga SAP")
else
	ll_fila 										= dw_cliente_rezago.Find("estado_reg = 0",1, ll_tot_reg)
	if ll_fila=0 then 
		messagebox("Advertencia","Debe Seleccionar Clientes para Traspaso A SAP")
	else
		ll_res									= MessageBox("Advertencia","¿Desea Generar Traspaso de Clientes a SAP?", Exclamation!, YesNo!, 2)
		if ll_res=1 then
			dw_cliente_rezago.accepttext()
			dw_cliente_rezago.setFilter( "estado_reg = 0")
			dw_cliente_rezago.filter()
			dw_cliente_rezago.accepttext()
			ll_tot_reg				= dw_cliente_rezago.rowcount()
			SetPointer(HourGlass!)
			for	ll_indi=1 to ll_tot_reg
				ll_estado_reg		= dw_cliente_rezago.getitemnumber(ll_indi,'estado_reg')
				if ll_estado_reg=0 then
					ldb_rut				= dw_cliente_rezago.getitemnumber(ll_indi,'rut')
					ls_dv					= dw_cliente_rezago.getitemstring(ll_indi,'rut_dv')
					ls_grupo_cta		= dw_cliente_rezago.getitemstring(ll_indi,'grupo_cuenta')
					ls_sociedad			= dw_cliente_rezago.getitemstring(ll_indi,'sociedad')
					ls_tipo_vta			= dw_cliente_rezago.getitemstring(ll_indi,'origen_venta')
					ls_uso				= dw_cliente_rezago.getitemstring(ll_indi,'uso')
					ls_origen_vta		= dw_cliente_rezago.getitemstring(ll_indi,'origen_venta')

					ls_tipo_cliente		= dw_cliente_rezago.getitemstring(ll_indi,'tipo_cliente')
					ls_organizacion		= dw_cliente_rezago.getitemstring(ll_indi,'organizacion')
					
					ls_cod_pago			= dw_cliente_rezago.getitemstring(ll_indi,'cod_pago')
					ll_folio				= dw_cliente_rezago.getitemnumber(ll_indi,'folio')
					ldt_fecha_pago		= dw_cliente_rezago.getitemdatetime(ll_indi,'fecha_pago')
					
					if not isnull(ldb_rut) and ldb_rut>0 then
						ls_rut						= string(ldb_rut)+'-'+ls_dv
						ls_nro_sap				= f_vista_cliente_sap(ls_grupo_cta,ls_sociedad,ls_organizacion,ls_uso,ls_origen_vta,ls_rut)
						SELECT	SYSDATE
						INTO 		:gdt_fec_sistema
						FROM		"TASA"  
						WHERE	"TASA"."LOOK" = 1   
						USING	Trans_2;
						if ls_tipo_cliente = 'C' then
							UPDATE	"CLIENTE_REZAGO"  
							SET 		"FECHA_SAP" = :gdt_fec_sistema,
										"ESTADO_SAP" = 2
							WHERE	"CLIENTE_REZAGO"."RUT" = :ldb_rut AND
										"CLIENTE_REZAGO"."COD_PAGO" = :ls_cod_pago AND
										"CLIENTE_REZAGO"."FOLIO" = :ll_folio AND
										"CLIENTE_REZAGO"."FECHA_PAGO" = :ldt_fecha_pago
							USING	sqlca;
							if sqlca.sqlcode=0 then
								commit using sqlca;
							else
								rollback using sqlca;
							end if
								
							UPDATE	"SAP_AMPLIACION_CLIENTE"  
							SET		"FECHA_SAP" = :gdt_fec_sistema
							WHERE	"SAP_AMPLIACION_CLIENTE"."RUT" = :ldb_rut AND  
										"SAP_AMPLIACION_CLIENTE"."MANDT" = :gs_mandatario AND  
										"SAP_AMPLIACION_CLIENTE"."TIPO_CLIENTE" = :ls_tipo_cliente AND
										"SAP_AMPLIACION_CLIENTE"."GRUPO_CUENTA" = :ls_grupo_cta AND
										"SAP_AMPLIACION_CLIENTE"."SOCIEDAD" = :ls_sociedad AND
										"SAP_AMPLIACION_CLIENTE"."ORGANIZACION" = :ls_organizacion AND
										"SAP_AMPLIACION_CLIENTE"."ORIGEN_VENTA" = :ls_origen_vta AND
										"SAP_AMPLIACION_CLIENTE"."USO" = :ls_uso and
										"SAP_AMPLIACION_CLIENTE"."TIPO_CLIENTE" = :ls_tipo_cliente 								
							USING	Trans_1;
							if Trans_1.sqlcode=0 then
								commit using Trans_1;
							else
								rollback using Trans_1;
							end if
						else
							UPDATE	"SAP_AMPLIACION_CLIENTE"  
							SET		"FECHA_SAP" = :gdt_fec_sistema
							WHERE	"SAP_AMPLIACION_CLIENTE"."RUT" = :ldb_rut AND  
										"SAP_AMPLIACION_CLIENTE"."MANDT" = :gs_mandatario AND  
										"SAP_AMPLIACION_CLIENTE"."TIPO_CLIENTE" = :ls_tipo_cliente AND
										"SAP_AMPLIACION_CLIENTE"."GRUPO_CUENTA" = :ls_grupo_cta AND
										"SAP_AMPLIACION_CLIENTE"."SOCIEDAD" = :ls_sociedad AND
										"SAP_AMPLIACION_CLIENTE"."ORGANIZACION" = :ls_organizacion AND
										"SAP_AMPLIACION_CLIENTE"."ORIGEN_VENTA" = :ls_origen_vta AND
										"SAP_AMPLIACION_CLIENTE"."USO" = :ls_uso and
										"SAP_AMPLIACION_CLIENTE"."TIPO_CLIENTE" = :ls_tipo_cliente 
							USING	sqlca;
							if sqlca.sqlcode=0 then
								commit using sqlca;
							else
								rollback using sqlca;
							end if
						end if
						if isnull(ls_nro_sap) or ls_nro_sap='' then
//							f_direccion_url(ls_tipo_cliente,ldb_rut)
						end if
					end if
				end if
			next
			dw_cliente_rezago.retrieve()
			dw_cliente_rezago.setFilter("")
			dw_cliente_rezago.filter()
			dw_cliente_rezago.accepttext()
			dw_hana_cliente.retrieve(gs_mandatario,ls_grupo_cta,ls_sociedad,ls_tipo_vta,ls_uso,ls_origen_vta)
			SetPointer(Arrow!)
			messagebox("Grabar",'Proceso Terminado :~r~n'+string(ll_graba,'###,###,##0')+' Clientes Grabados con Exito en SAP~r~n'+&
										'y '+string(ll_no_graba,'###,###,##0')+' Clientes No Grabados en SAP.',information!)
		end if
	end if
end if
end event

