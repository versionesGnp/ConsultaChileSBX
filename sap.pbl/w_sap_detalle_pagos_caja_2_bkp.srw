type cb_crea_rezago from commandbutton within w_sap_detalle_pagos_caja_2_bkp
boolean visible = false
integer x = 3383
integer y = 2236
integer width = 389
integer height = 96
integer taborder = 70
integer textsize = -8
integer weight = 700
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string text = "Crea Rezago"
end type

event clicked;string		ls_base,ls_serie,ls_nombre,ls_paterno,ls_materno,ls_direcc_part,ls_comuna,ls_ciudad,ls_fono,ls_usuario,ls_dv,ls_tipo_cob,&
			ls_estado,ls_caja,ls_user_trasp,ls_moneda,ls_nro_sap,ls_nro_part,ls_tipo_mov,ls_cod_caja,ls_nro_cliente_sap
long		ll_folio,ll_cod_parque,ll_estado_sap,ll_graba,ll_no_graba,ll_fila,ll_existe
double 	ldb_rut,ldb_numero
datetime	ldt_fec_pago,ldt_fec_trasp,ldt_fec_sap


if il_fila_res>0 then
	ll_fila	= il_fila_res
	tab_1.tabpage_1.dw_ingreso_sap.setfocus()
	tab_1.tabpage_1.dw_ingreso_sap.scrolltorow(ll_fila)

	if ll_fila>0 then
		//ls_nro_cliente_sap			= tab_1.tabpage_1.dw_ingreso_sap.getitemstring(ll_fila,'vista_sap_haber_cliente_sap')
		ls_nro_cliente_sap			= '0001085553'
		
		if isnull(ls_nro_cliente_sap) or ls_nro_cliente_sap='' then
			messagebox("Advertencia","Debe Crear Cliente SAP")
		else
			ldb_rut					= tab_1.tabpage_1.dw_ingreso_sap.getitemnumber(ll_fila,'rut')
			ls_base					= tab_1.tabpage_1.dw_ingreso_sap.getitemstring(ll_fila,'base')
			ls_serie					= tab_1.tabpage_1.dw_ingreso_sap.getitemstring(ll_fila,'serie')
			ldb_numero				= tab_1.tabpage_1.dw_ingreso_sap.getitemnumber(ll_fila,'numero')
			ls_tipo_cob				= tab_1.tabpage_1.dw_ingreso_sap.getitemstring(ll_fila,'tipo_cob')
			ls_tipo_mov				= tab_1.tabpage_1.dw_ingreso_sap.getitemstring(ll_fila,'tipo_mov')
			ls_cod_caja				= tab_1.tabpage_1.dw_ingreso_sap.getitemstring(ll_fila,'caja')
			ls_moneda				= tab_1.tabpage_1.dw_ingreso_sap.getitemstring(ll_fila,'vista_sap_haber_moneda')
			
			ll_folio					= tab_1.tabpage_1.dw_ingreso_sap.getitemnumber(ll_fila,'folio')	
			ldt_fec_pago			= tab_1.tabpage_1.dw_ingreso_sap.getitemdatetime(ll_fila,'fecha_pago')
			ls_caja					= tab_1.tabpage_1.dw_ingreso_sap.getitemstring(ll_fila,'caja')
			ll_cod_parque			= tab_1.tabpage_1.dw_ingreso_sap.getitemnumber(ll_fila,'cod_parque')
			
			ls_usuario				= 'SAP'
			ll_estado_sap			= 1
			
			SELECT	"NOMBRE",	"A_PATERNO",	"A_MATERNO",	"DIRECCION_P",	"COMUNA",	"CIUDAD",	"FONO_P",	"NUMERO_PARTICULAR",	"DV",		"FECHA_SAP",	"NRO_CLIENTE_SAP"   
			INTO 		:ls_nombre,	:ls_paterno,		:ls_materno,	:ls_direcc_part,		:ls_comuna,	:ls_ciudad,	:ls_fono,		:ls_nro_part,					:ls_dv,	:ldt_fec_sap,	:ls_nro_sap	  
			FROM 	"CLIENTE"
			WHERE	"CLIENTE"."RUT" =:ldb_rut
			USING	sqlca;
			
			SELECT	count("BASE")
			INTO		:ll_existe
			FROM		"CLIENTE_REZAGO"  
			WHERE	"CLIENTE_REZAGO"."RUT" = :ldb_rut AND
						"CLIENTE_REZAGO"."COD_PAGO" = :ls_tipo_cob AND
						"CLIENTE_REZAGO"."FOLIO" = :ll_folio AND
						"CLIENTE_REZAGO"."FECHA_PAGO" = :ldt_fec_pago AND
						"CLIENTE_REZAGO"."CAJA" = :ls_caja
			USING	sqlca;
			if isnull(ll_existe) then ll_existe=0
			if ll_existe>0 then
				messagebox("Advertencia","Folio Existe en Rezago")
			else
				INSERT INTO	"CLIENTE_REZAGO"  
							("RUT",		"BASE",	"SERIE",	"NUMERO",		"NOMBRE",	"AP_PATERNO",	"AP_MATERNO",	"DIRECCION_PART",	"COMUNA_PART",	"CIUDAD_PART",	"TELEFONO_PART",	"FECHA_CREA",	"USUARIO",	"DV",		"COD_PAGO",	"FOLIO",	"FECHA_PAGO",	"ESTADO",	"CAJA",	"FECHA_TRASPASO_REZAGO",	"USUARIO_GENERA_TRASPASO",	"COD_PARQUE",	"MONEDA",	"ESTADO_SAP",	"ESTADO_SAP_CONTRATO",	"NRO_CLIENTE_SAP",	"FECHA_SAP" )  
				VALUES	(:ldb_rut,	:ls_base,	:ls_serie,	:ldb_numero,	:ls_nombre,	:ls_paterno,			:ls_materno,		:ls_direcc_part,			:ls_comuna,			:ls_ciudad,			:ls_fono,					:gdt_fec_sistema,	:ls_usuario,	:ls_dv,	:ls_tipo_cob,	:ll_folio,	:ldt_fec_pago,		:ls_estado,	:ls_caja,	:ldt_fec_trasp,						:ls_user_trasp,							:ll_cod_parque,		:ls_moneda,	:ll_estado_sap,		0,										:ls_nro_sap,				:ldt_fec_sap	)
				USING	sqlca;	
				if sqlca.sqlcode = 0 then
					commit using sqlca;
					UPDATE	"INGRESO"  
					SET 		"REZAGO" = 'S'  
					WHERE	( "INGRESO"."FOLIO" = :ll_folio ) AND  
								( "INGRESO"."TIPO_COB" = :ls_tipo_cob ) AND  
								( "INGRESO"."FECHA_PAGO" = :ldt_fec_pago ) AND  
								( "INGRESO"."COD_CAJA" = :ls_cod_caja )
					USING	Trans_1;
					if Trans_1.sqlcode = 0 then
						commit using Trans_1;
					else
						rollback using Trans_1;
					end if 
					ll_graba++
				else
					rollback using sqlca;
					ll_no_graba++
				end if
			end if
		end if
	end if
end if
	

end event

