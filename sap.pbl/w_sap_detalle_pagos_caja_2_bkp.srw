end type

event clicked;tab_1.tabpage_6.dw_boletas_deposito_ch.retrieve()

String		ls_caja, ls_fecha
Long		ll_pos

ls_fecha								= String(DATE(EM_1.TEXT),'ddmmyyyy')
ll_pos									= pos(ddplb_caja.text,'-')
ls_caja								= trim(mid(ddplb_caja.text,1,(ll_pos - 1)))
if tab_1.tabpage_6.dw_boletas_deposito_ch.retrieve(ls_caja,ls_fecha) = 0 then
	messagebox("Advertencia","No Existe Boleta Deposito Caja "+ls_caja+ " del "+string(EM_1.TEXT))
end if
end event

type cb_32 from commandbutton within tabpage_6
