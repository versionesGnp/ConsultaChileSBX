this.pb_buscar=create pb_buscar
this.em_boleta=create em_boleta
this.st_15=create st_15
this.cb_limpiar_crea_ctto_serv=create cb_limpiar_crea_ctto_serv
this.cb_38=create cb_38
this.cb_37=create cb_37
this.cb_36=create cb_36
this.cb_35=create cb_35
this.st_13=create st_13
this.cb_crear_servicio=create cb_crear_servicio
this.cb_mostrar_ctto_serv=create cb_mostrar_ctto_serv
this.dw_contrato=create dw_contrato
this.gb_7=create gb_7
this.Control[]={this.cb_material,&
this.cb_51,&
this.cb_actualiza_ctto_sap,&
this.pb_buscar,&
this.em_boleta,&
this.st_15,&
this.cb_limpiar_crea_ctto_serv,&
this.cb_38,&
this.cb_37,&
this.cb_36,&
this.cb_35,&
this.st_13,&
this.cb_crear_servicio,&
this.cb_mostrar_ctto_serv,&
this.dw_contrato,&
this.gb_7}
end on

on tabpage_8.destroy
destroy(this.cb_material)
destroy(this.cb_51)
destroy(this.cb_actualiza_ctto_sap)
destroy(this.pb_buscar)
destroy(this.em_boleta)
destroy(this.st_15)
destroy(this.cb_limpiar_crea_ctto_serv)
destroy(this.cb_38)
destroy(this.cb_37)
destroy(this.cb_36)
destroy(this.cb_35)
destroy(this.st_13)
destroy(this.cb_crear_servicio)
destroy(this.cb_mostrar_ctto_serv)
destroy(this.dw_contrato)
destroy(this.gb_7)
end on

