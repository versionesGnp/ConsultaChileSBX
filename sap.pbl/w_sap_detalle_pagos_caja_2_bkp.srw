end type

event clicked;string		ls_cod_caja,ls_tipo_cob,ls_base,ls_serie
long		ll_res,ll_folio,ll_folio_doc,ll_graba=0,ll_no_graba=0
double	ldb_numero,ldb_monto
datetime	ldt_fec_pago,ldt_fec_sistema,ldt_fec_venc


ls_cod_caja						= trim(mid(ddplb_caja.text,1,(pos(ddplb_caja.text,'-') - 1)))
ldt_fec_pago					= datetime(date(em_1.text),time('00:00:00'))

ll_res								= MessageBox("Advertencia", 'Esta seguro de Grabar Registro', Exclamation!, YesNo!, 2)
if ll_res=1 then
	SetPointer(HourGlass!)
	DECLARE x1 CURSOR FOR
	SELECT DISTINCT "INGRESO"."FOLIO",   
					"INGRESO"."TIPO_COB",
					"INGRESO"."BASE",   
					"INGRESO"."SERIE",   
					"INGRESO"."CONTRATO",
					(	SELECT DISTINCT	"DOCUMENTOS"."FOLIO"
						  FROM	"DOCUMENTOS"
						  WHERE	"DOCUMENTOS"."FOLIO"  = "INGRESO"."FOLIO" AND
										"DOCUMENTOS"."TIPO_COB" = "INGRESO"."TIPO_COB" AND
										"DOCUMENTOS"."FECHA_PAGO" = "INGRESO"."FECHA_PAGO")
   FROM		"INGRESO" 
   WHERE	"INGRESO"."TIPO_COB" <> 'NE' AND  
				("INGRESO"."PAGO_HIST" = 'A' OR "INGRESO"."PAGO_HIST" = 'N') AND 
				"INGRESO"."ESTADO_PAGO_SAP" = 99 and
				"INGRESO"."FECHA_PAGO" = :ldt_fec_pago and
				"INGRESO"."COD_CAJA" = :ls_cod_caja and
				(	SELECT DISTINCT	"DOCUMENTOS"."FOLIO"
					FROM		"DOCUMENTOS"
					WHERE	"DOCUMENTOS"."FOLIO"  = "INGRESO"."FOLIO" AND
								"DOCUMENTOS"."TIPO_COB" = "INGRESO"."TIPO_COB" AND
								"DOCUMENTOS"."FECHA_PAGO" = "INGRESO"."FECHA_PAGO") IS NULL
    	ORDER BY	"INGRESO"."FOLIO" ASC
	USING	Trans_1;
	open x1;
	if Trans_1.sqlcode=0 then
		DO WHILE Trans_1.sqlcode=0
		fetch x1 INTO	:ll_folio,:ls_tipo_cob,:ls_base,:ls_serie,:ldb_numero,:ll_folio_doc;      
			if not isnull(ll_folio) and ll_folio > 0 and not isnull(ls_tipo_cob) and ls_tipo_cob<>'' and not isnull(ls_base) and ls_base<>'' and not isnull(ls_serie) and ls_serie<>'' and not isnull(ldb_numero) and ldb_numero>0 then	
				if isnull (ll_folio_doc) then ll_folio_doc = 0
				if ll_folio_doc = 0 THEN
					SELECT	SUM("INGRESO"."MONTO")
					INTO 		:ldb_monto
					FROM 	"INGRESO"  
					WHERE	"INGRESO"."BASE" = :ls_base AND  
								"INGRESO"."SERIE" = :ls_serie AND  
								"INGRESO"."CONTRATO" = :ldb_numero AND
								"INGRESO"."TIPO_COB" = :ls_tipo_cob AND		
								"INGRESO"."FOLIO" = :ll_folio AND
								"INGRESO"."FECHA_PAGO" = :ldt_fec_pago
					USING	sqlca;
					if isnull(ldb_monto) then ldb_monto=0
					
					SELECT DISTINCT MAX("INGRESO"."FECHA_SISTEMA"),MAX("INGRESO"."FECHA_VENC")
					INTO		:ldt_fec_sistema,	:ldt_fec_venc     
					FROM 	"INGRESO"  
					WHERE	"INGRESO"."BASE" = :ls_base AND  
								"INGRESO"."SERIE" = :ls_serie AND  
								"INGRESO"."CONTRATO" = :ldb_numero AND  
								"INGRESO"."FOLIO" = :ll_folio AND
								"INGRESO"."FECHA_PAGO" = :ldt_fec_pago       
					USING	sqlca;
					if isnull(ldt_fec_venc) then ldt_fec_venc = ldt_fec_pago
					if ll_folio> 0 then      
						INSERT INTO	"DOC_COB"  
									(	"FOLIO",	"TIPO_COB",	"N_CHEQUE",	"COD_BANCO",	"MONTO",	"FECHA_VENC",	"COD_PAGO",	"NUM_CHEQUES",	"REZAGO",	"FECHA_PAGO",	"COD_CAJA",	"COD_TARJETA_CREDITO",	"NRO_CUOTAS_CREDITO",	"COD_AUTORIZACION_CREDITO",	"TIPO_TARJETA_CREDITO",	"COD_TARJETA_DEBITO",	"COD_AUTORIZACION_DEBITO",	"COD_BANCO_DEBITO",	"TRASPASO_PAGO",	"TIPO_PAGO_TARJETA_CREDITO",	"HORA_PAGO",	"MINUTO_PAGO",	"TARJETA_EMPRESA",	"TIPO_COB_AUX")  
						VALUES	(	:ll_folio,	:ls_tipo_cob,	999,			    999,				:ldb_monto,	:ldt_fec_venc,		'EF' , 				999 , 				 	' ',				:ldt_fec_pago, 		:ls_cod_caja,	0,									0,									0,											0,									0,									0,											0,								null,						1,												null,				null,					null,				        		:ls_tipo_cob)
						USING	sqlca;
						if sqlca.sqlcode=0 then
							commit using sqlca;
						else
							rollback using sqlca;
						end if
							
						INSERT INTO	"DOCUMENTOS"  
									( 	"FOLIO",	"TIPO_COB",	"N_CHEQUE" ,	"COD_BANCO",	"MONTO"  ,  "FECHA_VENC", 	"COD_PAGO",	"NUM_CHEQUES", 	"REZAGO" , 	"FECHA_PAGO",	"COD_CAJA",	"COD_TARJETA_CREDITO",	"NRO_CUOTAS_CREDITO",	"COD_AUTORIZACION_CREDITO",	"TIPO_TARJETA_CREDITO",	"COD_TARJETA_DEBITO",	"COD_AUTORIZACION_DEBITO",	"COD_BANCO_DEBITO",	"TIPO_PAGO_TARJETA_CREDITO",	"HORA_PAGO",	"MINUTO_PAGO",	"TARJETA_EMPRESA",	"TIPO_COB_AUX",	"ESTADO_PAGO_SAP")  
						VALUES	(	:ll_folio,	:ls_tipo_cob,	999,				999, 				:ldb_monto,	:ldt_fec_venc,		'EF',				999 , 					' ', 			:ldt_fec_pago,		:ls_cod_caja,	0,									0,									0,											0,									0,									0,											0,								1,												null,				null,					null,							:ls_tipo_cob,		99)
						USING	sqlca;
						if sqlca.sqlcode=0 then
							commit using sqlca;
						else
							rollback using sqlca;
						end if
					end if
				end if
			end if
			setnull(ll_folio);setnull(ldt_fec_pago);setnull(ls_tipo_cob);setnull(ls_cod_caja);setnull(ldb_monto)
		LOOP
	end if
	close x1;
	messagebox("Grabar",'Proceso terminado :~r~n'+string(ll_graba,'###,###,##0')+' registros grabados con exito~r~n'+&
									'y '+string(ll_no_graba,'###,###,##0')+' registros con problemas.',information!)
end if
          
end event

type cb_47 from commandbutton within w_sap_detalle_pagos_caja_2_bkp
integer x = 453
integer y = 2236
integer width = 622
integer height = 96
integer taborder = 60
integer textsize = -8
integer weight = 700
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string text = "Corrige Monto Ingreso"
end type

event clicked;string		ls_base,ls_serie,ls_tipo_mov,ls_tipo_cob,ls_rezago,ls_cod_otros,ls_nro_ctto_sap,ls_tipo_deuda,ls_rez_sap,ls_moneda,ls_moneda_sap,ls_material,ls_cod_caja
long		ll_tot_reg,ll_res,ll_graba=0,ll_folio,ll_nro_cuota,ll_cta,ll_no_graba,ll_cta_ctto,ll_ctas_pag_s,ll_existe
double	ldb_numero,ldb_rut,ldb_monto,ldb_valor_uf,ldb_valor_cuota_m,ldb_valor_cuota_c,ldb_monto_sap,ldb_valor_cuota_p,ldb_monto_posic,ldb_valor_serv
datetime	ldt_fec_pago,ldt_fec_caja


ls_cod_caja						= trim(mid(ddplb_caja.text,1,(pos(ddplb_caja.text,'-') - 1)))
ldt_fec_caja						= datetime(date(em_1.text),time('00:00:00'))

SELECT	COUNT("INGRESO"."FOLIO")
INTO		:ll_tot_reg
FROM		"INGRESO"	
WHERE 	"INGRESO"."TIPO_COB" <> 'NE' AND  
			("INGRESO"."PAGO_HIST" = 'A' OR "INGRESO"."PAGO_HIST" = 'N') AND 
			"INGRESO"."ESTADO_PAGO_SAP" = 99 and
			"INGRESO"."COD_CAJA" = :ls_cod_caja and
			"INGRESO"."FECHA_PAGO" = :ldt_fec_caja
USING	sqlca;
if isnull(ll_tot_reg) then ll_tot_reg=0
if ll_tot_reg=0 then
	messagebox("Advertencia","No Registra Datos Para Actualizar")
else
	ll_res							= MessageBox("Advertencia", 'Esta seguro de Grabar Registro', Exclamation!, YesNo!, 2)
	if ll_res=1 then
		SetPointer(HourGlass!)
		UPDATE	"INGRESO"  
     	SET		"MONEDA_SAP" = null,  
         			"MONTO_UF" = null,  
         			"REZAGO_SAP" = null  
   		WHERE 	"INGRESO"."TIPO_COB" <> 'NE' AND  
         			("INGRESO"."PAGO_HIST" = 'A' OR "INGRESO"."PAGO_HIST" = 'N') AND
         			"INGRESO"."ESTADO_PAGO_SAP" = 99 and
					"INGRESO"."COD_CAJA" = :ls_cod_caja and
					"INGRESO"."FECHA_PAGO" = :ldt_fec_caja
		USING	sqlca;
		if sqlca.sqlcode=0 then
			commit using sqlca;
		else
			rollback using sqlca;
		end if	;
		
		DECLARE x1 CURSOR FOR  
        	SELECT	"INGRESO"."BASE",
			  		"INGRESO"."SERIE",
					"INGRESO"."CONTRATO",
					"INGRESO"."TIPO_MOV",
					"INGRESO"."RUT",
					"INGRESO"."FOLIO",
					"INGRESO"."TIPO_COB",
					"INGRESO"."FECHA_PAGO",
					"INGRESO"."REZAGO",
					"INGRESO"."CODIGO_OTRO",
					"INGRESO"."MONTO",
					"INGRESO"."VALOR_UF",
					"INGRESO"."CTAS_PAG_CTTO",
					"INGRESO"."CUOTAS_PAG"
		FROM		"INGRESO"
        	WHERE 	"INGRESO"."TIPO_COB" <> 'NE' AND  
         			("INGRESO"."PAGO_HIST" = 'A' OR "INGRESO"."PAGO_HIST" = 'N') AND
         			"INGRESO"."ESTADO_PAGO_SAP" = 99 and
					//"INGRESO"."FOLIO" = 319814 and	
					"INGRESO"."COD_CAJA" = :ls_cod_caja and
					"INGRESO"."FECHA_PAGO" = :ldt_fec_caja
        ORDER BY	"INGRESO"."BASE",
		  				"INGRESO"."SERIE",
            				"INGRESO"."CONTRATO",
                			"INGRESO"."FOLIO",
                			"INGRESO"."TIPO_COB",
                			"INGRESO"."TIPO_MOV",
                			"INGRESO"."RUT"
		USING		Trans_1;
		open x1;
		if Trans_1.sqlcode=0 then
			DO WHILE Trans_1.sqlcode=0
			fetch x1 INTO :ls_base,:ls_serie,:ldb_numero,:ls_tipo_mov,:ldb_rut,:ll_folio,:ls_tipo_cob,:ldt_fec_pago,:ls_rezago,:ls_cod_otros,:ldb_monto,:ldb_valor_uf,:ll_nro_cuota,:ll_ctas_pag_s;
				if not isnull(ll_folio) and ll_folio > 0 and not isnull(ls_tipo_cob) and ls_tipo_cob<>'' and not isnull(ls_tipo_mov) and ls_tipo_mov<>'' then
					
					DECLARE funcion_deuda PROCEDURE FOR F_TIPO_DEUDA_ING( :ls_base,:ls_serie,:ldb_numero,:ls_tipo_mov);
					EXECUTE funcion_deuda;
					if sqlca.sqlcode=0 then
						fetch funcion_deuda into :ls_tipo_deuda;
						close funcion_deuda;
					end if
					
					if ls_rezago='S' then
						ls_rez_sap								= 'S'
					else
						if ldb_numero>0 then
							SELECT	count("SAP_CTTO_01_CABEC"."TIPO_CTTO")
							INTO		:ll_cta_ctto	
							FROM 	"SAP_CTTO_01_CABEC"  
							WHERE	"SAP_CTTO_01_CABEC"."BASE" = :ls_base AND  
										"SAP_CTTO_01_CABEC"."SERIE" = :ls_serie AND  
										"SAP_CTTO_01_CABEC"."NUMERO" = :ldb_numero AND  
										"SAP_CTTO_01_CABEC"."TIPO_DEUDA" = :ls_tipo_deuda
							USING	sqlca;
							if isnull(ll_cta_ctto) then ll_cta_ctto=0
							if ll_cta_ctto=0 then
								ls_rez_sap					= 'S'
							else
								ls_rez_sap					= 'N'
							end if
						else
							ls_rez_sap						= 'S'
						end if
					end if
				
					if  ls_tipo_mov = 'S' then
						ls_moneda_sap						= '1'
						ldb_monto_sap     					= ldb_monto
					else	
						if ldb_numero > 0 then
							if ls_base='C' then
								SELECT  "CONTRATO"."VALOR_CUOTA_M"
								INTO    	:ldb_valor_cuota_m
								FROM 	"CADENA","CONTRATO"
								WHERE   "CADENA"."SERIE" = "CONTRATO"."SERIE_C" and  
											"CADENA"."NUMERO" = "CONTRATO"."NRO_CONTRATO" and  
											"CADENA"."CODIGO" = :ls_base and 
											"CADENA"."SERIE" = :ls_serie and
											"CADENA"."NUMERO" = :ldb_numero
								USING	sqlca;
								if isnull(ldb_valor_cuota_m) then ldb_valor_cuota_m = 0            
							
							elseif ls_base='O' then
								SELECT	"PAGO_OFERTA"."VALOR_CUOTA", "OFERTA_V"."VALOR_CUOTA_M", "PAGO_OFERTA"."MONEDA"
								INTO		:ldb_valor_cuota_c,:ldb_valor_cuota_m,:ls_moneda
								FROM 	"OFERTA_V","CADENA" ,"PAGO_OFERTA"   
								WHERE	"OFERTA_V"."SERIE" = "CADENA"."SERIE" and   
											"OFERTA_V"."NRO_OFERTA" = "CADENA"."NUMERO" and   
											"OFERTA_V"."SERIE" = "PAGO_OFERTA"."SERIE" and   
											"OFERTA_V"."NRO_OFERTA" = "PAGO_OFERTA"."NRO_OFERTA" and   
											"OFERTA_V"."ULT_FOLIO" = "PAGO_OFERTA"."FOLIO" AND 
											"CADENA"."CODIGO" = :ls_base and 
											"CADENA"."SERIE" = :ls_serie and
											"CADENA"."NUMERO" = :ldb_numero
								USING	sqlca;
								if isnull(ldb_valor_cuota_c) then ldb_valor_cuota_c = 0   
								if isnull(ldb_valor_cuota_m) then ldb_valor_cuota_m = 0
								if isnull(ls_moneda) then ls_moneda = ''
							
							elseif ls_base='L' then
								SELECT  	"PAGO_LIBERADOR"."VALOR_CUOTA","PAGO_LIBERADOR"."MONEDA"
								INTO    	:ldb_valor_cuota_c,:ls_moneda
								FROM		"ANEXO_LIBERADOR","CADENA","PAGO_LIBERADOR"  
								WHERE	"PAGO_LIBERADOR"."SERIE_M" = "ANEXO_LIBERADOR"."SERIE_M" and  
											"PAGO_LIBERADOR"."NRO_LIBERADOR" = "ANEXO_LIBERADOR"."NRO_LIBERADOR" and  
											"PAGO_LIBERADOR"."FOLIO" = "ANEXO_LIBERADOR"."ULT_FOLIO" and  
											"ANEXO_LIBERADOR"."SERIE_M" = "CADENA"."SERIE" and  
											"ANEXO_LIBERADOR"."NRO_LIBERADOR" = "CADENA"."NUMERO" and  
											"CADENA"."CODIGO" = :ls_base and 
											"CADENA"."SERIE" = :ls_serie and
											"CADENA"."NUMERO" = :ldb_numero
								USING	sqlca;
								if isnull(ldb_valor_cuota_c) then ldb_valor_cuota_c = 0
								if isnull(ls_moneda) then ls_moneda = ''
							
							elseif ls_base='A' then
								SELECT	"PAGO_AUMENTO"."VALOR_CUOTA","PAGO_AUMENTO"."MONEDA"
								INTO		:ldb_valor_cuota_c,:ls_moneda
								FROM		"ANEXO_AUMENTO","CADENA","PAGO_AUMENTO"  
								WHERE	"PAGO_AUMENTO"."SERIE_M" = "ANEXO_AUMENTO"."SERIE_M" and  
											"PAGO_AUMENTO"."NRO_AUMENTO" = "ANEXO_AUMENTO"."NRO_AUMENTO" and  
											"PAGO_AUMENTO"."FOLIO" = "ANEXO_AUMENTO"."ULT_FOLIO" and  
											"ANEXO_AUMENTO"."SERIE_M" = "CADENA"."SERIE" and  
											"ANEXO_AUMENTO"."NRO_AUMENTO" = "CADENA"."NUMERO" and  
											"CADENA"."CODIGO" = :ls_base and 
											"CADENA"."SERIE" = :ls_serie and
											"CADENA"."NUMERO" = :ldb_numero
								USING	sqlca;
								if isnull(ldb_valor_cuota_c) then ldb_valor_cuota_c = 0
								if isnull(ls_moneda) then ls_moneda = ''
							
							elseif ls_base='D' then
								SELECT	"DERECHO"."VALOR_CUO","DERECHO"."MONEDA"
								INTO    	:ldb_valor_cuota_c,:ls_moneda
								FROM    	"CADENA","DERECHO"  
								WHERE	"CADENA"."SERIE" = "DERECHO"."SERIE_P" and  
											"CADENA"."NUMERO" = "DERECHO"."NRO_PAGARE" and  
											"CADENA"."CODIGO" = :ls_base and 
											"CADENA"."SERIE" = :ls_serie and
											"CADENA"."NUMERO" = :ldb_numero
								USING	sqlca;
								if isnull(ldb_valor_cuota_c) then ldb_valor_cuota_c = 0
								if isnull(ls_moneda) then ls_moneda = ''
							
							elseif ls_base='P' then 
								SELECT  "PAGARE"."VALOR_CUO","PAGARE"."MONEDA"
								INTO    	:ldb_valor_cuota_c, :ls_moneda
								FROM		"CADENA","PAGARE"  
								WHERE	"CADENA"."SERIE" = "PAGARE"."SERIE_P" and  
											"CADENA"."NUMERO" = "PAGARE"."NRO_PAGARE" and  
											"CADENA"."CODIGO" = :ls_base and 
											"CADENA"."SERIE" = :ls_serie and
											"CADENA"."NUMERO" = :ldb_numero
								USING	sqlca;
								if isnull(ldb_valor_cuota_c) then ldb_valor_cuota_c = 0
								if isnull(ls_moneda) then ls_moneda = ''
							
							elseif ls_base='R' then
								SELECT	"REPACTA_MANTENCION"."VALOR_CUOTA_UF","REPACTA_MANTENCION"."TIPO_MONEDA"
								INTO		:ldb_valor_cuota_c,:ls_moneda
								FROM    "REPACTA_MANTENCION","CADENA" 
								WHERE   "CADENA"."SERIE" = "REPACTA_MANTENCION"."SERIE" and  
											"CADENA"."NUMERO" = "REPACTA_MANTENCION"."NUMERO" and  
											"CADENA"."CODIGO" = "REPACTA_MANTENCION"."BASE" AND 
											"CADENA"."CODIGO" = :ls_base and 
											"CADENA"."SERIE" = :ls_serie and
											"CADENA"."NUMERO" = :ldb_numero
								USING	sqlca;
								if isnull(ldb_valor_cuota_c) then ldb_valor_cuota_c = 0
								if isnull(ls_moneda) then ls_moneda = ''
							end if;
							
							if ls_base='O' or  ls_base='A' or  ls_base='L' or  ls_base='D' or  ls_base='P' or  ls_base='R' then 
								if (ls_tipo_mov = 'E' or ls_tipo_mov = 'K' or ls_tipo_mov = 'U' ) then 
									ldb_monto_posic				= wf_valor_cuota(ls_base,ls_serie,ldb_numero,ls_tipo_mov,ls_tipo_deuda,ll_nro_cuota)
									if not isnull(ldb_monto_posic) and ldb_monto_posic>0 then
										ldb_valor_cuota_c			= ldb_monto_posic
									end if
								end if
							end if
							
							if ls_tipo_mov = 'F' then
								ls_moneda_sap				= '2'
								ldb_monto_sap     			= ldb_valor_cuota_m
								
							elseif ls_tipo_mov = 'P' or  ls_tipo_mov = 'R' then
								ls_moneda_sap				= '2'
								ldb_monto_sap     			= round(ldb_monto / ldb_valor_uf,16)
							
							elseif  ls_tipo_mov = 'M' or  (ls_tipo_mov = 'L' and ls_cod_otros<>'3')  then
								ls_moneda_sap				= '2'
								ldb_monto_sap				= wf_valor_servicio(ll_folio,ls_tipo_cob,ls_tipo_mov,ls_cod_otros,ldt_fec_pago)
							
							elseif ls_tipo_mov = 'E' or ls_tipo_mov = 'K' or ls_tipo_mov = 'U' then
								ls_moneda_sap				= ls_moneda
								ldb_monto_sap     			= ldb_valor_cuota_c
							
							elseif ls_tipo_mov = 'A' or ls_tipo_mov = 'Q' then
								SELECT 	COUNT("DETALLE_PAGO_PIE"."BASE")
								INTO    	:ll_cta
								FROM		"DETALLE_PAGO_PIE"  
								WHERE	"DETALLE_PAGO_PIE"."BASE" = :ls_base AND  
											"DETALLE_PAGO_PIE"."SERIE" = :ls_serie AND  
											"DETALLE_PAGO_PIE"."NUMERO" = :ldb_numero
								USING	sqlca;
								if isnull(ll_cta) or ll_cta=0 then ll_cta =1
								if ll_cta = ll_nro_cuota then
									ldb_valor_cuota_p					= ldb_monto
								else
									SELECT	SUM("DETALLE_PAGO_PIE"."MONTO_CUOTA")
									INTO    	:ldb_valor_cuota_p
									FROM    	"DETALLE_PAGO_PIE"  
									WHERE   "DETALLE_PAGO_PIE"."BASE" = :ls_base AND  
												"DETALLE_PAGO_PIE"."SERIE" = :ls_serie AND  
												"DETALLE_PAGO_PIE"."NUMERO" = :ldb_numero AND  
												"DETALLE_PAGO_PIE"."NUMERO_CUOTA" = :ll_nro_cuota
									USING	sqlca;
									if isnull(ldb_valor_cuota_p) then ldb_valor_cuota_p = 0
								end if
								ldb_monto_posic						= wf_valor_cuota(ls_base,ls_serie,ldb_numero,ls_tipo_mov,ls_tipo_deuda,ll_nro_cuota)
								if not isnull(ldb_monto_posic) and ldb_monto_posic>0 then
									ldb_valor_cuota_p					= ldb_monto_posic
								end if
								ls_moneda_sap							= ls_moneda
								ldb_monto_sap     						= ldb_valor_cuota_p
								ls_moneda_sap							= ls_moneda
							else
								ls_moneda_sap							= ls_moneda
								if ls_moneda_sap='1' then
									ldb_monto_sap     					= ldb_monto
								elseif ls_moneda_sap='2' then
									if ls_tipo_mov='A' or ls_tipo_mov='Q' or ls_tipo_mov='E' or ls_tipo_mov='K' or ls_tipo_mov='U' and ls_tipo_mov='F' then 
										ldb_monto_sap     				= round(ldb_monto,4)
									else
										ldb_monto_sap     				= round(ldb_monto / ldb_valor_uf,16)
									end if
								end if
							end if
						else
							if ls_tipo_mov = 'M' or  (ls_tipo_mov = 'L' and ls_cod_otros<>'3')  then
								ls_moneda_sap							= '2'
								ldb_monto_sap							= wf_valor_servicio(ll_folio,ls_tipo_cob,ls_tipo_mov,ls_cod_otros,ldt_fec_pago)
							else
								SELECT DISTINCT "CLIENTE_REZAGO"."MONEDA"  
								INTO   	:ls_moneda_sap
								FROM   "CLIENTE_REZAGO"  
								WHERE ( "CLIENTE_REZAGO"."RUT" = :ldb_rut ) AND  
										 ( "CLIENTE_REZAGO"."COD_PAGO" = :ls_tipo_cob ) AND  
										 ( "CLIENTE_REZAGO"."FOLIO" = :ll_folio ) AND  
										 ( "CLIENTE_REZAGO"."FECHA_PAGO" = :ldt_fec_pago )
								USING	sqlca;
								if isnull(ls_moneda_sap) then ls_moneda_sap='2'
								ls_moneda_sap							= ls_moneda
								if ls_moneda_sap='1' then
									ldb_monto_sap     					= ldb_monto
								elseif ls_moneda_sap='2' then
									ldb_monto							= round(ldb_monto /  ldb_valor_uf,4)
									if ls_tipo_mov='A' or ls_tipo_mov='Q' or ls_tipo_mov='E' or ls_tipo_mov='K' or ls_tipo_mov='U' and ls_tipo_mov='F' then 
										ldb_monto_sap     				= round(ldb_monto,4)
									else
										ldb_monto_sap     				= round(ldb_monto,16)
									end if
								end if
							end if
						end if
					end if
								
					UPDATE	"INGRESO"  
					SET		"MONEDA_SAP" = :ls_moneda_sap,
								"MONTO_UF" = :ldb_monto_sap,
								"REZAGO_SAP" = :ls_rez_sap
					WHERE	"INGRESO"."BASE" = :ls_base and
								"INGRESO"."SERIE" = :ls_serie AND
								"INGRESO"."CONTRATO" = :ldb_numero AND
								"INGRESO"."TIPO_MOV" = :ls_tipo_mov AND
								"INGRESO"."RUT" = :ldb_rut AND  
								"INGRESO"."FOLIO" = :ll_folio AND  
								"INGRESO"."TIPO_COB" = :ls_tipo_cob AND
								"INGRESO"."CODIGO_OTRO" = :ls_cod_otros AND 
								"INGRESO"."FECHA_PAGO" = :ldt_fec_pago 
					USING	Trans_2;
					if Trans_2.sqlcode=0 then
						commit using Trans_2;
						ll_graba++
					else
						rollback using Trans_2;
						ll_no_graba++
					end if	
				end if
				setnull(ls_base);setnull(ls_serie);setnull(ldb_numero);setnull(ls_tipo_mov);setnull(ldb_rut);setnull(ll_folio);setnull(ls_tipo_cob);setnull(ldt_fec_pago);setnull(ls_rezago);setnull(ls_cod_otros);setnull(ldb_monto);setnull(ldb_valor_uf);setnull(ll_nro_cuota)
			LOOP
		end if
		close x1;
		SetPointer(Arrow!)
		if ll_tot_reg=ll_graba then
			messagebox("Grabar","Grabación Exitosa")
		end if
	end if
end if
end event

type cb_ctto_sap from commandbutton within w_sap_detalle_pagos_caja_2_bkp
integer x = 2962
integer y = 2236
integer width = 411
integer height = 100
integer taborder = 80
integer textsize = -8
integer weight = 700
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string text = "Contrato - SAP"
end type

event clicked;string	 	ls_base,ls_serie,ls_tipo_mov,ls_tipo_deuda,ls_string,ls_folio_consulta
long		ll_fila,ll_nro_cuota
double	ldb_numero

if il_fila_res>0 then
	ll_fila							= il_fila_res
	tab_1.tabpage_1.dw_ingreso_sap.setfocus()
	tab_1.tabpage_1.dw_ingreso_sap.scrolltorow(ll_fila)
	if ll_fila>0 then
		ls_base					= tab_1.tabpage_1.dw_ingreso_sap.getitemstring(ll_fila,'base')
		ls_serie					= tab_1.tabpage_1.dw_ingreso_sap.getitemstring(ll_fila,'serie')
		ldb_numero				= tab_1.tabpage_1.dw_ingreso_sap.getitemnumber(ll_fila,'numero')
		ls_tipo_mov				= tab_1.tabpage_1.dw_ingreso_sap.getitemstring(ll_fila,'tipo_mov')
		ll_nro_cuota				= tab_1.tabpage_1.dw_ingreso_sap.getitemnumber(ll_fila,'vista_sap_haber_ctas_pag_ctto')
	end if
elseif il_fila_haber>0 then
	ll_fila							= il_fila_haber
	tab_1.tabpage_1.dw_haber.setfocus()
	tab_1.tabpage_1.dw_haber.scrolltorow(ll_fila)
	if ll_fila>0 then
		ls_folio_consulta		= tab_1.tabpage_1.dw_haber.GetItemString(ll_fila, "ref_dcto")
		ls_base					= Mid(ls_folio_consulta,1,1) 
		ls_serie					= Mid(ls_folio_consulta,2,1) 
		ldb_numero				= double(Mid(ls_folio_consulta,3,20))
		ls_tipo_mov				= tab_1.tabpage_1.dw_haber.getitemstring(ll_fila,'tipo_mov')
		ll_nro_cuota				= long(tab_1.tabpage_1.dw_ingreso_sap.getitemstring(ll_fila,'nro_opera_transbank'))
	end if
end if
if ll_fila>0 then
	DECLARE funcion_deuda PROCEDURE FOR F_TIPO_DEUDA_ING( :ls_base,:ls_serie,:ldb_numero,:ls_tipo_mov);
	EXECUTE funcion_deuda;
	if sqlca.sqlcode=0 then
		fetch funcion_deuda into :ls_tipo_deuda;
		close funcion_deuda;
	end if
	if not isnull(ls_base) and ls_base<>'' and  not isnull(ls_serie) and ls_serie<>'' and not isnull(ldb_numero) and ldb_numero>0 and not isnull(ls_tipo_deuda) and ls_tipo_deuda<>'' then
		ls_string						= ls_base+'~t'+ls_serie+'~t'+string(ldb_numero)+'~t'+ls_tipo_deuda+'~t'+string(ll_nro_cuota)
//		messagebox("Falta Ventana","Falta Ventana w_detalle_contrato_sap")
		if isvalid(w_detalle_contrato_sap) then close(w_detalle_contrato_sap)
		OpenWithParm (w_detalle_contrato_sap,ls_string)
	end if
end if
end event

type cb_50 from commandbutton within w_sap_detalle_pagos_caja_2_bkp
integer x = 6034
integer y = 1368
integer width = 471
integer height = 100
integer taborder = 70
integer textsize = -8
integer weight = 700
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string text = "Resp Modif Debe"
end type

