type dw_cabecera from datawindow within tabpage_1
integer x = 27
integer y = 108
integer width = 4471
integer height = 428
integer taborder = 20
string title = "none"
string dataobject = "dw_sap_cabecera_interfaz"
boolean hscrollbar = true
boolean vscrollbar = true
boolean hsplitscroll = true
borderstyle borderstyle = stylelowered!
end type

event clicked;Date		MIAR
Long		ll_pos,ll_envio
String		ls_caja

if row > 0 then
//	MIAR 			= DATE(EM_1.TEXT)
//	ll_pos			= pos(ddplb_caja.text,'-')
//	ls_caja		= trim(mid(ddplb_caja.text,1,(ll_pos - 1)))
	This.SelectRow(0, false)
	This.SelectRow(row, true)
	ll_envio		= dw_cabecera.getitemnumber(dw_cabecera.getrow(),'nro_envio')
	if ll_envio >= 0 then
		MIAR 			= DATE(dw_cabecera.getitemdatetime(dw_cabecera.getrow(),'fecha_pago'))
		ls_caja		= dw_cabecera.getitemstring(dw_cabecera.getrow(),'cod_caja')
		il_item		= dw_cabecera.getitemnumber(dw_cabecera.getrow(),'item')
		dw_debe.retrieve(ls_caja, MIAR,il_item)
		dw_haber.retrieve(ls_caja, MIAR,il_item)
	end if
end if
end event

event rowfocuschanged;Date		MIAR
Long		ll_pos,ll_envio
String		ls_caja

if getrow() > 0 then
//	MIAR 				= DATE(EM_1.TEXT)
	ll_pos				= pos(ddplb_caja.text,'-')
//	ls_caja			= trim(mid(ddplb_caja.text,1,(ll_pos - 1)))
	This.SelectRow(0, false)
	This.SelectRow(getrow(), true)
	ll_envio			= dw_cabecera.getitemnumber(dw_cabecera.getrow(),'nro_envio')
	if ll_envio >= 0 then
		MIAR 			= DATE(dw_cabecera.getitemdatetime(dw_cabecera.getrow(),'fecha_pago'))
		ls_caja		= dw_cabecera.getitemstring(dw_cabecera.getrow(),'cod_caja')
		il_item		= dw_cabecera.getitemnumber(dw_cabecera.getrow(),'item')
		dw_debe.retrieve(ls_caja, MIAR,il_item)
		dw_haber.retrieve(ls_caja, MIAR,il_item)
	end if
end if
end event

type dw_ingreso_sap from datawindow within tabpage_1
boolean visible = false
integer x = 2117
integer y = 660
integer width = 2363
integer height = 924
integer taborder = 30
string title = "none"
string dataobject = "dw_detalle_ingreso_pagos_sap"
boolean hscrollbar = true
boolean vscrollbar = true
boolean hsplitscroll = true
borderstyle borderstyle = stylelowered!
end type

event clicked;String		ls_columna,ls_filtro,ls_tipo_cob,ls_caja
Long		ll_tot_reg,ll_indi,ll_fila,ll_folio,ll_rut
Datetime	ldt_fecha_pago

ls_columna						= dwo.name
if row > 0 then
	il_fila_res					= row
	This.SelectRow(0, false)
	This.SelectRow(il_fila_res, true)
else
	if ls_columna = 't_grabar' then
		ll_tot_reg				= dw_ingreso_sap.rowcount()
		ll_fila						= dw_ingreso_sap.Find("estado_reg = 0",  1, ll_tot_reg)
		if ll_fila > 0 then
			ls_filtro				= "estado_reg = 0"
			dw_ingreso_sap.SETfilter(ls_filtro)
			dw_ingreso_sap.filter()
			ll_tot_reg			= dw_ingreso_sap.rowcount()
			for ll_indi=1 to ll_tot_reg
				ls_tipo_cob		= dw_ingreso_sap.getitemstring(ll_indi,'tipo_cob')
				ll_folio			= dw_ingreso_sap.getitemnumber(ll_indi,'folio')
				ldt_fecha_pago	= dw_ingreso_sap.getitemdatetime(ll_indi,'fecha_pago')
				ll_rut				= dw_ingreso_sap.getitemnumber(ll_indi,'rut')
				ls_caja			= dw_ingreso_sap.getitemstring(ll_indi,'caja')
				
				//   ver
				if il_estado_sap=0 then il_estado_sap=1
//				il_estado_sap	= 2
				if ll_folio > 0 then
					UPDATE 	"INGRESO"  
					SET 		"ESTADO_PAGO_SAP" = :il_estado_sap  
					WHERE ( "INGRESO"."FOLIO" = :ll_folio ) AND  
							  ( "INGRESO"."TIPO_COB" = :ls_tipo_cob ) AND  
							  ( "INGRESO"."FECHA_PAGO" = :ldt_fecha_pago ) AND  
							  ( "INGRESO"."RUT" = :ll_rut ) AND
							  ( "INGRESO"."COD_CAJA" = :ls_caja )
					USING	sqlca;
					if sqlca.sqlcode=0 then
						commit;
						UPDATE 	"DOCUMENTOS"  
						SET 		"ESTADO_PAGO_SAP" = :il_estado_sap 
						WHERE ( "DOCUMENTOS"."FOLIO" = :ll_folio ) AND  
								  ( "DOCUMENTOS"."TIPO_COB" = :ls_tipo_cob ) AND  
								  ( "DOCUMENTOS"."FECHA_PAGO" = :ldt_fecha_pago ) AND  
								  ( "DOCUMENTOS"."COD_CAJA" = :ls_caja ) 
						USING	sqlca;
						if sqlca.sqlcode=0 then
							commit; 
						else
							rollback;
							messagebox("Error Grabar","Error al Grabar ESTADO_PAGO_SAP en DOCUMENTOS SQL: "+sqlca.sqlerrtext)
						end if
					else
						rollback;
						messagebox("Error Grabar","Error al Grabar ESTADO_PAGO_SAP en INGRESO SQL: "+sqlca.sqlerrtext)
					end if
				end if
			next
			dw_ingreso_sap.SETfilter('')
			dw_ingreso_sap.filter()
			cb_aceptar.triggerevent(clicked!)
		else
			messagebox("Advertencia","Debe Seleccionar Registro para Grabar")
		end if
	end if
end if
end event

event rowfocuschanged;if getrow() > 0 then
	il_fila_res		= getrow()
	This.SelectRow(0, false)
	This.SelectRow(il_fila_res, true)
end if
end event

event doubleclicked;if row > 0 then
	gs_base 									= dw_ingreso_sap.GetItemString(row, "base")
	gs_serie 									= dw_ingreso_sap.GetItemString(row, "serie")
	gi_numero 								= dw_ingreso_sap.GetItemNumber(row, "numero")
	gi_rut 									= dw_ingreso_sap.GetItemNumber(row, "rut")
	SELECT	"CADENA"."ESTADO",		"CADENA"."COD_PARQUE", 		"CLIENTE"."NOMBRE",		"CLIENTE"."A_PATERNO",	"CLIENTE"."A_MATERNO", 	"CLIENTE"."DV"  
	INTO 		:gs_estado, 					:gl_cod_parque_cta,   			:gs_nombres,   			:gs_apellido_paterno,			:gs_apellido_materno,		:gs_dv
	FROM 	"CADENA",	"CLIENTE"  
	WHERE ( "CADENA"."RUT" = "CLIENTE"."RUT" ) and  
			( ( "CADENA"."CODIGO" = :gs_base ) AND  
			( "CADENA"."SERIE" = :gs_serie ) AND  
			( "CADENA"."NUMERO" = :gi_numero ) )   
	USING	sqlca;
	if not isnull(gs_base) and gi_numero>0 then
		CHOOSE CASE gs_base
			CASE "O" 	// Oferta
				if isvalid(w_cuenta_corriente_oferta) then close(w_cuenta_corriente_oferta)
				Open(w_cuenta_corriente_oferta)
			CASE "L" 	// Anexo Liberador
				if isvalid(w_cuenta_corriente_liberador) then close(w_cuenta_corriente_liberador)
				Open(w_cuenta_corriente_liberador)
			CASE "P" 	// Pagaré
				if isvalid(w_cuenta_corriente_pagare) then close(w_cuenta_corriente_pagare)
				Open(w_cuenta_corriente_pagare)
			CASE "C" 	// Contrato ISA
				if isvalid(w_cuenta_corriente_contrato_isa) then close(w_cuenta_corriente_contrato_isa)
				Open(w_cuenta_corriente_contrato_isa)
			CASE "D" 	// Derecho Especial
				if isvalid(w_cuenta_corriente_derecho) then close(w_cuenta_corriente_derecho)
				Open(w_cuenta_corriente_derecho)
			CASE "R" 	// Repactación Ctas.Mantencion
				if isvalid(w_cuenta_corriente_repactar_cta_mant) then close(w_cuenta_corriente_repactar_cta_mant)
				Open(w_cuenta_corriente_repactar_cta_mant)
			CASE "A"
				if isvalid(w_cuenta_corriente_aumento_capacidad) then close(w_cuenta_corriente_aumento_capacidad)
				Open(w_cuenta_corriente_aumento_capacidad)
			CASE "F"
				if isvalid(w_cuenta_corriente_funeraria) then close(w_cuenta_corriente_funeraria)
				Open(w_cuenta_corriente_funeraria)
		END CHOOSE
	end if
end if
end event

