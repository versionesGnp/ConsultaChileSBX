event clicked;tab_1.tabpage_1.dw_ingreso.reset()
tab_1.tabpage_1.dw_ingreso_sap.reset()
tab_1.tabpage_1.dw_cabecera.reset()
tab_1.tabpage_1.dw_debe.reset()
tab_1.tabpage_1.dw_haber.reset()
cbx_asiento_pend.checked	= false
end event

type cb_centralizar from commandbutton within tabpage_1
integer x = 3424
integer y = 1632
integer width = 494
integer height = 112
integer taborder = 130
integer textsize = -8
integer weight = 400
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string text = "Crear Centralización"
end type

event clicked;long		ll_tot_reg,ll_indi,ll_count,ll_item,ll_estado_sap,ll_pos,ll_tot_filas,ll_indi_det,ll_estado,ll_folio_det,ll_rut_det,ll_nro_envio,ll_count_sap
String		ls_caja,ls_moneda,ls_sociedad,ls_ref_cont1,ls_caja_consulta,ls_tipo_cob_det,ls_caja_det,ls_waers
date		ldt_fecha_pago,MIAR
Datetime	ldt_fecha_det
Double	ll_total_debe,ll_total_haber
long		ret
Inet		iinet_base

if dw_debe.rowcount() > 0 and dw_haber.rowcount() > 0 then
	MIAR 						= DATE(EM_1.TEXT)
	ll_pos						= pos(ddplb_caja.text,'-')
	ls_caja_consulta		= trim(mid(ddplb_caja.text,1,(ll_pos - 1)))
	ll_total_debe			= dw_debe.getitemnumber(1,'c_suma_total')
	ll_total_haber			= dw_haber.getitemnumber(1,'c_suma_total')
	if ll_total_debe > 0 and ll_total_haber > 0 and ll_total_debe = ll_total_haber then
		ll_tot_reg				= dw_cabecera.rowcount()
		if ll_tot_reg > 0  then
			ll_indi					= dw_cabecera.getrow()
			ls_moneda			= dw_cabecera.getitemstring(ll_indi,'moneda')
			ls_sociedad			= dw_cabecera.getitemstring(ll_indi,'sociedad')
			ll_item				= dw_cabecera.getitemnumber(ll_indi,'item')
			ls_ref_cont1			= dw_cabecera.getitemstring(ll_indi,'ref_caja_contable1')
			ldt_fecha_pago		= date(dw_cabecera.getitemdatetime(ll_indi,'fecha_pago'))
			ls_caja				= dw_cabecera.getitemstring(ll_indi,'cod_caja')
			ll_estado_sap		= dw_cabecera.getitemnumber(ll_indi,'estado_sap')
			ll_nro_envio			= dw_cabecera.getitemnumber(ll_indi,'nro_envio')
			if ll_estado_sap = 3 then
				UPDATE 	"SAP_CABECERA_PAGOS"  
				SET 		"ESTADO_SAP" = 8  
				WHERE ( "SAP_CABECERA_PAGOS"."FECHA_PAGO" = :ldt_fecha_pago ) AND  
						  ( "SAP_CABECERA_PAGOS"."SOCIEDAD" = :ls_sociedad ) AND  
						  ( "SAP_CABECERA_PAGOS"."MONEDA" = :ls_moneda ) AND  
						  ( "SAP_CABECERA_PAGOS"."REF_CAJA_CONTABLE1" = :ls_ref_cont1 ) AND  
						  ( "SAP_CABECERA_PAGOS"."ESTADO_SAP" = :ll_estado_sap ) AND  
						  ( "SAP_CABECERA_PAGOS"."COD_CAJA" = :ls_caja ) AND  
						  ( "SAP_CABECERA_PAGOS"."ITEM" = :ll_item )  AND 
						  ( "SAP_CABECERA_PAGOS"."NRO_DOC_CONTABLE_SAP" IS NULL ) AND
						  ( "SAP_CABECERA_PAGOS"."NRO_ENVIO" = :ll_nro_envio )
				USING		sqlca;
				if sqlca.sqlcode=0 then
					commit;
					ll_count ++
				else
					rollback;
					messagebox("Advertencia","No Actualizó Estado SAP_CABECERA_PAGOS"+sqlca.sqlerrtext)
				end if
			elseif ll_estado_sap = 4 then
				UPDATE 	"SAP_CABECERA_PAGOS"  
				SET 		"ESTADO_SAP" = 9  
				WHERE ( "SAP_CABECERA_PAGOS"."FECHA_PAGO" = :ldt_fecha_pago ) AND  
						  ( "SAP_CABECERA_PAGOS"."SOCIEDAD" = :ls_sociedad ) AND  
						  ( "SAP_CABECERA_PAGOS"."MONEDA" = :ls_moneda ) AND  
						  ( "SAP_CABECERA_PAGOS"."REF_CAJA_CONTABLE1" = :ls_ref_cont1 ) AND  
						  ( "SAP_CABECERA_PAGOS"."ESTADO_SAP" = :ll_estado_sap ) AND  
						  ( "SAP_CABECERA_PAGOS"."COD_CAJA" = :ls_caja ) AND  
						  ( "SAP_CABECERA_PAGOS"."ITEM" = :ll_item )  AND 
						  ( "SAP_CABECERA_PAGOS"."NRO_DOC_CONTABLE_SAP" IS NULL ) AND
						  ( "SAP_CABECERA_PAGOS"."NRO_ENVIO" = :ll_nro_envio )
				USING		sqlca;
				if sqlca.sqlcode=0 then
					commit;
					ll_count ++
				else
					rollback;
					messagebox("Advertencia","No Actualizó Estado SAP_CABECERA_PAGOS"+sqlca.sqlerrtext)
				end if
			end if
			if ll_item = 1 then
				ls_waers		= 'CLP'
			else
				ls_waers		= 'UF'
			end if
			ll_count_sap			= 1
			
			if tab_1.tabpage_1.dw_cabecera.retrieve(ls_caja_consulta,MIAR) > 0 then
				tab_1.tabpage_1.dw_cabecera.scrolltorow(1)
				tab_1.tabpage_1.dw_cabecera.setfocus()
				ll_item			= tab_1.tabpage_1.dw_cabecera.getitemnumber(1,'item')
				tab_1.tabpage_1.dw_debe.retrieve(ls_caja,MIAR,ll_item)
				tab_1.tabpage_1.dw_haber.retrieve(ls_caja,MIAR,ll_item)
			else
				tab_1.tabpage_1.dw_debe.reset()
				tab_1.tabpage_1.dw_haber.reset()
			end if
			if ll_count > 0 then
				messagebox("Generar Centralización SAP","Generación Exitosa")
			end if
		end if
	else
		messagebox("Advertencia","Recuerde que Suma Total Debe y Haber deben ser Iguales")
	end if
end if
end event

type st_4 from statictext within tabpage_1
integer x = 32
integer y = 32
