event open;datetime		fecha_aux
String			ls_caja, ls_descrip

connect using Trans_1;
connect using Trans_2;
connect using Trans_hana;
tab_1.tabpage_1.cbx_asiento_pend.checked	= false
gf_centrar(w_sap_detalle_pagos_caja_2)
fecha_aux						= datetime(today())
em_1.text 						= String(Today(), "dd/mm/yyyy")
tab_1.tabpage_1.dw_ingreso.settransobject(sqlca)
tab_1.tabpage_1.dw_ingreso_sap.settransobject(sqlca)
tab_1.tabpage_1.dw_cabecera.settransobject(sqlca)
tab_1.tabpage_1.dw_debe.settransobject(sqlca)
tab_1.tabpage_1.dw_haber.settransobject(sqlca)
tab_1.tabpage_2.dw_cliente_rezago.settransobject(sqlca)
//tab_1.tabpage_3.dw_hana_clientefi.settransobject(Trans_hana)
tab_1.tabpage_4.dw_hana_centraliza.settransobject(Trans_hana)

dw_hana_cliente.settransobject(Trans_hana)
dw_hana_ctto.settransobject(Trans_hana)

//tab_1.tabpage_2.dw_cliente_rezago.retrieve(3,'R')
//tab_1.tabpage_3.dw_hana_clientefi.retrieve()
//tab_1.tabpage_4.dw_hana_centraliza.retrieve()
ddplb_caja.setfocus()
ddplb_caja.reset()
//ddplb_caja.additem('TODAS')
//ddplb_caja.text	= 'TODAS'
DECLARE x1 CURSOR FOR  
SELECT		"CODIGO_CAJAS"."COD_CAJA",   
				"CODIGO_CAJAS"."GLS_CAJA"  
FROM 		"CODIGO_CAJAS"  
WHERE 		"CODIGO_CAJAS"."EFECTO_FLUJO" = 'S'   
ORDER BY 	"CODIGO_CAJAS"."COD_CAJA" ASC   
USING		sqlca;
open x1;
if sqlca.sqlcode=0 then
	DO WHILE sqlca.sqlcode=0
		fetch x1 into :ls_caja, :ls_descrip;
		if not isnull(ls_caja) and ls_caja<>'' then
			ddplb_caja.additem(ls_caja + ' - ' +ls_descrip)
		end if
		Setnull(ls_caja)
	LOOP
end if
close x1;
end event

event close;disconnect using Trans_1;
disconnect using Trans_2;
disconnect using Trans_hana;
end event

