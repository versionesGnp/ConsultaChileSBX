			ls_centro_benef,ls_cod_mat_sap,ls_almacen,ls_sector,ls_sepult,ls_nro_tecnico,ls_fecha,ls_moneda,ls_clasif,ls_cod_jef,&
			ls_cod_sup,ls_cod_age,ls_area,ls_grupo_imput,ls_nro_ctto_sap,ls_ctto_asociado,ls_ctto_serv,ls_nro_cliente,ls_ok,&
			ls_folio_consul,ls_consul_nro_sap,ls_carga,ls_tipo_carga,ls_pasa='N',ls_tipo_serv
long		ret,ll_tot_reg,ll_fila,ll_res,ll_indi,ll_folio,ll_ctas_pact,ll_periodo_m,ll_cta_pag_s,ll_plazo,ll_posic_ubs,ll_estado_cab,ll_estado_ubs,ll_estado_pie,ll_estado_cta,&
			ll_mora_recon,ll_fallec,ll_capac,ll_graba,ll_no_graba=0,ll_plazo_dc,ll_estado,ll_existe,ll_cta
double	ldb_tot_porc=0,ldb_tot_porc_aux=0,ldb_numero,ldb_pie,ldb_pie_pag,ldb_cuota_m,ldb_tasa,ldb_rut,ldb_precio_dc,ldb_pie_dc,ldb_tasa_dc,ldb_val_cta_dc,ldb_gto_adm_dc,ldb_rut_aval
datetime	ldt_fecha_ctto,ldt_fec_pie,ldt_fecha_m,ldt_fec_prim_dc,ldt_fec_pago

Inet  iinet_base
ret = GetContextService("Internet", iinet_base)

dw_contrato.accepttext()
ll_tot_reg									= dw_contrato.rowcount()
if ll_tot_reg=0 then
	messagebox("Advertencia","No Registra Cliente par Carga SAP")
else
	ll_fila 										= dw_contrato.Find("estado_reg = 1",1, ll_tot_reg)
	if ll_fila=0 then 
		messagebox("Advertencia","Debe Seleccionar Clientes para Traspaso A SAP")
	else
		ll_res									= MessageBox("Advertencia","¿Desea Generar Traspaso de Contratos a SAP?", Exclamation!, YesNo!, 2)
		if ll_res=1 then
			dw_contrato.accepttext()
			dw_contrato.setFilter( "estado_reg = 1")
			dw_contrato.filter()
			dw_contrato.accepttext()
			ll_tot_reg						= dw_contrato.rowcount()
			SetPointer(HourGlass!)
			for	ll_indi=1 to ll_tot_reg
				is_obsev_tot					= ''
				ls_nro_cliente				= dw_contrato.getitemstring(ll_indi,'nro_cliente_sap')
				ls_base						= dw_contrato.getitemstring(ll_indi,'base')
				ls_serie						= dw_contrato.getitemstring(ll_indi,'serie')
				ldb_numero					= dw_contrato.getitemnumber(ll_indi,'numero')
				ls_tipo_deuda				= dw_contrato.getitemstring(ll_indi,'tipo_deuda')
				
				ls_tipo_ctto					= dw_contrato.getitemstring(ll_indi,'tipo_ctto')
				ls_organiz					= dw_contrato.getitemstring(ll_indi,'organiz')
				ls_origen_vta				= dw_contrato.getitemstring(ll_indi,'origen_venta')
				ls_uso						= dw_contrato.getitemstring(ll_indi,'uso')
				
//				ldt_fecha_ctto				= dw_contrato.getitemdatetime(ll_indi,'fecha_ctto')
				ldt_fec_pago				= dw_contrato.getitemdatetime(ll_indi,'fecha_pago')
				ll_folio						= dw_contrato.getitemnumber(ll_indi,'folio_coprob')
				ls_tipo_cob					= dw_contrato.getitemstring(ll_indi,'tipo_cob')
				
				ldb_pie						= dw_contrato.getitemnumber(ll_indi,'pie')
				ldb_pie_pag					= dw_contrato.getitemnumber(ll_indi,'pie_pagado')
				
				ll_ctas_pact					= dw_contrato.getitemnumber(ll_indi,'ctas_pactadas_pie')
				//ldt_fec_pie					= dw_contrato.getitemdatetime(ll_indi,'fecha_pie')
				ldb_rut_aval					= dw_contrato.getitemnumber(ll_indi,'rut_aval')
				ldb_cuota_m				= dw_contrato.getitemnumber(ll_indi,'valor_cuota_m')
				ldt_fecha_m					= dw_contrato.getitemdatetime(ll_indi,'fecha_m')
				ll_periodo_m				= dw_contrato.getitemnumber(ll_indi,'perio_mant')
				ll_cta_pag_s					= dw_contrato.getitemnumber(ll_indi,'cta_pag_s')
				ldb_rut						= dw_contrato.getitemnumber(ll_indi,'rut')
				ls_forma_pago				= dw_contrato.getitemstring(ll_indi,'forma_pago')
				ls_centro						= dw_contrato.getitemstring(ll_indi,'centro')
				ls_centro_benef			= dw_contrato.getitemstring(ll_indi,'centro_benef')
				ls_cod_mat_sap			= dw_contrato.getitemstring(ll_indi,'codigo_material_sap')
				ls_almacen					= dw_contrato.getitemstring(ll_indi,'almacen')
				ls_sector						= dw_contrato.getitemstring(ll_indi,'sector')
				ls_sepult						= dw_contrato.getitemstring(ll_indi,'sepultura')
				ls_nro_tecnico				= dw_contrato.getitemstring(ll_indi,'nro_tecnico')
				ll_plazo						= dw_contrato.getitemnumber(ll_indi,'nro_cuotas')
				ldb_tasa						= dw_contrato.getitemnumber(ll_indi,'tasa_ctto')
				ll_posic_ubs					= dw_contrato.getitemnumber(ll_indi,'nro_posic_ubs')
				ll_mora_recon				= dw_contrato.getitemnumber(ll_indi,'mora_mant_recon')
				
				ls_fecha						= dw_contrato.getitemstring(ll_indi,'fecha')
				ls_moneda					= dw_contrato.getitemstring(ll_indi,'moneda')
				ls_clasif						= dw_contrato.getitemstring(ll_indi,'clasifica_venta')
				ll_fallec						= dw_contrato.getitemnumber(ll_indi,'fallecidos')
				ls_cod_jef					= dw_contrato.getitemstring(ll_indi,'cod_jef')
				ls_cod_sup					= dw_contrato.getitemstring(ll_indi,'cod_sup')
				ls_cod_age					= dw_contrato.getitemstring(ll_indi,'cod_age')
				ls_area						= dw_contrato.getitemstring(ll_indi,'area')
				ll_capac						= dw_contrato.getitemnumber(ll_indi,'capacidad')
				ls_grupo_imput				= dw_contrato.getitemstring(ll_indi,'grupo_imputacion')
				ls_nro_ctto_sap			= dw_contrato.getitemstring(ll_indi,'nro_ctto_sap')
				ls_ctto_asociado			= dw_contrato.getitemstring(ll_indi,'ctto_asociado')
				ls_folio_consul				= ls_base+ls_serie+string(ldb_numero)
				ls_tipo_carga				= dw_contrato.getitemstring(ll_indi,'tipo_carga')
				ls_tipo_serv					= dw_contrato.getitemstring(ll_indi,'tipo_serv')
				gl_cod_parque				= dw_contrato.getitemnumber(ll_indi,'cod_parque')
				ls_folio						= string(ll_folio)
				ls_consul_nro_sap			= f_vista_ctto_sap(gs_mandatario,ls_tipo_ctto,ls_organiz,ls_origen_vta,ls_uso,ls_folio_consul,ls_tipo_deuda,ls_folio)
				if isnull(ls_consul_nro_sap) or ls_consul_nro_sap='' then
					ll_existe					= f_sap_cadena(ls_tipo_deuda,ls_base,ls_serie,ldb_numero,ll_folio)
					if ll_existe>0 then
						if ret = -1 then
							messagebox('No hay servicio','No hay servidor disponible de internet',stopsign!)
							return
						end if
						if gs_sap_conex='P' then
							if gl_cod_parque=104 then
								ret 				= iinet_base.HyperlinkToURL("http://50.50.50.192/nusoap/contrato.php?conexion=N")
							elseif gl_cod_parque=11 then
								ret 				= iinet_base.HyperlinkToURL("http://50.50.50.192/nusoap/contrato.php?conexion=F")
							else
								ret 				= iinet_base.HyperlinkToURL("http://50.50.50.192/nusoap/contrato.php?conexion=P")
							end if
						elseif gs_sap_conex='Q' then
							if gl_cod_parque=104 then
								ret 				= iinet_base.HyperlinkToURL("http://50.50.50.192/nusoap/contrato.php?conexion=QN")
							elseif gl_cod_parque=11 then
								ret 				= iinet_base.HyperlinkToURL("http://50.50.50.192/nusoap/contrato.php?conexion=QF&contrato="+ls_base+ls_serie+string(ldb_numero)+"&tipo="+ls_tipo_deuda+"&cerrar=si&cobro="+ls_tipo_cob+"&folio="+string(ll_folio)+"")
							else
								ret 				= iinet_base.HyperlinkToURL("http://50.50.50.192/nusoap/contrato.php?conexion=QP&contrato="+ls_base+ls_serie+string(ldb_numero)+"&tipo="+ls_tipo_deuda+"&cerrar=si&cobro="+ls_tipo_cob+"&folio="+string(ll_folio)+"")
							end if
						elseif gs_sap_conex='R' then
							if gl_cod_parque=104 then
								ret 				= iinet_base.HyperlinkToURL("http://50.50.50.192/nusoap/contrato.php?conexion=RN")
							elseif gl_cod_parque=11 then
								ret 				= iinet_base.HyperlinkToURL("http://50.50.50.192/nusoap/contrato.php?conexion=RF&contrato="+ls_base+ls_serie+string(ldb_numero)+"&tipo="+ls_tipo_deuda+"&cerrar=si&cobro="+ls_tipo_cob+"&folio="+string(ll_folio)+"")
							else
								ret 				= iinet_base.HyperlinkToURL("http://50.50.50.192/nusoap/contrato.php?conexion=RP&contrato="+ls_base+ls_serie+string(ldb_numero)+"&tipo="+ls_tipo_deuda+"&cerrar=si&cobro="+ls_tipo_cob+"&folio="+string(ll_folio)+"")
							end if	
						end if
						
						f_reg_x_segundo('CTTO',1000000)
						
						UPDATE "SAP_CADENA_SERVICIO"  
						SET 		"FECHA_SAP" = :gdt_fec_sistema
						WHERE	( "SAP_CADENA_SERVICIO"."BASE" = :ls_base ) AND  
									( "SAP_CADENA_SERVICIO"."SERIE" = :ls_serie ) AND  
									( "SAP_CADENA_SERVICIO"."NUMERO" = :ldb_numero ) AND  
									( "SAP_CADENA_SERVICIO"."TIPO_DEUDA" = :ls_tipo_deuda )
						USING	sqlca;
						if sqlca.sqlcode=0 then
							commit using sqlca;
						else
							rollback using sqlca;
						end if
					end if
				end if
			next
			dw_contrato.retrieve()
			SetPointer(Arrow!)
			messagebox("Grabar",'Proceso Terminado :~r~n'+string(ll_graba,'###,###,##0')+' Clientes Grabados con Exito en SAP~r~n'+&
										'y '+string(ll_no_graba,'###,###,##0')+' Clientes No Grabados.',information!)
		end if
	end if
end if
end event

type cb_actualiza_ctto_sap from commandbutton within tabpage_8
integer x = 3831
integer y = 1520
integer width = 658
integer height = 112
integer taborder = 70
integer textsize = -9
integer weight = 400
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string text = "Actualiza Contrato - SAP"
end type

event clicked;Long		ll_rut,ll_estado,ll_tot_reg,ll_graba=0,ll_folio,ll_no_graba=0,ll_cta_reg_vista,ll_cta_ubs,ll_cta_cta,ll_cta_pos_ora
String		ls_base, ls_serie, ls_tipo_deuda, ls_tipo, ls_tipo_ctto, ls_organizacion, ls_tipo_venta, ls_uso,ls_consul_nro_sap,ls_material,&
			ls_tipo_cob,ls_cod_otro,ls_tipo_mov,ls_boleta,ls_folio_consulta,ls_folio_sap,ls_obsev,ls_moneda
double	ldb_tot_porc=0,ldb_tot_porc_aux=0,ll_cttos=0,ldb_numero,ldb_sum_mto_sap,ldb_decimal,ldb_sum_cta
datetime	ldt_fec_pago

SELECT 	count("SAP_CADENA_SERVICIO"."BASE")
INTO		:ll_tot_reg
FROM 	"SAP_CADENA_SERVICIO","SAP_CTTO_05_CUOTA"  
WHERE 	"SAP_CADENA_SERVICIO"."BASE" = "SAP_CTTO_05_CUOTA"."BASE" AND
			"SAP_CADENA_SERVICIO"."SERIE" = "SAP_CTTO_05_CUOTA"."SERIE" AND
			"SAP_CADENA_SERVICIO"."NUMERO" = "SAP_CTTO_05_CUOTA"."NUMERO" AND
			"SAP_CADENA_SERVICIO"."TIPO_DEUDA" = "SAP_CTTO_05_CUOTA"."TIPO_DEUDA" AND
			"SAP_CADENA_SERVICIO"."FOLIO_COMPROBANTE" = TO_NUMBER("SAP_CTTO_05_CUOTA"."NRO_BOLETA") AND
			"SAP_CADENA_SERVICIO"."TIPO_DEUDA" = 'S' AND
			("SAP_CADENA_SERVICIO"."NRO_CONTRATO_SAP" is null or ("SAP_CADENA_SERVICIO"."NRO_CONTRATO_SAP" is not null and "SAP_CADENA_SERVICIO"."FOLIO_CONSULTA_SAP" is null))
USING	sqlca ;
if isnull(ll_tot_reg) then ll_tot_reg=0
if ll_tot_reg=0 then
	messagebox("Advertencia","No Registra Contratos para Actualizar")
else
	SetPointer(HourGlass!)
	ll_graba											= 0
	DECLARE x1 CURSOR FOR  
	SELECT "SAP_CADENA_SERVICIO"."BASE",   
				"SAP_CADENA_SERVICIO"."SERIE",   
				"SAP_CADENA_SERVICIO"."NUMERO",   
				"SAP_CADENA_SERVICIO"."TIPO_DEUDA",   
				"SAP_CADENA_SERVICIO"."TIPO_CONTRATO",   
				"SAP_CADENA_SERVICIO"."ORGANIZACION",   
				"SAP_CADENA_SERVICIO"."TIPO_VENTA",   
				"SAP_CADENA_SERVICIO"."USO",
				"SAP_CADENA_SERVICIO"."FOLIO_COMPROBANTE",
				"SAP_CADENA_SERVICIO"."FECHA_PAGO_COMPROBANTE",
				"SAP_CTTO_05_CUOTA"."CODIGO_MATERIAL_SAP",
				"SAP_CADENA_SERVICIO"."TIPO_COB_COMPROBANTE",
				"SAP_CADENA_SERVICIO"."FOLIO_CONSULTA" AS FOLIO_CONSULTA_SAP,
				"SAP_CADENA_SERVICIO"."MONEDA"
				
	FROM 	"SAP_CADENA_SERVICIO","SAP_CTTO_05_CUOTA"  
	WHERE 	"SAP_CADENA_SERVICIO"."BASE" = "SAP_CTTO_05_CUOTA"."BASE" AND
				"SAP_CADENA_SERVICIO"."SERIE" = "SAP_CTTO_05_CUOTA"."SERIE" AND
				"SAP_CADENA_SERVICIO"."NUMERO" = "SAP_CTTO_05_CUOTA"."NUMERO" AND
				"SAP_CADENA_SERVICIO"."TIPO_DEUDA" = "SAP_CTTO_05_CUOTA"."TIPO_DEUDA" AND
				"SAP_CADENA_SERVICIO"."FOLIO_COMPROBANTE" = TO_NUMBER("SAP_CTTO_05_CUOTA"."NRO_BOLETA") AND
				"SAP_CADENA_SERVICIO"."TIPO_DEUDA" = 'S' and
				("SAP_CADENA_SERVICIO"."NRO_CONTRATO_SAP" is null or ("SAP_CADENA_SERVICIO"."NRO_CONTRATO_SAP" is not null and "SAP_CADENA_SERVICIO"."FOLIO_CONSULTA_SAP" is null))
	USING	Trans_1 ;
	open x1;
	if Trans_1.sqlcode=0 then
		do while Trans_1.sqlcode=0
		fetch x1 into :ls_base, :ls_serie, :ldb_numero, :ls_tipo_deuda, :ls_tipo_ctto, :ls_organizacion, :ls_tipo_venta, :ls_uso,	:ll_folio,	:ldt_fec_pago,:ls_material,:ls_tipo_cob,:ls_folio_consulta,:ls_moneda;
			if not isnull(ls_base) and ls_base<>'' and not isnull(ls_serie) and ls_serie<>''  and not isnull(ldb_numero) and ldb_numero>0 and not isnull(ls_tipo_deuda) and ls_tipo_deuda<>'' and not isnull(ll_folio) and ll_folio>0 then
				ls_boleta						= string(ll_folio)
				if ls_moneda = 'CLP' then
				  ldb_decimal            		= 1
				elseif ls_moneda = 'UF' then
					ldb_decimal           	= 0.0001
				elseif ls_moneda = 'USD' then
				  ldb_decimal            		= 1
				elseif ls_moneda = 'BOB' then
					ldb_decimal            	= 1
				end if
				
				SELECT	"CODIGO_OTRO",	"TIPO_MOV"  
				INTO		:ls_cod_otro,		:ls_tipo_mov  
				FROM		"SAP_SERVICIOS_CREACION"  
				WHERE	"SAP_SERVICIOS_CREACION"."BASE" = 'S' AND  
							"SAP_SERVICIOS_CREACION"."TIPO_COB" = :ls_tipo_cob AND  
							//"SAP_SERVICIOS_CREACION"."TIPO_MOV" = :ls_tipo_mov AND  
							"SAP_SERVICIOS_CREACION"."COD_MATERIAL_SAP" = :ls_material
				USING	sqlca;
				if isnull(ls_cod_otro) then ls_cod_otro=''
				if isnull(ls_tipo_mov) then ls_tipo_mov=''
				
//				SELECT	count("BASE")  
//				INTO		:ll_cta_ubs
//				FROM 	"SAP_CTTO_03_UBS"
//				WHERE 	"SAP_CTTO_03_UBS"."BASE" = :ls_base and
//							"SAP_CTTO_03_UBS"."SERIE" = :ls_serie and
//							"SAP_CTTO_03_UBS"."NUMERO" = :ldb_numero and
//							"SAP_CTTO_03_UBS"."TIPO_DEUDA" = :ls_tipo_deuda and
//							"SAP_CTTO_03_UBS"."FOLIO" = :ll_folio
//				USING	sqlca;
				if isnull(ll_cta_ubs) then ll_cta_ubs=0
							
				SELECT	count("BASE"),sum("SAP_CTTO_05_CUOTA"."MTO_CTA_K" + "SAP_CTTO_05_CUOTA"."MTO_CTA_I" + "SAP_CTTO_05_CUOTA"."MTO_CTA_G")
				INTO		:ll_cta_cta,:ldb_sum_cta
				FROM		"SAP_CTTO_05_CUOTA"
				WHERE 	"SAP_CTTO_05_CUOTA"."BASE" = :ls_base and
							"SAP_CTTO_05_CUOTA"."SERIE" = :ls_serie and
							"SAP_CTTO_05_CUOTA"."NUMERO" = :ldb_numero and
							"SAP_CTTO_05_CUOTA"."TIPO_DEUDA" = :ls_tipo_deuda and
							"SAP_CTTO_05_CUOTA"."NRO_BOLETA" = :ls_boleta
				USING	sqlca;
				if isnull(ll_cta_cta) then ll_cta_cta=0
				if isnull(ldb_sum_cta) then ldb_sum_cta=0

				ll_cta_pos_ora						= ll_cta_ubs + ll_cta_cta
				

				
				SELECT DISTINCT	"SAPABAP1"."ZV_CONTRATOS2"."NUM_CONTRATO",
										"SAPABAP1"."ZV_CONTRATOS2"."FOLIO_CONSULTA", 
										COUNT( DISTINCT "SAPABAP1"."ZV_CONTRATOS2"."NRO_POSICION"),
										SUM( "SAPABAP1"."ZV_CONTRATOS2"."MTO_IMPUESTO")
				INTO		:ls_consul_nro_sap, :ls_folio_sap, :ll_cta_reg_vista,	:ldb_sum_mto_sap
				FROM 	"SAPABAP1"."ZV_CONTRATOS2"
				WHERE	"SAPABAP1"."ZV_CONTRATOS2"."MANDTE" = :gs_mandatario AND
							"SAPABAP1"."ZV_CONTRATOS2"."TIPO_CCTO" = :ls_tipo_ctto AND
							"SAPABAP1"."ZV_CONTRATOS2"."ORG_VENTAS" = :ls_organizacion AND
							"SAPABAP1"."ZV_CONTRATOS2"."ORIGEN_VTA" = :ls_tipo_venta AND
							"SAPABAP1"."ZV_CONTRATOS2"."USO" = :ls_uso AND
							"SAPABAP1"."ZV_CONTRATOS2"."BOLETA" = :ls_boleta AND
							//"SAPABAP1"."ZV_CONTRATOS2"."NUM_MATERIAL" = :ls_material AND
							//"SAPABAP1"."ZV_CONTRATOS2"."TIPO_INTERES" <> 'VPRS' AND
							"SAPABAP1"."ZV_CONTRATOS2"."FOLIO_CONSULTA" = :ls_folio_consulta
							
				GROUP BY 	"SAPABAP1"."ZV_CONTRATOS2"."NUM_CONTRATO",
								"SAPABAP1"."ZV_CONTRATOS2"."FOLIO_CONSULTA"
				USING	Trans_hana;
				if isnull(ls_consul_nro_sap) or ls_consul_nro_sap='' then ls_consul_nro_sap=''
				if isnull(ldb_sum_mto_sap) then ldb_sum_mto_sap=0
				if not isnull(ls_consul_nro_sap) and ls_consul_nro_sap<>'' then
					ldb_sum_mto_sap				= ldb_sum_mto_sap * ldb_decimal
					
					if ll_cta_reg_vista=ll_cta_pos_ora then
						ls_obsev						= 'Grabación Exitosa, Posic. ORA: '+string(ll_cta_pos_ora)+' Posic. SAP: '+string(ll_cta_reg_vista)+' Monto ORA: '+string(ldb_sum_cta)+' Monto SAP: '+string(ldb_sum_mto_sap)	
					else
						ls_obsev						= 'Error, Posic. Enviadas: '+string(ll_cta_pos_ora)+' Posic. Creadas en SAP: '+string(ll_cta_reg_vista)
					end if
					
					UPDATE	"SAP_CADENA_SERVICIO"  
     				SET		//"NRO_CONTRATO_SAP" = :ls_consul_nro_sap,   
         						//"FECHA_SAP" = :gdt_fec_sistema,
								//"ESTADO" = 1,	
								"CUENTA_REG_VISTA" =	 :ll_cta_reg_vista,
								"FOLIO_CONSULTA_SAP" =:ls_folio_sap,
								"OBSERV_POSICION" = :ls_obsev
								
					WHERE	( "SAP_CADENA_SERVICIO"."BASE" = :ls_base ) AND  
								( "SAP_CADENA_SERVICIO"."SERIE" = :ls_serie ) AND  
								( "SAP_CADENA_SERVICIO"."NUMERO" = :ldb_numero ) AND  
								( "SAP_CADENA_SERVICIO"."TIPO_DEUDA" = :ls_tipo_deuda ) AND  
								( "SAP_CADENA_SERVICIO"."FOLIO_COMPROBANTE" = :ll_folio ) AND  
								( "SAP_CADENA_SERVICIO"."TIPO_COB_COMPROBANTE" = :ls_tipo_cob ) AND  
								( "SAP_CADENA_SERVICIO"."FECHA_PAGO_COMPROBANTE" = :ldt_fec_pago )
					USING	sqlca;
					if sqlca.sqlcode = 0 then
						commit using sqlca;
						ll_graba++
						UPDATE	"INGRESO"  
						SET		"ESTADO_SAP" = 1  
						WHERE	"INGRESO"."FOLIO" = :ll_folio AND
									"INGRESO"."TIPO_COB" = :ls_tipo_cob AND
									"INGRESO"."TIPO_MOV" = :ls_tipo_mov AND  
									"INGRESO"."FECHA_PAGO" = :ldt_fec_pago AND
									"INGRESO"."BASE" = :ls_base AND  
									"INGRESO"."SERIE" = :ls_serie AND  
									"INGRESO"."CONTRATO" = :ldb_numero AND
									"INGRESO"."CODIGO_OTRO" = :ls_cod_otro
						USING	Trans_2;
						if Trans_2.sqlcode = 0 then
							commit using Trans_2;
						else
							rollback using Trans_2;
						end if
					else
						rollback using sqlca;
						ll_no_graba++
					end if
				end if
			end if
			setnull(ls_base);setnull(ls_serie);setnull(ldb_numero);setnull(ls_tipo_deuda);setnull(ls_tipo_ctto);setnull(ls_organizacion);setnull(ls_tipo_venta);setnull(ls_uso);setnull(ll_folio);setnull(ldt_fec_pago);setnull(ls_material);setnull(ls_tipo_cob);setnull(ls_folio_consulta)
			setnull(ls_consul_nro_sap);setnull(ls_folio_sap);setnull(ll_cta_reg_vista);setnull(ls_cod_otro);setnull(ls_tipo_mov)  
			
		loop	
	end if
	close x1;
	messagebox("Grabar",'Proceso terminado :~r~n'+string(ll_graba,'###,###,##0')+' registros grabados con exito~r~n'+&
								'y '+string(ll_no_graba,'###,###,##0')+' registros con problemas.',information!)
end if
end event

type pb_buscar from picturebutton within tabpage_8
integer x = 2034
integer y = 1636
integer width = 119
integer height = 104
integer taborder = 200
integer textsize = -8
integer weight = 400
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string picturename = "LUPA.BMP"
end type

event clicked;Long		ll_folio,ll_pos
String		ls_string

ll_folio			= long(em_boleta.text)
if ll_folio > 0 then
	ls_string		= 'folio_coprob = '+string(ll_folio)
	ll_pos 		= dw_contrato.Find(ls_string, 1, dw_contrato.RowCount())
	if ll_pos > 0 then
		dw_contrato.scrolltorow(ll_pos)
		dw_contrato.setfocus()
	else
		messagebox("Advertencia","Folio Inexistente")
	end if
end if
end event

