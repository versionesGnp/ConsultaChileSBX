type cb_31 from commandbutton within tabpage_6
integer x = 2034
integer y = 1632
integer width = 343
integer height = 112
integer taborder = 210
integer textsize = -9
integer weight = 700
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string text = "Crear"
end type

event clicked;Long		ll_tot_reg,ll_indi,ll_monto,ll_fila,ll_pos
String		ls_cuenta,ls_boleta,ls_caja,ls_pasa='S'
date		MIAR

ll_tot_reg		= dw_boletas_deposito_ch.rowcount()
for ll_indi=1 to ll_tot_reg
	ls_boleta		= dw_boletas_deposito_ch.getitemstring(ll_indi,'boleta_deposito')
	ll_monto		= dw_boletas_deposito_ch.getitemnumber(ll_indi,'monto')
	if isnull(ls_boleta) or ls_boleta='' then
		messagebox("Advertencia","Debe Ingresar N° Boleta Depósito en Fila "+string(ll_indi))
		dw_boletas_deposito_ch.setfocus()
		dw_boletas_deposito_ch.scrolltorow(ll_indi)
		dw_boletas_deposito_ch.setcolumn('boleta_deposito')
		ls_pasa	= 'N'
	elseif isnull(ll_monto) or ll_monto=0 then
		messagebox("Advertencia","Debe Ingresar Monto en Fila "+string(ll_indi))
		dw_boletas_deposito_ch.setfocus()
		dw_boletas_deposito_ch.scrolltorow(ll_indi)
		dw_boletas_deposito_ch.setcolumn('monto')
		ls_pasa	= 'N'
	end if
next
if ls_pasa = 'S' then
	MIAR 			= DATE(EM_1.TEXT)
	ll_pos			= pos(ddplb_caja.text,'-')
	ls_caja		= trim(mid(ddplb_caja.text,1,(ll_pos - 1)))

	ll_fila			= dw_boletas_deposito_ch.insertrow(0)
	dw_boletas_deposito_ch.scrolltorow(ll_fila)
	dw_boletas_deposito_ch.setitem(ll_fila,'cod_caja',ls_caja)
	dw_boletas_deposito_ch.setitem(ll_fila,'cod_pago','CH')
	dw_boletas_deposito_ch.setitem(ll_fila,'fecha_pago',MIAR)
	SELECT DISTINCT 	"SAP_CUENTAS_CONTABLES"."CUENTA_CONTABLE"  
	INTO		:ls_cuenta
	FROM 	"SAP_CUENTAS_CONTABLES"  
	WHERE ( "SAP_CUENTAS_CONTABLES"."COD_CAJA" =:ls_caja) AND  
			  ( "SAP_CUENTAS_CONTABLES"."COD_PAGO" = 'CH' ) AND  
			  ( "SAP_CUENTAS_CONTABLES"."ESTADO_CHEQUE" = 'DIA' )
	USING	sqlca;
	if sqlca.sqlcode=0 then
		dw_boletas_deposito_ch.setitem(ll_fila,'cuenta_contable',ls_cuenta)
	else
		messagebox("Advertencia","No se encontro Cuenta Contable")
	end if
	dw_boletas_deposito_ch.accepttext()
end if
end event

