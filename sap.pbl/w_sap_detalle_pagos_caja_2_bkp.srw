type cb_52 from commandbutton within w_sap_detalle_pagos_caja_2_bkp
integer x = 1906
integer y = 2232
integer width = 407
integer height = 100
integer taborder = 70
integer textsize = -8
integer weight = 700
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
