type cb_45 from commandbutton within w_sap_detalle_pagos_caja_2_bkp
integer x = 4640
integer y = 1072
integer width = 626
integer height = 100
integer taborder = 60
integer textsize = -8
integer weight = 700
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string text = "Actualizar Moneda SAP"
end type

event clicked;string		ls_base,ls_serie,ls_tipo_mov,ls_tipo_cob,ls_rezago,ls_cod_otros,ls_nro_ctto_sap,ls_tipo_deuda,ls_rez_sap,ls_moneda,ls_moneda_sap,ls_material,ls_pago_hist
long		ll_tot_reg,ll_res,ll_graba=0,ll_folio,ll_nro_cuota,ll_cta,ll_no_graba,ll_cta_ctto,ll_ctas_pag_s,ll_existe
double	ldb_numero,ldb_rut,ldb_monto,ldb_valor_uf,ldb_valor_cuota_m,ldb_valor_cuota_c,ldb_monto_sap,ldb_valor_cuota_p,ldb_monto_posic,ldb_valor_serv,ldb_tot_porc=0,ldb_tot_porc_aux=0
datetime	ldt_fec_pago


SELECT	COUNT("INGRESO"."FOLIO")
INTO		:ll_tot_reg
FROM		"INGRESO"	
WHERE 	"INGRESO"."TIPO_COB" <> 'NE' AND  
			("INGRESO"."PAGO_HIST" = 'A' OR "INGRESO"."PAGO_HIST" = 'N') AND  
			"INGRESO"."ESTADO_PAGO_SAP" = 99 and
			//( "INGRESO"."FOLIO" =305377 ) AND
			"INGRESO"."FECHA_PAGO" >= to_date('01/04/2016','DD/MM/YYYY')
USING	sqlca;
if isnull(ll_tot_reg) then ll_tot_reg=0
if ll_tot_reg=0 then
	messagebox("Advertencia","No Registra Datos Para Actualizar")
else
	ll_res														= MessageBox("Advertencia", 'Desea Cálcular Monto Integración  ', Exclamation!, YesNo!, 2)
	if ll_res=1 then
		SetPointer(HourGlass!)
		tab_1.tabpage_1.st_fondo.visible				= true
		tab_1.tabpage_1.st_cuenta.visible				= true
		tab_1.tabpage_1.st_porc.visible				= true
		tab_1.tabpage_1.hpb_1.visible					= true
		tab_1.tabpage_1.hpb_1.Position				= ldb_tot_porc
		UPDATE	"INGRESO"  
     	SET		"MONEDA_SAP" = null,  
         			"MONTO_UF" = null,  
         			"REZAGO_SAP" = null  
   		WHERE 	"INGRESO"."TIPO_COB" <> 'NE' AND  
         			("INGRESO"."PAGO_HIST" = 'A' OR "INGRESO"."PAGO_HIST" = 'N') AND  
         			"INGRESO"."ESTADO_PAGO_SAP" = 99 and
					//( "INGRESO"."FOLIO" =305377 ) AND
					"INGRESO"."FECHA_PAGO" >= to_date('01/04/2016','DD/MM/YYYY')
		USING	sqlca;
		if sqlca.sqlcode=0 then
			commit using sqlca;
		else
			rollback using sqlca;
		end if	;
		
		DECLARE x1 CURSOR FOR  
        	SELECT	"INGRESO"."BASE",
			  		"INGRESO"."SERIE",
					"INGRESO"."CONTRATO",
					"INGRESO"."TIPO_MOV",
					"INGRESO"."RUT",
					"INGRESO"."FOLIO",
					"INGRESO"."TIPO_COB",
					"INGRESO"."FECHA_PAGO",
					"INGRESO"."REZAGO",
					"INGRESO"."CODIGO_OTRO",
					"INGRESO"."MONTO",
					"INGRESO"."VALOR_UF",
					"INGRESO"."CTAS_PAG_CTTO",
					"INGRESO"."CUOTAS_PAG",
					"INGRESO"."PAGO_HIST"
		FROM		"INGRESO"
        	WHERE 	"INGRESO"."TIPO_COB" <> 'NE' AND  
         			("INGRESO"."PAGO_HIST" = 'A' OR "INGRESO"."PAGO_HIST" = 'N') AND  
         			"INGRESO"."ESTADO_PAGO_SAP" = 99 and
					//( "INGRESO"."FOLIO" =305377 ) AND
					"INGRESO"."FECHA_PAGO" >= to_date('01/04/2016','DD/MM/YYYY')
        ORDER BY	"INGRESO"."BASE",
		  				"INGRESO"."SERIE",
            				"INGRESO"."CONTRATO",
                			"INGRESO"."FOLIO",
                			"INGRESO"."TIPO_COB",
                			"INGRESO"."TIPO_MOV",
                			"INGRESO"."RUT"
		USING		Trans_1;
		open x1;
		if Trans_1.sqlcode=0 then
			DO WHILE Trans_1.sqlcode=0
			fetch x1 INTO :ls_base,:ls_serie,:ldb_numero,:ls_tipo_mov,:ldb_rut,:ll_folio,:ls_tipo_cob,:ldt_fec_pago,:ls_rezago,:ls_cod_otros,:ldb_monto,:ldb_valor_uf,:ll_nro_cuota,:ll_ctas_pag_s,:ls_pago_hist;
				if not isnull(ll_folio) and ll_folio > 0 and not isnull(ls_tipo_cob) and ls_tipo_cob<>'' and not isnull(ls_tipo_mov) and ls_tipo_mov<>'' then
					
					DECLARE funcion_deuda PROCEDURE FOR F_TIPO_DEUDA_ING( :ls_base,:ls_serie,:ldb_numero,:ls_tipo_mov);
					EXECUTE funcion_deuda;
					if sqlca.sqlcode=0 then
						fetch funcion_deuda into :ls_tipo_deuda;
						close funcion_deuda;
					end if
					
					if ls_rezago='S' then
						ls_rez_sap										= 'S'
					else
						if ldb_numero>0 then
							SELECT	count("SAP_CTTO_01_CABEC"."TIPO_CTTO")
							INTO		:ll_cta_ctto	
							FROM 	"SAP_CTTO_01_CABEC"  
							WHERE	"SAP_CTTO_01_CABEC"."BASE" = :ls_base AND  
										"SAP_CTTO_01_CABEC"."SERIE" = :ls_serie AND  
										"SAP_CTTO_01_CABEC"."NUMERO" = :ldb_numero AND  
										"SAP_CTTO_01_CABEC"."TIPO_DEUDA" = :ls_tipo_deuda
							USING	sqlca;
							if isnull(ll_cta_ctto) then ll_cta_ctto=0
							if ll_cta_ctto=0 then
								ls_rez_sap					= 'S'
							else
								ls_rez_sap					= 'N'
							end if
						else
							ls_rez_sap						= 'S'
						end if
					end if
					
					if ls_pago_hist<>'A' then
						if ls_tipo_mov='E' or ls_tipo_mov='K' then
							ls_moneda_sap							= '1'
							ldb_monto_sap							= round(ldb_monto / ll_ctas_pag_s ,0)
						elseif ls_tipo_mov='F' then
							ls_moneda_sap							= '2'
							ldb_monto_sap							= round(ldb_monto / ll_ctas_pag_s ,0)
						elseif  ls_tipo_mov = 'M' or  (ls_tipo_mov = 'L' and ls_cod_otros<>'3')  then
							ls_moneda_sap							= '2'
							ldb_valor_serv							= wf_valor_servicio(ll_folio,ls_tipo_cob,ls_tipo_mov,ls_cod_otros,ldt_fec_pago)
							if not isnull(ldb_valor_serv) and ldb_valor_serv>0 then
								ldb_monto_sap						= ldb_valor_serv
							else
								ldb_monto_sap						= 0
							end if	
						else
							ls_moneda_sap							= '1'
							ldb_monto_sap							= ldb_monto
						end if
					else
						if  ls_tipo_mov = 'S' then
							ls_moneda_sap						= '1'
							ldb_monto_sap     					= ldb_monto
						elseif  ls_tipo_mov = 'M' or  (ls_tipo_mov = 'L' and ls_cod_otros<>'3')  then
							ls_moneda_sap						= '2'
							ldb_valor_serv						= wf_valor_servicio(ll_folio,ls_tipo_cob,ls_tipo_mov,ls_cod_otros,ldt_fec_pago)
							if not isnull(ldb_valor_serv) and ldb_valor_serv>0 then
								ldb_monto_sap					= ldb_valor_serv
							else
								ldb_monto_sap					= 0
							end if
						else	
							if ldb_numero > 0 then
								if ls_rez_sap='S' then
									if ls_base='C' then
										SELECT  "CONTRATO"."VALOR_CUOTA_M"
										INTO    	:ldb_valor_cuota_m
										FROM 	"CADENA","CONTRATO"
										WHERE   "CADENA"."SERIE" = "CONTRATO"."SERIE_C" and  
													"CADENA"."NUMERO" = "CONTRATO"."NRO_CONTRATO" and  
													"CADENA"."CODIGO" = :ls_base and 
													"CADENA"."SERIE" = :ls_serie and
													"CADENA"."NUMERO" = :ldb_numero
										USING	sqlca;
										if isnull(ldb_valor_cuota_m) then ldb_valor_cuota_m = 0            
									
									elseif ls_base='O' then
										SELECT	"PAGO_OFERTA"."VALOR_CUOTA", "OFERTA_V"."VALOR_CUOTA_M", "PAGO_OFERTA"."MONEDA"
										INTO		:ldb_valor_cuota_c,:ldb_valor_cuota_m,:ls_moneda
										FROM 	"OFERTA_V","CADENA" ,"PAGO_OFERTA"   
										WHERE	"OFERTA_V"."SERIE" = "CADENA"."SERIE" and   
													"OFERTA_V"."NRO_OFERTA" = "CADENA"."NUMERO" and   
													"OFERTA_V"."SERIE" = "PAGO_OFERTA"."SERIE" and   
													"OFERTA_V"."NRO_OFERTA" = "PAGO_OFERTA"."NRO_OFERTA" and   
													"OFERTA_V"."ULT_FOLIO" = "PAGO_OFERTA"."FOLIO" AND 
													"CADENA"."CODIGO" = :ls_base and 
													"CADENA"."SERIE" = :ls_serie and
													"CADENA"."NUMERO" = :ldb_numero
										USING	sqlca;
										if isnull(ldb_valor_cuota_c) then ldb_valor_cuota_c = 0   
										if isnull(ldb_valor_cuota_m) then ldb_valor_cuota_m = 0
										if isnull(ls_moneda) then ls_moneda = ''
									
									elseif ls_base='L' then
										SELECT  	"PAGO_LIBERADOR"."VALOR_CUOTA","PAGO_LIBERADOR"."MONEDA"
										INTO    	:ldb_valor_cuota_c,:ls_moneda
										FROM		"ANEXO_LIBERADOR","CADENA","PAGO_LIBERADOR"  
										WHERE	"PAGO_LIBERADOR"."SERIE_M" = "ANEXO_LIBERADOR"."SERIE_M" and  
													"PAGO_LIBERADOR"."NRO_LIBERADOR" = "ANEXO_LIBERADOR"."NRO_LIBERADOR" and  
													"PAGO_LIBERADOR"."FOLIO" = "ANEXO_LIBERADOR"."ULT_FOLIO" and  
													"ANEXO_LIBERADOR"."SERIE_M" = "CADENA"."SERIE" and  
													"ANEXO_LIBERADOR"."NRO_LIBERADOR" = "CADENA"."NUMERO" and  
													"CADENA"."CODIGO" = :ls_base and 
													"CADENA"."SERIE" = :ls_serie and
													"CADENA"."NUMERO" = :ldb_numero
										USING	sqlca;
										if isnull(ldb_valor_cuota_c) then ldb_valor_cuota_c = 0
										if isnull(ls_moneda) then ls_moneda = ''
									
									elseif ls_base='A' then
										SELECT	"PAGO_AUMENTO"."VALOR_CUOTA","PAGO_AUMENTO"."MONEDA"
										INTO		:ldb_valor_cuota_c,:ls_moneda
										FROM		"ANEXO_AUMENTO","CADENA","PAGO_AUMENTO"  
										WHERE	"PAGO_AUMENTO"."SERIE_M" = "ANEXO_AUMENTO"."SERIE_M" and  
													"PAGO_AUMENTO"."NRO_AUMENTO" = "ANEXO_AUMENTO"."NRO_AUMENTO" and  
													"PAGO_AUMENTO"."FOLIO" = "ANEXO_AUMENTO"."ULT_FOLIO" and  
													"ANEXO_AUMENTO"."SERIE_M" = "CADENA"."SERIE" and  
													"ANEXO_AUMENTO"."NRO_AUMENTO" = "CADENA"."NUMERO" and  
													"CADENA"."CODIGO" = :ls_base and 
													"CADENA"."SERIE" = :ls_serie and
													"CADENA"."NUMERO" = :ldb_numero
										USING	sqlca;
										if isnull(ldb_valor_cuota_c) then ldb_valor_cuota_c = 0
										if isnull(ls_moneda) then ls_moneda = ''
									
									elseif ls_base='D' then
										SELECT	"DERECHO"."VALOR_CUO","DERECHO"."MONEDA"
										INTO    	:ldb_valor_cuota_c,:ls_moneda
										FROM    	"CADENA","DERECHO"  
										WHERE	"CADENA"."SERIE" = "DERECHO"."SERIE_P" and  
													"CADENA"."NUMERO" = "DERECHO"."NRO_PAGARE" and  
													"CADENA"."CODIGO" = :ls_base and 
													"CADENA"."SERIE" = :ls_serie and
													"CADENA"."NUMERO" = :ldb_numero
										USING	sqlca;
										if isnull(ldb_valor_cuota_c) then ldb_valor_cuota_c = 0
										if isnull(ls_moneda) then ls_moneda = ''
									
									elseif ls_base='P' then 
										SELECT  "PAGARE"."VALOR_CUO","PAGARE"."MONEDA"
										INTO    	:ldb_valor_cuota_c, :ls_moneda
										FROM		"CADENA","PAGARE"  
										WHERE	"CADENA"."SERIE" = "PAGARE"."SERIE_P" and  
													"CADENA"."NUMERO" = "PAGARE"."NRO_PAGARE" and  
													"CADENA"."CODIGO" = :ls_base and 
													"CADENA"."SERIE" = :ls_serie and
													"CADENA"."NUMERO" = :ldb_numero
										USING	sqlca;
										if isnull(ldb_valor_cuota_c) then ldb_valor_cuota_c = 0
										if isnull(ls_moneda) then ls_moneda = ''
									
									elseif ls_base='R' then
										SELECT	"REPACTA_MANTENCION"."VALOR_CUOTA_UF","REPACTA_MANTENCION"."TIPO_MONEDA"
										INTO		:ldb_valor_cuota_c,:ls_moneda
										FROM    "REPACTA_MANTENCION","CADENA" 
										WHERE   "CADENA"."SERIE" = "REPACTA_MANTENCION"."SERIE" and  
													"CADENA"."NUMERO" = "REPACTA_MANTENCION"."NUMERO" and  
													"CADENA"."CODIGO" = "REPACTA_MANTENCION"."BASE" AND 
													"CADENA"."CODIGO" = :ls_base and 
													"CADENA"."SERIE" = :ls_serie and
													"CADENA"."NUMERO" = :ldb_numero
										USING	sqlca;
										if isnull(ldb_valor_cuota_c) then ldb_valor_cuota_c = 0
										if isnull(ls_moneda) then ls_moneda = ''
									end if
									
									SELECT 	COUNT("DETALLE_PAGO_PIE"."BASE")
									INTO    	:ll_cta
									FROM		"DETALLE_PAGO_PIE"  
									WHERE	"DETALLE_PAGO_PIE"."BASE" = :ls_base AND  
												"DETALLE_PAGO_PIE"."SERIE" = :ls_serie AND  
												"DETALLE_PAGO_PIE"."NUMERO" = :ldb_numero
									USING	sqlca;
									if isnull(ll_cta) or ll_cta=0 then ll_cta =1
									if ll_cta = ll_nro_cuota then
										ldb_valor_cuota_p					= ldb_monto
										if ls_moneda='2' then
											ldb_valor_cuota_p				= round(ldb_monto /  ldb_valor_uf,4)
										end if
									else
										SELECT	SUM("DETALLE_PAGO_PIE"."MONTO_CUOTA")
										INTO    	:ldb_valor_cuota_p
										FROM    	"DETALLE_PAGO_PIE"  
										WHERE   "DETALLE_PAGO_PIE"."BASE" = :ls_base AND  
													"DETALLE_PAGO_PIE"."SERIE" = :ls_serie AND  
													"DETALLE_PAGO_PIE"."NUMERO" = :ldb_numero AND  
													"DETALLE_PAGO_PIE"."NUMERO_CUOTA" = :ll_nro_cuota
										USING	sqlca;
										if isnull(ldb_valor_cuota_p) then ldb_valor_cuota_p = 0
									end if
								else
									SELECT	"SAP_CTTO_01_CABEC"."MONEDA"
									INTO		:ls_moneda	
									FROM 	"SAP_CTTO_01_CABEC"  
									WHERE	"SAP_CTTO_01_CABEC"."BASE" = :ls_base AND  
												"SAP_CTTO_01_CABEC"."SERIE" = :ls_serie AND  
												"SAP_CTTO_01_CABEC"."NUMERO" = :ldb_numero AND  
												"SAP_CTTO_01_CABEC"."TIPO_DEUDA" = :ls_tipo_deuda
									USING	sqlca;
									if isnull(ls_moneda) then ls_moneda = 'UF'
									if ls_moneda='UF' then
										ls_moneda						= '2'
									elseif ls_moneda='CLP' then
										ls_moneda						= '1'
									end if
									if (ls_tipo_mov = 'E' or ls_tipo_mov = 'K' or ls_tipo_mov = 'U' ) then
										ldb_monto_posic				= wf_valor_cuota(ls_base,ls_serie,ldb_numero,ls_tipo_mov,ls_tipo_deuda,ll_nro_cuota)
										if not isnull(ldb_monto_posic) and ldb_monto_posic>0 then
											ldb_valor_cuota_c			= ldb_monto_posic
										else
											ldb_valor_cuota_c			= 0
										end if
											
									elseif ls_tipo_mov = 'F' then
										SELECT	"SAP_CADENA"."VALOR_CUOTA_M"
										INTO		:ldb_valor_cuota_m	
										FROM 	"SAP_CADENA"  
										WHERE	"SAP_CADENA"."BASE" = :ls_base AND  
													"SAP_CADENA"."SERIE" = :ls_serie AND  
													"SAP_CADENA"."NUMERO" = :ldb_numero AND  
													"SAP_CADENA"."TIPO_DEUDA" = :ls_tipo_deuda
										USING	sqlca;
										if isnull(ldb_valor_cuota_m) then ldb_valor_cuota_m = 0
									
									elseif ls_tipo_mov = 'A' or  ls_tipo_mov = 'Q' then
										ldb_monto_posic					=  wf_valor_pie(2,ls_base,ls_serie,ldb_numero,ll_folio,ls_tipo_mov,ldt_fec_pago,ldb_monto,ll_nro_cuota)
										if not isnull(ldb_monto_posic) and ldb_monto_posic>0 then
											ldb_valor_cuota_p				= ldb_monto_posic
										end if
									end if
								end if
									
								if ls_tipo_mov = 'E' or ls_tipo_mov = 'K' or ls_tipo_mov = 'U' then
									ls_moneda_sap							= ls_moneda
									ldb_monto_sap     						= ldb_valor_cuota_c
								elseif ls_tipo_mov = 'A' or ls_tipo_mov = 'Q' then
									ls_moneda_sap							= ls_moneda
									ldb_monto_sap     						= ldb_valor_cuota_p	
								elseif ls_tipo_mov = 'F' then
									ls_moneda_sap							= ls_moneda
									ldb_monto_sap     						= ldb_valor_cuota_m
									
								elseif ls_tipo_mov = 'P' or  ls_tipo_mov = 'R' then
									ls_moneda_sap							= '2'
									ldb_monto_sap     						= round(ldb_monto / ldb_valor_uf,16)
								else
									ls_moneda_sap							= ls_moneda
									if ls_moneda_sap='1' then
										ldb_monto_sap     					= ldb_monto
									elseif ls_moneda_sap='2' then
										ldb_monto							= round(ldb_monto /  ldb_valor_uf,16)
										if ls_tipo_mov='A' or ls_tipo_mov='Q' or ls_tipo_mov='E' or ls_tipo_mov='K' or ls_tipo_mov='U' and ls_tipo_mov='F' then 
											ldb_monto_sap     				= round(ldb_monto,4)
										else
											ldb_monto_sap     				= round(ldb_monto,16)
										end if
									end if
								end if
							else
								if ls_tipo_mov='E' or ls_tipo_mov='K' or ls_tipo_mov='F' then
									ldb_monto								= round(ldb_monto / ll_ctas_pag_s ,4)
								end if
								
								SELECT DISTINCT "CLIENTE_REZAGO"."MONEDA"  
								INTO   	:ls_moneda_sap
								FROM		"CLIENTE_REZAGO"  
								WHERE	( "CLIENTE_REZAGO"."RUT" = :ldb_rut ) AND  
											( "CLIENTE_REZAGO"."COD_PAGO" = :ls_tipo_cob ) AND  
											( "CLIENTE_REZAGO"."FOLIO" = :ll_folio ) AND  
											( "CLIENTE_REZAGO"."FECHA_PAGO" = :ldt_fec_pago ) AND
											( "CLIENTE_REZAGO"."BASE" = :ls_base ) 
								USING	sqlca;
								if isnull(ls_moneda_sap) then ls_moneda_sap='2'
								if ls_moneda_sap='1' then
									ldb_monto_sap     					= ldb_monto
								elseif ls_moneda_sap='2' then
									ldb_monto							= round(ldb_monto /  ldb_valor_uf,16)
									if ls_tipo_mov='A' or ls_tipo_mov='Q' or ls_tipo_mov='E' or ls_tipo_mov='K' or ls_tipo_mov='U' and ls_tipo_mov='F' then 
										ldb_monto_sap     				= round(ldb_monto,4)
									else
										ldb_monto_sap     				= round(ldb_monto,16)
									end if
								end if
							end if
						end if
					end if
								
					UPDATE	"INGRESO"  
					SET		"MONEDA_SAP" = :ls_moneda_sap,
								"MONTO_UF" = :ldb_monto_sap,
								"REZAGO_SAP" = :ls_rez_sap
					WHERE	"INGRESO"."BASE" = :ls_base and
								"INGRESO"."SERIE" = :ls_serie AND
								"INGRESO"."CONTRATO" = :ldb_numero AND
								"INGRESO"."TIPO_MOV" = :ls_tipo_mov AND
								"INGRESO"."RUT" = :ldb_rut AND  
								"INGRESO"."FOLIO" = :ll_folio AND  
								"INGRESO"."TIPO_COB" = :ls_tipo_cob AND
								"INGRESO"."CODIGO_OTRO" = :ls_cod_otros AND
								"INGRESO"."FECHA_PAGO" = :ldt_fec_pago 
					USING	Trans_2;
					if Trans_2.sqlcode=0 then
						commit using Trans_2;
						ll_graba++
					else
						rollback using Trans_2;
						ll_no_graba++
					end if	
				end if
				setnull(ls_base);setnull(ls_serie);setnull(ldb_numero);setnull(ls_tipo_mov);setnull(ldb_rut);setnull(ll_folio);setnull(ls_tipo_cob);setnull(ldt_fec_pago);setnull(ls_rezago);setnull(ls_cod_otros);setnull(ldb_monto);setnull(ldb_valor_uf);setnull(ll_nro_cuota)
				if ldb_tot_porc <> ldb_tot_porc_aux then 
					tab_1.tabpage_1.st_porc.text					= string(ldb_tot_porc,'#0.##')+" %"
					ldb_tot_porc_aux									= ldb_tot_porc
				end if
				ldb_tot_porc												= (ll_graba / ll_tot_reg) * 100
				tab_1.tabpage_1.hpb_1.Position					= ldb_tot_porc
				tab_1.tabpage_1.st_cuenta.text 					= 'Total Reg. '+string(ll_tot_reg,'###,###,###')+'    Reg. Cálculados '+string(ll_graba,'###,###,###')+'  '
			LOOP
		end if
		close x1;
		tab_1.tabpage_1.st_fondo.visible							= false
		tab_1.tabpage_1.st_cuenta.visible							= false
		tab_1.tabpage_1.hpb_1.visible 								= false
		tab_1.tabpage_1.st_porc.visible 							= false
		SetPointer(Arrow!)
	end if
end if
end event

type cb_44 from commandbutton within w_sap_detalle_pagos_caja_2_bkp
integer x = 1083
integer y = 2236
integer width = 585
integer height = 96
integer taborder = 60
integer textsize = -8
integer weight = 700
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string text = "Corrige Monto Docto"
end type

event clicked;string		ls_tipo_cob,ls_cod_caja,ls_cod_pago
long		ll_folio,ll_graba=0,ll_no_graba=0,ll_res,ll_cta,ll_cta2=0
datetime	ldt_fec_pago,ldt_fec_venc,ldt_fec_caja
double	ldb_monto,ldb_mto_dcto,ldb_mto_grupo=0


ls_cod_caja						= trim(mid(ddplb_caja.text,1,(pos(ddplb_caja.text,'-') - 1)))
ldt_fec_caja						= datetime(date(em_1.text),time('00:00:00'))

ll_res								= MessageBox("Advertencia", 'Esta seguro de Grabar Registro', Exclamation!, YesNo!, 2)
if ll_res=1 then
	SetPointer(HourGlass!)
	DECLARE x1 CURSOR FOR
	SELECT		"INGRESO"."FOLIO",
					"INGRESO"."FECHA_PAGO",
					"INGRESO"."TIPO_COB",
					"INGRESO"."COD_CAJA",
					SUM((	CASE WHEN "INGRESO"."TIPO_MOV"='F' OR "INGRESO"."TIPO_MOV"='E' OR "INGRESO"."TIPO_MOV"='K' OR "INGRESO"."TIPO_MOV"='U' THEN "INGRESO"."CUOTAS_PAG" * ( CASE WHEN  "INGRESO"."MONEDA_SAP" = '1' THEN "INGRESO"."MONTO_UF" WHEN "INGRESO"."MONEDA_SAP" = '2' THEN ROUND("INGRESO"."MONTO_UF" * "INGRESO"."VALOR_UF",0) END ) 
										WHEN "INGRESO"."TIPO_MOV"='Q' OR "INGRESO"."TIPO_MOV"='A'  THEN ( CASE WHEN "INGRESO"."CUOTAS_PAG" IS NULL OR "INGRESO"."CUOTAS_PAG" = 0 THEN 1 ELSE "INGRESO"."CUOTAS_PAG" END ) * ( CASE WHEN  "INGRESO"."MONEDA_SAP" = '1' THEN "INGRESO"."MONTO_UF" WHEN "INGRESO"."MONEDA_SAP" = '2' THEN ROUND("INGRESO"."MONTO_UF" * "INGRESO"."VALOR_UF",0) END ) 
								ELSE ( CASE WHEN  "INGRESO"."MONEDA_SAP" = '1' THEN "INGRESO"."MONTO_UF" WHEN "INGRESO"."MONEDA_SAP" = '2' THEN ROUND("INGRESO"."MONTO_UF" * "INGRESO"."VALOR_UF",0) END ) END))
	FROM			"INGRESO"
	WHERE	 	"INGRESO"."TIPO_COB" <> 'NE' AND
					"INGRESO"."ESTADO_PAGO_SAP" = 99 AND
					"INGRESO"."COD_CAJA" = :ls_cod_caja AND
					//"INGRESO"."FOLIO" = 366111 AND
					"INGRESO"."FECHA_PAGO" = :ldt_fec_caja AND
					("INGRESO"."PAGO_HIST" = 'A' OR "INGRESO"."PAGO_HIST" = 'N')
					
	GROUP BY 	"INGRESO"."FOLIO",
					"INGRESO"."FECHA_PAGO",
					"INGRESO"."TIPO_COB",
					"INGRESO"."COD_CAJA"
	USING	Trans_1;
	open x1;
	if Trans_1.sqlcode=0 then
		DO WHILE Trans_1.sqlcode=0
		fetch x1 INTO	:ll_folio,	:ldt_fec_pago,	:ls_tipo_cob,	:ls_cod_caja,	:ldb_monto;
			if not isnull(ll_folio) and ll_folio > 0 and not isnull(ldt_fec_pago) and not isnull(ls_tipo_cob) and ls_tipo_cob<>'' and not isnull(ls_cod_caja) and ls_cod_caja<>'' then
				SELECT	COUNT("DOCUMENTOS"."FOLIO")
				INTO		:ll_cta
				FROM		"DOCUMENTOS"
				WHERE	"DOCUMENTOS"."FOLIO" = :ll_folio AND  
							"DOCUMENTOS"."TIPO_COB" = :ls_tipo_cob AND  
							"DOCUMENTOS"."FECHA_PAGO" = :ldt_fec_pago AND  
							"DOCUMENTOS"."COD_CAJA" = :ls_cod_caja
				USING	sqlca;
				if isnull(ll_cta) then ll_cta=0
				if ll_cta>0 then
					if ll_cta= 1 then
						UPDATE	"DOCUMENTOS"  
						SET		"MONTO_UF" = :ldb_monto  
						WHERE	"DOCUMENTOS"."FOLIO" = :ll_folio AND  
									"DOCUMENTOS"."TIPO_COB" = :ls_tipo_cob AND  
									"DOCUMENTOS"."FECHA_PAGO" = :ldt_fec_pago AND  
									"DOCUMENTOS"."COD_CAJA" = :ls_cod_caja
						USING	sqlca;
						if sqlca.sqlcode=0 then
							commit using sqlca;
							ll_graba++
						else
							rollback using sqlca;
							ll_no_graba++
						end if
					else
						ldb_mto_grupo				= 0
						ll_cta2						= 0
						DECLARE x2 CURSOR FOR
						SELECT	"FECHA_VENC","MONTO","COD_PAGO"  
						FROM 	"DOCUMENTOS"  
						WHERE	( "DOCUMENTOS"."FOLIO" = :ll_folio ) AND  
         							( "DOCUMENTOS"."TIPO_COB" = :ls_tipo_cob ) AND  
         							( "DOCUMENTOS"."FECHA_PAGO" = :ldt_fec_pago ) AND  
         							( "DOCUMENTOS"."COD_CAJA" = :ls_cod_caja )
						ORDER BY	"DOCUMENTOS"."FECHA_VENC",
										"DOCUMENTOS"."COD_PAGO"
						USING	Trans_2;
						open x2;
						if Trans_2.sqlcode=0 then
							DO WHILE Trans_2.sqlcode=0
							fetch x2 INTO	:ldt_fec_venc,	:ldb_mto_dcto,:ls_cod_pago;
								if not isnull(ldt_fec_venc) and not isnull(ldb_mto_dcto) and ldb_mto_dcto > 0 and not isnull(ls_cod_pago) and ls_cod_pago<>'' then
									ll_cta2++
									if ll_cta2 < ll_cta then
										ldb_mto_grupo			= ldb_mto_grupo + ldb_mto_dcto
									elseif ll_cta2 = ll_cta then
										ldb_mto_dcto			= ldb_monto - ldb_mto_grupo
									end if
										
									UPDATE	"DOCUMENTOS"  
									SET		"MONTO_UF" = :ldb_mto_dcto  
									WHERE	"DOCUMENTOS"."FOLIO" = :ll_folio AND  
												"DOCUMENTOS"."TIPO_COB" = :ls_tipo_cob AND  
												"DOCUMENTOS"."FECHA_PAGO" = :ldt_fec_pago AND  
												"DOCUMENTOS"."COD_CAJA" = :ls_cod_caja AND
												"DOCUMENTOS"."FECHA_VENC" = :ldt_fec_venc AND
												"DOCUMENTOS"."COD_PAGO" = :ls_cod_pago
									USING	sqlca;
									if sqlca.sqlcode=0 then
										commit using sqlca;
										ll_graba++
									else
										rollback using sqlca;
										ll_no_graba++
									end if
								end if
								setnull(ldt_fec_venc);setnull(ldb_mto_dcto);setnull(ls_cod_pago)
								ldb_mto_dcto				= 0
							LOOP
						end if
						close x2;
					end if
				end if
			end if
			setnull(ll_folio);setnull(ldt_fec_pago);setnull(ls_tipo_cob);setnull(ls_cod_caja);setnull(ldb_monto)
										
		LOOP
	end if
	close x1;
	messagebox("Grabar",'Proceso terminado :~r~n'+string(ll_graba,'###,###,##0')+' registros grabados con exito~r~n'+&
								'y '+string(ll_no_graba,'###,###,##0')+' registros con problemas.',information!)
end if
end event

type cb_43 from commandbutton within w_sap_detalle_pagos_caja_2_bkp
integer x = 2021
integer y = 100
integer width = 402
integer height = 112
integer taborder = 60
integer textsize = -10
integer weight = 700
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string text = "Procesar"
end type

event clicked;long 		ver,ll_pos,ll_cod_parque,ll_count,ll_count_ing,ll_tot_reg,ll_indi,ll_folio,ll_monto,ll_rut,ll_cuotas_pag,ll_cod_parque_reg,ll_fila_e,ll_fila_f,ll_count_cta_fututa,ll_nro_cuota,ll_fila_p,&
			ll_dias_contables,ll_corre,ll_comi_monto,ll_folio_deposito,ll_folio_boleta,ll_n_cheque, ll_cod_banco, ll_monto_ch, ll_num_cheques,ll_folio_boleta_ch,ll_corre_debe,ll_tot_serv,&
			ll_folio_rez,ll_rut_rez,ll_ctas_pag_cred,ll_res,ll_suma_desc,ll_rut_cli,ll_cab_asiento2,ll_det_asiento2,ll_tot_reg_fi,ll_indi_fi,ll_ctas_pag_m,ll_fila,ll_sum_cta_dia,ll_count_cta_dia,&
			ll_count_pie,ll_ctas_pag_pie,ll_count_pend,ll_count_caja_sap,ll_contar_envio,ll_count_pie_sap,ll_count_reg,ll_nro_envio
Date 		MIAR,ldt_fecha_venc,ldt_fecha_proceso,ldt_fecha_contable,ld_fecha_valor,ldt_fecha_cheque,ldt_fecha_venc_ch
STRING 	ls_cod_parque,ls_caja,COMPA,ls_sociedad,ls_moneda,ls_clase,ls_ref1,ls_ref2,ls_hora,ls_tipo_cob,ls_tipo_mov,ls_base,ls_serie,ls_rezago,ls_codigo_otro,&
			ls_cuenta_contable,ls_descripcion_cuenta,ls_sociedad_reg,ls_cliente_sap,ls_centro,ls_contrato_sap,ls_llave,ls_clave_pago,ls_ref_dcto,ls_nro_opera_trans,&
			ls_via_pago,ls_pasa,ls_cod_pago, ls_forma_pago, ls_cond_pago,ls_tipo_comi,ls_estado_ch, ls_glosa_ch,ls_tipo_cob_ch,ls_clave_contab,ls_clave_contab_h,ls_material,&
			ls_moneda_u, ls_cta_puente, ls_descrip_cta_puente,ls_clave_contab_peso_haber,ls_clave_contab_uf_debe,ls_clave_contab_uf_haber,	ls_clave_contab_peso_debe,&
			ls_base_rez, ls_serie_rez, ls_tipo_cob_rez,ls_centro_benef,ls_rut_sap,ls_cod_cliente_sap,ls_clave_contab_haber,ls_clave_contab_debe,ls_dv_cli,ls_contar,ls_tipo_deuda,&
			ls_cadena
Time		lt_hora
Double	ldb_valor_uf,ll_monto_uf,ldb_uf_moneda,ldb_uf_pago,ll_numero,ll_numero_rez,ldb_valor_cuota,ldb_valor_posic,ldb_mto_ctto
Datetime	ldt_fecha_pago_rez,ldt_fec_pago

//gs_mandatario
tab_1.tabpage_2.dw_cliente_rezago.reset()
tab_1.tabpage_1.dw_cabecera.dataobject		= 'dw_sap_cabecera_interfaz'
tab_1.tabpage_1.dw_cabecera.settransobject(sqlca)
tab_1.tabpage_1.dw_debe.dataobject			= 'dw_sap_debe'
tab_1.tabpage_1.dw_debe.settransobject(sqlca)
tab_1.tabpage_1.dw_haber.dataobject			= 'dw_sap_haber'
tab_1.tabpage_1.dw_haber.settransobject(sqlca)
SetNull(il_estado_sap);SetNull(il_estado_sap_retrieve)
tab_1.tabpage_1.cb_centralizar.enabled			= true
tab_1.tabpage_1.cb_envio.enabled				= true


//MIAR 													= DATE(EM_1.TEXT)
ll_count													= 0
SELECT 		COUNT("SAP_CABECERA_PAGOS"."COD_CAJA")
INTO			:ll_count_reg
FROM 		"SAP_CABECERA_PAGOS"  
WHERE 	  ( "SAP_CABECERA_PAGOS"."ESTADO_SAP" = 3 ) OR  
			  ( "SAP_CABECERA_PAGOS"."ESTADO_SAP" = 4 ) OR  
			  ( "SAP_CABECERA_PAGOS"."ESTADO_SAP" = 2 )
USING	sqlca;
if ll_count_reg > 0 then
	messagebox("Advertencia","Existe(n) "+string(ll_count_reg,'###,###,##0') +" Asiento(s) Pendiente(s) se Eliminara(n)")
	
	if not isnull(ls_caja) and not isnull(MIAR) then
		tab_1.tabpage_2.dw_cliente_rezago.reset()
		tab_1.tabpage_2.dw_cliente_rezago.retrieve(3,'R')
		
		DECLARE X0 CURSOR FOR  
		SELECT 	"COD_CAJA",	"FECHA_PAGO",	"NRO_ENVIO"
		FROM 	"SAP_CABECERA_PAGOS"  
		WHERE 	( "SAP_CABECERA_PAGOS"."ESTADO_SAP" = 3 OR "SAP_CABECERA_PAGOS"."ESTADO_SAP" = 4 OR "SAP_CABECERA_PAGOS"."ESTADO_SAP" = 2 )
		USING	sqlca;
		open x0;
		if sqlca.sqlcode=0 then
			do while sqlca.sqlcode=0
				fetch x0 into :ls_caja, :MIAR, :ll_nro_envio;
				if not isnull(ls_caja) then
					UPDATE	"CLIENTE_REZAGO"  
					SET 		"ESTADO_SAP" = 0 
					WHERE 	"CLIENTE_REZAGO"."ESTADO_SAP" = 3
					USING	sqlca	;
					if sqlca.sqlcode=0 then
						commit;
					else
						rollback;
						messagebox("Error Actualizar Cliente Rezago","Error Actualizar CLIENTE_REZAGO SQL: "+sqlca.sqlerrtext)
					end if
				
					DELETE FROM 	"SAP_CABECERA_PAGOS"  
					WHERE 		  ( "SAP_CABECERA_PAGOS"."COD_CAJA" = :ls_caja ) AND  
									  ( "SAP_CABECERA_PAGOS"."FECHA_PAGO" = :MIAR ) AND
									  ( "SAP_CABECERA_PAGOS"."ESTADO_SAP" = 3 OR "SAP_CABECERA_PAGOS"."ESTADO_SAP" = 4  OR "SAP_CABECERA_PAGOS"."ESTADO_SAP" = 2) AND
									  ( "SAP_CABECERA_PAGOS"."NRO_ENVIO" = :ll_nro_envio )
					USING		sqlca;
					if sqlca.sqlcode=0 then
						commit;
						ll_count ++
					else
						rollback;
						messagebox("Error Eliminar","Error Eliminar SAP_CABECERA_PAGOS SQL: "+sqlca.sqlerrtext)
					end if
					  
					DELETE FROM  "SAP_HABER_SAP"
					WHERE 		  ( "SAP_HABER_SAP"."COD_CAJA" = :ls_caja ) AND  
									  ( "SAP_HABER_SAP"."FECHA_PAGO" = :MIAR ) AND
									  ( "SAP_HABER_SAP"."NRO_ENVIO" = :ll_nro_envio )
					USING sqlca  ;
					if sqlca.sqlcode=0 then
						commit;
						ll_count ++
					else
						rollback;
						messagebox("Error Eliminar","Error Eliminar SAP_HABER_SAP SQL: "+sqlca.sqlerrtext)
					end if
					
					DELETE FROM  "SAP_DEBE_SAP" 
					WHERE 		  ( "SAP_DEBE_SAP"."COD_CAJA" = :ls_caja ) AND  
									  ( "SAP_DEBE_SAP"."FECHA_PAGO" = :MIAR ) AND
									  ( "SAP_DEBE_SAP"."NRO_ENVIO" = :ll_nro_envio )
					USING sqlca  ;
					if sqlca.sqlcode=0 then
						commit;
						ll_count ++
					else
						rollback;
						messagebox("Error Eliminar","Error Eliminar SAP_DEBE_SAP SQL: "+sqlca.sqlerrtext)
					end if
					if ll_count = 3 then
						tab_1.tabpage_1.dw_ingreso.reset()
						tab_1.tabpage_1.dw_ingreso_sap.reset()
						tab_1.tabpage_1.dw_cabecera.reset()
						tab_1.tabpage_1.dw_debe.reset()
						tab_1.tabpage_1.dw_haber.reset()
						messagebox("Eliminar","Eliminación Exitosa - Proceso Caja "+ls_caja+ " Fecha del "+string(MIAR,'dd/mm/yyyy') )
					end if
				end if
				Setnull(ls_caja)
			loop	
		end if
		close x0;
	else
		if isnull(ls_caja) then
			messagebox("Advertencia","Debe Seleccionar CAJA")
			ddplb_caja.setfocus()
		elseif isnull(MIAR) then
			messagebox("Advertencia","Debe Seleccionar Fecha")
			em_1.setfocus()
		end if
	end if
end if

//if tab_1.tabpage_1.cbx_asiento_pend.checked=true then
//	il_estado_sap			= 	1
//else
//	il_estado_sap			= 	0
//end if

//ll_tot_reg_fi			= tab_1.tabpage_2.dw_cliente_rezago.retrieve(3,'R')
//if ll_tot_reg_fi > 0 then
//	for ll_indi_fi=1 to ll_tot_reg_fi
//		tab_1.tabpage_2.dw_cliente_rezago.setitem(ll_indi_fi,'estado_reg',1)
//	next
//	tab_1.tabpage_2.dw_cliente_rezago.object.t_marca.text		= 'Marcar Todo'
//	tab_1.tabpage_2.dw_cliente_rezago.accepttext()
//end if
//if tab_1.tabpage_2.dw_cliente_rezago.rowcount() > 0 then
//	messagebox("Advertencia","Debe Procesar Cliente Rezago - CLIENTE FI")
//else
	Setnull(ldt_fecha_cheque);Setnull(ls_nro_opera_trans)
	ls_pasa								= 'S'
	ldt_fecha_proceso					= date(gdt_fec_sistema)
	MIAR 									= DATE(EM_1.TEXT)
	ll_pos									= pos(ddplb_caja.text,'-')
	ls_caja								= trim(mid(ddplb_caja.text,1,(ll_pos - 1)))
	ldt_fecha_venc						= MIAR
	ls_llave								= ls_caja+string(MIAR,'ddmmyyyy')
	ldb_uf_moneda						= Round(gd_uf_dia / 1000,4)
	ll_cab_asiento2						= 0
	ll_det_asiento2						= 0
	SELECT	"TAB_UF"."VALOR_UF"  
	INTO 		:ldb_valor_uf  
	FROM 	"TAB_UF"  
	WHERE 	"TAB_UF"."FECHA_UF" = :MIAR   ;
	ldb_uf_moneda						= Round(ldb_valor_uf / 1000,4)
	
//	il_item								= tab_1.tabpage_1.dw_cabecera.getitemnumber(tab_1.tabpage_1.dw_cabecera.getrow(),'item')
	if not isnull(ls_caja) and not isnull(MIAR) then
		SetPointer(HourGlass!)
		SELECT 	"SAP_CUENTA_PUENTE"."CUENTA_PUENTE",		"SAP_CUENTA_PUENTE"."DESCRIPCION_CUENTA",	"SAP_CUENTA_PUENTE"."CLAVE_CONTAB_PESO_HABER",	"SAP_CUENTA_PUENTE"."CLAVE_CONTAB_UF_DEBE",	"SAP_CUENTA_PUENTE"."CLAVE_CONTAB_UF_HABER",	"SAP_CUENTA_PUENTE"."CLAVE_CONTAB_PESO_DEBE"
		INTO 		:ls_cta_puente,												:ls_descrip_cta_puente,										:ls_clave_contab_haber,										:ls_clave_contab_debe,										:ls_clave_contab_uf_haber,										:ls_clave_contab_peso_debe
		FROM		"SAP_CUENTA_PUENTE"  
		USING	sqlca;
		
		DECLARE a1 CURSOR FOR  
		SELECT 	"VISTA_SAP_CLIENTE_REZAGO"."BASE",   
					"VISTA_SAP_CLIENTE_REZAGO"."SERIE",   
					"VISTA_SAP_CLIENTE_REZAGO"."NUMERO",   
					"VISTA_SAP_CLIENTE_REZAGO"."TIPO_COB",   
					"VISTA_SAP_CLIENTE_REZAGO"."FOLIO",   
					"VISTA_SAP_CLIENTE_REZAGO"."FECHA_PAGO",   
					"VISTA_SAP_CLIENTE_REZAGO"."RUT"
		FROM 	"VISTA_SAP_CLIENTE_REZAGO"  
		WHERE ( "VISTA_SAP_CLIENTE_REZAGO"."CAJA" = :ls_caja ) AND  
				  ( "VISTA_SAP_CLIENTE_REZAGO"."FECHA_PAGO" = :MIAR ) AND  
				  ( "VISTA_SAP_CLIENTE_REZAGO"."ESTADO_SAP" = 0 )    
		USING	Trans_1;
		OPEN a1;
			do while Trans_1.sqlcode=0 
				fetch a1 into :ls_base_rez, :ls_serie_rez, :ll_numero_rez, :ls_tipo_cob_rez, :ll_folio_rez, :ldt_fecha_pago_rez, :ll_rut_rez ;
				if not isnull(ls_base_rez) and ll_rut_rez > 0 then
					UPDATE	"CLIENTE_REZAGO"  
					SET 		"ESTADO_SAP" = 3  
					WHERE ( "CLIENTE_REZAGO"."COD_PAGO" = :ls_tipo_cob_rez ) AND  
							  ( "CLIENTE_REZAGO"."FOLIO" = :ll_folio_rez ) AND  
							  ( "CLIENTE_REZAGO"."FECHA_PAGO" = :MIAR ) AND  
							  ( "CLIENTE_REZAGO"."RUT" = :ll_rut_rez )  
					USING	sqlca;
					if sqlca.sqlcode=0 then
						commit;
					else
						rollback;
						messagebox("Error Grabar","Error Actualizar Cliente Rezago SQL: "+sqlca.sqlerrtext)
					end if
				end if
			loop
		Close a1;
		
		SetPointer(Arrow!)
		SELECT	Count("INGRESO"."TIPO_COB")
		INTO 		:ll_count_ing  
		FROM 	"INGRESO"  
		WHERE ( "INGRESO"."COD_CAJA" = :ls_caja ) AND  
				  ( "INGRESO"."FECHA_PAGO" = :MIAR ) AND
				  ( "INGRESO"."ESTADO_PAGO_SAP" > 0 AND "INGRESO"."ESTADO_PAGO_SAP" <= 99 ) AND
				  ( "INGRESO"."PAGO_HIST" = 'A' OR "INGRESO"."PAGO_HIST" = 'N' ) ;
		if ll_count_ing > 0 then
			SetPointer(HourGlass!)
			SELECT DISTINCT	"SAP_CLASE_DOCUMENTO"."CLASE_DOC",	sysdate  
			INTO		:ls_clase,											:gdt_fec_sistema  
			FROM 	"SAP_CLASE_DOCUMENTO"  
			WHERE 	"SAP_CLASE_DOCUMENTO"."TIPO_MOV" = 'BE'  ;
			lt_hora						= Time(gdt_fec_sistema)
			ls_hora						= mid(string(lt_hora),1,2)+mid(string(lt_hora),4,2)
			SELECT	"SAP_SOCIEDAD_FI"."SOCIEDAD",		"SAP_SOCIEDAD_FI"."MONEDA",	"CODIGO_CAJAS"."DIAS_CONTABLES"
			INTO 		:ls_sociedad,								:ls_moneda,								:ll_dias_contables	
			FROM 	"CODIGO_CAJAS",		"SAP_SOCIEDAD_FI"  
			WHERE ( "CODIGO_CAJAS"."COD_PARQUE" = "SAP_SOCIEDAD_FI"."COD_PARQUE" ) and  
					  ( "CODIGO_CAJAS"."COD_CAJA" = :ls_caja ) 
			USING	sqlca;
			if sqlca.sqlcode=0 then
				if ls_moneda='CLP' then
					ls_moneda_u		= 'UF'
				end if
				if ls_moneda='BOB' then
					ls_moneda_u		= 'US'
				end if
				ldt_fecha_contable		= RelativeDate(MIAR,  ll_dias_contables)
				
				
				SELECT	COUNT("INGRESO"."TIPO_COB")
				INTO 		:ll_count_pend  
				FROM 	"INGRESO"  
				WHERE ( "INGRESO"."COD_CAJA" = :ls_caja ) AND  
						  ( "INGRESO"."FECHA_PAGO" = :MIAR ) AND  
						  ( "INGRESO"."ESTADO_PAGO_SAP" > 0 AND "INGRESO"."ESTADO_PAGO_SAP" < 90 ) 
				USING	sqlca;
				
				SELECT	COUNT("SAP_CABECERA_PAGOS"."SOCIEDAD")
				INTO 		:ll_count_caja_sap  
				FROM 	"SAP_CABECERA_PAGOS"  
				WHERE ( "SAP_CABECERA_PAGOS"."COD_CAJA" = :ls_caja ) AND  
						  ( "SAP_CABECERA_PAGOS"."FECHA_PAGO" = :MIAR )  AND
						  ( "SAP_CABECERA_PAGOS"."MONEDA" = 'CLP' ) 
				USING	sqlca;

				if ll_count_pend=0 and ll_count_caja_sap=0 then
					tab_1.tabpage_1.cbx_asiento_pend.checked	= false
					ls_contar													= string(ll_count_pend,'00')
					il_estado_sap											= 0
					il_estado_sap_retrieve								= 0
				elseif ll_count_pend>0 and ll_count_caja_sap=0 then
					tab_1.tabpage_1.cbx_asiento_pend.checked	= false
					il_estado_sap											= 1
					ls_contar													= string(il_estado_sap,'00')		//ll_count_caja_sap
					il_estado_sap_retrieve								= 99		//0									// 1
				elseif ll_count_pend>0 and ll_count_caja_sap>0  then
					ls_contar													= string(ll_count_caja_sap,'00')
					tab_1.tabpage_1.cbx_asiento_pend.checked	= true
					il_estado_sap											= ll_count_caja_sap + 1
//					il_estado_sap_retrieve								= ll_count_caja_sap - 1
					il_estado_sap_retrieve								= ll_count_caja_sap
					ls_contar													= string((ll_count_caja_sap + 1),'00')	
				end if	
				ls_ref1														= ls_caja+string(MIAR,'ddmmyyyy')+'_'+ls_contar
				ls_ref2														= ls_caja+string(gdt_fec_sistema,'ddmmyyyy')+'_'+ls_contar
				ll_contar_envio												= long(ls_contar)
				
				SELECT 	Count("SAP_CABECERA_PAGOS"."CLASE_DOC")
				INTO 		:ll_count  
				FROM 	"SAP_CABECERA_PAGOS"  
				WHERE ( "SAP_CABECERA_PAGOS"."FECHA_PAGO" = :MIAR ) AND  
						  ( "SAP_CABECERA_PAGOS"."COD_CAJA" = :ls_caja );
				if ll_count > 0 and ll_count_caja_sap=1 and ll_count_pend=0 then
					ll_res				= messagebox("Advertencia","Caja "+ls_caja+" del "+string(MIAR,'dd/mm/yyyy') +" Ya está Registrada, desea Visualizar Centralización",Exclamation!,YesNo!,2)
					if ll_res=1 then
						tab_1.tabpage_1.dw_cabecera.retrieve(ls_caja,MIAR)
						tab_1.tabpage_1.dw_cabecera.scrolltorow(1)

						if il_estado_sap_retrieve = 0 then il_estado_sap_retrieve=1
						tab_1.tabpage_1.dw_ingreso.retrieve(ls_caja,MIAR,il_estado_sap_retrieve)		//1)
						ll_tot_reg	= tab_1.tabpage_1.dw_ingreso_sap.retrieve(ls_caja,MIAR,il_estado_sap_retrieve)		//1)
						
						if ll_tot_reg > 0 then
							for ll_indi=1 to ll_tot_reg
								 tab_1.tabpage_1.dw_ingreso_sap.setitem(ll_indi,'estado_reg',1)
							next
							 tab_1.tabpage_1.dw_ingreso_sap.accepttext()
						end if
						tab_1.tabpage_1.dw_debe.retrieve(ls_caja,MIAR,1)
						tab_1.tabpage_1.dw_haber.retrieve(ls_caja,MIAR,1)
					end if
					ls_pasa				= 'N'
				else
					INSERT INTO	"SAP_CABECERA_PAGOS"  
									  ( "ITEM",	"FECHA_PAGO",	"FECHA_RECEP_PAGO",	"CLASE_DOC",	"SOCIEDAD",	"MONEDA",	"FECHA_CONVERSION",	"REF_CAJA_CONTABLE1",	"REF_CAJA_CONTABLE2",	"ESTADO_SAP",	"COD_CAJA",	"HORA",		"FECHA_PROCESO",		"FECHA_CONTABLE",		"USUARIO",		"VALOR_MONEDA",	"MONEDA_LOCAL",	"NRO_ENVIO" )  
					VALUES 		  ( 1,			:MIAR,				:MIAR, 						:ls_clase,   		:ls_sociedad,	:ls_moneda,	:MIAR,						:ls_ref1,							:ls_ref2,							3,						:ls_caja,			:ls_hora,		:ldt_fecha_proceso,		:ldt_fecha_contable,		'WS_IF_FI',		0,							Null,						:ll_contar_envio )  
					USING		sqlca;
					if sqlca.sqlcode=0 then
						commit;
						INSERT INTO	"SAP_CABECERA_PAGOS"  
										  ( "ITEM",	"FECHA_PAGO",	"FECHA_RECEP_PAGO",	"CLASE_DOC",	"SOCIEDAD",	"MONEDA",		"FECHA_CONVERSION",	"REF_CAJA_CONTABLE1",	"REF_CAJA_CONTABLE2",	"ESTADO_SAP",	"COD_CAJA",	"HORA",		"FECHA_PROCESO",		"FECHA_CONTABLE",		"USUARIO",		"VALOR_MONEDA",	"MONEDA_LOCAL",	"NRO_ENVIO" )  
						VALUES 		  ( 2,			:MIAR,				:MIAR, 						:ls_clase,   		:ls_sociedad,	:ls_moneda_u,	:MIAR,						:ls_ref1,							:ls_ref2,							4,						:ls_caja,			:ls_hora,		:ldt_fecha_proceso,		:ldt_fecha_contable,		'WS_IF_FI',		0,							'CLP',						:ll_contar_envio  )  
						USING		sqlca;
						if sqlca.sqlcode=0 then
							commit;
							ll_cab_asiento2 ++
						else
							rollback;
						end if
						tab_1.tabpage_1.dw_cabecera.retrieve(ls_caja,MIAR)
					else
						rollback;
						messagebox("Error Grabar","Error al Grabar Cabecera Interfaz Pago - SAP SQL: "+sqlca.sqlerrtext)
					end if
				end if
			end if
			SetPointer(Arrow!)
			if ls_pasa='S' then
				SetPointer(HourGlass!)
				if il_estado_sap_retrieve=0 then il_estado_sap_retrieve=1
				ll_tot_reg						= tab_1.tabpage_1.dw_ingreso.retrieve(ls_caja,MIAR,il_estado_sap_retrieve)		//1)
				if ll_tot_reg > 0 then
					ll_corre_debe				= 1
					ll_corre						= 1
					Setnull(ls_nro_opera_trans);Setnull(ls_ref_dcto);SetNull(ll_n_cheque)
					for ll_indi=1 to ll_tot_reg
						ls_cuenta_contable	= tab_1.tabpage_1.dw_ingreso.getitemstring(ll_indi,'sap_cuentas_contables_cuenta_contable')
						ls_descripcion_cuenta	= tab_1.tabpage_1.dw_ingreso.getitemstring(ll_indi,'sap_cuentas_contables_descripcion_cuenta')
						ls_cod_pago				= tab_1.tabpage_1.dw_ingreso.getitemstring(ll_indi,'cod_pago')
						ls_clave_contab		= tab_1.tabpage_1.dw_ingreso.getitemstring(ll_indi,'sap_cuentas_contables_clave_contab')
						if len(ls_descripcion_cuenta) > 50 then ls_descripcion_cuenta = mid(ls_descripcion_cuenta,1,50)
						if ls_cod_pago='TC' then
							ls_tipo_comi			= 'CC'
						elseif ls_cod_pago='TD' then
							ls_tipo_comi			= 'CD'
	//					elseif ls_cod_pago='EF' then
	//						SELECT 	SUM("INGRESO"."MONTO")
	//						INTO 		:ll_suma_desc  
	//						FROM 	"INGRESO"  
	//						WHERE ( "INGRESO"."COD_CAJA" = :ls_caja ) AND  
	//								  ( "INGRESO"."FECHA_PAGO" = :MIAR ) AND  
	//								  ( "INGRESO"."TIPO_MOV" = 'S' ) AND  
	//								  ( "INGRESO"."PAGO_HIST" = 'A' )   ;
	//						if isnull(ll_suma_desc) then ll_suma_desc = 0
						end if
						ls_forma_pago			= tab_1.tabpage_1.dw_ingreso.getitemstring(ll_indi,'forma_pago')
						ls_cond_pago			= tab_1.tabpage_1.dw_ingreso.getitemstring(ll_indi,'vista_sap_debe_condicion_pago')
						
						ls_rut_sap				= tab_1.tabpage_1.dw_ingreso.getitemstring(ll_indi,'vista_sap_debe_rut_cliente')
						Setnull(ls_cod_cliente_sap);SetNull(ll_n_cheque);Setnull(ls_nro_opera_trans)
						if ls_cond_pago <> '0' then
							ls_cod_cliente_sap	= f_existe_sap(ls_rut_sap)
						end if
						ll_monto					= tab_1.tabpage_1.dw_ingreso.getitemnumber(ll_indi,'suma_monto')
						
	//					if ls_cod_pago='EF' then
	//						ll_monto				= ll_monto + ll_count_cta_fututa
	//					end if
						ll_comi_monto			= tab_1.tabpage_1.dw_ingreso.getitemnumber(ll_indi,'suma_monto_comi')
						ls_centro					= tab_1.tabpage_1.dw_ingreso.getitemstring(ll_indi,'sap_cuentas_contables_centro_costo')
						ls_via_pago				= tab_1.tabpage_1.dw_ingreso.getitemstring(ll_indi,'sap_cuentas_contables_via_pago_sap')
						ls_centro_benef		= tab_1.tabpage_1.dw_ingreso.getitemstring(ll_indi,'sap_cuentas_contables_centro_beneficio')
						ld_fecha_valor			= MIAR
						if ll_comi_monto > 0 then
							ll_monto_uf			= round(ll_monto / ldb_valor_uf,4)
							INSERT INTO 	"SAP_DEBE_SAP"  
											  ( "CODIGO_CAJA_LLAVE",		"FECHA_PAGO",	"COD_PAGO",	"COD_PAGO_ANEXO",		"COD_CAJA",	"CUENTA_CONTABLE",	"DESCRIPCION_CUENTA",	"CENTRO",	"VIA_PAGO_SAP",		"FECHA_VALOR",	"MONTO",	"FOLIO_BOLETA_DEPOSITO",	"FECHA_VENC_CHEQUE",	"REF_DCTO",	"NRO_OPERACION_TRANS",		"FOLIO_BOLETA",	"CLAVE_CONTAB",		"ITEM",	"CORRELATIVO",	"CENTRO_BENEFICIO",	"NRO_CLIENTE_SAP",		"NRO_ENVIO" ) 
							VALUES 		  ( :ls_llave,   						:MIAR, 				:ls_cod_pago,  	:ls_cond_pago, 			:ls_caja,  		:ls_cuenta_contable,   	:ls_descripcion_cuenta,  		:ls_centro, 	:ls_via_pago,  			:ld_fecha_valor, 	:ll_monto, 	:ll_folio_deposito,  				:ldt_fecha_cheque, 			:ls_ref_dcto,  	:ls_nro_opera_trans,  			:ll_folio_boleta,		:ls_clave_contab,		1,			:ll_corre_debe,		:ls_centro_benef,			:ls_cod_cliente_sap,		:ll_contar_envio )  
							USING		sqlca;
							if sqlca.sqlcode=0 then
								commit;
								ll_corre_debe ++
								
								SELECT	DISTINCT "SAP_CUENTAS_CONTABLES"."CUENTA_CONTABLE",		"SAP_CUENTAS_CONTABLES"."DESCRIPCION_CUENTA"  
								INTO 			:ls_cuenta_contable, 												:ls_descripcion_cuenta  
								FROM 		"SAP_CUENTAS_CONTABLES"  
								WHERE 	  ( "SAP_CUENTAS_CONTABLES"."COD_CAJA" = :ls_caja ) AND  
											  ( "SAP_CUENTAS_CONTABLES"."ESTADO_CHEQUE" = :ls_cond_pago ) AND  
											  ( "SAP_CUENTAS_CONTABLES"."COD_PAGO" = :ls_tipo_comi )  
								USING		sqlca;
								if sqlca.sqlcode=0 then
									if len(ls_descripcion_cuenta) > 50 then ls_descripcion_cuenta = mid(ls_descripcion_cuenta,1,50)
									INSERT INTO 	"SAP_DEBE_SAP"  
													  ( "CODIGO_CAJA_LLAVE",		"FECHA_PAGO",	"COD_PAGO",	"COD_PAGO_ANEXO",		"COD_CAJA",	"CUENTA_CONTABLE",	"DESCRIPCION_CUENTA",	"CENTRO",	"VIA_PAGO_SAP",		"FECHA_VALOR",	"MONTO",			"FOLIO_BOLETA_DEPOSITO",	"FECHA_VENC_CHEQUE",	"REF_DCTO",	"NRO_OPERACION_TRANS",		"FOLIO_BOLETA",	"CLAVE_CONTAB",		"ITEM",	"CORRELATIVO",	"CENTRO_BENEFICIO",	"NRO_CLIENTE_SAP",		"NRO_ENVIO" ) 
									VALUES 		  ( :ls_llave,   						:MIAR, 				:ls_tipo_comi,  	:ls_cond_pago, 			:ls_caja,  		:ls_cuenta_contable,   	:ls_descripcion_cuenta,  		:ls_centro, 	:ls_via_pago,  			:ld_fecha_valor, 	:ll_comi_monto, 	:ll_folio_deposito,  				:ldt_fecha_cheque, 			:ls_ref_dcto,  	:ls_nro_opera_trans,  			:ll_folio_boleta,		:ls_clave_contab,		1,			:ll_corre_debe,		:ls_centro_benef,			:ls_cod_cliente_sap,		:ll_contar_envio )  
									USING		sqlca;
									if sqlca.sqlcode=0 then
										commit;
										ll_corre_debe ++
									else
										rollback;
									end if
								end if
							else
								rollback;
							end if
						elseif ls_cod_pago='CH' and ls_forma_pago='A FECHA' then
							DECLARE x1 CURSOR FOR  
							SELECT DISTINCT	"DOCUMENTOS"."FOLIO",	"DOCUMENTOS"."TIPO_COB",	"DOCUMENTOS"."N_CHEQUE",   "DOCUMENTOS"."COD_BANCO",   "DOCUMENTOS"."MONTO_UF",   "DOCUMENTOS"."FECHA_VENC",   "DOCUMENTOS"."NUM_CHEQUES",   "DOCUMENTOS"."ESTADO_CH",   "DOCUMENTOS"."GLOSA_CH",   "INGRESO"."BASE",   "INGRESO"."SERIE",   "INGRESO"."CONTRATO",	"INGRESO"."RUT",  "CLIENTE"."DV" 
							FROM 	"DOCUMENTOS",   "INGRESO", "CLIENTE"
							WHERE ( "DOCUMENTOS"."FOLIO" = "INGRESO"."FOLIO" ) and  
									  ( "DOCUMENTOS"."TIPO_COB" = "INGRESO"."TIPO_COB" ) and  
									  ( "DOCUMENTOS"."FECHA_PAGO" = "INGRESO"."FECHA_PAGO" ) and 
									  ( ingreso.rut = cliente.rut (+)) and  
									  ( "DOCUMENTOS"."COD_CAJA" = :ls_caja ) AND  
									  ( "DOCUMENTOS"."FECHA_PAGO" = :MIAR ) AND  
									  ( "INGRESO"."ESTADO_PAGO_SAP" > 0 AND "INGRESO"."ESTADO_PAGO_SAP" <= 99  ) AND
									  ( "DOCUMENTOS"."COD_PAGO" = 'CH' ) AND  
									  ( "DOCUMENTOS"."FECHA_PAGO" < "DOCUMENTOS"."FECHA_VENC" )   
							ORDER BY 	"DOCUMENTOS"."TIPO_COB" ASC,
										"DOCUMENTOS"."FOLIO" ASC
							USING	Trans_1;
							open x1;
							do while Trans_1.sqlcode=0 
								fetch x1 into :ll_folio_boleta_ch, :ls_tipo_cob_ch, :ll_n_cheque, :ll_cod_banco, :ll_monto_ch, :ldt_fecha_venc_ch, :ll_num_cheques, :ls_estado_ch, :ls_glosa_ch, :ls_base, :ls_serie, :ll_numero, :ll_rut_cli, :ls_dv_cli;
								if not isnull(ldt_fecha_venc_ch) and ll_monto_ch > 0 then
									ls_rut_sap			= string(ll_rut_cli)+'-'+ls_dv_cli
									if date(ldt_fecha_venc_ch) = date('01/01/1900') then Setnull(ldt_fecha_venc_ch)
									if ll_numero = 0 then
										SELECT	"CLIENTE_REZAGO"."BASE", 	"CLIENTE_REZAGO"."SERIE", 	"CLIENTE_REZAGO"."NUMERO", 	"CLIENTE_REZAGO"."RUT", 	"CLIENTE_REZAGO"."DV"  
										INTO 		:ls_base, 							:ls_serie, 							:ll_numero,								:ll_rut_cli,						:ls_dv_cli
										FROM 	"CLIENTE_REZAGO"  
										WHERE ( "CLIENTE_REZAGO"."COD_PAGO" = :ls_tipo_cob_ch ) AND ( "CLIENTE_REZAGO"."FOLIO" = :ll_folio_boleta_ch ) AND ( "CLIENTE_REZAGO"."FECHA_PAGO" = :MIAR )   
										USING	Trans_2;
										ls_rut_sap			= string(ll_rut_cli)+'-'+ls_dv_cli
									end if
									ls_ref_dcto				= ls_base+ls_serie+string(ll_numero)
									ls_nro_opera_trans	= String(ll_n_cheque)
									if ls_cond_pago <> '0' then
										ls_cod_cliente_sap	= f_existe_sap(ls_rut_sap)
									end if
									
									INSERT INTO 	"SAP_DEBE_SAP"  
													  ( "CODIGO_CAJA_LLAVE",		"FECHA_PAGO",	"COD_PAGO",	"COD_PAGO_ANEXO",		"COD_CAJA",	"CUENTA_CONTABLE",	"DESCRIPCION_CUENTA",	"CENTRO",	"VIA_PAGO_SAP",		"FECHA_VALOR",		"MONTO",		"FOLIO_BOLETA_DEPOSITO",	"FECHA_VENC_CHEQUE",	"REF_DCTO",	"NRO_OPERACION_TRANS",		"FOLIO_BOLETA",		"CLAVE_CONTAB",		"ITEM",	"CORRELATIVO",	"CENTRO_BENEFICIO",	"NRO_CLIENTE_SAP",		"NRO_ENVIO" ) 
									VALUES 		  ( :ls_llave,   						:MIAR, 				:ls_cod_pago,  	:ls_cond_pago, 			:ls_caja,  		:ls_cuenta_contable,   	:ls_descripcion_cuenta,  		:ls_centro, 	:ls_via_pago,  			:ldt_fecha_venc_ch, 	:ll_monto_ch, 	:ll_folio_deposito,  				:ldt_fecha_venc_ch, 			:ls_ref_dcto,  	:ls_nro_opera_trans,  			:ll_folio_boleta_ch,	:ls_clave_contab,		1,			:ll_corre_debe,		:ls_centro_benef,			:ls_cod_cliente_sap,		:ll_contar_envio)  
									USING		sqlca;
									if sqlca.sqlcode=0 then
										commit;
										ll_corre_debe ++
									else
										rollback;
									end if
								end if
								Setnull(ldt_fecha_venc);Setnull(ll_monto_ch);Setnull(ls_ref_dcto);Setnull(ll_folio_boleta_ch);SetNull(ll_n_cheque);Setnull(ls_nro_opera_trans)
							loop
							close x1;
						else
							INSERT INTO 	"SAP_DEBE_SAP"  
											  ( "CODIGO_CAJA_LLAVE",		"FECHA_PAGO",	"COD_PAGO",	"COD_PAGO_ANEXO",		"COD_CAJA",	"CUENTA_CONTABLE",	"DESCRIPCION_CUENTA",	"CENTRO",	"VIA_PAGO_SAP",		"FECHA_VALOR",	"MONTO",	"FOLIO_BOLETA_DEPOSITO",	"FECHA_VENC_CHEQUE",	"REF_DCTO",	"NRO_OPERACION_TRANS",		"FOLIO_BOLETA",	"CLAVE_CONTAB",		"ITEM",	"CORRELATIVO",	"CENTRO_BENEFICIO",	"NRO_CLIENTE_SAP",		"NRO_ENVIO" ) 
							VALUES 		  ( :ls_llave,   						:MIAR, 				:ls_cod_pago,  	:ls_cond_pago, 			:ls_caja,  		:ls_cuenta_contable,   	:ls_descripcion_cuenta,  		:ls_centro, 	:ls_via_pago,  			:ld_fecha_valor, 	:ll_monto, 	:ll_folio_deposito,  				:ldt_fecha_cheque, 			:ls_ref_dcto,  	:ls_nro_opera_trans,  			:ll_folio_boleta,		:ls_clave_contab,		1,			:ll_corre_debe,		:ls_centro_benef,			:ls_cod_cliente_sap,		:ll_contar_envio )  
							USING		sqlca;
							if sqlca.sqlcode=0 then
								commit;
								ll_corre_debe ++
							else
								rollback;
							end if
						end if
					next
					
	//				tab_1.tabpage_1.dw_debe.retrieve(ls_caja, MIAR,il_item)
				end if
				if il_estado_sap_retrieve=0 then il_estado_sap_retrieve=1
				ll_tot_reg		= tab_1.tabpage_1.dw_ingreso_sap.retrieve(ls_caja,MIAR,il_estado_sap_retrieve)		//1
				if ll_tot_reg=0 then
					messagebox("Advertencia","No registra Dato INGRESO SAP")
					DELETE FROM 	"SAP_CABECERA_PAGOS"  
					WHERE 		  ( "SAP_CABECERA_PAGOS"."COD_CAJA" = :ls_caja ) AND  
									  ( "SAP_CABECERA_PAGOS"."FECHA_PAGO" = :MIAR ) AND
									  ( "SAP_CABECERA_PAGOS"."ESTADO_SAP" = 3 OR "SAP_CABECERA_PAGOS"."ESTADO_SAP" = 4 ) 
					USING		sqlca;
					if sqlca.sqlcode=0 then
						commit;
						tab_1.tabpage_1.dw_cabecera.reset()
					else
						rollback;
						messagebox("Error Eliminar","Error Eliminar SAP_CABECERA_PAGOS SQL: "+sqlca.sqlerrtext)
					end if
				else
					ll_corre							= 1
					ll_ctas_pag_cred				= 0
					ll_ctas_pag_m					= 0
					il_cant_pie						= 0
					for ll_indi=1 to ll_tot_reg
						tab_1.tabpage_1.dw_ingreso_sap.setitem(ll_indi,'estado_reg',1)
						ls_tipo_cob					= tab_1.tabpage_1.dw_ingreso_sap.getitemstring(ll_indi,'tipo_cob')
						ll_folio						= tab_1.tabpage_1.dw_ingreso_sap.getitemnumber(ll_indi,'folio')
						
						if ll_folio = 0 then Setnull(ll_folio)
						ls_tipo_mov					= tab_1.tabpage_1.dw_ingreso_sap.getitemstring(ll_indi,'tipo_mov')
						ls_moneda					= tab_1.tabpage_1.dw_ingreso_sap.getitemstring(ll_indi,'vista_sap_haber_moneda')
						ll_monto_uf					= tab_1.tabpage_1.dw_ingreso_sap.getitemnumber(ll_indi,'vista_sap_haber_monto_uf')
						ldb_mto_ctto				= tab_1.tabpage_1.dw_ingreso_sap.getitemnumber(ll_indi,'vista_sap_haber_monto_uf')
						if ls_moneda='1' then
							ldb_mto_ctto			= ldb_mto_ctto
						elseif ls_moneda='2' then
							ldb_mto_ctto			= round(ldb_mto_ctto * ldb_valor_uf,0)
						end if
						
						
						if ls_moneda='1' then
							ll_monto					= round(ll_monto_uf,0)
							ll_monto_uf				= round(ll_monto_uf / ldb_valor_uf,16)
						elseif ls_moneda='2' then
							ll_monto					= round(ll_monto_uf * ldb_valor_uf,0)
							ll_monto_uf				= ll_monto_uf
						end if
						
						if ls_tipo_mov = 'S' then
							ll_monto					= ll_monto * -1
						end if
						ls_base						= tab_1.tabpage_1.dw_ingreso_sap.getitemstring(ll_indi,'base')
						ls_serie						= tab_1.tabpage_1.dw_ingreso_sap.getitemstring(ll_indi,'serie')
						ll_numero					= tab_1.tabpage_1.dw_ingreso_sap.getitemnumber(ll_indi,'numero')
						ls_rezago					= tab_1.tabpage_1.dw_ingreso_sap.getitemstring(ll_indi,'rezago')
						ldb_valor_uf					= tab_1.tabpage_1.dw_ingreso_sap.getitemnumber(ll_indi,'valor_uf')
						ll_rut							= tab_1.tabpage_1.dw_ingreso_sap.getitemnumber(ll_indi,'rut')
						ll_cuotas_pag				= tab_1.tabpage_1.dw_ingreso_sap.getitemnumber(ll_indi,'cuotas_pag')
						ls_codigo_otro				= tab_1.tabpage_1.dw_ingreso_sap.getitemstring(ll_indi,'codigo_otro')
						ll_cod_parque_reg			= tab_1.tabpage_1.dw_ingreso_sap.getitemnumber(ll_indi,'cod_parque')
						ls_cuenta_contable		= tab_1.tabpage_1.dw_ingreso_sap.getitemstring(ll_indi,'cuenta_contable')
						ls_descripcion_cuenta		= tab_1.tabpage_1.dw_ingreso_sap.getitemstring(ll_indi,'descripcion_cuenta')
						ls_sociedad_reg			= tab_1.tabpage_1.dw_ingreso_sap.getitemstring(ll_indi,'sociedad')
						ls_cliente_sap				= TRIM(tab_1.tabpage_1.dw_ingreso_sap.getitemstring(ll_indi,'vista_sap_haber_cliente_sap'))
						ls_centro						= tab_1.tabpage_1.dw_ingreso_sap.getitemstring(ll_indi,'vista_sap_haber_centro')
						ls_contrato_sap			= tab_1.tabpage_1.dw_ingreso_sap.getitemstring(ll_indi,'vista_sap_haber_contrato_sap')
						ls_clave_pago				= tab_1.tabpage_1.dw_ingreso_sap.getitemstring(ll_indi,'vista_sap_haber_condicion_pago')
						
						ll_nro_cuota					= tab_1.tabpage_1.dw_ingreso_sap.getitemnumber(ll_indi,'vista_sap_haber_ctas_pag_ctto')
//						if ll_numero=214469 then
//							messagebox("a","a")
//						end if
						
						
//						if ll_folio=223359 then
//							messagebox("a","a")
//						end if
						//if isnull(ls_cliente_sap) or ls_cliente_sap='' or isnull(ls_contrato_sap) or ls_contrato_sap='' then
//						if ls_tipo_mov='A' or ls_tipo_mov='B' or ls_tipo_mov='C' or ls_tipo_mov='H' or ls_tipo_mov='I' or ls_tipo_mov='K' or &
//							   ls_tipo_mov='L' or ls_tipo_mov='M' or ls_tipo_mov='N' or ls_tipo_mov='O' or ls_tipo_mov='Q' or &
//							   ls_tipo_mov='U' or ls_tipo_mov='W' or ls_tipo_mov='Y' or ls_tipo_mov='Z' or ls_tipo_mov='K' or &
//							   isnull(ls_cliente_sap) or ls_cliente_sap='' or isnull(ls_contrato_sap) or ls_contrato_sap='' then
						
							if ls_tipo_mov='B' or ls_tipo_mov='C' or ls_tipo_mov='H' or ls_tipo_mov='I' or ls_tipo_mov='N' or ls_tipo_mov='O' or &
							   /*ls_tipo_mov='U' or*/ ls_tipo_mov='W' or ls_tipo_mov='Y' or ls_tipo_mov='Z' or &
							   isnull(ls_cliente_sap) or ls_cliente_sap='' or ((isnull(ls_contrato_sap) or ls_contrato_sap='') and ls_rezago='N' ) then
								
								tab_1.tabpage_1.dw_ingreso_sap.setitem(ll_indi,'estado_reg',0)
							end if
						//end if
						ls_nro_opera_trans		= '0'
						ls_ref_dcto					= ls_base+ls_serie+string(ll_numero)
						ls_via_pago					= tab_1.tabpage_1.dw_ingreso_sap.getitemstring(ll_indi,'vista_sap_haber_via_pago_sap')
						ls_clave_contab_h			= tab_1.tabpage_1.dw_ingreso_sap.getitemstring(ll_indi,'vista_sap_haber_clave_contab')
						ll_ctas_pag_cred			= tab_1.tabpage_1.dw_ingreso_sap.getitemnumber(ll_indi,'cadena_mora_ctas_pag_s')
						ll_ctas_pag_m				= tab_1.tabpage_1.dw_ingreso_sap.getitemnumber(ll_indi,'vista_sap_haber_ctas_pag_m')
						ls_centro_benef			= tab_1.tabpage_1.dw_ingreso_sap.getitemstring(ll_indi,'vista_sap_haber_centro_beneficio')
						if ls_tipo_cob='NE' then ls_contrato_sap='0'
						if ls_rezago='S' then
							SELECT	"CLIENTE_REZAGO"."BASE",		"CLIENTE_REZAGO"."SERIE",	"CLIENTE_REZAGO"."NUMERO"  
							INTO 		:ls_base,								:ls_serie,								:ll_numero  
							FROM 	"CLIENTE_REZAGO"  
							WHERE ( "CLIENTE_REZAGO"."COD_PAGO" = :ls_tipo_cob ) AND  
									  ( "CLIENTE_REZAGO"."FOLIO" = :ll_folio ) AND  
									  ( "CLIENTE_REZAGO"."CAJA" = :ls_caja ) AND  
									  ( "CLIENTE_REZAGO"."FECHA_PAGO" = :MIAR )   ;
							if (ls_tipo_mov <> 'L' and ls_codigo_otro <> '3' and ls_tipo_mov <> 'M') or (ls_tipo_mov = 'L' and ls_codigo_otro = '3') then	
								ls_contrato_sap		= '0'
							end if 
						end if
						ldt_fecha_venc					= MIAR
						
						if not isnull(ls_contrato_sap)  then	//ls_cliente_sap
							DECLARE funcion_deuda PROCEDURE FOR F_TIPO_DEUDA_ING (:ls_base,:ls_serie,:ll_numero,:ls_tipo_mov);
							EXECUTE funcion_deuda;
							if sqlca.sqlcode=0 then
								fetch funcion_deuda into :ls_tipo_deuda;
								close funcion_deuda;
							end if
						
							if (ls_tipo_mov='E' or ls_tipo_mov='K' or ls_tipo_mov='U') then
								for ll_fila_e= 1 to ll_cuotas_pag
									
									if ll_fila_e=1 then
										ll_ctas_pag_cred			= (ll_nro_cuota - ll_cuotas_pag)
										ll_ctas_pag_cred ++
									else	
										ll_ctas_pag_cred ++
									end if
									ls_nro_opera_trans			= string(ll_ctas_pag_cred,'000')
									ldb_valor_posic					= wf_valor_cuota(ls_base,ls_serie,ll_numero,ls_tipo_mov,ls_tipo_deuda,ll_ctas_pag_cred)
									if not isnull(ldb_valor_posic) and ldb_valor_posic>0 then
										if ls_moneda='1' then
											ll_monto					= ldb_valor_posic
											ll_monto_uf				= round(ldb_valor_posic / ldb_valor_uf,0)
										elseif ls_moneda='2' then
											ll_monto					= round(ldb_valor_posic * ldb_valor_uf,0)
											ll_monto_uf				= ldb_valor_posic
										end if
									end if
									
									if ls_moneda = '2' then
										//ldt_fecha_venc
										INSERT INTO 	  "SAP_HABER_SAP"  
															( "CODIGO_CAJA_LLAVE",	"FECHA_PAGO",	"COD_CAJA",	"NRO_CLIENTE_SAP",		"CUENTA_CONTABLE",	"DESCRIPCION_CUENTA",	"CENTRO",	"NRO_CONTRATO_SAP",		"CLAVE_PAGO",	"VIA_PAGO",	"FECHA_VENC_DCTO",	"REF_DCTO",	"NRO_OPERA_TRANSBANK",	"FOLIO_BOLETA",	"MONTO",		"CORRELATIVO",	"CLAVE_CONTAB",			"ITEM",		"CENTRO_BENEFICIO",	"NRO_ENVIO", 		"MONTO_CLP",	"TIPO_COB",	"TIPO_MOV",	"CODIGO_OTRO" )  
										VALUES 			( :ls_llave, 						:MIAR, 				:ls_caja,			:ls_cliente_sap,				:ls_cta_puente,				:ls_descrip_cta_puente,		:ls_centro,	:ls_contrato_sap,				:ls_clave_pago,		:ls_via_pago,	Null,							:ls_ref_dcto,	:ls_nro_opera_trans,				:ll_folio,				:ll_monto,		:ll_corre,				:ls_clave_contab_haber,	1,				null,							:ll_contar_envio,	:ldb_mto_ctto,	:ls_tipo_cob,	:ls_tipo_mov,	:ls_codigo_otro )  
										USING		sqlca;
										if sqlca.sqlcode=0 then
											commit;
											ll_det_asiento2 ++
											
											INSERT INTO 	  "SAP_HABER_SAP"  
																( "CODIGO_CAJA_LLAVE",	"FECHA_PAGO",	"COD_CAJA",	"NRO_CLIENTE_SAP",		"CUENTA_CONTABLE",	"DESCRIPCION_CUENTA",	"CENTRO",	"NRO_CONTRATO_SAP",		"CLAVE_PAGO",	"VIA_PAGO",	"FECHA_VENC_DCTO",	"REF_DCTO",	"NRO_OPERA_TRANSBANK",	"FOLIO_BOLETA",	"MONTO",		"CORRELATIVO",	"CLAVE_CONTAB",		"ITEM",	"CENTRO_BENEFICIO",	"MONTO_HABER_LOCAL",	"NRO_ENVIO",		"MONTO_CLP",	"TIPO_COB",	"TIPO_MOV",	"CODIGO_OTRO" )  
											VALUES 			( :ls_llave, 						:MIAR, 				:ls_caja,			:ls_cliente_sap,				:ls_cuenta_contable,		:ls_descripcion_cuenta,		:ls_centro,	:ls_contrato_sap,				:ls_clave_pago,		:ls_via_pago,	:ldt_fecha_venc,			:ls_ref_dcto,	:ls_nro_opera_trans,				:ll_folio,				:ll_monto_uf,	:ll_corre,				:ls_clave_contab_h,	2,			:ls_centro_benef,			:ll_monto,						:ll_contar_envio,	:ldb_mto_ctto,	:ls_tipo_cob,	:ls_tipo_mov, 	:ls_codigo_otro)  
											USING		sqlca;
											if sqlca.sqlcode=0 then
												commit;
												
												ll_corre_debe ++
												
												INSERT INTO 	"SAP_DEBE_SAP"  
																  ( "CODIGO_CAJA_LLAVE",		"FECHA_PAGO",	"COD_PAGO",	"COD_PAGO_ANEXO",		"COD_CAJA",	"CUENTA_CONTABLE",	"DESCRIPCION_CUENTA",	"CENTRO",	"VIA_PAGO_SAP",		"FECHA_VALOR",	"MONTO",		"FOLIO_BOLETA_DEPOSITO",	"FECHA_VENC_CHEQUE",	"REF_DCTO",	"NRO_OPERACION_TRANS",		"FOLIO_BOLETA",	"CLAVE_CONTAB",				"ITEM",	"CORRELATIVO",	"MONTO_DEBE_LOCAL",		"NRO_ENVIO" ) 
												VALUES 		  ( :ls_llave,   						:MIAR, 				:ls_cod_pago,  	:ls_cond_pago, 			:ls_caja,  		:ls_cta_puente,   			:ls_descrip_cta_puente,  	null, 			null,  						:ld_fecha_valor, 	:ll_monto_uf, 	null,  									null, 								:ls_ref_dcto,  	null,  									null,					:ls_clave_contab_debe,		2,			:ll_corre_debe,		:ll_monto,						:ll_contar_envio )  
												USING		sqlca;
												if sqlca.sqlcode=0 then
													commit;
													ll_det_asiento2 ++
													ll_corre_debe ++
												else
													rollback;
												end if
												ll_corre ++
											else
												rollback;
											end if
										else
											rollback;
										end if
									else
										INSERT INTO 	  "SAP_HABER_SAP"  
															( "CODIGO_CAJA_LLAVE",	"FECHA_PAGO",	"COD_CAJA",	"NRO_CLIENTE_SAP",		"CUENTA_CONTABLE",	"DESCRIPCION_CUENTA",	"CENTRO",	"NRO_CONTRATO_SAP",		"CLAVE_PAGO",	"VIA_PAGO",	"FECHA_VENC_DCTO",	"REF_DCTO",	"NRO_OPERA_TRANSBANK",	"FOLIO_BOLETA",	"MONTO",		"CORRELATIVO",	"CLAVE_CONTAB",		"ITEM",	"CENTRO_BENEFICIO",	"NRO_ENVIO",	"MONTO_CLP",	"TIPO_COB",	"TIPO_MOV",	"CODIGO_OTRO"	 )  
										VALUES 			( :ls_llave, 						:MIAR, 				:ls_caja,			:ls_cliente_sap,				:ls_cuenta_contable,		:ls_descripcion_cuenta,		:ls_centro,	:ls_contrato_sap,				:ls_clave_pago,		:ls_via_pago,	:ldt_fecha_venc,			:ls_ref_dcto,	:ls_nro_opera_trans,				:ll_folio,				:ll_monto,	:ll_corre,				:ls_clave_contab_h,	1,			:ls_centro_benef,			:ll_contar_envio, :ldb_mto_ctto,	:ls_tipo_cob,	:ls_tipo_mov,	:ls_codigo_otro )  
										USING		sqlca;
										if sqlca.sqlcode=0 then
											commit;
											ll_corre ++
										else
											rollback;
										end if
									end if
								next
							elseif ls_tipo_mov='F' then
								for ll_fila_f= 1 to ll_cuotas_pag
									if ll_fila_f=1 then
										ll_ctas_pag_m					= (ll_nro_cuota - ll_cuotas_pag)
										ll_ctas_pag_m ++
									else	
										ll_ctas_pag_m ++
									end if
									ls_nro_opera_trans				= string(ll_ctas_pag_m,'000')
									ldb_valor_posic						= wf_valor_cuota(ls_base,ls_serie,ll_numero,ls_tipo_mov,ls_tipo_deuda,ll_ctas_pag_m)	
									if not isnull(ldb_valor_posic) and ldb_valor_posic>0 then
										if ls_moneda='1' then
											ll_monto					= ldb_valor_posic
											ll_monto_uf				= round(ldb_valor_posic / ldb_valor_uf,0)
										elseif ls_moneda='2' then
											ll_monto					= round(ldb_valor_posic * ldb_valor_uf,0)
											ll_monto_uf				= ldb_valor_posic
										end if
									end if
									
									INSERT INTO 	  "SAP_HABER_SAP"  
														( "CODIGO_CAJA_LLAVE",	"FECHA_PAGO",	"COD_CAJA",	"NRO_CLIENTE_SAP",		"CUENTA_CONTABLE",	"DESCRIPCION_CUENTA",	"CENTRO",	"NRO_CONTRATO_SAP",		"CLAVE_PAGO",	"VIA_PAGO",	"FECHA_VENC_DCTO",	"REF_DCTO",	"NRO_OPERA_TRANSBANK",	"FOLIO_BOLETA",	"MONTO",		"CORRELATIVO",	"CLAVE_CONTAB",			"ITEM",	"CENTRO_BENEFICIO",	"NRO_ENVIO",	"MONTO_CLP",	"TIPO_COB",	"TIPO_MOV",	"CODIGO_OTRO" ) 
									VALUES 			( :ls_llave, 						:MIAR, 				:ls_caja,			:ls_cliente_sap,				:ls_cta_puente,				:ls_descrip_cta_puente,		:ls_centro,	:ls_contrato_sap,				:ls_clave_pago,		:ls_via_pago,	Null,							:ls_ref_dcto,	:ls_nro_opera_trans,				:ll_folio,				:ll_monto,		:ll_corre,				:ls_clave_contab_haber,	1,			null,							:ll_contar_envio,	:ldb_mto_ctto,	:ls_tipo_cob,	:ls_tipo_mov,	:ls_codigo_otro )  
									USING		sqlca;
									if sqlca.sqlcode=0 then
										commit;
										ll_det_asiento2 ++
										INSERT INTO 	  "SAP_HABER_SAP"  
															( "CODIGO_CAJA_LLAVE",	"FECHA_PAGO",	"COD_CAJA",	"NRO_CLIENTE_SAP",		"CUENTA_CONTABLE",	"DESCRIPCION_CUENTA",	"CENTRO",	"NRO_CONTRATO_SAP",		"CLAVE_PAGO",	"VIA_PAGO",	"FECHA_VENC_DCTO",	"REF_DCTO",	"NRO_OPERA_TRANSBANK",	"FOLIO_BOLETA",	"MONTO",		"CORRELATIVO",	"CLAVE_CONTAB",		"ITEM",	"CENTRO_BENEFICIO",	"MONTO_HABER_LOCAL",	"NRO_ENVIO",	"MONTO_CLP",	"TIPO_COB",	"TIPO_MOV",	"CODIGO_OTRO" )  
										VALUES 			( :ls_llave, 						:MIAR, 				:ls_caja,			:ls_cliente_sap,				:ls_cuenta_contable,		:ls_descripcion_cuenta,		:ls_centro,	:ls_contrato_sap,				:ls_clave_pago,		:ls_via_pago,	:ldt_fecha_venc,			:ls_ref_dcto,	:ls_nro_opera_trans,				:ll_folio,				:ll_monto_uf,	:ll_corre,				:ls_clave_contab_h,	2,			:ls_centro_benef,			:ll_monto,						:ll_contar_envio,	:ldb_mto_ctto,	:ls_tipo_cob,	:ls_tipo_mov,	:ls_codigo_otro )  
										USING		sqlca;
										if sqlca.sqlcode=0 then
											commit;
											ll_corre_debe ++
											INSERT INTO 	"SAP_DEBE_SAP"  
															  ( "CODIGO_CAJA_LLAVE",		"FECHA_PAGO",	"COD_PAGO",	"COD_PAGO_ANEXO",		"COD_CAJA",	"CUENTA_CONTABLE",	"DESCRIPCION_CUENTA",	"CENTRO",	"VIA_PAGO_SAP",		"FECHA_VALOR",	"MONTO",		"FOLIO_BOLETA_DEPOSITO",	"FECHA_VENC_CHEQUE",	"REF_DCTO",	"NRO_OPERACION_TRANS",		"FOLIO_BOLETA",	"CLAVE_CONTAB",				"ITEM",	"CORRELATIVO",	"MONTO_DEBE_LOCAL",	"NRO_ENVIO" ) 
											VALUES 		  ( :ls_llave,   						:MIAR, 				:ls_cod_pago,  	:ls_cond_pago, 			:ls_caja,  		:ls_cta_puente,   			:ls_descrip_cta_puente,  	null, 			null,  						:ld_fecha_valor, 	:ll_monto_uf, 	null,  									null, 								:ls_ref_dcto,  	null,  									null,					:ls_clave_contab_debe,		2,			:ll_corre_debe,		:ll_monto,					:ll_contar_envio )  
											USING		sqlca;
											if sqlca.sqlcode=0 then
												commit;
												ll_det_asiento2 ++
												ll_corre_debe ++
											else
												rollback;
											end if
											ll_corre ++
										else
											rollback;
										end if
									else
										rollback;
									end if
								next
							elseif ls_tipo_mov = 'A' OR  ls_tipo_mov = 'Q' then
//								if ll_folio=190364 then
//									messagebox("a","a")
//								end if
								ldt_fec_pago							= datetime(date(MIAR),time('00:00:00'))
								SELECT	count("NUMERO_CUOTA")  
								INTO 		:ll_cuotas_pag  
								FROM		"DETALLE_PAGO_PIE"  
								WHERE	( "DETALLE_PAGO_PIE"."BASE" = :ls_base ) AND  
											( "DETALLE_PAGO_PIE"."SERIE" = :ls_serie ) AND  
											( "DETALLE_PAGO_PIE"."NUMERO" = :ll_numero ) AND
											( "DETALLE_PAGO_PIE"."FOLIO" = :ll_folio ) AND
											//( "DETALLE_PAGO_PIE"."FECHA_PAGO" = :ldt_fec_pago ) AND
											( "DETALLE_PAGO_PIE"."ESTADO" = 'C' )
								USING	sqlca;
								if isnull(ll_cuotas_pag) or ll_cuotas_pag=0 then ll_cuotas_pag=1
								
								FOR ll_fila_p= 1 to ll_cuotas_pag
									if ll_fila_p=1 then
										ll_ctas_pag_pie					= (ll_nro_cuota - ll_cuotas_pag)
										ll_ctas_pag_pie ++
									else	
										ll_ctas_pag_pie ++
									end if
									ls_nro_opera_trans				= 'P'+string(ll_ctas_pag_pie,'00')
									
									DECLARE funcion_pie_sap PROCEDURE FOR F_SAP_VALIDA_CTAS_PAG (:ls_base,:ls_serie,:ll_numero,:ls_tipo_mov,'C',:ll_ctas_pag_pie);
									EXECUTE funcion_pie_sap;
									if sqlca.sqlcode=0 then
										fetch funcion_pie_sap into :ldb_valor_posic;
										close funcion_pie_sap;
									end if
									if isnull(ldb_valor_posic) or ldb_valor_posic=0 then
										if ls_moneda='1' then
											ldb_valor_posic			= wf_valor_pie(2,ls_base,ls_serie,ll_numero,ll_folio,ls_tipo_mov,ldt_fec_pago,ll_monto,ll_ctas_pag_pie)
										elseif ls_moneda='2' then
											ldb_valor_posic			= wf_valor_pie(2,ls_base,ls_serie,ll_numero,ll_folio,ls_tipo_mov,ldt_fec_pago,ll_monto_uf,ll_ctas_pag_pie)
										end if
										if ls_moneda='1' then
											ll_monto					= ldb_valor_posic
											ll_monto_uf				= round(ldb_valor_posic / ldb_valor_uf,0)
										elseif ls_moneda='2' then
											ll_monto					= round(ldb_valor_posic * ldb_valor_uf,0)
											ll_monto_uf				= ldb_valor_posic
										end if
									else
										if ls_moneda='1' then
											ll_monto					= ldb_valor_posic
											ll_monto_uf				= round(ldb_valor_posic / ldb_valor_uf,0)
										elseif ls_moneda='2' then
											ll_monto					= round(ldb_valor_posic * ldb_valor_uf,0)
											ll_monto_uf				= ldb_valor_posic
										end if
									end if
									
									if ls_moneda = '2' then
										INSERT INTO 	  "SAP_HABER_SAP"  
															( "CODIGO_CAJA_LLAVE",	"FECHA_PAGO",	"COD_CAJA",	"NRO_CLIENTE_SAP",		"CUENTA_CONTABLE",	"DESCRIPCION_CUENTA",	"CENTRO",	"NRO_CONTRATO_SAP",		"CLAVE_PAGO",	"VIA_PAGO",	"FECHA_VENC_DCTO",	"REF_DCTO",	"NRO_OPERA_TRANSBANK",	"FOLIO_BOLETA",	"MONTO",		"CORRELATIVO",	"CLAVE_CONTAB",			"ITEM",	"CENTRO_BENEFICIO",	"NRO_ENVIO",	"MONTO_CLP",	"TIPO_COB",	"TIPO_MOV",	"CODIGO_OTRO" )  
										VALUES 			( :ls_llave, 						:MIAR, 				:ls_caja,			:ls_cliente_sap,				:ls_cta_puente,				:ls_descrip_cta_puente,		:ls_centro,	:ls_contrato_sap,				:ls_clave_pago,		:ls_via_pago,	Null,							:ls_ref_dcto,	:ls_nro_opera_trans,				:ll_folio,				:ll_monto,		:ll_corre,				:ls_clave_contab_haber,	1,			null,							:ll_contar_envio,	:ldb_mto_ctto,	:ls_tipo_cob,	:ls_tipo_mov,	:ls_codigo_otro )  
										USING		sqlca;
										if sqlca.sqlcode=0 then
											commit;
											
											if ls_tipo_cob='NE' and ls_cond_pago='EF' then
												Setnull(ls_cliente_sap)
											end if
											ll_det_asiento2 ++
											
											INSERT INTO 	  "SAP_HABER_SAP"  
																( "CODIGO_CAJA_LLAVE",	"FECHA_PAGO",	"COD_CAJA",	"NRO_CLIENTE_SAP",		"CUENTA_CONTABLE",	"DESCRIPCION_CUENTA",	"CENTRO",	"NRO_CONTRATO_SAP",		"CLAVE_PAGO",	"VIA_PAGO",	"FECHA_VENC_DCTO",	"REF_DCTO",	"NRO_OPERA_TRANSBANK",	"FOLIO_BOLETA",	"MONTO",		"CORRELATIVO",	"CLAVE_CONTAB",		"ITEM",	"CENTRO_BENEFICIO",	"MONTO_HABER_LOCAL",	"NRO_ENVIO",	"MONTO_CLP",	"TIPO_COB",	"TIPO_MOV",	"CODIGO_OTRO" )  
											VALUES 			( :ls_llave, 						:MIAR, 				:ls_caja,			:ls_cliente_sap,				:ls_cuenta_contable,		:ls_descripcion_cuenta,		:ls_centro,	:ls_contrato_sap,				:ls_clave_pago,		:ls_via_pago,	:ldt_fecha_venc,			:ls_ref_dcto,	:ls_nro_opera_trans,				:ll_folio,				:ll_monto_uf,	:ll_corre,				:ls_clave_contab_h,	2,			:ls_centro_benef,			:ll_monto,						:ll_contar_envio,	:ldb_mto_ctto,	:ls_tipo_cob,	:ls_tipo_mov,	:ls_codigo_otro )  
											USING		sqlca;
											if sqlca.sqlcode=0 then
												commit;
												ll_corre_debe ++
												INSERT INTO 	"SAP_DEBE_SAP"  
																  ( "CODIGO_CAJA_LLAVE",		"FECHA_PAGO",	"COD_PAGO",	"COD_PAGO_ANEXO",		"COD_CAJA",	"CUENTA_CONTABLE",	"DESCRIPCION_CUENTA",	"CENTRO",	"VIA_PAGO_SAP",		"FECHA_VALOR",	"MONTO",		"FOLIO_BOLETA_DEPOSITO",	"FECHA_VENC_CHEQUE",	"REF_DCTO",	"NRO_OPERACION_TRANS",		"FOLIO_BOLETA",	"CLAVE_CONTAB",				"ITEM",	"CORRELATIVO",	"MONTO_DEBE_LOCAL",		"NRO_ENVIO" ) 
												VALUES 		  ( :ls_llave,   						:MIAR, 				:ls_cod_pago,  	:ls_cond_pago, 			:ls_caja,  		:ls_cta_puente,   			:ls_descrip_cta_puente,  	null, 			null,  						:ld_fecha_valor, 	:ll_monto_uf, 	null,  									null, 								:ls_ref_dcto,  	null,  									null,					:ls_clave_contab_debe,		2,			:ll_corre_debe,		:ll_monto,						:ll_contar_envio )  
												USING		sqlca;
												if sqlca.sqlcode=0 then
													commit;
													ll_det_asiento2 ++
													ll_corre_debe ++
												else
													rollback;
												end if
												ll_corre ++
											else
												rollback;
											end if
										else
											rollback;
										end if
									else
										INSERT INTO 	  "SAP_HABER_SAP"  
															( "CODIGO_CAJA_LLAVE",	"FECHA_PAGO",	"COD_CAJA",	"NRO_CLIENTE_SAP",		"CUENTA_CONTABLE",	"DESCRIPCION_CUENTA",	"CENTRO",	"NRO_CONTRATO_SAP",		"CLAVE_PAGO",	"VIA_PAGO",	"FECHA_VENC_DCTO",	"REF_DCTO",	"NRO_OPERA_TRANSBANK",	"FOLIO_BOLETA",	"MONTO",		"CORRELATIVO",	"CLAVE_CONTAB",		"ITEM",	"CENTRO_BENEFICIO",	"NRO_ENVIO",	"MONTO_CLP",	"TIPO_COB",	"TIPO_MOV",	"CODIGO_OTRO" )  
										VALUES 			( :ls_llave, 						:MIAR, 				:ls_caja,			:ls_cliente_sap,				:ls_cuenta_contable,		:ls_descripcion_cuenta,		:ls_centro,	:ls_contrato_sap,				:ls_clave_pago,		:ls_via_pago,	:ldt_fecha_venc,			:ls_ref_dcto,	:ls_nro_opera_trans,				:ll_folio,				:ll_monto,		:ll_corre,				:ls_clave_contab_h,	1,			:ls_centro_benef,			:ll_contar_envio,	:ldb_mto_ctto,	:ls_tipo_cob,	:ls_tipo_mov,	:ls_codigo_otro )  
										USING		sqlca;
										if sqlca.sqlcode=0 then
											commit;
											ll_corre ++
										else
											rollback;
										end if
									end if
								NEXT
							else
								if ls_moneda = '2' or ls_tipo_mov='R' or ls_tipo_mov='P' then
									if ls_tipo_mov = 'M' or ( ls_tipo_mov='L' and ls_codigo_otro<>'3') then
										ls_nro_opera_trans						= '001'
										SELECT 	count("SAP_CADENA_SERVICIO"."BASE")
										INTO		:ll_tot_serv
										FROM 	"SAP_CADENA_SERVICIO"
										WHERE 	"SAP_CADENA_SERVICIO"."BASE" = :ls_base AND
													"SAP_CADENA_SERVICIO"."SERIE" = :ls_serie AND
													"SAP_CADENA_SERVICIO"."NUMERO" = :ll_numero AND
													"SAP_CADENA_SERVICIO"."TIPO_DEUDA" = 'S' AND
													"SAP_CADENA_SERVICIO"."FOLIO_COMPROBANTE" = :ll_folio
										USING	sqlca ;
										if isnull(ll_tot_serv) then ll_tot_serv=0
										if ll_tot_serv>0 then
											SELECT 	distinct ("SAP_CADENA_SERVICIO"."FOLIO_CONSULTA")
											INTO		:ls_ref_dcto
											FROM 	"SAP_CADENA_SERVICIO"
											WHERE 	"SAP_CADENA_SERVICIO"."BASE" = :ls_base AND
														"SAP_CADENA_SERVICIO"."SERIE" = :ls_serie AND
														"SAP_CADENA_SERVICIO"."NUMERO" = :ll_numero AND
														"SAP_CADENA_SERVICIO"."TIPO_DEUDA" = 'S' AND
														"SAP_CADENA_SERVICIO"."FOLIO_COMPROBANTE" = :ll_folio AND
														"SAP_CADENA_SERVICIO"."TIPO_COB_COMPROBANTE" = :ls_tipo_cob
											USING	sqlca ;
											if isnull(ls_ref_dcto) then ls_ref_dcto=''										
											
											SELECT	"COD_MATERIAL_SAP"
											INTO		:ls_material
											FROM		"SAP_SERVICIOS_CREACION"  
											WHERE	"SAP_SERVICIOS_CREACION"."BASE" = 'S' AND  
														"SAP_SERVICIOS_CREACION"."TIPO_COB" = :ls_tipo_cob AND  
														"SAP_SERVICIOS_CREACION"."TIPO_MOV" = :ls_tipo_mov AND
														"SAP_SERVICIOS_CREACION"."CODIGO_OTRO" = :ls_codigo_otro
											USING	sqlca;
											if isnull(ls_material) then ls_material=''
											if not isnull(ls_material) and ls_material<>'' then
												SELECT	"MTO_CTA_K"
												INTO		:ldb_valor_posic
												FROM		"SAP_CTTO_05_CUOTA"  
												WHERE	( "SAP_CTTO_05_CUOTA"."BASE" = :ls_base ) AND  
															( "SAP_CTTO_05_CUOTA"."SERIE" = :ls_serie ) AND  
															( "SAP_CTTO_05_CUOTA"."NUMERO" = :ll_numero ) AND  
															( "SAP_CTTO_05_CUOTA"."TIPO_DEUDA" = :ls_tipo_deuda ) AND  
															( "SAP_CTTO_05_CUOTA"."NRO_BOLETA" = :ll_folio ) AND  
															( "SAP_CTTO_05_CUOTA"."CODIGO_MATERIAL_SAP" = :ls_material )
												USING	sqlca;
												if isnull(ldb_valor_posic) then ldb_valor_posic=0
												if ldb_valor_posic>0 then
													if ls_moneda='1' then
														ll_monto					= ldb_valor_posic
														ll_monto_uf				= round(ldb_valor_posic / ldb_valor_uf,0)
													elseif ls_moneda='2' then
														ll_monto					= round(ldb_valor_posic * ldb_valor_uf,0)
														ll_monto_uf				= ldb_valor_posic
													end if
												end if
											end if
										end if
									end if	
										
									
									INSERT INTO 	  "SAP_HABER_SAP"  
														( "CODIGO_CAJA_LLAVE",	"FECHA_PAGO",	"COD_CAJA",	"NRO_CLIENTE_SAP",		"CUENTA_CONTABLE",	"DESCRIPCION_CUENTA",	"CENTRO",	"NRO_CONTRATO_SAP",		"CLAVE_PAGO",	"VIA_PAGO",	"FECHA_VENC_DCTO",	"REF_DCTO",	"NRO_OPERA_TRANSBANK",	"FOLIO_BOLETA",	"MONTO",		"CORRELATIVO",	"CLAVE_CONTAB",			"ITEM",	"CENTRO_BENEFICIO",	"NRO_ENVIO",	"MONTO_CLP",	"TIPO_COB",	"TIPO_MOV",	"CODIGO_OTRO" )  
									VALUES 			( :ls_llave, 						:MIAR, 				:ls_caja,			:ls_cliente_sap,				:ls_cta_puente,				:ls_descrip_cta_puente,		:ls_centro,	:ls_contrato_sap,				:ls_clave_pago,		:ls_via_pago,	Null,							:ls_ref_dcto,	:ls_nro_opera_trans,				:ll_folio,				:ll_monto,		:ll_corre,				:ls_clave_contab_haber,	1,			null,							:ll_contar_envio,	:ldb_mto_ctto,	:ls_tipo_cob,	:ls_tipo_mov, :ls_codigo_otro)  
									USING		sqlca;
									if sqlca.sqlcode=0 then
										commit;
										if ls_tipo_cob='NE' and ls_cond_pago='EF' then
											Setnull(ls_cliente_sap)
										end if
										ll_det_asiento2 ++
										
										INSERT INTO 	  "SAP_HABER_SAP"  
															( "CODIGO_CAJA_LLAVE",	"FECHA_PAGO",	"COD_CAJA",	"NRO_CLIENTE_SAP",		"CUENTA_CONTABLE",	"DESCRIPCION_CUENTA",	"CENTRO",	"NRO_CONTRATO_SAP",		"CLAVE_PAGO",	"VIA_PAGO",	"FECHA_VENC_DCTO",	"REF_DCTO",	"NRO_OPERA_TRANSBANK",	"FOLIO_BOLETA",	"MONTO",		"CORRELATIVO",	"CLAVE_CONTAB",		"ITEM",	"CENTRO_BENEFICIO",	"MONTO_HABER_LOCAL",	"NRO_ENVIO",	"MONTO_CLP",	"TIPO_COB",	"TIPO_MOV",	"CODIGO_OTRO" )  
										VALUES 			( :ls_llave, 						:MIAR, 				:ls_caja,			:ls_cliente_sap,				:ls_cuenta_contable,		:ls_descripcion_cuenta,		:ls_centro,	:ls_contrato_sap,				:ls_clave_pago,		:ls_via_pago,	:ldt_fecha_venc,			:ls_ref_dcto,	:ls_nro_opera_trans,				:ll_folio,				:ll_monto_uf,	:ll_corre,				:ls_clave_contab_h,	2,			:ls_centro_benef,			:ll_monto,						:ll_contar_envio,	:ldb_mto_ctto,	:ls_tipo_cob,	:ls_tipo_mov,	:ls_codigo_otro )  
										USING		sqlca;
										if sqlca.sqlcode=0 then
											commit;
											ll_corre_debe ++
											INSERT INTO 	"SAP_DEBE_SAP"  
															  ( "CODIGO_CAJA_LLAVE",		"FECHA_PAGO",	"COD_PAGO",	"COD_PAGO_ANEXO",		"COD_CAJA",	"CUENTA_CONTABLE",	"DESCRIPCION_CUENTA",	"CENTRO",	"VIA_PAGO_SAP",		"FECHA_VALOR",	"MONTO",		"FOLIO_BOLETA_DEPOSITO",	"FECHA_VENC_CHEQUE",	"REF_DCTO",	"NRO_OPERACION_TRANS",		"FOLIO_BOLETA",	"CLAVE_CONTAB",				"ITEM",	"CORRELATIVO",	"MONTO_DEBE_LOCAL",		"NRO_ENVIO" ) 
											VALUES 		  ( :ls_llave,   						:MIAR, 				:ls_cod_pago,  	:ls_cond_pago, 			:ls_caja,  		:ls_cta_puente,   			:ls_descrip_cta_puente,  	null, 			null,  						:ld_fecha_valor, 	:ll_monto_uf, 	null,  									null, 								:ls_ref_dcto,  	null,  									null,					:ls_clave_contab_debe,		2,			:ll_corre_debe,		:ll_monto,						:ll_contar_envio )  
											USING		sqlca;
											if sqlca.sqlcode=0 then
												commit;
												ll_det_asiento2 ++
												ll_corre_debe ++
											else
												rollback;
											end if
											ll_corre ++
										else
											rollback;
										end if
									else
										rollback;
									end if
								else
									INSERT INTO 	  "SAP_HABER_SAP"  
														( "CODIGO_CAJA_LLAVE",	"FECHA_PAGO",	"COD_CAJA",	"NRO_CLIENTE_SAP",		"CUENTA_CONTABLE",	"DESCRIPCION_CUENTA",	"CENTRO",	"NRO_CONTRATO_SAP",		"CLAVE_PAGO",	"VIA_PAGO",	"FECHA_VENC_DCTO",	"REF_DCTO",	"NRO_OPERA_TRANSBANK",	"FOLIO_BOLETA",	"MONTO",		"CORRELATIVO",	"CLAVE_CONTAB",		"ITEM",	"CENTRO_BENEFICIO",	"NRO_ENVIO",	"MONTO_CLP",	"TIPO_COB",	"TIPO_MOV",	"CODIGO_OTRO" )  
									VALUES 			( :ls_llave, 						:MIAR, 				:ls_caja,			:ls_cliente_sap,				:ls_cuenta_contable,		:ls_descripcion_cuenta,		:ls_centro,	:ls_contrato_sap,				:ls_clave_pago,		:ls_via_pago,	:ldt_fecha_venc,			:ls_ref_dcto,	:ls_nro_opera_trans,				:ll_folio,				:ll_monto,		:ll_corre,				:ls_clave_contab_h,	1,			:ls_centro_benef,			:ll_contar_envio,	:ldb_mto_ctto,	:ls_tipo_cob,	:ls_tipo_mov,	:ls_codigo_otro )  
									USING		sqlca;
									if sqlca.sqlcode=0 then
										commit;
										ll_corre ++
									else
										rollback;
									end if
								end if
								ll_ctas_pag_cred	= 0
								ll_ctas_pag_m		= 0
							end if
						end if
					next
					ll_fila													= tab_1.tabpage_1.dw_ingreso_sap.Find("estado_reg = 0",  1, ll_tot_reg)
					if ll_fila > 0 then
						messagebox("Advertencia","Recuerde Actualizar Pagos - NO Envio SAP")
						tab_1.tabpage_1.cb_centralizar.enabled	= false
						tab_1.tabpage_1.cb_envio.enabled		= false	
					end if
				end if
				if ll_cab_asiento2 > 0 and ll_det_asiento2 =0 then
					DELETE FROM 	"SAP_CABECERA_PAGOS"  
					WHERE 		  ( "SAP_CABECERA_PAGOS"."COD_CAJA" = :ls_caja ) AND  
									  ( "SAP_CABECERA_PAGOS"."FECHA_PAGO" = :MIAR ) AND
									  ( "SAP_CABECERA_PAGOS"."ITEM" = 2 ) AND
									  ( "SAP_CABECERA_PAGOS"."NRO_ENVIO" = :ll_contar_envio )
					USING		sqlca;
					if sqlca.sqlcode=0 then
						commit;
						ll_count ++
					else
						rollback;
						messagebox("Error Eliminar","Error Eliminar SAP_CABECERA_PAGOS SQL: "+sqlca.sqlerrtext)
					end if
				end if
				if tab_1.tabpage_1.dw_cabecera.rowcount() > 0 then
					il_item			= tab_1.tabpage_1.dw_cabecera.getitemnumber(tab_1.tabpage_1.dw_cabecera.getrow(),'item')
					tab_1.tabpage_1.dw_debe.retrieve(ls_caja,MIAR,il_item)
					tab_1.tabpage_1.dw_haber.retrieve(ls_caja,MIAR,il_item)
					tab_1.tabpage_1.dw_cabecera.scrolltorow(1)
					tab_1.tabpage_1.dw_cabecera.setfocus()
				end if
				SetPointer(Arrow!)
			end if
			if tab_1.tabpage_1.cb_revisar.text='Volver' then tab_1.tabpage_1.cb_revisar.triggerevent(clicked!)
		else
			messagebox("Advertencia","No Registra Pagos Caja "+ls_caja+ " con Fecha "+string(MIAR,'dd/mm/yyyy'))
		end if
	else
		if isnull(ls_caja) then
			messagebox("Advertencia","Debe Seleccionar CAJA")
			ddplb_caja.setfocus()
		elseif isnull(MIAR) then
			messagebox("Advertencia","Debe Seleccionar Fecha")
			em_1.setfocus()
		end if
	end if
//end if
end event

type cb_42 from commandbutton within w_sap_detalle_pagos_caja_2_bkp
integer x = 5573
integer y = 368
integer width = 402
integer height = 112
integer taborder = 60
integer textsize = -10
integer weight = 700
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string text = "original"
end type

event clicked;long 		ver,ll_pos,ll_cod_parque,ll_count,ll_count_ing,ll_tot_reg,ll_indi,ll_folio,ll_monto,ll_rut,ll_cuotas_pag,ll_cod_parque_reg,ll_fila_e,ll_fila_f,ll_monto_e,ll_monto_f,&
			ll_dias_contables,ll_corre,ll_comi_monto,ll_folio_deposito,ll_folio_boleta,ll_n_cheque, ll_cod_banco, ll_monto_ch, ll_num_cheques,ll_folio_boleta_ch,ll_corre_debe,&
			ll_folio_rez,ll_rut_rez,ll_ctas_pag_cred,ll_res,ll_suma_desc,ll_rut_cli,ll_cab_asiento2,ll_det_asiento2,ll_tot_reg_fi,ll_indi_fi,ll_ctas_pag_m,ll_fila,ll_sum_cta_dia,ll_count_cta_dia,&
			ll_count_pie,ll_ctas_pag_pie,ll_count_pend,ll_count_caja_sap,ll_contar_envio,ll_count_pie_sap,ll_count_reg,ll_nro_envio,ll_count_cta_fututa,ll_diferencia,ll_diferencia_m
Date 		MIAR,ldt_fecha_venc,ldt_fecha_proceso,ldt_fecha_contable,ld_fecha_valor,ldt_fecha_cheque,ldt_fecha_venc_ch
STRING 	ls_cod_parque,ls_caja,COMPA,ls_sociedad,ls_moneda,ls_clase,ls_ref1,ls_ref2,ls_hora,ls_tipo_cob,ls_tipo_mov,ls_base,ls_serie,ls_rezago,ls_codigo_otro,&
			ls_cuenta_contable,ls_descripcion_cuenta,ls_sociedad_reg,ls_cliente_sap,ls_centro,ls_contrato_sap,ls_llave,ls_clave_pago,ls_ref_dcto,ls_nro_opera_trans,&
			ls_via_pago,ls_pasa,ls_cod_pago, ls_forma_pago, ls_cond_pago,ls_tipo_comi,ls_estado_ch, ls_glosa_ch,ls_tipo_cob_ch,ls_clave_contab,ls_clave_contab_h,&
			ls_moneda_u, ls_cta_puente, ls_descrip_cta_puente,ls_clave_contab_peso_haber,ls_clave_contab_uf_debe,ls_clave_contab_uf_haber,	ls_clave_contab_peso_debe,&
			ls_base_rez, ls_serie_rez, ls_tipo_cob_rez,ls_centro_benef,ls_rut_sap,ls_cod_cliente_sap,ls_clave_contab_haber,ls_clave_contab_debe,ls_dv_cli,ls_contar,&
			ls_cadena
Time		lt_hora
Double	ldb_valor_uf,ll_monto_uf,ldb_uf_moneda,ldb_uf_pago,ll_numero,ll_numero_rez
Datetime	ldt_fecha_pago_rez

//gs_mandatario
tab_1.tabpage_2.dw_cliente_rezago.reset()
SetNull(il_estado_sap);SetNull(il_estado_sap_retrieve)
//MIAR 									= DATE(EM_1.TEXT)
ll_count								= 0
SELECT 		COUNT("SAP_CABECERA_PAGOS"."COD_CAJA")
INTO			:ll_count_reg
FROM 		"SAP_CABECERA_PAGOS"  
WHERE 	  ( "SAP_CABECERA_PAGOS"."ESTADO_SAP" = 3 ) OR  
			  ( "SAP_CABECERA_PAGOS"."ESTADO_SAP" = 4 ) OR  
			  ( "SAP_CABECERA_PAGOS"."ESTADO_SAP" = 2 )
USING	sqlca;
if ll_count_reg > 0 then
	messagebox("Advertencia","Existe(n) "+string(ll_count_reg,'###,###,##0') +" Asiento(s) Pendiente(s) se Eliminara(n)")
	
	if not isnull(ls_caja) and not isnull(MIAR) then
		tab_1.tabpage_2.dw_cliente_rezago.reset()
		tab_1.tabpage_2.dw_cliente_rezago.retrieve(3,'R')
		
		DECLARE X0 CURSOR FOR  
		SELECT 	"SAP_CABECERA_PAGOS"."COD_CAJA",   
					"SAP_CABECERA_PAGOS"."FECHA_PAGO",
					"SAP_CABECERA_PAGOS"."NRO_ENVIO"
		FROM 	"SAP_CABECERA_PAGOS"  
		WHERE ( "SAP_CABECERA_PAGOS"."ESTADO_SAP" = 3 ) OR  
				  ( "SAP_CABECERA_PAGOS"."ESTADO_SAP" = 4 ) OR  
				  ( "SAP_CABECERA_PAGOS"."ESTADO_SAP" = 2 )
		USING	sqlca;
		open x0;
		if sqlca.sqlcode=0 then
			do while sqlca.sqlcode=0
				fetch x0 into :ls_caja, :MIAR, :ll_nro_envio;
				if not isnull(ls_caja) then
					UPDATE	"CLIENTE_REZAGO"  
					SET 		"ESTADO_SAP" = 0 
					WHERE 	"CLIENTE_REZAGO"."ESTADO_SAP" = 3
					USING	sqlca	;
					if sqlca.sqlcode=0 then
						commit;
					else
						rollback;
						messagebox("Error Actualizar Cliente Rezago","Error Actualizar CLIENTE_REZAGO SQL: "+sqlca.sqlerrtext)
					end if
				
					DELETE FROM 	"SAP_CABECERA_PAGOS"  
					WHERE 		  ( "SAP_CABECERA_PAGOS"."COD_CAJA" = :ls_caja ) AND  
									  ( "SAP_CABECERA_PAGOS"."FECHA_PAGO" = :MIAR ) AND
									  ( "SAP_CABECERA_PAGOS"."ESTADO_SAP" = 3 OR "SAP_CABECERA_PAGOS"."ESTADO_SAP" = 4  OR "SAP_CABECERA_PAGOS"."ESTADO_SAP" = 2) AND
									  ( "SAP_CABECERA_PAGOS"."NRO_ENVIO" = :ll_nro_envio )
					USING		sqlca;
					if sqlca.sqlcode=0 then
						commit;
						ll_count ++
					else
						rollback;
						messagebox("Error Eliminar","Error Eliminar SAP_CABECERA_PAGOS SQL: "+sqlca.sqlerrtext)
					end if
					  
					DELETE FROM  "SAP_HABER_SAP"
					WHERE 		  ( "SAP_HABER_SAP"."COD_CAJA" = :ls_caja ) AND  
									  ( "SAP_HABER_SAP"."FECHA_PAGO" = :MIAR ) AND
									  ( "SAP_HABER_SAP"."NRO_ENVIO" = :ll_nro_envio )
					USING sqlca  ;
					if sqlca.sqlcode=0 then
						commit;
						ll_count ++
					else
						rollback;
						messagebox("Error Eliminar","Error Eliminar SAP_HABER_SAP SQL: "+sqlca.sqlerrtext)
					end if
					
					DELETE FROM  "SAP_DEBE_SAP" 
					WHERE 		  ( "SAP_DEBE_SAP"."COD_CAJA" = :ls_caja ) AND  
									  ( "SAP_DEBE_SAP"."FECHA_PAGO" = :MIAR ) AND
									  ( "SAP_DEBE_SAP"."NRO_ENVIO" = :ll_nro_envio )
					USING sqlca  ;
					if sqlca.sqlcode=0 then
						commit;
						ll_count ++
					else
						rollback;
						messagebox("Error Eliminar","Error Eliminar SAP_DEBE_SAP SQL: "+sqlca.sqlerrtext)
					end if
					if ll_count = 3 then
						tab_1.tabpage_1.dw_ingreso.reset()
						tab_1.tabpage_1.dw_ingreso_sap.reset()
						tab_1.tabpage_1.dw_cabecera.reset()
						tab_1.tabpage_1.dw_debe.reset()
						tab_1.tabpage_1.dw_haber.reset()
						messagebox("Eliminar","Eliminación Exitosa - Proceso Caja "+ls_caja+ " Fecha del "+string(MIAR,'dd/mm/yyyy') )
					end if
				end if
				Setnull(ls_caja)
			loop	
		end if
		close x0;
	else
		if isnull(ls_caja) then
			messagebox("Advertencia","Debe Seleccionar CAJA")
			ddplb_caja.setfocus()
		elseif isnull(MIAR) then
			messagebox("Advertencia","Debe Seleccionar Fecha")
			em_1.setfocus()
		end if
	end if
end if

//if tab_1.tabpage_1.cbx_asiento_pend.checked=true then
//	il_estado_sap			= 	1
//else
//	il_estado_sap			= 	0
//end if

//ll_tot_reg_fi			= tab_1.tabpage_2.dw_cliente_rezago.retrieve(3,'R')
//if ll_tot_reg_fi > 0 then
//	for ll_indi_fi=1 to ll_tot_reg_fi
//		tab_1.tabpage_2.dw_cliente_rezago.setitem(ll_indi_fi,'estado_reg',1)
//	next
//	tab_1.tabpage_2.dw_cliente_rezago.object.t_marca.text		= 'Marcar Todo'
//	tab_1.tabpage_2.dw_cliente_rezago.accepttext()
//end if
//if tab_1.tabpage_2.dw_cliente_rezago.rowcount() > 0 then
//	messagebox("Advertencia","Debe Procesar Cliente Rezago - CLIENTE FI")
//else
	Setnull(ldt_fecha_cheque);Setnull(ls_nro_opera_trans)
	ls_pasa								= 'S'
	ldt_fecha_proceso					= date(gdt_fec_sistema)
	MIAR 									= DATE(EM_1.TEXT)
	ll_pos									= pos(ddplb_caja.text,'-')
	ls_caja								= trim(mid(ddplb_caja.text,1,(ll_pos - 1)))
	ldt_fecha_venc						= MIAR
	ls_llave								= ls_caja+string(MIAR,'ddmmyyyy')
	ldb_uf_moneda						= Round(gd_uf_dia / 1000,4)
	ll_cab_asiento2						= 0
	ll_det_asiento2						= 0
	SELECT	"TAB_UF"."VALOR_UF"  
	INTO 		:ldb_valor_uf  
	FROM 	"TAB_UF"  
	WHERE 	"TAB_UF"."FECHA_UF" = :MIAR   ;
	ldb_uf_moneda						= Round(ldb_valor_uf / 1000,4)
	
//	il_item								= tab_1.tabpage_1.dw_cabecera.getitemnumber(tab_1.tabpage_1.dw_cabecera.getrow(),'item')
	if not isnull(ls_caja) and not isnull(MIAR) then
		SetPointer(HourGlass!)
		SELECT 	"SAP_CUENTA_PUENTE"."CUENTA_PUENTE",		"SAP_CUENTA_PUENTE"."DESCRIPCION_CUENTA",	"SAP_CUENTA_PUENTE"."CLAVE_CONTAB_PESO_HABER",	"SAP_CUENTA_PUENTE"."CLAVE_CONTAB_UF_DEBE",	"SAP_CUENTA_PUENTE"."CLAVE_CONTAB_UF_HABER",	"SAP_CUENTA_PUENTE"."CLAVE_CONTAB_PESO_DEBE"
		INTO 		:ls_cta_puente,												:ls_descrip_cta_puente,										:ls_clave_contab_haber,										:ls_clave_contab_debe,										:ls_clave_contab_uf_haber,										:ls_clave_contab_peso_debe
		FROM		"SAP_CUENTA_PUENTE"  
		USING	sqlca;
		
		DECLARE a1 CURSOR FOR  
		SELECT 	"VISTA_SAP_CLIENTE_REZAGO"."BASE",   
					"VISTA_SAP_CLIENTE_REZAGO"."SERIE",   
					"VISTA_SAP_CLIENTE_REZAGO"."NUMERO",   
					"VISTA_SAP_CLIENTE_REZAGO"."TIPO_COB",   
					"VISTA_SAP_CLIENTE_REZAGO"."FOLIO",   
					"VISTA_SAP_CLIENTE_REZAGO"."FECHA_PAGO",   
					"VISTA_SAP_CLIENTE_REZAGO"."RUT"
		FROM 	"VISTA_SAP_CLIENTE_REZAGO"  
		WHERE ( "VISTA_SAP_CLIENTE_REZAGO"."CAJA" = :ls_caja ) AND  
				  ( "VISTA_SAP_CLIENTE_REZAGO"."FECHA_PAGO" = :MIAR ) AND  
				  ( "VISTA_SAP_CLIENTE_REZAGO"."ESTADO_SAP" = 0 )    
		USING	Trans_1;
		OPEN a1;
			do while Trans_1.sqlcode=0 
				fetch a1 into :ls_base_rez, :ls_serie_rez, :ll_numero_rez, :ls_tipo_cob_rez, :ll_folio_rez, :ldt_fecha_pago_rez, :ll_rut_rez ;
				if not isnull(ls_base_rez) and ll_rut_rez > 0 then
					UPDATE	"CLIENTE_REZAGO"  
					SET 		"ESTADO_SAP" = 3  
					WHERE ( "CLIENTE_REZAGO"."COD_PAGO" = :ls_tipo_cob_rez ) AND  
							  ( "CLIENTE_REZAGO"."FOLIO" = :ll_folio_rez ) AND  
							  ( "CLIENTE_REZAGO"."FECHA_PAGO" = :MIAR ) AND  
							  ( "CLIENTE_REZAGO"."RUT" = :ll_rut_rez )  
					USING	sqlca;
					if sqlca.sqlcode=0 then
						commit;
					else
						rollback;
						messagebox("Error Grabar","Error Actualizar Cliente Rezago SQL: "+sqlca.sqlerrtext)
					end if
				end if
			loop
		Close a1;
		
		SetPointer(Arrow!)
		SELECT	Count("INGRESO"."TIPO_COB")
		INTO 		:ll_count_ing  
		FROM 	"INGRESO"  
		WHERE ( "INGRESO"."COD_CAJA" = :ls_caja ) AND  
				  ( "INGRESO"."FECHA_PAGO" = :MIAR ) AND
				  ( "INGRESO"."ESTADO_PAGO_SAP" > 0 AND "INGRESO"."ESTADO_PAGO_SAP" <= 99 ) AND
				  ( "INGRESO"."PAGO_HIST" = 'A' ) ;
		if ll_count_ing > 0 then
			SetPointer(HourGlass!)
			SELECT DISTINCT	"SAP_CLASE_DOCUMENTO"."CLASE_DOC",	sysdate  
			INTO		:ls_clase,											:gdt_fec_sistema  
			FROM 	"SAP_CLASE_DOCUMENTO"  
			WHERE 	"SAP_CLASE_DOCUMENTO"."TIPO_MOV" = 'BE'  ;
			lt_hora						= Time(gdt_fec_sistema)
			ls_hora						= mid(string(lt_hora),1,2)+mid(string(lt_hora),4,2)
			SELECT	"SAP_SOCIEDAD_FI"."SOCIEDAD",		"SAP_SOCIEDAD_FI"."MONEDA",	"CODIGO_CAJAS"."DIAS_CONTABLES"
			INTO 		:ls_sociedad,								:ls_moneda,								:ll_dias_contables	
			FROM 	"CODIGO_CAJAS",		"SAP_SOCIEDAD_FI"  
			WHERE ( "CODIGO_CAJAS"."COD_PARQUE" = "SAP_SOCIEDAD_FI"."COD_PARQUE" ) and  
					  ( "CODIGO_CAJAS"."COD_CAJA" = :ls_caja ) 
			USING	sqlca;
			if sqlca.sqlcode=0 then
				if ls_moneda='CLP' then
					ls_moneda_u		= 'UF'
				end if
				if ls_moneda='BOB' then
					ls_moneda_u		= 'US'
				end if
				ldt_fecha_contable		= RelativeDate(MIAR,  ll_dias_contables)
				
				
				SELECT	COUNT("INGRESO"."TIPO_COB")
				INTO 		:ll_count_pend  
				FROM 	"INGRESO"  
				WHERE ( "INGRESO"."COD_CAJA" = :ls_caja ) AND  
						  ( "INGRESO"."FECHA_PAGO" = :MIAR ) AND  
						  ( "INGRESO"."ESTADO_PAGO_SAP" > 0 AND "INGRESO"."ESTADO_PAGO_SAP" < 90 ) 
				USING	sqlca;
				
				SELECT	COUNT("SAP_CABECERA_PAGOS"."SOCIEDAD")
				INTO 		:ll_count_caja_sap  
				FROM 	"SAP_CABECERA_PAGOS"  
				WHERE ( "SAP_CABECERA_PAGOS"."COD_CAJA" = :ls_caja ) AND  
						  ( "SAP_CABECERA_PAGOS"."FECHA_PAGO" = :MIAR )  AND
						  ( "SAP_CABECERA_PAGOS"."MONEDA" = 'CLP' ) 
				USING	sqlca;

				if ll_count_pend=0 and ll_count_caja_sap=0 then
					tab_1.tabpage_1.cbx_asiento_pend.checked	= false
					ls_contar													= string(ll_count_pend,'00')
					il_estado_sap											= 0
					il_estado_sap_retrieve								= 0
				elseif ll_count_pend>0 and ll_count_caja_sap=0 then
					tab_1.tabpage_1.cbx_asiento_pend.checked	= false
					il_estado_sap											= 1
					ls_contar													= string(il_estado_sap,'00')		//ll_count_caja_sap
					il_estado_sap_retrieve								= 99		//0									// 1
				elseif ll_count_pend>0 and ll_count_caja_sap>0  then
					ls_contar													= string(ll_count_caja_sap,'00')
					tab_1.tabpage_1.cbx_asiento_pend.checked	= true
					il_estado_sap											= ll_count_caja_sap + 1
//					il_estado_sap_retrieve								= ll_count_caja_sap - 1
					il_estado_sap_retrieve								= ll_count_caja_sap
					ls_contar													= string((ll_count_caja_sap + 1),'00')	
				end if	
				ls_ref1														= ls_caja+string(MIAR,'ddmmyyyy')+'_'+ls_contar
				ls_ref2														= ls_caja+string(gdt_fec_sistema,'ddmmyyyy')+'_'+ls_contar
				ll_contar_envio												= long(ls_contar)
				
				SELECT 	Count("SAP_CABECERA_PAGOS"."CLASE_DOC")
				INTO 		:ll_count  
				FROM 	"SAP_CABECERA_PAGOS"  
				WHERE ( "SAP_CABECERA_PAGOS"."FECHA_PAGO" = :MIAR ) AND  
						  ( "SAP_CABECERA_PAGOS"."COD_CAJA" = :ls_caja );
				if ll_count > 0 and ll_count_caja_sap=1 and ll_count_pend=0 then
					ll_res				= messagebox("Advertencia","Caja "+ls_caja+" del "+string(MIAR,'dd/mm/yyyy') +" Ya está Registrada, desea Visualizar Centralización",Exclamation!,YesNo!,2)
					if ll_res=1 then
						tab_1.tabpage_1.dw_cabecera.retrieve(ls_caja,MIAR)
						tab_1.tabpage_1.dw_cabecera.scrolltorow(1)

						if il_estado_sap_retrieve = 0 then il_estado_sap_retrieve=1
						tab_1.tabpage_1.dw_ingreso.retrieve(ls_caja,MIAR,il_estado_sap_retrieve)		//1)
						ll_tot_reg	= tab_1.tabpage_1.dw_ingreso_sap.retrieve(ls_caja,MIAR,il_estado_sap_retrieve)		//1)
						
						if ll_tot_reg > 0 then
							for ll_indi=1 to ll_tot_reg
								 tab_1.tabpage_1.dw_ingreso_sap.setitem(ll_indi,'estado_reg',1)
							next
							 tab_1.tabpage_1.dw_ingreso_sap.accepttext()
						end if
						tab_1.tabpage_1.dw_debe.retrieve(ls_caja,MIAR,1)
						tab_1.tabpage_1.dw_haber.retrieve(ls_caja,MIAR,1)
					end if
					ls_pasa				= 'N'
				else
					INSERT INTO	"SAP_CABECERA_PAGOS"  
									  ( "ITEM",	"FECHA_PAGO",	"FECHA_RECEP_PAGO",	"CLASE_DOC",	"SOCIEDAD",	"MONEDA",	"FECHA_CONVERSION",	"REF_CAJA_CONTABLE1",	"REF_CAJA_CONTABLE2",	"ESTADO_SAP",	"COD_CAJA",	"HORA",		"FECHA_PROCESO",		"FECHA_CONTABLE",		"USUARIO",		"VALOR_MONEDA",	"MONEDA_LOCAL",	"NRO_ENVIO" )  
					VALUES 		  ( 1,			:MIAR,				:MIAR, 						:ls_clase,   		:ls_sociedad,	:ls_moneda,	:MIAR,						:ls_ref1,							:ls_ref2,							3,						:ls_caja,			:ls_hora,		:ldt_fecha_proceso,		:ldt_fecha_contable,		'WS_IF_FI',		0,							Null,						:ll_contar_envio )  
					USING		sqlca;
					if sqlca.sqlcode=0 then
						commit;
						INSERT INTO	"SAP_CABECERA_PAGOS"  
										  ( "ITEM",	"FECHA_PAGO",	"FECHA_RECEP_PAGO",	"CLASE_DOC",	"SOCIEDAD",	"MONEDA",		"FECHA_CONVERSION",	"REF_CAJA_CONTABLE1",	"REF_CAJA_CONTABLE2",	"ESTADO_SAP",	"COD_CAJA",	"HORA",		"FECHA_PROCESO",		"FECHA_CONTABLE",		"USUARIO",		"VALOR_MONEDA",	"MONEDA_LOCAL",	"NRO_ENVIO" )  
						VALUES 		  ( 2,			:MIAR,				:MIAR, 						:ls_clase,   		:ls_sociedad,	:ls_moneda_u,	:MIAR,						:ls_ref1,							:ls_ref2,							4,						:ls_caja,			:ls_hora,		:ldt_fecha_proceso,		:ldt_fecha_contable,		'WS_IF_FI',		0,							'CLP',						:ll_contar_envio  )  
						USING		sqlca;
						if sqlca.sqlcode=0 then
							commit;
							ll_cab_asiento2 ++
						else
							rollback;
						end if
						tab_1.tabpage_1.dw_cabecera.retrieve(ls_caja,MIAR)
					else
						rollback;
						messagebox("Error Grabar","Error al Grabar Cabecera Interfaz Pago - SAP SQL: "+sqlca.sqlerrtext)
					end if
				end if
			end if
			SetPointer(Arrow!)
			if ls_pasa='S' then
				SetPointer(HourGlass!)
				if il_estado_sap_retrieve=0 then il_estado_sap_retrieve=1
				ll_tot_reg						= tab_1.tabpage_1.dw_ingreso.retrieve(ls_caja,MIAR,il_estado_sap_retrieve)		//1)
				if ll_tot_reg > 0 then
					ll_corre_debe				= 1
					ll_corre						= 1
					Setnull(ls_nro_opera_trans);Setnull(ls_ref_dcto);SetNull(ll_n_cheque)
					for ll_indi=1 to ll_tot_reg
						ls_cuenta_contable	= tab_1.tabpage_1.dw_ingreso.getitemstring(ll_indi,'sap_cuentas_contables_cuenta_contable')
						ls_descripcion_cuenta	= tab_1.tabpage_1.dw_ingreso.getitemstring(ll_indi,'sap_cuentas_contables_descripcion_cuenta')
						ls_cod_pago				= tab_1.tabpage_1.dw_ingreso.getitemstring(ll_indi,'cod_pago')
						ls_clave_contab		= tab_1.tabpage_1.dw_ingreso.getitemstring(ll_indi,'sap_cuentas_contables_clave_contab')
						if len(ls_descripcion_cuenta) > 50 then ls_descripcion_cuenta = mid(ls_descripcion_cuenta,1,50)
						if ls_cod_pago='TC' then
							ls_tipo_comi			= 'CC'
						elseif ls_cod_pago='TD' then
							ls_tipo_comi			= 'CD'
	//					elseif ls_cod_pago='EF' then
	//						SELECT 	SUM("INGRESO"."MONTO")
	//						INTO 		:ll_suma_desc  
	//						FROM 	"INGRESO"  
	//						WHERE ( "INGRESO"."COD_CAJA" = :ls_caja ) AND  
	//								  ( "INGRESO"."FECHA_PAGO" = :MIAR ) AND  
	//								  ( "INGRESO"."TIPO_MOV" = 'S' ) AND  
	//								  ( "INGRESO"."PAGO_HIST" = 'A' )   ;
	//						if isnull(ll_suma_desc) then ll_suma_desc = 0
						end if
						ls_forma_pago			= tab_1.tabpage_1.dw_ingreso.getitemstring(ll_indi,'forma_pago')
						ls_cond_pago			= tab_1.tabpage_1.dw_ingreso.getitemstring(ll_indi,'vista_sap_debe_condicion_pago')
						ls_rut_sap				= tab_1.tabpage_1.dw_ingreso.getitemstring(ll_indi,'vista_sap_debe_rut_cliente')
						Setnull(ls_cod_cliente_sap);SetNull(ll_n_cheque);Setnull(ls_nro_opera_trans)
						if ls_cond_pago <> '0' then
							SELECT DISTINCT SAPABAP1.ZV_CLIENTES.KUNNR  
							INTO 		:ls_cod_cliente_sap  
							FROM 	SAPABAP1.ZV_CLIENTES  
							WHERE 	SAPABAP1.ZV_CLIENTES.STCD1 = :ls_rut_sap
							USING	Trans_hana;
						end if
						ll_monto					= tab_1.tabpage_1.dw_ingreso.getitemnumber(ll_indi,'suma_monto')
	//					if ls_cod_pago='EF' then
	//						ll_monto				= ll_monto + ll_count_cta_fututa
	//					end if
						ll_comi_monto			= tab_1.tabpage_1.dw_ingreso.getitemnumber(ll_indi,'suma_monto_comi')
						ls_centro					= tab_1.tabpage_1.dw_ingreso.getitemstring(ll_indi,'sap_cuentas_contables_centro_costo')
						ls_via_pago				= tab_1.tabpage_1.dw_ingreso.getitemstring(ll_indi,'sap_cuentas_contables_via_pago_sap')
						ls_centro_benef		= tab_1.tabpage_1.dw_ingreso.getitemstring(ll_indi,'sap_cuentas_contables_centro_beneficio')
						ld_fecha_valor			= MIAR
						if ll_comi_monto > 0 then
							ll_monto_uf			= round(ll_monto / ldb_valor_uf,4)
							INSERT INTO 	"SAP_DEBE_SAP"  
											  ( "CODIGO_CAJA_LLAVE",		"FECHA_PAGO",	"COD_PAGO",	"COD_PAGO_ANEXO",		"COD_CAJA",	"CUENTA_CONTABLE",	"DESCRIPCION_CUENTA",	"CENTRO",	"VIA_PAGO_SAP",		"FECHA_VALOR",	"MONTO",	"FOLIO_BOLETA_DEPOSITO",	"FECHA_VENC_CHEQUE",	"REF_DCTO",	"NRO_OPERACION_TRANS",		"FOLIO_BOLETA",	"CLAVE_CONTAB",		"ITEM",	"CORRELATIVO",	"CENTRO_BENEFICIO",	"NRO_CLIENTE_SAP",		"NRO_ENVIO" ) 
							VALUES 		  ( :ls_llave,   						:MIAR, 				:ls_cod_pago,  	:ls_cond_pago, 			:ls_caja,  		:ls_cuenta_contable,   	:ls_descripcion_cuenta,  		:ls_centro, 	:ls_via_pago,  			:ld_fecha_valor, 	:ll_monto, 	:ll_folio_deposito,  				:ldt_fecha_cheque, 			:ls_ref_dcto,  	:ls_nro_opera_trans,  			:ll_folio_boleta,		:ls_clave_contab,		1,			:ll_corre_debe,		:ls_centro_benef,			:ls_cod_cliente_sap,		:ll_contar_envio )  
							USING		sqlca;
							if sqlca.sqlcode=0 then
								commit;
								ll_corre_debe ++
								
								SELECT	DISTINCT "SAP_CUENTAS_CONTABLES"."CUENTA_CONTABLE",		"SAP_CUENTAS_CONTABLES"."DESCRIPCION_CUENTA"  
								INTO 			:ls_cuenta_contable, 												:ls_descripcion_cuenta  
								FROM 		"SAP_CUENTAS_CONTABLES"  
								WHERE 	  ( "SAP_CUENTAS_CONTABLES"."COD_CAJA" = :ls_caja ) AND  
											  ( "SAP_CUENTAS_CONTABLES"."ESTADO_CHEQUE" = :ls_cond_pago ) AND  
											  ( "SAP_CUENTAS_CONTABLES"."COD_PAGO" = :ls_tipo_comi )  
								USING		sqlca;
								if sqlca.sqlcode=0 then
									if len(ls_descripcion_cuenta) > 50 then ls_descripcion_cuenta = mid(ls_descripcion_cuenta,1,50)
									INSERT INTO 	"SAP_DEBE_SAP"  
													  ( "CODIGO_CAJA_LLAVE",		"FECHA_PAGO",	"COD_PAGO",	"COD_PAGO_ANEXO",		"COD_CAJA",	"CUENTA_CONTABLE",	"DESCRIPCION_CUENTA",	"CENTRO",	"VIA_PAGO_SAP",		"FECHA_VALOR",	"MONTO",			"FOLIO_BOLETA_DEPOSITO",	"FECHA_VENC_CHEQUE",	"REF_DCTO",	"NRO_OPERACION_TRANS",		"FOLIO_BOLETA",	"CLAVE_CONTAB",		"ITEM",	"CORRELATIVO",	"CENTRO_BENEFICIO",	"NRO_CLIENTE_SAP",		"NRO_ENVIO" ) 
									VALUES 		  ( :ls_llave,   						:MIAR, 				:ls_tipo_comi,  	:ls_cond_pago, 			:ls_caja,  		:ls_cuenta_contable,   	:ls_descripcion_cuenta,  		:ls_centro, 	:ls_via_pago,  			:ld_fecha_valor, 	:ll_comi_monto, 	:ll_folio_deposito,  				:ldt_fecha_cheque, 			:ls_ref_dcto,  	:ls_nro_opera_trans,  			:ll_folio_boleta,		:ls_clave_contab,		1,			:ll_corre_debe,		:ls_centro_benef,			:ls_cod_cliente_sap,		:ll_contar_envio )  
									USING		sqlca;
									if sqlca.sqlcode=0 then
										commit;
										ll_corre_debe ++
									else
										rollback;
									end if
								end if
							else
								rollback;
							end if
						elseif ls_cod_pago='CH' and ls_forma_pago='A FECHA' then
							DECLARE x1 CURSOR FOR  
							SELECT DISTINCT	"DOCUMENTOS"."FOLIO",	"DOCUMENTOS"."TIPO_COB",	"DOCUMENTOS"."N_CHEQUE",   "DOCUMENTOS"."COD_BANCO",   "DOCUMENTOS"."MONTO",   "DOCUMENTOS"."FECHA_VENC",   "DOCUMENTOS"."NUM_CHEQUES",   "DOCUMENTOS"."ESTADO_CH",   "DOCUMENTOS"."GLOSA_CH",   "INGRESO"."BASE",   "INGRESO"."SERIE",   "INGRESO"."CONTRATO",	"INGRESO"."RUT",  "CLIENTE"."DV" 
							FROM 	"DOCUMENTOS",   "INGRESO", "CLIENTE"
							WHERE ( "DOCUMENTOS"."FOLIO" = "INGRESO"."FOLIO" ) and  
									  ( "DOCUMENTOS"."TIPO_COB" = "INGRESO"."TIPO_COB" ) and  
									  ( "DOCUMENTOS"."FECHA_PAGO" = "INGRESO"."FECHA_PAGO" ) and 
									  ( ingreso.rut = cliente.rut (+)) and  
									  ( "DOCUMENTOS"."COD_CAJA" = :ls_caja ) AND  
									  ( "DOCUMENTOS"."FECHA_PAGO" = :MIAR ) AND  
									  ( "INGRESO"."ESTADO_PAGO_SAP" > 0 AND "INGRESO"."ESTADO_PAGO_SAP" <= 99  ) AND
									  ( "DOCUMENTOS"."COD_PAGO" = 'CH' ) AND  
									  ( "DOCUMENTOS"."FECHA_PAGO" < "DOCUMENTOS"."FECHA_VENC" )   
							ORDER BY 	"DOCUMENTOS"."TIPO_COB" ASC,
										"DOCUMENTOS"."FOLIO" ASC
							USING	Trans_1;
							open x1;
							do while Trans_1.sqlcode=0 
								fetch x1 into :ll_folio_boleta_ch, :ls_tipo_cob_ch, :ll_n_cheque, :ll_cod_banco, :ll_monto_ch, :ldt_fecha_venc_ch, :ll_num_cheques, :ls_estado_ch, :ls_glosa_ch, :ls_base, :ls_serie, :ll_numero, :ll_rut_cli, :ls_dv_cli;
								if not isnull(ldt_fecha_venc_ch) and ll_monto_ch > 0 then
									ls_rut_sap			= string(ll_rut_cli)+'-'+ls_dv_cli
									if date(ldt_fecha_venc_ch) = date('01/01/1900') then Setnull(ldt_fecha_venc_ch)
									if ll_numero = 0 then
										SELECT	"CLIENTE_REZAGO"."BASE", 	"CLIENTE_REZAGO"."SERIE", 	"CLIENTE_REZAGO"."NUMERO", 	"CLIENTE_REZAGO"."RUT", 	"CLIENTE_REZAGO"."DV"  
										INTO 		:ls_base, 							:ls_serie, 							:ll_numero,								:ll_rut_cli,						:ls_dv_cli
										FROM 	"CLIENTE_REZAGO"  
										WHERE ( "CLIENTE_REZAGO"."COD_PAGO" = :ls_tipo_cob_ch ) AND ( "CLIENTE_REZAGO"."FOLIO" = :ll_folio_boleta_ch ) AND ( "CLIENTE_REZAGO"."FECHA_PAGO" = :MIAR )   
										USING	Trans_2;
										ls_rut_sap			= string(ll_rut_cli)+'-'+ls_dv_cli
									end if
									ls_ref_dcto				= ls_base+ls_serie+string(ll_numero)
									ls_nro_opera_trans	= String(ll_n_cheque)
									if ls_cond_pago <> '0' then
										SELECT DISTINCT	SAPABAP1.ZV_CLIENTES.KUNNR  
										INTO 		:ls_cod_cliente_sap  
										FROM 	SAPABAP1.ZV_CLIENTES  
										WHERE 	SAPABAP1.ZV_CLIENTES.STCD1 = :ls_rut_sap 
										USING	Trans_hana;
									end if
									
									INSERT INTO 	"SAP_DEBE_SAP"  
													  ( "CODIGO_CAJA_LLAVE",		"FECHA_PAGO",	"COD_PAGO",	"COD_PAGO_ANEXO",		"COD_CAJA",	"CUENTA_CONTABLE",	"DESCRIPCION_CUENTA",	"CENTRO",	"VIA_PAGO_SAP",		"FECHA_VALOR",		"MONTO",		"FOLIO_BOLETA_DEPOSITO",	"FECHA_VENC_CHEQUE",	"REF_DCTO",	"NRO_OPERACION_TRANS",		"FOLIO_BOLETA",		"CLAVE_CONTAB",		"ITEM",	"CORRELATIVO",	"CENTRO_BENEFICIO",	"NRO_CLIENTE_SAP",		"NRO_ENVIO" ) 
									VALUES 		  ( :ls_llave,   						:MIAR, 				:ls_cod_pago,  	:ls_cond_pago, 			:ls_caja,  		:ls_cuenta_contable,   	:ls_descripcion_cuenta,  		:ls_centro, 	:ls_via_pago,  			:ldt_fecha_venc_ch, 	:ll_monto_ch, 	:ll_folio_deposito,  				:ldt_fecha_venc_ch, 			:ls_ref_dcto,  	:ls_nro_opera_trans,  			:ll_folio_boleta_ch,	:ls_clave_contab,		1,			:ll_corre_debe,		:ls_centro_benef,			:ls_cod_cliente_sap,		:ll_contar_envio)  
									USING		sqlca;
									if sqlca.sqlcode=0 then
										commit;
										ll_corre_debe ++
									else
										rollback;
									end if
								end if
								Setnull(ldt_fecha_venc);Setnull(ll_monto_ch);Setnull(ls_ref_dcto);Setnull(ll_folio_boleta_ch);SetNull(ll_n_cheque);Setnull(ls_nro_opera_trans)
							loop
							close x1;
						else
							INSERT INTO 	"SAP_DEBE_SAP"  
											  ( "CODIGO_CAJA_LLAVE",		"FECHA_PAGO",	"COD_PAGO",	"COD_PAGO_ANEXO",		"COD_CAJA",	"CUENTA_CONTABLE",	"DESCRIPCION_CUENTA",	"CENTRO",	"VIA_PAGO_SAP",		"FECHA_VALOR",	"MONTO",	"FOLIO_BOLETA_DEPOSITO",	"FECHA_VENC_CHEQUE",	"REF_DCTO",	"NRO_OPERACION_TRANS",		"FOLIO_BOLETA",	"CLAVE_CONTAB",		"ITEM",	"CORRELATIVO",	"CENTRO_BENEFICIO",	"NRO_CLIENTE_SAP",		"NRO_ENVIO" ) 
							VALUES 		  ( :ls_llave,   						:MIAR, 				:ls_cod_pago,  	:ls_cond_pago, 			:ls_caja,  		:ls_cuenta_contable,   	:ls_descripcion_cuenta,  		:ls_centro, 	:ls_via_pago,  			:ld_fecha_valor, 	:ll_monto, 	:ll_folio_deposito,  				:ldt_fecha_cheque, 			:ls_ref_dcto,  	:ls_nro_opera_trans,  			:ll_folio_boleta,		:ls_clave_contab,		1,			:ll_corre_debe,		:ls_centro_benef,			:ls_cod_cliente_sap,		:ll_contar_envio )  
							USING		sqlca;
							if sqlca.sqlcode=0 then
								commit;
								ll_corre_debe ++
							else
								rollback;
							end if
						end if
					next
					
	//				tab_1.tabpage_1.dw_debe.retrieve(ls_caja, MIAR,il_item)
				end if
				if il_estado_sap_retrieve=0 then il_estado_sap_retrieve=1
				ll_tot_reg		= tab_1.tabpage_1.dw_ingreso_sap.retrieve(ls_caja,MIAR,il_estado_sap_retrieve)		//1
				if ll_tot_reg=0 then
					messagebox("Advertencia","No registra Dato INGRESO SAP")
					DELETE FROM 	"SAP_CABECERA_PAGOS"  
					WHERE 		  ( "SAP_CABECERA_PAGOS"."COD_CAJA" = :ls_caja ) AND  
									  ( "SAP_CABECERA_PAGOS"."FECHA_PAGO" = :MIAR ) AND
									  ( "SAP_CABECERA_PAGOS"."ESTADO_SAP" = 3 OR "SAP_CABECERA_PAGOS"."ESTADO_SAP" = 4 ) 
					USING		sqlca;
					if sqlca.sqlcode=0 then
						commit;
						tab_1.tabpage_1.dw_cabecera.reset()
					else
						rollback;
						messagebox("Error Eliminar","Error Eliminar SAP_CABECERA_PAGOS SQL: "+sqlca.sqlerrtext)
					end if
				else
					ll_corre							= 1
					ll_ctas_pag_cred				= 0
					ll_ctas_pag_m					= 0
					il_cant_pie						= 0
					for ll_indi=1 to ll_tot_reg
						tab_1.tabpage_1.dw_ingreso_sap.setitem(ll_indi,'estado_reg',1)
						ls_tipo_cob					= tab_1.tabpage_1.dw_ingreso_sap.getitemstring(ll_indi,'tipo_cob')
						ll_folio						= tab_1.tabpage_1.dw_ingreso_sap.getitemnumber(ll_indi,'folio')
					
						if ll_folio = 0 then Setnull(ll_folio)
						ls_tipo_mov					= tab_1.tabpage_1.dw_ingreso_sap.getitemstring(ll_indi,'tipo_mov')
						ll_monto						= tab_1.tabpage_1.dw_ingreso_sap.getitemnumber(ll_indi,'monto')
						if ls_tipo_mov = 'S' then
							ll_monto					= ll_monto * -1
						end if
						ls_base						= tab_1.tabpage_1.dw_ingreso_sap.getitemstring(ll_indi,'base')
						ls_serie						= tab_1.tabpage_1.dw_ingreso_sap.getitemstring(ll_indi,'serie')
						ll_numero					= tab_1.tabpage_1.dw_ingreso_sap.getitemnumber(ll_indi,'numero')
						ls_rezago					= tab_1.tabpage_1.dw_ingreso_sap.getitemstring(ll_indi,'rezago')
						ldb_valor_uf					= tab_1.tabpage_1.dw_ingreso_sap.getitemnumber(ll_indi,'valor_uf')
						ll_rut							= tab_1.tabpage_1.dw_ingreso_sap.getitemnumber(ll_indi,'rut')
						ll_cuotas_pag				= tab_1.tabpage_1.dw_ingreso_sap.getitemnumber(ll_indi,'cuotas_pag')
						ls_codigo_otro				= tab_1.tabpage_1.dw_ingreso_sap.getitemstring(ll_indi,'codigo_otro')
						ll_cod_parque_reg			= tab_1.tabpage_1.dw_ingreso_sap.getitemnumber(ll_indi,'cod_parque')
						ls_cuenta_contable		= tab_1.tabpage_1.dw_ingreso_sap.getitemstring(ll_indi,'cuenta_contable')
						ls_descripcion_cuenta		= tab_1.tabpage_1.dw_ingreso_sap.getitemstring(ll_indi,'descripcion_cuenta')
						ls_sociedad_reg			= tab_1.tabpage_1.dw_ingreso_sap.getitemstring(ll_indi,'sociedad')
						ls_cliente_sap				= TRIM(tab_1.tabpage_1.dw_ingreso_sap.getitemstring(ll_indi,'vista_sap_haber_cliente_sap'))
						ls_centro						= tab_1.tabpage_1.dw_ingreso_sap.getitemstring(ll_indi,'vista_sap_haber_centro')
						ls_contrato_sap			= tab_1.tabpage_1.dw_ingreso_sap.getitemstring(ll_indi,'vista_sap_haber_contrato_sap')
						ls_clave_pago				= tab_1.tabpage_1.dw_ingreso_sap.getitemstring(ll_indi,'vista_sap_haber_condicion_pago')
//						if ll_folio=223359 then
//							messagebox("a","a")
//						end if
						//if isnull(ls_cliente_sap) or ls_cliente_sap='' or isnull(ls_contrato_sap) or ls_contrato_sap='' then
//						if ls_tipo_mov='A' or ls_tipo_mov='B' or ls_tipo_mov='C' or ls_tipo_mov='H' or ls_tipo_mov='I' or ls_tipo_mov='K' or &
//							   ls_tipo_mov='L' or ls_tipo_mov='M' or ls_tipo_mov='N' or ls_tipo_mov='O' or ls_tipo_mov='Q' or &
//							   ls_tipo_mov='U' or ls_tipo_mov='W' or ls_tipo_mov='Y' or ls_tipo_mov='Z' or ls_tipo_mov='K' or &
//							   isnull(ls_cliente_sap) or ls_cliente_sap='' or isnull(ls_contrato_sap) or ls_contrato_sap='' then
						
							if ls_tipo_mov='B' or ls_tipo_mov='C' or ls_tipo_mov='H' or ls_tipo_mov='I' or ls_tipo_mov='N' or ls_tipo_mov='O' or &
							   ls_tipo_mov='U' or ls_tipo_mov='W' or ls_tipo_mov='Y' or ls_tipo_mov='Z' or &
							   isnull(ls_cliente_sap) or ls_cliente_sap='' or ((isnull(ls_contrato_sap) or ls_contrato_sap='') and ls_rezago='N' ) then
								
								tab_1.tabpage_1.dw_ingreso_sap.setitem(ll_indi,'estado_reg',0)
							end if
						//end if
						ls_nro_opera_trans		= '0'
						ls_ref_dcto					= ls_base+ls_serie+string(ll_numero)
						ls_via_pago					= tab_1.tabpage_1.dw_ingreso_sap.getitemstring(ll_indi,'vista_sap_haber_via_pago_sap')
						ls_clave_contab_h			= tab_1.tabpage_1.dw_ingreso_sap.getitemstring(ll_indi,'vista_sap_haber_clave_contab')
						ls_moneda					= tab_1.tabpage_1.dw_ingreso_sap.getitemstring(ll_indi,'vista_sap_haber_moneda')
						ll_ctas_pag_cred			= tab_1.tabpage_1.dw_ingreso_sap.getitemnumber(ll_indi,'cadena_mora_ctas_pag_s')
						ll_ctas_pag_m				= tab_1.tabpage_1.dw_ingreso_sap.getitemnumber(ll_indi,'vista_sap_haber_ctas_pag_m')
						ls_centro_benef			= tab_1.tabpage_1.dw_ingreso_sap.getitemstring(ll_indi,'vista_sap_haber_centro_beneficio')
						if ls_tipo_cob='NE' then ls_contrato_sap='0'
						if ls_rezago='S' then
							SELECT	"CLIENTE_REZAGO"."BASE",		"CLIENTE_REZAGO"."SERIE",	"CLIENTE_REZAGO"."NUMERO"  
							INTO 		:ls_base,								:ls_serie,								:ll_numero  
							FROM 	"CLIENTE_REZAGO"  
							WHERE ( "CLIENTE_REZAGO"."COD_PAGO" = :ls_tipo_cob ) AND  
									  ( "CLIENTE_REZAGO"."FOLIO" = :ll_folio ) AND  
									  ( "CLIENTE_REZAGO"."CAJA" = :ls_caja ) AND  
									  ( "CLIENTE_REZAGO"."FECHA_PAGO" = :MIAR )   ;
							if (ls_tipo_mov <> 'L' and ls_codigo_otro <> '3' and ls_tipo_mov <> 'M') or (ls_tipo_mov = 'L' and ls_codigo_otro = '3') then	
								ls_contrato_sap		= '0'
							end if 
						end if
						ldt_fecha_venc				= MIAR
						
						if not isnull(ls_contrato_sap)  then	//ls_cliente_sap
							if (ls_tipo_mov='E' or ls_tipo_mov='K') and ll_cuotas_pag > 1 then
								SELECT	SUM("INGRESO"."CUOTAS_PAG")
								INTO 		:ll_count_cta_fututa  
								FROM 	"INGRESO"  
								WHERE ( "INGRESO"."BASE" = :ls_base ) AND  
										  ( "INGRESO"."SERIE" = :ls_serie ) AND  
										  ( "INGRESO"."CONTRATO" = :ll_numero ) AND  
										  ( "INGRESO"."FECHA_PAGO" > :MIAR ) AND  
										  ( "INGRESO"."TIPO_MOV" = 'E' or "INGRESO"."TIPO_MOV" = 'K' ) AND  
										  ( "INGRESO"."PAGO_HIST" = 'A' )   
								USING	sqlca;
								if isnull(ll_count_cta_fututa) then ll_count_cta_fututa=0

								ll_ctas_pag_cred	= (ll_ctas_pag_cred - ll_cuotas_pag) - ll_count_cta_fututa
								ll_monto_e			= round(ll_monto / ll_cuotas_pag,0)
								ll_diferencia			= ll_monto - (ll_monto_e * ll_cuotas_pag)
								for ll_fila_e= 1 to ll_cuotas_pag
									ll_ctas_pag_cred ++
									ls_nro_opera_trans	= string(ll_ctas_pag_cred,'000')
									if ll_fila_e = ll_cuotas_pag and ll_diferencia <> 0 then
										ll_monto_e		= ll_monto_e + ll_diferencia
									end if
									if ls_moneda = '2' then
										//ldt_fecha_venc
										INSERT INTO 	  "SAP_HABER_SAP"  
															( "CODIGO_CAJA_LLAVE",	"FECHA_PAGO",	"COD_CAJA",	"NRO_CLIENTE_SAP",		"CUENTA_CONTABLE",	"DESCRIPCION_CUENTA",	"CENTRO",	"NRO_CONTRATO_SAP",		"CLAVE_PAGO",	"VIA_PAGO",	"FECHA_VENC_DCTO",	"REF_DCTO",	"NRO_OPERA_TRANSBANK",	"FOLIO_BOLETA",	"MONTO",		"CORRELATIVO",	"CLAVE_CONTAB",			"ITEM",		"CENTRO_BENEFICIO",	"NRO_ENVIO" )  
										VALUES 			( :ls_llave, 						:MIAR, 				:ls_caja,			:ls_cliente_sap,				:ls_cta_puente,				:ls_descrip_cta_puente,		:ls_centro,	:ls_contrato_sap,				:ls_clave_pago,		:ls_via_pago,	Null,							:ls_ref_dcto,	:ls_nro_opera_trans,				:ll_folio,				:ll_monto_e,	:ll_corre,				:ls_clave_contab_haber,	1,				null,							:ll_contar_envio )  
										USING		sqlca;
										if sqlca.sqlcode=0 then
											commit;
											ll_det_asiento2 ++
											ll_monto_uf		= round(ll_monto_e / ldb_valor_uf,4)
											INSERT INTO 	  "SAP_HABER_SAP"  
																( "CODIGO_CAJA_LLAVE",	"FECHA_PAGO",	"COD_CAJA",	"NRO_CLIENTE_SAP",		"CUENTA_CONTABLE",	"DESCRIPCION_CUENTA",	"CENTRO",	"NRO_CONTRATO_SAP",		"CLAVE_PAGO",	"VIA_PAGO",	"FECHA_VENC_DCTO",	"REF_DCTO",	"NRO_OPERA_TRANSBANK",	"FOLIO_BOLETA",	"MONTO",		"CORRELATIVO",	"CLAVE_CONTAB",		"ITEM",	"CENTRO_BENEFICIO",	"MONTO_HABER_LOCAL",	"NRO_ENVIO" )  
											VALUES 			( :ls_llave, 						:MIAR, 				:ls_caja,			:ls_cliente_sap,				:ls_cuenta_contable,		:ls_descripcion_cuenta,		:ls_centro,	:ls_contrato_sap,				:ls_clave_pago,		:ls_via_pago,	:ldt_fecha_venc,			:ls_ref_dcto,	:ls_nro_opera_trans,				:ll_folio,				:ll_monto_uf,	:ll_corre,				:ls_clave_contab_h,	2,			:ls_centro_benef,			:ll_monto_e,					:ll_contar_envio )  
											USING		sqlca;
											if sqlca.sqlcode=0 then
												commit;
												
												ll_corre_debe ++
												
												INSERT INTO 	"SAP_DEBE_SAP"  
																  ( "CODIGO_CAJA_LLAVE",		"FECHA_PAGO",	"COD_PAGO",	"COD_PAGO_ANEXO",		"COD_CAJA",	"CUENTA_CONTABLE",	"DESCRIPCION_CUENTA",	"CENTRO",	"VIA_PAGO_SAP",		"FECHA_VALOR",	"MONTO",		"FOLIO_BOLETA_DEPOSITO",	"FECHA_VENC_CHEQUE",	"REF_DCTO",	"NRO_OPERACION_TRANS",		"FOLIO_BOLETA",	"CLAVE_CONTAB",				"ITEM",	"CORRELATIVO",	"MONTO_DEBE_LOCAL",		"NRO_ENVIO" ) 
												VALUES 		  ( :ls_llave,   						:MIAR, 				:ls_cod_pago,  	:ls_cond_pago, 			:ls_caja,  		:ls_cta_puente,   			:ls_descrip_cta_puente,  	null, 			null,  						:ld_fecha_valor, 	:ll_monto_uf, 	null,  									null, 								:ls_ref_dcto,  	null,  									null,					:ls_clave_contab_debe,		2,			:ll_corre_debe,		:ll_monto_e,					:ll_contar_envio )  
												USING		sqlca;
												if sqlca.sqlcode=0 then
													commit;
													ll_det_asiento2 ++
													ll_corre_debe ++
												else
													rollback;
												end if
												ll_corre ++
											else
												rollback;
											end if
										else
											rollback;
										end if
									else
										INSERT INTO 	  "SAP_HABER_SAP"  
															( "CODIGO_CAJA_LLAVE",	"FECHA_PAGO",	"COD_CAJA",	"NRO_CLIENTE_SAP",		"CUENTA_CONTABLE",	"DESCRIPCION_CUENTA",	"CENTRO",	"NRO_CONTRATO_SAP",		"CLAVE_PAGO",	"VIA_PAGO",	"FECHA_VENC_DCTO",	"REF_DCTO",	"NRO_OPERA_TRANSBANK",	"FOLIO_BOLETA",	"MONTO",		"CORRELATIVO",	"CLAVE_CONTAB",		"ITEM",	"CENTRO_BENEFICIO",	"NRO_ENVIO" )  
										VALUES 			( :ls_llave, 						:MIAR, 				:ls_caja,			:ls_cliente_sap,				:ls_cuenta_contable,		:ls_descripcion_cuenta,		:ls_centro,	:ls_contrato_sap,				:ls_clave_pago,		:ls_via_pago,	:ldt_fecha_venc,			:ls_ref_dcto,	:ls_nro_opera_trans,				:ll_folio,				:ll_monto_e,	:ll_corre,				:ls_clave_contab_h,	1,			:ls_centro_benef,			:ll_contar_envio )  
										USING		sqlca;
										if sqlca.sqlcode=0 then
											commit;
											ll_corre ++
										else
											rollback;
										end if
									end if
								next
							elseif ls_tipo_mov='F' and ll_cuotas_pag > 1 then
								SELECT	SUM("INGRESO"."CUOTAS_PAG")
								INTO 		:ll_count_cta_fututa  
								FROM 	"INGRESO"  
								WHERE ( "INGRESO"."BASE" = :ls_base ) AND  
										  ( "INGRESO"."SERIE" = :ls_serie ) AND  
										  ( "INGRESO"."CONTRATO" = :ll_numero ) AND  
										  ( "INGRESO"."FECHA_PAGO" > :MIAR ) AND  
										  ( "INGRESO"."TIPO_MOV" = 'F' ) AND  
										  ( "INGRESO"."PAGO_HIST" = 'A' )   
								USING	sqlca;
								if isnull(ll_count_cta_fututa) then ll_count_cta_fututa=0
								ll_monto_f			= round(ll_monto / ll_cuotas_pag,0)
								ll_ctas_pag_m		= ( ll_ctas_pag_m - ll_cuotas_pag ) - ll_count_cta_fututa
								ll_diferencia_m		= ll_monto - (ll_monto_f * ll_cuotas_pag)
								for ll_fila_f= 1 to ll_cuotas_pag
									ll_ctas_pag_m ++
									if ll_fila_f = ll_cuotas_pag and ll_diferencia_m <> 0 then
										ll_monto_f		= ll_monto_f + ll_diferencia_m
									end if
									ls_nro_opera_trans	= string(ll_ctas_pag_m,'000')
									INSERT INTO 	  "SAP_HABER_SAP"  
														( "CODIGO_CAJA_LLAVE",	"FECHA_PAGO",	"COD_CAJA",	"NRO_CLIENTE_SAP",		"CUENTA_CONTABLE",	"DESCRIPCION_CUENTA",	"CENTRO",	"NRO_CONTRATO_SAP",		"CLAVE_PAGO",	"VIA_PAGO",	"FECHA_VENC_DCTO",	"REF_DCTO",	"NRO_OPERA_TRANSBANK",	"FOLIO_BOLETA",	"MONTO",		"CORRELATIVO",	"CLAVE_CONTAB",			"ITEM",	"CENTRO_BENEFICIO",	"NRO_ENVIO" ) 
									VALUES 			( :ls_llave, 						:MIAR, 				:ls_caja,			:ls_cliente_sap,				:ls_cta_puente,				:ls_descrip_cta_puente,		:ls_centro,	:ls_contrato_sap,				:ls_clave_pago,		:ls_via_pago,	Null,							:ls_ref_dcto,	:ls_nro_opera_trans,				:ll_folio,				:ll_monto_f,		:ll_corre,				:ls_clave_contab_haber,	1,			null,							:ll_contar_envio )  
									USING		sqlca;
									if sqlca.sqlcode=0 then
										commit;
										ll_det_asiento2 ++
										ll_monto_uf		= round(ll_monto_f / ldb_valor_uf,4)
										INSERT INTO 	  "SAP_HABER_SAP"  
															( "CODIGO_CAJA_LLAVE",	"FECHA_PAGO",	"COD_CAJA",	"NRO_CLIENTE_SAP",		"CUENTA_CONTABLE",	"DESCRIPCION_CUENTA",	"CENTRO",	"NRO_CONTRATO_SAP",		"CLAVE_PAGO",	"VIA_PAGO",	"FECHA_VENC_DCTO",	"REF_DCTO",	"NRO_OPERA_TRANSBANK",	"FOLIO_BOLETA",	"MONTO",		"CORRELATIVO",	"CLAVE_CONTAB",		"ITEM",	"CENTRO_BENEFICIO",	"MONTO_HABER_LOCAL",	"NRO_ENVIO" )  
										VALUES 			( :ls_llave, 						:MIAR, 				:ls_caja,			:ls_cliente_sap,				:ls_cuenta_contable,		:ls_descripcion_cuenta,		:ls_centro,	:ls_contrato_sap,				:ls_clave_pago,		:ls_via_pago,	:ldt_fecha_venc,			:ls_ref_dcto,	:ls_nro_opera_trans,				:ll_folio,				:ll_monto_uf,	:ll_corre,				:ls_clave_contab_h,	2,			:ls_centro_benef,			:ll_monto_f,						:ll_contar_envio )  
										USING		sqlca;
										if sqlca.sqlcode=0 then
											commit;
											ll_corre_debe ++
											INSERT INTO 	"SAP_DEBE_SAP"  
															  ( "CODIGO_CAJA_LLAVE",		"FECHA_PAGO",	"COD_PAGO",	"COD_PAGO_ANEXO",		"COD_CAJA",	"CUENTA_CONTABLE",	"DESCRIPCION_CUENTA",	"CENTRO",	"VIA_PAGO_SAP",		"FECHA_VALOR",	"MONTO",		"FOLIO_BOLETA_DEPOSITO",	"FECHA_VENC_CHEQUE",	"REF_DCTO",	"NRO_OPERACION_TRANS",		"FOLIO_BOLETA",	"CLAVE_CONTAB",				"ITEM",	"CORRELATIVO",	"MONTO_DEBE_LOCAL",	"NRO_ENVIO" ) 
											VALUES 		  ( :ls_llave,   						:MIAR, 				:ls_cod_pago,  	:ls_cond_pago, 			:ls_caja,  		:ls_cta_puente,   			:ls_descrip_cta_puente,  	null, 			null,  						:ld_fecha_valor, 	:ll_monto_uf, 	null,  									null, 								:ls_ref_dcto,  	null,  									null,					:ls_clave_contab_debe,		2,			:ll_corre_debe,		:ll_monto_f,					:ll_contar_envio )  
											USING		sqlca;
											if sqlca.sqlcode=0 then
												commit;
												ll_det_asiento2 ++
												ll_corre_debe ++
											else
												rollback;
											end if
											ll_corre ++
										else
											rollback;
										end if
									else
										rollback;
									end if
								next
							elseif ls_tipo_mov = 'A' then
								ls_cadena		= ls_base+ls_serie+string(ll_numero)
								SELECT	Count("SAP_HABER_SAP"."COD_CAJA")
								INTO 		:ll_count_pie_sap  
								FROM 	"SAP_HABER_SAP"  
								WHERE ( "SAP_HABER_SAP"."COD_CAJA" = :ls_caja ) AND  
										  ( "SAP_HABER_SAP"."FECHA_PAGO" = :MIAR ) AND  
										  ( "SAP_HABER_SAP"."REF_DCTO" = :ls_cadena ) AND  
										  ( substr("SAP_HABER_SAP"."NRO_OPERA_TRANSBANK",1,1) = 'P' ) 
								USING	sqlca;
								if isnull(ll_count_pie_sap) then ll_count_pie_sap=0
								
								SELECT	count("INGRESO"."TIPO_COB") 
								INTO 		:ll_count_pie   
								FROM 	"INGRESO",  "CLIENTE_REZAGO"  
								WHERE ( ingreso.folio = cliente_rezago.folio (+)) and  
										( ingreso.tipo_cob = cliente_rezago.cod_pago (+)) and  
										( ingreso.fecha_pago = cliente_rezago.fecha_pago (+)) and  
										( ingreso.rut = cliente_rezago.rut (+)) and  
										( ingreso.cod_caja = cliente_rezago.caja (+)) and  
										( ( "INGRESO"."FOLIO" = :ll_folio ) AND  
										( "INGRESO"."TIPO_COB" = :ls_tipo_cob ) AND  
										( "INGRESO"."TIPO_MOV" = :ls_tipo_mov ) AND  
										( "INGRESO"."FECHA_PAGO" < :MIAR ) AND  
										( "INGRESO"."COD_CAJA" = :ls_caja ) )  
								USING	sqlca;
								if isnull(ll_count_pie) then ll_count_pie=0
								ll_count_pie				= ll_count_pie + ll_count_pie_sap
								if ll_count_pie = 0 then
									il_cant_pie			= 1
								else
									il_cant_pie ++
								end if
								ll_ctas_pag_pie			= il_cant_pie
								ls_nro_opera_trans	= 'P'+string(ll_ctas_pag_pie,'00')
								if ls_moneda = '2' then
									INSERT INTO 	  "SAP_HABER_SAP"  
														( "CODIGO_CAJA_LLAVE",	"FECHA_PAGO",	"COD_CAJA",	"NRO_CLIENTE_SAP",		"CUENTA_CONTABLE",	"DESCRIPCION_CUENTA",	"CENTRO",	"NRO_CONTRATO_SAP",		"CLAVE_PAGO",	"VIA_PAGO",	"FECHA_VENC_DCTO",	"REF_DCTO",	"NRO_OPERA_TRANSBANK",	"FOLIO_BOLETA",	"MONTO",		"CORRELATIVO",	"CLAVE_CONTAB",			"ITEM",	"CENTRO_BENEFICIO",	"NRO_ENVIO" )  
									VALUES 			( :ls_llave, 						:MIAR, 				:ls_caja,			:ls_cliente_sap,				:ls_cta_puente,				:ls_descrip_cta_puente,		:ls_centro,	:ls_contrato_sap,				:ls_clave_pago,		:ls_via_pago,	Null,							:ls_ref_dcto,	:ls_nro_opera_trans,				:ll_folio,				:ll_monto,		:ll_corre,				:ls_clave_contab_haber,	1,			null,							:ll_contar_envio )  
									USING		sqlca;
									if sqlca.sqlcode=0 then
										commit;
										
										if ls_tipo_cob='NE' and ls_cond_pago='EF' then
											Setnull(ls_cliente_sap)
										end if
										ll_det_asiento2 ++
										
										ll_monto_uf		= round(ll_monto / ldb_valor_uf,4)
										INSERT INTO 	  "SAP_HABER_SAP"  
															( "CODIGO_CAJA_LLAVE",	"FECHA_PAGO",	"COD_CAJA",	"NRO_CLIENTE_SAP",		"CUENTA_CONTABLE",	"DESCRIPCION_CUENTA",	"CENTRO",	"NRO_CONTRATO_SAP",		"CLAVE_PAGO",	"VIA_PAGO",	"FECHA_VENC_DCTO",	"REF_DCTO",	"NRO_OPERA_TRANSBANK",	"FOLIO_BOLETA",	"MONTO",		"CORRELATIVO",	"CLAVE_CONTAB",		"ITEM",	"CENTRO_BENEFICIO",	"MONTO_HABER_LOCAL",	"NRO_ENVIO" )  
										VALUES 			( :ls_llave, 						:MIAR, 				:ls_caja,			:ls_cliente_sap,				:ls_cuenta_contable,		:ls_descripcion_cuenta,		:ls_centro,	:ls_contrato_sap,				:ls_clave_pago,		:ls_via_pago,	:ldt_fecha_venc,			:ls_ref_dcto,	:ls_nro_opera_trans,				:ll_folio,				:ll_monto_uf,	:ll_corre,				:ls_clave_contab_h,	2,			:ls_centro_benef,			:ll_monto,						:ll_contar_envio )  
										USING		sqlca;
										if sqlca.sqlcode=0 then
											commit;
											ll_corre_debe ++
											INSERT INTO 	"SAP_DEBE_SAP"  
															  ( "CODIGO_CAJA_LLAVE",		"FECHA_PAGO",	"COD_PAGO",	"COD_PAGO_ANEXO",		"COD_CAJA",	"CUENTA_CONTABLE",	"DESCRIPCION_CUENTA",	"CENTRO",	"VIA_PAGO_SAP",		"FECHA_VALOR",	"MONTO",		"FOLIO_BOLETA_DEPOSITO",	"FECHA_VENC_CHEQUE",	"REF_DCTO",	"NRO_OPERACION_TRANS",		"FOLIO_BOLETA",	"CLAVE_CONTAB",				"ITEM",	"CORRELATIVO",	"MONTO_DEBE_LOCAL",		"NRO_ENVIO" ) 
											VALUES 		  ( :ls_llave,   						:MIAR, 				:ls_cod_pago,  	:ls_cond_pago, 			:ls_caja,  		:ls_cta_puente,   			:ls_descrip_cta_puente,  	null, 			null,  						:ld_fecha_valor, 	:ll_monto_uf, 	null,  									null, 								:ls_ref_dcto,  	null,  									null,					:ls_clave_contab_debe,		2,			:ll_corre_debe,		:ll_monto,						:ll_contar_envio )  
											USING		sqlca;
											if sqlca.sqlcode=0 then
												commit;
												ll_det_asiento2 ++
												ll_corre_debe ++
											else
												rollback;
											end if
											ll_corre ++
										else
											rollback;
										end if
									else
										rollback;
									end if
								else
									INSERT INTO 	  "SAP_HABER_SAP"  
														( "CODIGO_CAJA_LLAVE",	"FECHA_PAGO",	"COD_CAJA",	"NRO_CLIENTE_SAP",		"CUENTA_CONTABLE",	"DESCRIPCION_CUENTA",	"CENTRO",	"NRO_CONTRATO_SAP",		"CLAVE_PAGO",	"VIA_PAGO",	"FECHA_VENC_DCTO",	"REF_DCTO",	"NRO_OPERA_TRANSBANK",	"FOLIO_BOLETA",	"MONTO",		"CORRELATIVO",	"CLAVE_CONTAB",		"ITEM",	"CENTRO_BENEFICIO",	"NRO_ENVIO" )  
									VALUES 			( :ls_llave, 						:MIAR, 				:ls_caja,			:ls_cliente_sap,				:ls_cuenta_contable,		:ls_descripcion_cuenta,		:ls_centro,	:ls_contrato_sap,				:ls_clave_pago,		:ls_via_pago,	:ldt_fecha_venc,			:ls_ref_dcto,	:ls_nro_opera_trans,				:ll_folio,				:ll_monto,		:ll_corre,				:ls_clave_contab_h,	1,			:ls_centro_benef,			:ll_contar_envio )  
									USING		sqlca;
									if sqlca.sqlcode=0 then
										commit;
										ll_corre ++
									else
										rollback;
									end if
								end if
							else
								if ls_tipo_mov='E' or ls_tipo_mov='K' then
									SELECT	SUM("INGRESO"."CUOTAS_PAG")
									INTO 		:ll_count_cta_fututa  
									FROM 	"INGRESO"  
									WHERE ( "INGRESO"."BASE" = :ls_base ) AND  
											  ( "INGRESO"."SERIE" = :ls_serie ) AND  
											  ( "INGRESO"."CONTRATO" = :ll_numero ) AND  
											  ( "INGRESO"."FECHA_PAGO" > :MIAR ) AND  
											  ( "INGRESO"."TIPO_MOV" = 'E' or "INGRESO"."TIPO_MOV" = 'K' ) AND  
											  ( "INGRESO"."PAGO_HIST" = 'A' )   
									USING	sqlca;
									if ll_count_cta_fututa >= 0 then
										if isnull(ll_count_cta_fututa) then ll_count_cta_fututa=0
										ll_ctas_pag_cred		= ( ll_ctas_pag_cred - ll_cuotas_pag ) - ll_count_cta_fututa
										ll_ctas_pag_cred ++
										ls_nro_opera_trans	= string(ll_ctas_pag_cred,'000')
									end if
									
									SELECT	SUM("INGRESO"."CUOTAS_PAG")
									INTO 		:ll_count_cta_dia  
									FROM 	"INGRESO"  
									WHERE ( "INGRESO"."BASE" = :ls_base ) AND  
											  ( "INGRESO"."SERIE" = :ls_serie ) AND  
											  ( "INGRESO"."CONTRATO" = :ll_numero ) AND  
											  ( "INGRESO"."FECHA_PAGO" = :MIAR ) AND  
											  ( "INGRESO"."TIPO_MOV" = 'E' or "INGRESO"."TIPO_MOV" = 'K' ) AND  
											  ( "INGRESO"."PAGO_HIST" = 'A' )   
									USING	sqlca;
									if ll_count_cta_dia > 0 then
										ll_sum_cta_dia	++
										if isnull(ll_count_cta_dia) then ll_count_cta_dia=0
										ll_ctas_pag_cred		= (( ll_ctas_pag_cred - ll_cuotas_pag ) - ll_count_cta_dia) + ll_sum_cta_dia
										ll_ctas_pag_cred ++
										ls_nro_opera_trans	= string(ll_ctas_pag_cred,'000')
										if ll_sum_cta_dia = ll_count_cta_dia then ll_sum_cta_dia = 0
									else
										if isnull(ll_count_cta_dia) then ll_count_cta_dia=0
										ll_ctas_pag_cred		= ( ll_ctas_pag_cred - ll_cuotas_pag ) - ll_count_cta_dia
										ll_ctas_pag_cred ++
										ls_nro_opera_trans	= string(ll_ctas_pag_cred,'000')
									end if
								end if
								if ls_tipo_mov='F' then
									SELECT	SUM("INGRESO"."CUOTAS_PAG")
									INTO 		:ll_count_cta_fututa  
									FROM 	"INGRESO"  
									WHERE ( "INGRESO"."BASE" = :ls_base ) AND  
											  ( "INGRESO"."SERIE" = :ls_serie ) AND  
											  ( "INGRESO"."CONTRATO" = :ll_numero ) AND  
											  ( "INGRESO"."FECHA_PAGO" > :MIAR ) AND  
											  ( "INGRESO"."TIPO_MOV" = 'F' ) AND  
											  ( "INGRESO"."PAGO_HIST" = 'A' )   
									USING	sqlca;
									if ll_count_cta_fututa >= 0 then
										if isnull(ll_count_cta_fututa) then ll_count_cta_fututa=0
										ll_ctas_pag_m		= ( ll_ctas_pag_m - ll_cuotas_pag ) - ll_count_cta_fututa
										ll_ctas_pag_m ++
										ls_nro_opera_trans	= string(ll_ctas_pag_m,'000')
									end if
									
									SELECT	SUM("INGRESO"."CUOTAS_PAG")
									INTO 		:ll_count_cta_dia  
									FROM 	"INGRESO"  
									WHERE ( "INGRESO"."BASE" = :ls_base ) AND  
											  ( "INGRESO"."SERIE" = :ls_serie ) AND  
											  ( "INGRESO"."CONTRATO" = :ll_numero ) AND  
											  ( "INGRESO"."FECHA_PAGO" = :MIAR ) AND  
											  ( "INGRESO"."TIPO_MOV" = 'F' ) AND  
											  ( "INGRESO"."PAGO_HIST" = 'A' )   
									USING	sqlca;
									if ll_count_cta_dia > 0 then
										ll_sum_cta_dia	++
										if isnull(ll_count_cta_dia) then ll_count_cta_dia=0
										ll_ctas_pag_m		= (( ll_ctas_pag_m - ll_cuotas_pag ) - ll_count_cta_dia) + ll_sum_cta_dia
										ll_ctas_pag_m ++
										ls_nro_opera_trans	= string(ll_ctas_pag_m,'000')
										if ll_sum_cta_dia = ll_count_cta_dia then ll_sum_cta_dia = 0
									else
										if isnull(ll_count_cta_dia) then ll_count_cta_dia=0
										ll_ctas_pag_m		= ( ll_ctas_pag_m - ll_cuotas_pag ) - ll_count_cta_dia
										ll_ctas_pag_m ++
										ls_nro_opera_trans	= string(ll_ctas_pag_m,'000')
									end if
								end if
								if ls_tipo_mov='M' or (ls_tipo_mov='L' and ls_codigo_otro <>'3' ) then
									ls_nro_opera_trans	= '001'
								end if
								if ls_moneda = '2' or ls_tipo_mov='F' or ls_tipo_mov='R' or ls_tipo_mov='P' then
									INSERT INTO 	  "SAP_HABER_SAP"  
														( "CODIGO_CAJA_LLAVE",	"FECHA_PAGO",	"COD_CAJA",	"NRO_CLIENTE_SAP",		"CUENTA_CONTABLE",	"DESCRIPCION_CUENTA",	"CENTRO",	"NRO_CONTRATO_SAP",		"CLAVE_PAGO",	"VIA_PAGO",	"FECHA_VENC_DCTO",	"REF_DCTO",	"NRO_OPERA_TRANSBANK",	"FOLIO_BOLETA",	"MONTO",		"CORRELATIVO",	"CLAVE_CONTAB",			"ITEM",	"CENTRO_BENEFICIO",	"NRO_ENVIO" )  
									VALUES 			( :ls_llave, 						:MIAR, 				:ls_caja,			:ls_cliente_sap,				:ls_cta_puente,				:ls_descrip_cta_puente,		:ls_centro,	:ls_contrato_sap,				:ls_clave_pago,		:ls_via_pago,	Null,							:ls_ref_dcto,	:ls_nro_opera_trans,				:ll_folio,				:ll_monto,		:ll_corre,				:ls_clave_contab_haber,	1,			null,							:ll_contar_envio )  
									USING		sqlca;
									if sqlca.sqlcode=0 then
										commit;
										if ls_tipo_cob='NE' and ls_cond_pago='EF' then
											Setnull(ls_cliente_sap)
										end if
										ll_det_asiento2 ++
										
										ll_monto_uf		= round(ll_monto / ldb_valor_uf,4)
										INSERT INTO 	  "SAP_HABER_SAP"  
															( "CODIGO_CAJA_LLAVE",	"FECHA_PAGO",	"COD_CAJA",	"NRO_CLIENTE_SAP",		"CUENTA_CONTABLE",	"DESCRIPCION_CUENTA",	"CENTRO",	"NRO_CONTRATO_SAP",		"CLAVE_PAGO",	"VIA_PAGO",	"FECHA_VENC_DCTO",	"REF_DCTO",	"NRO_OPERA_TRANSBANK",	"FOLIO_BOLETA",	"MONTO",		"CORRELATIVO",	"CLAVE_CONTAB",		"ITEM",	"CENTRO_BENEFICIO",	"MONTO_HABER_LOCAL",	"NRO_ENVIO" )  
										VALUES 			( :ls_llave, 						:MIAR, 				:ls_caja,			:ls_cliente_sap,				:ls_cuenta_contable,		:ls_descripcion_cuenta,		:ls_centro,	:ls_contrato_sap,				:ls_clave_pago,		:ls_via_pago,	:ldt_fecha_venc,			:ls_ref_dcto,	:ls_nro_opera_trans,				:ll_folio,				:ll_monto_uf,	:ll_corre,				:ls_clave_contab_h,	2,			:ls_centro_benef,			:ll_monto,						:ll_contar_envio )  
										USING		sqlca;
										if sqlca.sqlcode=0 then
											commit;
											ll_corre_debe ++
											INSERT INTO 	"SAP_DEBE_SAP"  
															  ( "CODIGO_CAJA_LLAVE",		"FECHA_PAGO",	"COD_PAGO",	"COD_PAGO_ANEXO",		"COD_CAJA",	"CUENTA_CONTABLE",	"DESCRIPCION_CUENTA",	"CENTRO",	"VIA_PAGO_SAP",		"FECHA_VALOR",	"MONTO",		"FOLIO_BOLETA_DEPOSITO",	"FECHA_VENC_CHEQUE",	"REF_DCTO",	"NRO_OPERACION_TRANS",		"FOLIO_BOLETA",	"CLAVE_CONTAB",				"ITEM",	"CORRELATIVO",	"MONTO_DEBE_LOCAL",		"NRO_ENVIO" ) 
											VALUES 		  ( :ls_llave,   						:MIAR, 				:ls_cod_pago,  	:ls_cond_pago, 			:ls_caja,  		:ls_cta_puente,   			:ls_descrip_cta_puente,  	null, 			null,  						:ld_fecha_valor, 	:ll_monto_uf, 	null,  									null, 								:ls_ref_dcto,  	null,  									null,					:ls_clave_contab_debe,		2,			:ll_corre_debe,		:ll_monto,						:ll_contar_envio )  
											USING		sqlca;
											if sqlca.sqlcode=0 then
												commit;
												ll_det_asiento2 ++
												ll_corre_debe ++
											else
												rollback;
											end if
											ll_corre ++
										else
											rollback;
										end if
									else
										rollback;
									end if
								else
									INSERT INTO 	  "SAP_HABER_SAP"  
														( "CODIGO_CAJA_LLAVE",	"FECHA_PAGO",	"COD_CAJA",	"NRO_CLIENTE_SAP",		"CUENTA_CONTABLE",	"DESCRIPCION_CUENTA",	"CENTRO",	"NRO_CONTRATO_SAP",		"CLAVE_PAGO",	"VIA_PAGO",	"FECHA_VENC_DCTO",	"REF_DCTO",	"NRO_OPERA_TRANSBANK",	"FOLIO_BOLETA",	"MONTO",		"CORRELATIVO",	"CLAVE_CONTAB",		"ITEM",	"CENTRO_BENEFICIO",	"NRO_ENVIO" )  
									VALUES 			( :ls_llave, 						:MIAR, 				:ls_caja,			:ls_cliente_sap,				:ls_cuenta_contable,		:ls_descripcion_cuenta,		:ls_centro,	:ls_contrato_sap,				:ls_clave_pago,		:ls_via_pago,	:ldt_fecha_venc,			:ls_ref_dcto,	:ls_nro_opera_trans,				:ll_folio,				:ll_monto,		:ll_corre,				:ls_clave_contab_h,	1,			:ls_centro_benef,			:ll_contar_envio )  
									USING		sqlca;
									if sqlca.sqlcode=0 then
										commit;
										ll_corre ++
									else
										rollback;
									end if
								end if
								ll_ctas_pag_cred	= 0
								ll_ctas_pag_m		= 0
							end if
						end if
					next
					ll_fila						= tab_1.tabpage_1.dw_ingreso_sap.Find("estado_reg = 0",  1, ll_tot_reg)
					if ll_fila > 0 then
						messagebox("Advertencia","Recuerde Actualizar Pagos - NO Envio SAP")
					end if
				end if
				if ll_cab_asiento2 > 0 and ll_det_asiento2 =0 then
					DELETE FROM 	"SAP_CABECERA_PAGOS"  
					WHERE 		  ( "SAP_CABECERA_PAGOS"."COD_CAJA" = :ls_caja ) AND  
									  ( "SAP_CABECERA_PAGOS"."FECHA_PAGO" = :MIAR ) AND
									  ( "SAP_CABECERA_PAGOS"."ITEM" = 2 ) AND
									  ( "SAP_CABECERA_PAGOS"."NRO_ENVIO" = :ll_contar_envio )
					USING		sqlca;
					if sqlca.sqlcode=0 then
						commit;
						ll_count ++
					else
						rollback;
						messagebox("Error Eliminar","Error Eliminar SAP_CABECERA_PAGOS SQL: "+sqlca.sqlerrtext)
					end if
				end if
				if tab_1.tabpage_1.dw_cabecera.rowcount() > 0 then
					il_item			= tab_1.tabpage_1.dw_cabecera.getitemnumber(tab_1.tabpage_1.dw_cabecera.getrow(),'item')
					tab_1.tabpage_1.dw_debe.retrieve(ls_caja,MIAR,il_item)
					tab_1.tabpage_1.dw_haber.retrieve(ls_caja,MIAR,il_item)
					tab_1.tabpage_1.dw_cabecera.scrolltorow(1)
					tab_1.tabpage_1.dw_cabecera.setfocus()
				end if
				SetPointer(Arrow!)
			end if
			if tab_1.tabpage_1.cb_revisar.text='Volver' then tab_1.tabpage_1.cb_revisar.triggerevent(clicked!)
		else
			messagebox("Advertencia","No Registra Pagos Caja "+ls_caja+ " con Fecha "+string(MIAR,'dd/mm/yyyy'))
		end if
	else
		if isnull(ls_caja) then
			messagebox("Advertencia","Debe Seleccionar CAJA")
			ddplb_caja.setfocus()
		elseif isnull(MIAR) then
			messagebox("Advertencia","Debe Seleccionar Fecha")
			em_1.setfocus()
		end if
	end if
//end if
end event

type cb_41 from commandbutton within w_sap_detalle_pagos_caja_2_bkp
integer x = 4640
integer y = 956
integer width = 626
integer height = 108
integer taborder = 60
integer textsize = -8
integer weight = 700
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string text = "Genera Nueva Cta.Mant."
end type

event clicked;string		ls_base,ls_serie,ls_tipo_cob,ls_tipo_mov,ls_rezago
long		ll_folio,ll_graba=0,ll_ctas_pag,ll_nro_ctas,ll_cta,ll_cta_ini,ll_posic,ll_periodo,ll_ctas_pag_s,ll_res,ll_tot_reg
double	ldb_numero,ldb_tot_porc=0,ldb_tot_porc_aux=0
datetime	ldt_fec_pago,ldt_fec_venc



SELECT	count("BASE")
INTO		:ll_tot_reg
FROM 	"INGRESO"
WHERE	"INGRESO"."TIPO_MOV" = 'F' and
			"INGRESO"."ESTADO_PAGO_SAP" = 99 AND
			"INGRESO"."COD_CAJA" <> 'CR' AND
			"INGRESO"."CTAS_PAG_CTTO"  > 0 AND
			(SELECT  DISTINCT "SAP_CTTO_05_CUOTA"."NRO_CUOTA"
			FROM 	  "SAP_CTTO_05_CUOTA"  
			WHERE	  "SAP_CTTO_05_CUOTA"."BASE" = "INGRESO"."BASE" AND  
						  "SAP_CTTO_05_CUOTA"."SERIE" = "INGRESO"."SERIE" AND  
						  "SAP_CTTO_05_CUOTA"."NUMERO" = "INGRESO"."CONTRATO" AND  
						  "SAP_CTTO_05_CUOTA"."TIPO_DEUDA" = 'M' AND
						  TO_NUMBER("SAP_CTTO_05_CUOTA"."NRO_CUOTA") = "INGRESO"."CTAS_PAG_CTTO") IS NULL
USING	sqlca;
if isnull(ll_tot_reg) then ll_tot_reg=0
if ll_tot_reg=0 then
	messagebox("Advertencia","No Registra Datos Para Actualizar")
else
	ll_res														= MessageBox("Advertencia", 'Desea Cálcular Extensión Cuota Mantención  ', Exclamation!, YesNo!, 2)
	if ll_res=1 then
		SetPointer(HourGlass!)
		tab_1.tabpage_1.st_fondo.visible				= true
		tab_1.tabpage_1.st_cuenta.visible				= true
		tab_1.tabpage_1.st_porc.visible				= true
		tab_1.tabpage_1.hpb_1.visible					= true
		tab_1.tabpage_1.hpb_1.Position				= ldb_tot_porc
		DECLARE x1 CURSOR FOR
		SELECT	"BASE",	"SERIE",	"CONTRATO",	"FOLIO",	"FECHA_PAGO",	"TIPO_COB",	"TIPO_MOV",	"CUOTAS_PAG",	 "INGRESO"."CTAS_PAG_CTTO"
		FROM 	"INGRESO"
		WHERE	"INGRESO"."TIPO_MOV" = 'F' and
					"INGRESO"."ESTADO_PAGO_SAP" = 99 AND
					"INGRESO"."COD_CAJA" <> 'CR' AND
					"INGRESO"."CTAS_PAG_CTTO"  > 0 AND
					(SELECT  DISTINCT "SAP_CTTO_05_CUOTA"."NRO_CUOTA"
					FROM 	  "SAP_CTTO_05_CUOTA"  
					WHERE	  "SAP_CTTO_05_CUOTA"."BASE" = "INGRESO"."BASE" AND  
								  "SAP_CTTO_05_CUOTA"."SERIE" = "INGRESO"."SERIE" AND  
								  "SAP_CTTO_05_CUOTA"."NUMERO" = "INGRESO"."CONTRATO" AND  
								  "SAP_CTTO_05_CUOTA"."TIPO_DEUDA" = 'M' AND
								  TO_NUMBER("SAP_CTTO_05_CUOTA"."NRO_CUOTA") = "INGRESO"."CTAS_PAG_CTTO") IS NULL
		USING	Trans_1;
		open x1;
		if Trans_1.sqlcode=0 then
			DO WHILE Trans_1.sqlcode=0
			fetch x1 INTO	:ls_base,:ls_serie,:ldb_numero,:ll_folio,:ldt_fec_pago,:ls_tipo_cob,:ls_tipo_mov,	:ll_ctas_pag,	:ll_ctas_pag_s;
				if not isnull(ldt_fec_pago) and not isnull(ll_folio) and ll_folio>0 and not isnull(ls_tipo_cob) and ls_tipo_cob<>'' and not isnull(ls_tipo_mov) and ls_tipo_mov<>''  then
					SELECT	COUNT("SAP_CADENA"."BASE"  )
					INTO 		:ll_cta  
					FROM 	"SAP_CADENA"  
					WHERE	"SAP_CADENA"."BASE" = :ls_base AND  
								"SAP_CADENA"."SERIE" = :ls_serie AND  
								"SAP_CADENA"."NUMERO" = :ldb_numero AND  
								"SAP_CADENA"."TIPO_DEUDA" = 'M' AND  
								"SAP_CADENA"."ESTADO_SAP" = 1
					USING	sqlca;
					if isnull(ll_cta) then ll_cta=0
					
					if ll_cta>0 then
						SELECT	max("SAP_CTTO_05_CUOTA"."NRO_POSIC_CTA"),	max(TO_DATE("SAP_CTTO_05_CUOTA"."FECHA_VCTO",'DD/MM/YYYY')),	max("SAP_CTTO_05_CUOTA"."NRO_CUOTA"),	"SAP_CADENA"."PERIODO_MANT"
							INTO 		:ll_posic,															:ldt_fec_venc,																				:ll_nro_ctas,												:ll_periodo					  
							FROM		"SAP_CADENA","SAP_CTTO_05_CUOTA"  
							WHERE	"SAP_CADENA"."BASE" = "SAP_CTTO_05_CUOTA"."BASE" and  
									"SAP_CADENA"."SERIE" = "SAP_CTTO_05_CUOTA"."SERIE" and
									"SAP_CADENA"."NUMERO" = "SAP_CTTO_05_CUOTA"."NUMERO" and
									"SAP_CADENA"."TIPO_DEUDA" = "SAP_CTTO_05_CUOTA"."TIPO_DEUDA" and
									"SAP_CADENA"."BASE" = :ls_base AND  
									"SAP_CADENA"."SERIE" = :ls_serie AND  
									"SAP_CADENA"."NUMERO" = :ldb_numero AND  
									"SAP_CADENA"."TIPO_DEUDA" = 'M' AND  
									"SAP_CADENA"."ESTADO_SAP" = 1
						GROUP BY	"SAP_CADENA"."PERIODO_MANT"
						USING	sqlca;
						if isnull(ll_posic) then ll_posic=0
						if isnull(ll_nro_ctas) then ll_nro_ctas=0
						if isnull(ll_periodo) then ll_periodo=12
						
						if not isnull(ll_posic) and ll_posic>0 and not isnull(ldt_fec_venc) and not isnull(ll_nro_ctas) and ll_nro_ctas>0 then
//							messagebox("Falta Funcion","Falta Funcion f_sap_ctto_05_new_mant")
							f_sap_ctto_05_new_mant(ls_base,ls_serie,ldb_numero,ll_nro_ctas,ll_ctas_pag,ldt_fec_venc,ll_posic,ll_periodo,'P')	
						end if
					end if
				end if
				setnull(ls_base);setnull(ls_serie);setnull(ldb_numero);setnull(ll_folio);setnull(ldt_fec_pago);setnull(ls_tipo_cob);setnull(ls_tipo_mov);setnull(ll_ctas_pag);setnull(ll_posic);setnull(ldt_fec_venc);setnull(ll_nro_ctas);setnull(ll_periodo)
				if ldb_tot_porc <> ldb_tot_porc_aux then 
					tab_1.tabpage_1.st_porc.text					= string(ldb_tot_porc,'#0.##')+" %"
					ldb_tot_porc_aux									= ldb_tot_porc
				end if
				ldb_tot_porc												= (ll_graba / ll_tot_reg) * 100
				tab_1.tabpage_1.hpb_1.Position					= ldb_tot_porc
				tab_1.tabpage_1.st_cuenta.text 					= 'Total Reg. '+string(ll_tot_reg,'###,###,###')+'    Reg. Cálculados '+string(ll_graba,'###,###,###')+' '
			LOOP
		end if
		close x1;
		tab_1.tabpage_1.st_fondo.visible							= false
		tab_1.tabpage_1.st_cuenta.visible							= false
		tab_1.tabpage_1.hpb_1.visible 								= false
		tab_1.tabpage_1.st_porc.visible 							= false
		SetPointer(Arrow!)
	end if
end if
		

end event

type cb_40 from commandbutton within w_sap_detalle_pagos_caja_2_bkp
integer x = 4640
integer y = 716
integer width = 626
integer height = 108
integer taborder = 60
integer textsize = -8
integer weight = 700
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string text = "Corrección Rezago"
end type

event clicked;string		ls_base,ls_serie,ls_tipo_cob,ls_tipo_mov,ls_cod_otro,ls_rezago
long		ll_folio,ll_cod_parque,ll_graba=0,ll_tot_reg,ll_res
double	ldb_numero,ldb_tot_porc=0,ldb_tot_porc_aux=0
datetime	ldt_fec_pago


SELECT	count("BASE")
INTO		:ll_tot_reg
FROM 	"INGRESO"
WHERE	 "INGRESO"."TIPO_COB" <> 'NE' AND
			"INGRESO"."ESTADO_PAGO_SAP" = 99 AND
			"INGRESO"."FECHA_PAGO" >= to_date('01/04/2016','dd/mm/yyyy')
USING	sqlca;
if isnull(ll_tot_reg) then ll_tot_reg=0
if ll_tot_reg = 0 then
	messagebox("Advertencia","No Registra Datos")
else
	ll_res											= MessageBox("Advertencia", '¿Desea Actualizar Estado Rezago?', Exclamation!, YesNo!, 2)
	if ll_res = 1 then
		SetPointer(HourGlass!)
		tab_1.tabpage_1.st_fondo.visible				= true
		tab_1.tabpage_1.st_cuenta.visible				= true
		tab_1.tabpage_1.st_porc.visible				= true
		tab_1.tabpage_1.hpb_1.visible					= true
		tab_1.tabpage_1.hpb_1.Position				= ldb_tot_porc
		
		DECLARE x1 CURSOR FOR
		SELECT	"BASE",	"SERIE",	"CONTRATO",	"FOLIO",	"FECHA_PAGO",	"TIPO_COB",	"TIPO_MOV",	"CODIGO_OTRO",	"COD_PARQUE"
		FROM 	"INGRESO"
		WHERE	 "INGRESO"."TIPO_COB" <> 'NE' AND
					"INGRESO"."ESTADO_PAGO_SAP" = 99 AND
					"INGRESO"."FECHA_PAGO" >= to_date('01/04/2016','dd/mm/yyyy')
		USING	Trans_1;
		open x1;
		if Trans_1.sqlcode=0 then
			DO WHILE Trans_1.sqlcode=0
			fetch x1 INTO	:ls_base,:ls_serie,:ldb_numero,:ll_folio,:ldt_fec_pago,:ls_tipo_cob,:ls_tipo_mov,:ls_cod_otro,	:ll_cod_parque;
				if not isnull(ldt_fec_pago) and not isnull(ll_folio) and ll_folio>0 and not isnull(ls_tipo_cob) and ls_tipo_cob<>'' and not isnull(ls_tipo_mov) and ls_tipo_mov<>''  then
					if ldb_numero=0 then
						if ll_cod_parque=0 then
							ll_cod_parque										= 1
						end if
						ls_rezago												= 'S'
					else
						SELECT	"CADENA"."COD_PARQUE"  
						INTO		:ll_cod_parque  
						FROM		"CADENA"  
						WHERE 	"CADENA"."CODIGO" = :ls_base AND  
									"CADENA"."SERIE" = :ls_serie AND  
									"CADENA"."NUMERO" = :ldb_numero 
						USING	sqlca;
						if isnull(ll_cod_parque) then ll_cod_parque		= 1
						ls_rezago												= ' '
					end if
					
					UPDATE "INGRESO"  
					SET		"REZAGO" = :ls_rezago,
								"COD_PARQUE" = :ll_cod_parque
						WHERE	"INGRESO"."FOLIO" = :ll_folio AND  
								"INGRESO"."TIPO_COB" = :ls_tipo_cob AND  
								"INGRESO"."FECHA_PAGO" = :ldt_fec_pago AND  
								"INGRESO"."TIPO_MOV" = :ls_tipo_mov AND  
								"INGRESO"."BASE" = :ls_base AND  
								"INGRESO"."SERIE" = :ls_serie AND  
								"INGRESO"."CONTRATO" = :ldb_numero
					USING	sqlca;
					if sqlca.sqlcode=0 then
						commit using sqlca;
						ll_graba++
					else
						rollback using sqlca;
					end if
				end if
				setnull(ls_base);setnull(ls_serie);setnull(ldb_numero);setnull(ll_folio);setnull(ldt_fec_pago);setnull(ls_tipo_cob);setnull(ls_tipo_mov);setnull(ll_cod_parque)
				if ldb_tot_porc <> ldb_tot_porc_aux then 
					tab_1.tabpage_1.st_porc.text					= string(ldb_tot_porc,'#0.##')+" %"
					ldb_tot_porc_aux									= ldb_tot_porc
				end if
				ldb_tot_porc												= (ll_graba / ll_tot_reg) * 100
				tab_1.tabpage_1.hpb_1.Position					= ldb_tot_porc
				tab_1.tabpage_1.st_cuenta.text 					= 'Total Reg. '+string(ll_tot_reg,'###,###,###')+'    Reg. Actualizados '+string(ll_graba,'###,###,###')+' '
			LOOP
		end if
		close x1;
		tab_1.tabpage_1.st_fondo.visible							= false
		tab_1.tabpage_1.st_cuenta.visible							= false
		tab_1.tabpage_1.hpb_1.visible 								= false
		tab_1.tabpage_1.st_porc.visible 							= false
		SetPointer(Arrow!)
	end if
end if
end event

type cb_39 from commandbutton within w_sap_detalle_pagos_caja_2_bkp
integer x = 5531
integer y = 1676
integer width = 626
integer height = 108
integer taborder = 60
integer textsize = -8
integer weight = 700
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string text = "Corrección Diferencias"
end type

event clicked;string		ls_base,ls_serie,ls_tipo_cob,ls_tipo_mov,ls_tipo_deuda,ls_moneda
long		ll_folio,ll_cta_pag,ll_nro_cuota,ll_graba
datetime	ldt_fec_pago
double	ldb_numero,ldb_monto,ldb_monto_uf,ldb_monto_sap,ldb_dif_pago

DECLARE x1 CURSOR FOR
SELECT	"BASE","SERIE","CONTRATO","FOLIO","FECHA_PAGO","TIPO_COB","TIPO_MOV","CUOTAS_PAG","MONTO","MONTO_UF","MONTO_SAP","CTAS_PAG_CTTO","TIPO_DEUDA","MONEDA",
			(	CASE	WHEN "VISTA_VALIDA_INGRESO_SAP"."MONEDA" = 'CLP'  THEN "VISTA_VALIDA_INGRESO_SAP"."MONTO" - "VISTA_VALIDA_INGRESO_SAP"."MONTO_SAP"
                 			WHEN "VISTA_VALIDA_INGRESO_SAP"."MONEDA" = 'UF' THEN "VISTA_VALIDA_INGRESO_SAP"."MONTO_UF" - "VISTA_VALIDA_INGRESO_SAP"."MONTO_SAP" ELSE  1 END ) AS DIF_MONTO
FROM		"VISTA_VALIDA_INGRESO_SAP"
WHERE	"VISTA_VALIDA_INGRESO_SAP"."MONTO_SAP">0 and
			"VISTA_VALIDA_INGRESO_SAP"."TIPO_MOV"<>'F' and
			"VISTA_VALIDA_INGRESO_SAP"."MONEDA" = 'UF' AND 
			"VISTA_VALIDA_INGRESO_SAP"."BASE"<>'R' and
			( "VISTA_VALIDA_INGRESO_SAP"."TIPO_MOV" = 'A' OR "VISTA_VALIDA_INGRESO_SAP"."TIPO_MOV" = 'Q' OR "VISTA_VALIDA_INGRESO_SAP"."TIPO_MOV" = 'E' OR "VISTA_VALIDA_INGRESO_SAP"."TIPO_MOV" = 'U' OR "VISTA_VALIDA_INGRESO_SAP"."TIPO_MOV" = 'F' ) AND
			(	CASE	WHEN "VISTA_VALIDA_INGRESO_SAP"."MONEDA" = 'CLP' THEN "VISTA_VALIDA_INGRESO_SAP"."MONTO" - "VISTA_VALIDA_INGRESO_SAP"."MONTO_SAP" 
                 			WHEN "VISTA_VALIDA_INGRESO_SAP"."MONEDA" = 'UF' THEN "VISTA_VALIDA_INGRESO_SAP"."MONTO_UF" - "VISTA_VALIDA_INGRESO_SAP"."MONTO_SAP" 	ELSE  1 END )>0	
USING	Trans_1;
open x1;
if Trans_1.sqlcode=0 then
	DO WHILE Trans_1.sqlcode=0
	fetch x1 INTO	:ls_base,:ls_serie,:ldb_numero,:ll_folio,:ldt_fec_pago,:ls_tipo_cob,:ls_tipo_mov,	:ll_cta_pag,:ldb_monto,:ldb_monto_uf,:ldb_monto_sap,:ll_nro_cuota,:ls_tipo_deuda,:ls_moneda,:ldb_dif_pago;
		if not isnull(ldt_fec_pago) and not isnull(ll_folio) and ll_folio>0 and not isnull(ls_tipo_deuda) and ls_tipo_deuda<>'' and not isnull(ls_tipo_cob) and ls_tipo_cob<>'' and not isnull(ls_tipo_mov) and ls_tipo_mov<>''  then
			UPDATE "INGRESO"  
     		SET		"MONTO_UF" = :ldb_monto_sap  
   			WHERE	"INGRESO"."FOLIO" = :ll_folio AND  
						"INGRESO"."TIPO_COB" = :ls_tipo_cob AND  
						"INGRESO"."FECHA_PAGO" = :ldt_fec_pago AND  
						"INGRESO"."TIPO_MOV" = :ls_tipo_mov AND  
						"INGRESO"."BASE" = :ls_base AND  
						"INGRESO"."SERIE" = :ls_serie AND  
						"INGRESO"."CONTRATO" = :ldb_numero
			USING	sqlca;
			if sqlca.sqlcode=0 then
				commit using sqlca;
				ll_graba++
			else
				rollback using sqlca;
			end if
			
		end if
		setnull(ls_base);setnull(ls_serie);setnull(ldb_numero);setnull(ll_folio);setnull(ldt_fec_pago);setnull(ls_tipo_cob);setnull(ls_tipo_mov);setnull(ll_cta_pag);setnull(ldb_monto);setnull(ldb_monto_uf);setnull(ldb_monto_sap);setnull(ll_nro_cuota);setnull(ls_tipo_deuda);setnull(ls_moneda);setnull(ldb_dif_pago)
	LOOP
end if
close x1;


end event

type cb_ctas_pag_ing from commandbutton within w_sap_detalle_pagos_caja_2_bkp
integer x = 4640
integer y = 836
integer width = 626
integer height = 108
integer taborder = 50
integer textsize = -8
integer weight = 700
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string text = "Actualizar N°Cuotas Pag"
end type

event clicked;string		ls_tipo_deuda,ls_tipo_cob,ls_tipo_mov,ls_cod_otros,ls_rezago,ls_base,ls_serie
long		ll_folio,ll_ctas_pag,ll_ctas_pag_ctto,ll_ctas_ingre,ll_tot_reg,ll_graba=0,ll_res
double	ldb_numero,ldb_tot_porc=0,ldb_tot_porc_aux=0
datetime	ldt_fec_pago,ldt_fecha_anterior,ldt_fecha_actual,ldt_inicio_fecha_actual



SELECT	"SAP_FECHA_FACTURA"."FECHA_FACTURA"  
INTO     	:ldt_fecha_actual  
FROM		"SAP_FECHA_FACTURA"  
WHERE	"SAP_FECHA_FACTURA"."ESTADO" = 'N'
USING	sqlca;

SELECT	MAX("SAP_FECHA_FACTURA"."FECHA_FACTURA")
INTO     	:ldt_fecha_anterior  
FROM		"SAP_FECHA_FACTURA"  
WHERE	"SAP_FECHA_FACTURA"."ESTADO" = 'S'
USING	sqlca;

ldt_inicio_fecha_actual 				= Datetime(relativedate(date(ldt_fecha_anterior),1),time('00:00:00'))
SELECT	COUNT("INGRESO"."FOLIO")
INTO     	:ll_tot_reg
FROM		"INGRESO","COD_MOVI"  
WHERE	"INGRESO"."TIPO_MOV" = "COD_MOVI"."COD_ING" and  
      		"INGRESO"."TIPO_COB" <> 'NE' AND  
            	( "INGRESO"."TIPO_MOV" = 'A' OR "INGRESO"."TIPO_MOV" = 'Q' OR "INGRESO"."TIPO_MOV" = 'F' OR "INGRESO"."TIPO_MOV" = 'E' OR "INGRESO"."TIPO_MOV" = 'K' OR "INGRESO"."TIPO_MOV" = 'U' OR "INGRESO"."TIPO_MOV" = 'M' OR ("INGRESO"."TIPO_MOV" = 'L' AND "INGRESO"."CODIGO_OTRO" <> '3'))   AND 
              //"INGRESO"."COD_CAJA" = 'CR' AND
              "INGRESO"."ESTADO_PAGO_SAP" = 99 AND
              "INGRESO"."PAGO_HIST" = 'A' AND
              "INGRESO"."FECHA_PAGO" >= :ldt_inicio_fecha_actual AND
              "INGRESO"."FECHA_PAGO" <= :ldt_fecha_actual
USING  sqlca;
if isnull(ll_tot_reg) then ll_tot_reg=0
if ll_tot_reg=0 then
	messagebox("Advertencia","No Registra Datos Para Actualizar")
else
	ll_res														= MessageBox("Advertencia", 'Desea Cálcular Cuota Pagada', Exclamation!, YesNo!, 2)
	if ll_res=1 then
		SetPointer(HourGlass!)
		tab_1.tabpage_1.st_fondo.visible				= true
		tab_1.tabpage_1.st_cuenta.visible				= true
		tab_1.tabpage_1.st_porc.visible				= true
		tab_1.tabpage_1.hpb_1.visible					= true
		tab_1.tabpage_1.hpb_1.Position				= ldb_tot_porc
		
		UPDATE	"INGRESO"  
     	SET		"CTAS_PAG_CTTO" = 0  
   		WHERE 	"INGRESO"."TIPO_COB" <> 'NE' AND
					( "INGRESO"."TIPO_MOV" = 'A' OR "INGRESO"."TIPO_MOV" = 'Q' OR "INGRESO"."TIPO_MOV" = 'F' OR "INGRESO"."TIPO_MOV" = 'E' OR "INGRESO"."TIPO_MOV" = 'K' OR "INGRESO"."TIPO_MOV" = 'U' OR "INGRESO"."TIPO_MOV" = 'M' OR ("INGRESO"."TIPO_MOV" = 'L' AND "INGRESO"."CODIGO_OTRO" <> '3') )   AND 
         			"INGRESO"."PAGO_HIST" = 'A'  AND
					//"INGRESO"."COD_CAJA" = 'CR' AND
         			"INGRESO"."ESTADO_PAGO_SAP" = 99 and
					"INGRESO"."FECHA_PAGO" >= :ldt_inicio_fecha_actual
		USING	sqlca;
		if sqlca.sqlcode=0 then
			commit using sqlca;
		else
			rollback using sqlca;
		end if	;
		
		SetPointer(HourGlass!)
		DECLARE x1 CURSOR FOR
		SELECT	"INGRESO"."FECHA_PAGO",
					"INGRESO"."FOLIO",
					"COD_MOVI"."TIPO_DEUDA_SAP",
					"INGRESO"."TIPO_COB",
					"INGRESO"."TIPO_MOV",
					"INGRESO"."CODIGO_OTRO",
					( CASE WHEN "INGRESO"."REZAGO" = ' ' THEN 'N' ELSE 	"INGRESO"."REZAGO" END ) AS REZAGO,
					"INGRESO"."CUOTAS_PAG",
					"INGRESO"."BASE",
					"INGRESO"."SERIE",
					"INGRESO"."CONTRATO"
		FROM		"INGRESO","COD_MOVI"  
		WHERE	"INGRESO"."TIPO_MOV" = "COD_MOVI"."COD_ING" and  
					"INGRESO"."TIPO_COB" <> 'NE' AND  
					( "INGRESO"."TIPO_MOV" = 'A' OR "INGRESO"."TIPO_MOV" = 'Q' OR "INGRESO"."TIPO_MOV" = 'F' OR "INGRESO"."TIPO_MOV" = 'E' OR "INGRESO"."TIPO_MOV" = 'K' OR "INGRESO"."TIPO_MOV" = 'U' OR "INGRESO"."TIPO_MOV" = 'M' OR ("INGRESO"."TIPO_MOV" = 'L' AND "INGRESO"."CODIGO_OTRO" <> '3'))   AND  
					"INGRESO"."ESTADO_PAGO_SAP" = 99 AND
					"INGRESO"."PAGO_HIST" = 'A' AND
					//"INGRESO"."COD_CAJA" = 'CR' AND
					 "INGRESO"."FECHA_PAGO" >= :ldt_inicio_fecha_actual AND
              		"INGRESO"."FECHA_PAGO" <= :ldt_fecha_actual
		ORDER BY "INGRESO"."FECHA_PAGO",
					"INGRESO"."FOLIO",
					"COD_MOVI"."TIPO_DEUDA_SAP",
					"INGRESO"."TIPO_COB",
					"INGRESO"."TIPO_MOV"
		USING	Trans_1;
		open x1;
		if Trans_1.sqlcode=0 then
			DO WHILE Trans_1.sqlcode=0
			fetch x1 INTO	:ldt_fec_pago,:ll_folio,:ls_tipo_deuda,:ls_tipo_cob,:ls_tipo_mov,:ls_cod_otros,:ls_rezago,:ll_ctas_pag,:ls_base,:ls_serie,:ldb_numero;
				if not isnull(ldt_fec_pago) and not isnull(ll_folio) and ll_folio>0 and not isnull(ls_tipo_deuda) and ls_tipo_deuda<>'' and not isnull(ls_tipo_cob) and ls_tipo_cob<>'' and not isnull(ls_tipo_mov) and ls_tipo_mov<>''  then
					
					if isnull(ll_ctas_pag) or ll_ctas_pag=0 then ll_ctas_pag=1
					
					if ls_tipo_deuda = 'S' then
						ll_ctas_pag_ctto					= 1
					elseif ls_tipo_deuda = 'C' then
						if ls_tipo_mov='A' or ls_tipo_mov='Q' then
							if ls_rezago='S' then
								ll_ctas_pag_ctto				= ll_ctas_pag
							else
								SELECT	count("NUMERO_CUOTA")  
								INTO 		:ll_ctas_pag_ctto  
								FROM		"DETALLE_PAGO_PIE"  
								WHERE	( "DETALLE_PAGO_PIE"."BASE" = :ls_base ) AND  
											( "DETALLE_PAGO_PIE"."SERIE" = :ls_serie ) AND  
											( "DETALLE_PAGO_PIE"."NUMERO" = :ldb_numero ) AND
											( "DETALLE_PAGO_PIE"."FOLIO" = :ll_folio ) AND
											( "DETALLE_PAGO_PIE"."FECHA_PAGO" <= :ldt_fec_pago ) AND
											( "DETALLE_PAGO_PIE"."ESTADO" = 'C' )
								USING	sqlca;
								if isnull(ll_ctas_pag_ctto) then ll_ctas_pag_ctto=0
								if ll_ctas_pag_ctto=0 then
									SELECT	max("INGRESO"."CTAS_PAG_CTTO")
									INTO		:ll_ctas_pag_ctto
									FROM		"INGRESO"
									WHERE	"INGRESO"."BASE" = :ls_base AND
												"INGRESO"."SERIE" = :ls_serie AND
												"INGRESO"."CONTRATO" = :ldb_numero AND
												"INGRESO"."TIPO_COB" <> 'NE' AND  
												("INGRESO"."TIPO_MOV" = 'A' or "INGRESO"."TIPO_MOV" = 'Q' ) AND  
												"INGRESO"."PAGO_HIST" = 'A'
									USING	sqlca;
									if isnull(ll_ctas_pag_ctto) or ll_ctas_pag_ctto=0 then
										ll_ctas_pag_ctto				= ll_ctas_pag
									else
										ll_ctas_pag_ctto				= ll_ctas_pag_ctto + ll_ctas_pag
									end if
								else
									SELECT	MAX("NUMERO_CUOTA")  
									INTO 		:ll_ctas_pag_ctto  
									FROM		"DETALLE_PAGO_PIE"  
									WHERE	( "DETALLE_PAGO_PIE"."BASE" = :ls_base ) AND  
												( "DETALLE_PAGO_PIE"."SERIE" = :ls_serie ) AND  
												( "DETALLE_PAGO_PIE"."NUMERO" = :ldb_numero ) AND
												( "DETALLE_PAGO_PIE"."FOLIO" = :ll_folio ) AND
												( "DETALLE_PAGO_PIE"."FECHA_PAGO" <= :ldt_fec_pago ) AND
												( "DETALLE_PAGO_PIE"."ESTADO" = 'C' )
									USING	sqlca;
									if isnull(ll_ctas_pag_ctto) then ll_ctas_pag_ctto=0
								end if
							end if
						elseif ls_tipo_mov='E' or ls_tipo_mov='U' or ls_tipo_mov='K' then
							if ls_rezago='N' then
								SELECT	max("INGRESO"."CTAS_PAG_CTTO")
								INTO		:ll_ctas_pag_ctto
								FROM		"INGRESO"
								WHERE	"INGRESO"."BASE" = :ls_base AND
											"INGRESO"."SERIE" = :ls_serie AND
											"INGRESO"."CONTRATO" = :ldb_numero AND
											"INGRESO"."TIPO_COB" <> 'NE' AND  
											("INGRESO"."TIPO_MOV" = 'E' or "INGRESO"."TIPO_MOV" = 'K' or "INGRESO"."TIPO_MOV" = 'U' ) AND  
											"INGRESO"."PAGO_HIST" = 'A'
								USING	sqlca;
								if isnull(ll_ctas_pag_ctto) or ll_ctas_pag_ctto=0 then
									if ls_base='R' then
										SELECT	"REPACTA_MANTENCION"."CTAS_PAGADAS"  
										INTO 		:ll_ctas_pag_ctto 
										FROM 	"REPACTA_MANTENCION"  
										WHERE	"REPACTA_MANTENCION"."BASE" = :ls_base AND
													"REPACTA_MANTENCION"."SERIE" = :ls_serie AND
													"REPACTA_MANTENCION"."NUMERO" = :ldb_numero 
										USING sqlca;
										if isnull(ll_ctas_pag_ctto) then ll_ctas_pag_ctto=0
								
										SELECT 	sum("INGRESO"."CUOTAS_PAG")  
										INTO		:ll_ctas_ingre
										FROM		"INGRESO"  
										WHERE	"INGRESO"."BASE" = :ls_base AND  
													"INGRESO"."SERIE" = :ls_serie AND  
													"INGRESO"."CONTRATO" = :ldb_numero AND
													"INGRESO"."TIPO_MOV" = 'E' AND  
													"INGRESO"."PAGO_HIST" = 'A' AND
													"INGRESO"."FECHA_PAGO" >= :ldt_fec_pago
										USING	sqlca;
										if isnull(ll_ctas_ingre) then ll_ctas_ingre=0
										if ll_ctas_ingre>0 then
											ll_ctas_pag_ctto		= ll_ctas_pag_ctto - ll_ctas_ingre
										end if
										if isnull(ll_ctas_pag_ctto) or ll_ctas_pag_ctto=0 then
											ll_ctas_pag_ctto		= ll_ctas_pag
										else
											ll_ctas_pag_ctto		= ll_ctas_pag_ctto + ll_ctas_pag
										end if
									else
										if ls_base='P' then
											SELECT	"FACTURA_PAGARE"."CTAS_PAG"  
											INTO 		:ll_ctas_pag_ctto 
											FROM 	"FACTURA_PAGARE"  
											WHERE	"FACTURA_PAGARE"."BASE" = :ls_base AND
														"FACTURA_PAGARE"."SERIE" = :ls_serie AND
														"FACTURA_PAGARE"."NUMERO" = :ldb_numero AND
														( "FACTURA_PAGARE"."ESTADO" = 'N' OR "FACTURA_PAGARE"."ESTADO" = 'S' ) AND  
														"FACTURA_PAGARE"."FECHA_CIERRE" = :ldt_fecha_anterior
											USING sqlca;
										else
											SELECT	"FACTURA_OFERTA"."CTAS_PAG"  
											INTO 		:ll_ctas_pag_ctto 
											FROM 	"FACTURA_OFERTA"  
											WHERE	"FACTURA_OFERTA"."BASE" = :ls_base AND
														"FACTURA_OFERTA"."SERIE" = :ls_serie AND
														"FACTURA_OFERTA"."NUMERO" = :ldb_numero AND
														( "FACTURA_OFERTA"."ESTADO" = 'N' OR "FACTURA_OFERTA"."ESTADO" = 'S' ) AND  
														"FACTURA_OFERTA"."FECHA_CIERRE" = :ldt_fecha_anterior
											USING sqlca;
										end if
										if isnull(ll_ctas_pag_ctto) or ll_ctas_pag_ctto=0 then
											ll_ctas_pag_ctto		= ll_ctas_pag
										else
											ll_ctas_pag_ctto		= ll_ctas_pag_ctto + ll_ctas_pag
										end if
									end if
								else
									ll_ctas_pag_ctto			= ll_ctas_pag_ctto + ll_ctas_pag
								end if
							else
								ll_ctas_pag_ctto				= ll_ctas_pag
							end if
						end if
					elseif ls_tipo_deuda = 'M' then
						if ls_rezago='N' then
							SELECT	max("INGRESO"."CTAS_PAG_CTTO")
							INTO		:ll_ctas_pag_ctto
							FROM		"INGRESO"
							WHERE	"INGRESO"."BASE" = :ls_base AND
										"INGRESO"."SERIE" = :ls_serie AND
										"INGRESO"."CONTRATO" = :ldb_numero AND
										"INGRESO"."TIPO_COB" <> 'NE' AND  
										("INGRESO"."TIPO_MOV" = 'F'  ) AND  
										"INGRESO"."PAGO_HIST" = 'A'
							USING	sqlca;
							if isnull(ll_ctas_pag_ctto) or ll_ctas_pag_ctto=0 then
								if ls_base='O' then
									SELECT	"OFERTA_V"."CTA_PAG_M"  
									INTO		:ll_ctas_pag_ctto  
									FROM		"CADENA","OFERTA_V"  
									WHERE	"CADENA"."SERIE" = "OFERTA_V"."SERIE" and  
												"CADENA"."NUMERO" = "OFERTA_V"."NRO_OFERTA" and  
												"CADENA"."CODIGO" = :ls_base AND  
												"CADENA"."SERIE" = :ls_serie AND  
												"CADENA"."NUMERO" = :ldb_numero
									USING	sqlca;
								elseif ls_base='C' then
									SELECT	"CONTRATO"."CTA_PAG_M"  
									INTO		:ll_ctas_pag_ctto  
									FROM		"CADENA","CONTRATO"  
									WHERE	"CADENA"."SERIE" = "CONTRATO"."SERIE_C" and  
												"CADENA"."NUMERO" = "CONTRATO"."NRO_CONTRATO" and  
												"CADENA"."CODIGO" = :ls_base AND  
												"CADENA"."SERIE" = :ls_serie AND  
												"CADENA"."NUMERO" = :ldb_numero
									USING	sqlca;
								end if
								if isnull(ll_ctas_pag_ctto) then ll_ctas_pag_ctto=0
								
								SELECT 	sum("INGRESO"."CUOTAS_PAG")  
								INTO		:ll_ctas_ingre
								FROM		"INGRESO"  
								WHERE	"INGRESO"."BASE" = :ls_base AND  
											"INGRESO"."SERIE" = :ls_serie AND  
											"INGRESO"."CONTRATO" = :ldb_numero AND
											"INGRESO"."TIPO_MOV" = 'F' AND  
											"INGRESO"."PAGO_HIST" = 'A' AND
											"INGRESO"."FECHA_PAGO" >= :ldt_fec_pago
								USING	sqlca;
								if isnull(ll_ctas_ingre) then ll_ctas_ingre=0
								if ll_ctas_ingre>0 then
									ll_ctas_pag_ctto		= ll_ctas_pag_ctto - ll_ctas_ingre
								end if
								if isnull(ll_ctas_pag_ctto) or ll_ctas_pag_ctto=0 then
									ll_ctas_pag_ctto		= ll_ctas_pag
								else
									ll_ctas_pag_ctto		= ll_ctas_pag_ctto + ll_ctas_pag
								end if
							else
								ll_ctas_pag_ctto			= ll_ctas_pag_ctto + ll_ctas_pag
							end if
						end if
					end if
					UPDATE	"INGRESO"  
					SET		"CTAS_PAG_CTTO" = :ll_ctas_pag_ctto  
					WHERE	"INGRESO"."FOLIO" = :ll_folio AND  
								"INGRESO"."TIPO_COB" = :ls_tipo_cob AND  
								"INGRESO"."FECHA_PAGO" = :ldt_fec_pago AND  
								"INGRESO"."TIPO_MOV" = :ls_tipo_mov AND
								"INGRESO"."CODIGO_OTRO" = :ls_cod_otros AND
								"INGRESO"."BASE" = :ls_base and
								"INGRESO"."SERIE" = :ls_serie AND
								"INGRESO"."CONTRATO" = :ldb_numero
					USING	Trans_2;
					if Trans_2.sqlcode=0 then
						commit using Trans_2;
						ll_graba++
					else
						rollback using Trans_2;
					end if
				end if
				setnull(ldt_fec_pago);setnull(ll_folio);setnull(ls_tipo_deuda);setnull(ls_tipo_cob);setnull(ls_tipo_mov);setnull(ls_cod_otros);setnull(ls_rezago);setnull(ls_base);setnull(ls_serie);setnull(ldb_numero);setnull(ll_ctas_pag)
				if ldb_tot_porc <> ldb_tot_porc_aux then 
					tab_1.tabpage_1.st_porc.text					= string(ldb_tot_porc,'#0.##')+" %"
					ldb_tot_porc_aux									= ldb_tot_porc
				end if
				ldb_tot_porc												= (ll_graba / ll_tot_reg) * 100
				tab_1.tabpage_1.hpb_1.Position					= ldb_tot_porc
				tab_1.tabpage_1.st_cuenta.text 					= 'Total Reg. '+string(ll_tot_reg,'###,###,###')+'    Reg. Cálculados '+string(ll_graba,'###,###,###')+'  '
			LOOP
		end if
		close x1;
		tab_1.tabpage_1.st_fondo.visible							= false
		tab_1.tabpage_1.st_cuenta.visible							= false
		tab_1.tabpage_1.hpb_1.visible 								= false
		tab_1.tabpage_1.st_porc.visible 							= false
		SetPointer(Arrow!)
	end if
end if
end event

type dw_hana_ctto from datawindow within w_sap_detalle_pagos_caja_2_bkp
boolean visible = false
integer x = 1957
integer y = 2664
integer width = 686
integer height = 400
string title = "none"
string dataobject = "dw_vista_sap_hana_ctto"
boolean livescroll = true
borderstyle borderstyle = stylelowered!
end type

type dw_hana_cliente from datawindow within w_sap_detalle_pagos_caja_2_bkp
boolean visible = false
integer x = 891
integer y = 2652
integer width = 686
integer height = 400
string title = "none"
string dataobject = "dw_vista_sap_hana_cliente"
boolean livescroll = true
borderstyle borderstyle = stylelowered!
end type

type cb_eliminar from commandbutton within w_sap_detalle_pagos_caja_2_bkp
boolean visible = false
integer x = 4686
integer y = 116
integer width = 736
integer height = 112
integer taborder = 40
integer textsize = -8
integer weight = 700
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string text = "Eliminar Centralización"
end type

event clicked;Date		MIAR
Long		ll_pos,ll_count,ll_res,ll_count_reg,ll_nro_envio
String		ls_caja

if gs_depto='I' then
	ll_count								= 0
	SELECT 		COUNT("SAP_CABECERA_PAGOS"."COD_CAJA")
	INTO			:ll_count_reg
	FROM 		"SAP_CABECERA_PAGOS"  
	WHERE 	  ( "SAP_CABECERA_PAGOS"."ESTADO_SAP" = 3 ) OR  
				  ( "SAP_CABECERA_PAGOS"."ESTADO_SAP" = 4 ) OR 
				  ( "SAP_CABECERA_PAGOS"."ESTADO_SAP" = 2 )
	USING	sqlca;
	if ll_count_reg > 0 then
		ll_res								= messagebox("Eliminar Centralización","Está Seguro de Eliminar Centralización... Existe(n) "+string(ll_count_reg,'###,###,##0') +" Asiento(s) Pendiente(s)",Exclamation!,YesNo!,2)
		if ll_res=1 then
			if not isnull(ls_caja) and not isnull(MIAR) then
				tab_1.tabpage_2.dw_cliente_rezago.reset()
				tab_1.tabpage_2.dw_cliente_rezago.retrieve(3,'R')
				
				DECLARE X1 CURSOR FOR  
				SELECT 	"SAP_CABECERA_PAGOS"."COD_CAJA",   
							"SAP_CABECERA_PAGOS"."FECHA_PAGO",
							"SAP_CABECERA_PAGOS"."NRO_ENVIO"
				FROM 	"SAP_CABECERA_PAGOS"  
				WHERE ( "SAP_CABECERA_PAGOS"."ESTADO_SAP" = 3 ) OR  
						  ( "SAP_CABECERA_PAGOS"."ESTADO_SAP" = 4 ) OR 
				  			( "SAP_CABECERA_PAGOS"."ESTADO_SAP" = 2 )
				USING	sqlca;
				open x1;
				if sqlca.sqlcode=0 then
					do while sqlca.sqlcode=0
						fetch x1 into :ls_caja, :MIAR, :ll_nro_envio;
						if not isnull(ls_caja) then
							UPDATE	"CLIENTE_REZAGO"  
							SET 		"ESTADO_SAP" = 0 
							WHERE 	"CLIENTE_REZAGO"."ESTADO_SAP" = 3
							USING	sqlca	;
							if sqlca.sqlcode=0 then
								commit;
							else
								rollback;
								messagebox("Error Actualizar Cliente Rezago","Error Actualizar CLIENTE_REZAGO SQL: "+sqlca.sqlerrtext)
							end if
						
							DELETE FROM 	"SAP_CABECERA_PAGOS"  
							WHERE 		  ( "SAP_CABECERA_PAGOS"."COD_CAJA" = :ls_caja ) AND  
											  ( "SAP_CABECERA_PAGOS"."FECHA_PAGO" = :MIAR ) AND
											  ( "SAP_CABECERA_PAGOS"."ESTADO_SAP" = 3 OR "SAP_CABECERA_PAGOS"."ESTADO_SAP" = 4 OR "SAP_CABECERA_PAGOS"."ESTADO_SAP" = 2 ) AND
											  ( "SAP_CABECERA_PAGOS"."NRO_ENVIO" = :ll_nro_envio )
							USING		sqlca;
							if sqlca.sqlcode=0 then
								commit;
								ll_count ++
							else
								rollback;
								messagebox("Error Eliminar","Error Eliminar SAP_CABECERA_PAGOS SQL: "+sqlca.sqlerrtext)
							end if
							  
							DELETE FROM  "SAP_HABER_SAP"
							WHERE 		  ( "SAP_HABER_SAP"."COD_CAJA" = :ls_caja ) AND  
											  ( "SAP_HABER_SAP"."FECHA_PAGO" = :MIAR ) AND
											  ( "SAP_HABER_SAP"."NRO_ENVIO" = :ll_nro_envio )
							USING sqlca  ;
							if sqlca.sqlcode=0 then
								commit;
								ll_count ++
							else
								rollback;
								messagebox("Error Eliminar","Error Eliminar SAP_HABER_SAP SQL: "+sqlca.sqlerrtext)
							end if
							
							DELETE FROM  "SAP_DEBE_SAP" 
							WHERE 		  ( "SAP_DEBE_SAP"."COD_CAJA" = :ls_caja ) AND  
											  ( "SAP_DEBE_SAP"."FECHA_PAGO" = :MIAR ) AND
											  ( "SAP_DEBE_SAP"."NRO_ENVIO" = :ll_nro_envio )
							USING sqlca  ;
							if sqlca.sqlcode=0 then
								commit;
								ll_count ++
							else
								rollback;
								messagebox("Error Eliminar","Error Eliminar SAP_DEBE_SAP SQL: "+sqlca.sqlerrtext)
							end if
							if ll_count = 3 then
								tab_1.tabpage_1.dw_ingreso.reset()
								tab_1.tabpage_1.dw_ingreso_sap.reset()
								tab_1.tabpage_1.dw_cabecera.reset()
								tab_1.tabpage_1.dw_debe.reset()
								tab_1.tabpage_1.dw_haber.reset()
								messagebox("Eliminar","Eliminación Exitosa - Proceso Caja "+ls_caja+ " Fecha del "+string(MIAR,'dd/mm/yyyy') )
							end if
						end if
						Setnull(ls_caja)
					loop	
				end if
				close x1;
			else
				if isnull(ls_caja) then
					messagebox("Advertencia","Debe Seleccionar CAJA")
					ddplb_caja.setfocus()
				elseif isnull(MIAR) then
					messagebox("Advertencia","Debe Seleccionar Fecha")
					em_1.setfocus()
				end if
			end if
		end if
	else
		messagebox("Advertencia","No Existe Centralización Pendiente")
		MIAR 									= DATE(EM_1.TEXT)
		ll_pos									= pos(ddplb_caja.text,'-')
		ls_caja								= trim(mid(ddplb_caja.text,1,(ll_pos - 1)))
		SELECT 		COUNT("SAP_CABECERA_PAGOS"."COD_CAJA")
		INTO			:ll_count_reg
		FROM 		"SAP_CABECERA_PAGOS"  
		WHERE 	  ( "SAP_CABECERA_PAGOS"."ESTADO_SAP" = 1 ) AND
					  ( "SAP_CABECERA_PAGOS"."FECHA_PAGO" = :MIAR ) AND
					  ( "SAP_CABECERA_PAGOS"."COD_CAJA" = :ls_caja ) 
		USING	sqlca;
		if ll_count_reg > 0 and gs_depto = 'I' then
			ll_res		= messagebox("Advertencia","Caja "+ls_caja+" Ya está Centralizada con Fecha "+string(MIAR,'dd/mm/yyyy'),Exclamation!,YesNo!,2)
//			ll_res		= messagebox("Advertencia","Caja "+ls_caja+" Ya está Centralizada con Fecha "+string(MIAR,'dd/mm/yyyy')+", Esta seguro de Eliminar ",Exclamation!,YesNo!,2)
//			if ll_res=1 then
//				DELETE FROM 	"SAP_CABECERA_PAGOS"  
//				WHERE 		  ( "SAP_CABECERA_PAGOS"."COD_CAJA" = :ls_caja ) AND  
