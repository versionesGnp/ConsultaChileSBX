 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"sap_boleta_deposito~" ) COLUMN(NAME=~"sap_boleta_deposito.correlativo~") COLUMN(NAME=~"sap_boleta_deposito.cod_caja~") COLUMN(NAME=~"sap_boleta_deposito.fecha_pago~") COLUMN(NAME=~"sap_boleta_deposito.cod_pago~") COLUMN(NAME=~"sap_boleta_deposito.boleta_deposito~") COLUMN(NAME=~"sap_boleta_deposito.monto~") COLUMN(NAME=~"sap_boleta_deposito.observacion~") COLUMN(NAME=~"sap_boleta_deposito.cuenta_contable~") COLUMN(NAME=~"sap_boleta_deposito.sociedad~") COLUMN(NAME=~"sap_boleta_deposito.monto_uf~")WHERE(    EXP1 =~"~~~"SAP_BOLETA_DEPOSITO~~~".~~~"COD_CAJA~~~"~"   OP =~"=~"    EXP2 =~":caja~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SAP_BOLETA_DEPOSITO~~~".~~~"FECHA_PAGO~~~"~"   OP =~"=~"    EXP2 =~":fecha~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"SAP_BOLETA_DEPOSITO~~~".~~~"COD_PAGO~~~"~"   OP =~"=~"    EXP2 =~"'CH'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"SAP_BOLETA_DEPOSITO~~~".~~~"SOCIEDAD~~~"~"   OP =~"=~"    EXP2 =~":sociedad~" ) ) ARG(NAME = ~"caja~" TYPE = string)  ARG(NAME = ~"fecha~" TYPE = date)  ARG(NAME = ~"sociedad~" TYPE = string) " update="SAP_BOLETA_DEPOSITO" updatewhere=0 updatekeyinplace=yes arguments=(("caja", string),("fecha", date),("sociedad", string))  sort="boleta_deposito A " )
