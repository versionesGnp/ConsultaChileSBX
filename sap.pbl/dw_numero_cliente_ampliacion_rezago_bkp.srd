 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"sap_ampliacion_cliente~" )  TABLE(NAME=~"cliente_rezago~" ) COLUMN(NAME=~"sap_ampliacion_cliente.rut~") COLUMN(NAME=~"sap_ampliacion_cliente.mandt~") COLUMN(NAME=~"sap_ampliacion_cliente.grupo_cuenta~") COLUMN(NAME=~"sap_ampliacion_cliente.sociedad~") COLUMN(NAME=~"sap_ampliacion_cliente.organizacion~") COLUMN(NAME=~"sap_ampliacion_cliente.fecha_creacion~") COLUMN(NAME=~"sap_ampliacion_cliente.usuario_creador~") COLUMN(NAME=~"sap_ampliacion_cliente.rut_dv~") COLUMN(NAME=~"sap_ampliacion_cliente.origen_venta~") COLUMN(NAME=~"sap_ampliacion_cliente.uso~") COLUMN(NAME=~"sap_ampliacion_cliente.tipo_cliente~") COLUMN(NAME=~"sap_ampliacion_cliente.moneda~") COLUMN(NAME=~"sap_ampliacion_cliente.ano_renta~") COLUMN(NAME=~"sap_ampliacion_cliente.pais~") COMPUTE(NAME=~"0 as estado_reg~") COLUMN(NAME=~"cliente_rezago.nombre~") COLUMN(NAME=~"cliente_rezago.ap_paterno~") COLUMN(NAME=~"cliente_rezago.ap_materno~") COLUMN(NAME=~"cliente_rezago.estado_sap~") COLUMN(NAME=~"cliente_rezago.nro_cliente_sap~") COLUMN(NAME=~"cliente_rezago.fecha_sap~") COLUMN(NAME=~"cliente_rezago.cod_pago~") COLUMN(NAME=~"cliente_rezago.folio~") COLUMN(NAME=~"cliente_rezago.fecha_pago~")    JOIN (LEFT=~"sap_ampliacion_cliente.rut~"    OP =~"=~"RIGHT=~"cliente_rezago.rut~" )WHERE(    EXP1 =~"~~~"SAP_AMPLIACION_CLIENTE~~~".~~~"ESTADO_SAP~~~"~"   OP =~"=~"    EXP2 =~"3~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"(~~~"SAP_AMPLIACION_CLIENTE~~~".~~~"TIPO_CLIENTE~~~"~"   OP =~"=~"    EXP2 =~"'C'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"SAP_AMPLIACION_CLIENTE~~~".~~~"TIPO_CLIENTE~~~"~"   OP =~"=~"    EXP2 =~"'A')~" ) ) "  sort="rut A " )
