global type f_direccion_url from function_object
end type

forward prototypes
global subroutine f_direccion_url (string as_tipo_cliente, double adb_rut, string as_xml)
end prototypes

global subroutine f_direccion_url (string as_tipo_cliente, double adb_rut, string as_xml);string	ls_string
long 		ret
Inet  iinet_base
ret = GetContextService("Internet", iinet_base)

//f_direccion_url(as_tipo_cliente,adb_rut)
if ret = -1 then
	messagebox('No hay servicio','No hay servidor disponible de internet',stopsign!)
	return
end if

if as_tipo_cliente='C' then
	ls_string							= 'z001'
else
	ls_string							= 'z0013'
end if

if gs_sap_conex='P' then
	if gl_cod_parque=104 then
		ret 					= iinet_base.HyperlinkToURL("http://172.30.2.78/z001.php?conexion=N")
	elseif gl_cod_parque=11 then
		ret 					= iinet_base.HyperlinkToURL("http://172.30.2.78/z001.php?conexion=F")
	else
		ret 					= iinet_base.HyperlinkToURL("http://172.30.2.78/"+ls_string+".php?conexion=P&rut="+string(adb_rut)+"&cerrar="+as_xml+"")
	end if
elseif gs_sap_conex='Q' then
	if gl_cod_parque=104 then
		//ret 					= iinet_base.HyperlinkToURL("http://50.50.50.192/z001.php?conexion=QN")
		ret 					= iinet_base.HyperlinkToURL("http://172.30.2.78/"+ls_string+".php?conexion=QN&rut="+string(adb_rut)+"&cerrar="+as_xml+"")
	elseif gl_cod_parque=11 then
		//ret 					= iinet_base.HyperlinkToURL("http://50.50.50.192/z001.php?conexion=QF")
		ret 					= iinet_base.HyperlinkToURL("http://172.30.2.78/"+ls_string+".php?conexion=QF&rut="+string(adb_rut)+"&cerrar="+as_xml+"")
	else
		//ret 					= iinet_base.HyperlinkToURL("http://50.50.50.192/z001.php?conexion=QP")
		ret 					= iinet_base.HyperlinkToURL("http://172.30.2.78/"+ls_string+".php?conexion=QP&rut="+string(adb_rut)+"&cerrar="+as_xml+"")
	end if
elseif gs_sap_conex='R' then
	if gl_cod_parque=104 then
		ret 					= iinet_base.HyperlinkToURL("http://172.30.2.78/"+ls_string+".php?conexion=RN&rut="+string(adb_rut)+"&cerrar="+as_xml+"")
	elseif gl_cod_parque=11 then
		ret 					= iinet_base.HyperlinkToURL("http://172.30.2.78/"+ls_string+".php?conexion=RF&rut="+string(adb_rut)+"&cerrar="+as_xml+"")
	else
		ret 					= iinet_base.HyperlinkToURL("http://172.30.2.78/"+ls_string+".php?conexion=RP&rut="+string(adb_rut)+"&cerrar="+as_xml+"")
	end if	
end if

f_reg_x_segundo('CLIE',1350000)

end subroutine

