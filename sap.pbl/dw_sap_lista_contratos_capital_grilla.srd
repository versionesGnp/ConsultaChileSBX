 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"vista_listado_cttos_calculo~" )  TABLE(NAME=~"vista_sap_ctto_00_tot_ctto~" ) COLUMN(NAME=~"vista_listado_cttos_calculo.base~") COLUMN(NAME=~"vista_listado_cttos_calculo.serie~") COLUMN(NAME=~"vista_listado_cttos_calculo.numero~") COLUMN(NAME=~"vista_listado_cttos_calculo.precio~") COLUMN(NAME=~"vista_listado_cttos_calculo.pie~") COLUMN(NAME=~"vista_listado_cttos_calculo.tasa~") COLUMN(NAME=~"vista_listado_cttos_calculo.tasa_base~") COLUMN(NAME=~"vista_listado_cttos_calculo.plazo~") COLUMN(NAME=~"vista_listado_cttos_calculo.valor_cuota~") COLUMN(NAME=~"vista_listado_cttos_calculo.moneda~") COLUMN(NAME=~"vista_listado_cttos_calculo.tipo_cobro~") COLUMN(NAME=~"vista_listado_cttos_calculo.estado_ctto~") COLUMN(NAME=~"vista_listado_cttos_calculo.gastos_adm~") COLUMN(NAME=~"vista_listado_cttos_calculo.fecha_prim~") COMPUTE(NAME=~"0 estado_reg~")    JOIN (LEFT=~"vista_listado_cttos_calculo.base~"    OP =~"=~"RIGHT=~"vista_sap_ctto_00_tot_ctto.base~" )    JOIN (LEFT=~"vista_listado_cttos_calculo.serie~"    OP =~"=~"RIGHT=~"vista_sap_ctto_00_tot_ctto.serie~" )    JOIN (LEFT=~"vista_listado_cttos_calculo.numero~"    OP =~"=~"RIGHT=~"vista_sap_ctto_00_tot_ctto.numero~" )WHERE(    EXP1 =~"(~~~"VISTA_SAP_CTTO_00_TOT_CTTO~~~".~~~"TIPO_DEUDA~~~"~"   OP =~"=~"    EXP2 =~"'C'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"VISTA_SAP_CTTO_00_TOT_CTTO~~~".~~~"TIPO_DEUDA~~~"~"   OP =~"=~"    EXP2 =~"'E')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"VISTA_LISTADO_CTTOS_CALCULO~~~".~~~"CREADA~~~"~"   OP =~"=~"    EXP2 =~":estado1~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"VISTA_LISTADO_CTTOS_CALCULO~~~".~~~"CREADA~~~"~"   OP =~"=~"    EXP2 =~":estado2)~" ) ) ORDER(NAME=~"vista_listado_cttos_calculo.numero~" ASC=yes ) ARG(NAME = ~"estado1~" TYPE = string)  ARG(NAME = ~"estado2~" TYPE = string) " arguments=(("estado1", string),("estado2", string))  sort="numero A " )
