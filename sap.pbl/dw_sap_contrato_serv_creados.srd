 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"sap_cadena_servicio~" ) COMPUTE(NAME=~"0 as marca~") COMPUTE(NAME=~"0 estado_sap~") COLUMN(NAME=~"sap_cadena_servicio.base~") COLUMN(NAME=~"sap_cadena_servicio.serie~") COLUMN(NAME=~"sap_cadena_servicio.numero~") COLUMN(NAME=~"sap_cadena_servicio.tipo_deuda~") COLUMN(NAME=~"sap_cadena_servicio.nro_cliente_sap~") COLUMN(NAME=~"sap_cadena_servicio.tipo_contrato~") COLUMN(NAME=~"sap_cadena_servicio.organizacion~") COLUMN(NAME=~"sap_cadena_servicio.rut~") COLUMN(NAME=~"sap_cadena_servicio.tipo_venta~") COLUMN(NAME=~"sap_cadena_servicio.uso~") COLUMN(NAME=~"sap_cadena_servicio.folio_comprobante~") COLUMN(NAME=~"sap_cadena_servicio.tipo_cob_comprobante~") COLUMN(NAME=~"sap_cadena_servicio.fecha_pago_comprobante~") COLUMN(NAME=~"sap_cadena_servicio.estado_sap~") COLUMN(NAME=~"sap_cadena_servicio.fecha_ctto~") COLUMN(NAME=~"sap_cadena_servicio.grupo_imputacion~") COLUMN(NAME=~"sap_cadena_servicio.folio_consulta~")WHERE(    EXP1 =~"~~~"SAP_CADENA_SERVICIO~~~".~~~"TIPO_DEUDA~~~"~"   OP =~"=~"    EXP2 =~"'S'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"SAP_CADENA_SERVICIO~~~".~~~"FECHA_PAGO_COMPROBANTE~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SAP_CADENA_SERVICIO~~~".~~~"FECHA_PAGO_COMPROBANTE~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"SAP_CADENA_SERVICIO~~~".~~~"ESTADO_SAP~~~"~"   OP =~"<>~"    EXP2 =~"1~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = datetime)  ARG(NAME = ~"fecha_fin~" TYPE = datetime) " arguments=(("fecha_ini", datetime),("fecha_fin", datetime))  sort="fecha_pago_comprobante A " )
