table(column=(type=char(20) updatewhereclause=yes name=sap_cuentas_contables_cuenta_contable dbname="sap_cuentas_contables.cuenta_contable" dbalias=".cuenta_contable" )
 column=(type=char(200) updatewhereclause=yes name=sap_cuentas_contables_descripcion_cuenta dbname="sap_cuentas_contables.descripcion_cuenta" dbalias=".descripcion_cuenta" )
 column=(type=char(2) updatewhereclause=yes name=cod_pago dbname="vista_sap_debe.cod_pago" dbalias=".cod_pago" )
 column=(type=datetime updatewhereclause=yes name=fecha_pago dbname="vista_sap_debe.fecha_pago" dbalias=".fecha_pago" )
 column=(type=char(7) updatewhereclause=yes name=forma_pago dbname="vista_sap_debe.forma_pago" dbalias=".forma_pago" )
 column=(type=char(2) updatewhereclause=yes name=cod_caja dbname="vista_sap_debe.cod_caja" dbalias=".cod_caja" )
 column=(type=number updatewhereclause=yes name=suma_monto dbname="suma_monto" )
 column=(type=number updatewhereclause=yes name=suma_monto_comi dbname="suma_monto_comi" )
 column=(type=char(10) updatewhereclause=yes name=vista_sap_debe_condicion_pago dbname="vista_sap_debe.condicion_pago" dbalias=".condicion_pago" )
 column=(type=char(1) updatewhereclause=yes name=sap_cuentas_contables_via_pago_sap dbname="sap_cuentas_contables.via_pago_sap" dbalias=".via_pago_sap" )
 column=(type=char(10) updatewhereclause=yes name=sap_cuentas_contables_centro_costo dbname="sap_cuentas_contables.centro_costo" dbalias=".centro_costo" )
 column=(type=char(2) updatewhereclause=yes name=sap_cuentas_contables_clave_contab dbname="sap_cuentas_contables.clave_contab" dbalias=".clave_contab" )
 column=(type=char(10) updatewhereclause=yes name=sap_cuentas_contables_centro_beneficio dbname="sap_cuentas_contables.centro_beneficio" dbalias=".centro_beneficio" )
 column=(type=char(10) updatewhereclause=yes name=vista_sap_debe_rut_cliente dbname="vista_sap_debe.rut_cliente" dbalias=".rut_cliente" )
 column=(type=char(20) updatewhereclause=yes name=vista_sap_debe_boleta_deposito dbname="vista_sap_debe.boleta_deposito" dbalias=".boleta_deposito" )
 column=(type=number updatewhereclause=yes name=numero dbname="numero" )
 column=(type=char(5) updatewhereclause=yes name=codigo_otro dbname="codigo_otro" )
 column=(type=number updatewhereclause=yes name=folio dbname="folio" )
 column=(type=decimal(4) updatewhereclause=yes name=tab_uf_valor_uf dbname="tab_uf.valor_uf" dbalias=".valor_uf" )
 column=(type=char(40) updatewhereclause=yes name=vista_sap_debe_cod_autorizacion_credito dbname="vista_sap_debe.cod_autorizacion_credito" dbalias=".cod_autorizacion_credito" )
 column=(type=char(81) updatewhereclause=yes name=vista_sap_debe_nro_cuotas_credito dbname="vista_sap_debe.nro_cuotas_credito" dbalias=".nro_cuotas_credito" )
 column=(type=char(20) updatewhereclause=yes name=vista_sap_debe_convenio_banco dbname="vista_sap_debe.convenio_banco" dbalias=".convenio_banco" )
 column=(type=char(15) updatewhereclause=yes name=vista_sap_debe_sociedad dbname="vista_sap_debe.sociedad" dbalias=".sociedad" )
 column=(type=char(6) updatewhereclause=yes name=tipo_monto dbname="tipo_monto" )
 retrieve="  SELECT  ~"SAP_CUENTAS_CONTABLES~".~"CUENTA_CONTABLE~",   
         ~"SAP_CUENTAS_CONTABLES~".~"DESCRIPCION_CUENTA~",   
         ~"VISTA_SAP_DEBE~".~"COD_PAGO~",   
         ~"VISTA_SAP_DEBE~".~"FECHA_PAGO~",   
         ~"VISTA_SAP_DEBE~".~"FORMA_PAGO~",   
         ~"VISTA_SAP_DEBE~".~"COD_CAJA~",   
      	TO_NUMBER(~"VISTA_SAP_DEBE~".~"SUMA_MONTO~") AS SUMA_MONTO,
		TO_NUMBER(~"VISTA_SAP_DEBE~".~"SUMA_MONTO_COMI~") AS SUMA_MONTO_COMI, 
		~"VISTA_SAP_DEBE~".~"CONDICION_PAGO~",  
         ~"SAP_CUENTAS_CONTABLES~".~"VIA_PAGO_SAP~",   
         ~"SAP_CUENTAS_CONTABLES~".~"CENTRO_COSTO~",   
         ~"SAP_CUENTAS_CONTABLES~".~"CLAVE_CONTAB~",   
         ~"SAP_CUENTAS_CONTABLES~".~"CENTRO_BENEFICIO~",   
         ~"VISTA_SAP_DEBE~".~"RUT_CLIENTE~",   
         ~"VISTA_SAP_DEBE~".~"BOLETA_DEPOSITO~",
		0 as NUMERO,
		'0' as CODIGO_OTRO,
		0 as FOLIO,
		~"TAB_UF~" .~"VALOR_UF~",
		 ~"VISTA_SAP_DEBE~".~"COD_AUTORIZACION_CREDITO~",
		 ~"VISTA_SAP_DEBE~".~"NRO_CUOTAS_CREDITO~",
		 ~"VISTA_SAP_DEBE~".~"CONVENIO_BANCO~",
		~"VISTA_SAP_DEBE~".~"SOCIEDAD~",
		'PAGO' AS TIPO_MONTO
    FROM ~"VISTA_SAP_DEBE~",   
         ~"SAP_CUENTAS_CONTABLES~",   
         ~"CODIGO_CAJAS~",
		~"TAB_UF~"  
   WHERE ( ~"VISTA_SAP_DEBE~".~"COD_PAGO~" = ~"SAP_CUENTAS_CONTABLES~".~"COD_PAGO~" ) and  
         ( ~"VISTA_SAP_DEBE~".~"COD_CAJA~" = ~"SAP_CUENTAS_CONTABLES~".~"COD_CAJA~" ) and  
         ( ~"VISTA_SAP_DEBE~".~"CONDICION_PAGO~" = ~"SAP_CUENTAS_CONTABLES~".~"ESTADO_CHEQUE~" ) and  
         ( ~"SAP_CUENTAS_CONTABLES~".~"COD_CAJA~" = ~"CODIGO_CAJAS~".~"COD_CAJA~" ) and  
         ( ~"SAP_CUENTAS_CONTABLES~".~"COD_PARQUE~" = ~"CODIGO_CAJAS~".~"COD_PARQUE~" ) and
		( ~"VISTA_SAP_DEBE~".~"FECHA_DEPOSITO~" = ~"TAB_UF~".~"FECHA_UF~" ) and

		( ~"VISTA_SAP_DEBE~".~"SOCIEDAD~" = ~"SAP_CUENTAS_CONTABLES~".~"SOCIEDAD~" ) and


         ( ( ~"VISTA_SAP_DEBE~".~"COD_CAJA~" = :cod_caja ) AND  
         ( ~"VISTA_SAP_DEBE~".~"FECHA_DEPOSITO~" = :fecha_pago ) AND
		( ~"VISTA_SAP_DEBE~".~"SOCIEDAD~" = :sociedad) AND
		( ~"SAP_CUENTAS_CONTABLES~".~"SOCIEDAD~" = :sociedad) AND
		( ~"VISTA_SAP_DEBE~".~"ESTADO_PAGO_SAP~" = :al_est_pag_sap OR ~"VISTA_SAP_DEBE~".~"ESTADO_PAGO_SAP~" = 99 ))   
   UNION ALL
  SELECT   ~"VISTA_SAP_HABER~".~"CUENTA_CONTABLE~",   
         ~"VISTA_SAP_HABER~".~"DESCRIPCION_CUENTA~",   
         'EF' as COD_PAGO,   
         ~"VISTA_SAP_HABER~".~"FECHA_PAGO~",   
         '0' as FORMA_PAGO,   
         ~"VISTA_SAP_HABER~".~"CAJA~",   
         ( ~"VISTA_SAP_HABER~".~"MTO_CLP~" * (- 1) ) AS SUM_MONTO,
   		0 as SUMA_MONTO_COMI,
		'EF' as CONDICION_PAGO,   
         '6' as VIA_PAGO_SAP,   
         ~"VISTA_SAP_HABER~".~"CENTRO~",   
         ~"VISTA_SAP_HABER~".~"CLAVE_CONTAB~",   
         ~"VISTA_SAP_HABER~".~"CENTRO_BENEFICIO~",   
         '0' as RUT_CLIENTE,   
         '0' as boleta_deposito,
		 ~"VISTA_SAP_HABER~".~"NUMERO~",
		~"VISTA_SAP_HABER~".~"CODIGO_OTRO~",
		0 as FOLIO,  --~"VISTA_SAP_HABER~".~"FOLIO~",
		~"TAB_UF~" .~"VALOR_UF~" ,
		'0',
		'0',
         '' ,
		~"VISTA_SAP_HABER~".~"SOCIEDAD~",
		'DESCTO' AS TIPO_MONTO
    FROM ~"CADENA_MORA~",  ~"CLIENTE~",   ~"COD_MOVI~",   ~"VISTA_SAP_HABER~",
		~"TAB_UF~"
   WHERE ( vista_sap_haber.base = cadena_mora.base (+)) and  
         ( vista_sap_haber.serie = cadena_mora.serie (+)) and  
         ( vista_sap_haber.numero = cadena_mora.numero (+)) and  
         ( vista_sap_haber.rut = cliente.rut (+)) and  
         ( ~"VISTA_SAP_HABER~".~"TIPO_MOV~" = ~"COD_MOVI~".~"COD_ING~" ) and  
         ( ( ~"VISTA_SAP_HABER~".~"CAJA~" = :cod_caja ) AND  
         ( ~"VISTA_SAP_HABER~".~"FECHA_DEPOSITO~" = :fecha_pago ) AND
		( ~"VISTA_SAP_HABER~".~"SOCIEDAD~" = :sociedad) AND
		( ~"VISTA_SAP_HABER~".~"FECHA_DEPOSITO~" = ~"TAB_UF~".~"FECHA_UF~" ) and  
         ( ~"VISTA_SAP_HABER~".~"TIPO_MOV~" = 'S' ) AND
		( ~"VISTA_SAP_HABER~".~"ESTADO_PAGO_SAP~" = :al_est_pag_sap OR ~"VISTA_SAP_HABER~".~"ESTADO_PAGO_SAP~" = 99))  " arguments=(("cod_caja", string),("fecha_pago", date),("al_est_pag_sap", number),("sociedad", string))  sort="sap_cuentas_contables_cuenta_contable A suma_monto A " )
