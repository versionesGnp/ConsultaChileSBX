 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"sap_boleta_deposito~" ) COLUMN(NAME=~"sap_boleta_deposito.correlativo~") COLUMN(NAME=~"sap_boleta_deposito.cod_caja~") COLUMN(NAME=~"sap_boleta_deposito.fecha_pago~") COLUMN(NAME=~"sap_boleta_deposito.cod_pago~") COLUMN(NAME=~"sap_boleta_deposito.boleta_deposito~") COLUMN(NAME=~"sap_boleta_deposito.monto~") COLUMN(NAME=~"sap_boleta_deposito.observacion~") COLUMN(NAME=~"sap_boleta_deposito.cuenta_contable~") COLUMN(NAME=~"sap_boleta_deposito.sociedad~") COLUMN(NAME=~"sap_boleta_deposito.monto_uf~") COMPUTE(NAME=~"~~~"SAP_BOLETA_DEPOSITO~~~".~~~"MONTO~~~" - ~~~"SAP_BOLETA_DEPOSITO~~~".~~~"MONTO_UF~~~" as DIF_MONTOS~")WHERE(    EXP1 =~"~~~"SAP_BOLETA_DEPOSITO~~~".~~~"COD_CAJA~~~"~"   OP =~"=~"    EXP2 =~":cod_caja~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SAP_BOLETA_DEPOSITO~~~".~~~"FECHA_PAGO~~~"~"   OP =~"=~"    EXP2 =~":fecha~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SAP_BOLETA_DEPOSITO~~~".~~~"SOCIEDAD~~~"~"   OP =~"=~"    EXP2 =~":sociedad~" ) ) ARG(NAME = ~"cod_caja~" TYPE = string)  ARG(NAME = ~"fecha~" TYPE = datetime)  ARG(NAME = ~"sociedad~" TYPE = string) " update="SAP_BOLETA_DEPOSITO" updatewhere=1 updatekeyinplace=no arguments=(("cod_caja", string),("fecha", datetime),("sociedad", string))  sort="cod_pago A correlativo A " )
