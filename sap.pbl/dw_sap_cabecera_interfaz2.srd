 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"sap_cabecera_pagos~" ) COLUMN(NAME=~"sap_cabecera_pagos.fecha_pago~") COLUMN(NAME=~"sap_cabecera_pagos.fecha_recep_pago~") COLUMN(NAME=~"sap_cabecera_pagos.clase_doc~") COLUMN(NAME=~"sap_cabecera_pagos.sociedad~") COLUMN(NAME=~"sap_cabecera_pagos.moneda~") COLUMN(NAME=~"sap_cabecera_pagos.fecha_conversion~") COLUMN(NAME=~"sap_cabecera_pagos.ref_caja_contable1~") COLUMN(NAME=~"sap_cabecera_pagos.ref_caja_contable2~") COLUMN(NAME=~"sap_cabecera_pagos.estado_sap~") COLUMN(NAME=~"sap_cabecera_pagos.cod_caja~") COLUMN(NAME=~"sap_cabecera_pagos.hora~") COLUMN(NAME=~"sap_cabecera_pagos.fecha_proceso~") COLUMN(NAME=~"sap_cabecera_pagos.fecha_contable~") COLUMN(NAME=~"sap_cabecera_pagos.item~") COLUMN(NAME=~"sap_cabecera_pagos.usuario~") COLUMN(NAME=~"sap_cabecera_pagos.valor_moneda~") COLUMN(NAME=~"sap_cabecera_pagos.moneda_local~") COLUMN(NAME=~"sap_cabecera_pagos.nro_envio~")WHERE(    EXP1 =~"~~~"SAP_CABECERA_PAGOS~~~".~~~"FECHA_PAGO~~~"~"   OP =~"=~"    EXP2 =~":fecha_pago~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"SAP_CABECERA_PAGOS~~~".~~~"COD_CAJA~~~"~"   OP =~"=~"    EXP2 =~":caja~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"SAP_CABECERA_PAGOS~~~".~~~"ESTADO_SAP~~~"~"   OP =~"=~"    EXP2 =~"1~" ) ) ARG(NAME = ~"caja~" TYPE = string)  ARG(NAME = ~"fecha_pago~" TYPE = date) " update="SAP_CABECERA_PAGOS" updatewhere=0 updatekeyinplace=yes arguments=(("caja", string),("fecha_pago", date))  sort="item A " )
