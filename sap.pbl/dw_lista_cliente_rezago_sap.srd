 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"vista_sap_cliente_rezago~" )  TABLE(NAME=~"cliente_rezago~" ) COLUMN(NAME=~"vista_sap_cliente_rezago.base~") COLUMN(NAME=~"vista_sap_cliente_rezago.serie~") COLUMN(NAME=~"vista_sap_cliente_rezago.numero~") COLUMN(NAME=~"vista_sap_cliente_rezago.tipo_cob~") COLUMN(NAME=~"vista_sap_cliente_rezago.folio~") COLUMN(NAME=~"vista_sap_cliente_rezago.fecha_pago~") COLUMN(NAME=~"vista_sap_cliente_rezago.rut~") COLUMN(NAME=~"vista_sap_cliente_rezago.caja~") COLUMN(NAME=~"vista_sap_cliente_rezago.rezago~") COLUMN(NAME=~"vista_sap_cliente_rezago.condicion_pago~") COLUMN(NAME=~"vista_sap_cliente_rezago.via_pago_sap~") COLUMN(NAME=~"vista_sap_cliente_rezago.nombre~") COLUMN(NAME=~"vista_sap_cliente_rezago.ap_paterno~") COLUMN(NAME=~"vista_sap_cliente_rezago.ap_materno~") COLUMN(NAME=~"vista_sap_cliente_rezago.telefono_part~") COLUMN(NAME=~"vista_sap_cliente_rezago.dv~") COLUMN(NAME=~"cliente_rezago.base~") COLUMN(NAME=~"cliente_rezago.serie~") COLUMN(NAME=~"cliente_rezago.numero~") COLUMN(NAME=~"vista_sap_cliente_rezago.estado_sap~") COMPUTE(NAME=~"0  as sw_marca~")    JOIN (LEFT=~"vista_sap_cliente_rezago.tipo_cob~"    OP =~"=~"RIGHT=~"cliente_rezago.cod_pago~" )    JOIN (LEFT=~"vista_sap_cliente_rezago.folio~"    OP =~"=~"RIGHT=~"cliente_rezago.folio~" )    JOIN (LEFT=~"vista_sap_cliente_rezago.fecha_pago~"    OP =~"=~"RIGHT=~"cliente_rezago.fecha_pago~" )    JOIN (LEFT=~"vista_sap_cliente_rezago.rut~"    OP =~"=~"RIGHT=~"cliente_rezago.rut~" )WHERE(    EXP1 =~"~~~"VISTA_SAP_CLIENTE_REZAGO~~~".~~~"ESTADO_SAP~~~"~"   OP =~"=~"    EXP2 =~"3~" ) ) "  sort="fecha_pago D rut A " )
