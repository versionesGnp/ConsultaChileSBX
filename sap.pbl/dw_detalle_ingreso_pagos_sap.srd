 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"vista_sap_haber~" )  TABLE(NAME=~"cod_movi~" )  TABLE(NAME=~"cadena_mora~" ) COLUMN(NAME=~"vista_sap_haber.tipo_cob~") COLUMN(NAME=~"vista_sap_haber.folio~") COLUMN(NAME=~"vista_sap_haber.fecha_pago~") COLUMN(NAME=~"vista_sap_haber.tipo_mov~") COLUMN(NAME=~"vista_sap_haber.monto~") COLUMN(NAME=~"vista_sap_haber.base~") COLUMN(NAME=~"vista_sap_haber.serie~") COLUMN(NAME=~"vista_sap_haber.numero~") COLUMN(NAME=~"vista_sap_haber.caja~") COLUMN(NAME=~"vista_sap_haber.rezago~") COLUMN(NAME=~"vista_sap_haber.valor_uf~") COLUMN(NAME=~"vista_sap_haber.rut~") COLUMN(NAME=~"vista_sap_haber.cuotas_pag~") COLUMN(NAME=~"vista_sap_haber.codigo_otro~") COLUMN(NAME=~"vista_sap_haber.cod_parque~") COLUMN(NAME=~"vista_sap_haber.cuenta_contable~") COLUMN(NAME=~"vista_sap_haber.descripcion_cuenta~") COLUMN(NAME=~"vista_sap_haber.sociedad~") COLUMN(NAME=~"vista_sap_haber.condicion_pago~") COLUMN(NAME=~"vista_sap_haber.via_pago_sap~") COLUMN(NAME=~"vista_sap_haber.contrato_sap~") COLUMN(NAME=~"vista_sap_haber.clave_contab~") COLUMN(NAME=~"vista_sap_haber.moneda~") COLUMN(NAME=~"cadena_mora.ctas_pag_s~") COLUMN(NAME=~"vista_sap_haber.cliente_sap~") COLUMN(NAME=~"vista_sap_haber.centro_beneficio~") COLUMN(NAME=~"vista_sap_haber.centro~") COLUMN(NAME=~"vista_sap_haber.ctas_pag_m~") COMPUTE(NAME=~"0 as estado_reg~") COLUMN(NAME=~"vista_sap_haber.estado_pago_sap~") COLUMN(NAME=~"vista_sap_haber.monto_uf~") COLUMN(NAME=~"vista_sap_haber.ctas_pag_ctto~") COLUMN(NAME=~"vista_sap_haber.mto_clp~")    JOIN (LEFT=~"vista_sap_haber.base~"    OP =~"=~"RIGHT=~"cadena_mora.base~"    OUTER1 =~"vista_sap_haber.base~" )    JOIN (LEFT=~"vista_sap_haber.serie~"    OP =~"=~"RIGHT=~"cadena_mora.serie~"    OUTER1 =~"vista_sap_haber.serie~" )    JOIN (LEFT=~"vista_sap_haber.numero~"    OP =~"=~"RIGHT=~"cadena_mora.numero~"    OUTER1 =~"vista_sap_haber.numero~" )    JOIN (LEFT=~"vista_sap_haber.tipo_mov~"    OP =~"=~"RIGHT=~"cod_movi.cod_ing~" )WHERE(    EXP1 =~"( ( ~~~"VISTA_SAP_HABER~~~".~~~"CAJA~~~"~"   OP =~"=~"    EXP2 =~":caja )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"VISTA_SAP_HABER~~~".~~~"FECHA_DEPOSITO~~~"~"   OP =~"=~"    EXP2 =~":fecha )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"VISTA_SAP_HABER~~~".~~~"SOCIEDAD~~~"~"   OP =~"=~"    EXP2 =~":sociedad )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"VISTA_SAP_HABER~~~".~~~"TIPO_MOV~~~"~"   OP =~"<>~"    EXP2 =~"'S' )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"((~~~"VISTA_SAP_HABER~~~".~~~"ESTADO_PAGO_SAP~~~"~"   OP =~"=~"    EXP2 =~":estado_pago_sap)~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"(~~~"VISTA_SAP_HABER~~~".~~~"ESTADO_PAGO_SAP~~~"~"   OP =~"=~"    EXP2 =~"99)))~" ) ) ARG(NAME = ~"caja~" TYPE = string)  ARG(NAME = ~"fecha~" TYPE = date)  ARG(NAME = ~"estado_pago_sap~" TYPE = number)  ARG(NAME = ~"sociedad~" TYPE = string) " arguments=(("caja", string),("fecha", date),("estado_pago_sap", number),("sociedad", string))  sort="base A serie A numero A fecha_pago A folio A tipo_mov A vista_sap_haber_ctas_pag_ctto A " )
