 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"sap_haber_sap~" )  TABLE(NAME=~"sap_cabecera_pagos~" ) COLUMN(NAME=~"sap_haber_sap.codigo_caja_llave~") COLUMN(NAME=~"sap_haber_sap.fecha_pago~") COLUMN(NAME=~"sap_haber_sap.cod_caja~") COLUMN(NAME=~"sap_haber_sap.nro_cliente_sap~") COLUMN(NAME=~"sap_haber_sap.cuenta_contable~") COLUMN(NAME=~"sap_haber_sap.descripcion_cuenta~") COLUMN(NAME=~"sap_haber_sap.centro~") COLUMN(NAME=~"sap_haber_sap.nro_contrato_sap~") COLUMN(NAME=~"sap_haber_sap.clave_pago~") COLUMN(NAME=~"sap_haber_sap.via_pago~") COLUMN(NAME=~"sap_haber_sap.fecha_venc_dcto~") COLUMN(NAME=~"sap_haber_sap.ref_dcto~") COLUMN(NAME=~"sap_haber_sap.nro_opera_transbank~") COLUMN(NAME=~"sap_haber_sap.folio_boleta~") COLUMN(NAME=~"sap_haber_sap.rez_grupo_cuenta~") COLUMN(NAME=~"sap_haber_sap.rez_sociedad~") COLUMN(NAME=~"sap_haber_sap.rez_nombre~") COLUMN(NAME=~"sap_haber_sap.rez_apellidos~") COLUMN(NAME=~"sap_haber_sap.rez_telefonos~") COLUMN(NAME=~"sap_haber_sap.rez_celular~") COLUMN(NAME=~"sap_haber_sap.rez_rut~") COLUMN(NAME=~"sap_haber_sap.rez_email~") COLUMN(NAME=~"sap_haber_sap.rez_codigo_pais~") COLUMN(NAME=~"sap_haber_sap.rez_nro_contratp_zap~") COLUMN(NAME=~"sap_haber_sap.correlativo~") COLUMN(NAME=~"sap_haber_sap.monto~") COLUMN(NAME=~"sap_haber_sap.clave_contab~") COLUMN(NAME=~"sap_haber_sap.item~") COLUMN(NAME=~"sap_haber_sap.centro_beneficio~") COLUMN(NAME=~"sap_haber_sap.monto_haber_local~")    JOIN (LEFT=~"sap_haber_sap.fecha_pago~"    OP =~"=~"RIGHT=~"sap_cabecera_pagos.fecha_pago~" )    JOIN (LEFT=~"sap_haber_sap.cod_caja~"    OP =~"=~"RIGHT=~"sap_cabecera_pagos.cod_caja~" )    JOIN (LEFT=~"sap_haber_sap.item~"    OP =~"=~"RIGHT=~"sap_cabecera_pagos.item~" )WHERE(    EXP1 =~"~~~"SAP_HABER_SAP~~~".~~~"COD_CAJA~~~"~"   OP =~"=~"    EXP2 =~":caja~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SAP_HABER_SAP~~~".~~~"FECHA_PAGO~~~"~"   OP =~"=~"    EXP2 =~":fecha_pago~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"SAP_HABER_SAP~~~".~~~"ITEM~~~"~"   OP =~"=~"    EXP2 =~":item~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"SAP_CABECERA_PAGOS~~~".~~~"ESTADO_SAP~~~"~"   OP =~"=~"    EXP2 =~"1~" ) ) ARG(NAME = ~"caja~" TYPE = string)  ARG(NAME = ~"fecha_pago~" TYPE = date)  ARG(NAME = ~"item~" TYPE = number) " arguments=(("caja", string),("fecha_pago", date),("item", number))  sort="codigo_caja_llave A correlativo A fecha_pago A cod_caja A " )
