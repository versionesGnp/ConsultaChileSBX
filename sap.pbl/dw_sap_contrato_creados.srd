 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"sap_cadena~" )  TABLE(NAME=~"sap_ctto_01_cabec~" ) COMPUTE(NAME=~"0 as marca~") COLUMN(NAME=~"sap_cadena.base~") COLUMN(NAME=~"sap_cadena.serie~") COLUMN(NAME=~"sap_cadena.numero~") COLUMN(NAME=~"sap_cadena.tipo_deuda~") COLUMN(NAME=~"sap_cadena.tipo_contrato~") COLUMN(NAME=~"sap_cadena.organizacion~") COLUMN(NAME=~"sap_cadena.tipo_venta~") COLUMN(NAME=~"sap_cadena.uso~") COLUMN(NAME=~"sap_cadena.rut~") COLUMN(NAME=~"sap_cadena.nro_contrato_sap~") COLUMN(NAME=~"sap_cadena.estado~") COLUMN(NAME=~"sap_cadena.nro_cliente_sap~") COLUMN(NAME=~"sap_cadena.grupo_imputacion~") COLUMN(NAME=~"sap_cadena.fecha_factura~") COLUMN(NAME=~"sap_cadena.tipo_carga~") COLUMN(NAME=~"sap_cadena.centro_benef~") COLUMN(NAME=~"sap_ctto_01_cabec.folio_consulta~") COLUMN(NAME=~"sap_cadena.porcentaje_pago~") COLUMN(NAME=~"sap_cadena.fecha~") COLUMN(NAME=~"sap_cadena.cod_parque~") COLUMN(NAME=~"sap_cadena.estado_sap~") COLUMN(NAME=~"sap_ctto_01_cabec.cod_age~") COLUMN(NAME=~"sap_ctto_01_cabec.cod_sup~") COLUMN(NAME=~"sap_ctto_01_cabec.cod_jef~") COLUMN(NAME=~"sap_cadena.val_age~") COLUMN(NAME=~"sap_cadena.val_sup~") COLUMN(NAME=~"sap_cadena.val_jef~")    JOIN (LEFT=~"sap_cadena.base~"    OP =~"=~"RIGHT=~"sap_ctto_01_cabec.base~" )    JOIN (LEFT=~"sap_cadena.serie~"    OP =~"=~"RIGHT=~"sap_ctto_01_cabec.serie~" )    JOIN (LEFT=~"sap_cadena.numero~"    OP =~"=~"RIGHT=~"sap_ctto_01_cabec.numero~" )    JOIN (LEFT=~"sap_cadena.tipo_deuda~"    OP =~"=~"RIGHT=~"sap_ctto_01_cabec.tipo_deuda~" )WHERE(    EXP1 =~"~~~"SAP_CADENA~~~".~~~"TIPO_DEUDA~~~"~"   OP =~"<>~"    EXP2 =~"'S'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"SAP_CADENA~~~".~~~"ESTADO_SAP~~~"~"   OP =~">~"    EXP2 =~"1~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"SAP_CADENA~~~".~~~"TIPO_CARGA~~~"~"   OP =~"=~"    EXP2 =~"'N'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"SAP_CADENA~~~".~~~"TIPO_CARGA~~~"~"   OP =~"=~"    EXP2 =~"'H') ~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"SAP_CADENA~~~".~~~"ESTADO_SAP~~~"~"   OP =~"<~"    EXP2 =~"99~" ) ) " )
