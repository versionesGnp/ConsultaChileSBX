 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"SAPABAP1.ZV_CONTRATOS2~" ) COLUMN(NAME=~"SAPABAP1.ZV_CONTRATOS2.MANDTE~") COLUMN(NAME=~"SAPABAP1.ZV_CONTRATOS2.NUM_CONTRATO~") COLUMN(NAME=~"SAPABAP1.ZV_CONTRATOS2.ORG_VENTAS~") COLUMN(NAME=~"SAPABAP1.ZV_CONTRATOS2.ORIGEN_VTA~") COLUMN(NAME=~"SAPABAP1.ZV_CONTRATOS2.USO~") COLUMN(NAME=~"SAPABAP1.ZV_CONTRATOS2.CLIENTE_SAP~") COLUMN(NAME=~"SAPABAP1.ZV_CONTRATOS2.FOLIO_CONSULTA~") COLUMN(NAME=~"SAPABAP1.ZV_CONTRATOS2.FECHA_CONTRATO~") COLUMN(NAME=~"SAPABAP1.ZV_CONTRATOS2.MONEDA~") COLUMN(NAME=~"SAPABAP1.ZV_CONTRATOS2.GRUPO_IMPUTACION~") COLUMN(NAME=~"SAPABAP1.ZV_CONTRATOS2.NRO_POSICION~") COLUMN(NAME=~"SAPABAP1.ZV_CONTRATOS2.NUM_MATERIAL~") COLUMN(NAME=~"SAPABAP1.ZV_CONTRATOS2.CENTRO~") COLUMN(NAME=~"SAPABAP1.ZV_CONTRATOS2.ALMACEN~") COLUMN(NAME=~"SAPABAP1.ZV_CONTRATOS2.SECTOR~") COLUMN(NAME=~"SAPABAP1.ZV_CONTRATOS2.COD_SEPULTURA~") COLUMN(NAME=~"SAPABAP1.ZV_CONTRATOS2.NUM_TECNICO~") COLUMN(NAME=~"SAPABAP1.ZV_CONTRATOS2.TASA_INTERES~") COLUMN(NAME=~"SAPABAP1.ZV_CONTRATOS2.CENTRO_BENEF~") COLUMN(NAME=~"SAPABAP1.ZV_CONTRATOS2.FEC_VENCIMIENTO~") COLUMN(NAME=~"SAPABAP1.ZV_CONTRATOS2.BOLETA~") COLUMN(NAME=~"SAPABAP1.ZV_CONTRATOS2.TIPO_CCTO~")WHERE(    EXP1 =~"SAPABAP1.ZV_CONTRATOS2.MANDTE~"   OP =~"=~"    EXP2 =~"'200'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"SAPABAP1.ZV_CONTRATOS2.FOLIO_CONSULTA~"   OP =~"=~"    EXP2 =~"'OI181525'~" ) ) ORDER(NAME=~"SAPABAP1.ZV_CONTRATOS2.NUM_CONTRATO~" ASC=no) "  sort="num_contrato D " )
