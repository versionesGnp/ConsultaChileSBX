 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"sap_ampliacion_cliente~" )  TABLE(NAME=~"cliente~" ) COLUMN(NAME=~"sap_ampliacion_cliente.rut~") COLUMN(NAME=~"sap_ampliacion_cliente.mandt~") COLUMN(NAME=~"sap_ampliacion_cliente.grupo_cuenta~") COLUMN(NAME=~"sap_ampliacion_cliente.sociedad~") COLUMN(NAME=~"sap_ampliacion_cliente.organizacion~") COLUMN(NAME=~"sap_ampliacion_cliente.fecha_creacion~") COLUMN(NAME=~"sap_ampliacion_cliente.usuario_creador~") COLUMN(NAME=~"sap_ampliacion_cliente.rut_dv~") COLUMN(NAME=~"sap_ampliacion_cliente.origen_venta~") COLUMN(NAME=~"sap_ampliacion_cliente.uso~") COLUMN(NAME=~"sap_ampliacion_cliente.tipo_cliente~") COLUMN(NAME=~"sap_ampliacion_cliente.moneda~") COLUMN(NAME=~"sap_ampliacion_cliente.ano_renta~") COLUMN(NAME=~"sap_ampliacion_cliente.pais~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COMPUTE(NAME=~"0 as estado_reg~") COMPUTE(NAME=~"'CC' as tipo~") COLUMN(NAME=~"sap_ampliacion_cliente.estado_sap~") COLUMN(NAME=~"sap_ampliacion_cliente.fecha_sap~") COLUMN(NAME=~"sap_ampliacion_cliente.nro_cliente_sap~")    JOIN (LEFT=~"sap_ampliacion_cliente.rut~"    OP =~"=~"RIGHT=~"cliente.rut~" )WHERE(    EXP1 =~"((~~~"SAP_AMPLIACION_CLIENTE~~~".~~~"NRO_CLIENTE_SAP~~~"~"   OP =~"is~"    EXP2 =~"null~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"SAP_AMPLIACION_CLIENTE~~~".~~~"ESTADO_SAP~~~"~"   OP =~"=~"    EXP2 =~"2)~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"(~~~"SAP_AMPLIACION_CLIENTE~~~".~~~"NRO_CLIENTE_SAP~~~"~"   OP =~"is not~"    EXP2 =~"null~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SAP_AMPLIACION_CLIENTE~~~".~~~"ESTADO_SAP~~~"~"   OP =~"=~"    EXP2 =~"3))~" ) )    UNION (PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"sap_ampliacion_cliente~" )  TABLE(NAME=~"cliente_rezago~" ) COLUMN(NAME=~"sap_ampliacion_cliente.rut~") COLUMN(NAME=~"sap_ampliacion_cliente.mandt~") COLUMN(NAME=~"sap_ampliacion_cliente.grupo_cuenta~") COLUMN(NAME=~"sap_ampliacion_cliente.sociedad~") COLUMN(NAME=~"sap_ampliacion_cliente.organizacion~") COLUMN(NAME=~"sap_ampliacion_cliente.fecha_creacion~") COLUMN(NAME=~"sap_ampliacion_cliente.usuario_creador~") COLUMN(NAME=~"cliente_rezago.dv~") COLUMN(NAME=~"sap_ampliacion_cliente.origen_venta~") COLUMN(NAME=~"sap_ampliacion_cliente.uso~") COLUMN(NAME=~"sap_ampliacion_cliente.tipo_cliente~") COLUMN(NAME=~"sap_ampliacion_cliente.moneda~") COLUMN(NAME=~"sap_ampliacion_cliente.ano_renta~") COLUMN(NAME=~"sap_ampliacion_cliente.pais~") COLUMN(NAME=~"cliente_rezago.nombre~") COLUMN(NAME=~"cliente_rezago.ap_paterno~") COLUMN(NAME=~"cliente_rezago.ap_materno~") COMPUTE(NAME=~"0 as estado_reg~") COMPUTE(NAME=~"'CR' as tipo~") COLUMN(NAME=~"sap_ampliacion_cliente.estado_sap~") COLUMN(NAME=~"sap_ampliacion_cliente.fecha_sap~") COLUMN(NAME=~"sap_ampliacion_cliente.nro_cliente_sap~")    JOIN (LEFT=~"sap_ampliacion_cliente.rut~"    OP =~"=~"RIGHT=~"cliente_rezago.rut~" )WHERE(    EXP1 =~"((~~~"SAP_AMPLIACION_CLIENTE~~~".~~~"NRO_CLIENTE_SAP~~~"~"   OP =~"is~"    EXP2 =~"null~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SAP_AMPLIACION_CLIENTE~~~".~~~"ESTADO_SAP~~~"~"   OP =~"=~"    EXP2 =~"2)~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"(~~~"SAP_AMPLIACION_CLIENTE~~~".~~~"NRO_CLIENTE_SAP~~~"~"   OP =~"is not~"    EXP2 =~"null~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SAP_AMPLIACION_CLIENTE~~~".~~~"ESTADO_SAP~~~"~"   OP =~"=~"    EXP2 =~"3))~" ) )) "  sort="sap_ampliacion_cliente_estado_sap A " )
