 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"sap_ampliacion_cliente~" )  TABLE(NAME=~"cliente~" ) COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"sap_ampliacion_cliente.rut~") COLUMN(NAME=~"sap_ampliacion_cliente.mandt~") COLUMN(NAME=~"sap_ampliacion_cliente.grupo_cuenta~") COLUMN(NAME=~"sap_ampliacion_cliente.sociedad~") COLUMN(NAME=~"sap_ampliacion_cliente.organizacion~") COLUMN(NAME=~"sap_ampliacion_cliente.estado_sap~") COLUMN(NAME=~"sap_ampliacion_cliente.fecha_sap~") COLUMN(NAME=~"sap_ampliacion_cliente.nro_cliente_sap~") COLUMN(NAME=~"sap_ampliacion_cliente.fecha_creacion~") COLUMN(NAME=~"sap_ampliacion_cliente.usuario_creador~") COLUMN(NAME=~"sap_ampliacion_cliente.rut_dv~") COLUMN(NAME=~"sap_ampliacion_cliente.origen_venta~") COLUMN(NAME=~"sap_ampliacion_cliente.uso~") COLUMN(NAME=~"sap_ampliacion_cliente.tipo_cliente~") COLUMN(NAME=~"sap_ampliacion_cliente.moneda~") COLUMN(NAME=~"sap_ampliacion_cliente.ano_renta~") COLUMN(NAME=~"sap_ampliacion_cliente.pais~")    JOIN (LEFT=~"sap_ampliacion_cliente.rut~"    OP =~"=~"RIGHT=~"cliente.rut~" )WHERE(    EXP1 =~"(~~~"SAP_AMPLIACION_CLIENTE~~~".~~~"ESTADO_SAP~~~"~"   OP =~"=~"    EXP2 =~"3~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"CLIENTE~~~".~~~"ESTADO_SAP~~~"~"   OP =~"=~"    EXP2 =~"0)~" ) ) ORDER(NAME=~"sap_ampliacion_cliente.rut~" ASC=yes )  ORDER(NAME=~"sap_ampliacion_cliente.ano_renta~" ASC=yes ) " )
