table(column=(type=char(1) updatewhereclause=yes name=cadena_codigo dbname="cadena.codigo" dbalias=".codigo" )
 column=(type=char(1) updatewhereclause=yes name=cadena_serie dbname="cadena.serie" dbalias=".serie" )
 column=(type=decimal(4) updatewhereclause=yes name=cadena_numero dbname="cadena.numero" dbalias=".numero" )
 column=(type=char(1) updatewhereclause=yes name=cadena_estado dbname="cadena.estado" dbalias=".estado" )
 column=(type=number updatewhereclause=yes name=estado_reg dbname="estado_reg" values="	1/	0" )
 column=(type=char(8) updatewhereclause=yes name=sap_cadena_sector dbname="sap_cadena.sector" dbalias=".sector" )
 column=(type=char(8) updatewhereclause=yes name=sap_cadena_sepultura dbname="sap_cadena.sepultura" dbalias=".sepultura" )
 column=(type=char(25) updatewhereclause=yes name=sap_cadena_nro_tecnico dbname="sap_cadena.nro_tecnico" dbalias=".nro_tecnico" )
 column=(type=datetime updatewhereclause=yes name=cadena_mora_fecha_venc_cred dbname="cadena_mora.fecha_venc_cred" dbalias=".fecha_venc_cred" )
 column=(type=char(50) updatewhereclause=yes name=sap_cadena_nro_contrato_sap dbname="sap_cadena.nro_contrato_sap" dbalias=".nro_contrato_sap" )
 column=(type=char(1) updatewhereclause=yes name=sap_cadena_tipo_status_sap dbname="sap_cadena.tipo_status_sap" dbalias=".tipo_status_sap" values="MODIFICACION	M/RESCILIACION	R/" )
 column=(type=char(3) updatewhereclause=yes name=sap_cadena_tipo_modif_sap dbname="sap_cadena.tipo_modif_sap" dbalias=".tipo_modif_sap" )
 column=(type=char(500) updatewhereclause=yes name=solicitudes_descripcion dbname="solicitudes.descripcion" dbalias=".descripcion" )
 column=(type=char(1) updatewhereclause=yes name=sap_cadena_tipo_deuda dbname="sap_cadena.tipo_deuda" dbalias=".tipo_deuda" )
 column=(type=decimal(4) updatewhereclause=yes name=cadena_rut dbname="cadena.rut" dbalias=".rut" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"sap_cadena~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"estado~" )  TABLE(NAME=~"cadena_mora~" )  TABLE(NAME=~"solicitudes~" ) COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"cadena.serie~") COLUMN(NAME=~"cadena.numero~") COLUMN(NAME=~"cadena.estado~") COMPUTE(NAME=~"0 as estado_reg~") COLUMN(NAME=~"sap_cadena.sector~") COLUMN(NAME=~"sap_cadena.sepultura~") COLUMN(NAME=~"sap_cadena.nro_tecnico~") COLUMN(NAME=~"cadena_mora.fecha_venc_cred~") COLUMN(NAME=~"sap_cadena.nro_contrato_sap~") COLUMN(NAME=~"sap_cadena.tipo_status_sap~") COLUMN(NAME=~"sap_cadena.tipo_modif_sap~") COLUMN(NAME=~"solicitudes.descripcion~") COLUMN(NAME=~"sap_cadena.tipo_deuda~") COLUMN(NAME=~"cadena.rut~")    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"sap_cadena.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"sap_cadena.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"sap_cadena.numero~" )    JOIN (LEFT=~"cadena.estado~"    OP =~"=~"RIGHT=~"estado.cod_estado~" )    JOIN (LEFT=~"sap_cadena.tipo_deuda~"    OP =~"=~"RIGHT=~"cadena.sap_cred~" )    JOIN (LEFT=~"sap_cadena.base~"    OP =~"=~"RIGHT=~"cadena_mora.base~" )    JOIN (LEFT=~"sap_cadena.serie~"    OP =~"=~"RIGHT=~"cadena_mora.serie~" )    JOIN (LEFT=~"sap_cadena.numero~"    OP =~"=~"RIGHT=~"cadena_mora.numero~" )    JOIN (LEFT=~"sap_cadena.tipo_modif_sap~"    OP =~"=~"RIGHT=~"solicitudes.codigo_solicitud~" )WHERE(    EXP1 =~"~~~"ESTADO~~~".~~~"ESTADO_FACTURACION~~~"~"   OP =~"=~"    EXP2 =~"'V'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"SAP_CADENA~~~".~~~"TIPO_STATUS_SAP~~~"~"   OP =~"=~"    EXP2 =~"'M'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"SAP_CADENA~~~".~~~"STATUS_MODIF_SAP~~~"~"   OP =~"=~"    EXP2 =~"0~" ) ) " )
