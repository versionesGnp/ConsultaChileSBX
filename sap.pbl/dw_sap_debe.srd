 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"sap_debe_sap~" )  TABLE(NAME=~"sap_cabecera_pagos~" ) COLUMN(NAME=~"sap_debe_sap.codigo_caja_llave~") COLUMN(NAME=~"sap_debe_sap.fecha_pago~") COLUMN(NAME=~"sap_debe_sap.cod_pago~") COLUMN(NAME=~"sap_debe_sap.cod_pago_anexo~") COLUMN(NAME=~"sap_debe_sap.cod_caja~") COLUMN(NAME=~"sap_debe_sap.cuenta_contable~") COLUMN(NAME=~"sap_debe_sap.descripcion_cuenta~") COLUMN(NAME=~"sap_debe_sap.centro~") COLUMN(NAME=~"sap_debe_sap.via_pago_sap~") COLUMN(NAME=~"sap_debe_sap.fecha_valor~") COLUMN(NAME=~"sap_debe_sap.monto~") COLUMN(NAME=~"sap_debe_sap.folio_boleta_deposito~") COLUMN(NAME=~"sap_debe_sap.fecha_venc_cheque~") COLUMN(NAME=~"sap_debe_sap.ref_dcto~") COLUMN(NAME=~"sap_debe_sap.nro_operacion_trans~") COLUMN(NAME=~"sap_debe_sap.folio_boleta~") COLUMN(NAME=~"sap_debe_sap.centro_beneficio~") COLUMN(NAME=~"sap_debe_sap.clave_contab~") COLUMN(NAME=~"sap_debe_sap.nro_cliente_sap~") COLUMN(NAME=~"sap_debe_sap.monto_debe_local~")    JOIN (LEFT=~"sap_debe_sap.fecha_pago~"    OP =~"=~"RIGHT=~"sap_cabecera_pagos.fecha_pago~" )    JOIN (LEFT=~"sap_debe_sap.cod_caja~"    OP =~"=~"RIGHT=~"sap_cabecera_pagos.cod_caja~" )    JOIN (LEFT=~"sap_debe_sap.item~"    OP =~"=~"RIGHT=~"sap_cabecera_pagos.item~" )    JOIN (LEFT=~"sap_debe_sap.nro_envio~"    OP =~"=~"RIGHT=~"sap_cabecera_pagos.nro_envio~" )    JOIN (LEFT=~"sap_debe_sap.sociedad~"    OP =~"=~"RIGHT=~"sap_cabecera_pagos.sociedad~" )WHERE(    EXP1 =~"~~~"SAP_DEBE_SAP~~~".~~~"FECHA_PAGO~~~"~"   OP =~"=~"    EXP2 =~":fecha_pago~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SAP_DEBE_SAP~~~".~~~"COD_CAJA~~~"~"   OP =~"=~"    EXP2 =~":caja~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"SAP_DEBE_SAP~~~".~~~"SOCIEDAD~~~"~"   OP =~"=~"    EXP2 =~":sociedad~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"SAP_DEBE_SAP~~~".~~~"ITEM~~~"~"   OP =~"=~"    EXP2 =~":item~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"SAP_CABECERA_PAGOS~~~".~~~"ESTADO_SAP~~~"~"   OP =~"=~"    EXP2 =~"2~" ) ) ARG(NAME = ~"caja~" TYPE = string)  ARG(NAME = ~"fecha_pago~" TYPE = date)  ARG(NAME = ~"item~" TYPE = number)  ARG(NAME = ~"sociedad~" TYPE = string) " arguments=(("caja", string),("fecha_pago", date),("item", number),("sociedad", string))  sort="codigo_caja_llave A cuenta_contable A cod_pago A cod_pago_anexo A folio_boleta A " )
