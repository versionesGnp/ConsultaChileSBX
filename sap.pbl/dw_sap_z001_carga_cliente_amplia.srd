 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"vista_sap_cliente~" )  TABLE(NAME=~"sap_ampliacion_cliente~" ) COLUMN(NAME=~"vista_sap_cliente.rut~") COLUMN(NAME=~"vista_sap_cliente.dv~") COLUMN(NAME=~"vista_sap_cliente.nombre~") COLUMN(NAME=~"vista_sap_cliente.a_paterno~") COLUMN(NAME=~"vista_sap_cliente.a_materno~") COLUMN(NAME=~"vista_sap_cliente.estado_sap~") COLUMN(NAME=~"vista_sap_cliente.fecha_sap~") COLUMN(NAME=~"vista_sap_cliente.nro_cliente_sap~") COLUMN(NAME=~"vista_sap_cliente.uso~") COLUMN(NAME=~"vista_sap_cliente.tipo_venta~") COLUMN(NAME=~"vista_sap_cliente.organ_venta~") COLUMN(NAME=~"vista_sap_cliente.sociedad~") COLUMN(NAME=~"vista_sap_cliente.grupo_cta~") COMPUTE(NAME=~"0 as estado_reg~") COLUMN(NAME=~"vista_sap_cliente.tipo_carga~") COLUMN(NAME=~"vista_sap_cliente.ano_renta~") COLUMN(NAME=~"vista_sap_cliente.porcentaje_pago~") COLUMN(NAME=~"vista_sap_cliente.uwaer~") COLUMN(NAME=~"vista_sap_cliente.pais~")    JOIN (LEFT=~"vista_sap_cliente.rut~"    OP =~"=~"RIGHT=~"sap_ampliacion_cliente.rut~" )    JOIN (LEFT=~"vista_sap_cliente.grupo_cta~"    OP =~"=~"RIGHT=~"sap_ampliacion_cliente.grupo_cuenta~" )    JOIN (LEFT=~"vista_sap_cliente.sociedad~"    OP =~"=~"RIGHT=~"sap_ampliacion_cliente.sociedad~" )    JOIN (LEFT=~"vista_sap_cliente.organ_venta~"    OP =~"=~"RIGHT=~"sap_ampliacion_cliente.organizacion~" )    JOIN (LEFT=~"vista_sap_cliente.tipo_venta~"    OP =~"=~"RIGHT=~"sap_ampliacion_cliente.origen_venta~" )    JOIN (LEFT=~"vista_sap_cliente.uso~"    OP =~"=~"RIGHT=~"sap_ampliacion_cliente.uso~" )WHERE(    EXP1 =~"~~~"VISTA_SAP_CLIENTE~~~".~~~"TIPO~~~"~"   OP =~"=~"    EXP2 =~":tipo_carga~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"SAP_AMPLIACION_CLIENTE~~~".~~~"TIPO_CLIENTE~~~"~"   OP =~"=~"    EXP2 =~"'A'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"VISTA_SAP_CLIENTE~~~".~~~"ESTADO_SAP~~~"~"   OP =~"=~"    EXP2 =~"1~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"SAP_AMPLIACION_CLIENTE~~~".~~~"ESTADO_SAP~~~"~"   OP =~"=~"    EXP2 =~"3~" ) ) ORDER(NAME=~"vista_sap_cliente.rut~" ASC=yes )  ORDER(NAME=~"vista_sap_cliente.ano_renta~" ASC=yes ) ARG(NAME = ~"tipo_carga~" TYPE = string) " arguments=(("tipo_carga", string))  sort="rut A ano_renta A " )
