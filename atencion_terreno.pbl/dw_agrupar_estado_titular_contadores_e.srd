table(column=(type=char(1) updatewhereclause=yes name=cliente_estado_titular dbname="cliente.estado_titular" values="1 - Fallecido	1/0 - Activo	0/" )
 column=(type=decimal(4) updatewhereclause=yes name=carta_log_rut dbname="carta_log.rut" )
 column=(type=char(3) updatewhereclause=yes name=carta_log_estado_env dbname="carta_log.estado_env" )
 column=(type=datetime updatewhereclause=yes name=carta_log_fecha_carta dbname="carta_log.fecha_carta" )
 column=(type=char(15) updatewhereclause=yes name=carta_log_usuario dbname="carta_log.usuario" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cliente~" )  TABLE(NAME=~"encargados~" )  TABLE(NAME=~"carta_log~" ) COLUMN(NAME=~"cliente.estado_titular~") COLUMN(NAME=~"carta_log.rut~") COLUMN(NAME=~"carta_log.estado_env~") COLUMN(NAME=~"carta_log.fecha_carta~") COLUMN(NAME=~"carta_log.usuario~")    JOIN (LEFT=~"carta_log.usuario~"    OP =~"=~"RIGHT=~"encargados.codigo_usuario~" )    JOIN (LEFT=~"cliente.rut~"    OP =~"=~"RIGHT=~"carta_log.rut~" )WHERE(    EXP1 =~"(~~~"CARTA_LOG~~~".~~~"FECHA_CARTA~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CARTA_LOG~~~".~~~"FECHA_CARTA~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CARTA_LOG~~~".~~~"USUARIO~~~"~"   OP =~"like~"    EXP2 =~":usuario~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = date)  ARG(NAME = ~"fecha_fin~" TYPE = date)  ARG(NAME = ~"usuario~" TYPE = string) " arguments=(("fecha_ini", date),("fecha_fin", date),("usuario", string))  sort="cliente_estado_titular A estado_num A " )
