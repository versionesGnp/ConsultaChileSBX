 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"at_gestion~" )  TABLE(NAME=~"at_lista_gestion~" ) COLUMN(NAME=~"at_gestion.base~") COLUMN(NAME=~"at_gestion.serie~") COLUMN(NAME=~"at_gestion.numero~") COLUMN(NAME=~"at_gestion.rut_cliente~") COLUMN(NAME=~"at_gestion.fecha_crea~") COLUMN(NAME=~"at_gestion.codigo_grupo~") COLUMN(NAME=~"at_gestion.estado_gestion~") COLUMN(NAME=~"at_gestion.usuario_asignado~") COLUMN(NAME=~"at_gestion.fecha_prox_llamada~") COLUMN(NAME=~"at_gestion.fecha_prox_visita~") COLUMN(NAME=~"at_gestion.estado_llamada~") COLUMN(NAME=~"at_gestion.estado_visita~") COLUMN(NAME=~"at_lista_gestion.usuario_creador~")    JOIN (LEFT=~"at_gestion.codigo_grupo~"    OP =~"=~"RIGHT=~"at_lista_gestion.codigo_grupo~" )WHERE(    EXP1 =~"~~~"AT_GESTION~~~".~~~"CODIGO_GRUPO~~~"~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"AT_LISTA_GESTION~~~".~~~"ESTADO_GESTION_LISTA~~~"~"   OP =~"=~"    EXP2 =~"'P'~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"usuario_creador~" TYPE = string)  ARG(NAME = ~"gs_depto~" TYPE = string)  ARG(NAME = ~"opcion~" TYPE = string) " update="AT_GESTION" updatewhere=0 updatekeyinplace=yes arguments=(("grupo", number),("usuario_creador", string),("gs_depto", string),("opcion", string)) )
