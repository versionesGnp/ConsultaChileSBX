 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"encargados~" )  TABLE(NAME=~"at_usuario_mixto~" ) COLUMN(NAME=~"encargados.codigo_usuario~") COLUMN(NAME=~"encargados.password~") COLUMN(NAME=~"encargados.nombre~") COLUMN(NAME=~"encargados.acceso~") COLUMN(NAME=~"encargados.depto~") COLUMN(NAME=~"encargados.company~") COLUMN(NAME=~"encargados.fecha_termino~") COLUMN(NAME=~"encargados.opera~") COLUMN(NAME=~"encargados.cons_general~") COLUMN(NAME=~"encargados.solicitudes~") COLUMN(NAME=~"encargados.digitacion~") COLUMN(NAME=~"encargados.fecha_ingreso~") COLUMN(NAME=~"encargados.fecha_expiracion~") COLUMN(NAME=~"encargados.estado~") COLUMN(NAME=~"encargados.personal_interno~") COLUMN(NAME=~"encargados.link~") COLUMN(NAME=~"encargados.email~")    JOIN (LEFT=~"encargados.codigo_usuario~"    OP =~"=~"RIGHT=~"at_usuario_mixto.usuario~" )WHERE(    EXP1 =~"~~~"ENCARGADOS~~~".~~~"DEPTO~~~"~"   OP =~"=~"    EXP2 =~"'E'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"AT_USUARIO_MIXTO~~~".~~~"TIPO_GESTION~~~"~"   OP =~"=~"    EXP2 =~":tipo_cob~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"ENCARGADOS~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'A'~" ) ) ARG(NAME = ~"tipo_cob~" TYPE = string) " arguments=(("tipo_cob", string))  sort="codigo_usuario A " )
