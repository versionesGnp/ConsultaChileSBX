 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"at_gestion~" )  TABLE(NAME=~"at_lista_gestion~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"cadena_mora~" )  TABLE(NAME=~"cliente~" )  TABLE(NAME=~"oferta_v~" )  TABLE(NAME=~"pago_oferta~" )  TABLE(NAME=~"at_clasifica_riesgo~" ) COLUMN(NAME=~"at_gestion.base~") COLUMN(NAME=~"at_gestion.serie~") COLUMN(NAME=~"at_gestion.numero~") COLUMN(NAME=~"at_gestion.rut_cliente~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cliente.fono_p~") COLUMN(NAME=~"cliente.fono_c~") COLUMN(NAME=~"cadena_mora.mora_cred~") COLUMN(NAME=~"cadena_mora.dias_mora_cred~") COLUMN(NAME=~"cadena_mora.fecha_venc_cred~") COLUMN(NAME=~"cadena_mora.ctas_pag_s~") COLUMN(NAME=~"cadena_mora.plazo~") COLUMN(NAME=~"cadena_mora.valor_cuota~") COLUMN(NAME=~"cadena.cod_parque~") COLUMN(NAME=~"cadena_mora.fallecidos~") COLUMN(NAME=~"pago_oferta.fecha_ult~") COLUMN(NAME=~"oferta_v.uso~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"at_gestion.estado_gestion~") COLUMN(NAME=~"at_clasifica_riesgo.op_pie~") COLUMN(NAME=~"at_clasifica_riesgo.op_justifica_renta~") COLUMN(NAME=~"at_clasifica_riesgo.op_comp_domicilio~") COLUMN(NAME=~"at_clasifica_riesgo.op_plazo~") COLUMN(NAME=~"at_clasifica_riesgo.at_tipo_vivienda~") COLUMN(NAME=~"at_clasifica_riesgo.at_automovil~") COLUMN(NAME=~"at_clasifica_riesgo.at_electrodomestico~") COLUMN(NAME=~"at_clasifica_riesgo.at_telecomunicaciones~") COLUMN(NAME=~"at_clasifica_riesgo.at_interes_cliente~") COLUMN(NAME=~"at_gestion.usuario_asignado~") COLUMN(NAME=~"at_gestion.fecha_crea~")    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"at_clasifica_riesgo.base~"    OUTER1 =~"cadena.codigo~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"at_clasifica_riesgo.serie~"    OUTER1 =~"cadena.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"at_clasifica_riesgo.numero~"    OUTER1 =~"cadena.numero~" )    JOIN (LEFT=~"at_gestion.codigo_grupo~"    OP =~"=~"RIGHT=~"at_lista_gestion.codigo_grupo~" )    JOIN (LEFT=~"oferta_v.serie~"    OP =~"=~"RIGHT=~"pago_oferta.serie~" )    JOIN (LEFT=~"oferta_v.nro_oferta~"    OP =~"=~"RIGHT=~"pago_oferta.nro_oferta~" )    JOIN (LEFT=~"oferta_v.ult_folio~"    OP =~"=~"RIGHT=~"pago_oferta.folio~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"cadena_mora.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"cadena_mora.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"cadena_mora.numero~" )    JOIN (LEFT=~"at_gestion.base~"    OP =~"=~"RIGHT=~"cadena.codigo~" )    JOIN (LEFT=~"at_gestion.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"at_gestion.numero~"    OP =~"=~"RIGHT=~"cadena.numero~" )    JOIN (LEFT=~"at_gestion.rut_cliente~"    OP =~"=~"RIGHT=~"cliente.rut~" )    JOIN (LEFT=~"at_gestion.serie~"    OP =~"=~"RIGHT=~"oferta_v.serie~" )    JOIN (LEFT=~"at_gestion.numero~"    OP =~"=~"RIGHT=~"oferta_v.nro_oferta~" )WHERE(    EXP1 =~"~~~"AT_GESTION~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~"'O'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"AT_GESTION~~~".~~~"ESTADO_GESTION~~~"~"   OP =~"like~"    EXP2 =~":estado~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CADENA_MORA~~~".~~~"MORA_CRED~~~"~"   OP =~">=~"    EXP2 =~":mora_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CADENA_MORA~~~".~~~"MORA_CRED~~~"~"   OP =~"<=~"    EXP2 =~":mora_fin~" ) ) ARG(NAME = ~"parque~" TYPE = number)  ARG(NAME = ~"estado~" TYPE = string)  ARG(NAME = ~"mora_ini~" TYPE = number)  ARG(NAME = ~"mora_fin~" TYPE = number) " arguments=(("parque", number),("estado", string),("mora_ini", number),("mora_fin", number))  sort="at_gestion_numero A cadena_estado A " )
