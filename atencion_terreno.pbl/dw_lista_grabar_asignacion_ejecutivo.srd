 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"at_gestion~" ) COLUMN(NAME=~"at_gestion.base~") COLUMN(NAME=~"at_gestion.serie~") COLUMN(NAME=~"at_gestion.numero~") COLUMN(NAME=~"at_gestion.rut_cliente~") COLUMN(NAME=~"at_gestion.fecha_crea~") COLUMN(NAME=~"at_gestion.codigo_grupo~") COLUMN(NAME=~"at_gestion.estado_gestion~") COLUMN(NAME=~"at_gestion.usuario_asignado~") COLUMN(NAME=~"at_gestion.fecha_prox_llamada~") COLUMN(NAME=~"at_gestion.fecha_prox_visita~") COLUMN(NAME=~"at_gestion.estado_llamada~") COLUMN(NAME=~"at_gestion.estado_visita~") COLUMN(NAME=~"at_gestion.tipo_cobranza~")WHERE(    EXP1 =~"~~~"AT_GESTION~~~".~~~"CODIGO_GRUPO~~~"~"   OP =~"=~"    EXP2 =~":grupo~" ) ) ARG(NAME = ~"grupo~" TYPE = number) " update="AT_GESTION" updatewhere=0 updatekeyinplace=yes arguments=(("grupo", number)) )
