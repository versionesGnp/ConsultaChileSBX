 column=(type=char(15) updatewhereclause=yes name=carta_log_usuario dbname="carta_log.usuario" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"at_gestion~" )  TABLE(NAME=~"cliente~" )  TABLE(NAME=~"encargados~" )  TABLE(NAME=~"carta_log~" ) COLUMN(NAME=~"cliente.estado_titular~") COLUMN(NAME=~"carta_log.rut~") COLUMN(NAME=~"carta_log.estado_env~") COLUMN(NAME=~"carta_log.fecha_carta~") COLUMN(NAME=~"carta_log.usuario~")    JOIN (LEFT=~"at_gestion.base~"    OP =~"=~"RIGHT=~"carta_log.base~"    OUTER1 =~"at_gestion.base~" )    JOIN (LEFT=~"at_gestion.serie~"    OP =~"=~"RIGHT=~"carta_log.serie~"    OUTER1 =~"at_gestion.serie~" )    JOIN (LEFT=~"at_gestion.numero~"    OP =~"=~"RIGHT=~"carta_log.numero~"    OUTER1 =~"at_gestion.numero~" )    JOIN (LEFT=~"at_gestion.rut_cliente~"    OP =~"=~"RIGHT=~"cliente.rut~" )    JOIN (LEFT=~"carta_log.usuario~"    OP =~"=~"RIGHT=~"encargados.codigo_usuario~" )WHERE(    EXP1 =~"(to_date(~~~"CARTA_LOG~~~".~~~"FECHA_CARTA~~~")~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"to_date(~~~"CARTA_LOG~~~".~~~"FECHA_CARTA~~~")~"   OP =~"<=~"    EXP2 =~":fecha_fin)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"ENCARGADOS~~~".~~~"DEPTO~~~"~"   OP =~"=~"    EXP2 =~"'E'~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = date)  ARG(NAME = ~"fecha_fin~" TYPE = date) " arguments=(("fecha_ini", date),("fecha_fin", date))  sort="cliente_estado_titular A estado_num A " )
