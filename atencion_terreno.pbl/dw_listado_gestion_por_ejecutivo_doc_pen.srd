 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"at_gestion~" )  TABLE(NAME=~"atencion_log~" )  TABLE(NAME=~"cliente~" )  TABLE(NAME=~"ciudad~" )  TABLE(NAME=~"comuna~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"cadena_mora~" )  TABLE(NAME=~"encargados~" ) COLUMN(NAME=~"at_gestion.base~") COLUMN(NAME=~"at_gestion.serie~") COLUMN(NAME=~"at_gestion.numero~") COLUMN(NAME=~"at_gestion.rut_cliente~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cliente.direccion_p~") COLUMN(NAME=~"cliente.numero_particular~") COLUMN(NAME=~"cliente.depto_particular~") COLUMN(NAME=~"cliente.block_particular~") COLUMN(NAME=~"cliente.estado_titular~") COLUMN(NAME=~"cliente.comuna~") COLUMN(NAME=~"comuna.comuna~") COLUMN(NAME=~"cliente.ciudad~") COLUMN(NAME=~"ciudad.ciudad~") COLUMN(NAME=~"at_gestion.codigo_grupo~") COLUMN(NAME=~"cliente.fono_p~") COLUMN(NAME=~"cliente.fono_c~") COLUMN(NAME=~"at_gestion.fecha_prox_visita~") COLUMN(NAME=~"at_gestion.estado_visita~") COLUMN(NAME=~"atencion_log.estado~") COLUMN(NAME=~"atencion_log.fecha~") COLUMN(NAME=~"atencion_log.glosa~") COLUMN(NAME=~"at_gestion.fecha_prox_llamada~") COLUMN(NAME=~"at_gestion.estado_llamada~") COLUMN(NAME=~"cadena.cod_parque~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"cadena.fecha_res~") COLUMN(NAME=~"cadena_mora.mora_cred~") COLUMN(NAME=~"cadena_mora.dias_mora_cred~") COLUMN(NAME=~"cadena_mora.fecha_venc_cred~") COLUMN(NAME=~"cadena_mora.mora_mant~") COLUMN(NAME=~"cadena_mora.dias_mora_mant~") COLUMN(NAME=~"cadena_mora.fecha_venc_mant~") COLUMN(NAME=~"cadena_mora.plazo~") COLUMN(NAME=~"cadena_mora.ctas_pag_s~") COLUMN(NAME=~"cadena_mora.mora_cred_pie~") COLUMN(NAME=~"cadena_mora.dias_mora_cred_pie~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"encargados.nombre~") COLUMN(NAME=~"cadena_mora.fallecidos~") COMPUTE(NAME=~"''~") COLUMN(NAME=~"at_gestion.usuario_asignado~")    JOIN (LEFT=~"at_gestion.base~"    OP =~"=~"RIGHT=~"atencion_log.base~" )    JOIN (LEFT=~"at_gestion.serie~"    OP =~"=~"RIGHT=~"atencion_log.serie~" )    JOIN (LEFT=~"at_gestion.numero~"    OP =~"=~"RIGHT=~"atencion_log.numero~" )    JOIN (LEFT=~"at_gestion.rut_cliente~"    OP =~"=~"RIGHT=~"cliente.rut~" )    JOIN (LEFT=~"cliente.comuna~"    OP =~"=~"RIGHT=~"comuna.codigo_comuna~" )    JOIN (LEFT=~"cliente.ciudad~"    OP =~"=~"RIGHT=~"ciudad.codigo_ciudad~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"cadena_mora.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"cadena_mora.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"cadena_mora.numero~" )    JOIN (LEFT=~"atencion_log.base~"    OP =~"=~"RIGHT=~"cadena.codigo~" )    JOIN (LEFT=~"atencion_log.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"atencion_log.numero~"    OP =~"=~"RIGHT=~"cadena.numero~" )    JOIN (LEFT=~"at_gestion.usuario_asignado~"    OP =~"=~"RIGHT=~"encargados.codigo_usuario~" )    JOIN (LEFT=~"at_gestion.usuario_asignado~"    OP =~"=~"RIGHT=~"atencion_log.usuario~" )WHERE(    EXP1 =~"~~~"AT_GESTION~~~".~~~"USUARIO_ASIGNADO~~~"~"   OP =~"like~"    EXP2 =~":usuario~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"ATENCION_LOG~~~".~~~"FECHA~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"ATENCION_LOG~~~".~~~"FECHA~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"ATENCION_LOG~~~".~~~"ESTADO~~~"~"   OP =~"like~"    EXP2 =~":estado~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = date)  ARG(NAME = ~"fecha_fin~" TYPE = date)  ARG(NAME = ~"usuario~" TYPE = string)  ARG(NAME = ~"estado~" TYPE = string) " arguments=(("fecha_ini", date),("fecha_fin", date),("usuario", string),("estado", string))  sort="at_gestion_base A at_gestion_numero A cadena_mora_mora_cred A " )
