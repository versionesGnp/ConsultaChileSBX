 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cadena~" )  TABLE(NAME=~"cod_parq~" )  TABLE(NAME=~"at_gestion~" )  TABLE(NAME=~"at_lista_gestion~" )  TABLE(NAME=~"cliente~" )  TABLE(NAME=~"cadena_mora~" ) COLUMN(NAME=~"cadena.cod_parque~") COLUMN(NAME=~"cod_parq.nombre~") COLUMN(NAME=~"at_gestion.base~") COLUMN(NAME=~"at_gestion.serie~") COLUMN(NAME=~"at_gestion.numero~") COLUMN(NAME=~"at_gestion.rut_cliente~") COLUMN(NAME=~"at_gestion.fecha_crea~") COLUMN(NAME=~"at_gestion.codigo_grupo~") COLUMN(NAME=~"at_gestion.estado_gestion~") COLUMN(NAME=~"at_gestion.usuario_asignado~") COLUMN(NAME=~"at_gestion.fecha_prox_llamada~") COLUMN(NAME=~"at_gestion.fecha_prox_visita~") COLUMN(NAME=~"at_gestion.estado_llamada~") COLUMN(NAME=~"at_gestion.estado_visita~") COLUMN(NAME=~"at_lista_gestion.codigo_grupo~") COLUMN(NAME=~"at_lista_gestion.fecha_crea~") COLUMN(NAME=~"at_lista_gestion.obervacion~") COLUMN(NAME=~"at_lista_gestion.usuario_creador~") COLUMN(NAME=~"at_lista_gestion.estado_gestion_lista~") COLUMN(NAME=~"at_lista_gestion.usuario_asignado~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COMPUTE(NAME=~"0,0,0~") COLUMN(NAME=~"cadena_mora.mora_cred~") COLUMN(NAME=~"cadena_mora.mora_mant~") COLUMN(NAME=~"cadena_mora.dias_mora_cred~") COLUMN(NAME=~"cadena_mora.dias_mora_mant~") COLUMN(NAME=~"cadena_mora.fecha_venc_cred~") COLUMN(NAME=~"cadena_mora.fecha_venc_mant~") COLUMN(NAME=~"cadena_mora.fallecidos~") COLUMN(NAME=~"cadena_mora.ctas_pag_s~") COLUMN(NAME=~"cadena_mora.plazo~") COLUMN(NAME=~"cadena_mora.total_pagado~") COLUMN(NAME=~"cadena_mora.valor_cuota~") COLUMN(NAME=~"cadena_mora.valor_cuota_mant~") COLUMN(NAME=~"cadena_mora.mora_cred_pie~") COLUMN(NAME=~"cadena_mora.dias_mora_cred_pie~") COLUMN(NAME=~"at_gestion.estado_comi~") COLUMN(NAME=~"at_gestion.tipo_gestion~") COLUMN(NAME=~"at_gestion.tipo_cobranza~")    JOIN (LEFT=~"cadena.cod_parque~"    OP =~"=~"RIGHT=~"cod_parq.codigo~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"at_gestion.serie~" )    JOIN (LEFT=~"at_gestion.codigo_grupo~"    OP =~"=~"RIGHT=~"at_lista_gestion.codigo_grupo~" )    JOIN (LEFT=~"at_gestion.base~"    OP =~"=~"RIGHT=~"cadena.codigo~" )    JOIN (LEFT=~"at_gestion.numero~"    OP =~"=~"RIGHT=~"cadena.numero~" )    JOIN (LEFT=~"at_gestion.rut_cliente~"    OP =~"=~"RIGHT=~"cliente.rut~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"cadena_mora.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"cadena_mora.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"cadena_mora.numero~" )WHERE(    EXP1 =~"~~~"AT_LISTA_GESTION~~~".~~~"CODIGO_GRUPO~~~"~"   OP =~"=~"    EXP2 =~":codigo~" ) ) ARG(NAME = ~"codigo~" TYPE = number) " arguments=(("codigo", number))  sort="at_gestion_estado_gestion A at_gestion_fecha_prox_llamada A at_gestion_fecha_prox_visita A " )
