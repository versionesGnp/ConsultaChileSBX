table(column=(type=char(1) updatewhereclause=yes name=at_gestion_base dbname="at_gestion.base" dbalias=".base" )
 column=(type=char(1) updatewhereclause=yes name=at_gestion_serie dbname="at_gestion.serie" dbalias=".serie" )
 column=(type=decimal(4) updatewhereclause=yes name=at_gestion_numero dbname="at_gestion.numero" dbalias=".numero" )
 column=(type=char(2) updatewhereclause=yes name=at_gestion_concepto dbname="at_gestion.concepto" dbalias=".concepto" )
 column=(type=decimal(4) updatewhereclause=yes name=at_gestion_monto dbname="at_gestion.monto" dbalias=".monto" )
 column=(type=decimal(4) updatewhereclause=yes name=res_comi_total_pago dbname="res_comi.total_pago" dbalias=".total_pago" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"res_comi~" )  TABLE(NAME=~"at_gestion~" ) COLUMN(NAME=~"at_gestion.base~") COLUMN(NAME=~"at_gestion.serie~") COLUMN(NAME=~"at_gestion.numero~") COLUMN(NAME=~"at_gestion.concepto~") COLUMN(NAME=~"at_gestion.monto~") COLUMN(NAME=~"res_comi.total_pago~")    JOIN (LEFT=~"res_comi.serie~"    OP =~"=~"RIGHT=~"at_gestion.serie~" )    JOIN (LEFT=~"res_comi.contrato~"    OP =~"=~"RIGHT=~"at_gestion.numero~" )    JOIN (LEFT=~"res_comi.base~"    OP =~"=~"RIGHT=~"at_gestion.base~" )WHERE(    EXP1 =~"~~~"RES_COMI~~~".~~~"COD_CONTABLE~~~"~"   OP =~"=~"    EXP2 =~"'P21'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"AT_GESTION~~~".~~~"TIPO_COBRANZA~~~"~"   OP =~"=~"    EXP2 =~"'C'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"RES_COMI~~~".~~~"FECHA~~~"~"   OP =~"=~"    EXP2 =~"to_date('24/10/2014','dd/mm/yyyy')~" ) ) " )
