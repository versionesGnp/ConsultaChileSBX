 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"at_clasifica_riesgo~" )  TABLE(NAME=~"cadena~" ) COLUMN(NAME=~"at_clasifica_riesgo.base~") COLUMN(NAME=~"at_clasifica_riesgo.serie~") COLUMN(NAME=~"at_clasifica_riesgo.numero~") COLUMN(NAME=~"at_clasifica_riesgo.jefe_venta~") COLUMN(NAME=~"at_clasifica_riesgo.fecha_crea~") COLUMN(NAME=~"at_clasifica_riesgo.op_pie~") COLUMN(NAME=~"at_clasifica_riesgo.op_justifica_renta~") COLUMN(NAME=~"at_clasifica_riesgo.op_comp_domicilio~") COLUMN(NAME=~"at_clasifica_riesgo.op_plazo~") COLUMN(NAME=~"at_clasifica_riesgo.at_tipo_vivienda~") COLUMN(NAME=~"at_clasifica_riesgo.at_automovil~") COLUMN(NAME=~"at_clasifica_riesgo.at_electrodomestico~") COLUMN(NAME=~"at_clasifica_riesgo.at_telecomunicaciones~") COLUMN(NAME=~"at_clasifica_riesgo.at_interes_cliente~") COLUMN(NAME=~"at_clasifica_riesgo.parque~") COLUMN(NAME=~"at_clasifica_riesgo.estado_titular~") COLUMN(NAME=~"at_clasifica_riesgo.plazo~") COLUMN(NAME=~"at_clasifica_riesgo.pie~") COLUMN(NAME=~"at_clasifica_riesgo.pie_pagado~") COLUMN(NAME=~"at_clasifica_riesgo.precio~") COLUMN(NAME=~"at_clasifica_riesgo.moneda~") COLUMN(NAME=~"cadena.rut~") COLUMN(NAME=~"cadena.estado~")    JOIN (LEFT=~"at_clasifica_riesgo.base~"    OP =~"=~"RIGHT=~"cadena.codigo~" )    JOIN (LEFT=~"at_clasifica_riesgo.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"at_clasifica_riesgo.numero~"    OP =~"=~"RIGHT=~"cadena.numero~" )WHERE(    EXP1 =~"to_date(~~~"AT_CLASIFICA_RIESGO~~~".~~~"FECHA_CREA~~~")~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"to_date(~~~"AT_CLASIFICA_RIESGO~~~".~~~"FECHA_CREA~~~")~"   OP =~"<=~"    EXP2 =~":fecha_fin~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = date)  ARG(NAME = ~"fecha_fin~" TYPE = date) " arguments=(("fecha_ini", date),("fecha_fin", date))  sort="parque A " )
group(level=1 header.height=0 trailer.height=0 by=("parque" ) header.color="536870912" trailer.color="536870912" )
compute(band=header alignment="2" expression="'Total Contratos Asignados a Ejecutivos en terreno entre '+string( fecha_ini ,'dd/mm/yyyy')+ ' hasta '+string( fecha_fin ,'dd/mm/yyyy')"border="0" color="0" x="73" y="16" height="68" width="2775" format="[GENERAL]"  name=compute_1  font.face="Arial" font.height="-10" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" font.underline="1" background.mode="1" background.color="553648127" )
