 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"at_gestion~" )  TABLE(NAME=~"at_lista_gestion~" )  TABLE(NAME=~"cadena_mora~" )  TABLE(NAME=~"cadena~" ) COLUMN(NAME=~"at_gestion.base~") COLUMN(NAME=~"at_gestion.serie~") COLUMN(NAME=~"at_gestion.numero~") COLUMN(NAME=~"at_gestion.rut_cliente~") COLUMN(NAME=~"at_gestion.fecha_crea~") COLUMN(NAME=~"at_gestion.codigo_grupo~") COLUMN(NAME=~"at_gestion.estado_gestion~") COLUMN(NAME=~"at_gestion.usuario_asignado~") COLUMN(NAME=~"at_gestion.fecha_prox_llamada~") COLUMN(NAME=~"at_gestion.fecha_prox_visita~") COLUMN(NAME=~"at_gestion.estado_llamada~") COLUMN(NAME=~"at_gestion.estado_visita~") COLUMN(NAME=~"cadena_mora.mora_cred~") COLUMN(NAME=~"cadena_mora.dias_mora_cred~") COLUMN(NAME=~"cadena_mora.fecha_venc_cred~") COLUMN(NAME=~"cadena_mora.mora_mant~") COLUMN(NAME=~"cadena_mora.dias_mora_mant~") COLUMN(NAME=~"cadena_mora.fecha_venc_mant~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"cadena.fecha_res~") COLUMN(NAME=~"cadena.cod_parque~")    JOIN (LEFT=~"at_gestion.codigo_grupo~"    OP =~"=~"RIGHT=~"at_lista_gestion.codigo_grupo~" )    JOIN (LEFT=~"at_gestion.base~"    OP =~"=~"RIGHT=~"cadena_mora.base~" )    JOIN (LEFT=~"at_gestion.serie~"    OP =~"=~"RIGHT=~"cadena_mora.serie~" )    JOIN (LEFT=~"at_gestion.numero~"    OP =~"=~"RIGHT=~"cadena_mora.numero~" )    JOIN (LEFT=~"at_gestion.base~"    OP =~"=~"RIGHT=~"cadena.codigo~" )    JOIN (LEFT=~"at_gestion.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"at_gestion.numero~"    OP =~"=~"RIGHT=~"cadena.numero~" )WHERE(    EXP1 =~"~~~"AT_GESTION~~~".~~~"USUARIO_ASIGNADO~~~"~"   OP =~"=~"    EXP2 =~":usuario~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"AT_GESTION~~~".~~~"ESTADO_GESTION~~~"~"   OP =~"<>~"    EXP2 =~"'A'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"AT_GESTION~~~".~~~"ESTADO_LLAMADA~~~"~"   OP =~"=~"    EXP2 =~"'S'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"AT_GESTION~~~".~~~"ESTADO_VISITA~~~"~"   OP =~"=~"    EXP2 =~"'S')~" ) ) ARG(NAME = ~"usuario~" TYPE = string)  ARG(NAME = ~"fecha_hoy~" TYPE = date) " arguments=(("usuario", string),("fecha_hoy", date))  sort="at_gestion_codigo_grupo A at_gestion_fecha_prox_visita A at_gestion_fecha_prox_llamada A " )
