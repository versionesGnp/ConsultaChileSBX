N(NAME=~"oferta_v.tot_pagado~")    JOIN (LEFT=~"at_gestion.base~"    OP =~"=~"RIGHT=~"atencion_log.base~"    OUTER1 =~"at_gestion.base~" )    JOIN (LEFT=~"at_gestion.serie~"    OP =~"=~"RIGHT=~"atencion_log.serie~"    OUTER1 =~"at_gestion.serie~" )    JOIN (LEFT=~"at_gestion.numero~"    OP =~"=~"RIGHT=~"atencion_log.numero~"    OUTER1 =~"at_gestion.numero~" )    JOIN (LEFT=~"at_gestion.base~"    OP =~"=~"RIGHT=~"tele_log.base~"    OUTER1 =~"at_gestion.base~" )    JOIN (LEFT=~"at_gestion.serie~"    OP =~"=~"RIGHT=~"tele_log.serie~"    OUTER1 =~"at_gestion.serie~" )    JOIN (LEFT=~"at_gestion.numero~"    OP =~"=~"RIGHT=~"tele_log.numero~"    OUTER1 =~"at_gestion.numero~" )    JOIN (LEFT=~"at_gestion.rut_cliente~"    OP =~"=~"RIGHT=~"cliente.rut~" )    JOIN (LEFT=~"cliente.comuna~"    OP =~"=~"RIGHT=~"comuna.codigo_comuna~" )    JOIN (LEFT=~"cliente.ciudad~"    OP =~"=~"RIGHT=~"ciudad.codigo_ciudad~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"cadena_mora.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"cadena_mora.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"cadena_mora.numero~" )    JOIN (LEFT=~"atencion_log.base~"    OP =~"=~"RIGHT=~"cadena.codigo~" )    JOIN (LEFT=~"atencion_log.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"atencion_log.numero~"    OP =~"=~"RIGHT=~"cadena.numero~" )    JOIN (LEFT=~"at_gestion.usuario_asignado~"    OP =~"=~"RIGHT=~"encargados.codigo_usuario~" )    JOIN (LEFT=~"oferta_v.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"oferta_v.nro_oferta~"    OP =~"=~"RIGHT=~"cadena.numero~" )WHERE(    EXP1 =~"~~~"AT_GESTION~~~".~~~"USUARIO_ASIGNADO~~~"~"   OP =~"=~"    EXP2 =~":usuario~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"(to_date(~~~"ATENCION_LOG~~~".~~~"FECHA~~~")~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"to_date(~~~"ATENCION_LOG~~~".~~~"FECHA~~~")~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"ATENCION_LOG~~~".~~~"USUARIO~~~"~"   OP =~"=~"    EXP2 =~":usuario)~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"(to_date(~~~"TELE_LOG~~~".~~~"FECHA~~~")~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"to_date(~~~"TELE_LOG~~~".~~~"FECHA~~~")~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"TELE_LOG~~~".~~~"USUARIO~~~"~"   OP =~"=~"    EXP2 =~":usuario)~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = date)  ARG(NAME = ~"fecha_fin~" TYPE = date)  ARG(NAME = ~"usuario~" TYPE = string) " arguments=(("fecha_ini", date),("fecha_fin", date),("usuario", string))  sort="at_gestion_base A at_gestion_numero A cadena_mora_mora_cred A " )
