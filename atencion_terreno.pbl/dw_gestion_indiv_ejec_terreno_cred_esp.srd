s marca~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"tipo_via.descripcion~") COLUMN(NAME=~"comuna.comuna~") COLUMN(NAME=~"oferta_v.fecha~") COLUMN(NAME=~"oferta_v.tot_pagado~") COLUMN(NAME=~"cadena_mora.fallecidos~") COLUMN(NAME=~"pago_oferta.area~") COLUMN(NAME=~"pago_oferta.sector~") COLUMN(NAME=~"pago_oferta.sepultura~") COLUMN(NAME=~"pago_oferta.capacidad~") COLUMN(NAME=~"cliente.estado_titular~") COLUMN(NAME=~"ciudad.sigla_ciudad~") COLUMN(NAME=~"cliente.ult_clasificacion_envio_carta~") COMPUTE(NAME=~"0 as ing_caja~") COLUMN(NAME=~"at_gestion.estado_comi~") COLUMN(NAME=~"at_gestion.concepto~") COMPUTE(NAME=~"'' as existe_pago~") COMPUTE(NAME=~"(SELECT DISTINCT ~~~"TELE_LOG~~~".~~~"ESTADO~~~" FROM ~~~"TELE_LOG~~~" WHERE ~~~"TELE_LOG~~~".~~~"RUT~~~" = ~~~"AT_GESTION~~~".~~~"RUT_CLIENTE~~~" AND ~~~"TELE_LOG~~~".~~~"FECHA~~~" = (SELECT MAX(~~~"TELE_LOG~~~".~~~"FECHA~~~") FROM ~~~"TELE_LOG~~~" WHERE ~~~"TELE_LOG~~~".~~~"RUT~~~" = ~~~"AT_GESTION~~~".~~~"RUT_CLIENTE~~~" )) as estado_tele_log~") COMPUTE(NAME=~"(SELECT MAX(~~~"TELE_LOG~~~".~~~"FECHA~~~") FROM ~~~"TELE_LOG~~~" WHERE ~~~"TELE_LOG~~~".~~~"RUT~~~" = ~~~"AT_GESTION~~~".~~~"RUT_CLIENTE~~~" AND ~~~"TELE_LOG~~~".~~~"USUARIO~~~" = ~~~"AT_GESTION~~~".~~~"USUARIO_ASIGNADO~~~" AND ~~~"TELE_LOG~~~".~~~"FECHA~~~" >= ~~~"AT_GESTION~~~".~~~"FECHA_CREA~~~" ) as fecha_llamado~") COLUMN(NAME=~"at_gestion.fec_compromiso~") COMPUTE(NAME=~"(SELECT DISTINCT ~~~"ATENCION_LOG~~~".~~~"ESTADO~~~" FROM ~~~"ATENCION_LOG~~~" WHERE ~~~"ATENCION_LOG~~~".~~~"RUT~~~" = ~~~"AT_GESTION~~~".~~~"RUT_CLIENTE~~~" AND ~~~"ATENCION_LOG~~~".~~~"FECHA~~~" = (SELECT MAX(~~~"ATENCION_LOG~~~".~~~"FECHA~~~") FROM ~~~"ATENCION_LOG~~~" WHERE ~~~"ATENCION_LOG~~~".~~~"RUT~~~" = ~~~"AT_GESTION~~~".~~~"RUT_CLIENTE~~~" )) as estado_aten_log~") COMPUTE(NAME=~"(SELECT MAX(~~~"ATENCION_LOG~~~".~~~"FECHA~~~") FROM ~~~"ATENCION_LOG~~~" WHERE ~~~"ATENCION_LOG~~~".~~~"RUT~~~" = ~~~"AT_GESTION~~~".~~~"RUT_CLIENTE~~~" AND ~~~"ATENCION_LOG~~~".~~~"USUARIO~~~" = ~~~"AT_GESTION~~~".~~~"USUARIO_ASIGNADO~~~" AND ~~~"ATENCION_LOG~~~".~~~"FECHA~~~" >= ~~~"AT_GESTION~~~".~~~"FECHA_CREA~~~" ) as fecha_atencion~")    JOIN (LEFT=~"at_gestion.serie~"    OP =~"=~"RIGHT=~"oferta_v.serie~" )    JOIN (LEFT=~"at_gestion.numero~"    OP =~"=~"RIGHT=~"oferta_v.nro_oferta~" )    JOIN (LEFT=~"at_gestion.codigo_grupo~"    OP =~"=~"RIGHT=~"at_lista_gestion.codigo_grupo~" )    JOIN (LEFT=~"at_gestion.base~"    OP =~"=~"RIGHT=~"cadena_mora.base~" )    JOIN (LEFT=~"at_gestion.serie~"    OP =~"=~"RIGHT=~"cadena_mora.serie~" )    JOIN (LEFT=~"at_gestion.numero~"    OP =~"=~"RIGHT=~"cadena_mora.numero~" )    JOIN (LEFT=~"at_gestion.base~"    OP =~"=~"RIGHT=~"cadena.codigo~" )    JOIN (LEFT=~"at_gestion.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"at_gestion.numero~"    OP =~"=~"RIGHT=~"cadena.numero~" )    JOIN (LEFT=~"at_gestion.rut_cliente~"    OP =~"=~"RIGHT=~"cliente.rut~" )    JOIN (LEFT=~"cliente.tipo_via~"    OP =~"=~"RIGHT=~"tipo_via.tipo_via~" )    JOIN (LEFT=~"cliente.ciudad~"    OP =~"=~"RIGHT=~"ciudad.codigo_ciudad~" )    JOIN (LEFT=~"cliente.comuna~"    OP =~"=~"RIGHT=~"comuna.codigo_comuna~" )    JOIN (LEFT=~"oferta_v.serie~"    OP =~"=~"RIGHT=~"pago_oferta.serie~" )    JOIN (LEFT=~"oferta_v.nro_oferta~"    OP =~"=~"RIGHT=~"pago_oferta.nro_oferta~" )    JOIN (LEFT=~"oferta_v.ult_folio~"    OP =~"=~"RIGHT=~"pago_oferta.folio~" )WHERE(    EXP1 =~"~~~"AT_GESTION~~~".~~~"USUARIO_ASIGNADO~~~"~"   OP =~"=~"    EXP2 =~":usuario~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"AT_GESTION~~~".~~~"ESTADO_COMI~~~"~"   OP =~"=~"    EXP2 =~"'N'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"AT_GESTION~~~".~~~"TIPO_COBRANZA~~~"~"   OP =~"=~"    EXP2 =~"'E'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"AT_GESTION~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~"'O'~" ) ) ARG(NAME = ~"usuario~" TYPE = string)  ARG(NAME = ~"fecha_hoy~" TYPE = date) " arguments=(("usuario", string),("fecha_hoy", date))  sort="at_gestion_numero A at_gestion_codigo_grupo A at_ges