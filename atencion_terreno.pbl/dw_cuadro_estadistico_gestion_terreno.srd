table(column=(type=datetime updatewhereclause=yes name=compute_0015 dbname="compute_0015" )
 column=(type=number updatewhereclause=yes name=estado dbname="estado" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"at_gestion~" )  TABLE(NAME=~"tele_log~" )  TABLE(NAME=~"encargados~" ALIAS=~"encargados_a~" )  TABLE(NAME=~"encargados~" ALIAS=~"encargados_b~" ) COLUMN(NAME=~"at_gestion.base~") COLUMN(NAME=~"at_gestion.serie~") COLUMN(NAME=~"at_gestion.numero~") COLUMN(NAME=~"at_gestion.rut_cliente~") COLUMN(NAME=~"tele_log.fecha~") COLUMN(NAME=~"at_gestion.codigo_grupo~") COLUMN(NAME=~"at_gestion.estado_gestion~") COLUMN(NAME=~"tele_log.usuario~") COLUMN(NAME=~"at_gestion.fecha_prox_llamada~") COLUMN(NAME=~"at_gestion.fecha_prox_visita~") COLUMN(NAME=~"at_gestion.estado_llamada~") COLUMN(NAME=~"at_gestion.estado_visita~") COLUMN(NAME=~"tele_log.estado~") COMPUTE(NAME=~"to_date(~~~"TELE_LOG~~~".~~~"FECHA~~~"),TO_NUMBER(~~~"TELE_LOG~~~".~~~"ESTADO~~~")~")    JOIN (LEFT=~"at_gestion.base~"    OP =~"=~"RIGHT=~"tele_log.base~" )    JOIN (LEFT=~"at_gestion.serie~"    OP =~"=~"RIGHT=~"tele_log.serie~" )    JOIN (LEFT=~"at_gestion.numero~"    OP =~"=~"RIGHT=~"tele_log.numero~" )    JOIN (LEFT=~"tele_log.usuario~"    OP =~"=~"RIGHT=~"encargados_a.codigo_usuario~" )    JOIN (LEFT=~"tele_log.usuario~"    OP =~"=~"RIGHT=~"encargados_b.codigo_usuario~" )WHERE(    EXP1 =~"to_date(~~~"TELE_LOG~~~".~~~"FECHA~~~")~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"to_date(~~~"TELE_LOG~~~".~~~"FECHA~~~")~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"TELE_LOG~~~".~~~"USUARIO~~~"~"   OP =~"like~"    EXP2 =~":usuario~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"ENCARGADOS_A~~~".~~~"DEPTO~~~"~"   OP =~"=~"    EXP2 =~"'E'~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = date)  ARG(NAME = ~"fecha_fin~" TYPE = date)  ARG(NAME = ~"usuario~" TYPE = string) " arguments=(("fecha_ini", date),("fecha_fin", date),("usuario", string))  sort="compute_0015 A " )
