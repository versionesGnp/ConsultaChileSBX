liente.lat_geo~") COLUMN(NAME=~"cliente.lon_geo~") COLUMN(NAME=~"cliente.status_geo~") COLUMN(NAME=~"cliente.tipo_via~") COMPUTE(NAME=~"0~") COLUMN(NAME=~"oferta_v.uso~")    JOIN (LEFT=~"at_gestion.serie~"    OP =~"=~"RIGHT=~"oferta_v.serie~"    OUTER1 =~"at_gestion.serie~" )    JOIN (LEFT=~"at_gestion.numero~"    OP =~"=~"RIGHT=~"oferta_v.nro_oferta~"    OUTER1 =~"at_gestion.numero~" )    JOIN (LEFT=~"at_gestion.rut_cliente~"    OP =~"=~"RIGHT=~"cliente.rut~" )    JOIN (LEFT=~"cliente.comuna~"    OP =~"=~"RIGHT=~"comuna.codigo_comuna~" )    JOIN (LEFT=~"cliente.ciudad~"    OP =~"=~"RIGHT=~"ciudad.codigo_ciudad~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"cadena_mora.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"cadena_mora.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"cadena_mora.numero~" )    JOIN (LEFT=~"at_gestion.base~"    OP =~"=~"RIGHT=~"cadena.codigo~" )    JOIN (LEFT=~"at_gestion.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"at_gestion.numero~"    OP =~"=~"RIGHT=~"cadena.numero~" )    JOIN (LEFT=~"at_gestion.codigo_grupo~"    OP =~"=~"RIGHT=~"at_lista_gestion.codigo_grupo~" )WHERE(    EXP1 =~"to_date(~~~"AT_GESTION~~~".~~~"FECHA_PROX_VISITA~~~")~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"to_date(~~~"AT_GESTION~~~".~~~"FECHA_PROX_VISITA~~~")~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"AT_GESTION~~~".~~~"USUARIO_ASIGNADO~~~"~"   OP =~"like~"    EXP2 =~":usuario~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"AT_LISTA_GESTION~~~".~~~"ESTADO_GESTION_LISTA~~~"~"   OP =~"<>~"    EXP2 =~"'G'~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = date)  ARG(NAME = ~"fecha_fin~" TYPE = date)  ARG(NAME = ~"usuario~" TYPE = string)  ARG(NAME = ~"fecha_hoy~" TYPE = date) " arguments=(("fecha_ini", date),("fecha_fin", date),("usuario", string),("fecha_hoy", date))  sort="at_gestion_fecha_prox_visita A at_gestion_numero A " )
