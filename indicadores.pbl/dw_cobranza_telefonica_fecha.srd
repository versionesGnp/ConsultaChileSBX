 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"tele_log~" )  TABLE(NAME=~"estado_cobranza~" )  TABLE(NAME=~"cadena~" ) COLUMN(NAME=~"tele_log.rut~") COLUMN(NAME=~"estado_cobranza.glosa_estado~") COLUMN(NAME=~"tele_log.fecha~") COLUMN(NAME=~"tele_log.glosa~") COLUMN(NAME=~"tele_log.usuario~") COLUMN(NAME=~"estado_cobranza.cod_esatdo~") COLUMN(NAME=~"tele_log.base~") COLUMN(NAME=~"tele_log.serie~") COLUMN(NAME=~"tele_log.numero~") COLUMN(NAME=~"cadena.cod_parque~") COLUMN(NAME=~"cadena.estado~")    JOIN (LEFT=~"tele_log.estado~"    OP =~"=~"RIGHT=~"estado_cobranza.cod_esatdo~" )    JOIN (LEFT=~"tele_log.base~"    OP =~"=~"RIGHT=~"cadena.codigo~" )    JOIN (LEFT=~"tele_log.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"tele_log.numero~"    OP =~"=~"RIGHT=~"cadena.numero~" )WHERE(    EXP1 =~"( ( ~~~"TELE_LOG~~~".~~~"FECHA~~~"~"   OP =~">=~"    EXP2 =~":fecha1 )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"TELE_LOG~~~".~~~"FECHA~~~"~"   OP =~"<=~"    EXP2 =~":fecha2 ) )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"TELE_LOG~~~".~~~"ESTADO~~~"~"   OP =~">~"    EXP2 =~"'0'~" ) ) ORDER(NAME=~"estado_cobranza.cod_esatdo~" ASC=yes ) ARG(NAME = ~"fecha1~" TYPE = date)  ARG(NAME = ~"fecha2~" TYPE = date) " arguments=(("fecha1", date),("fecha2", date))  sort="tele_log_fecha A tele_log_numero A cadena_cod_parque A " )
