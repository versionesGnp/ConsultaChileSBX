E(    EXP1 =~"~~~"FACTURA_OFERTA~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~"'O'~" ) ) ARG(NAME = ~"fecha1~" TYPE = date)  ARG(NAME = ~"fecha2~" TYPE = date) " update="FACTURA_OFERTA" updatewhere=1 updatekeyinplace=no arguments=(("fecha1", date),("fecha2", date))  sort="fecha_cierre A " )
