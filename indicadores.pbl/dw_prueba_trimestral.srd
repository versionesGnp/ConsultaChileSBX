 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"factura_oferta~" ) COLUMN(NAME=~"factura_oferta.serie~") COLUMN(NAME=~"factura_oferta.saldo_total~") COLUMN(NAME=~"factura_oferta.capital~") COLUMN(NAME=~"factura_oferta.interes~") COLUMN(NAME=~"factura_oferta.gc~") COLUMN(NAME=~"factura_oferta.facturado~") COLUMN(NAME=~"factura_oferta.fecha_cierre~") COLUMN(NAME=~"factura_oferta.estado~")WHERE(    EXP1 =~"~~~"FACTURA_OFERTA~~~".~~~"FECHA_CIERRE~~~"~"   OP =~">=~"    EXP2 =~"TO_DATE('01-Jan-1999 00:00:00','DD-MON-YYYY HH24:MI:SS')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FACTURA_OFERTA~~~".~~~"FECHA_CIERRE~~~"~"   OP =~"<=~"    EXP2 =~"TO_DATE('31-Mar-1999 00:00:00','DD-MON-YYYY HH24:MI:SS')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"FACTURA_OFERTA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'N'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"FACTURA_OFERTA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'R')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FACTURA_OFERTA~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~"'O'~" ) )    UNION (PBSELECT( VERSION(400) TABLE(NAME=~"factura_oferta~" ) COLUMN(NAME=~"factura_oferta.serie~") COLUMN(NAME=~"factura_oferta.saldo_total~") COLUMN(NAME=~"factura_oferta.capital~") COLUMN(NAME=~"factura_oferta.interes~") COLUMN(NAME=~"factura_oferta.gc~") COLUMN(NAME=~"factura_oferta.facturado~") COLUMN(NAME=~"factura_oferta.fecha_cierre~") COLUMN(NAME=~"factura_oferta.estado~")WHERE(    EXP1 =~"~~~"FACTURA_OFERTA~~~".~~~"FECHA_CIERRE~~~"~"   OP =~">=~"    EXP2 =~"TO_DATE('01-Jan-2000 00:00:00','DD-MON-YYYY HH24:MI:SS')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FACTURA_OFERTA~~~".~~~"FECHA_CIERRE~~~"~"   OP =~"<=~"    EXP2 =~"TO_DATE('31-Mar-2000 00:00:00','DD-MON-YYYY HH24:MI:SS')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"FACTURA_OFERTA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'N'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"FACTURA_OFERTA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'R')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FACTURA_OFERTA~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~"'O'~" ) )) "  sort="fecha_cierre A " )
