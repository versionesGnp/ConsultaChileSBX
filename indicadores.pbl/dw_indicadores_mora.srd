 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"factura_oferta~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"oferta_v~" )  TABLE(NAME=~"pago_oferta~" ) COLUMN(NAME=~"factura_oferta.base~") COLUMN(NAME=~"factura_oferta.serie~") COLUMN(NAME=~"factura_oferta.numero~") COLUMN(NAME=~"factura_oferta.plazo~") COMPUTE(NAME=~"0~") COLUMN(NAME=~"oferta_v.cta_pag_s~") COLUMN(NAME=~"pago_oferta.fecha_prim~")    JOIN (LEFT=~"factura_oferta.serie~"    OP =~"=~"RIGHT=~"oferta_v.serie~" )    JOIN (LEFT=~"oferta_v.nro_oferta~"    OP =~"=~"RIGHT=~"factura_oferta.numero~" )    JOIN (LEFT=~"oferta_v.serie~"    OP =~"=~"RIGHT=~"pago_oferta.serie~" )    JOIN (LEFT=~"oferta_v.nro_oferta~"    OP =~"=~"RIGHT=~"pago_oferta.nro_oferta~" )    JOIN (LEFT=~"oferta_v.ult_folio~"    OP =~"=~"RIGHT=~"pago_oferta.folio~" )    JOIN (LEFT=~"pago_oferta.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"pago_oferta.nro_oferta~"    OP =~"=~"RIGHT=~"cadena.numero~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"factura_oferta.base~" )WHERE(    EXP1 =~"~~~"FACTURA_OFERTA~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~"'O'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"FACTURA_OFERTA~~~".~~~"FECHA_CIERRE~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FACTURA_OFERTA~~~".~~~"FECHA_CIERRE~~~"~"   OP =~"<=~"    EXP2 =~":fecha_term)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"FACTURA_OFERTA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'N')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'V'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FACTURA_OFERTA~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = date)  ARG(NAME = ~"fecha_term~" TYPE = date)  ARG(NAME = ~"parque~" TYPE = number) " arguments=(("fecha_ini", date),("fecha_term", date),("parque", number)) )
