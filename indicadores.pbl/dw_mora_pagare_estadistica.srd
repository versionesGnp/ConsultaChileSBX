 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"factura_pagare~" ) COLUMN(NAME=~"factura_pagare.base~") COLUMN(NAME=~"factura_pagare.serie~") COLUMN(NAME=~"factura_pagare.numero~") COLUMN(NAME=~"factura_pagare.fec_ofe~") COLUMN(NAME=~"factura_pagare.mora~") COLUMN(NAME=~"factura_pagare.monto_mora~") COLUMN(NAME=~"factura_pagare.valor_cta~") COLUMN(NAME=~"factura_pagare.saldo_total~") COLUMN(NAME=~"factura_pagare.saldo_cp~") COLUMN(NAME=~"factura_pagare.saldo_lp~") COLUMN(NAME=~"factura_pagare.capital~") COLUMN(NAME=~"factura_pagare.capital_cp~") COLUMN(NAME=~"factura_pagare.capital_lp~") COLUMN(NAME=~"factura_pagare.interes~") COLUMN(NAME=~"factura_pagare.interes_cp~") COLUMN(NAME=~"factura_pagare.interes_lp~") COLUMN(NAME=~"factura_pagare.gc~") COLUMN(NAME=~"factura_pagare.gc_cp~") COLUMN(NAME=~"factura_pagare.gc_lp~") COLUMN(NAME=~"factura_pagare.fecha_cierre~")WHERE(    EXP1 =~"( ~~~"FACTURA_PAGARE~~~".~~~"MORA~~~"~"   OP =~">~"    EXP2 =~"-1 )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(( ~~~"FACTURA_PAGARE~~~".~~~"FECHA_CIERRE~~~"~"   OP =~">=~"    EXP2 =~":fecha )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"FACTURA_PAGARE~~~".~~~"FECHA_CIERRE~~~"~"   OP =~"<=~"    EXP2 =~":fecha1 ))~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"FACTURA_PAGARE~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~"'P' )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"FACTURA_PAGARE~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'S'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"FACTURA_PAGARE~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'R')~" ) ) ORDER(NAME=~"factura_pagare.fecha_cierre~" ASC=yes ) ARG(NAME = ~"fecha~" TYPE = date)  ARG(NAME = ~"fecha1~" TYPE = date) " arguments=(("fecha", date),("fecha1", date))  sort="fecha_cierre A " )
