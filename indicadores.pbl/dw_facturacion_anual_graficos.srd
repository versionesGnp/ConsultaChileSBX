E(    EXP1 =~"~~~"FACTURA_OFERTA~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~"'O'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FACTURA_OFERTA~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~" ) ) ARG(NAME = ~"fecha1~" TYPE = date)  ARG(NAME = ~"fecha2~" TYPE = date)  ARG(NAME = ~"parque~" TYPE = number) " update="FACTURA_OFERTA" updatewhere=1 updatekeyinplace=no arguments=(("fecha1", date),("fecha2", date),("parque", number))  sort="fecha_cierre A " )
