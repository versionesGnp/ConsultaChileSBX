 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cliente~" )  TABLE(NAME=~"oferta_v~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"pago_oferta~" ) COLUMN(NAME=~"cliente.total_rent~") COLUMN(NAME=~"oferta_v.fecha~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"cadena.serie~") COLUMN(NAME=~"cadena.numero~") COLUMN(NAME=~"cliente.fecha_nac~") COLUMN(NAME=~"cadena.rut~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"oferta_v.cod_age~") COLUMN(NAME=~"oferta_v.cod_sup~") COLUMN(NAME=~"oferta_v.cod_jef~") COLUMN(NAME=~"pago_oferta.fecha_prim~") COLUMN(NAME=~"pago_oferta.nro_cuotas~") COLUMN(NAME=~"oferta_v.cta_pag_s~") COMPUTE(NAME=~"0~")    JOIN (LEFT=~"oferta_v.serie~"    OP =~"=~"RIGHT=~"pago_oferta.serie~" )    JOIN (LEFT=~"oferta_v.nro_oferta~"    OP =~"=~"RIGHT=~"pago_oferta.nro_oferta~" )    JOIN (LEFT=~"oferta_v.ult_folio~"    OP =~"=~"RIGHT=~"pago_oferta.folio~" )    JOIN (LEFT=~"oferta_v.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"oferta_v.nro_oferta~"    OP =~"=~"RIGHT=~"cadena.numero~" )    JOIN (LEFT=~"cliente.rut~"    OP =~"=~"RIGHT=~"oferta_v.rut~" )WHERE(    EXP1 =~"(~~~"OFERTA_V~~~".~~~"FECHA~~~"~"   OP =~">=~"    EXP2 =~":fec_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"OFERTA_V~~~".~~~"FECHA~~~"~"   OP =~"<=~"    EXP2 =~":fec_fin)~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"(~~~"CLIENTE~~~".~~~"RUT~~~"~"   OP =~"<~"    EXP2 =~"40000000)~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"(~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'O')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"CADENA~~~".~~~"ESTADO~~~"~"   OP =~"like~"    EXP2 =~":estado)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":PARQUE~" ) ) ARG(NAME = ~"fec_ini~" TYPE = date)  ARG(NAME = ~"fec_fin~" TYPE = date)  ARG(NAME = ~"estado~" TYPE = string)  ARG(NAME = ~"PARQUE~" TYPE = number) " arguments=(("fec_ini", date),("fec_fin", date),("estado", string),("PARQUE", number))  sort="oferta_v_fecha A " )
