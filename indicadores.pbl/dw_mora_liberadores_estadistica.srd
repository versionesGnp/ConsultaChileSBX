 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"factura_oferta~" ) COLUMN(NAME=~"factura_oferta.base~") COLUMN(NAME=~"factura_oferta.serie~") COLUMN(NAME=~"factura_oferta.numero~") COLUMN(NAME=~"factura_oferta.fec_ofe~") COLUMN(NAME=~"factura_oferta.mora~") COLUMN(NAME=~"factura_oferta.monto_mora~") COLUMN(NAME=~"factura_oferta.valor_cta~") COLUMN(NAME=~"factura_oferta.saldo_total~") COLUMN(NAME=~"factura_oferta.saldo_cp~") COLUMN(NAME=~"factura_oferta.saldo_lp~") COLUMN(NAME=~"factura_oferta.capital~") COLUMN(NAME=~"factura_oferta.capital_cp~") COLUMN(NAME=~"factura_oferta.capital_lp~") COLUMN(NAME=~"factura_oferta.interes~") COLUMN(NAME=~"factura_oferta.interes_cp~") COLUMN(NAME=~"factura_oferta.interes_lp~") COLUMN(NAME=~"factura_oferta.gc~") COLUMN(NAME=~"factura_oferta.gc_cp~") COLUMN(NAME=~"factura_oferta.gc_lp~") COLUMN(NAME=~"factura_oferta.fecha_cierre~")WHERE(    EXP1 =~"( ~~~"FACTURA_OFERTA~~~".~~~"MORA~~~"~"   OP =~">~"    EXP2 =~"-1 )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(( ~~~"FACTURA_OFERTA~~~".~~~"FECHA_CIERRE~~~"~"   OP =~">=~"    EXP2 =~":fecha )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"FACTURA_OFERTA~~~".~~~"FECHA_CIERRE~~~"~"   OP =~"<=~"    EXP2 =~":fecha1 ))~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"FACTURA_OFERTA~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~"'L' )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"FACTURA_OFERTA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'N'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"FACTURA_OFERTA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'S')~" ) ) ORDER(NAME=~"factura_oferta.fecha_cierre~" ASC=yes ) ARG(NAME = ~"fecha~" TYPE = date)  ARG(NAME = ~"fecha1~" TYPE = date) " arguments=(("fecha", date),("fecha1", date)) )
