global type funcion_mora_mant from function_object
end type

forward prototypes
global function double funcion_mora_mant (datetime primer, double pag, double cuotas)
end prototypes

global function double funcion_mora_mant (datetime primer, double pag, double cuotas);
double vmes,vano,vcuo_venc,vmora
		  	  
  	  	vano=year(today())-year(DATE(primer))
		vano=vano*12	 
 		vmes=month(today())-month(DATE(primer))
		
		vcuo_venc= vano+vmes
		
			if (day(today())> day(DATE(Primer)))  then
				vcuo_venc=vcuo_venc+1
			end if
		
			if vcuo_venc <0 then
				vcuo_venc=0
			end if
	 		
			if vcuo_venc> cuotas then
				vcuo_venc=cuotas
			end if
			
	 		vmora=  vcuo_venc - pag
			 
	 		IF vmora <= 0 then 
				vmora=0
			end if
			 
	 	 	 

return(vmora)



               

end function

