global type f_ddlb_all_año from function_object
end type

forward prototypes
global function integer f_ddlb_all_año (ref dropdownlistbox ddlb_param, string select_string, integer codigo_param)
end prototypes

global function integer f_ddlb_all_año (ref dropdownlistbox ddlb_param, string select_string, integer codigo_param);STRING dato_1,dato_2,ls_item,ls_item_buscado
INT li_pos,año

PREPARE sqlsa FROM :select_string;
DECLARE dyn_cursor DYNAMIC CURSOR FOR sqlsa;
OPEN DYNAMIC dyn_cursor;  

IF sqlca.sqlcode < 0 THEN
	MessageBox(gs_app_name,"DataBase Error!.~n~n"+sqlca.sqlerrtext+".~n~nf_ddlb_all()")
	Return -1
END IF

ddlb_param.SetRedraw(FALSE)
ddlb_param.Reset( )

Do While sqlca.sqlcode = 0
	Fetch dyn_cursor into :año;
	If sqlca.sqlcode = 0 Then
		IF not isnull(año) THEN
			ls_item = RightTrim(string(año))
			ddlb_param.AddItem(ls_item)
			dato_1 = string(codigo_param)
			dato_2 = RightTrim(string(año))
			If dato_1 = dato_2 Then
				ls_item_buscado = string(ls_item)
			End If
		END IF
	ElseIf sqlca.sqlcode < 0 Then
		MessageBox(gs_app_name,"DataBase Error!.~n~n"+sqlca.sqlerrtext+".~n~nf_ddlb_all()")
		Return -1
	Else
		Exit
	End If
Loop
ddlb_param.SetRedraw(TRUE)
li_pos = ddlb_param.FindItem(ls_item_buscado, 0)

Close dyn_cursor;
Return li_pos
end function

