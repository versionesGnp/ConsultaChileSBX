 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"carta_log~" )  TABLE(NAME=~"proceso_carta~" )  TABLE(NAME=~"tab_uf~" ) COLUMN(NAME=~"carta_log.base~") COLUMN(NAME=~"carta_log.serie~") COLUMN(NAME=~"carta_log.numero~") COLUMN(NAME=~"carta_log.rut~") COLUMN(NAME=~"carta_log.mora~") COLUMN(NAME=~"carta_log.mora_mant~") COLUMN(NAME=~"tab_uf.valor_uf~") COMPUTE(NAME=~"0~") COMPUTE(NAME=~"0~") COMPUTE(NAME=~"0~") COMPUTE(NAME=~"0~") COMPUTE(NAME=~"0~") COMPUTE(NAME=~"0~") COMPUTE(NAME=~"0~") COMPUTE(NAME=~"0~") COLUMN(NAME=~"proceso_carta.fecha~") COMPUTE(NAME=~"''~") COMPUTE(NAME=~"''~") COMPUTE(NAME=~"0~") COMPUTE(NAME=~"0~") COMPUTE(NAME=~"0~") COMPUTE(NAME=~"0~") COMPUTE(NAME=~"0~")    JOIN (LEFT=~"carta_log.cod_accion~"    OP =~"=~"RIGHT=~"proceso_carta.cod_accion~" )    JOIN (LEFT=~"carta_log.fecha_carta~"    OP =~"=~"RIGHT=~"proceso_carta.fecha~" )    JOIN (LEFT=~"carta_log.clasificacion~"    OP =~"=~"RIGHT=~"proceso_carta.clasificacion~" )WHERE(    EXP1 =~"~~~"CARTA_LOG~~~".~~~"COD_ACCION~~~"~"   OP =~"=~"    EXP2 =~":cod_accion~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CARTA_LOG~~~".~~~"CLASIFICACION~~~"~"   OP =~"=~"    EXP2 =~":clasificacion~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"TAB_UF~~~".~~~"FECHA_UF~~~"~"   OP =~"=~"    EXP2 =~":fecha~" ) ) ORDER(NAME=~"carta_log.rut~" ASC=yes ) ARG(NAME = ~"cod_accion~" TYPE = string)  ARG(NAME = ~"clasificacion~" TYPE = string)  ARG(NAME = ~"fecha_fact~" TYPE = date)  ARG(NAME = ~"fecha~" TYPE = date) " arguments=(("cod_accion", string),("clasificacion", string),("fecha_fact", date),("fecha", date))  sort="proceso_carta_fecha A " )
