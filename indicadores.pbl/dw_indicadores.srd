 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"factura_oferta~" )  TABLE(NAME=~"cadena~" ) COLUMN(NAME=~"factura_oferta.base~") COLUMN(NAME=~"factura_oferta.serie~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"factura_oferta.numero~") COLUMN(NAME=~"factura_oferta.cod_parque~")    JOIN (LEFT=~"factura_oferta.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"factura_oferta.numero~" )    JOIN (LEFT=~"factura_oferta.base~"    OP =~"=~"RIGHT=~"cadena.codigo~" )WHERE(    EXP1 =~"~~~"FACTURA_OFERTA~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~"'O'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"FACTURA_OFERTA~~~".~~~"FECHA_CIERRE~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FACTURA_OFERTA~~~".~~~"FECHA_CIERRE~~~"~"   OP =~"<=~"    EXP2 =~":fecha_term)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FACTURA_OFERTA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'N'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FACTURA_OFERTA~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~" ) ) ORDER(NAME=~"cadena.estado~" ASC=yes ) ARG(NAME = ~"fecha_ini~" TYPE = date)  ARG(NAME = ~"fecha_term~" TYPE = date)  ARG(NAME = ~"parque~" TYPE = number) " arguments=(("fecha_ini", date),("fecha_term", date),("parque", number)) )
