 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"atencion_log~" )  TABLE(NAME=~"estado_atencion~" )  TABLE(NAME=~"cadena~" ) COLUMN(NAME=~"atencion_log.rut~") COLUMN(NAME=~"estado_atencion.glosa_estado~") COLUMN(NAME=~"atencion_log.fecha~") COLUMN(NAME=~"atencion_log.glosa~") COLUMN(NAME=~"atencion_log.usuario~") COLUMN(NAME=~"atencion_log.base~") COLUMN(NAME=~"atencion_log.serie~") COLUMN(NAME=~"atencion_log.numero~") COLUMN(NAME=~"estado_atencion.cod_esatdo~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"cadena.cod_parque~")    JOIN (LEFT=~"atencion_log.estado~"    OP =~"=~"RIGHT=~"estado_atencion.cod_esatdo~" )    JOIN (LEFT=~"atencion_log.base~"    OP =~"=~"RIGHT=~"cadena.codigo~" )    JOIN (LEFT=~"atencion_log.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"atencion_log.numero~"    OP =~"=~"RIGHT=~"cadena.numero~" )WHERE(    EXP1 =~"~~~"ATENCION_LOG~~~".~~~"FECHA~~~"~"   OP =~">=~"    EXP2 =~":fecha1~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"ATENCION_LOG~~~".~~~"FECHA~~~"~"   OP =~"<=~"    EXP2 =~":fecha2~" ) ) ORDER(NAME=~"estado_atencion.cod_esatdo~" ASC=yes ) ARG(NAME = ~"fecha1~" TYPE = date)  ARG(NAME = ~"fecha2~" TYPE = date) " arguments=(("fecha1", date),("fecha2", date))  sort="atencion_log_fecha A cadena_cod_parque A atencion_log_numero A " )
