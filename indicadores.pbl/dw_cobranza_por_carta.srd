 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"carta_accion~" )  TABLE(NAME=~"carta_log~" )  TABLE(NAME=~"carta_producto~" )  TABLE(NAME=~"cadena~" ) COLUMN(NAME=~"carta_log.rut~") COLUMN(NAME=~"carta_log.fecha_carta~") COLUMN(NAME=~"carta_log.base~") COLUMN(NAME=~"carta_log.serie~") COLUMN(NAME=~"carta_log.numero~") COLUMN(NAME=~"carta_log.mora~") COLUMN(NAME=~"carta_producto.glosa~") COLUMN(NAME=~"carta_accion.glosa~") COLUMN(NAME=~"carta_producto.estado~") COLUMN(NAME=~"carta_accion.estado~") COLUMN(NAME=~"carta_log.cod_envio~") COLUMN(NAME=~"carta_log.estado_env~") COLUMN(NAME=~"carta_log.cod_accion~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"cadena.cod_parque~") COLUMN(NAME=~"carta_log.clasificacion~")    JOIN (LEFT=~"carta_log.cod_accion~"    OP =~"=~"RIGHT=~"carta_accion.estado~" )    JOIN (LEFT=~"carta_log.cod_envio~"    OP =~"=~"RIGHT=~"carta_producto.estado~" )    JOIN (LEFT=~"carta_log.base~"    OP =~"=~"RIGHT=~"cadena.codigo~" )    JOIN (LEFT=~"carta_log.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"carta_log.numero~"    OP =~"=~"RIGHT=~"cadena.numero~" )WHERE(    EXP1 =~"~~~"CARTA_LOG~~~".~~~"FECHA_CARTA~~~"~"   OP =~">=~"    EXP2 =~":fecha1~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CARTA_LOG~~~".~~~"FECHA_CARTA~~~"~"   OP =~"<=~"    EXP2 =~":fecha2 ~" ) ) ARG(NAME = ~"fecha1~" TYPE = date)  ARG(NAME = ~"fecha2~" TYPE = date) " arguments=(("fecha1", date),("fecha2", date))  sort="carta_log_fecha_carta A cadena_cod_parque A carta_log_numero A " )
