global type f_ddlb_all_mes from function_object
end type

forward prototypes
global function integer f_ddlb_all_mes (ref dropdownlistbox ddlb_param, string select_string, string codigo_param)
end prototypes

global function integer f_ddlb_all_mes (ref dropdownlistbox ddlb_param, string select_string, string codigo_param);
STRING ls_codigo,ls_nombre, ls_item_buscado,ls_item,año

//"SELECT codigo,descripcion FROM tabla "

STRING Blancos,Ceros
INT li_pos //posición buscada

Blancos	= Space(180)
Ceros		= "0000000000"

PREPARE sqlsa FROM :select_string;
DECLARE dyn_cursor DYNAMIC CURSOR FOR sqlsa;
OPEN DYNAMIC dyn_cursor;  

IF sqlca.sqlcode < 0 THEN
	MessageBox(gs_app_name,"DataBase Error!.~n~n"+sqlca.sqlerrtext+".~n~nf_ddlb_all()")
	Return -1
END IF

ddlb_param.SetRedraw(FALSE)
ddlb_param.Reset( )

Do While sqlca.sqlcode = 0
	Fetch dyn_cursor into :año;
	If sqlca.sqlcode = 0 Then
//		IF LONG(año) <> 0 THEN
			ls_item = año
			if long(año) <= 99 and long(año) > 50 then 
				ls_nombre = '19'+ls_item
			elseif long(año) >= 0 and long(año) < 50 then 
				ls_nombre = '20'+ls_item
			end if	
			ddlb_param.AddItem(ls_nombre)
			If ls_item = codigo_param Then
				ls_item_buscado = ls_nombre
			End If
//		END IF
	ElseIf sqlca.sqlcode < 0 Then
		MessageBox(gs_app_name,"DataBase Error!.~n~n"+sqlca.sqlerrtext+".~n~nf_ddlb_all()")
		Return -1
	Else
		Exit
	End If
Loop

ddlb_param.Sorted = TRUE
ddlb_param.SetRedraw(TRUE)
li_pos = ddlb_param.FindItem(ls_item_buscado, 0)

Close dyn_cursor;
Return li_pos
end function

