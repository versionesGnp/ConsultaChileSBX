 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"factura_oferta~" ) COLUMN(NAME=~"factura_oferta.mora~") COLUMN(NAME=~"factura_oferta.fecha_cierre~")WHERE(    EXP1 =~"( ~~~"FACTURA_OFERTA~~~".~~~"MORA~~~"~"   OP =~">~"    EXP2 =~"0 )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(( ~~~"FACTURA_OFERTA~~~".~~~"FECHA_CIERRE~~~"~"   OP =~">=~"    EXP2 =~":fecha )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"FACTURA_OFERTA~~~".~~~"FECHA_CIERRE~~~"~"   OP =~"<=~"    EXP2 =~":fecha1 ))~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"FACTURA_OFERTA~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~"'O' )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"FACTURA_OFERTA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'N'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"FACTURA_OFERTA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'S')~" ) ) ORDER(NAME=~"factura_oferta.fecha_cierre~" ASC=yes ) ARG(NAME = ~"fecha~" TYPE = date)  ARG(NAME = ~"fecha1~" TYPE = date) " arguments=(("fecha", date),("fecha1", date)) )
