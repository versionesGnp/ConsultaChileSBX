release 7;
datawindow(units=1 timer_interval=0 color=1090519039 processing=4 HTMLDW=no print.documentname="" print.orientation = 0 print.margin.left = 100 print.margin.right = 0 print.margin.top = 24 print.margin.bottom = 24 print.paper.source = 0 print.paper.size = 0 print.prompt=no print.buttons=no print.preview.buttons=no  crosstab.dynamic = yes grid.lines=0 grid.columnmove=no selected.mouse=no )
header[1](height=65 color="536870912" )
header[2](height=0 color="536870912" )
summary(height=18 color="536870912" )
footer(height=0 color="536870912" )
detail(height=17 color="536870912" )
table(column=(type=char(20) updatewhereclause=yes name=base dbname="base" values="Contrato ISA	C/Derecho	D/Liberador	L/Promesa	O/Pagare	P" )
 column=(type=char(20) updatewhereclause=yes name=row_column dbname="row_column" )
 column=(type=number updatewhereclause=yes name=monto dbname="monto" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ingreso~" )  TABLE(NAME=~"cod_movi~" ) COLUMN(NAME=~"ingreso.folio~") COLUMN(NAME=~"ingreso.tipo_cob~") COLUMN(NAME=~"ingreso.fecha_pago~") COLUMN(NAME=~"ingreso.tipo_mov~") COLUMN(NAME=~"ingreso.monto~") COLUMN(NAME=~"ingreso.base~") COLUMN(NAME=~"cod_movi.sigla~") COLUMN(NAME=~"ingreso.cod_caja~") COLUMN(NAME=~"ingreso.serie~") COLUMN(NAME=~"ingreso.contrato~")    JOIN (LEFT=~"ingreso.tipo_mov~"    OP =~"=~"RIGHT=~"cod_movi.cod_ing~" )WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"FECHA_PAGO~~~"~"   OP =~">=~"    EXP2 =~":fecha1~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"FECHA_PAGO~~~"~"   OP =~"<=~"    EXP2 =~":fecha2~" ) ) ORDER(NAME=~"ingreso.folio~" ASC=yes ) ARG(NAME = ~"fecha1~" TYPE = date)  ARG(NAME = ~"fecha2~" TYPE = date) " arguments=(("fecha1", date),("fecha2", date))  sort="base A row_column A " )
group(level=1 header.height=0 trailer.height=18 by=("base" ) header.color="536870912" trailer.color="536870912" )
text(band=header[2] alignment="0" text="Base" border="0" color="0" x="2" y="5" height="14" width="90"  name=base_t  font.face="Arial" font.height="-8" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="12632256" )
text(band=header[2] alignment="0" text="if(tipo_mov='A','Pie', if(tipo_mov='E','Cuota',  if(tipo_mov='F','Mantencion',  if(tipo_mov='G','Mora',  if(tipo_mov='I','Abono Cuota',  if(tipo_mov='J','Gastos de Cobranza',  if(tipo_mov='L','Otros Gastos',  if(tipo_mov='M','Derecho de Sepult.',  if(tipo_mov='N','Abono de Mant.',  if(tipo_mov='S','Descuento', tipo_mov )  )  )  )  )  )  )  )  ) )" border="0" color="0" x="94" y="5" height="14" width="256"  name=row_column_t  font.face="Arial" font.height="-8" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="12632256" )
text(band=header[2] alignment="0" text="@col" border="0" color="0" x="352" y="5" height="14" width="1"  name=monto_t  font.face="Arial" font.height="-8" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="12632256" )
text(band=header[2] alignment="0" text="Grand Total " border="0" color="0" x="355" y="5" height="14" width="126"  name=grand_sum_monto_t  font.face="Arial" font.height="-8" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="12632256" )
column(band=detail id=3 alignment="1" tabsequence=32766 border="0" color="0" x="352" y="2" height="13" width="1" format="###,###,###"  name=monto edit.limit=0 edit.case=any edit.focusrectangle=no edit.autoselect=no edit.autohscroll=yes crosstab.repeat=yes  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" )
compute(band=detail alignment="1" expression="crosstabsum(1)"border="0" color="0" x="355" y="2" height="13" width="126" format="###,###,###"  name=grand_sum_monto  font.face="Arial" font.height="-8" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" )
compute(band=trailer.1 alignment="1" expression="sum(monto for group 1)"border="0" color="0" x="2" y="2" height="14" width="90" format="###,###,###"  name=compute_2  font.face="Arial" font.height="-8" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" )
compute(band=summary alignment="1" expression="sum(monto for all )"border="0" color="0" x="2" y="1" height="14" width="90" format="###,###,###"  name=compute_5  font.face="Arial" font.height="-8" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" )
text(band=header[1] alignment="2" text="Resumen de Ingreso" border="0" color="0" x="94" y="13" height="14" width="256"  name=t_1  font.face="Arial" font.height="-8" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" font.underline="1" background.mode="1" background.color="553648127" )
compute(band=header[1] alignment="2" expression="'Fecha desde el '+ string(fecha1,'dd/mm/yyyy') +' hasta el '+ string(fecha2 ,'dd/mm/yyyy')"border="0" color="0" x="94" y="38" height="14" width="256" format="[general]"  name=compute_1  font.face="Arial" font.height="-8" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" font.underline="1" background.mode="1" background.color="553648127" )
column(band=detail id=1 alignment="2" tabsequence=32766 border="6" color="0" x="2" y="2" height="13" width="90" format="[general]"  name=base ddlb.limit=0 ddlb.allowedit=no ddlb.case=any  font.face="Arial" font.height="-8" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127" )
column(band=detail id=2 alignment="0" tabsequence=32766 border="6" color="0" x="94" y="2" height="13" width="256" format="[general]"  name=row_column edit.limit=0 edit.case=any edit.focusrectangle=no edit.autoselect=yes edit.autohscroll=yes  font.face="Arial" font.height="-8" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127" )
compute(band=trailer.1 alignment="1" expression="base + ~" Total~""border="6" color="0" x="2" y="2" height="14" width="90" format="[general]"  name=compute_3  font.face="Arial" font.height="-8" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127" )
compute(band=summary alignment="1" expression="~"Grand Total~""border="6" color="0" x="2" y="1" height="15" width="90" format="[general]"  name=compute_6  font.face="Arial" font.height="-8" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127" )
compute(band=trailer.1 alignment="1" expression="sum(grand_sum_monto for group 1)"border="6" color="16711680" x="355" y="2" height="14" width="126" format="###,###,###"  name=compute_4  font.face="Arial" font.height="-8" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127" )
compute(band=summary alignment="1" expression="sum(grand_sum_monto for all )"border="6" color="255" x="355" y="1" height="15" width="126" format="###,###,###"  name=compute_7  font.face="Arial" font.height="-8" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127" )
 crosstab(band = foreground  crosstabonly = yes 
 columns = "sum(monto)" rows = "base, if(tipo_mov='A','Pie', if(tipo_mov='E','Cuota',  if(tipo_mov='F','Mantencion',  if(tipo_mov='G','Mora',  if(tipo_mov='I','Abono Cuota',  if(tipo_mov='J','Gastos de Cobranza',  if(tipo_mov='L','Otros Gastos',  if(tipo_mov='M','Derecho de Sepult.',  if(tipo_mov='N','Abono de Mant.',  if(tipo_mov='S','Descuento', tipo_mov )  )  )  )  )  )  )  )  ) )" values = "sum(monto for crosstab)" sourcenames = "folio, tipo_cob, fecha_pago, tipo_mov, monto, base, sigla, cod_caja, serie, contrato")
sparse(names="base")htmltable(border="0" )
