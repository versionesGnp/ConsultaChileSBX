 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"res_mora_fact~" ) COLUMN(NAME=~"res_mora_fact.mes~") COLUMN(NAME=~"res_mora_fact.base~") COLUMN(NAME=~"res_mora_fact.mora_cero~") COLUMN(NAME=~"res_mora_fact.mora_uno~") COLUMN(NAME=~"res_mora_fact.mora_dos~") COLUMN(NAME=~"res_mora_fact.mora_tres_cuatro~") COLUMN(NAME=~"res_mora_fact.mora_cinco_doce~") COLUMN(NAME=~"res_mora_fact.mora_trece~") COLUMN(NAME=~"res_mora_fact.capital_uno~") COLUMN(NAME=~"res_mora_fact.capital_dos~") COLUMN(NAME=~"res_mora_fact.capital_tres_cuatro~") COLUMN(NAME=~"res_mora_fact.capital_cinco_doce~") COLUMN(NAME=~"res_mora_fact.capital_trece~")WHERE(    EXP1 =~"~~~"RES_MORA_FACT~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~"'O'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"RES_MORA_FACT~~~".~~~"MES~~~"~"   OP =~">=~"    EXP2 =~":fecha~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"RES_MORA_FACT~~~".~~~"MES~~~"~"   OP =~"<=~"    EXP2 =~":fecha1~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"RES_MORA_FACT~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~" ) ) ARG(NAME = ~"fecha~" TYPE = date)  ARG(NAME = ~"fecha1~" TYPE = date)  ARG(NAME = ~"parque~" TYPE = number) " update="RES_MORA_FACT" updatewhere=1 updatekeyinplace=no arguments=(("fecha", date),("fecha1", date),("parque", number)) )
