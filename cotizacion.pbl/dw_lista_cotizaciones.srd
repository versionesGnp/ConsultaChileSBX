 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cotizaciones~" )  TABLE(NAME=~"jefe_ventas~" )  TABLE(NAME=~"supervisor~" ) COLUMN(NAME=~"cotizaciones.cod_parque~") COLUMN(NAME=~"cotizaciones.nombre_cotizante~") COLUMN(NAME=~"cotizaciones.ap_paterno_cotizante~") COLUMN(NAME=~"cotizaciones.ap_materno_cotizante~") COLUMN(NAME=~"cotizaciones.rut_cotizante~") COLUMN(NAME=~"cotizaciones.dv_cotizante~") COLUMN(NAME=~"cotizaciones.fono_cotizante~") COLUMN(NAME=~"cotizaciones.fecha~") COLUMN(NAME=~"cotizaciones.tipo_sepultura~") COLUMN(NAME=~"cotizaciones.sector~") COLUMN(NAME=~"cotizaciones.capacidad~") COLUMN(NAME=~"cotizaciones.uf_dia~") COLUMN(NAME=~"cotizaciones.valor_uso_ni~") COLUMN(NAME=~"cotizaciones.pie_minimo_ni~") COLUMN(NAME=~"cotizaciones.dscto_uso_anticipado~") COLUMN(NAME=~"cotizaciones.valor_uso_anticipado~") COLUMN(NAME=~"cotizaciones.pie_minimo_nf~") COLUMN(NAME=~"cotizaciones.plazo~") COLUMN(NAME=~"cotizaciones.valor_cuota~") COLUMN(NAME=~"cotizaciones.valor_mantencion_anual~") COLUMN(NAME=~"cotizaciones.cod_ejecutivo~") COLUMN(NAME=~"cotizaciones.fono_ejecutivo~") COLUMN(NAME=~"cotizaciones.celular_ejecutivo~") COLUMN(NAME=~"cotizaciones.correlativo_interno~") COLUMN(NAME=~"cotizaciones.moneda~") COLUMN(NAME=~"cotizaciones.mail~") COLUMN(NAME=~"cotizaciones.uso~")    JOIN (LEFT=~"cotizaciones.cod_ejecutivo~"    OP =~"=~"RIGHT=~"supervisor.cod_sup~"    OUTER1 =~"cotizaciones.cod_ejecutivo~" )    JOIN (LEFT=~"supervisor.cod_jefe~"    OP =~"=~"RIGHT=~"jefe_ventas.jefe_ventas~"    OUTER1 =~"supervisor.cod_jefe~" )WHERE(    EXP1 =~"~~~"COTIZACIONES~~~".~~~"FECHA~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"COTIZACIONES~~~".~~~"FECHA~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"COTIZACIONES~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"COTIZACIONES~~~".~~~"COD_EJECUTIVO~~~"~"   OP =~"=~"    EXP2 =~":usuario~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"JEFE_VENTAS~~~".~~~"JEFE_VENTAS~~~"~"   OP =~"=~"    EXP2 =~":usuario)~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = datetime)  ARG(NAME = ~"fecha_fin~" TYPE = datetime)  ARG(NAME = ~"parque~" TYPE = number)  ARG(NAME = ~"usuario~" TYPE = string) " arguments=(("fecha_ini", datetime),("fecha_fin", datetime),("parque", number),("usuario", string)) )
