global type funcion_mora_al from function_object
end type

forward prototypes
global function double funcion_mora_al (datetime primer, double pag, double cuotas, string as_estado_cadena, datetime adt_fecha_al)
end prototypes

global function double funcion_mora_al (datetime primer, double pag, double cuotas, string as_estado_cadena, datetime adt_fecha_al);double vmes,vano,vcuo_venc,vmora, ll_valor
if as_estado_cadena='S' then 
	vmora				= 0  
else
	vano				= year(date(adt_fecha_al)) - year(DATE(primer))
	vano				= vano * 12	 
	vmes				= month(date(adt_fecha_al)) - month(DATE(primer))
	vcuo_venc		= vano + vmes
	if (day(date(adt_fecha_al))> day(DATE(Primer))) then
		vcuo_venc	= vcuo_venc + 1
	end if
	if vcuo_venc <0 then
		vcuo_venc	= 0
	end if
	if vcuo_venc> cuotas then
		vcuo_venc	= cuotas
	end if
	vmora				= vcuo_venc - pag
	IF vmora <= 0 then 
		vmora			= 0
	end if
end if
return(vmora)
end function

