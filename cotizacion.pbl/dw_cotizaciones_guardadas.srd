 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cotizaciones~" )  TABLE(NAME=~"agentes~" ) COLUMN(NAME=~"cotizaciones.cod_parque~") COLUMN(NAME=~"cotizaciones.nombre_cotizante~") COLUMN(NAME=~"cotizaciones.ap_paterno_cotizante~") COLUMN(NAME=~"cotizaciones.ap_materno_cotizante~") COLUMN(NAME=~"cotizaciones.fecha~") COLUMN(NAME=~"cotizaciones.tipo_sepultura~") COLUMN(NAME=~"cotizaciones.sector~") COLUMN(NAME=~"cotizaciones.capacidad~") COLUMN(NAME=~"cotizaciones.cod_ejecutivo~") COLUMN(NAME=~"cotizaciones.rut_cotizante~") COLUMN(NAME=~"cotizaciones.dv_cotizante~") COLUMN(NAME=~"cotizaciones.correlativo_interno~") COLUMN(NAME=~"agentes.nombre~") COLUMN(NAME=~"agentes.a_paterno~") COLUMN(NAME=~"agentes.a_materno~")    JOIN (LEFT=~"cotizaciones.cod_ejecutivo~"    OP =~"=~"RIGHT=~"agentes.cod_age~" )WHERE(    EXP1 =~"~~~"COTIZACIONES~~~".~~~"RUT_COTIZANTE~~~"~"   OP =~"=~"    EXP2 =~":ll_rut~" ) ) ARG(NAME = ~"ll_rut~" TYPE = number) " arguments=(("ll_rut", number))  sort="correlativo_interno A " )
