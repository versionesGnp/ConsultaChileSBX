 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"informe_agente~" )  TABLE(NAME=~"agentes~" )  TABLE(NAME=~"supervisor~" )  TABLE(NAME=~"jefe_ventas~" ) COLUMN(NAME=~"informe_agente.correlativo~") COLUMN(NAME=~"informe_agente.cod_sup~") COLUMN(NAME=~"informe_agente.cod_age~") COLUMN(NAME=~"informe_agente.fecha_reporte~") COLUMN(NAME=~"informe_agente.nombre_contacto~") COLUMN(NAME=~"informe_agente.apellido_paterno_contacto~") COLUMN(NAME=~"informe_agente.apellido_materno_contacto~") COLUMN(NAME=~"informe_agente.rut_contacto~") COLUMN(NAME=~"informe_agente.dv_contacto~") COLUMN(NAME=~"informe_agente.direccion_contacto~") COLUMN(NAME=~"informe_agente.numero_contacto~") COLUMN(NAME=~"informe_agente.depto_contacto~") COLUMN(NAME=~"informe_agente.block_contacto~") COLUMN(NAME=~"informe_agente.poblacion_villa_contacto~") COLUMN(NAME=~"informe_agente.sector~") COLUMN(NAME=~"informe_agente.ciudad_contacto~") COLUMN(NAME=~"informe_agente.comuna_contacto~") COLUMN(NAME=~"informe_agente.fono_contacto~") COLUMN(NAME=~"informe_agente.estado_gestion~") COLUMN(NAME=~"informe_agente.fecha_prox_contacto~") COLUMN(NAME=~"informe_agente.observaciones~") COLUMN(NAME=~"informe_agente.estado_general~") COLUMN(NAME=~"informe_agente.estado_reg~") COLUMN(NAME=~"agentes.estado~") COLUMN(NAME=~"supervisor.nombre~") COLUMN(NAME=~"supervisor.a_paterno~") COLUMN(NAME=~"supervisor.a_materno~") COLUMN(NAME=~"supervisor.estado~") COLUMN(NAME=~"supervisor.cod_jefe~") COLUMN(NAME=~"jefe_ventas.nombre~") COLUMN(NAME=~"jefe_ventas.a_paterno~") COLUMN(NAME=~"jefe_ventas.a_materno~") COLUMN(NAME=~"jefe_ventas.estado~") COLUMN(NAME=~"agentes.nombre~") COLUMN(NAME=~"agentes.a_paterno~") COLUMN(NAME=~"agentes.a_materno~") COLUMN(NAME=~"jefe_ventas.jefe_ventas~")    JOIN (LEFT=~"informe_agente.cod_age~"    OP =~"=~"RIGHT=~"agentes.cod_age~" )    JOIN (LEFT=~"informe_agente.cod_sup~"    OP =~"=~"RIGHT=~"supervisor.cod_sup~" )    JOIN (LEFT=~"jefe_ventas.jefe_ventas~"    OP =~"=~"RIGHT=~"supervisor.cod_jefe~" )WHERE(    EXP1 =~"~~~"INFORME_AGENTE~~~".~~~"FECHA_PROX_CONTACTO~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INFORME_AGENTE~~~".~~~"FECHA_PROX_CONTACTO~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INFORME_AGENTE~~~".~~~"ESTADO_GENERAL~~~"~"   OP =~"=~"    EXP2 =~"'P'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INFORME_AGENTE~~~".~~~"COD_SUP~~~"~"   OP =~"=~"    EXP2 =~":cod_sup~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"INFORME_AGENTE~~~".~~~"ESTADO_REG~~~"~"   OP =~"=~"    EXP2 =~"'A'~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = datetime)  ARG(NAME = ~"fecha_fin~" TYPE = datetime)  ARG(NAME = ~"cod_sup~" TYPE = string) " arguments=(("fecha_ini", datetime),("fecha_fin", datetime),("cod_sup", string))  sort="cod_sup A cod_age A fecha_reporte A " )
