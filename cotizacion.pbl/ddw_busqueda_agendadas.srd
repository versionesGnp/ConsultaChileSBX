 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"informe_agente~" ) COLUMN(NAME=~"informe_agente.correlativo~") COLUMN(NAME=~"informe_agente.cod_sup~") COLUMN(NAME=~"informe_agente.cod_age~") COLUMN(NAME=~"informe_agente.fecha_reporte~") COLUMN(NAME=~"informe_agente.nombre_contacto~") COLUMN(NAME=~"informe_agente.apellido_paterno_contacto~") COLUMN(NAME=~"informe_agente.apellido_materno_contacto~") COLUMN(NAME=~"informe_agente.rut_contacto~") COLUMN(NAME=~"informe_agente.dv_contacto~") COLUMN(NAME=~"informe_agente.direccion_contacto~") COLUMN(NAME=~"informe_agente.numero_contacto~") COLUMN(NAME=~"informe_agente.depto_contacto~") COLUMN(NAME=~"informe_agente.block_contacto~") COLUMN(NAME=~"informe_agente.poblacion_villa_contacto~") COLUMN(NAME=~"informe_agente.sector~") COLUMN(NAME=~"informe_agente.ciudad_contacto~") COLUMN(NAME=~"informe_agente.comuna_contacto~") COLUMN(NAME=~"informe_agente.fono_contacto~") COLUMN(NAME=~"informe_agente.estado_gestion~") COLUMN(NAME=~"informe_agente.fecha_prox_contacto~") COLUMN(NAME=~"informe_agente.observaciones~") COLUMN(NAME=~"informe_agente.estado_general~")WHERE(    EXP1 =~"~~~"INFORME_AGENTE~~~".~~~"FECHA_PROX_CONTACTO~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INFORME_AGENTE~~~".~~~"FECHA_PROX_CONTACTO~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INFORME_AGENTE~~~".~~~"ESTADO_GENERAL~~~"~"   OP =~"=~"    EXP2 =~"'P'~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = datetime)  ARG(NAME = ~"fecha_fin~" TYPE = datetime) " update="INFORME_AGENTE" updatewhere=1 updatekeyinplace=no arguments=(("fecha_ini", datetime),("fecha_fin", datetime)) )
