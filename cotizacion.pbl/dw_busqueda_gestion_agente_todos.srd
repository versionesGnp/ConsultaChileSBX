 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"informe_agente~" )  TABLE(NAME=~"agentes~" )  TABLE(NAME=~"jefe_ventas~" )  TABLE(NAME=~"supervisor~" ) COLUMN(NAME=~"informe_agente.correlativo~") COLUMN(NAME=~"informe_agente.cod_sup~") COLUMN(NAME=~"informe_agente.cod_age~") COLUMN(NAME=~"informe_agente.fecha_reporte~") COLUMN(NAME=~"informe_agente.nombre_contacto~") COLUMN(NAME=~"informe_agente.apellido_paterno_contacto~") COLUMN(NAME=~"informe_agente.apellido_materno_contacto~") COLUMN(NAME=~"informe_agente.rut_contacto~") COLUMN(NAME=~"informe_agente.dv_contacto~") COLUMN(NAME=~"informe_agente.direccion_contacto~") COLUMN(NAME=~"informe_agente.numero_contacto~") COLUMN(NAME=~"informe_agente.depto_contacto~") COLUMN(NAME=~"informe_agente.block_contacto~") COLUMN(NAME=~"informe_agente.poblacion_villa_contacto~") COLUMN(NAME=~"informe_agente.sector~") COLUMN(NAME=~"informe_agente.ciudad_contacto~") COLUMN(NAME=~"informe_agente.comuna_contacto~") COLUMN(NAME=~"informe_agente.fono_contacto~") COLUMN(NAME=~"informe_agente.estado_gestion~") COLUMN(NAME=~"informe_agente.fecha_prox_contacto~") COLUMN(NAME=~"informe_agente.observaciones~") COLUMN(NAME=~"informe_agente.estado_general~") COLUMN(NAME=~"informe_agente.estado_reg~") COLUMN(NAME=~"agentes.nombre~") COLUMN(NAME=~"agentes.a_paterno~") COLUMN(NAME=~"agentes.a_materno~") COLUMN(NAME=~"supervisor.nombre~") COLUMN(NAME=~"supervisor.a_paterno~") COLUMN(NAME=~"supervisor.a_materno~") COLUMN(NAME=~"jefe_ventas.jefe_ventas~") COLUMN(NAME=~"jefe_ventas.nombre~") COLUMN(NAME=~"jefe_ventas.a_paterno~") COLUMN(NAME=~"jefe_ventas.a_materno~") COLUMN(NAME=~"agentes.estado~") COLUMN(NAME=~"supervisor.estado~") COLUMN(NAME=~"jefe_ventas.estado~")    JOIN (LEFT=~"supervisor.cod_jefe~"    OP =~"=~"RIGHT=~"jefe_ventas.jefe_ventas~" )    JOIN (LEFT=~"informe_agente.cod_age~"    OP =~"=~"RIGHT=~"agentes.cod_age~" )    JOIN (LEFT=~"agentes.cod_sup~"    OP =~"=~"RIGHT=~"supervisor.cod_sup~" )WHERE(    EXP1 =~"~~~"INFORME_AGENTE~~~".~~~"FECHA_REPORTE~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INFORME_AGENTE~~~".~~~"FECHA_REPORTE~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = datetime)  ARG(NAME = ~"fecha_fin~" TYPE = datetime) " arguments=(("fecha_ini", datetime),("fecha_fin", datetime))  sort="jefe_ventas_jefe_ventas A cod_sup A cod_age A fecha_reporte A " )
