 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"informe_agente~" ) COLUMN(NAME=~"informe_agente.correlativo~") COLUMN(NAME=~"informe_agente.fecha_reporte~") COLUMN(NAME=~"informe_agente.apellido_paterno_contacto~") COLUMN(NAME=~"informe_agente.apellido_materno_contacto~") COLUMN(NAME=~"informe_agente.rut_contacto~") COLUMN(NAME=~"informe_agente.dv_contacto~") COLUMN(NAME=~"informe_agente.direccion_contacto~") COLUMN(NAME=~"informe_agente.numero_contacto~") COLUMN(NAME=~"informe_agente.depto_contacto~") COLUMN(NAME=~"informe_agente.block_contacto~") COLUMN(NAME=~"informe_agente.poblacion_villa_contacto~") COLUMN(NAME=~"informe_agente.sector~") COLUMN(NAME=~"informe_agente.ciudad_contacto~") COLUMN(NAME=~"informe_agente.comuna_contacto~") COLUMN(NAME=~"informe_agente.fono_contacto~") COLUMN(NAME=~"informe_agente.estado_gestion~") COLUMN(NAME=~"informe_agente.fecha_prox_contacto~") COLUMN(NAME=~"informe_agente.observaciones~") COLUMN(NAME=~"informe_agente.estado_general~") COLUMN(NAME=~"informe_agente.estado_reg~") COLUMN(NAME=~"informe_agente.tipo_via~") COLUMN(NAME=~"informe_agente.tipo_venta~") COLUMN(NAME=~"informe_agente.nombre_contacto~") COLUMN(NAME=~"informe_agente.cod_sup~") COLUMN(NAME=~"informe_agente.cod_age~") COLUMN(NAME=~"informe_agente.usuario_crea~")WHERE(    EXP1 =~"~~~"INFORME_AGENTE~~~".~~~"COD_AGE~~~"~"   OP =~"=~"    EXP2 =~":cod_age~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"INFORME_AGENTE~~~".~~~"FECHA_REPORTE~~~"~"   OP =~"=~"    EXP2 =~":fecha_rep~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INFORME_AGENTE~~~".~~~"CORRELATIVO~~~"~"   OP =~"=~"    EXP2 =~":corr~" ) ) ARG(NAME = ~"cod_age~" TYPE = string)  ARG(NAME = ~"fecha_rep~" TYPE = date)  ARG(NAME = ~"corr~" TYPE = number) " update="INFORME_AGENTE" updatewhere=0 updatekeyinplace=yes arguments=(("cod_age", string),("fecha_rep", date),("corr", number)) )
