 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"vista_listado_obituario~" ) COLUMN(NAME=~"vista_listado_obituario.hora~") COLUMN(NAME=~"vista_listado_obituario.minutos~") COLUMN(NAME=~"vista_listado_obituario.nombre_fallecido~") COLUMN(NAME=~"vista_listado_obituario.ap_paterno_fall~") COLUMN(NAME=~"vista_listado_obituario.ap_materno_fall~") COLUMN(NAME=~"vista_listado_obituario.rut_fallecido~") COLUMN(NAME=~"vista_listado_obituario.dv_fallecido~") COLUMN(NAME=~"vista_listado_obituario.base~") COLUMN(NAME=~"vista_listado_obituario.serie~") COLUMN(NAME=~"vista_listado_obituario.numero~") COLUMN(NAME=~"vista_listado_obituario.cod_parque~") COLUMN(NAME=~"vista_listado_obituario.sector~") COLUMN(NAME=~"vista_listado_obituario.sepultura~") COLUMN(NAME=~"vista_listado_obituario.correlativo_ficha~") COLUMN(NAME=~"vista_listado_obituario.codigo_funeraria~") COLUMN(NAME=~"vista_listado_obituario.observacion_sepultura_completa~") COLUMN(NAME=~"vista_listado_obituario.tipo_ficha~") COLUMN(NAME=~"vista_listado_obituario.fecha_sepultacion~")WHERE(    EXP1 =~"~~~"VISTA_LISTADO_OBITUARIO~~~".~~~"FECHA_SEPULTACION~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"VISTA_LISTADO_OBITUARIO~~~".~~~"FECHA_SEPULTACION~~~"~"   OP =~"<=~"    EXP2 =~":fech_fin~" ) ) ORDER(NAME=~"vista_listado_obituario.hora~" ASC=yes )  ORDER(NAME=~"vista_listado_obituario.minutos~" ASC=yes ) ARG(NAME = ~"fecha_ini~" TYPE = datetime)  ARG(NAME = ~"fech_fin~" TYPE = datetime) " arguments=(("fecha_ini", datetime),("fech_fin", datetime))  sort="fecha_sepultacion A hora A minutos A " )
