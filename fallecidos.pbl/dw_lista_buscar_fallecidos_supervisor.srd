 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"fallecidos~" )  TABLE(NAME=~"cadena~" ) COLUMN(NAME=~"fallecidos.cod_parque~") COLUMN(NAME=~"fallecidos.sector~") COLUMN(NAME=~"fallecidos.n_sep~") COLUMN(NAME=~"fallecidos.fec_sep~") COLUMN(NAME=~"fallecidos.nombres~") COLUMN(NAME=~"fallecidos.ap_paterno~") COLUMN(NAME=~"fallecidos.ap_materno~") COLUMN(NAME=~"fallecidos.rut~") COLUMN(NAME=~"fallecidos.dv~") COLUMN(NAME=~"fallecidos.base~") COLUMN(NAME=~"fallecidos.ss~") COLUMN(NAME=~"fallecidos.contrato~") COLUMN(NAME=~"fallecidos.fec_fall~") COMPUTE(NAME=~"(SELECT ~~~"PAGO_OFERTA~~~".~~~"CAPACIDAD~~~" FROM ~~~"OFERTA_V~~~",~~~"PAGO_OFERTA~~~",~~~"CADENA~~~" WHERE ( ~~~"OFERTA_V~~~".~~~"SERIE~~~" = ~~~"PAGO_OFERTA~~~".~~~"SERIE~~~" ) and ( ~~~"OFERTA_V~~~".~~~"NRO_OFERTA~~~" = ~~~"PAGO_OFERTA~~~".~~~"NRO_OFERTA~~~" ) and ( ~~~"CADENA~~~".~~~"SERIE~~~" = ~~~"OFERTA_V~~~".~~~"SERIE~~~" ) and ( ~~~"CADENA~~~".~~~"NUMERO~~~" = ~~~"OFERTA_V~~~".~~~"NRO_OFERTA~~~" ) and ( ( ~~~"CADENA~~~".~~~"CODIGO~~~" =~~~"FALLECIDOS~~~".~~~"BASE~~~" ) AND ( ~~~"CADENA~~~".~~~"SERIE~~~" = ~~~"FALLECIDOS~~~".~~~"SS~~~" ) AND ( ~~~"CADENA~~~".~~~"NUMERO~~~" = ~~~"FALLECIDOS~~~".~~~"CONTRATO~~~" ) ) UNION SELECT ~~~"CONTRATO~~~".~~~"CAPACIDAD~~~" FROM ~~~"CADENA~~~",~~~"CONTRATO~~~" WHERE ( ~~~"CADENA~~~".~~~"SERIE~~~" = ~~~"CONTRATO~~~".~~~"SERIE_C~~~" ) and ( ~~~"CADENA~~~".~~~"NUMERO~~~" = ~~~"CONTRATO~~~".~~~"NRO_CONTRATO~~~" ) and ( ( ~~~"CADENA~~~".~~~"CODIGO~~~" = ~~~"FALLECIDOS~~~".~~~"BASE~~~" ) AND ( ~~~"CADENA~~~".~~~"SERIE~~~" = ~~~"FALLECIDOS~~~".~~~"SS~~~" ) AND ( ~~~"CADENA~~~".~~~"NUMERO~~~" = ~~~"FALLECIDOS~~~".~~~"CONTRATO~~~" ) ) ) as CAPACIDAD~") COMPUTE(NAME=~"(SELECT COUNT(~~~"FALLECIDOS~~~".~~~"LLAVE~~~") FROM ~~~"FALLECIDOS~~~" WHERE ( ~~~"FALLECIDOS~~~".~~~"BASE~~~" = ~~~"CADENA~~~".~~~"CODIGO~~~" ) AND ( ~~~"FALLECIDOS~~~".~~~"SS~~~" = ~~~"CADENA~~~".~~~"SERIE~~~" ) AND ( ~~~"FALLECIDOS~~~".~~~"CONTRATO~~~" = ~~~"CADENA~~~".~~~"NUMERO~~~" ) AND (~~~"FALLECIDOS~~~".~~~"EST~~~" = 'RE' OR ~~~"FALLECIDOS~~~".~~~"EST~~~" = 'AN')) as CONTAR_REDUC~") COMPUTE(NAME=~"(SELECT COUNT(~~~"FALLECIDOS~~~".~~~"LLAVE~~~") FROM ~~~"FALLECIDOS~~~" WHERE ( ~~~"FALLECIDOS~~~".~~~"BASE~~~" = ~~~"CADENA~~~".~~~"CODIGO~~~" ) AND ( ~~~"FALLECIDOS~~~".~~~"SS~~~" = ~~~"CADENA~~~".~~~"SERIE~~~" ) AND ( ~~~"FALLECIDOS~~~".~~~"CONTRATO~~~" = ~~~"CADENA~~~".~~~"NUMERO~~~" ) AND (~~~"FALLECIDOS~~~".~~~"EST~~~" <> 'RE') AND ( ~~~"FALLECIDOS~~~".~~~"EST~~~" <> 'AN')) as CONTAR_NORMAL~") COLUMN(NAME=~"cadena.rut~") COLUMN(NAME=~"cadena.estado~")    JOIN (LEFT=~"fallecidos.base~"    OP =~"=~"RIGHT=~"cadena.codigo~" )    JOIN (LEFT=~"fallecidos.ss~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"fallecidos.contrato~"    OP =~"=~"RIGHT=~"cadena.numero~" )WHERE(    EXP1 =~"~~~"FALLECIDOS~~~".~~~"RUT~~~"~"   OP =~"=~"    EXP2 =~":rut~" ) ) ARG(NAME = ~"rut~" TYPE = number) " arguments=(("rut", number))  sort="contrato A n_sep A " )
