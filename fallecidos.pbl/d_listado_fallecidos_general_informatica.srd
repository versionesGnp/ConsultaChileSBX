 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"fallecidos~" ) COLUMN(NAME=~"fallecidos.llave~") COLUMN(NAME=~"fallecidos.folio~") COLUMN(NAME=~"fallecidos.n_l~") COLUMN(NAME=~"fallecidos.n_m~") COLUMN(NAME=~"fallecidos.base~") COLUMN(NAME=~"fallecidos.ss~") COLUMN(NAME=~"fallecidos.contrato~") COLUMN(NAME=~"fallecidos.sector~") COLUMN(NAME=~"fallecidos.n_sep~") COLUMN(NAME=~"fallecidos.nombres~") COLUMN(NAME=~"fallecidos.ap_paterno~") COLUMN(NAME=~"fallecidos.ap_materno~") COLUMN(NAME=~"fallecidos.fec_sep~") COLUMN(NAME=~"fallecidos.est~") COLUMN(NAME=~"fallecidos.op~") COLUMN(NAME=~"fallecidos.rut~") COLUMN(NAME=~"fallecidos.dv~") COLUMN(NAME=~"fallecidos.sexo~") COLUMN(NAME=~"fallecidos.edad~") COLUMN(NAME=~"fallecidos.periodo~") COLUMN(NAME=~"fallecidos.fec_nac~") COLUMN(NAME=~"fallecidos.fec_fall~") COLUMN(NAME=~"fallecidos.pase~") COLUMN(NAME=~"fallecidos.reg_civil~") COLUMN(NAME=~"fallecidos.causa_fall~") COLUMN(NAME=~"fallecidos.enf_obl~") COLUMN(NAME=~"fallecidos.funeraria~") COLUMN(NAME=~"fallecidos.boleta~") COLUMN(NAME=~"fallecidos.carta_aut~") COLUMN(NAME=~"fallecidos.rg_est~") COLUMN(NAME=~"fallecidos.n_tec~") COLUMN(NAME=~"fallecidos.nivel~") COLUMN(NAME=~"fallecidos.vta~") COLUMN(NAME=~"fallecidos.observaciones~") COLUMN(NAME=~"fallecidos.estado_contrato~") COLUMN(NAME=~"fallecidos.cod_parque~") COLUMN(NAME=~"fallecidos.estado_reg~")WHERE(    EXP1 =~"~~~"FALLECIDOS~~~".~~~"ESTADO_CONTRATO~~~"~"   OP =~"like~"    EXP2 =~":as_estado~" ) ) ORDER(NAME=~"fallecidos.llave~" ASC=no) ARG(NAME = ~"as_estado~" TYPE = string) " update="FALLECIDOS" updatewhere=0 updatekeyinplace=yes arguments=(("as_estado", string)) )
