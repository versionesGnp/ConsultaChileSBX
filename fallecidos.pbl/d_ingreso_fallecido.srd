_inhumacion~") COLUMN(NAME=~"fallecidos.estado_traslado_interno~") COLUMN(NAME=~"fallecidos.fecha_traslado_interno~") COLUMN(NAME=~"fallecidos.estado_traslado_externo~") COLUMN(NAME=~"fallecidos.fecha_traslado_externo~") COLUMN(NAME=~"fallecidos.estado_reduccion~") COLUMN(NAME=~"fallecidos.fecha_reduccion~") COLUMN(NAME=~"fallecidos.estado_en_transito~") COLUMN(NAME=~"fallecidos.fecha_en_transito~") COLUMN(NAME=~"fallecidos.estado_crematorio~") COLUMN(NAME=~"fallecidos.fecha_crematorio~") COLUMN(NAME=~"fallecidos.estado_reg~") COLUMN(NAME=~"fallecidos.estado_fallecido~") COLUMN(NAME=~"fallecidos.base_destino~") COLUMN(NAME=~"fallecidos.serie_destino~") COLUMN(NAME=~"fallecidos.numero_destino~") COLUMN(NAME=~"fallecidos.usuario_crea~") COLUMN(NAME=~"fallecidos.fecha_crea~")WHERE(    EXP1 =~"~~~"FALLECIDOS~~~".~~~"LLAVE~~~"~"   OP =~"=~"    EXP2 =~":an_llave~" ) ) ARG(NAME = ~"an_llave~" TYPE = number) " update="FALLECIDOS" updatewhere=0 updatekeyinplace=yes arguments=(("an_llave", number)) )
