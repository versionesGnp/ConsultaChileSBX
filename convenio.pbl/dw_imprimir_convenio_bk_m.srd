 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"convenio~" )  TABLE(NAME=~"convenio_retiro~" ) COLUMN(NAME=~"convenio.serie~") COLUMN(NAME=~"convenio.numero~") COLUMN(NAME=~"convenio.rut~") COLUMN(NAME=~"convenio.ap_paterno~") COLUMN(NAME=~"convenio.ap_materno~") COLUMN(NAME=~"convenio.fecha_pago~") COLUMN(NAME=~"convenio.valor_cuota~") COLUMN(NAME=~"convenio.cod_convenio~") COLUMN(NAME=~"convenio_retiro.glosa~") COLUMN(NAME=~"convenio_retiro.moneda~") COLUMN(NAME=~"convenio_retiro.direccion~") COLUMN(NAME=~"convenio_retiro.contacto~") COLUMN(NAME=~"convenio.fecha_envio_carta~") COLUMN(NAME=~"convenio.cod_parque~") COLUMN(NAME=~"convenio.nombre~") COLUMN(NAME=~"convenio.plazo~") COLUMN(NAME=~"convenio.cuotas_pag~")    JOIN (LEFT=~"convenio.cod_convenio~"    OP =~"=~"RIGHT=~"convenio_retiro.cod_convenio~" )WHERE(    EXP1 =~"~~~"CONVENIO~~~".~~~"COD_CONVENIO~~~"~"   OP =~"=~"    EXP2 =~"6000~" ) ) " )
