forward
global type m_convenio from menu
end type
type m_opciones from menu within m_convenio
end type
type m_insertar from menu within m_opciones
end type
type m_eliminar from menu within m_opciones
end type
type m_opciones from menu within m_convenio
m_insertar m_insertar
m_eliminar m_eliminar
end type
global type m_convenio from menu
m_opciones m_opciones
end type
end forward

global type m_convenio from menu
m_opciones m_opciones
end type
global m_convenio m_convenio

on m_convenio.create
m_convenio=this
call super::create
this.m_opciones=create m_opciones
this.Item[UpperBound(this.Item)+1]=this.m_opciones
end on

on m_convenio.destroy
call super::destroy
destroy(this.m_opciones)
end on

type m_opciones from menu within m_convenio
m_insertar m_insertar
m_eliminar m_eliminar
end type

on m_opciones.create
call super::create
this.text = "&Opciones"
this.m_insertar=create m_insertar
this.m_eliminar=create m_eliminar
this.Item[UpperBound(this.Item)+1]=this.m_insertar
this.Item[UpperBound(this.Item)+1]=this.m_eliminar
end on

on m_opciones.destroy
call super::destroy
destroy(this.m_insertar)
destroy(this.m_eliminar)
end on

type m_insertar from menu within m_opciones
end type

on m_insertar.create
call super::create
this.text = "&Insertar"
end on

on m_insertar.destroy
call super::destroy
end on

event clicked;Long	ll_row
if isvalid(w_mantenedor_convenio_stgo) then
	ll_row	= w_mantenedor_convenio_stgo.dw_lista.insertrow(w_mantenedor_convenio_stgo.dw_lista.getrow())
	w_mantenedor_convenio_stgo.dw_lista.scrolltorow(ll_row)
	w_mantenedor_convenio_stgo.dw_lista.setcolumn('cod_convenio')
	w_mantenedor_convenio_stgo.dw_lista.setfocus()
end if
end event

type m_eliminar from menu within m_opciones
end type

on m_eliminar.create
call super::create
this.text = "&Eliminar"
end on

on m_eliminar.destroy
call super::destroy
end on

event clicked;Long	ll_row,ll_fila,ll_codigo,ll_res
if isvalid(w_mantenedor_convenio_stgo) then
	ll_fila		= w_mantenedor_convenio_stgo.dw_lista.getrow()
	ll_codigo	= w_mantenedor_convenio_stgo.dw_lista.getitemnumber(ll_fila,'cod_convenio')
	ll_res		= messagebox("Advertencia","Está Seguro de Eliminar Convenio Nº "+string(ll_codigo)+ ", recuerde Grabar los Cambios",Exclamation!,YesNo!,2)
	if ll_res=1 then
		w_mantenedor_convenio_stgo.dw_lista.deleterow(ll_fila)
		w_mantenedor_convenio_stgo.dw_lista.scrolltorow(1)
	end if
end if
end event

