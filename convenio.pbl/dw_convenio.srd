 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"contrato~" )  TABLE(NAME=~"cadena_mora~" )  TABLE(NAME=~"cliente~" )  TABLE(NAME=~"pagare~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"convenio_retiro~" )  TABLE(NAME=~"convenio~" ) COLUMN(NAME=~"contrato.rut~") COLUMN(NAME=~"cadena_mora.mora_cred~") COLUMN(NAME=~"cadena_mora.fecha_venc_cred~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"pagare.valor_cuo~") COLUMN(NAME=~"pagare.moneda~") COLUMN(NAME=~"convenio_retiro.cod_convenio~") COLUMN(NAME=~"contrato.parque~") COLUMN(NAME=~"pagare.plazo~") COMPUTE(NAME=~"(~~~"PAGARE~~~".~~~"CTA_PAG_LA~~~" + ~~~"PAGARE~~~".~~~"CTA_PAG_ISA~~~")~") COLUMN(NAME=~"pagare.fecha_prim~") COLUMN(NAME=~"pagare.serie_p~") COLUMN(NAME=~"pagare.nro_pagare~") COMPUTE(NAME=~"0~") COLUMN(NAME=~"convenio.estado_grabacion~") COMPUTE(NAME=~"0~") COMPUTE(NAME=~"'P' as c_base~")    JOIN (LEFT=~"convenio_retiro.cod_convenio~"    OP =~"=~"RIGHT=~"convenio.cod_convenio~"    OUTER1 =~"convenio_retiro.cod_convenio~" )    JOIN (LEFT=~"contrato.serie~"    OP =~"=~"RIGHT=~"pagare.serie_p~" )    JOIN (LEFT=~"contrato.nro_pagare~"    OP =~"=~"RIGHT=~"pagare.nro_pagare~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"cadena_mora.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"cadena_mora.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"cadena_mora.numero~" )    JOIN (LEFT=~"cliente.rut~"    OP =~"=~"RIGHT=~"pagare.rut~" )    JOIN (LEFT=~"convenio_retiro.cod_convenio~"    OP =~"=~"RIGHT=~"contrato.cod_convenio~" )    JOIN (LEFT=~"pagare.serie_p~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"pagare.nro_pagare~"    OP =~"=~"RIGHT=~"cadena.numero~" )WHERE(    EXP1 =~"~~~"CADENA_MORA~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~"'P'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"PAGARE~~~".~~~"PLAZO~~~"~"   OP =~">~"    EXP2 =~"(~~~"PAGARE~~~".~~~"CTA_PAG_LA~~~" + ~~~"PAGARE~~~".~~~"CTA_PAG_ISA~~~")~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'V'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CONTRATO~~~".~~~"COD_CONVENIO~~~"~"   OP =~"<>~"    EXP2 =~"0~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CONVENIO_RETIRO~~~".~~~"VIGENCIA_CONVENIO~~~"~"   OP =~">=~"    EXP2 =~":fech_sistema~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA_MORA~~~".~~~"FECHA_VENC_CRED~~~"~"   OP =~"<=~"    EXP2 =~":fecha_proc~" ) )    UNION (PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"cadena~" )  TABLE(NAME=~"cadena_mora~" )  TABLE(NAME=~"cliente~" )  TABLE(NAME=~"convenio_retiro~" )  TABLE(NAME=~"oferta_v~" )  TABLE(NAME=~"pago_oferta~" )  TABLE(NAME=~"convenio~" ) COLUMN(NAME=~"cadena.rut~") COLUMN(NAME=~"cadena_mora.mora_cred~") COLUMN(NAME=~"cadena_mora.fecha_venc_cred~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"pago_oferta.valor_cuota~") COLUMN(NAME=~"pago_oferta.moneda~") COLUMN(NAME=~"convenio_retiro.cod_convenio~") COLUMN(NAME=~"cadena.cod_parque~") COLUMN(NAME=~"pago_oferta.nro_cuotas~") COLUMN(NAME=~"oferta_v.cta_pag_s~") COLUMN(NAME=~"pago_oferta.fecha_prim~") COLUMN(NAME=~"oferta_v.serie~") COLUMN(NAME=~"oferta_v.nro_oferta~") COMPUTE(NAME=~"0~") COLUMN(NAME=~"convenio.estado_grabacion~") COLUMN(NAME=~"oferta_v.promocion~") COMPUTE(NAME=~"'O' as c_base~")    JOIN (LEFT=~"convenio_retiro.cod_convenio~"    OP =~"=~"RIGHT=~"convenio.cod_convenio~"    OUTER1 =~"convenio_retiro.cod_convenio~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"cadena_mora.serie~" )    JOIN (LEFT=~"oferta_v.serie~"    OP =~"=~"RIGHT=~"pago_oferta.serie~" )    JOIN (LEFT=~"oferta_v.nro_oferta~"    OP =~"=~"RIGHT=~"pago_oferta.nro_oferta~" )    JOIN (LEFT=~"oferta_v.ult_folio~"    OP =~"=~"RIGHT=~"pago_oferta.folio~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"cadena_mora.base~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"cadena_mora.numero~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"oferta_v.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"oferta_v.nro_oferta~" )    JOIN (LEFT=~"cadena.rut~"    OP =~"=~"RIGHT=~"cliente.rut~" )    JOIN (LEFT=~"oferta_v.cod_convenio~"    OP =~"=~"RIGHT=~"convenio_retiro.cod_convenio~" )WHERE(    EXP1 =~"~~~"PAGO_OFERTA~~~".~~~"NRO_CUOTAS~~~"~"   OP =~">~"    EXP2 =~"~~~"OFERTA_V~~~".~~~"CTA_PAG_S~~~"~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'V'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"OFERTA_V~~~".~~~"COD_CONVENIO~~~"~"   OP =~"<>~"    EXP2 =~"0~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CONVENIO_RETIRO~~~".~~~"VIGENCIA_CONVENIO~~~"~"   OP =~">=~"    EXP2 =~":fech_sistema~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA_MORA~~~".~~~"FECHA_VENC_CRED~~~"~"   OP =~"<=~"    EXP2 =~":fecha_proc~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"OFERTA_V~~~".~~~"DSCTO_PLANILLA~~~"~"   OP =~"=~"    EXP2 =~"'S'~" ) )) ARG(NAME = ~"c_uf_dia~" TYPE = number)  ARG(NAME = ~"fecha_proc~" TYPE = datetime)  ARG(NAME = ~"fech_sistema~" TYPE = datetime) " arguments=(("c_uf_dia", number),("fecha_proc", datetime),("fech_sistema", datetime))  sort="convenio_retiro_cod_convenio A cliente_a_paterno A cliente_a_materno A cliente_nombre A " )
