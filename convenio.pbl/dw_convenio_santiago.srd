 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"contrato~" )  TABLE(NAME=~"cadena_mora~" )  TABLE(NAME=~"cliente~" )  TABLE(NAME=~"pagare~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"convenio_retiro~" ) COLUMN(NAME=~"contrato.rut~") COLUMN(NAME=~"cadena_mora.mora_cred~") COLUMN(NAME=~"cadena_mora.fecha_venc_cred~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"pagare.valor_cuo~") COLUMN(NAME=~"pagare.moneda~") COLUMN(NAME=~"convenio_retiro.cod_convenio~") COLUMN(NAME=~"contrato.parque~") COLUMN(NAME=~"pagare.plazo~") COLUMN(NAME=~"pagare.cta_pag_isa~") COLUMN(NAME=~"pagare.cta_pag_la~") COLUMN(NAME=~"pagare.fecha_prim~") COLUMN(NAME=~"pagare.serie_p~") COLUMN(NAME=~"pagare.nro_pagare~")    JOIN (LEFT=~"contrato.serie~"    OP =~"=~"RIGHT=~"pagare.serie_p~" )    JOIN (LEFT=~"contrato.nro_pagare~"    OP =~"=~"RIGHT=~"pagare.nro_pagare~" )    JOIN (LEFT=~"cadena_mora.serie~"    OP =~"=~"RIGHT=~"pagare.serie_p~" )    JOIN (LEFT=~"cadena_mora.numero~"    OP =~"=~"RIGHT=~"pagare.nro_pagare~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"cadena_mora.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"cadena_mora.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"cadena_mora.numero~" )    JOIN (LEFT=~"cliente.rut~"    OP =~"=~"RIGHT=~"pagare.rut~" )    JOIN (LEFT=~"convenio_retiro.cod_convenio~"    OP =~"=~"RIGHT=~"contrato.cod_convenio~" )WHERE(    EXP1 =~"~~~"CADENA_MORA~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~"'P'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"PAGARE~~~".~~~"PLAZO~~~"~"   OP =~">~"    EXP2 =~"(~~~"PAGARE~~~".~~~"CTA_PAG_LA~~~" + ~~~"PAGARE~~~".~~~"CTA_PAG_ISA~~~")~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'V'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CONTRATO~~~".~~~"COD_CONVENIO~~~"~"   OP =~"<>~"    EXP2 =~"0~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CONVENIO_RETIRO~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'A'~" ) ) "  sort="convenio_retiro_cod_convenio A " )
