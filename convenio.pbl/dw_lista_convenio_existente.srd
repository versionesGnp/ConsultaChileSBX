 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"convenio~" ) COLUMN(NAME=~"convenio.serie~") COLUMN(NAME=~"convenio.numero~") COLUMN(NAME=~"convenio.rut~") COLUMN(NAME=~"convenio.nombre~") COLUMN(NAME=~"convenio.ap_paterno~") COLUMN(NAME=~"convenio.ap_materno~") COLUMN(NAME=~"convenio.fecha_pago~") COLUMN(NAME=~"convenio.valor_cuota~") COLUMN(NAME=~"convenio.cod_convenio~") COLUMN(NAME=~"convenio.fecha_envio_carta~") COLUMN(NAME=~"convenio.cod_parque~") COLUMN(NAME=~"convenio.plazo~") COLUMN(NAME=~"convenio.cuotas_pag~") COLUMN(NAME=~"convenio.estado_impresion~") COLUMN(NAME=~"convenio.fecha_sistema~") COLUMN(NAME=~"convenio.estado_grabacion~") COLUMN(NAME=~"convenio.usuario~")WHERE(    EXP1 =~"~~~"CONVENIO~~~".~~~"FECHA_PAGO~~~"~"   OP =~"=~"    EXP2 =~":fecha~" ) ) ARG(NAME = ~"fecha~" TYPE = datetime) " update="CONVENIO" updatewhere=1 updatekeyinplace=no arguments=(("fecha", datetime))  sort="cod_convenio A ap_paterno A ap_materno A nombre A " )
