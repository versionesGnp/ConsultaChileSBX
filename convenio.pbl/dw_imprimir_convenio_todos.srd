table(column=(type=char(1) updatewhereclause=yes name=serie dbname="convenio.serie" )
 column=(type=decimal(4) updatewhereclause=yes name=numero dbname="convenio.numero" )
 column=(type=decimal(4) updatewhereclause=yes name=rut dbname="convenio.rut" )
 column=(type=char(40) updatewhereclause=yes name=ap_paterno dbname="convenio.ap_paterno" )
 column=(type=char(40) updatewhereclause=yes name=ap_materno dbname="convenio.ap_materno" )
 column=(type=datetime updatewhereclause=yes name=fecha_pago dbname="convenio.fecha_pago" )
 column=(type=decimal(4) updatewhereclause=yes name=valor_cuota dbname="convenio.valor_cuota" )
 column=(type=decimal(4) updatewhereclause=yes name=cod_convenio dbname="convenio.cod_convenio" )
 column=(type=char(1000) updatewhereclause=yes name=convenio_retiro_glosa dbname="convenio_retiro.glosa" )
 column=(type=char(2) updatewhereclause=yes name=convenio_retiro_moneda dbname="convenio_retiro.moneda" )
 column=(type=char(1000) updatewhereclause=yes name=convenio_retiro_direccion dbname="convenio_retiro.direccion" )
 column=(type=char(100) updatewhereclause=yes name=convenio_retiro_contacto dbname="convenio_retiro.contacto" )
 column=(type=datetime updatewhereclause=yes name=convenio_fecha_envio_carta dbname="convenio.fecha_envio_carta" )
 column=(type=decimal(4) updatewhereclause=yes name=convenio_cod_parque dbname="convenio.cod_parque" )
 column=(type=char(40) updatewhereclause=yes name=nombre dbname="convenio.nombre" )
 column=(type=decimal(4) updatewhereclause=yes name=convenio_plazo dbname="convenio.plazo" )
 column=(type=decimal(0) updatewhereclause=yes name=convenio_cuotas_pag dbname="convenio.cuotas_pag" )
 column=(type=char(1) updatewhereclause=yes name=convenio_estado_impresion dbname="convenio.estado_impresion" )
 column=(type=datetime updatewhereclause=yes name=convenio_fecha_sistema dbname="convenio.fecha_sistema" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"convenio~" )  TABLE(NAME=~"convenio_retiro~" ) COLUMN(NAME=~"convenio.serie~") COLUMN(NAME=~"convenio.numero~") COLUMN(NAME=~"convenio.rut~") COLUMN(NAME=~"convenio.ap_paterno~") COLUMN(NAME=~"convenio.ap_materno~") COLUMN(NAME=~"convenio.fecha_pago~") COLUMN(NAME=~"convenio.valor_cuota~") COLUMN(NAME=~"convenio.cod_convenio~") COLUMN(NAME=~"convenio_retiro.glosa~") COLUMN(NAME=~"convenio_retiro.moneda~") COLUMN(NAME=~"convenio_retiro.direccion~") COLUMN(NAME=~"convenio_retiro.contacto~") COLUMN(NAME=~"convenio.fecha_envio_carta~") COLUMN(NAME=~"convenio.cod_parque~") COLUMN(NAME=~"convenio.nombre~") COLUMN(NAME=~"convenio.plazo~") COLUMN(NAME=~"convenio.cuotas_pag~") COLUMN(NAME=~"convenio.estado_impresion~") COLUMN(NAME=~"convenio.fecha_sistema~")    JOIN (LEFT=~"convenio.cod_convenio~"    OP =~"=~"RIGHT=~"convenio_retiro.cod_convenio~" )WHERE(    EXP1 =~"~~~"CONVENIO~~~".~~~"FECHA_PAGO~~~"~"   OP =~"=~"    EXP2 =~":ldt_fecha_pago~" ) ) ARG(NAME = ~"ldt_fecha_pago~" TYPE = date) " arguments=(("ldt_fecha_pago", date))  sort="ap_paterno A " )
