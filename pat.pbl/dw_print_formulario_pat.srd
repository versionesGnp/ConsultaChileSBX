iginal~") COLUMN(NAME=~"sol_pat.ciudad_original~") COLUMN(NAME=~"sol_pat.fono_p_original~") COLUMN(NAME=~"sol_pat.fecha_nac_original~") COLUMN(NAME=~"sol_pat.estado_civil_original~") COLUMN(NAME=~"sol_pat.domicilio_c_original~") COLUMN(NAME=~"sol_pat.fono_c_original~") COLUMN(NAME=~"sol_pat.total_renta_original~") COLUMN(NAME=~"sol_pat.grupo_f_original~") COLUMN(NAME=~"sol_pat.estado_cod_original~") COLUMN(NAME=~"sol_pat.estado_ctto_original~") COLUMN(NAME=~"sol_pat.fecha_rescil_original~") COLUMN(NAME=~"sol_pat.area_sepultura~") COLUMN(NAME=~"sol_pat.sector_sepultura~") COLUMN(NAME=~"sol_pat.sepultura~") COLUMN(NAME=~"sol_pat.capacidad~") COLUMN(NAME=~"sol_pat.fecha_contrato~") COLUMN(NAME=~"sol_pat.tipo_via_original~") COLUMN(NAME=~"sol_pat.numero_particular_original~") COLUMN(NAME=~"sol_pat.depto_particular_original~") COLUMN(NAME=~"sol_pat.block_particular_original~") COLUMN(NAME=~"sol_pat.fecha_sistema~") COLUMN(NAME=~"sol_pat.cod_banco~") COLUMN(NAME=~"sol_pat.tipo_cuenta~") COLUMN(NAME=~"sol_pat.monto_cuota_cred~") COLUMN(NAME=~"sol_pat.monto_cuota_mant~") COLUMN(NAME=~"sol_pat.fecha_venc_cred~") COLUMN(NAME=~"sol_pat.fecha_venc_mant~") COLUMN(NAME=~"sol_pat.fecha_cobro_pac~") COLUMN(NAME=~"sol_pat.fecha_suscripcion~") COLUMN(NAME=~"sol_pat.numero_cuenta~") COLUMN(NAME=~"sol_pat.fecha_cobro_pac_mant~") COLUMN(NAME=~"tipo_via.descripcion~") COLUMN(NAME=~"cadena.cod_parque~")    JOIN (LEFT=~"sol_estatus.base~"    OP =~"=~"RIGHT=~"sol_pat.base~" )    JOIN (LEFT=~"sol_estatus.serie~"    OP =~"=~"RIGHT=~"sol_pat.serie~" )    JOIN (LEFT=~"sol_estatus.numero~"    OP =~"=~"RIGHT=~"sol_pat.numero~" )    JOIN (LEFT=~"sol_estatus.correlativo~"    OP =~"=~"RIGHT=~"sol_pat.correlativo~" )    JOIN (LEFT=~"sol_pat.tipo_via~"    OP =~"=~"RIGHT=~"tipo_via.tipo_via~" )    JOIN (LEFT=~"sol_estatus.base~"    OP =~"=~"RIGHT=~"cadena.codigo~" )    JOIN (LEFT=~"sol_estatus.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"sol_estatus.numero~"    OP =~"=~"RIGHT=~"cadena.numero~" )WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"CODIGO_SOLICITUD~~~"~"   OP =~"=~"    EXP2 =~":tipo_sol~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"CORRELATIVO~~~"~"   OP =~"=~"    EXP2 =~":corr~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number)  ARG(NAME = ~"tipo_sol~" TYPE = string)  ARG(NAME = ~"corr~" TYPE = number) " arguments=(("base", string),("serie", string),("numero", number),("tipo_sol", string),("corr", number)) )
