 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"gestion_cobranza~" )  TABLE(NAME=~"ingreso~" )  TABLE(NAME=~"tele_log~" ) COLUMN(NAME=~"gestion_cobranza.base~") COLUMN(NAME=~"gestion_cobranza.serie~") COLUMN(NAME=~"gestion_cobranza.numero~") COLUMN(NAME=~"ingreso.tipo_mov~") COLUMN(NAME=~"ingreso.monto~") COLUMN(NAME=~"ingreso.tipo_cob~") COLUMN(NAME=~"ingreso.folio~")    JOIN (LEFT=~"gestion_cobranza.base~"    OP =~"=~"RIGHT=~"tele_log.base~" )    JOIN (LEFT=~"gestion_cobranza.serie~"    OP =~"=~"RIGHT=~"tele_log.serie~" )    JOIN (LEFT=~"gestion_cobranza.numero~"    OP =~"=~"RIGHT=~"tele_log.numero~" )    JOIN (LEFT=~"gestion_cobranza.base~"    OP =~"=~"RIGHT=~"ingreso.base~" )    JOIN (LEFT=~"gestion_cobranza.serie~"    OP =~"=~"RIGHT=~"ingreso.serie~" )    JOIN (LEFT=~"gestion_cobranza.numero~"    OP =~"=~"RIGHT=~"ingreso.contrato~" )WHERE(    EXP1 =~"(~~~"GESTION_COBRANZA~~~".~~~"FECHA_ASIGNACION~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"GESTION_COBRANZA~~~".~~~"FECHA_ASIGNACION~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"GESTION_COBRANZA~~~".~~~"USUARIO_ASIGNADO~~~"~"   OP =~"=~"    EXP2 =~":usuario)~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"(~~~"TELE_LOG~~~".~~~"FECHA~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"TELE_LOG~~~".~~~"FECHA~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"TELE_LOG~~~".~~~"USUARIO~~~"~"   OP =~"=~"    EXP2 =~":usuario~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"(~~~"TELE_LOG~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'0'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"TELE_LOG~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'1'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"TELE_LOG~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'2'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"TELE_LOG~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'11') )~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"(~~~"INGRESO~~~".~~~"FE