UMN(NAME=~"reclamo_solicitud.a_paterno_contacto~") COLUMN(NAME=~"reclamo_solicitud.a_materno_contacto~") COLUMN(NAME=~"reclamo_solicitud.depto_asig~") COLUMN(NAME=~"reclamo_solicitud.depto_crea~") COMPUTE(NAME=~"( SELECT ~~~"ESD1~~~".~~~"USUARIO_CREA~~~" FROM ~~~"RECLAMO_SOLICITUD_DETALLE~~~" ~~~"ESD1~~~" WHERE ~~~"ESD1~~~".~~~"NUMERO_RECLAMO~~~" = ~~~"RECLAMO_SOLICITUD~~~".~~~"NUMERO_RECLAMO~~~" AND ~~~"ESD1~~~".~~~"CODIGO_GESTION~~~" <> 99 AND ~~~"ESD1~~~".~~~"CODIGO_GESTION~~~" = ( SELECT MIN(~~~"ESD2~~~".~~~"CODIGO_GESTION~~~") FROM ~~~"RECLAMO_SOLICITUD_DETALLE~~~" ~~~"ESD2~~~" WHERE ~~~"ESD2~~~".~~~"NUMERO_RECLAMO~~~" = ~~~"RECLAMO_SOLICITUD~~~".~~~"NUMERO_RECLAMO~~~" AND ~~~"ESD2~~~".~~~"CODIGO_GESTION~~~" <> 99 AND ~~~"ESD2~~~".~~~"FECHA_GESTION~~~" = ( SELECT MIN(~~~"ESD3~~~".~~~"FECHA_GESTION~~~") FROM ~~~"RECLAMO_SOLICITUD_DETALLE~~~" ~~~"ESD3~~~" WHERE ~~~"ESD3~~~".~~~"NUMERO_RECLAMO~~~" = ~~~"RECLAMO_SOLICITUD~~~".~~~"NUMERO_RECLAMO~~~" AND ~~~"ESD3~~~".~~~"CODIGO_GESTION~~~" <> 99 )) AND ~~~"ESD1~~~".~~~"FECHA_GESTION~~~" = ( SELECT MIN(~~~"ESD3~~~".~~~"FECHA_GESTION~~~") FROM ~~~"RECLAMO_SOLICITUD_DETALLE~~~" ~~~"ESD3~~~" WHERE ~~~"ESD3~~~".~~~"NUMERO_RECLAMO~~~" = ~~~"RECLAMO_SOLICITUD~~~".~~~"NUMERO_RECLAMO~~~" AND ~~~"ESD3~~~".~~~"CODIGO_GESTION~~~" <> 99 )) AS USER_CREACION~") COMPUTE(NAME=~"(SELECT ~~~"ENCARGADOS~~~".~~~"NOMBRE~~~" FROM ~~~"ENCARGADOS~~~" WHERE ~~~"ENCARGADOS~~~".~~~"CODIGO_USUARIO~~~" = ( SELECT ~~~"ESD1~~~".~~~"USUARIO_CREA~~~" FROM ~~~"RECLAMO_SOLICITUD_DETALLE~~~" ~~~"ESD1~~~" WHERE ~~~"ESD1~~~".~~~"NUMERO_RECLAMO~~~" = ~~~"RECLAMO_SOLICITUD~~~".~~~"NUMERO_RECLAMO~~~" AND ~~~"ESD1~~~".~~~"CODIGO_GESTION~~~" <> 99 AND ~~~"ESD1~~~".~~~"CODIGO_GESTION~~~" = ( SELECT 	MIN(~~~"ESD2~~~".~~~"CODIGO_GESTION~~~") FROM ~~~"RECLAMO_SOLICITUD_DETALLE~~~" ~~~"ESD2~~~" WHERE ~~~"ESD2~~~".~~~"NUMERO_RECLAMO~~~" = ~~~"RECLAMO_SOLICITUD~~~".~~~"NUMERO_RECLAMO~~~" AND~~~"ESD2~~~".~~~"CODIGO_GESTION~~~" <> 99 AND ~~~"ESD2~~~".~~~"FECHA_GESTION~~~" = ( SELECT MIN(~~~"ESD3~~~".~~~"FECHA_GESTION~~~") FROM ~~~"RECLAMO_SOLICITUD_DETALLE~~~" ~~~"ESD3~~~" WHERE ~~~"ESD3~~~".~~~"NUMERO_RECLAMO~~~" = ~~~"RECLAMO_SOLICITUD~~~".~~~"NUMERO_RECLAMO~~~" AND~~~"ESD3~~~".~~~"CODIGO_GESTION~~~" <> 99 )) AND ~~~"ESD1~~~".~~~"FECHA_GESTION~~~" = ( SELECT MIN(~~~"ESD3~~~".~~~"FECHA_GESTION~~~") FROM ~~~"RECLAMO_SOLICITUD_DETALLE~~~" ~~~"ESD3~~~" WHERE ~~~"ESD3~~~".~~~"NUMERO_RECLAMO~~~" = ~~~"RECLAMO_SOLICITUD~~~".~~~"NUMERO_RECLAMO~~~" AND ~~~"ESD3~~~".~~~"CODIGO_GESTION~~~" <> 99 ))) AS USER_NOMBRE~") COMPUTE(NAME=~"( SELECT ~~~"ESD1~~~".~~~"FECHA_CREA~~~" FROM ~~~"RECLAMO_SOLICITUD_DETALLE~~~" ~~~"ESD1~~~" WHERE ~~~"ESD1~~~".~~~"NUMERO_RECLAMO~~~" = ~~~"RECLAMO_SOLICITUD~~~".~~~"NUMERO_RECLAMO~~~" AND ~~~"ESD1~~~".~~~"CODIGO_GESTION~~~" <> 99 AND ~~~"ESD1~~~".~~~"CODIGO_GESTION~~~" = ( SELECT MIN(~~~"ESD2~~~".~~~"CODIGO_GESTION~~~") FROM ~~~"RECLAMO_SOLICITUD_DETALLE~~~" ~~~"ESD2~~~" WHERE ~~~"ESD2~~~".~~~"NUMERO_RECLAMO~~~" = ~~~"RECLAMO_SOLICITUD~~~".~~~"NUMERO_RECLAMO~~~" AND ~~~"ESD2~~~".~~~"CODIGO_GESTION~~~" <> 99 AND ~~~"ESD2~~~".~~~"FECHA_GESTION~~~" = ( SELECT MIN(~~~"ESD3~~~".~~~"FECHA_GESTION~~~") FROM ~~~"RECLAMO_SOLICITUD_DETALLE~~~" ~~~"ESD3~~~" WHERE ~~~"ESD3~~~".~~~"NUMERO_RECLAMO~~~" = ~~~"RECLAMO_SOLICITUD~~~".~~~"NUMERO_RECLAMO~~~" AND ~~~"ESD3~~~".~~~"CODIGO_GESTION~~~" <> 99 )) AND ~~~"ESD1~~~".~~~"FECHA_GESTION~~~" = ( SELECT MIN(~~~"ESD3~~~".~~~"FECHA_GESTION~~~") FROM ~~~"RECLAMO_SOLICITUD_DETALLE~~~" ~~~"ESD3~~~" WHERE ~~~"ESD3~~~".~~~"NUMERO_RECLAMO~~~" = ~~~"RECLAMO_SOLICITUD~~~".~~~"NUMERO_RECLAMO~~~" AND ~~~"ESD3~~~".~~~"CODIGO_GESTION~~~" <> 99 )) AS FECHA_CREACION~") COLUMN(NAME=~"reclamo_solicitud_detalle.fecha_compromiso~")    JOIN (LEFT=~"reclamo_solicitud.cod_parque~"    OP =~"=~"RIGHT=~"cod_parq.codigo~"    OUTER1 =~"reclamo_solicitud.cod_parque~" )    JOIN (LEFT=~"reclamo_solicitud.tipo_solicitud~"    OP =~"=~"RIGHT=~"reclamo_tipo_solicitud.tipo_solicitud~"    OUTER1 =~"reclamo_solicitud.tipo_solicitud~" )    JOIN (LEFT=~"reclamo_solicitud.codigo_solicitud~"    OP =~"=~"RIGHT=~"reclamo_codigo_tipo.codigo_reclamo~"    OUTER1 =~"reclamo_solicitud.codigo_solicitud~" )    JOIN (LEFT=~"reclamo_solicitud.codigo_reclamo~"    OP =~"=~"RIGHT=~"reclamo_codigo_reclamo.codigo~"    OUTER1 =~"reclamo_solicitud.codigo_reclamo~" )    JOIN (LEFT=~"reclamo_solicitud.origen~"    OP =~"=~"RIGHT=~"reclamo_origen.codigo_origen~"    OUTER1 =~"reclamo_solicitud.origen~" )    JOIN (LEFT=~"reclamo_solicitud.usuario_asignado~"    OP =~"=~"RIGHT=~"encargados_a.codigo_usuario~" )    JOIN (LEFT=~"reclamo_solicitud.usuario_crea~"    OP =~"=~"RIGHT=~"encargados_b.codigo_usuario~" )    JOIN (LEFT=~"reclamo_solicitud.numero_reclamo~"    OP =~"=~"RIGHT=~"reclamo_solicitud_detalle.numero_reclamo~" )WHERE(    EXP1 =~"~~~"RECLAMO_SOLICITUD~~~".~~~"FECHA_CREA~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"RECLAMO_SOLICITUD~~~".~~~"FECHA_CREA~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"RECLAMO_SOLICITUD_DETALLE~~~".~~~"FECHA_COMPROMISO~~~"~"   OP =~"is not~"    EXP2 =~"null~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = datetime)  ARG(NAME = ~"fecha_fin~" TYPE = datetime) " arguments=(("fecha_ini", datetime),("fecha_fin", datetime))  sort="cod_parque A user_creacion A numero_reclamo A " )
