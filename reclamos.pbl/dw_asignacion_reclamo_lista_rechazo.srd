 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"reclamo_solicitud~" )  TABLE(NAME=~"reclamo_usuario_responsable~" )  TABLE(NAME=~"cliente~" )  TABLE(NAME=~"reclamo_solicitud_detalle~" ) COLUMN(NAME=~"reclamo_solicitud.codigo_solicitud~") COLUMN(NAME=~"reclamo_solicitud.fecha_crea~") COLUMN(NAME=~"reclamo_solicitud.usuario_crea~") COLUMN(NAME=~"reclamo_solicitud.ult_estado_gestion~") COLUMN(NAME=~"reclamo_solicitud.ult_fecha_gestion~") COLUMN(NAME=~"reclamo_solicitud.ult_glosa_gestion~") COLUMN(NAME=~"reclamo_solicitud.usuario_asignado~") COLUMN(NAME=~"reclamo_solicitud.cod_gerencia_asignado~") COLUMN(NAME=~"reclamo_solicitud.email~") COLUMN(NAME=~"reclamo_solicitud.fono_particular~") COLUMN(NAME=~"reclamo_solicitud.fono_comercial~") COLUMN(NAME=~"reclamo_solicitud.celular~") COLUMN(NAME=~"reclamo_solicitud.base~") COLUMN(NAME=~"reclamo_solicitud.serie~") COLUMN(NAME=~"reclamo_solicitud.numero~") COLUMN(NAME=~"reclamo_solicitud.rut_titular~") COLUMN(NAME=~"reclamo_solicitud.cod_estado_reg~") COLUMN(NAME=~"reclamo_solicitud.area~") COLUMN(NAME=~"reclamo_solicitud.sector~") COLUMN(NAME=~"reclamo_solicitud.sepultura~") COLUMN(NAME=~"reclamo_solicitud.codigo_reclamo~") COLUMN(NAME=~"reclamo_solicitud.glosa_reclamo_original~") COLUMN(NAME=~"reclamo_solicitud.depto_crea~") COLUMN(NAME=~"reclamo_solicitud.depto_asig~") COLUMN(NAME=~"reclamo_solicitud.rut_contacto~") COLUMN(NAME=~"reclamo_solicitud.nombre_contacto~") COLUMN(NAME=~"reclamo_solicitud.a_paterno_contacto~") COLUMN(NAME=~"reclamo_solicitud.a_materno_contacto~") COLUMN(NAME=~"reclamo_solicitud.cod_parque~") COLUMN(NAME=~"reclamo_solicitud.nivel~") COLUMN(NAME=~"reclamo_solicitud.numero_reclamo~") COMPUTE(NAME=~"sysdate as c_fecha_compromiso~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"reclamo_solicitud.numero_reclamo_original~") COLUMN(NAME=~"reclamo_solicitud.tipo_solicitud~") COLUMN(NAME=~"reclamo_solicitud_detalle.depto_asig~")    JOIN (LEFT=~"reclamo_solicitud.rut_titular~"    OP =~"=~"RIGHT=~"cliente.rut~"    OUTER1 =~"reclamo_solicitud.rut_titular~" )    JOIN (LEFT=~"reclamo_solicitud.usuario_asignado~"    OP =~"=~"RIGHT=~"reclamo_usuario_responsable.usuario_asignado~" )    JOIN (LEFT=~"reclamo_solicitud.numero_reclamo~"    OP =~"=~"RIGHT=~"reclamo_solicitud_detalle.numero_reclamo~" )WHERE(    EXP1 =~"~~~"RECLAMO_SOLICITUD~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":cod_parque~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"RECLAMO_SOLICITUD~~~".~~~"ULT_FECHA_GESTION~~~"~"   OP =~">=~"    EXP2 =~":fec_ini~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"RECLAMO_SOLICITUD~~~".~~~"ULT_FECHA_GESTION~~~"~"   OP =~"<=~"    EXP2 =~":fec_fin~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"RECLAMO_SOLICITUD~~~".~~~"ULT_ESTADO_GESTION~~~"~"   OP =~"=~"    EXP2 =~"3~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"RECLAMO_SOLICITUD_DETALLE~~~".~~~"CODIGO_GESTION~~~"~"   OP =~"=~"    EXP2 =~"1~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"RECLAMO_SOLICITUD_DETALLE~~~".~~~"USUARIO_CREA~~~"~"   OP =~"=~"    EXP2 =~":usuario~" ) ) ARG(NAME = ~"cod_parque~" TYPE = number)  ARG(NAME = ~"fec_ini~" TYPE = datetime)  ARG(NAME = ~"fec_fin~" TYPE = datetime)  ARG(NAME = ~"depto~" TYPE = string)  ARG(NAME = ~"usuario~" TYPE = string) " arguments=(("cod_parque", number),("fec_ini", datetime),("fec_fin", datetime),("depto", string),("usuario", string))  sort="numero_reclamo A " )
