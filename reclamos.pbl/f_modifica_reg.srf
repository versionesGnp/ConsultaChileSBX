SELECT	"BASE",	"SERIE",	"NUMERO",	"COD_ESTADO_REG",	"NOMBRE_CONTACTO",	"A_PATERNO_CONTACTO",	"A_MATERNO_CONTACTO",	"RUT_CONTACTO",	"EMAIL",		"FONO_PARTICULAR",	"FONO_COMERCIAL",	"CELULAR",	"AREA",	"SECTOR",	"SEPULTURA"  
INTO 		:ls_base,	:ls_serie,	:ll_numero,	:ls_estado_reg,			:ls_nombre,					:ls_a_pater,						:ls_a_mater,					:ll_rut	,					:ls_email,	:ls_fono_part,				:ls_fono_comer	,		:ls_celular,	:ls_area,	:ls_sector,	:ls_sepult   
FROM	 	"RECLAMO_SOLICITUD"
WHERE 	"RECLAMO_SOLICITUD"."COD_PARQUE" = :al_parque AND  
         	"RECLAMO_SOLICITUD"."CODIGO_SOLICITUD" = :as_cod_solic AND  
         	"RECLAMO_SOLICITUD"."FECHA_CREA" = :adt_fec_crea AND  
         	"RECLAMO_SOLICITUD"."ULT_ESTADO_GESTION" = :al_cod_gest AND  
