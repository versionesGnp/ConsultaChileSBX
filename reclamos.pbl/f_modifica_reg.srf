			UPDATE	"RECLAMO_SOLICITUD"  
			SET		"BASE" = :as_base  
			WHERE 	"RECLAMO_SOLICITUD"."COD_PARQUE" = :al_parque AND  
						"RECLAMO_SOLICITUD"."CODIGO_SOLICITUD" = :as_cod_solic AND  
						"RECLAMO_SOLICITUD"."FECHA_CREA" = :adt_fec_crea AND  
