		ls_pasa_base,ls_pasa_serie,ls_pasa_numero,ls_numero,ls_pasa_reg,ls_pasa_nomb,ls_pasa_a_pater,ls_pasa_a_mater,ls_rut,ls_pasa_rut,ls_pasa_email,&
		ls_pasa_f_part,ls_pasa_f_comer,ls_pasa_celu,ls_pasa_area,ls_pasa_sector,ls_pasa_sepult
