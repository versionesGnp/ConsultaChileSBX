	if ls_pasa_rut= 'S' then
		ls_rut							= '; '+ls_rut
	else
		ls_rut							= ''
	end if
	if ls_pasa_email = 'S' then
		ls_email						= '; '+ls_email
	else
		ls_email						= ''	
	end if
	if ls_pasa_f_part = 'S' then
		ls_fono_part					= '; '+ls_fono_part
	else
		ls_fono_part					= ''
	end if
	if ls_pasa_f_comer = 'S' then
		ls_fono_comer				= '; '+ls_fono_comer
	else
		ls_fono_comer				= ''
	end if
	if ls_pasa_celu = 'S' then
		ls_celular					= '; '+ls_celular
	else
		ls_celular					= ''
	end if
	if ls_pasa_area = 'S' then
		ls_area						= '; '+ls_area
	else
		ls_area						= ''
	end if
	if ls_pasa_sector = 'S' then
		ls_sector						= '; '+ls_sector
	else
		ls_sector						= ''
	end if
	if ls_pasa_sepult = 'S' then
		ls_sepult						= '; '+ls_sepult
	else
		ls_sepult						= ''
	end if
 end if
 if ll_grabar>0 then
	ls_glosa							= ls_base+ls_serie+ls_numero+ls_estado_reg+ls_nombre+ls_a_pater+ls_a_mater+ls_rut+ls_email+ls_fono_part+ls_fono_comer+ls_celular+ls_area+ls_sector+ls_sepult
else
	ls_glosa							= ''
end if
if isnull(ls_glosa) then ls_glosa=''
Return ls_glosa
end function

