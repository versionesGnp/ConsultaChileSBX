 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"reclamo_solicitud~" )  TABLE(NAME=~"reclamo_codigo_reclamo~" )  TABLE(NAME=~"reclamo_codigo_tipo~" )  TABLE(NAME=~"reclamo_tipo_solicitud~" ) COLUMN(NAME=~"reclamo_solicitud.numero_reclamo~") COLUMN(NAME=~"reclamo_solicitud.codigo_solicitud~") COLUMN(NAME=~"reclamo_codigo_tipo.descripcion~") COLUMN(NAME=~"reclamo_solicitud.fecha_crea~") COLUMN(NAME=~"reclamo_solicitud.usuario_crea~") COLUMN(NAME=~"reclamo_solicitud.ult_estado_gestion~") COLUMN(NAME=~"reclamo_solicitud.ult_fecha_gestion~") COLUMN(NAME=~"reclamo_solicitud.ult_glosa_gestion~") COLUMN(NAME=~"reclamo_solicitud.usuario_asignado~") COLUMN(NAME=~"reclamo_solicitud.cod_gerencia_asignado~") COLUMN(NAME=~"reclamo_solicitud.email~") COLUMN(NAME=~"reclamo_solicitud.fono_particular~") COLUMN(NAME=~"reclamo_solicitud.fono_comercial~") COLUMN(NAME=~"reclamo_solicitud.celular~") COLUMN(NAME=~"reclamo_solicitud.base~") COLUMN(NAME=~"reclamo_solicitud.serie~") COLUMN(NAME=~"reclamo_solicitud.numero~") COLUMN(NAME=~"reclamo_solicitud.rut_titular~") COLUMN(NAME=~"reclamo_solicitud.cod_estado_reg~") COLUMN(NAME=~"reclamo_solicitud.area~") COLUMN(NAME=~"reclamo_solicitud.sector~") COLUMN(NAME=~"reclamo_solicitud.sepultura~") COLUMN(NAME=~"reclamo_solicitud.codigo_reclamo~") COLUMN(NAME=~"reclamo_solicitud.glosa_reclamo_original~") COLUMN(NAME=~"reclamo_solicitud.depto_crea~") COLUMN(NAME=~"reclamo_solicitud.depto_asig~") COLUMN(NAME=~"reclamo_solicitud.rut_contacto~") COLUMN(NAME=~"reclamo_solicitud.nombre_contacto~") COLUMN(NAME=~"reclamo_solicitud.a_paterno_contacto~") COLUMN(NAME=~"reclamo_solicitud.a_materno_contacto~") COLUMN(NAME=~"reclamo_solicitud.cod_parque~") COLUMN(NAME=~"reclamo_solicitud.nivel~") COLUMN(NAME=~"reclamo_solicitud.usuario_modif~") COLUMN(NAME=~"reclamo_solicitud.fecha_modif~") COLUMN(NAME=~"reclamo_solicitud.origen~") COLUMN(NAME=~"reclamo_codigo_reclamo.descripcion~") COLUMN(NAME=~"reclamo_tipo_solicitud.descripcion~") COLUMN(NAME=~"reclamo_solicitud.tipo_solicitud~") COLUMN(NAME=~"reclamo_solicitud.numero_reclamo_original~")    JOIN (LEFT=~"reclamo_solicitud.tipo_solicitud~"    OP =~"=~"RIGHT=~"reclamo_tipo_solicitud.tipo_solicitud~"    OUTER1 =~"reclamo_solicitud.tipo_solicitud~" )    JOIN (LEFT=~"reclamo_solicitud.codigo_reclamo~"    OP =~"=~"RIGHT=~"reclamo_codigo_reclamo.codigo~" )    JOIN (LEFT=~"reclamo_solicitud.codigo_solicitud~"    OP =~"=~"RIGHT=~"reclamo_codigo_tipo.codigo_reclamo~" )WHERE(    EXP1 =~"~~~"RECLAMO_SOLICITUD~~~".~~~"ULT_FECHA_GESTION~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"RECLAMO_SOLICITUD~~~".~~~"ULT_FECHA_GESTION~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"RECLAMO_SOLICITUD~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = datetime)  ARG(NAME = ~"fecha_fin~" TYPE = datetime)  ARG(NAME = ~"parque~" TYPE = number) " arguments=(("fecha_ini", datetime),("fecha_fin", datetime),("parque", number))  sort="numero_reclamo D " )
