 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"reclamo_solicitud~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"cliente~" ) COLUMN(NAME=~"reclamo_solicitud.numero_reclamo~") COLUMN(NAME=~"reclamo_solicitud.codigo_solicitud~") COLUMN(NAME=~"reclamo_solicitud.fecha_crea~") COLUMN(NAME=~"reclamo_solicitud.usuario_crea~") COLUMN(NAME=~"reclamo_solicitud.ult_estado_gestion~") COLUMN(NAME=~"reclamo_solicitud.ult_fecha_gestion~") COLUMN(NAME=~"reclamo_solicitud.ult_glosa_gestion~") COLUMN(NAME=~"reclamo_solicitud.usuario_asignado~") COLUMN(NAME=~"reclamo_solicitud.cod_gerencia_asignado~") COLUMN(NAME=~"reclamo_solicitud.email~") COLUMN(NAME=~"reclamo_solicitud.fono_particular~") COLUMN(NAME=~"reclamo_solicitud.fono_comercial~") COLUMN(NAME=~"reclamo_solicitud.celular~") COLUMN(NAME=~"reclamo_solicitud.base~") COLUMN(NAME=~"reclamo_solicitud.serie~") COLUMN(NAME=~"reclamo_solicitud.numero~") COLUMN(NAME=~"reclamo_solicitud.rut_titular~") COLUMN(NAME=~"reclamo_solicitud.cod_estado_reg~") COLUMN(NAME=~"reclamo_solicitud.area~") COLUMN(NAME=~"reclamo_solicitud.sector~") COLUMN(NAME=~"reclamo_solicitud.sepultura~") COLUMN(NAME=~"reclamo_solicitud.codigo_reclamo~") COLUMN(NAME=~"reclamo_solicitud.glosa_reclamo_original~") COLUMN(NAME=~"reclamo_solicitud.depto_crea~") COLUMN(NAME=~"reclamo_solicitud.depto_asig~") COLUMN(NAME=~"reclamo_solicitud.rut_contacto~") COLUMN(NAME=~"reclamo_solicitud.nombre_contacto~") COLUMN(NAME=~"reclamo_solicitud.a_paterno_contacto~") COLUMN(NAME=~"reclamo_solicitud.a_materno_contacto~") COLUMN(NAME=~"reclamo_solicitud.cod_parque~") COLUMN(NAME=~"reclamo_solicitud.nivel~") COLUMN(NAME=~"reclamo_solicitud.usuario_modif~") COLUMN(NAME=~"reclamo_solicitud.fecha_modif~") COLUMN(NAME=~"reclamo_solicitud.origen~") COLUMN(NAME=~"reclamo_solicitud.tipo_solicitud~") COLUMN(NAME=~"reclamo_solicitud.numero_reclamo_original~") COLUMN(NAME=~"cliente.estado_titular~") COLUMN(NAME=~"cliente.tipo_cliente~")    JOIN (LEFT=~"cadena.rut~"    OP =~"=~"RIGHT=~"cliente.rut~" )    JOIN (LEFT=~"reclamo_solicitud.base~"    OP =~"=~"RIGHT=~"cadena.codigo~" )    JOIN (LEFT=~"reclamo_solicitud.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"reclamo_solicitud.numero~"    OP =~"=~"RIGHT=~"cadena.numero~" )WHERE(    EXP1 =~"~~~"RECLAMO_SOLICITUD~~~".~~~"NUMERO_RECLAMO~~~"~"   OP =~"=~"    EXP2 =~":numero~" ) ) ARG(NAME = ~"numero~" TYPE = number) " update="RECLAMO_SOLICITUD" updatewhere=0 updatekeyinplace=yes arguments=(("numero", number))  sort="numero_reclamo A " )
