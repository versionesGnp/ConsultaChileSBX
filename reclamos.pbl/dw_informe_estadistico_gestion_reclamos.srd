 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"reclamo_solicitud~" ) COLUMN(NAME=~"reclamo_solicitud.ult_estado_gestion~") COMPUTE(NAME=~"to_date( to_char( ~~~"RECLAMO_SOLICITUD~~~".~~~"ULT_FECHA_GESTION~~~") ) as fecha_ult_gestion~")WHERE(    EXP1 =~"~~~"RECLAMO_SOLICITUD~~~".~~~"ULT_FECHA_GESTION~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"RECLAMO_SOLICITUD~~~".~~~"ULT_FECHA_GESTION~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~" )  GROUP(NAME=~"reclamo_solicitud.ult_estado_gestion~") GROUP(NAME=~"reclamo_solicitud.ult_fecha_gestion~")) ARG(NAME = ~"fecha_ini~" TYPE = datetime)  ARG(NAME = ~"fecha_fin~" TYPE = datetime) " arguments=(("fecha_ini", datetime),("fecha_fin", datetime))  sort="fecha_ult_gestion A " )
