 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"fallecidos~" ) COLUMN(NAME=~"fallecidos.base~") COLUMN(NAME=~"fallecidos.ss~") COLUMN(NAME=~"fallecidos.contrato~") COLUMN(NAME=~"fallecidos.cod_parque~") COLUMN(NAME=~"fallecidos.sector~") COLUMN(NAME=~"fallecidos.n_sep~") COLUMN(NAME=~"fallecidos.nombres~") COLUMN(NAME=~"fallecidos.ap_paterno~") COLUMN(NAME=~"fallecidos.ap_materno~") COLUMN(NAME=~"fallecidos.fec_sep~") COLUMN(NAME=~"fallecidos.fec_nac~") COLUMN(NAME=~"fallecidos.fec_fall~") COLUMN(NAME=~"fallecidos.nivel~") COLUMN(NAME=~"fallecidos.observaciones~") COLUMN(NAME=~"fallecidos.resolucion_traslado_nro~") COLUMN(NAME=~"fallecidos.otorgado_por~") COLUMN(NAME=~"fallecidos.causa_fall~") COLUMN(NAME=~"fallecidos.est~") COLUMN(NAME=~"fallecidos.rut~") COLUMN(NAME=~"fallecidos.dv~") COLUMN(NAME=~"fallecidos.enf_obl~")WHERE(    EXP1 =~"~~~"FALLECIDOS~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FALLECIDOS~~~".~~~"SECTOR~~~"~"   OP =~"=~"    EXP2 =~":sector~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FALLECIDOS~~~".~~~"N_SEP~~~"~"   OP =~"=~"    EXP2 =~":sepultura~" ) ) ARG(NAME = ~"parque~" TYPE = number)  ARG(NAME = ~"sector~" TYPE = string)  ARG(NAME = ~"sepultura~" TYPE = string) " arguments=(("parque", number),("sector", string),("sepultura", string))  sort="nombres A ap_paterno A ap_materno A " )
