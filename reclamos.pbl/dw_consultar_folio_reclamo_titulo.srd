 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"reclamo_solicitud~" )  TABLE(NAME=~"cliente~" )  TABLE(NAME=~"reclamo_codigo_reclamo~" ) COLUMN(NAME=~"reclamo_solicitud.numero_reclamo~") COLUMN(NAME=~"reclamo_solicitud.codigo_solicitud~") COLUMN(NAME=~"reclamo_solicitud.ult_estado_gestion~") COLUMN(NAME=~"reclamo_solicitud.ult_fecha_gestion~") COLUMN(NAME=~"reclamo_solicitud.ult_glosa_gestion~") COLUMN(NAME=~"reclamo_solicitud.usuario_asignado~") COLUMN(NAME=~"reclamo_solicitud.base~") COLUMN(NAME=~"reclamo_solicitud.serie~") COLUMN(NAME=~"reclamo_solicitud.numero~") COLUMN(NAME=~"cliente.rut~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"reclamo_solicitud.area~") COLUMN(NAME=~"reclamo_solicitud.sector~") COLUMN(NAME=~"reclamo_solicitud.sepultura~") COLUMN(NAME=~"reclamo_solicitud.codigo_reclamo~") COLUMN(NAME=~"reclamo_solicitud.rut_contacto~") COLUMN(NAME=~"reclamo_solicitud.nombre_contacto~") COLUMN(NAME=~"reclamo_solicitud.a_paterno_contacto~") COLUMN(NAME=~"reclamo_solicitud.a_materno_contacto~") COLUMN(NAME=~"reclamo_solicitud.cod_parque~") COLUMN(NAME=~"reclamo_codigo_reclamo.descripcion~") COLUMN(NAME=~"reclamo_solicitud.rut_titular~")    JOIN (LEFT=~"reclamo_solicitud.rut_titular~"    OP =~"=~"RIGHT=~"cliente.rut~"    OUTER1 =~"reclamo_solicitud.rut_titular~" )    JOIN (LEFT=~"reclamo_solicitud.codigo_reclamo~"    OP =~"=~"RIGHT=~"reclamo_codigo_reclamo.codigo~" )WHERE(    EXP1 =~"~~~"RECLAMO_SOLICITUD~~~".~~~"NUMERO_RECLAMO~~~"~"   OP =~"=~"    EXP2 =~":folio~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"RECLAMO_SOLICITUD~~~".~~~"ULT_ESTADO_GESTION~~~"~"   OP =~"=~"    EXP2 =~":ult_gestion~" ) ) ARG(NAME = ~"folio~" TYPE = number)  ARG(NAME = ~"ult_gestion~" TYPE = number) " arguments=(("folio", number),("ult_gestion", number)) )
