 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"reclamo_solicitud~" )  TABLE(NAME=~"reclamo_solicitud_detalle~" ) COLUMN(NAME=~"reclamo_solicitud.fecha_crea~") COLUMN(NAME=~"reclamo_solicitud.usuario_crea~") COLUMN(NAME=~"reclamo_solicitud.ult_estado_gestion~") COLUMN(NAME=~"reclamo_solicitud.ult_fecha_gestion~") COLUMN(NAME=~"reclamo_solicitud.ult_glosa_gestion~") COLUMN(NAME=~"reclamo_solicitud.usuario_asignado~") COLUMN(NAME=~"reclamo_solicitud.cod_gerencia_asignado~") COLUMN(NAME=~"reclamo_solicitud.email~") COLUMN(NAME=~"reclamo_solicitud.fono_particular~") COLUMN(NAME=~"reclamo_solicitud.fono_comercial~") COLUMN(NAME=~"reclamo_solicitud.celular~") COLUMN(NAME=~"reclamo_solicitud.base~") COLUMN(NAME=~"reclamo_solicitud.serie~") COLUMN(NAME=~"reclamo_solicitud.numero~") COLUMN(NAME=~"reclamo_solicitud.rut_titular~") COLUMN(NAME=~"reclamo_solicitud.cod_estado_reg~") COLUMN(NAME=~"reclamo_solicitud.area~") COLUMN(NAME=~"reclamo_solicitud.sector~") COLUMN(NAME=~"reclamo_solicitud.sepultura~") COLUMN(NAME=~"reclamo_solicitud.codigo_reclamo~") COLUMN(NAME=~"reclamo_solicitud.glosa_reclamo_original~") COLUMN(NAME=~"reclamo_solicitud.depto_crea~") COLUMN(NAME=~"reclamo_solicitud.depto_asig~") COLUMN(NAME=~"reclamo_solicitud.rut_contacto~") COLUMN(NAME=~"reclamo_solicitud.nombre_contacto~") COLUMN(NAME=~"reclamo_solicitud.a_paterno_contacto~") COLUMN(NAME=~"reclamo_solicitud.a_materno_contacto~") COLUMN(NAME=~"reclamo_solicitud.cod_parque~") COLUMN(NAME=~"reclamo_solicitud.nivel~") COMPUTE(NAME=~"0 as c_marca~") COLUMN(NAME=~"reclamo_solicitud.usuario_modif~") COLUMN(NAME=~"reclamo_solicitud.fecha_modif~") COLUMN(NAME=~"reclamo_solicitud.codigo_solicitud~") COLUMN(NAME=~"reclamo_solicitud_detalle.observacion~") COLUMN(NAME=~"reclamo_solicitud_detalle.fecha_compromiso~") COLUMN(NAME=~"reclamo_solicitud.numero_reclamo~") COMPUTE(NAME=~"sysdate  AS c_max_fec_comp~") COLUMN(NAME=~"reclamo_solicitud.tipo_solicitud~") COLUMN(NAME=~"reclamo_solicitud.numero_reclamo_original~")    JOIN (LEFT=~"reclamo_solicitud.numero_reclamo~"    OP =~"=~"RIGHT=~"reclamo_solicitud_detalle.numero_reclamo~" )    JOIN (LEFT=~"reclamo_solicitud.ult_estado_gestion~"    OP =~"=~"RIGHT=~"reclamo_solicitud_detalle.codigo_gestion~" )    JOIN (LEFT=~"reclamo_solicitud.ult_fecha_gestion~"    OP =~"=~"RIGHT=~"reclamo_solicitud_detalle.fecha_gestion~" )WHERE(    EXP1 =~"~~~"RECLAMO_SOLICITUD~~~".~~~"NUMERO_RECLAMO~~~"~"   OP =~"=~"    EXP2 =~":num_reclamo~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"RECLAMO_SOLICITUD~~~".~~~"ULT_ESTADO_GESTION~~~"~"   OP =~"=~"    EXP2 =~":cod_gestion~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"RECLAMO_SOLICITUD~~~".~~~"ULT_FECHA_GESTION~~~"~"   OP =~"=~"    EXP2 =~":fecha_gestion~" ) ) ARG(NAME = ~"num_reclamo~" TYPE = number)  ARG(NAME = ~"cod_gestion~" TYPE = number)  ARG(NAME = ~"fecha_gestion~" TYPE = datetime) " arguments=(("num_reclamo", number),("cod_gestion", number),("fecha_gestion", datetime)) )
