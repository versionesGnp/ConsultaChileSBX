 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"encargados~" )  TABLE(NAME=~"encuesta~" )  TABLE(NAME=~"encuesta_evaluacion~" ) COLUMN(NAME=~"encuesta_evaluacion.cod_encuesta~") COLUMN(NAME=~"encuesta_evaluacion.puntos~") COLUMN(NAME=~"encuesta.folio~") COLUMN(NAME=~"encuesta.base~") COLUMN(NAME=~"encuesta.serie~") COLUMN(NAME=~"encuesta.numero~")    JOIN (LEFT=~"encargados.codigo_usuario~"    OP =~"=~"RIGHT=~"encuesta.usuario_crea~" )    JOIN (LEFT=~"encuesta.folio~"    OP =~"=~"RIGHT=~"encuesta_evaluacion.folio~" )    JOIN (LEFT=~"encuesta.rut~"    OP =~"=~"RIGHT=~"encuesta_evaluacion.rut~" )WHERE(    EXP1 =~"~~~"ENCUESTA~~~".~~~"FECHA_CREA~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"ENCUESTA~~~".~~~"FECHA_CREA~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"ENCARGADOS~~~".~~~"DEPTO~~~"~"   OP =~"=~"    EXP2 =~"'E'~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = datetime)  ARG(NAME = ~"fecha_fin~" TYPE = datetime) " arguments=(("fecha_ini", datetime),("fecha_fin", datetime))  sort="encuesta_evaluacion_puntos A " )
