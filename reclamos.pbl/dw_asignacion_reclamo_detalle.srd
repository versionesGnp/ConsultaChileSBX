 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"reclamo_solicitud_detalle~" )  TABLE(NAME=~"reclamo_solicitud~" ) COLUMN(NAME=~"reclamo_solicitud_detalle.codigo_solicitud~") COLUMN(NAME=~"reclamo_solicitud_detalle.fecha_crea~") COLUMN(NAME=~"reclamo_solicitud_detalle.usuario_crea~") COLUMN(NAME=~"reclamo_solicitud_detalle.codigo_gestion~") COLUMN(NAME=~"reclamo_solicitud_detalle.fecha_gestion~") COLUMN(NAME=~"reclamo_solicitud_detalle.observacion~") COLUMN(NAME=~"reclamo_solicitud_detalle.glosa_gestion~") COLUMN(NAME=~"reclamo_solicitud_detalle.rut_contacto~") COLUMN(NAME=~"reclamo_solicitud.usuario_asignado~") COLUMN(NAME=~"reclamo_solicitud.cod_gerencia_asignado~") COLUMN(NAME=~"reclamo_solicitud.email~") COLUMN(NAME=~"reclamo_solicitud.fono_particular~") COLUMN(NAME=~"reclamo_solicitud.fono_comercial~") COLUMN(NAME=~"reclamo_solicitud.celular~") COLUMN(NAME=~"reclamo_solicitud.base~") COLUMN(NAME=~"reclamo_solicitud.serie~") COLUMN(NAME=~"reclamo_solicitud.numero~") COLUMN(NAME=~"reclamo_solicitud.rut_titular~") COLUMN(NAME=~"reclamo_solicitud.cod_estado_reg~") COLUMN(NAME=~"reclamo_solicitud.area~") COLUMN(NAME=~"reclamo_solicitud.sector~") COLUMN(NAME=~"reclamo_solicitud.sepultura~") COLUMN(NAME=~"reclamo_solicitud.codigo_reclamo~") COLUMN(NAME=~"reclamo_solicitud.glosa_reclamo_original~") COLUMN(NAME=~"reclamo_solicitud.depto_crea~") COLUMN(NAME=~"reclamo_solicitud.depto_asig~") COLUMN(NAME=~"reclamo_solicitud.nombre_contacto~") COLUMN(NAME=~"reclamo_solicitud.a_paterno_contacto~") COLUMN(NAME=~"reclamo_solicitud.a_materno_contacto~") COLUMN(NAME=~"reclamo_solicitud_detalle.cod_parque~") COLUMN(NAME=~"reclamo_solicitud_detalle.usuario_asig~") COLUMN(NAME=~"reclamo_solicitud_detalle.depto_asig~") COLUMN(NAME=~"reclamo_solicitud_detalle.nivel~") COLUMN(NAME=~"reclamo_solicitud_detalle.fecha_compromiso~") COLUMN(NAME=~"reclamo_solicitud_detalle.numero_reclamo~")    JOIN (LEFT=~"reclamo_solicitud_detalle.numero_reclamo~"    OP =~"=~"RIGHT=~"reclamo_solicitud.numero_reclamo~" )WHERE(    EXP1 =~"~~~"RECLAMO_SOLICITUD_DETALLE~~~".~~~"NUMERO_RECLAMO~~~"~"   OP =~"=~"    EXP2 =~":numero_reclamo~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"RECLAMO_SOLICITUD_DETALLE~~~".~~~"FECHA_CREA~~~"~"   OP =~"=~"    EXP2 =~"(SELECT MAX(~~~"RECLAMO_SOLICITUD_DETALLE~~~".~~~"FECHA_CREA~~~") FROM ~~~"RECLAMO_SOLICITUD_DETALLE~~~" WHERE ~~~"RECLAMO_SOLICITUD_DETALLE~~~".~~~"NUMERO_RECLAMO~~~" = :numero_reclamo )~" ) ) ARG(NAME = ~"numero_reclamo~" TYPE = number) " arguments=(("numero_reclamo", number))  sort="fecha_gestion D " )
