 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"reclamo_solicitud_detalle~" )  TABLE(NAME=~"reclamo_solicitud~" ) COLUMN(NAME=~"reclamo_solicitud_detalle.codigo_solicitud~") COLUMN(NAME=~"reclamo_solicitud_detalle.fecha_crea~") COLUMN(NAME=~"reclamo_solicitud_detalle.usuario_crea~") COLUMN(NAME=~"reclamo_solicitud_detalle.codigo_gestion~") COLUMN(NAME=~"reclamo_solicitud_detalle.fecha_gestion~") COLUMN(NAME=~"reclamo_solicitud_detalle.observacion~") COLUMN(NAME=~"reclamo_solicitud_detalle.rut_contacto~") COLUMN(NAME=~"reclamo_solicitud_detalle.cod_parque~") COLUMN(NAME=~"reclamo_solicitud.nombre_contacto~") COLUMN(NAME=~"reclamo_solicitud.a_paterno_contacto~") COLUMN(NAME=~"reclamo_solicitud.a_materno_contacto~") COLUMN(NAME=~"reclamo_solicitud_detalle.usuario_asig~") COLUMN(NAME=~"reclamo_solicitud_detalle.depto_asig~") COLUMN(NAME=~"reclamo_solicitud_detalle.nivel~") COLUMN(NAME=~"reclamo_solicitud.glosa_reclamo_original~") COLUMN(NAME=~"reclamo_solicitud_detalle.glosa_gestion~") COLUMN(NAME=~"reclamo_solicitud_detalle.numero_reclamo~") COLUMN(NAME=~"reclamo_solicitud_detalle.fecha_compromiso~")    JOIN (LEFT=~"reclamo_solicitud_detalle.numero_reclamo~"    OP =~"=~"RIGHT=~"reclamo_solicitud.numero_reclamo~" )WHERE(    EXP1 =~"~~~"RECLAMO_SOLICITUD_DETALLE~~~".~~~"NUMERO_RECLAMO~~~"~"   OP =~"=~"    EXP2 =~":num_reclamo~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"RECLAMO_SOLICITUD_DETALLE~~~".~~~"CODIGO_GESTION~~~"~"   OP =~"=~"    EXP2 =~":cod_gestion~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"RECLAMO_SOLICITUD_DETALLE~~~".~~~"FECHA_GESTION~~~"~"   OP =~"=~"    EXP2 =~":fecha_gestion~" ) ) ARG(NAME = ~"num_reclamo~" TYPE = number)  ARG(NAME = ~"cod_gestion~" TYPE = number)  ARG(NAME = ~"fecha_gestion~" TYPE = datetime) " arguments=(("num_reclamo", number),("cod_gestion", number),("fecha_gestion", datetime)) )
