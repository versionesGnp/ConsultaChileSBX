 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"web_contacto~" )  TABLE(NAME=~"reclamo_permiso_admin~" ) COLUMN(NAME=~"web_contacto.indice_c~") COLUMN(NAME=~"web_contacto.rut_cotizante~") COLUMN(NAME=~"web_contacto.dv_cotizante~") COLUMN(NAME=~"web_contacto.nombre_cotizante~") COLUMN(NAME=~"web_contacto.email~") COLUMN(NAME=~"web_contacto.telefono~") COLUMN(NAME=~"web_contacto.tipo_contacto~") COLUMN(NAME=~"web_contacto.asunto~") COLUMN(NAME=~"web_contacto.rut_titular~") COLUMN(NAME=~"web_contacto.dv_titular~") COLUMN(NAME=~"web_contacto.nro_contrato~") COLUMN(NAME=~"web_contacto.nombre_titular~") COLUMN(NAME=~"web_contacto.fecha~") COLUMN(NAME=~"web_contacto.cod_parque~") COLUMN(NAME=~"web_contacto.correlativo~") COLUMN(NAME=~"web_contacto.ap_paterno_cotizante~") COLUMN(NAME=~"web_contacto.ap_materno_cotizante~") COLUMN(NAME=~"web_contacto.ap_paterno_titular~") COLUMN(NAME=~"web_contacto.ap_materno_titular~") COLUMN(NAME=~"web_contacto.estado_asigna~") COLUMN(NAME=~"web_contacto.fecha_asigna~")    JOIN (LEFT=~"web_contacto.tipo_contacto~"    OP =~"=~"RIGHT=~"reclamo_permiso_admin.codigo_reclamo~" )WHERE(    EXP1 =~"~~~"WEB_CONTACTO~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"WEB_CONTACTO~~~".~~~"ESTADO_ASIGNA~~~"~"   OP =~"=~"    EXP2 =~":estado_asig~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"RECLAMO_PERMISO_ADMIN~~~".~~~"USUARIO~~~"~"   OP =~"=~"    EXP2 =~":usuario~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"WEB_CONTACTO~~~".~~~"ESTADO_ASIGNA~~~"~"   OP =~"<>~"    EXP2 =~"'I'~" ) ) ARG(NAME = ~"parque~" TYPE = number)  ARG(NAME = ~"estado_asig~" TYPE = string)  ARG(NAME = ~"usuario~" TYPE = string) " update="WEB_CONTACTO" updatewhere=0 updatekeyinplace=yes arguments=(("parque", number),("estado_asig", string),("usuario", string))  sort="fecha A " )
