 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"reclamo_solicitud~" )  TABLE(NAME=~"reclamo_usuario_responsable~" ) COLUMN(NAME=~"reclamo_solicitud.ult_estado_gestion~") COLUMN(NAME=~"reclamo_solicitud.ult_fecha_gestion~") COLUMN(NAME=~"reclamo_solicitud.ult_glosa_gestion~") COLUMN(NAME=~"reclamo_solicitud.numero_reclamo~") COLUMN(NAME=~"reclamo_solicitud.area~") COLUMN(NAME=~"reclamo_solicitud.sector~") COLUMN(NAME=~"reclamo_solicitud.sepultura~") COLUMN(NAME=~"reclamo_solicitud.cod_parque~") COLUMN(NAME=~"reclamo_solicitud.fecha_crea~") COLUMN(NAME=~"reclamo_solicitud.base~") COLUMN(NAME=~"reclamo_solicitud.serie~") COLUMN(NAME=~"reclamo_solicitud.numero~") COLUMN(NAME=~"reclamo_solicitud.rut_titular~") COLUMN(NAME=~"reclamo_solicitud.glosa_reclamo_original~") COLUMN(NAME=~"reclamo_solicitud.codigo_reclamo~") COLUMN(NAME=~"reclamo_usuario_responsable.usuario_asigna~") COLUMN(NAME=~"reclamo_solicitud.usuario_asignado~")    JOIN (LEFT=~"reclamo_solicitud.usuario_asignado~"    OP =~"=~"RIGHT=~"reclamo_usuario_responsable.usuario_asignado~" )WHERE(    EXP1 =~"~~~"RECLAMO_SOLICITUD~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"RECLAMO_SOLICITUD~~~".~~~"ULT_FECHA_GESTION~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"RECLAMO_SOLICITUD~~~".~~~"ULT_FECHA_GESTION~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~" ) ) ARG(NAME = ~"parque~" TYPE = number)  ARG(NAME = ~"fecha_ini~" TYPE = datetime)  ARG(NAME = ~"fecha_fin~" TYPE = datetime)  ARG(NAME = ~"usuario~" TYPE = string) " update="RECLAMO_SOLICITUD" updatewhere=0 updatekeyinplace=yes arguments=(("parque", number),("fecha_ini", datetime),("fecha_fin", datetime),("usuario", string))  sort="ult_fecha_gestion A " )
