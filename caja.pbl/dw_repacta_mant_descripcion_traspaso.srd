 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"repacta_mantencion~" )  TABLE(NAME=~"tasa~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"cadena_mora~" ) COLUMN(NAME=~"repacta_mantencion.valor_cuota_uf~") COLUMN(NAME=~"repacta_mantencion.valor_cuota~") COLUMN(NAME=~"repacta_mantencion.ctas_pagadas~") COLUMN(NAME=~"repacta_mantencion.factor_aplicado~") COLUMN(NAME=~"repacta_mantencion.cuotas_pactadas~") COLUMN(NAME=~"repacta_mantencion.fecha_primera_cta~") COLUMN(NAME=~"repacta_mantencion.total_pagado~") COLUMN(NAME=~"repacta_mantencion.fecha_ult~") COLUMN(NAME=~"tasa.tasa_m~") COLUMN(NAME=~"tasa.tasa_a~") COLUMN(NAME=~"tasa.tasa_int_p~") COLUMN(NAME=~"tasa.tasa_int_uf~") COLUMN(NAME=~"repacta_mantencion.tipo_moneda~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"cadena.cod_parque~") COLUMN(NAME=~"cadena.estado_carta~") COLUMN(NAME=~"cadena_mora.mora_cred~") COLUMN(NAME=~"cadena_mora.dias_mora_cred~") COLUMN(NAME=~"cadena_mora.fecha_venc_cred~") COMPUTE(NAME=~"
to_date(sysdate) as fecha_pago~") COMPUTE(NAME=~"to_date(sysdate) as fecha_uf~") COLUMN(NAME=~"repacta_mantencion.pie~")    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"cadena_mora.serie~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"cadena_mora.base~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"cadena_mora.numero~" )    JOIN (LEFT=~"repacta_mantencion.base~"    OP =~"=~"RIGHT=~"cadena.codigo~" )    JOIN (LEFT=~"repacta_mantencion.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"repacta_mantencion.numero~"    OP =~"=~"RIGHT=~"cadena.numero~" )WHERE(    EXP1 =~"~~~"REPACTA_MANTENCION~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":as_base~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"REPACTA_MANTENCION~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"REPACTA_MANTENCION~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~" ) ) ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number)  ARG(NAME = ~"as_base~" TYPE = string) " arguments=(("serie", string),("numero", number),("as_base", string)) )
