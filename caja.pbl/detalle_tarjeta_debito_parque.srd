 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"bancos~" )  TABLE(NAME=~"documentos~" ) COLUMN(NAME=~"documentos.cod_pago~") COLUMN(NAME=~"documentos.n_cheque~") COLUMN(NAME=~"documentos.fecha_venc~") COLUMN(NAME=~"documentos.monto~") COLUMN(NAME=~"bancos.descripcion~") COLUMN(NAME=~"documentos.tipo_cob~") COLUMN(NAME=~"documentos.fecha_pago~") COLUMN(NAME=~"documentos.cod_tarjeta_debito~") COLUMN(NAME=~"documentos.cod_autorizacion_debito~") COLUMN(NAME=~"documentos.cod_banco_debito~") COLUMN(NAME=~"documentos.folio~") COLUMN(NAME=~"documentos.rezago~")    JOIN (LEFT=~"bancos.cod_banco~"    OP =~"=~"RIGHT=~"documentos.cod_banco~"    OUTER2 =~"documentos.cod_banco~" )WHERE(    EXP1 =~"(( ~~~"DOCUMENTOS~~~".~~~"COD_PAGO~~~"~"   OP =~"=~"    EXP2 =~"'TD'  )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(( ~~~"DOCUMENTOS~~~".~~~"COD_CAJA~~~"~"   OP =~"=~"    EXP2 =~":ca  )~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"( ~~~"DOCUMENTOS~~~".~~~"COD_CAJA~~~"~"   OP =~"=~"    EXP2 =~":ca2))~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"DOCUMENTOS~~~".~~~"FECHA_DEPOSITO~~~"~"   OP =~"=~"    EXP2 =~":fe ))~" ) ) ARG(NAME = ~"ca~" TYPE = string)  ARG(NAME = ~"fe~" TYPE = date)  ARG(NAME = ~"ca2~" TYPE = string)  ARG(NAME = ~"cod_parque~" TYPE = number) " filter="f_funcion_parque = cod_parque"arguments=(("ca", string),("fe", date),("ca2", string),("cod_parque", number)) )
