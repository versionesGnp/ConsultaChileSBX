 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"nota_de_credito~" ) COLUMN(NAME=~"nota_de_credito.tipo_cob~") COLUMN(NAME=~"nota_de_credito.folio~") COLUMN(NAME=~"nota_de_credito.fecha_pago~") COLUMN(NAME=~"nota_de_credito.tipo_mov~") COLUMN(NAME=~"nota_de_credito.estado~") COLUMN(NAME=~"nota_de_credito.monto~") COLUMN(NAME=~"nota_de_credito.cuotas_pag~") COLUMN(NAME=~"nota_de_credito.base~") COLUMN(NAME=~"nota_de_credito.serie~") COLUMN(NAME=~"nota_de_credito.numero~") COLUMN(NAME=~"nota_de_credito.tipo_cob_original~") COLUMN(NAME=~"nota_de_credito.folio_original~")WHERE(    EXP1 =~"~~~"NOTA_DE_CREDITO~~~".~~~"TIPO_COB_ORIGINAL~~~"~"   OP =~"=~"    EXP2 =~":tipo_cob_nc~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"NOTA_DE_CREDITO~~~".~~~"FOLIO_ORIGINAL~~~"~"   OP =~"=~"    EXP2 =~":folio_nc~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"NOTA_DE_CREDITO~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'A'~" ) ) ARG(NAME = ~"tipo_cob_nc~" TYPE = string)  ARG(NAME = ~"folio_nc~" TYPE = number) " update="NOTA_DE_CREDITO" updatewhere=1 updatekeyinplace=no arguments=(("tipo_cob_nc", string),("folio_nc", number)) )
