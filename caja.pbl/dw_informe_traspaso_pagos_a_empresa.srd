 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"documentos_traspaso~" ) COLUMN(NAME=~"documentos_traspaso.folio~") COLUMN(NAME=~"documentos_traspaso.tipo_cob~") COLUMN(NAME=~"documentos_traspaso.n_cheque~") COLUMN(NAME=~"documentos_traspaso.cod_banco~") COLUMN(NAME=~"documentos_traspaso.monto~") COLUMN(NAME=~"documentos_traspaso.fecha_venc~") COLUMN(NAME=~"documentos_traspaso.cod_pago~") COLUMN(NAME=~"documentos_traspaso.num_cheques~") COLUMN(NAME=~"documentos_traspaso.rezago~") COLUMN(NAME=~"documentos_traspaso.fecha_pago~") COLUMN(NAME=~"documentos_traspaso.cod_caja~") COLUMN(NAME=~"documentos_traspaso.estado_ch~") COLUMN(NAME=~"documentos_traspaso.glosa_ch~") COLUMN(NAME=~"documentos_traspaso.fecha_estado_ch~") COLUMN(NAME=~"documentos_traspaso.cod_tarjeta_credito~") COLUMN(NAME=~"documentos_traspaso.nro_cuotas_credito~") COLUMN(NAME=~"documentos_traspaso.cod_autorizacion_credito~") COLUMN(NAME=~"documentos_traspaso.tipo_tarjeta_credito~") COLUMN(NAME=~"documentos_traspaso.cod_tarjeta_debito~") COLUMN(NAME=~"documentos_traspaso.cod_autorizacion_debito~") COLUMN(NAME=~"documentos_traspaso.cod_banco_debito~") COLUMN(NAME=~"documentos_traspaso.traspado_pago~") COLUMN(NAME=~"documentos_traspaso.folio_documentos~") COLUMN(NAME=~"documentos_traspaso.tipo_cob_documentos~") COLUMN(NAME=~"documentos_traspaso.fecha_pago_documentos~") COLUMN(NAME=~"documentos_traspaso.codigo_caja_documentos~")WHERE(    EXP1 =~"~~~"DOCUMENTOS_TRASPASO~~~".~~~"FECHA_PAGO~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"DOCUMENTOS_TRASPASO~~~".~~~"FECHA_PAGO~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"substr( ~~~"DOCUMENTOS_TRASPASO~~~".~~~"TRASPADO_PAGO~~~" ,1,1)~"   OP =~"=~"    EXP2 =~":empresa~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = date)  ARG(NAME = ~"fecha_fin~" TYPE = date)  ARG(NAME = ~"empresa~" TYPE = string) " update="DOCUMENTOS_TRASPASO" updatewhere=1 updatekeyinplace=no arguments=(("fecha_ini", date),("fecha_fin", date),("empresa", string))  sort="tipo_cob A folio A fecha_venc A " )
