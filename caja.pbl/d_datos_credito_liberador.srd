 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"tasa~" ALIAS=~"tasa_a~" )  TABLE(NAME=~"anexo_liberador~" )  TABLE(NAME=~"pago_liberador~" )  TABLE(NAME=~"tasa~" ALIAS=~"tasa_b~" )  TABLE(NAME=~"cadena~" ) COLUMN(NAME=~"anexo_liberador.serie_m~") COLUMN(NAME=~"anexo_liberador.nro_liberador~") COLUMN(NAME=~"pago_liberador.valor_cuota~") COLUMN(NAME=~"pago_liberador.nro_cuotas~") COLUMN(NAME=~"pago_liberador.moneda~") COLUMN(NAME=~"pago_liberador.fecha_prim~") COLUMN(NAME=~"pago_liberador.fecha_ult~") COLUMN(NAME=~"pago_liberador.tasa~") COLUMN(NAME=~"anexo_liberador.cta_pag_m~") COLUMN(NAME=~"anexo_liberador.tot_pagado~") COLUMN(NAME=~"tasa_b.tasa_int_p~") COLUMN(NAME=~"tasa_b.tasa_int_uf~") COLUMN(NAME=~"cadena.estado~")    JOIN (LEFT=~"anexo_liberador.serie_m~"    OP =~"=~"RIGHT=~"pago_liberador.serie_m~" )    JOIN (LEFT=~"anexo_liberador.nro_liberador~"    OP =~"=~"RIGHT=~"pago_liberador.nro_liberador~" )    JOIN (LEFT=~"anexo_liberador.ult_folio~"    OP =~"=~"RIGHT=~"pago_liberador.folio~" )    JOIN (LEFT=~"anexo_liberador.serie_m~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"anexo_liberador.nro_liberador~"    OP =~"=~"RIGHT=~"cadena.numero~" )WHERE(    EXP1 =~"~~~"ANEXO_LIBERADOR~~~".~~~"SERIE_M~~~"~"   OP =~"=~"    EXP2 =~":as_serie~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"ANEXO_LIBERADOR~~~".~~~"NRO_LIBERADOR~~~"~"   OP =~"=~"    EXP2 =~":an_numero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'L'~" ) ) ARG(NAME = ~"as_serie~" TYPE = string)  ARG(NAME = ~"an_numero~" TYPE = number) " arguments=(("as_serie", string),("an_numero", number)) )
