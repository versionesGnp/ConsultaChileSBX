 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"detalle_cupon_ci~" ) COLUMN(NAME=~"detalle_cupon_ci.tipo_cob~") COLUMN(NAME=~"detalle_cupon_ci.folio~") COLUMN(NAME=~"detalle_cupon_ci.fecha~") COLUMN(NAME=~"detalle_cupon_ci.tipo_mov~") COLUMN(NAME=~"detalle_cupon_ci.num_cupon~") COLUMN(NAME=~"detalle_cupon_ci.monto~") COLUMN(NAME=~"detalle_cupon_ci.monto_mora~") COLUMN(NAME=~"detalle_cupon_ci.monto_gasto_cob~") COLUMN(NAME=~"detalle_cupon_ci.monto_total~")WHERE(    EXP1 =~"~~~"DETALLE_CUPON_CI~~~".~~~"TIPO_COB~~~"~"   OP =~"=~"    EXP2 =~":tipo_cob~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"DETALLE_CUPON_CI~~~".~~~"FOLIO~~~"~"   OP =~"=~"    EXP2 =~":folio~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"DETALLE_CUPON_CI~~~".~~~"FECHA~~~"~"   OP =~"=~"    EXP2 =~":fecha~" ) ) ARG(NAME = ~"tipo_cob~" TYPE = string)  ARG(NAME = ~"folio~" TYPE = number)  ARG(NAME = ~"fecha~" TYPE = datetime) " update="DETALLE_CUPON_CI" updatewhere=1 updatekeyinplace=no arguments=(("tipo_cob", string),("folio", number),("fecha", datetime)) )
