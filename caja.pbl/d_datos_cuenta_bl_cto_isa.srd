 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"contrato~" )  TABLE(NAME=~"cliente~" )  TABLE(NAME=~"cod_parq~" )  TABLE(NAME=~"tasa~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"cadena_mora~" ) COLUMN(NAME=~"contrato.serie_c~") COLUMN(NAME=~"contrato.nro_contrato~") COLUMN(NAME=~"contrato.fecha~") COLUMN(NAME=~"contrato.serie~") COLUMN(NAME=~"contrato.nro_pagare~") COLUMN(NAME=~"contrato.estado~") COLUMN(NAME=~"contrato.nro_resc~") COLUMN(NAME=~"cod_parq.nombre~") COLUMN(NAME=~"cod_parq.ciudad~") COLUMN(NAME=~"contrato.dueno~") COLUMN(NAME=~"contrato.origen~") COLUMN(NAME=~"contrato.ubs~") COLUMN(NAME=~"contrato.sector~") COLUMN(NAME=~"contrato.sepultura~") COLUMN(NAME=~"contrato.zona~") COLUMN(NAME=~"contrato.capacidad~") COLUMN(NAME=~"contrato.cta_pag_m~") COLUMN(NAME=~"contrato.valor_cuota_m~") COLUMN(NAME=~"contrato.fecha_m~") COLUMN(NAME=~"contrato.abono_m~") COLUMN(NAME=~"cliente.rut~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cliente.direccion_p~") COLUMN(NAME=~"cliente.comuna~") COLUMN(NAME=~"cliente.ciudad~") COLUMN(NAME=~"cliente.fono_p~") COLUMN(NAME=~"tasa.tasa_m~") COLUMN(NAME=~"tasa.tasa_a~") COLUMN(NAME=~"tasa.tasa_int_p~") COLUMN(NAME=~"tasa.tasa_int_uf~") COLUMN(NAME=~"contrato.moneda~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"cadena.cod_parque~") COLUMN(NAME=~"contrato.plazo~") COLUMN(NAME=~"contrato.pie~") COLUMN(NAME=~"cadena.estado_carta~") COLUMN(NAME=~"contrato.valor_cuo~") COLUMN(NAME=~"contrato.cta_pag_la~") COLUMN(NAME=~"contrato.cta_pag_isa~") COLUMN(NAME=~"contrato.nro_tec~") COLUMN(NAME=~"cadena_mora.mora_mant~") COLUMN(NAME=~"cadena_mora.dias_mora_mant~") COLUMN(NAME=~"cadena_mora.fecha_venc_mant~") COMPUTE(NAME=~"
to_date(sysdate) as fecha_pago~") COMPUTE(NAME=~"to_date(sysdate) as fecha_uf~") COLUMN(NAME=~"contrato.pie_pagado~")    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"cadena_mora.serie~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"cadena_mora.base~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"cadena_mora.numero~" )    JOIN (LEFT=~"contrato.rut~"    OP =~"=~"RIGHT=~"cliente.rut~" )    JOIN (LEFT=~"contrato.parque~"    OP =~"=~"RIGHT=~"cod_parq.codigo~" )    JOIN (LEFT=~"contrato.serie_c~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"contrato.nro_contrato~"    OP =~"=~"RIGHT=~"cadena.numero~" )WHERE(    EXP1 =~"~~~"CONTRATO~~~".~~~"SERIE_C~~~"~"   OP =~"=~"    EXP2 =~":as_serie~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CONTRATO~~~".~~~"NRO_CONTRATO~~~"~"   OP =~"=~"    EXP2 =~":an_numero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~":as_base~" ) ) ARG(NAME = ~"as_serie~" TYPE = string)  ARG(NAME = ~"an_numero~" TYPE = number)  ARG(NAME = ~"as_base~" TYPE = string) " arguments=(("as_serie", string),("an_numero", number),("as_base", string)) )
