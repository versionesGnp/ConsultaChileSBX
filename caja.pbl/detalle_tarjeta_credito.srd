 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"bancos~" )  TABLE(NAME=~"documentos~" ) COLUMN(NAME=~"documentos.cod_pago~") COLUMN(NAME=~"documentos.cod_banco~") COLUMN(NAME=~"documentos.n_cheque~") COLUMN(NAME=~"documentos.fecha_venc~") COLUMN(NAME=~"documentos.monto~") COLUMN(NAME=~"bancos.descripcion~") COLUMN(NAME=~"documentos.tipo_cob~") COLUMN(NAME=~"documentos.fecha_pago~") COLUMN(NAME=~"documentos.cod_tarjeta_credito~") COLUMN(NAME=~"documentos.nro_cuotas_credito~") COLUMN(NAME=~"documentos.cod_autorizacion_credito~") COLUMN(NAME=~"documentos.tipo_tarjeta_credito~") COLUMN(NAME=~"documentos.folio~") COLUMN(NAME=~"documentos.rezago~")    JOIN (LEFT=~"bancos.cod_banco~"    OP =~"=~"RIGHT=~"documentos.cod_banco~"    OUTER2 =~"documentos.cod_banco~" )WHERE(    EXP1 =~"(( ~~~"DOCUMENTOS~~~".~~~"COD_PAGO~~~"~"   OP =~"=~"    EXP2 =~"'TC'  )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(( ~~~"DOCUMENTOS~~~".~~~"COD_CAJA~~~"~"   OP =~"=~"    EXP2 =~":ca  )~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"( ~~~"DOCUMENTOS~~~".~~~"COD_CAJA~~~"~"   OP =~"=~"    EXP2 =~":ca2))~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"DOCUMENTOS~~~".~~~"FECHA_DEPOSITO~~~"~"   OP =~"=~"    EXP2 =~":fe ))~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"DOCUMENTOS~~~".~~~"TIPO_COB_MP~~~"~"   OP =~"is~"    EXP2 =~"null~" ) ) ARG(NAME = ~"ca~" TYPE = string)  ARG(NAME = ~"fe~" TYPE = date)  ARG(NAME = ~"ca2~" TYPE = string) " arguments=(("ca", string),("fe", date),("ca2", string))  sort="documentos_cod_banco A documentos_cod_tarjeta_credito A documentos_fecha_venc A " )
