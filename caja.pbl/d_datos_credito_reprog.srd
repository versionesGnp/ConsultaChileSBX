 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cod_parq~" )  TABLE(NAME=~"tasa~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"repacta_mantencion~" ) COLUMN(NAME=~"cod_parq.codigo~") COLUMN(NAME=~"cod_parq.nombre~") COLUMN(NAME=~"tasa.tasa_int_p~") COLUMN(NAME=~"tasa.tasa_int_uf~") COLUMN(NAME=~"tasa.tasa_m~") COLUMN(NAME=~"tasa.tasa_a~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"repacta_mantencion.serie~") COLUMN(NAME=~"repacta_mantencion.numero~") COLUMN(NAME=~"repacta_mantencion.valor_cuota~") COLUMN(NAME=~"repacta_mantencion.fecha_primera_cta~") COLUMN(NAME=~"repacta_mantencion.fecha_ult~") COLUMN(NAME=~"repacta_mantencion.cuotas_pactadas~") COLUMN(NAME=~"repacta_mantencion.ctas_pagadas~") COLUMN(NAME=~"repacta_mantencion.abono~") COLUMN(NAME=~"repacta_mantencion.tipo_moneda~") COLUMN(NAME=~"repacta_mantencion.base_original~") COLUMN(NAME=~"repacta_mantencion.serie_original~") COLUMN(NAME=~"repacta_mantencion.numero_original~") COLUMN(NAME=~"repacta_mantencion.total_pagado~") COLUMN(NAME=~"repacta_mantencion.cta_mora_original~") COLUMN(NAME=~"repacta_mantencion.ctas_pag_m_original~") COLUMN(NAME=~"repacta_mantencion.total_deuda~") COLUMN(NAME=~"repacta_mantencion.cuotas_en_mora~") COLUMN(NAME=~"repacta_mantencion.estado_pago~") COLUMN(NAME=~"repacta_mantencion.factor_aplicado~") COLUMN(NAME=~"repacta_mantencion.total_deuda_uf~") COLUMN(NAME=~"repacta_mantencion.valor_cuota_uf~")    JOIN (LEFT=~"cadena.cod_parque~"    OP =~"=~"RIGHT=~"cod_parq.codigo~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"repacta_mantencion.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"repacta_mantencion.numero~" )WHERE(    EXP1 =~"~~~"REPACTA_MANTENCION~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":as_serie~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"REPACTA_MANTENCION~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":an_numero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'R'~" ) ) ARG(NAME = ~"as_serie~" TYPE = string)  ARG(NAME = ~"an_numero~" TYPE = number) " arguments=(("as_serie", string),("an_numero", number)) )
