 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ingre~" )  TABLE(NAME=~"cod_movi~" ) COLUMN(NAME=~"ingre.tipo_mov~") COLUMN(NAME=~"cod_movi.des_ing~") COLUMN(NAME=~"ingre.cuotas_pag~") COLUMN(NAME=~"ingre.monto~") COLUMN(NAME=~"ingre.valor_uf~") COLUMN(NAME=~"ingre.codigo_otro~") COLUMN(NAME=~"ingre.serie~") COLUMN(NAME=~"ingre.contrato~")    JOIN (LEFT=~"ingre.tipo_mov~"    OP =~"=~"RIGHT=~"cod_movi.cod_ing~" )WHERE(    EXP1 =~"~~~"INGRE~~~".~~~"FOLIO~~~"~"   OP =~"=~"    EXP2 =~":an_folio~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INGRE~~~".~~~"TIPO_COB~~~"~"   OP =~"=~"    EXP2 =~":tipo_cob~" ) ) ARG(NAME = ~"an_folio~" TYPE = number)  ARG(NAME = ~"tipo_cob~" TYPE = string) " arguments=(("an_folio", number),("tipo_cob", string)) )
