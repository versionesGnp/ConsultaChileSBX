 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cadena~" )  TABLE(NAME=~"cliente~" ) COLUMN(NAME=~"cliente.rut~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cliente.direccion_p~") COLUMN(NAME=~"cliente.comuna~") COLUMN(NAME=~"cliente.ciudad~") COLUMN(NAME=~"cliente.fono_p~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"cliente.tipo_via~") COLUMN(NAME=~"cliente.numero_particular~") COLUMN(NAME=~"cliente.depto_particular~") COLUMN(NAME=~"cliente.block_particular~")    JOIN (LEFT=~"cadena.rut~"    OP =~"=~"RIGHT=~"cliente.rut~"    OUTER1 =~"cadena.rut~" )WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~":as_base~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":as_serie~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":an_numero~" ) ) ARG(NAME = ~"as_base~" TYPE = string)  ARG(NAME = ~"as_serie~" TYPE = string)  ARG(NAME = ~"an_numero~" TYPE = number) " arguments=(("as_base", string),("as_serie", string),("an_numero", number)) )
