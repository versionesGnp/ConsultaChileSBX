 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"detalle_pago_pie~" )  TABLE(NAME=~"ingreso~" )  TABLE(NAME=~"cliente_rezago~" ) COLUMN(NAME=~"detalle_pago_pie.numero_cuota~") COLUMN(NAME=~"detalle_pago_pie.monto_cuota~") COLUMN(NAME=~"detalle_pago_pie.fecha_pago~") COLUMN(NAME=~"detalle_pago_pie.caja~") COLUMN(NAME=~"detalle_pago_pie.tipo_cob~") COLUMN(NAME=~"detalle_pago_pie.folio~") COLUMN(NAME=~"detalle_pago_pie.monto_pie_pagado_peso~") COLUMN(NAME=~"detalle_pago_pie.estado~") COLUMN(NAME=~"detalle_pago_pie.fecha_venc_cta~") COLUMN(NAME=~"detalle_pago_pie.moneda~") COLUMN(NAME=~"detalle_pago_pie.base~") COLUMN(NAME=~"detalle_pago_pie.serie~") COLUMN(NAME=~"detalle_pago_pie.numero~") COLUMN(NAME=~"detalle_pago_pie.fecha_crea~") COLUMN(NAME=~"detalle_pago_pie.usuario~") COLUMN(NAME=~"detalle_pago_pie.canal~")    JOIN (LEFT=~"cliente_rezago.cod_pago~"    OP =~"=~"RIGHT=~"ingreso.tipo_cob~" )    JOIN (LEFT=~"cliente_rezago.folio~"    OP =~"=~"RIGHT=~"ingreso.folio~" )    JOIN (LEFT=~"detalle_pago_pie.base~"    OP =~"=~"RIGHT=~"cliente_rezago.base~" )    JOIN (LEFT=~"detalle_pago_pie.serie~"    OP =~"=~"RIGHT=~"cliente_rezago.serie~" )    JOIN (LEFT=~"detalle_pago_pie.numero~"    OP =~"=~"RIGHT=~"cliente_rezago.numero~" )WHERE(    EXP1 =~"~~~"DETALLE_PAGO_PIE~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"DETALLE_PAGO_PIE~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"DETALLE_PAGO_PIE~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number)  ARG(NAME = ~"uf_dia~" TYPE = number) " update="DETALLE_PAGO_PIE" updatewhere=0 updatekeyinplace=yes arguments=(("base", string),("serie", string),("numero", number),("uf_dia", number))  sort="detalle_pago_pie_numero_cuota A " )
