SELECT DISTINCT "INGRESO"."MONTO"  
INTO 		  :ll_monto  
FROM 		  "INGRESO"  
WHERE 	( "INGRESO"."BASE" = :as_base ) AND  
         ( "INGRESO"."SERIE" = :as_serie ) AND  
         ( "INGRESO"."CONTRATO" = :al_numero ) AND  
			( "INGRESO"."TIPO_MOV" = 'S' ) AND  
         ( "INGRESO"."FECHA_PAGO" = (SELECT DISTINCT MAX("INGRESO"."FECHA_PAGO") FROM "INGRESO" WHERE ( "INGRESO"."BASE" = :as_base ) AND ( "INGRESO"."TIPO_MOV" = 'S' ) AND ( "INGRESO"."CODIGO_OTRO" = '107' ) AND ( "INGRESO"."SERIE" = :as_serie ) AND ( "INGRESO"."CONTRATO" = :al_numero ) ) ) 
USING		sqlca;
Return(ll_monto)
end function

