 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"electronica_fb~" )  TABLE(NAME=~"electronica_fb_detalle~" ) COLUMN(NAME=~"electronica_fb_detalle.tipo_dte~") COLUMN(NAME=~"electronica_fb_detalle.nro_documento~") COLUMN(NAME=~"electronica_fb_detalle.estado_documento~") COLUMN(NAME=~"electronica_fb_detalle.tasa_iva~") COLUMN(NAME=~"electronica_fb_detalle.fecha_pago~") COLUMN(NAME=~"electronica_fb_detalle.rut~") COLUMN(NAME=~"electronica_fb_detalle.dv~") COLUMN(NAME=~"electronica_fb_detalle.nombre_cliente~") COLUMN(NAME=~"electronica_fb_detalle.monto_exento~") COLUMN(NAME=~"electronica_fb_detalle.monto_afecto~") COLUMN(NAME=~"electronica_fb_detalle.monto_iva~") COLUMN(NAME=~"electronica_fb_detalle.monto_total~")    JOIN (LEFT=~"electronica_fb.grupo~"    OP =~"=~"RIGHT=~"electronica_fb_detalle.grupo~" )WHERE(    EXP1 =~"substr(to_char(~~~"ELECTRONICA_FB_DETALLE~~~".~~~"FECHA_PAGO~~~",'dd/mm/yyyy'),4,7)~"   OP =~"=~"    EXP2 =~":fecha~" ) ) ARG(NAME = ~"fecha~" TYPE = string) " arguments=(("fecha", string))  sort="electronica_fb_detalle_fecha_pago A " )
