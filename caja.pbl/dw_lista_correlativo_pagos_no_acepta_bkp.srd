 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"log_caja_rechazados~" ) COLUMN(NAME=~"log_caja_rechazados.correlativo~") COLUMN(NAME=~"log_caja_rechazados.tipo_cob~") COLUMN(NAME=~"log_caja_rechazados.folio~") COLUMN(NAME=~"log_caja_rechazados.fecha~") COLUMN(NAME=~"log_caja_rechazados.rezago~") COLUMN(NAME=~"log_caja_rechazados.usuario~") COLUMN(NAME=~"log_caja_rechazados.total_monto~") COLUMN(NAME=~"log_caja_rechazados.rut_cliente~") COLUMN(NAME=~"log_caja_rechazados.caja~") COLUMN(NAME=~"log_caja_rechazados.cod_observacion~") COLUMN(NAME=~"log_caja_rechazados.imprimir~") COLUMN(NAME=~"log_caja_rechazados.base~") COLUMN(NAME=~"log_caja_rechazados.serie~") COLUMN(NAME=~"log_caja_rechazados.numero~")WHERE(    EXP1 =~"~~~"LOG_CAJA_RECHAZADOS~~~".~~~"FECHA~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"LOG_CAJA_RECHAZADOS~~~".~~~"FECHA~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = date)  ARG(NAME = ~"fecha_fin~" TYPE = date) " update="LOG_CAJA_RECHAZADOS" updatewhere=1 updatekeyinplace=no arguments=(("fecha_ini", date),("fecha_fin", date))  sort="correlativo A " )
