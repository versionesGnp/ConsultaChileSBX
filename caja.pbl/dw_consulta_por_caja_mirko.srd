 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ingreso~" ) COLUMN(NAME=~"ingreso.folio~") COLUMN(NAME=~"ingreso.tipo_cob~") COLUMN(NAME=~"ingreso.fecha_pago~") COLUMN(NAME=~"ingreso.tipo_mov~") COLUMN(NAME=~"ingreso.monto~") COLUMN(NAME=~"ingreso.cuotas_pag~") COLUMN(NAME=~"ingreso.serie~") COLUMN(NAME=~"ingreso.contrato~") COLUMN(NAME=~"ingreso.cod_caja~") COLUMN(NAME=~"ingreso.rezago~") COLUMN(NAME=~"ingreso.valor_uf~") COLUMN(NAME=~"ingreso.pago_hist~") COLUMN(NAME=~"ingreso.base~") COLUMN(NAME=~"ingreso.rut~") COLUMN(NAME=~"ingreso.usuario~") COLUMN(NAME=~"ingreso.cod_age~") COLUMN(NAME=~"ingreso.fecha_venc~") COLUMN(NAME=~"ingreso.pago_externo~") COLUMN(NAME=~"ingreso.lugar_externo~") COLUMN(NAME=~"ingreso.viene_de~") COLUMN(NAME=~"ingreso.fecha_ant~") COLUMN(NAME=~"ingreso.fcha_ant~") COLUMN(NAME=~"ingreso.servipag~") COLUMN(NAME=~"ingreso.codigo_otro~") COLUMN(NAME=~"ingreso.traspaso_e~") COLUMN(NAME=~"ingreso.fecha_traspaso_rezago~") COLUMN(NAME=~"ingreso.fecha_sistema~") COLUMN(NAME=~"ingreso.cod_parque~")WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"FECHA_PAGO~~~"~"   OP =~"=~"    EXP2 =~"TO_DATE('07-06-2015 00:00:00','DD-MM-YYYY HH24:MI:SS')~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"COD_CAJA~~~"~"   OP =~"=~"    EXP2 =~"'51'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"TIPO_MOV~~~"~"   OP =~"=~"    EXP2 =~"'A'~" ) ) " update="INGRESO" updatewhere=1 updatekeyinplace=no )
