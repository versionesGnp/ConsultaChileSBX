 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"electronica_fb~" )  TABLE(NAME=~"electronica_fb_detalle~" ) COMPUTE(NAME=~"~~~"ELECTRONICA_FB_DETALLE~~~".~~~"MONTO_AFECTO~~~" as sum_afecto~") COMPUTE(NAME=~"~~~"ELECTRONICA_FB_DETALLE~~~".~~~"MONTO_EXENTO~~~" as sum_exento~") COMPUTE(NAME=~"~~~"ELECTRONICA_FB_DETALLE~~~".~~~"MONTO_IVA~~~" as sum_iva~") COMPUTE(NAME=~"~~~"ELECTRONICA_FB_DETALLE~~~".~~~"MONTO_TOTAL~~~" as sum_total~") COLUMN(NAME=~"electronica_fb_detalle.nro_documento~") COLUMN(NAME=~"electronica_fb_detalle.tipo_documento~") COLUMN(NAME=~"electronica_fb_detalle.tipo_dte~") COLUMN(NAME=~"electronica_fb_detalle.estado_documento~") COLUMN(NAME=~"electronica_fb_detalle.tasa_iva~") COLUMN(NAME=~"electronica_fb_detalle.fecha_pago~") COLUMN(NAME=~"electronica_fb_detalle.rut~") COLUMN(NAME=~"electronica_fb_detalle.dv~") COLUMN(NAME=~"electronica_fb_detalle.nombre_cliente~") COLUMN(NAME=~"electronica_fb_detalle.cod_caja~") COMPUTE(NAME=~"'N' as tiene_be~")    JOIN (LEFT=~"electronica_fb.grupo~"    OP =~"=~"RIGHT=~"electronica_fb_detalle.grupo~" )WHERE(    EXP1 =~"substr(to_char(~~~"ELECTRONICA_FB_DETALLE~~~".~~~"FECHA_PAGO~~~",'dd/mm/yyyy'),4,7)~"   OP =~"=~"    EXP2 =~":fecha~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"ELECTRONICA_FB_DETALLE~~~".~~~"MONTO_TOTAL~~~"~"   OP =~">~"    EXP2 =~"0~" ) )    UNION (PBSELECT( VERSION(400) TABLE(NAME=~"vista_listado_ingreso_sii~" )  TABLE(NAME=~"cliente~" ) COLUMN(NAME=~"vista_listado_ingreso_sii.sum_exento~") COLUMN(NAME=~"vista_listado_ingreso_sii.sum_afecto~") COLUMN(NAME=~"vista_listado_ingreso_sii.sum_iva~") COLUMN(NAME=~"vista_listado_ingreso_sii.sum_total~") COLUMN(NAME=~"vista_listado_ingreso_sii.numero_documento~") COLUMN(NAME=~"vista_listado_ingreso_sii.tipo_documento~") COMPUTE(NAME=~"'38' as tipo_dte~") COMPUTE(NAME=~"'' as estado_documento~") COMPUTE(NAME=~"0 as tasa_iva~") COLUMN(NAME=~"vista_listado_ingreso_sii.fecha_pago~") COLUMN(NAME=~"vista_listado_ingreso_sii.rut~") COLUMN(NAME=~"vista_listado_ingreso_sii.dv~") COMPUTE(NAME=~"to_char( ~~~"CLIENTE~~~".~~~"NOMBRE~~~" | | ~~~"CLIENTE~~~".~~~"A_PATERNO~~~" | | ~~~"CLIENTE~~~".~~~"A_MATERNO~~~" ) as nombre_cliente~") COLUMN(NAME=~"vista_listado_ingreso_sii.cod_caja~") COMPUTE(NAME=~"'N' as tiene_be~")    JOIN (LEFT=~"vista_listado_ingreso_sii.rut~"    OP =~"=~"RIGHT=~"cliente.rut~" )WHERE(    EXP1 =~"substr(to_char(~~~"VISTA_LISTADO_INGRESO_SII~~~".~~~"FECHA_PAGO~~~",'dd/mm/yyyy'),4,7)~"   OP =~"=~"    EXP2 =~":fecha~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"VISTA_LISTADO_INGRESO_SII~~~".~~~"TIPO_DOCUMENTO~~~"~"   OP =~"=~"    EXP2 =~"'CI'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"VISTA_LISTADO_INGRESO_SII~~~".~~~"SUM_TOTAL~~~"~"   OP =~">~"    EXP2 =~"0~" ) ))    UNION (PBSELECT( VERSION(400) TABLE(NAME=~"cliente~" )  TABLE(NAME=~"vista_cupones_sin_be~" )  TABLE(NAME=~"vista_listado_ingreso_sii~" ) COLUMN(NAME=~"vista_listado_ingreso_sii.sum_exento~") COLUMN(NAME=~"vista_listado_ingreso_sii.sum_afecto~") COLUMN(NAME=~"vista_listado_ingreso_sii.sum_iva~") COLUMN(NAME=~"vista_listado_ingreso_sii.sum_total~") COLUMN(NAME=~"vista_listado_ingreso_sii.numero_documento~") COLUMN(NAME=~"vista_listado_ingreso_sii.tipo_documento~") COMPUTE(NAME=~"'38' as tipo_dte~") COMPUTE(NAME=~"'' as estado_documento~") COMPUTE(NAME=~"0 as tasa_iva~") COLUMN(NAME=~"vista_listado_ingreso_sii.fecha_pago~") COLUMN(NAME=~"vista_listado_ingreso_sii.rut~") COLUMN(NAME=~"vista_listado_ingreso_sii.dv~") COMPUTE(NAME=~"to_char( ~~~"CLIENTE~~~".~~~"NOMBRE~~~" | | ~~~"CLIENTE~~~".~~~"A_PATERNO~~~" | | ~~~"CLIENTE~~~".~~~"A_MATERNO~~~" ) as nombre_cliente~") COLUMN(NAME=~"vista_listado_ingreso_sii.cod_caja~") COLUMN(NAME=~"vista_cupones_sin_be.tiene_be~")    JOIN (LEFT=~"cliente.rut~"    OP =~"=~"RIGHT=~"vista_listado_ingreso_sii.rut~" )    JOIN (LEFT=~"vista_listado_ingreso_sii.tipo_documento~"    OP =~"=~"RIGHT=~"vista_cupones_sin_be.tipo_doc~" )    JOIN (LEFT=~"vista_listado_ingreso_sii.numero_documento~"    OP =~"=~"RIGHT=~"vista_cupones_sin_be.numero_cupon~" )WHERE(    EXP1 =~"substr(to_char(~~~"VISTA_LISTADO_INGRESO_SII~~~".~~~"FECHA_PAGO~~~",'dd/mm/yyyy'),4,7)~"   OP =~"=~"    EXP2 =~":fecha~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"VISTA_LISTADO_INGRESO_SII~~~".~~~"TIPO_DOCUMENTO~~~"~"   OP =~"=~"    EXP2 =~"'CU'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"VISTA_LISTADO_INGRESO_SII~~~".~~~"SUM_TOTAL~~~"~"   OP =~">~"    EXP2 =~"0~" ) )) ORDER(NAME=~"10~" ASC=yes )  ORDER(NAME=~"5~" ASC=yes ) ARG(NAME = ~"fecha~" TYPE = string) " filter="tiene_be <> 'S' or isnull(tiene_be)"arguments=(("fecha", string))  sort="electronica_fb_detalle_fecha_pago A electronica_fb_detalle_nro_documento A electronica_fb_detalle_tipo_documento A " )
