 column=(type=number updatewhereclause=yes name=sum_total dbname="electronica_fb_detalle.sum_total" )
 column=(type=decimal(4) updatewhereclause=yes name=electronica_fb_detalle_nro_documento dbname="electronica_fb_detalle.nro_documento" )
 column=(type=char(10) updatewhereclause=yes name=electronica_fb_detalle_tipo_documento dbname="electronica_fb_detalle.tipo_documento" )
