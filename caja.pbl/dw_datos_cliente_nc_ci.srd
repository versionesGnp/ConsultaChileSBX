table(column=(type=decimal(4) updatewhereclause=yes name=cliente_rut dbname="cliente.rut" )
 column=(type=char(1) updatewhereclause=yes name=cliente_dv dbname="cliente.dv" )
 column=(type=char(40) updatewhereclause=yes name=cliente_nombre dbname="cliente.nombre" )
 column=(type=char(40) updatewhereclause=yes name=cliente_a_paterno dbname="cliente.a_paterno" )
 column=(type=char(40) updatewhereclause=yes name=cliente_a_materno dbname="cliente.a_materno" )
 column=(type=char(100) updatewhereclause=yes name=tipo_via_descripcion dbname="tipo_via.descripcion" )
 column=(type=char(60) updatewhereclause=yes name=cliente_direccion_p dbname="cliente.direccion_p" )
 column=(type=char(15) updatewhereclause=yes name=cliente_numero_particular dbname="cliente.numero_particular" )
 column=(type=char(15) updatewhereclause=yes name=cliente_depto_particular dbname="cliente.depto_particular" )
 column=(type=char(15) updatewhereclause=yes name=cliente_block_particular dbname="cliente.block_particular" )
 column=(type=char(90) updatewhereclause=yes name=ciudad_ciudad dbname="ciudad.ciudad" )
 column=(type=char(90) updatewhereclause=yes name=comuna_comuna dbname="comuna.comuna" )
 column=(type=char(1) updatewhereclause=yes name=ingreso_base dbname="ingreso.base" )
 column=(type=char(1) updatewhereclause=yes name=ingreso_serie dbname="ingreso.serie" )
 column=(type=decimal(4) updatewhereclause=yes name=ingreso_contrato dbname="ingreso.contrato" )
 column=(type=char(25) updatewhereclause=yes name=cliente_fono_p dbname="cliente.fono_p" )
 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"cliente~" )  TABLE(NAME=~"tipo_via~" )  TABLE(NAME=~"ciudad~" )  TABLE(NAME=~"comuna~" )  TABLE(NAME=~"ingreso~" ) COLUMN(NAME=~"cliente.rut~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"tipo_via.descripcion~") COLUMN(NAME=~"cliente.direccion_p~") COLUMN(NAME=~"cliente.numero_particular~") COLUMN(NAME=~"cliente.depto_particular~") COLUMN(NAME=~"cliente.block_particular~") COLUMN(NAME=~"ciudad.ciudad~") COLUMN(NAME=~"comuna.comuna~") COLUMN(NAME=~"ingreso.base~") COLUMN(NAME=~"ingreso.serie~") COLUMN(NAME=~"ingreso.contrato~") COLUMN(NAME=~"cliente.fono_p~")    JOIN (LEFT=~"cliente.tipo_via~"    OP =~"=~"RIGHT=~"tipo_via.tipo_via~" )    JOIN (LEFT=~"cliente.comuna~"    OP =~"=~"RIGHT=~"comuna.codigo_comuna~" )    JOIN (LEFT=~"cliente.ciudad~"    OP =~"=~"RIGHT=~"ciudad.codigo_ciudad~" )    JOIN (LEFT=~"cliente.rut~"    OP =~"=~"RIGHT=~"ingreso.rut~" )WHERE(    EXP1 =~"~~~"CLIENTE~~~".~~~"RUT~~~"~"   OP =~"=~"    EXP2 =~":rut~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"TIPO_COB~~~"~"   OP =~"=~"    EXP2 =~":tipo_cob~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"FOLIO~~~"~"   OP =~"=~"    EXP2 =~":folio~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"FECHA_PAGO~~~"~"   OP =~"=~"    EXP2 =~":fecha_pago~" ) ) ARG(NAME = ~"rut~" TYPE = number)  ARG(NAME = ~"tipo_cob~" TYPE = string)  ARG(NAME = ~"folio~" TYPE = number)  ARG(NAME = ~"fecha_pago~" TYPE = date) " arguments=(("rut", number),("tipo_cob", string),("folio", number),("fecha_pago", date)) )
