 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"servipag_recupera~" )  TABLE(NAME=~"log_servipag~" ) COLUMN(NAME=~"servipag_recupera.correlativo~") COLUMN(NAME=~"servipag_recupera.nro_cupon~") COLUMN(NAME=~"servipag_recupera.tipo_mov~") COLUMN(NAME=~"servipag_recupera.rut~") COLUMN(NAME=~"servipag_recupera.nro_cuota~") COLUMN(NAME=~"servipag_recupera.monto_cuota~") COLUMN(NAME=~"servipag_recupera.interes~") COLUMN(NAME=~"servipag_recupera.gasto_cob~") COLUMN(NAME=~"servipag_recupera.fecha_pago~") COLUMN(NAME=~"servipag_recupera.forma_pago~") COLUMN(NAME=~"servipag_recupera.base~") COLUMN(NAME=~"servipag_recupera.serie~") COLUMN(NAME=~"servipag_recupera.numero~") COLUMN(NAME=~"log_servipag.correlativo~") COLUMN(NAME=~"log_servipag.fecha_archivo~") COLUMN(NAME=~"log_servipag.fecha_crea~") COLUMN(NAME=~"log_servipag.usuario_creador~") COLUMN(NAME=~"log_servipag.nombre_archivo~") COLUMN(NAME=~"servipag_recupera.cod_caja~") COLUMN(NAME=~"servipag_recupera.cod_parque~") COLUMN(NAME=~"servipag_recupera.monto_seg_renta~") COLUMN(NAME=~"servipag_recupera.monto_seg_colectivo~") COLUMN(NAME=~"servipag_recupera.monto_segundo_aseg~") COLUMN(NAME=~"servipag_recupera.monto_seg_desgravamen~") COLUMN(NAME=~"servipag_recupera.monto_gasto_adm~") COLUMN(NAME=~"servipag_recupera.monto_asist_funeraria~")    JOIN (LEFT=~"servipag_recupera.correlativo~"    OP =~"=~"RIGHT=~"log_servipag.correlativo~" )WHERE(    EXP1 =~"~~~"SERVIPAG_RECUPERA~~~".~~~"CORRELATIVO~~~"~"   OP =~"=~"    EXP2 =~":corr~" ) ) ARG(NAME = ~"corr~" TYPE = number) " arguments=(("corr", number))  sort="numero A " )
