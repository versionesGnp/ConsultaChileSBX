compute(band=detail alignment="0" expression=" c_monto_efectivo + c_monto_cheque "border="0" color="0" x="2830" y="8" height="64" width="224" format="[general]"  name=c_total  font.face="Arial" font.height="-10" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" )
