detail(height=0 color="536870912" )
table(column=(type=decimal(4) updatewhereclause=yes name=folio dbname="documentos.folio" )
 column=(type=decimal(4) updatewhereclause=yes name=monto dbname="documentos.monto" )
 column=(type=char(2) updatewhereclause=yes name=cod_pago dbname="documentos.cod_pago" )
 column=(type=char(2) updatewhereclause=yes name=tipo_cob dbname="documentos.tipo_cob" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"documentos~" ) COLUMN(NAME=~"documentos.folio~") COLUMN(NAME=~"documentos.monto~") COLUMN(NAME=~"documentos.cod_pago~") COLUMN(NAME=~"documentos.tipo_cob~")WHERE(    EXP1 =~"(~~~"DOCUMENTOS~~~".~~~"FECHA_PAGO~~~"~"   OP =~"=~"    EXP2 =~":FE )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"DOCUMENTOS~~~".~~~"COD_CAJA~~~"~"   OP =~"=~"    EXP2 =~":CA~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"DOCUMENTOS~~~".~~~"COD_CAJA~~~"~"   OP =~"=~"    EXP2 =~":ca2)~" ) ) ARG(NAME = ~"FE~" TYPE = date)  ARG(NAME = ~"CA~" TYPE = string)  ARG(NAME = ~"ca2~" TYPE = string) " arguments=(("FE", date),("CA", string),("ca2", string))  sort="tipo_cob A " )
group(level=1 header.height=0 trailer.height=284 by=("tipo_cob" ) header.color="553648127" trailer.color="536870912"  sort="count(tipo_cob for group 1) A " )
