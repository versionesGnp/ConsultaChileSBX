~"    OP =~"=~"RIGHT=~"electronica_fb_detalle.rut~" )    JOIN (LEFT=~"electronica_fb.rut_empresa~"    OP =~"=~"RIGHT=~"electronica_fb_detalle.rut_empresa~" )    JOIN (LEFT=~"electronica_fb.tipo_documento~"    OP =~"=~"RIGHT=~"electronica_fb_detalle.tipo_documento~" )    JOIN (LEFT=~"electronica_fb.tipo_documento~"    OP =~"=~"RIGHT=~"vista_listado_ingreso_sii.tipo_documento~" )WHERE(    EXP1 =~"(substr(to_char(~~~"VISTA_LISTADO_INGRESO_SII~~~".~~~"FECHA_PAGO~~~",'dd/mm/yyyy'),4,7)~"   OP =~"=~"    EXP2 =~":fecha)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CODIGO_CAJAS~~~".~~~"EFECTO_FLUJO~~~"~"   OP =~"=~"    EXP2 =~"'S'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"ELECTRONICA_FB_DETALLE~~~".~~~"RUT_EMPRESA~~~"~"   OP =~"=~"    EXP2 =~":rut_empresa~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"ELECTRONICA_FB~~~".~~~"RUT_EMPRESA~~~"~"   OP =~"=~"    EXP2 =~":rut_empresa~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"VISTA_LISTADO_INGRESO_SII~~~".~~~"TIPO_DOCUMENTO~~~"~"   OP =~"<>~"    EXP2 =~"'NE'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"VISTA_LISTADO_INGRESO_SII~~~".~~~"TIPO_LIBRO~~~"~"   OP =~"=~"    EXP2 =~":tipo_libro~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"VISTA_LISTADO_INGRESO_SII~~~".~~~"COD_CAJA~~~"~"   OP =~"<>~"    EXP2 =~"'TP'~" ) )    UNION (PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"codigo_cajas~" )  TABLE(NAME=~"electronica_fb_tipo~" )  TABLE(NAME=~"vista_listado_ingreso_sii~" )  TABLE(NAME=~"electronica_fb~" )  TABLE(NAME=~"electronica_fb_detalle~" )  TABLE(NAME=~"tasa~" ) COMPUTE(NAME=~"(~~~"VISTA_LISTADO_INGRESO_SII~~~".~~~"SUM_EXENTO~~~" * -1) as sum_exento~") COMPUTE(NAME=~"(~~~"VISTA_LISTADO_INGRESO_SII~~~".~~~"SUM_AFECTO~~~" * -1) as sum_afecto~") COMPUTE(NAME=~"(~~~"VISTA_LISTADO_INGRESO_SII~~~".~~~"SUM_IVA~~~" * -1) as sum_iva~") COMPUTE(NAME=~"(~~~"VISTA_LISTADO_INGRESO_SII~~~".~~~"SUM_TOTAL~~~" * -1) as sum_total~") COLUMN(NAME=~"vista_listado_ingreso_sii.numero_documento~") COLUMN(NAME=~"vista_listado_ingreso_sii.tipo_documento~") COL