 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"doc_cob~" )  TABLE(NAME=~"bancos~" )  TABLE(NAME=~"ingre~" ) COLUMN(NAME=~"doc_cob.cod_pago~") COLUMN(NAME=~"doc_cob.cod_banco~") COLUMN(NAME=~"doc_cob.n_cheque~") COLUMN(NAME=~"doc_cob.fecha_venc~") COLUMN(NAME=~"doc_cob.monto~") COLUMN(NAME=~"bancos.descripcion~") COLUMN(NAME=~"doc_cob.tipo_cob~") COLUMN(NAME=~"ingre.base~") COLUMN(NAME=~"ingre.serie~") COLUMN(NAME=~"ingre.contrato~") COLUMN(NAME=~"ingre.rut~") COLUMN(NAME=~"doc_cob.cod_caja~") COLUMN(NAME=~"doc_cob.folio~") COLUMN(NAME=~"doc_cob.cod_tarjeta_credito~") COLUMN(NAME=~"doc_cob.nro_cuotas_credito~") COLUMN(NAME=~"doc_cob.cod_autorizacion_credito~") COLUMN(NAME=~"doc_cob.tipo_tarjeta_credito~")    JOIN (LEFT=~"doc_cob.cod_banco~"    OP =~"=~"RIGHT=~"bancos.cod_banco~" )    JOIN (LEFT=~"doc_cob.folio~"    OP =~"=~"RIGHT=~"ingre.folio~" )    JOIN (LEFT=~"doc_cob.tipo_cob~"    OP =~"=~"RIGHT=~"ingre.tipo_cob~" )WHERE(    EXP1 =~"(( ~~~"DOC_COB~~~".~~~"COD_PAGO~~~"~"   OP =~"=~"    EXP2 =~"'TC'  )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"DOC_COB~~~".~~~"COD_CAJA~~~"~"   OP =~"=~"    EXP2 =~":ca  ~"    LOGIC =~"or~" ) WHERE(    EXP1 =~" ~~~"DOC_COB~~~".~~~"COD_CAJA~~~"~"   OP =~"=~"    EXP2 =~":ca2)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"DOC_COB~~~".~~~"FECHA_PAGO~~~"~"   OP =~"=~"    EXP2 =~":fe )~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"(~~~"DOC_COB~~~".~~~"FECHA_VENC~~~"~"   OP =~"=~"    EXP2 =~":fe)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"DOC_COB~~~".~~~"TIPO_PAGO_TARJETA_CREDITO~~~"~"   OP =~"=~"    EXP2 =~"2))~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"(( ~~~"DOC_COB~~~".~~~"COD_PAGO~~~"~"   OP =~"=~"    EXP2 =~"'TC'  )~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"( ~~~"DOC_COB~~~".~~~"COD_CAJA~~~"~"   OP =~"=~"    EXP2 =~":ca  ~"    LOGIC =~"or~" ) WHERE(    EXP1 =~" ~~~"DOC_COB~~~".~~~"COD_CAJA~~~"~"   OP =~"=~"    EXP2 =~":ca2)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"DOC_COB~~~".~~~"FECHA_PAGO~~~"~"   OP =~"=~"    EXP2 =~":fe )~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"(~~~"DOC_COB~~~".~~~"TIPO_PAGO_TARJETA_CREDITO~~~"~"   OP =~"<>~"    EXP2 =~"2))~" ) ) ORDER(NAME=~"doc_cob.tipo_cob~" ASC=yes ) ARG(NAME = ~"ca~" TYPE = string)  ARG(NAME = ~"fe~" TYPE = date)  ARG(NAME = ~"ca2~" TYPE = string) " arguments=(("ca", string),("fe", date),("ca2", string)) )
