table(column=(type=decimal(4) updatewhereclause=yes name=documentos_n_cheque dbname="documentos.n_cheque" dbalias=".n_cheque" )
 column=(type=char(15) updatewhereclause=yes name=bancos_descripcion dbname="bancos.descripcion" dbalias=".descripcion" )
 column=(type=decimal(4) updatewhereclause=yes name=documentos_monto dbname="documentos.monto" dbalias=".monto" )
 column=(type=datetime updatewhereclause=yes name=documentos_fecha_venc dbname="documentos.fecha_venc" dbalias=".fecha_venc" )
 column=(type=char(15) updatewhereclause=yes name=bancos_descripcion_print dbname="bancos.descripcion_print" dbalias=".descripcion_print" )
 column=(type=decimal(4) updatewhereclause=yes name=documentos_num_cheques dbname="documentos.num_cheques" dbalias=".num_cheques" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"documentos~" )  TABLE(NAME=~"bancos~" ) COLUMN(NAME=~"documentos.n_cheque~") COLUMN(NAME=~"bancos.descripcion~") COLUMN(NAME=~"documentos.monto~") COLUMN(NAME=~"documentos.fecha_venc~") COLUMN(NAME=~"bancos.descripcion_print~") COLUMN(NAME=~"documentos.num_cheques~")    JOIN (LEFT=~"documentos.cod_banco~"    OP =~"=~"RIGHT=~"bancos.cod_banco~" )WHERE(    EXP1 =~"~~~"DOCUMENTOS~~~".~~~"TIPO_COB~~~"~"   OP =~"=~"    EXP2 =~":tipo_cob~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"DOCUMENTOS~~~".~~~"COD_PAGO~~~"~"   OP =~"=~"    EXP2 =~"'CH'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"DOCUMENTOS~~~".~~~"FOLIO~~~"~"   OP =~"=~"    EXP2 =~":an_folio~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"DOCUMENTOS~~~".~~~"FECHA_PAGO~~~"~"   OP =~"=~"    EXP2 =~":fecha~" ) ) ARG(NAME = ~"an_folio~" TYPE = number)  ARG(NAME = ~"tipo_cob~" TYPE = string)  ARG(NAME = ~"fecha~" TYPE = date) " filter="compute_1>20"arguments=(("an_folio", number),("tipo_cob", string),("fecha", date)) )
