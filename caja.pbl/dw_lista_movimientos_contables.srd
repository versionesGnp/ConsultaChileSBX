table(column=(type=char(2) updatewhereclause=yes name=ingreso_tipo_cob dbname="ingreso.tipo_cob" dbalias=".tipo_cob" )
 column=(type=datetime updatewhereclause=yes name=ingreso_fecha_pago dbname="ingreso.fecha_pago" dbalias=".fecha_pago" )
 column=(type=char(2) updatewhereclause=yes name=ingreso_tipo_mov dbname="ingreso.tipo_mov" dbalias=".tipo_mov" )
 column=(type=decimal(4) updatewhereclause=yes name=ingreso_monto dbname="ingreso.monto" dbalias=".monto" )
 column=(type=char(1) updatewhereclause=yes name=ingreso_serie dbname="ingreso.serie" dbalias=".serie" )
 column=(type=decimal(4) updatewhereclause=yes name=ingreso_contrato dbname="ingreso.contrato" dbalias=".contrato" )
 column=(type=char(2) updatewhereclause=yes name=ingreso_cod_caja dbname="ingreso.cod_caja" dbalias=".cod_caja" )
 column=(type=char(1) updatewhereclause=yes name=ingreso_rezago dbname="ingreso.rezago" dbalias=".rezago" )
 column=(type=decimal(4) updatewhereclause=yes name=ingreso_valor_uf dbname="ingreso.valor_uf" dbalias=".valor_uf" )
 column=(type=char(1) updatewhereclause=yes name=ingreso_base dbname="ingreso.base" dbalias=".base" )
 column=(type=char(7) updatewhereclause=yes name=cod_movi_sigla dbname="cod_movi.sigla" dbalias=".sigla" )
 column=(type=char(0) updatewhereclause=yes name=nro_cuenta dbname="compute_0012" )
 column=(type=decimal(4) updatewhereclause=yes name=ingreso_folio dbname="ingreso.folio" dbalias=".folio" )
 column=(type=decimal(4) updatewhereclause=yes name=ingreso_rut dbname="ingreso.rut" dbalias=".rut" )
 column=(type=datetime updatewhereclause=yes name=ingreso_fecha_venc dbname="ingreso.fecha_venc" dbalias=".fecha_venc" )
 column=(type=char(5) updatewhereclause=yes name=ingreso_codigo_otro dbname="ingreso.codigo_otro" dbalias=".codigo_otro" )
 column=(type=datetime updatewhereclause=yes name=ingreso_servipag dbname="ingreso.servipag" dbalias=".servipag" )
 column=(type=char(1) updatewhereclause=yes name=ingreso_pago_hist dbname="ingreso.pago_hist" dbalias=".pago_hist" )
 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"cod_movi~" )  TABLE(NAME=~"ingreso~" ) COLUMN(NAME=~"ingreso.tipo_cob~") COLUMN(NAME=~"ingreso.fecha_pago~") COLUMN(NAME=~"ingreso.tipo_mov~") COLUMN(NAME=~"ingreso.monto~") COLUMN(NAME=~"ingreso.serie~") COLUMN(NAME=~"ingreso.contrato~") COLUMN(NAME=~"ingreso.cod_caja~") COLUMN(NAME=~"ingreso.rezago~") COLUMN(NAME=~"ingreso.valor_uf~") COLUMN(NAME=~"ingreso.base~") COLUMN(NAME=~"cod_movi.sigla~") COMPUTE(NAME=~"''~") COLUMN(NAME=~"ingreso.folio~") COLUMN(NAME=~"ingreso.rut~") COLUMN(NAME=~"ingreso.fecha_venc~") COLUMN(NAME=~"ingreso.codigo_otro~") COLUMN(NAME=~"ingreso.servipag~") COLUMN(NAME=~"ingreso.pago_hist~")    JOIN (LEFT=~"ingreso.tipo_mov~"    OP =~"=~"RIGHT=~"cod_movi.cod_ing~" )WHERE(    EXP1 =~"(~~~"INGRESO~~~".~~~"FECHA_PAGO~~~"~"   OP =~"=~"    EXP2 =~":fec_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"COD_CAJA~~~"~"   OP =~"=~"    EXP2 =~":caja~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"TIPO_MOV~~~"~"   OP =~"<>~"    EXP2 =~"'W')~" ) ) ORDER(NAME=~"ingreso.folio~" ASC=yes )  ORDER(NAME=~"ingreso.tipo_cob~" ASC=yes )  ORDER(NAME=~"ingreso.monto~" ASC=no) ARG(NAME = ~"fec_ini~" TYPE = date)  ARG(NAME = ~"caja~" TYPE = string) " arguments=(("fec_ini", date),("caja", string))  sort="ingreso_folio A ingreso_tipo_cob A ingreso_monto D " )
