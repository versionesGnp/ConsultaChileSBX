table(column=(type=char(2) updatewhereclause=yes name=ingre_tipo_mov dbname="ingre.tipo_mov" dbalias=".tipo_mov" )
 column=(type=char(30) updatewhereclause=yes name=cod_movi_des_ing dbname="cod_movi.des_ing" dbalias=".des_ing" )
 column=(type=decimal(2) updatewhereclause=yes name=ingre_cuotas_pag dbname="ingre.cuotas_pag" dbalias=".cuotas_pag" )
 column=(type=decimal(4) updatewhereclause=yes name=ingre_monto dbname="ingre.monto" dbalias=".monto" )
 column=(type=decimal(4) updatewhereclause=yes name=ingre_valor_uf dbname="ingre.valor_uf" dbalias=".valor_uf" )
 column=(type=char(5) updatewhereclause=yes name=ingre_codigo_otro dbname="ingre.codigo_otro" dbalias=".codigo_otro" )
 column=(type=char(2) updatewhereclause=yes name=ingre_tipo_cob dbname="ingre.tipo_cob" dbalias=".tipo_cob" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ingre~" )  TABLE(NAME=~"cod_movi~" ) COLUMN(NAME=~"ingre.tipo_mov~") COLUMN(NAME=~"cod_movi.des_ing~") COLUMN(NAME=~"ingre.cuotas_pag~") COLUMN(NAME=~"ingre.monto~") COLUMN(NAME=~"ingre.valor_uf~") COLUMN(NAME=~"ingre.codigo_otro~") COLUMN(NAME=~"ingre.tipo_cob~")    JOIN (LEFT=~"ingre.tipo_mov~"    OP =~"=~"RIGHT=~"cod_movi.cod_ing~" )WHERE(    EXP1 =~"~~~"INGRE~~~".~~~"TIPO_COB~~~"~"   OP =~"=~"    EXP2 =~":tipo_cob~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INGRE~~~".~~~"FOLIO~~~"~"   OP =~"=~"    EXP2 =~":an_folio~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INGRE~~~".~~~"FECHA_PAGO~~~"~"   OP =~"=~"    EXP2 =~":fecha~" ) ) ARG(NAME = ~"an_folio~" TYPE = number)  ARG(NAME = ~"tipo_cob~" TYPE = string)  ARG(NAME = ~"fecha~" TYPE = date) " arguments=(("an_folio", number),("tipo_cob", string),("fecha", date)) )
