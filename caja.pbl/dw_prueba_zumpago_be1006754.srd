table(column=(type=decimal(4) updatewhereclause=yes name=folio dbname="ingreso.folio" dbalias=".folio" )
 column=(type=char(2) updatewhereclause=yes name=tipo_cob dbname="ingreso.tipo_cob" dbalias=".tipo_cob" )
 column=(type=datetime updatewhereclause=yes name=fecha_pago dbname="ingreso.fecha_pago" dbalias=".fecha_pago" )
 column=(type=char(2) updatewhereclause=yes name=tipo_mov dbname="ingreso.tipo_mov" dbalias=".tipo_mov" )
 column=(type=decimal(4) updatewhereclause=yes name=monto dbname="ingreso.monto" dbalias=".monto" )
 column=(type=decimal(2) updatewhereclause=yes name=cuotas_pag dbname="ingreso.cuotas_pag" dbalias=".cuotas_pag" )
 column=(type=char(1) updatewhereclause=yes name=base dbname="ingreso.base" dbalias=".base" )
 column=(type=char(1) updatewhereclause=yes name=serie dbname="ingreso.serie" dbalias=".serie" )
 column=(type=decimal(4) updatewhereclause=yes name=contrato dbname="ingreso.contrato" dbalias=".contrato" )
 column=(type=char(2) updatewhereclause=yes name=cod_caja dbname="ingreso.cod_caja" dbalias=".cod_caja" )
 column=(type=decimal(4) updatewhereclause=yes name=valor_uf dbname="ingreso.valor_uf" dbalias=".valor_uf" )
 column=(type=decimal(4) updatewhereclause=yes name=rut dbname="ingreso.rut" dbalias=".rut" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ingreso~" ) COLUMN(NAME=~"ingreso.folio~") COLUMN(NAME=~"ingreso.tipo_cob~") COLUMN(NAME=~"ingreso.fecha_pago~") COLUMN(NAME=~"ingreso.tipo_mov~") COLUMN(NAME=~"ingreso.monto~") COLUMN(NAME=~"ingreso.cuotas_pag~") COLUMN(NAME=~"ingreso.base~") COLUMN(NAME=~"ingreso.serie~") COLUMN(NAME=~"ingreso.contrato~") COLUMN(NAME=~"ingreso.cod_caja~") COLUMN(NAME=~"ingreso.valor_uf~") COLUMN(NAME=~"ingreso.rut~")WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"FECHA_PAGO~~~"~"   OP =~"=~"    EXP2 =~"TO_DATE('05-08-2019 00:00:00','DD-MM-YYYY HH24:MI:SS')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"TIPO_COB~~~"~"   OP =~"=~"    EXP2 =~"'BE'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"(~~~"INGRESO~~~".~~~"FOLIO~~~"~"   OP =~"=~"    EXP2 =~"1006754~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"FOLIO~~~"~"   OP =~"=~"    EXP2 =~"1006755)~" ) ) "  sort="tipo_cob A folio A " )
