 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"servipag_recupera~" )  TABLE(NAME=~"log_servipag~" ) COLUMN(NAME=~"servipag_recupera.correlativo~") COLUMN(NAME=~"servipag_recupera.nro_cupon~") COLUMN(NAME=~"servipag_recupera.tipo_mov~") COLUMN(NAME=~"servipag_recupera.rut~") COLUMN(NAME=~"servipag_recupera.nro_cuota~") COLUMN(NAME=~"servipag_recupera.monto_cuota~") COLUMN(NAME=~"servipag_recupera.interes~") COLUMN(NAME=~"servipag_recupera.gasto_cob~") COLUMN(NAME=~"servipag_recupera.fecha_pago~") COLUMN(NAME=~"servipag_recupera.forma_pago~") COLUMN(NAME=~"servipag_recupera.base~") COLUMN(NAME=~"servipag_recupera.serie~") COLUMN(NAME=~"servipag_recupera.numero~") COLUMN(NAME=~"log_servipag.correlativo~") COLUMN(NAME=~"log_servipag.fecha_archivo~") COLUMN(NAME=~"log_servipag.fecha_crea~") COLUMN(NAME=~"log_servipag.usuario_creador~") COLUMN(NAME=~"log_servipag.nombre_archivo~") COLUMN(NAME=~"servipag_recupera.cod_caja~") COLUMN(NAME=~"servipag_recupera.cod_parque~")    JOIN (LEFT=~"servipag_recupera.correlativo~"    OP =~"=~"RIGHT=~"log_servipag.correlativo~" )WHERE(    EXP1 =~"~~~"LOG_SERVIPAG~~~".~~~"FECHA_ARCHIVO~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"LOG_SERVIPAG~~~".~~~"FECHA_ARCHIVO~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"SERVIPAG_RECUPERA~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = date)  ARG(NAME = ~"fecha_fin~" TYPE = date)  ARG(NAME = ~"parque~" TYPE = number) " arguments=(("fecha_ini", date),("fecha_fin", date),("parque", number))  sort="log_servipag_fecha_archivo A " )
