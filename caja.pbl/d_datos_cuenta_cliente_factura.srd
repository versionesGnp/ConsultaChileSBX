 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ciudad~" )  TABLE(NAME=~"comuna~" )  TABLE(NAME=~"facturas_cliente_exentas~" )  TABLE(NAME=~"facturas_cadena~" ) COLUMN(NAME=~"ciudad.sigla_ciudad~") COLUMN(NAME=~"comuna.sigla_comuna~") COLUMN(NAME=~"facturas_cliente_exentas.rut~") COLUMN(NAME=~"facturas_cliente_exentas.nombre~") COLUMN(NAME=~"facturas_cliente_exentas.a_paterno~") COLUMN(NAME=~"facturas_cliente_exentas.a_materno~") COLUMN(NAME=~"facturas_cliente_exentas.direccion_p~") COLUMN(NAME=~"facturas_cliente_exentas.comuna~") COLUMN(NAME=~"facturas_cliente_exentas.ciudad~") COLUMN(NAME=~"facturas_cliente_exentas.dv~") COLUMN(NAME=~"facturas_cliente_exentas.numero_particular~") COLUMN(NAME=~"facturas_cliente_exentas.depto_particular~") COLUMN(NAME=~"facturas_cliente_exentas.block_particular~") COLUMN(NAME=~"facturas_cadena.estado~") COLUMN(NAME=~"facturas_cadena.moneda~") COLUMN(NAME=~"facturas_cadena.monto~") COLUMN(NAME=~"facturas_cadena.fecha_pago~") COLUMN(NAME=~"facturas_cadena.observacion~") COLUMN(NAME=~"facturas_cadena.cod_parque~")    JOIN (LEFT=~"facturas_cliente_exentas.comuna~"    OP =~"=~"RIGHT=~"comuna.codigo_comuna~" )    JOIN (LEFT=~"facturas_cliente_exentas.ciudad~"    OP =~"=~"RIGHT=~"ciudad.codigo_ciudad~" )    JOIN (LEFT=~"facturas_cliente_exentas.rut~"    OP =~"=~"RIGHT=~"facturas_cadena.rut~" )WHERE(    EXP1 =~"~~~"FACTURAS_CADENA~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":as_serie~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FACTURAS_CADENA~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":an_numero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FACTURAS_CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'B'~" ) ) ARG(NAME = ~"as_serie~" TYPE = string)  ARG(NAME = ~"an_numero~" TYPE = number)  ARG(NAME = ~"as_base~" TYPE = string) " arguments=(("as_serie", string),("an_numero", number),("as_base", string)) )
