 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"oferta_v~" )  TABLE(NAME=~"pago_oferta~" )  TABLE(NAME=~"cod_parq~" )  TABLE(NAME=~"tasa~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"cliente~" )  TABLE(NAME=~"tipo_via~" ) COLUMN(NAME=~"oferta_v.serie~") COLUMN(NAME=~"oferta_v.nro_oferta~") COLUMN(NAME=~"cod_parq.codigo~") COLUMN(NAME=~"cod_parq.nombre~") COLUMN(NAME=~"pago_oferta.fecha_prim~") COLUMN(NAME=~"pago_oferta.fecha_ult~") COLUMN(NAME=~"pago_oferta.nro_cuotas~") COLUMN(NAME=~"pago_oferta.valor_cuota~") COLUMN(NAME=~"oferta_v.cta_pag_s~") COLUMN(NAME=~"oferta_v.abono_c~") COLUMN(NAME=~"tasa.tasa_int_p~") COLUMN(NAME=~"tasa.tasa_int_uf~") COLUMN(NAME=~"tasa.tasa_m~") COLUMN(NAME=~"tasa.tasa_a~") COLUMN(NAME=~"pago_oferta.moneda~") COLUMN(NAME=~"oferta_v.ult_folio~") COLUMN(NAME=~"oferta_v.tot_pagado~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"oferta_v.cta_pag_m~") COLUMN(NAME=~"oferta_v.valor_cuota_m~") COLUMN(NAME=~"oferta_v.fecha_m~") COLUMN(NAME=~"oferta_v.abono_m~") COLUMN(NAME=~"oferta_v.tot_pagado_m~") COLUMN(NAME=~"cliente.rut~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cliente.direccion_p~") COLUMN(NAME=~"cliente.numero_particular~") COLUMN(NAME=~"cliente.depto_particular~") COLUMN(NAME=~"cliente.block_particular~") COLUMN(NAME=~"tipo_via.descripcion~") COLUMN(NAME=~"cliente.estado_cobranza~") COLUMN(NAME=~"cliente.fecha_cobranza~") COLUMN(NAME=~"cliente.glosa_cobranza~") COLUMN(NAME=~"cliente.ult_estado_pub~") COLUMN(NAME=~"cliente.ult_glosa_pub~") COLUMN(NAME=~"cliente.ult_fecha_pub~") COLUMN(NAME=~"cliente.ult_cod_envio_carta~") COLUMN(NAME=~"cliente.ult_estado_envio_carta~") COLUMN(NAME=~"cliente.ult_fecha_envio_carta~") COLUMN(NAME=~"cliente.ult_cod_accion_envio_carta~") COLUMN(NAME=~"cliente.ult_clasificacion_envio_carta~") COLUMN(NAME=~"cliente.fecha_prox_envio_carta~") COLUMN(NAME=~"cliente.estado_envio_carta~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"cadena.estado_titulo~") COLUMN(NAME=~"cadena.fecha_titulo~")    JOIN (LEFT=~"cadena.rut~"    OP =~"=~"RIGHT=~"cliente.rut~"    OUTER1 =~"cadena.rut~" )    JOIN (LEFT=~"oferta_v.serie~"    OP =~"=~"RIGHT=~"pago_oferta.serie~" )    JOIN (LEFT=~"oferta_v.nro_oferta~"    OP =~"=~"RIGHT=~"pago_oferta.nro_oferta~" )    JOIN (LEFT=~"oferta_v.ult_folio~"    OP =~"=~"RIGHT=~"pago_oferta.folio~" )    JOIN (LEFT=~"pago_oferta.parque~"    OP =~"=~"RIGHT=~"cod_parq.codigo~" )    JOIN (LEFT=~"oferta_v.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"oferta_v.nro_oferta~"    OP =~"=~"RIGHT=~"cadena.numero~" )    JOIN (LEFT=~"cliente.tipo_via~"    OP =~"=~"RIGHT=~"tipo_via.tipo_via~" )WHERE(    EXP1 =~"~~~"OFERTA_V~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":as_serie~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"OFERTA_V~~~".~~~"NRO_OFERTA~~~"~"   OP =~"=~"    EXP2 =~":an_numero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'O'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'U')~" ) ) ARG(NAME = ~"as_serie~" TYPE = string)  ARG(NAME = ~"an_numero~" TYPE = number) " arguments=(("as_serie", string),("an_numero", number)) )
