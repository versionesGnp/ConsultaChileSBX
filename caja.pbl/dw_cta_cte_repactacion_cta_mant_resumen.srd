 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cadena~" )  TABLE(NAME=~"cliente~" )  TABLE(NAME=~"repacta_mantencion~" ) COLUMN(NAME=~"repacta_mantencion.base~") COLUMN(NAME=~"repacta_mantencion.serie~") COLUMN(NAME=~"repacta_mantencion.numero~") COLUMN(NAME=~"repacta_mantencion.base_original~") COLUMN(NAME=~"repacta_mantencion.serie_original~") COLUMN(NAME=~"repacta_mantencion.numero_original~") COLUMN(NAME=~"repacta_mantencion.correlativo~") COLUMN(NAME=~"repacta_mantencion.fecha_crea~") COLUMN(NAME=~"repacta_mantencion.total_deuda~") COLUMN(NAME=~"repacta_mantencion.cuotas_pactadas~") COLUMN(NAME=~"repacta_mantencion.estado_pago~") COLUMN(NAME=~"repacta_mantencion.valor_cuota~") COLUMN(NAME=~"repacta_mantencion.fecha_primera_cta~") COLUMN(NAME=~"repacta_mantencion.cuotas_en_mora~") COLUMN(NAME=~"repacta_mantencion.usuario~") COLUMN(NAME=~"repacta_mantencion.ctas_pagadas~") COLUMN(NAME=~"repacta_mantencion.abono~") COLUMN(NAME=~"repacta_mantencion.saldo~") COLUMN(NAME=~"repacta_mantencion.rut_cliente~") COLUMN(NAME=~"repacta_mantencion.dv_cliente~") COLUMN(NAME=~"repacta_mantencion.uf_dia~") COLUMN(NAME=~"repacta_mantencion.tipo_moneda~") COLUMN(NAME=~"repacta_mantencion.total_deuda_uf~") COLUMN(NAME=~"repacta_mantencion.valor_cuota_uf~") COLUMN(NAME=~"repacta_mantencion.interes_cuota_pesos~") COLUMN(NAME=~"repacta_mantencion.interes_deuda_pesos~") COLUMN(NAME=~"repacta_mantencion.por_descuento~") COLUMN(NAME=~"repacta_mantencion.interes_adm_pesos~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cliente.direccion_p~") COLUMN(NAME=~"cliente.poblacion~") COLUMN(NAME=~"cliente.sector~") COLUMN(NAME=~"cliente.comuna~") COLUMN(NAME=~"cliente.ciudad~") COLUMN(NAME=~"cliente.fono_p~") COLUMN(NAME=~"cliente.rut~") COLUMN(NAME=~"cliente.dv~")    JOIN (LEFT=~"cliente.rut~"    OP =~"=~"RIGHT=~"repacta_mantencion.rut_cliente~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"repacta_mantencion.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"repacta_mantencion.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"repacta_mantencion.numero~" )WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number) " arguments=(("base", string),("serie", string),("numero", number)) )
