table(column=(type=decimal(4) updatewhereclause=yes name=ingreso_folio dbname="ingreso.folio" )
 column=(type=char(2) updatewhereclause=yes name=ingreso_tipo_cob dbname="ingreso.tipo_cob" )
 column=(type=datetime updatewhereclause=yes name=ingreso_fecha_pago dbname="ingreso.fecha_pago" )
 column=(type=char(2) updatewhereclause=yes name=ingreso_tipo_mov dbname="ingreso.tipo_mov" )
 column=(type=char(30) updatewhereclause=yes name=cod_movi_des_ing dbname="cod_movi.des_ing" )
 column=(type=decimal(4) updatewhereclause=yes name=ingreso_monto dbname="ingreso.monto" )
 column=(type=decimal(4) updatewhereclause=yes name=ingreso_contrato dbname="ingreso.contrato" )
 column=(type=char(1) updatewhereclause=yes name=ingreso_base dbname="ingreso.base" )
 column=(type=char(5) updatewhereclause=yes name=ingreso_codigo_otro dbname="ingreso.codigo_otro" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cod_movi~" )  TABLE(NAME=~"ingreso~" ) COLUMN(NAME=~"ingreso.folio~") COLUMN(NAME=~"ingreso.tipo_cob~") COLUMN(NAME=~"ingreso.fecha_pago~") COLUMN(NAME=~"ingreso.tipo_mov~") COLUMN(NAME=~"cod_movi.des_ing~") COLUMN(NAME=~"ingreso.monto~") COLUMN(NAME=~"ingreso.contrato~") COLUMN(NAME=~"ingreso.base~") COLUMN(NAME=~"ingreso.codigo_otro~")    JOIN (LEFT=~"cod_movi.cod_ing~"    OP =~"=~"RIGHT=~"ingreso.tipo_mov~" )WHERE(    EXP1 =~"(~~~"INGRESO~~~".~~~"FECHA_DEPOSITO~~~"~"   OP =~"=~"    EXP2 =~":fe)~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"(~~~"INGRESO~~~".~~~"COD_CAJA~~~"~"   OP =~"=~"    EXP2 =~":ca~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"COD_CAJA~~~"~"   OP =~"=~"    EXP2 =~":ca2)~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"CONTRATO~~~"~"   OP =~"=~"    EXP2 =~"0~" ) ) ARG(NAME = ~"fe~" TYPE = date)  ARG(NAME = ~"ca~" TYPE = string)  ARG(NAME = ~"ca2~" TYPE = string)  ARG(NAME = ~"cod_parque~" TYPE = number) " filter="f_funcion_parque = cod_parque"arguments=(("fe", date),("ca", string),("ca2", string),("cod_parque", number))  sort="ingreso_base A ingreso_tipo_mov A " )
