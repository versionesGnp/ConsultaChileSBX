 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"servipag_recupera~" ) COLUMN(NAME=~"servipag_recupera.base~") COLUMN(NAME=~"servipag_recupera.serie~") COLUMN(NAME=~"servipag_recupera.numero~") COLUMN(NAME=~"servipag_recupera.nro_cupon~") COLUMN(NAME=~"servipag_recupera.tipo_mov~") COLUMN(NAME=~"servipag_recupera.rut~") COLUMN(NAME=~"servipag_recupera.nro_cuota~") COLUMN(NAME=~"servipag_recupera.monto_cuota~") COLUMN(NAME=~"servipag_recupera.interes~") COLUMN(NAME=~"servipag_recupera.gasto_cob~") COLUMN(NAME=~"servipag_recupera.fecha_pago~") COMPUTE(NAME=~"'SI'~")WHERE(    EXP1 =~"~~~"SERVIPAG_RECUPERA~~~".~~~"NOMBRE_ARCHIVO~~~"~"   OP =~"=~"    EXP2 =~":nom_arch~" ) )    UNION (PBSELECT( VERSION(400) TABLE(NAME=~"servipag_cupon_existe~" ) COLUMN(NAME=~"servipag_cupon_existe.base~") COLUMN(NAME=~"servipag_cupon_existe.serie~") COLUMN(NAME=~"servipag_cupon_existe.numero~") COLUMN(NAME=~"servipag_cupon_existe.nro_cupon~") COLUMN(NAME=~"servipag_cupon_existe.tipo_mov~") COLUMN(NAME=~"servipag_cupon_existe.rut~") COLUMN(NAME=~"servipag_cupon_existe.nro_documento~") COLUMN(NAME=~"servipag_cupon_existe.monto_cuota~") COLUMN(NAME=~"servipag_cupon_existe.monto_interes~") COLUMN(NAME=~"servipag_cupon_existe.monto_gc~") COLUMN(NAME=~"servipag_cupon_existe.fecha_pago~") COMPUTE(NAME=~"'NO'~")WHERE(    EXP1 =~"~~~"SERVIPAG_CUPON_EXISTE~~~".~~~"NOMBRE_ARCHIVO~~~"~"   OP =~"=~"    EXP2 =~":nom_arch~" ) )) ARG(NAME = ~"nom_arch~" TYPE = string) " arguments=(("nom_arch", string))  sort="estado_carga A rut A " )
