 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ingreso~" )  TABLE(NAME=~"cliente_rezago~" )  TABLE(NAME=~"cd_folio~" ) COLUMN(NAME=~"ingreso.tipo_cob~") COLUMN(NAME=~"ingreso.folio~") COLUMN(NAME=~"ingreso.fecha_pago~") COLUMN(NAME=~"ingreso.tipo_mov~") COLUMN(NAME=~"ingreso.monto~") COLUMN(NAME=~"ingreso.rezago~") COLUMN(NAME=~"ingreso.rut~") COLUMN(NAME=~"cliente_rezago.base~") COLUMN(NAME=~"cliente_rezago.serie~") COLUMN(NAME=~"cliente_rezago.numero~") COLUMN(NAME=~"cliente_rezago.nombre~") COLUMN(NAME=~"cliente_rezago.ap_paterno~") COLUMN(NAME=~"cliente_rezago.ap_materno~") COLUMN(NAME=~"cd_folio.ult_estado~")    JOIN (LEFT=~"ingreso.folio~"    OP =~"=~"RIGHT=~"cliente_rezago.folio~" )    JOIN (LEFT=~"ingreso.tipo_cob~"    OP =~"=~"RIGHT=~"cliente_rezago.cod_pago~" )    JOIN (LEFT=~"cliente_rezago.base~"    OP =~"=~"RIGHT=~"cd_folio.base~" )    JOIN (LEFT=~"cliente_rezago.serie~"    OP =~"=~"RIGHT=~"cd_folio.serie~" )    JOIN (LEFT=~"cliente_rezago.numero~"    OP =~"=~"RIGHT=~"cd_folio.numero~" )WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"TIPO_COB~~~"~"   OP =~"=~"    EXP2 =~":tipo_cob~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"FOLIO~~~"~"   OP =~"=~"    EXP2 =~":folio~" ) ) ARG(NAME = ~"folio~" TYPE = number)  ARG(NAME = ~"tipo_cob~" TYPE = string) " arguments=(("folio", number),("tipo_cob", string)) )
