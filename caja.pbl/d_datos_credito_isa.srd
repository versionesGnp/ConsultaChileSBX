 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cod_parq~" )  TABLE(NAME=~"tasa~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"contrato~" ) COLUMN(NAME=~"cod_parq.codigo~") COLUMN(NAME=~"cod_parq.nombre~") COLUMN(NAME=~"tasa.tasa_int_p~") COLUMN(NAME=~"tasa.tasa_int_uf~") COLUMN(NAME=~"tasa.tasa_m~") COLUMN(NAME=~"tasa.tasa_a~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"contrato.plazo~") COLUMN(NAME=~"contrato.cta_pag_isa~") COLUMN(NAME=~"contrato.cta_pag_la~") COLUMN(NAME=~"contrato.serie_c~") COLUMN(NAME=~"contrato.nro_contrato~") COLUMN(NAME=~"contrato.fecha_prim~") COLUMN(NAME=~"contrato.fecha_ult~") COLUMN(NAME=~"contrato.abono_pag~") COLUMN(NAME=~"contrato.valor_cuota_m~") COLUMN(NAME=~"contrato.valor_cuo~") COLUMN(NAME=~"contrato.fecha_m~") COLUMN(NAME=~"contrato.cta_pag_m~") COLUMN(NAME=~"contrato.moneda~")    JOIN (LEFT=~"contrato.serie_c~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"contrato.nro_contrato~"    OP =~"=~"RIGHT=~"cadena.numero~" )    JOIN (LEFT=~"cadena.cod_parque~"    OP =~"=~"RIGHT=~"cod_parq.codigo~" )WHERE(    EXP1 =~"~~~"CONTRATO~~~".~~~"SERIE_C~~~"~"   OP =~"=~"    EXP2 =~":as_serie~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CONTRATO~~~".~~~"NRO_CONTRATO~~~"~"   OP =~"=~"    EXP2 =~":an_numero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'C'~" ) ) ARG(NAME = ~"as_serie~" TYPE = string)  ARG(NAME = ~"an_numero~" TYPE = number) " arguments=(("as_serie", string),("an_numero", number)) )
