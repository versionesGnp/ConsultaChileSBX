table(column=(type=char(2) updatewhereclause=yes name=tipo_cob dbname="ingreso.tipo_cob" )
 column=(type=decimal(4) updatewhereclause=yes name=folio dbname="ingreso.folio" )
 column=(type=datetime updatewhereclause=yes name=fecha_pago dbname="ingreso.fecha_pago" )
 column=(type=char(1) updatewhereclause=yes name=base dbname="ingreso.base" )
 column=(type=char(1) updatewhereclause=yes name=serie dbname="ingreso.serie" )
 column=(type=decimal(4) updatewhereclause=yes name=contrato dbname="ingreso.contrato" )
 column=(type=decimal(4) updatewhereclause=yes name=rut dbname="ingreso.rut" )
 column=(type=char(2) updatewhereclause=yes name=cod_caja dbname="ingreso.cod_caja" )
 column=(type=char(1) updatewhereclause=yes name=rezago dbname="ingreso.rezago" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ingreso~" ) COLUMN(NAME=~"ingreso.tipo_cob~") COLUMN(NAME=~"ingreso.folio~") COLUMN(NAME=~"ingreso.fecha_pago~") COLUMN(NAME=~"ingreso.base~") COLUMN(NAME=~"ingreso.serie~") COLUMN(NAME=~"ingreso.contrato~") COLUMN(NAME=~"ingreso.rut~") COLUMN(NAME=~"ingreso.cod_caja~") COLUMN(NAME=~"ingreso.rezago~")WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"TIPO_COB~~~"~"   OP =~"=~"    EXP2 =~":tipo_cob~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"FOLIO~~~"~"   OP =~"=~"    EXP2 =~":folio~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"FECHA_PAGO~~~"~"   OP =~"=~"    EXP2 =~":fecha_pago~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"REZAGO~~~"~"   OP =~"=~"    EXP2 =~":rezago~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"RUT~~~"~"   OP =~"=~"    EXP2 =~":rut~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":cod_parque~" ) ) ARG(NAME = ~"tipo_cob~" TYPE = string)  ARG(NAME = ~"folio~" TYPE = number)  ARG(NAME = ~"fecha_pago~" TYPE = date)  ARG(NAME = ~"rezago~" TYPE = string)  ARG(NAME = ~"rut~" TYPE = number)  ARG(NAME = ~"cod_parque~" TYPE = number)  ARG(NAME = ~"monto_palabra~" TYPE = string) " arguments=(("tipo_cob", string),("folio", number),("fecha_pago", date),("rezago", string),("rut", number),("cod_parque", number),("monto_palabra", string)) )
