 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ingreso~" )  TABLE(NAME=~"cod_movi~" ) COLUMN(NAME=~"ingreso.folio~") COLUMN(NAME=~"ingreso.tipo_cob~") COLUMN(NAME=~"ingreso.fecha_pago~") COLUMN(NAME=~"ingreso.tipo_mov~") COLUMN(NAME=~"ingreso.monto~") COLUMN(NAME=~"ingreso.base~") COLUMN(NAME=~"cod_movi.sigla~") COLUMN(NAME=~"ingreso.cod_caja~") COLUMN(NAME=~"ingreso.serie~") COLUMN(NAME=~"ingreso.contrato~")    JOIN (LEFT=~"ingreso.tipo_mov~"    OP =~"=~"RIGHT=~"cod_movi.cod_ing~" )WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"FECHA_PAGO~~~"~"   OP =~">=~"    EXP2 =~":fecha1~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"FECHA_PAGO~~~"~"   OP =~"<=~"    EXP2 =~":fecha2~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"COD_CAJA~~~"~"   OP =~"=~"    EXP2 =~":cod_caja~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~"'L'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"INGRESO~~~".~~~"TIPO_COB~~~"~"   OP =~"=~"    EXP2 =~"'CI'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"TIPO_COB~~~"~"   OP =~"=~"    EXP2 =~"'CU'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"TIPO_COB~~~"~"   OP =~"=~"    EXP2 =~"'C0'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"TIPO_COB~~~"~"   OP =~"=~"    EXP2 =~"'C1')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"CONTRATO~~~"~"   OP =~">~"    EXP2 =~"0~" ) ) ORDER(NAME=~"ingreso.folio~" ASC=yes ) ARG(NAME = ~"fecha1~" TYPE = date)  ARG(NAME = ~"fecha2~" TYPE = date)  ARG(NAME = ~"cod_caja~" TYPE = string) " arguments=(("fecha1", date),("fecha2", date),("cod_caja", string))  sort="cod_caja A folio A " )
