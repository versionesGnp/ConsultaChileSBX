 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"documentos~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"ingreso~" ) COLUMN(NAME=~"documentos.monto~") COLUMN(NAME=~"documentos.cod_caja~") COLUMN(NAME=~"documentos.fecha_pago~") COLUMN(NAME=~"documentos.cod_pago~") COLUMN(NAME=~"documentos.hora_pago~") COLUMN(NAME=~"documentos.minuto_pago~") COLUMN(NAME=~"documentos.folio~") COLUMN(NAME=~"documentos.tipo_cob~") COLUMN(NAME=~"documentos.rezago~") COLUMN(NAME=~"documentos.nro_cuotas_credito~") COLUMN(NAME=~"documentos.tipo_tarjeta_credito~") COLUMN(NAME=~"documentos.tipo_pago_tarjeta_credito~") COLUMN(NAME=~"documentos.fecha_venc~") COLUMN(NAME=~"cadena.cod_parque~") COLUMN(NAME=~"ingreso.base~") COLUMN(NAME=~"ingreso.serie~") COLUMN(NAME=~"ingreso.contrato~") COLUMN(NAME=~"documentos.estado_ch~") COLUMN(NAME=~"documentos.fecha_estado_ch~") COLUMN(NAME=~"documentos.cod_tarjeta_credito~") COLUMN(NAME=~"documentos.cod_autorizacion_credito~") COLUMN(NAME=~"documentos.cod_tarjeta_debito~") COLUMN(NAME=~"documentos.cod_autorizacion_debito~") COLUMN(NAME=~"documentos.cod_banco_debito~") COLUMN(NAME=~"documentos.n_cheque~") COLUMN(NAME=~"documentos.num_cheques~") COLUMN(NAME=~"documentos.glosa_ch~") COLUMN(NAME=~"documentos.cod_banco~")    JOIN (LEFT=~"ingreso.base~"    OP =~"=~"RIGHT=~"cadena.codigo~"    OUTER1 =~"ingreso.base~" )    JOIN (LEFT=~"ingreso.serie~"    OP =~"=~"RIGHT=~"cadena.serie~"    OUTER1 =~"ingreso.serie~" )    JOIN (LEFT=~"ingreso.contrato~"    OP =~"=~"RIGHT=~"cadena.numero~"    OUTER1 =~"ingreso.contrato~" )    JOIN (LEFT=~"documentos.folio~"    OP =~"=~"RIGHT=~"ingreso.folio~" )    JOIN (LEFT=~"documentos.tipo_cob~"    OP =~"=~"RIGHT=~"ingreso.tipo_cob~" )    JOIN (LEFT=~"documentos.fecha_pago~"    OP =~"=~"RIGHT=~"ingreso.fecha_pago~" )WHERE(    EXP1 =~"((~~~"DOCUMENTOS~~~".~~~"FECHA_PAGO~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"DOCUMENTOS~~~".~~~"FECHA_PAGO~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin)~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"(~~~"DOCUMENTOS~~~".~~~"FECHA_PAGO~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"DOCUMENTOS~~~".~~~"HORA_PAGO~~~"~"   OP =~">=~"    EXP2 =~":hora_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"DOCUMENTOS~~~".~~~"MINUTO_PAGO~~~"~"   OP =~">=~"    EXP2 =~":min_ini)~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"(~~~"DOCUMENTOS~~~".~~~"FECHA_PAGO~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"DOCUMENTOS~~~".~~~"HORA_PAGO~~~"~"   OP =~"<=~"    EXP2 =~":hora_fin~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"DOCUMENTOS~~~".~~~"MINUTO_PAGO~~~"~"   OP =~"<=~"    EXP2 =~":min_fin))~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = date)  ARG(NAME = ~"hora_ini~" TYPE = number)  ARG(NAME = ~"min_ini~" TYPE = number)  ARG(NAME = ~"fecha_fin~" TYPE = date)  ARG(NAME = ~"hora_fin~" TYPE = number)  ARG(NAME = ~"min_fin~" TYPE = number) " arguments=(("fecha_ini", date),("hora_ini", number),("min_ini", number),("fecha_fin", date),("hora_fin", number),("min_fin", number))  sort="fecha_pago A cod_caja A cod_pago A hora_pago A minuto_pago A " )
