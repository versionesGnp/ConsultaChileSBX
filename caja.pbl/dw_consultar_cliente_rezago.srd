 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cliente_rezago~" )  TABLE(NAME=~"ingreso~" ) COLUMN(NAME=~"cliente_rezago.rut~") COLUMN(NAME=~"cliente_rezago.base~") COLUMN(NAME=~"cliente_rezago.serie~") COLUMN(NAME=~"cliente_rezago.numero~") COLUMN(NAME=~"cliente_rezago.nombre~") COLUMN(NAME=~"cliente_rezago.ap_paterno~") COLUMN(NAME=~"cliente_rezago.ap_materno~") COLUMN(NAME=~"cliente_rezago.direccion_part~") COLUMN(NAME=~"cliente_rezago.comuna_part~") COLUMN(NAME=~"cliente_rezago.ciudad_part~") COLUMN(NAME=~"cliente_rezago.telefono_part~") COLUMN(NAME=~"cliente_rezago.fecha_crea~") COLUMN(NAME=~"cliente_rezago.usuario~") COLUMN(NAME=~"cliente_rezago.dv~") COLUMN(NAME=~"cliente_rezago.cod_pago~") COLUMN(NAME=~"cliente_rezago.folio~") COLUMN(NAME=~"cliente_rezago.fecha_pago~") COLUMN(NAME=~"cliente_rezago.estado~") COLUMN(NAME=~"cliente_rezago.caja~") COLUMN(NAME=~"cliente_rezago.fecha_traspaso_rezago~") COLUMN(NAME=~"cliente_rezago.usuario_genera_traspaso~") COLUMN(NAME=~"ingreso.monto~") COLUMN(NAME=~"ingreso.tipo_mov~")    JOIN (LEFT=~"cliente_rezago.base~"    OP =~"=~"RIGHT=~"ingreso.base~"    OUTER1 =~"cliente_rezago.base~" )    JOIN (LEFT=~"cliente_rezago.serie~"    OP =~"=~"RIGHT=~"ingreso.serie~"    OUTER1 =~"cliente_rezago.serie~" )    JOIN (LEFT=~"cliente_rezago.numero~"    OP =~"=~"RIGHT=~"ingreso.contrato~"    OUTER1 =~"cliente_rezago.numero~" )    JOIN (LEFT=~"cliente_rezago.rut~"    OP =~"=~"RIGHT=~"ingreso.rut~" )    JOIN (LEFT=~"cliente_rezago.folio~"    OP =~"=~"RIGHT=~"ingreso.folio~" )    JOIN (LEFT=~"cliente_rezago.cod_pago~"    OP =~"=~"RIGHT=~"ingreso.tipo_cob~" )    JOIN (LEFT=~"cliente_rezago.fecha_pago~"    OP =~"=~"RIGHT=~"ingreso.fecha_pago~" )WHERE(    EXP1 =~"~~~"CLIENTE_REZAGO~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CLIENTE_REZAGO~~~".~~~"FECHA_PAGO~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CLIENTE_REZAGO~~~".~~~"FECHA_PAGO~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"fecha_ini~" TYPE = date)  ARG(NAME = ~"fecha_fin~" TYPE = date) " arguments=(("base", string),("fecha_ini", date),("fecha_fin", date))  sort="fecha_pago D folio A " )
