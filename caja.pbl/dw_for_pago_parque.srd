table(column=(type=decimal(4) updatewhereclause=yes name=folio dbname="documentos.folio" )
 column=(type=char(2) updatewhereclause=yes name=tipo_cob dbname="documentos.tipo_cob" )
 column=(type=decimal(4) updatewhereclause=yes name=monto dbname="documentos.monto" )
 column=(type=char(2) updatewhereclause=yes name=cod_pago dbname="documentos.cod_pago" )
 column=(type=datetime updatewhereclause=yes name=fecha_pago dbname="documentos.fecha_pago" )
 column=(type=char(2) updatewhereclause=yes name=cod_caja dbname="documentos.cod_caja" )
 column=(type=datetime updatewhereclause=yes name=fecha_venc dbname="documentos.fecha_venc" )
 column=(type=decimal(0) updatewhereclause=yes name=tipo_pago_tarjeta_credito dbname="documentos.tipo_pago_tarjeta_credito" )
 column=(type=char(2) updatewhereclause=yes name=tipo_cob_aux dbname="documentos.tipo_cob_aux" )
 column=(type=datetime updatewhereclause=yes name=fecha_deposito dbname="documentos.fecha_deposito" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"documentos~" ) COLUMN(NAME=~"documentos.folio~") COLUMN(NAME=~"documentos.tipo_cob~") COLUMN(NAME=~"documentos.monto~") COLUMN(NAME=~"documentos.cod_pago~") COLUMN(NAME=~"documentos.fecha_pago~") COLUMN(NAME=~"documentos.cod_caja~") COLUMN(NAME=~"documentos.fecha_venc~") COLUMN(NAME=~"documentos.tipo_pago_tarjeta_credito~") COLUMN(NAME=~"documentos.tipo_cob_aux~") COLUMN(NAME=~"documentos.fecha_deposito~")WHERE(    EXP1 =~"( ~~~"DOCUMENTOS~~~".~~~"FECHA_DEPOSITO~~~"~"   OP =~"=~"    EXP2 =~":FE)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"DOCUMENTOS~~~".~~~"COD_CAJA~~~"~"   OP =~"=~"    EXP2 =~":CA~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"DOCUMENTOS~~~".~~~"COD_CAJA~~~"~"   OP =~"=~"    EXP2 =~":ca2)~" ) ) ARG(NAME = ~"FE~" TYPE = date)  ARG(NAME = ~"CA~" TYPE = string)  ARG(NAME = ~"ca2~" TYPE = string)  ARG(NAME = ~"cod_parque~" TYPE = number) " filter="f_funcion_parque = cod_parque"arguments=(("FE", date),("CA", string),("ca2", string),("cod_parque", number))  sort="cod_pago A " )
