 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"oferta_v~" )  TABLE(NAME=~"cliente~" )  TABLE(NAME=~"pago_oferta~" )  TABLE(NAME=~"tasa~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"cadena_mora~" ) COLUMN(NAME=~"oferta_v.serie~") COLUMN(NAME=~"oferta_v.nro_oferta~") COLUMN(NAME=~"oferta_v.fecha~") COLUMN(NAME=~"pago_oferta.fecha_entre~") COLUMN(NAME=~"pago_oferta.fecha_prim~") COLUMN(NAME=~"pago_oferta.fecha_ult~") COLUMN(NAME=~"pago_oferta.pie~") COLUMN(NAME=~"pago_oferta.fecha_pie~") COLUMN(NAME=~"pago_oferta.precio~") COLUMN(NAME=~"cliente.rut~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cliente.direccion_p~") COLUMN(NAME=~"cliente.comuna~") COLUMN(NAME=~"cliente.ciudad~") COLUMN(NAME=~"oferta_v.cod_age~") COLUMN(NAME=~"oferta_v.cod_sup~") COLUMN(NAME=~"pago_oferta.valor_cuota~") COLUMN(NAME=~"pago_oferta.nro_cuotas~") COLUMN(NAME=~"oferta_v.valor_cuota_m~") COLUMN(NAME=~"oferta_v.fecha_m~") COLUMN(NAME=~"oferta_v.tot_pagado~") COLUMN(NAME=~"oferta_v.cta_pag_s~") COLUMN(NAME=~"oferta_v.cta_pag_m~") COLUMN(NAME=~"oferta_v.abono_c~") COLUMN(NAME=~"oferta_v.abono_m~") COLUMN(NAME=~"oferta_v.tot_pagado_m~") COLUMN(NAME=~"pago_oferta.moneda~") COLUMN(NAME=~"tasa.tasa_m~") COLUMN(NAME=~"tasa.tasa_a~") COLUMN(NAME=~"tasa.tasa_int_p~") COLUMN(NAME=~"tasa.tasa_int_uf~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"pago_oferta.ctas_pactadas_pie~") COLUMN(NAME=~"pago_oferta.ctas_pagadas_pie~") COLUMN(NAME=~"pago_oferta.fecha_prim_pie~") COLUMN(NAME=~"cadena.cod_parque~") COLUMN(NAME=~"cadena_mora.mora_cred~") COLUMN(NAME=~"cadena_mora.mora_mant~") COLUMN(NAME=~"cadena_mora.dias_mora_cred~") COLUMN(NAME=~"cadena_mora.dias_mora_mant~") COLUMN(NAME=~"cadena_mora.fecha_venc_cred~") COLUMN(NAME=~"cadena_mora.fecha_venc_mant~") COLUMN(NAME=~"cadena_mora.mora_cred_pie~") COLUMN(NAME=~"cadena_mora.dias_mora_cred_pie~")    JOIN (LEFT=~"oferta_v.rut~"    OP =~"=~"RIGHT=~"cliente.rut~"    OUTER1 =~"oferta_v.rut~" )    JOIN (LEFT=~"oferta_v.serie~"    OP =~"=~"RIGHT=~"pago_oferta.serie~" )    JOIN (LEFT=~"oferta_v.nro_oferta~"    OP =~"=~"RIGHT=~"pago_oferta.nro_oferta~" )    JOIN (LEFT=~"oferta_v.ult_folio~"    OP =~"=~"RIGHT=~"pago_oferta.folio~" )    JOIN (LEFT=~"oferta_v.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"oferta_v.nro_oferta~"    OP =~"=~"RIGHT=~"cadena.numero~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"cadena_mora.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"cadena_mora.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"cadena_mora.numero~" )WHERE(    EXP1 =~"~~~"OFERTA_V~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":as_serie~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"OFERTA_V~~~".~~~"NRO_OFERTA~~~"~"   OP =~"=~"    EXP2 =~":an_numero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'O'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'U')~" ) ) ARG(NAME = ~"as_serie~" TYPE = string)  ARG(NAME = ~"an_numero~" TYPE = number) " arguments=(("as_serie", string),("an_numero", number)) )
