 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"detalle_pago_pie~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"producto_anexo~" )  TABLE(NAME=~"producto_pago~" ) COLUMN(NAME=~"detalle_pago_pie.base~") COLUMN(NAME=~"detalle_pago_pie.serie~") COLUMN(NAME=~"detalle_pago_pie.numero~") COLUMN(NAME=~"detalle_pago_pie.estado~") COLUMN(NAME=~"detalle_pago_pie.fecha_crea~") COLUMN(NAME=~"detalle_pago_pie.fecha_venc_cta~") COLUMN(NAME=~"detalle_pago_pie.numero_cuota~") COLUMN(NAME=~"detalle_pago_pie.monto_cuota~") COLUMN(NAME=~"detalle_pago_pie.tipo_cob~") COLUMN(NAME=~"detalle_pago_pie.folio~") COLUMN(NAME=~"detalle_pago_pie.caja~") COLUMN(NAME=~"detalle_pago_pie.usuario~") COLUMN(NAME=~"detalle_pago_pie.fecha_pago~") COLUMN(NAME=~"detalle_pago_pie.canal~") COLUMN(NAME=~"detalle_pago_pie.moneda~") COMPUTE(NAME=~"0,'',''~") COLUMN(NAME=~"detalle_pago_pie.monto_pie_pagado_peso~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"detalle_pago_pie.monto_pie_pagado_uf~") COLUMN(NAME=~"producto_pago.ctas_pie_pagadas~") COLUMN(NAME=~"producto_pago.fecha_pie_prim~") COLUMN(NAME=~"producto_pago.ctas_pie_plazo~")    JOIN (LEFT=~"detalle_pago_pie.base~"    OP =~"=~"RIGHT=~"cadena.codigo~" )    JOIN (LEFT=~"producto_anexo.base~"    OP =~"=~"RIGHT=~"producto_pago.base~" )    JOIN (LEFT=~"producto_anexo.serie~"    OP =~"=~"RIGHT=~"producto_pago.serie~" )    JOIN (LEFT=~"producto_anexo.numero~"    OP =~"=~"RIGHT=~"producto_pago.numero~" )    JOIN (LEFT=~"producto_anexo.ult_folio~"    OP =~"=~"RIGHT=~"producto_pago.folio~" )    JOIN (LEFT=~"detalle_pago_pie.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"detalle_pago_pie.numero~"    OP =~"=~"RIGHT=~"cadena.numero~" )    JOIN (LEFT=~"detalle_pago_pie.base~"    OP =~"=~"RIGHT=~"producto_anexo.base~" )    JOIN (LEFT=~"detalle_pago_pie.serie~"    OP =~"=~"RIGHT=~"producto_anexo.serie~" )    JOIN (LEFT=~"detalle_pago_pie.numero~"    OP =~"=~"RIGHT=~"producto_anexo.numero~" )WHERE(    EXP1 =~"(~~~"DETALLE_PAGO_PIE~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"DETALLE_PAGO_PIE~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"DETALLE_PAGO_PIE~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero)~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number)  ARG(NAME = ~"uf~" TYPE = number) " update="DETALLE_PAGO_PIE" updatewhere=0 updatekeyinplace=yes arguments=(("base", string),("serie", string),("numero", number),("uf", number))  sort="numero_cuota A " )
