 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"documentos~" )  TABLE(NAME=~"documentos_traspaso~" ) COLUMN(NAME=~"documentos.folio~") COLUMN(NAME=~"documentos.tipo_cob~") COLUMN(NAME=~"documentos.monto~") COLUMN(NAME=~"documentos.fecha_venc~") COLUMN(NAME=~"documentos.cod_pago~") COLUMN(NAME=~"documentos.cod_banco~") COLUMN(NAME=~"documentos.n_cheque~") COLUMN(NAME=~"documentos.rezago~") COLUMN(NAME=~"documentos.fecha_pago~") COLUMN(NAME=~"documentos.cod_caja~") COLUMN(NAME=~"documentos.estado_ch~") COLUMN(NAME=~"documentos.fecha_estado_ch~") COLUMN(NAME=~"documentos.cod_tarjeta_credito~") COLUMN(NAME=~"documentos.nro_cuotas_credito~") COLUMN(NAME=~"documentos.tipo_tarjeta_credito~") COLUMN(NAME=~"documentos.cod_tarjeta_debito~") COLUMN(NAME=~"documentos.cod_banco_debito~") COLUMN(NAME=~"documentos_traspaso.folio~") COLUMN(NAME=~"documentos_traspaso.tipo_cob~") COLUMN(NAME=~"documentos_traspaso.monto~")    JOIN (LEFT=~"documentos.folio~"    OP =~"=~"RIGHT=~"documentos_traspaso.folio_documentos~"    OUTER1 =~"documentos.folio~" )    JOIN (LEFT=~"documentos.tipo_cob~"    OP =~"=~"RIGHT=~"documentos_traspaso.tipo_cob_documentos~"    OUTER1 =~"documentos.tipo_cob~" )    JOIN (LEFT=~"documentos.fecha_pago~"    OP =~"=~"RIGHT=~"documentos_traspaso.fecha_pago_documentos~"    OUTER1 =~"documentos.fecha_pago~" )    JOIN (LEFT=~"documentos.cod_caja~"    OP =~"=~"RIGHT=~"documentos_traspaso.codigo_caja_documentos~"    OUTER1 =~"documentos.cod_caja~" )WHERE(    EXP1 =~"~~~"DOCUMENTOS_TRASPASO~~~".~~~"TRASPADO_PAGO~~~"~"   OP =~"like~"    EXP2 =~":traspaso_e~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"DOCUMENTOS~~~".~~~"FECHA_PAGO~~~"~"   OP =~"=~"    EXP2 =~":fecha~" ) ) ARG(NAME = ~"traspaso_e~" TYPE = string)  ARG(NAME = ~"fecha~" TYPE = date) " arguments=(("traspaso_e", string),("fecha", date)) )
