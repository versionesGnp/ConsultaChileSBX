 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ingreso~" )  TABLE(NAME=~"cod_movi~" )  TABLE(NAME=~"cliente~" ) COLUMN(NAME=~"ingreso.folio~") COLUMN(NAME=~"ingreso.tipo_cob~") COLUMN(NAME=~"ingreso.fecha_pago~") COLUMN(NAME=~"ingreso.tipo_mov~") COLUMN(NAME=~"ingreso.monto~") COLUMN(NAME=~"ingreso.cuotas_pag~") COLUMN(NAME=~"ingreso.base~") COLUMN(NAME=~"ingreso.serie~") COLUMN(NAME=~"ingreso.contrato~") COLUMN(NAME=~"ingreso.rut~") COLUMN(NAME=~"ingreso.cod_caja~") COLUMN(NAME=~"ingreso.rezago~") COLUMN(NAME=~"ingreso.codigo_otro~") COLUMN(NAME=~"cod_movi.orden~") COLUMN(NAME=~"cliente.dv~")    JOIN (LEFT=~"ingreso.rut~"    OP =~"=~"RIGHT=~"cliente.rut~"    OUTER1 =~"ingreso.rut~" )    JOIN (LEFT=~"ingreso.tipo_mov~"    OP =~"=~"RIGHT=~"cod_movi.cod_ing~" )WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"FECHA_PAGO~~~"~"   OP =~"=~"    EXP2 =~":fecha~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"MONTO~~~"~"   OP =~"<>~"    EXP2 =~"0~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"COD_CAJA~~~"~"   OP =~"<>~"    EXP2 =~"'X5'~" ) ) ARG(NAME = ~"fecha~" TYPE = datetime) " arguments=(("fecha", datetime))  sort="tipo_cob A folio A cod_movi_orden A " )
group(level=1 header.height=0 trailer.height=100 by=("tipo_cob" , "folio" ) header.color="536870912" trailer.color="536870912"  sort="sum(cod_movi_orden for group 1) A " )
