 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"bancos~" )  TABLE(NAME=~"tipo_tarjeta~" )  TABLE(NAME=~"documentos_traspaso~" ) COLUMN(NAME=~"bancos.descripcion~") COLUMN(NAME=~"tipo_tarjeta.descripcion~") COLUMN(NAME=~"documentos_traspaso.n_cheque~") COLUMN(NAME=~"documentos_traspaso.cod_banco~") COLUMN(NAME=~"documentos_traspaso.monto~") COLUMN(NAME=~"documentos_traspaso.fecha_venc~") COLUMN(NAME=~"documentos_traspaso.cod_tarjeta_credito~") COLUMN(NAME=~"documentos_traspaso.nro_cuotas_credito~") COLUMN(NAME=~"documentos_traspaso.cod_autorizacion_credito~") COLUMN(NAME=~"documentos_traspaso.tipo_tarjeta_credito~")    JOIN (LEFT=~"bancos.cod_banco~"    OP =~"=~"RIGHT=~"documentos_traspaso.cod_banco~" )    JOIN (LEFT=~"tipo_tarjeta.codigo~"    OP =~"=~"RIGHT=~"documentos_traspaso.tipo_tarjeta_credito~" )WHERE(    EXP1 =~"(~~~"DOCUMENTOS_TRASPASO~~~".~~~"TIPO_COB~~~"~"   OP =~"=~"    EXP2 =~"'CI'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"DOCUMENTOS_TRASPASO~~~".~~~"TIPO_COB~~~"~"   OP =~"=~"    EXP2 =~"'C0')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"DOCUMENTOS_TRASPASO~~~".~~~"FOLIO~~~"~"   OP =~"=~"    EXP2 =~":an_folio~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"DOCUMENTOS_TRASPASO~~~".~~~"COD_PAGO~~~"~"   OP =~"=~"    EXP2 =~"'TC'~" ) ) ARG(NAME = ~"an_folio~" TYPE = number) " arguments=(("an_folio", number)) )
