 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"cadena~" )  TABLE(NAME=~"ingreso~" )  TABLE(NAME=~"web_pagos~" )  TABLE(NAME=~"electronica_fb_detalle~" ) COLUMN(NAME=~"ingreso.monto~") COLUMN(NAME=~"ingreso.cod_caja~") COLUMN(NAME=~"web_pagos.fecha_pago~") COMPUTE(NAME=~"'EF'~") COLUMN(NAME=~"web_pagos.fecha_crea~") COLUMN(NAME=~"ingreso.tipo_cob~") COLUMN(NAME=~"ingreso.folio~") COLUMN(NAME=~"ingreso.tipo_mov~") COLUMN(NAME=~"ingreso.cuotas_pag~") COLUMN(NAME=~"ingreso.rezago~") COLUMN(NAME=~"ingreso.base~") COLUMN(NAME=~"ingreso.serie~") COLUMN(NAME=~"ingreso.contrato~") COLUMN(NAME=~"ingreso.fecha_venc~") COLUMN(NAME=~"cadena.cod_parque~") COLUMN(NAME=~"ingreso.rut~") COLUMN(NAME=~"electronica_fb_detalle.tipo_doc_asoc~") COLUMN(NAME=~"electronica_fb_detalle.folio_asoc~")    JOIN (LEFT=~"ingreso.base~"    OP =~"=~"RIGHT=~"cadena.codigo~"    OUTER1 =~"ingreso.base~" )    JOIN (LEFT=~"ingreso.serie~"    OP =~"=~"RIGHT=~"cadena.serie~"    OUTER1 =~"ingreso.serie~" )    JOIN (LEFT=~"ingreso.contrato~"    OP =~"=~"RIGHT=~"cadena.numero~"    OUTER1 =~"ingreso.contrato~" )    JOIN (LEFT=~"ingreso.serie~"    OP =~"=~"RIGHT=~"electronica_fb_detalle.serie~" )    JOIN (LEFT=~"ingreso.contrato~"    OP =~"=~"RIGHT=~"electronica_fb_detalle.numero~" )    JOIN (LEFT=~"ingreso.base~"    OP =~"=~"RIGHT=~"electronica_fb_detalle.base~" )    JOIN (LEFT=~"ingreso.folio~"    OP =~"=~"RIGHT=~"electronica_fb_detalle.nro_documento~" )    JOIN (LEFT=~"electronica_fb_detalle.base~"    OP =~"=~"RIGHT=~"web_pagos.base~" )    JOIN (LEFT=~"electronica_fb_detalle.serie~"    OP =~"=~"RIGHT=~"web_pagos.serie~" )    JOIN (LEFT=~"electronica_fb_detalle.numero~"    OP =~"=~"RIGHT=~"web_pagos.numero~" )    JOIN (LEFT=~"electronica_fb_detalle.folio_asoc~"    OP =~"=~"RIGHT=~"web_pagos.numero_cupon~" )    JOIN (LEFT=~"ingreso.tipo_cob~"    OP =~"=~"RIGHT=~"electronica_fb_detalle.tipo_documento~" )WHERE(    EXP1 =~"(~~~"WEB_PAGOS~~~".~~~"FECHA_CREA~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"WEB_PAGOS~~~".~~~"FECHA_CREA~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"COD_CAJA~~~"~"   OP =~"=~"    EXP2 =~"'WP')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"WEB_PAGOS~~~".~~~"ESTADO_PAGO~~~"~"   OP =~"=~"    EXP2 =~"'P'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"WEB_PAGOS~~~".~~~"ACTUALIZA_INGRESO~~~"~"   OP =~"=~"    EXP2 =~"'S'~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = datetime)  ARG(NAME = ~"fecha_fin~" TYPE = datetime) " arguments=(("fecha_ini", datetime),("fecha_fin", datetime))  sort="web_pagos_fecha_crea A ingreso_cod_caja A ingreso_tipo_cob A ingreso_folio A " )
