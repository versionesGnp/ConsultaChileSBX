 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ingreso~" ) COLUMN(NAME=~"ingreso.folio~") COLUMN(NAME=~"ingreso.tipo_cob~") COLUMN(NAME=~"ingreso.fecha_pago~") COLUMN(NAME=~"ingreso.tipo_mov~") COLUMN(NAME=~"ingreso.monto~") COLUMN(NAME=~"ingreso.cuotas_pag~") COLUMN(NAME=~"ingreso.serie~") COLUMN(NAME=~"ingreso.contrato~") COLUMN(NAME=~"ingreso.cod_caja~") COLUMN(NAME=~"ingreso.rezago~") COLUMN(NAME=~"ingreso.valor_uf~") COLUMN(NAME=~"ingreso.pago_hist~") COLUMN(NAME=~"ingreso.base~") COLUMN(NAME=~"ingreso.rut~") COLUMN(NAME=~"ingreso.usuario~") COLUMN(NAME=~"ingreso.cod_age~") COLUMN(NAME=~"ingreso.fecha_venc~") COLUMN(NAME=~"ingreso.pago_externo~") COLUMN(NAME=~"ingreso.lugar_externo~") COLUMN(NAME=~"ingreso.viene_de~") COLUMN(NAME=~"ingreso.fecha_ant~") COLUMN(NAME=~"ingreso.fcha_ant~") COLUMN(NAME=~"ingreso.servipag~") COLUMN(NAME=~"ingreso.codigo_otro~") COLUMN(NAME=~"ingreso.traspaso_e~") COLUMN(NAME=~"ingreso.fecha_traspaso_rezago~")WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"TIPO_COB~~~"~"   OP =~"=~"    EXP2 =~":tipo_cob~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"FOLIO~~~"~"   OP =~"=~"    EXP2 =~":folio~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"REZAGO~~~"~"   OP =~"=~"    EXP2 =~"'S'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"PAGO_HIST~~~"~"   OP =~"=~"    EXP2 =~"'A'~" ) )    UNION (PBSELECT( VERSION(400) TABLE(NAME=~"facturas_ingreso~" ) COLUMN(NAME=~"facturas_ingreso.folio~") COLUMN(NAME=~"facturas_ingreso.tipo_cob~") COLUMN(NAME=~"facturas_ingreso.fecha_pago~") COLUMN(NAME=~"facturas_ingreso.tipo_mov~") COLUMN(NAME=~"facturas_ingreso.monto~") COLUMN(NAME=~"facturas_ingreso.cuotas_pag~") COLUMN(NAME=~"facturas_ingreso.serie~") COLUMN(NAME=~"facturas_ingreso.contrato~") COLUMN(NAME=~"facturas_ingreso.cod_caja~") COLUMN(NAME=~"facturas_ingreso.rezago~") COLUMN(NAME=~"facturas_ingreso.valor_uf~") COLUMN(NAME=~"facturas_ingreso.pago_hist~") COLUMN(NAME=~"facturas_ingreso.base~") COLUMN(NAME=~"facturas_ingreso.rut~") COLUMN(NAME=~"facturas_ingreso.usuario~") COLUMN(NAME=~"facturas_ingreso.cod_age~") COLUMN(NAME=~"facturas_ingreso.fecha_venc~") COLUMN(NAME=~"facturas_ingreso.pago_externo~") COLUMN(NAME=~"facturas_ingreso.lugar_externo~") COLUMN(NAME=~"facturas_ingreso.viene_de~") COLUMN(NAME=~"facturas_ingreso.fecha_ant~") COLUMN(NAME=~"facturas_ingreso.fcha_ant~") COLUMN(NAME=~"facturas_ingreso.servipag~") COLUMN(NAME=~"facturas_ingreso.codigo_otro~") COLUMN(NAME=~"facturas_ingreso.traspaso_e~") COLUMN(NAME=~"facturas_ingreso.fecha_traspaso_rezago~")WHERE(    EXP1 =~"~~~"FACTURAS_INGRESO~~~".~~~"FOLIO~~~"~"   OP =~"=~"    EXP2 =~":folio~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FACTURAS_INGRESO~~~".~~~"TIPO_COB~~~"~"   OP =~"=~"    EXP2 =~":tipo_cob~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FACTURAS_INGRESO~~~".~~~"PAGO_HIST~~~"~"   OP =~"=~"    EXP2 =~"'A'~" ) )) ARG(NAME = ~"tipo_cob~" TYPE = string)  ARG(NAME = ~"folio~" TYPE = number) " arguments=(("tipo_cob", string),("folio", number))  sort="fecha_pago A tipo_cob A tipo_mov A " )
