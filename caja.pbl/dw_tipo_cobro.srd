table(column=(type=decimal(4) updatewhereclause=yes key=yes name=folio dbname="documentos.folio" dbalias=".folio" )
 column=(type=decimal(4) updatewhereclause=yes name=monto dbname="documentos.monto" dbalias=".monto" )
 column=(type=char(2) updatewhereclause=yes key=yes name=cod_pago dbname="documentos.cod_pago" dbalias=".cod_pago" )
 column=(type=char(2) updatewhereclause=yes key=yes name=tipo_cob dbname="documentos.tipo_cob" dbalias=".tipo_cob" )
 column=(type=datetime updatewhereclause=yes key=yes name=fecha_venc dbname="documentos.fecha_venc" dbalias=".fecha_venc" )
 column=(type=datetime updatewhereclause=yes name=fecha_deposito dbname="documentos.fecha_deposito" dbalias=".fecha_deposito" )
 column=(type=decimal(4) updatewhereclause=yes key=yes name=n_cheque dbname="documentos.n_cheque" dbalias=".n_cheque" )
 column=(type=decimal(4) updatewhereclause=yes key=yes name=cod_banco dbname="documentos.cod_banco" dbalias=".cod_banco" )
 column=(type=decimal(4) updatewhereclause=yes name=num_cheques dbname="documentos.num_cheques" dbalias=".num_cheques" )
 column=(type=char(2) updatewhereclause=yes name=rezago dbname="documentos.rezago" dbalias=".rezago" )
 column=(type=char(2) updatewhereclause=yes name=cod_caja dbname="documentos.cod_caja" dbalias=".cod_caja" )
 column=(type=decimal(0) updatewhereclause=yes name=tipo_pago_tarjeta_credito dbname="documentos.tipo_pago_tarjeta_credito" dbalias=".tipo_pago_tarjeta_credito" )
 column=(type=char(2) updatewhereclause=yes name=tipo_cob_aux dbname="documentos.tipo_cob_aux" dbalias=".tipo_cob_aux" )
 column=(type=datetime updatewhereclause=yes key=yes name=fecha_pago dbname="documentos.fecha_pago" dbalias=".fecha_pago" )
 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"documentos~" ) COLUMN(NAME=~"documentos.folio~") COLUMN(NAME=~"documentos.monto~") COLUMN(NAME=~"documentos.cod_pago~") COLUMN(NAME=~"documentos.tipo_cob~") COLUMN(NAME=~"documentos.fecha_venc~") COLUMN(NAME=~"documentos.fecha_deposito~") COLUMN(NAME=~"documentos.n_cheque~") COLUMN(NAME=~"documentos.cod_banco~") COLUMN(NAME=~"documentos.num_cheques~") COLUMN(NAME=~"documentos.rezago~") COLUMN(NAME=~"documentos.cod_caja~") COLUMN(NAME=~"documentos.tipo_pago_tarjeta_credito~") COLUMN(NAME=~"documentos.tipo_cob_aux~") COLUMN(NAME=~"documentos.fecha_pago~")WHERE(    EXP1 =~"(~~~"DOCUMENTOS~~~".~~~"FECHA_DEPOSITO~~~"~"   OP =~"=~"    EXP2 =~":FE )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"DOCUMENTOS~~~".~~~"COD_CAJA~~~"~"   OP =~"=~"    EXP2 =~":CA~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"DOCUMENTOS~~~".~~~"COD_CAJA~~~"~"   OP =~"=~"    EXP2 =~":ca2)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"DOCUMENTOS~~~".~~~"TIPO_COB_MP~~~"~"   OP =~"is~"    EXP2 =~"null~" ) ) ARG(NAME = ~"FE~" TYPE = date)  ARG(NAME = ~"CA~" TYPE = string)  ARG(NAME = ~"ca2~" TYPE = string) " update="DOCUMENTOS" updatewhere=0 updatekeyinplace=no arguments=(("FE", date),("CA", string),("ca2", string))  sort="tipo_cob A tipo_cob_aux A " )
