global type gf_existe_cupon from function_object
end type

forward prototypes
global function boolean gf_existe_cupon (long al_num_cupon)
end prototypes

global function boolean gf_existe_cupon (long al_num_cupon);long il_num_cupon

//SELECT DISTINCT "INGRESO"."FOLIO"  
//INTO 		:il_num_cupon
//FROM 		"INGRESO"  
//WHERE  ( "INGRESO"."FOLIO" = :al_num_cupon ) AND  
//		 ( "INGRESO"."TIPO_COB" = 'CU' );


SELECT "ELECTRONICA_FB_DETALLE"."FOLIO_ASOC"
INTO 		:il_num_cupon
FROM 	"ELECTRONICA_FB_DETALLE"  
WHERE  	( "ELECTRONICA_FB_DETALLE"."FOLIO_ASOC" = :al_num_cupon ) AND
			( "ELECTRONICA_FB_DETALLE"."TIPO_DOC_ASOC" = 'CU' ) ;

RETURN (al_num_cupon = il_num_cupon )

end function

