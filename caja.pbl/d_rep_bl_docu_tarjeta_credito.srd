table(column=(type=decimal(4) updatewhereclause=yes name=documentos_n_cheque dbname="documentos.n_cheque" dbalias=".n_cheque" )
 column=(type=decimal(4) updatewhereclause=yes name=documentos_monto dbname="documentos.monto" dbalias=".monto" )
 column=(type=datetime updatewhereclause=yes name=documentos_fecha_venc dbname="documentos.fecha_venc" dbalias=".fecha_venc" )
 column=(type=decimal(0) updatewhereclause=yes name=documentos_cod_tarjeta_credito dbname="documentos.cod_tarjeta_credito" dbalias=".cod_tarjeta_credito" )
 column=(type=decimal(0) updatewhereclause=yes name=documentos_nro_cuotas_credito dbname="documentos.nro_cuotas_credito" dbalias=".nro_cuotas_credito" )
 column=(type=char(20) updatewhereclause=yes name=documentos_cod_autorizacion_credito dbname="documentos.cod_autorizacion_credito" dbalias=".cod_autorizacion_credito" )
 column=(type=decimal(0) updatewhereclause=yes name=documentos_tipo_tarjeta_credito dbname="documentos.tipo_tarjeta_credito" dbalias=".tipo_tarjeta_credito" )
 column=(type=decimal(4) updatewhereclause=yes name=cod_banco dbname="documentos.cod_banco" dbalias=".cod_banco" )
 column=(type=char(15) updatewhereclause=yes name=bancos_descripcion_print dbname="bancos.descripcion_print" dbalias=".descripcion_print" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"documentos~" )  TABLE(NAME=~"bancos~" ) COLUMN(NAME=~"documentos.n_cheque~") COLUMN(NAME=~"documentos.monto~") COLUMN(NAME=~"documentos.fecha_venc~") COLUMN(NAME=~"documentos.cod_tarjeta_credito~") COLUMN(NAME=~"documentos.nro_cuotas_credito~") COLUMN(NAME=~"documentos.cod_autorizacion_credito~") COLUMN(NAME=~"documentos.tipo_tarjeta_credito~") COLUMN(NAME=~"documentos.cod_banco~") COLUMN(NAME=~"bancos.descripcion_print~")    JOIN (LEFT=~"documentos.cod_banco~"    OP =~"=~"RIGHT=~"bancos.cod_banco~" )WHERE(    EXP1 =~"~~~"DOCUMENTOS~~~".~~~"FOLIO~~~"~"   OP =~"=~"    EXP2 =~":an_folio~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"DOCUMENTOS~~~".~~~"COD_PAGO~~~"~"   OP =~"=~"    EXP2 =~"'TC'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"DOCUMENTOS~~~".~~~"TIPO_COB~~~"~"   OP =~"=~"    EXP2 =~":tipo_cob~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"DOCUMENTOS~~~".~~~"FECHA_PAGO~~~"~"   OP =~"=~"    EXP2 =~":fecha~" ) ) ARG(NAME = ~"an_folio~" TYPE = number)  ARG(NAME = ~"tipo_cob~" TYPE = string)  ARG(NAME = ~"fecha~" TYPE = date) " arguments=(("an_folio", number),("tipo_cob", string),("fecha", date))  sort="documentos_nro_cuotas_credito A " )
