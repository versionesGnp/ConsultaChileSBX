 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cliente_rezago~" ) COLUMN(NAME=~"cliente_rezago.rut~") COLUMN(NAME=~"cliente_rezago.base~") COLUMN(NAME=~"cliente_rezago.serie~") COLUMN(NAME=~"cliente_rezago.numero~") COLUMN(NAME=~"cliente_rezago.nombre~") COLUMN(NAME=~"cliente_rezago.ap_paterno~") COLUMN(NAME=~"cliente_rezago.ap_materno~") COLUMN(NAME=~"cliente_rezago.direccion_part~") COLUMN(NAME=~"cliente_rezago.comuna_part~") COLUMN(NAME=~"cliente_rezago.ciudad_part~") COLUMN(NAME=~"cliente_rezago.telefono_part~") COLUMN(NAME=~"cliente_rezago.fecha_crea~") COLUMN(NAME=~"cliente_rezago.usuario~") COLUMN(NAME=~"cliente_rezago.dv~") COMPUTE(NAME=~"0~") COLUMN(NAME=~"cliente_rezago.cod_pago~") COLUMN(NAME=~"cliente_rezago.folio~") COLUMN(NAME=~"cliente_rezago.fecha_pago~") COLUMN(NAME=~"cliente_rezago.estado~") COLUMN(NAME=~"cliente_rezago.caja~") COLUMN(NAME=~"cliente_rezago.fecha_traspaso_rezago~") COLUMN(NAME=~"cliente_rezago.usuario_genera_traspaso~") COLUMN(NAME=~"cliente_rezago.cod_parque~") COLUMN(NAME=~"cliente_rezago.moneda~")WHERE(    EXP1 =~"~~~"CLIENTE_REZAGO~~~".~~~"RUT~~~"~"   OP =~"=~"    EXP2 =~":rut~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CLIENTE_REZAGO~~~".~~~"FECHA_CREA~~~"~"   OP =~"=~"    EXP2 =~"(SELECT MAX(~~~"CLIENTE_REZAGO~~~".~~~"FECHA_CREA~~~") FROM ~~~"CLIENTE_REZAGO~~~" WHERE ~~~"CLIENTE_REZAGO~~~".~~~"RUT~~~" = :rut )~" ) ) ARG(NAME = ~"rut~" TYPE = number) " update="CLIENTE_REZAGO" updatewhere=0 updatekeyinplace=yes arguments=(("rut", number)) )
