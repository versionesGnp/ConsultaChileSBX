 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"documentos~" ) COLUMN(NAME=~"documentos.folio~") COLUMN(NAME=~"documentos.tipo_cob~") COLUMN(NAME=~"documentos.n_cheque~") COLUMN(NAME=~"documentos.cod_banco~") COLUMN(NAME=~"documentos.monto~") COLUMN(NAME=~"documentos.fecha_venc~") COLUMN(NAME=~"documentos.cod_pago~") COLUMN(NAME=~"documentos.num_cheques~") COLUMN(NAME=~"documentos.rezago~") COLUMN(NAME=~"documentos.fecha_pago~") COLUMN(NAME=~"documentos.cod_caja~") COLUMN(NAME=~"documentos.estado_ch~") COLUMN(NAME=~"documentos.glosa_ch~") COLUMN(NAME=~"documentos.fecha_estado_ch~")WHERE(    EXP1 =~"~~~"DOCUMENTOS~~~".~~~"FECHA_PAGO~~~"~"   OP =~">=~"    EXP2 =~":fec_ini~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"DOCUMENTOS~~~".~~~"FECHA_PAGO~~~"~"   OP =~"<=~"    EXP2 =~":fec_fin~" ) ) ORDER(NAME=~"documentos.folio~" ASC=yes )  ORDER(NAME=~"documentos.tipo_cob~" ASC=yes ) ARG(NAME = ~"fec_ini~" TYPE = date)  ARG(NAME = ~"fec_fin~" TYPE = date) " update="DOCUMENTOS" updatewhere=0 updatekeyinplace=no arguments=(("fec_ini", date),("fec_fin", date))  sort="documentos_folio A documentos_tipo_cob A " )
