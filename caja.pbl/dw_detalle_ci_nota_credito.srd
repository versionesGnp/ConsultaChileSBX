 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"nota_de_credito~" )  TABLE(NAME=~"cod_movi~" ) COLUMN(NAME=~"nota_de_credito.tipo_cob~") COLUMN(NAME=~"nota_de_credito.folio~") COLUMN(NAME=~"nota_de_credito.fecha_pago~") COLUMN(NAME=~"nota_de_credito.tipo_mov~") COLUMN(NAME=~"nota_de_credito.estado~") COLUMN(NAME=~"nota_de_credito.monto~") COLUMN(NAME=~"nota_de_credito.cuotas_pag~") COLUMN(NAME=~"nota_de_credito.base~") COLUMN(NAME=~"nota_de_credito.serie~") COLUMN(NAME=~"nota_de_credito.numero~") COLUMN(NAME=~"nota_de_credito.tipo_cob_original~") COLUMN(NAME=~"nota_de_credito.folio_original~") COLUMN(NAME=~"nota_de_credito.codigo_otro~") COLUMN(NAME=~"nota_de_credito.codigo_motivo~") COLUMN(NAME=~"cod_movi.sigla~")    JOIN (LEFT=~"nota_de_credito.tipo_mov~"    OP =~"=~"RIGHT=~"cod_movi.cod_ing~" )WHERE(    EXP1 =~"~~~"NOTA_DE_CREDITO~~~".~~~"TIPO_COB_ORIGINAL~~~"~"   OP =~"=~"    EXP2 =~":tipo_cob~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"NOTA_DE_CREDITO~~~".~~~"FOLIO_ORIGINAL~~~"~"   OP =~"=~"    EXP2 =~":folio~" ) ) ARG(NAME = ~"folio~" TYPE = number)  ARG(NAME = ~"tipo_cob~" TYPE = string) " arguments=(("folio", number),("tipo_cob", string)) )
