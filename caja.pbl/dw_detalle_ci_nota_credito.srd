 column=(type=char(1) update=yes updatewhereclause=yes name=serie dbname="nota_de_credito.serie" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=numero dbname="nota_de_credito.numero" )
 column=(type=char(2) update=yes updatewhereclause=yes name=tipo_cob_original dbname="nota_de_credito.tipo_cob_original" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=folio_original dbname="nota_de_credito.folio_original" )
 column=(type=char(5) update=yes updatewhereclause=yes name=codigo_otro dbname="nota_de_credito.codigo_otro" )
