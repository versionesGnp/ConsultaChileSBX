 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"caja_externa_respaldo_txt~" ) COLUMN(NAME=~"caja_externa_respaldo_txt.caja~") COLUMN(NAME=~"caja_externa_respaldo_txt.rut~") COLUMN(NAME=~"caja_externa_respaldo_txt.dv~") COLUMN(NAME=~"caja_externa_respaldo_txt.tipo_pago~") COLUMN(NAME=~"caja_externa_respaldo_txt.cupon~") COLUMN(NAME=~"caja_externa_respaldo_txt.monto_pago~") COLUMN(NAME=~"caja_externa_respaldo_txt.fecha_pago~") COLUMN(NAME=~"caja_externa_respaldo_txt.fecha_deposito~") COLUMN(NAME=~"caja_externa_respaldo_txt.nombre_archivo~")WHERE(    EXP1 =~"~~~"CAJA_EXTERNA_RESPALDO_TXT~~~".~~~"FECHA_DEPOSITO~~~"~"   OP =~"=~"    EXP2 =~":ls_fecha~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CAJA_EXTERNA_RESPALDO_TXT~~~".~~~"NOMBRE_ARCHIVO~~~"~"   OP =~"=~"    EXP2 =~":ls_nombre~" ) ) ARG(NAME = ~"ls_fecha~" TYPE = date)  ARG(NAME = ~"ls_nombre~" TYPE = string) " arguments=(("ls_fecha", date),("ls_nombre", string)) )
