 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"electronica_fb_detalle~" ) COLUMN(NAME=~"electronica_fb_detalle.grupo~") COLUMN(NAME=~"electronica_fb_detalle.tipo_documento~") COLUMN(NAME=~"electronica_fb_detalle.nro_documento~") COLUMN(NAME=~"electronica_fb_detalle.rut~") COLUMN(NAME=~"electronica_fb_detalle.estado_reg~") COLUMN(NAME=~"electronica_fb_detalle.dv~") COLUMN(NAME=~"electronica_fb_detalle.nombre_cliente~") COLUMN(NAME=~"electronica_fb_detalle.monto_afecto~") COLUMN(NAME=~"electronica_fb_detalle.monto_exento~") COLUMN(NAME=~"electronica_fb_detalle.monto_iva~") COLUMN(NAME=~"electronica_fb_detalle.monto_total~") COLUMN(NAME=~"electronica_fb_detalle.usuario_crea~") COLUMN(NAME=~"electronica_fb_detalle.fecha_pago~") COLUMN(NAME=~"electronica_fb_detalle.fecha_crea~") COLUMN(NAME=~"electronica_fb_detalle.cod_caja~") COLUMN(NAME=~"electronica_fb_detalle.base~") COLUMN(NAME=~"electronica_fb_detalle.serie~") COLUMN(NAME=~"electronica_fb_detalle.numero~") COLUMN(NAME=~"electronica_fb_detalle.tipo_dte~") COLUMN(NAME=~"electronica_fb_detalle.estado_documento~") COLUMN(NAME=~"electronica_fb_detalle.tasa_iva~") COLUMN(NAME=~"electronica_fb_detalle.ip_equipo~") COLUMN(NAME=~"electronica_fb_detalle.tipo_doc_asoc~") COLUMN(NAME=~"electronica_fb_detalle.folio_asoc~") COLUMN(NAME=~"electronica_fb_detalle.rut_empresa~")WHERE(    EXP1 =~"( ~~~"ELECTRONICA_FB_DETALLE~~~".~~~"GRUPO~~~"~"   OP =~"=~"    EXP2 =~":grupo )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"ELECTRONICA_FB_DETALLE~~~".~~~"TIPO_DOCUMENTO~~~"~"   OP =~"=~"    EXP2 =~":tipo_doc )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"ELECTRONICA_FB_DETALLE~~~".~~~"RUT_EMPRESA~~~"~"   OP =~"=~"    EXP2 =~":rut_empresa)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"ELECTRONICA_FB_DETALLE~~~".~~~"ESTADO_REG~~~"~"   OP =~"=~"    EXP2 =~"'P')~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"tipo_doc~" TYPE = string)  ARG(NAME = ~"rut_empresa~" TYPE = string) " update="ELECTRONICA_FB_DETALLE" updatewhere=0 updatekeyinplace=yes arguments=(("grupo", number),("tipo_doc", string),("rut_empresa", string))  sort="grupo A nro_documento A " )
