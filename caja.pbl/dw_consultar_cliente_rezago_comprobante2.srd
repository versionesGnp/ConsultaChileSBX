 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cliente_rezago~" )  TABLE(NAME=~"ingreso~" ) COLUMN(NAME=~"cliente_rezago.rut~") COLUMN(NAME=~"cliente_rezago.base~") COLUMN(NAME=~"cliente_rezago.serie~") COLUMN(NAME=~"cliente_rezago.numero~") COLUMN(NAME=~"cliente_rezago.nombre~") COLUMN(NAME=~"cliente_rezago.ap_paterno~") COLUMN(NAME=~"cliente_rezago.ap_materno~") COLUMN(NAME=~"cliente_rezago.direccion_part~") COLUMN(NAME=~"cliente_rezago.comuna_part~") COLUMN(NAME=~"cliente_rezago.ciudad_part~") COLUMN(NAME=~"cliente_rezago.telefono_part~") COLUMN(NAME=~"cliente_rezago.fecha_crea~") COLUMN(NAME=~"cliente_rezago.usuario~") COLUMN(NAME=~"cliente_rezago.dv~") COLUMN(NAME=~"cliente_rezago.cod_pago~") COLUMN(NAME=~"cliente_rezago.folio~") COLUMN(NAME=~"cliente_rezago.fecha_pago~") COLUMN(NAME=~"cliente_rezago.estado~") COLUMN(NAME=~"cliente_rezago.caja~") COLUMN(NAME=~"cliente_rezago.fecha_traspaso_rezago~") COLUMN(NAME=~"cliente_rezago.usuario_genera_traspaso~") COLUMN(NAME=~"ingreso.monto~") COLUMN(NAME=~"ingreso.tipo_mov~")    JOIN (LEFT=~"cliente_rezago.rut~"    OP =~"=~"RIGHT=~"ingreso.rut~" )    JOIN (LEFT=~"cliente_rezago.cod_pago~"    OP =~"=~"RIGHT=~"ingreso.tipo_cob~" )    JOIN (LEFT=~"cliente_rezago.folio~"    OP =~"=~"RIGHT=~"ingreso.folio~" )WHERE(    EXP1 =~"~~~"CLIENTE_REZAGO~~~".~~~"COD_PAGO~~~"~"   OP =~"=~"    EXP2 =~":tipo_cob~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CLIENTE_REZAGO~~~".~~~"FECHA_PAGO~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CLIENTE_REZAGO~~~".~~~"FECHA_PAGO~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~" ) ) ARG(NAME = ~"tipo_cob~" TYPE = string)  ARG(NAME = ~"fecha_ini~" TYPE = date)  ARG(NAME = ~"fecha_fin~" TYPE = date) " arguments=(("tipo_cob", string),("fecha_ini", date),("fecha_fin", date))  sort="fecha_pago D folio A " )
