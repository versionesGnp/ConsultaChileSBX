 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"bancos~" )  TABLE(NAME=~"tipo_tarjeta~" )  TABLE(NAME=~"documentos_traspaso~" ) COLUMN(NAME=~"tipo_tarjeta.descripcion~") COLUMN(NAME=~"documentos_traspaso.n_cheque~") COLUMN(NAME=~"documentos_traspaso.cod_banco~") COLUMN(NAME=~"documentos_traspaso.monto~") COLUMN(NAME=~"documentos_traspaso.fecha_venc~") COLUMN(NAME=~"documentos_traspaso.cod_tarjeta_credito~") COLUMN(NAME=~"documentos_traspaso.nro_cuotas_credito~") COLUMN(NAME=~"documentos_traspaso.cod_autorizacion_credito~") COLUMN(NAME=~"documentos_traspaso.tipo_tarjeta_credito~") COLUMN(NAME=~"bancos.descripcion_print~") COLUMN(NAME=~"bancos.descripcion~")    JOIN (LEFT=~"documentos_traspaso.cod_banco~"    OP =~"=~"RIGHT=~"bancos.cod_banco~" )    JOIN (LEFT=~"documentos_traspaso.tipo_tarjeta_credito~"    OP =~"=~"RIGHT=~"tipo_tarjeta.codigo~" )WHERE(    EXP1 =~"~~~"DOCUMENTOS_TRASPASO~~~".~~~"FOLIO~~~"~"   OP =~"=~"    EXP2 =~":an_folio~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"DOCUMENTOS_TRASPASO~~~".~~~"COD_PAGO~~~"~"   OP =~"=~"    EXP2 =~"'TC'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"DOCUMENTOS_TRASPASO~~~".~~~"TIPO_COB~~~"~"   OP =~"=~"    EXP2 =~"'BL'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"DOCUMENTOS_TRASPASO~~~".~~~"TIPO_COB~~~"~"   OP =~"=~"    EXP2 =~"'B0')~" ) ) ARG(NAME = ~"an_folio~" TYPE = number) " arguments=(("an_folio", number)) )
