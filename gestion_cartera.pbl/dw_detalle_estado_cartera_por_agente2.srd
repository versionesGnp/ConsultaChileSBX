erta_v.cod_age~"    OP =~"=~"RIGHT=~"agentes.cod_age~" )    JOIN (LEFT=~"agentes.cod_sup~"    OP =~"=~"RIGHT=~"supervisor.cod_sup~" )    JOIN (LEFT=~"supervisor.cod_jefe~"    OP =~"=~"RIGHT=~"jefe_ventas.jefe_ventas~" )WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'O'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"(~~~"OFERTA_V~~~".~~~"U_FECHA~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"OFERTA_V~~~".~~~"U_FECHA~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"OFERTA_V~~~".~~~"COD_SUP~~~"~"   OP =~"=~"    EXP2 =~":codigo~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = datetime)  ARG(NAME = ~"fecha_fin~" TYPE = datetime)  ARG(NAME = ~"codigo~" TYPE = string) " arguments=(("fecha_ini", datetime),("fecha_fin", datetime),("codigo", string))  sort="oferta_v_cod_jef A oferta_v_cod_sup A oferta_v_cod_age A " )
