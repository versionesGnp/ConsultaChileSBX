 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"remu~" ) COLUMN(NAME=~"remu.nombre~") COLUMN(NAME=~"remu.num_rut~") COLUMN(NAME=~"remu.dgv_rut~") COLUMN(NAME=~"remu.num_periodo~") COLUMN(NAME=~"remu.gls_mes~") COLUMN(NAME=~"remu.dias_trabaj~") COLUMN(NAME=~"remu.mto_imponible~") COLUMN(NAME=~"remu.mto_liquido~") COLUMN(NAME=~"remu.t_haberes~")WHERE(    EXP1 =~"~~~"REMU~~~".~~~"NUM_RUT~~~"~"   OP =~"=~"    EXP2 =~":rut~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"((~~~"REMU~~~".~~~"NUM_PERIODO~~~"~"   OP =~">=~"    EXP2 =~":anno_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"REMU~~~".~~~"GLS_MES~~~"~"   OP =~">=~"    EXP2 =~":mes_ini)~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"(~~~"REMU~~~".~~~"NUM_PERIODO~~~"~"   OP =~"<=~"    EXP2 =~":anno_fin~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"REMU~~~".~~~"GLS_MES~~~"~"   OP =~"<=~"    EXP2 =~":mes_fin))~" ) ) ARG(NAME = ~"rut~" TYPE = number)  ARG(NAME = ~"anno_ini~" TYPE = number)  ARG(NAME = ~"mes_ini~" TYPE = number)  ARG(NAME = ~"anno_fin~" TYPE = number)  ARG(NAME = ~"mes_fin~" TYPE = number) " update="REMU" updatewhere=1 updatekeyinplace=no arguments=(("rut", number),("anno_ini", number),("mes_ini", number),("anno_fin", number),("mes_fin", number)) )
