 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"vista_docto_pend_informe~" ) COLUMN(NAME=~"vista_docto_pend_informe.base~") COLUMN(NAME=~"vista_docto_pend_informe.serie~") COLUMN(NAME=~"vista_docto_pend_informe.numero~") COLUMN(NAME=~"vista_docto_pend_informe.ult_estado~") COLUMN(NAME=~"vista_docto_pend_informe.mes~") COLUMN(NAME=~"vista_docto_pend_informe.anno~") COLUMN(NAME=~"vista_docto_pend_informe.codigo_grupo_excepcion~") COLUMN(NAME=~"vista_docto_pend_informe.grupo_excep~") COLUMN(NAME=~"vista_docto_pend_informe.nombre_sup~") COLUMN(NAME=~"vista_docto_pend_informe.nombre_jef~") COMPUTE(NAME=~" ( CASE WHEN ~~~"VISTA_DOCTO_PEND_INFORME~~~".~~~"MES~~~" = 1 THEN '01'||'-'|| ~~~"VISTA_DOCTO_PEND_INFORME~~~".~~~"ANNO~~~" WHEN ~~~"VISTA_DOCTO_PEND_INFORME~~~".~~~"MES~~~" = 2 THEN '02'||'-'|| ~~~"VISTA_DOCTO_PEND_INFORME~~~".~~~"ANNO~~~" WHEN ~~~"VISTA_DOCTO_PEND_INFORME~~~".~~~"MES~~~" = 3 THEN '03'||'-'|| ~~~"VISTA_DOCTO_PEND_INFORME~~~".~~~"ANNO~~~" WHEN ~~~"VISTA_DOCTO_PEND_INFORME~~~".~~~"MES~~~" = 4 THEN '04'||'-'|| ~~~"VISTA_DOCTO_PEND_INFORME~~~".~~~"ANNO~~~" WHEN ~~~"VISTA_DOCTO_PEND_INFORME~~~".~~~"MES~~~" = 5 THEN '05'||'-'|| ~~~"VISTA_DOCTO_PEND_INFORME~~~".~~~"ANNO~~~" WHEN ~~~"VISTA_DOCTO_PEND_INFORME~~~".~~~"MES~~~" = 6 THEN '06'||'-'|| ~~~"VISTA_DOCTO_PEND_INFORME~~~".~~~"ANNO~~~" WHEN ~~~"VISTA_DOCTO_PEND_INFORME~~~".~~~"MES~~~" = 7 THEN '07'||'-'|| ~~~"VISTA_DOCTO_PEND_INFORME~~~".~~~"ANNO~~~" WHEN ~~~"VISTA_DOCTO_PEND_INFORME~~~".~~~"MES~~~" = 8 THEN '08'||'-'|| ~~~"VISTA_DOCTO_PEND_INFORME~~~".~~~"ANNO~~~" WHEN ~~~"VISTA_DOCTO_PEND_INFORME~~~".~~~"MES~~~" = 9 THEN '09'||'-'|| ~~~"VISTA_DOCTO_PEND_INFORME~~~".~~~"ANNO~~~" WHEN ~~~"VISTA_DOCTO_PEND_INFORME~~~".~~~"MES~~~" = 10 THEN '10'||'-'|| ~~~"VISTA_DOCTO_PEND_INFORME~~~".~~~"ANNO~~~" WHEN ~~~"VISTA_DOCTO_PEND_INFORME~~~".~~~"MES~~~" = 11 THEN '11'||'-'|| ~~~"VISTA_DOCTO_PEND_INFORME~~~".~~~"ANNO~~~" ELSE '12'||'-'|| ~~~"VISTA_DOCTO_PEND_INFORME~~~".~~~"ANNO~~~" END) as periodo~")WHERE(    EXP1 =~"~~~"VISTA_DOCTO_PEND_INFORME~~~".~~~"MES~~~"~"   OP =~">=~"    EXP2 =~":mes_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"VISTA_DOCTO_PEND_INFORME~~~".~~~"ANNO~~~"~"   OP =~">=~"    EXP2 =~":ano_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"VISTA_DOCTO_PEND_INFORME~~~".~~~"MES~~~"~"   OP =~"<=~"    EXP2 =~":mes_fin~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"VISTA_DOCTO_PEND_INFORME~~~".~~~"ANNO~~~"~"   OP =~"<=~"    EXP2 =~":ano_fin~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"VISTA_DOCTO_PEND_INFORME~~~".~~~"CODIGO_GRUPO_EXCEPCION~~~"~"   OP =~"=~"    EXP2 =~"3~" ) ) ARG(NAME = ~"mes_ini~" TYPE = number)  ARG(NAME = ~"ano_ini~" TYPE = number)  ARG(NAME = ~"mes_fin~" TYPE = number)  ARG(NAME = ~"ano_fin~" TYPE = number) " arguments=(("mes_ini", number),("ano_ini", number),("mes_fin", number),("ano_fin", number))  sort="grupo_excep A " )
