table(column=(type=char(5) update=yes updatewhereclause=yes name=jefe_ventas dbname="jefe_ventas.jefe_ventas" dbalias=".jefe_ventas" )
 column=(type=char(20) update=yes updatewhereclause=yes name=nombre dbname="jefe_ventas.nombre" dbalias=".nombre" )
 column=(type=char(50) update=yes updatewhereclause=yes name=a_paterno dbname="jefe_ventas.a_paterno" dbalias=".a_paterno" )
 column=(type=char(50) update=yes updatewhereclause=yes name=a_materno dbname="jefe_ventas.a_materno" dbalias=".a_materno" )
 column=(type=datetime update=yes updatewhereclause=yes name=fecha_ing dbname="jefe_ventas.fecha_ing" dbalias=".fecha_ing" )
 column=(type=datetime update=yes updatewhereclause=yes name=fecha_fin dbname="jefe_ventas.fecha_fin" dbalias=".fecha_fin" )
 column=(type=char(1) update=yes updatewhereclause=yes name=estado dbname="jefe_ventas.estado" dbalias=".estado" values="Activo	A/Inactivo	I/" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=rut dbname="jefe_ventas.rut" dbalias=".rut" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=porc_jefe_vta dbname="jefe_ventas.porc_jefe_vta" dbalias=".porc_jefe_vta" )
 column=(type=decimal(4) updatewhereclause=yes name=cod_parque dbname="jefe_ventas.cod_parque" dbalias=".cod_parque" )
 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"jefe_ventas~" )  TABLE(NAME=~"agentes~" )  TABLE(NAME=~"supervisor~" ) COLUMN(NAME=~"jefe_ventas.jefe_ventas~") COLUMN(NAME=~"jefe_ventas.nombre~") COLUMN(NAME=~"jefe_ventas.a_paterno~") COLUMN(NAME=~"jefe_ventas.a_materno~") COLUMN(NAME=~"jefe_ventas.fecha_ing~") COLUMN(NAME=~"jefe_ventas.fecha_fin~") COLUMN(NAME=~"jefe_ventas.estado~") COLUMN(NAME=~"jefe_ventas.rut~") COLUMN(NAME=~"jefe_ventas.porc_jefe_vta~") COLUMN(NAME=~"jefe_ventas.cod_parque~")    JOIN (LEFT=~"jefe_ventas.jefe_ventas~"    OP =~"=~"RIGHT=~"supervisor.cod_jefe~" )    JOIN (LEFT=~"supervisor.cod_sup~"    OP =~"=~"RIGHT=~"agentes.cod_sup~" )WHERE(    EXP1 =~"~~~"JEFE_VENTAS~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'A'~" ) ) "  sort="estado A jefe_ventas A " )
