 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"supervisor~" )  TABLE(NAME=~"agentes~" ) COLUMN(NAME=~"supervisor.cod_sup~") COLUMN(NAME=~"supervisor.cod_jefe~") COLUMN(NAME=~"supervisor.nombre~") COLUMN(NAME=~"supervisor.a_paterno~") COLUMN(NAME=~"supervisor.a_materno~") COLUMN(NAME=~"supervisor.tipo~") COLUMN(NAME=~"supervisor.fecha_ing~") COLUMN(NAME=~"supervisor.fecha_fin~") COLUMN(NAME=~"supervisor.estado~") COLUMN(NAME=~"supervisor.rut~") COLUMN(NAME=~"supervisor.cod_parque~")    JOIN (LEFT=~"supervisor.cod_sup~"    OP =~"=~"RIGHT=~"agentes.cod_sup~" )WHERE(    EXP1 =~"~~~"SUPERVISOR~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'A'~" ) ) "  sort="estado A cod_jefe A " )
