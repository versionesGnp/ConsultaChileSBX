 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cd_folio~" ) COLUMN(NAME=~"cd_folio.base~") COLUMN(NAME=~"cd_folio.serie~") COLUMN(NAME=~"cd_folio.numero~") COLUMN(NAME=~"cd_folio.fecha_crea~") COLUMN(NAME=~"cd_folio.usuario_crea~") COLUMN(NAME=~"cd_folio.cod_agente~") COLUMN(NAME=~"cd_folio.cod_supervisor~") COLUMN(NAME=~"cd_folio.cod_jefe_venta~") COLUMN(NAME=~"cd_folio.ult_estado~") COLUMN(NAME=~"cd_folio.ult_fecha_estado~") COLUMN(NAME=~"cd_folio.ult_glosa_estado~") COLUMN(NAME=~"cd_folio.ult_memo~") COLUMN(NAME=~"cd_folio.ult_usuario_gestion~") COLUMN(NAME=~"cd_folio.depto_asignado~") COLUMN(NAME=~"cd_folio.estado_reg~") COLUMN(NAME=~"cd_folio.ult_referencia_memo~") COLUMN(NAME=~"cd_folio.usuario_entregar_form~") COLUMN(NAME=~"cd_folio.cod_parque~")WHERE(    EXP1 =~"~~~"CD_FOLIO~~~".~~~"NUMERO~~~"~"   OP =~">=~"    EXP2 =~":folio_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CD_FOLIO~~~".~~~"NUMERO~~~"~"   OP =~"<=~"    EXP2 =~":folio_fin~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CD_FOLIO~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CD_FOLIO~~~".~~~"ULT_ESTADO~~~"~"   OP =~"<=~"    EXP2 =~"1~" ) ) ARG(NAME = ~"folio_ini~" TYPE = number)  ARG(NAME = ~"folio_fin~" TYPE = number)  ARG(NAME = ~"base~" TYPE = string) " update="CD_FOLIO" updatewhere=0 updatekeyinplace=yes arguments=(("folio_ini", number),("folio_fin", number),("base", string))  sort="numero A base A serie A " )
