 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cd_informe_detalle~" )  TABLE(NAME=~"cd_informe~" ) COLUMN(NAME=~"cd_informe_detalle.base~") COLUMN(NAME=~"cd_informe_detalle.serie~") COLUMN(NAME=~"cd_informe_detalle.fecha_crea~") COLUMN(NAME=~"cd_informe_detalle.correlativo~") COLUMN(NAME=~"cd_informe_detalle.referencia~") COLUMN(NAME=~"cd_informe_detalle.estado_cd~") COLUMN(NAME=~"cd_informe_detalle.usuario~") COLUMN(NAME=~"cd_informe_detalle.observacion~") COLUMN(NAME=~"cd_informe_detalle.departamento~") COLUMN(NAME=~"cd_informe_detalle.estado_registro~") COLUMN(NAME=~"cd_informe_detalle.cod_agente~") COLUMN(NAME=~"cd_informe_detalle.cod_supervisor~") COLUMN(NAME=~"cd_informe_detalle.cod_jefe_venta~") COLUMN(NAME=~"cd_informe_detalle.rut_cliente~") COLUMN(NAME=~"cd_informe_detalle.dv~") COLUMN(NAME=~"cd_informe_detalle.nombre_cliente~") COLUMN(NAME=~"cd_informe_detalle.apellido_paterno~") COLUMN(NAME=~"cd_informe_detalle.apellido_materno~") COLUMN(NAME=~"cd_informe_detalle.numero~") COLUMN(NAME=~"cd_informe_detalle.correlativo_lista~") COLUMN(NAME=~"cd_informe_detalle.precio~") COLUMN(NAME=~"cd_informe_detalle.motivo_devolucion~") COLUMN(NAME=~"cd_informe.fecha_entrega~")    JOIN (LEFT=~"cd_informe_detalle.referencia~"    OP =~"=~"RIGHT=~"cd_informe.referencia~" )    JOIN (LEFT=~"cd_informe_detalle.correlativo_lista~"    OP =~"=~"RIGHT=~"cd_informe.correlativo~" )    JOIN (LEFT=~"cd_informe_detalle.estado_cd~"    OP =~"=~"RIGHT=~"cd_informe.codigo~" )WHERE(    EXP1 =~"~~~"CD_INFORME~~~".~~~"CORRELATIVO~~~"~"   OP =~"=~"    EXP2 =~":corr~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CD_INFORME~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~":codigo~" ) ) ARG(NAME = ~"corr~" TYPE = number)  ARG(NAME = ~"codigo~" TYPE = number) " arguments=(("corr", number),("codigo", number)) )
