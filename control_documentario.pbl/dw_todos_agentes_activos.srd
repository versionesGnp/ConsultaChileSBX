table(column=(type=char(5) update=yes updatewhereclause=yes key=yes name=cod_age dbname="agentes.cod_age" dbalias=".cod_age" )
 column=(type=char(20) update=yes updatewhereclause=yes name=nombre dbname="agentes.nombre" dbalias=".nombre" )
 column=(type=char(50) update=yes updatewhereclause=yes name=a_paterno dbname="agentes.a_paterno" dbalias=".a_paterno" )
 column=(type=char(50) update=yes updatewhereclause=yes name=a_materno dbname="agentes.a_materno" dbalias=".a_materno" )
 column=(type=datetime update=yes updatewhereclause=yes name=fecha_ini dbname="agentes.fecha_ini" dbalias=".fecha_ini" )
 column=(type=datetime update=yes updatewhereclause=yes name=fecha_fin dbname="agentes.fecha_fin" dbalias=".fecha_fin" )
 column=(type=char(1) update=yes updatewhereclause=yes name=estado dbname="agentes.estado" dbalias=".estado" values="Activo	A/Inactivo	I/" )
 column=(type=char(5) update=yes updatewhereclause=yes name=cod_sup dbname="agentes.cod_sup" dbalias=".cod_sup" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=rut dbname="agentes.rut" dbalias=".rut" )
 column=(type=char(1) update=yes updatewhereclause=yes name=tipo_cont dbname="agentes.tipo_cont" dbalias=".tipo_cont" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=meta dbname="agentes.meta" dbalias=".meta" )
 column=(type=char(1) update=yes updatewhereclause=yes name=clasificacion dbname="agentes.clasificacion" dbalias=".clasificacion" )
 column=(type=decimal(4) updatewhereclause=yes name=cod_parque dbname="agentes.cod_parque" dbalias=".cod_parque" )
 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"agentes~" ) COLUMN(NAME=~"agentes.cod_age~") COLUMN(NAME=~"agentes.nombre~") COLUMN(NAME=~"agentes.a_paterno~") COLUMN(NAME=~"agentes.a_materno~") COLUMN(NAME=~"agentes.fecha_ini~") COLUMN(NAME=~"agentes.fecha_fin~") COLUMN(NAME=~"agentes.estado~") COLUMN(NAME=~"agentes.cod_sup~") COLUMN(NAME=~"agentes.rut~") COLUMN(NAME=~"agentes.tipo_cont~") COLUMN(NAME=~"agentes.meta~") COLUMN(NAME=~"agentes.clasificacion~") COLUMN(NAME=~"agentes.cod_parque~")WHERE(    EXP1 =~"~~~"AGENTES~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'A'~" ) ) " update="AGENTES" updatewhere=1 updatekeyinplace=no  sort="estado A cod_age A " )
