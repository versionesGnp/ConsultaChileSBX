table(column=(type=char(1) updatewhereclause=yes name=vista_clasifica_promesa_codigo dbname="vista_clasifica_promesa.codigo" dbalias=".codigo" )
 column=(type=char(1) updatewhereclause=yes name=vista_clasifica_promesa_serie dbname="vista_clasifica_promesa.serie" dbalias=".serie" )
 column=(type=decimal(4) updatewhereclause=yes name=vista_clasifica_promesa_numero dbname="vista_clasifica_promesa.numero" dbalias=".numero" )
 column=(type=char(1) updatewhereclause=yes name=vista_clasifica_promesa_estado dbname="vista_clasifica_promesa.estado" dbalias=".estado" )
 column=(type=char(5) updatewhereclause=yes name=vista_clasifica_promesa_cod_age dbname="vista_clasifica_promesa.cod_age" dbalias=".cod_age" )
 column=(type=char(5) updatewhereclause=yes name=vista_clasifica_promesa_cod_sup dbname="vista_clasifica_promesa.cod_sup" dbalias=".cod_sup" )
 column=(type=char(5) updatewhereclause=yes name=vista_clasifica_promesa_cod_jef dbname="vista_clasifica_promesa.cod_jef" dbalias=".cod_jef" )
 column=(type=datetime updatewhereclause=yes name=cd_folio_ult_fecha_estado dbname="cd_folio.ult_fecha_estado" dbalias=".ult_fecha_estado" )
 column=(type=char(20) updatewhereclause=yes name=estado_sigla_estado dbname="estado.sigla_estado" dbalias=".sigla_estado" )
 column=(type=char(20) updatewhereclause=yes name=agentes_nombre dbname="agentes.nombre" dbalias=".nombre" )
 column=(type=char(50) updatewhereclause=yes name=agentes_a_paterno dbname="agentes.a_paterno" dbalias=".a_paterno" )
 column=(type=char(50) updatewhereclause=yes name=agentes_a_materno dbname="agentes.a_materno" dbalias=".a_materno" )
 column=(type=char(20) updatewhereclause=yes name=supervisor_nombre dbname="supervisor.nombre" dbalias=".nombre" )
 column=(type=char(50) updatewhereclause=yes name=supervisor_a_paterno dbname="supervisor.a_paterno" dbalias=".a_paterno" )
 column=(type=char(50) updatewhereclause=yes name=supervisor_a_materno dbname="supervisor.a_materno" dbalias=".a_materno" )
 column=(type=char(20) updatewhereclause=yes name=jefe_ventas_nombre dbname="jefe_ventas.nombre" dbalias=".nombre" )
 column=(type=char(50) updatewhereclause=yes name=jefe_ventas_a_paterno dbname="jefe_ventas.a_paterno" dbalias=".a_paterno" )
 column=(type=char(50) updatewhereclause=yes name=jefe_ventas_a_materno dbname="jefe_ventas.a_materno" dbalias=".a_materno" )
 column=(type=datetime updatewhereclause=yes name=vista_clasifica_promesa_fecha dbname="vista_clasifica_promesa.fecha" dbalias=".fecha" )
 column=(type=datetime updatewhereclause=yes name=vista_clasifica_promesa_fecha_nac dbname="vista_clasifica_promesa.fecha_nac" dbalias=".fecha_nac" )
 column=(type=char(1) updatewhereclause=yes name=vista_clasifica_promesa_forma_pago dbname="vista_clasifica_promesa.forma_pago" dbalias=".forma_pago" )
 column=(type=char(0) updatewhereclause=yes name=dps_rev dbname="dps_rev" )
 column=(type=char(0) updatewhereclause=yes name=dps_cal dbname="dps_cal" )
 column=(type=number updatewhereclause=yes name=edad dbname="edad" )
 column=(type=decimal(4) updatewhereclause=yes name=vista_clasifica_promesa_rut dbname="vista_clasifica_promesa.rut" dbalias=".rut" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cd_folio~" )  TABLE(NAME=~"agentes~" )  TABLE(NAME=~"supervisor~" )  TABLE(NAME=~"jefe_ventas~" )  TABLE(NAME=~"estado~" )  TABLE(NAME=~"vista_clasifica_promesa~" ) COLUMN(NAME=~"vista_clasifica_promesa.codigo~") COLUMN(NAME=~"vista_clasifica_promesa.serie~") COLUMN(NAME=~"vista_clasifica_promesa.numero~") COLUMN(NAME=~"vista_clasifica_promesa.estado~") COLUMN(NAME=~"vista_clasifica_promesa.cod_age~") COLUMN(NAME=~"vista_clasifica_promesa.cod_sup~") COLUMN(NAME=~"vista_clasifica_promesa.cod_jef~") COLUMN(NAME=~"cd_folio.ult_fecha_estado~") COLUMN(NAME=~"estado.sigla_estado~") COLUMN(NAME=~"agentes.nombre~") COLUMN(NAME=~"agentes.a_paterno~") COLUMN(NAME=~"agentes.a_materno~") COLUMN(NAME=~"supervisor.nombre~") COLUMN(NAME=~"supervisor.a_paterno~") COLUMN(NAME=~"supervisor.a_materno~") COLUMN(NAME=~"jefe_ventas.nombre~") COLUMN(NAME=~"jefe_ventas.a_paterno~") COLUMN(NAME=~"jefe_ventas.a_materno~") COLUMN(NAME=~"vista_clasifica_promesa.fecha~") COLUMN(NAME=~"vista_clasifica_promesa.fecha_nac~") COLUMN(NAME=~"vista_clasifica_promesa.forma_pago~") COMPUTE(NAME=~"'' as dps_rev~") COMPUTE(NAME=~"'' as dps_cal~") COMPUTE(NAME=~"0 as edad~") COLUMN(NAME=~"vista_clasifica_promesa.rut~")    JOIN (LEFT=~"vista_clasifica_promesa.codigo~"    OP =~"=~"RIGHT=~"cd_folio.base~" )    JOIN (LEFT=~"vista_clasifica_promesa.serie~"    OP =~"=~"RIGHT=~"cd_folio.serie~" )    JOIN (LEFT=~"vista_clasifica_promesa.numero~"    OP =~"=~"RIGHT=~"cd_folio.numero~" )    JOIN (LEFT=~"vista_clasifica_promesa.cod_age~"    OP =~"=~"RIGHT=~"agentes.cod_age~" )    JOIN (LEFT=~"vista_clasifica_promesa.cod_sup~"    OP =~"=~"RIGHT=~"supervisor.cod_sup~" )    JOIN (LEFT=~"vista_clasifica_promesa.cod_jef~"    OP =~"=~"RIGHT=~"jefe_ventas.jefe_ventas~" )    JOIN (LEFT=~"vista_clasifica_promesa.estado~"    OP =~"=~"RIGHT=~"estado.cod_estado~" )WHERE(    EXP1 =~"~~~"VISTA_CLASIFICA_PROMESA~~~".~~~"CIERRE_VENTA~~~"~"   OP =~"=~"    EXP2 =~":fecha_cierre~" ) ) ARG(NAME = ~"fecha_cierre~" TYPE = datetime) " arguments=(("fecha_cierre", datetime)) )
