 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cd_folio_detalle~" )  TABLE(NAME=~"cd_folio~" ) COLUMN(NAME=~"cd_folio_detalle.base~") COLUMN(NAME=~"cd_folio_detalle.serie~") COLUMN(NAME=~"cd_folio_detalle.numero~") COLUMN(NAME=~"cd_folio_detalle.fecha_crea~") COLUMN(NAME=~"cd_folio_detalle.usuario_crea~") COLUMN(NAME=~"cd_folio_detalle.estado~") COLUMN(NAME=~"cd_folio_detalle.fecha_estado~") COLUMN(NAME=~"cd_folio_detalle.glosa~") COLUMN(NAME=~"cd_folio_detalle.memo~") COLUMN(NAME=~"cd_folio.depto_asignado~") COLUMN(NAME=~"cd_folio.estado_reg~") COLUMN(NAME=~"cd_folio_detalle.cod_agente~") COLUMN(NAME=~"cd_folio_detalle.cod_supervisor~") COLUMN(NAME=~"cd_folio_detalle.cod_jefe_venta~")    JOIN (LEFT=~"cd_folio_detalle.base~"    OP =~"=~"RIGHT=~"cd_folio.base~"    OUTER2 =~"cd_folio.base~" )    JOIN (LEFT=~"cd_folio_detalle.serie~"    OP =~"=~"RIGHT=~"cd_folio.serie~"    OUTER2 =~"cd_folio.serie~" )    JOIN (LEFT=~"cd_folio_detalle.numero~"    OP =~"=~"RIGHT=~"cd_folio.numero~"    OUTER2 =~"cd_folio.numero~" )WHERE(    EXP1 =~"~~~"CD_FOLIO~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CD_FOLIO~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CD_FOLIO~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number) " arguments=(("base", string),("serie", string),("numero", number))  sort="fecha_crea D " )
