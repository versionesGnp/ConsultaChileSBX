 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"cd_folio~" )  TABLE(NAME=~"cadena~" ) COLUMN(NAME=~"cd_folio.mes_cierre~") COLUMN(NAME=~"cd_folio.ano_cierre~") COLUMN(NAME=~"cd_folio.base~") COLUMN(NAME=~"cd_folio.serie~") COLUMN(NAME=~"cd_folio.numero~") COLUMN(NAME=~"cd_folio.cod_agente~") COLUMN(NAME=~"cd_folio.cod_supervisor~") COLUMN(NAME=~"cd_folio.cod_jefe_venta~") COLUMN(NAME=~"cd_folio.ult_estado~") COLUMN(NAME=~"cd_folio.ult_fecha_estado~") COLUMN(NAME=~"cd_folio.cod_parque~") COLUMN(NAME=~"cd_folio.sw_sup~") COLUMN(NAME=~"cd_folio.sw_vta~") COMPUTE(NAME=~"'' as tipo_cob~") COMPUTE(NAME=~"0 as folio~") COMPUTE(NAME=~"1 dif_age~") COMPUTE(NAME=~"1 dif_sup~") COMPUTE(NAME=~"1 dif_jef~") COMPUTE(NAME=~"1 estado_cd_folio~") COMPUTE(NAME=~"1 valida_fecha_ctto~") COMPUTE(NAME=~"1 valida_periodo_vta~") COMPUTE(NAME=~"1 valida_fecha_pago~") COMPUTE(NAME=~"1 valida_estado_ctto~") COMPUTE(NAME=~"1 valida_cierre_vta~") COMPUTE(NAME=~"'' as tiene_cheque~") COMPUTE(NAME=~"sysdate as fecha_pago~") COMPUTE(NAME=~"'' as estado_cheque~") COMPUTE(NAME=~"sysdate as fecha_estado_cheque~") COMPUTE(NAME=~"0 as monto_pagado~") COMPUTE(NAME=~"sysdate as fecha_venc_cheque~") COLUMN(NAME=~"cadena.estado~") COMPUTE(NAME=~"'' as cod_age~") COMPUTE(NAME=~"'' as cod_sup~") COMPUTE(NAME=~"'' as cod_jef~") COMPUTE(NAME=~"'' as forma_pago~") COMPUTE(NAME=~"sysdate as fecha_cierre~") COLUMN(NAME=~"cadena.rut~")    JOIN (LEFT=~"cd_folio.base~"    OP =~"=~"RIGHT=~"cadena.codigo~" )    JOIN (LEFT=~"cd_folio.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"cd_folio.numero~"    OP =~"=~"RIGHT=~"cadena.numero~" )WHERE(    EXP1 =~"~~~"CD_FOLIO~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CD_FOLIO~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CD_FOLIO~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number) " arguments=(("base", string),("serie", string),("numero", number))  sort="cod_agente A " )
