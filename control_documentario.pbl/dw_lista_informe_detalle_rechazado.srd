 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cd_informe~" )  TABLE(NAME=~"cd_informe_detalle~" )  TABLE(NAME=~"cd_folio_detalle_excepcion~" ) COLUMN(NAME=~"cd_informe.codigo~") COLUMN(NAME=~"cd_informe.correlativo~") COLUMN(NAME=~"cd_informe_detalle.base~") COLUMN(NAME=~"cd_informe_detalle.serie~") COLUMN(NAME=~"cd_informe_detalle.numero~") COLUMN(NAME=~"cd_folio_detalle_excepcion.referencia_memo~") COLUMN(NAME=~"cd_folio_detalle_excepcion.codigo_grupo_excepcion~") COLUMN(NAME=~"cd_folio_detalle_excepcion.codigo_excepcion~") COLUMN(NAME=~"cd_folio_detalle_excepcion.fecha_entrega_pendiente~") COLUMN(NAME=~"cd_folio_detalle_excepcion.estado_entrega~") COLUMN(NAME=~"cd_informe_detalle.fecha_crea~") COLUMN(NAME=~"cd_informe_detalle.cod_agente~") COLUMN(NAME=~"cd_informe_detalle.cod_supervisor~") COLUMN(NAME=~"cd_informe_detalle.cod_jefe_venta~") COLUMN(NAME=~"cd_informe_detalle.rut_cliente~") COLUMN(NAME=~"cd_informe_detalle.dv~") COLUMN(NAME=~"cd_informe_detalle.nombre_cliente~") COLUMN(NAME=~"cd_informe_detalle.correlativo~") COLUMN(NAME=~"cd_informe_detalle.referencia~") COLUMN(NAME=~"cd_informe_detalle.estado_cd~") COLUMN(NAME=~"cd_informe_detalle.usuario~") COLUMN(NAME=~"cd_informe_detalle.observacion~") COLUMN(NAME=~"cd_informe_detalle.departamento~") COLUMN(NAME=~"cd_informe_detalle.estado_registro~") COLUMN(NAME=~"cd_informe_detalle.apellido_paterno~") COLUMN(NAME=~"cd_informe_detalle.apellido_materno~") COLUMN(NAME=~"cd_informe_detalle.correlativo_lista~") COLUMN(NAME=~"cd_informe_detalle.precio~") COLUMN(NAME=~"cd_informe_detalle.motivo_devolucion~")    JOIN (LEFT=~"cd_informe_detalle.base~"    OP =~"=~"RIGHT=~"cd_folio_detalle_excepcion.base~"    OUTER1 =~"cd_informe_detalle.base~" )    JOIN (LEFT=~"cd_informe_detalle.serie~"    OP =~"=~"RIGHT=~"cd_folio_detalle_excepcion.serie~"    OUTER1 =~"cd_informe_detalle.serie~" )    JOIN (LEFT=~"cd_informe_detalle.numero~"    OP =~"=~"RIGHT=~"cd_folio_detalle_excepcion.numero~"    OUTER1 =~"cd_informe_detalle.numero~" )    JOIN (LEFT=~"cd_informe.fecha_crea~"    OP =~"=~"RIGHT=~"cd_informe_detalle.fecha_crea~" )    JOIN (LEFT=~"cd_informe.correlativo~"    OP =~"=~"RIGHT=~"cd_informe_detalle.correlativo_lista~" )WHERE(    EXP1 =~"~~~"CD_INFORME~~~".~~~"CORRELATIVO~~~"~"   OP =~"=~"    EXP2 =~":corr~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CD_INFORME~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~":codigo~" ) ) ARG(NAME = ~"corr~" TYPE = number)  ARG(NAME = ~"codigo~" TYPE = number) " update="CD_INFORME_DETALLE" updatewhere=0 updatekeyinplace=yes arguments=(("corr", number),("codigo", number)) )
