 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cd_informe~" ) COLUMN(NAME=~"cd_informe.referencia~") COLUMN(NAME=~"cd_informe.correlativo~") COLUMN(NAME=~"cd_informe.usuario~") COLUMN(NAME=~"cd_informe.fecha_crea~") COLUMN(NAME=~"cd_informe.observacion~") COLUMN(NAME=~"cd_informe.cantidad_dcto~") COLUMN(NAME=~"cd_informe.codigo~") COLUMN(NAME=~"cd_informe.usuario_entregado~") COLUMN(NAME=~"cd_informe.fecha_entrega~") COLUMN(NAME=~"cd_informe.copia~")WHERE(    EXP1 =~"~~~"CD_INFORME~~~".~~~"FECHA_ENTREGA~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CD_INFORME~~~".~~~"FECHA_ENTREGA~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CD_INFORME~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~":codigo~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = datetime)  ARG(NAME = ~"fecha_fin~" TYPE = datetime)  ARG(NAME = ~"codigo~" TYPE = number) " update="CD_INFORME" updatewhere=1 updatekeyinplace=no arguments=(("fecha_ini", datetime),("fecha_fin", datetime),("codigo", number))  sort="fecha_entrega D codigo A correlativo A referencia A " )
