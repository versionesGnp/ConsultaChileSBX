 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cd_folio_detalle_excepcion~" )  TABLE(NAME=~"cd_folio~" ) COLUMN(NAME=~"cd_folio_detalle_excepcion.base~") COLUMN(NAME=~"cd_folio_detalle_excepcion.serie~") COLUMN(NAME=~"cd_folio_detalle_excepcion.numero~") COLUMN(NAME=~"cd_folio_detalle_excepcion.fecha_crea~") COLUMN(NAME=~"cd_folio_detalle_excepcion.referencia_memo~") COLUMN(NAME=~"cd_folio_detalle_excepcion.codigo_grupo_excepcion~") COLUMN(NAME=~"cd_folio_detalle_excepcion.codigo_excepcion~") COLUMN(NAME=~"cd_folio_detalle_excepcion.fecha_entrega_pendiente~") COLUMN(NAME=~"cd_folio_detalle_excepcion.estado_entrega~") COLUMN(NAME=~"cd_folio_detalle_excepcion.fecha_recepcion_documento~") COLUMN(NAME=~"cd_folio_detalle_excepcion.estado_entrega_opera~") COLUMN(NAME=~"cd_folio_detalle_excepcion.fecha_recepcion_doc_opera~") COLUMN(NAME=~"cd_folio_detalle_excepcion.observacion~") COLUMN(NAME=~"cd_folio_detalle_excepcion.estado~") COLUMN(NAME=~"cd_folio_detalle_excepcion.usuario_eliminar~")    JOIN (LEFT=~"cd_folio_detalle_excepcion.base~"    OP =~"=~"RIGHT=~"cd_folio.base~" )    JOIN (LEFT=~"cd_folio_detalle_excepcion.serie~"    OP =~"=~"RIGHT=~"cd_folio.serie~" )    JOIN (LEFT=~"cd_folio_detalle_excepcion.numero~"    OP =~"=~"RIGHT=~"cd_folio.numero~" )WHERE(    EXP1 =~"((~~~"CD_FOLIO_DETALLE_EXCEPCION~~~".~~~"CODIGO_GRUPO_EXCEPCION~~~"~"   OP =~"=~"    EXP2 =~"4~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CD_FOLIO_DETALLE_EXCEPCION~~~".~~~"ESTADO_ENTREGA~~~"~"   OP =~"=~"    EXP2 =~"'P')~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"(~~~"CD_FOLIO_DETALLE_EXCEPCION~~~".~~~"CODIGO_GRUPO_EXCEPCION~~~"~"   OP =~"=~"    EXP2 =~"4~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CD_FOLIO_DETALLE_EXCEPCION~~~".~~~"ESTADO_ENTREGA_OPERA~~~"~"   OP =~"=~"    EXP2 =~"'P'))~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CD_FOLIO_DETALLE_EXCEPCION~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'V'~" ) ) ARG(NAME = ~"depto~" TYPE = string) " arguments=(("depto", string))  sort="numero A " )
