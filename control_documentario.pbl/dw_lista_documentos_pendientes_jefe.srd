 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cd_folio_detalle_excepcion~" )  TABLE(NAME=~"cd_folio~" ) COLUMN(NAME=~"cd_folio_detalle_excepcion.base~") COLUMN(NAME=~"cd_folio_detalle_excepcion.serie~") COLUMN(NAME=~"cd_folio_detalle_excepcion.numero~") COLUMN(NAME=~"cd_folio_detalle_excepcion.fecha_crea~") COLUMN(NAME=~"cd_folio_detalle_excepcion.referencia_memo~") COLUMN(NAME=~"cd_folio_detalle_excepcion.codigo_grupo_excepcion~") COLUMN(NAME=~"cd_folio_detalle_excepcion.codigo_excepcion~") COLUMN(NAME=~"cd_folio_detalle_excepcion.fecha_entrega_pendiente~") COLUMN(NAME=~"cd_folio_detalle_excepcion.estado_entrega~") COLUMN(NAME=~"cd_folio_detalle_excepcion.fecha_recepcion_documento~") COLUMN(NAME=~"cd_folio_detalle_excepcion.estado_entrega_opera~") COLUMN(NAME=~"cd_folio_detalle_excepcion.fecha_recepcion_doc_opera~") COLUMN(NAME=~"cd_folio.cod_agente~") COLUMN(NAME=~"cd_folio.cod_supervisor~") COLUMN(NAME=~"cd_folio_detalle_excepcion.observacion~")    JOIN (LEFT=~"cd_folio_detalle_excepcion.base~"    OP =~"=~"RIGHT=~"cd_folio.base~" )    JOIN (LEFT=~"cd_folio_detalle_excepcion.serie~"    OP =~"=~"RIGHT=~"cd_folio.serie~" )    JOIN (LEFT=~"cd_folio_detalle_excepcion.numero~"    OP =~"=~"RIGHT=~"cd_folio.numero~" )WHERE(    EXP1 =~"~~~"CD_FOLIO~~~".~~~"COD_JEFE_VENTA~~~"~"   OP =~"=~"    EXP2 =~":jefe~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CD_FOLIO_DETALLE_EXCEPCION~~~".~~~"CODIGO_GRUPO_EXCEPCION~~~"~"   OP =~"=~"    EXP2 =~"4~" ) ) ARG(NAME = ~"depto~" TYPE = string)  ARG(NAME = ~"jefe~" TYPE = string) " update="CD_FOLIO_DETALLE_EXCEPCION" updatewhere=0 updatekeyinplace=yes arguments=(("depto", string),("jefe", string))  sort="base A serie A numero A codigo_grupo_excepcion A codigo_excepcion A " )
