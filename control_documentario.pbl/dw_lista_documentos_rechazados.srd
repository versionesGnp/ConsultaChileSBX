 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cd_folio_detalle_rechazo~" ) COLUMN(NAME=~"cd_folio_detalle_rechazo.base~") COLUMN(NAME=~"cd_folio_detalle_rechazo.serie~") COLUMN(NAME=~"cd_folio_detalle_rechazo.numero~") COLUMN(NAME=~"cd_folio_detalle_rechazo.fecha_crea~") COLUMN(NAME=~"cd_folio_detalle_rechazo.referencia_memo~") COLUMN(NAME=~"cd_folio_detalle_rechazo.codigo_grupo_rechazo~") COLUMN(NAME=~"cd_folio_detalle_rechazo.codigo_rechazo~") COLUMN(NAME=~"cd_folio_detalle_rechazo.observacion~") COLUMN(NAME=~"cd_folio_detalle_rechazo.estado~")WHERE(    EXP1 =~"~~~"CD_FOLIO_DETALLE_RECHAZO~~~".~~~"FECHA_CREA~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CD_FOLIO_DETALLE_RECHAZO~~~".~~~"FECHA_CREA~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CD_FOLIO_DETALLE_RECHAZO~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'P'~" ) ) ARG(NAME = ~"depto~" TYPE = string)  ARG(NAME = ~"fecha_ini~" TYPE = date)  ARG(NAME = ~"fecha_fin~" TYPE = date) " update="CD_FOLIO_DETALLE_RECHAZO" updatewhere=0 updatekeyinplace=yes arguments=(("depto", string),("fecha_ini", date),("fecha_fin", date)) )
