 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"encargados~" )  TABLE(NAME=~"codigo_depto~" ) COLUMN(NAME=~"encargados.codigo_usuario~") COLUMN(NAME=~"encargados.password~") COLUMN(NAME=~"encargados.nombre~") COLUMN(NAME=~"encargados.acceso~") COLUMN(NAME=~"encargados.depto~") COLUMN(NAME=~"encargados.company~") COLUMN(NAME=~"encargados.fecha_termino~") COLUMN(NAME=~"encargados.opera~") COLUMN(NAME=~"encargados.cons_general~") COLUMN(NAME=~"encargados.solicitudes~") COLUMN(NAME=~"encargados.digitacion~") COLUMN(NAME=~"encargados.fecha_ingreso~") COLUMN(NAME=~"encargados.fecha_expiracion~") COLUMN(NAME=~"encargados.estado~") COLUMN(NAME=~"encargados.personal_interno~") COLUMN(NAME=~"encargados.link~") COLUMN(NAME=~"encargados.email~") COLUMN(NAME=~"codigo_depto.descripcion~")    JOIN (LEFT=~"encargados.depto~"    OP =~"=~"RIGHT=~"codigo_depto.codigo~" )WHERE(    EXP1 =~"~~~"ENCARGADOS~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'A'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"length(~~~"ENCARGADOS~~~".~~~"EMAIL~~~")~"   OP =~">~"    EXP2 =~"0~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"ENCARGADOS~~~".~~~"DEPTO~~~"~"   OP =~"like~"    EXP2 =~":depto~" ) ) ARG(NAME = ~"depto~" TYPE = string) " arguments=(("depto", string))  sort="nombre A " )
