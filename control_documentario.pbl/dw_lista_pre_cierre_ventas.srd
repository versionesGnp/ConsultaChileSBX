 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"cd_folio~" )  TABLE(NAME=~"cod_parq~" )  TABLE(NAME=~"revision_contratos~" )  TABLE(NAME=~"supervisor~" ) COLUMN(NAME=~"cd_folio.mes_cierre~") COLUMN(NAME=~"cd_folio.ano_cierre~") COLUMN(NAME=~"cd_folio.base~") COLUMN(NAME=~"cd_folio.serie~") COLUMN(NAME=~"cd_folio.numero~") COMPUTE(NAME=~"'' as fecha_cierre~") COMPUTE(NAME=~"'' as estado_contrato~") COLUMN(NAME=~"cd_folio.ult_estado~") COLUMN(NAME=~"cd_folio.cod_agente~") COMPUTE(NAME=~"'' as cod_age~") COLUMN(NAME=~"cd_folio.cod_supervisor~") COMPUTE(NAME=~"'' as cod_sup~") COLUMN(NAME=~"cd_folio.cod_jefe_venta~") COMPUTE(NAME=~"'' as cod_jef~") COLUMN(NAME=~"cd_folio.ult_fecha_estado~") COLUMN(NAME=~"cd_folio.ult_glosa_estado~") COLUMN(NAME=~"cd_folio.ult_memo~") COLUMN(NAME=~"cd_folio.cod_parque~") COLUMN(NAME=~"cd_folio.ult_tipo_rechazo~") COLUMN(NAME=~"cd_folio.ult_tipo_excepcion~") COLUMN(NAME=~"cd_folio.ult_estado_excepcion~") COLUMN(NAME=~"cd_folio.ult_estado_asociado_excepcion~") COLUMN(NAME=~"cod_parq.nombre~") COLUMN(NAME=~"revision_contratos.rut~") COLUMN(NAME=~"revision_contratos.dv~") COLUMN(NAME=~"revision_contratos.moneda~") COLUMN(NAME=~"revision_contratos.uf_fecha_ctto~") COLUMN(NAME=~"revision_contratos.precio_contrato~") COLUMN(NAME=~"supervisor.nombre~") COLUMN(NAME=~"supervisor.a_paterno~") COLUMN(NAME=~"supervisor.a_materno~") COLUMN(NAME=~"revision_contratos.uso~") COMPUTE(NAME=~"'' as tipo_cob~") COMPUTE(NAME=~"0 as folio~") COMPUTE(NAME=~"'' as forma_pago~") COLUMN(NAME=~"cd_folio.sw_sup~") COLUMN(NAME=~"cd_folio.sw_vta~") COMPUTE(NAME=~"'' as dif_age~") COMPUTE(NAME=~"'' as dif_sup~") COMPUTE(NAME=~"'' as dif_jef~") COMPUTE(NAME=~"'' as tiene_cheque~") COMPUTE(NAME=~"sysdate as fecha_pago~") COMPUTE(NAME=~"'' as estado_cheque~") COMPUTE(NAME=~"sysdate as fecha_estado_cheque~") COMPUTE(NAME=~"0 as monto_pagado~") COMPUTE(NAME=~"sysdate as fecha_venc_cheque~")    JOIN (LEFT=~"cd_folio.base~"    OP =~"=~"RIGHT=~"revision_contratos.base~"    OUTER1 =~"cd_folio.base~" )    JOIN (LEFT=~"cd_folio.serie~"    OP =~"=~"RIGHT=~"revision_contratos.serie~"    OUTER1 =~"cd_folio.serie~" )    JOIN (LEFT=~"cd_folio.numero~"    OP =~"=~"RIGHT=~"revision_contratos.numero~"    OUTER1 =~"cd_folio.numero~" )    JOIN (LEFT=~"cd_folio.cod_parque~"    OP =~"=~"RIGHT=~"cod_parq.codigo~" )    JOIN (LEFT=~"cd_folio.cod_supervisor~"    OP =~"=~"RIGHT=~"supervisor.cod_sup~" )WHERE(    EXP1 =~"~~~"CD_FOLIO~~~".~~~"MES_CIERRE~~~"~"   OP =~"=~"    EXP2 =~":mes_cierre~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CD_FOLIO~~~".~~~"ANO_CIERRE~~~"~"   OP =~"=~"    EXP2 =~":ano_cierre~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CD_FOLIO~~~".~~~"COD_SUPERVISOR~~~"~"   OP =~"=~"    EXP2 =~":supervisor~" ) ) ARG(NAME = ~"mes_cierre~" TYPE = number)  ARG(NAME = ~"ano_cierre~" TYPE = number)  ARG(NAME = ~"supervisor~" TYPE = string) " arguments=(("mes_cierre", number),("ano_cierre", number),("supervisor", string))  sort="fecha_cierre A " )
