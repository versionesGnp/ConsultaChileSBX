 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cd_folio~" ) COLUMN(NAME=~"cd_folio.base~") COLUMN(NAME=~"cd_folio.serie~") COLUMN(NAME=~"cd_folio.numero~") COLUMN(NAME=~"cd_folio.cod_agente~") COLUMN(NAME=~"cd_folio.cod_supervisor~") COLUMN(NAME=~"cd_folio.cod_jefe_venta~") COLUMN(NAME=~"cd_folio.ult_fecha_estado~") COLUMN(NAME=~"cd_folio.ult_glosa_estado~") COLUMN(NAME=~"cd_folio.ult_memo~") COLUMN(NAME=~"cd_folio.ult_usuario_gestion~") COLUMN(NAME=~"cd_folio.ult_referencia_memo~") COLUMN(NAME=~"cd_folio.ult_estado~") COLUMN(NAME=~"cd_folio.depto_asignado~") COLUMN(NAME=~"cd_folio.estado_reg~") COLUMN(NAME=~"cd_folio.fecha_crea~") COLUMN(NAME=~"cd_folio.usuario_crea~") COLUMN(NAME=~"cd_folio.cod_parque~")WHERE(    EXP1 =~"~~~"CD_FOLIO~~~".~~~"ULT_FECHA_ESTADO~~~"~"   OP =~">=~"    EXP2 =~":fec_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CD_FOLIO~~~".~~~"ULT_FECHA_ESTADO~~~"~"   OP =~"<=~"    EXP2 =~":fec_fin~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CD_FOLIO~~~".~~~"ULT_ESTADO~~~"~"   OP =~"=~"    EXP2 =~":estado~" ) ) ARG(NAME = ~"fec_ini~" TYPE = datetime)  ARG(NAME = ~"fec_fin~" TYPE = datetime)  ARG(NAME = ~"estado~" TYPE = number) " update="CD_FOLIO" updatewhere=0 updatekeyinplace=yes arguments=(("fec_ini", datetime),("fec_fin", datetime),("estado", number))  sort="base A serie A numero A " )
