 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cd_modificacion_ctto~" )  TABLE(NAME=~"cd_modif_ctto_detalle~" ) COLUMN(NAME=~"cd_modificacion_ctto.base~") COLUMN(NAME=~"cd_modificacion_ctto.serie~") COLUMN(NAME=~"cd_modificacion_ctto.numero~") COLUMN(NAME=~"cd_modificacion_ctto.codigo_modif~") COLUMN(NAME=~"cd_modificacion_ctto.codigo_detalle~") COLUMN(NAME=~"cd_modificacion_ctto.estado~") COLUMN(NAME=~"cd_modificacion_ctto.fecha_crea~") COLUMN(NAME=~"cd_modificacion_ctto.usuario~") COLUMN(NAME=~"cd_modificacion_ctto.codigo_docto~") COLUMN(NAME=~"cd_modif_ctto_detalle.descripcion~")    JOIN (LEFT=~"cd_modificacion_ctto.codigo_modif~"    OP =~"=~"RIGHT=~"cd_modif_ctto_detalle.codigo_modif~" )    JOIN (LEFT=~"cd_modificacion_ctto.codigo_detalle~"    OP =~"=~"RIGHT=~"cd_modif_ctto_detalle.codigo_detalle~" )WHERE(    EXP1 =~"~~~"CD_MODIFICACION_CTTO~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CD_MODIFICACION_CTTO~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CD_MODIFICACION_CTTO~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CD_MODIFICACION_CTTO~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'V'~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number) " update="CD_MODIFICACION_CTTO" updatewhere=0 updatekeyinplace=yes arguments=(("base", string),("serie", string),("numero", number))  sort="codigo_modif A codigo_detalle A " )
