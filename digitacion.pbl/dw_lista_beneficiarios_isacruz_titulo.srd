table(column=(type=decimal(4) updatewhereclause=yes name=rut dbname="coprop_isacruz.rut" )
 column=(type=char(1) updatewhereclause=yes name=dv dbname="coprop_isacruz.dv" )
 column=(type=char(30) updatewhereclause=yes name=nombres dbname="coprop_isacruz.nombres" )
 column=(type=char(15) updatewhereclause=yes name=apaterno dbname="coprop_isacruz.apaterno" )
 column=(type=char(15) updatewhereclause=yes name=amaterno dbname="coprop_isacruz.amaterno" )
 column=(type=char(1) updatewhereclause=yes name=estado_heredero dbname="coprop_isacruz.estado_heredero" )
 column=(type=decimal(4) updatewhereclause=yes name=cadena_cod_parque dbname="cadena.cod_parque" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"coprop_isacruz~" )  TABLE(NAME=~"cadena~" ) COLUMN(NAME=~"coprop_isacruz.rut~") COLUMN(NAME=~"coprop_isacruz.dv~") COLUMN(NAME=~"coprop_isacruz.nombres~") COLUMN(NAME=~"coprop_isacruz.apaterno~") COLUMN(NAME=~"coprop_isacruz.amaterno~") COLUMN(NAME=~"coprop_isacruz.estado_heredero~") COLUMN(NAME=~"cadena.cod_parque~")    JOIN (LEFT=~"coprop_isacruz.base~"    OP =~"=~"RIGHT=~"cadena.codigo~"    OUTER1 =~"coprop_isacruz.base~" )    JOIN (LEFT=~"coprop_isacruz.serie~"    OP =~"=~"RIGHT=~"cadena.serie~"    OUTER1 =~"coprop_isacruz.serie~" )    JOIN (LEFT=~"coprop_isacruz.numero~"    OP =~"=~"RIGHT=~"cadena.numero~"    OUTER1 =~"coprop_isacruz.numero~" )WHERE(    EXP1 =~"~~~"COPROP_ISACRUZ~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"COPROP_ISACRUZ~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"COPROP_ISACRUZ~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~" ) )    UNION (PBSELECT( VERSION(400) TABLE(NAME=~"cadena~" )  TABLE(NAME=~"co_prop~" ) COLUMN(NAME=~"co_prop.rut~") COLUMN(NAME=~"co_prop.dv~") COLUMN(NAME=~"co_prop.nombre~") COLUMN(NAME=~"co_prop.a_paterno~") COLUMN(NAME=~"co_prop.a_materno~") COMPUTE(NAME=~"'N' as estado_heredero~") COLUMN(NAME=~"cadena.cod_parque~")    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"co_prop.base~"    OUTER2 =~"co_prop.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"co_prop.serie~"    OUTER2 =~"co_prop.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"co_prop.nro_oferta~"    OUTER2 =~"co_prop.nro_oferta~" )WHERE(    EXP1 =~"~~~"CO_PROP~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CO_PROP~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CO_PROP~~~".~~~"NRO_OFERTA~~~"~"   OP =~"=~"    EXP2 =~":numero~" ) )) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number) " arguments=(("base", string),("serie", string),("numero", number)) )
