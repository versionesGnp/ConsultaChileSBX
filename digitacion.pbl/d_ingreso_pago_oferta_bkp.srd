 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"pago_oferta~" )  TABLE(NAME=~"oferta_v~" ) COLUMN(NAME=~"pago_oferta.serie~") COLUMN(NAME=~"pago_oferta.nro_oferta~") COLUMN(NAME=~"pago_oferta.fecha~") COLUMN(NAME=~"pago_oferta.folio~") COLUMN(NAME=~"pago_oferta.precio~") COLUMN(NAME=~"pago_oferta.pie~") COLUMN(NAME=~"pago_oferta.tasa~") COLUMN(NAME=~"pago_oferta.capacidad~") COLUMN(NAME=~"pago_oferta.n_reduccion~") COLUMN(NAME=~"pago_oferta.valor_cuota~") COLUMN(NAME=~"pago_oferta.des_esp~") COLUMN(NAME=~"pago_oferta.nro_cuotas~") COLUMN(NAME=~"pago_oferta.uf_dia~") COLUMN(NAME=~"pago_oferta.moneda~") COLUMN(NAME=~"pago_oferta.fecha_prim~") COLUMN(NAME=~"pago_oferta.fecha_ult~") COLUMN(NAME=~"pago_oferta.fecha_entre~") COLUMN(NAME=~"pago_oferta.fecha_pie~") COLUMN(NAME=~"pago_oferta.modificado~") COLUMN(NAME=~"pago_oferta.fecha_mod~") COLUMN(NAME=~"pago_oferta.area~") COLUMN(NAME=~"pago_oferta.parque~") COLUMN(NAME=~"pago_oferta.sector~") COLUMN(NAME=~"pago_oferta.sepultura~") COLUMN(NAME=~"pago_oferta.derecho_lib~") COLUMN(NAME=~"pago_oferta.gastos_adm~") COLUMN(NAME=~"pago_oferta.factura~") COLUMN(NAME=~"pago_oferta.fecha_fact~") COLUMN(NAME=~"pago_oferta.total_fact~") COLUMN(NAME=~"pago_oferta.carta_bienv~") COLUMN(NAME=~"pago_oferta.pie_pagado~")    JOIN (LEFT=~"pago_oferta.serie~"    OP =~"=~"RIGHT=~"oferta_v.serie~" )    JOIN (LEFT=~"oferta_v.nro_oferta~"    OP =~"=~"RIGHT=~"pago_oferta.nro_oferta~" )    JOIN (LEFT=~"oferta_v.ult_folio~"    OP =~"=~"RIGHT=~"pago_oferta.folio~" )WHERE(    EXP1 =~"( ( ~~~"PAGO_OFERTA~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":as_serie )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"PAGO_OFERTA~~~".~~~"NRO_OFERTA~~~"~"   OP =~"=~"    EXP2 =~":an_numero ) )~" ) ) ARG(NAME = ~"as_serie~" TYPE = string)  ARG(NAME = ~"an_numero~" TYPE = number) " arguments=(("as_serie", string),("an_numero", number)) )
