compute(band=detail alignment="3" expression="'El Cliente se obliga en forma adicional a pagar todos los servicios que requiera del Cementerio, asi como los gastos propiamente tales de sepultación, y los demás servicios que establece el Reglamento Interno y Arancel del Cementerio, los que el Cliente declara conocer y aceptar en sus actuales términos como así mismo las modificaciones que puedan hacerse a ellos, y los cuales se entienden formar parte del presente contrato.'"border="0" color="0" x="114" y="4500" height="232" width="3383" format="[GENERAL]" html.valueishtml="0"  name=compute_11 visible="1"  font.face="Arial" font.height="-9" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" background.transparency="0" background.gradient.color="8421504" background.gradient.transparency="0" background.gradient.angle="0" background.brushmode="0" background.gradient.repetition.mode="0" background.gradient.repetition.count="0" background.gradient.repetition.length="100" background.gradient.focus="0" background.gradient.scale="100" background.gradient.spread="100" tooltip.backcolor="134217752" tooltip.delay.initial="0" tooltip.delay.visible="32000" tooltip.enabled="0" tooltip.hasclosebutton="0" tooltip.icon="0" tooltip.isbubble="0" tooltip.maxwidth="0" tooltip.textcolor="134217751" tooltip.transparency="0" transparency="0" )
compute(band=detail alignment="3" expression="'El Cliente podrá hacer uso de los derechos de sepultación en la sepultura indicada, una vez transcurrido seis meses contados desde que se haya efectuado el primer pago de acuerdo a lo estipulado en el Nº 4 precedente, y siempre y cuando el Cliente se encuentre al día en el pago de todas y cada una de las obligaciones estipuladas en éste contrato.  En el evento de que el Cliente entes de esta fecha requiera hacer uso de la sepultura, deberá cancelar el derecho especial de uso anticipado señalado en la clausula primera.  Si por la necesidad de uso anticipado, la sepultura asignada no pudiere ser utilizada, La Florida podrá entregar al Cliente una sepultura del mismo tipo, ubicada en el mismo sector, a elección del Cliente, de entre aquellas que se encuentren disponibles.'"border="0" color="0" x="114" y="4736" height="356" width="3383" format="[GENERAL]" html.valueishtml="0"  name=compute_12 visible="1"  font.face="Arial" font.height="-9" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" background.transparency="0" background.gradient.color="8421504" background.gradient.transparency="0" background.gradient.angle="0" background.brushmode="0" background.gradient.repetition.mode="0" background.gradient.repetition.count="0" background.gradient.repetition.length="100" background.gradient.focus="0" background.gradient.scale="100" background.gradient.spread="100" tooltip.backcolor="134217752" tooltip.delay.initial="0" tooltip.delay.visible="32000" tooltip.enabled="0" tooltip.hasclosebutton="0" tooltip.icon="0" tooltip.isbubble="0" tooltip.maxwidth="0" tooltip.textcolor="134217751" tooltip.transparency="0" transparency="0" )
