compute(band=detail alignment="3" expression="'Declarar resuelto ipso facto el presente contrato u otros que deriven del mismo.  Para este efecto La Florida notificará al Cliente mediante una carta certificada a su domicilio, o bién, publicará en aviso en un diario de circulación nacional.  En tal evento las partes estipulan como avaluación anticipada de los perjuicios causados por el incumplimiento del Cliente, el equivalente a todas las sumas qye haya pagado a la Florida a cualquier título por concepto del presente contrato de promesa, o por concepto de otros servicios indicados por el Reglamento Interno y Arancel del Cementerio, y facultando el Cliente desde ya a La Florida para que una vez transcurridos treita días del envío de la carta, o publicación del aviso, tome posesión de la sepultura individualizada precedentemente, pudiendo exhumar los restos que se hallen sepultados en ellas, sin prejuicios de otros derechos y de la reglamentación civíl indemnizatoria.'"border="0" color="0" x="114" y="2992" height="476" width="3383" format="[GENERAL]" html.valueishtml="0"  name=compute_5 visible="1"  font.face="Arial" font.height="-9" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" background.transparency="0" background.gradient.color="8421504" background.gradient.transparency="0" background.gradient.angle="0" background.brushmode="0" background.gradient.repetition.mode="0" background.gradient.repetition.count="0" background.gradient.repetition.length="100" background.gradient.focus="0" background.gradient.scale="100" background.gradient.spread="100" tooltip.backcolor="134217752" tooltip.delay.initial="0" tooltip.delay.visible="32000" tooltip.enabled="0" tooltip.hasclosebutton="0" tooltip.icon="0" tooltip.isbubble="0" tooltip.maxwidth="0" tooltip.textcolor="134217751" tooltip.transparency="0" transparency="0" )
