 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"derecho~" ) COLUMN(NAME=~"derecho.serie_p~") COLUMN(NAME=~"derecho.nro_pagare~") COLUMN(NAME=~"derecho.fecha~") COLUMN(NAME=~"derecho.serie~") COLUMN(NAME=~"derecho.nro_oferta~") COLUMN(NAME=~"derecho.rut_aval~") COLUMN(NAME=~"derecho.kapital~") COLUMN(NAME=~"derecho.tasa~") COLUMN(NAME=~"derecho.valor_cuo~") COLUMN(NAME=~"derecho.fecha_prim~") COLUMN(NAME=~"derecho.fecha_ult~") COLUMN(NAME=~"derecho.plazo~") COLUMN(NAME=~"derecho.tot_pagado~") COLUMN(NAME=~"derecho.pie_pagado~") COLUMN(NAME=~"derecho.cta_pag_la~") COLUMN(NAME=~"derecho.cta_pag_isa~") COLUMN(NAME=~"derecho.abono_pag~") COLUMN(NAME=~"derecho.usuario~") COLUMN(NAME=~"derecho.fechas_ingreso~") COLUMN(NAME=~"derecho.estado~") COLUMN(NAME=~"derecho.nro_resc~") COLUMN(NAME=~"derecho.rut~") COLUMN(NAME=~"derecho.parque~") COLUMN(NAME=~"derecho.dueno~") COLUMN(NAME=~"derecho.origen~") COLUMN(NAME=~"derecho.moneda~") COLUMN(NAME=~"derecho.sector~") COLUMN(NAME=~"derecho.sepultura~") COLUMN(NAME=~"derecho.pie~") COLUMN(NAME=~"derecho.base~") COLUMN(NAME=~"derecho.estado_reg~") COLUMN(NAME=~"derecho.correlativo~") COLUMN(NAME=~"derecho.print_contrato~") COLUMN(NAME=~"derecho.fecha_pie~") COLUMN(NAME=~"derecho.forma_pago~")WHERE(    EXP1 =~"~~~"DERECHO~~~".~~~"SERIE_P~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"DERECHO~~~".~~~"NRO_PAGARE~~~"~"   OP =~"=~"    EXP2 =~":numero~" ) ) ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number) " update="DERECHO" updatewhere=0 updatekeyinplace=yes arguments=(("serie", string),("numero", number)) )
