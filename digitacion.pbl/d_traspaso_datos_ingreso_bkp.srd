 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ingreso~" ) COLUMN(NAME=~"ingreso.tipo_cob~") COLUMN(NAME=~"ingreso.folio~") COLUMN(NAME=~"ingreso.fecha_pago~") COLUMN(NAME=~"ingreso.tipo_mov~") COLUMN(NAME=~"ingreso.monto~") COLUMN(NAME=~"ingreso.cuotas_pag~") COLUMN(NAME=~"ingreso.valor_uf~") COLUMN(NAME=~"ingreso.rezago~") COLUMN(NAME=~"ingreso.serie~") COLUMN(NAME=~"ingreso.contrato~") COLUMN(NAME=~"ingreso.base~") COLUMN(NAME=~"ingreso.rut~")WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"TIPO_COB~~~"~"   OP =~"=~"    EXP2 =~":as_tipo_cobro~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"FOLIO~~~"~"   OP =~"=~"    EXP2 =~":an_folio~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"REZAGO~~~"~"   OP =~"=~"    EXP2 =~"'S'~" ) ) ARG(NAME = ~"as_tipo_cobro~" TYPE = string)  ARG(NAME = ~"an_folio~" TYPE = number) " update="INGRESO" updatewhere=2 updatekeyinplace=yes arguments=(("as_tipo_cobro", string),("an_folio", number)) )
