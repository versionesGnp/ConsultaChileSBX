 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"co_prop~" ) COLUMN(NAME=~"co_prop.contador~") COLUMN(NAME=~"co_prop.serie~") COLUMN(NAME=~"co_prop.nro_oferta~") COLUMN(NAME=~"co_prop.rut~") COLUMN(NAME=~"co_prop.nombre~") COLUMN(NAME=~"co_prop.a_paterno~") COLUMN(NAME=~"co_prop.a_materno~") COLUMN(NAME=~"co_prop.dv~")WHERE(    EXP1 =~"~~~"CO_PROP~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":as_serie~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CO_PROP~~~".~~~"NRO_OFERTA~~~"~"   OP =~"=~"    EXP2 =~":an_numero~" ) ) ARG(NAME = ~"as_serie~" TYPE = string)  ARG(NAME = ~"an_numero~" TYPE = number) " update="CO_PROP" updatewhere=0 updatekeyinplace=yes arguments=(("as_serie", string),("an_numero", number))  sort="contador A " )
