type dw_agente from datawindow within w_ingresar_oferta
event ue_mousemove pbm_mousemove
integer x = 343
integer y = 216
integer width = 425
integer height = 92
integer taborder = 40
string title = "none"
string dataobject = "dwe_agentes"
boolean border = false
boolean livescroll = true
end type

event ue_mousemove;st_limpiar.visible						= false
st_grabar.visible						= false
st_salir.visible							= false
st_help_pagare.visible				= false
st_seguro_complementario.visible	= false
st_ver_pie_pactado.visible			= false
st_ver_funeraria.visible				= false
st_ver_institucion.visible				= false
st_ver_aval.visible						= false
st_imprimir.visible						= false
st_help_memo.visible					= false
st_buscar.visible						= false
st_help_cta_cte.visible				= false
st_help_seguro_2.visible				= false
st_help_porce_comi.visible			= false
st_help_beneficios.visible			= false
st_help_copropietario.visible		= false
st_funeraria.visible					= false
st_promociones.visible				= false
st_seg_fune.visible					= false
end event

event itemchanged;Long		ll_resp,ll_grabar_1=0,ll_grabar_2=1
String		ls_tipo_cont,ls_obs,ls_ok,ls_string,ls_age_aux,ls_sup_aux,ls_jefe_aux,ls_sup,ls_jefe,ls_cod_age,ls_fecha,ls_canal


dw_agente.accepttext()
ls_cod_age				= dw_agente.getitemstring(1,'agente')
if not isnull(ls_cod_age) then
	if gi_rut>0 then
		is_sw_age		= 'S'
		gs_serie 		= trim(em_serie.Text)
//		gs_base			= 'O'
		if gi_rut>0 then
			if is_pasa_asigna='S' then
				gs_age	= dw_agente.getitemstring(1,'agente')
				gs_sup	= dw_supervisor.getitemstring(1,'supervisores')
				gs_jefe	= dw_jefe.getitemstring(1,'jefes')
				if not isnull(gs_age) or gs_age<>'' then
					if gl_cod_parque=0 or isnull(gl_cod_parque) then
						SELECT	"AGENTES"."COD_SUP",
									"AGENTES"."COD_PARQUE",
									"AGENTES"."CANAL"
						INTO 		:ls_sup,
									:gl_cod_parque,
									:ls_canal
						FROM 	"AGENTES",   
									"SUPERVISOR"  
						WHERE  ( "AGENTES"."COD_SUP" = "SUPERVISOR"."COD_SUP" ) and  
								 (("AGENTES"."COD_AGE" = :gs_age ) )   
						USING		sqlca;
					else
						SELECT	"AGENTES"."COD_SUP",
									"AGENTES"."CANAL"
						INTO 		:ls_sup,
									:ls_canal
						FROM 		"AGENTES",   
									"SUPERVISOR"  
						WHERE  ( "AGENTES"."COD_SUP" = "SUPERVISOR"."COD_SUP" ) and  
								 (("AGENTES"."COD_AGE" = :gs_age ) )   
						USING		sqlca;
					end if
					if sqlca.sqlcode=0 then
						if isnull(gs_age) or gs_age='' then
							messagebox("Advertencia","Debe Ingresar Agente")
							dw_agente.setfocus()
						else
							dw_oferta_v.SetItem(1, "cod_age", gs_age)
							dw_oferta_v.SetItem(1, "oferta_v_canal_venta", ls_canal)
							dw_oferta_v.SetItem(1, "cadena_cod_parque", gl_cod_parque)
							dw_oferta_v.accepttext()
							if gl_cod_parque > 0 then
								dw_oferta_v.getchild('oferta_v_beneficio_complementario',idw_detalle2)
								idw_detalle2.settransobject(sqlca)
								idw_detalle2.retrieve(gl_cod_parque)
								idw_detalle3.retrieve(gl_cod_parque)
								idw_detalle4.retrieve(gl_cod_parque,gs_base)
							end if
							if gs_nueva_oferta='S' and is_sw_age='S' and gs_sup<>'' and not isnull(gs_sup) and gs_jefe<>'' and not isnull(gs_jefe) then
								il_resp_age	= MessageBox("Advertencia", "Está seguro de ASIGNAR Promesa Nº "+gs_serie+'-'+string(gi_numero,"###,###,###,###"),Exclamation!, YesNo!, 2)
								IF il_resp_age = 1 THEN
									ls_string	= gs_serie+'~t'+string(gi_numero)+'~t'+gs_age+'~t'+string(gdt_fec_sistema)+'~t'+string(gdt_fec_sistema)+'~t'+'V'+'~t'+ls_obs+'~t'+gs_sup+'~t'+gs_jefe
									openwithparm(w_verificar_datos_contrato,ls_string)
									IF trim(Message.StringParm)='OK' THEN
										if gl_cod_parque=0 or isnull(gl_cod_parque) then
											SELECT	"AGENTES"."TIPO_CONT",
														"AGENTES"."COD_PARQUE"
											INTO 		:ls_tipo_cont,
														:gl_cod_parque
											FROM 		"AGENTES"  
											WHERE 	"AGENTES"."COD_AGE" = :gs_age and "AGENTES"."COD_SUP" <> '036'  ;
										else
											SELECT	"AGENTES"."TIPO_CONT"
											INTO 		:ls_tipo_cont
											FROM 		"AGENTES"  
											WHERE 	"AGENTES"."COD_AGE" = :gs_age and "AGENTES"."COD_SUP" <> '036'  ;
										end if
										dw_oferta_v.SetItem(1, "cadena_cod_parque", gl_cod_parque)
										if gl_cod_parque > 0 then
											dw_oferta_v.getchild('oferta_v_beneficio_complementario',idw_detalle2)
											idw_detalle2.settransobject(sqlca)
											idw_detalle2.retrieve(gl_cod_parque)
											idw_detalle3.retrieve(gl_cod_parque)
											idw_detalle4.retrieve(gl_cod_parque,gs_base)
										end if
										
										ls_obs	= 'Promesa creada por '+gs_user+' el '+string(gdt_fec_sistema)
										if len(ls_obs)>50 then ls_obs=mid(ls_obs,1,50)
										wf_revision_contrato() //REVISION_CONTRATO
										dw_oferta_v.accepttext()
										dw_oferta_v.enabled			= true
										dw_oferta_v.setfocus()
									else
										dw_oferta_v.enabled			= false
//										wf_cargar_codigo_originales()
										messagebox("Advertencia","NO fue Asignada Promesa Nº "+gs_base+'-'+gs_serie+'-'+string(gi_numero,"###,###,###,###"))
										dw_supervisor.setfocus()
									end if
								else
//									wf_cargar_codigo_originales()
								END IF
							end if
						end if
					else
						messagebox("Advertencia","Agente Inexistente")
						dw_agente.reset()
						dw_agente.insertrow(0)
						dw_agente.setfocus()
						gs_age	= ''
					end if
				end if
			
			elseif is_pasa_asigna='N' and is_sw_age='S' then
				gs_age	= dw_agente.getitemstring(1,'agente')
				gs_sup	= dw_supervisor.getitemstring(1,'supervisores')
				gs_jefe	= dw_jefe.getitemstring(1,'jefes')
				if not isnull(gs_age) or gs_age<>'' then
					if gl_cod_parque=0 or isnull(gl_cod_parque) then
						SELECT	"AGENTES"."COD_SUP",
									"AGENTES"."COD_PARQUE",
									"AGENTES"."CANAL"
						INTO 		:ls_sup,
									:gl_cod_parque,
									:ls_canal
						FROM 	"AGENTES",   
									"SUPERVISOR"  
						WHERE  ( "AGENTES"."COD_SUP" = "SUPERVISOR"."COD_SUP" ) and  
								 (("AGENTES"."COD_AGE" = :gs_age ) )   
						USING		sqlca;
					else
						SELECT	"AGENTES"."COD_SUP",
									"AGENTES"."CANAL"
						INTO 		:ls_sup,
									:ls_canal
						FROM 		"AGENTES",   
									"SUPERVISOR"  
						WHERE  ( "AGENTES"."COD_SUP" = "SUPERVISOR"."COD_SUP" ) and  
								 (("AGENTES"."COD_AGE" = :gs_age ) )   
						USING		sqlca;
					end if
					if sqlca.sqlcode=0 then
						dw_oferta_v.SetItem(1, "cadena_cod_parque", gl_cod_parque)
						dw_oferta_v.SetItem(1, "oferta_v_canal_venta", ls_canal)
						dw_oferta_v.accepttext()
						if gl_cod_parque > 0 then
							dw_oferta_v.getchild('oferta_v_beneficio_complementario',idw_detalle2)
							idw_detalle2.settransobject(sqlca)
							idw_detalle2.retrieve(gl_cod_parque)
							idw_detalle3.retrieve(gl_cod_parque)
							idw_detalle4.retrieve(gl_cod_parque,gs_base)
						end if
						if isnull(gs_age) or gs_age='' then
							messagebox("Advertencia","Debe Ingresar Agente")
							dw_agente.setfocus()
						else
							dw_oferta_v.SetItem(1, "cod_age", gs_age)
							dw_oferta_v.accepttext()
							if is_sw_age='S' and gs_sup<>'' and not isnull(gs_sup) and gs_jefe<>'' and not isnull(gs_jefe) then
								il_resp_age	= MessageBox("Advertencia", "Está seguro de ASIGNAR Promesa Nº "+gs_serie+'-'+string(gi_numero,"###,###,###,###"),Exclamation!, YesNo!, 2)
								IF il_resp_age = 1 THEN
									ls_string	= gs_serie+'~t'+string(gi_numero)+'~t'+gs_age+'~t'+string(gdt_fec_sistema)+'~t'+string(gdt_fec_sistema)+'~t'+'V'+'~t'+ls_obs+'~t'+gs_sup+'~t'+gs_jefe
									openwithparm(w_verificar_datos_contrato,ls_string)
									IF trim(Message.StringParm)='OK' THEN
										if gl_cod_parque=0 or isnull(gl_cod_parque) then
											SELECT	"AGENTES"."TIPO_CONT",
														"AGENTES"."COD_PARQUE"
											INTO 		:ls_tipo_cont,
														:gl_cod_parque
											FROM 		"AGENTES"  
											WHERE 	"AGENTES"."COD_AGE" = :gs_age and "AGENTES"."COD_SUP" <> '036'  ;
										else
											SELECT	"AGENTES"."TIPO_CONT"
											INTO 		:ls_tipo_cont
											FROM 		"AGENTES"  
											WHERE 	"AGENTES"."COD_AGE" = :gs_age and "AGENTES"."COD_SUP" <> '036'  ;
										end if
										dw_oferta_v.SetItem(1, "cadena_cod_parque", gl_cod_parque)
										if gl_cod_parque > 0 then
											dw_oferta_v.getchild('oferta_v_beneficio_complementario',idw_detalle2)
											idw_detalle2.settransobject(sqlca)
											idw_detalle2.retrieve(gl_cod_parque)
											idw_detalle3.retrieve(gl_cod_parque)
											idw_detalle4.retrieve(gl_cod_parque,gs_base)
										end if
										
										ls_obs	= 'Promesa creada por '+gs_user+' el '+string(gdt_fec_sistema)
										if len(ls_obs)>50 then ls_obs=mid(ls_obs,1,50)
										dw_oferta_v.enabled			= true
										wf_revision_contrato() //REVISION_CONTRATO
										dw_oferta_v.setfocus()
									else
										dw_oferta_v.enabled			= false
//											wf_cargar_codigo_originales()
										messagebox("Advertencia","NO fue Re-Asignada Promesa Nº "+gs_base+'-'+gs_serie+'-'+string(gi_numero,"###,###,###,###"))
										dw_supervisor.setfocus()
									end if
								else
//										wf_cargar_codigo_originales()
								END IF
							end if
						end if
					else
						messagebox("Advertencia","Agente Inexistente")
						dw_agente.reset()
						dw_agente.insertrow(0)
						dw_agente.setfocus()
						gs_age	= ''
					end if
				end if
			end if
			if ll_grabar_1	= 1 and ll_grabar_2 = 1 then
				commit using sqlca;
				
				UPDATE	"OFERTA_V"  
				SET 		"COD_AGE" = :gs_age,   
							"COD_SUP" = :gs_sup,   
							"COD_JEF" = :gs_jefe  
				WHERE  ( "OFERTA_V"."SERIE" = :gs_serie ) AND  
						 ( "OFERTA_V"."NRO_OFERTA" = :gi_numero )   
				USING		sqlca;
				if sqlca.sqlcode=0 then
					commit;
				else
					rollback;
				end if
			else
				rollback using sqlca;
			end if
		end if
		this.accepttext()
	else
		messagebox("Advertencia","Recuerde antes de Asingar debe ingresar Rut Cliente")
		dw_agente.reset()
		dw_agente.insertrow(0)
		em_rut.setfocus()
	end if
end if
end event

type dw_oferta_v from datawindow within w_ingresar_oferta
event ue_mousemove pbm_dwnmousemove
integer x = 18
integer y = 32
integer width = 3333
integer height = 1936
integer taborder = 80
string title = "none"
string dataobject = "d_ingreso_oferta_v"
boolean border = false
boolean livescroll = true
end type

event ue_mousemove;string	ls_columna
ls_columna									= dwo.name
if ls_columna='t_seguro' then
	st_seguro_complementario.visible	= true
else
	st_seguro_complementario.visible	= false
end if
if ls_columna='t_17' then
	st_ver_pie_pactado.visible			= true
else
	st_ver_pie_pactado.visible			= false
end if
st_limpiar.visible							= false
st_grabar.visible							= false
st_salir.visible								= false
st_help_pagare.visible					= false
st_ver_funeraria.visible					= false
st_ver_institucion.visible					= false
st_ver_aval.visible							= false
st_imprimir.visible							= false
st_help_memo.visible						= false
st_buscar.visible							= false
st_help_cta_cte.visible					= false
st_help_seguro_2.visible					= false
st_help_porce_comi.visible				= false
st_help_beneficios.visible				= false
st_help_copropietario.visible			= false
st_funeraria.visible						= false
st_promociones.visible					= false
st_seg_fune.visible						= false

end event

event clicked;string	ls_columna,ls_fecha,ls_uso,ls_moneda
Datetime	ldt_fecha_prim,ldt_fecha_pie,ldt_fecha
Date		ld_fecha_prim,ld_fecha_min
Long		ll_nro_cuotas,ll_dias,ll_cod_parque,ll_dias_tope_def,ll_dias_inicio_def
Double	ldb_precio,lld_pie,lld_gasto_uf,lld_saldo_finan,lld_factor

SELECT	sysdate,	"TASA"."DIAS_TOPE_REPACTA",	"TASA"."DIAS_INICIO_REPACTA"  INTO :gdt_fec_sistema,	:ll_dias_tope_def,			:ll_dias_inicio_def
FROM 	"TASA"  ;

ls_columna	= dwo.name
CHOOSE CASE ls_columna
	CASE 'p_1'
		if dw_oferta_v.getitemnumber(1,'pago_oferta_factura') = 0 then
			ld_fecha_prim	= date(dw_oferta_v.getitemdatetime(1,'pago_oferta_fecha_prim'))
			ld_fecha_min	= RelativeDate(date(gdt_fec_sistema),  (ll_dias_inicio_def * -1))
			if ld_fecha_prim < ld_fecha_min then
				messagebox("Advertencia","Fecha Primer Vencimiento Inválida")
				dw_oferta_v.setitem(1,'pago_oferta_fecha_prim',date(gdt_fec_sistema))
				dw_oferta_v.accepttext()
			else
				ls_fecha					= string(date(dw_oferta_v.getitemdatetime(1,'pago_oferta_fecha_prim')))
				if isnull(ls_fecha) then ls_fecha = string(id_fecha_dia,"dd/mm/yyyy")
				if f_valida_fecha(ls_fecha)=-1 then 
					dw_oferta_v.setitem(1,'pago_oferta_fecha_prim',datetime(string(id_fecha_dia,gs_formato_fecha)))
					return
				end if
				OpenWithParm(w_calendar,ls_fecha)
				IF not isnull(Message.StringParm) THEN
					ls_fecha				= trim(Message.StringParm)
					dw_oferta_v.setitem(1,'pago_oferta_fecha_prim',date(ls_fecha))
				END IF
				dw_oferta_v.accepttext()
				ldt_fecha_prim	= dw_oferta_v.getitemdatetime(1,'pago_oferta_fecha_prim')
				ll_nro_cuotas	= dw_oferta_v.getitemnumber(1,'pago_oferta_nro_cuotas')
				if not isnull(ldt_fecha_prim) and not isnull(ll_nro_cuotas) and ll_nro_cuotas>0 then
					ls_fecha			= f_fecha_vcto_prim(  ll_nro_cuotas ,  ldt_fecha_prim  )
					if not isnull(ls_fecha) and ls_fecha<>'//' and ls_fecha<>'' then
						dw_oferta_v.setitem(1,'pago_oferta_fecha_ult',date(ls_fecha))
					end if
				end if
				ls_uso	= dw_oferta_v.getitemstring(1,'uso')
				ldt_fecha_pie	= dw_oferta_v.getitemdatetime(1,'pago_oferta_fecha_pie')
				ldt_fecha_prim	= dw_oferta_v.getitemdatetime(1,'pago_oferta_fecha_prim')
				if ls_uso='NF' then
					if not isnull(ldt_fecha_pie) then
						ls_fecha			= f_fecha_vcto_prim( 7 ,  ldt_fecha_pie  )
						if not isnull(ls_fecha) and ls_fecha<>'//' and ls_fecha<>'' then
							dw_oferta_v.setitem(1,'pago_oferta_fecha_entre',date(ls_fecha))
						end if
					else
						ls_fecha			= f_fecha_vcto_prim( 7 ,  ldt_fecha_prim  )
						if not isnull(ls_fecha) and ls_fecha<>'//' and ls_fecha<>'' then
							dw_oferta_v.setitem(1,'pago_oferta_fecha_entre',date(ls_fecha))
						end if
					end if
				elseif ls_uso='NI' then
					ldt_fecha	= dw_oferta_v.getitemdatetime(1,'fecha')
					ldt_fecha	= dw_oferta_v.getitemdatetime(1,'fecha')
					dw_oferta_v.setitem(1,'pago_oferta_fecha_entre',ldt_fecha)
				end if
	//			if not isnull(ldt_fecha_pie) then
	//				ls_fecha			= f_fecha_vcto_mant( 13 ,  ldt_fecha_pie  )
	//				if not isnull(ls_fecha) and ls_fecha<>'//' and ls_fecha<>'' then
	//					dw_oferta_v.setitem(1,'fecha_m',date(ls_fecha))
	//				end if
	//			else
	//				if not isnull(ldt_fecha_prim) then
	//					ls_fecha			= f_fecha_vcto_mant( 13 ,  ldt_fecha_prim )
	//					if not isnull(ls_fecha) and ls_fecha<>'//' and ls_fecha<>'' then
	//						dw_oferta_v.setitem(1,'fecha_m',date(ls_fecha))
	//					end if
	//				end if
	//			end if
				ll_nro_cuotas		= dw_oferta_v.getitemnumber(1,'pago_oferta_nro_cuotas')
				ldt_fecha			= dw_oferta_v.getitemdatetime(1,'fecha')
				ldt_fecha_prim		= dw_oferta_v.getitemdatetime(1,'pago_oferta_fecha_prim')
				ls_moneda			= dw_oferta_v.getitemstring(1,'pago_oferta_moneda')
				ldb_precio			= dw_oferta_v.getitemnumber(1,'pago_oferta_precio')
				lld_pie				= dw_oferta_v.getitemnumber(1,'pago_oferta_pie')
				lld_gasto_uf		= dw_oferta_v.getitemnumber(1,'pago_oferta_gastos_adm')
				dw_oferta_v.accepttext()
				lld_saldo_finan	= double(dw_oferta_v.getitemnumber(1,'saldo_finan'))
				if not isnull(ll_nro_cuotas) and ll_nro_cuotas>0 and not isnull(ldt_fecha) and not isnull(ldt_fecha_prim) and &
					not isnull(ls_moneda) and not isnull(ldb_precio) and not isnull(lld_pie) and not isnull(lld_gasto_uf) and &
					ldb_precio>0 and lld_pie>0 and lld_gasto_uf>0 then
					if ldt_fecha_prim > ldt_fecha and ll_nro_cuotas > 0 then
						ll_dias	= DaysAfter(date(ldt_fecha),date(ldt_fecha_prim))
						SELECT	"FACTORES"."FACTOR"  
						INTO 		:lld_factor  
						FROM 		"FACTORES"  
						WHERE  ( "FACTORES"."BASE" = :gs_base ) AND  
								 ( :ll_nro_cuotas = "FACTORES"."NRO_CUOTAS_INICIAL")  AND  
								 ((:ll_dias >= "FACTORES"."DIAS_INICIAL")  AND  
								 ( :ll_dias <= "FACTORES"."DIAS_FINAL" ))  AND
								 ( "FACTORES"."MONEDA" = :ls_moneda )
						USING		sqlca;
						if sqlca.sqlcode=0 then
							if lld_factor>0 and lld_saldo_finan>0 then
								lld_saldo_finan	= lld_factor * lld_saldo_finan
								dw_oferta_v.setitem(1,'pago_oferta_valor_cuota',lld_saldo_finan)
							end if
						end if
					end if
				end if
			end if
			dw_oferta_v.setfocus()
			dw_oferta_v.setcolumn('pago_oferta_fecha_prim')
		else	
		end if
	CASE 'p_2'
		if dw_oferta_v.getitemnumber(1,'pago_oferta_factura') = 0 then
			lld_pie				= double(dw_oferta_v.getitemnumber(1,'pago_oferta_pie'))
			if lld_pie>0 and not isnull(lld_pie) then
				ls_fecha			= string(date(dw_oferta_v.getitemdatetime(1,'pago_oferta_fecha_pie')))
				if isnull(ls_fecha) then ls_fecha = string(id_fecha_dia,"dd/mm/yyyy")
				if f_valida_fecha(ls_fecha)=-1 then 
					dw_oferta_v.setitem(1,'pago_oferta_fecha_pie',datetime(string(id_fecha_dia,gs_formato_fecha)))
					return
				end if
				OpenWithParm(w_calendar,ls_fecha)
				IF not isnull(Message.StringParm) THEN
					ls_fecha		= trim(Message.StringParm)
					dw_oferta_v.setitem(1,'pago_oferta_fecha_pie',date(ls_fecha))
				END IF
				ls_uso			= dw_oferta_v.getitemstring(1,'uso')
				ldt_fecha_pie	= dw_oferta_v.getitemdatetime(1,'pago_oferta_fecha_pie')
				ldt_fecha_prim	= dw_oferta_v.getitemdatetime(1,'pago_oferta_fecha_prim')
				if ls_uso='NF' then
					if not isnull(ldt_fecha_pie) then
						ls_fecha			= f_fecha_vcto_prim( 7 ,  ldt_fecha_pie  )
						if not isnull(ls_fecha) and ls_fecha<>'//' and ls_fecha<>'' then
							dw_oferta_v.setitem(1,'pago_oferta_fecha_entre',date(ls_fecha))
						end if
					else
						ls_fecha			= f_fecha_vcto_prim( 7 ,  ldt_fecha_prim  )
						if not isnull(ls_fecha) and ls_fecha<>'//' and ls_fecha<>'' then
							dw_oferta_v.setitem(1,'pago_oferta_fecha_entre',date(ls_fecha))
						end if
					end if
				elseif ls_uso='NI' then
					ldt_fecha	= dw_oferta_v.getitemdatetime(1,'fecha')
					ldt_fecha	= dw_oferta_v.getitemdatetime(1,'fecha')
					dw_oferta_v.setitem(1,'pago_oferta_fecha_entre',ldt_fecha)
				end if
	//			if not isnull(ldt_fecha_pie) then
	//				ls_fecha			= f_fecha_vcto_mant( 13 ,  ldt_fecha_pie  )
	//				if not isnull(ls_fecha) and ls_fecha<>'//' and ls_fecha<>'' then
	//					dw_oferta_v.setitem(1,'fecha_m',date(ls_fecha))
	//				end if
	//			else
	//				if not isnull(ldt_fecha_prim) then
	//					ls_fecha			= f_fecha_vcto_mant( 13 ,  ldt_fecha_prim )
	//					if not isnull(ls_fecha) and ls_fecha<>'//' and ls_fecha<>'' then
	//						dw_oferta_v.setitem(1,'fecha_m',date(ls_fecha))
	//					end if
	//				end if
	//			end if
				dw_oferta_v.setfocus()
				dw_oferta_v.setcolumn('pago_oferta_fecha_pie')
			else
				messagebox("Advertencia","Debe Ingresar Antes Valor Pie")
				dw_oferta_v.setfocus()
				dw_oferta_v.setcolumn('pago_oferta_pie')
			end if
		end if
	CASE 'p_3'
		ls_fecha					= string(date(dw_oferta_v.getitemdatetime(1,'pago_oferta_fecha_entre')))
		if isnull(ls_fecha) then ls_fecha = string(id_fecha_dia,"dd/mm/yyyy")
		if f_valida_fecha(ls_fecha)=-1 then 
			dw_oferta_v.setitem(1,'pago_oferta_fecha_entre',datetime(string(id_fecha_dia,gs_formato_fecha)))
			return
		end if
		OpenWithParm(w_calendar,ls_fecha)
		IF not isnull(Message.StringParm) THEN
			ls_fecha				= trim(Message.StringParm)
			dw_oferta_v.setitem(1,'pago_oferta_fecha_entre',date(ls_fecha))
		END IF
		dw_oferta_v.setfocus()
		dw_oferta_v.setcolumn('pago_oferta_fecha_entre')
		
	CASE 'p_4'
		if dw_oferta_v.getitemnumber(1,'pago_oferta_factura') = 0 then	
			ls_fecha					= string(date(dw_oferta_v.getitemdatetime(1,'pago_oferta_fecha_ult')))
			if isnull(ls_fecha) then ls_fecha = string(id_fecha_dia,"dd/mm/yyyy")
			if f_valida_fecha(ls_fecha)=-1 then 
				dw_oferta_v.setitem(1,'pago_oferta_fecha_ult',datetime(string(id_fecha_dia,gs_formato_fecha)))
				return
			end if
			OpenWithParm(w_calendar,ls_fecha)
			IF not isnull(Message.StringParm) THEN
				ls_fecha				= trim(Message.StringParm)
				dw_oferta_v.setitem(1,'pago_oferta_fecha_ult',date(ls_fecha))
			END IF
			dw_oferta_v.setfocus()
			dw_oferta_v.setcolumn('pago_oferta_fecha_ult')
		end if
	CASE 'p_5'
		if dw_oferta_v.getitemnumber(1,'pago_oferta_factura') = 0 then
			ls_fecha					= string(date(dw_oferta_v.getitemdatetime(1,'fecha_m')))
			if isnull(ls_fecha) then ls_fecha = string(id_fecha_dia,"dd/mm/yyyy")
			if f_valida_fecha(ls_fecha)=-1 then 
				dw_oferta_v.setitem(1,'fecha_m',datetime(string(id_fecha_dia,gs_formato_fecha)))
				return
			end if
			OpenWithParm(w_calendar,ls_fecha)
			IF not isnull(Message.StringParm) THEN
				ls_fecha				= trim(Message.StringParm)
				dw_oferta_v.setitem(1,'fecha_m',date(ls_fecha))
			END IF
			dw_oferta_v.setfocus()
			dw_oferta_v.setcolumn('fecha_m')
		end if
	CASE 'p_6'
		if dw_oferta_v.getitemnumber(1,'pago_oferta_factura') = 0 then
			ls_fecha					= string(date(dw_oferta_v.getitemdatetime(1,'fecha')))
			if isnull(ls_fecha) then ls_fecha = string(id_fecha_dia,"dd/mm/yyyy")
			if f_valida_fecha(ls_fecha)=-1 then 
				dw_oferta_v.setitem(1,'fecha',datetime(string(id_fecha_dia,gs_formato_fecha)))
				return
			end if
			OpenWithParm(w_calendar,ls_fecha)
			IF not isnull(Message.StringParm) THEN
				ls_fecha				= trim(Message.StringParm)
				dw_oferta_v.setitem(1,'fecha',date(ls_fecha))
			END IF
			ls_uso	= dw_oferta_v.getitemstring(1,'uso')
			ldt_fecha_pie	= dw_oferta_v.getitemdatetime(1,'pago_oferta_fecha_pie')
			ldt_fecha_prim	= dw_oferta_v.getitemdatetime(1,'pago_oferta_fecha_prim')
			if ls_uso='NF' then
				if not isnull(ldt_fecha_pie) then
					ls_fecha			= f_fecha_vcto_prim( 7 ,  ldt_fecha_pie  )
					if not isnull(ls_fecha) and ls_fecha<>'//' and ls_fecha<>'' then
						dw_oferta_v.setitem(1,'pago_oferta_fecha_entre',date(ls_fecha))
					end if
				else
					ls_fecha			= f_fecha_vcto_prim( 7 ,  ldt_fecha_prim  )
					if not isnull(ls_fecha) and ls_fecha<>'//' and ls_fecha<>'' then
						dw_oferta_v.setitem(1,'pago_oferta_fecha_entre',date(ls_fecha))
					end if
				end if
			elseif ls_uso='NI' then
				ldt_fecha	= dw_oferta_v.getitemdatetime(1,'fecha')
				dw_oferta_v.setitem(1,'pago_oferta_fecha_entre',ldt_fecha)
			end if
			ldt_fecha				= dw_oferta_v.getitemdatetime(1,'fecha')
			if not isnull(ldt_fecha) then
				ll_cod_parque	= dw_oferta_v.getitemnumber(1,'cadena_cod_parque')
				if ll_cod_parque=103 then
					ls_fecha			= f_fecha_vcto_mant( 13 ,  ldt_fecha ) //7
				else
					ls_fecha			= f_fecha_vcto_mant( 13 ,  ldt_fecha )
				end if
				if not isnull(ls_fecha) and ls_fecha<>'//' and ls_fecha<>'' then
					dw_oferta_v.setitem(1,'fecha_m',date(ls_fecha))
				end if
			end if
			dw_oferta_v.AcceptText()
			dw_oferta_v.setfocus()
			dw_oferta_v.setcolumn('fecha')
			dw_oferta_v.SetItem(1 , "pago_oferta_uf_dia", gf_uf( String(dw_oferta_v.GetItemDateTime(1, "fecha"),"dd/mm/yyyy") ) )
			dw_oferta_v.AcceptText()
			ll_nro_cuotas		= dw_oferta_v.getitemnumber(1,'pago_oferta_nro_cuotas')
			ldt_fecha				= dw_oferta_v.getitemdatetime(1,'fecha')
			ldt_fecha_prim		= dw_oferta_v.getitemdatetime(1,'pago_oferta_fecha_prim')
			ls_moneda			= dw_oferta_v.getitemstring(1,'pago_oferta_moneda')
			ldb_precio			= dw_oferta_v.getitemnumber(1,'pago_oferta_precio')
			lld_pie				= dw_oferta_v.getitemnumber(1,'pago_oferta_pie')
			lld_gasto_uf			= dw_oferta_v.getitemnumber(1,'pago_oferta_gastos_adm')
			dw_oferta_v.accepttext()
			lld_saldo_finan	= double(dw_oferta_v.getitemnumber(1,'saldo_finan'))
			if not isnull(ll_nro_cuotas) and ll_nro_cuotas>0 and not isnull(ldt_fecha) and not isnull(ldt_fecha_prim) and &
				not isnull(ls_moneda) and not isnull(ldb_precio) and not isnull(lld_pie) and not isnull(lld_gasto_uf) and &
				ldb_precio>0 and lld_pie>0 and lld_gasto_uf>0 then
				if ldt_fecha_prim > ldt_fecha and ll_nro_cuotas > 0 then
					ll_dias	= DaysAfter(date(ldt_fecha),date(ldt_fecha_prim))
					SELECT	"FACTORES"."FACTOR"  
					INTO 		:lld_factor  
					FROM 		"FACTORES"  
					WHERE  ( "FACTORES"."BASE" = :gs_base ) AND  
							 ( :ll_nro_cuotas = "FACTORES"."NRO_CUOTAS_INICIAL")  AND  
							 ((:ll_dias >= "FACTORES"."DIAS_INICIAL")  AND  
							 ( :ll_dias <= "FACTORES"."DIAS_FINAL" ))  AND
							 ( "FACTORES"."MONEDA" = :ls_moneda )
					USING		sqlca;
					if sqlca.sqlcode=0 then
						if lld_factor>0 and lld_saldo_finan>0 then
							lld_saldo_finan	= lld_factor * lld_saldo_finan
							dw_oferta_v.setitem(1,'pago_oferta_valor_cuota',lld_saldo_finan)
						end if
					end if
				end if
			end if
			dw_oferta_v.accepttext()
		end if		
END CHOOSE
end event

event itemchanged;long 		ll_cant, ll_fila,rut_institucional,rut_aval,rut_funeraria,ll_capacidad,ll_nro_cuotas,ll_resp,ll_reg,ll_gastos_adm_peso,ll_dias,ll_tipo_dscto,ll_promocion,ll_cod_parque,ll_tipo_seguro,&
			ll_cantidad,ll_cod_seguro,ll_nulo,ll_dia_hoy,ll_dia_nac,ll_mes_hoy,ll_mes_nac,ll_anfecha_mo_hoy,ll_ano_nac,ll_edad,ll_count_reg,ll_ano_hoy,ll_tot_reg,ll_indi,ll_tipo_conv,&
			ll_dias_tope_def,ll_dias_inicio_def,ll_tipo_producto
string 	ls_columna,ls_area,ls_moneda,ls_tipo_sepultura,ls_uso,ls_string,ls_tipo_contru,ls_fecha,ls_tipo_construc,ls_descrip_moneda,ls_dv,ls_anexo_dacion,ls_estado,ls_ctto_text,ls_base_dac,&
			ls_serie_dac,ls_agente,ls_canal,ls_string_find
Double	ldb_uf,ldb_cuota_mant,ldb_precio,ldb_derecho,ldb_liberador,ldb_precio_ori,ldb_derecho_ori,ldb_cuota_mant_ori,ldb_liberador_ori,lld_gasto_uf,lld_gastos_adm_uf,lld_tasa,lld_valor_cuo,&
			lld_pie,lld_factor,lld_saldo_finan,lld_fac_cta_mensual,lld_descuento_por,ll_gasto_peso,lld_factor_seg_comp,ldb_factor_seguro,ldb_suma_cuota,ldb_factor_gasto_cob,ldb_valor_gasto_adm,&
			ldb_gastos_adm,ll_numero_dac
Datetime	ldt_fecha_prim,ldt_fecha_pie,ldt_fecha,ldt_fecha_duracion_vigencia
Date		ld_fecha_prim,ld_fecha_min,ld_fecha_max,ld_fecha,ldt_fecha_ctto

SELECT	sysdate,	"TASA"."DIAS_TOPE_REPACTA",	"TASA"."DIAS_INICIO_REPACTA"  INTO :gdt_fec_sistema,	:ll_dias_tope_def,			:ll_dias_inicio_def
FROM 	"TASA"  ;


setnull(ll_nulo)
dw_oferta_v.AcceptText()
ls_columna												= GetColumnName()
if ls_columna='tipo_venta' then
	IF GetItemSTRING(1, "tipo_venta") <> '6' THEN
		Object.rut_institucional.TabSequence	= 0
		Object.compute_0050.TabSequence 			= 0
	ELSE
		Object.rut_institucional.TabSequence 		= 130
		Object.compute_0050.TabSequence 			= 140
	END IF
end if
if ls_columna='rut_institucional' then dw_oferta_v.SetColumn('compute_0050')
if ls_columna='compute_0050' then
	if String(getitemstring(1,'compute_0050')) <> String(gf_obtener_dv(long(GetItemNumber(1, "rut_institucional")))) then
		messagebox('Error','El Rut Institucional no es valido',stopsign!)
		cb_aceptar.setfocus()
		dw_oferta_v.setfocus()
		dw_oferta_v.SetColumn('rut_institucional')
	else
		rut_institucional = dw_oferta_v.getitemnumber(1,'rut_institucional')
		SELECT	"INSTITUCIONAL"."RUT"  
		INTO 		:rut_institucional  
		FROM 		"INSTITUCIONAL"  
		WHERE 	"INSTITUCIONAL"."RUT" = :rut_institucional   ;
		if sqlca.sqlcode <> 0 then
			pb_institucion.triggerevent(clicked!)
		end if
	end if
end if		
if ls_columna='compute_0053' then
	if String(getitemstring(1,'compute_0053')) <> String(gf_obtener_dv(long(GetItemNumber(1, "rut_aval")))) then
		messagebox('Error','El Rut Aval no es valido',stopsign!)
		dw_oferta_v.setfocus()
		dw_oferta_v.SetColumn('rut_aval')
	else
		rut_aval	= dw_oferta_v.getitemnumber(1,'rut_aval')
		OpenWithParm(w_aval,string(rut_aval))
		if Message.StringParm = '1' then
			dw_oferta_v.setitem(1,'aval',1)
		else
			dw_oferta_v.setitem(1,'aval',0)
		end if 
	end if	
end if		
if ls_columna='compute_0055' then
	if String(getitemstring(1,'compute_0055')) <> String(gf_obtener_dv(long(GetItemNumber(1, "rut_funeraria")))) then
		messagebox('Error','El Rut de Funeraria no es valido',stopsign!)
		cb_aceptar.setfocus()
		dw_oferta_v.setfocus()
		dw_oferta_v.SetColumn('rut_funeraria')
	else
		rut_funeraria 	= dw_oferta_v.getitemnumber(1,'rut_funeraria')
		ls_dv				= dw_oferta_v.getitemstring(1,'compute_0055')
		SELECT	"FUNERARIA"."RUT"  
		INTO 		:rut_funeraria
		FROM 		"FUNERARIA"  
		WHERE 	"FUNERARIA"."RUT" = :rut_funeraria   ;
		if sqlca.sqlcode <> 0 then
			OpenWithParm(w_ingreso_funeraria,string(rut_funeraria)+'~t'+ls_dv)
		end if
	end if		
end if	
dw_oferta_v.AcceptText()
if ls_columna='pago_oferta_codigo_tipo_seguro' then
	ll_tipo_seguro				= long(data)	// dw_oferta_v.getitemnumber(1,'pago_oferta_codigo_tipo_seguro')
	ls_string_find				= 'codigo = '+string(ll_tipo_seguro)
	ll_reg 						= dw_seguro.Find(ls_string_find, 1, dw_seguro.RowCount())
	if ll_reg > 0 then
		//if dw_oferta_v.getitemnumber(1,'pago_oferta_factura') = 99 then
			SELECT	"TIPO_SEGURO"."CANTIDAD_BENEFICIARIO",   
						"TIPO_SEGURO"."FACTOR",
						"TIPO_SEGURO"."FECHA_DURACION_VIGENCIA"
			INTO 		:ll_cantidad,   
						:lld_factor_seg_comp,
						:ldt_fecha_duracion_vigencia
			FROM 		"TIPO_SEGURO"  
			WHERE 	"TIPO_SEGURO"."CODIGO" = :ll_tipo_seguro   
			USING		sqlca;
			if sqlca.sqlcode=0 then
				ld_fecha						= date(dw_clientes.getitemdatetime(1,'fecha_nac'))
				if ll_tipo_seguro=2 then
					if not isnull(ld_fecha) then
						ll_dia_hoy			= day(id_fecha_dia)
						ll_dia_nac			= day(ld_fecha)
						ll_mes_hoy			= month(id_fecha_dia)
						ll_mes_nac			= month(ld_fecha)
						ll_ano_hoy			= year(id_fecha_dia)
						ll_ano_nac			= year(ld_fecha)
						ll_edad				= ll_ano_hoy - ll_ano_nac
						if ll_mes_hoy > ll_mes_nac then
							ll_edad ++
						elseif ll_mes_hoy = ll_mes_nac then
							if ll_dia_hoy >= ll_dia_nac then
								ll_edad ++
							end if
						end if
						if ll_edad<=65 then
							ls_string		= gs_base+'~t'+gs_serie+'~t'+string(gi_numero)+'~t'+string(ll_cantidad)+'~t'+string(lld_factor_seg_comp)+'~t'+string(ll_tipo_seguro)
							openwithparm(w_ingreso_seguro_complementario,ls_string)
						else
							messagebox("Advertencia","Recuerde No es posible Ingresar Beneficiarios, Titular debe tener Menos de 65 Años")
						end if
					else
						messagebox("Advertencia","Debe Ingresar Cliente, recuerde ingresar correctamente Fecha de Nacimiento")
					end if
				elseif ll_tipo_seguro>0 then
					if ldt_fecha_duracion_vigencia > gdt_fec_sistema then
						ls_string	= gs_base+'~t'+gs_serie+'~t'+string(gi_numero)+'~t'+string(ll_cantidad)+'~t'+string(lld_factor_seg_comp)+'~t'+string(ll_tipo_seguro)
						openwithparm(w_ingreso_seguro_complementario,ls_string)
					else
						messagebox("Advertencia","Seguro No Vigente")
						dw_oferta_v.setitem(1,'pago_oferta_codigo_tipo_seguro',0)
						dw_oferta_v.accepttext()
					end if
				end if
			end if
//			messagebox("Advertencia","Debe Seleccionar Tipo Seguro Asociado")
//			dw_oferta_v.setitem(1,'pago_oferta_codigo_tipo_seguro',0)
//			dw_oferta_v.accepttext()
//			dw_oferta_v.setfocus()
//			dw_oferta_v.setcolumn('pago_oferta_codigo_tipo_seguro')
//		else	
//			dw_seguro.enabled = true
//		end if	
	else
		messagebox("Advertencia","Seguro Complementario Seleccionado No está VIGENTE")
		dw_oferta_v.setitem(1,'pago_oferta_codigo_tipo_seguro',0)
		dw_oferta_v.accepttext()
		dw_oferta_v.setfocus()
		dw_oferta_v.setcolumn('pago_oferta_codigo_tipo_seguro')
	end if
end if
if ls_columna='fecha' then
	dw_oferta_v.SetItem(1 , "pago_oferta_uf_dia", gf_uf( String(dw_oferta_v.GetItemDateTime(1, "fecha"),"dd/mm/yyyy") ) )	
	ldt_fecha				= dw_oferta_v.getitemdatetime(1,'fecha')
	if not isnull(ldt_fecha) then
		ll_cod_parque	= dw_oferta_v.getitemnumber(1,'cadena_cod_parque')
		if ll_cod_parque=103 then
			ls_fecha			= f_fecha_vcto_mant( 13 ,  ldt_fecha ) //7
		else
			ls_fecha			= f_fecha_vcto_mant( 13 ,  ldt_fecha )
		end if
		if not isnull(ls_fecha) and ls_fecha<>'//' and ls_fecha<>'' then
			dw_oferta_v.setitem(1,'fecha_m',date(ls_fecha))
		end if
	end if
end if
if ls_columna = 'cadena_cod_parque' then
	gl_cod_parque		= dw_oferta_v.getitemnumber(1,'cadena_cod_parque')
	if gl_cod_parque > 0 then
		dw_oferta_v.getchild('oferta_v_beneficio_complementario',idw_detalle2)
		idw_detalle2.settransobject(sqlca)
		idw_detalle2.retrieve(gl_cod_parque)
		
		idw_detalle3.retrieve(gl_cod_parque)
		
		idw_detalle4.retrieve(gl_cod_parque,gs_base)
		
		if gs_conexion = "Parque El Prado" then
			ll_tot_reg	= dw_seguro.retrieve(gl_cod_parque,gs_base)
		elseif gs_conexion = "Parque La Foresta" then
			ll_tot_reg	= dw_seguro.retrieve(gl_cod_parque,gs_base)
		end if
		if ll_tot_reg > 0 then
			for ll_indi=1 to ll_tot_reg
				dw_seguro.setitem(ll_indi,'c_estado_reg',1)
			next
			dw_seguro.accepttext()
		end if
		
	end if
end if
if ls_columna='pago_oferta_fecha_prim' or ls_columna='pago_oferta_nro_cuotas' then
	ldt_fecha_prim		= dw_oferta_v.getitemdatetime(1,'pago_oferta_fecha_prim')
	ll_nro_cuotas		= dw_oferta_v.getitemnumber(1,'pago_oferta_nro_cuotas')
	if not isnull(ldt_fecha_prim) and not isnull(ll_nro_cuotas) and ll_nro_cuotas>0 then
		ls_fecha			= f_fecha_vcto_prim(  ll_nro_cuotas ,  ldt_fecha_prim  )
		if not isnull(ls_fecha) and ls_fecha<>'//' and ls_fecha<>'' then
			dw_oferta_v.setitem(1,'pago_oferta_fecha_ult',date(ls_fecha))
		end if
	end if
end if	
if ls_columna='pago_oferta_fecha_prim' then
	ld_fecha_prim	= date(dw_oferta_v.getitemdatetime(1,'pago_oferta_fecha_prim'))
	ld_fecha_min	= RelativeDate(date(gdt_fec_sistema),  (ll_dias_inicio_def * -1))
	ld_fecha_max	= RelativeDate(date(gdt_fec_sistema),  ll_dias_tope_def)
	if ld_fecha_prim < ld_fecha_min or ld_fecha_prim > ld_fecha_max then
		messagebox("Advertencia","Fecha Primer Vencimiento Inválida")
		dw_oferta_v.setitem(1,'pago_oferta_fecha_prim',date(gdt_fec_sistema))
		dw_oferta_v.accepttext()
	end if
end if	
if ls_columna='pago_oferta_nro_cuotas' or ls_columna='pago_oferta_moneda' then
	ll_nro_cuotas		= dw_oferta_v.getitemnumber(1,'pago_oferta_nro_cuotas')
	ls_moneda			= dw_oferta_v.getitemstring(1,'pago_oferta_moneda')
	ll_cod_seguro		= dw_oferta_v.getitemnumber(1,'pago_oferta_codigo_tipo_seguro')
	if ll_nro_cuotas>0 and not isnull(ls_moneda) then
		SELECT	"REVISION_CONTRATOS"."GASTO_ADM"  
		INTO 		:ldb_valor_gasto_adm  
		FROM 		"REVISION_CONTRATOS"  
		WHERE  ( "REVISION_CONTRATOS"."BASE" = :gs_base ) AND  
				 ( "REVISION_CONTRATOS"."SERIE" = :gs_serie ) AND  
				 ( "REVISION_CONTRATOS"."NUMERO" = :gi_numero ) AND
				 ( "REVISION_CONTRATOS"."ESTADO_REVISION" = 'A')
		USING		sqlca;
		if sqlca.sqlcode=0 then
			dw_oferta_v.setitem(1,'pago_oferta_gastos_adm',ldb_valor_gasto_adm)
			if ls_moneda='1' then //peso
				SELECT	"INTERES_CUOTAS"."INTERES_PESOS"  
				INTO 		:lld_fac_cta_mensual  
				FROM 		"INTERES_CUOTAS"  
				WHERE 	"INTERES_CUOTAS"."NRO_CUOTAS" = :ll_nro_cuotas   
				USING		sqlca;
				if sqlca.sqlcode=0 then
					if dw_oferta_v.getitemstring(1,'forma_pago')='1' or dw_oferta_v.getitemstring(1,'forma_pago')='3' then
						lld_fac_cta_mensual	= 0
					end if
					dw_oferta_v.setitem(1,'pago_oferta_tasa_base',lld_fac_cta_mensual)
				end if
			else
				SELECT	"INTERES_CUOTAS"."INTERES_UF"  
				INTO 		:lld_fac_cta_mensual  
				FROM 		"INTERES_CUOTAS"  
				WHERE 	"INTERES_CUOTAS"."NRO_CUOTAS" = :ll_nro_cuotas   
				USING		sqlca;
				if sqlca.sqlcode=0 then
					if dw_oferta_v.getitemstring(1,'forma_pago')='1' or dw_oferta_v.getitemstring(1,'forma_pago')='3' then
						lld_fac_cta_mensual	= 0
					end if
					dw_oferta_v.setitem(1,'pago_oferta_tasa_base',lld_fac_cta_mensual)
				end if
			end if
		else
			SELECT	"TASA_GASTOS_ADM"."TASA_UF",   
						"TASA_GASTOS_ADM"."TASA_PESO"  
			INTO 		:lld_gasto_uf,   
						:ll_gasto_peso  
			FROM 		"TASA_GASTOS_ADM"  
			WHERE 	"TASA_GASTOS_ADM"."CODIGO" = 1   
			USING		sqlca;
			if sqlca.sqlcode=0 then
				if ls_moneda='1' then //peso
					if ll_cod_seguro = 1 then
						SELECT	"TIPO_SEGURO"."FACTOR_PESO"  
						INTO 		:ldb_factor_seguro  
						FROM 		"TIPO_SEGURO"  
						WHERE 	"TIPO_SEGURO"."CODIGO" = :ll_cod_seguro
						USING		sqlca;
						if sqlca.sqlcode=0 then
							ll_gasto_peso			= ll_gasto_peso + ldb_factor_seguro
						end if
						ll_gastos_adm_peso		= ll_nro_cuotas * ll_gasto_peso
					else
						ll_gastos_adm_peso		= ll_nro_cuotas * ll_gasto_peso
					end if
					if dw_oferta_v.getitemstring(1,'forma_pago')='1' or dw_oferta_v.getitemstring(1,'forma_pago')='3' then
						ll_gastos_adm_peso		= 0
					end if
					dw_oferta_v.setitem(1,'pago_oferta_gastos_adm',ll_gastos_adm_peso)
					SELECT	"INTERES_CUOTAS"."INTERES_PESOS"  
					INTO 		:lld_fac_cta_mensual  
					FROM 		"INTERES_CUOTAS"  
					WHERE 	"INTERES_CUOTAS"."NRO_CUOTAS" = :ll_nro_cuotas   
					USING		sqlca;
					if sqlca.sqlcode=0 then
						if dw_oferta_v.getitemstring(1,'forma_pago')='1' or dw_oferta_v.getitemstring(1,'forma_pago')='3' then
							lld_fac_cta_mensual	= 0
						end if
						dw_oferta_v.setitem(1,'pago_oferta_tasa_base',lld_fac_cta_mensual)
					end if
				elseif ls_moneda='2' then //uf
					if ll_cod_seguro = 1 then
						SELECT	"TIPO_SEGURO"."FACTOR"  
						INTO 		:ldb_factor_seguro  
						FROM 		"TIPO_SEGURO"  
						WHERE 	"TIPO_SEGURO"."CODIGO" = :ll_cod_seguro   
						USING		sqlca;
						if sqlca.sqlcode=0 then
							lld_gasto_uf			= lld_gasto_uf + ldb_factor_seguro
						end if
						lld_gastos_adm_uf			= ll_nro_cuotas * lld_gasto_uf  
					else
						lld_gastos_adm_uf			= ll_nro_cuotas * lld_gasto_uf  
					end if
					if dw_oferta_v.getitemstring(1,'forma_pago')='1' or dw_oferta_v.getitemstring(1,'forma_pago')='3' then
						lld_gastos_adm_uf			= 0
					end if
					dw_oferta_v.setitem(1,'pago_oferta_gastos_adm',lld_gastos_adm_uf)
					SELECT	"INTERES_CUOTAS"."INTERES_UF"  
					INTO 		:lld_fac_cta_mensual  
					FROM 		"INTERES_CUOTAS"  
					WHERE 	"INTERES_CUOTAS"."NRO_CUOTAS" = :ll_nro_cuotas   
					USING		sqlca;
					if sqlca.sqlcode=0 then
						if dw_oferta_v.getitemstring(1,'forma_pago')='1' or dw_oferta_v.getitemstring(1,'forma_pago')='3' then
							lld_fac_cta_mensual	= 0
						end if
						dw_oferta_v.setitem(1,'pago_oferta_tasa_base',lld_fac_cta_mensual)
					end if
				end if
			end if
		end if
	end if	
end if
if ls_columna='pago_oferta_pie' then
	dw_oferta_v.accepttext()
	lld_pie										= double(dw_oferta_v.getitemnumber(1,'pago_oferta_pie'))
	ls_moneda									= dw_oferta_v.getitemstring(1,'pago_oferta_moneda')
	if lld_pie>0 then
		ls_uso			= trim(dw_oferta_v.getitemstring(1,'uso'))
		SELECT	Count("DETALLE_PAGO_PIE"."ESTADO")  
		INTO 		:ll_count_reg  
		FROM 		"DETALLE_PAGO_PIE"  
		WHERE  ( "DETALLE_PAGO_PIE"."BASE" = :gs_base ) AND  
				 ( "DETALLE_PAGO_PIE"."SERIE" = :gs_serie ) AND  
				 ( "DETALLE_PAGO_PIE"."NUMERO" = :gi_numero ) AND  
				 ( "DETALLE_PAGO_PIE"."ESTADO" = 'C' )   
		USING		sqlca;
		if isnull(ll_count_reg) or ll_count_reg=0 then
			ls_string		= gs_base+'~t'+gs_serie+'~t'+string(gi_numero)+'~t'+string(lld_pie)+'~t'+ls_uso+'~t'+'M'+'~t'+ls_moneda
			if not isnull(ls_uso) and ls_uso<>'' and not isnull(ls_moneda) then
				openwithparm(w_mensaje_pie,ls_string)
				is_respuesta	= Message.StringParm
				IF trim(is_respuesta)='S' THEN 
					openwithparm(w_ingreso_pie_pactado,ls_string)
				elseif trim(is_respuesta)='C' THEN
					cb_3.triggerevent(clicked!)
				end if
			else 
				if isnull(ls_uso) then
					messagebox("Advertencia","Debe ingresar antes Uso")
				elseif isnull(ls_moneda) then
					messagebox("Advertencia","Debe ingresar antes Moneda")
				end if
				cb_3.triggerevent(clicked!)
			end if
		else
			if ll_count_reg=1 then
				messagebox("Advertencia","No es posible Modificar Valor, existe pago asociado en Pactación del Pie")
			elseif ll_count_reg>1 then
				messagebox("Advertencia","No es posible Modificar Valor, existen pagos asociados en Pactación del Pie")
			end if
			SELECT	SUM("DETALLE_PAGO_PIE"."MONTO_CUOTA")
			INTO 		:ldb_suma_cuota  
			FROM 		"DETALLE_PAGO_PIE"  
			WHERE  ( "DETALLE_PAGO_PIE"."BASE" = :gs_base ) AND  
					 ( "DETALLE_PAGO_PIE"."SERIE" = :gs_serie ) AND  
					 ( "DETALLE_PAGO_PIE"."NUMERO" = :gi_numero )   
			USING		sqlca;
			if ldb_suma_cuota>0 then
				dw_oferta_v.setitem(1,'pago_oferta_pie',ldb_suma_cuota)
				dw_oferta_v.accepttext()
			end if
		end if
	end if
end if
if ls_columna='uso' or ls_columna='pago_oferta_fecha_pie' or ls_columna='pago_oferta_fecha_prim' then
	ls_uso			= trim(dw_oferta_v.getitemstring(1,'uso'))
	ldt_fecha_pie	= dw_oferta_v.getitemdatetime(1,'pago_oferta_fecha_pie')
	ldt_fecha_prim	= dw_oferta_v.getitemdatetime(1,'pago_oferta_fecha_prim')
	if ls_uso='NF' then
		dw_oferta_v.setitem(1,'estatus_comision','1')
		if not isnull(ldt_fecha_pie) then
			ls_fecha			= f_fecha_vcto_prim( 7 ,  ldt_fecha_pie  )
			if not isnull(ls_fecha) and ls_fecha<>'//' and ls_fecha<>'' then
				dw_oferta_v.setitem(1,'pago_oferta_fecha_entre',date(ls_fecha))
			end if
		else
			ls_fecha			= f_fecha_vcto_prim( 7 ,  ldt_fecha_prim  )
			if not isnull(ls_fecha) and ls_fecha<>'//' and ls_fecha<>'' then
				dw_oferta_v.setitem(1,'pago_oferta_fecha_entre',date(ls_fecha))
			end if
		end if
		SELECT	"AGENTES"."CANAL" 
		INTO 		:ls_canal  
		FROM 	"AGENTES"  
		WHERE 	"AGENTES"."COD_AGE" = :ls_agente   
		USING		sqlca;
		
	elseif ls_uso='NI' then
		ls_agente	= trim(dw_agente.getitemstring(1,'agente'))
		SELECT	"AGENTES"."CANAL" 
		INTO 		:ls_canal  
		FROM 	"AGENTES"  
		WHERE 	"AGENTES"."COD_AGE" = :ls_agente   
		USING		sqlca;
		if ls_canal='ET' then
			dw_oferta_v.setitem(1,'estatus_comision','0')
		elseif ls_uso='NI' and ls_canal='NF' then
			dw_oferta_v.setitem(1,'estatus_comision','1')
		elseif ls_uso='NI' and ls_canal='NI' then
			dw_oferta_v.setitem(1,'estatus_comision','0')
		else
			dw_oferta_v.setitem(1,'estatus_comision','0')
		end if
		ldt_fecha			= dw_oferta_v.getitemdatetime(1,'fecha')
		dw_oferta_v.setitem(1,'pago_oferta_fecha_entre',ldt_fecha)
	end if
	//dw_oferta_v.setitem(1,'oferta_v_canal_venta',ls_canal)
	if trim(em_serie.Text)='R' then
		dw_oferta_v.setitem(1,'estatus_comision','0')
	end if
end if
dw_oferta_v.accepttext()
if ls_columna='pago_oferta_precio' then
	ldb_precio		= double(dw_oferta_v.getitemnumber(1,'pago_oferta_precio'))
	ldb_precio		= idb_precio - ldb_precio
	if ldb_precio<0 then
		messagebox("Advertencia","Valor Descuento Por es "+string(ldb_precio,"###,###,###,##0.0###")+ ' No puede Superar el Precio de Lista: '+string(idb_precio,"###,###,###,##0.0###"))
		dw_oferta_v.setitem(1,'oferta_v_descuento_por',0)
		dw_oferta_v.setfocus()
		dw_oferta_v.setcolumn('pago_oferta_precio')
	else
		dw_oferta_v.setitem(1,'oferta_v_descuento_por',ldb_precio)
	end if
end if
if ls_columna='pago_oferta_valor_cuota' or ls_columna='pago_oferta_pie' or ls_columna='pago_oferta_tasa_base' then
	ls_moneda					= this.getitemstring(1,'pago_oferta_moneda')
	lld_tasa						= double(dw_oferta_v.getitemnumber(1,'pago_oferta_tasa_base'))
	if lld_tasa > 100 then
		messagebox("Error","Valor Tasa Contrato Inválida")
		dw_oferta_v.setfocus()
		dw_oferta_v.setcolumn('pago_oferta_tasa_base')
	end if
	if ls_moneda='2' then //uf
		lld_valor_cuo			= double(dw_oferta_v.getitemnumber(1,'pago_oferta_valor_cuota'))
		lld_pie					= double(dw_oferta_v.getitemnumber(1,'pago_oferta_pie'))
		if lld_valor_cuo>=500 then
			messagebox("Advertencia","Recuerde los Valores deben ser ingresados en U.F. (Verificar Valor Cuota)")
			dw_oferta_v.setfocus()
			dw_oferta_v.setcolumn('pago_oferta_valor_cuota')
		elseif lld_pie>=500 then
			messagebox("Advertencia","Recuerde los Valores deben ser ingresados en U.F. (Verificar Pie)")
			dw_oferta_v.setfocus()
			dw_oferta_v.setcolumn('pago_oferta_pie')
		end if
	end if
end if
if ls_columna='pago_oferta_area' then
	ls_area						= dw_oferta_v.getitemstring(1,'pago_oferta_area')
	if not isnull(ls_area) and ls_area<>'' then
		dw_oferta_v.getchild('pago_oferta_sector',idw_detalle)
		idw_detalle.settransobject(sqlca)
		idw_detalle.retrieve(ls_area)
	end if
end if
if ls_columna='pago_oferta_capacidad' or ls_columna='pago_oferta_area' or ls_columna='pago_oferta_uf_dia' or ls_columna='pago_oferta_moneda' or ls_columna='tipo_sepult' or ls_columna='uso' or ls_columna='tipo_cons' or ls_columna='oferta_v_tipo_producto' then

	ls_tipo_contru				= dw_oferta_v.getitemstring(1,'tipo_cons')
	ls_tipo_sepultura			= dw_oferta_v.getitemstring(1,'tipo_sepult')
	if ls_columna='tipo_sepult' then
		if ls_tipo_sepultura = '1' then
			dw_oferta_v.setitem(1,'tipo_cons','T')
		end if
		if ls_tipo_sepultura = '2' or ls_tipo_sepultura = '3' or ls_tipo_sepultura = '4' or ls_tipo_sepultura = '5' or ls_tipo_sepultura = '8' then
			dw_oferta_v.setitem(1,'tipo_cons','C')
		end if	
	end if
	if ls_columna='tipo_cons' then
		if gs_base='O' then
			if ls_tipo_contru = 'T' then 
				dw_oferta_v.setitem(1,'tipo_sepult','1')
			else
				dw_oferta_v.setitem(1,'tipo_sepult','2')
			end if
		elseif gs_base='U' then
			dw_oferta_v.setitem(1,'tipo_sepult','8')
		end if
	end if
	ll_capacidad							= dw_oferta_v.getitemnumber(1,'pago_oferta_capacidad')
	ls_area								= dw_oferta_v.getitemstring(1,'pago_oferta_area')
	ldb_uf									= double(dw_oferta_v.getitemnumber(1,'pago_oferta_uf_dia'))
	ls_moneda							= dw_oferta_v.getitemstring(1,'pago_oferta_moneda')
	ls_tipo_sepultura					= dw_oferta_v.getitemstring(1,'tipo_sepult')
	
	ll_tipo_producto					= dw_oferta_v.getitemnumber(1,'oferta_v_tipo_producto')
	wf_tipo_producto_campo(ll_tipo_producto)
	
	
	ldt_fecha_ctto						= date(dw_oferta_v.getitemdatetime(1,'fecha'))
	ls_uso								= trim(dw_oferta_v.getitemstring(1,'uso'))
	ls_tipo_construc					= dw_oferta_v.getitemstring(1,'tipo_cons')
	ll_cod_parque						= dw_oferta_v.getitemnumber(1,'cadena_cod_parque')
	if not isnull(ll_capacidad) and ll_capacidad>0 and not isnull(ls_area) and not isnull(ldb_uf) and ldb_uf>0 and &
		not isnull(ls_moneda) and not isnull(ls_tipo_sepultura) and not isnull(ls_uso) then
		if isnull(dw_oferta_v.getitemnumber(1,'oferta_v_descuento_por')) or dw_oferta_v.getitemnumber(1,'oferta_v_descuento_por')=0 then
			ls_string						= f_valida_precio(ls_tipo_sepultura,ls_area,ll_capacidad,ls_uso,ls_moneda,ldb_uf,ls_tipo_construc,ll_cod_parque,ll_tipo_producto,ldt_fecha_ctto)
			if ls_moneda='2' then //UF
				ls_descrip_moneda	= 'U.F.'
				ldb_precio				= double(substr(1,1,ls_string))
				ldb_derecho				= double(substr(1,2,ls_string))
				ldb_cuota_mant		= double(substr(1,3,ls_string))
				ldb_liberador			= double(substr(1,4,ls_string))
			else // peso
				ls_descrip_moneda	= 'Pesos'
				ldb_precio				= double(long(substr(1,1,ls_string)))
				ldb_derecho				= double(long(substr(1,2,ls_string)))
				ldb_cuota_mant		= double(substr(1,3,ls_string))
				ldb_liberador			= double(long(substr(1,4,ls_string)))
			end if
			ldb_liberador				= 0
			if gs_serie='R' or ls_uso='NI' then
				ldb_derecho				= 0
			end if
			if gs_nueva_oferta='S' then
				idb_precio				= ldb_precio
				dw_oferta_v.setitem(1,'pago_oferta_precio',ldb_precio)
				dw_oferta_v.setitem(1,'pago_oferta_des_esp',ldb_derecho)
				dw_oferta_v.setitem(1,'valor_cuota_m',ldb_cuota_mant)
				dw_oferta_v.setitem(1,'pago_oferta_derecho_lib',ldb_liberador)
			else
				idb_precio			= ldb_precio
				ldb_precio_ori		= double(dw_oferta_v.getitemnumber(1,'pago_oferta_precio'))
				ldb_derecho_ori	= double(dw_oferta_v.getitemnumber(1,'pago_oferta_des_esp'))
				ldb_cuota_mant_ori= double(dw_oferta_v.getitemnumber(1,'valor_cuota_m'))
				ldb_liberador_ori	= double(dw_oferta_v.getitemnumber(1,'pago_oferta_derecho_lib'))
				if ldb_precio<>ldb_precio_ori and ldb_precio<>0 then //and ldb_precio_ori<>0
					ll_resp	= messagebox("Advertencia","Se ha detectado Variación en el Precio Original: "+string(ldb_precio_ori,"###,###,###,##0.0###")+" "+ls_descrip_moneda+" Precio Actualizado es: "+string(ldb_precio,"###,###,###,##0.0###")+" "+ls_descrip_moneda+", desea actualizarlo",Exclamation!, YesNo!, 2)
					if ll_resp=1 then
						dw_oferta_v.setitem(1,'pago_oferta_precio',ldb_precio)
					end if
				else
					dw_oferta_v.setitem(1,'pago_oferta_precio',ldb_precio)
				end if
				if trim(dw_oferta_v.getitemstring(1,'uso')) = 'NI' then 
					ldb_derecho		= 0
					dw_oferta_v.setitem(1,'pago_oferta_des_esp',ldb_derecho)
				else
					if ldb_derecho<>ldb_derecho_ori and ldb_derecho<>0 then // and ldb_derecho_ori<>0
						ll_resp	= messagebox("Advertencia","Se ha detectado Variación en el Derecho Especial Original: "+string(ldb_derecho_ori,"###,###,###,##0.0###")+" "+ls_descrip_moneda+" Derecho Especial Actualizado es: "+string(ldb_derecho,"###,###,###,##0.0###")+" "+ls_descrip_moneda+", desea actualizarlo",Exclamation!, YesNo!, 2)
						if ll_resp=1 then
							dw_oferta_v.setitem(1,'pago_oferta_des_esp',ldb_derecho)
						end if
					else
						dw_oferta_v.setitem(1,'pago_oferta_des_esp',ldb_derecho)
					end if
				end if
				if ldb_cuota_mant<>ldb_cuota_mant_ori and ldb_cuota_mant<>0 then //and ldb_cuota_mant_ori<>0
					ll_resp	= messagebox("Advertencia","Se ha detectado Variación en la Cuota Mantención Original: "+string(ldb_cuota_mant_ori,"###,###,###,##0.0###")+" "+ls_descrip_moneda+" Cuota Mantención Actualizada es: "+string(ldb_cuota_mant,"###,###,###,##0.0###")+" "+ls_descrip_moneda+", desea actualizarlo",Exclamation!, YesNo!, 2)
					if ll_resp=1 then
						dw_oferta_v.setitem(1,'valor_cuota_m',ldb_cuota_mant)
					end if
				else
					dw_oferta_v.setitem(1,'valor_cuota_m',ldb_cuota_mant)
				end if
				dw_oferta_v.setitem(1,'pago_oferta_derecho_lib',ldb_liberador)
			end if
		end if
	end if	
end if
if ls_columna='pago_oferta_valor_cuota'  then
	SELECT	Count("CADENA"."CODIGO")  
	INTO 		:il_modif  
	FROM 		"CADENA"  
	WHERE  ( "CADENA"."CODIGO" = :gs_base ) AND  
			 ( "CADENA"."SERIE" = :gs_serie ) AND  
			 ( "CADENA"."NUMERO" = :gi_numero )   
	USING		sqlca;
end if
if ls_columna='pago_oferta_nro_cuotas' then
	SELECT	Count("CADENA"."CODIGO")  
	INTO 		:il_modif_plazo  
	FROM 		"CADENA"  
	WHERE  ( "CADENA"."CODIGO" = :gs_base ) AND  
			 ( "CADENA"."SERIE" = :gs_serie ) AND  
			 ( "CADENA"."NUMERO" = :gi_numero )   
	USING		sqlca;
end if
if ls_columna='valor_cuota_m' then
	SELECT	Count("CADENA"."CODIGO")  
	INTO 		:il_modif_mant  
	FROM 		"CADENA"  
	WHERE  ( "CADENA"."CODIGO" = :gs_base ) AND  
			 ( "CADENA"."SERIE" = :gs_serie ) AND  
			 ( "CADENA"."NUMERO" = :gi_numero )   
	USING		sqlca;
end if
if ls_columna='fecha_m' then
	SELECT	Count("CADENA"."CODIGO")  
	INTO 		:il_modif_fec_mant  
	FROM 		"CADENA"  
	WHERE  ( "CADENA"."CODIGO" = :gs_base ) AND  
			 ( "CADENA"."SERIE" = :gs_serie ) AND  
			 ( "CADENA"."NUMERO" = :gi_numero )   
	USING		sqlca;
end if
if ls_columna='pago_oferta_fecha_prim' then
	SELECT	Count("CADENA"."CODIGO")  
	INTO 		:il_modif_fec  
	FROM 		"CADENA"  
	WHERE  ( "CADENA"."CODIGO" = :gs_base ) AND  
			 ( "CADENA"."SERIE" = :gs_serie ) AND  
			 ( "CADENA"."NUMERO" = :gi_numero )   
	USING		sqlca;
end if
if ls_columna='cadena_cod_parque' then
	gl_cod_parque		= dw_oferta_v.getitemnumber(1,'cadena_cod_parque')
	SELECT	Count("CADENA"."CODIGO")  
	INTO 		:il_modif_parque  
	FROM 		"CADENA"  
	WHERE  ( "CADENA"."CODIGO" = :gs_base ) AND  
			 ( "CADENA"."SERIE" = :gs_serie ) AND  
			 ( "CADENA"."NUMERO" = :gi_numero )   
	USING		sqlca;
	idw_detalle2.retrieve(gl_cod_parque)
	idw_detalle3.retrieve(gl_cod_parque)
end if
if ls_columna='pago_oferta_nro_cuotas' or ls_columna='fecha' or ls_columna='pago_oferta_fecha_prim' or &
	ls_columna='pago_oferta_moneda' then
	ll_nro_cuotas						= dw_oferta_v.getitemnumber(1,'pago_oferta_nro_cuotas')
	ldt_fecha								= dw_oferta_v.getitemdatetime(1,'fecha')
	ldt_fecha_prim						= dw_oferta_v.getitemdatetime(1,'pago_oferta_fecha_prim')
	ls_moneda							= dw_oferta_v.getitemstring(1,'pago_oferta_moneda')
	ldb_precio							= dw_oferta_v.getitemnumber(1,'pago_oferta_precio')
	lld_pie								= dw_oferta_v.getitemnumber(1,'pago_oferta_pie')
	lld_gasto_uf							= dw_oferta_v.getitemnumber(1,'pago_oferta_gastos_adm')
	if isnull(lld_pie) then lld_pie=0
	dw_oferta_v.accepttext()
	lld_saldo_finan					= double(dw_oferta_v.getitemnumber(1,'saldo_finan'))
	if not isnull(ll_nro_cuotas) and ll_nro_cuotas>0 and not isnull(ldt_fecha) and not isnull(ldt_fecha_prim) and &
		not isnull(ls_moneda) and not isnull(ldb_precio) and  not isnull(lld_gasto_uf) and &
		ldb_precio>0 and lld_gasto_uf>0 then
		if ldt_fecha_prim > ldt_fecha and ll_nro_cuotas > 0 then
			ll_dias						= DaysAfter(date(ldt_fecha),date(ldt_fecha_prim))
			if ll_nro_cuotas>=1 and ll_nro_cuotas<=11 then
				dw_oferta_v.setitem(1,'pago_oferta_valor_cuota',ldb_precio + lld_pie)
			else
				if ll_dias>=30 then
					SELECT	"FACTORES"."FACTOR",
								"FACTORES"."FACTOR_GASTO_ADM"
					INTO 		:lld_factor,
								:ldb_factor_gasto_cob
					FROM 		"FACTORES"  
					WHERE  ( "FACTORES"."BASE" = :gs_base ) AND  
							 ( :ll_nro_cuotas >= "FACTORES"."NRO_CUOTAS_INICIAL")  AND  
							 ( :ll_nro_cuotas <= "FACTORES"."NRO_CUOTAS_FINAL")  AND  
							 ((:ll_dias >= "FACTORES"."DIAS_INICIAL")  AND  
							 ( :ll_dias <= "FACTORES"."DIAS_FINAL" ))  AND
							 ( "FACTORES"."MONEDA" = :ls_moneda ) AND
							 ( "FACTORES"."FECHA_VIGENCIA" = :idt_fecha_vig )
					USING		sqlca;
					if lld_factor > 0 and lld_saldo_finan > 0 then
						ldt_fecha_ctto		= date(dw_oferta_v.getitemdatetime(1,'fecha'))
						if ldt_fecha_ctto >= date('01/10/2013') then
							ldb_factor_gasto_cob	= 0
						end if
						lld_saldo_finan	= lld_factor * lld_saldo_finan
						dw_oferta_v.setitem(1,'pago_oferta_valor_cuota',lld_saldo_finan)
						dw_oferta_v.setitem(1,'pago_oferta_gastos_adm',ll_nro_cuotas * ldb_factor_gasto_cob)
					else
						SELECT	"FACTORES"."FACTOR",
									"FACTORES"."FACTOR_GASTO_ADM"
						INTO 		:lld_factor,
									:ldb_factor_gasto_cob  
						FROM 		"FACTORES"  
						WHERE  ( "FACTORES"."BASE" = :gs_base ) AND  
								 ( :ll_nro_cuotas >= "FACTORES"."NRO_CUOTAS_INICIAL")  AND  
								 ( :ll_nro_cuotas <= "FACTORES"."NRO_CUOTAS_FINAL")  AND  
								 ( "FACTORES"."MONEDA" = :ls_moneda ) AND  
							 	 ( "FACTORES"."FECHA_VIGENCIA" = :idt_fecha_vig ) AND
								 ( "FACTORES"."DIAS_INICIAL" = ( SELECT	MIN("FACTORES"."DIAS_INICIAL") 
																	FROM 		"FACTORES" 
																	WHERE  ( "FACTORES"."BASE" = :gs_base ) AND 
												 							 ( "FACTORES"."FECHA_VIGENCIA" = :idt_fecha_vig ) AND
																			 ( :ll_nro_cuotas >= "FACTORES"."NRO_CUOTAS_INICIAL")  AND  
																			 ( :ll_nro_cuotas <= "FACTORES"."NRO_CUOTAS_FINAL")  AND  
																			 ( "FACTORES"."MONEDA" = :ls_moneda ) AND 
																			 ( "FACTORES"."FACTOR" <> 0 ) ) )   ;
						if lld_factor > 0 and lld_saldo_finan > 0 then
							ldt_fecha_ctto		= date(dw_oferta_v.getitemdatetime(1,'fecha'))
							if ldt_fecha_ctto >= date('01/10/2013') then
								ldb_factor_gasto_cob	= 0
							end if
							lld_saldo_finan	= lld_factor * lld_saldo_finan
							dw_oferta_v.setitem(1,'pago_oferta_valor_cuota',lld_saldo_finan)
							dw_oferta_v.setitem(1,'pago_oferta_gastos_adm',ll_nro_cuotas * ldb_factor_gasto_cob)
						end if
					end if
				else
					SELECT	"FACTORES"."FACTOR",
								"FACTORES"."FACTOR_GASTO_ADM"
					INTO 		:lld_factor,
								:ldb_factor_gasto_cob
					FROM 		"FACTORES"  
					WHERE  ( "FACTORES"."BASE" = :gs_base ) AND  
							 ( :ll_nro_cuotas >= "FACTORES"."NRO_CUOTAS_INICIAL")  AND  
							 ( :ll_nro_cuotas <= "FACTORES"."NRO_CUOTAS_FINAL")  AND  
							 ( "FACTORES"."MONEDA" = :ls_moneda ) AND  
							 ( "FACTORES"."FECHA_VIGENCIA" = :idt_fecha_vig ) AND
							 ( "FACTORES"."DIAS_INICIAL" = ( SELECT	MIN("FACTORES"."DIAS_INICIAL") 
																FROM 		"FACTORES" 
																WHERE  ( "FACTORES"."BASE" = :gs_base ) AND 
																		 ( :ll_nro_cuotas >= "FACTORES"."NRO_CUOTAS_INICIAL")  AND  
																		 ( :ll_nro_cuotas <= "FACTORES"."NRO_CUOTAS_FINAL")  AND  
																		 ( "FACTORES"."MONEDA" = :ls_moneda ) AND 
							 											 ( "FACTORES"."FECHA_VIGENCIA" = :idt_fecha_vig ) AND
																		 ( "FACTORES"."FACTOR" <> 0 ) ) )   
					USING		sqlca;
					if lld_factor > 0 and lld_saldo_finan > 0 then
						ldt_fecha_ctto		= date(dw_oferta_v.getitemdatetime(1,'fecha'))
						if ldt_fecha_ctto >= date('01/10/2013') then
							ldb_factor_gasto_cob	= 0
						end if
						lld_saldo_finan	= lld_factor * lld_saldo_finan
						dw_oferta_v.setitem(1,'pago_oferta_valor_cuota',lld_saldo_finan)
						dw_oferta_v.setitem(1,'pago_oferta_gastos_adm',ll_nro_cuotas * ldb_factor_gasto_cob)
					end if
				end if
			end if
		end if
	end if
end if
if ls_columna='oferta_v_promocion' then
	ll_promocion						= dw_oferta_v.getitemnumber(1,'oferta_v_promocion')
	ll_tipo_dscto							= dw_oferta_v.getitemnumber(1,'oferta_v_tipo_descuento')
	if ll_promocion=0 or isnull(ll_promocion) then
		if isnull(ll_tipo_dscto) or ll_tipo_dscto=0 then
			dw_oferta_v.setitem(1,'oferta_v_tipo_descuento',0)
		end if
	end if
end if
if ls_columna='oferta_v_beneficio_complementario' then
	ll_promocion						= dw_oferta_v.getitemnumber(1,'oferta_v_beneficio_complementario')
	if ll_promocion > 0 then
		pb_promociones.enabled		= true
	else
		pb_promociones.enabled		= false
	end if
	if ll_promocion <> 6 then
		setnull(ll_tipo_conv)
		dw_oferta_v.setitem(1,'oferta_v_cod_convenio',ll_tipo_conv)
	end if	
end if
if ls_columna='oferta_v_tipo_descuento' then
	ll_tipo_dscto							= dw_oferta_v.getitemnumber(1,'oferta_v_tipo_descuento')
	if isnull(ll_tipo_dscto) or ll_tipo_dscto=0 then dw_oferta_v.setitem(1,'oferta_v_tipo_descuento',0)
//	dw_oferta_v.setitem(1,'oferta_v_anexo_dacion','')
//	dw_oferta_v.setitem(1,'oferta_v_descuento_por',0)
end if
//if ls_columna='oferta_v_anexo_dacion' then
//	ls_anexo_dacion					= trim(dw_oferta_v.getitemstring(1,'oferta_v_anexo_dacion'))
//	ls_ctto_text							= gs_base+gs_serie+string(gi_numero)
//	if ls_anexo_dacion=ls_ctto_text then
//		messagebox("Advertencia","No es Posible Asociar la misma Promesa")
//		dw_oferta_v.setitem(1,'oferta_v_anexo_dacion','')
//		dw_oferta_v.accepttext()
//		dw_oferta_v.setfocus()
//		dw_oferta_v.setcolumn('oferta_v_anexo_dacion')
//	else
//		if mid(ls_anexo_dacion,1,1)='O' or mid(ls_anexo_dacion,1,1)='C' or mid(ls_anexo_dacion,1,1)='P' or mid(ls_anexo_dacion,1,1)='G' then
//			ls_base_dac					= mid(ls_anexo_dacion,1,1)
//			ls_serie_dac					= mid(ls_anexo_dacion,2,1)
//			ll_numero_dac				= Double(mid(ls_anexo_dacion,3))
//			SELECT	Count("SOL_ESTATUS"."BASE")  
//			INTO 		:ll_count_reg  
//			FROM 		"SOL_ESTATUS"  
//			WHERE  (("SOL_ESTATUS"."BASE" = :ls_base_dac AND  
//						"SOL_ESTATUS"."SERIE" = :ls_serie_dac AND  
//						"SOL_ESTATUS"."NUMERO" = :ll_numero_dac AND  
//						"SOL_ESTATUS"."CODIGO_SOLICITUD" = '2') OR  
//					 ( "SOL_ESTATUS"."BASE" = :ls_base_dac AND  
//						"SOL_ESTATUS"."SERIE" = :ls_serie_dac AND  
//						"SOL_ESTATUS"."NUMERO" = :ll_numero_dac AND  
//						"SOL_ESTATUS"."CODIGO_SOLICITUD" = '13'))   
//			USING		sqlca;
//			if ll_count_reg=0 or isnull(ll_count_reg) then
//				messagebox("Advertencia","Contrato Original debe Tener Asociada Solicitud de 2-Resciliación por Reprogramación o 13-Dación en Pago")
//				dw_oferta_v.setitem(1,'oferta_v_anexo_dacion','')
//				dw_oferta_v.accepttext()
//			end if
//		else
//			messagebox("Advertencia","Solo puede Ingresar C-Contrato, P-Pagaré o O-Promesas")
//			dw_oferta_v.setitem(1,'oferta_v_anexo_dacion','')
//			dw_oferta_v.accepttext()
//		end if
//	end if
//end if
if ls_columna='pago_oferta_moneda' then
	ls_moneda							= dw_oferta_v.getitemstring(1,'pago_oferta_moneda')
	lld_valor_cuo						= double(dw_oferta_v.getitemnumber(1,'pago_oferta_valor_cuota'))
	lld_pie								= double(dw_oferta_v.getitemnumber(1,'pago_oferta_pie'))
	lld_descuento_por					= double(dw_oferta_v.getitemnumber(1,'oferta_v_descuento_por'))
	ldb_precio							= double(dw_oferta_v.getitemnumber(1,'pago_oferta_precio'))
	ldb_gastos_adm						= double(dw_oferta_v.getitemnumber(1,'pago_oferta_gastos_adm'))
	if isnull(lld_pie) then lld_pie=0
	if gd_uf_dia>0 then
		if ls_moneda='1' then //peso
			if lld_valor_cuo<500 then
				dw_oferta_v.setitem(1,'pago_oferta_valor_cuota',long(round((lld_valor_cuo * gd_uf_dia),2)))
			end if
			if ldb_gastos_adm<500 then
				dw_oferta_v.setitem(1,'pago_oferta_gastos_adm',long(round((ldb_gastos_adm * gd_uf_dia),2)))
			end if
			if ldb_precio<500 then
				dw_oferta_v.setitem(1,'pago_oferta_precio',long(round((ldb_precio * gd_uf_dia),2)))
			end if
			if lld_pie<500 then
				dw_oferta_v.setitem(1,'pago_oferta_pie',long(round((lld_pie * gd_uf_dia),2)))
			end if
			if lld_descuento_por<500 then
				dw_oferta_v.setitem(1,'oferta_v_descuento_por',long(round((lld_descuento_por * gd_uf_dia),2)))
			end if
		elseif ls_moneda='2' then //uf
			if lld_valor_cuo>=500 then
				dw_oferta_v.setitem(1,'pago_oferta_valor_cuota',(lld_valor_cuo / gd_uf_dia))
			end if
			if ldb_gastos_adm>=500 then
				dw_oferta_v.setitem(1,'pago_oferta_gastos_adm',(ldb_gastos_adm / gd_uf_dia))
			end if
			if ldb_precio>=500 then
				dw_oferta_v.setitem(1,'pago_oferta_precio',(ldb_precio / gd_uf_dia))
			end if
			if lld_pie>=500 then
				dw_oferta_v.setitem(1,'pago_oferta_pie',(lld_pie / gd_uf_dia))
			end if
			if lld_descuento_por>=500 then
				dw_oferta_v.setitem(1,'oferta_v_descuento_por',(lld_descuento_por / gd_uf_dia))
			end if
		end if
		dw_oferta_v.accepttext()
	end if
END IF
dw_oferta_v.accepttext()
end event

event doubleclicked;string	ls_columna,ls_string,ls_moneda,ls_uso
Long		ll_codigo,ll_tipo_seguro,ll_cantidad,ll_dia_hoy,ll_dia_nac,ll_mes_hoy,&
			ll_mes_nac,ll_ano_hoy,ll_ano_nac,ll_edad
Double	lld_factor,lld_factor_seg_comp,lld_pie
Date		ld_fecha,ld_fecha_tope

dw_oferta_v.accepttext()
ls_columna			= dwo.name //dw_oferta_v.GetColumnName()
if ls_columna='oferta_v_promocion' or ls_columna='t_34' then
	ll_codigo			= dw_oferta_v.getitemnumber(1,'oferta_v_promocion')
	if not isnull(ll_codigo) and ll_codigo<>0 then OpenWithParm(w_lista_detalle_promocion, string(ll_codigo))
elseif ls_columna='t_17' then
	dw_oferta_v.accepttext()
	lld_pie			= double(dw_oferta_v.getitemnumber(1,'pago_oferta_pie'))
	ls_moneda		= dw_oferta_v.getitemstring(1,'pago_oferta_moneda')
	if lld_pie>0 then
		ls_uso		= trim(dw_oferta_v.getitemstring(1,'uso'))
		ls_string		= gs_base+'~t'+gs_serie+'~t'+string(gi_numero)+'~t'+string(lld_pie)+'~t'+ls_uso+'~t'+'C'+'~t'+ls_moneda
		if not isnull(ls_uso) and ls_uso<>'' and not isnull(ls_moneda) then
			openwithparm(w_ingreso_pie_pactado,ls_string)
		else
			if isnull(ls_uso) then
				messagebox("Advertencia","Debe ingresar antes Uso")
			elseif isnull(ls_moneda) then
				messagebox("Advertencia","Debe ingresar antes Moneda")
			end if
			cb_3.triggerevent(clicked!)
		end if
	end if
	
elseif ls_columna='t_seguro' then	
	ll_tipo_seguro	= dw_oferta_v.getitemnumber(1,'pago_oferta_codigo_tipo_seguro')
	if ll_tipo_seguro>0 then
		SELECT	"TIPO_SEGURO"."CANTIDAD_BENEFICIARIO",   
					"TIPO_SEGURO"."UF_SEGURO"  
		INTO 		:ll_cantidad,   
					:lld_factor  
		FROM 	"TIPO_SEGURO"  
		WHERE 	"TIPO_SEGURO"."CODIGO" = :ll_tipo_seguro   
		USING	sqlca;
		ls_string	= gs_base+'~t'+gs_serie+'~t'+string(gi_numero)+'~t'+string(ll_cantidad)+'~t'+string(lld_factor)+'~t'+string(ll_tipo_seguro)
		openwithparm(w_ingreso_beneficiario_seg_comple,ls_string)
	else
		messagebox("Advertencia","Debe seleccionar Tipo de Seguro Complementario antes de Ingresar Beneficiarios")
		dw_oferta_v.setfocus()
		dw_oferta_v.setcolumn('pago_oferta_codigo_tipo_seguro')
	end if
	
elseif ls_columna='pago_oferta_codigo_tipo_seguro' then
	ll_tipo_seguro	= dw_oferta_v.getitemnumber(1,'pago_oferta_codigo_tipo_seguro')
	if ll_tipo_seguro>0 then
		SELECT	"TIPO_SEGURO"."CANTIDAD_BENEFICIARIO",   
					"TIPO_SEGURO"."FACTOR"  
		INTO 		:ll_cantidad,   
					:lld_factor_seg_comp  
		FROM 		"TIPO_SEGURO"  
		WHERE 	"TIPO_SEGURO"."CODIGO" = :ll_tipo_seguro   
		USING		sqlca;
		ls_string	= gs_base+'~t'+gs_serie+'~t'+string(gi_numero)+'~t'+string(ll_cantidad)+'~t'+string(lld_factor_seg_comp)+'~t'+string(ll_tipo_seguro)
		if ll_tipo_seguro=2 then
			ld_fecha					= date(dw_clientes.getitemdatetime(1,'fecha_nac'))
			ld_fecha_tope			= date(dw_oferta_v.getitemdatetime(1,'fecha'))
			if not isnull(ld_fecha) then
				ll_dia_hoy			= day(ld_fecha_tope)
				ll_dia_nac			= day(ld_fecha)
				ll_mes_hoy			= month(ld_fecha_tope)
				ll_mes_nac			= month(ld_fecha)
				ll_ano_hoy			= year(ld_fecha_tope)
				ll_ano_nac			= year(ld_fecha)
				ll_edad				= ll_ano_hoy - ll_ano_nac
				if ll_mes_hoy > ll_mes_nac then
					ll_edad ++
				elseif ll_mes_hoy = ll_mes_nac then
					if ll_dia_hoy >= ll_dia_nac then
						ll_edad ++
					end if
				end if
				if ll_edad<=65 then
					openwithparm(w_ingreso_seguro_complementario,ls_string)
				else
					messagebox("Advertencia","Recuerde No es posible Ingresar Beneficiarios, Titular debe tener Menos de 65 Años")
				end if
			else
				messagebox("Advertencia","Debe Ingresar Cliente, recuerde ingresar correctamente Fecha de Nacimiento")
			end if
		else
			openwithparm(w_ingreso_seguro_complementario,ls_string)
		end if
	end if
end if
end event

event itemfocuschanged;string		ls_columna,ls_string_find
Double	ldb_suma_cuota,ldb_valor_pie
Long		ll_count_reg,ll_tipo_seguro,ll_reg,ll_nulo
Datetime	ldt_fecha_duracion_vigencia

dw_oferta_v.accepttext()
Setnull(ll_nulo)
ls_columna			= GetColumnName() //dwo.name//
if ls_columna='pago_oferta_fecha_pie' then
	ldb_valor_pie	= dw_oferta_v.getitemnumber(1,'pago_oferta_pie')
	if ldb_valor_pie>=0 then 
//		cb_3.triggerevent(clicked!)
		SELECT	Count("DETALLE_PAGO_PIE"."ESTADO")  
		INTO 		:ll_count_reg  
		FROM 	"DETALLE_PAGO_PIE"  
		WHERE  ( "DETALLE_PAGO_PIE"."BASE" = :gs_base ) AND  
				 ( "DETALLE_PAGO_PIE"."SERIE" = :gs_serie ) AND  
				 ( "DETALLE_PAGO_PIE"."NUMERO" = :gi_numero ) AND  
				 ( "DETALLE_PAGO_PIE"."ESTADO" = 'C' )   
		USING		sqlca;
		if ll_count_reg>0 then
			SELECT	SUM("DETALLE_PAGO_PIE"."MONTO_CUOTA")
			INTO 		:ldb_suma_cuota  
			FROM 	"DETALLE_PAGO_PIE"  
			WHERE  ( "DETALLE_PAGO_PIE"."BASE" = :gs_base ) AND  
					 ( "DETALLE_PAGO_PIE"."SERIE" = :gs_serie ) AND  
					 ( "DETALLE_PAGO_PIE"."NUMERO" = :gi_numero )   
			USING		sqlca;
			if ldb_suma_cuota>0 then
				if ldb_valor_pie <>ldb_suma_cuota then
					dw_oferta_v.setitem(1,'pago_oferta_pie',ldb_suma_cuota)
					dw_oferta_v.accepttext()
				end if
			end if
		end if
	end if
elseif ls_columna='cadena_cod_parque' then
	ll_tipo_seguro	= dw_oferta_v.getitemnumber(1,'pago_oferta_codigo_tipo_seguro')
	SELECT	"TIPO_SEGURO"."FECHA_DURACION_VIGENCIA"
	INTO 		:ldt_fecha_duracion_vigencia
	FROM 		"TIPO_SEGURO"  
	WHERE 	"TIPO_SEGURO"."CODIGO" = :ll_tipo_seguro   
	USING		sqlca;
	if ldt_fecha_duracion_vigencia <= gdt_fec_sistema then
		dw_oferta_v.setitem(1,'pago_oferta_codigo_tipo_seguro',0)
		dw_oferta_v.accepttext()
	end if
end if
