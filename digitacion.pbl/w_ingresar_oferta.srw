event open;String		ls_serie,ls_opcion_dig,ls_serie_doc_pend,ls_pasa='S'
Long		ll_tot_reg,ll_indi
double	ll_numero_doc_pend

Setnull(gs_serie);setnull(gi_numero);setnull(gs_base);setnull(gs_age);setnull(gs_sup);setnull(gs_jefe)
gs_base							= Message.StringParm
if gs_base='O' then
	st_3.text						= 'Ingreso Promesa'
elseif gs_base='U' then
	st_3.text						= 'Ingreso Columbario'
end if
SELECT	"ENCARGADOS"."DIGITACION"
INTO 		:ls_opcion_dig
FROM 	"ENCARGADOS"  
WHERE 	"ENCARGADOS"."CODIGO_USUARIO" = :gs_user   
USING	sqlca;
if sqlca.sqlcode=0 then
	if ls_opcion_dig='1' or ls_opcion_dig='3' then 
		cb_aceptar.enabled	= true
		st_pagare.enabled		= true
	elseif ls_opcion_dig='2' then
		cb_aceptar.enabled	= false
		st_pagare.enabled		= false
	else
		cb_aceptar.enabled	= false
		st_pagare.enabled		= false
		ls_pasa					= 'N'
	end if
//	if ls_pasa = 'S' then
		gf_centrar(w_ingresar_oferta)
		dw_oferta_v.SetTransObject(SQLCA)
		dw_seguro.SetTransObject(SQLCA)
		dw_oferta_v.getchild('pago_oferta_sector',idw_detalle)
		idw_detalle.settransobject(sqlca)
		if idw_detalle.rowcount()=0 then
			idw_detalle.insertrow(0)
		end if
		if isvalid(w_consultar_documentos_pendientes) then 
			ls_serie_doc_pend			= gs_serie
			ll_numero_doc_pend		= gi_numero
		end if	
		dw_oferta_v.getchild('oferta_v_beneficio_complementario',idw_detalle2)
		idw_detalle2.settransobject(sqlca)
		if idw_detalle2.rowcount()=0 then
			idw_detalle2.insertrow(0)
		end if
		
		dw_oferta_v.getchild('pago_oferta_area',idw_detalle3)
		idw_detalle3.settransobject(sqlca)
		if idw_detalle3.rowcount()=0 then
			idw_detalle3.insertrow(0)
		end if
		
		dw_oferta_v.getchild('pago_oferta_codigo_tipo_seguro',idw_detalle4)
		idw_detalle4.settransobject(sqlca)
//		idw_detalle4.retrieve(1,gs_base)
		idw_detalle4.retrieve(1,gs_base)
		if idw_detalle4.rowcount()=0 then
			idw_detalle4.insertrow(0)
		end if
		
		SELECT MAX("FACTORES"."FECHA_VIGENCIA")
		INTO 	:idt_fecha_vig  
		FROM 	"FACTORES"  
		WHERE "FACTORES"."ESTADO_VIGENCIA" = 'V' AND
				"FACTORES"."BASE" = :gs_base
		USING	sqlca;
		dw_clientes.SetTransObject(SQLCA)
		dw_1.settransobject (sqlca)
		dw_agente.settransobject(sqlca)
		dw_supervisor.settransobject(sqlca)
		dw_jefe.settransobject(sqlca)
		dw_agente.insertrow(0)
		dw_supervisor.insertrow(0)
		dw_jefe.insertrow(0)
		if gs_conexion = "Parque El Prado" then
			ll_tot_reg	= dw_seguro.retrieve(1,gs_base)
		elseif gs_conexion = "Parque La Foresta" then
			ll_tot_reg	= dw_seguro.retrieve(11,gs_base)
		end if
		if ll_tot_reg > 0 then
			for ll_indi=1 to ll_tot_reg
				dw_seguro.setitem(ll_indi,'c_estado_reg',1)
			next
			dw_seguro.accepttext()
		end if
		dw_seguro.enabled			= false
		
//		gs_base							= 'O'
		DECLARE	x1 CURSOR FOR  
		SELECT 	"TABLA_SERIES"."SERIE"  
		FROM 	"TABLA_SERIES"  
		WHERE 	"TABLA_SERIES"."BASE" = :gs_base   
		USING		sqlca;
		open x1;
		if sqlca.sqlcode=0 then
			DO WHILE sqlca.sqlcode=0 
				fetch x1 into :ls_serie;
				if not isnull(ls_serie) then
					em_serie.AddItem(trim(ls_serie)) //if not isnull(ls_serie)	then 
				end if
				setnull(ls_serie)
			LOOP
		end if
		close x1;
		il_count_modi					= 0
		dw_oferta_v.enabled			= false
		em_rut.enabled				= false
		em_dv.enabled					= false
		dw_agente.enabled			= false
		dw_supervisor.enabled		= false
		dw_jefe.enabled				= false
		pb_promociones.enabled		= false
		id_fecha_dia					= date(gdt_fec_sistema)
		cb_aceptar.text 				= 'Ingresar'
		gs_nueva_oferta				= 'N'
		if gs_empresa = 'El Prado' then
			em_serie.text				= 'I'
		elseif gs_empresa = 'La Foresta' then
			em_serie.text				= 'S'
		elseif gs_empresa = 'Santiago' then
			em_serie.text				= 'T'
		end if
		SELECT 	"TAB_UF"."VALOR_UF"  
		INTO 		:gd_uf_dia  
		FROM 	"TAB_UF"  
		WHERE 	"TAB_UF"."FECHA_UF" = :id_fecha_dia;
		IF gd_uf_dia = 0 or isnull(gd_uf_dia) THEN 
			messagebox("Advertencia","No se Registra U.F. del día "+string(id_fecha_dia))
			Open(w_mantenedor_uf)
		end if
		SELECT 	"TAB_UF"."VALOR_UF"  
		INTO 		:gd_uf_dia
		FROM 		"TAB_UF"  
		WHERE 	"TAB_UF"."FECHA_UF" = :id_fecha_dia
		using		sqlca;
		if sqlca.sqlcode<>0 then
			close(w_ingresar_oferta)
		else
			dw_clientes.insertrow(0)
			dw_oferta_v.reset()
			dw_oferta_v.InsertRow(0)
			dw_oferta_v.SetItem(1, 'fecha',id_fecha_dia)
			dw_oferta_v.SetItem(1, "pago_oferta_uf_dia", gd_uf_dia)
		end if
		if isvalid(w_consultar_documentos_pendientes) then 
			em_serie.text			= ls_serie_doc_pend
			em_numero.text		= string(ll_numero_doc_pend)
			em_numero.triggerEvent(modified!)
		end if	
//	else
//		messagebox("Advertencia","No tiene Acceso a Digitación")
//		close(w_ingresar_oferta)
//	end if
else
	messagebox("Advertencia","No tiene Acceso a Digitación")
	close(w_ingresar_oferta)
end if
end event

