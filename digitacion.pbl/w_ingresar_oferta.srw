public subroutine wf_setear_oferta ();String		ls_moneda,ls_forma_pago
Long		ll_tot_reg,ll_count_seg,ll_indi,ll_est_reg,ll_codigo,ll_count
Double	ldb_monto

ls_forma_pago		= dw_oferta_v.getitemstring(1,'forma_pago')
ls_moneda			= dw_oferta_v.getitemstring(1,'pago_oferta_moneda')
if isnull(ls_moneda) then ls_moneda='2'
if isnull(ls_forma_pago) then ls_forma_pago='2'
SELECT		Count("SEGURO_ASOCIADOS"."COD_SEGURO")
INTO 			:ll_count_seg  
FROM 		"SEGURO_ASOCIADOS"  
WHERE 	  ( "SEGURO_ASOCIADOS"."BASE" = :gs_base ) AND  
			  ( "SEGURO_ASOCIADOS"."SERIE" = :gs_serie ) AND  
			  ( "SEGURO_ASOCIADOS"."NUMERO" = :gi_numero )   ;
if ll_count_seg > 0 then
	UPDATE		"SEGURO_ASOCIADOS"  
	SET 			"ESTADO_SEGURO" = 'I',
					"ESTADO_REG" = 1
	WHERE 	  ( "SEGURO_ASOCIADOS"."BASE" = :gs_base ) AND  
				  ( "SEGURO_ASOCIADOS"."SERIE" = :gs_serie ) AND  
				  ( "SEGURO_ASOCIADOS"."NUMERO" = :gi_numero )   
	USING		sqlca;
	if sqlca.sqlcode=0 then
		commit;
		ll_tot_reg		= dw_seguro.rowcount()
		for ll_indi=1 to ll_tot_reg
			ll_est_reg	= dw_seguro.getitemnumber(ll_indi,'c_estado_reg')
			ll_codigo		= dw_seguro.getitemnumber(ll_indi,'codigo')
			if ls_moneda='1' then
				SELECT	"TIPO_SEGURO"."FACTOR_PESO"  
				INTO 		:ldb_monto  
				FROM 	"TIPO_SEGURO"  
				WHERE 	"TIPO_SEGURO"."CODIGO" = :ll_codigo 
				USING	sqlca;
			elseif ls_moneda='2' then
				SELECT	"TIPO_SEGURO"."FACTOR_PRIMA"  
				INTO 		:ldb_monto  
				FROM 	"TIPO_SEGURO"  
				WHERE 	"TIPO_SEGURO"."CODIGO" = :ll_codigo 
				USING	sqlca;
			end if
			if ll_est_reg = 0 then
				SELECT		Count("SEGURO_ASOCIADOS"."BASE")
				INTO 			:ll_count  
				FROM 		"SEGURO_ASOCIADOS"  
				WHERE 	  ( "SEGURO_ASOCIADOS"."BASE" = :gs_base ) AND  
							  ( "SEGURO_ASOCIADOS"."SERIE" = :gs_serie ) AND  
							  ( "SEGURO_ASOCIADOS"."NUMERO" = :gi_numero ) AND  
							  ( "SEGURO_ASOCIADOS"."COD_SEGURO" = :ll_codigo )  
				USING		sqlca;
				if ll_count > 0 then
					if isnull(ldb_monto) then ldb_monto=0

					UPDATE		"SEGURO_ASOCIADOS"  
					SET 			"ESTADO_SEGURO" = 'A',
									"ESTADO_REG" = 0,
									"MONTO_PRIMA" = :ldb_monto,
									"MONEDA" = :ls_moneda
					WHERE 	  ( "SEGURO_ASOCIADOS"."BASE" = :gs_base ) AND  
								  ( "SEGURO_ASOCIADOS"."SERIE" = :gs_serie ) AND  
								  ( "SEGURO_ASOCIADOS"."NUMERO" = :gi_numero ) AND  
								  ( "SEGURO_ASOCIADOS"."COD_SEGURO" = :ll_codigo ) 
					USING		sqlca;
					if sqlca.sqlcode=0 then
						commit;
					elseif sqlca.sqlcode=100 then
						INSERT INTO "SEGURO_ASOCIADOS"  
										( "BASE",		"SERIE",   	"NUMERO",   	"COD_SEGURO",   		"FECHA_CREA",   	"MONTO_PRIMA",   	"USUARIO",   	"ESTADO_REG",   	"FOLIO_SEGURO",   	"ESTADO_SEGURO",		"MONEDA",		"FORMA_PAGO" )  
						VALUES 		( :gs_base, 	:gs_serie,   :gi_numero,   	:ll_codigo,   				:gdt_fec_sistema,  :ldb_monto,   			:gs_user,   		0,   					0,   						'A',							:ls_moneda,		:ls_forma_pago)  
						USING		sqlca;
						if sqlca.sqlcode=0 then
							commit;
						else
							rollback;
							messagebox("Error Grabar","Error INSERT SEGURO_ASOCIADOS SQL "+sqlca.sqlerrtext)
						end if
					else
						rollback;
						messagebox("Error Grabar","Error UPDATE SEGURO_ASOCIADOS SQL "+sqlca.sqlerrtext)
					end if
				else
					INSERT INTO "SEGURO_ASOCIADOS"  
									( "BASE",		"SERIE",   	"NUMERO",   	"COD_SEGURO",   		"FECHA_CREA",   	"MONTO_PRIMA",   	"USUARIO",   	"ESTADO_REG",   	"FOLIO_SEGURO",   	"ESTADO_SEGURO",	"MONEDA",		"FORMA_PAGO" )  
					VALUES 		( :gs_base, 	:gs_serie,   :gi_numero,   	:ll_codigo,   				:gdt_fec_sistema,  :ldb_monto,   			:gs_user,   		0,   					0,   						'A',						:ls_moneda,		:ls_forma_pago )  
					USING		sqlca;
					if sqlca.sqlcode=0 then
						commit;
					else
						rollback;
						messagebox("Error Grabar","Error INSERT SEGURO_ASOCIADOS SQL "+sqlca.sqlerrtext)
					end if
				end if

			end if
		next
	else
		rollback;
		ll_tot_reg		= dw_seguro.rowcount()
		for ll_indi=1 to ll_tot_reg
			ll_est_reg	= dw_seguro.getitemnumber(ll_indi,'c_estado_reg')
			ll_codigo		= dw_seguro.getitemnumber(ll_indi,'codigo')
			if ls_moneda='1' then
				SELECT	"TIPO_SEGURO"."FACTOR_PESO"  
				INTO 		:ldb_monto  
				FROM 	"TIPO_SEGURO"  
				WHERE 	"TIPO_SEGURO"."CODIGO" = :ll_codigo 
				USING	sqlca;
//												ldb_monto	= dw_seguro.getitemnumber(ll_indi,'factor_prima')
			elseif ls_moneda='2' then
				SELECT	"TIPO_SEGURO"."FACTOR_PRIMA"  
				INTO 		:ldb_monto  
				FROM 	"TIPO_SEGURO"  
				WHERE 	"TIPO_SEGURO"."CODIGO" = :ll_codigo 
				USING	sqlca;
//												ldb_monto	= dw_seguro.getitemnumber(ll_indi,'factor_peso')
			end if
			if ll_est_reg = 0 then
				INSERT INTO "SEGURO_ASOCIADOS"  
							( "BASE",		"SERIE",   	"NUMERO",   	"COD_SEGURO",   		"FECHA_CREA",   	"MONTO_PRIMA",   	"USUARIO",   	"ESTADO_REG",   	"FOLIO_SEGURO",   	"ESTADO_SEGURO",	"MONEDA",		"FORMA_PAGO" )  
				VALUES 	( :gs_base, 	:gs_serie,   :gi_numero,   	:ll_codigo,   				:gdt_fec_sistema,  :ldb_monto,   			:gs_user,   		0,   					0,   						'A',						:ls_moneda,		:ls_forma_pago )  
				USING		sqlca;
				if sqlca.sqlcode=0 then
					commit;
				else
					rollback;
					messagebox("Error Grabar","Error INSERT SEGURO_ASOCIADOS SQL "+sqlca.sqlerrtext)
				end if
			end if
		next
	end if
else
	ll_tot_reg		= dw_seguro.rowcount()
	for ll_indi=1 to ll_tot_reg
		ll_est_reg	= dw_seguro.getitemnumber(ll_indi,'c_estado_reg')
		ll_codigo		= dw_seguro.getitemnumber(ll_indi,'codigo')
		if ls_moneda='1' then
			SELECT	"TIPO_SEGURO"."FACTOR_PESO"  
			INTO 		:ldb_monto  
			FROM 	"TIPO_SEGURO"  
			WHERE 	"TIPO_SEGURO"."CODIGO" = :ll_codigo 
			USING	sqlca;
		elseif ls_moneda='2' then
			SELECT	"TIPO_SEGURO"."FACTOR_PRIMA"  
			INTO 		:ldb_monto  
			FROM 	"TIPO_SEGURO"  
			WHERE 	"TIPO_SEGURO"."CODIGO" = :ll_codigo 
			USING	sqlca;
		end if
		if ll_est_reg = 0 then
			INSERT INTO "SEGURO_ASOCIADOS"  
						( "BASE",		"SERIE",   	"NUMERO",   	"COD_SEGURO",   		"FECHA_CREA",   	"MONTO_PRIMA",   	"USUARIO",   	"ESTADO_REG",   	"FOLIO_SEGURO",   	"ESTADO_SEGURO",	"MONEDA",		"FORMA_PAGO" )  
			VALUES 	( :gs_base, 	:gs_serie,   :gi_numero,   	:ll_codigo,   				:gdt_fec_sistema,  :ldb_monto,   			:gs_user,   		0,   					0,   						'A',						:ls_moneda,		:ls_forma_pago )  
			USING		sqlca;
			if sqlca.sqlcode=0 then
				commit;
			else
				rollback;
				messagebox("Error Grabar","Error INSERT SEGURO_ASOCIADOS SQL "+sqlca.sqlerrtext)
			end if
		end if
	next
end if
end subroutine

public subroutine wf_log_promesa ();String	ls_serie,ls_area,ls_sector,ls_sepultura,ls_tipo_sepult,ls_moneda,&
			ls_tipo_cons,ls_n_reduccion,ls_uso,ls_forma_pago,ls_tipo_mant,ls_tipo_venta,&
			ls_lugar_v,ls_cod_jef,ls_cod_sup,ls_cod_age,ls_anexo_dacion
Long		ll_nro_oferta,ll_rut,ll_nro_cuotas,ll_capacidad,ll_des_esp,ll_derecho_lib,&
			ll_rut_institucional,ll_rut_aval,ll_rut_funeraria,ll_cod_parque,&
			ll_descuento_por,ll_tipo_descuento,ll_promocion,ll_cod_benef_comp,ll_score,ll_tipo_clas_renta
Double	ll_saldo_financiero,ll_precio,ll_gastos_adm,ll_plazo,ll_tasa,&
			ll_uf_dia,ll_valor_cuota,ll_pie,ll_valor_cuota_m,ll_tasa_base
Datetime	ldt_fecha,ldt_fecha_prim,ldt_fecha_pie,ldt_fecha_hoy,ldt_fecha_ult,&
			ldt_fecha_m,ldt_fecha_entre,ldt_fecha_ingreso
			
SELECT	sysdate  
INTO 		:gdt_fec_sistema
FROM 		"TASA"  ;
ldt_fecha_hoy			= gdt_fec_sistema
ls_serie					= dw_oferta_v.getitemstring(1,'serie')
ls_area					= dw_oferta_v.getitemstring(1,'pago_oferta_area')
ls_sector					= dw_oferta_v.getitemstring(1,'pago_oferta_sector')
ls_sepultura				= dw_oferta_v.getitemstring(1,'pago_oferta_sepultura')
ls_tipo_sepult			= dw_oferta_v.getitemstring(1,'tipo_sepult')
ls_tipo_cons				= dw_oferta_v.getitemstring(1,'tipo_cons')
ls_n_reduccion			= dw_oferta_v.getitemstring(1,'pago_oferta_n_reduccion')
ls_uso					= dw_oferta_v.getitemstring(1,'uso')
ls_moneda				= dw_oferta_v.getitemstring(1,'pago_oferta_moneda')
ls_forma_pago			= dw_oferta_v.getitemstring(1,'forma_pago')
ls_tipo_mant			= dw_oferta_v.getitemstring(1,'tipo_mant')
ls_tipo_venta			= dw_oferta_v.getitemstring(1,'tipo_venta')
ls_lugar_v				= dw_oferta_v.getitemstring(1,'lugar_v')
ls_cod_jef				= dw_oferta_v.getitemstring(1,'cod_jef')
ls_cod_sup				= dw_oferta_v.getitemstring(1,'cod_sup')
ls_cod_age				= dw_oferta_v.getitemstring(1,'cod_age')
ll_nro_oferta			= dw_oferta_v.getitemnumber(1,'nro_oferta')
ll_rut						= dw_oferta_v.getitemnumber(1,'rut')
ll_saldo_financiero		= dw_oferta_v.getitemnumber(1,'saldo_finan')
ll_capacidad				= dw_oferta_v.getitemnumber(1,'pago_oferta_capacidad')
ll_des_esp				= dw_oferta_v.getitemnumber(1,'pago_oferta_des_esp')
ll_precio					= dw_oferta_v.getitemnumber(1,'pago_oferta_precio')
ll_nro_cuotas			= dw_oferta_v.getitemnumber(1,'pago_oferta_nro_cuotas')
ll_pie						= dw_oferta_v.getitemnumber(1,'pago_oferta_pie')
ll_gastos_adm			= dw_oferta_v.getitemnumber(1,'pago_oferta_gastos_adm')
ll_tasa					= dw_oferta_v.getitemnumber(1,'pago_oferta_tasa')
ll_tasa_base				= dw_oferta_v.getitemnumber(1,'pago_oferta_tasa_base')
ll_valor_cuota			= dw_oferta_v.getitemnumber(1,'pago_oferta_valor_cuota')
ll_uf_dia					= dw_oferta_v.getitemnumber(1,'pago_oferta_uf_dia')
ll_valor_cuota_m		= dw_oferta_v.getitemnumber(1,'valor_cuota_m')
ll_derecho_lib			= dw_oferta_v.getitemnumber(1,'pago_oferta_derecho_lib')
ll_rut_institucional		= dw_oferta_v.getitemnumber(1,'rut_institucional')
ll_rut_aval				= dw_oferta_v.getitemnumber(1,'rut_aval')
ll_rut_funeraria			= dw_oferta_v.getitemnumber(1,'rut_funeraria')
ll_cod_parque			= dw_oferta_v.getitemnumber(1,'cadena_cod_parque')
ldt_fecha					= dw_oferta_v.getitemdatetime(1,'fecha')
ldt_fecha_prim			= dw_oferta_v.getitemdatetime(1,'pago_oferta_fecha_prim')
ldt_fecha_ult			= dw_oferta_v.getitemdatetime(1,'pago_oferta_fecha_ult')
ldt_fecha_pie			= dw_oferta_v.getitemdatetime(1,'pago_oferta_fecha_pie')
ldt_fecha_ingreso		= dw_oferta_v.getitemdatetime(1,'fecha_ingreso')
