public function boolean wf_cadena (integer ai_modo);string	ls_barra,ls_agente

ls_barra			= gs_base + gs_serie + String(gi_numero)
gl_cod_parque	= dw_oferta_v.getitemnumber(1,'cadena_cod_parque')
gl_cod_parque		= dw_oferta_v.getitemnumber(1,'cadena_cod_parque')
if gl_cod_parque > 0 then
	dw_oferta_v.getchild('oferta_v_beneficio_complementario',idw_detalle2)
	idw_detalle2.settransobject(sqlca)
	idw_detalle2.retrieve(gl_cod_parque)
end if
ls_agente		= dw_oferta_v.getitemstring(1,'cod_age')
if isnull(gl_cod_parque) or gl_cod_parque=0 then
	SELECT	"AGENTES"."COD_PARQUE"  
	INTO 		:gl_cod_parque  
	FROM 		"AGENTES"  
	WHERE 	"AGENTES"."COD_AGE" = :ls_agente   
	USING		sqlca;
	if sqlca.sqlcode<>0 then gl_cod_parque	= 0
end if
IF ai_modo = 0 THEN // Es un Insert
	INSERT INTO	cadena
				  (barra,		rut,  		codigo,		serie,			numero, 		estado, 	print,	est_cup,	nro_carta,	fecha_carta,	estado_carta,	fecha_act_estado,	cuota_cupon,	fecha_res,	a_demandar,	estado_contable,	estado_titulo,	fecha_titulo,	nro_carta_m,	fecha_carta_m,	estado_carta_m,	fecha_act_estado_m,	cod_parque)
	VALUES	  (:ls_barra, :gi_rut,	:gs_base,	:gs_serie,	:gi_numero,	'V',		'N',		'0',		'SC',			Null,				'0',				Null,					0,					Null,			'0',			'A',					'P',				Null,				'SC',				Null,				'0', 					Null,						:gl_cod_parque)
	USING		sqlca;
	if sqlca.sqlcode=0 then
		il_graba_8	= 1
	else
		il_graba_8	= 0
	end if
	RETURN (SQLCA.SQLCode <> -1)
ELSE
	UPDATE	"CADENA"  
	SET 		"CADENA"."COD_PARQUE" = :gl_cod_parque  
	WHERE  ( "CADENA"."CODIGO" = :gs_base ) AND  
			 ( "CADENA"."SERIE" = :gs_serie ) AND  
			 ( "CADENA"."NUMERO" = :gi_numero )   
	USING		sqlca ;
	IF sqlca.sqlcode=0 THEN
		il_graba_8	= 1
	ELSE
		il_graba_8	= 0
	END IF
	RETURN (SQLCA.SQLCode <> -1)
END IF
end function

public subroutine wf_grabar ();string		serie, tipo_cont,tipo_cons, area, ls_n_reduccion,ls_moneda,ls_area,ls_sector,ls_sepultura,ls_carta_bienv,ls_nro_tecnico,ls_string,ls_estado_comi_sup,&
			ls_depto_asignado,ls_glosa,ls_memo,ls_ref,ls_anexo_dacion,ls_base_aux,ls_serie_aux,	ls_pasa,ls_forma_pago,ls_anexo_dac,ls_dv,ls_estado_cadena,ls_modif,ls_canal_venta,&
			ls_carga_benef,ls_mensaje_producto
long		i,a,ret,ll_contador, numero, suma,rut_busca,rut,nro_cuotas,ll_folio,ll_capacidad,ll_nro_cuotas,ll_parque,ll_factura,ll_total_fact,ll_count_seg,ll_count_prom,&
			ll_estado_cd,ll_estado_graba,ll_tipo_dscto,ll_ult_folio,ll_tipo_seguro,ll_folio_ini,ll_resp,ll_count_reg,ll_count_reg_c,ll_tipo_ctto,ll_dias_tope_def,&
			ll_plazo,ll_rut,ll_cod_parque,ll_count_vig,ll_tot_reg,ll_indi,ll_est_reg,ll_codigo,ll_count,ll_fila,ll_res,ll_benef_com,ll_conv,ll_conv_aux,ll_dias_inicio_def,ll_tipo_producto
double 	ld_porcent_age, ld_porcent_sup,ll_valor_cuota,uf_dia,pie, precio, porcentaje,ldb_tasa,ldb_valor_cuota,ldb_des_esp,ldb_uf_dia,ldb_derecho_lib,ldb_gastos_adm,ll_pie,&
			ll_precio,ll_pie_pagado,ld_saldo_finan,ld_porc_sup,ld_porc_jefe,ldb_tasa_base,ld_descuento_por,ldb_suma_cuota,ldb_valor_pie,ldb_tasa_12,&
			ldb_der_esp,ldb_valor_cuota_mant,ldb_calculo,ldb_descuento,ldb_monto,ldb_prima,ll_numero_aux,ldb_tasa_int_cta,ldb_tasa_cta
Datetime	ldt_fecha,ldt_fecha_prim,ldt_fecha_entre,ldt_fecha_pie,ldt_fecha_mod,ldt_fecha_fact,ldt_fecha_ult,ldt_fecha_prim_pie,ldt_fec_venc_mant,ldt_val_fecha_m,&
			ldt_new_fecha_m
date		ldt_fecha_ctto,ldt_fecha_prim_val,ldt_fecha_ult_val,ldt_fecha_m_val,ldt_fecha_val,ld_fecha_min,ld_fecha_max,ldt_fecha_pie_val

ls_estado_comi_sup	= 'N'
SELECT	sysdate,	"TASA"."DIAS_TOPE_REPACTA",	"TASA"."DIAS_INICIO_REPACTA"  INTO :gdt_fec_sistema,	:ll_dias_tope_def,	:ll_dias_inicio_def
FROM 	"TASA"  ;

dw_oferta_v.AcceptText()
ll_cod_parque			= dw_oferta_v.getitemnumber(1,'cadena_cod_parque')
if not isnull(gs_base) and not isnull(gs_serie) and gi_numero>0 and gi_rut>0 then
	if String(trim(em_dv.text)) <> String(gf_obtener_dv(long(trim(em_rut.text)))) then
		messagebox('Error','El Rut no es valido',stopsign!)
		em_rut.setfocus()
		return
	end if
	if gs_age='' or isnull(gs_age) then
		messagebox('Error','Codigo Agente Inválido',stopsign!)
		dw_agente.setfocus()
		return
	end if
	if gs_sup='' or isnull(gs_sup) then
		messagebox('Error','Codigo Supervisor Inválido',stopsign!)
		dw_supervisor.setfocus()
		return
	end if
	if gs_jefe='' or isnull(gs_jefe) then
		messagebox('Error','Codigo Jefe de Venta Inválido',stopsign!)
		dw_jefe.setfocus()
		return
	end if
	ll_tipo_seguro	= dw_oferta_v.getitemnumber(1,'pago_oferta_codigo_tipo_seguro')
	
	ldt_fecha_ctto		= date(dw_oferta_v.getitemdatetime(1,'fecha'))
	if ldt_fecha_ctto >= date('01/10/2013') then
		ll_fila				= dw_seguro.Find("c_estado_reg = 0", 1, dw_seguro.RowCount())
		if ll_fila=0 then
			ll_res			= messagebox('Advertencia','No Registra Seguros Asociados, desea Seleccionar',Exclamation!,YesNo!,2)
			if ll_res=1 then
				dw_seguro.setfocus()
				return
			end if
		end if
	else
		ll_fila				= dw_seguro.Find("c_estado_reg = 0", 1, dw_seguro.RowCount())
		if ll_tipo_seguro > 0 and ll_fila = 0 then
//			ll_res			= messagebox('Advertencia','Debe Seleccionar Tipo Seguros Asociados')
//			dw_seguro.setfocus()
//			return
		elseif ll_tipo_seguro = 0 and ll_fila > 0 then
			ll_res			= messagebox('Advertencia','Debe Seleccionar Seguros Complementario')
			dw_oferta_v.setfocus()
			dw_oferta_v.setcolumn('pago_oferta_codigo_tipo_seguro')
			return
		end if
	end if
	gl_cod_parque		= dw_oferta_v.GetItemNumber(1,"cadena_cod_parque")
	if isnull(gl_cod_parque) or gl_cod_parque=0 then
		messagebox('Advertencia','Debe Ingresar Código Parque',stopsign!)
		dw_oferta_v.setfocus()
		dw_oferta_v.setcolumn('cadena_cod_parque')
		return
	end if
	ll_tipo_ctto		= f_tipo_contrato(gs_age)
	if mid(gs_age,1,2)='ET' then
		SELECT	"ENCARGADOS"."PORCE_VTA"  
		INTO 		:ld_porcent_age  
		FROM 	"ENCARGADOS"  
		WHERE  	( "ENCARGADOS"."CODIGO_USUARIO" = :gs_age ) AND  
				 	( "ENCARGADOS"."DEPTO" = 'E' )   
		USING		sqlca;
	end if
	if isnull(ld_porcent_age) or ld_porcent_age=0 then
		IF ll_tipo_ctto = 1 THEN
			// Trae porcentaje de venta del vendedor segun contrato 1 (Antiguo)
			ld_porcent_age	= f_comision_age1(dw_oferta_v.GetItemString(1,"tipo_venta"), & 
														dw_oferta_v.GetItemString(1,"pago_oferta_area") , &
														dw_oferta_v.GetItemString(1,"uso"))
		ELSE
			// Trae porcentaje de venta del vendedor segun contrato 2 (Nuevo)
			SELECT	"PORCE_AGE_TERRENO"."PORCE_VENTA"  
			INTO 		:ld_porcent_age  
			FROM 		"PORCE_AGE_TERRENO"  
			WHERE  ( "PORCE_AGE_TERRENO"."COD_AGENTE" = :gs_age ) AND  
					 ( "PORCE_AGE_TERRENO"."ESTADO" = 'V' )   ;
			if ld_porcent_age=0 or isnull(ld_porcent_age) then
				ld_porcent_age	= f_comision_age2(dw_oferta_v.GetItemString(1,"tipo_sepult"), & 
															dw_oferta_v.GetItemString(1,"pago_oferta_area") , &
															dw_oferta_v.GetItemNumber(1,"pago_oferta_capacidad") , &
															dw_oferta_v.GetItemString(1,"uso"))
			end if
		END IF
	end if
	if gs_nueva_oferta = 'S' then
		ldt_fecha_val					= date(dw_oferta_v.getitemdatetime(1,'fecha'))
		ld_fecha_min					= RelativeDate(date(gdt_fec_sistema),  (ll_dias_inicio_def * -1))
		ld_fecha_max					= RelativeDate(date(gdt_fec_sistema),  ll_dias_tope_def)
		if ldt_fecha_val < ld_fecha_min or ldt_fecha_val > ld_fecha_max then
			messagebox("Advertencia","Fecha Promesa Inválida")
			dw_oferta_v.setfocus()
			dw_oferta_v.setcolumn('fecha')
			return
		end if
		
		ldt_fecha_pie_val				= date(dw_oferta_v.getitemdatetime(1,'pago_oferta_fecha_pie'))
		ld_fecha_min					= RelativeDate(date(gdt_fec_sistema),   (ll_dias_inicio_def * -1))
		ld_fecha_max					= RelativeDate(date(gdt_fec_sistema),  ll_dias_tope_def)
		if (ldt_fecha_pie_val < ld_fecha_min or ldt_fecha_pie_val > ld_fecha_max) and not isnull(ldt_fecha_pie_val) then
			messagebox("Advertencia","Fecha Pie Inválida")
			dw_oferta_v.setfocus()
			dw_oferta_v.setcolumn('pago_oferta_fecha_pie')
			return
		end if
	
		ldt_fecha_prim_val			= date(dw_oferta_v.getitemdatetime(1,'pago_oferta_fecha_prim'))
		ld_fecha_min					= RelativeDate(date(gdt_fec_sistema),   (ll_dias_inicio_def * -1))
		ld_fecha_max					= RelativeDate(date(gdt_fec_sistema),  ll_dias_tope_def)
		if (ldt_fecha_prim_val < ld_fecha_min or ldt_fecha_prim_val > ld_fecha_max) and not isnull(ldt_fecha_prim_val) then
			messagebox("Advertencia","Fecha Primer Vencimiento Inválida")
			dw_oferta_v.setfocus()
			dw_oferta_v.setcolumn('pago_oferta_fecha_prim')
			return
		end if
		
		ldt_fecha_ult_val				= date(dw_oferta_v.getitemdatetime(1,'pago_oferta_fecha_ult'))
		ld_fecha_min					= RelativeDate(date(gdt_fec_sistema),   (ll_dias_inicio_def * -1))
		if ldt_fecha_ult_val < ld_fecha_min and not isnull(ldt_fecha_ult_val) then
			messagebox("Advertencia","Fecha Ultimo Vencimiento Inválida")
			dw_oferta_v.setfocus()
			dw_oferta_v.setcolumn('pago_oferta_fecha_ult')
			return
		end if
		
		ldt_fecha_m_val				= date(dw_oferta_v.getitemdatetime(1,'fecha_m'))
		ld_fecha_min					= RelativeDate(date(gdt_fec_sistema),   (ll_dias_inicio_def * -1))
		if ldt_fecha_m_val < ld_fecha_min and not isnull(ldt_fecha_m_val) then
			messagebox("Advertencia","Fecha Mantención Inválida")
			dw_oferta_v.setfocus()
			dw_oferta_v.setcolumn('fecha_m')
			return
		end if
	end if	
	if isnull(ld_porcent_age) or ld_porcent_age=0 then
		messagebox('Advertencia','Error Porcentaje de Comisión Agente Inválida, debe chequear Tipo Sepultura, Area, Capacidad y Uso',stopsign!)
		dw_oferta_v.setfocus()
		dw_oferta_v.setcolumn('tipo_sepult')
		return
	end if
	SELECT	"SUPERVISOR"."PORC_SUPERVISOR"  
	INTO 		:ld_porc_sup  
	FROM 		"SUPERVISOR"  
	WHERE 	"SUPERVISOR"."COD_SUP" = :gs_sup   
	USING		sqlca;
	if isnull(ld_porc_sup) or ld_porc_sup=0 then
		messagebox('Advertencia','Error Porcentaje de Comisión Supervisor Inválida, debe chequear con Departamento Informática Tabla Supervisor',stopsign!)
		dw_oferta_v.setfocus()
		return
	end if
	SELECT DISTINCT	"JEFE_VENTAS"."PORC_JEFE_VTA"  
	INTO 		:ld_porc_jefe  
	FROM 		"JEFE_VENTAS"  
	WHERE 	"JEFE_VENTAS"."JEFE_VENTAS" = :gs_jefe   
	USING		sqlca;
	if isnull(ld_porc_jefe) or ld_porc_jefe=0 then
		messagebox('Advertencia','Error Porcentaje de Comisión Jefe de Venta Inválida, debe chequear con Departamento Informática Tabla Jefe_Ventas',stopsign!)
		dw_oferta_v.setfocus()
		return
	end if
	if String(dw_oferta_v.getitemstring(1,'compute_0050')) <> String(gf_obtener_dv(long(dw_oferta_v.GetItemNumber(1, "rut_institucional")))) then
		messagebox('Error','El Rut institucional no es valido',stopsign!)
		dw_oferta_v.setfocus()
		dw_oferta_v.SetColumn('rut_institucional')
		return
	end if
	ldb_valor_pie	= double(dw_oferta_v.getitemnumber(1,'pago_oferta_pie'))
	if ldb_valor_pie > 0 then
		SELECT	SUM("DETALLE_PAGO_PIE"."MONTO_CUOTA"  )
		INTO 		:ldb_suma_cuota  
		FROM 	"DETALLE_PAGO_PIE"  
		WHERE  ( "DETALLE_PAGO_PIE"."BASE" = :gs_base ) AND  
				 ( "DETALLE_PAGO_PIE"."SERIE" = :gs_serie ) AND  
				 ( "DETALLE_PAGO_PIE"."NUMERO" = :gi_numero )   
		USING		sqlca;
		if ldb_suma_cuota>0 then
			ldb_valor_pie	= double(dw_oferta_v.getitemnumber(1,'pago_oferta_pie'))
			if round(ldb_valor_pie,4) <> round(ldb_suma_cuota,4) then
				messagebox('Error','No coincide Valor Pie con las cuotas pactadas, la suma Pactada es: '+string(ldb_suma_cuota,"###,###,###,###,##0.0###"),stopsign!)
				dw_oferta_v.setfocus()
				dw_oferta_v.SetColumn('pago_oferta_pie')
				return
			end if
		end if
	end if	
	if dw_oferta_v.getitemstring(1,'tipo_venta') = '6' and len(string(dw_oferta_v.GetItemNumber(1, "rut_institucional"))) = 0 then
		messagebox('Error','Debe Ingresar Rut institucional.',stopsign!)
		dw_oferta_v.setfocus()
		dw_oferta_v.SetColumn('rut_institucional')
		return
	end if
	
	ls_canal_venta			= dw_oferta_v.getitemstring(1,'oferta_v_canal_venta')
	if ls_canal_venta='' or isnull(ls_canal_venta) then
		messagebox('Error','Falta Ingresar Canal de Venta',stopsign!)
		dw_oferta_v.setfocus()
		dw_oferta_v.SetColumn('oferta_v_canal_venta')
		return
	end if
	ls_moneda			= dw_oferta_v.getitemstring(1,'pago_oferta_moneda')
	if ls_moneda = '1' then // 1=peso  y  2=UF
		suma				= ((dw_oferta_v.getitemnumber(1,'pago_oferta_nro_cuotas') * dw_oferta_v.getitemnumber(1,'pago_oferta_valor_cuota')) + dw_oferta_v.getitemnumber(1,'pago_oferta_pie'))
	else
//		messagebox("valor_cuota * UF",string(dw_oferta_v.getitemnumber(1,'pago_oferta_valor_cuota'))+'*'+string(dw_oferta_v.getitemnumber(1,'pago_oferta_uf_dia')))
//		messagebox("plazo",string(dw_oferta_v.getitemnumber(1,'pago_oferta_nro_cuotas')))
//		messagebox("pie * UF",string(dw_oferta_v.getitemnumber(1,'pago_oferta_pie'))+'*'+string(dw_oferta_v.getitemnumber(1,'pago_oferta_uf_dia')))
		
		suma				= dw_oferta_v.getitemnumber(1,'pago_oferta_valor_cuota') * dw_oferta_v.getitemnumber(1,'pago_oferta_uf_dia')
		suma				= suma * dw_oferta_v.getitemnumber(1,'pago_oferta_nro_cuotas')
		suma				= suma + ( dw_oferta_v.getitemnumber(1,'pago_oferta_pie') * dw_oferta_v.getitemnumber(1,'pago_oferta_uf_dia'))	
	end if
	ldt_fec_venc_mant		= dw_oferta_v.getitemdatetime(1,'fecha_m')
	if isnull(ldt_fec_venc_mant) then
		messagebox('Error','Debe Ingresar Fecha Mantención',stopsign!)
		dw_oferta_v.setfocus()
		dw_oferta_v.SetColumn('fecha_m')
		return
	end if
	ldb_valor_cuota_mant	= dw_oferta_v.getitemnumber(1,'valor_cuota_m')
	if ldb_valor_cuota_mant=0 or isnull(ldb_valor_cuota_mant) then
		messagebox('Error','Debe Ingresar Cuota Mantención',stopsign!)
		dw_oferta_v.setfocus()
		dw_oferta_v.SetColumn('valor_cuota_m')
		return
	end if
	if suma < 500 or suma > 60000000 then
		messagebox('Advertencia','Valores Ingresados No son validos',stopsign!)
		dw_oferta_v.setfocus()
		dw_oferta_v.setcolumn('pago_oferta_nro_cuotas')
		return
	else
		ldb_valor_pie			= double(dw_oferta_v.getitemnumber(1,'pago_oferta_pie'))
		ldb_valor_cuota		= dw_oferta_v.getitemnumber(1,'pago_oferta_valor_cuota')
		ldb_gastos_adm		= dw_oferta_v.getitemnumber(1,'pago_oferta_gastos_adm')
		ll_precio					= double(dw_oferta_v.getitemnumber(1,'pago_oferta_precio'))
		ldb_der_esp				= double(dw_oferta_v.getitemnumber(1,'pago_oferta_des_esp'))
		ll_plazo					= dw_oferta_v.getitemnumber(1,'pago_oferta_nro_cuotas')
		ldb_descuento			= dw_oferta_v.getitemnumber(1,'oferta_v_descuento_por')
				
		ldb_calculo				= (ldb_valor_pie + ( ll_plazo * ldb_valor_cuota))
		if ldb_calculo < 0 then ldb_calculo=0
		if ls_moneda = '1' then	// PESO
			if ldb_der_esp >= 500 then
				messagebox("Advertencia","Recuerde que Valor Derecho Especial se debe Ingresar en UF")
				dw_oferta_v.setfocus()
				dw_oferta_v.setcolumn('pago_oferta_des_esp')
				return
			elseif ll_precio < 3000 then
				messagebox("Advertencia","Recuerde que Valor Precio se debe Ingresar en Peso")
				dw_oferta_v.setfocus()
				dw_oferta_v.setcolumn('pago_oferta_precio')
				return
			elseif ldb_valor_pie < 500 and ldb_valor_pie<>0 then
				messagebox("Advertencia","Recuerde que Valor Pie se debe Ingresar en Peso")
				dw_oferta_v.setfocus()
				dw_oferta_v.setcolumn('pago_oferta_pie')
				return
			elseif ldb_gastos_adm < 500 and ldb_gastos_adm<>0 and dw_oferta_v.GetItemString(1, "forma_pago")='2' and dw_oferta_v.GetItemNumber(1, "pago_oferta_nro_cuotas") > 17 and ll_cod_parque <> 103 then
				messagebox("Advertencia","Recuerde que Valor Gasto Administrativo se debe Ingresar en Peso")
				dw_oferta_v.setfocus()
				dw_oferta_v.setcolumn('pago_oferta_gastos_adm')
				return
			elseif ldb_gastos_adm < 500 and ldb_gastos_adm<>0 and dw_oferta_v.GetItemString(1, "forma_pago")='4' and dw_oferta_v.GetItemNumber(1, "pago_oferta_nro_cuotas") > 24 and ll_cod_parque <> 103 then
				messagebox("Advertencia","Recuerde que Valor Gasto Administrativo se debe Ingresar en Peso")
				dw_oferta_v.setfocus()
				dw_oferta_v.setcolumn('pago_oferta_gastos_adm')
				return
			elseif ldb_valor_cuota < 500 then
				messagebox("Advertencia","Recuerde que Valor Cuota se debe Ingresar en Peso")
				dw_oferta_v.setfocus()
				dw_oferta_v.setcolumn('pago_oferta_valor_cuota')
				return
			elseif ll_precio > ldb_calculo + 1000 then
				messagebox("Advertencia","Valor Cuota Inválida, debe revisar Plazo, Valor Cuota, Valor Pie o Precio")
				dw_oferta_v.setfocus()
				dw_oferta_v.setcolumn('pago_oferta_valor_cuota')
				return
			end if
		elseif ls_moneda = '2' then //UF
			if ldb_der_esp >= 500 then
				messagebox("Advertencia","Recuerde que Valor Derecho Especial se debe Ingresar en UF")
				dw_oferta_v.setfocus()
				dw_oferta_v.setcolumn('pago_oferta_des_esp')
				return
			elseif ll_precio >= 3000 then
				messagebox("Advertencia","Recuerde que Valor Precio se debe Ingresar en UF")
				dw_oferta_v.setfocus()
				dw_oferta_v.setcolumn('pago_oferta_precio')
				return
			elseif ldb_valor_pie >= 500 and ldb_valor_pie<>0 then
				messagebox("Advertencia","Recuerde que Valor Pie se debe Ingresar en UF")
				dw_oferta_v.setfocus()
				dw_oferta_v.setcolumn('pago_oferta_pie')
				return
			elseif ldb_gastos_adm >= 500 and ldb_gastos_adm<>0 and dw_oferta_v.GetItemString(1, "forma_pago")='2' and dw_oferta_v.GetItemNumber(1, "pago_oferta_nro_cuotas") > 17 and ll_cod_parque <> 103 then
				messagebox("Advertencia","Recuerde que Valor Gasto Administrativo se debe Ingresar en UF")
				dw_oferta_v.setfocus()
				dw_oferta_v.setcolumn('pago_oferta_gastos_adm')
				return
			elseif ldb_gastos_adm >= 500 and ldb_gastos_adm<>0 and dw_oferta_v.GetItemString(1, "forma_pago")='4' and dw_oferta_v.GetItemNumber(1, "pago_oferta_nro_cuotas") > 24 and ll_cod_parque <> 103 then
				messagebox("Advertencia","Recuerde que Valor Gasto Administrativo se debe Ingresar en UF")
				dw_oferta_v.setfocus()
				dw_oferta_v.setcolumn('pago_oferta_gastos_adm')
				return
			elseif ldb_valor_cuota >= 500 then
				messagebox("Advertencia","Recuerde que Valor Cuota se debe Ingresar en UF")
				dw_oferta_v.setfocus()
				dw_oferta_v.setcolumn('pago_oferta_valor_cuota')
				return
			elseif (ll_precio + 0.2) > (ldb_calculo + ldb_descuento) then
				messagebox("Advertencia","Valor Cuota Inválida, debe revisar Plazo, Valor Cuota, Valor Pie o Precio")
				dw_oferta_v.setfocus()
				dw_oferta_v.setcolumn('pago_oferta_valor_cuota')
				return
			end if
		end if
	end if
	ll_tipo_dscto					= dw_oferta_v.getitemnumber(1,'oferta_v_tipo_descuento')
	ld_descuento_por			= dw_oferta_v.getitemnumber(1,'oferta_v_descuento_por')
	ll_tipo_producto			= dw_oferta_v.getitemnumber(1,'oferta_v_tipo_producto')
	
	if ll_tipo_producto = 1 or ll_tipo_producto =2 then
		if (isnull(ll_tipo_dscto) or ll_tipo_dscto=0) then
			dw_oferta_v.setitem(1,'oferta_v_tipo_descuento',0)
			if ld_descuento_por=0 or isnull(ld_descuento_por) then
				ll_resp	= messagebox("Advertencia","Falta Ingresar Tipo Descuento,  Desea Ingresarlo",Exclamation!,YesNo!,2)
				if ll_resp=1 then
					dw_oferta_v.setfocus()
					dw_oferta_v.setcolumn('oferta_v_tipo_descuento')
					return
				end if
			end if
		end if
	end if
//	if ll_tipo_dscto=1 or ll_tipo_dscto=2 then
//		ls_anexo_dacion	= trim(dw_oferta_v.getitemstring(1,'oferta_v_anexo_dacion'))
//		if isnull(ls_anexo_dacion) or ls_anexo_dacion='' then
//			messagebox('Advertencia','Debe Ingresar CONTRATO ORIGINAL',stopsign!)
//			dw_oferta_v.setfocus()
//			dw_oferta_v.setcolumn('oferta_v_anexo_dacion')
//			return
//		elseif isnull(ld_descuento_por) or ld_descuento_por=0 then
//			messagebox('Advertencia','Ingreso Tipo Descuento por, No es posible que Descuento Por estar en 0, debe modificar el Precio',stopsign!)
//			dw_oferta_v.setfocus()
//			dw_oferta_v.setcolumn('pago_oferta_precio')
//			return
//		end if
//	end if
	ll_benef_com		= dw_oferta_v.getitemnumber(1,'oferta_v_beneficio_complementario')
	if ll_benef_com = 6 then
		ll_conv		= dw_oferta_v.getitemnumber(1,'oferta_v_cod_convenio')
		if not isnull(ll_conv) then
			serie					= dw_oferta_v.getitemstring(1,'serie')
			numero				= dw_oferta_v.getitemnumber(1,'nro_oferta')
			SELECT 	"TIPO_PROMOCION_ASOCIADOS"."COD_CONVENIO"
			INTO		:ll_conv_aux
			FROM 	"TIPO_PROMOCION_ASOCIADOS"  
			WHERE 	"TIPO_PROMOCION_ASOCIADOS"."BASE" = :gs_base AND  
						"TIPO_PROMOCION_ASOCIADOS"."SERIE" = :serie AND  
						"TIPO_PROMOCION_ASOCIADOS"."NUMERO" = :numero  
			USING	sqlca;
			if ll_conv <> ll_conv_aux then
				messagebox('Advertencia','Tipo Convenio No Coincide Con los Beneficios Guardados')
				dw_oferta_v.setfocus()
				dw_oferta_v.setcolumn('oferta_v_cod_convenio')
				return
			end if
		else
			messagebox('Advertencia','Debe Ingresar Tipo Convenio')
			dw_oferta_v.setfocus()
			dw_oferta_v.setcolumn('oferta_v_cod_convenio')
			return
		end if
		setnull(serie);setnull(numero);
	end if
	serie					= dw_oferta_v.getitemstring(1,'serie')
	numero				= dw_oferta_v.getitemnumber(1,'nro_oferta')
	rut						= long(em_rut.text)
	ls_forma_pago		= dw_oferta_v.getitemstring(1,'forma_pago')
	if numero > 0 and not isnull(numero) and not isnull(serie) then
		ll_tipo_seguro	= dw_oferta_v.getitemnumber(1,'pago_oferta_codigo_tipo_seguro')
		if isnull(ll_tipo_seguro) then ll_tipo_seguro=0
		ls_pasa			= 'S'
		if ll_tipo_seguro >= 0 then
			SELECT	"TIPO_SEGURO"."FOLIO_INICIAL"  
			INTO 		:ll_folio_ini
			FROM 	"TIPO_SEGURO"  
			WHERE 	"TIPO_SEGURO"."CODIGO" = :ll_tipo_seguro   
			USING		sqlca;
			if sqlca.sqlcode=0 then
				if numero > ll_folio_ini and ll_tipo_seguro = 0 and (ls_forma_pago = '2' or ls_forma_pago = '4') then
					ll_resp	= messagebox("Advertencia","Debe Ingresar Seguro Complementario, Es Obligatorio o esta Promesa se Ingresa por Excepción?",Exclamation!,YesNo!,2)
					if ll_resp=1 then
						ls_pasa	= 'S'
					else
						ls_pasa	= 'N'
						dw_oferta_v.setfocus()
						dw_oferta_v.setcolumn('pago_oferta_codigo_tipo_seguro')
					end if
				elseif (numero > ll_folio_ini and ll_tipo_seguro>0) or (numero <= ll_folio_ini) then
					ls_pasa	= 'S'
				end if
			end if
		end if
		if ls_pasa='S' then
			ls_anexo_dac		= trim(dw_oferta_v.getitemstring(1,'oferta_v_anexo_dacion'))
			dw_oferta_v.setitem(1,'oferta_v_anexo_dacion',ls_anexo_dac)
			tipo_cons			= dw_oferta_v.getitemstring(1,'tipo_cons')
			nro_cuotas			= dw_oferta_v.getitemnumber(1,'pago_oferta_nro_cuotas')
			pie						= double(dw_oferta_v.getitemnumber(1,'pago_oferta_pie'))
			precio					= dw_oferta_v.getitemnumber(1,'pago_oferta_precio')
			area					= dw_oferta_v.getitemstring(1,'pago_oferta_area')
			ll_valor_cuota		= dw_oferta_v.getitemnumber(1,'pago_oferta_valor_cuota')
			gs_age				= dw_agente.getitemstring(1,'agente')
			gs_sup				= dw_supervisor.getitemstring(1,'supervisores')
			gs_jefe				= dw_jefe.getitemstring(1,'jefes')
			gl_cod_parque		= dw_oferta_v.getitemnumber(1,'cadena_cod_parque')
			ll_tipo_producto	= dw_oferta_v.getitemnumber(1,'oferta_v_tipo_producto')
			
			if precio>0 then
				if pie = 0 and nro_cuotas = 1 then
					porcentaje	= round(((ll_valor_cuota * 100) / precio),2)
				else
					porcentaje	= round(((pie * 100) / precio),2)
				end if
			else
				porcentaje		= 0
			end if
//			SELECT	count("PAGARE_V"."SERIE")  
//			INTO 		:a  
//			FROM 		"PAGARE_V"  
//			WHERE  ( "PAGARE_V"."SERIE" = :serie ) AND  
//					 ( "PAGARE_V"."NUMERO" = :numero )   ;
//			if sqlca.sqlcode = -1 then
//				messagebox('Error',sqlca.SQLErrText,stopsign!)
//				return
//			elseif sqlca.sqlcode = 100 then
//				ret	= messagebox('No Existe','No Existe el Pagaré Asociado a la Promesa Serie :'+serie+' N° :'+string(numero,'###,###,###')+'~r~n'+&
//														' Desea Ingresarlo',Exclamation!,YesNo!, 2 )
//				serie = serie+string(numero)
//				if ret = 1 then
//					OpenWithParm(w_ingresa_pagare,serie)
//				end if
//			end if
			IF f_validar()=true THEN
				ld_saldo_finan	= dw_oferta_v.getitemnumber(1,'saldo_finan')
				dw_oferta_v.setitem(1,'oferta_v_saldo_financiar',ld_saldo_finan)
				dw_oferta_v.accepttext()
				ldb_tasa	= f_tasa(nro_cuotas,ll_valor_cuota,ld_saldo_finan)
				if ldb_tasa <= 0.0001 then
					ldb_tasa						= 0.0001
					ldb_tasa_cta				= 0.0001
				else
					 ldb_tasa						= ldb_tasa
					 ldb_tasa_cta				= ldb_tasa / 100
				end if
					
				if ldb_tasa > 0 and ldb_tasa < 10 then
					dw_oferta_v.setitem(1,'pago_oferta_tasa',ldb_tasa)
					dw_oferta_v.setitem(1,'pago_oferta_tasa_interes_cuota', ldb_tasa_cta)
					dw_oferta_v.setitem(1,'oferta_v_base',gs_base)
					dw_oferta_v.accepttext()
					IF MessageBox("Promesa", "Desea Actualizar los datos ingresados", Question!, YesNo!) = 1 THEN
						dw_oferta_v.setitem(1,'cod_age',gs_age)
						dw_oferta_v.setitem(1,'cod_sup',gs_sup)
						dw_oferta_v.setitem(1,'cod_jef',gs_jefe)
						dw_oferta_v.accepttext()
						il_graba_1	= dw_oferta_v.Update()
//						wf_sap_validacion()
						dw_clientes.accepttext()
						il_graba_2 	= 1
						IF il_graba_1 = 1 AND il_graba_2 = 1 THEN
							ldt_fecha				= dw_oferta_v.getitemdatetime(1,'pago_oferta_fecha')
							ll_folio				= dw_oferta_v.getitemnumber(1,'pago_oferta_folio')
							ll_precio				= double(dw_oferta_v.getitemnumber(1,'pago_oferta_precio'))
							ll_pie					= double(dw_oferta_v.getitemnumber(1,'pago_oferta_pie'))
							ldb_tasa				= dw_oferta_v.getitemnumber(1,'pago_oferta_tasa')
							ldb_tasa_base		= dw_oferta_v.getitemnumber(1,'pago_oferta_tasa_base')
							ldb_tasa_int_cta	= dw_oferta_v.getitemnumber(1,'pago_oferta_tasa_interes_cuota')
							ll_capacidad			= dw_oferta_v.getitemnumber(1,'pago_oferta_capacidad')
							ls_n_reduccion		= dw_oferta_v.getitemstring(1,'pago_oferta_n_reduccion')
							ldb_valor_cuota	= dw_oferta_v.getitemnumber(1,'pago_oferta_valor_cuota')
							ldb_des_esp			= dw_oferta_v.getitemnumber(1,'pago_oferta_des_esp')
							ll_nro_cuotas		= dw_oferta_v.getitemnumber(1,'pago_oferta_nro_cuotas')
							ldb_uf_dia			= dw_oferta_v.getitemnumber(1,'pago_oferta_uf_dia')
							ls_moneda			= dw_oferta_v.getitemstring(1,'pago_oferta_moneda')
							ldt_fecha_prim		= dw_oferta_v.getitemdatetime(1,'pago_oferta_fecha_prim')
							ldt_fecha_ult		= dw_oferta_v.getitemdatetime(1,'pago_oferta_fecha_ult')
							ldt_fecha_entre		= dw_oferta_v.getitemdatetime(1,'pago_oferta_fecha_entre')
							ldt_fecha_pie		= dw_oferta_v.getitemdatetime(1,'pago_oferta_fecha_pie')
							ldt_fecha_mod		= dw_oferta_v.getitemdatetime(1,'pago_oferta_fecha_mod')
							ls_area				= dw_oferta_v.getitemstring(1,'pago_oferta_area')
							ll_parque				= dw_oferta_v.getitemnumber(1,'pago_oferta_parque')
							ls_sector				= dw_oferta_v.getitemstring(1,'pago_oferta_sector')
							ls_sepultura			= dw_oferta_v.getitemstring(1,'pago_oferta_sepultura')
							ldb_derecho_lib	= dw_oferta_v.getitemnumber(1,'pago_oferta_derecho_lib')
							ldb_gastos_adm	= dw_oferta_v.getitemnumber(1,'pago_oferta_gastos_adm')
							ll_factura				= dw_oferta_v.getitemnumber(1,'pago_oferta_factura')
							ldt_fecha_fact		= dw_oferta_v.getitemdatetime(1,'pago_oferta_fecha_fact')
							ll_total_fact			= dw_oferta_v.getitemnumber(1,'pago_oferta_total_fact')
							ls_carta_bienv		= dw_oferta_v.getitemstring(1,'pago_oferta_carta_bienv')
							ll_pie_pagado		= double(dw_oferta_v.getitemnumber(1,'pago_oferta_pie_pagado'))
							ls_nro_tecnico		= dw_oferta_v.getitemstring(1,'pago_oferta_nro_tecnico')
							ll_tipo_producto	= dw_oferta_v.getitemnumber(1,'oferta_v_tipo_producto')
							IF cb_aceptar.text = "Actualizar" THEN
								// Update
								IF Not(wf_cadena(1)) THEN
									MessageBox("SQL error en cadena ", SQLCA.SQLErrText, Information!)
		//							rollback using SQLCA;
									RETURN
								END IF
								if mid(gs_age,1,2)='ET' then
									SELECT	"ENCARGADOS"."PORCE_VTA"  
									INTO 		:ld_porcent_age  
									FROM 	"ENCARGADOS"  
									WHERE  ( "ENCARGADOS"."CODIGO_USUARIO" = :gs_age ) AND  
											 ( "ENCARGADOS"."DEPTO" = 'E' )   
									USING		sqlca;
								end if
								if isnull(ld_porcent_age) or ld_porcent_age=0 then
									IF f_tipo_contrato(gs_age) = 1 THEN
										// Trae porcentaje de venta del vendedor segun contrato 1 (Antiguo)
										ld_porcent_age	= f_comision_age1(dw_oferta_v.GetItemString(1,"tipo_venta"), & 
																					dw_oferta_v.GetItemString(1,"pago_oferta_area") , &
																					dw_oferta_v.GetItemString(1,"uso"))
									ELSE
										// Trae porcentaje de venta del vendedor segun contrato 2 (Nuevo)
										SELECT	"PORCE_AGE_TERRENO"."PORCE_VENTA"  
										INTO 		:ld_porcent_age  
										FROM 	"PORCE_AGE_TERRENO"  
										WHERE  ( "PORCE_AGE_TERRENO"."COD_AGENTE" = :gs_age ) AND  
												 ( "PORCE_AGE_TERRENO"."ESTADO" = 'V' )   ;
										if ld_porcent_age=0 or isnull(ld_porcent_age) then
											ld_porcent_age	= f_comision_age2(dw_oferta_v.GetItemString(1,"tipo_sepult"), & 
																						dw_oferta_v.GetItemString(1,"pago_oferta_area") , &
																						dw_oferta_v.GetItemNumber(1,"pago_oferta_capacidad") , &
																						dw_oferta_v.GetItemString(1,"uso"))
										end if
									END IF
								end if
								dw_oferta_v.SetItem(1, "porce_venta", ld_porcent_age)
								dw_oferta_v.accepttext()
								il_graba_3	= dw_oferta_v.update()
							ELSE
								// Insert
								IF Not(wf_cadena(0)) THEN
									MessageBox("SQL error en cadena ", SQLCA.SQLErrText, Information!)
		//							rollback using SQLCA;
									RETURN
								END IF
								if mid(gs_age,1,2)='ET' then
									SELECT	"ENCARGADOS"."PORCE_VTA"  
									INTO 		:ld_porcent_age  
									FROM 	"ENCARGADOS"  
									WHERE  ( "ENCARGADOS"."CODIGO_USUARIO" = :gs_age ) AND  
											 ( "ENCARGADOS"."DEPTO" = 'E' )   
									USING		sqlca;
								end if
								if isnull(ld_porcent_age) or ld_porcent_age=0 then
									IF f_tipo_contrato(gs_age) = 1 THEN
										// Trae porcentaje de venta del vendedor segun contrato 1 (Antiguo)
										ld_porcent_age	= f_comision_age1(dw_oferta_v.GetItemString(1,"tipo_venta"), & 
																					dw_oferta_v.GetItemString(1,"pago_oferta_area") , &
																					dw_oferta_v.GetItemString(1,"uso"))
									ELSE
										// Trae porcentaje de venta del vendedor segun contrato 2 (Nuevo)
										SELECT	"PORCE_AGE_TERRENO"."PORCE_VENTA"  
										INTO 		:ld_porcent_age  
										FROM 	"PORCE_AGE_TERRENO"  
										WHERE  ( "PORCE_AGE_TERRENO"."COD_AGENTE" = :gs_age ) AND  
												 ( "PORCE_AGE_TERRENO"."ESTADO" = 'V' )   ;
										if ld_porcent_age=0 or isnull(ld_porcent_age) then
											ld_porcent_age	= f_comision_age2(dw_oferta_v.GetItemString(1,"tipo_sepult"), & 
																						dw_oferta_v.GetItemString(1,"pago_oferta_area") , &
																						dw_oferta_v.GetItemNumber(1,"pago_oferta_capacidad") , &
																						dw_oferta_v.GetItemString(1,"uso"))
										end if
									END IF
								end if
								dw_oferta_v.SetItem(1, "porce_venta", ld_porcent_age)
								SELECT	"SUPERVISOR"."PORC_SUPERVISOR"  
								INTO 		:ld_porc_sup  
								FROM 	"SUPERVISOR"  
								WHERE 	"SUPERVISOR"."COD_SUP" = :gs_sup   
								USING		sqlca;
								if sqlca.sqlcode=0 then
									dw_oferta_v.SetItem(1, "porce_sup", ld_porc_sup)
								else
									dw_oferta_v.SetItem(1, "porce_sup", 0)
								end if
								SELECT DISTINCT	"JEFE_VENTAS"."PORC_JEFE_VTA"  
								INTO 		:ld_porc_jefe  
								FROM 	"JEFE_VENTAS"  
								WHERE 	"JEFE_VENTAS"."JEFE_VENTAS" = :gs_jefe   
								USING		sqlca;
								if sqlca.sqlcode=0 then
									dw_oferta_v.SetItem(1, "oferta_v_porce_jefe", ld_porc_jefe)
								else
									dw_oferta_v.SetItem(1, "oferta_v_porce_jefe", 0)
								end if
								dw_oferta_v.SetItem(1, "porce_adicional", 0)
								dw_oferta_v.SetItem(1, "estado_comi_sup", ls_estado_comi_sup)
								dw_oferta_v.accepttext()
								il_graba_3	= dw_oferta_v.update()
							END IF
							if dw_oferta_v.getitemstring(1,'forma_pago')='1' then
								if ldb_tasa=0 then ldb_tasa=0.0001
								if ldb_tasa_base=0 then ldb_tasa_base=0.0001
								ldb_gastos_adm = 0 
 							elseif dw_oferta_v.getitemstring(1,'forma_pago')='2' and dw_oferta_v.GetItemNumber(1, "pago_oferta_nro_cuotas") <= 17 then
								if ldb_tasa=0 then ldb_tasa=0.0001
								if ldb_tasa_base=0 then ldb_tasa_base=0.0001
								ldb_gastos_adm	= 0
							elseif dw_oferta_v.getitemstring(1,'forma_pago')='4' and dw_oferta_v.GetItemNumber(1, "pago_oferta_nro_cuotas") <= 24 then
								if ldb_tasa=0 then ldb_tasa=0.0001
								if ldb_tasa_base=0 then ldb_tasa_base=0.0001
								ldb_gastos_adm	= 0
							end if
							if gs_nueva_oferta='S' then
								// insertar pago_oferta
								ll_tipo_seguro	= dw_oferta_v.getitemnumber(1, "pago_oferta_codigo_tipo_seguro")
								if isnull(ll_tipo_seguro) then ll_tipo_seguro=0
								SELECT		Min("DETALLE_PAGO_PIE"."FECHA_VENC_CTA")  
								INTO 			:ldt_fecha_prim_pie  
								FROM 		"DETALLE_PAGO_PIE"  
								WHERE  	  ( "DETALLE_PAGO_PIE"."BASE" = :gs_base ) AND  
										 	  ( "DETALLE_PAGO_PIE"."SERIE" = :gs_serie ) AND  
										 	  ( "DETALLE_PAGO_PIE"."NUMERO" = :gi_numero ) 
								USING		sqlca;
								SELECT		Count("DETALLE_PAGO_PIE"."NUMERO")  
								INTO 			:ll_count_reg  
								FROM 		"DETALLE_PAGO_PIE"  
								WHERE 	  ( "DETALLE_PAGO_PIE"."BASE" = :gs_base ) AND  
										 	  ( "DETALLE_PAGO_PIE"."SERIE" = :gs_serie ) AND  
											  ( "DETALLE_PAGO_PIE"."NUMERO" = :gi_numero ) 
								USING		sqlca;
								if isnull(ll_count_reg) then ll_count_reg=0
								SELECT	Count("DETALLE_PAGO_PIE"."NUMERO")  
								INTO 		:ll_count_reg_c  
								FROM 	"DETALLE_PAGO_PIE"  
								WHERE  	 ( "DETALLE_PAGO_PIE"."BASE" = :gs_base ) AND  
											 ( "DETALLE_PAGO_PIE"."SERIE" = :gs_serie ) AND  
											 ( "DETALLE_PAGO_PIE"."NUMERO" = :gi_numero ) AND
											 ( "DETALLE_PAGO_PIE"."ESTADO" = 'C' )
								USING		sqlca;
								if isnull(ll_count_reg_c) then ll_count_reg_c=0
								if isnull(ls_sector) then ls_sector='0'
								if isnull(ls_sepultura) then ls_sepultura='0'
								INSERT 	INTO "PAGO_OFERTA"  
										( 	"BASE",		"SERIE",   "NRO_OFERTA",   "FECHA",   "FOLIO",   "PRECIO",   "PIE",   	"TASA",  	"CAPACIDAD",   "N_REDUCCION",   	"VALOR_CUOTA",  	"DES_ESP",   	"NRO_CUOTAS",	"UF_DIA",   "MONEDA",   "FECHA_PRIM",   "FECHA_ULT",   	"FECHA_ENTRE",   	"FECHA_PIE",   "MODIFICADO",  	"FECHA_MOD",   "AREA",   "PARQUE",   "SECTOR",   "SEPULTURA",   "DERECHO_LIB",   "GASTOS_ADM",   "FACTURA",   	"FECHA_FACT",   "TOTAL_FACT",   	"CARTA_BIENV",   "PIE_PAGADO",   	"NRO_TECNICO",	"TASA_BASE",		"CODIGO_TIPO_SEGURO",	"CTAS_PACTADAS_PIE",	"CTAS_PAGADAS_PIE",	"FECHA_PRIM_PIE",	"TASA_INTERES_CUOTA" )  
								VALUES 
										( 	:gs_base,	:gs_serie,  :gi_numero,		:ldt_fecha,:ll_folio, 	:ll_precio,	:ll_pie,    :ldb_tasa,	:ll_capacidad,	 :ls_n_reduccion,  		:ldb_valor_cuota, 		:ldb_des_esp,  :ll_nro_cuotas,		:ldb_uf_dia,:ls_moneda, :ldt_fecha_prim,	:ldt_fecha_ult,	:ldt_fecha_entre, 		:ldt_fecha_pie,	:gs_user,   			:ldt_fecha_mod,:ls_area, 	:ll_parque, :ls_sector, 	:ls_sepultura, 	:ldb_derecho_lib,	:ldb_gastos_adm,	:ll_factura, 		:ldt_fecha_fact,		:ll_total_fact, 		:ls_carta_bienv, 	:ll_pie_pagado, 	:ls_nro_tecnico,	:ldb_tasa_base,	:ll_tipo_seguro,					:ll_count_reg,				:ll_count_reg_c,			:ldt_fecha_prim_pie,	:ldb_tasa_int_cta )  
								using		sqlca;
								if sqlca.sqlcode=0 then
									il_graba_4					= 1
		//							commit;
									SELECT	"CD_FOLIO"."ULT_ESTADO",
												"CD_FOLIO"."DEPTO_ASIGNADO"
									INTO 		:ll_estado_cd,
												:ls_depto_asignado
									FROM 	"CD_FOLIO"  
									WHERE  ( "CD_FOLIO"."BASE" = :gs_base ) AND  
											 ( "CD_FOLIO"."SERIE" = :gs_serie ) AND  
											 ( "CD_FOLIO"."NUMERO" = :gi_numero )   
									USING		sqlca;
									if sqlca.sqlcode=0 then
										if ll_estado_cd<>11 then
											ll_estado_graba	= 11
											ls_glosa				= 'PROMESA DIGITADA'
											ls_memo				= '-'
											ls_ref				= '-'
											UPDATE	"CD_FOLIO"  
											SET 		"ULT_ESTADO" = :ll_estado_graba,   
														"ULT_FECHA_ESTADO" = :gdt_fec_sistema,   
														"ULT_GLOSA_ESTADO" = :ls_glosa,   
														"ULT_MEMO" = :ls_memo,   
														"ULT_USUARIO_GESTION" = :gs_user,   
														"ULT_REFERENCIA_MEMO" = :ls_ref  
											WHERE	 ( "CD_FOLIO"."BASE" = :gs_base ) AND  
													 	( "CD_FOLIO"."SERIE" = :gs_serie ) AND  
													 	( "CD_FOLIO"."NUMERO" = :gi_numero )   
											USING		sqlca;
											if sqlca.sqlcode=0 then
												il_graba_5		= 1
		//										commit;
												INSERT INTO	"CD_FOLIO_DETALLE"  
															( "BASE",	"SERIE",		"NUMERO",	"FECHA_CREA",		"USUARIO_CREA",	"ESTADO",			"FECHA_ESTADO",	"GLOSA",		"MEMO",		"COD_AGENTE",	"COD_SUPERVISOR",	"COD_JEFE_VENTA",	"REFERENCIA_MEMO" )  
												VALUES 	( :gs_base,	:gs_serie,	:gi_numero,	:gdt_fec_sistema,	:gs_user,   		:ll_estado_graba,	:gdt_fec_sistema,	:ls_glosa,	:ls_memo,	:gs_age,			:gs_sup,				:gs_jefe,			:ls_ref )  
												USING		sqlca;
												if sqlca.sqlcode=0 then
													il_graba_6	= 1
		//											commit;
												else
													il_graba_6	= 0
		//											rollback;
												end if
											else
												il_graba_5		= 0
		//										rollback;
											end if
										else
											il_graba_5			= 1
											il_graba_6			= 1
										end if
									else
										il_graba_5				= 1
										il_graba_6				= 1
									end if
								else
									il_graba_4					= 0
		//							rollback;
								end if
							else
								// update pago_oferta
								ll_ult_folio	= dw_oferta_v.getitemnumber(1,'ult_folio')
								if isnull(ll_ult_folio) then ll_ult_folio=0
								ll_tipo_seguro	= dw_oferta_v.getitemnumber(1, "pago_oferta_codigo_tipo_seguro")
								if isnull(ll_tipo_seguro) then ll_tipo_seguro=0
								SELECT	Min("DETALLE_PAGO_PIE"."FECHA_VENC_CTA")  
								INTO 		:ldt_fecha_prim_pie  
								FROM 	"DETALLE_PAGO_PIE"  
								WHERE  ( "DETALLE_PAGO_PIE"."BASE" = :gs_base ) AND  
										 ( "DETALLE_PAGO_PIE"."SERIE" = :gs_serie ) AND  
										 ( "DETALLE_PAGO_PIE"."NUMERO" = :gi_numero ) 
								USING		sqlca;
								SELECT	Count("DETALLE_PAGO_PIE"."NUMERO")  
								INTO 		:ll_count_reg  
								FROM 	"DETALLE_PAGO_PIE"  
								WHERE  ( "DETALLE_PAGO_PIE"."BASE" = :gs_base ) AND  
										 ( "DETALLE_PAGO_PIE"."SERIE" = :gs_serie ) AND  
										 ( "DETALLE_PAGO_PIE"."NUMERO" = :gi_numero ) 
								USING		sqlca;
								if isnull(ll_count_reg) then ll_count_reg=0
								SELECT	Count("DETALLE_PAGO_PIE"."NUMERO")  
								INTO 		:ll_count_reg_c  
								FROM 	"DETALLE_PAGO_PIE"  
								WHERE  ( "DETALLE_PAGO_PIE"."BASE" = :gs_base ) AND  
										 ( "DETALLE_PAGO_PIE"."SERIE" = :gs_serie ) AND  
										 ( "DETALLE_PAGO_PIE"."NUMERO" = :gi_numero ) AND
										 ( "DETALLE_PAGO_PIE"."ESTADO" = 'C' )
								USING		sqlca;
								if isnull(ll_count_reg_c) then ll_count_reg_c=0
								if isnull(ldt_fecha_pie) then Setnull(ldt_fecha_pie)//=datetime(date('00/00/0000'),time('00:00:00'))
								UPDATE 	"PAGO_OFERTA"   
								SET 		"FECHA"			= :ldt_fecha,
											"FOLIO"			= :ll_folio,
											"PRECIO"			= :ll_precio,
											"PIE"				= :ll_pie,
											"TASA"			= :ldb_tasa,
											"TASA_BASE"		= :ldb_tasa_base,
											"CAPACIDAD"		= :ll_capacidad, 
											"N_REDUCCION"	= :ls_n_reduccion,
											"VALOR_CUOTA"	= :ldb_valor_cuota,
											"DES_ESP"		= :ldb_des_esp,
											"NRO_CUOTAS"	= :ll_nro_cuotas,
											"UF_DIA"			= :ldb_uf_dia,
											"MONEDA"			= :ls_moneda,
											"FECHA_PRIM"	= :ldt_fecha_prim,
											"FECHA_ULT"		= :ldt_fecha_ult,
											"FECHA_ENTRE"	= :ldt_fecha_entre,
											"FECHA_PIE"		= :ldt_fecha_pie,
											"MODIFICADO"	= :gs_user,
											"FECHA_MOD"		= :ldt_fecha_mod,
											"AREA"			= :ls_area,
											"PARQUE"			= :ll_parque,
											"SECTOR"			= :ls_sector,
											"SEPULTURA"		= :ls_sepultura,
											"DERECHO_LIB"	= :ldb_derecho_lib,
											"GASTOS_ADM"	= :ldb_gastos_adm,
											"FACTURA"		= :ll_factura,
											"FECHA_FACT"	= :ldt_fecha_fact,
											"TOTAL_FACT"	= :ll_total_fact,
											"CARTA_BIENV"	= :ls_carta_bienv,
											"PIE_PAGADO"	= :ll_pie_pagado,
											"NRO_TECNICO"	= :ls_nro_tecnico,
											"CODIGO_TIPO_SEGURO" = :ll_tipo_seguro,
											"CTAS_PACTADAS_PIE" = :ll_count_reg,
											"CTAS_PAGADAS_PIE" = :ll_count_reg_c,
											"FECHA_PRIM_PIE" = :ldt_fecha_prim_pie,
											"BASE" = :gs_base,
											"TASA_INTERES_CUOTA" = :ldb_tasa_int_cta
								WHERE	  ("SERIE"			= :gs_serie and
											"NRO_OFERTA"	= :gi_numero and
											"FOLIO"			= :ll_ult_folio )
								using		sqlca;
								if sqlca.sqlcode=0 then
									il_graba_4		= 1
									il_graba_5		= 1
									il_graba_6		= 1
		//							commit;
								else
									il_graba_4		= 0
		//							rollback;
								end if
							end if
							gs_nueva_oferta		= 'N'
							IF cb_aceptar.text	= "Actualizar" THEN 
								gs_age				= dw_agente.getitemstring(1,'agente')
								gs_sup				= dw_supervisor.getitemstring(1,'supervisores')
								gs_jefe				= dw_jefe.getitemstring(1,'jefes')
								il_graba_5			= 1 
								il_graba_6			= 1
								il_graba_7			= 1
								if il_graba_1=1 and il_graba_2=1 and il_graba_3=1 and il_graba_4=1 and &
									il_graba_5=1 and il_graba_6=1 and il_graba_7=1 and il_graba_8=1 then
									commit using sqlca;
									
									SELECT 	Count("TIPO_PROMOCION_ASOCIADOS"."BASE"  )
									INTO 		:ll_count_prom  
									FROM 	"TIPO_PROMOCION_ASOCIADOS"  
									WHERE 	( "TIPO_PROMOCION_ASOCIADOS"."BASE" = :gs_base ) AND  
												( "TIPO_PROMOCION_ASOCIADOS"."SERIE" = :gs_serie ) AND  
												( "TIPO_PROMOCION_ASOCIADOS"."NUMERO" = :gi_numero )   ;
									if isnull(ll_count_prom) then ll_count_prom=0
									if ll_count_prom = 0 then
										ls_carga_benef			= f_carga_benef_promo(gs_base,gs_serie,gi_numero,ll_tipo_producto);
									end if
									//VALIDAR FECHA MANT
									ldt_val_fecha_m			= dw_oferta_v.getitemdatetime(1,'fecha_m')
									if not isnull(ldt_val_fecha_m) then
										SELECT 	"VISTA_CALCULA_PROX_MANT"."NEW_FECHA_M"  
										INTO		:ldt_new_fecha_m
										FROM 	"VISTA_CALCULA_PROX_MANT"  
										WHERE 	( "VISTA_CALCULA_PROX_MANT"."CODIGO" = :gs_base ) AND  
													( "VISTA_CALCULA_PROX_MANT"."SERIE" = :gs_serie ) AND  
													( "VISTA_CALCULA_PROX_MANT"."NUMERO" = :gi_numero )   ;
										if ldt_val_fecha_m <> ldt_new_fecha_m and not isnull(ldt_val_fecha_m) and not isnull(ldt_new_fecha_m) then
											UPDATE 	  "OFERTA_V"  
											SET 		  "FECHA_M" = :ldt_new_fecha_m  
											WHERE 	( "OFERTA_V"."BASE" = :gs_base ) AND  
														( "OFERTA_V"."SERIE" = :gs_serie ) AND  
														( "OFERTA_V"."NRO_OFERTA" = :gi_numero )   
											USING	sqlca;
											if sqlca.sqlcode=0 then
												commit;
											else
												rollback;
											end if
										end if
									end if
									wf_setear_oferta()
									if not isnull(ls_anexo_dacion) and ls_anexo_dacion <> '' then
										ls_base_aux		= mid(ls_anexo_dacion,1,1)
										ls_serie_aux		= mid(ls_anexo_dacion,2,1)
										ll_numero_aux	= Double(mid(ls_anexo_dacion,3))
										CHOOSE CASE ls_base_aux
											CASE 'O', 'U'
												UPDATE	"OFERTA_V"  
												SET 		"ANEXO_DACION" = :ls_anexo_dacion  
												WHERE  ( "OFERTA_V"."SERIE" = :gs_serie ) AND  
														 ( "OFERTA_V"."NRO_OFERTA" = :gi_numero )   
												USING		sqlca;
												if sqlca.sqlcode=0 then
													commit;
												else
													rollback;
												end if
		
											CASE 'C'
												UPDATE	"CONTRATO"  
												SET 		"ANEXO_DACION" = :ls_anexo_dacion  
												WHERE  ( "CONTRATO"."SERIE_C" = :gs_serie ) AND  
														 ( "CONTRATO"."NRO_CONTRATO" = :gi_numero )   
												USING		sqlca;
												if sqlca.sqlcode=0 then
													commit;
												else
													rollback;
												end if
												
											CASE 'P'
												UPDATE	"PAGARE"  
												SET 		"ANEXO_DACION" = :ls_anexo_dacion  
												WHERE  ( "PAGARE"."SERIE" = :gs_serie ) AND  
														 ( "PAGARE"."NRO_OFERTA" = :gi_numero )   
												USING		sqlca;
												if sqlca.sqlcode=0 then
													commit;
												else
													rollback;
												end if
		
										END CHOOSE
									end if
									wf_log_promesa()
									if dw_oferta_v.getitemstring(1,'tipo_venta') = '6' then
										UPDATE	"CADENA"  
										SET 		"EST_CUP" = 1  
										WHERE  ( "CADENA"."CODIGO" = :gs_base ) AND  
												 ( "CADENA"."SERIE" = :serie ) AND  
												 ( "CADENA"."NUMERO" = :numero )   
										USING		sqlca;
										if sqlca.sqlcode=0 then
											Commit using SQLCA;
										else
											Rollback using SQLCA;
										end if
									end if
									wf_comision(serie,numero,porcentaje,nro_cuotas,area,tipo_cons)//--nueva comision--
									ll_plazo						= dw_oferta_v.getitemnumber(1,'pago_oferta_nro_cuotas')
									ll_rut							= dw_oferta_v.getitemnumber(1,'rut')
									ldb_valor_cuota			= dw_oferta_v.getitemnumber(1,'pago_oferta_valor_cuota')
									ldt_fecha_prim				= dw_oferta_v.getitemdatetime(1,'pago_oferta_fecha_prim')
									ldt_fec_venc_mant			= dw_oferta_v.getitemdatetime(1,'fecha_m')
									ldb_valor_cuota_mant	= dw_oferta_v.getitemnumber(1,'valor_cuota_m')
									ls_dv							= TRIM(em_dv.text)
									ll_cod_parque				= dw_oferta_v.getitemnumber(1,'cadena_cod_parque')
									ls_moneda					= TRIM(dw_oferta_v.getitemstring(1,'pago_oferta_moneda'))
									ll_tipo_producto			= dw_oferta_v.getitemnumber(1,'oferta_v_tipo_producto')
									
									SELECT	"CADENA"."ESTADO"  
									INTO 		:ls_estado_cadena  
									FROM 	"CADENA"  
									WHERE  ( "CADENA"."CODIGO" = :gs_base ) AND  
											   ( "CADENA"."SERIE" = :gs_serie ) AND  
											   ( "CADENA"."NUMERO" = :gi_numero )   
									USING		sqlca;
									if ls_estado_cadena='V' then
										SELECT	"CUPONERAS"."NUMERO"  
										INTO 		:ll_count_vig  
										FROM 	"CUPONERAS"  
										WHERE  ( "CUPONERAS"."BASE" = :gs_base ) AND  
												 ( "CUPONERAS"."SERIE" = :gs_serie ) AND  
												 ( "CUPONERAS"."NUMERO" = :gi_numero ) AND  
												 ( "CUPONERAS"."ESTADO_CUPONERA" = 'V' )   
										USING		sqlca;
										if sqlca.sqlcode=0 then
											if il_modif > 0 or il_modif_fec > 0 or il_modif_plazo > 0 or il_modif_mant > 0 or il_modif_fec_mant > 0 then
												if il_modif > 0 then
													ls_modif	= 'E'
												elseif il_modif_fec > 0 then
													ls_modif	= 'C'
												elseif il_modif_plazo > 0 then
													ls_modif	= 'P'
												elseif il_modif_mant > 0 then
													ls_modif	= 'F'
												elseif il_modif_fec_mant > 0 then
													ls_modif	= 'M'
												end if
												SELECT	"CADENA_MORA"."FECHA_VENC_MANT"  
												INTO 		:ldt_fec_venc_mant  
												FROM 	"CADENA_MORA"  
												WHERE  ( "CADENA_MORA"."BASE" = :gs_base ) AND  
														 ( "CADENA_MORA"."SERIE" = :gs_serie ) AND  
														 ( "CADENA_MORA"."NUMERO" = :gi_numero )   
												USING		sqlca;
												ls_moneda				= dw_oferta_v.getitemstring(1,'pago_oferta_moneda')
												
												
												INSERT INTO "CUPONERAS_MODIFICA"  
															( "BASE",	"SERIE",		"NUMERO",	"FECHA_CREA",		"USUARIO",	"DEPTO_SOLICITA",	"ESTADO_REG",	"PLAZO",		"RUT",	"DV",		"VALOR_CUOTA_CRED",	"VALOR_CUOTA_MANT",		"COD_PARQUE",		"FECHA_PRIM",		"FEC_VENC_MANT",		"MONEDA",	"TIPO_MODIFICACION" )
												VALUES	( :gs_base,	:gs_serie,	:gi_numero,	:gdt_fec_sistema,	:gs_user,	:gs_depto,			'V',				:ll_plazo,	:ll_rut,	:ls_dv,	:ldb_valor_cuota,		:ldb_valor_cuota_mant,	:ll_cod_parque,	:ldt_fecha_prim,	:ldt_fec_venc_mant,	:ls_moneda,	:ls_modif )  
												USING		sqlca;
												if sqlca.sqlcode=0 then
													commit;
													DECLARE sp_nuevo_cadena_mora1 PROCEDURE FOR sp_nuevo_cadena_mora(:gs_base,:gs_serie,:gi_numero,'M');
													EXECUTE sp_nuevo_cadena_mora1;
												
													DECLARE sp_proc_modifica_cuponera1 PROCEDURE FOR SP_MODIFICAR_CUPONERA( :gs_base, :gs_serie, :gi_numero, :ll_plazo, :gs_user, :ll_rut, :ldb_valor_cuota, :ldb_valor_cuota_mant, :ls_dv, :ll_cod_parque, :ldt_fecha_prim, :ldt_fec_venc_mant, :ls_moneda, :ls_modif );
													EXECUTE sp_proc_modifica_cuponera1;
													
													ldb_tasa_12				= (ldb_tasa / 100) * 12
													DECLARE SP_DESARROLLO_CUOTA1 PROCEDURE FOR SP_DESARROLLO_CUOTA( :gs_base, :gs_serie, :gi_numero, :ll_plazo, :ll_precio, :ll_pie, :ldb_tasa_12, :ldb_valor_cuota, :ldb_gastos_adm, :ldt_fecha_prim, :ls_moneda, :ldb_tasa_int_cta);
													EXECUTE SP_DESARROLLO_CUOTA1;
												else
													rollback;
												end if
											else
												ldb_tasa_12				= (ldb_tasa / 100) * 12
												DECLARE SP_DESARROLLO_CUOTA1_1 PROCEDURE FOR SP_DESARROLLO_CUOTA( :gs_base, :gs_serie, :gi_numero, :ll_plazo, :ll_precio, :ll_pie, :ldb_tasa_12, :ldb_valor_cuota, :ldb_gastos_adm, :ldt_fecha_prim, :ls_moneda, :ldb_tasa_int_cta);
												EXECUTE SP_DESARROLLO_CUOTA1_1;
											end if
										elseif sqlca.sqlcode=100 then
											DECLARE sp_nuevo_cadena_mora PROCEDURE FOR sp_nuevo_cadena_mora(:gs_base,:gs_serie,:gi_numero,'N');
											EXECUTE sp_nuevo_cadena_mora;

											DECLARE sp_proc_genera_cuponera PROCEDURE FOR SP_GENERAR_CUPONERA( :gs_base, :gs_serie, :gi_numero, :ll_plazo, :gs_user, :ll_rut, :ldb_valor_cuota, :ldb_valor_cuota_mant, :ls_dv, :ll_cod_parque, :ldt_fecha_prim, :ldt_fec_venc_mant, :ls_moneda);
											EXECUTE sp_proc_genera_cuponera;
											
											ldb_tasa_12				= (ldb_tasa / 100) * 12
											DECLARE SP_DESARROLLO_CUOTA PROCEDURE FOR SP_DESARROLLO_CUOTA( :gs_base, :gs_serie, :gi_numero, :ll_plazo, :ll_precio, :ll_pie, :ldb_tasa_12, :ldb_valor_cuota, :ldb_gastos_adm, :ldt_fecha_prim, :ls_moneda, :ldb_tasa_int_cta);
											EXECUTE SP_DESARROLLO_CUOTA;
									
										end if
										
									end if
									if gs_base='O' then
										ls_mensaje_producto		= 'Promesa'
									elseif gs_base='U' then
										ls_mensaje_producto		= 'Columbario'
									end if
									IF MessageBox("Grabar", "Grabación Exitosa, desea Ingresar otra "+ls_mensaje_producto, Question!, YesNo!, 2) = 1 THEN
										Setnull(gs_serie);setnull(gi_numero);setnull(gi_rut)
										Setnull(gs_age);setnull(gs_sup);setnull(gs_jefe)
										cb_limpiar.triggerevent(clicked!)
										if gs_empresa = 'El Prado' then
											if gs_base='O' then
												em_serie.text	= 'I'
											elseif gs_base='U' then
												em_serie.text	= 'U'
											else
												em_serie.text	= 'I'
											end if
										elseif gs_empresa = 'La Foresta' then
											if gs_base='O' then
												em_serie.text	= 'S'
											elseif gs_base='U' then
												em_serie.text	= 'A'
											else
												em_serie.text	= 'S'
											end if
										elseif gs_empresa = 'Santiago' then
											em_serie.text	= 'T'
										end if
										em_serie.setfocus()
									else
										gs_nueva_oferta	= 'N'
										cb_aceptar.text 	= "Actualizar"
									END IF
								else
									rollback using sqlca;
									messagebox("Error Grabar","Error Grabar SQL: "+sqlca.sqlerrtext)
								end if
							ELSE
								if il_graba_1=1 and il_graba_2=1 and il_graba_3=1 and il_graba_4=1 and &
									il_graba_5=1 and il_graba_6=1 and il_graba_8=1 then
									commit using sqlca;
									
									SELECT 	Count("TIPO_PROMOCION_ASOCIADOS"."BASE"  )
									INTO 		:ll_count_prom  
									FROM 	"TIPO_PROMOCION_ASOCIADOS"  
									WHERE 	( "TIPO_PROMOCION_ASOCIADOS"."BASE" = :gs_base ) AND  
												( "TIPO_PROMOCION_ASOCIADOS"."SERIE" = :gs_serie ) AND  
												( "TIPO_PROMOCION_ASOCIADOS"."NUMERO" = :gi_numero )   ;
									if isnull(ll_count_prom) then ll_count_prom=0
									if ll_count_prom = 0 then
										ls_carga_benef			= f_carga_benef_promo(gs_base,gs_serie,gi_numero,ll_tipo_producto);
									end if
									
									// VALIDAR FECHA MANT
									ldt_val_fecha_m			= dw_oferta_v.getitemdatetime(1,'fecha_m')
									if not isnull(ldt_val_fecha_m) then
										SELECT 	"VISTA_CALCULA_PROX_MANT"."NEW_FECHA_M"  
										INTO		:ldt_new_fecha_m
										FROM 	"VISTA_CALCULA_PROX_MANT"  
										WHERE 	( "VISTA_CALCULA_PROX_MANT"."CODIGO" = :gs_base ) AND  
													( "VISTA_CALCULA_PROX_MANT"."SERIE" = :gs_serie ) AND  
													( "VISTA_CALCULA_PROX_MANT"."NUMERO" = :gi_numero )   ;
										if ldt_val_fecha_m <> ldt_new_fecha_m and not isnull(ldt_val_fecha_m) and not isnull(ldt_new_fecha_m) then
											UPDATE 	  "OFERTA_V"  
											SET 		  "FECHA_M" = :ldt_new_fecha_m  
											WHERE 	( "OFERTA_V"."BASE" = :gs_base ) AND  
														( "OFERTA_V"."SERIE" = :gs_serie ) AND  
														( "OFERTA_V"."NRO_OFERTA" = :gi_numero )   
											USING	sqlca;
											if sqlca.sqlcode=0 then
												commit;
											else
												rollback;
											end if
										end if
									end if
									wf_log_promesa()
									if dw_oferta_v.getitemstring(1,'tipo_venta') = '6' then
										UPDATE	"CADENA"  
										SET 		"EST_CUP" = 1  
										WHERE  	( "CADENA"."CODIGO" = :gs_base ) AND  
													( "CADENA"."SERIE" = :serie ) AND  
												 	( "CADENA"."NUMERO" = :numero )   
										USING		sqlca;
										if sqlca.sqlcode=0 then
											commit using sqlca;
										else
											rollback using sqlca;
										end if
									end if
									wf_comision(serie,numero,porcentaje,nro_cuotas,area,tipo_cons)//--nueva comision--
									ll_plazo						= dw_oferta_v.getitemnumber(1,'pago_oferta_nro_cuotas')
									ll_rut							= dw_oferta_v.getitemnumber(1,'rut')
									ldb_valor_cuota			= dw_oferta_v.getitemnumber(1,'pago_oferta_valor_cuota')
									ldt_fecha_prim				= dw_oferta_v.getitemdatetime(1,'pago_oferta_fecha_prim')
									ldt_fec_venc_mant			= dw_oferta_v.getitemdatetime(1,'fecha_m')
									ldb_valor_cuota_mant	= dw_oferta_v.getitemnumber(1,'valor_cuota_m')
									ls_dv							= TRIM(em_dv.text)
									ll_cod_parque				= dw_oferta_v.getitemnumber(1,'cadena_cod_parque')
									ls_moneda					= dw_oferta_v.getitemstring(1,'pago_oferta_moneda')
									SELECT	"CADENA"."ESTADO"  
									INTO 		:ls_estado_cadena  
									FROM 	"CADENA"  
									WHERE  ( "CADENA"."CODIGO" = :gs_base ) AND  
											 ( "CADENA"."SERIE" = :gs_serie ) AND  
											 ( "CADENA"."NUMERO" = :gi_numero )   
									USING		sqlca;
									if ls_estado_cadena='V' then
										SELECT	"CUPONERAS"."NUMERO"  
										INTO 		:ll_count_vig  
										FROM 		"CUPONERAS"  
										WHERE  ( "CUPONERAS"."BASE" = :gs_base ) AND  
												 ( "CUPONERAS"."SERIE" = :gs_serie ) AND  
												 ( "CUPONERAS"."NUMERO" = :gi_numero ) AND  
												 ( "CUPONERAS"."ESTADO_CUPONERA" = 'V' )   
										USING		sqlca;
										if sqlca.sqlcode=0 then
											if il_modif > 1 or il_modif_fec > 1 or il_modif_plazo > 1 or il_modif_mant > 1 or il_modif_fec_mant > 1 then
												if il_modif > 1 then
													ls_modif	= 'E'
												elseif il_modif_fec > 1 then
													ls_modif	= 'C'
												elseif il_modif_plazo > 1 then
													ls_modif	= 'P'
												elseif il_modif_mant > 1 then
													ls_modif	= 'F'
												elseif il_modif_fec_mant > 1 then
													ls_modif	= 'M'
												elseif il_modif_parque > 1 then
													ls_modif	= 'A'
												end if
												SELECT	"CADENA_MORA"."FECHA_VENC_MANT"  
												INTO 		:ldt_fec_venc_mant  
												FROM 	"CADENA_MORA"  
												WHERE 	( "CADENA_MORA"."BASE" = :gs_base ) AND  
														 	( "CADENA_MORA"."SERIE" = :gs_serie ) AND  
														 	( "CADENA_MORA"."NUMERO" = :gi_numero )   
												USING		sqlca;
												ls_moneda				= dw_oferta_v.getitemstring(1,'pago_oferta_moneda')
												INSERT INTO "CUPONERAS_MODIFICA"  
															( "BASE",	"SERIE",		"NUMERO",	"FECHA_CREA",		"USUARIO",	"DEPTO_SOLICITA",	"ESTADO_REG",	"PLAZO",		"RUT",	"DV",		"VALOR_CUOTA_CRED",	"VALOR_CUOTA_MANT",		"COD_PARQUE",		"FECHA_PRIM",		"FEC_VENC_MANT",		"MONEDA",	"TIPO_MODIFICACION" )
												VALUES	( :gs_base,	:gs_serie,	:gi_numero,	:gdt_fec_sistema,	:gs_user,	:gs_depto,			'V',				:ll_plazo,	:ll_rut,	:ls_dv,	:ldb_valor_cuota,		:ldb_valor_cuota_mant,	:ll_cod_parque,	:ldt_fecha_prim,	:ldt_fec_venc_mant,	:ls_moneda,	:ls_modif )  
												USING		sqlca;
												if sqlca.sqlcode=0 then
													commit;
													DECLARE sp_nuevo_cadena_mora2 PROCEDURE FOR sp_nuevo_cadena_mora(:gs_base,:gs_serie,:gi_numero,'M');
													EXECUTE sp_nuevo_cadena_mora2;
													
													DECLARE sp_proc_modifica_cuponera2 PROCEDURE FOR SP_MODIFICAR_CUPONERA( :gs_base, :gs_serie, :gi_numero, :ll_plazo, :gs_user, :ll_rut, :ldb_valor_cuota, :ldb_valor_cuota_mant, :ls_dv, :ll_cod_parque, :ldt_fecha_prim, :ldt_fec_venc_mant, :ls_moneda, :ls_modif );
													EXECUTE sp_proc_modifica_cuponera2;
													
													ldb_tasa_12				= (ldb_tasa / 100) * 12
													DECLARE SP_DESARROLLO_CUOTA2 PROCEDURE FOR SP_DESARROLLO_CUOTA( :gs_base, :gs_serie, :gi_numero, :ll_plazo, :ll_precio, :ll_pie, :ldb_tasa_12, :ldb_valor_cuota, :ldb_gastos_adm, :ldt_fecha_prim, :ls_moneda, :ldb_tasa_int_cta);
													EXECUTE SP_DESARROLLO_CUOTA2;
												
												else
													rollback;
												end if
											else
												ldb_tasa_12					= (ldb_tasa / 100) * 12
												DECLARE SP_DESARROLLO_CUOTA2_1 PROCEDURE FOR SP_DESARROLLO_CUOTA( :gs_base, :gs_serie, :gi_numero, :ll_plazo, :ll_precio, :ll_pie, :ldb_tasa_12, :ldb_valor_cuota, :ldb_gastos_adm, :ldt_fecha_prim, :ls_moneda, :ldb_tasa_int_cta);
												EXECUTE SP_DESARROLLO_CUOTA2_1;
											end if
										elseif sqlca.sqlcode=100 then
											DECLARE sp_nuevo_cadena_mora3 PROCEDURE FOR sp_nuevo_cadena_mora(:gs_base,:gs_serie,:gi_numero,'N');
											EXECUTE sp_nuevo_cadena_mora3;
											
											DECLARE sp_proc_genera_cuponera3 PROCEDURE FOR SP_GENERAR_CUPONERA( :gs_base, :gs_serie, :gi_numero, :ll_plazo, :gs_user, :ll_rut, :ldb_valor_cuota, :ldb_valor_cuota_mant, :ls_dv, :ll_cod_parque, :ldt_fecha_prim, :ldt_fec_venc_mant, :ls_moneda);
											EXECUTE sp_proc_genera_cuponera3;
											
											ldb_tasa_12				= (ldb_tasa / 100) * 12
											DECLARE SP_DESARROLLO_CUOTA3 PROCEDURE FOR SP_DESARROLLO_CUOTA( :gs_base, :gs_serie, :gi_numero, :ll_plazo, :ll_precio, :ll_pie, :ldb_tasa_12, :ldb_valor_cuota, :ldb_gastos_adm, :ldt_fecha_prim, :ls_moneda, :ldb_tasa_int_cta);
											EXECUTE SP_DESARROLLO_CUOTA3;
									
										end if
									end if
									
									wf_setear_oferta()
									if gs_base='O' then
										ls_mensaje_producto		= 'Promesa'
									elseif gs_base='U' then
										ls_mensaje_producto		= 'Columbario'
									end if
									IF MessageBox("Grabar", "Grabación Exitosa, desea Ingresar otra "+ls_mensaje_producto, Question!, YesNo!, 2) = 1 THEN
										Setnull(gs_serie);setnull(gi_numero);setnull(gi_rut)
										Setnull(gs_age);setnull(gs_sup);setnull(gs_jefe)
										cb_limpiar.triggerevent(clicked!)
										if gs_empresa = 'El Prado' then
											if gs_base='O' then
												em_serie.text	= 'I'
											elseif gs_base='U' then
												em_serie.text	= 'U'
											else
												em_serie.text	= 'I'
											end if
										elseif gs_empresa = 'La Foresta' then
											if gs_base='O' then
												em_serie.text	= 'S'
											elseif gs_base='U' then
												em_serie.text	= 'A'
											else
												em_serie.text	= 'S'
											end if
										elseif gs_empresa = 'Santiago' then
											em_serie.text	= 'T'
										end if
										em_serie.setfocus()
									else
										gs_nueva_oferta	= 'N'
										cb_aceptar.text 	= "Actualizar"
									END IF
								else
									rollback using sqlca;
									messagebox("Error Grabar","Error Grabar SQL: "+sqlca.sqlerrtext)
								end if
							END IF
						ELSE
							RollBack using SQLCA;
							messagebox("Error Grabar","Error Grabar SQL: "+sqlca.sqlerrtext)
						END IF
					END IF
				else
					messagebox("Advertencia","La Tasa es: "+string(ldb_tasa)+", debe ser Mayor o Igual a 0 y Menor a 10")
				end if
			END IF
		end if
	else
		messagebox("Advertencia","Debe Ingresar Contrato")
	end if
else
	em_numero.setfocus()
end if
end subroutine

public subroutine wf_comision (string serie, double numero, double pie, integer credito, string area, string tipo_construccion);Long		correlativo,ll_cod_parque
double 	c_pie,c_primera,c_segunda,c_tercera,c_cuarta,c_quinta ,c_sexta ,porce_comi ,c_septima, c_octava, c_novena

dw_oferta_v.accepttext()
ll_cod_parque	= dw_oferta_v.getitemnumber(1,'cadena_cod_parque')
if ll_cod_parque>0 then
	SELECT	SERIE,	NUMERO  
	INTO 		:serie,	:numero  
	FROM 		COMISION_PROMESA  
	WHERE    ( BASE = :gs_base ) AND ( SERIE = :serie ) AND ( NUMERO = :numero )   ;
//	IF credito = 1 THEN pie = 100
	if sqlca.sqlcode = 0 then
		if pie < 10 then
			SELECT	CORRELATIVO ,	C_PIE ,	C_PRIMERA ,	C_SEGUNDA ,	C_TERCERA ,	C_CUARTA ,	C_QUINTA ,	C_SEXTA  ,	C_SEPTIMA,  C_OCTAVA,	C_NOVENA,	(C_PIE + C_PRIMERA + C_SEGUNDA + C_TERCERA + C_CUARTA + C_QUINTA + C_SEXTA + C_SEPTIMA + C_OCTAVA + C_NOVENA) AS PORCENTAJE  
			INTO 		:correlativo,	:c_pie,	:c_primera,	:c_segunda,	:c_tercera,	:c_cuarta,	:c_quinta,	:c_sexta ,	:c_septima, :c_octava,	:c_novena,	:porce_comi 
			FROM 		PORCENTAJE_COMISIONES  
			WHERE  ( PIE_MIN <= :pie AND  PIE_MAX >= :pie) AND  
						AREA = :area AND T_CONS = :tipo_construccion AND ( CREDITO_MIN <= :credito AND CREDITO >= :credito ) AND
					 ( C_PIE + C_PRIMERA + C_SEGUNDA + C_TERCERA + C_CUARTA + C_QUINTA + C_SEXTA + C_SEPTIMA + C_OCTAVA + C_NOVENA) > 0 and 
					 	COD_PARQUE = :ll_cod_parque;
		elseif pie >= 10 then
			SELECT	CORRELATIVO ,	C_PIE ,	C_PRIMERA ,	C_SEGUNDA ,	C_TERCERA ,	C_CUARTA ,	C_QUINTA ,	C_SEXTA  ,	C_SEPTIMA,  C_OCTAVA,	C_NOVENA,	(C_PIE + C_PRIMERA + C_SEGUNDA + C_TERCERA + C_CUARTA + C_QUINTA + C_SEXTA + C_SEPTIMA + C_OCTAVA + C_NOVENA) AS PORCENTAJE  
			INTO 		:correlativo,	:c_pie,	:c_primera,	:c_segunda,	:c_tercera,	:c_cuarta,	:c_quinta,	:c_sexta ,	:c_septima, :c_octava, :c_novena,	:porce_comi 
			FROM 		PORCENTAJE_COMISIONES  
			WHERE  ( PIE_MIN <= :pie AND  PIE_MAX >= :pie) AND  
						AREA = :area AND T_CONS = :tipo_construccion AND
					 ( C_PIE + C_PRIMERA + C_SEGUNDA + C_TERCERA + C_CUARTA + C_QUINTA + C_SEXTA + C_SEPTIMA + C_OCTAVA + C_NOVENA) > 0  and 
					 	COD_PARQUE = :ll_cod_parque;
		end if
		if sqlca.sqlcode = 0 and not isnull(correlativo) then
			UPDATE	"COMISION_PROMESA"
			SET 		C_PIE     = :c_pie,
						C_PRIMERA = :c_primera,
						C_SEGUNDA = :c_segunda,
						C_TERCERA = :c_tercera,
						C_CUARTA  = :c_cuarta,
						C_QUINTA  = :c_quinta,
						C_SEXTA   = :c_sexta,
						C_SEPTIMA = :c_septima,
						C_OCTAVA  = :c_octava,
						C_NOVENA  = :c_novena
			where 	base = :gs_base and serie = :serie and numero = :numero
			USING		sqlca;
			if sqlca.sqlcode = 0 then
				commit using sqlca;
			else
				rollback using sqlca;
				messagebox("Error Comisiones","Error al Grabar COMISION_PROMESA SQL: "+sqlca.sqlerrtext+", Contrato Nº: "+'O-'+serie+'-'+string(numero,"###,###,###,###,###")+" Area: "+area+" Tipo Construccion: "+tipo_construccion+" Plazo: "+string(credito)+" Pie: "+string(pie))
			end if
		end if
	end if
end if
end subroutine

public subroutine wf_valida_contrato (string as_serie, double al_numero);string		is_serie2,ls_estado
long 		ll_cant,ll_cant_benef,ll_resp,ll_count_reg,ll_estado,ll_tipo_seguro,ll_count_1,ll_count_2,ll_cod_seguro,ll_estado_reg,	ll_count,ll_tot_reg,ll_indi,ll_reg,ll_promocion,&
			ll_cod_parque
double 	ld_valor_uf,ldb_monto

SELECT	"CD_FOLIO"."SERIE",	"CD_FOLIO"."COD_AGENTE",	"CD_FOLIO"."COD_SUPERVISOR",	"CD_FOLIO"."COD_JEFE_VENTA",	"CADENA"."RUT",	"CADENA"."ESTADO" 
INTO 		:is_serie2,				:gs_age,							:gs_sup,								:gs_jefe,							:gi_rut,				:ls_estado
FROM		"CD_FOLIO",	"CADENA"  
WHERE  ( cd_folio.base = cadena.codigo (+)) and  
		 ( cd_folio.serie = cadena.serie (+)) and  
		 ( cd_folio.numero = cadena.numero (+)) and  
		 (("CD_FOLIO"."BASE" = :gs_base ) AND  
		 ( "CD_FOLIO"."SERIE" = :as_serie ) AND  
		 ( "CD_FOLIO"."NUMERO" = :al_numero ) )   
USING		sqlca;
if sqlca.sqlcode=0 then
	IF as_serie = is_serie2 THEN
		is_pasa_asigna					= 'N'
		gi_numero						= al_numero
//		gs_base 							= "O"
		ll_cant 							= dw_oferta_v.Retrieve(as_serie,gi_numero)
		if ll_cant>0 then
//			if dw_oferta_v.getitemnumber(1,'pago_oferta_factura') = 99 then
//				cb_aceptar.enabled	= false
//			else
//				cb_aceptar.enabled	= true
//			end if
			gs_jefe						= dw_oferta_v.getitemstring(1,'cod_jef')
			gs_sup						= dw_oferta_v.getitemstring(1,'cod_sup')
			gs_age						= dw_oferta_v.getitemstring(1,'cod_age')
			ll_promocion				= dw_oferta_v.getitemnumber(1,'oferta_v_beneficio_complementario')
			ll_cod_parque				= dw_oferta_v.getitemnumber(1,'cadena_cod_parque')
			if ll_promocion > 0 then 
				pb_promociones.enabled		= true
			else
				pb_promociones.enabled		= false
			end if
			ll_tot_reg					= dw_seguro.retrieve(ll_cod_parque,gs_base)
			if ll_tot_reg > 0 then
				for ll_indi=1 to ll_tot_reg
					dw_seguro.setitem(ll_indi,'c_estado_reg',1)
				next
				dw_seguro.accepttext()
			end if
			
			SELECT		COUNT("SEGURO_ASOCIADOS"."COD_SEGURO")
			INTO			:ll_count
			FROM 		"SEGURO_ASOCIADOS"  
			WHERE 	  ( "SEGURO_ASOCIADOS"."BASE" = :gs_base ) AND  
						  ( "SEGURO_ASOCIADOS"."SERIE" = :as_serie ) AND  
						  ( "SEGURO_ASOCIADOS"."NUMERO" = :gi_numero ) AND  
						  ( "SEGURO_ASOCIADOS"."ESTADO_SEGURO" = 'A' )   ;
			if ll_count > 0 then
				DECLARE x1 CURSOR FOR  
				SELECT		"SEGURO_ASOCIADOS"."COD_SEGURO",   
								"SEGURO_ASOCIADOS"."MONTO_PRIMA",   
								"SEGURO_ASOCIADOS"."ESTADO_REG"  
				FROM 		"SEGURO_ASOCIADOS"  
				WHERE 	  ( "SEGURO_ASOCIADOS"."BASE" = :gs_base ) AND  
							  ( "SEGURO_ASOCIADOS"."SERIE" = :as_serie ) AND  
							  ( "SEGURO_ASOCIADOS"."NUMERO" = :gi_numero ) AND  
							  ( "SEGURO_ASOCIADOS"."ESTADO_SEGURO" = 'A' )   
				USING		sqlca;
				open x1;
				if sqlca.sqlcode=0 then
					do while sqlca.sqlcode=0
						Fetch x1 into :ll_cod_seguro, :ldb_monto, :ll_estado_reg;
						if not isnull(ll_cod_seguro) then
							if ll_estado_reg = 0 then
								ll_reg = dw_seguro.Find("codigo = "+string(ll_cod_seguro), 1, dw_seguro.RowCount())
								if ll_reg > 0 then
									dw_seguro.setitem(ll_reg,'c_estado_reg',0)
								end if
							end if
						end if
						setnull(ll_cod_seguro)
					loop
				end if
				close x1;
				dw_seguro.accepttext()
			end if
		end if
		dw_seguro.enabled			= true
		dw_agente.setitem(1,'agente',gs_age)
		dw_supervisor.setitem(1,'supervisores',gs_sup)
		dw_jefe.setitem(1,'jefes',gs_jefe)
		dw_agente.accepttext()
		dw_supervisor.accepttext()
		dw_jefe.accepttext()
		IF ll_cant = 0 THEN
			wf_ingresar_nueva_oferta()
			gs_nueva_oferta				= 'S'
		ELSE
			wf_mostrar_oferta()
			gs_nueva_oferta				= 'N'
		END IF
		SELECT	Count("PAGARE_V"."SERIE")  
		INTO 		:ll_count_reg  
		FROM 		"PAGARE_V"  
		WHERE  ( "PAGARE_V"."SERIE" = :as_serie ) AND  
				 ( "PAGARE_V"."NUMERO" = :gi_numero )   
		Using		sqlca;
		if ll_count_reg>0 then 
			st_pagare.italic			= true
		else
			st_pagare.italic			= false
		end if
		SELECT	COUNT("CD_FOLIO_DETALLE"."BASE")  
		INTO 		:ll_count_reg  
		FROM 		"CD_FOLIO_DETALLE"  
		WHERE  ( "CD_FOLIO_DETALLE"."BASE" = :gs_base ) AND  
				 ( "CD_FOLIO_DETALLE"."SERIE" = :as_serie ) AND  
				 ( "CD_FOLIO_DETALLE"."NUMERO" = :gi_numero ) AND
				 ( "CD_FOLIO_DETALLE"."ESTADO" = 99 )
		USING		sqlca;
		if ll_count_reg>0 then
			st_memo.italic			= true
		else
			st_memo.italic			= false
		end if
		dw_agente.setfocus()
	ELSE
		if gs_base='O' then
			ll_resp	= MessageBox("Advertencia Asignación de Promesa", "Promesa NO asignada, desea Ingresarla",Exclamation!, YesNo!, 2)
		elseif gs_base='U' then
			ll_resp	= MessageBox("Advertencia Asignación de Promesa", "Columbario NO asignada, desea Ingresarla",Exclamation!, YesNo!, 2)
		end if
		IF ll_resp = 1 THEN
			gs_nueva_oferta				= 'S'
			is_pasa_asigna					= 'S'
			Setnull(gi_rut);setnull(gs_age);setnull(gs_sup);setnull(gs_jefe)
			wf_limpiar()
//			gs_base 							= "O"
			em_rut.enabled				= true
			em_dv.enabled					= true
			dw_agente.enabled			= true
			dw_supervisor.enabled		= true
			dw_jefe.enabled				= true
			dw_agente.reset()
			dw_supervisor.reset()
			dw_jefe.reset()
			dw_agente.insertrow(0)
			dw_supervisor.insertrow(0)
			dw_jefe.insertrow(0)
			em_rut.text						= ''
			em_dv.text						= ''
			em_rut.setfocus()
		ELSE
			dw_oferta_v.enabled			= false
			dw_clientes.enabled			= false
			dw_agente.enabled			= false
			dw_supervisor.enabled		= false
			dw_jefe.enabled				= false
			em_rut.text						= ''
			em_dv.text						= ''
			gs_nueva_oferta				= 'N'
			is_pasa_asigna					= 'N'
			em_rut.enabled				= false
			em_dv.enabled					= false
			setnull(gi_rut);setnull(gs_serie);setnull(gi_numero)
			setnull(gs_age);setnull(gs_sup);setnull(gs_jefe)
			wf_limpiar()
			em_numero.setfocus()
		END IF
	END IF
	ll_tipo_seguro	= dw_oferta_v.getitemnumber(1, "pago_oferta_codigo_tipo_seguro")
	if isnull(ll_tipo_seguro) then 
		dw_oferta_v.setitem(1, "pago_oferta_codigo_tipo_seguro",0)
		dw_oferta_v.accepttext()
	end if
	SELECT	Count("BENEFICIARIOS_SEGURO"."BASE")  
	INTO 		:ll_count_1  
	FROM 		"BENEFICIARIOS_SEGURO"  
	WHERE  ( "BENEFICIARIOS_SEGURO"."BASE" = :gs_base ) AND  
			 ( "BENEFICIARIOS_SEGURO"."SERIE" = :gs_serie ) AND  
			 ( "BENEFICIARIOS_SEGURO"."NUMERO" = :gi_numero )   
	USING		sqlca;
	if ll_count_1 > 0 then
		w_ingresar_oferta.dw_oferta_v.object.t_seguro.font.italic = 1
	end if
	SELECT	Count("SEGURO_RENTA_DECESO"."BASE_CTTO_ORIGINAL")  
	INTO 		:ll_count_2  
	FROM 		"SEGURO_RENTA_DECESO"  
	WHERE  ( "SEGURO_RENTA_DECESO"."BASE_CTTO_ORIGINAL" = :gs_base ) AND  
			 ( "SEGURO_RENTA_DECESO"."SERIE_CTTO_ORIGINAL" = :gs_serie ) AND  
			 ( "SEGURO_RENTA_DECESO"."NUMERO_CTTO_ORIGINAL" = :gi_numero )   
	USING		sqlca;
	if ll_count_2 > 0 then
		w_ingresar_oferta.dw_oferta_v.object.pago_oferta_codigo_tipo_seguro.font.italic = 1
	end if
else
	is_pasa_asigna					= 'N'
	gi_numero						= al_numero
//	gs_base 							= "O"
	ll_cant 							= dw_oferta_v.Retrieve(as_serie,gi_numero)
	if ll_cant>0 then
		gs_jefe						= dw_oferta_v.getitemstring(1,'cod_jef')
		gs_sup						= dw_oferta_v.getitemstring(1,'cod_sup')
		gs_age						= dw_oferta_v.getitemstring(1,'cod_age')
		ll_promocion				= dw_oferta_v.getitemnumber(1,'oferta_v_promocion')
			if ll_promocion > 0 then 
				pb_promociones.enabled		= true
			else
				pb_promociones.enabled		= false
			end if
		dw_agente.setitem(1,'agente',gs_age)
		dw_supervisor.setitem(1,'supervisores',gs_sup)
		dw_jefe.setitem(1,'jefes',gs_jefe)
		dw_agente.accepttext()
		dw_supervisor.accepttext()
		dw_jefe.accepttext()
		IF ll_cant = 0 THEN
			wf_ingresar_nueva_oferta()
			gs_nueva_oferta				= 'S'
		ELSE
			wf_mostrar_oferta()
			gs_nueva_oferta				= 'N'
		END IF
		SELECT	Count("PAGARE_V"."SERIE")  
		INTO 		:ll_count_reg  
		FROM 		"PAGARE_V"  
		WHERE  ( "PAGARE_V"."SERIE" = :as_serie ) AND  
				 ( "PAGARE_V"."NUMERO" = :gi_numero )   
		Using		sqlca;
		if ll_count_reg>0 then 
			st_pagare.italic			= true
		else
			st_pagare.italic			= false
		end if
		dw_agente.setfocus()
	else
		messagebox("Advertencia","Contrato Nº: "+gs_base+gs_serie+'-'+string(al_numero,"###,###,###,###")+" No Existe")
		cb_limpiar.triggerevent(clicked!)
		em_numero.setfocus()
	end if
end if
end subroutine

public subroutine wf_sap_validacion ();string		ls_cod_age,ls_cod_sup,ls_cod_jef,ls_cargo,ls_codigo,ls_tipo_sepul,ls_tipo_cons,ls_sociedad,ls_cod_material,ls_centro,ls_anno
long		ll_cod_parque,ll_capac,ll_disponib

dw_oferta_v.accepttext()

ll_cod_parque							= dw_oferta_v.getitemnumber(1,'cadena_cod_parque')
ls_cod_age								= dw_oferta_v.getitemstring(1,'cod_age')
if not isnull(ls_cod_age) and ls_cod_age<>'' then
	ls_cargo                                 = 'A'
	ls_codigo                                = f_sap_tabla_vtas_cargo(ls_cargo,ls_cod_age)
	if isnull(ls_codigo) then ls_codigo='nulo' 
	if ls_codigo<>ls_cod_age then
   		f_sap_correo_validacion('C','AGE',ll_cod_parque,ls_cod_age)
	end if
end if

ls_cod_sup								= dw_oferta_v.getitemstring(1,'cod_sup')
if not isnull(ls_cod_sup) and ls_cod_sup<>'' then
	ls_cargo                                 = 'S'
	ls_codigo                                = f_sap_tabla_vtas_cargo(ls_cargo,ls_cod_sup)
	if isnull(ls_codigo) then ls_codigo='nulo' 
	if ls_codigo<>ls_cod_sup then
   		f_sap_correo_validacion('C','SUP',ll_cod_parque,ls_cod_sup)
	end if
end if

ls_cod_jef								= dw_oferta_v.getitemstring(1,'cod_jef')
if not isnull(ls_cod_jef) and ls_cod_jef<>'' then
	ls_cargo                                 = 'J'
	ls_codigo                                = f_sap_tabla_vtas_cargo(ls_cargo,ls_cod_jef)
	if isnull(ls_codigo) then ls_codigo='nulo' 
	if ls_codigo<>ls_cod_jef then
   		f_sap_correo_validacion('C','JEF',ll_cod_parque,ls_cod_jef)
	end if
end if
	
ls_tipo_sepul							= dw_oferta_v.getitemstring(1,'tipo_sepult')
ls_tipo_cons								= dw_oferta_v.getitemstring(1,'tipo_cons')
ll_capac									= dw_oferta_v.getitemnumber(1,'pago_oferta_capacidad')
ls_anno									= string(year(date(dw_oferta_v.getitemdatetime(1,'fecha'))))

if not isnull(ls_tipo_sepul) and ls_tipo_sepul<>'' and not isnull(ls_tipo_cons) and ls_tipo_cons<>'' and not isnull(ll_capac) and ll_capac<>0 then
	if gs_base= 'O' or gs_base='U' then
		ls_sociedad						= 'CL02'
	elseif gs_base= 'F' then
		ls_sociedad						= 'CL04'
	end if
							
	SELECT	"SAP_UBS"."CODIGO_MATERIAL_SAP"  
    	INTO 		:ls_cod_material  
	FROM		"SAP_UBS"  
	WHERE	"SAP_UBS"."TIPO_SEPULT" = :ls_tipo_sepul AND  
				"SAP_UBS"."TIPO_CONS" = :ls_tipo_cons AND  
				"SAP_UBS"."CAPACIDAD" = :ll_capac
	USING	sqlca;

	SELECT	"CENTRO_COMPRA"
	INTO		:ls_centro
	FROM		"SAP_CENTRO_COMPRA"  
	WHERE	"SAP_CENTRO_COMPRA"."COD_PARQUE" = :ll_cod_parque and
				"SAP_CENTRO_COMPRA"."SOCIEDAD" = :ls_sociedad
	USING	sqlca;
							
	ll_disponib							= f_sap_material_sap(ls_centro,ls_anno,ls_cod_material)
	if ll_disponib=0 then
		f_sap_correo_validacion('U',ls_cod_material,ll_cod_parque,'')
	end if
end if
			


end subroutine

public subroutine wf_revision_contrato ();string		ls_moneda,ls_forma_pago,ls_area,ls_tipo_sepult,ls_uso,ls_origen_vta,ls_fecha,ls_ok
long		ll_capacidad,ll_plazo,ll_cod_parque,ll_reduccion,ll_tipo_producto,ll_existe
datetime	ldt_fecha_ctto,ldt_fecha_prim
double	ldb_uf_ctto,ldb_pie,ldb_gasto_adm,ldb_derecho_esp,ldb_valor_cuota_mant,ldb_saldo_financiar,ldb_valor_cuota,ldb_precio_ctto,ldb_factor_cuota,ldb_int_peso,ldb_int_uf

//wf_revision_contrato()
SELECT	count("CADENA"."CODIGO")
INTO 		:ll_existe  
FROM 	"CADENA"  
WHERE 	"CADENA"."CODIGO" = :gs_base AND  
			"CADENA"."SERIE" = :gs_serie AND  
			"CADENA"."NUMERO" = :gi_numero    
USING	sqlca;
if isnull(ll_existe) then ll_existe=0

if ll_existe=0 then
	SELECT	"FECHA_CTTO",	"UF_FECHA_CTTO",	"MONEDA",	"FORMA_PAGO",	"AREA",	"TIPO_SEPULT",	"CAPACIDAD",	"USO",	"PIE",		"PLAZO",	"FECHA_PRIM",		"GASTO_ADM",		"DERECHO_ESPECIAL",	"VALOR_CUOTA_MANT",		"SALDO_FINANCIAR",	"VALOR_CUOTA",	"PRECIO_CONTRATO",	"FACTOR_CUOTA",	"COD_PARQUE",	"REDUCCION",	"ORIGEN_VENTA",	"TIPO_PRODUCTO"
	INTO 		:ldt_fecha_ctto,		:ldb_uf_ctto,			:ls_moneda,	:ls_forma_pago,	:ls_area,	:ls_tipo_sepult,		:ll_capacidad,	:ls_uso,	:ldb_pie,	:ll_plazo,	:ldt_fecha_prim,	:ldb_gasto_adm,	:ldb_derecho_esp,			:ldb_valor_cuota_mant,		:ldb_saldo_financiar,	:ldb_valor_cuota,	:ldb_precio_ctto,			:ldb_factor_cuota,		:ll_cod_parque,		:ll_reduccion,	:ls_origen_vta,		:ll_tipo_producto
	FROM 	"REVISION_CONTRATOS"  
	WHERE  	"REVISION_CONTRATOS"."BASE" = :gs_base AND  
				"REVISION_CONTRATOS"."SERIE" = :gs_serie AND  
				"REVISION_CONTRATOS"."NUMERO" = :gi_numero 	//AND
//				"REVISION_CONTRATOS"."ESTADO_REVISION" = 'V'   
	USING		sqlca;
	if sqlca.sqlcode=0 then
		dw_oferta_v.SetItem(1,'fecha',ldt_fecha_ctto)
		dw_oferta_v.SetItem(1,'pago_oferta_uf_dia',ldb_uf_ctto)
		dw_oferta_v.SetItem(1,'pago_oferta_moneda',ls_moneda)
		dw_oferta_v.SetItem(1,'forma_pago',ls_forma_pago)
		dw_oferta_v.SetItem(1,'pago_oferta_area',ls_area)
		dw_oferta_v.SetItem(1,'tipo_sepult',ls_tipo_sepult)
		
		dw_oferta_v.SetItem(1,'oferta_v_tipo_producto',ll_tipo_producto)
		
		wf_tipo_producto_campo(ll_tipo_producto)	
		
		dw_oferta_v.SetItem(1,'pago_oferta_n_reduccion',string(ll_reduccion))
		dw_oferta_v.SetItem(1,'tipo_venta',ls_origen_vta)
		if ls_tipo_sepult = '1' then
			dw_oferta_v.setitem(1,'tipo_cons','T')
		end if
		if ls_tipo_sepult = '2' or ls_tipo_sepult = '3' or ls_tipo_sepult = '4' or ls_tipo_sepult = '5' or ls_tipo_sepult = '8' then
			dw_oferta_v.setitem(1,'tipo_cons','C')
		end if	
		dw_oferta_v.SetItem(1,'pago_oferta_capacidad',ll_capacidad)
		dw_oferta_v.SetItem(1,'uso',ls_uso)
		dw_oferta_v.SetItem(1,'pago_oferta_pie',ldb_pie)
		if ldb_pie > 0 then
			dw_oferta_v.SetItem(1,'pago_oferta_fecha_pie',ldt_fecha_ctto)
		end if
		dw_oferta_v.SetItem(1,'pago_oferta_nro_cuotas',ll_plazo)
		dw_oferta_v.SetItem(1,'pago_oferta_fecha_prim',ldt_fecha_prim)
		dw_oferta_v.SetItem(1,'pago_oferta_gastos_adm',ldb_gasto_adm)
		dw_oferta_v.SetItem(1,'pago_oferta_des_esp',ldb_derecho_esp)
		dw_oferta_v.SetItem(1,'valor_cuota_m',ldb_valor_cuota_mant)
//											dw_oferta_v.SetItem(1,'',ldb_saldo_financiar_rev)
		dw_oferta_v.SetItem(1,'pago_oferta_valor_cuota',ldb_valor_cuota)
		dw_oferta_v.SetItem(1,'pago_oferta_precio',ldb_precio_ctto)
//											dw_oferta_v.SetItem(1,'',ldb_factor_cuota_rev)
		dw_oferta_v.SetItem(1,'cadena_cod_parque',ll_cod_parque)
		if ll_cod_parque > 0 then
			dw_oferta_v.getchild('oferta_v_beneficio_complementario',idw_detalle2)
			idw_detalle2.settransobject(sqlca)
			idw_detalle2.retrieve(ll_cod_parque)
			idw_detalle3.retrieve(ll_cod_parque)
			idw_detalle4.retrieve(ll_cod_parque,gs_base)
		end if
		setnull(ls_fecha)
		ls_fecha			= f_fecha_vcto_mant( 13 ,  ldt_fecha_ctto )
		dw_oferta_v.setitem(1,'fecha_m',date(ls_fecha))
		setnull(ls_fecha)
		if ls_uso='NF' then
			ls_fecha			= f_fecha_vcto_prim( 7 ,  ldt_fecha_prim  )
			if not isnull(ls_fecha) and ls_fecha<>'//' and ls_fecha<>'' then
				dw_oferta_v.setitem(1,'pago_oferta_fecha_entre',date(ls_fecha))
			end if
		elseif ls_uso='NI' then
			dw_oferta_v.setitem(1,'pago_oferta_fecha_entre',ldt_fecha_ctto)
		end if
		setnull(ls_fecha)
		ls_fecha			= f_fecha_vcto_prim(  ll_plazo ,  ldt_fecha_prim  )
		if not isnull(ls_fecha) and ls_fecha<>'//' and ls_fecha<>'' then
			dw_oferta_v.setitem(1,'pago_oferta_fecha_ult',date(ls_fecha))
		end if
		SELECT	"INTERES_CUOTAS"."INTERES_PESOS",	"INTERES_CUOTAS"."INTERES_UF"
		INTO 		:ldb_int_peso,								:ldb_int_uf
		FROM 	"INTERES_CUOTAS"  
		WHERE 	"INTERES_CUOTAS"."NRO_CUOTAS" = :ll_plazo   
		USING	sqlca;
		if sqlca.sqlcode=0 then
			if dw_oferta_v.getitemstring(1,'forma_pago')='1' or dw_oferta_v.getitemstring(1,'forma_pago')='3' then
				ldb_int_peso	= 0
				ldb_int_uf		= 0
			end if
			if ls_moneda='1' then //peso
				dw_oferta_v.setitem(1,'pago_oferta_tasa_base',ldb_int_peso)
			elseif ls_moneda='2' then //UF
				dw_oferta_v.setitem(1,'pago_oferta_tasa_base',ldb_int_uf)
			end if
		end if
	end if
end if
ls_ok								= 'S'

dw_oferta_v.accepttext()
end subroutine

public subroutine wf_tipo_producto_campo (long al_tipo_producto);long	ll_codigo_benef
//wf_tipo_producto_campo(al_tipo_producto)

dw_oferta_v.accepttext()
SELECT	"LISTA_TIPO_PRODUCTO"."CODIGO_BENEFICIO"
INTO		:ll_codigo_benef
FROM 	"LISTA_TIPO_PRODUCTO"  
WHERE 	"LISTA_TIPO_PRODUCTO"."TIPO_PRODUCTO" = :al_tipo_producto AND  
			"LISTA_TIPO_PRODUCTO"."BENEFICIOS" = 'S'
USING	sqlca;
if isnull(ll_codigo_benef) then ll_codigo_benef=0 
dw_oferta_v.SetItem(1,'oferta_v_beneficio_complementario',ll_codigo_benef)
dw_oferta_v.accepttext()


if al_tipo_producto = 3 or al_tipo_producto = 4  then // INTEGRA o SB
	dw_oferta_v.object.oferta_v_beneficio_complementario.protect 	= 1
	dw_oferta_v.object.t_34.visible 											= false
	dw_oferta_v.object.t_33.visible 											= false
	dw_oferta_v.object.t_32.visible 											= false
	
	dw_oferta_v.object.t_6.visible 												= false
	dw_oferta_v.object.t_37.visible 											= false
	dw_oferta_v.object.t_38.visible 											= false
	dw_oferta_v.object.t_7.visible 												= false
	
	dw_oferta_v.object.oferta_v_promocion.visible 						= false
	dw_oferta_v.object.oferta_v_tipo_descuento.visible 					= false
	dw_oferta_v.object.oferta_v_descuento_por.visible 					= false
	dw_oferta_v.object.oferta_v_cod_convenio.visible 					= false
	dw_oferta_v.object.rut_institucional.visible 								= false
	dw_oferta_v.object.compute_0050.visible 								= false
	dw_oferta_v.object.oferta_v_dscto_planilla.visible 					= false
		
elseif al_tipo_producto = 2 then //convenio
	dw_oferta_v.object.oferta_v_beneficio_complementario.protect 	= 0
	dw_oferta_v.object.t_34.visible 											= false
	dw_oferta_v.object.t_33.visible 											= false
	dw_oferta_v.object.t_32.visible 											= false
	
	
	dw_oferta_v.object.t_6.visible 												= true
	dw_oferta_v.object.t_37.visible 											= true
	dw_oferta_v.object.t_38.visible 											= true
	dw_oferta_v.object.t_7.visible 												= true
	
	dw_oferta_v.object.oferta_v_promocion.visible 						= false
	dw_oferta_v.object.oferta_v_tipo_descuento.visible 					= false
	dw_oferta_v.object.oferta_v_descuento_por.visible 					= false
	dw_oferta_v.object.oferta_v_cod_convenio.visible 					= true
	dw_oferta_v.object.rut_institucional.visible 								= true
	dw_oferta_v.object.compute_0050.visible 								= true
	dw_oferta_v.object.oferta_v_dscto_planilla.visible 					= true

else	
	dw_oferta_v.object.oferta_v_beneficio_complementario.protect 	= 0						
	dw_oferta_v.object.t_34.visible 											= true
	dw_oferta_v.object.t_33.visible 											= true
	dw_oferta_v.object.t_32.visible 											= true
	
	dw_oferta_v.object.t_6.visible 												= true
	dw_oferta_v.object.t_37.visible 											= true
	dw_oferta_v.object.t_38.visible 											= true
	dw_oferta_v.object.t_7.visible 												= true
	
	dw_oferta_v.object.oferta_v_promocion.visible 						= true
	dw_oferta_v.object.oferta_v_tipo_descuento.visible 					= true
	dw_oferta_v.object.oferta_v_descuento_por.visible 					= true
	dw_oferta_v.object.oferta_v_cod_convenio.visible 					= true
	dw_oferta_v.object.rut_institucional.visible 								= true
	dw_oferta_v.object.compute_0050.visible 								= true
	dw_oferta_v.object.oferta_v_dscto_planilla.visible 					= true
	
end if
end subroutine

