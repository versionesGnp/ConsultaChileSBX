if isnull(ll_gastos_adm) 			then ll_gastos_adm=0
if isnull(ll_tasa) 					then ll_tasa=0
if isnull(ll_tasa_base) 				then ll_tasa_base=0
if isnull(ll_valor_cuota) 			then ll_valor_cuota=0
if isnull(ll_uf_dia) 					then ll_uf_dia=0
if isnull(ll_valor_cuota_m) 		then ll_valor_cuota_m=0
if isnull(ll_derecho_lib) 			then ll_derecho_lib=0
if isnull(ll_rut_institucional) 		then ll_rut_institucional=0
if isnull(ll_rut_aval) 				then ll_rut_aval=0
if isnull(ll_rut_funeraria) 			then ll_rut_funeraria=0
if isnull(ll_cod_parque) 			then ll_cod_parque=0
if isnull(ldt_fecha) 					then ldt_fecha=datetime(date("00/00/0000"),time("00:00:00"))
if isnull(ldt_fecha_prim) 			then ldt_fecha_prim=datetime(date("00/00/0000"),time("00:00:00"))
if isnull(ldt_fecha_ult) 			then ldt_fecha_ult=datetime(date("00/00/0000"),time("00:00:00"))
if isnull(ldt_fecha_pie) 			then Setnull(ldt_fecha_pie)//=datetime(date("00/00/0000"),time("00:00:00"))
if isnull(ldt_fecha_ingreso) 		then ldt_fecha_ingreso=datetime(date("00/00/0000"),time("00:00:00"))
if isnull(ldt_fecha_entre) 			then ldt_fecha_entre=datetime(date("00/00/0000"),time("00:00:00"))
if isnull(ldt_fecha_m) 				then ldt_fecha_m=datetime(date("00/00/0000"),time("00:00:00"))
if isnull(ll_descuento_por)		then ll_descuento_por=0
if isnull(ll_tipo_descuento)		then ll_tipo_descuento=0
if isnull(ll_promocion)				then ll_promocion=0
if isnull(ls_anexo_dacion)		then ls_anexo_dacion=''
if isnull(ll_cod_benef_comp)		then ll_cod_benef_comp=0
INSERT INTO "LOG_PROMESA"  
			( "SERIE",   "NRO_OFERTA",   "FECHA",   "FECHA_INGRESO",   "USUARIO_CREA",   "FECHA_CREA",   "UF_DIA",   "AREA",   "SECTOR",   "SEPULTURA",   "CAPACIDAD",   "TIPO_SEPULT",   "TIPO_CONS",   "N_REDUCCION",   "USO",   "MONEDA",   "DES_ESP",   "FORMA_PAGO",   "PRECIO",   "NRO_CUOTAS",   "PIE",   "FECHA_PIE",   "FECHA_PRIM",   "GASTOS_ADM",   "TASA",   "VALOR_CUOTA",   "FECHA_ULT",   "FECHA_ENTRE",   "TIPO_MANT",   "FECHA_M",   "VALOR_CUOTA_M",   "DERECHO_LIB",   "TIPO_VENTA",   "LUGAR_V",   "SALDO_FINANCIERO",   "RUT_INSTITUCIONAL",   "RUT_AVAL",   "RUT_FUNERARIA",   "COD_JEF",   "COD_SUP",   "COD_AGE",   "RUT",	"COD_PARQUE",		"TASA_BASE",	"DESCUENTO_POR",		"TIPO_DESCUENTO",		"PROMOCION",	"ANEXO_DACION",	"COD_BENEF_COMP",	"DICOM_SCORE", "TIPO_CLASIFICA_RENTA" )  
VALUES 	( :ls_serie, :ll_nro_oferta, :ldt_fecha,:ldt_fecha_ingreso,:gs_user,   		  :ldt_fecha_hoy, :ll_uf_dia, :ls_area, :ls_sector, :ls_sepultura, :ll_capacidad, :ls_tipo_sepult, :ls_tipo_cons, :ls_n_reduccion, :ls_uso, :ls_moneda, :ll_des_esp, :ls_forma_pago, :ll_precio, :ll_nro_cuotas, :ll_pie, :ldt_fecha_pie,:ldt_fecha_prim,:ll_gastos_adm, :ll_tasa, :ll_valor_cuota, :ldt_fecha_ult,:ldt_fecha_entre,:ls_tipo_mant, :ldt_fecha_m,:ll_valor_cuota_m, :ll_derecho_lib, :ls_tipo_venta, :ls_lugar_v, :ll_saldo_financiero, :ll_rut_institucional, :ll_rut_aval, :ll_rut_funeraria, :ls_cod_jef, :ls_cod_sup, :ls_cod_age, :ll_rut,	:ll_cod_parque,	:ll_tasa_base,	:ll_descuento_por,	:ll_tipo_descuento,	:ll_promocion,	:ls_anexo_dacion,	:ll_cod_benef_comp,	:ll_score,	:ll_tipo_clas_renta	 )  
USING		sqlca;
if sqlca.sqlcode=0 then
	commit using sqlca;
else
	rollback using sqlca;
end if
end subroutine

public subroutine wf_ingresar_nueva_oferta ();String	ls_null,ls_fecha
long		ll_null
Date		ld_null

cb_aceptar.text 			= 'Ingresar'
em_rut.enabled				= true
em_dv.enabled				= true
dw_clientes.reset()
dw_agente.reset()
dw_agente.insertrow(0)
dw_supervisor.reset()
dw_supervisor.insertrow(0)
dw_jefe.reset()
dw_jefe.insertrow(0)
dw_clientes.insertrow(0)
dw_oferta_v.InsertRow(0)
dw_oferta_v.SetItem(1, "serie", gs_serie)
dw_oferta_v.SetItem(1, "nro_oferta", gi_numero)
dw_oferta_v.SetItem(1, "ult_folio", 0)
dw_oferta_v.SetItem(1, "fecha", id_fecha_dia)
if not isnull(id_fecha_dia) then
	ls_fecha				= f_fecha_vcto_mant( 13 , datetime(id_fecha_dia))
	if not isnull(ls_fecha) and ls_fecha<>'//' and ls_fecha<>'' then
		dw_oferta_v.setitem(1,'fecha_m',date(ls_fecha))
	end if
end if
if (isnull(gi_numero) or gi_numero=0) and (isnull(gi_rut) or gi_rut=0) then
	em_rut.text					= ''
	em_dv.text					= ''
	dw_oferta_v.SetItem(1, "rut", ll_null)
end if
dw_oferta_v.SetItem(1, "cod_age_ant", gs_age)
dw_oferta_v.SetItem(1, "cod_age", gs_age)
dw_oferta_v.SetItem(1, "cod_sup", gs_sup)
dw_oferta_v.SetItem(1, "cod_jef", gs_jefe)
dw_oferta_v.SetItem(1, 'fecha_ingreso',id_fecha_dia)
dw_oferta_v.SetItem(1, "cod_emp", "0")
dw_oferta_v.SetItem(1, "contacto", gs_age)
dw_oferta_v.SetItem(1, "age_ant", "0")
dw_oferta_v.SetItem(1, "tipo_sepult", ls_null)
dw_oferta_v.SetItem(1, "oferta_v_tipo_producto", ll_null)

dw_oferta_v.SetItem(1, "tipo_cons", ls_null)
dw_oferta_v.SetItem(1, "tipo_venta", ls_null)
dw_oferta_v.SetItem(1, "uso", ls_null)
dw_oferta_v.SetItem(1, "tot_pagado", 0)
dw_oferta_v.SetItem(1, "cta_pag_s", 0)
dw_oferta_v.SetItem(1, "cta_pag_m", 0)
dw_oferta_v.SetItem(1, "valor_cuota_m", 0)
dw_oferta_v.SetItem(1, "fecha_m", id_fecha_dia)
dw_oferta_v.SetItem(1, "abono_c", 0)
dw_oferta_v.SetItem(1, "abono_m", 0)
dw_oferta_v.SetItem(1, "tot_pagado_m", 0)
dw_oferta_v.SetItem(1, "abono_d", 0)
dw_oferta_v.SetItem(1, "lugar_v", ls_null)
dw_oferta_v.SetItem(1, "titulo", "0")
dw_oferta_v.SetItem(1, "estado_comi", "N")
dw_oferta_v.SetItem(1, "estado_premio", "N")
dw_oferta_v.SetItem(1, "estado_comi_sup", "N")
dw_oferta_v.SetItem(1, "usuario", gs_user)
dw_oferta_v.SetItem(1, "forma_pago", ls_null)
dw_oferta_v.SetItem(1, "fecha_cierre", ld_null)
dw_oferta_v.SetItem(1, "uf_cierre", 0)
dw_oferta_v.SetItem(1, "fecha_com", ld_null)
dw_oferta_v.SetItem(1, "total_com", 0)
dw_oferta_v.SetItem(1, "por_ingre", 0)
dw_oferta_v.SetItem(1, "porce_ing", 0)
dw_oferta_v.SetItem(1, "tipo_mant", "N")
dw_oferta_v.SetItem(1, "nro_resc", "0")
dw_oferta_v.SetItem(1, "origen", ls_null)
dw_oferta_v.SetItem(1, "estado", "0")
dw_oferta_v.SetItem(1, "porce_venta", 0)
dw_oferta_v.SetItem(1, "porce_ubicacion", 0)
dw_oferta_v.SetItem(1, "porce_adicional", 0)
dw_oferta_v.SetItem(1, "porce_manperpe", 0)
dw_oferta_v.SetItem(1, "porce_sup", 1)
dw_oferta_v.Object.rut_institucional.TabSequence		= 0
dw_oferta_v.Object.compute_0050.TabSequence 				= 0	
dw_oferta_v.SetItem(1, "pago_oferta_serie", gs_serie)
dw_oferta_v.SetItem(1, "pago_oferta_nro_oferta", gi_numero)
dw_oferta_v.SetItem(1, "pago_oferta_fecha", id_fecha_dia)
dw_oferta_v.SetItem(1, "pago_oferta_folio", 0)
dw_oferta_v.SetItem(1, "pago_oferta_precio", 0)
dw_oferta_v.SetItem(1, "pago_oferta_pie", 0)
dw_oferta_v.SetItem(1, "pago_oferta_tasa", 0)
dw_oferta_v.SetItem(1, "pago_oferta_tasa_base", 0)
dw_oferta_v.SetItem(1, "pago_oferta_capacidad", 0)
dw_oferta_v.SetItem(1, "pago_oferta_n_reduccion", ls_null)
dw_oferta_v.SetItem(1, "pago_oferta_valor_cuota", 0)
dw_oferta_v.SetItem(1, "pago_oferta_des_esp", 0)
dw_oferta_v.SetItem(1, "pago_oferta_nro_cuotas", 0)
dw_oferta_v.SetItem(1, "pago_oferta_uf_dia", gd_uf_dia)
dw_oferta_v.SetItem(1, "pago_oferta_moneda", ls_null)
dw_oferta_v.SetItem(1, "pago_oferta_fecha_prim", ld_null)
dw_oferta_v.SetItem(1, "pago_oferta_fecha_ult", ld_null)
dw_oferta_v.SetItem(1, "pago_oferta_fecha_entre", ld_null)
dw_oferta_v.SetItem(1, "pago_oferta_fecha_pie", ld_null)
dw_oferta_v.SetItem(1, "pago_oferta_modificado", gs_user)
dw_oferta_v.SetItem(1, "pago_oferta_fecha_mod", id_fecha_dia)
dw_oferta_v.SetItem(1, "pago_oferta_area", ls_null)
dw_oferta_v.SetItem(1, "pago_oferta_parque", gl_cod_parque)
dw_oferta_v.SetItem(1, "pago_oferta_sector", "0")
dw_oferta_v.SetItem(1, "pago_oferta_sepultura", ls_null)
dw_oferta_v.SetItem(1, "pago_oferta_derecho_lib", 0)
dw_oferta_v.SetItem(1, "pago_oferta_gastos_adm", 0)
dw_oferta_v.SetItem(1, "pago_oferta_factura", 0)
dw_oferta_v.SetItem(1, 'oferta_v_promocion',0)
dw_oferta_v.SetItem(1, 'oferta_v_tipo_descuento',0)
dw_oferta_v.SetItem(1, "pago_oferta_fecha_fact", ld_null)
dw_oferta_v.SetItem(1, "pago_oferta_total_fact", 0)
dw_oferta_v.SetItem(1, "pago_oferta_carta_bienv", "N")
dw_oferta_v.SetItem(1, "pago_oferta_pie_pagado", 0)
if gi_rut>0 then
	dw_clientes.Retrieve(gi_rut)
	dw_oferta_v.SetItem(1,"compute",upper(dw_clientes.GetItemstring(1,"dv")))
	em_rut.text		= string(gi_rut)
	em_dv.text		= string(upper(dw_clientes.GetItemstring(1,"dv")))
	dw_agente.setitem(1,'agente',gs_age)
	dw_supervisor.setitem(1,'supervisores',gs_sup)
	dw_jefe.setitem(1,'jefes',gs_jefe)
end if
em_rut.setfocus()
end subroutine

public function double f_comision_age2 (string as_tipo_sep, string as_area, integer an_capacidad, string as_uso);double ld_porce_nf, ld_porce_ni

SELECT		"COMISIONES_INMOBI"."PORCE_NF",   	"COMISIONES_INMOBI"."PORCE_NI"  
INTO   		:ld_porce_nf,									:ld_porce_ni
FROM 		"COMISIONES_INMOBI"  
WHERE  		( "COMISIONES_INMOBI"."TIPO_SEP" = :as_tipo_sep ) AND  
				( "COMISIONES_INMOBI"."AREA" = :as_area ) AND  
				( "COMISIONES_INMOBI"."CAPACIDAD" = :an_capacidad );    

IF as_uso = "NF" THEN
	RETURN ld_porce_nf
ELSE
	RETURN ld_porce_ni
END IF

RETURN 0

end function

public function double f_comision_sup1 (string as_area);double ld_porce

SELECT	comi_sup.com
INTO 		:ld_porce
FROM 		comi_sup
WHERE   (comi_sup.area = :as_area);

RETURN ld_porce

end function

public function integer f_tipo_contrato (string as_agente);integer li_tipo_cont

SELECT	"AGENTES"."TIPO_CONT"  
INTO 		:li_tipo_cont
FROM 	"AGENTES"  
WHERE 	"AGENTES"."COD_AGE" = :as_agente;
	
RETURN li_tipo_cont


end function

public subroutine wf_mostrar_oferta ();String	ls_area,ls_moneda,ls_tipo_sepultura,ls_uso,ls_tipo_construc,ls_string
Long		ll_capacidad,ll_cod_parque,ll_tipo_producto
Double	ldb_uf
date		ldt_fecha_ctto

cb_aceptar.text 			= "Actualizar"
gi_rut 						= Long(dw_oferta_v.GetItemNumber(1, "rut"))
dw_clientes.Retrieve(gi_rut)
dw_oferta_v.SetItem(1,"compute",upper(dw_clientes.GetItemstring(1,"dv")))
em_rut.text					= string(gi_rut)
em_dv.text					= string(upper(dw_clientes.GetItemstring(1,"dv")))
em_rut.enabled			= false
em_dv.enabled				= false
dw_oferta_v.enabled		= true
dw_agente.enabled		= true
dw_supervisor.enabled	= true
dw_jefe.enabled			= true
if dw_oferta_v.GetItemstring(1, "tipo_venta") = '6' then
	dw_oferta_v.Object.rut_institucional.TabSequence		= 130
	dw_oferta_v.Object.compute_0050.TabSequence 			= 140
else
	dw_oferta_v.Object.rut_institucional.TabSequence 		= 0
	dw_oferta_v.Object.compute_0050.TabSequence 			= 0
end if

ll_capacidad			= dw_oferta_v.getitemnumber(1,'pago_oferta_capacidad')
ls_area				= dw_oferta_v.getitemstring(1,'pago_oferta_area')
ldb_uf					= double(dw_oferta_v.getitemnumber(1,'pago_oferta_uf_dia'))
ls_moneda			= dw_oferta_v.getitemstring(1,'pago_oferta_moneda')
ls_tipo_sepultura	= dw_oferta_v.getitemstring(1,'tipo_sepult')

ll_tipo_producto	= dw_oferta_v.getitemnumber(1,'oferta_v_tipo_producto')
wf_tipo_producto_campo(ll_tipo_producto)

ldt_fecha_ctto		= date(dw_oferta_v.getitemdatetime(1,'fecha'))
ls_uso				= trim(dw_oferta_v.getitemstring(1,'uso'))
ls_tipo_construc	= dw_oferta_v.getitemstring(1,'tipo_cons')
ll_cod_parque		= dw_oferta_v.getitemnumber(1,'cadena_cod_parque')
if ll_cod_parque>0 then
	dw_oferta_v.getchild('oferta_v_beneficio_complementario',idw_detalle2)
	idw_detalle2.settransobject(sqlca)
	idw_detalle2.retrieve(ll_cod_parque)
	idw_detalle3.retrieve(ll_cod_parque)
	idw_detalle4.retrieve(ll_cod_parque,gs_base)
end if
if not isnull(ll_capacidad) and ll_capacidad>0 and not isnull(ls_area) and not isnull(ldb_uf) and ldb_uf>0 and &
	not isnull(ls_moneda) and not isnull(ls_tipo_sepultura) and not isnull(ls_uso) and not isnull(ll_tipo_producto) then
	ls_string			= f_valida_precio(ls_tipo_sepultura,ls_area,ll_capacidad,ls_uso,ls_moneda,ldb_uf,ls_tipo_construc,ll_cod_parque,ll_tipo_producto,ldt_fecha_ctto)
	if ls_moneda='2' then //UF
		idb_precio			= double(substr(1,1,ls_string))
	else // peso
		idb_precio			= double(long(substr(1,1,ls_string)))
	end if
end if
//idb_precio					= dw_oferta_v.GetItemNumber(1, "pago_oferta_precio")
dw_oferta_v.setitem(1,'compute_0050',gf_obtener_dv(dw_oferta_v.GetItemNumber(1, "rut_institucional")))
dw_oferta_v.setitem(1,'compute_0053',gf_obtener_dv(dw_oferta_v.GetItemNumber(1, "rut_aval")))
dw_oferta_v.setitem(1,'compute_0055',gf_obtener_dv(dw_oferta_v.GetItemNumber(1, "rut_funeraria")))
dw_oferta_v.setitem(1,'compute',gf_obtener_dv(dw_oferta_v.GetItemNumber(1, "rut")))
end subroutine

public subroutine wf_limpiar ();long		ll_cant,ll_null,ll_tot_reg,ll_indi
date 		ld_null
string 	ls_null,ls_fecha

dw_oferta_v.enabled			= false
st_pagare.italic					= false
st_memo.italic					= false
em_rut.enabled				= false
em_dv.enabled					= false
pb_promociones.enabled		= false
dw_seguro.reset()
if gs_conexion = "Parque El Prado" then
	ll_tot_reg	= dw_seguro.retrieve(1,gs_base)
elseif gs_conexion = "Parque La Foresta" then
	ll_tot_reg	= dw_seguro.retrieve(11,gs_base)
end if
if ll_tot_reg > 0 then
	for ll_indi=1 to ll_tot_reg
		dw_seguro.setitem(ll_indi,'c_estado_reg',1)
	next
	dw_seguro.accepttext()
end if
dw_seguro.enabled			= false
dw_agente.reset()
dw_supervisor.reset()
dw_jefe.reset()
dw_agente.insertrow(0)
dw_supervisor.insertrow(0)
dw_jefe.insertrow(0)
dw_agente.enabled			= false
dw_supervisor.enabled		= false
dw_jefe.enabled				= false
if isnull(gd_uf_dia) then
	SELECT	"TAB_UF"."VALOR_UF"  
	INTO 		:gd_uf_dia  
	FROM 		"TAB_UF"  
	WHERE 	"TAB_UF"."FECHA_UF" = :id_fecha_dia   ;
end if
SetNull(ld_null);SetNull(ls_null);SetNull(ll_null)
dw_clientes.reset()
dw_clientes.insertrow(0)
idw_detalle.reset()
idw_detalle4.reset()
idw_detalle2.reset()
idw_detalle.insertrow(0)
idw_detalle2.insertrow(0)
idw_detalle4.insertrow(0)
dw_oferta_v.Reset()
cb_aceptar.text 	= "Ingresar"
dw_oferta_v.InsertRow(0)
dw_oferta_v.SetItem(1, "ult_folio", 0)
if isnull(gi_rut) or gi_rut=0  then
	dw_oferta_v.SetItem(1, "rut", ll_null)
	em_rut.text				= ls_null
else
	dw_oferta_v.SetItem(1, "rut", gi_rut)
	em_rut.text				= string(gi_rut)
end if
dw_oferta_v.SetItem(1, "cod_emp", "0")
dw_oferta_v.SetItem(1, "age_ant", "0")
dw_oferta_v.SetItem(1, "tipo_sepult", ls_null)
dw_oferta_v.SetItem(1, "oferta_v_tipo_producto", ll_null)

dw_oferta_v.SetItem(1, "tipo_cons", ls_null)
dw_oferta_v.SetItem(1, "tipo_venta", ls_null)
dw_oferta_v.SetItem(1, "uso", ls_null)
dw_oferta_v.SetItem(1, "tot_pagado", 0)
dw_oferta_v.SetItem(1, "fecha_ingreso", id_fecha_dia)
dw_oferta_v.SetItem(1, "fecha", id_fecha_dia)
if not isnull(id_fecha_dia) then
	if gs_conexion	= "Parque Santiago" then
