event clicked;String	ls_serie,ls_base
Double	ldb_suma_cuota,ldb_valor_pie,ll_numero

dw_oferta_v.accepttext()
ls_serie 		= trim(em_serie.Text)
ll_numero 	= Double(em_numero.text)
ls_base		= gs_base
if not isnull(ls_serie) and ll_numero>0 then
	SELECT	SUM("DETALLE_PAGO_PIE"."MONTO_CUOTA")
	INTO 		:ldb_suma_cuota  
	FROM 		"DETALLE_PAGO_PIE"  
	WHERE  ( "DETALLE_PAGO_PIE"."BASE" = :ls_base ) AND  
			 ( "DETALLE_PAGO_PIE"."SERIE" = :ls_serie ) AND  
			 ( "DETALLE_PAGO_PIE"."NUMERO" = :ll_numero )   
	USING		sqlca;
	if ldb_suma_cuota>0 and Double(em_numero.text)>0 then
		ldb_valor_pie	= double(dw_oferta_v.getitemnumber(1,'pago_oferta_pie'))
		if ldb_valor_pie<>ldb_suma_cuota then
			messagebox('Error','No coincide Valor Pie con las cuotas pactadas, la suma Pactada es: '+string(ldb_suma_cuota,"###,###,###,###,##0.0###"),stopsign!)
			dw_oferta_v.setfocus()
			dw_oferta_v.SetColumn('pago_oferta_pie')
		else
			if isvalid(w_listado_contrato) then close(w_listado_contrato)
			openwithparm(w_listado_contrato,gs_base)
		end if
	else
		if isvalid(w_listado_contrato) then close(w_listado_contrato)
		openwithparm(w_listado_contrato,gs_base)
	end if
else
	if isvalid(w_listado_contrato) then close(w_listado_contrato)
	openwithparm(w_listado_contrato,gs_base)
end if


end event

