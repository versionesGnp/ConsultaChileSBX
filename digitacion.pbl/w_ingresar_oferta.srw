event itemchanged;Long		ll_resp,ll_grabar_1=0,ll_grabar_2=1
String		ls_string,ls_obs,ls_tipo_cont,ls_age_aux,ls_sup_aux,ls_jefe_aux,ls_jefe,ls_cod_jefe,ls_fecha


dw_jefe.accepttext()
ls_cod_jefe	= dw_jefe.getitemstring(1,'jefes')
if not isnull(ls_cod_jefe) then
	if gi_rut>0 then
		is_sw_jef		= 'S'
		gs_serie 		= trim(em_serie.Text)
//		gs_base			= 'O'
		if gi_rut>0 then
			if is_pasa_asigna='S' then
				gs_age	= dw_agente.getitemstring(1,'agente')
				gs_sup	= dw_supervisor.getitemstring(1,'supervisores')
				gs_jefe	= dw_jefe.getitemstring(1,'jefes')
				SELECT DISTINCT	"JEFE_VENTAS"."JEFE_VENTAS"  
				INTO 		:ls_jefe  
				FROM 		"JEFE_VENTAS"  
				WHERE 	"JEFE_VENTAS"."JEFE_VENTAS" = :gs_jefe   
				USING		sqlca;
				if sqlca.sqlcode=0 then
					if isnull(gs_jefe) then
						messagebox("Advertencia","Debe Seleccionar Jefe Venta")
						dw_agente.setfocus()
					else
						dw_oferta_v.SetItem(1, "cod_jef", gs_jefe)
						dw_oferta_v.accepttext()
						if not isnull(gs_age) then il_resp_age=0
						if not isnull(gs_sup) then il_resp_sup=0
						if il_resp_age<>1 and il_resp_sup<>1 then
							if gs_nueva_oferta='S' and is_sw_jef='S' and gs_age<>'' and not isnull(gs_age) and not isnull(gs_sup) and gs_sup<>'' then
								ll_resp	= MessageBox("Advertencia", "Está seguro de ASIGNAR Promesa Nº "+gs_serie+'-'+string(gi_numero,"###,###,###,###"),Exclamation!, YesNo!, 2)
								IF ll_resp = 1 THEN
									ls_string	= gs_serie+'~t'+string(gi_numero)+'~t'+gs_age+'~t'+string(gdt_fec_sistema)+'~t'+string(gdt_fec_sistema)+'~t'+'V'+'~t'+ls_obs+'~t'+gs_sup+'~t'+gs_jefe
									openwithparm(w_verificar_datos_contrato,ls_string)
									IF trim(Message.StringParm)='OK' THEN
										ls_obs	= 'Promesa creada por '+gs_user+' el '+string(gdt_fec_sistema)
										if len(ls_obs)>50 then ls_obs=mid(ls_obs,1,50)
										wf_revision_contrato(); //REVISION_CONTRATO
										dw_oferta_v.accepttext()
										dw_oferta_v.enabled			= true
										dw_oferta_v.setfocus()
									else
										dw_oferta_v.enabled			= false
//										wf_cargar_codigo_originales()
										messagebox("Advertencia","NO fue Asignada Promesa Nº "+gs_base+'-'+gs_serie+'-'+string(gi_numero,"###,###,###,###"))
									end if
								else
//									wf_cargar_codigo_originales()
								END IF
							end if
						end if
					end if
					dw_oferta_v.setfocus()
				else
					messagebox("Advertencia","Jefe Venta Inexistente")
					dw_jefe.reset()
					dw_jefe.insertrow(0)
					dw_jefe.Setfocus()
					gs_jefe	= ''
				end if
			elseif is_pasa_asigna='N' and is_sw_jef='S' then
				gs_age	= dw_agente.getitemstring(1,'agente')
				gs_sup	= dw_supervisor.getitemstring(1,'supervisores')
				gs_jefe	= dw_jefe.getitemstring(1,'jefes')
				SELECT DISTINCT	"JEFE_VENTAS"."JEFE_VENTAS"  
				INTO 		:ls_jefe  
				FROM 		"JEFE_VENTAS"  
				WHERE 	"JEFE_VENTAS"."JEFE_VENTAS" = :gs_jefe   
				USING		sqlca;
				if sqlca.sqlcode=0 then
					if isnull(gs_jefe) then
						messagebox("Advertencia","Debe Seleccionar Jefe Venta")
						dw_agente.setfocus()
					else
						dw_oferta_v.SetItem(1, "cod_jef", gs_jefe)
						dw_oferta_v.accepttext()
						if is_sw_jef='S' and is_sw_jef='S' and gs_age<>'' and not isnull(gs_age) and not isnull(gs_sup) and gs_sup<>''  then//if il_resp_age=2 and il_resp_sup=2 and is_sw_jef='S' then
							ll_resp	= MessageBox("Advertencia", "Está seguro de ASIGNAR Promesa Nº "+gs_serie+'-'+string(gi_numero,"###,###,###,###"),Exclamation!, YesNo!, 2)
							IF ll_resp = 1 THEN
								ls_string	= gs_serie+'~t'+string(gi_numero)+'~t'+gs_age+'~t'+string(gdt_fec_sistema)+'~t'+string(gdt_fec_sistema)+'~t'+'V'+'~t'+ls_obs+'~t'+gs_sup+'~t'+gs_jefe
								openwithparm(w_verificar_datos_contrato,ls_string)
								IF trim(Message.StringParm)='OK' THEN
									ls_obs	= 'Promesa creada por '+gs_user+' el '+string(gdt_fec_sistema)
									if len(ls_obs)>50 then ls_obs=mid(ls_obs,1,50)
									dw_oferta_v.enabled			= true
									wf_revision_contrato() //REVISION_CONTRATO
									dw_oferta_v.setfocus()
								else
									dw_oferta_v.enabled			= false
//									wf_cargar_codigo_originales()
									messagebox("Advertencia","NO fue Asignada Promesa Nº "+gs_base+'-'+gs_serie+'-'+string(gi_numero,"###,###,###,###"))
								end if
							else
//								wf_cargar_codigo_originales()
							END IF
						end if
					end if
					dw_oferta_v.setfocus()
				else
					messagebox("Advertencia","Jefe Venta Inexistente")
					dw_jefe.reset()
					dw_jefe.insertrow(0)
					dw_jefe.Setfocus()
					gs_jefe	= ''
				end if
			end if
			if ll_grabar_1	= 1 and ll_grabar_2 = 1 then
				commit using sqlca;
				UPDATE	"OFERTA_V"  
				SET 		"COD_AGE" = :gs_age,   
							"COD_SUP" = :gs_sup,   
							"COD_JEF" = :gs_jefe  
				WHERE  ( "OFERTA_V"."SERIE" = :gs_serie ) AND  
						 ( "OFERTA_V"."NRO_OFERTA" = :gi_numero )   
				USING		sqlca;
				if sqlca.sqlcode=0 then
					commit;
				else
					rollback;
				end if
			else
				rollback using sqlca;
			end if
		end if
		this.accepttext()
	else
		messagebox("Advertencia","Recuerde antes de Asingar debe ingresar Rut Cliente")
		dw_jefe.reset()
		dw_jefe.insertrow(0)
		em_rut.setfocus()
	end if
end if
end event

