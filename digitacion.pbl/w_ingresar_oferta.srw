st_ver_funeraria.visible				= false
st_ver_institucion.visible				= false
st_ver_aval.visible						= false
st_imprimir.visible						= false
st_help_memo.visible					= false
st_buscar.visible						= false
st_help_cta_cte.visible				= false
st_help_seguro_2.visible				= false
st_help_porce_comi.visible			= false
st_help_beneficios.visible			= false
st_help_copropietario.visible		= false
st_funeraria.visible					= false
st_seg_fune.visible					= false
end event

event clicked;String	ls_serie,ls_base
Long		ll_rut_aux
Double	ldb_suma_cuota,ldb_valor_pie,ll_numero

dw_oferta_v.accepttext()
ls_serie 		= trim(em_serie.Text)
ll_numero 	= Double(em_numero.text)
ls_base		= gs_base

if not isnull(ls_serie) and ll_numero>0 then
	SELECT	SUM("DETALLE_PAGO_PIE"."MONTO_CUOTA")
	INTO 		:ldb_suma_cuota  
	FROM 		"DETALLE_PAGO_PIE"  
	WHERE  ( "DETALLE_PAGO_PIE"."BASE" = :ls_base ) AND  
			 ( "DETALLE_PAGO_PIE"."SERIE" = :ls_serie ) AND  
			 ( "DETALLE_PAGO_PIE"."NUMERO" = :ll_numero )   
	USING		sqlca;
	if ldb_suma_cuota>0 and Double(em_numero.text)>0 then
		ldb_valor_pie	= double(dw_oferta_v.getitemnumber(1,'pago_oferta_pie'))
		if round(ldb_valor_pie,2) <> round(ldb_suma_cuota,2) then
//			messagebox('Error','No coincide Valor Pie con las cuotas pactadas, la suma Pactada es: '+string(ldb_suma_cuota,"###,###,###,###,##0.0###"),stopsign!)
			dw_oferta_v.setfocus()
			dw_oferta_v.SetColumn('pago_oferta_pie')
		else
			//em_serie.text	= ''
			setnull(gl_cod_parque)
			em_numero.text	= ''
			if isnull(gi_rut) then
				em_rut.text		= ''
				em_dv.text		= ''
			end if
			
			is_pasa_asigna	= 'N'
			is_sw_age		= 'N'
			is_sw_sup		= 'N'
			is_sw_jef		= 'N'
			wf_limpiar()
		end if
	else
		//em_serie.text	= ''
		setnull(gl_cod_parque)
		em_numero.text	= ''
		em_rut.text		= ''
		em_dv.text		= ''
		is_pasa_asigna	= 'N'
		is_sw_age		= 'N'
		is_sw_sup		= 'N'
		is_sw_jef		= 'N'
		wf_limpiar()
	end if
else
	//em_serie.text	= ''
	setnull(gl_cod_parque)
	em_numero.text	= ''
	em_rut.text		= ''
	em_dv.text		= ''
	is_pasa_asigna	= 'N'
	is_sw_age		= 'N'
	is_sw_sup		= 'N'
	is_sw_jef		= 'N'
	wf_limpiar()
end if
end event

event getfocus;if trim(em_serie.text)='' then 
	em_serie.setfocus()
elseif trim(em_numero.text)='' then
	em_numero.setfocus()
end if
end event

