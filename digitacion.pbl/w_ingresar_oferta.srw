event ue_mousemove;st_limpiar.visible					= false
st_grabar.visible						= false
st_salir.visible						= false
st_help_pagare.visible				= false
st_seguro_complementario.visible	= false
st_ver_pie_pactado.visible			= false
st_ver_funeraria.visible			= false
st_ver_institucion.visible			= false
st_ver_aval.visible					= false
st_imprimir.visible					= false
st_help_memo.visible					= false
st_buscar.visible						= false
st_help_cta_cte.visible				= false
st_help_seguro_2.visible			= false
st_help_porce_comi.visible			= false
st_help_beneficios.visible			= false
end event

event modified;Date		ld_null
Double	ld_valor_uf
String	ls_null,ls_dv
Long		ll_null

SetNull(ld_null);SetNull(ls_null);SetNull(ll_null)
ls_dv		= trim(em_dv.text)
if ls_dv<>'' and not isnull(ls_dv) then 
	if String(this.text) <> String(gf_obtener_dv(long(em_rut.text))) then
		messagebox('Error','El Rut no es valido',stopsign!)
		dw_oferta_v.enabled		= false
		cb_aceptar.text 			= "Ingresar"
		dw_oferta_v.reset()
		dw_oferta_v.InsertRow(0)
		dw_oferta_v.Object.rut_institucional.TabSequence		= 0
		dw_oferta_v.Object.compute_0050.TabSequence 			= 0	
		dw_clientes.SetTransObject(SQLCA)
		dw_clientes.insertrow(0)
		Select	tab_uf.valor_uf
		into		:ld_valor_uf
		from 		tab_uf
		where 	tab_uf.fecha_uf = :id_fecha_dia;
		dw_oferta_v.SetItem(1, "pago_oferta_uf_dia", ld_valor_uf)
		em_rut.setfocus()	
	else
		gi_rut							= Long(em_rut.text)
		gs_serie 						= em_serie.Text
		gi_numero 					= Double(em_numero.text)
		dw_clientes.SetItem(il_fila, "rut", gi_rut)
		dw_clientes.SetItem(il_fila, "dv", trim(this.text))
		dw_oferta_v.SetItem(il_fila, "rut", gi_rut)
		dw_oferta_v.SetItem(il_fila, "compute", trim(this.text))
		dw_oferta_v.enabled		= true
		dw_seguro.enabled		= true
		dw_oferta_v.setfocus()
	end if
end if
end event

