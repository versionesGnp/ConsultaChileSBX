event clicked;string	ls_numero,ls_serie,ls_string
Double		ll_nro_aux
gs_serie 	= trim(em_serie.text)	//dw_oferta_v.getitemstring(1,'serie')
gi_numero	= Double(trim(em_numero.text))	//dw_oferta_v.getitemnumber(1,'nro_oferta')
ls_numero 	= trim(em_numero.text)	//string(dw_oferta_v.getitemnumber(1,'nro_oferta'))
if not isnull(gs_serie) and gs_serie<>'' and gi_numero>0 and not isnull(gs_age) and gs_age<>'' then
	SELECT	"CADENA"."NUMERO"  
	INTO 		:ll_nro_aux    
	FROM 		"CADENA"  
	WHERE  ( "CADENA"."SERIE" = :gs_serie ) AND  
			 ( "CADENA"."CODIGO" = :gs_base ) AND  
			 ( "CADENA"."NUMERO" = :gi_numero ) 
	USING		sqlca;
	if sqlca.sqlcode=0 then
		ls_string 	= gs_base+'~t'+gs_serie+'~t'+string(gi_numero)
		OpenWithParm(w_ingreso_cd_memorandum_digitacion,ls_string)
		w_ingreso_cd_memorandum_digitacion.setfocus()
	else
		messagebox("Advertencia","Antes de Ingresar Memorandum debería estar Digitado Promesa Nº "+gs_base+'-'+gs_serie+'-'+string(gi_numero,"####,###,###,##0"))
	end if
end if
end event

