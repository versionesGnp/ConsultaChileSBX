event modified;string		ls_serie, is_serie2,ls_estado,ls_descrip,ls_respuesta,ls_serie_aux
long 		ll_cant,ll_cant_benef,ll_resp,ll_count_reg,ll_estado,ll_ult_estado,ll_count_rev
double 	ld_valor_uf,ll_numero

if isvalid(w_ingresar_oferta) then 
	SetNull(gs_age);Setnull(gs_sup);Setnull(gs_jefe);setnull(gs_serie);setnull(gi_numero)
	ls_serie 		= trim(em_serie.Text)
	ll_numero 	= Double(em_numero.text)
//	gs_base		= 'O'
	gs_serie		= ls_serie
	gi_numero	= ll_numero
	
	if not isnull(gs_base) and gs_base<>'' and gs_serie<>'' and not isnull(gs_serie) and gi_numero>0 then
		SELECT	COUNT("REVISION_CONTRATOS"."BASE" )
    		INTO 		:ll_count_rev  
    		FROM 	"REVISION_CONTRATOS"  
   		WHERE 	"REVISION_CONTRATOS"."BASE" = :gs_base AND  
					"REVISION_CONTRATOS"."SERIE" = :gs_serie AND  
					"REVISION_CONTRATOS"."NUMERO" = :gi_numero
		USING	sqlca;
		if isnull(ll_count_rev) then ll_count_rev=0
		if ll_count_rev > 0 then
			SELECT	max(distinct "REVISION_CONTRATOS"."RUT") 
			INTO 		:gi_rut  
			FROM 	"REVISION_CONTRATOS"  
			WHERE 	"REVISION_CONTRATOS"."BASE" = :gs_base AND  
						"REVISION_CONTRATOS"."SERIE" = :gs_serie AND  
						"REVISION_CONTRATOS"."NUMERO" = :gi_numero
			USING	sqlca;
			em_rut.text												= string(gi_rut)
			em_rut.setfocus()
			em_rut.triggerevent(modified!)
		end if

		SELECT	Count("PAGARE_V"."SERIE")  
		INTO 		:ll_count_reg  
		FROM 	"PAGARE_V"  
		WHERE  	"PAGARE_V"."SERIE" = :gs_serie AND  
				 	"PAGARE_V"."NUMERO" = :gi_numero    
		Using		sqlca;
		if ll_count_reg>0 then 
			st_pagare.italic			= true
		else
			st_pagare.italic			= false
		end if
		SELECT	COUNT("CD_FOLIO_DETALLE"."BASE")  
		INTO 		:ll_count_reg  
		FROM 	"CD_FOLIO_DETALLE"  
		WHERE	"CD_FOLIO_DETALLE"."BASE" = :gs_base AND  
				 	"CD_FOLIO_DETALLE"."SERIE" = :gs_serie AND  
				 	"CD_FOLIO_DETALLE"."NUMERO" = :gi_numero AND
					"CD_FOLIO_DETALLE"."ESTADO" = 11  
		USING		sqlca;
		if ll_count_reg>0 then
			st_memo.italic			= true
		else
			st_memo.italic			= false
		end if
		if ll_numero >= gi_prim_nro_O_cd and gi_prim_nro_O_cd>0 then
			SELECT	"CD_FOLIO"."ULT_ESTADO",
						"CD_FOLIO"."COD_PARQUE"
			INTO 		:ll_estado,
						:gl_cod_parque
			FROM 		"CD_FOLIO"  
			WHERE	 ( "CD_FOLIO"."BASE" = :gs_base ) AND  
					 ( "CD_FOLIO"."SERIE" = :ls_serie ) AND  
					 ( "CD_FOLIO"."NUMERO" = :ll_numero )   
			USING		sqlca;
			if sqlca.sqlcode=0 then
				SELECT	"CD_ESTADO"."DESCRIPCION"  
				INTO 		:ls_descrip  
				FROM 		"CD_ESTADO"  
				WHERE 	"CD_ESTADO"."CODIGO" = :ll_estado   ;
				if ll_estado=9 then //VALIDAR MAS
					if not isnull(ls_serie) and ls_serie<>'' then
						if ll_numero>0 and not isnull(ll_numero) then
							wf_valida_contrato(ls_serie,ll_numero)
						end if
					else
						messagebox("Advertencia","Serie  ' "+ls_serie+" '  NO corresponde a Promesa")
						cb_limpiar.triggerevent(clicked!)
						em_serie.text	= 'I'
						em_serie.setfocus()
					end if
				elseif ll_estado=11 then
					if not isnull(ls_serie) and ls_serie<>'' then
						if ll_numero>0 and not isnull(ll_numero) then
							wf_valida_contrato(ls_serie,ll_numero)
						end if
					else
						messagebox("Advertencia","Serie  ' "+ls_serie+" '  NO corresponde a Promesa")
						cb_limpiar.triggerevent(clicked!)
						em_serie.text	= 'I'
						em_serie.setfocus()
					end if
				elseif isnull(ll_estado) then
					if not isnull(ls_serie) and ls_serie<>'' then
						if ll_numero>0 and not isnull(ll_numero) then
							wf_valida_contrato(ls_serie,ll_numero)
						end if
					else
						messagebox("Advertencia","Serie  ' "+ls_serie+" '  NO corresponde a Promesa")
						cb_limpiar.triggerevent(clicked!)
						em_serie.text	= 'I'
						em_serie.setfocus()
					end if
				else
					messagebox("Advertencia","No es Posible Digitar Promesa "+gs_base+' - '+ls_serie+ ' - '+string(ll_numero,"###,###,###,###,###")+', por Encontrarse en Estado: '+string(ll_estado)+' - '+ls_descrip)
					cb_limpiar.triggerevent(clicked!)
				end if
			else
				if not isnull(ls_serie) and ls_serie<>'' then
					SELECT	"OFERTA_V"."SERIE"  
					INTO 		:ls_serie_aux  
					FROM 	"OFERTA_V",   
								"PAGO_OFERTA",   
								"CADENA"  
					WHERE	 ( "OFERTA_V"."SERIE" = "PAGO_OFERTA"."SERIE" ) and  
							 ( "OFERTA_V"."NRO_OFERTA" = "PAGO_OFERTA"."NRO_OFERTA" ) and  
							 ( "OFERTA_V"."ULT_FOLIO" = "PAGO_OFERTA"."FOLIO" ) and  
							 ( "OFERTA_V"."SERIE" = "CADENA"."SERIE" ) and  
							 ( "OFERTA_V"."NRO_OFERTA" = "CADENA"."NUMERO" ) and  
							 (("OFERTA_V"."SERIE" = :gs_serie ) AND  
							 ( "OFERTA_V"."NRO_OFERTA" = :gi_numero ) AND  
							 ( "CADENA"."CODIGO" = :gs_base ) )   
					USING		sqlca;
					if sqlca.sqlcode=0 then
						wf_valida_contrato(ls_serie,ll_numero)
					else
						if ll_numero>0 and not isnull(ll_numero) then
							SELECT	"CD_FOLIO"."ULT_ESTADO"  
							INTO 		:ll_ult_estado  
							FROM 		"CD_FOLIO"  
							WHERE  ( "CD_FOLIO"."BASE" = :gs_base ) AND  
									 ( "CD_FOLIO"."SERIE" = :gs_serie ) AND  
									 ( "CD_FOLIO"."NUMERO" = :gi_numero )   
							USING		sqlca;
							if sqlca.sqlcode<>0 then 
								OpenWithParm(w_verificar_contrato, gs_base+'~t'+gs_serie+'~t'+string(gi_numero))
								ls_respuesta	= Message.StringParm
							end if				
							if ls_respuesta='S' then
								wf_valida_contrato(ls_serie,ll_numero)
							else
								cb_limpiar.triggerevent(clicked!)
							end if	
						end if
					end if
				else
					messagebox("Advertencia","Promesa "+gs_base+' - '+ls_serie+ ' - '+string(ll_numero,"###,###,###,###,###")+" Inexistente")
					cb_limpiar.triggerevent(clicked!)
				end if
			end if
		else
			SELECT	"OFERTA_V"."SERIE"  
			INTO 		:ls_serie_aux  
			FROM 		"OFERTA_V",   
						"PAGO_OFERTA",   
						"CADENA"  
			WHERE	 ( "OFERTA_V"."SERIE" = "PAGO_OFERTA"."SERIE" ) and  
					 ( "OFERTA_V"."NRO_OFERTA" = "PAGO_OFERTA"."NRO_OFERTA" ) and  
					 ( "OFERTA_V"."ULT_FOLIO" = "PAGO_OFERTA"."FOLIO" ) and  
					 ( "OFERTA_V"."SERIE" = "CADENA"."SERIE" ) and  
					 ( "OFERTA_V"."NRO_OFERTA" = "CADENA"."NUMERO" ) and  
					 (("OFERTA_V"."SERIE" = :gs_serie ) AND  
					 ( "OFERTA_V"."NRO_OFERTA" = :gi_numero ) AND  
					 ( "CADENA"."CODIGO" = :gs_base ) )   
			USING		sqlca;
			if sqlca.sqlcode=0 then
				wf_valida_contrato(ls_serie,ll_numero)
			else
				SELECT	"CD_FOLIO"."ULT_ESTADO"  
				INTO 		:ll_ult_estado  
				FROM 		"CD_FOLIO"  
				WHERE  ( "CD_FOLIO"."BASE" = :gs_base ) AND  
						 ( "CD_FOLIO"."SERIE" = :gs_serie ) AND  
						 ( "CD_FOLIO"."NUMERO" = :gi_numero )   
				USING		sqlca;
				if sqlca.sqlcode<>0 then 
					OpenWithParm(w_verificar_contrato, gs_base+'~t'+gs_serie+'~t'+string(gi_numero))
					ls_respuesta	= Message.StringParm
				end if				
				if ls_respuesta='S' then
					wf_valida_contrato(ls_serie,ll_numero)
				else
					cb_limpiar.triggerevent(clicked!)
				end if
			end if
		end if
		//--Inicio Verificación Contrato Ingresado a SAP
		if dw_oferta_v.getitemnumber(1,'pago_oferta_factura') = 99 then
			dw_oferta_v.setitem(1,'c_estado_factura',99)
			//dw_seguro.enabled 		= false
			dw_agente.enabled 		= false
			dw_supervisor.enabled 	= false
			dw_jefe.enabled 			= false
			dw_oferta_v.setfocus()
			dw_oferta_v.setcolumn('pago_oferta_codigo_tipo_seguro')
		else
			dw_oferta_v.setitem(1,'c_estado_factura',0)
			//dw_seguro.enabled = true
		end if
		dw_oferta_v.accepttext()
		//--Fin Verificación
	end if
end if
end event

