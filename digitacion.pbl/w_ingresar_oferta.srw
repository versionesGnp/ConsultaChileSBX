event modified;long		ll_cant, ll_resp
date		ld_null
Double	ld_valor_uf
String	ls_dv,LS_NULL,ls_string

gi_rut								= Long(em_rut.text)
gs_serie 							= em_serie.Text
gi_numero 						= Double(em_numero.text)
if gi_rut>0 then
	em_rut.text					= string(gi_rut)
	dw_seguro.enabled		= true
	em_dv.text					= ''
	wf_limpiar()
	ll_cant 						= dw_clientes.Retrieve(gi_rut)
	IF ll_cant = 0 THEN
		dw_clientes.insertrow(0)
		ll_resp 					= MessageBox("Advertencia", "Cliente NO Existe, desea Ingresarlo", &
					  			  Exclamation!, YesNo!, 2)
		IF ll_resp = 1 THEN
			ls_string				= 'N'+'~t'+string(il_tipo_cliente)
			if gi_rut>0 then openwithparm(w_ingreso_cliente,ls_string) 
		else
			em_rut.text			= ''
			em_dv.text			= ''
			em_rut.enabled	= true
			em_dv.enabled		= true
			em_rut.setfocus()
		END IF
	else
		ls_dv						= dw_clientes.getitemstring(1,'dv')
		em_dv.text				= ls_dv
		dw_oferta_v.setitem(1, 'rut',gi_rut)
		dw_oferta_v.setitem(1, 'serie',gs_serie)
		dw_oferta_v.setitem(1, 'nro_oferta',gi_numero)
		dw_oferta_v.SetItem(1, 'fecha_ingreso',id_fecha_dia)
		dw_oferta_v.SetItem(1, 'fecha',id_fecha_dia)
		dw_oferta_v.SetItem(1, "cod_age_ant", gs_age)
		dw_oferta_v.SetItem(1, "cod_age", gs_age)
		dw_oferta_v.SetItem(1, "cod_sup", gs_sup)
		dw_oferta_v.SetItem(1, "cod_jef", gs_jefe)
		dw_agente.setitem(1,'agente',gs_age)
		dw_supervisor.setitem(1,'supervisores',gs_sup)
		dw_jefe.setitem(1,'jefes',gs_jefe)
		dw_oferta_v.SetItem(1, 'fecha_ingreso',id_fecha_dia)
		if isnull(dw_oferta_v.getitemstring(1,'usuario')) then dw_oferta_v.setitem(1,'usuario',gs_user)
		Setnull(ls_null);setnull(ld_null)
		dw_oferta_v.SetItem(1, "pago_oferta_serie", gs_serie)
		dw_oferta_v.SetItem(1, "pago_oferta_nro_oferta", gi_numero)
		dw_oferta_v.SetItem(1, "pago_oferta_fecha", id_fecha_dia)
		dw_oferta_v.SetItem(1, "pago_oferta_folio", 0)
		dw_oferta_v.SetItem(1, "pago_oferta_precio", 0)
		dw_oferta_v.SetItem(1, "pago_oferta_pie", 0)
		dw_oferta_v.SetItem(1, "pago_oferta_tasa", 0)
		dw_oferta_v.SetItem(1, "pago_oferta_tasa_base", 0)
		dw_oferta_v.SetItem(1, "pago_oferta_capacidad", 0)
		dw_oferta_v.SetItem(1, "pago_oferta_n_reduccion", ls_null)
		dw_oferta_v.SetItem(1, "pago_oferta_valor_cuota", 0)
		dw_oferta_v.SetItem(1, "pago_oferta_des_esp", 0)
		dw_oferta_v.SetItem(1, "pago_oferta_nro_cuotas", 0)
		dw_oferta_v.SetItem(1, "pago_oferta_uf_dia", gd_uf_dia)
		dw_oferta_v.SetItem(1, "pago_oferta_moneda", ls_null)
		dw_oferta_v.SetItem(1, "pago_oferta_fecha_prim", ld_null)
		dw_oferta_v.SetItem(1, "pago_oferta_fecha_ult", ld_null)
		dw_oferta_v.SetItem(1, "pago_oferta_fecha_entre", ld_null)
		dw_oferta_v.SetItem(1, "pago_oferta_fecha_pie", ld_null)
		dw_oferta_v.SetItem(1, "pago_oferta_modificado", gs_user)
		dw_oferta_v.SetItem(1, "pago_oferta_fecha_mod", id_fecha_dia)
		dw_oferta_v.SetItem(1, "pago_oferta_area", ls_null)
		dw_oferta_v.SetItem(1, "pago_oferta_parque", gl_cod_parque) //gi_cod_parque)
		dw_oferta_v.SetItem(1, "pago_oferta_sector", "0")
		dw_oferta_v.SetItem(1, "pago_oferta_sepultura", ls_null)
		dw_oferta_v.SetItem(1, "pago_oferta_derecho_lib", 0)
		dw_oferta_v.SetItem(1, "pago_oferta_gastos_adm", 0)
		dw_oferta_v.SetItem(1, "pago_oferta_factura", 0)
		dw_oferta_v.SetItem(1, "pago_oferta_fecha_fact", ld_null)
		dw_oferta_v.SetItem(1, "pago_oferta_total_fact", 0)
		dw_oferta_v.SetItem(1, "pago_oferta_carta_bienv", "N")
		dw_oferta_v.SetItem(1, "pago_oferta_pie_pagado", 0)
		dw_oferta_v.SetItem(1, 'oferta_v_promocion',0)
		dw_oferta_v.SetItem(1, 'oferta_v_tipo_descuento',0)
		dw_oferta_v.enabled			= true
		dw_clientes.enabled			= true
		dw_agente.enabled			= true
		dw_supervisor.enabled		= true
		dw_jefe.enabled				= true
		dw_seguro.enabled			= true
		if gs_nueva_oferta='S' then
			// Valida Agente CD
			if gi_numero >= gi_prim_nro_O_cd then
				String	ls_cod_age,ls_cod_sup,ls_cod_jefe,ls_descrip
				Long		ll_estado
				SELECT	"CD_FOLIO"."COD_AGENTE",   
							"CD_FOLIO"."COD_SUPERVISOR",   
							"CD_FOLIO"."COD_JEFE_VENTA",
							"CD_FOLIO"."COD_PARQUE",
							"CD_FOLIO"."ULT_ESTADO"  
				INTO 		:ls_cod_age,   
							:ls_cod_sup,   
							:ls_cod_jefe,
							:gl_cod_parque,
							:ll_estado
				FROM		"CD_FOLIO"  
				WHERE  ( "CD_FOLIO"."BASE" = :gs_base ) AND  
						 ( "CD_FOLIO"."SERIE" = :gs_serie ) AND  
						 ( "CD_FOLIO"."NUMERO" = :gi_numero ) 
				USING		sqlca;
				if sqlca.sqlcode=0 then
					if not isnull(ls_cod_age) and ls_cod_age<>'' then
						dw_oferta_v.SetItem(1, "pago_oferta_parque", gl_cod_parque)
						dw_oferta_v.accepttext()
						SELECT	"CD_ESTADO"."DESCRIPCION"  
						INTO 		:ls_descrip  
						FROM 		"CD_ESTADO"  
						WHERE 	"CD_ESTADO"."CODIGO" = :ll_estado ;
						if ll_estado<>9 then 
							messagebox( "Advertencia","Promesa Nº "+gs_base+'-'+gs_serie+'-'+string(gi_numero,"###,###,###,###,###")+&
											', NO es posible Asignar por encontrarse en ESTADO: '+string(ll_estado)+'-'+ls_descrip)
							dw_agente.enabled		= false
							dw_supervisor.enabled	= false
							dw_jefe.enabled			= false
							dw_oferta_v.enabled		= false
							dw_seguro.enabled		= false
							cb_limpiar.triggerevent(clicked!)
						else
							dw_agente.enabled		= True
							dw_supervisor.enabled	= True
							dw_jefe.enabled			= True
							dw_oferta_v.enabled		= true
							dw_seguro.enabled		= true
							dw_agente.setitem(1,'agente',ls_cod_age)
							dw_supervisor.setitem(1,'supervisores',ls_cod_sup)
							dw_jefe.setitem(1,'jefes',ls_cod_jefe)
							dw_agente.accepttext()
							dw_agente.triggerevent(itemchanged!)
						end if
					end if
				end if
			end if
			dw_agente.setfocus()
		else
			dw_oferta_v.setfocus()
		end if
	END IF
	dw_clientes.Object.DataWindow.ReadOnly	= "No"
end if
end event

