ll_score					= dw_clientes.getitemnumber(1,'dicom_score')
ll_tipo_clas_renta		= dw_clientes.getitemnumber(1,'tipo_clasifica_renta')
if isnull(ls_serie) 					then ls_serie=' '
if isnull(ls_area) 					then ls_area=' '
if isnull(ls_sector) 					then ls_sector=' '
