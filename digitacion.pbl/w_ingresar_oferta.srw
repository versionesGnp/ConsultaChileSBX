event itemchanged;Long		ll_grabar_1=0,ll_grabar_2=1
String		ls_string,ls_obs,ls_tipo_cont,ls_age_aux,ls_sup_aux,ls_jefe_aux,ls_jefe,ls_cod_sup,ls_fecha



dw_supervisor.accepttext()
ls_cod_sup	= dw_supervisor.getitemstring(1,'supervisores')
if not isnull(ls_cod_sup) then
	if gi_rut>0 then
		is_sw_sup		= 'S'
		this.accepttext()
		gs_serie 		= trim(em_serie.Text)
//		gs_base			= 'O'
		if gi_rut>0 then
			if is_pasa_asigna='S' then
				gs_age	= dw_agente.getitemstring(1,'agente')
				gs_sup	= dw_supervisor.getitemstring(1,'supervisores')
				gs_jefe	= dw_jefe.getitemstring(1,'jefes')
				if not isnull(gs_sup) then
					SELECT	"SUPERVISOR"."COD_JEFE"  
					INTO 		:ls_jefe  
					FROM 		"SUPERVISOR"  
					WHERE 	"SUPERVISOR"."COD_SUP" = :gs_sup   
					USING		sqlca;
					if sqlca.sqlcode=0 then
						if isnull(gs_sup) then
							messagebox("Advertencia","Debe Ingresar Supervisor")
							dw_agente.setfocus()
						else
							dw_oferta_v.SetItem(1, "cod_sup", gs_sup)
							if not isnull(gs_age) then il_resp_age=0
							dw_oferta_v.accepttext()
							if il_resp_age<>1 then
								if gs_nueva_oferta='S' and is_sw_sup='S' and not isnull(gs_age) and gs_age<>'' and not isnull(gs_jefe) and gs_jefe<>'' then
									il_resp_sup	= MessageBox("Advertencia", "Está seguro de ASIGNAR Promesa Nº "+gs_serie+'-'+string(gi_numero,"###,###,###,###"),Exclamation!, YesNo!, 2)
									IF il_resp_sup = 1 THEN
										ls_string	= gs_serie+'~t'+string(gi_numero)+'~t'+gs_age+'~t'+string(gdt_fec_sistema)+'~t'+string(gdt_fec_sistema)+'~t'+'V'+'~t'+ls_obs+'~t'+gs_sup+'~t'+gs_jefe
										openwithparm(w_verificar_datos_contrato,ls_string)
										IF trim(Message.StringParm)='OK' THEN
											ls_obs	= 'Promesa creada por '+gs_user+' el '+string(gdt_fec_sistema)
											if len(ls_obs)>50 then ls_obs=mid(ls_obs,1,50)
											wf_revision_contrato() //REVISION_CONTRATO
											dw_oferta_v.accepttext()
											dw_oferta_v.enabled			= true
											dw_oferta_v.setfocus()
										else
											dw_oferta_v.enabled			= false
//											wf_cargar_codigo_originales()
											messagebox("Advertencia","NO fue Asignada Promesa Nº "+gs_base+'-'+gs_serie+'-'+string(gi_numero,"###,###,###,###"))
											dw_jefe.setfocus()
										end if
									else
//										wf_cargar_codigo_originales()
									END IF
								end if
							end if
						end if
					else
						messagebox("Advertencia","Supervisor Inexistente")
						dw_supervisor.reset()
						dw_supervisor.insertrow(0)
						dw_supervisor.Setfocus()
						gs_sup	= ''
					end if
				end if
			elseif is_pasa_asigna='N' and is_sw_sup='S' then	
				gs_age	= dw_agente.getitemstring(1,'agente')
				gs_sup	= dw_supervisor.getitemstring(1,'supervisores')
				if not isnull(gs_sup) then
					SELECT	"SUPERVISOR"."COD_JEFE"  
					INTO 		:ls_jefe  
					FROM 		"SUPERVISOR"  
					WHERE 	"SUPERVISOR"."COD_SUP" = :gs_sup   
					USING		sqlca;
					if sqlca.sqlcode=0 then
						if isnull(gs_sup) then
							messagebox("Advertencia","Debe Ingresar Supervisor")
							dw_agente.setfocus()
						else
							dw_oferta_v.SetItem(1, "cod_sup", gs_sup)
							dw_oferta_v.accepttext()
							if is_sw_sup='S' and not isnull(gs_age) and gs_age<>'' and not isnull(gs_jefe) and gs_jefe<>''  then//if il_resp_age=2 and is_sw_sup='S' then
								il_resp_sup	= MessageBox("Advertencia", "Está seguro de ASIGNAR Promesa Nº "+gs_serie+'-'+string(gi_numero,"###,###,###,###"),Exclamation!, YesNo!, 2)
								IF il_resp_sup = 1 THEN
									ls_string	= gs_serie+'~t'+string(gi_numero)+'~t'+gs_age+'~t'+string(gdt_fec_sistema)+'~t'+string(gdt_fec_sistema)+'~t'+'V'+'~t'+ls_obs+'~t'+gs_sup+'~t'+gs_jefe
									openwithparm(w_verificar_datos_contrato,ls_string)
									IF trim(Message.StringParm)='OK' THEN
										ls_obs	= 'Promesa creada por '+gs_user+' el '+string(gdt_fec_sistema)
										if len(ls_obs)>50 then ls_obs=mid(ls_obs,1,50)
										dw_oferta_v.enabled			= true
										wf_revision_contrato() //REVISION_CONTRATO
										dw_oferta_v.setfocus()
									else
										dw_oferta_v.enabled			= false
//										wf_cargar_codigo_originales()
										messagebox("Advertencia","NO fue Re-Asignada Promesa Nº "+gs_base+'-'+gs_serie+'-'+string(gi_numero,"###,###,###,###"))
										dw_jefe.setfocus()
									end if
								else
//									wf_cargar_codigo_originales()
								END IF
							end if
						end if
					else
						messagebox("Advertencia","Supervisor Inexistente")
						dw_supervisor.reset()
						dw_supervisor.insertrow(0)
						dw_supervisor.Setfocus()
						gs_sup	= ''
					end if
				end if
			end if
			if ll_grabar_1	= 1 and ll_grabar_2 = 1 then
				commit using sqlca;
				
				UPDATE	"OFERTA_V"  
				SET 		"COD_AGE" = :gs_age,   
							"COD_SUP" = :gs_sup,   
							"COD_JEF" = :gs_jefe  
				WHERE  ( "OFERTA_V"."SERIE" = :gs_serie ) AND  
						 ( "OFERTA_V"."NRO_OFERTA" = :gi_numero )   
				USING		sqlca;
				if sqlca.sqlcode=0 then
					commit;
				else
					rollback;
				end if
			else
				rollback using sqlca;
			end if
		end if
		this.accepttext()
	else
		messagebox("Advertencia","Recuerde antes de Asingar debe ingresar Rut Cliente")
		dw_supervisor.reset()
		dw_supervisor.insertrow(0)
		em_rut.setfocus()
	end if
end if
end event

