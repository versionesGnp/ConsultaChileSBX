 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cliente~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"producto_anexo~" )  TABLE(NAME=~"producto_pago~" ) COLUMN(NAME=~"cliente.rut~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cliente.direccion_p~") COLUMN(NAME=~"cliente.fono_p~") COLUMN(NAME=~"cliente.fono_c~") COLUMN(NAME=~"cliente.estado_titular~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"cadena.estado_titulo~") COLUMN(NAME=~"cadena.fecha_titulo~") COLUMN(NAME=~"cadena.fecha_res~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"cadena.cod_parque~") COLUMN(NAME=~"producto_anexo.serie~") COLUMN(NAME=~"producto_anexo.numero~") COLUMN(NAME=~"producto_anexo.total_pagado~") COLUMN(NAME=~"producto_anexo.cuotas_pag~") COLUMN(NAME=~"producto_anexo.forma_pago~") COLUMN(NAME=~"producto_anexo.fecha_cierre~") COLUMN(NAME=~"producto_anexo.cod_agente~") COLUMN(NAME=~"producto_anexo.cod_super~") COLUMN(NAME=~"producto_anexo.cod_jefe~") COLUMN(NAME=~"producto_anexo.estado_comi~") COLUMN(NAME=~"producto_anexo.estado_premio~") COLUMN(NAME=~"producto_anexo.estatus_comision~") COLUMN(NAME=~"producto_anexo.cierre_venta~") COLUMN(NAME=~"producto_anexo.cierre_venta_semanal~") COLUMN(NAME=~"producto_anexo.saldo_financiar~") COLUMN(NAME=~"producto_pago.precio~") COLUMN(NAME=~"producto_pago.pie_pagado~") COLUMN(NAME=~"producto_pago.pie~") COLUMN(NAME=~"producto_pago.tasa~") COLUMN(NAME=~"producto_pago.valor_cuota~") COLUMN(NAME=~"producto_pago.plazo~") COLUMN(NAME=~"producto_pago.uf_dia~") COLUMN(NAME=~"producto_pago.moneda~") COLUMN(NAME=~"producto_pago.gasto_adm~") COLUMN(NAME=~"producto_pago.ctas_pie_plazo~") COLUMN(NAME=~"producto_pago.ctas_pie_pagadas~") COLUMN(NAME=~"producto_pago.base~") COLUMN(NAME=~"producto_pago.tasa_base~") COLUMN(NAME=~"producto_anexo.uso~")    JOIN (LEFT=~"cliente.rut~"    OP =~"=~"RIGHT=~"producto_anexo.rut~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"producto_anexo.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"producto_anexo.numero~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"producto_anexo.base~" )    JOIN (LEFT=~"producto_anexo.base~"    OP =~"=~"RIGHT=~"producto_pago.base~" )    JOIN (LEFT=~"producto_anexo.serie~"    OP =~"=~"RIGHT=~"producto_pago.serie~" )    JOIN (LEFT=~"producto_anexo.numero~"    OP =~"=~"RIGHT=~"producto_pago.numero~" )    JOIN (LEFT=~"producto_anexo.ult_folio~"    OP =~"=~"RIGHT=~"producto_pago.folio~" )WHERE(    EXP1 =~"~~~"PRODUCTO_PAGO~~~".~~~"FECHA~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"PRODUCTO_PAGO~~~".~~~"FECHA~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~":base~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = date)  ARG(NAME = ~"fecha_fin~" TYPE = date)  ARG(NAME = ~"base~" TYPE = string) " arguments=(("fecha_ini", date),("fecha_fin", date),("base", string))  sort="producto_anexo_numero A " )
