 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"beneficiario_funeraria~" ) COLUMN(NAME=~"beneficiario_funeraria.contador~") COLUMN(NAME=~"beneficiario_funeraria.serie~") COLUMN(NAME=~"beneficiario_funeraria.nro_oferta~") COLUMN(NAME=~"beneficiario_funeraria.rut~") COLUMN(NAME=~"beneficiario_funeraria.nombre~") COLUMN(NAME=~"beneficiario_funeraria.a_paterno~") COLUMN(NAME=~"beneficiario_funeraria.a_materno~") COLUMN(NAME=~"beneficiario_funeraria.dv~")WHERE(    EXP1 =~"~~~"BENEFICIARIO_FUNERARIA~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":as_serie~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"BENEFICIARIO_FUNERARIA~~~".~~~"NRO_OFERTA~~~"~"   OP =~"=~"    EXP2 =~":an_numero~" ) ) ARG(NAME = ~"as_serie~" TYPE = string)  ARG(NAME = ~"an_numero~" TYPE = number) " update="BENEFICIARIO_FUNERARIA" updatewhere=0 updatekeyinplace=yes arguments=(("as_serie", string),("an_numero", number)) )
