 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cadena~" )  TABLE(NAME=~"cliente~" )  TABLE(NAME=~"derecho~" ) COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cliente.rut~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"cadena.fecha_res~") COLUMN(NAME=~"derecho.serie_p~") COLUMN(NAME=~"derecho.nro_pagare~") COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"cadena.serie~") COLUMN(NAME=~"cadena.numero~") COLUMN(NAME=~"derecho.fecha~") COLUMN(NAME=~"derecho.valor_cuo~") COLUMN(NAME=~"derecho.plazo~") COLUMN(NAME=~"derecho.tasa~") COLUMN(NAME=~"derecho.tot_pagado~") COLUMN(NAME=~"derecho.pie_pagado~") COLUMN(NAME=~"derecho.cta_pag_la~") COLUMN(NAME=~"derecho.cta_pag_isa~") COLUMN(NAME=~"derecho.kapital~") COLUMN(NAME=~"derecho.fecha_prim~") COLUMN(NAME=~"derecho.estado~") COLUMN(NAME=~"derecho.estado_reg~") COLUMN(NAME=~"derecho.serie~") COLUMN(NAME=~"derecho.nro_oferta~") COLUMN(NAME=~"derecho.rut_aval~") COLUMN(NAME=~"derecho.fecha_ult~") COLUMN(NAME=~"derecho.abono_pag~") COLUMN(NAME=~"derecho.usuario~") COLUMN(NAME=~"derecho.fechas_ingreso~") COLUMN(NAME=~"derecho.nro_resc~") COLUMN(NAME=~"derecho.rut~") COLUMN(NAME=~"derecho.parque~") COLUMN(NAME=~"derecho.dueno~") COLUMN(NAME=~"derecho.origen~") COLUMN(NAME=~"derecho.moneda~") COLUMN(NAME=~"derecho.sector~") COLUMN(NAME=~"derecho.sepultura~") COLUMN(NAME=~"derecho.pie~") COLUMN(NAME=~"derecho.base~") COLUMN(NAME=~"derecho.correlativo~") COLUMN(NAME=~"derecho.fecha_pie~") COLUMN(NAME=~"derecho.forma_pago~") COLUMN(NAME=~"cadena.cod_parque~")    JOIN (LEFT=~"cadena.rut~"    OP =~"=~"RIGHT=~"cliente.rut~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"derecho.serie_p~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"derecho.nro_pagare~" )WHERE(    EXP1 =~"~~~"DERECHO~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"DERECHO~~~".~~~"NRO_OFERTA~~~"~"   OP =~"=~"    EXP2 =~":numero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'D'~" ) ) ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number) " update="DERECHO" updatewhere=0 updatekeyinplace=yes arguments=(("serie", string),("numero", number))  sort="derecho_correlativo A " )
