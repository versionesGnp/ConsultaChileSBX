 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cliente~" ) COLUMN(NAME=~"cliente.rut~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cliente.direccion_p~") COLUMN(NAME=~"cliente.poblacion~") COLUMN(NAME=~"cliente.sector~") COLUMN(NAME=~"cliente.comuna~") COLUMN(NAME=~"cliente.ciudad~") COLUMN(NAME=~"cliente.fono_p~") COLUMN(NAME=~"cliente.estado_titular~") COLUMN(NAME=~"cliente.tipo_via~") COLUMN(NAME=~"cliente.numero_particular~") COLUMN(NAME=~"cliente.depto_particular~") COLUMN(NAME=~"cliente.block_particular~")WHERE(    EXP1 =~"~~~"CLIENTE~~~".~~~"RUT~~~"~"   OP =~"=~"    EXP2 =~":an_rut~" ) ) ARG(NAME = ~"an_rut~" TYPE = number) " update="CLIENTE" updatewhere=1 updatekeyinplace=no arguments=(("an_rut", number)) )
