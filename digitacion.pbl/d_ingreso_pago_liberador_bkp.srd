table(column=(type=char(1) update=yes updatewhereclause=yes key=yes name=serie_m dbname="pago_liberador.serie_m" )
 column=(type=decimal(4) update=yes updatewhereclause=yes key=yes name=nro_liberador dbname="pago_liberador.nro_liberador" )
 column=(type=datetime update=yes updatewhereclause=yes name=fecha dbname="pago_liberador.fecha" )
 column=(type=decimal(4) update=yes updatewhereclause=yes key=yes name=folio dbname="pago_liberador.folio" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=precio dbname="pago_liberador.precio" validation="double(gettext()) < if( moneda ='2' , 100,2000000)" validationmsg="~"Valor fuera de rango~"" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=pie_pagado dbname="pago_liberador.pie_pagado" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=pie dbname="pago_liberador.pie" validation="double(gettext()) < if(moneda = '2', 20, 1100000)" validationmsg="~"valor fuera de rango~"" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=tasa dbname="pago_liberador.tasa" validation="double(gettext()) > 0 and double(gettext()) < 3" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=valor_cuota dbname="pago_liberador.valor_cuota" validation="(double(gettext()) < if (moneda = '2', 100, 2000000)) and (double(gettext()) >0)" validationmsg="~"valor fuera de rango~"" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=nro_cuotas dbname="pago_liberador.nro_cuotas" validation="long(gettext()) > 0" validationmsg="~"numero de cuotas debe ser mayor que cero~"" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=uf_dia dbname="pago_liberador.uf_dia" )
 column=(type=char(1) update=yes updatewhereclause=yes name=moneda dbname="pago_liberador.moneda" values="Pesos	1/U.F.	2/" )
 column=(type=datetime update=yes updatewhereclause=yes name=fecha_prim dbname="pago_liberador.fecha_prim" )
 column=(type=datetime update=yes updatewhereclause=yes name=fecha_ult dbname="pago_liberador.fecha_ult" )
 column=(type=datetime update=yes updatewhereclause=yes name=fecha_pie dbname="pago_liberador.fecha_pie" )
 column=(type=char(4) update=yes updatewhereclause=yes name=modificado dbname="pago_liberador.modificado" )
 column=(type=datetime update=yes updatewhereclause=yes name=fecha_mod dbname="pago_liberador.fecha_mod" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=gastos_adm dbname="pago_liberador.gastos_adm" validation="double(gettext()) < if(moneda='2',11,110000)" validationmsg="~"valor fuera de rango~"" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"pago_liberador~" )  TABLE(NAME=~"anexo_liberador~" ) COLUMN(NAME=~"pago_liberador.serie_m~") COLUMN(NAME=~"pago_liberador.nro_liberador~") COLUMN(NAME=~"pago_liberador.fecha~") COLUMN(NAME=~"pago_liberador.folio~") COLUMN(NAME=~"pago_liberador.precio~") COLUMN(NAME=~"pago_liberador.pie_pagado~") COLUMN(NAME=~"pago_liberador.pie~") COLUMN(NAME=~"pago_liberador.tasa~") COLUMN(NAME=~"pago_liberador.valor_cuota~") COLUMN(NAME=~"pago_liberador.nro_cuotas~") COLUMN(NAME=~"pago_liberador.uf_dia~") COLUMN(NAME=~"pago_liberador.moneda~") COLUMN(NAME=~"pago_liberador.fecha_prim~") COLUMN(NAME=~"pago_liberador.fecha_ult~") COLUMN(NAME=~"pago_liberador.fecha_pie~") COLUMN(NAME=~"pago_liberador.modificado~") COLUMN(NAME=~"pago_liberador.fecha_mod~") COLUMN(NAME=~"pago_liberador.gastos_adm~")    JOIN (LEFT=~"anexo_liberador.serie_m~"    OP =~"=~"RIGHT=~"pago_liberador.serie_m~" )    JOIN (LEFT=~"anexo_liberador.nro_liberador~"    OP =~"=~"RIGHT=~"pago_liberador.nro_liberador~" )    JOIN (LEFT=~"anexo_liberador.ult_folio~"    OP =~"=~"RIGHT=~"pago_liberador.folio~" )WHERE(    EXP1 =~"~~~"PAGO_LIBERADOR~~~".~~~"SERIE_M~~~"~"   OP =~"=~"    EXP2 =~":as_serie~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"PAGO_LIBERADOR~~~".~~~"NRO_LIBERADOR~~~"~"   OP =~"=~"    EXP2 =~":an_numero~" ) ) ARG(NAME = ~"as_serie~" TYPE = string)  ARG(NAME = ~"an_numero~" TYPE = number) " update="PAGO_LIBERADOR" updatewhere=1 updatekeyinplace=no arguments=(("as_serie", string),("an_numero", number)) )
