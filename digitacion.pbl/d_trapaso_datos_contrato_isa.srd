table(column=(type=decimal(4) updatewhereclause=yes name=kapital dbname="contrato.kapital" )
 column=(type=decimal(4) updatewhereclause=yes name=plazo dbname="contrato.plazo" )
 column=(type=decimal(4) updatewhereclause=yes name=valor_cuo dbname="contrato.valor_cuo" )
 column=(type=decimal(4) updatewhereclause=yes name=pie dbname="contrato.pie" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"contrato~" )  TABLE(NAME=~"cadena~" ) COLUMN(NAME=~"contrato.kapital~") COLUMN(NAME=~"contrato.plazo~") COLUMN(NAME=~"contrato.valor_cuo~") COLUMN(NAME=~"contrato.pie~")    JOIN (LEFT=~"contrato.serie_c~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"contrato.nro_contrato~"    OP =~"=~"RIGHT=~"cadena.numero~" )WHERE(    EXP1 =~"~~~"CONTRATO~~~".~~~"SERIE_C~~~"~"   OP =~"=~"    EXP2 =~":as_serie~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CONTRATO~~~".~~~"NRO_CONTRATO~~~"~"   OP =~"=~"    EXP2 =~":an_numero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'C'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"(~~~"CADENA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'V'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'C')~" ) ) ARG(NAME = ~"as_serie~" TYPE = string)  ARG(NAME = ~"an_numero~" TYPE = number) " arguments=(("as_serie", string),("an_numero", number)) )
