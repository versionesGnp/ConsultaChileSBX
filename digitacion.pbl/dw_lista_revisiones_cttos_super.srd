MN(NAME=~"cd_folio.cod_jefe_venta~") COLUMN(NAME=~"cd_folio.mes_cierre~") COLUMN(NAME=~"cd_folio.ano_cierre~") COLUMN(NAME=~"revision_contratos.codigo_servicio~")    JOIN (LEFT=~"revision_contratos.base~"    OP =~"=~"RIGHT=~"cd_folio.base~"    OUTER1 =~"revision_contratos.base~" )    JOIN (LEFT=~"revision_contratos.serie~"    OP =~"=~"RIGHT=~"cd_folio.serie~"    OUTER1 =~"revision_contratos.serie~" )    JOIN (LEFT=~"revision_contratos.numero~"    OP =~"=~"RIGHT=~"cd_folio.numero~"    OUTER1 =~"revision_contratos.numero~" )WHERE(    EXP1 =~"~~~"REVISION_CONTRATOS~~~".~~~"FECHA_CTTO~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"REVISION_CONTRATOS~~~".~~~"FECHA_CTTO~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"REVISION_CONTRATOS~~~".~~~"USUARIO_CREA~~~"~"   OP =~"=~"    EXP2 =~":super~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = date)  ARG(NAME = ~"fecha_fin~" TYPE = date)  ARG(NAME = ~"super~" TYPE = string) " arguments=(("fecha_ini", date),("fecha_fin", date),("super", string)) )
