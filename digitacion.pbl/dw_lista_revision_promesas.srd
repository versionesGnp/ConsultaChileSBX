 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cadena~" )  TABLE(NAME=~"oferta_v~" )  TABLE(NAME=~"pago_oferta~" )  TABLE(NAME=~"agentes~" )  TABLE(NAME=~"jefe_ventas~" )  TABLE(NAME=~"supervisor~" )  TABLE(NAME=~"tipo_descuento~" )  TABLE(NAME=~"tipo_promocion~" )  TABLE(NAME=~"tipo_seguro~" )  TABLE(NAME=~"tasa_gastos_adm~" ) COLUMN(NAME=~"cadena.rut~") COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"cadena.serie~") COLUMN(NAME=~"cadena.numero~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"supervisor.porc_supervisor~") COLUMN(NAME=~"jefe_ventas.porc_jefe_vta~") COLUMN(NAME=~"oferta_v.porce_venta~") COLUMN(NAME=~"oferta_v.tipo_sepult~") COLUMN(NAME=~"pago_oferta.area~") COLUMN(NAME=~"pago_oferta.capacidad~") COLUMN(NAME=~"oferta_v.uso~") COLUMN(NAME=~"pago_oferta.moneda~") COLUMN(NAME=~"pago_oferta.uf_dia~") COLUMN(NAME=~"oferta_v.tipo_cons~") COLUMN(NAME=~"cadena.cod_parque~") COLUMN(NAME=~"oferta_v.tipo_descuento~") COLUMN(NAME=~"oferta_v.descuento_por~") COLUMN(NAME=~"oferta_v.promocion~") COLUMN(NAME=~"tipo_descuento.descripcion~") COLUMN(NAME=~"tipo_promocion.descripcion~") COLUMN(NAME=~"pago_oferta.precio~") COLUMN(NAME=~"pago_oferta.pie~") COLUMN(NAME=~"pago_oferta.tasa~") COLUMN(NAME=~"pago_oferta.tasa_base~") COLUMN(NAME=~"pago_oferta.valor_cuota~") COLUMN(NAME=~"pago_oferta.nro_cuotas~") COLUMN(NAME=~"pago_oferta.fecha_prim~") COLUMN(NAME=~"pago_oferta.fecha_entre~") COLUMN(NAME=~"pago_oferta.sector~") COLUMN(NAME=~"pago_oferta.sepultura~") COLUMN(NAME=~"pago_oferta.ctas_pactadas_pie~") COLUMN(NAME=~"pago_oferta.ctas_pagadas_pie~") COLUMN(NAME=~"pago_oferta.fecha_prim_pie~") COLUMN(NAME=~"pago_oferta.codigo_tipo_seguro~") COLUMN(NAME=~"tipo_seguro.descripcion~") COLUMN(NAME=~"tasa_gastos_adm.tasa_uf~") COLUMN(NAME=~"tasa_gastos_adm.tasa_peso~") COLUMN(NAME=~"oferta_v.fecha_ingreso~") COLUMN(NAME=~"oferta_v.fecha~") COLUMN(NAME=~"oferta_v.cod_age~") COLUMN(NAME=~"oferta_v.cod_sup~") COLUMN(NAME=~"oferta_v.cod_jef~") COLUMN(NAME=~"oferta_v.tipo_venta~") COLUMN(NAME=~"oferta_v.porce_jefe~") COLUMN(NAME=~"oferta_v.porce_sup~") COLUMN(NAME=~"pago_oferta.gastos_adm~") COMPUTE(NAME=~"0,0,0,0,0~") COLUMN(NAME=~"oferta_v.forma_pago~") COMPUTE(NAME=~"''~")    JOIN (LEFT=~"oferta_v.cod_age~"    OP =~"=~"RIGHT=~"agentes.cod_age~"    OUTER1 =~"oferta_v.cod_age~" )    JOIN (LEFT=~"oferta_v.cod_sup~"    OP =~"=~"RIGHT=~"supervisor.cod_sup~"    OUTER1 =~"oferta_v.cod_sup~" )    JOIN (LEFT=~"oferta_v.cod_jef~"    OP =~"=~"RIGHT=~"jefe_ventas.jefe_ventas~"    OUTER1 =~"oferta_v.cod_jef~" )    JOIN (LEFT=~"oferta_v.tipo_descuento~"    OP =~"=~"RIGHT=~"tipo_descuento.codigo~"    OUTER1 =~"oferta_v.tipo_descuento~" )    JOIN (LEFT=~"oferta_v.promocion~"    OP =~"=~"RIGHT=~"tipo_promocion.codigo~"    OUTER1 =~"oferta_v.promocion~" )    JOIN (LEFT=~"pago_oferta.codigo_tipo_seguro~"    OP =~"=~"RIGHT=~"tipo_seguro.codigo~"    OUTER1 =~"pago_oferta.codigo_tipo_seguro~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"oferta_v.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"oferta_v.nro_oferta~" )    JOIN (LEFT=~"oferta_v.serie~"    OP =~"=~"RIGHT=~"pago_oferta.serie~" )    JOIN (LEFT=~"oferta_v.nro_oferta~"    OP =~"=~"RIGHT=~"pago_oferta.nro_oferta~" )    JOIN (LEFT=~"oferta_v.ult_folio~"    OP =~"=~"RIGHT=~"pago_oferta.folio~" )WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'O'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"OFERTA_V~~~".~~~"FECHA_INGRESO~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"OFERTA_V~~~".~~~"FECHA_INGRESO~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"TASA_GASTOS_ADM~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"1~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = date)  ARG(NAME = ~"fecha_fin~" TYPE = date)  ARG(NAME = ~"parque~" TYPE = number) " arguments=(("fecha_ini", date),("fecha_fin", date),("parque", number))  sort="cadena_numero A " )
