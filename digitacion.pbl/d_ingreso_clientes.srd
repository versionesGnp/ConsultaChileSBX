 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cliente~" ) COLUMN(NAME=~"cliente.rut~") COLUMN(NAME=~"cliente.tipo~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cliente.direccion_p~") COLUMN(NAME=~"cliente.poblacion~") COLUMN(NAME=~"cliente.sector~") COLUMN(NAME=~"cliente.ciudad~") COLUMN(NAME=~"cliente.sexo~") COLUMN(NAME=~"cliente.fecha_nac~") COLUMN(NAME=~"cliente.esta_civil~") COLUMN(NAME=~"cliente.domicilio_c~") COLUMN(NAME=~"cliente.fono_c~") COLUMN(NAME=~"cliente.fecha_ingr~") COLUMN(NAME=~"cliente.total_rent~") COLUMN(NAME=~"cliente.grupo_f~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"cliente.fono_p~") COLUMN(NAME=~"cliente.estado_cobranza~") COLUMN(NAME=~"cliente.estado_titular~") COLUMN(NAME=~"cliente.comuna~") COLUMN(NAME=~"cliente.auto_propio~") COLUMN(NAME=~"cliente.casa_propia~") COLUMN(NAME=~"cliente.numero_particular~") COLUMN(NAME=~"cliente.depto_particular~") COLUMN(NAME=~"cliente.block_particular~") COLUMN(NAME=~"cliente.comuna_comercial~") COLUMN(NAME=~"cliente.ciudad_comercial~") COLUMN(NAME=~"cliente.numero_comercial~") COLUMN(NAME=~"cliente.actividad~") COLUMN(NAME=~"cliente.otras_rentas~") COLUMN(NAME=~"cliente.fecha_cobranza~") COLUMN(NAME=~"cliente.tipo_via~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.dicom_score~") COLUMN(NAME=~"cliente.tipo_clasifica_renta~")WHERE(    EXP1 =~"~~~"CLIENTE~~~".~~~"RUT~~~"~"   OP =~"=~"    EXP2 =~":an_rut~" ) ) ARG(NAME = ~"an_rut~" TYPE = number) " update="CLIENTE" updatewhere=0 updatekeyinplace=yes arguments=(("an_rut", number)) )
