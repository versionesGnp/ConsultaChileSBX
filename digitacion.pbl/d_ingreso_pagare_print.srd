 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"pagare~" )  TABLE(NAME=~"cliente~" )  TABLE(NAME=~"cadena~" ) COLUMN(NAME=~"pagare.serie_p~") COLUMN(NAME=~"pagare.nro_pagare~") COLUMN(NAME=~"pagare.fecha~") COLUMN(NAME=~"pagare.serie~") COLUMN(NAME=~"pagare.nro_oferta~") COLUMN(NAME=~"pagare.rut_aval~") COLUMN(NAME=~"pagare.kapital~") COLUMN(NAME=~"pagare.tasa~") COLUMN(NAME=~"pagare.valor_cuo~") COLUMN(NAME=~"pagare.fecha_prim~") COLUMN(NAME=~"pagare.fecha_ult~") COLUMN(NAME=~"pagare.plazo~") COLUMN(NAME=~"pagare.tot_pagado~") COLUMN(NAME=~"pagare.pie_pagado~") COLUMN(NAME=~"pagare.cta_pag_la~") COLUMN(NAME=~"pagare.cta_pag_isa~") COLUMN(NAME=~"pagare.abono_pag~") COLUMN(NAME=~"pagare.usuario~") COLUMN(NAME=~"pagare.fechas_ingreso~") COLUMN(NAME=~"pagare.estado~") COLUMN(NAME=~"pagare.nro_resc~") COLUMN(NAME=~"pagare.rut~") COLUMN(NAME=~"pagare.parque~") COLUMN(NAME=~"pagare.dueno~") COLUMN(NAME=~"pagare.origen~") COLUMN(NAME=~"pagare.moneda~") COLUMN(NAME=~"pagare.sector~") COLUMN(NAME=~"pagare.sepultura~") COLUMN(NAME=~"pagare.pie~") COLUMN(NAME=~"pagare.facturado~") COLUMN(NAME=~"pagare.base~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"cadena.cod_parque~") COLUMN(NAME=~"pagare.forma_pago~") COLUMN(NAME=~"pagare.glosa_ficha~")    JOIN (LEFT=~"pagare.rut~"    OP =~"=~"RIGHT=~"cliente.rut~" )    JOIN (LEFT=~"pagare.serie_p~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"pagare.nro_pagare~"    OP =~"=~"RIGHT=~"cadena.numero~" )WHERE(    EXP1 =~"~~~"PAGARE~~~".~~~"SERIE_P~~~"~"   OP =~"=~"    EXP2 =~":as_serie~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"PAGARE~~~".~~~"NRO_PAGARE~~~"~"   OP =~"=~"    EXP2 =~":an_numero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'P'~" ) ) ARG(NAME = ~"as_serie~" TYPE = string)  ARG(NAME = ~"an_numero~" TYPE = number) " arguments=(("as_serie", string),("an_numero", number)) )
