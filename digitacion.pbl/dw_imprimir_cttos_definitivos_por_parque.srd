compute(band=detail alignment="3" expression="'En '+UPPER( f_buscar_dato_membrete('ciudad'))+' de Chile, a '+  fecha_proceso_palabras  +' entre la sociedad '+ f_buscar_dato_membrete('empresa')+', persona jurídica del giro de su denominación, Rol Único Tributario '+UPPER( f_buscar_dato_membrete('rut'))+', representada por Don '+  gerente_operaciones_nombre  +', '+ gerente_operaciones_nacionalidad +', '+ gerente_operaciones_estado_civil +', '+ gerente_operaciones_titulo +', cédula nacional de identidad Nº '+ string( proceso_titulo_ctto_definitivo_rut_geren ,~"###,###,###,###,###~")+' - '+string( gerente_operaciones_dv ) + ', ambos domiciliados en ' + gerente_operaciones_direccion +', '+ gerente_operaciones_comuna +' y '+ gerente_operaciones_ciudad +', en adelante indistintamente '+'~"'+'la vendedora'+'~"'+', y '+ trato +' '+ nombre_cliente +', '+ codigo_estado_civil_descripcion+', cédula nacional de identidad Nº '+string( rut ,~"###,###,###,###,###~")+' - '+ dv +', domiciliado en '+  proceso_titulo_ctto_definitivo_tipo_via +' '+direccion_p +' '+ nro_particular + if (isnull( depto_particular ) or depto_particular='-', '', ' Depto.: '+depto_particular ) +' '+ if (isnull(  block_particular ) or block_particular='-', '', ' Block: '+ block_particular ) +', '+ poblacion +', comuna de '+   comuna_sigla_comuna  +' '+  ciudad_sigla_ciudad  +', en adelante indistintamente '+'~"'+'el comprador'+'~", se ha convenido en el siguiente contrato de compraventa de derechos de sepultación:'"border="0" color="0" x="64" y="1136" height="852" width="2775" format="[GENERAL]" html.valueishtml="0"  name=compute_2 visible="1"  font.face="Arial" font.height="-12" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" background.transparency="0" background.gradient.color="8421504" background.gradient.transparency="0" background.gradient.angle="0" background.brushmode="0" background.gradient.repetition.mode="0" background.gradient.repetition.count="0" background.gradient.repetition.length="100" background.gradient.focus="0" background.gradient.scale="100" background.gradient.spread="100" tooltip.backcolor="134217752" tooltip.delay.initial="0" tooltip.delay.visible="32000" tooltip.enabled="0" tooltip.hasclosebutton="0" tooltip.icon="0" tooltip.isbubble="0" tooltip.maxwidth="0" tooltip.textcolor="134217751" tooltip.transparency="0" transparency="0" )
compute(band=detail alignment="3" expression="'PRIMERO: Por instrumento privado de fecha '+  day(   fecha_promesa )+' de '+case( month(   fecha_promesa ) when 1 then 'Enero ' when 2 then 'Febrero ' when 3 then 'Marzo ' when 4 then 'Abril ' when 5 then 'Mayo ' when 6 then 'Junio ' when 7 then 'Julio ' when 8 then 'Agosto ' when 9 then 'Septiembre ' when 10 then 'Octubre ' when 11 then 'Noviembre ' when 12 then 'Diciembre ')+' de '+year(   fecha_promesa ) +', Nº '+ base +'-'+ serie +'-'+ string(numero ,~"###,###,###,###,###~")+', la sociedad '+ f_buscar_dato_membrete('empresa')+' prometió vender, ceder y transferir a '+ trato +' '+ nombre_cliente +', quien prometió comprar, aceptar y adquirir para sí, los derechos  de sepultación la sepultura Nº '+ nro_sepultura +' ubicada en sector '+ sector +', de la planimetría del Cementerio Parque '+'~"'+ f_buscar_dato_membrete('parque')+'~"'+', ubicado en la comuna de '+ f_buscar_dato_membrete('comuna')+', '+  f_buscar_dato_membrete('ciudad')+', con una capacidad de '+string( capacidad ,~"###,###,###,###~")+' difunto'+if ( capacidad >1,'s','')+', de carácter '+if ( capacidad >1,'familiar','individual')+', tipo '+  lower(tipo_construccion_descripcion) +', y de '+ if (uso='NI','Necesidad Inmediata','Necesidad Futura') +if ( capacidad > 1 ,', con el número de reducciones que se indica en el respectivo contrato de promesa de compraventa derechos de sepultación.  De conformidad al Nº 2 del citado contrato de promesa, la compraventa definitiva se otorgaría una vez que el precio de venta se encontrare íntegramente pagado.' , ', sin reducciones.  La compraventa definitiva se otorgaría una vez que el precio de venta se encontrare íntegramente pagado.')"border="0" color="0" x="64" y="2032" height="744" width="2775" format="[GENERAL]" html.valueishtml="0"  name=compute_3 visible="1"  font.face="Arial" font.height="-11" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" background.transparency="0" background.gradient.color="8421504" background.gradient.transparency="0" background.gradient.angle="0" background.brushmode="0" background.gradient.repetition.mode="0" background.gradient.repetition.count="0" background.gradient.repetition.length="100" background.gradient.focus="0" background.gradient.scale="100" background.gradient.spread="100" tooltip.backcolor="134217752" tooltip.delay.initial="0" tooltip.delay.visible="32000" tooltip.enabled="0" tooltip.hasclosebutton="0" tooltip.icon="0" tooltip.isbubble="0" tooltip.maxwidth="0" tooltip.textcolor="134217751" tooltip.transparency="0" transparency="0" )
compute(band=detail alignment="3" expression="'CUARTO: El comprador declara conocer y aceptar las características y ubicación de la sepultura.'"border="0" color="0" x="64" y="4156" height="208" width="2775" format="[GENERAL]" html.valueishtml="0"  name=compute_6 visible="1"  font.face="Arial" font.height="-11" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" background.transparency="0" background.gradient.color="8421504" background.gradient.transparency="0" background.gradient.angle="0" background.brushmode="0" background.gradient.repetition.mode="0" background.gradient.repetition.count="0" background.gradient.repetition.length="100" background.gradient.focus="0" background.gradient.scale="100" background.gradient.spread="100" tooltip.backcolor="134217752" tooltip.delay.initial="0" tooltip.delay.visible="32000" tooltip.enabled="0" tooltip.hasclosebutton="0" tooltip.icon="0" tooltip.isbubble="0" tooltip.maxwidth="0" tooltip.textcolor="134217751" tooltip.transparency="0" transparency="0" )
compute(band=detail alignment="3" expression="'QUINTO: En este acto '+ trato +' '+ nombre_cliente +' se obliga a: UNO) Pagar las cuotas de mantención anual de la sepultura respecto de la cual radican los derechos de sepultación objeto del presente instrumento, cuyo valor se señala en el Arancel del Cementerio Parque '+ f_buscar_dato_membrete('parque')+', documento que el comprador declara conocer y aceptar, así como sus posteriores modificaciones, y que forma parte integrante del presente instrumento para todos los efectos legales. Dichas cuotas deberán ser pagadas dentro del mes de '+case( MONTH(  proceso_titulo_ctto_definitivo_fecha_man  ) when 1 then 'Enero' when 2 then 'Febrero' when 3 then 'Marzo' when 4 then 'Abril' when 5 then 'Mayo' when 6 then 'Junio' when 7 then 'Julio' when 8 then 'Agosto' when 9 then 'Septiembre'  when 10 then 'Octubre' when 11 then 'Noviembre' else 'Diciembre')+' de cada año, a contar del año '+year(  proceso_titulo_ctto_definitivo_fecha_man  )+', en las oficinas de '+ f_buscar_dato_membrete('empresa')+', salvo que el comprador convenga por escrito con la vendedora una forma diferente de pago. El no pago de los referidos gastos de mantención hará devengar intereses penales por el atraso, equivalentes a la tasa de interés máximo convencional para operaciones no reajustables; y DOS) Pagar todos los servicios que requiera del Cementerio Parque '+ f_buscar_dato_membrete('parque')+', así como los gastos propiamente tales de sepultación, establecidos en el Reglamento Interno y Arancel del Cementerio Parque '+ f_buscar_dato_membrete('parque')+', documentos que el comprador declara conocer y aceptar en sus actuales términos, como asimismo sus posteriores modificaciones. Asimismo, ratifica y asume las demás obligaciones convenidas en el contrato de promesa de compraventa singularizado en la cláusula primera precedente en todo lo que no sean contradictorias con el presente contrato, las cuales se entienden formar parte de éste.'"border="0" color="0" x="64" y="4376" height="1280" width="2775" format="[GENERAL]" html.valueishtml="0"  name=compute_7 visible="1"  font.face="Arial" font.height="-11" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" background.transparency="0" background.gradient.color="8421504" background.gradient.transparency="0" background.gradient.angle="0" background.brushmode="0" background.gradient.repetition.mode="0" background.gradient.repetition.count="0" background.gradient.repetition.length="100" background.gradient.focus="0" background.gradient.scale="100" background.gradient.spread="100" tooltip.backcolor="134217752" tooltip.delay.initial="0" tooltip.delay.visible="32000" tooltip.enabled="0" tooltip.hasclosebutton="0" tooltip.icon="0" tooltip.isbubble="0" tooltip.maxwidth="0" tooltip.textcolor="134217751" tooltip.transparency="0" transparency="0" )
compute(band=detail alignment="3" expression="'SEGUNDO: Habiéndose verificado la condición suspensiva enunciada en la cláusula precedente, esto es, el pago íntegro del precio de la compraventa, en este acto, la sociedad '+ f_buscar_dato_membrete('empresa')+', debidamente, representada viene en vender, ceder y transferir a '+ trato +' '+ nombre_cliente +', quien compra, acepta y adquiere para sí los derechos de sepultación en la sepultura singularizada en la cláusula primera anterior.'"border="0" color="0" x="64" y="2856" height="420" width="2775" format="[GENERAL]" html.valueishtml="0"  name=compute_4 visible="1"  font.face="Arial" font.height="-11" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" background.transparency="0" background.gradient.color="8421504" background.gradient.transparency="0" background.gradient.angle="0" background.brushmode="0" background.gradient.repetition.mode="0" background.gradient.repetition.count="0" background.gradient.repetition.length="100" background.gradient.focus="0" background.gradient.scale="100" background.gradient.spread="100" tooltip.backcolor="134217752" tooltip.delay.initial="0" tooltip.delay.visible="32000" tooltip.enabled="0" tooltip.hasclosebutton="0" tooltip.icon="0" tooltip.isbubble="0" tooltip.maxwidth="0" tooltip.textcolor="134217751" tooltip.transparency="0" transparency="0" )
bitmap(band=detail filename="firma_p2.jpg" x="1541" y="9220" height="484" width="1225" border="0" tooltip.backcolor="134217752" tooltip.delay.initial="0" tooltip.delay.visible="32000" tooltip.enabled="0" tooltip.hasclosebutton="0" tooltip.icon="0" tooltip.isbubble="0" tooltip.maxwidth="0" tooltip.textcolor="134217751" tooltip.transparency="0"  name=p_1 visible="1" transparency="0" )
compute(band=detail alignment="3" expression="'SEXTO: Las partes estipulan que la responsabilidad del cliente y la de sus herederos y/o sucesores, respecto del pago de las cuotas de mantención establecidas en la cláusula precedente, tendrán el carácter de indivisible para todos los efectos legales y en especial para lo dispuesto en los artículos 1526 Nº 4 y 1528 del Código Civil.'"border="0" color="0" x="64" y="5676" height="344" width="2775" format="[GENERAL]" html.valueishtml="0"  name=compute_8 visible="1"  font.face="Arial" font.height="-11" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" background.transparency="0" background.gradient.color="8421504" background.gradient.transparency="0" background.gradient.angle="0" background.brushmode="0" background.gradient.repetition.mode="0" background.gradient.repetition.count="0" background.gradient.repetition.length="100" background.gradient.focus="0" background.gradient.scale="100" background.gradient.spread="100" tooltip.backcolor="134217752" tooltip.delay.initial="0" tooltip.delay.visible="32000" tooltip.enabled="0" tooltip.hasclosebutton="0" tooltip.icon="0" tooltip.isbubble="0" tooltip.maxwidth="0" tooltip.textcolor="134217751" tooltip.transparency="0" transparency="0" )
compute(band=detail alignment="3" expression="'SEPTIMO: En caso de que el comprador deje de pagar una o más de las cuotas de mantención estipuladas precedentemente, no podrá ejercer el derecho respecto de la  sepultura materia de éste contrato, y a su vez la vendedora queda facultada para que en tal evento, a su exclusivo arbitrio ejercer alguno de los siguientes derechos:'"border="0" color="0" x="64" y="6040" height="328" width="2775" format="[GENERAL]" html.valueishtml="0"  name=compute_9 visible="1"  font.face="Arial" font.height="-11" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" background.transparency="0" background.gradient.color="8421504" background.gradient.transparency="0" background.gradient.angle="0" background.brushmode="0" background.gradient.repetition.mode="0" background.gradient.repetition.count="0" background.gradient.repetition.length="100" background.gradient.focus="0" background.gradient.scale="100" background.gradient.spread="100" tooltip.backcolor="134217752" tooltip.delay.initial="0" tooltip.delay.visible="32000" tooltip.enabled="0" tooltip.hasclosebutton="0" tooltip.icon="0" tooltip.isbubble="0" tooltip.maxwidth="0" tooltip.textcolor="134217751" tooltip.transparency="0" transparency="0" )
compute(band=detail alignment="3" expression="'a)       Exigir el pago del valor a que asciendan las cuotas de mantención impagas, más los intereses de mora de acuerdo a la tasa de interés máximo convencional que esté vigente a la fecha del pago efectivo.

b)       Declarar resuelto Ipso Facto el presente contrato y todos aquellos otros actos que deriven del mismo. Para este efecto la vendedora notificará al comprador mediante una carta certificada a su domicilio, o bien, publicará un aviso en un diario de circulación nacional. En tal evento las partes estipulan como avaluación anticipada de los perjuicios causados por el incumplimiento del comprador, el equivalente a todas las sumas que haya pagado a la vendedora a cualquier título por concepto del presente contrato de compraventa, o por concepto de otros servicios indicados por el Reglamento Interno y Arancel del Cementerio, y facultando el comprador desde ya a '+ f_buscar_dato_membrete('empresa')+' para que una vez transcurridos treinta días del envío de la carta, o publicación del aviso, tome posesión de la sepultura individualizada precedentemente, pudiendo exhumar los restos que se halle'+if ( capacidad > 1, 'n' ,'')+' sepultado'+if ( capacidad > 1, 's' ,'')+' en ella'+if ( capacidad > 1, 's' ,'')+', sin perjuicio de otros derechos y de la reglamentación civil indemnizatoria.'"border="0" color="0" x="64" y="6380" height="1176" width="2775" format="[GENERAL]" html.valueishtml="0"  name=compute_14 visible="1"  font.face="Arial" font.height="-11" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" background.transparency="0" background.gradient.color="8421504" background.gradient.transparency="0" background.gradient.angle="0" background.brushmode="0" background.gradient.repetition.mode="0" background.gradient.repetition.count="0" background.gradient.repetition.length="100" background.gradient.focus="0" background.gradient.scale="100" background.gradient.spread="100" tooltip.backcolor="134217752" tooltip.delay.initial="0" tooltip.delay.visible="32000" tooltip.enabled="0" tooltip.hasclosebutton="0" tooltip.icon="0" tooltip.isbubble="0" tooltip.maxwidth="0" tooltip.textcolor="134217751" tooltip.transparency="0" transparency="0" )
compute(band=detail alignment="3" expression="'OCTAVO: En el evento que '+ f_buscar_dato_membrete('empresa')+' tenga derecho a ejercer la facultad de resolver el contrato de compraventa, de conformidad con lo estipulado en la cláusula séptima letra b precedente, el comprador viene por éste acto en conferir a '+ f_buscar_dato_membrete('empresa')+', un mandato especial e irrevocable en los términos del artículo 241 del Código de Comercio para suscribir en su nombre y representación, EL CONTRATO DE RESOLUCIÓN DEL PRESENTE CONTRATO DE COMPRAVENTA, facultándole expresamente para autocontratar. Dicho contrato deberá contemplar, además de las estipulaciones usuales, las siguientes: 1) Una declaración en orden a que las partes han estipulado como avaluación anticipada de los perjuicios causados por el incumplimiento del comprador, el equivalente a todas las sumas que éste haya pagado a la vendedora a cualquier título por concepto del presente contrato de compraventa, o por concepto de otros servicios indicados por el Reglamento Interno y Arancel del Cementerio, por lo cual no corresponderá pago alguno a la compradora por efecto de la resolución del contrato; 2) Estipular la entrega material '+if ( capacidad > 1 ,'de los derechos', 'del derecho')+' de sepultación respecto de la sepultura individualizada precedentemente, y 3) Facultar a '+ f_buscar_dato_membrete('empresa')+' para exhumar los restos que se hallen sepultado'+if ( capacidad >1,'s','')+', y pactar todas las demás estipulaciones necesarias para resolver el presente contrato de compraventa. '+ f_buscar_dato_membrete('empresa')+' acepta por éste acto el mandato conferido.'"border="0" color="0" x="64" y="7588" height="1372" width="2775" format="[GENERAL]" html.valueishtml="0"  name=compute_10 visible="1"  font.face="Arial" font.height="-11" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" background.transparency="0" background.gradient.color="8421504" background.gradient.transparency="0" background.gradient.angle="0" background.brushmode="0" background.gradient.repetition.mode="0" background.gradient.repetition.count="0" background.gradient.repetition.length="100" background.gradient.focus="0" background.gradient.scale="100" background.gradient.spread="100" tooltip.backcolor="134217752" tooltip.delay.initial="0" tooltip.delay.visible="32000" tooltip.enabled="0" tooltip.hasclosebutton="0" tooltip.icon="0" tooltip.isbubble="0" tooltip.maxwidth="0" tooltip.textcolor="134217751" tooltip.transparency="0" transparency="0" )
compute(band=detail alignment="3" expression="'NOVENO: Para todos los efectos legales de este instrumento, las partes fijan su domicilio en la ciudad de '+ UPPER( f_buscar_dato_membrete('ciudad'))  +' y se someten desde ya a la competencia de sus Tribunales de Justicia.'"border="0" color="0" x="64" y="8972" height="240" width="2775" format="[GENERAL]" html.valueishtml="0"  name=compute_11 visible="1"  font.face="Arial" font.height="-11" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" background.transparency="0" background.gradient.color="8421504" background.gradient.transparency="0" background.gradient.angle="0" background.brushmode="0" background.gradient.repetition.mode="0" background.gradient.repetition.count="0" background.gradient.repetition.length="100" background.gradient.focus="0" background.gradient.scale="100" background.gradient.spread="100" tooltip.backcolor="134217752" tooltip.delay.initial="0" tooltip.delay.visible="32000" tooltip.enabled="0" tooltip.hasclosebutton="0" tooltip.icon="0" tooltip.isbubble="0" tooltip.maxwidth="0" tooltip.textcolor="134217751" tooltip.transparency="0" transparency="0" )
