 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"contrato~" )  TABLE(NAME=~"cliente~" )  TABLE(NAME=~"cadena~" ) COLUMN(NAME=~"contrato.serie_c~") COLUMN(NAME=~"contrato.nro_contrato~") COLUMN(NAME=~"contrato.fecha~") COLUMN(NAME=~"contrato.serie~") COLUMN(NAME=~"contrato.nro_pagare~") COLUMN(NAME=~"contrato.rut_aval~") COLUMN(NAME=~"contrato.kapital~") COLUMN(NAME=~"contrato.tasa~") COLUMN(NAME=~"contrato.valor_cuo~") COLUMN(NAME=~"contrato.fecha_prim~") COLUMN(NAME=~"contrato.fecha_ult~") COLUMN(NAME=~"contrato.plazo~") COLUMN(NAME=~"contrato.tot_pagado~") COLUMN(NAME=~"contrato.cta_pag_la~") COLUMN(NAME=~"contrato.cta_pag_isa~") COLUMN(NAME=~"contrato.abono_pag~") COLUMN(NAME=~"contrato.usuario~") COLUMN(NAME=~"contrato.fechas_ingreso~") COLUMN(NAME=~"contrato.estado~") COLUMN(NAME=~"contrato.nro_resc~") COLUMN(NAME=~"contrato.rut~") COLUMN(NAME=~"contrato.parque~") COLUMN(NAME=~"contrato.dueno~") COLUMN(NAME=~"contrato.origen~") COLUMN(NAME=~"contrato.moneda~") COLUMN(NAME=~"contrato.ubs~") COLUMN(NAME=~"contrato.fec_restr~") COLUMN(NAME=~"contrato.cod_banco~") COLUMN(NAME=~"contrato.sector~") COLUMN(NAME=~"contrato.sepultura~") COLUMN(NAME=~"contrato.status~") COLUMN(NAME=~"contrato.statu2~") COLUMN(NAME=~"contrato.zona~") COLUMN(NAME=~"contrato.capacidad~") COLUMN(NAME=~"contrato.canc~") COLUMN(NAME=~"contrato.vend~") COLUMN(NAME=~"contrato.la_primer_v~") COLUMN(NAME=~"contrato.pie~") COLUMN(NAME=~"contrato.pie_pagado~") COLUMN(NAME=~"contrato.agente~") COLUMN(NAME=~"contrato.cta_pag_m~") COLUMN(NAME=~"contrato.valor_cuota_m~") COLUMN(NAME=~"contrato.fecha_m~") COLUMN(NAME=~"contrato.abono_m~") COLUMN(NAME=~"contrato.nro_tec~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"cadena.cod_parque~") COLUMN(NAME=~"contrato.cod_convenio~") COLUMN(NAME=~"contrato.uso~") COLUMN(NAME=~"contrato.forma_pago~")    JOIN (LEFT=~"contrato.rut~"    OP =~"=~"RIGHT=~"cliente.rut~" )    JOIN (LEFT=~"contrato.serie_c~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"contrato.nro_contrato~"    OP =~"=~"RIGHT=~"cadena.numero~" )WHERE(    EXP1 =~"~~~"CONTRATO~~~".~~~"SERIE_C~~~"~"   OP =~"=~"    EXP2 =~":as_serie~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CONTRATO~~~".~~~"NRO_CONTRATO~~~"~"   OP =~"=~"    EXP2 =~":an_numero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'C'~" ) ) ARG(NAME = ~"as_serie~" TYPE = string)  ARG(NAME = ~"an_numero~" TYPE = number) " arguments=(("as_serie", string),("an_numero", number)) )
