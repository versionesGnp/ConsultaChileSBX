 retrieve="SELECT ~"CADENA~".~"CODIGO~",   
         ~"CADENA~".~"SERIE~",
         ~"CADENA~".~"NUMERO~"   ,
         ~"CLIENTE~".~"RUT~",   
~"CLIENTE~".~"DV~",   
         ~"CLIENTE~".~"NOMBRE~",
         ~"CLIENTE~".~"A_PATERNO~" ,  
         ~"CLIENTE~".~"A_MATERNO~"  , 
         ~"OFERTA_V~".~"FORMA_PAGO~",   
         ~"PAGO_OFERTA~".~"VALOR_CUOTA~",   
         ~"PAGO_OFERTA~".~"NRO_CUOTAS~",
         ~"OFERTA_V~".~"COD_AGE~",   
         ~"OFERTA_V~".~"COD_SUP~",   
         ~"OFERTA_V~".~"FECHA~",   
         ~"OFERTA_V~".~"TIPO_SEPULT~",   
         ~"OFERTA_V~".~"TIPO_VENTA~",   
         '',   
         ~"OFERTA_V~".~"USO~",
         ~"PAGO_OFERTA~".~"PARQUE~",   
         ~"PAGO_OFERTA~".~"AREA~",   
         ~"PAGO_OFERTA~".~"SECTOR~"  ,
         ~"PAGO_OFERTA~".~"SEPULTURA~",   
         ~"PAGO_OFERTA~".~"PIE~",   
         ~"PAGO_OFERTA~".~"CAPACIDAD~",   
         ~"PAGO_OFERTA~".~"N_REDUCCION~" ,  
         ~"PAGO_OFERTA~".~"DES_ESP~",   
         ~"OFERTA_V~".~"USUARIO~",   
         ~"OFERTA_V~".~"INGRESO_SISTEMA~",   
         ~"CLIENTE~".~"FECHA_NAC~",   
         ~"CLIENTE~".~"ESTA_CIVIL~",   
         ~"CLIENTE~".~"FONO_P~"  , 
	~"CLIENTE~".~"FONO_C~"  ,
		~"CLIENTE~".~"EMAIL~"  ,
         ~"OFERTA_V~".~"VALOR_CUOTA_M~",   
         ~"CLIENTE~".~"CELULAR~",   
         ~"OFERTA_V~".~"FECHA_M~",   
         ~"OFERTA_V~".~"PROMOCION~",   
         ~"PAGO_OFERTA~".~"FECHA_ENTRE~",   
         ~"OFERTA_V~".~"RUT_AVAL~",   
         ~"AVAL~".~"NOMBRE~",   
         ~"AVAL~".~"A_PATERNO~",   
         ~"AVAL~".~"A_MATERNO~",   
         ~"OFERTA_V~".~"COD_JEF~"   ,
         ~"CLIENTE~".~"DIRECCION_P~",
         ~"CLIENTE~".~"NUMERO_PARTICULAR~",   
         ~"CLIENTE~".~"BLOCK_PARTICULAR~",   
         ~"CLIENTE~".~"DEPTO_PARTICULAR~",
         ~"CLIENTE~".~"POBLACION~",
         ~"CLIENTE~".~"SECTOR~",   
         ~"PAGO_OFERTA~".~"PRECIO~",
         ~"PAGO_OFERTA~".~"CTAS_PACTADAS_PIE~",   
         ~"PAGO_OFERTA~".~"CODIGO_TIPO_SEGURO~",   
         ~"CLIENTE~".~"COMUNA~",
         ~"COMUNA~".~"COMUNA~",   
         ~"PAGO_OFERTA~".~"FECHA_PRIM~", 
        ( SELECT sum( ~"VISTA_PAGOS_DIGITACION_INFORME~".~"SUMA_MONTO~") FROM ~"VISTA_PAGOS_DIGITACION_INFORME~" WHERE  ~"VISTA_PAGOS_DIGITACION_INFORME~".~"BASE~" = ~"CADENA~".~"CODIGO~"  AND  ~"VISTA_PAGOS_DIGITACION_INFORME~".~"SERIE~" = ~"CADENA~".~"SERIE~"  AND ~"VISTA_PAGOS_DIGITACION_INFORME~".~"NUMERO~" = ~"CADENA~".~"NUMERO~" AND to_date(~"VISTA_PAGOS_DIGITACION_INFORME~".~"FECHA_PAGO~",'dd/mm/yyyy') >= :fech_ini AND to_date(~"VISTA_PAGOS_DIGITACION_INFORME~".~"FECHA_PAGO~",'dd/mm/yyyy') <= :fech_fin ) as sumar_monto  
    FROM ~"CADENA~",   
         ~"OFERTA_V~",   
         ~"PAGO_OFERTA~",   
         ~"CLIENTE~",   
         ~"AVAL~",   
         ~"COMUNA~"  
   WHERE ( oferta_v.rut_aval = aval.rut (+)) and  
         ( ~"PAGO_OFERTA~".~"SERIE~" = ~"OFERTA_V~".~"SERIE~" ) and  
         ( ~"OFERTA_V~".~"NRO_OFERTA~" = ~"PAGO_OFERTA~".~"NRO_OFERTA~" ) and  
         ( ~"PAGO_OFERTA~".~"FOLIO~" = ~"OFERTA_V~".~"ULT_FOLIO~" ) and  
		( ~"CADENA~".~"CODIGO~" = 'O' OR ~"CADENA~".~"CODIGO~" = 'U' ) and  
         ( ~"CADENA~".~"SERIE~" = ~"OFERTA_V~".~"SERIE~" ) and  
         ( ~"CADENA~".~"NUMERO~" = ~"OFERTA_V~".~"NRO_OFERTA~" ) and  
         ( ~"OFERTA_V~".~"RUT~" = ~"CLIENTE~".~"RUT~" ) and  
         ( ~"CLIENTE~".~"COMUNA~" = ~"COMUNA~".~"CODIGO_COMUNA~" )  and  
         ( ( ~"OFERTA_V~".~"INGRESO_SISTEMA~" >= :fech_ini  ) AND  
         ( ~"OFERTA_V~".~"INGRESO_SISTEMA~" <= :fech_fin  ) )    

union

  SELECT ~"CADENA~".~"CODIGO~" ,
         ~"CADENA~".~"SERIE~",
         ~"CADENA~".~"NUMERO~",
         ~"CLIENTE~".~"RUT~" ,  
~"CLIENTE~".~"DV~",   
         ~"CLIENTE~".~"NOMBRE~",
         ~"CLIENTE~".~"A_PATERNO~",
         ~"CLIENTE~".~"A_MATERNO~",
         ~"ANEXO_AUMENTO~".~"FORMA_PAGO~",   
         ~"PAGO_AUMENTO~".~"VALOR_CUOTA~",   
         ~"PAGO_AUMENTO~".~"NRO_CUOTAS~",
         ~"ANEXO_AUMENTO~".~"COD_AGENTE~",   
         ~"ANEXO_AUMENTO~".~"COD_SUPER~",   
         ~"PAGO_AUMENTO~".~"FECHA~",   
         ~"ANEXO_AUMENTO~".~"TIPO_SEPULT~",   
         ~"ANEXO_AUMENTO~".~"TIPO_VENTA~" , 
         '',   
         ~"ANEXO_AUMENTO~".~"USO~",
         ~"CADENA~".~"COD_PARQUE~",   
         ~"ANEXO_AUMENTO~".~"AREA~",   
         '' as SECTOR,   
         '' as SEPULTURA,   
         ~"PAGO_AUMENTO~".~"PIE~",   
         ~"PAGO_AUMENTO~".~"CAPACIDAD~",   
         '' as N_REDUCCION ,  
         0 as DES_ESP,   
         ~"ANEXO_AUMENTO~".~"USUARIO~",   
         ~"ANEXO_AUMENTO~".~"INGRESO_SISTEMA~",   
         ~"CLIENTE~".~"FECHA_NAC~",   
         ~"CLIENTE~".~"ESTA_CIVIL~",   
         ~"CLIENTE~".~"FONO_P~",
	~"CLIENTE~".~"FONO_C~"  ,
		~"CLIENTE~".~"EMAIL~"  ,  
         0 as VALOR_CUOTA_M,   
         ~"CLIENTE~".~"CELULAR~",   
         ~"CADENA~".~"FECHA_RES~" as FECHA_M,   
         0 as PROMOCION,   
         ~"PAGO_AUMENTO~".~"FECHA_ULT~",   
         ~"AVAL~".~"RUT~"   ,
         ~"AVAL~".~"NOMBRE~",   
         ~"AVAL~".~"A_PATERNO~",   
         ~"AVAL~".~"A_MATERNO~",   
         ~"ANEXO_AUMENTO~".~"COD_JEF~",
         ~"CLIENTE~".~"DIRECCION_P~",
         ~"CLIENTE~".~"NUMERO_PARTICULAR~",   
         ~"CLIENTE~".~"BLOCK_PARTICULAR~",   
         ~"CLIENTE~".~"DEPTO_PARTICULAR~",
         ~"CLIENTE~".~"POBLACION~",   
         ~"CLIENTE~".~"SECTOR~",   
         ~"PAGO_AUMENTO~".~"PRECIO~",
         ~"PAGO_AUMENTO~".~"CTAS_PACTADAS_PIE~",   
         0 as CODIGO_TIPO_SEGURO,   
         ~"CLIENTE~".~"COMUNA~",
         ~"COMUNA~".~"COMUNA~",   
         ~"PAGO_AUMENTO~".~"FECHA_PRIM~"  ,
         ( SELECT sum( ~"VISTA_PAGOS_DIGITACION_INFORME~".~"SUMA_MONTO~") FROM ~"VISTA_PAGOS_DIGITACION_INFORME~" WHERE  ~"VISTA_PAGOS_DIGITACION_INFORME~".~"BASE~" = ~"CADENA~".~"CODIGO~"  AND  ~"VISTA_PAGOS_DIGITACION_INFORME~".~"SERIE~" = ~"CADENA~".~"SERIE~"  AND ~"VISTA_PAGOS_DIGITACION_INFORME~".~"NUMERO~" = ~"CADENA~".~"NUMERO~" AND ~"VISTA_PAGOS_DIGITACION_INFORME~".~"FECHA_PAGO~" >= :fech_ini AND ~"VISTA_PAGOS_DIGITACION_INFORME~".~"FECHA_PAGO~" <= :fech_fin ) as sumar_monto  
    FROM ~"CADENA~",   
         ~"CLIENTE~",   
         ~"AVAL~",   
         ~"COMUNA~",   
         ~"ANEXO_AUMENTO~",   
         ~"PAGO_AUMENTO~"  
   WHERE ( ~"PAGO_AUMENTO~".~"SERIE_M~" = ~"ANEXO_AUMENTO~".~"SERIE_M~" ) and  
         ( ~"PAGO_AUMENTO~".~"NRO_AUMENTO~" = ~"ANEXO_AUMENTO~".~"NRO_AUMENTO~" ) and  
         ( ~"PAGO_AUMENTO~".~"FOLIO~" = ~"ANEXO_AUMENTO~".~"ULT_FOLIO~" ) and  
         ( ~"CADENA~".~"SERIE~" = ~"ANEXO_AUMENTO~".~"SERIE_M~" ) and  
         ( ~"CADENA~".~"NUMERO~" = ~"ANEXO_AUMENTO~".~"NRO_AUMENTO~" ) and  
         ( anexo_aumento.rut = aval.rut (+)) and  
         ( ~"ANEXO_AUMENTO~".~"RUT~" = ~"CLIENTE~".~"RUT~" ) and  
         ( ~"CLIENTE~".~"COMUNA~" = ~"COMUNA~".~"CODIGO_COMUNA~" ) and  
         ( ~"CADENA~".~"CODIGO~" = 'A' ) AND  
         ( ( ~"ANEXO_AUMENTO~".~"INGRESO_SISTEMA~" >= :fech_ini  ) AND  
         ( ~"ANEXO_AUMENTO~".~"INGRESO_SISTEMA~" <= :fech_fin  ) )  

union

  SELECT ~"CADENA~".~"CODIGO~" ,
         ~"CADENA~".~"SERIE~",
         ~"CADENA~".~"NUMERO~",
         ~"CLIENTE~".~"RUT~" ,  
~"CLIENTE~".~"DV~",   
         ~"CLIENTE~".~"NOMBRE~",
         ~"CLIENTE~".~"A_PATERNO~",
         ~"CLIENTE~".~"A_MATERNO~",
         ~"ANEXO_LIBERADOR~".~"FORMA_PAGO~",   
         ~"PAGO_LIBERADOR~".~"VALOR_CUOTA~",   
         ~"PAGO_LIBERADOR~".~"NRO_CUOTAS~",
         ~"ANEXO_LIBERADOR~".~"COD_AGENTE~",   
         ~"ANEXO_LIBERADOR~".~"COD_SUPER~",   
         ~"PAGO_LIBERADOR~".~"FECHA~",   
         '' as TIPO_SEPULT,   
         '' as TIPO_VENTA , 
         '',   
         ~"ANEXO_LIBERADOR~".~"CANAL_VENTA~",
         ~"CADENA~".~"COD_PARQUE~",   
         '' as AREA,   
         '' as SECTOR,   
         '' as SEPULTURA,   
         ~"PAGO_LIBERADOR~".~"PIE~",   
         0 as CAPACIDAD,   
         '' as N_REDUCCION ,  
         0 as DES_ESP,   
         ~"ANEXO_LIBERADOR~".~"USUARIO~",   
         ~"ANEXO_LIBERADOR~".~"INGRESO_SISTEMA~",   
         ~"CLIENTE~".~"FECHA_NAC~",   
         ~"CLIENTE~".~"ESTA_CIVIL~",   
         ~"CLIENTE~".~"FONO_P~", 
	~"CLIENTE~".~"FONO_C~"  ,
		~"CLIENTE~".~"EMAIL~"  , 
         0 as VALOR_CUOTA_M,   
         ~"CLIENTE~".~"CELULAR~",   
         ~"CADENA~".~"FECHA_RES~" as FECHA_M,   
         0 as PROMOCION,   
         ~"PAGO_LIBERADOR~".~"FECHA_ULT~",   
         ~"AVAL~".~"RUT~"   ,
         ~"AVAL~".~"NOMBRE~",   
         ~"AVAL~".~"A_PATERNO~",   
         ~"AVAL~".~"A_MATERNO~",   
         ~"ANEXO_LIBERADOR~".~"COD_JEF~",
         ~"CLIENTE~".~"DIRECCION_P~",
         ~"CLIENTE~".~"NUMERO_PARTICULAR~",   
         ~"CLIENTE~".~"BLOCK_PARTICULAR~",   
         ~"CLIENTE~".~"DEPTO_PARTICULAR~",
         ~"CLIENTE~".~"POBLACION~",   
         ~"CLIENTE~".~"SECTOR~",   
         ~"PAGO_LIBERADOR~".~"PRECIO~",
         ~"PAGO_LIBERADOR~".~"CTAS_PACTADAS_PIE~",   
         0 as CODIGO_TIPO_SEGURO,   
         ~"CLIENTE~".~"COMUNA~",
         ~"COMUNA~".~"COMUNA~",   
         ~"PAGO_LIBERADOR~".~"FECHA_PRIM~"  ,
         ( SELECT sum( ~"VISTA_PAGOS_DIGITACION_INFORME~".~"SUMA_MONTO~") FROM ~"VISTA_PAGOS_DIGITACION_INFORME~" WHERE  ~"VISTA_PAGOS_DIGITACION_INFORME~".~"BASE~" = ~"CADENA~".~"CODIGO~"  AND  ~"VISTA_PAGOS_DIGITACION_INFORME~".~"SERIE~" = ~"CADENA~".~"SERIE~"  AND ~"VISTA_PAGOS_DIGITACION_INFORME~".~"NUMERO~" = ~"CADENA~".~"NUMERO~" AND ~"VISTA_PAGOS_DIGITACION_INFORME~".~"FECHA_PAGO~" >= :fech_ini AND ~"VISTA_PAGOS_DIGITACION_INFORME~".~"FECHA_PAGO~" <= :fech_fin ) as sumar_monto  
    FROM ~"CADENA~",   
         ~"CLIENTE~",   
         ~"AVAL~",   
         ~"COMUNA~",   
         ~"ANEXO_LIBERADOR~",   
         ~"PAGO_LIBERADOR~"  
   WHERE ( ~"PAGO_LIBERADOR~".~"SERIE_M~" = ~"ANEXO_LIBERADOR~".~"SERIE_M~" ) and  
         ( ~"PAGO_LIBERADOR~".~"NRO_LIBERADOR~" = ~"ANEXO_LIBERADOR~".~"NRO_LIBERADOR~" ) and  
         ( ~"PAGO_LIBERADOR~".~"FOLIO~" = ~"ANEXO_LIBERADOR~".~"ULT_FOLIO~" ) and  
         ( ~"CADENA~".~"SERIE~" = ~"ANEXO_LIBERADOR~".~"SERIE_M~" ) and  
         ( ~"CADENA~".~"NUMERO~" = ~"ANEXO_LIBERADOR~".~"NRO_LIBERADOR~" ) and  
         ( anexo_liberador.rut = aval.rut (+)) and  
         ( ~"ANEXO_LIBERADOR~".~"RUT~" = ~"CLIENTE~".~"RUT~" ) and  
         ( ~"CLIENTE~".~"COMUNA~" = ~"COMUNA~".~"CODIGO_COMUNA~" ) and  
         ( ~"CADENA~".~"CODIGO~" = 'L' ) AND  
         ( ( ~"ANEXO_LIBERADOR~".~"INGRESO_SISTEMA~" >= :fech_ini  ) AND  
         ( ~"ANEXO_LIBERADOR~".~"INGRESO_SISTEMA~" <= :fech_fin  ) ) 

UNION

SELECT ~"CADENA~".~"CODIGO~" ,
         ~"CADENA~".~"SERIE~",
         ~"CADENA~".~"NUMERO~",
         ~"CLIENTE~".~"RUT~" ,  
~"CLIENTE~".~"DV~",   
         ~"CLIENTE~".~"NOMBRE~",
         ~"CLIENTE~".~"A_PATERNO~",
         ~"CLIENTE~".~"A_MATERNO~",
         ~"PRODUCTO_ANEXO~".~"FORMA_PAGO~",   
         ~"PRODUCTO_PAGO~".~"VALOR_CUOTA~",   
         ~"PRODUCTO_PAGO~".~"PLAZO~",
         ~"PRODUCTO_ANEXO~".~"COD_AGENTE~",   
         ~"PRODUCTO_ANEXO~".~"COD_SUPER~",   
         ~"PRODUCTO_PAGO~".~"FECHA~",   
         '' as TIPO_SEPULT,   
         '' as TIPO_VENTA , 
         '',   
         ~"PRODUCTO_ANEXO~".~"TIPO_VENTA~",
         ~"CADENA~".~"COD_PARQUE~",   
         '' as AREA,   
         '' as SECTOR,   
         '' as SEPULTURA,   
         ~"PRODUCTO_PAGO~".~"PIE~",   
         0 as CAPACIDAD,   
         '' as N_REDUCCION ,  
         0 as DES_ESP,   
         ~"PRODUCTO_PAGO~".~"USUARIO_CREA~",   
         ~"PRODUCTO_ANEXO~".~"INGRESO_SISTEMA~",   
         ~"CLIENTE~".~"FECHA_NAC~",   
         ~"CLIENTE~".~"ESTA_CIVIL~",   
         ~"CLIENTE~".~"FONO_P~", 
	~"CLIENTE~".~"FONO_C~"  ,
		~"CLIENTE~".~"EMAIL~"  , 
         0 as VALOR_CUOTA_M,   
         ~"CLIENTE~".~"CELULAR~",   
         ~"CADENA~".~"FECHA_RES~" as FECHA_M,   
         0 as PROMOCION,   
         ~"PRODUCTO_PAGO~".~"FECHA_ULT~",   
         ~"AVAL~".~"RUT~"   ,
         ~"AVAL~".~"NOMBRE~",   
         ~"AVAL~".~"A_PATERNO~",   
         ~"AVAL~".~"A_MATERNO~",   
         ~"PRODUCTO_ANEXO~".~"COD_JEFE~",
         ~"CLIENTE~".~"DIRECCION_P~",
         ~"CLIENTE~".~"NUMERO_PARTICULAR~",   
         ~"CLIENTE~".~"BLOCK_PARTICULAR~",   
         ~"CLIENTE~".~"DEPTO_PARTICULAR~",
         ~"CLIENTE~".~"POBLACION~",   
         ~"CLIENTE~".~"SECTOR~",   
         ~"PRODUCTO_PAGO~".~"PRECIO~",
         ~"PRODUCTO_PAGO~".~"CTAS_PIE_PLAZO~",   
         0 as CODIGO_TIPO_SEGURO,   
         ~"CLIENTE~".~"COMUNA~",
         ~"COMUNA~".~"COMUNA~",   
         ~"PRODUCTO_PAGO~".~"FECHA_PRIM~"  ,
         ( SELECT sum( ~"VISTA_PAGOS_DIGITACION_INFORME~".~"SUMA_MONTO~") FROM ~"VISTA_PAGOS_DIGITACION_INFORME~" WHERE  ~"VISTA_PAGOS_DIGITACION_INFORME~".~"BASE~" = ~"CADENA~".~"CODIGO~"  AND  ~"VISTA_PAGOS_DIGITACION_INFORME~".~"SERIE~" = ~"CADENA~".~"SERIE~"  AND ~"VISTA_PAGOS_DIGITACION_INFORME~".~"NUMERO~" = ~"CADENA~".~"NUMERO~" AND ~"VISTA_PAGOS_DIGITACION_INFORME~".~"FECHA_PAGO~" >= :fech_ini  AND ~"VISTA_PAGOS_DIGITACION_INFORME~".~"FECHA_PAGO~" <= :fech_fin  ) as sumar_monto  
    FROM ~"CADENA~",   
         ~"CLIENTE~",   
         ~"AVAL~",   
         ~"COMUNA~",   
         ~"PRODUCTO_ANEXO~",   
         ~"PRODUCTO_PAGO~"  
   WHERE ( ~"PRODUCTO_PAGO~".~"SERIE~" = ~"PRODUCTO_ANEXO~".~"SERIE~" ) and  
         ( ~"PRODUCTO_PAGO~".~"NUMERO~" = ~"PRODUCTO_ANEXO~".~"NUMERO~" ) and  
         ( ~"PRODUCTO_PAGO~".~"FOLIO~" = ~"PRODUCTO_ANEXO~".~"ULT_FOLIO~" ) and  
         ( ~"CADENA~".~"SERIE~" = ~"PRODUCTO_ANEXO~".~"SERIE~" ) and  
         ( ~"CADENA~".~"NUMERO~" = ~"PRODUCTO_ANEXO~".~"NUMERO~" ) and  
         ( producto_anexo.rut = aval.rut (+)) and  
         ( ~"PRODUCTO_ANEXO~".~"RUT~" = ~"CLIENTE~".~"RUT~" ) and  
         ( ~"CLIENTE~".~"COMUNA~" = ~"COMUNA~".~"CODIGO_COMUNA~" ) and  
         ( ~"CADENA~".~"CODIGO~" = 'G' )  AND  
         ( ( ~"PRODUCTO_ANEXO~".~"INGRESO_SISTEMA~" >= :fech_ini ) AND  
         ( ~"PRODUCTO_ANEXO~".~"INGRESO_SISTEMA~" <= :fech_fin ) ) 
