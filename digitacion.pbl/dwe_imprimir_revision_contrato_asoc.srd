 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"revision_contratos~" ) COLUMN(NAME=~"revision_contratos.base~") COLUMN(NAME=~"revision_contratos.serie~") COLUMN(NAME=~"revision_contratos.numero~") COLUMN(NAME=~"revision_contratos.rut~") COLUMN(NAME=~"revision_contratos.dv~") COLUMN(NAME=~"revision_contratos.usuario_crea~") COLUMN(NAME=~"revision_contratos.fecha_crea~") COLUMN(NAME=~"revision_contratos.estado_revision~")WHERE(    EXP1 =~"~~~"REVISION_CONTRATOS~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"REVISION_CONTRATOS~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"REVISION_CONTRATOS~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"REVISION_CONTRATOS~~~".~~~"RUT~~~"~"   OP =~"=~"    EXP2 =~":rut~" ) ) ARG(NAME = ~"rut~" TYPE = number)  ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number)  ARG(NAME = ~"usuario~" TYPE = string) " arguments=(("rut", number),("base", string),("serie", string),("numero", number),("usuario", string)) )
