 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cadena~" )  TABLE(NAME=~"estado~" )  TABLE(NAME=~"repacta_mantencion~" ) COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"cadena.fecha_res~") COLUMN(NAME=~"cadena.nro_carta~") COLUMN(NAME=~"cadena.fecha_carta~") COLUMN(NAME=~"cadena.estado_carta~") COLUMN(NAME=~"cadena.estado_titulo~") COLUMN(NAME=~"cadena.fecha_titulo~") COLUMN(NAME=~"estado.nombre_estado~") COLUMN(NAME=~"repacta_mantencion.base~") COLUMN(NAME=~"repacta_mantencion.serie~") COLUMN(NAME=~"repacta_mantencion.numero~") COLUMN(NAME=~"repacta_mantencion.correlativo~") COLUMN(NAME=~"repacta_mantencion.base_original~") COLUMN(NAME=~"repacta_mantencion.serie_original~") COLUMN(NAME=~"repacta_mantencion.numero_original~") COLUMN(NAME=~"repacta_mantencion.fecha_crea~") COLUMN(NAME=~"repacta_mantencion.cuotas_pactadas~") COLUMN(NAME=~"repacta_mantencion.fecha_primera_cta~") COLUMN(NAME=~"repacta_mantencion.cuotas_en_mora~") COLUMN(NAME=~"repacta_mantencion.ctas_pagadas~") COLUMN(NAME=~"repacta_mantencion.uf_dia~") COLUMN(NAME=~"repacta_mantencion.total_deuda_uf~") COLUMN(NAME=~"repacta_mantencion.valor_cuota_uf~") COLUMN(NAME=~"repacta_mantencion.cta_mora_original~") COLUMN(NAME=~"repacta_mantencion.total_pagado~") COLUMN(NAME=~"cadena.cod_parque~")    JOIN (LEFT=~"cadena.estado~"    OP =~"=~"RIGHT=~"estado.cod_estado~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"repacta_mantencion.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"repacta_mantencion.numero~" )WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":as_serie~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":an_numero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'R'~" ) ) ARG(NAME = ~"as_serie~" TYPE = string)  ARG(NAME = ~"an_numero~" TYPE = number) " arguments=(("as_serie", string),("an_numero", number)) )
