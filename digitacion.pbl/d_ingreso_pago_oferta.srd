release 7;
datawindow(units=0 timer_interval=0 color=80269524 processing=0 HTMLDW=no print.documentname="" print.orientation = 0 print.margin.left = 110 print.margin.right = 110 print.margin.top = 97 print.margin.bottom = 97 print.paper.source = 0 print.paper.size = 0 print.prompt=no print.buttons=no print.preview.buttons=no )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=648 color="536870912" )
table(column=(type=char(1) update=yes updatewhereclause=yes key=yes name=serie dbname="pago_oferta.serie" )
 column=(type=decimal(4) update=yes updatewhereclause=yes key=yes name=nro_oferta dbname="pago_oferta.nro_oferta" )
 column=(type=datetime update=yes updatewhereclause=yes name=fecha dbname="pago_oferta.fecha" )
 column=(type=decimal(4) update=yes updatewhereclause=yes key=yes name=folio dbname="pago_oferta.folio" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=precio dbname="pago_oferta.precio" validation="double(gettext()) < if(moneda = '2', 500, 9000000)" validationmsg="~"Valor muy alto~"" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=pie dbname="pago_oferta.pie" validation="double(gettext()) < if(moneda = '2', 110, 5000000)" validationmsg="~"Valor muy alto~"" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=tasa dbname="pago_oferta.tasa" validation="double(gettext()) > 0" validationmsg="~"El valor del int. mensual debe ser mayor que cero~"" )
 column=(type=char(2) update=yes updatewhereclause=yes name=n_reduccion dbname="pago_oferta.n_reduccion" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=valor_cuota dbname="pago_oferta.valor_cuota" validation="double(gettext()) < if(moneda = '2', 500, 5000000) AND double(gettext()) >0" validationmsg="~"Valor de la cuota incorrecto~"" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=des_esp dbname="pago_oferta.des_esp" validation="double(gettext()) < 100" validationmsg="~"Valor expresado en U.F. es muy alto~"" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=nro_cuotas dbname="pago_oferta.nro_cuotas" validation="long(gettext()) < 121 and long(gettext()) > 0" validationmsg="~"Número de cuotas incorrecto, debe estar en Rango 1 a 120~"" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=uf_dia dbname="pago_oferta.uf_dia" )
 column=(type=char(1) update=yes updatewhereclause=yes name=moneda dbname="pago_oferta.moneda" values="Pesos	1/U.F.	2/" )
 column=(type=datetime update=yes updatewhereclause=yes name=fecha_prim dbname="pago_oferta.fecha_prim" )
 column=(type=datetime update=yes updatewhereclause=yes name=fecha_ult dbname="pago_oferta.fecha_ult" )
 column=(type=datetime update=yes updatewhereclause=yes name=fecha_entre dbname="pago_oferta.fecha_entre" )
 column=(type=datetime update=yes updatewhereclause=yes name=fecha_pie dbname="pago_oferta.fecha_pie" )
 column=(type=char(4) update=yes updatewhereclause=yes name=modificado dbname="pago_oferta.modificado" )
 column=(type=datetime update=yes updatewhereclause=yes name=fecha_mod dbname="pago_oferta.fecha_mod" )
 column=(type=char(2) update=yes updatewhereclause=yes name=area dbname="pago_oferta.area" values="A1	A1/A2	A2/A3	A3/A4	A4/" )
 column=(type=number update=yes updatewhereclause=yes name=parque dbname="pago_oferta.parque" )
 column=(type=char(8) update=yes updatewhereclause=yes name=sector dbname="pago_oferta.sector" )
 column=(type=char(8) update=yes updatewhereclause=yes name=sepultura dbname="pago_oferta.sepultura" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=derecho_lib dbname="pago_oferta.derecho_lib" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=gastos_adm dbname="pago_oferta.gastos_adm" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=factura dbname="pago_oferta.factura" )
 column=(type=datetime update=yes updatewhereclause=yes name=fecha_fact dbname="pago_oferta.fecha_fact" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=total_fact dbname="pago_oferta.total_fact" )
 column=(type=char(1) update=yes updatewhereclause=yes name=carta_bienv dbname="pago_oferta.carta_bienv" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=pie_pagado dbname="pago_oferta.pie_pagado" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=capacidad dbname="pago_oferta.capacidad" validation="long(gettext()) > 0 and long(gettext()) < 13" validationmsg="~"Capacidad debe estar en Rango 1 a 12~"" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"pago_oferta~" )  TABLE(NAME=~"oferta_v~" ) COLUMN(NAME=~"pago_oferta.serie~") COLUMN(NAME=~"pago_oferta.nro_oferta~") COLUMN(NAME=~"pago_oferta.fecha~") COLUMN(NAME=~"pago_oferta.folio~") COLUMN(NAME=~"pago_oferta.precio~") COLUMN(NAME=~"pago_oferta.pie~") COLUMN(NAME=~"pago_oferta.tasa~") COLUMN(NAME=~"pago_oferta.n_reduccion~") COLUMN(NAME=~"pago_oferta.valor_cuota~") COLUMN(NAME=~"pago_oferta.des_esp~") COLUMN(NAME=~"pago_oferta.nro_cuotas~") COLUMN(NAME=~"pago_oferta.uf_dia~") COLUMN(NAME=~"pago_oferta.moneda~") COLUMN(NAME=~"pago_oferta.fecha_prim~") COLUMN(NAME=~"pago_oferta.fecha_ult~") COLUMN(NAME=~"pago_oferta.fecha_entre~") COLUMN(NAME=~"pago_oferta.fecha_pie~") COLUMN(NAME=~"pago_oferta.modificado~") COLUMN(NAME=~"pago_oferta.fecha_mod~") COLUMN(NAME=~"pago_oferta.area~") COLUMN(NAME=~"pago_oferta.parque~") COLUMN(NAME=~"pago_oferta.sector~") COLUMN(NAME=~"pago_oferta.sepultura~") COLUMN(NAME=~"pago_oferta.derecho_lib~") COLUMN(NAME=~"pago_oferta.gastos_adm~") COLUMN(NAME=~"pago_oferta.factura~") COLUMN(NAME=~"pago_oferta.fecha_fact~") COLUMN(NAME=~"pago_oferta.total_fact~") COLUMN(NAME=~"pago_oferta.carta_bienv~") COLUMN(NAME=~"pago_oferta.pie_pagado~") COLUMN(NAME=~"pago_oferta.capacidad~")    JOIN (LEFT=~"pago_oferta.serie~"    OP =~"=~"RIGHT=~"oferta_v.serie~" )    JOIN (LEFT=~"oferta_v.nro_oferta~"    OP =~"=~"RIGHT=~"pago_oferta.nro_oferta~" )    JOIN (LEFT=~"oferta_v.ult_folio~"    OP =~"=~"RIGHT=~"pago_oferta.folio~" )WHERE(    EXP1 =~"( ( ~~~"PAGO_OFERTA~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":as_serie )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"PAGO_OFERTA~~~".~~~"NRO_OFERTA~~~"~"   OP =~"=~"    EXP2 =~":an_numero ) )~" ) ) ARG(NAME = ~"as_serie~" TYPE = string)  ARG(NAME = ~"an_numero~" TYPE = number) " update="PAGO_OFERTA" updatewhere=0 updatekeyinplace=no arguments=(("as_serie", string),("an_numero", number)) )
