 COLUMN(NAME=~"anexo_aumento.saldo_financiar~") COLUMN(NAME=~"anexo_aumento.area~") COLUMN(NAME=~"anexo_aumento.porce_jefe~") COLUMN(NAME=~"anexo_aumento.tipo_venta~") COLUMN(NAME=~"anexo_aumento.uso~") COLUMN(NAME=~"anexo_aumento.tipo_sepult~") COLUMN(NAME=~"pago_aumento.capacidad~") COLUMN(NAME=~"cadena.cod_parque~") COLUMN(NAME=~"anexo_aumento.estado_seguro~") COLUMN(NAME=~"anexo_aumento.ult_fecha_seg~") COLUMN(NAME=~"anexo_aumento.u_folio~") COLUMN(NAME=~"anexo_aumento.u_fecha~") COLUMN(NAME=~"anexo_aumento.cierre_venta~") COLUMN(NAME=~"anexo_aumento.cierre_venta_semanal~") COLUMN(NAME=~"pago_aumento.tasa_base~") COLUMN(NAME=~"pago_aumento.tasa_interes_cuota~") COLUMN(NAME=~"anexo_aumento.rut_aval~") COLUMN(NAME=~"anexo_aumento.canal_venta~") COMPUTE(NAME=~"'' as modifica~")    JOIN (LEFT=~"pago_aumento.serie_m~"    OP =~"=~"RIGHT=~"anexo_aumento.serie_m~" )    JOIN (LEFT=~"pago_aumento.nro_aumento~"    OP =~"=~"RIGHT=~"anexo_aumento.nro_aumento~" )    JOIN (LEFT=~"pago_aumento.folio~"    OP =~"=~"RIGHT=~"anexo_aumento.ult_folio~" )    JOIN (LEFT=~"anexo_aumento.serie_m~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"anexo_aumento.nro_aumento~"    OP =~"=~"RIGHT=~"cadena.numero~" )WHERE(    EXP1 =~"~~~"ANEXO_AUMENTO~~~".~~~"SERIE_M~~~"~"   OP =~"=~"    EXP2 =~":as_serie~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"ANEXO_AUMENTO~~~".~~~"NRO_AUMENTO~~~"~"   OP =~"=~"    EXP2 =~":an_nro_aumento~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'A'~" ) ) ARG(NAME = ~"as_serie~" TYPE = string)  ARG(NAME = ~"an_nro_aumento~" TYPE = number) " update="ANEXO_AUMENTO" updatewhere=0 updatekeyinplace=yes arguments=(("as_serie", string),("an_nro_aumento", number)) )
