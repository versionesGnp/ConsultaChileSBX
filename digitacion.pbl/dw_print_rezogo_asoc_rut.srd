 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cliente_rezago~" )  TABLE(NAME=~"ingreso~" ) COLUMN(NAME=~"cliente_rezago.rut~") COLUMN(NAME=~"cliente_rezago.dv~") COLUMN(NAME=~"ingreso.tipo_cob~") COLUMN(NAME=~"ingreso.folio~") COLUMN(NAME=~"ingreso.fecha_pago~") COLUMN(NAME=~"ingreso.tipo_mov~") COLUMN(NAME=~"ingreso.cuotas_pag~") COLUMN(NAME=~"cliente_rezago.base~") COLUMN(NAME=~"cliente_rezago.serie~") COLUMN(NAME=~"cliente_rezago.numero~") COLUMN(NAME=~"cliente_rezago.nombre~") COLUMN(NAME=~"cliente_rezago.ap_paterno~") COLUMN(NAME=~"cliente_rezago.ap_materno~") COLUMN(NAME=~"cliente_rezago.telefono_part~") COLUMN(NAME=~"ingreso.rezago~") COLUMN(NAME=~"ingreso.cod_caja~") COLUMN(NAME=~"ingreso.base~") COLUMN(NAME=~"ingreso.serie~") COLUMN(NAME=~"ingreso.contrato~") COLUMN(NAME=~"ingreso.monto~")    JOIN (LEFT=~"cliente_rezago.rut~"    OP =~"=~"RIGHT=~"ingreso.rut~"    OUTER2 =~"ingreso.rut~" )    JOIN (LEFT=~"cliente_rezago.cod_pago~"    OP =~"=~"RIGHT=~"ingreso.tipo_cob~"    OUTER2 =~"ingreso.tipo_cob~" )    JOIN (LEFT=~"cliente_rezago.folio~"    OP =~"=~"RIGHT=~"ingreso.folio~"    OUTER2 =~"ingreso.folio~" )WHERE(    EXP1 =~"~~~"CLIENTE_REZAGO~~~".~~~"RUT~~~"~"   OP =~"=~"    EXP2 =~":rut~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"REZAGO~~~"~"   OP =~"=~"    EXP2 =~"'S'~" ) ) ARG(NAME = ~"rut~" TYPE = number) " arguments=(("rut", number))  sort="ingreso_fecha_pago D " )
