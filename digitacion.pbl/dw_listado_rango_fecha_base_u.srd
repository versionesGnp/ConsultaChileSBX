 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cliente~" )  TABLE(NAME=~"oferta_v~" )  TABLE(NAME=~"pago_oferta~" )  TABLE(NAME=~"cadena~" ) COLUMN(NAME=~"oferta_v.serie~") COLUMN(NAME=~"oferta_v.nro_oferta~") COLUMN(NAME=~"oferta_v.ult_folio~") COLUMN(NAME=~"oferta_v.cod_jef~") COLUMN(NAME=~"oferta_v.cod_sup~") COLUMN(NAME=~"oferta_v.cod_age~") COLUMN(NAME=~"oferta_v.fecha~") COLUMN(NAME=~"oferta_v.tipo_sepult~") COLUMN(NAME=~"oferta_v.tipo_cons~") COLUMN(NAME=~"oferta_v.tipo_venta~") COLUMN(NAME=~"oferta_v.uso~") COLUMN(NAME=~"oferta_v.tot_pagado~") COLUMN(NAME=~"oferta_v.cta_pag_s~") COLUMN(NAME=~"oferta_v.cta_pag_m~") COLUMN(NAME=~"oferta_v.valor_cuota_m~") COLUMN(NAME=~"oferta_v.fecha_m~") COLUMN(NAME=~"oferta_v.tot_pagado_m~") COLUMN(NAME=~"oferta_v.titulo~") COLUMN(NAME=~"oferta_v.forma_pago~") COLUMN(NAME=~"oferta_v.fecha_cierre~") COLUMN(NAME=~"oferta_v.uf_cierre~") COLUMN(NAME=~"oferta_v.porce_venta~") COLUMN(NAME=~"oferta_v.porce_sup~") COLUMN(NAME=~"oferta_v.u_folio~") COLUMN(NAME=~"oferta_v.u_fecha~") COLUMN(NAME=~"oferta_v.estatus_comision~") COLUMN(NAME=~"oferta_v.estado_comi_sup~") COLUMN(NAME=~"oferta_v.cierre_venta~") COLUMN(NAME=~"oferta_v.anexo_repacta~") COLUMN(NAME=~"oferta_v.cta_repacta~") COLUMN(NAME=~"pago_oferta.precio~") COLUMN(NAME=~"pago_oferta.pie~") COLUMN(NAME=~"pago_oferta.tasa~") COLUMN(NAME=~"pago_oferta.capacidad~") COLUMN(NAME=~"pago_oferta.n_reduccion~") COLUMN(NAME=~"pago_oferta.valor_cuota~") COLUMN(NAME=~"pago_oferta.nro_cuotas~") COLUMN(NAME=~"pago_oferta.uf_dia~") COLUMN(NAME=~"pago_oferta.moneda~") COLUMN(NAME=~"pago_oferta.fecha_prim~") COLUMN(NAME=~"pago_oferta.area~") COLUMN(NAME=~"pago_oferta.parque~") COLUMN(NAME=~"pago_oferta.sector~") COLUMN(NAME=~"pago_oferta.sepultura~") COLUMN(NAME=~"pago_oferta.derecho_lib~") COLUMN(NAME=~"pago_oferta.gastos_adm~") COLUMN(NAME=~"pago_oferta.pie_pagado~") COLUMN(NAME=~"pago_oferta.nro_tecnico~") COLUMN(NAME=~"cliente.rut~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cliente.direccion_p~") COLUMN(NAME=~"cliente.fono_p~") COLUMN(NAME=~"cliente.fono_c~") COLUMN(NAME=~"cliente.estado_titular~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"cadena.estado_titulo~") COLUMN(NAME=~"cadena.fecha_titulo~") COLUMN(NAME=~"cadena.fecha_res~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"cadena.cod_parque~") COLUMN(NAME=~"pago_oferta.ctas_pactadas_pie~") COLUMN(NAME=~"pago_oferta.ctas_pagadas_pie~") COLUMN(NAME=~"pago_oferta.tasa_interes_cuota~") COLUMN(NAME=~"pago_oferta.base~")    JOIN (LEFT=~"cliente.rut~"    OP =~"=~"RIGHT=~"oferta_v.rut~" )    JOIN (LEFT=~"oferta_v.serie~"    OP =~"=~"RIGHT=~"pago_oferta.serie~" )    JOIN (LEFT=~"oferta_v.nro_oferta~"    OP =~"=~"RIGHT=~"pago_oferta.nro_oferta~" )    JOIN (LEFT=~"oferta_v.ult_folio~"    OP =~"=~"RIGHT=~"pago_oferta.folio~" )    JOIN (LEFT=~"pago_oferta.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"pago_oferta.nro_oferta~"    OP =~"=~"RIGHT=~"cadena.numero~" )WHERE(    EXP1 =~"~~~"OFERTA_V~~~".~~~"FECHA~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"OFERTA_V~~~".~~~"FECHA~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'U'~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = date)  ARG(NAME = ~"fecha_fin~" TYPE = date) " arguments=(("fecha_ini", date),("fecha_fin", date))  sort="oferta_v_nro_oferta A oferta_v_serie A " )
