 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"oferta_v~" )  TABLE(NAME=~"cliente~" )  TABLE(NAME=~"pago_oferta~" )  TABLE(NAME=~"cadena~" ) COLUMN(NAME=~"oferta_v.serie~") COLUMN(NAME=~"oferta_v.nro_oferta~") COLUMN(NAME=~"oferta_v.rut~") COLUMN(NAME=~"cliente.dv~") COMPUTE(NAME=~"(~~~"PAGO_OFERTA~~~".~~~"VALOR_CUOTA~~~"*~~~"PAGO_OFERTA~~~".~~~"NRO_CUOTAS~~~")+~~~"PAGO_OFERTA~~~".~~~"PIE~~~"~") COLUMN(NAME=~"pago_oferta.factura~") COLUMN(NAME=~"oferta_v.cod_age~") COLUMN(NAME=~"oferta_v.cod_sup~") COLUMN(NAME=~"oferta_v.cod_jef~") COLUMN(NAME=~"cadena.cod_parque~") COLUMN(NAME=~"cadena.codigo~")    JOIN (LEFT=~"oferta_v.rut~"    OP =~"=~"RIGHT=~"cliente.rut~" )    JOIN (LEFT=~"oferta_v.serie~"    OP =~"=~"RIGHT=~"pago_oferta.serie~" )    JOIN (LEFT=~"oferta_v.nro_oferta~"    OP =~"=~"RIGHT=~"pago_oferta.nro_oferta~" )    JOIN (LEFT=~"oferta_v.ult_folio~"    OP =~"=~"RIGHT=~"pago_oferta.folio~" )    JOIN (LEFT=~"oferta_v.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"oferta_v.nro_oferta~"    OP =~"=~"RIGHT=~"cadena.numero~" )WHERE(    EXP1 =~"~~~"OFERTA_V~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"OFERTA_V~~~".~~~"NRO_OFERTA~~~"~"   OP =~"=~"    EXP2 =~":numero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'O'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'U')~" ) ) ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number) " arguments=(("serie", string),("numero", number)) )
