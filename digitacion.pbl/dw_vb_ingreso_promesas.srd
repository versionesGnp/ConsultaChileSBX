table(column=(type=char(1) update=yes updatewhereclause=yes name=serie dbname="oferta_v.serie" dbalias=".serie" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=nro_oferta dbname="oferta_v.nro_oferta" dbalias=".nro_oferta" )
 column=(type=decimal(4) updatewhereclause=yes name=rut dbname="oferta_v.rut" dbalias=".rut" )
