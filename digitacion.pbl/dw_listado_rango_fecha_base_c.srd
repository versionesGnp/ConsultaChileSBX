 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cadena~" )  TABLE(NAME=~"contrato~" )  TABLE(NAME=~"cliente~" ) COLUMN(NAME=~"contrato.serie_c~") COLUMN(NAME=~"contrato.nro_contrato~") COLUMN(NAME=~"contrato.fecha~") COLUMN(NAME=~"contrato.serie~") COLUMN(NAME=~"contrato.nro_pagare~") COLUMN(NAME=~"contrato.kapital~") COLUMN(NAME=~"contrato.tasa~") COLUMN(NAME=~"contrato.valor_cuo~") COLUMN(NAME=~"contrato.fecha_prim~") COLUMN(NAME=~"contrato.fecha_ult~") COLUMN(NAME=~"contrato.plazo~") COLUMN(NAME=~"contrato.tot_pagado~") COLUMN(NAME=~"contrato.cta_pag_la~") COLUMN(NAME=~"contrato.cta_pag_isa~") COLUMN(NAME=~"contrato.abono_pag~") COLUMN(NAME=~"contrato.fechas_ingreso~") COLUMN(NAME=~"contrato.parque~") COLUMN(NAME=~"contrato.moneda~") COLUMN(NAME=~"contrato.ubs~") COLUMN(NAME=~"contrato.fec_restr~") COLUMN(NAME=~"contrato.sector~") COLUMN(NAME=~"contrato.sepultura~") COLUMN(NAME=~"contrato.zona~") COLUMN(NAME=~"contrato.capacidad~") COLUMN(NAME=~"contrato.pie~") COLUMN(NAME=~"contrato.pie_pagado~") COLUMN(NAME=~"contrato.cta_pag_m~") COLUMN(NAME=~"contrato.valor_cuota_m~") COLUMN(NAME=~"contrato.fecha_m~") COLUMN(NAME=~"contrato.anexo_lib~") COLUMN(NAME=~"contrato.u_folio~") COLUMN(NAME=~"contrato.u_fecha~") COLUMN(NAME=~"contrato.anexo_repacta~") COLUMN(NAME=~"contrato.cta_repacta~") COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"cliente.rut~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cliente.direccion_p~") COLUMN(NAME=~"cliente.fono_p~") COLUMN(NAME=~"cliente.fono_c~") COLUMN(NAME=~"cadena.cod_parque~")    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"contrato.serie_c~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"contrato.nro_contrato~" )    JOIN (LEFT=~"contrato.rut~"    OP =~"=~"RIGHT=~"cliente.rut~" )WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'C'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CONTRATO~~~".~~~"FECHA~~~"~"   OP =~">=~"    EXP2 =~":fec_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CONTRATO~~~".~~~"FECHA~~~"~"   OP =~"<=~"    EXP2 =~":fec_fin~" ) ) ARG(NAME = ~"fec_ini~" TYPE = date)  ARG(NAME = ~"fec_fin~" TYPE = date) " arguments=(("fec_ini", date),("fec_fin", date))  sort="contrato_nro_contrato A contrato_serie_c A " )
