 column=(type=decimal(4) updatewhereclause=yes name=ingreso_valor_uf dbname="ingreso.valor_uf" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ingreso~" )  TABLE(NAME=~"cliente_rezago~" ) COLUMN(NAME=~"ingreso.tipo_cob~") COLUMN(NAME=~"ingreso.folio~") COLUMN(NAME=~"ingreso.monto~") COLUMN(NAME=~"ingreso.fecha_pago~") COLUMN(NAME=~"ingreso.rezago~") COLUMN(NAME=~"ingreso.cod_caja~") COLUMN(NAME=~"ingreso.valor_uf~")    JOIN (LEFT=~"cliente_rezago.cod_pago~"    OP =~"=~"RIGHT=~"ingreso.tipo_cob~" )    JOIN (LEFT=~"cliente_rezago.folio~"    OP =~"=~"RIGHT=~"ingreso.folio~" )    JOIN (LEFT=~"ingreso.fecha_pago~"    OP =~"=~"RIGHT=~"cliente_rezago.fecha_pago~" )    JOIN (LEFT=~"ingreso.cod_caja~"    OP =~"=~"RIGHT=~"cliente_rezago.caja~" )WHERE(    EXP1 =~"~~~"CLIENTE_REZAGO~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CLIENTE_REZAGO~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CLIENTE_REZAGO~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"TIPO_MOV~~~"~"   OP =~"=~"    EXP2 =~"'A'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"TIPO_COB~~~"~"   OP =~"=~"    EXP2 =~":tipo_cob~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"FOLIO~~~"~"   OP =~"=~"    EXP2 =~":folio~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number)  ARG(NAME = ~"tipo_cob~" TYPE = string)  ARG(NAME = ~"folio~" TYPE = number) " arguments=(("base", string),("serie", string),("numero", number),("tipo_cob", string),("folio", number))  sort="fecha_pago A " )
