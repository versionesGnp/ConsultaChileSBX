 column=(type=datetime updatewhereclause=yes name=fecha_pago dbname="ingreso.fecha_pago" )
 column=(type=char(1) updatewhereclause=yes name=ingreso_rezago dbname="ingreso.rezago" values="Si	S/No	N/" )
