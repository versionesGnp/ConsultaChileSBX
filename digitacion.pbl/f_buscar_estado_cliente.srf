global type f_buscar_estado_cliente from function_object
end type

forward prototypes
global function string f_buscar_estado_cliente (long al_rut)
end prototypes

global function string f_buscar_estado_cliente (long al_rut);String	ls_texto,ls_nom,ls_ap_pat,ls_ap_mat,ls_estado_titular
if al_rut=0 or isnull(al_rut) then
	ls_texto			= ''
elseif al_rut>0 then
	SELECT	"CLIENTE"."NOMBRE",   
				"CLIENTE"."A_PATERNO",   
				"CLIENTE"."A_MATERNO",   
				"CLIENTE"."ESTADO_TITULAR"  
	INTO		:ls_nom,   
				:ls_ap_pat,   
				:ls_ap_mat,   
				:ls_estado_titular  
	FROM 		"CLIENTE"  
	WHERE 	"CLIENTE"."RUT" = :al_rut   
	USING		sqlca;
	if sqlca.sqlcode=0 then
		if not isnull(ls_estado_titular) then
			if ls_estado_titular='0' then //activo
				ls_texto	= 'Estado Titular: Activo'
			elseif ls_estado_titular='1' then //Fallecido
				ls_texto	= 'Estado Titular: Fallecido'
			end if
		else
			ls_texto	= ''
		end if
	else
		ls_texto		= ''
	end if
end if
return ls_texto
end function

