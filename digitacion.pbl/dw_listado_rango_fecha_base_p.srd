 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cadena~" )  TABLE(NAME=~"cliente~" )  TABLE(NAME=~"pagare~" ) COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"pagare.serie_p~") COLUMN(NAME=~"pagare.nro_pagare~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"pagare.fecha~") COLUMN(NAME=~"pagare.base~") COLUMN(NAME=~"pagare.serie~") COLUMN(NAME=~"pagare.nro_oferta~") COLUMN(NAME=~"pagare.kapital~") COLUMN(NAME=~"pagare.tasa~") COLUMN(NAME=~"pagare.valor_cuo~") COLUMN(NAME=~"pagare.fecha_prim~") COLUMN(NAME=~"pagare.fecha_ult~") COLUMN(NAME=~"pagare.plazo~") COLUMN(NAME=~"pagare.tot_pagado~") COLUMN(NAME=~"pagare.pie_pagado~") COLUMN(NAME=~"pagare.cta_pag_la~") COLUMN(NAME=~"pagare.cta_pag_isa~") COLUMN(NAME=~"pagare.fechas_ingreso~") COLUMN(NAME=~"pagare.moneda~") COLUMN(NAME=~"pagare.sector~") COLUMN(NAME=~"pagare.sepultura~") COLUMN(NAME=~"pagare.pie~") COLUMN(NAME=~"cliente.rut~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cliente.direccion_p~") COLUMN(NAME=~"cliente.fono_p~") COLUMN(NAME=~"cliente.fono_c~") COLUMN(NAME=~"cadena.cod_parque~")    JOIN (LEFT=~"cliente.rut~"    OP =~"=~"RIGHT=~"pagare.rut~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"pagare.serie_p~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"pagare.nro_pagare~" )WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'P'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"PAGARE~~~".~~~"FECHA~~~"~"   OP =~">=~"    EXP2 =~":fec_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"PAGARE~~~".~~~"FECHA~~~"~"   OP =~"<=~"    EXP2 =~":fec_fin~" ) ) ARG(NAME = ~"fec_ini~" TYPE = date)  ARG(NAME = ~"fec_fin~" TYPE = date) " arguments=(("fec_ini", date),("fec_fin", date))  sort="pagare_nro_pagare A pagare_serie_p A " )
