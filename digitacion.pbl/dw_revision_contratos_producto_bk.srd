 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"revision_contratos~" ) COLUMN(NAME=~"revision_contratos.cod_parque~") COLUMN(NAME=~"revision_contratos.base~") COLUMN(NAME=~"revision_contratos.serie~") COLUMN(NAME=~"revision_contratos.numero~") COLUMN(NAME=~"revision_contratos.rut~") COLUMN(NAME=~"revision_contratos.dv~") COLUMN(NAME=~"revision_contratos.edad~") COLUMN(NAME=~"revision_contratos.renta_liquida~") COLUMN(NAME=~"revision_contratos.uf_fecha_ctto~") COLUMN(NAME=~"revision_contratos.moneda~") COLUMN(NAME=~"revision_contratos.forma_pago~") COLUMN(NAME=~"revision_contratos.area~") COLUMN(NAME=~"revision_contratos.tipo_sepult~") COLUMN(NAME=~"revision_contratos.capacidad~") COLUMN(NAME=~"revision_contratos.uso~") COLUMN(NAME=~"revision_contratos.pie~") COLUMN(NAME=~"revision_contratos.plazo~") COLUMN(NAME=~"revision_contratos.fecha_prim~") COLUMN(NAME=~"revision_contratos.gasto_adm~") COLUMN(NAME=~"revision_contratos.precio~") COLUMN(NAME=~"revision_contratos.derecho_especial~") COLUMN(NAME=~"revision_contratos.valor_cuota_mant~") COLUMN(NAME=~"revision_contratos.saldo_financiar~") COLUMN(NAME=~"revision_contratos.valor_cuota~") COLUMN(NAME=~"revision_contratos.observacion~") COLUMN(NAME=~"revision_contratos.estado_revision~") COLUMN(NAME=~"revision_contratos.usuario_crea~") COLUMN(NAME=~"revision_contratos.fecha_crea~") COLUMN(NAME=~"revision_contratos.precio_contrato~") COLUMN(NAME=~"revision_contratos.factor_cuota~") COLUMN(NAME=~"revision_contratos.dias_vencimiento_prim~") COLUMN(NAME=~"revision_contratos.pie_minimo~") COLUMN(NAME=~"revision_contratos.fecha_factor_vigente~") COLUMN(NAME=~"revision_contratos.reduccion~") COLUMN(NAME=~"revision_contratos.base_asoc~") COLUMN(NAME=~"revision_contratos.serie_asoc~") COLUMN(NAME=~"revision_contratos.numero_asoc~") COLUMN(NAME=~"revision_contratos.comprobante_titular~") COLUMN(NAME=~"revision_contratos.origen_venta~") COMPUTE(NAME=~"0.0 as c_total_cuota~") COLUMN(NAME=~"revision_contratos.fecha_ctto~") COLUMN(NAME=~"revision_contratos.fecha_nac~") COLUMN(NAME=~"revision_contratos.codigo_servicio~") COLUMN(NAME=~"revision_contratos.tipo_beneficiarios~") COLUMN(NAME=~"revision_contratos.sw_activa_servicio~") COLUMN(NAME=~"revision_contratos.folio_fa~") COLUMN(NAME=~"revision_contratos.fecha_activacion~")WHERE(    EXP1 =~"~~~"REVISION_CONTRATOS~~~".~~~"RUT~~~"~"   OP =~"=~"    EXP2 =~":rut~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"REVISION_CONTRATOS~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"REVISION_CONTRATOS~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"REVISION_CONTRATOS~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~" ) ) ARG(NAME = ~"rut~" TYPE = number)  ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number)  ARG(NAME = ~"depto~" TYPE = string) " update="REVISION_CONTRATOS" updatewhere=0 updatekeyinplace=yes arguments=(("rut", number),("base", string),("serie", string),("numero", number),("depto", string)) )
