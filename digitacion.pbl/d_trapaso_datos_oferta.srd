 column=(type=decimal(4) updatewhereclause=yes name=pago_oferta_nro_cuotas dbname="pago_oferta.nro_cuotas" dbalias=".nro_cuotas" )
 column=(type=decimal(4) updatewhereclause=yes name=pago_oferta_valor_cuota dbname="pago_oferta.valor_cuota" dbalias=".valor_cuota" )
 column=(type=decimal(4) updatewhereclause=yes name=pago_oferta_pie dbname="pago_oferta.pie" dbalias=".pie" )
 column=(type=char(2) updatewhereclause=yes name=oferta_v_uso dbname="oferta_v.uso" dbalias=".uso" )
 column=(type=char(1) updatewhereclause=yes name=pago_oferta_moneda dbname="pago_oferta.moneda" dbalias=".moneda" )
 column=(type=char(1) updatewhereclause=yes name=cadena_codigo dbname="cadena.codigo" dbalias=".codigo" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"oferta_v~" )  TABLE(NAME=~"pago_oferta~" )  TABLE(NAME=~"cadena~" ) COLUMN(NAME=~"pago_oferta.precio~") COLUMN(NAME=~"pago_oferta.nro_cuotas~") COLUMN(NAME=~"pago_oferta.valor_cuota~") COLUMN(NAME=~"pago_oferta.pie~") COLUMN(NAME=~"oferta_v.uso~") COLUMN(NAME=~"pago_oferta.moneda~") COLUMN(NAME=~"cadena.codigo~")    JOIN (LEFT=~"oferta_v.serie~"    OP =~"=~"RIGHT=~"pago_oferta.serie~" )    JOIN (LEFT=~"oferta_v.nro_oferta~"    OP =~"=~"RIGHT=~"pago_oferta.nro_oferta~" )    JOIN (LEFT=~"oferta_v.ult_folio~"    OP =~"=~"RIGHT=~"pago_oferta.folio~" )    JOIN (LEFT=~"oferta_v.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"oferta_v.nro_oferta~"    OP =~"=~"RIGHT=~"cadena.numero~" )WHERE(    EXP1 =~"~~~"OFERTA_V~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":as_serie~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"OFERTA_V~~~".~~~"NRO_OFERTA~~~"~"   OP =~"=~"    EXP2 =~":an_numero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~":as_base~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"CADENA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'V'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'C')~" ) ) ARG(NAME = ~"as_serie~" TYPE = string)  ARG(NAME = ~"an_numero~" TYPE = number)  ARG(NAME = ~"as_base~" TYPE = string) " arguments=(("as_serie", string),("an_numero", number),("as_base", string)) )
