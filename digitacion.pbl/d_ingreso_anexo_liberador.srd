COLUMN(NAME=~"pago_liberador.fecha~") COLUMN(NAME=~"pago_liberador.folio~") COMPUTE(NAME=~"'',0,0~") COLUMN(NAME=~"anexo_liberador.saldo_financiar~") COLUMN(NAME=~"anexo_liberador.porce_jefe~") COLUMN(NAME=~"cadena.cod_parque~") COLUMN(NAME=~"anexo_liberador.estado_seguro~") COLUMN(NAME=~"anexo_liberador.ult_fecha_seg~") COLUMN(NAME=~"anexo_liberador.u_folio~") COLUMN(NAME=~"anexo_liberador.u_fecha~") COLUMN(NAME=~"anexo_liberador.cierre_venta~") COLUMN(NAME=~"anexo_liberador.cierre_venta_semanal~") COLUMN(NAME=~"pago_liberador.tasa_base~") COLUMN(NAME=~"pago_liberador.ctas_pagadas_pie~") COLUMN(NAME=~"pago_liberador.ctas_pactadas_pie~") COLUMN(NAME=~"pago_liberador.fecha_prim_pie~") COLUMN(NAME=~"pago_liberador.base~") COLUMN(NAME=~"pago_liberador.anno_liberar~") COLUMN(NAME=~"pago_liberador.tasa_interes_cuota~") COLUMN(NAME=~"anexo_liberador.canal_venta~") COMPUTE(NAME=~"'' as modifica~") COMPUTE(NAME=~"0 as valor_cuota_iva~") COMPUTE(NAME=~"0 as iva_pie~") COMPUTE(NAME=~"0.0 as cuota_seguros~") COMPUTE(NAME=~"0.0 as valor_iva~")    JOIN (LEFT=~"anexo_liberador.serie_m~"    OP =~"=~"RIGHT=~"pago_liberador.serie_m~" )    JOIN (LEFT=~"anexo_liberador.nro_liberador~"    OP =~"=~"RIGHT=~"pago_liberador.nro_liberador~" )    JOIN (LEFT=~"anexo_liberador.ult_folio~"    OP =~"=~"RIGHT=~"pago_liberador.folio~" )    JOIN (LEFT=~"anexo_liberador.serie_m~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"anexo_liberador.nro_liberador~"    OP =~"=~"RIGHT=~"cadena.numero~" )WHERE(    EXP1 =~"~~~"ANEXO_LIBERADOR~~~".~~~"SERIE_M~~~"~"   OP =~"=~"    EXP2 =~":as_serie~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"ANEXO_LIBERADOR~~~".~~~"NRO_LIBERADOR~~~"~"   OP =~"=~"    EXP2 =~":an_nro_liberador~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'L'~" ) ) ARG(NAME = ~"as_serie~" TYPE = string)  ARG(NAME = ~"an_nro_liberador~" TYPE = number) " update="ANEXO_LIBERADOR" updatewhere=0 updatekeyinplace=yes arguments=(("as_serie", string),(