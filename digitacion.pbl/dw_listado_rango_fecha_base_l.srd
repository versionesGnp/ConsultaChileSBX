 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"anexo_liberador~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"cliente~" )  TABLE(NAME=~"pago_liberador~" ) COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"anexo_liberador.serie_m~") COLUMN(NAME=~"anexo_liberador.nro_liberador~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"anexo_liberador.base~") COLUMN(NAME=~"anexo_liberador.serie~") COLUMN(NAME=~"anexo_liberador.nro_oferta~") COLUMN(NAME=~"anexo_liberador.tot_pagado~") COLUMN(NAME=~"anexo_liberador.cta_pag_m~") COLUMN(NAME=~"anexo_liberador.fecha_ingreso~") COLUMN(NAME=~"anexo_liberador.forma_pago~") COLUMN(NAME=~"anexo_liberador.fecha_cierre~") COLUMN(NAME=~"anexo_liberador.uf_cierre~") COLUMN(NAME=~"anexo_liberador.cod_agente~") COLUMN(NAME=~"anexo_liberador.cod_super~") COLUMN(NAME=~"anexo_liberador.estado_comi~") COLUMN(NAME=~"anexo_liberador.estado_premio~") COLUMN(NAME=~"anexo_liberador.total_com~") COLUMN(NAME=~"anexo_liberador.por_ingre~") COLUMN(NAME=~"anexo_liberador.porce_sup~") COLUMN(NAME=~"anexo_liberador.porce_age~") COLUMN(NAME=~"anexo_liberador.u_folio~") COLUMN(NAME=~"anexo_liberador.u_fecha~") COLUMN(NAME=~"anexo_liberador.cod_jef~") COLUMN(NAME=~"pago_liberador.precio~") COLUMN(NAME=~"pago_liberador.pie_pagado~") COLUMN(NAME=~"pago_liberador.pie~") COLUMN(NAME=~"pago_liberador.tasa~") COLUMN(NAME=~"pago_liberador.valor_cuota~") COLUMN(NAME=~"pago_liberador.nro_cuotas~") COLUMN(NAME=~"pago_liberador.uf_dia~") COLUMN(NAME=~"pago_liberador.moneda~") COLUMN(NAME=~"pago_liberador.fecha_prim~") COLUMN(NAME=~"pago_liberador.fecha_ult~") COLUMN(NAME=~"pago_liberador.fecha_pie~") COLUMN(NAME=~"pago_liberador.gastos_adm~") COLUMN(NAME=~"cliente.rut~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cliente.direccion_p~") COLUMN(NAME=~"cliente.fono_p~") COLUMN(NAME=~"cliente.fono_c~") COLUMN(NAME=~"cadena.cod_parque~") COLUMN(NAME=~"pago_liberador.ctas_pagadas_pie~") COLUMN(NAME=~"pago_liberador.ctas_pactadas_pie~") COLUMN(NAME=~"pago_liberador.tasa_interes_cuota~") COLUMN(NAME=~"pago_liberador.base~")    JOIN (LEFT=~"cadena.rut~"    OP =~"=~"RIGHT=~"cliente.rut~" )    JOIN (LEFT=~"anexo_liberador.serie_m~"    OP =~"=~"RIGHT=~"pago_liberador.serie_m~" )    JOIN (LEFT=~"anexo_liberador.nro_liberador~"    OP =~"=~"RIGHT=~"pago_liberador.nro_liberador~" )    JOIN (LEFT=~"anexo_liberador.ult_folio~"    OP =~"=~"RIGHT=~"pago_liberador.folio~" )    JOIN (LEFT=~"anexo_liberador.serie_m~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"anexo_liberador.nro_liberador~"    OP =~"=~"RIGHT=~"cadena.numero~" )WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'L'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"PAGO_LIBERADOR~~~".~~~"FECHA~~~"~"   OP =~">=~"    EXP2 =~":fec_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"PAGO_LIBERADOR~~~".~~~"FECHA~~~"~"   OP =~"<=~"    EXP2 =~":fec_fin~" ) ) ARG(NAME = ~"fec_ini~" TYPE = date)  ARG(NAME = ~"fec_fin~" TYPE = date) " arguments=(("fec_ini", date),("fec_fin", date))  sort="anexo_liberador_nro_liberador A anexo_liberador_serie_m A " )
