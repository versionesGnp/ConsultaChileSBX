 column=(type=char(7) updatewhereclause=yes name=cod_movi_sigla dbname="cod_movi.sigla" )
 column=(type=char(2) updatewhereclause=yes name=ingreso_cod_caja dbname="ingreso.cod_caja" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ingreso~" )  TABLE(NAME=~"cod_movi~" )  TABLE(NAME=~"cod_pago~" ) COLUMN(NAME=~"ingreso.folio~") COLUMN(NAME=~"ingreso.tipo_cob~") COLUMN(NAME=~"ingreso.fecha_pago~") COLUMN(NAME=~"ingreso.tipo_mov~") COLUMN(NAME=~"ingreso.cuotas_pag~") COLUMN(NAME=~"cod_pago.tipo_cob~") COLUMN(NAME=~"ingreso.monto~") COLUMN(NAME=~"ingreso.pago_hist~") COLUMN(NAME=~"ingreso.valor_uf~") COLUMN(NAME=~"cod_pago.descripcion~") COLUMN(NAME=~"cod_movi.sigla~") COLUMN(NAME=~"ingreso.cod_caja~")    JOIN (LEFT=~"ingreso.tipo_cob~"    OP =~"=~"RIGHT=~"cod_pago.tipo_cob~"    OUTER1 =~"ingreso.tipo_cob~" )    JOIN (LEFT=~"ingreso.tipo_mov~"    OP =~"=~"RIGHT=~"cod_movi.cod_ing~"    OUTER1 =~"ingreso.tipo_mov~" )WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":as_serie~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"CONTRATO~~~"~"   OP =~"=~"    EXP2 =~":an_numero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":as_base~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"INGRESO~~~".~~~"TIPO_MOV~~~"~"   OP =~"=~"    EXP2 =~"'E'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"TIPO_MOV~~~"~"   OP =~"=~"    EXP2 =~"'I')~" ) ) ORDER(NAME=~"ingreso.fecha_pago~" ASC=yes ) ARG(NAME = ~"as_serie~" TYPE = string)  ARG(NAME = ~"an_numero~" TYPE = number)  ARG(NAME = ~"as_base~" TYPE = string) " arguments=(("as_serie", string),("an_numero", number),("as_base", string)) )
