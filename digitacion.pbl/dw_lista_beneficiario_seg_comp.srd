 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"beneficiarios_seguro~" )  TABLE(NAME=~"oferta_v~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"pago_oferta~" )  TABLE(NAME=~"tipo_seguro_detalle~" ) COLUMN(NAME=~"beneficiarios_seguro.base~") COLUMN(NAME=~"beneficiarios_seguro.serie~") COLUMN(NAME=~"beneficiarios_seguro.numero~") COLUMN(NAME=~"beneficiarios_seguro.rut~") COLUMN(NAME=~"beneficiarios_seguro.dv~") COLUMN(NAME=~"beneficiarios_seguro.codigo_seguro~") COLUMN(NAME=~"beneficiarios_seguro.nombres~") COLUMN(NAME=~"beneficiarios_seguro.ap_paterno~") COLUMN(NAME=~"beneficiarios_seguro.ap_materno~") COLUMN(NAME=~"beneficiarios_seguro.codigo_seguro_detalle~") COLUMN(NAME=~"beneficiarios_seguro.fono_contacto~") COLUMN(NAME=~"beneficiarios_seguro.tipo_via~") COLUMN(NAME=~"beneficiarios_seguro.direccion_particular~") COLUMN(NAME=~"beneficiarios_seguro.numero_particular~") COLUMN(NAME=~"beneficiarios_seguro.depto_particular~") COLUMN(NAME=~"beneficiarios_seguro.block_particular~") COLUMN(NAME=~"beneficiarios_seguro.comuna_particular~") COLUMN(NAME=~"beneficiarios_seguro.ciudad_particular~") COLUMN(NAME=~"beneficiarios_seguro.villa_poblacion~") COLUMN(NAME=~"beneficiarios_seguro.fecha_nacimiento~") COLUMN(NAME=~"tipo_seguro_detalle.descripcion~") COLUMN(NAME=~"oferta_v.fecha~")    JOIN (LEFT=~"beneficiarios_seguro.serie~"    OP =~"=~"RIGHT=~"oferta_v.serie~" )    JOIN (LEFT=~"oferta_v.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"beneficiarios_seguro.numero~"    OP =~"=~"RIGHT=~"oferta_v.nro_oferta~" )    JOIN (LEFT=~"oferta_v.nro_oferta~"    OP =~"=~"RIGHT=~"cadena.numero~" )    JOIN (LEFT=~"oferta_v.serie~"    OP =~"=~"RIGHT=~"pago_oferta.serie~" )    JOIN (LEFT=~"oferta_v.nro_oferta~"    OP =~"=~"RIGHT=~"pago_oferta.nro_oferta~" )    JOIN (LEFT=~"oferta_v.ult_folio~"    OP =~"=~"RIGHT=~"pago_oferta.folio~" )    JOIN (LEFT=~"beneficiarios_seguro.codigo_seguro_detalle~"    OP =~"=~"RIGHT=~"tipo_seguro_detalle.codigo_tipo~" )    JOIN (LEFT=~"beneficiarios_seguro.codigo_seguro~"    OP =~"=~"RIGHT=~"tipo_seguro_detalle.codigo_seguro~" )WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'O'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"OFERTA_V~~~".~~~"FECHA~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"OFERTA_V~~~".~~~"FECHA~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = date)  ARG(NAME = ~"fecha_fin~" TYPE = date) " arguments=(("fecha_ini", date),("fecha_fin", date))  sort="beneficiarios_seguro_base A beneficiarios_seguro_numero A beneficiarios_seguro_serie A beneficiarios_seguro_codigo_seguro_detal A " )
