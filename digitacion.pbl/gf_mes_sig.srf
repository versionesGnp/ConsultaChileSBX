global type gf_mes_sig from function_object
end type

forward prototypes
global function date gf_mes_sig (string as_fecha, integer ai_meses)
end prototypes

global function date gf_mes_sig (string as_fecha, integer ai_meses);
long ll_anno, ll_mes, ll_dia
date ld_fecha, id_e, ad_fecha

//ll_dia = Integer(String(ad_fecha, "dd"))
//ll_mes  = Integer(String(ad_fecha,"mm"))
//ll_anno = Integer(String(ad_fecha,"yyyy"))

ad_fecha = Date(as_fecha)

ll_dia = day(ad_fecha)
ll_mes = month(ad_fecha) + ai_meses
ll_anno = year(ad_fecha) 

IF ll_mes > 12 then
	ll_mes = ll_mes - 12
	ll_anno ++
END IF

IF ll_dia > 29 and ll_mes = 2 then
	ll_dia = 28
END IF
ld_fecha = Date((String(ll_dia) + "/"+ String(ll_mes) + "/"+ String(ll_anno)))

id_e = Date("30/02/2000")

do while ld_fecha = id_e
	ll_dia = ll_dia - 1
	ld_fecha = Date((String(ll_dia) + "/"+ String(ll_mes) + "/"+ String(ll_anno)))
loop

ld_fecha = date(ll_anno, ll_mes, ll_dia)
RETURN ld_fecha
end function

