 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"beneficiarios_seguro~" ) COLUMN(NAME=~"beneficiarios_seguro.base~") COLUMN(NAME=~"beneficiarios_seguro.serie~") COLUMN(NAME=~"beneficiarios_seguro.numero~") COLUMN(NAME=~"beneficiarios_seguro.rut~") COLUMN(NAME=~"beneficiarios_seguro.codigo_seguro~") COLUMN(NAME=~"beneficiarios_seguro.nombres~") COLUMN(NAME=~"beneficiarios_seguro.ap_paterno~") COLUMN(NAME=~"beneficiarios_seguro.ap_materno~") COLUMN(NAME=~"beneficiarios_seguro.codigo_seguro_detalle~") COLUMN(NAME=~"beneficiarios_seguro.dv~") COLUMN(NAME=~"beneficiarios_seguro.fono_contacto~") COLUMN(NAME=~"beneficiarios_seguro.tipo_via~") COLUMN(NAME=~"beneficiarios_seguro.direccion_particular~") COLUMN(NAME=~"beneficiarios_seguro.numero_particular~") COLUMN(NAME=~"beneficiarios_seguro.depto_particular~") COLUMN(NAME=~"beneficiarios_seguro.block_particular~") COLUMN(NAME=~"beneficiarios_seguro.comuna_particular~") COLUMN(NAME=~"beneficiarios_seguro.ciudad_particular~") COLUMN(NAME=~"beneficiarios_seguro.villa_poblacion~") COLUMN(NAME=~"beneficiarios_seguro.fecha_nacimiento~") COLUMN(NAME=~"beneficiarios_seguro.sexo~") COLUMN(NAME=~"beneficiarios_seguro.porce_uf_designa~") COLUMN(NAME=~"beneficiarios_seguro.nro_uf_designa~") COMPUTE(NAME=~"0,0~") COLUMN(NAME=~"beneficiarios_seguro.codigo_parentesco~")WHERE(    EXP1 =~"~~~"BENEFICIARIOS_SEGURO~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"BENEFICIARIOS_SEGURO~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"BENEFICIARIOS_SEGURO~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"BENEFICIARIOS_SEGURO~~~".~~~"CODIGO_SEGURO~~~"~"   OP =~"=~"    EXP2 =~":seguro~" ) ) ARG(NAME = ~"numero~" TYPE = number)  ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"seguro~" TYPE = number) " update="BENEFICIARIOS_SEGURO" updatewhere=0 updatekeyinplace=yes arguments=(("numero", number),("base", string),("serie", string),("seguro", number)) )
