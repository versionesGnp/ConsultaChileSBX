text(band=detail alignment="0" text="Dependiendo del Tipo Sepultura, Area, Capacidad, Tipo Construcción, Uso, Codigo Parque y Moneda esta definido el Precio que Corresponde a una determinada Sepultura." border="0" color="0" x="178" y="10184" height="156" width="2597"  name=t_77  font.face="Arial" font.height="-10" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127" )
