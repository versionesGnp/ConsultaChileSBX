text(band=detail alignment="0" text="Los días Vencidos se Calcula en Base a la Fecha del Contrato y Fecha del Primer Vencimiento." border="0" color="0" x="178" y="5000" height="64" width="2597"  name=t_40  font.face="Arial" font.height="-10" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127" )
text(band=detail alignment="0" text="  15% de Pie Obligatorio" border="0" color="0" x="55" y="5128" height="60" width="2720"  name=t_31  font.face="Arial" font.height="-9" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" )
text(band=detail alignment="0" text="Para todos los Contratos Resueltos después del Año 2003, se exige como Mínimo 15% de Pie." border="0" color="0" x="178" y="5200" height="64" width="2597"  name=t_32  font.face="Arial" font.height="-10" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127" )
