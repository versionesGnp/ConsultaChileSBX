text(band=detail alignment="0" text="  Gastos Administrativos" border="0" color="0" x="55" y="10388" height="60" width="2720"  name=t_74  font.face="Arial" font.height="-9" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" )
text(band=detail alignment="0" text="Si la Forma de Pago es en Peso el Gasto Administrativo es $1.900, en caso de ser Unidad de Fomento es 0.1 U.F. y multiplicándose por el Plazo nos entrega el Total de Gastos." border="0" color="0" x="178" y="10460" height="152" width="2597"  name=t_75  font.face="Arial" font.height="-10" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127" )
