text(band=detail alignment="0" text="Si Tiene entre 65 y 69 años en el Calculo de la Edad." border="0" color="0" x="178" y="2112" height="64" width="2597"  name=t_18  font.face="Arial" font.height="-10" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127" )
text(band=detail alignment="0" text="  Cuota Mantención" border="0" color="0" x="55" y="2236" height="60" width="2720"  name=t_19  font.face="Arial" font.height="-9" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" )
text(band=detail alignment="0" text="  Derecho Especial" border="0" color="0" x="55" y="2576" height="60" width="2720"  name=t_21  font.face="Arial" font.height="-9" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" )
text(band=detail alignment="0" text="Dependiendo del Tipo Sepultura, Area, Capacidad, Tipo Construcción, Uso, Codigo Parque y Moneda esta definido en Lista de Precio el Valor Cuota Mantención que debe Cancelar el Cliente Anualmente." border="0" color="0" x="178" y="2308" height="208" width="2597"  name=t_20  font.face="Arial" font.height="-10" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127" )
text(band=detail alignment="0" text="Dependiendo del Tipo Sepultura, Area, Capacidad, Tipo Construcción, Uso, Codigo Parque y Modena esta definido en Lista de Precio el Valor Derecho Especial (Diferencia Precio NF - NI), en caso de Reprogramaciones o Uso es NI este Cobro se Anula." border="0" color="0" x="178" y="2648" height="208" width="2597"  name=t_22  font.face="Arial" font.height="-10" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127" )
text(band=detail alignment="0" text="  Precio de Lista" border="0" color="0" x="55" y="2908" height="60" width="2720"  name=t_23  font.face="Arial" font.height="-9" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" )
text(band=detail alignment="0" text="Dependiendo del Tipo Sepultura, Area, Capacidad, Tipo Construcción, Uso, Codigo Parque y Moneda esta definido el Precio que Corresponde a una determinada Sepultura." border="0" color="0" x="178" y="2980" height="156" width="2597"  name=t_24  font.face="Arial" font.height="-10" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127" )
text(band=detail alignment="0" text="  Gastos Administrativos" border="0" color="0" x="55" y="3184" height="60" width="2720"  name=t_25  font.face="Arial" font.height="-9" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" )
text(band=detail alignment="0" text="Si la Forma de Pago es en Peso el Gasto Administrativo es $1.900, en caso de ser Unidad de Fomento es 0.1 U.F. y multiplicándose por el Plazo nos entrega el Total de Gastos." border="0" color="0" x="178" y="3256" height="152" width="2597"  name=t_26  font.face="Arial" font.height="-10" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127" )
text(band=detail alignment="0" text="2.- Si tiene 70 años o más." border="0" color="0" x="178" y="1844" height="64" width="2597"  name=t_15  font.face="Arial" font.height="-10" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127" )
text(band=detail alignment="0" text="3.- Si al vencer el Credito el Cliente Tiene más de 75 años." border="0" color="0" x="178" y="1912" height="64" width="2597"  name=t_16  font.face="Arial" font.height="-10" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127" )
text(band=detail alignment="0" text="1.- No alcanza su Renta, es decir, el valor cuota supera el 10% de su Renta Líquida." border="0" color="0" x="178" y="1776" height="64" width="2597"  name=t_8  font.face="Arial" font.height="-10" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127" )
text(band=detail alignment="0" text="  Saldo a Financiar" border="0" color="0" x="55" y="4200" height="60" width="2720"  name=t_27  font.face="Arial" font.height="-9" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" )
text(band=detail alignment="0" text="Se Calcula ( ( PRECIO - PIE ) + GASTO_ADMINISTRATIVO )." border="0" color="0" x="178" y="4284" height="84" width="2597"  name=t_28  font.face="Arial" font.height="-10" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127" )
text(band=detail alignment="0" text="  Factor Aplicado" border="0" color="0" x="55" y="4432" height="60" width="2720"  name=t_37  font.face="Arial" font.height="-9" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" )
text(band=detail alignment="0" text="Dependiendo la Base del Contrato, por Rango de Cuotas además por Rango de Dias Vencidos y el Tipo de Moneda, Está Definido El Factor que es Aplicable al Valor Cuota." border="0" color="0" x="178" y="4504" height="164" width="2597"  name=t_38  font.face="Arial" font.height="-10" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127" )
text(band=detail alignment="0" text="  Valor Cuota" border="0" color="0" x="55" y="4728" height="60" width="2720"  name=t_29  font.face="Arial" font.height="-9" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" )
text(band=detail alignment="0" text="No debe Superar al 10% de la Renta Líquida Indicada." border="0" color="0" x="178" y="4800" height="64" width="2597"  name=t_30  font.face="Arial" font.height="-10" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127" )
