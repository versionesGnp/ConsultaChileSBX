text(band=detail alignment="0" text="  Asociado como Beneficiario" border="4" color="0" x="9" y="4" height="80" width="2821"  name=t_2  font.face="Arial" font.height="-12" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" )
text(band=detail alignment="0" text="Se verifica si existe como Beneficiario en Contrato IsaCruz o en Promesa. Identicando el Número y Estado del Contrato." border="0" color="0" x="55" y="104" height="152" width="2766"  name=t_3  font.face="Arial" font.height="-10" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127" )
text(band=detail alignment="0" text="  Contratos Asociados" border="4" color="0" x="9" y="320" height="80" width="2821"  name=t_9  font.face="Arial" font.height="-12" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" )
text(band=detail alignment="0" text="Se verifica si es Titular de uno o más Contrato(s), visualizando datos importantes como: Estado del Contrato, Nombre del Titular, Plazo, Cuotas pagadas, Mora Credito, Mora mantención, Mora Pie Pactado, etc." border="0" color="0" x="55" y="420" height="208" width="2766"  name=t_10  font.face="Arial" font.height="-10" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127" )
text(band=detail alignment="0" text="  Pagos en Rezago" border="4" color="0" x="9" y="692" height="80" width="2821"  name=t_11  font.face="Arial" font.height="-12" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" )
text(band=detail alignment="0" text="Se indica los Pagos en Rezago realizados por el Cliente, indicando: Nº de Comprobante, Fecha de Pago, Monto Cancelado en $ y UF, Tipo Movimiento (si es Pago Cuota, Mantención, Pie, etc.), Nº de Cuotas a Pagar, Fono Particular, Nº Caja y Nº del Contrato." border="0" color="0" x="55" y="792" height="220" width="2766"  name=t_12  font.face="Arial" font.height="-10" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127" )
text(band=detail alignment="0" text="Se Identifica cual es el Ultimo Estado en Control Documentario" border="0" color="0" x="55" y="1164" height="64" width="2766"  name=t_14  font.face="Arial" font.height="-10" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127" )
