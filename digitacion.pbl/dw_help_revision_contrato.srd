text(band=detail alignment="0" text="Si Tiene entre 65 y 69 años en el Calculo de la Edad." border="0" color="0" x="178" y="9696" height="64" width="2597"  name=t_69  font.face="Arial" font.height="-10" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127" )
text(band=detail alignment="0" text="2.- Si tiene 70 años o más." border="0" color="0" x="178" y="9428" height="64" width="2597"  name=t_70  font.face="Arial" font.height="-10" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127" )
text(band=detail alignment="0" text="3.- Si al vencer el Credito el Cliente Tiene más de 75 años." border="0" color="0" x="178" y="9496" height="64" width="2597"  name=t_71  font.face="Arial" font.height="-10" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127" )
text(band=detail alignment="0" text="1.- No alcanza su Renta, es decir, el valor cuota supera el 10% de su Renta Líquida." border="0" color="0" x="178" y="9360" height="64" width="2597"  name=t_72  font.face="Arial" font.height="-10" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127" )
