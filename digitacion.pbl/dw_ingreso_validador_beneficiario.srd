 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"validar_beneficiarios~" ) COLUMN(NAME=~"validar_beneficiarios.rut~") COLUMN(NAME=~"validar_beneficiarios.dv~") COLUMN(NAME=~"validar_beneficiarios.cod_parentesco~") COLUMN(NAME=~"validar_beneficiarios.fecha_nac~") COLUMN(NAME=~"validar_beneficiarios.nombre~") COLUMN(NAME=~"validar_beneficiarios.ap_paterno~") COLUMN(NAME=~"validar_beneficiarios.ap_materno~") COLUMN(NAME=~"validar_beneficiarios.tipo_seguro~") COLUMN(NAME=~"validar_beneficiarios.base~") COLUMN(NAME=~"validar_beneficiarios.serie~") COLUMN(NAME=~"validar_beneficiarios.numero~") COLUMN(NAME=~"validar_beneficiarios.orden~")WHERE(    EXP1 =~"~~~"VALIDAR_BENEFICIARIOS~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"VALIDAR_BENEFICIARIOS~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"VALIDAR_BENEFICIARIOS~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number) " update="VALIDAR_BENEFICIARIOS" updatewhere=0 updatekeyinplace=yes arguments=(("base", string),("serie", string),("numero", number))  sort="orden A " )
