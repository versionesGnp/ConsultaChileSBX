table(column=(type=decimal(4) updatewhereclause=yes name=folio dbname="ingreso.folio" )
 column=(type=char(2) updatewhereclause=yes name=tipo_cob dbname="ingreso.tipo_cob" )
 column=(type=datetime updatewhereclause=yes name=fecha_pago dbname="ingreso.fecha_pago" )
 column=(type=char(2) updatewhereclause=yes name=tipo_mov dbname="ingreso.tipo_mov" )
 column=(type=decimal(2) updatewhereclause=yes name=cuotas_pag dbname="ingreso.cuotas_pag" )
 column=(type=decimal(4) updatewhereclause=yes name=monto dbname="ingreso.monto" )
 column=(type=char(1) update=yes updatewhereclause=yes name=pago_hist dbname="ingreso.pago_hist" values="Vigente	A/Repactado	R/Vig.	 /" )
 column=(type=decimal(4) updatewhereclause=yes name=valor_uf dbname="ingreso.valor_uf" )
 column=(type=char(1) updatewhereclause=yes name=serie dbname="ingreso.serie" )
 column=(type=decimal(4) updatewhereclause=yes name=contrato dbname="ingreso.contrato" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ingreso~" ) COLUMN(NAME=~"ingreso.folio~") COLUMN(NAME=~"ingreso.tipo_cob~") COLUMN(NAME=~"ingreso.fecha_pago~") COLUMN(NAME=~"ingreso.tipo_mov~") COLUMN(NAME=~"ingreso.cuotas_pag~") COLUMN(NAME=~"ingreso.monto~") COLUMN(NAME=~"ingreso.pago_hist~") COLUMN(NAME=~"ingreso.valor_uf~") COLUMN(NAME=~"ingreso.serie~") COLUMN(NAME=~"ingreso.contrato~")WHERE(    EXP1 =~"( ~~~"INGRESO~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":as_serie )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"INGRESO~~~".~~~"CONTRATO~~~"~"   OP =~"=~"    EXP2 =~":an_numero )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"INGRESO~~~".~~~"FECHA_PAGO~~~"~"   OP =~"<=~"    EXP2 =~":ad_fecha_pago )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"INGRESO~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":as_base )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"INGRESO~~~".~~~"TIPO_COB~~~"~"   OP =~"=~"    EXP2 =~"'CI'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"TIPO_COB~~~"~"   OP =~"=~"    EXP2 =~"'CU'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"TIPO_COB~~~"~"   OP =~"=~"    EXP2 =~"'CC'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"TIPO_COB~~~"~"   OP =~"=~"    EXP2 =~"'C0')~" ) ) ORDER(NAME=~"ingreso.fecha_pago~" ASC=yes ) ARG(NAME = ~"as_serie~" TYPE = string)  ARG(NAME = ~"an_numero~" TYPE = number)  ARG(NAME = ~"ad_fecha_pago~" TYPE = date)  ARG(NAME = ~"as_base~" TYPE = string) " arguments=(("as_serie", string),("an_numero", number),("ad_fecha_pago", date),("as_base", string)) )
