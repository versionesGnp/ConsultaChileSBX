sion_contratos.liberador_annos~") COLUMN(NAME=~"revision_contratos.descto_liber~") COLUMN(NAME=~"revision_contratos.derecho_especial~") COLUMN(NAME=~"revision_contratos.nueva_capac~") COLUMN(NAME=~"revision_contratos.periodo_mant~") COMPUTE(NAME=~"0 as iva_pie~") COMPUTE(NAME=~"0 as iva_cuota~") COMPUTE(NAME=~"0 as iva_cuota_TS~") COLUMN(NAME=~"revision_contratos.tipo_producto~") COLUMN(NAME=~"revision_contratos.tipo_venta_subcat~")WHERE(    EXP1 =~"~~~"REVISION_CONTRATOS~~~".~~~"RUT~~~"~"   OP =~"=~"    EXP2 =~":rut~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"REVISION_CONTRATOS~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"REVISION_CONTRATOS~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"REVISION_CONTRATOS~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~" ) ) ARG(NAME = ~"rut~" TYPE = number)  ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number)  ARG(NAME = ~"depto~" TYPE = string) " update="REVISION_CONTRATOS" updatewhere=0 updatekeyinplace=yes arguments=(("rut", number),("base", string),("serie", string),("numero", number),("depto", string)) )
