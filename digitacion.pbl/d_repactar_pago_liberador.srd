 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"pago_liberador~" ) COLUMN(NAME=~"pago_liberador.serie_m~") COLUMN(NAME=~"pago_liberador.nro_liberador~") COLUMN(NAME=~"pago_liberador.fecha~") COLUMN(NAME=~"pago_liberador.folio~") COLUMN(NAME=~"pago_liberador.precio~") COLUMN(NAME=~"pago_liberador.pie~") COLUMN(NAME=~"pago_liberador.tasa~") COLUMN(NAME=~"pago_liberador.valor_cuota~") COLUMN(NAME=~"pago_liberador.nro_cuotas~") COLUMN(NAME=~"pago_liberador.uf_dia~") COLUMN(NAME=~"pago_liberador.moneda~") COLUMN(NAME=~"pago_liberador.fecha_prim~") COLUMN(NAME=~"pago_liberador.fecha_ult~") COLUMN(NAME=~"pago_liberador.fecha_pie~") COLUMN(NAME=~"pago_liberador.modificado~") COLUMN(NAME=~"pago_liberador.gastos_adm~") COLUMN(NAME=~"pago_liberador.pie_pagado~") COLUMN(NAME=~"pago_liberador.fecha_mod~")WHERE(    EXP1 =~"( ~~~"PAGO_LIBERADOR~~~".~~~"SERIE_M~~~"~"   OP =~"=~"    EXP2 =~":as_serie )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"PAGO_LIBERADOR~~~".~~~"NRO_LIBERADOR~~~"~"   OP =~"=~"    EXP2 =~":an_numero )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"PAGO_LIBERADOR~~~".~~~"FOLIO~~~"~"   OP =~"=~"    EXP2 =~":an_folio )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~":modificar~"   OP =~"=~"    EXP2 =~":modificar~" ) ) ARG(NAME = ~"as_serie~" TYPE = string)  ARG(NAME = ~"an_numero~" TYPE = number)  ARG(NAME = ~"an_folio~" TYPE = number)  ARG(NAME = ~"modificar~" TYPE = number) " update="PAGO_LIBERADOR" updatewhere=0 updatekeyinplace=no arguments=(("as_serie", string),("an_numero", number),("an_folio", number),("modificar", number)) )
