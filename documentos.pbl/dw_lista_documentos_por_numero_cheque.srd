 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"DOCUMENTOS~" ) COLUMN(NAME=~"DOCUMENTOS.folio~") COLUMN(NAME=~"DOCUMENTOS.n_cheque~") COLUMN(NAME=~"DOCUMENTOS.cod_banco~") COLUMN(NAME=~"DOCUMENTOS.monto~") COLUMN(NAME=~"DOCUMENTOS.fecha_venc~") COLUMN(NAME=~"DOCUMENTOS.cod_pago~") COLUMN(NAME=~"DOCUMENTOS.estado_ch~") COLUMN(NAME=~"DOCUMENTOS.tipo_cob~") COLUMN(NAME=~"DOCUMENTOS.rezago~")WHERE(    EXP1 =~"~~~"DOCUMENTOS~~~".~~~"N_CHEQUE~~~"~"   OP =~"=~"    EXP2 =~":numero~" ) ) ORDER(NAME=~"DOCUMENTOS.fecha_venc~" ASC=yes ) ARG(NAME = ~"numero~" TYPE = number) " update="DOCUMENTOS" updatewhere=0 updatekeyinplace=no arguments=(("numero", number)) )
