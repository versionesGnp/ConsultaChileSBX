 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"documentos~" )  TABLE(NAME=~"ingreso~" )  TABLE(NAME=~"estado_cheque~" )  TABLE(NAME=~"cliente_rezago~" )  TABLE(NAME=~"cd_folio~" ) COLUMN(NAME=~"documentos.folio~") COLUMN(NAME=~"documentos.tipo_cob~") COLUMN(NAME=~"documentos.n_cheque~") COLUMN(NAME=~"documentos.cod_banco~") COLUMN(NAME=~"documentos.monto~") COLUMN(NAME=~"documentos.fecha_venc~") COLUMN(NAME=~"documentos.num_cheques~") COLUMN(NAME=~"documentos.rezago~") COLUMN(NAME=~"documentos.fecha_pago~") COLUMN(NAME=~"documentos.cod_caja~") COLUMN(NAME=~"documentos.estado_ch~") COLUMN(NAME=~"ingreso.rut~") COLUMN(NAME=~"ingreso.base~") COLUMN(NAME=~"ingreso.serie~") COLUMN(NAME=~"ingreso.contrato~") COLUMN(NAME=~"estado_cheque.descripcion~") COLUMN(NAME=~"cd_folio.cod_parque~")    JOIN (LEFT=~"documentos.folio~"    OP =~"=~"RIGHT=~"ingreso.folio~" )    JOIN (LEFT=~"documentos.tipo_cob~"    OP =~"=~"RIGHT=~"ingreso.tipo_cob~" )    JOIN (LEFT=~"documentos.estado_ch~"    OP =~"=~"RIGHT=~"estado_cheque.estado_ch~" )    JOIN (LEFT=~"ingreso.tipo_cob~"    OP =~"=~"RIGHT=~"cliente_rezago.cod_pago~" )    JOIN (LEFT=~"ingreso.folio~"    OP =~"=~"RIGHT=~"cliente_rezago.folio~" )    JOIN (LEFT=~"cliente_rezago.base~"    OP =~"=~"RIGHT=~"cd_folio.base~" )    JOIN (LEFT=~"cliente_rezago.serie~"    OP =~"=~"RIGHT=~"cd_folio.serie~" )    JOIN (LEFT=~"cliente_rezago.numero~"    OP =~"=~"RIGHT=~"cd_folio.numero~" )WHERE(    EXP1 =~"~~~"DOCUMENTOS~~~".~~~"COD_PAGO~~~"~"   OP =~"=~"    EXP2 =~"'CH'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"CONTRATO~~~"~"   OP =~"=~"    EXP2 =~"0~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"DOCUMENTOS~~~".~~~"ESTADO_CH~~~"~"   OP =~"=~"    EXP2 =~":estado_ch~" ) ) ORDER(NAME=~"documentos.estado_ch~" ASC=yes ) ARG(NAME = ~"estado_ch~" TYPE = string) " arguments=(("estado_ch", string)) )
