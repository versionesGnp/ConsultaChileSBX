 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"doc_cob~" ) COLUMN(NAME=~"doc_cob.folio~") COLUMN(NAME=~"doc_cob.tipo_cob~") COLUMN(NAME=~"doc_cob.n_cheque~") COLUMN(NAME=~"doc_cob.cod_banco~") COLUMN(NAME=~"doc_cob.monto~") COLUMN(NAME=~"doc_cob.fecha_venc~") COLUMN(NAME=~"doc_cob.cod_pago~") COLUMN(NAME=~"doc_cob.num_cheques~") COLUMN(NAME=~"doc_cob.rezago~") COLUMN(NAME=~"doc_cob.fecha_pago~") COLUMN(NAME=~"doc_cob.cod_caja~") COLUMN(NAME=~"doc_cob.cod_tarjeta_credito~") COLUMN(NAME=~"doc_cob.nro_cuotas_credito~") COLUMN(NAME=~"doc_cob.cod_autorizacion_credito~") COLUMN(NAME=~"doc_cob.tipo_tarjeta_credito~") COLUMN(NAME=~"doc_cob.cod_tarjeta_debito~") COLUMN(NAME=~"doc_cob.cod_autorizacion_debito~") COLUMN(NAME=~"doc_cob.cod_banco_debito~") COLUMN(NAME=~"doc_cob.traspaso_pago~") COLUMN(NAME=~"doc_cob.tipo_pago_tarjeta_credito~") COLUMN(NAME=~"doc_cob.hora_pago~") COLUMN(NAME=~"doc_cob.minuto_pago~") COLUMN(NAME=~"doc_cob.tarjeta_empresa~") COLUMN(NAME=~"doc_cob.tipo_cob_aux~")WHERE(    EXP1 =~"~~~"DOC_COB~~~".~~~"TIPO_COB~~~"~"   OP =~"=~"    EXP2 =~":tipo_cob~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"DOC_COB~~~".~~~"FOLIO~~~"~"   OP =~"=~"    EXP2 =~":folio~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"DOC_COB~~~".~~~"FECHA_PAGO~~~"~"   OP =~"=~"    EXP2 =~":fecha_pago~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"DOC_COB~~~".~~~"COD_PAGO~~~"~"   OP =~"=~"    EXP2 =~"'CH'~" ) ) ARG(NAME = ~"tipo_cob~" TYPE = string)  ARG(NAME = ~"folio~" TYPE = number)  ARG(NAME = ~"fecha_pago~" TYPE = datetime) " update="DOC_COB" updatewhere=0 updatekeyinplace=yes arguments=(("tipo_cob", string),("folio", number),("fecha_pago", datetime))  sort="fecha_pago A fecha_venc A " )
