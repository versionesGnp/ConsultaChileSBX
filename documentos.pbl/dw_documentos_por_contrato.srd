release 5;
datawindow(units=0 timer_interval=60000 color=12632256 processing=0 print.documentname="" print.orientation = 0 print.margin.left = 787 print.margin.right = 110 print.margin.top = 97 print.margin.bottom = 97 print.paper.source = 0 print.paper.size = 0 print.prompt=no )
