 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"pagare~" )  TABLE(NAME=~"cliente~" )  TABLE(NAME=~"cod_parq~" )  TABLE(NAME=~"tasa~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"contrato~" )  TABLE(NAME=~"cadena_mora~" ) COLUMN(NAME=~"pagare.serie_p~") COLUMN(NAME=~"pagare.nro_pagare~") COLUMN(NAME=~"pagare.fecha~") COLUMN(NAME=~"pagare.serie~") COLUMN(NAME=~"pagare.nro_oferta~") COLUMN(NAME=~"pagare.kapital~") COLUMN(NAME=~"pagare.tasa~") COLUMN(NAME=~"pagare.valor_cuo~") COLUMN(NAME=~"pagare.fecha_prim~") COLUMN(NAME=~"pagare.fecha_ult~") COLUMN(NAME=~"pagare.plazo~") COLUMN(NAME=~"pagare.tot_pagado~") COLUMN(NAME=~"pagare.pie_pagado~") COLUMN(NAME=~"pagare.cta_pag_la~") COLUMN(NAME=~"pagare.cta_pag_isa~") COLUMN(NAME=~"pagare.abono_pag~") COLUMN(NAME=~"pagare.fechas_ingreso~") COLUMN(NAME=~"pagare.estado~") COLUMN(NAME=~"pagare.dueno~") COLUMN(NAME=~"pagare.origen~") COLUMN(NAME=~"pagare.moneda~") COLUMN(NAME=~"pagare.sector~") COLUMN(NAME=~"pagare.sepultura~") COLUMN(NAME=~"pagare.pie~") COLUMN(NAME=~"cod_parq.nombre~") COLUMN(NAME=~"cod_parq.ciudad~") COLUMN(NAME=~"cliente.rut~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cliente.direccion_p~") COLUMN(NAME=~"cliente.comuna~") COLUMN(NAME=~"cliente.ciudad~") COLUMN(NAME=~"cliente.fono_p~") COLUMN(NAME=~"tasa.tasa_m~") COLUMN(NAME=~"tasa.tasa_a~") COLUMN(NAME=~"tasa.tasa_int_p~") COLUMN(NAME=~"tasa.tasa_int_uf~") COLUMN(NAME=~"tasa.gasto_cob_mora~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"contrato.agente~") COLUMN(NAME=~"cadena_mora.mora_cred~") COLUMN(NAME=~"cadena_mora.dias_mora_cred~") COLUMN(NAME=~"cadena_mora.fecha_venc_cred~") COLUMN(NAME=~"cadena.cod_parque~")    JOIN (LEFT=~"pagare.rut~"    OP =~"=~"RIGHT=~"cliente.rut~"    OUTER1 =~"pagare.rut~" )    JOIN (LEFT=~"pagare.parque~"    OP =~"=~"RIGHT=~"cod_parq.codigo~"    OUTER1 =~"pagare.parque~" )    JOIN (LEFT=~"pagare.serie_p~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"pagare.nro_pagare~"    OP =~"=~"RIGHT=~"cadena.numero~" )    JOIN (LEFT=~"pagare.serie~"    OP =~"=~"RIGHT=~"contrato.serie_c~" )    JOIN (LEFT=~"pagare.nro_oferta~"    OP =~"=~"RIGHT=~"contrato.nro_contrato~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"cadena_mora.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"cadena_mora.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"cadena_mora.numero~" )WHERE(    EXP1 =~"~~~"PAGARE~~~".~~~"SERIE_P~~~"~"   OP =~"=~"    EXP2 =~":as_serie~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"PAGARE~~~".~~~"NRO_PAGARE~~~"~"   OP =~"=~"    EXP2 =~":an_numero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'P'~" ) ) ARG(NAME = ~"as_serie~" TYPE = string)  ARG(NAME = ~"an_numero~" TYPE = number) " arguments=(("as_serie", string),("an_numero", number)) )
