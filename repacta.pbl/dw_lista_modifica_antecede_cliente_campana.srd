 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"vista_modific_antece_cliente~" ) COLUMN(NAME=~"vista_modific_antece_cliente.rut~") COLUMN(NAME=~"vista_modific_antece_cliente.dv~") COLUMN(NAME=~"vista_modific_antece_cliente.nombres~") COLUMN(NAME=~"vista_modific_antece_cliente.ap_paterno~") COLUMN(NAME=~"vista_modific_antece_cliente.ap_materno~") COLUMN(NAME=~"vista_modific_antece_cliente.tipo_via_ori~") COLUMN(NAME=~"vista_modific_antece_cliente.tipo_via_nva~") COLUMN(NAME=~"vista_modific_antece_cliente.direc_p_ori~") COLUMN(NAME=~"vista_modific_antece_cliente.direc_p_nva~") COLUMN(NAME=~"vista_modific_antece_cliente.nro_part_ori~") COLUMN(NAME=~"vista_modific_antece_cliente.nro_part_nva~") COLUMN(NAME=~"vista_modific_antece_cliente.depto_part_ori~") COLUMN(NAME=~"vista_modific_antece_cliente.depto_part_nva~") COLUMN(NAME=~"vista_modific_antece_cliente.block_part_ori~") COLUMN(NAME=~"vista_modific_antece_cliente.block_part_nva~") COLUMN(NAME=~"vista_modific_antece_cliente.poblacion_ori~") COLUMN(NAME=~"vista_modific_antece_cliente.poblacion_nva~") COLUMN(NAME=~"vista_modific_antece_cliente.sector_ori~") COLUMN(NAME=~"vista_modific_antece_cliente.sector_nva~") COLUMN(NAME=~"vista_modific_antece_cliente.comuna_ori~") COLUMN(NAME=~"vista_modific_antece_cliente.comuna_nva~") COLUMN(NAME=~"vista_modific_antece_cliente.ciudad_ori~") COLUMN(NAME=~"vista_modific_antece_cliente.ciudad_nva~") COLUMN(NAME=~"vista_modific_antece_cliente.fono_p_ori~") COLUMN(NAME=~"vista_modific_antece_cliente.fono_p_nva~") COLUMN(NAME=~"vista_modific_antece_cliente.celular_ori~") COLUMN(NAME=~"vista_modific_antece_cliente.celular_nva~") COLUMN(NAME=~"vista_modific_antece_cliente.email_ori~") COLUMN(NAME=~"vista_modific_antece_cliente.email_nva~") COLUMN(NAME=~"vista_modific_antece_cliente.fecha_crea~") COLUMN(NAME=~"vista_modific_antece_cliente.cod_usuario~") COLUMN(NAME=~"vista_modific_antece_cliente.nomb_usuario~")WHERE(    EXP1 =~"~~~"VISTA_MODIFIC_ANTECE_CLIENTE~~~".~~~"FECHA_CREA~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"VISTA_MODIFIC_ANTECE_CLIENTE~~~".~~~"FECHA_CREA~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin +1~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = date)  ARG(NAME = ~"fecha_fin~" TYPE = date) " arguments=(("fecha_ini", date),("fecha_fin", date))  sort="fecha_crea A ap_paterno A ap_materno A nombres A " )
