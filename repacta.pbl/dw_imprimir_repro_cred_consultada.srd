"repacta_credito.total_pagado_original~") COLUMN(NAME=~"repacta_credito.estado_comi_age_original~") COLUMN(NAME=~"repacta_credito.estado_comi_sup_original~") COLUMN(NAME=~"repacta_credito.tipo_reprog~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"pago_oferta.pie~") COLUMN(NAME=~"pago_oferta.fecha_pie~") COLUMN(NAME=~"pago_oferta.tasa_base~") COLUMN(NAME=~"pago_oferta.pie_pagado~") COLUMN(NAME=~"pago_oferta.des_esp~") COLUMN(NAME=~"cadena.cod_parque~")    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"oferta_v.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"oferta_v.nro_oferta~" )    JOIN (LEFT=~"oferta_v.serie~"    OP =~"=~"RIGHT=~"pago_oferta.serie~" )    JOIN (LEFT=~"oferta_v.nro_oferta~"    OP =~"=~"RIGHT=~"pago_oferta.nro_oferta~" )    JOIN (LEFT=~"oferta_v.ult_folio~"    OP =~"=~"RIGHT=~"pago_oferta.folio~" )    JOIN (LEFT=~"repacta_credito.rut_ctto_original~"    OP =~"=~"RIGHT=~"cliente.rut~" )    JOIN (LEFT=~"repacta_credito.base_original~"    OP =~"=~"RIGHT=~"cadena.codigo~" )    JOIN (LEFT=~"repacta_credito.serie_original~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"repacta_credito.numero_original~"    OP =~"=~"RIGHT=~"cadena.numero~" )WHERE(    EXP1 =~"~~~"REPACTA_CREDITO~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"REPACTA_CREDITO~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"REPACTA_CREDITO~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"REPACTA_CREDITO~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~":estado~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"REPACTA_CREDITO~~~".~~~"FECHA_CREA~~~"~"   OP =~"=~"    EXP2 =~":fecha~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number)  ARG(NAME = ~"nombre_usuario~" TYPE = string)  ARG(NAME = ~"estado~" TYPE = string)  ARG(