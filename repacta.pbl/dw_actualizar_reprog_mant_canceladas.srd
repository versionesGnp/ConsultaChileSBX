 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"repacta_mantencion~" ) COLUMN(NAME=~"repacta_mantencion.base~") COLUMN(NAME=~"repacta_mantencion.serie~") COLUMN(NAME=~"repacta_mantencion.numero~") COLUMN(NAME=~"repacta_mantencion.correlativo~") COLUMN(NAME=~"repacta_mantencion.base_original~") COLUMN(NAME=~"repacta_mantencion.serie_original~") COLUMN(NAME=~"repacta_mantencion.numero_original~") COLUMN(NAME=~"repacta_mantencion.estado_pago~") COLUMN(NAME=~"repacta_mantencion.cuotas_pactadas~") COLUMN(NAME=~"repacta_mantencion.ctas_pagadas~") COLUMN(NAME=~"repacta_mantencion.rut_cliente~") COLUMN(NAME=~"repacta_mantencion.fecha_crea~") COLUMN(NAME=~"repacta_mantencion.cuotas_en_mora~") COLUMN(NAME=~"repacta_mantencion.valor_cuota~") COLUMN(NAME=~"repacta_mantencion.valor_cuota_uf~") COLUMN(NAME=~"repacta_mantencion.total_pagado~") COLUMN(NAME=~"repacta_mantencion.cta_mora_original~") COMPUTE(NAME=~"'',0~")WHERE(    EXP1 =~"~~~"REPACTA_MANTENCION~~~".~~~"CTAS_PAGADAS~~~"~"   OP =~">=~"    EXP2 =~"~~~"REPACTA_MANTENCION~~~".~~~"CUOTAS_PACTADAS~~~"~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"REPACTA_MANTENCION~~~".~~~"ESTADO_PAGO~~~"~"   OP =~"=~"    EXP2 =~"'V'~" ) ) "  sort="pagos_pendientes A numero_original A numero A " )
