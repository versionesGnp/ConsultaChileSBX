 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cadena~" )  TABLE(NAME=~"cadena_mora~" )  TABLE(NAME=~"cliente~" ) COLUMN(NAME=~"cadena.cod_parque~") COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"cadena.serie~") COLUMN(NAME=~"cadena.numero~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"cliente.rut~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cliente.estado_titular~") COLUMN(NAME=~"cadena_mora.mora_cred~") COLUMN(NAME=~"cadena_mora.dias_mora_cred~") COLUMN(NAME=~"cadena_mora.fecha_venc_cred~") COLUMN(NAME=~"cadena_mora.fallecidos~") COLUMN(NAME=~"cadena_mora.mora_mant~") COLUMN(NAME=~"cadena_mora.dias_mora_mant~") COLUMN(NAME=~"cadena_mora.fecha_venc_mant~") COLUMN(NAME=~"cadena_mora.mora_cred_pie~") COLUMN(NAME=~"cadena_mora.dias_mora_cred_pie~") COMPUTE(NAME=~"'','',0,0~")    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"cadena_mora.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"cadena_mora.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"cadena_mora.numero~" )    JOIN (LEFT=~"cadena.rut~"    OP =~"=~"RIGHT=~"cliente.rut~" )WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'V'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA_MORA~~~".~~~"CTAS_PAG_S~~~"~"   OP =~"=~"    EXP2 =~"0~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA_MORA~~~".~~~"TOTAL_PAGADO~~~"~"   OP =~"=~"    EXP2 =~"0~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA_MORA~~~".~~~"DIAS_MORA_CRED~~~"~"   OP =~">~"    EXP2 =~"60~" ) ) ARG(NAME = ~"base~" TYPE = string) " arguments=(("base", string))  sort="cadena_cod_parque A cadena_codigo A cadena_numero A cadena_mora_mora_cred D " )
