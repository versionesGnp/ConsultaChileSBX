table(column=(type=char(1) updatewhereclause=yes name=cadena_codigo dbname="cadena.codigo" )
 column=(type=char(1) updatewhereclause=yes name=cadena_serie dbname="cadena.serie" )
 column=(type=decimal(4) updatewhereclause=yes name=cadena_numero dbname="cadena.numero" )
 column=(type=char(1) updatewhereclause=yes name=cadena_estado dbname="cadena.estado" )
 column=(type=decimal(4) updatewhereclause=yes name=cadena_mora_mora_cred dbname="cadena_mora.mora_cred" )
 column=(type=number updatewhereclause=yes name=estado dbname="compute_0006" values="	0/	1" )
 column=(type=char(0) updatewhereclause=yes name=pagos_pendientes dbname="compute_0007" values="S - Tiene Cheques Pendientes o Saldo > 0	S/N - No Tiene	N/Y - Saldo Mayor 0	Y/F - No Facturado	F/" )
 column=(type=decimal(4) updatewhereclause=yes name=cadena_rut dbname="cadena.rut" )
 column=(type=datetime updatewhereclause=yes name=pagare_fecha dbname="pagare.fecha" )
 column=(type=decimal(4) updatewhereclause=yes name=pagare_tot_pagado dbname="pagare.tot_pagado" )
 column=(type=decimal(4) updatewhereclause=yes name=pagare_valor_cuo dbname="pagare.valor_cuo" )
 column=(type=decimal(4) updatewhereclause=yes name=pagare_plazo dbname="pagare.plazo" )
 column=(type=decimal(0) updatewhereclause=yes name=pagare_cta_pag_la dbname="pagare.cta_pag_la" )
 column=(type=decimal(0) updatewhereclause=yes name=pagare_cta_pag_isa dbname="pagare.cta_pag_isa" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cadena~" )  TABLE(NAME=~"cadena_mora~" )  TABLE(NAME=~"pagare~" ) COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"cadena.serie~") COLUMN(NAME=~"cadena.numero~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"cadena_mora.mora_cred~") COMPUTE(NAME=~"0,''~") COLUMN(NAME=~"cadena.rut~") COLUMN(NAME=~"pagare.fecha~") COLUMN(NAME=~"pagare.tot_pagado~") COLUMN(NAME=~"pagare.valor_cuo~") COLUMN(NAME=~"pagare.plazo~") COLUMN(NAME=~"pagare.cta_pag_la~") COLUMN(NAME=~"pagare.cta_pag_isa~")    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"cadena_mora.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"cadena_mora.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"cadena_mora.numero~" )    JOIN (LEFT=~"cadena_mora.serie~"    OP =~"=~"RIGHT=~"pagare.serie_p~" )    JOIN (LEFT=~"cadena_mora.numero~"    OP =~"=~"RIGHT=~"pagare.nro_pagare~" )WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'P'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"(~~~"PAGARE~~~".~~~"CTA_PAG_LA~~~" + ~~~"PAGARE~~~".~~~"CTA_PAG_ISA~~~")~"   OP =~">=~"    EXP2 =~"~~~"PAGARE~~~".~~~"PLAZO~~~"~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'V'~" ) ) "  sort="pagos_pendientes A cadena_numero A " )
