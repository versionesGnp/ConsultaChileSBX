 column=(type=decimal(4) updatewhereclause=yes name=cadena_rut dbname="cadena.rut" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cadena~" )  TABLE(NAME=~"cadena_mora~" )  TABLE(NAME=~"oferta_v~" )  TABLE(NAME=~"pago_oferta~" ) COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"cadena.serie~") COLUMN(NAME=~"cadena.numero~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"pago_oferta.nro_cuotas~") COLUMN(NAME=~"oferta_v.fecha~") COLUMN(NAME=~"cadena_mora.mora_cred~") COLUMN(NAME=~"pago_oferta.valor_cuota~") COLUMN(NAME=~"oferta_v.tot_pagado~") COMPUTE(NAME=~"0,''~") COLUMN(NAME=~"cadena.rut~")    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"cadena_mora.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"cadena_mora.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"cadena_mora.numero~" )    JOIN (LEFT=~"oferta_v.serie~"    OP =~"=~"RIGHT=~"pago_oferta.serie~" )    JOIN (LEFT=~"oferta_v.nro_oferta~"    OP =~"=~"RIGHT=~"pago_oferta.nro_oferta~" )    JOIN (LEFT=~"oferta_v.ult_folio~"    OP =~"=~"RIGHT=~"pago_oferta.folio~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"oferta_v.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"oferta_v.nro_oferta~" )WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'O'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"OFERTA_V~~~".~~~"CTA_PAG_S~~~"~"   OP =~">=~"    EXP2 =~"~~~"PAGO_OFERTA~~~".~~~"NRO_CUOTAS~~~"~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'V'~" ) ) "  sort="pagos_pendientes A cadena_numero A " )
