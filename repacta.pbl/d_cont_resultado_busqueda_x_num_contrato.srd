 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cadena~" )  TABLE(NAME=~"cliente~" ) COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"cadena.serie~") COLUMN(NAME=~"cadena.numero~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.rut~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"cadena.cod_parque~")    JOIN (LEFT=~"cadena.rut~"    OP =~"=~"RIGHT=~"cliente.rut~"    OUTER1 =~"cadena.rut~" )WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":an_num_contrato~" ) ) ORDER(NAME=~"cadena.codigo~" ASC=yes )  ORDER(NAME=~"cadena.serie~" ASC=yes )  ORDER(NAME=~"cadena.numero~" ASC=yes ) ARG(NAME = ~"an_num_contrato~" TYPE = number) " arguments=(("an_num_contrato", number))  sort="cadena_codigo A cadena_serie A cadena_numero A " )
