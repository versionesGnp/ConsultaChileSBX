 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cliente~" )  TABLE(NAME=~"cod_parq~" )  TABLE(NAME=~"pagare~" )  TABLE(NAME=~"interes_cuotas~" )  TABLE(NAME=~"tasa~" )  TABLE(NAME=~"cadena~" ) COLUMN(NAME=~"cod_parq.nombre~") COLUMN(NAME=~"cod_parq.ciudad~") COLUMN(NAME=~"cliente.rut~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cliente.direccion_p~") COLUMN(NAME=~"cliente.comuna~") COLUMN(NAME=~"cliente.ciudad~") COLUMN(NAME=~"cliente.fono_p~") COLUMN(NAME=~"pagare.serie_p~") COLUMN(NAME=~"pagare.nro_pagare~") COLUMN(NAME=~"pagare.fecha~") COLUMN(NAME=~"pagare.serie~") COLUMN(NAME=~"pagare.nro_oferta~") COLUMN(NAME=~"pagare.kapital~") COLUMN(NAME=~"pagare.tasa~") COLUMN(NAME=~"pagare.valor_cuo~") COLUMN(NAME=~"pagare.fecha_prim~") COLUMN(NAME=~"pagare.fecha_ult~") COLUMN(NAME=~"pagare.plazo~") COLUMN(NAME=~"pagare.tot_pagado~") COLUMN(NAME=~"pagare.pie_pagado~") COLUMN(NAME=~"pagare.cta_pag_la~") COLUMN(NAME=~"pagare.cta_pag_isa~") COLUMN(NAME=~"pagare.abono_pag~") COLUMN(NAME=~"pagare.estado~") COLUMN(NAME=~"pagare.dueno~") COLUMN(NAME=~"pagare.moneda~") COLUMN(NAME=~"pagare.sepultura~") COLUMN(NAME=~"pagare.pie~") COLUMN(NAME=~"interes_cuotas.interes_uf~") COLUMN(NAME=~"interes_cuotas.factor_pesos~") COLUMN(NAME=~"interes_cuotas.factor_uf~") COLUMN(NAME=~"tasa.tasa_int_p~") COLUMN(NAME=~"tasa.tasa_int_uf~") COMPUTE(NAME=~"0~") COMPUTE(NAME=~"0~") COMPUTE(NAME=~"0~") COMPUTE(NAME=~"0~") COMPUTE(NAME=~"0~") COMPUTE(NAME=~"0~") COMPUTE(NAME=~"0~") COMPUTE(NAME=~"0~") COMPUTE(NAME=~"0~") COMPUTE(NAME=~"0~") COLUMN(NAME=~"tasa.gasto_cob_mora~") COLUMN(NAME=~"cadena.estado~") COMPUTE(NAME=~"0~") COMPUTE(NAME=~"0~") COMPUTE(NAME=~"0~") COLUMN(NAME=~"cadena.cod_parque~")    JOIN (LEFT=~"pagare.rut~"    OP =~"=~"RIGHT=~"cliente.rut~"    OUTER1 =~"pagare.rut~" )    JOIN (LEFT=~"pagare.plazo~"    OP =~"=~"RIGHT=~"interes_cuotas.nro_cuotas~"    OUTER1 =~"pagare.plazo~" )    JOIN (LEFT=~"pagare.serie_p~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"pagare.nro_pagare~"    OP =~"=~"RIGHT=~"cadena.numero~" )WHERE(    EXP1 =~"((~~~"PAGARE~~~".~~~"SERIE_P~~~"~"   OP =~"=~"    EXP2 =~":as_serie )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"PAGARE~~~".~~~"NRO_PAGARE~~~"~"   OP =~"=~"    EXP2 =~":an_numero ) )~" ) ) ARG(NAME = ~"as_serie~" TYPE = string)  ARG(NAME = ~"an_numero~" TYPE = number) " arguments=(("as_serie", string),("an_numero", number)) )
