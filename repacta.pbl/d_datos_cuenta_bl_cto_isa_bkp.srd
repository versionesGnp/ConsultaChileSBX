 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"contrato~" )  TABLE(NAME=~"cliente~" )  TABLE(NAME=~"cod_parq~" )  TABLE(NAME=~"tasa~" ) COLUMN(NAME=~"contrato.serie_c~") COLUMN(NAME=~"contrato.nro_contrato~") COLUMN(NAME=~"contrato.fecha~") COLUMN(NAME=~"contrato.serie~") COLUMN(NAME=~"contrato.nro_pagare~") COLUMN(NAME=~"contrato.estado~") COLUMN(NAME=~"contrato.nro_resc~") COLUMN(NAME=~"cod_parq.nombre~") COLUMN(NAME=~"cod_parq.ciudad~") COLUMN(NAME=~"contrato.dueno~") COLUMN(NAME=~"contrato.origen~") COLUMN(NAME=~"contrato.ubs~") COLUMN(NAME=~"contrato.sector~") COLUMN(NAME=~"contrato.sepultura~") COLUMN(NAME=~"contrato.zona~") COLUMN(NAME=~"contrato.capacidad~") COLUMN(NAME=~"contrato.cta_pag_m~") COLUMN(NAME=~"contrato.valor_cuota_m~") COLUMN(NAME=~"contrato.fecha_m~") COLUMN(NAME=~"contrato.abono_m~") COLUMN(NAME=~"contrato.nro_tec~") COLUMN(NAME=~"cliente.rut~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cliente.direccion_p~") COLUMN(NAME=~"cliente.comuna~") COLUMN(NAME=~"cliente.ciudad~") COLUMN(NAME=~"cliente.fono_p~") COLUMN(NAME=~"tasa.tasa_m~") COLUMN(NAME=~"tasa.tasa_a~") COLUMN(NAME=~"tasa.tasa_int_p~") COLUMN(NAME=~"tasa.tasa_int_uf~") COLUMN(NAME=~"contrato.moneda~")    JOIN (LEFT=~"contrato.rut~"    OP =~"=~"RIGHT=~"cliente.rut~"    OUTER1 =~"contrato.rut~" )    JOIN (LEFT=~"contrato.parque~"    OP =~"=~"RIGHT=~"cod_parq.codigo~"    OUTER1 =~"contrato.parque~" )WHERE(    EXP1 =~"~~~"CONTRATO~~~".~~~"SERIE_C~~~"~"   OP =~"=~"    EXP2 =~":as_serie~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CONTRATO~~~".~~~"NRO_CONTRATO~~~"~"   OP =~"=~"    EXP2 =~":an_numero~" ) ) ARG(NAME = ~"as_serie~" TYPE = string)  ARG(NAME = ~"an_numero~" TYPE = number) " arguments=(("as_serie", string),("an_numero", number)) )
