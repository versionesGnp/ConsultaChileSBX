 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"repacta_credito~" )  TABLE(NAME=~"cliente~" )  TABLE(NAME=~"cadena~" ) COLUMN(NAME=~"repacta_credito.base~") COLUMN(NAME=~"repacta_credito.serie~") COLUMN(NAME=~"repacta_credito.numero~") COLUMN(NAME=~"repacta_credito.estado~") COLUMN(NAME=~"repacta_credito.fecha_crea~") COLUMN(NAME=~"repacta_credito.usuario~") COLUMN(NAME=~"repacta_credito.base_original~") COLUMN(NAME=~"repacta_credito.serie_original~") COLUMN(NAME=~"repacta_credito.numero_original~") COLUMN(NAME=~"repacta_credito.moneda_original~") COLUMN(NAME=~"repacta_credito.plazo_original~") COLUMN(NAME=~"repacta_credito.cuotas_pagadas_original~") COLUMN(NAME=~"repacta_credito.valor_cuota_original~") COLUMN(NAME=~"repacta_credito.precio_original~") COLUMN(NAME=~"repacta_credito.cod_age~") COLUMN(NAME=~"repacta_credito.cod_sup~") COLUMN(NAME=~"repacta_credito.cod_jefe~") COLUMN(NAME=~"repacta_credito.capital_pagado~") COLUMN(NAME=~"repacta_credito.valor_presente~") COLUMN(NAME=~"repacta_credito.valor_cuota_mora~") COLUMN(NAME=~"repacta_credito.valor_interes_mora_total~") COLUMN(NAME=~"repacta_credito.valor_interes_mora_gc~") COLUMN(NAME=~"repacta_credito.valor_interes_mora_im~") COLUMN(NAME=~"repacta_credito.cuotas_mora~") COLUMN(NAME=~"repacta_credito.dias_mora~") COLUMN(NAME=~"repacta_credito.saldo_precio~") COLUMN(NAME=~"repacta_credito.saldo_insoluto~") COLUMN(NAME=~"repacta_credito.nvo_plazo~") COLUMN(NAME=~"repacta_credito.nvo_pie~") COLUMN(NAME=~"repacta_credito.nvo_saldo~") COLUMN(NAME=~"repacta_credito.nvo_gasto_adm~") COLUMN(NAME=~"repacta_credito.nvo_saldo_insoluto~") COLUMN(NAME=~"repacta_credito.nvo_valor_cuota~") COLUMN(NAME=~"repacta_credito.uf_dia~") COLUMN(NAME=~"repacta_credito.interes_cuota~") COLUMN(NAME=~"repacta_credito.tasa_interes~") COLUMN(NAME=~"repacta_credito.rut_ctto_original~") COLUMN(NAME=~"repacta_credito.dv_ctto_original~") COLUMN(NAME=~"repacta_credito.moneda~") COLUMN(NAME=~"repacta_credito.total_pagado_original~") COLUMN(NAME=~"repacta_credito.estado_comi_age_original~") COLUMN(NAME=~"repacta_credito.estado_comi_sup_original~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cadena.cod_parque~") COLUMN(NAME=~"repacta_credito.tipo_reprog~")    JOIN (LEFT=~"repacta_credito.rut_ctto_original~"    OP =~"=~"RIGHT=~"cliente.rut~" )    JOIN (LEFT=~"repacta_credito.base_original~"    OP =~"=~"RIGHT=~"cadena.codigo~" )    JOIN (LEFT=~"repacta_credito.serie_original~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"repacta_credito.numero_original~"    OP =~"=~"RIGHT=~"cadena.numero~" )WHERE(    EXP1 =~"~~~"REPACTA_CREDITO~~~".~~~"BASE_ORIGINAL~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"REPACTA_CREDITO~~~".~~~"SERIE_ORIGINAL~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"REPACTA_CREDITO~~~".~~~"NUMERO_ORIGINAL~~~"~"   OP =~"=~"    EXP2 =~":numero~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number) " update="REPACTA_CREDITO" updatewhere=0 updatekeyinplace=yes arguments=(("base", string),("serie", string),("numero", number)) )
