table(column=(type=char(1) updatewhereclause=yes name=cadena_codigo dbname="cadena.codigo" )
 column=(type=char(1) updatewhereclause=yes name=cadena_serie dbname="cadena.serie" )
 column=(type=decimal(4) updatewhereclause=yes name=cadena_numero dbname="cadena.numero" )
 column=(type=char(1) updatewhereclause=yes name=cadena_estado dbname="cadena.estado" )
 column=(type=decimal(4) updatewhereclause=yes name=cadena_mora_mora_cred dbname="cadena_mora.mora_cred" )
 column=(type=number updatewhereclause=yes name=estado dbname="compute_0006" values="	0/	1" )
 column=(type=char(0) updatewhereclause=yes name=pagos_pendientes dbname="compute_0007" values="S - Tiene Cheques Pendientes	S/N - No tiene	N/Y - Saldo Mayor 0	Y/F - No Facturado	F/" )
 column=(type=decimal(4) updatewhereclause=yes name=cadena_rut dbname="cadena.rut" )
 column=(type=datetime updatewhereclause=yes name=pago_liberador_fecha dbname="pago_liberador.fecha" )
 column=(type=decimal(4) updatewhereclause=yes name=anexo_liberador_tot_pagado dbname="anexo_liberador.tot_pagado" )
 column=(type=decimal(4) updatewhereclause=yes name=pago_liberador_valor_cuota dbname="pago_liberador.valor_cuota" )
 column=(type=decimal(4) updatewhereclause=yes name=pago_liberador_nro_cuotas dbname="pago_liberador.nro_cuotas" )
 column=(type=decimal(4) updatewhereclause=yes name=anexo_liberador_cta_pag_m dbname="anexo_liberador.cta_pag_m" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cadena~" )  TABLE(NAME=~"cadena_mora~" )  TABLE(NAME=~"anexo_liberador~" )  TABLE(NAME=~"pago_liberador~" ) COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"cadena.serie~") COLUMN(NAME=~"cadena.numero~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"cadena_mora.mora_cred~") COMPUTE(NAME=~"0,''~") COLUMN(NAME=~"cadena.rut~") COLUMN(NAME=~"pago_liberador.fecha~") COLUMN(NAME=~"anexo_liberador.tot_pagado~") COLUMN(NAME=~"pago_liberador.valor_cuota~") COLUMN(NAME=~"pago_liberador.nro_cuotas~") COLUMN(NAME=~"anexo_liberador.cta_pag_m~")    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"cadena_mora.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"cadena_mora.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"cadena_mora.numero~" )    JOIN (LEFT=~"anexo_liberador.serie_m~"    OP =~"=~"RIGHT=~"pago_liberador.serie_m~" )    JOIN (LEFT=~"anexo_liberador.nro_liberador~"    OP =~"=~"RIGHT=~"pago_liberador.nro_liberador~" )    JOIN (LEFT=~"anexo_liberador.ult_folio~"    OP =~"=~"RIGHT=~"pago_liberador.folio~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"anexo_liberador.serie_m~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"anexo_liberador.nro_liberador~" )WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'L'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"PAGO_LIBERADOR~~~".~~~"NRO_CUOTAS~~~"~"   OP =~"<=~"    EXP2 =~"~~~"ANEXO_LIBERADOR~~~".~~~"CTA_PAG_M~~~"~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'V'~" ) ) "  sort="pagos_pendientes A cadena_numero A " )
