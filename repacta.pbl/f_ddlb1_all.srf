global type f_ddlb1_all from function_object
end type

forward prototypes
global function integer f_ddlb1_all (ref dropdownlistbox ddlb_param, string select_string)
end prototypes

global function integer f_ddlb1_all (ref dropdownlistbox ddlb_param, string select_string);datetime fecha
STRING ls_codigo,ls_nombre,ls_item, ls_item_buscado
STRING Blancos,Ceros,dato_1,dato_2
INT li_pos,ii_cod_esatdo //posición buscada

PREPARE sqlsa FROM :select_string;
DECLARE dyn_cursor DYNAMIC CURSOR FOR sqlsa;
OPEN DYNAMIC dyn_cursor;  
IF sqlca.sqlcode < 0 THEN
	MessageBox(gs_app_name,"DataBase Error!.~n~n"+sqlca.sqlerrtext+".~n~nf_ddlb_all()")
	Return -1
END IF
ddlb_param.SetRedraw(FALSE)
ddlb_param.Reset( )
Do While sqlca.sqlcode = 0
	Fetch dyn_cursor into :ii_cod_esatdo,:ls_item;
	If sqlca.sqlcode = 0 Then
		ls_nombre = string(ii_cod_esatdo)+' - '+ls_item
		ddlb_param.AddItem(ls_nombre)
	ElseIf sqlca.sqlcode < 0 Then
		MessageBox(gs_app_name,"DataBase Error!.~n~n"+sqlca.sqlerrtext+".~n~nf_ddlb_all()")
		Return -1
	Else
		Exit
	End If
Loop
ddlb_param.SetRedraw(TRUE)
Close dyn_cursor;
Return li_pos
end function

