 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"pagare_v~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"cliente~" ) COLUMN(NAME=~"pagare_v.serie~") COLUMN(NAME=~"pagare_v.numero~") COLUMN(NAME=~"pagare_v.serie_p~") COLUMN(NAME=~"pagare_v.numero_p~") COLUMN(NAME=~"pagare_v.estado~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"cliente.rut~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cadena.codigo~")    JOIN (LEFT=~"cadena.rut~"    OP =~"=~"RIGHT=~"cliente.rut~"    OUTER1 =~"cadena.rut~" )    JOIN (LEFT=~"pagare_v.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"pagare_v.numero~"    OP =~"=~"RIGHT=~"cadena.numero~" )WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'O'~" ) ) ORDER(NAME=~"pagare_v.numero~" ASC=yes ) " )
