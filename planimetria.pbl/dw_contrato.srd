 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"contrato~" )  TABLE(NAME=~"cadena~" ) COLUMN(NAME=~"contrato.parque~") COLUMN(NAME=~"contrato.zona~") COLUMN(NAME=~"contrato.sector~") COLUMN(NAME=~"contrato.sepultura~") COLUMN(NAME=~"contrato.nro_tec~") COLUMN(NAME=~"contrato.capacidad~") COLUMN(NAME=~"contrato.serie_c~") COLUMN(NAME=~"contrato.nro_contrato~") COLUMN(NAME=~"contrato.ubs~") COLUMN(NAME=~"cadena.codigo~")    JOIN (LEFT=~"contrato.serie_c~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"contrato.nro_contrato~"    OP =~"=~"RIGHT=~"cadena.numero~" )WHERE(    EXP1 =~"( ~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'C' )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"CONTRATO~~~".~~~"SECTOR~~~"~"   OP =~"=~"    EXP2 =~":SECTOR )~" ) ) ORDER(NAME=~"contrato.sepultura~" ASC=yes ) ARG(NAME = ~"SECTOR~" TYPE = string) " arguments=(("SECTOR", string)) )
