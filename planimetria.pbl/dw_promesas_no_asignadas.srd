 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"oferta_v~" )  TABLE(NAME=~"pago_oferta~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"tipo_construccion~" )  TABLE(NAME=~"tipo_sepultura~" )  TABLE(NAME=~"base_plani~" ) COLUMN(NAME=~"oferta_v.serie~") COLUMN(NAME=~"oferta_v.nro_oferta~") COLUMN(NAME=~"pago_oferta.area~") COLUMN(NAME=~"pago_oferta.sector~") COLUMN(NAME=~"pago_oferta.sepultura~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"oferta_v.tipo_cons~") COLUMN(NAME=~"oferta_v.tipo_sepult~") COLUMN(NAME=~"pago_oferta.capacidad~") COLUMN(NAME=~"tipo_construccion.descripcion~") COLUMN(NAME=~"tipo_sepultura.descripcion~")    JOIN (LEFT=~"pago_oferta.area~"    OP =~"=~"RIGHT=~"base_plani.area~" )    JOIN (LEFT=~"pago_oferta.parque~"    OP =~"=~"RIGHT=~"base_plani.cod_parque~" )    JOIN (LEFT=~"oferta_v.serie~"    OP =~"=~"RIGHT=~"pago_oferta.serie~" )    JOIN (LEFT=~"oferta_v.nro_oferta~"    OP =~"=~"RIGHT=~"pago_oferta.nro_oferta~" )    JOIN (LEFT=~"oferta_v.ult_folio~"    OP =~"=~"RIGHT=~"pago_oferta.folio~" )    JOIN (LEFT=~"pago_oferta.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"pago_oferta.nro_oferta~"    OP =~"=~"RIGHT=~"cadena.numero~" )    JOIN (LEFT=~"oferta_v.tipo_cons~"    OP =~"=~"RIGHT=~"tipo_construccion.tipo_const~" )    JOIN (LEFT=~"oferta_v.tipo_sepult~"    OP =~"=~"RIGHT=~"tipo_sepultura.tipo_sep~" )WHERE(    EXP1 =~"((~~~"PAGO_OFERTA~~~".~~~"SEPULTURA~~~"~"   OP =~"=~"    EXP2 =~"'0'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'O'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"CADENA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'C'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'V')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"BASE_PLANI~~~".~~~"CODIGO_PRODUCTO~~~"~"   OP =~"=~"    EXP2 =~":cod_producto)~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"(~~~"PAGO_OFERTA~~~".~~~"SEPULTURA~~~"~"   OP =~"=~"    EXP2 =~"'0'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'U'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"(~~~"CADENA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'C'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'V')~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"BASE_PLANI~~~".~~~"CODIGO_PRODUCTO~~~"~"   OP =~"=~"    EXP2 =~":cod_producto))~" ) ) ORDER(NAME=~"pago_oferta.area~" ASC=yes ) ARG(NAME = ~"parque~" TYPE = number)  ARG(NAME = ~"cod_producto~" TYPE = string) " arguments=(("parque", number),("cod_producto", string))  sort="pago_oferta_area A " )
