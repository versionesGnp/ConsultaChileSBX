 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"base_plani~" )  TABLE(NAME=~"inventario_plani~" )  TABLE(NAME=~"tipo_sepultura~" ) COLUMN(NAME=~"tipo_sepultura.descripcion~") COLUMN(NAME=~"base_plani.area~") COLUMN(NAME=~"tipo_sepultura.tipo_sep~") COLUMN(NAME=~"inventario_plani.capacidad~") COMPUTE(NAME=~"count(~~~"INVENTARIO_PLANI~~~".~~~"NUMERO~~~")~") COMPUTE(NAME=~"0~") COMPUTE(NAME=~"0~") COMPUTE(NAME=~"0~") COMPUTE(NAME=~"0~")    JOIN (LEFT=~"base_plani.tipo_sep~"    OP =~"=~"RIGHT=~"tipo_sepultura.tipo_sep~" )    JOIN (LEFT=~"inventario_plani.sector~"    OP =~"=~"RIGHT=~"base_plani.sector~" )    JOIN (LEFT=~"inventario_plani.cod_parque~"    OP =~"=~"RIGHT=~"base_plani.cod_parque~" )WHERE(    EXP1 =~"~~~"BASE_PLANI~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"BASE_PLANI~~~".~~~"CODIGO_PRODUCTO~~~"~"   OP =~"=~"    EXP2 =~":cod_producto~" )  GROUP(NAME=~"tipo_sepultura.tipo_sep~") GROUP(NAME=~"tipo_sepultura.descripcion~") GROUP(NAME=~"base_plani.area~") GROUP(NAME=~"inventario_plani.capacidad~")) ORDER(NAME=~"tipo_sepultura.tipo_sep~" ASC=yes )  ORDER(NAME=~"tipo_sepultura.descripcion~" ASC=yes )  ORDER(NAME=~"base_plani.area~" ASC=yes )  ORDER(NAME=~"inventario_plani.capacidad~" ASC=yes ) ARG(NAME = ~"parque~" TYPE = number)  ARG(NAME = ~"cod_producto~" TYPE = number) " arguments=(("parque", number),("cod_producto", number)) )
