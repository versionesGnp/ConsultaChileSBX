table(column=(type=decimal(4) update=yes updatewhereclause=yes name=correlativo dbname="log_reserva_sepultura.correlativo" dbalias=".correlativo" )
 column=(type=char(2) update=yes updatewhereclause=yes name=area dbname="log_reserva_sepultura.area" dbalias=".area" )
 column=(type=char(8) update=yes updatewhereclause=yes name=sector dbname="log_reserva_sepultura.sector" dbalias=".sector" )
 column=(type=char(8) update=yes updatewhereclause=yes name=sepultura dbname="log_reserva_sepultura.sepultura" dbalias=".sepultura" )
 column=(type=char(1) update=yes updatewhereclause=yes name=base dbname="log_reserva_sepultura.base" dbalias=".base" )
 column=(type=char(1) update=yes updatewhereclause=yes name=serie dbname="log_reserva_sepultura.serie" dbalias=".serie" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=numero dbname="log_reserva_sepultura.numero" dbalias=".numero" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=folio_reserva dbname="log_reserva_sepultura.folio_reserva" dbalias=".folio_reserva" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=rut dbname="log_reserva_sepultura.rut" dbalias=".rut" )
 column=(type=char(200) update=yes updatewhereclause=yes name=observacion dbname="log_reserva_sepultura.observacion" dbalias=".observacion" )
 column=(type=datetime update=yes updatewhereclause=yes name=fecha_reserva dbname="log_reserva_sepultura.fecha_reserva" dbalias=".fecha_reserva" )
 column=(type=char(5) update=yes updatewhereclause=yes name=cod_agente dbname="log_reserva_sepultura.cod_agente" dbalias=".cod_agente" )
 column=(type=datetime update=yes updatewhereclause=yes name=fecha_log dbname="log_reserva_sepultura.fecha_log" dbalias=".fecha_log" )
 column=(type=char(15) update=yes updatewhereclause=yes name=usuario_log dbname="log_reserva_sepultura.usuario_log" dbalias=".usuario_log" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=corre_reserva dbname="log_reserva_sepultura.corre_reserva" dbalias=".corre_reserva" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=cod_parque dbname="log_reserva_sepultura.cod_parque" dbalias=".cod_parque" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=estado dbname="log_reserva_sepultura.estado" dbalias=".estado" values="Activo	1/Inactivo	2/Inactivo	3/Inactivo	4/Inactivo	5/" )
 column=(type=char(20) updatewhereclause=yes name=cod_parq_nombre dbname="cod_parq.nombre" dbalias=".nombre" )
 column=(type=char(100) updatewhereclause=yes name=estado_reserva_descripcion dbname="estado_reserva.descripcion" dbalias="ESTADO_RESERVA_A.descripcion" )
 column=(type=char(100) updatewhereclause=yes name=estado_reserva_descripcion dbname="estado_reserva.descripcion" dbalias="ESTADO_RESERVA_B.descripcion" )
 column=(type=decimal(4) updatewhereclause=yes name=reserva_sepultura_estado dbname="reserva_sepultura.estado" dbalias=".estado" )
 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"log_reserva_sepultura~" )  TABLE(NAME=~"cod_parq~" )  TABLE(NAME=~"estado_reserva~" ALIAS=~"estado_reserva_a~" )  TABLE(NAME=~"reserva_sepultura~" )  TABLE(NAME=~"estado_reserva~" ALIAS=~"estado_reserva_b~" ) COLUMN(NAME=~"log_reserva_sepultura.correlativo~") COLUMN(NAME=~"log_reserva_sepultura.area~") COLUMN(NAME=~"log_reserva_sepultura.sector~") COLUMN(NAME=~"log_reserva_sepultura.sepultura~") COLUMN(NAME=~"log_reserva_sepultura.base~") COLUMN(NAME=~"log_reserva_sepultura.serie~") COLUMN(NAME=~"log_reserva_sepultura.numero~") COLUMN(NAME=~"log_reserva_sepultura.folio_reserva~") COLUMN(NAME=~"log_reserva_sepultura.rut~") COLUMN(NAME=~"log_reserva_sepultura.observacion~") COLUMN(NAME=~"log_reserva_sepultura.fecha_reserva~") COLUMN(NAME=~"log_reserva_sepultura.cod_agente~") COLUMN(NAME=~"log_reserva_sepultura.fecha_log~") COLUMN(NAME=~"log_reserva_sepultura.usuario_log~") COLUMN(NAME=~"log_reserva_sepultura.corre_reserva~") COLUMN(NAME=~"log_reserva_sepultura.cod_parque~") COLUMN(NAME=~"log_reserva_sepultura.estado~") COLUMN(NAME=~"cod_parq.nombre~") COLUMN(NAME=~"estado_reserva_a.descripcion~") COLUMN(NAME=~"estado_reserva_b.descripcion~") COLUMN(NAME=~"reserva_sepultura.estado~")    JOIN (LEFT=~"log_reserva_sepultura.sector~"    OP =~"=~"RIGHT=~"reserva_sepultura.sector~" )    JOIN (LEFT=~"log_reserva_sepultura.sepultura~"    OP =~"=~"RIGHT=~"reserva_sepultura.sepultura~" )    JOIN (LEFT=~"log_reserva_sepultura.folio_reserva~"    OP =~"=~"RIGHT=~"reserva_sepultura.folio_reserva~" )    JOIN (LEFT=~"log_reserva_sepultura.cod_parque~"    OP =~"=~"RIGHT=~"cod_parq.codigo~" )    JOIN (LEFT=~"log_reserva_sepultura.estado~"    OP =~"=~"RIGHT=~"estado_reserva_a.codigo~" )    JOIN (LEFT=~"reserva_sepultura.estado~"    OP =~"=~"RIGHT=~"estado_reserva_b.codigo~" )WHERE(    EXP1 =~"~~~"LOG_RESERVA_SEPULTURA~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"LOG_RESERVA_SEPULTURA~~~".~~~"SECTOR~~~"~"   OP =~"=~"    EXP2 =~":sector~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"LOG_RESERVA_SEPULTURA~~~".~~~"BASE~~~"~"   OP =~"<>~"    EXP2 =~"'U'~" ) ) ORDER(NAME=~"log_reserva_sepultura.sector~" ASC=yes )  ORDER(NAME=~"log_reserva_sepultura.sepultura~" ASC=yes )  ORDER(NAME=~"log_reserva_sepultura.fecha_log~" ASC=yes ) ARG(NAME = ~"parque~" TYPE = number)  ARG(NAME = ~"sector~" TYPE = string) " arguments=(("parque", number),("sector", string)) )
