 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"log_reserva_sepultura~" )  TABLE(NAME=~"base_plani~" ) COLUMN(NAME=~"log_reserva_sepultura.correlativo~") COLUMN(NAME=~"log_reserva_sepultura.area~") COLUMN(NAME=~"log_reserva_sepultura.sector~") COLUMN(NAME=~"log_reserva_sepultura.sepultura~") COLUMN(NAME=~"log_reserva_sepultura.base~") COLUMN(NAME=~"log_reserva_sepultura.serie~") COLUMN(NAME=~"log_reserva_sepultura.numero~") COLUMN(NAME=~"log_reserva_sepultura.folio_reserva~") COLUMN(NAME=~"log_reserva_sepultura.rut~") COLUMN(NAME=~"log_reserva_sepultura.observacion~") COLUMN(NAME=~"log_reserva_sepultura.fecha_reserva~") COLUMN(NAME=~"log_reserva_sepultura.estado~") COLUMN(NAME=~"log_reserva_sepultura.cod_agente~") COLUMN(NAME=~"log_reserva_sepultura.fecha_log~") COLUMN(NAME=~"log_reserva_sepultura.usuario_log~") COLUMN(NAME=~"log_reserva_sepultura.corre_reserva~")    JOIN (LEFT=~"log_reserva_sepultura.area~"    OP =~"=~"RIGHT=~"base_plani.area~" )    JOIN (LEFT=~"log_reserva_sepultura.cod_parque~"    OP =~"=~"RIGHT=~"base_plani.cod_parque~" )    JOIN (LEFT=~"log_reserva_sepultura.sector~"    OP =~"=~"RIGHT=~"base_plani.sector~" )WHERE(    EXP1 =~"~~~"LOG_RESERVA_SEPULTURA~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"BASE_PLANI~~~".~~~"CODIGO_PRODUCTO~~~"~"   OP =~"=~"    EXP2 =~":cod_producto~" ) ) ORDER(NAME=~"log_reserva_sepultura.area~" ASC=yes )  ORDER(NAME=~"log_reserva_sepultura.sector~" ASC=yes )  ORDER(NAME=~"log_reserva_sepultura.sepultura~" ASC=yes ) ARG(NAME = ~"parque~" TYPE = number)  ARG(NAME = ~"cod_producto~" TYPE = string) " arguments=(("parque", number),("cod_producto", string)) )
