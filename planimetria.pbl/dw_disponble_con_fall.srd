table(column=(type=char(10) updatewhereclause=yes name=inventario_plani_sector dbname="inventario_plani.sector" dbalias=".sector" )
 column=(type=char(10) updatewhereclause=yes name=inventario_plani_sepultura dbname="inventario_plani.sepultura" dbalias=".sepultura" )
 column=(type=decimal(4) updatewhereclause=yes name=inventario_plani_capacidad dbname="inventario_plani.capacidad" dbalias=".capacidad" )
 column=(type=char(45) updatewhereclause=yes name=fallecidos_nombres dbname="fallecidos.nombres" dbalias=".nombres" )
 column=(type=char(20) updatewhereclause=yes name=fallecidos_ap_paterno dbname="fallecidos.ap_paterno" dbalias=".ap_paterno" )
 column=(type=char(20) updatewhereclause=yes name=fallecidos_ap_materno dbname="fallecidos.ap_materno" dbalias=".ap_materno" )
 column=(type=decimal(4) updatewhereclause=yes name=fallecidos_rut dbname="fallecidos.rut" dbalias=".rut" )
 column=(type=char(1) updatewhereclause=yes name=fallecidos_dv dbname="fallecidos.dv" dbalias=".dv" )
 column=(type=char(1) updatewhereclause=yes name=fallecidos_base dbname="fallecidos.base" dbalias=".base" )
 column=(type=char(1) updatewhereclause=yes name=fallecidos_ss dbname="fallecidos.ss" dbalias=".ss" )
 column=(type=decimal(4) updatewhereclause=yes name=fallecidos_contrato dbname="fallecidos.contrato" dbalias=".contrato" )
 column=(type=char(100) updatewhereclause=yes name=inventario_plani_observaciones dbname="inventario_plani.observaciones" dbalias=".observaciones" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"inventario_plani~" )  TABLE(NAME=~"fallecidos~" )  TABLE(NAME=~"base_plani~" ) COLUMN(NAME=~"inventario_plani.sector~") COLUMN(NAME=~"inventario_plani.sepultura~") COLUMN(NAME=~"inventario_plani.capacidad~") COLUMN(NAME=~"fallecidos.nombres~") COLUMN(NAME=~"fallecidos.ap_paterno~") COLUMN(NAME=~"fallecidos.ap_materno~") COLUMN(NAME=~"fallecidos.rut~") COLUMN(NAME=~"fallecidos.dv~") COLUMN(NAME=~"fallecidos.base~") COLUMN(NAME=~"fallecidos.ss~") COLUMN(NAME=~"fallecidos.contrato~") COLUMN(NAME=~"inventario_plani.observaciones~")    JOIN (LEFT=~"inventario_plani.sector~"    OP =~"=~"RIGHT=~"fallecidos.sector~" )    JOIN (LEFT=~"inventario_plani.sepultura~"    OP =~"=~"RIGHT=~"fallecidos.n_sep~" )    JOIN (LEFT=~"inventario_plani.cod_parque~"    OP =~"=~"RIGHT=~"fallecidos.cod_parque~" )    JOIN (LEFT=~"fallecidos.sector~"    OP =~"=~"RIGHT=~"base_plani.sector~" )    JOIN (LEFT=~"fallecidos.cod_parque~"    OP =~"=~"RIGHT=~"base_plani.cod_parque~" )WHERE(    EXP1 =~"~~~"INVENTARIO_PLANI~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~"0~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INVENTARIO_PLANI~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"BASE_PLANI~~~".~~~"CODIGO_PRODUCTO~~~"~"   OP =~"=~"    EXP2 =~":cod_producto~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FALLECIDOS~~~".~~~"ESTADO_REG~~~"~"   OP =~"=~"    EXP2 =~"'A'~" ) ) ARG(NAME = ~"parque~" TYPE = number)  ARG(NAME = ~"cod_producto~" TYPE = string) " arguments=(("parque", number),("cod_producto", string)) )
