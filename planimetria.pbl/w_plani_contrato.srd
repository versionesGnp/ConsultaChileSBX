 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"cadena~" )  TABLE(NAME=~"oferta_v~" )  TABLE(NAME=~"pago_oferta~" ) COLUMN(NAME=~"pago_oferta.parque~") COLUMN(NAME=~"pago_oferta.area~") COLUMN(NAME=~"pago_oferta.sector~") COLUMN(NAME=~"pago_oferta.sepultura~") COLUMN(NAME=~"pago_oferta.nro_tecnico~") COLUMN(NAME=~"pago_oferta.capacidad~") COLUMN(NAME=~"oferta_v.tipo_sepult~") COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"cadena.serie~") COLUMN(NAME=~"cadena.numero~") COLUMN(NAME=~"oferta_v.tipo_cons~")    JOIN (LEFT=~"oferta_v.serie~"    OP =~"=~"RIGHT=~"pago_oferta.serie~" )    JOIN (LEFT=~"oferta_v.nro_oferta~"    OP =~"=~"RIGHT=~"pago_oferta.nro_oferta~" )    JOIN (LEFT=~"oferta_v.ult_folio~"    OP =~"=~"RIGHT=~"pago_oferta.folio~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"oferta_v.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"oferta_v.nro_oferta~" )WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'O'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"CADENA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'C'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'V')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"PAGO_OFERTA~~~".~~~"SECTOR~~~"~"   OP =~"=~"    EXP2 =~":sector~" ) ) ORDER(NAME=~"pago_oferta.parque~" ASC=yes )  ORDER(NAME=~"pago_oferta.area~" ASC=yes )  ORDER(NAME=~"pago_oferta.sector~" ASC=yes )  ORDER(NAME=~"cadena.serie~" ASC=yes )  ORDER(NAME=~"cadena.numero~" ASC=yes )  ORDER(NAME=~"pago_oferta.sepultura~" ASC=yes ) ARG(NAME = ~"sector~" TYPE = string) " arguments=(("sector", string)) )
