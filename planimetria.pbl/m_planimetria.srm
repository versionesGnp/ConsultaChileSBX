global type m_planimetria from menu
m_porzona m_porzona
end type
global m_planimetria m_planimetria

on m_planimetria.create
m_planimetria=this
call super::create
this.text = "m_planimetria"
this.m_porzona=create m_porzona
this.Item[UpperBound(this.Item)+1]=this.m_porzona
end on

on m_planimetria.destroy
call super::destroy
destroy(this.m_porzona)
end on

type m_porzona from menu within m_planimetria
m_planimetriaparque m_planimetriaparque
m_verparque m_verparque
m_stocktotalsepulturas m_stocktotalsepulturas
m_agregarsepultasector m_agregarsepultasector
m_actualización m_actualización
m_cambiodearea m_cambiodearea
m_estadistica m_estadistica
m_- m_-
m_salir m_salir
end type

on m_porzona.create
call super::create
this.visible = false
this.text = "Planimetria"
this.m_planimetriaparque=create m_planimetriaparque
this.m_verparque=create m_verparque
this.m_stocktotalsepulturas=create m_stocktotalsepulturas
this.m_agregarsepultasector=create m_agregarsepultasector
this.m_actualización=create m_actualización
this.m_cambiodearea=create m_cambiodearea
this.m_estadistica=create m_estadistica
this.m_-=create m_-
this.m_salir=create m_salir
this.Item[UpperBound(this.Item)+1]=this.m_planimetriaparque
this.Item[UpperBound(this.Item)+1]=this.m_verparque
this.Item[UpperBound(this.Item)+1]=this.m_stocktotalsepulturas
this.Item[UpperBound(this.Item)+1]=this.m_agregarsepultasector
this.Item[UpperBound(this.Item)+1]=this.m_actualización
this.Item[UpperBound(this.Item)+1]=this.m_cambiodearea
this.Item[UpperBound(this.Item)+1]=this.m_estadistica
this.Item[UpperBound(this.Item)+1]=this.m_-
this.Item[UpperBound(this.Item)+1]=this.m_salir
end on

on m_porzona.destroy
call super::destroy
destroy(this.m_planimetriaparque)
destroy(this.m_verparque)
destroy(this.m_stocktotalsepulturas)
destroy(this.m_agregarsepultasector)
destroy(this.m_actualización)
destroy(this.m_cambiodearea)
destroy(this.m_estadistica)
destroy(this.m_-)
destroy(this.m_salir)
end on

type m_planimetriaparque from menu within m_porzona
m_planimetriaparque1 m_planimetriaparque1
m_verparque1 m_verparque1
m_stocktotalsepultura m_stocktotalsepultura
m_resumenstocktotal m_resumenstocktotal
m_buscarporsector m_buscarporsector
m_promesasinasignar m_promesasinasignar
m_contratosisasinasignar m_contratosisasinasignar
m_fallecidossinasignar m_fallecidossinasignar
m_nulosconfallecidos m_nulosconfallecidos
m_contratosfallidos m_contratosfallidos
end type

on m_planimetriaparque.create
call super::create
this.text = "Por Zona"
this.m_planimetriaparque1=create m_planimetriaparque1
this.m_verparque1=create m_verparque1
this.m_stocktotalsepultura=create m_stocktotalsepultura
this.m_resumenstocktotal=create m_resumenstocktotal
this.m_buscarporsector=create m_buscarporsector
this.m_promesasinasignar=create m_promesasinasignar
this.m_contratosisasinasignar=create m_contratosisasinasignar
this.m_fallecidossinasignar=create m_fallecidossinasignar
this.m_nulosconfallecidos=create m_nulosconfallecidos
this.m_contratosfallidos=create m_contratosfallidos
this.Item[UpperBound(this.Item)+1]=this.m_planimetriaparque1
this.Item[UpperBound(this.Item)+1]=this.m_verparque1
this.Item[UpperBound(this.Item)+1]=this.m_stocktotalsepultura
this.Item[UpperBound(this.Item)+1]=this.m_resumenstocktotal
this.Item[UpperBound(this.Item)+1]=this.m_buscarporsector
this.Item[UpperBound(this.Item)+1]=this.m_promesasinasignar
this.Item[UpperBound(this.Item)+1]=this.m_contratosisasinasignar
this.Item[UpperBound(this.Item)+1]=this.m_fallecidossinasignar
this.Item[UpperBound(this.Item)+1]=this.m_nulosconfallecidos
this.Item[UpperBound(this.Item)+1]=this.m_contratosfallidos
end on

on m_planimetriaparque.destroy
call super::destroy
destroy(this.m_planimetriaparque1)
destroy(this.m_verparque1)
destroy(this.m_stocktotalsepultura)
destroy(this.m_resumenstocktotal)
destroy(this.m_buscarporsector)
destroy(this.m_promesasinasignar)
destroy(this.m_contratosisasinasignar)
destroy(this.m_fallecidossinasignar)
destroy(this.m_nulosconfallecidos)
destroy(this.m_contratosfallidos)
end on

