table(column=(type=char(1) updatewhereclause=yes name=tipo dbname="base_plani.tipo" dbalias=".tipo" )
 column=(type=decimal(4) updatewhereclause=yes name=capacidad dbname="inventario_plani.capacidad" dbalias=".capacidad" )
 column=(type=number updatewhereclause=yes name=compute_0003 dbname="compute_0003" )
 column=(type=char(2) updatewhereclause=yes name=area dbname="base_plani.area" dbalias=".area" )
 column=(type=number updatewhereclause=yes name=disponible dbname="compute_0005" )
 column=(type=number updatewhereclause=yes name=reservadas dbname="compute_0006" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"inventario_plani~" )  TABLE(NAME=~"base_plani~" ) COLUMN(NAME=~"base_plani.tipo~") COLUMN(NAME=~"inventario_plani.capacidad~") COMPUTE(NAME=~"count(1)~") COLUMN(NAME=~"base_plani.area~") COMPUTE(NAME=~"0~") COMPUTE(NAME=~"0~")    JOIN (LEFT=~"inventario_plani.sector~"    OP =~"=~"RIGHT=~"base_plani.sector~" )    JOIN (LEFT=~"inventario_plani.cod_parque~"    OP =~"=~"RIGHT=~"base_plani.cod_parque~" )WHERE(    EXP1 =~"~~~"INVENTARIO_PLANI~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"BASE_PLANI~~~".~~~"CODIGO_PRODUCTO~~~"~"   OP =~"=~"    EXP2 =~":cod_producto~" )  GROUP(NAME=~"base_plani.area~") GROUP(NAME=~"base_plani.tipo~") GROUP(NAME=~"inventario_plani.capacidad~")) ORDER(NAME=~"base_plani.area~" ASC=yes )  ORDER(NAME=~"base_plani.tipo~" ASC=yes )  ORDER(NAME=~"inventario_plani.capacidad~" ASC=yes ) ARG(NAME = ~"parque~" TYPE = number)  ARG(NAME = ~"cod_producto~" TYPE = string) " arguments=(("parque", number),("cod_producto", string)) )
