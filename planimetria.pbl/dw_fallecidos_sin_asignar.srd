 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"fallecidos~" ) COLUMN(NAME=~"fallecidos.llave~") COLUMN(NAME=~"fallecidos.folio~") COLUMN(NAME=~"fallecidos.base~") COLUMN(NAME=~"fallecidos.ss~") COLUMN(NAME=~"fallecidos.contrato~") COLUMN(NAME=~"fallecidos.sector~") COLUMN(NAME=~"fallecidos.n_sep~") COLUMN(NAME=~"fallecidos.nombres~") COLUMN(NAME=~"fallecidos.ap_paterno~") COLUMN(NAME=~"fallecidos.ap_materno~") COLUMN(NAME=~"fallecidos.fec_sep~") COLUMN(NAME=~"fallecidos.n_tec~") COLUMN(NAME=~"fallecidos.estado_contrato~")WHERE(    EXP1 =~"~~~"FALLECIDOS~~~".~~~"ESTADO_CONTRATO~~~"~"   OP =~"=~"    EXP2 =~"'E'~" ) ) ORDER(NAME=~"fallecidos.sector~" ASC=yes )  ORDER(NAME=~"fallecidos.n_sep~" ASC=yes ) " update="FALLECIDOS" updatewhere=1 updatekeyinplace=no )
