event clicked;long contrato,ll_obj, parque


parque 	= integer(w_plano_sector_parque.st_parque.text)
SELECT	count("PERFIL_USUARIO"."CORRELATIVO_OBJETO")  
INTO 		:ll_obj  
FROM 	"PERFIL_USUARIO"  
WHERE 	( "PERFIL_USUARIO"."USUARIO" = :gs_user ) AND  
		   	( "PERFIL_USUARIO"."CORRELATIVO_OBJETO" = '2154' )   
USING	sqlca;
if ll_obj > 0 then
	messagebox("Advertencia","Ud. no está Autorizado a Reservar")
else
	w_plano_sector_parque.dw_plano_sector_parque.enabled = false
	//open(w_solicitud_reserva)
	SELECT	"INVENTARIO_PLANI"."NUMERO" 
	INTO 		:contrato  
	FROM 	"INVENTARIO_PLANI"  
	WHERE ( "INVENTARIO_PLANI"."SECTOR" = :gs_sector ) AND  
			  ( "INVENTARIO_PLANI"."SEPULTURA"  = :gs_sepultura )  and ("INVENTARIO_PLANI"."COD_PARQUE" = :parque) ;
	if contrato >= 10000000 then
		OpenWithParm(w_sepul_const_m12,gs_sepultura)
	else
		OpenWithParm(w_solicitud_reserva,gs_sepultura)				
	end if
end if
end event

