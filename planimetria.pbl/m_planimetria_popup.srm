type m_sepulturasindividuales from menu within m_popup
end type

event clicked;long contrato
integer parque

parque 	= integer(w_plano_sector_parque.st_parque.text)

w_plano_sector_parque.dw_plano_sector_parque.enabled = false

SELECT 	"INVENTARIO_PLANI"."NUMERO" 
INTO 		:contrato  
FROM 	"INVENTARIO_PLANI"  
WHERE 	( "INVENTARIO_PLANI"."SECTOR"     = :gs_sector ) AND  
  	   		( "INVENTARIO_PLANI"."SEPULTURA"  = :gs_sepultura ) AND
			( "INVENTARIO_PLANI"."COD_PARQUE" = :parque );
if contrato >= 10000000 then
	OpenWithParm(w_sepul_const_m12,gs_sepultura)
else
	messagebox('No Corresponde', 'No es una Sepultura Individual.',stopsign!)
	w_plano_sector_parque.dw_plano_sector_parque.enabled = true
end if
end event

