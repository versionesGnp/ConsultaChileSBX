m_listarsector m_listarsector
m_distribuciónfallecidos m_distribuciónfallecidos
m_fallecidos m_fallecidos
end type

on m_popup.create
call super::create
this.text = "Popup"
this.menutextcolor = 134217735
this.menubackcolor = 134217732
this.menuhighlightcolor = 134217741
this.textsize = 8
this.weight = 400
this.facename = "Tahoma"
this.titlebackcolor = 134217730
this.bitmapbackcolor = 12632256
this.menubitmaps = true
this.titlegradient = true
this.toolbartextcolor = 134217746
this.toolbarbackcolor = 67108864
this.toolbarhighlightcolor = 134217741
this.toolbargradient = true
this.bitmapgradient = true
this.m_datoscliente=create m_datoscliente
this.m_datoscontrato=create m_datoscontrato
this.m_cuentacorriente=create m_cuentacorriente
this.m_-=create m_-
this.m_detallesepultura=create m_detallesepultura
this.m_sepulturasindividuales=create m_sepulturasindividuales
this.m_ingresodereserva=create m_ingresodereserva
this.m_0=create m_0
this.m_liberarsepulturadelapromnesa=create m_liberarsepulturadelapromnesa
this.m_historicoreservasporsepult=create m_historicoreservasporsepult
this.m_listarsector=create m_listarsector
this.m_distribuciónfallecidos=create m_distribuciónfallecidos
this.m_fallecidos=create m_fallecidos
this.Item[UpperBound(this.Item)+1]=this.m_datoscliente
this.Item[UpperBound(this.Item)+1]=this.m_datoscontrato
this.Item[UpperBound(this.Item)+1]=this.m_cuentacorriente
this.Item[UpperBound(this.Item)+1]=this.m_-
this.Item[UpperBound(this.Item)+1]=this.m_detallesepultura
this.Item[UpperBound(this.Item)+1]=this.m_sepulturasindividuales
this.Item[UpperBound(this.Item)+1]=this.m_ingresodereserva
this.Item[UpperBound(this.Item)+1]=this.m_0
this.Item[UpperBound(this.Item)+1]=this.m_liberarsepulturadelapromnesa
this.Item[UpperBound(this.Item)+1]=this.m_historicoreservasporsepult
this.Item[UpperBound(this.Item)+1]=this.m_listarsector
this.Item[UpperBound(this.Item)+1]=this.m_distribuciónfallecidos
this.Item[UpperBound(this.Item)+1]=this.m_fallecidos
end on

on m_popup.destroy
call super::destroy
destroy(this.m_datoscliente)
destroy(this.m_datoscontrato)
destroy(this.m_cuentacorriente)
destroy(this.m_-)
destroy(this.m_detallesepultura)
destroy(this.m_sepulturasindividuales)
destroy(this.m_ingresodereserva)
destroy(this.m_0)
destroy(this.m_liberarsepulturadelapromnesa)
destroy(this.m_historicoreservasporsepult)
destroy(this.m_listarsector)
destroy(this.m_distribuciónfallecidos)
destroy(this.m_fallecidos)
end on

