type m_datoscontrato from menu within m_popup
end type

event clicked;
CHOOSE CASE gs_base
	CASE "O","U"	 // Oferta/Columbario
		w_plano_sector_parque.dw_plano_sector_parque.enabled = false
		Open(w_datos_contrato_oferta)
	CASE "C" // Contrato ISA
		w_plano_sector_parque.dw_plano_sector_parque.enabled = false
		Open(w_datos_contrato_isa)
END CHOOSE

end event

