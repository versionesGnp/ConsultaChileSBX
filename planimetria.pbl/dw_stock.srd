table(column=(type=char(10) updatewhereclause=yes name=sector dbname="inventario_plani.sector" dbalias=".sector" )
 column=(type=decimal(4) updatewhereclause=yes name=capacidad dbname="inventario_plani.capacidad" dbalias=".capacidad" )
 column=(type=decimal(4) updatewhereclause=yes name=numero dbname="inventario_plani.numero" dbalias=".numero" )
 column=(type=char(10) updatewhereclause=yes name=inventario_plani_sepultura dbname="inventario_plani.sepultura" dbalias=".sepultura" )
 column=(type=decimal(4) updatewhereclause=yes name=reserva_sepultura_estado dbname="reserva_sepultura.estado" dbalias=".estado" )
 column=(type=decimal(4) updatewhereclause=yes name=inventario_plani_cod_parque dbname="inventario_plani.cod_parque" dbalias=".cod_parque" )
 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"inventario_plani~" )  TABLE(NAME=~"reserva_sepultura~" ) COLUMN(NAME=~"inventario_plani.sector~") COLUMN(NAME=~"inventario_plani.capacidad~") COLUMN(NAME=~"inventario_plani.numero~") COLUMN(NAME=~"inventario_plani.sepultura~") COLUMN(NAME=~"reserva_sepultura.estado~") COLUMN(NAME=~"inventario_plani.cod_parque~")    JOIN (LEFT=~"inventario_plani.sector~"    OP =~"=~"RIGHT=~"reserva_sepultura.sector~" )    JOIN (LEFT=~"inventario_plani.sepultura~"    OP =~"=~"RIGHT=~"reserva_sepultura.sepultura~" )WHERE(    EXP1 =~"~~~"INVENTARIO_PLANI~~~".~~~"SECTOR~~~"~"   OP =~"=~"    EXP2 =~":sector~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INVENTARIO_PLANI~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INVENTARIO_PLANI~~~".~~~"CAPACIDAD~~~"~"   OP =~"=~"    EXP2 =~":capa~" ) ) ORDER(NAME=~"inventario_plani.sector~" ASC=yes )  ORDER(NAME=~"inventario_plani.sepultura~" ASC=yes ) ARG(NAME = ~"sector~" TYPE = string)  ARG(NAME = ~"parque~" TYPE = number)  ARG(NAME = ~"capa~" TYPE = number) " arguments=(("sector", string),("parque", number),("capa", number)) )
