 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"log_reserva_sepultura~" ) COLUMN(NAME=~"log_reserva_sepultura.correlativo~") COLUMN(NAME=~"log_reserva_sepultura.area~") COLUMN(NAME=~"log_reserva_sepultura.sector~") COLUMN(NAME=~"log_reserva_sepultura.sepultura~") COLUMN(NAME=~"log_reserva_sepultura.base~") COLUMN(NAME=~"log_reserva_sepultura.serie~") COLUMN(NAME=~"log_reserva_sepultura.numero~") COLUMN(NAME=~"log_reserva_sepultura.folio_reserva~") COLUMN(NAME=~"log_reserva_sepultura.rut~") COLUMN(NAME=~"log_reserva_sepultura.observacion~") COLUMN(NAME=~"log_reserva_sepultura.fecha_reserva~") COLUMN(NAME=~"log_reserva_sepultura.estado~") COLUMN(NAME=~"log_reserva_sepultura.cod_agente~") COLUMN(NAME=~"log_reserva_sepultura.fecha_log~") COLUMN(NAME=~"log_reserva_sepultura.usuario_log~") COLUMN(NAME=~"log_reserva_sepultura.corre_reserva~")WHERE(    EXP1 =~"~~~"LOG_RESERVA_SEPULTURA~~~".~~~"SECTOR~~~"~"   OP =~"=~"    EXP2 =~":sector~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"LOG_RESERVA_SEPULTURA~~~".~~~"SEPULTURA~~~"~"   OP =~"=~"    EXP2 =~":sepultura~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"LOG_RESERVA_SEPULTURA~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~" ) ) ORDER(NAME=~"log_reserva_sepultura.fecha_log~" ASC=no) ARG(NAME = ~"sector~" TYPE = string)  ARG(NAME = ~"sepultura~" TYPE = string)  ARG(NAME = ~"parque~" TYPE = number) " update="LOG_RESERVA_SEPULTURA" updatewhere=1 updatekeyinplace=no arguments=(("sector", string),("sepultura", string),("parque", number)) )
