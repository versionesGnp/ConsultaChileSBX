table(column=(type=char(10) update=yes updatewhereclause=yes name=sepultura dbname="inventario_plani.sepultura" dbalias=".sepultura" )
 column=(type=char(10) update=yes updatewhereclause=yes name=sector dbname="inventario_plani.sector" dbalias=".sector" )
 column=(type=char(10) update=yes updatewhereclause=yes name=numero_tec dbname="inventario_plani.numero_tec" dbalias=".numero_tec" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=capacidad dbname="inventario_plani.capacidad" dbalias=".capacidad" )
 column=(type=char(2) updatewhereclause=yes name=base_plani_area dbname="base_plani.area" dbalias=".area" )
 column=(type=decimal(4) updatewhereclause=yes name=reserva_sepultura_estado dbname="reserva_sepultura.estado" dbalias=".estado" )
 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"inventario_plani~" )  TABLE(NAME=~"base_plani~" )  TABLE(NAME=~"reserva_sepultura~" ) COLUMN(NAME=~"inventario_plani.sepultura~") COLUMN(NAME=~"inventario_plani.sector~") COLUMN(NAME=~"inventario_plani.numero_tec~") COLUMN(NAME=~"inventario_plani.capacidad~") COLUMN(NAME=~"base_plani.area~") COLUMN(NAME=~"reserva_sepultura.estado~")    JOIN (LEFT=~"inventario_plani.sector~"    OP =~"=~"RIGHT=~"reserva_sepultura.sector~"    OUTER1 =~"inventario_plani.sector~" )    JOIN (LEFT=~"inventario_plani.sepultura~"    OP =~"=~"RIGHT=~"reserva_sepultura.sepultura~"    OUTER1 =~"inventario_plani.sepultura~" )    JOIN (LEFT=~"inventario_plani.sector~"    OP =~"=~"RIGHT=~"base_plani.sector~" )WHERE(    EXP1 =~"~~~"INVENTARIO_PLANI~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~"0~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INVENTARIO_PLANI~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"BASE_PLANI~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"BASE_PLANI~~~".~~~"CODIGO_PRODUCTO~~~"~"   OP =~"=~"    EXP2 =~":cod_producto~" ) )    UNION (PBSELECT( VERSION(400) TABLE(NAME=~"inventario_plani_const~" )  TABLE(NAME=~"base_plani~" )  TABLE(NAME=~"reserva_sepultura~" ) COLUMN(NAME=~"inventario_plani_const.sepultura~") COLUMN(NAME=~"inventario_plani_const.sector~") COLUMN(NAME=~"inventario_plani_const.numero_tec~") COLUMN(NAME=~"inventario_plani_const.capacidad~") COLUMN(NAME=~"base_plani.area~") COLUMN(NAME=~"reserva_sepultura.estado~")    JOIN (LEFT=~"inventario_plani_const.sector~"    OP =~"=~"RIGHT=~"reserva_sepultura.sector~"    OUTER1 =~"inventario_plani_const.sector~" )    JOIN (LEFT=~"inventario_plani_const.sepultura~"    OP =~"=~"RIGHT=~"reserva_sepultura.sepultura~"    OUTER1 =~"inventario_plani_const.sepultura~" )    JOIN (LEFT=~"inventario_plani_const.sector~"    OP =~"=~"RIGHT=~"base_plani.sector~" )WHERE(    EXP1 =~"~~~"INVENTARIO_PLANI_CONST~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~"0~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INVENTARIO_PLANI_CONST~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"BASE_PLANI~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~" ) )) ORDER(NAME=~"5~" ASC=yes )  ORDER(NAME=~"2~" ASC=yes )  ORDER(NAME=~"4~" ASC=yes ) ARG(NAME = ~"parque~" TYPE = number)  ARG(NAME = ~"cod_producto~" TYPE = string) " filter="isnull( reserva_sepultura_estado ) or  reserva_sepultura_estado =3"arguments=(("parque", number),("cod_producto", string))  sort="reserva_sepultura_estado D " )
