 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"reserva_sepultura~" ) COLUMN(NAME=~"reserva_sepultura.folio_reserva~") COLUMN(NAME=~"reserva_sepultura.area~") COLUMN(NAME=~"reserva_sepultura.sector~") COLUMN(NAME=~"reserva_sepultura.sepultura~") COLUMN(NAME=~"reserva_sepultura.base~") COLUMN(NAME=~"reserva_sepultura.serie~") COLUMN(NAME=~"reserva_sepultura.numero~") COLUMN(NAME=~"reserva_sepultura.rut~") COLUMN(NAME=~"reserva_sepultura.nombre~") COLUMN(NAME=~"reserva_sepultura.a_paterno~") COLUMN(NAME=~"reserva_sepultura.a_materno~") COLUMN(NAME=~"reserva_sepultura.observacion~") COLUMN(NAME=~"reserva_sepultura.fecha~") COLUMN(NAME=~"reserva_sepultura.cod_agente~") COLUMN(NAME=~"reserva_sepultura.estado~") COLUMN(NAME=~"reserva_sepultura.corre_inventario~") COLUMN(NAME=~"reserva_sepultura.fecha_promesa~") COLUMN(NAME=~"reserva_sepultura.cod_parque~") COLUMN(NAME=~"reserva_sepultura.capacidad~") COMPUTE(NAME=~"'','',''~")WHERE(    EXP1 =~"~~~"RESERVA_SEPULTURA~~~".~~~"FOLIO_RESERVA~~~"~"   OP =~"=~"    EXP2 =~":folio~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"RESERVA_SEPULTURA~~~".~~~"SECTOR~~~"~"   OP =~"=~"    EXP2 =~":sector~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"RESERVA_SEPULTURA~~~".~~~"SEPULTURA~~~"~"   OP =~"=~"    EXP2 =~":sepultura~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"RESERVA_SEPULTURA~~~".~~~"CORRE_INVENTARIO~~~"~"   OP =~"=~"    EXP2 =~":corre~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"RESERVA_SEPULTURA~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~" ) ) ARG(NAME = ~"folio~" TYPE = number)  ARG(NAME = ~"sector~" TYPE = string)  ARG(NAME = ~"sepultura~" TYPE = string)  ARG(NAME = ~"corre~" TYPE = number)  ARG(NAME = ~"parque~" TYPE = number) " update="RESERVA_SEPULTURA" updatewhere=0 updatekeyinplace=yes arguments=(("folio", number),("sector", string),("sepultura", string),("corre", number),("parque", number)) )
