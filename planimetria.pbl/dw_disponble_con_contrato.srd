 column=(type=char(10) updatewhereclause=yes name=inventario_plani_sepultura dbname="inventario_plani.sepultura" dbalias=".sepultura" )
 column=(type=decimal(4) updatewhereclause=yes name=inventario_plani_capacidad dbname="inventario_plani.capacidad" dbalias=".capacidad" )
 column=(type=char(100) updatewhereclause=yes name=inventario_plani_observaciones dbname="inventario_plani.observaciones" dbalias=".observaciones" )
 column=(type=char(1) updatewhereclause=yes name=pago_oferta_serie dbname="pago_oferta.serie" dbalias=".serie" )
 column=(type=decimal(4) updatewhereclause=yes name=pago_oferta_nro_oferta dbname="pago_oferta.nro_oferta" dbalias=".nro_oferta" )
 column=(type=char(1) updatewhereclause=yes name=cadena_codigo dbname="cadena.codigo" dbalias=".codigo" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"inventario_plani~" )  TABLE(NAME=~"oferta_v~" )  TABLE(NAME=~"pago_oferta~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"base_plani~" ) COLUMN(NAME=~"inventario_plani.sector~") COLUMN(NAME=~"inventario_plani.sepultura~") COLUMN(NAME=~"inventario_plani.capacidad~") COLUMN(NAME=~"inventario_plani.observaciones~") COLUMN(NAME=~"pago_oferta.serie~") COLUMN(NAME=~"pago_oferta.nro_oferta~") COLUMN(NAME=~"cadena.codigo~")    JOIN (LEFT=~"pago_oferta.sector~"    OP =~"=~"RIGHT=~"inventario_plani.sector~"    OUTER2 =~"inventario_plani.sector~" )    JOIN (LEFT=~"pago_oferta.sepultura~"    OP =~"=~"RIGHT=~"inventario_plani.sepultura~"    OUTER2 =~"inventario_plani.sepultura~" )    JOIN (LEFT=~"oferta_v.serie~"    OP =~"=~"RIGHT=~"pago_oferta.serie~" )    JOIN (LEFT=~"oferta_v.nro_oferta~"    OP =~"=~"RIGHT=~"pago_oferta.nro_oferta~" )    JOIN (LEFT=~"oferta_v.ult_folio~"    OP =~"=~"RIGHT=~"pago_oferta.folio~" )    JOIN (LEFT=~"oferta_v.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"oferta_v.nro_oferta~"    OP =~"=~"RIGHT=~"cadena.numero~" )    JOIN (LEFT=~"pago_oferta.area~"    OP =~"=~"RIGHT=~"base_plani.area~" )    JOIN (LEFT=~"pago_oferta.sector~"    OP =~"=~"RIGHT=~"base_plani.sector~" )    JOIN (LEFT=~"pago_oferta.parque~"    OP =~"=~"RIGHT=~"base_plani.cod_parque~" )WHERE(    EXP1 =~"~~~"INVENTARIO_PLANI~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~"0~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INVENTARIO_PLANI~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"BASE_PLANI~~~".~~~"CODIGO_PRODUCTO~~~"~"   OP =~"=~"    EXP2 =~":cod_producto~" ) )    UNION (PBSELECT( VERSION(400) TABLE(NAME=~"contrato~" )  TABLE(NAME=~"inventario_plani~" )  TABLE(NAME=~"cadena~" ) COLUMN(NAME=~"inventario_plani.sector~") COLUMN(NAME=~"inventario_plani.sepultura~") COLUMN(NAME=~"inventario_plani.capacidad~") COLUMN(NAME=~"inventario_plani.observaciones~") COLUMN(NAME=~"contrato.serie_c~") COLUMN(NAME=~"contrato.nro_contrato~") COLUMN(NAME=~"cadena.codigo~")    JOIN (LEFT=~"contrato.sector~"    OP =~"=~"RIGHT=~"inventario_plani.sector~"    OUTER1 =~"contrato.sector~" )    JOIN (LEFT=~"contrato.sepultura~"    OP =~"=~"RIGHT=~"inventario_plani.sepultura~"    OUTER1 =~"contrato.sepultura~" )    JOIN (LEFT=~"contrato.serie_c~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"contrato.nro_contrato~"    OP =~"=~"RIGHT=~"cadena.numero~" )WHERE(    EXP1 =~"~~~"INVENTARIO_PLANI~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~"0~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~" ) )) ARG(NAME = ~"parque~" TYPE = number)  ARG(NAME = ~"cod_producto~" TYPE = string) " arguments=(("parque", number),("cod_producto", string))  sort="compute_1 A " )
