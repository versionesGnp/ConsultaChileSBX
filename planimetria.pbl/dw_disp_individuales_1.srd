table(column=(type=char(10) updatewhereclause=yes name=inventario_plani_const_sector dbname="inventario_plani_const.sector" dbalias=".sector" )
 column=(type=char(10) updatewhereclause=yes name=inventario_plani_const_sepultura dbname="inventario_plani_const.sepultura" dbalias=".sepultura" )
 column=(type=char(20) updatewhereclause=yes name=cod_parq_nombre dbname="cod_parq.nombre" dbalias=".nombre" )
 column=(type=decimal(4) updatewhereclause=yes name=inventario_plani_const_numero dbname="inventario_plani_const.numero" dbalias=".numero" )
 column=(type=decimal(4) updatewhereclause=yes name=fallecidos_llave dbname="fallecidos.llave" dbalias=".llave" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"inventario_plani~" )  TABLE(NAME=~"inventario_plani_const~" )  TABLE(NAME=~"cod_parq~" )  TABLE(NAME=~"fallecidos~" ) COLUMN(NAME=~"inventario_plani_const.sector~") COLUMN(NAME=~"inventario_plani_const.sepultura~") COLUMN(NAME=~"cod_parq.nombre~") COLUMN(NAME=~"inventario_plani_const.numero~") COLUMN(NAME=~"fallecidos.llave~")    JOIN (LEFT=~"inventario_plani_const.base~"    OP =~"=~"RIGHT=~"fallecidos.base~"    OUTER1 =~"inventario_plani_const.base~" )    JOIN (LEFT=~"inventario_plani_const.serie~"    OP =~"=~"RIGHT=~"fallecidos.ss~"    OUTER1 =~"inventario_plani_const.serie~" )    JOIN (LEFT=~"inventario_plani_const.numero~"    OP =~"=~"RIGHT=~"fallecidos.contrato~"    OUTER1 =~"inventario_plani_const.numero~" )    JOIN (LEFT=~"inventario_plani.sector~"    OP =~"=~"RIGHT=~"inventario_plani_const.sector~" )    JOIN (LEFT=~"inventario_plani.sepultura~"    OP =~"=~"RIGHT=~"inventario_plani_const.sepultura~" )    JOIN (LEFT=~"inventario_plani.cod_parque~"    OP =~"=~"RIGHT=~"inventario_plani_const.cod_parque~" )    JOIN (LEFT=~"cod_parq.codigo~"    OP =~"=~"RIGHT=~"inventario_plani.cod_parque~" )WHERE(    EXP1 =~"~~~"INVENTARIO_PLANI~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~"10000000~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INVENTARIO_PLANI~~~".~~~"BASE~~~"~"   OP =~"<>~"    EXP2 =~"'U'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FALLECIDOS~~~".~~~"ESTADO_REG~~~"~"   OP =~"=~"    EXP2 =~"'A'~" ) ) ORDER(NAME=~"inventario_plani_const.sector~" ASC=yes )  ORDER(NAME=~"inventario_plani_const.sepultura~" ASC=yes ) " )
