table(column=(type=char(8) updatewhereclause=yes name=sector dbname="fallecidos.sector" dbalias=".sector" )
 column=(type=char(8) updatewhereclause=yes name=n_sep dbname="fallecidos.n_sep" dbalias=".n_sep" )
 column=(type=char(45) updatewhereclause=yes name=nombres dbname="fallecidos.nombres" dbalias=".nombres" )
 column=(type=char(20) updatewhereclause=yes name=ap_paterno dbname="fallecidos.ap_paterno" dbalias=".ap_paterno" )
 column=(type=char(20) updatewhereclause=yes name=ap_materno dbname="fallecidos.ap_materno" dbalias=".ap_materno" )
 column=(type=datetime updatewhereclause=yes name=fec_sep dbname="fallecidos.fec_sep" dbalias=".fec_sep" )
 column=(type=decimal(4) updatewhereclause=yes name=rut dbname="fallecidos.rut" dbalias=".rut" )
