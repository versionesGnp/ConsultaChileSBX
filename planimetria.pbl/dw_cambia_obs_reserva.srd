 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"reserva_sepultura~" ) COLUMN(NAME=~"reserva_sepultura.folio_reserva~") COLUMN(NAME=~"reserva_sepultura.area~") COLUMN(NAME=~"reserva_sepultura.sector~") COLUMN(NAME=~"reserva_sepultura.sepultura~") COLUMN(NAME=~"reserva_sepultura.base~") COLUMN(NAME=~"reserva_sepultura.serie~") COLUMN(NAME=~"reserva_sepultura.numero~") COLUMN(NAME=~"reserva_sepultura.rut~") COLUMN(NAME=~"reserva_sepultura.nombre~") COLUMN(NAME=~"reserva_sepultura.a_paterno~") COLUMN(NAME=~"reserva_sepultura.a_materno~") COLUMN(NAME=~"reserva_sepultura.observacion~") COLUMN(NAME=~"reserva_sepultura.fecha~") COLUMN(NAME=~"reserva_sepultura.cod_agente~") COLUMN(NAME=~"reserva_sepultura.estado~") COLUMN(NAME=~"reserva_sepultura.corre_inventario~") COLUMN(NAME=~"reserva_sepultura.fecha_promesa~") COLUMN(NAME=~"reserva_sepultura.cod_parque~")WHERE(    EXP1 =~"~~~"RESERVA_SEPULTURA~~~".~~~"SECTOR~~~"~"   OP =~"=~"    EXP2 =~":SECTOR~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"RESERVA_SEPULTURA~~~".~~~"SEPULTURA~~~"~"   OP =~"=~"    EXP2 =~":SEP~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"RESERVA_SEPULTURA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"1~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"RESERVA_SEPULTURA~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~" ) ) ARG(NAME = ~"SECTOR~" TYPE = string)  ARG(NAME = ~"SEP~" TYPE = string)  ARG(NAME = ~"parque~" TYPE = number) " update="RESERVA_SEPULTURA" updatewhere=1 updatekeyinplace=no arguments=(("SECTOR", string),("SEP", string),("parque", number)) )
