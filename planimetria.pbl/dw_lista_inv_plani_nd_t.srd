 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"inventario_plani~" ) COLUMN(NAME=~"inventario_plani.base~") COLUMN(NAME=~"inventario_plani.serie~") COLUMN(NAME=~"inventario_plani.numero~") COLUMN(NAME=~"inventario_plani.rut~") COLUMN(NAME=~"inventario_plani.sector~") COLUMN(NAME=~"inventario_plani.sub_sector~") COLUMN(NAME=~"inventario_plani.sepultura~") COLUMN(NAME=~"inventario_plani.capacidad~") COLUMN(NAME=~"inventario_plani.status~") COLUMN(NAME=~"inventario_plani.fecha_status~") COLUMN(NAME=~"inventario_plani.folio_asignacion~") COLUMN(NAME=~"inventario_plani.numero_tec~") COLUMN(NAME=~"inventario_plani.correlativo~")WHERE(    EXP1 =~"~~~"INVENTARIO_PLANI~~~".~~~"SECTOR~~~"~"   OP =~"=~"    EXP2 =~":sector~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INVENTARIO_PLANI~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":PARQUE~" ) ) ORDER(NAME=~"inventario_plani.correlativo~" ASC=yes ) ARG(NAME = ~"sector~" TYPE = string)  ARG(NAME = ~"PARQUE~" TYPE = number) " update="INVENTARIO_PLANI" updatewhere=0 updatekeyinplace=no arguments=(("sector", string),("PARQUE", number)) )
