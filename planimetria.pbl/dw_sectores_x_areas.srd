table(column=(type=char(8) updatewhereclause=yes key=yes name=sector dbname="base_plani.sector" )
 column=(type=char(1) updatewhereclause=yes name=tipo dbname="base_plani.tipo" )
 column=(type=decimal(4) updatewhereclause=yes name=total_sep dbname="base_plani.total_sep" )
 column=(type=decimal(4) updatewhereclause=yes name=total_asignadas dbname="base_plani.total_asignadas" )
 column=(type=decimal(4) updatewhereclause=yes name=capacidad dbname="base_plani.capacidad" )
 column=(type=char(2) updatewhereclause=yes key=yes name=area dbname="base_plani.area" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"base_plani~" ) COLUMN(NAME=~"base_plani.sector~") COLUMN(NAME=~"base_plani.tipo~") COLUMN(NAME=~"base_plani.total_sep~") COLUMN(NAME=~"base_plani.total_asignadas~") COLUMN(NAME=~"base_plani.capacidad~") COLUMN(NAME=~"base_plani.area~")WHERE(    EXP1 =~"~~~"BASE_PLANI~~~".~~~"AREA~~~"~"   OP =~"=~"    EXP2 =~":area~" ) ) ORDER(NAME=~"base_plani.tipo~" ASC=yes )  ORDER(NAME=~"base_plani.sector~" ASC=yes ) ARG(NAME = ~"area~" TYPE = string) " update="BASE_PLANI" updatewhere=0 updatekeyinplace=no arguments=(("area", string)) )
