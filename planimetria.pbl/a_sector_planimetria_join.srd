 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"planimetria~" )  TABLE(NAME=~"cadena~" ) COLUMN(NAME=~"planimetria.parque~") COLUMN(NAME=~"planimetria.zona~") COLUMN(NAME=~"planimetria.sector~") COLUMN(NAME=~"planimetria.nro_sistema~") COLUMN(NAME=~"planimetria.sepultura~") COLUMN(NAME=~"planimetria.nro_tecnico~") COLUMN(NAME=~"planimetria.capacidad~") COLUMN(NAME=~"planimetria.tipo_construccion~") COLUMN(NAME=~"planimetria.estado_sepultura~") COLUMN(NAME=~"planimetria.base~") COLUMN(NAME=~"planimetria.serie~") COLUMN(NAME=~"planimetria.nro_contrato~") COLUMN(NAME=~"planimetria.ubs~") COLUMN(NAME=~"planimetria.xx~") COLUMN(NAME=~"planimetria.yy~") COMPUTE(NAME=~"''~") COMPUTE(NAME=~"1~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"planimetria.fallecidos~") COLUMN(NAME=~"planimetria.tipo_sepult~")    JOIN (LEFT=~"planimetria.base~"    OP =~"=~"RIGHT=~"cadena.codigo~" )    JOIN (LEFT=~"planimetria.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"planimetria.nro_contrato~"    OP =~"=~"RIGHT=~"cadena.numero~" )WHERE(    EXP1 =~"~~~"PLANIMETRIA~~~".~~~"SECTOR~~~"~"   OP =~"=~"    EXP2 =~":gs_sector~" ) ) ORDER(NAME=~"planimetria.sepultura~" ASC=yes ) ARG(NAME = ~"gs_sector~" TYPE = string) " arguments=(("gs_sector", string)) )
