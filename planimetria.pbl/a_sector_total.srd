 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cadena~" )  TABLE(NAME=~"contrato~" )  TABLE(NAME=~"estado~" ) COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"cadena.serie~") COLUMN(NAME=~"cadena.numero~") COLUMN(NAME=~"contrato.sector~") COLUMN(NAME=~"contrato.sepultura~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"estado.sigla_estado~")    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"contrato.serie_c~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"contrato.nro_contrato~" )    JOIN (LEFT=~"cadena.estado~"    OP =~"=~"RIGHT=~"estado.cod_estado~" )WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'C'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CONTRATO~~~".~~~"SECTOR~~~"~"   OP =~"=~"    EXP2 =~":sector_b~" ) )    UNION (PBSELECT( VERSION(400) TABLE(NAME=~"cadena~" )  TABLE(NAME=~"oferta_v~" )  TABLE(NAME=~"pago_oferta~" )  TABLE(NAME=~"estado~" ) COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"cadena.serie~") COLUMN(NAME=~"cadena.numero~") COLUMN(NAME=~"pago_oferta.sector~") COLUMN(NAME=~"pago_oferta.sepultura~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"estado.sigla_estado~")    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"oferta_v.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"oferta_v.nro_oferta~" )    JOIN (LEFT=~"oferta_v.serie~"    OP =~"=~"RIGHT=~"pago_oferta.serie~" )    JOIN (LEFT=~"oferta_v.nro_oferta~"    OP =~"=~"RIGHT=~"pago_oferta.nro_oferta~" )    JOIN (LEFT=~"oferta_v.ult_folio~"    OP =~"=~"RIGHT=~"pago_oferta.folio~" )    JOIN (LEFT=~"cadena.estado~"    OP =~"=~"RIGHT=~"estado.cod_estado~" )WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'O'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"PAGO_OFERTA~~~".~~~"SECTOR~~~"~"   OP =~"=~"    EXP2 =~":sector_b~" ) ))    UNION (PBSELECT( VERSION(400) TABLE(NAME=~"asigna_sep~" )  TABLE(NAME=~"estado~" ) COLUMN(NAME=~"asigna_sep.base~") COLUMN(NAME=~"asigna_sep.serie~") COLUMN(NAME=~"asigna_sep.contrato~") COLUMN(NAME=~"asigna_sep.sector~") COLUMN(NAME=~"asigna_sep.sepultura~") COLUMN(NAME=~"asigna_sep.estado_contrato~") COLUMN(NAME=~"estado.sigla_estado~")    JOIN (LEFT=~"asigna_sep.estado_contrato~"    OP =~"=~"RIGHT=~"estado.cod_estado~" )WHERE(    EXP1 =~"~~~"ASIGNA_SEP~~~".~~~"SECTOR~~~"~"   OP =~"=~"    EXP2 =~":sector_b~" ) ))    UNION (PBSELECT( VERSION(400) TABLE(NAME=~"fallecidos~" )  TABLE(NAME=~"estado~" ) COLUMN(NAME=~"fallecidos.base~") COLUMN(NAME=~"fallecidos.ss~") COLUMN(NAME=~"fallecidos.contrato~") COLUMN(NAME=~"fallecidos.sector~") COLUMN(NAME=~"fallecidos.n_sep~") COLUMN(NAME=~"fallecidos.estado_contrato~") COLUMN(NAME=~"estado.sigla_estado~")    JOIN (LEFT=~"fallecidos.estado_contrato~"    OP =~"=~"RIGHT=~"estado.cod_estado~" )WHERE(    EXP1 =~"~~~"FALLECIDOS~~~".~~~"SECTOR~~~"~"   OP =~"=~"    EXP2 =~":sector_b~" ) )) ARG(NAME = ~"sector_b~" TYPE = string) " arguments=(("sector_b", string))  sort="INTEGER(contrato_sepultura) A " )
