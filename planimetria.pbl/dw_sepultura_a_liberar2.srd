 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"inventario_plani~" )  TABLE(NAME=~"cliente~" ) COLUMN(NAME=~"inventario_plani.base~") COLUMN(NAME=~"inventario_plani.serie~") COLUMN(NAME=~"inventario_plani.numero~") COLUMN(NAME=~"inventario_plani.rut~") COLUMN(NAME=~"inventario_plani.sector~") COLUMN(NAME=~"inventario_plani.sepultura~") COLUMN(NAME=~"inventario_plani.capacidad~") COLUMN(NAME=~"inventario_plani.observaciones~") COLUMN(NAME=~"inventario_plani.numero_tec~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~")    JOIN (LEFT=~"inventario_plani.rut~"    OP =~"=~"RIGHT=~"cliente.rut~" )WHERE(    EXP1 =~"~~~"INVENTARIO_PLANI~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"INVENTARIO_PLANI~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"INVENTARIO_PLANI~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"INVENTARIO_PLANI~~~".~~~"SECTOR~~~"~"   OP =~"=~"    EXP2 =~":sector~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"INVENTARIO_PLANI~~~".~~~"SEPULTURA~~~"~"   OP =~"=~"    EXP2 =~":sepultura~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number)  ARG(NAME = ~"sector~" TYPE = string)  ARG(NAME = ~"sepultura~" TYPE = string) " arguments=(("base", string),("serie", string),("numero", number),("sector", string),("sepultura", string)) )
