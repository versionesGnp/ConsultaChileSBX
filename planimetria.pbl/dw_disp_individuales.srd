 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"inventario_plani~" )  TABLE(NAME=~"inventario_plani_const~" )  TABLE(NAME=~"cod_parq~" )  TABLE(NAME=~"fallecidos~" ) COLUMN(NAME=~"inventario_plani_const.base~") COLUMN(NAME=~"inventario_plani_const.serie~") COLUMN(NAME=~"inventario_plani_const.numero~") COLUMN(NAME=~"cod_parq.nombre~") COLUMN(NAME=~"fallecidos.llave~") COLUMN(NAME=~"inventario_plani_const.sector~") COLUMN(NAME=~"inventario_plani_const.sepultura~")    JOIN (LEFT=~"inventario_plani_const.base~"    OP =~"=~"RIGHT=~"fallecidos.base~"    OUTER1 =~"inventario_plani_const.base~" )    JOIN (LEFT=~"inventario_plani_const.serie~"    OP =~"=~"RIGHT=~"fallecidos.ss~"    OUTER1 =~"inventario_plani_const.serie~" )    JOIN (LEFT=~"inventario_plani_const.numero~"    OP =~"=~"RIGHT=~"fallecidos.contrato~"    OUTER1 =~"inventario_plani_const.numero~" )    JOIN (LEFT=~"inventario_plani.sector~"    OP =~"=~"RIGHT=~"inventario_plani_const.sector~" )    JOIN (LEFT=~"inventario_plani.cod_parque~"    OP =~"=~"RIGHT=~"cod_parq.codigo~" )    JOIN (LEFT=~"inventario_plani.sepultura~"    OP =~"=~"RIGHT=~"inventario_plani_const.sepultura~" )    JOIN (LEFT=~"inventario_plani.cod_parque~"    OP =~"=~"RIGHT=~"inventario_plani_const.cod_parque~" )WHERE(    EXP1 =~"~~~"INVENTARIO_PLANI~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~"10000000~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INVENTARIO_PLANI~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INVENTARIO_PLANI~~~".~~~"SECTOR~~~"~"   OP =~"=~"    EXP2 =~"'G50M12'~" ) ) ARG(NAME = ~"parque~" TYPE = number) " arguments=(("parque", number)) )
