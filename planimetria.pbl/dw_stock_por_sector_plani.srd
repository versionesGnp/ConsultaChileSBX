 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"inventario_plani~" )  TABLE(NAME=~"base_plani~" ) COLUMN(NAME=~"inventario_plani.sector~") COLUMN(NAME=~"inventario_plani.sepultura~") COLUMN(NAME=~"inventario_plani.capacidad~") COLUMN(NAME=~"inventario_plani.numero_tec~") COLUMN(NAME=~"base_plani.area~")    JOIN (LEFT=~"inventario_plani.sector~"    OP =~"=~"RIGHT=~"base_plani.sector~" )WHERE(    EXP1 =~"~~~"INVENTARIO_PLANI~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~"0~" ) )    UNION (PBSELECT( VERSION(400) TABLE(NAME=~"inventario_plani_const~" )  TABLE(NAME=~"base_plani~" ) COLUMN(NAME=~"inventario_plani_const.sector~") COLUMN(NAME=~"inventario_plani_const.sepultura~") COLUMN(NAME=~"inventario_plani_const.capacidad~") COLUMN(NAME=~"inventario_plani_const.numero_tec~") COLUMN(NAME=~"base_plani.area~")    JOIN (LEFT=~"inventario_plani_const.sector~"    OP =~"=~"RIGHT=~"base_plani.sector~" )WHERE(    EXP1 =~"~~~"INVENTARIO_PLANI_CONST~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~"0~" ) )) ORDER(NAME=~"5~" ASC=yes )  ORDER(NAME=~"1~" ASC=yes ) " retrieve.asneeded=yes data.storage=disk  sort="base_plani_area A sector A " )
