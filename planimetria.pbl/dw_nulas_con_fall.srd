 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"cadena~" )  TABLE(NAME=~"inventario_plani~" )  TABLE(NAME=~"fallecidos~" )  TABLE(NAME=~"cliente~" ) COLUMN(NAME=~"inventario_plani.base~") COLUMN(NAME=~"inventario_plani.serie~") COLUMN(NAME=~"inventario_plani.numero~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"inventario_plani.rut~") COLUMN(NAME=~"inventario_plani.sector~") COLUMN(NAME=~"inventario_plani.sepultura~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~")    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"inventario_plani.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"inventario_plani.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"inventario_plani.numero~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"fallecidos.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"fallecidos.ss~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"fallecidos.contrato~" )    JOIN (LEFT=~"cadena.rut~"    OP =~"=~"RIGHT=~"cliente.rut~" )WHERE(    EXP1 =~"(~~~"CADENA~~~".~~~"ESTADO~~~"~"   OP =~"<>~"    EXP2 =~"'V'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"ESTADO~~~"~"   OP =~"<>~"    EXP2 =~"'C')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FALLECIDOS~~~".~~~"ESTADO_REG~~~"~"   OP =~"=~"    EXP2 =~"'A'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"<>~"    EXP2 =~"'U'~" ) ) ORDER(NAME=~"inventario_plani.sector~" ASC=yes )  ORDER(NAME=~"inventario_plani.sepultura~" ASC=yes ) ARG(NAME = ~"parque~" TYPE = number) " arguments=(("parque", number))  sort="inventario_plani_sector A inventario_plani_sepultura A " )
