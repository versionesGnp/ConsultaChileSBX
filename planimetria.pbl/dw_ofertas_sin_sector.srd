 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"planimetria_aux~" ) COLUMN(NAME=~"planimetria_aux.parque~") COLUMN(NAME=~"planimetria_aux.zona~") COLUMN(NAME=~"planimetria_aux.sector~") COLUMN(NAME=~"planimetria_aux.sepultura~") COLUMN(NAME=~"planimetria_aux.nro_tecnico~") COLUMN(NAME=~"planimetria_aux.capacidad~") COLUMN(NAME=~"planimetria_aux.base~") COLUMN(NAME=~"planimetria_aux.serie~") COLUMN(NAME=~"planimetria_aux.nro_contrato~") COLUMN(NAME=~"planimetria_aux.tipo_contruccion~") COLUMN(NAME=~"planimetria_aux.reg_fallido~")WHERE(    EXP1 =~"~~~"PLANIMETRIA_AUX~~~".~~~"REG_FALLIDO~~~"~"   OP =~"=~"    EXP2 =~"'1'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"PLANIMETRIA_AUX~~~".~~~"REG_FALLIDO~~~"~"   OP =~"=~"    EXP2 =~"'2'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"PLANIMETRIA_AUX~~~".~~~"REG_FALLIDO~~~"~"   OP =~"=~"    EXP2 =~"'3'~" ) ) ORDER(NAME=~"planimetria_aux.reg_fallido~" ASC=yes ) " )
