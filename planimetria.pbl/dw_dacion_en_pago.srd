table(column=(type=char(1) updatewhereclause=yes name=cadena_codigo dbname="cadena.codigo" )
 column=(type=char(1) updatewhereclause=yes name=cadena_serie dbname="cadena.serie" )
 column=(type=decimal(4) updatewhereclause=yes name=cadena_numero dbname="cadena.numero" )
 column=(type=char(20) updatewhereclause=yes name=cod_parq_nombre dbname="cod_parq.nombre" )
 column=(type=char(2) updatewhereclause=yes name=pago_oferta_area dbname="pago_oferta.area" )
 column=(type=char(8) updatewhereclause=yes name=pago_oferta_sector dbname="pago_oferta.sector" )
 column=(type=char(8) updatewhereclause=yes name=pago_oferta_sepultura dbname="pago_oferta.sepultura" )
 column=(type=datetime updatewhereclause=yes name=cadena_fecha_res dbname="cadena.fecha_res" )
 column=(type=char(20) updatewhereclause=yes name=estado_nombre_estado dbname="estado.nombre_estado" )
 column=(type=char(0) updatewhereclause=yes name=fallecido dbname="compute_0010" )
 column=(type=char(0) updatewhereclause=yes name=fall dbname="compute_0011" )
 column=(type=char(2) updatewhereclause=yes name=codigo_producto dbname="codigo_producto" )
 retrieve="  SELECT ~"CADENA~".~"CODIGO~",   
         ~"CADENA~".~"SERIE~",   
         ~"CADENA~".~"NUMERO~",   
         ~"COD_PARQ~".~"NOMBRE~",   
         ~"PAGO_OFERTA~".~"AREA~",   
         ~"PAGO_OFERTA~".~"SECTOR~",   
         ~"PAGO_OFERTA~".~"SEPULTURA~",   
         ~"CADENA~".~"FECHA_RES~",   
         ~"ESTADO~".~"NOMBRE_ESTADO~" ,
			'' ,
			'',
		'SE' as CODIGO_PRODUCTO
    FROM ~"CADENA~",   
         ~"OFERTA_V~",   
         ~"PAGO_OFERTA~",   
         ~"ESTADO~",
         ~"COD_PARQ~"  
   WHERE ( ~"CADENA~".~"SERIE~" = ~"OFERTA_V~".~"SERIE~" ) and  
         ( ~"CADENA~".~"NUMERO~" = ~"OFERTA_V~".~"NRO_OFERTA~" ) and  
         ( ~"OFERTA_V~".~"SERIE~" = ~"PAGO_OFERTA~".~"SERIE~" ) and  
         ( ~"OFERTA_V~".~"NRO_OFERTA~" = ~"PAGO_OFERTA~".~"NRO_OFERTA~" ) and  
         ( ~"OFERTA_V~".~"ULT_FOLIO~" = ~"PAGO_OFERTA~".~"FOLIO~" ) and  
         ( ~"CADENA~".~"ESTADO~" = ~"ESTADO~".~"COD_ESTADO~" ) and  
         ( ~"COD_PARQ~".~"CODIGO~" = ~"CADENA~".~"COD_PARQUE~" ) AND 
         ( ( ~"CADENA~".~"CODIGO~" = 'O' ) AND  
         ( ~"CADENA~".~"ESTADO~" = 'D' ) AND  
         ( ~"CADENA~".~"COD_PARQUE~" = :cod_parque ) AND
		( 'SE' = :cod_producto) )   
union
SELECT ~"CADENA~".~"CODIGO~",   
         ~"CADENA~".~"SERIE~",   
         ~"CADENA~".~"NUMERO~",   
         ~"COD_PARQ~".~"NOMBRE~",   
         ~"CONTRATO~".~"ZONA~",   
         ~"CONTRATO~".~"SECTOR~",   
         ~"CONTRATO~".~"SEPULTURA~",   
         ~"CADENA~".~"FECHA_RES~",   
         ~"ESTADO~".~"NOMBRE_ESTADO~"  ,
         '' ,
         '',
		'SE' as CODIGO_PRODUCTO
    FROM ~"CADENA~",   
         ~"CONTRATO~",   
         ~"ESTADO~"  ,
         ~"COD_PARQ~"
   WHERE ( ~"CADENA~".~"SERIE~" = ~"CONTRATO~".~"SERIE_C~" ) and  
         ( ~"CADENA~".~"NUMERO~" = ~"CONTRATO~".~"NRO_CONTRATO~" ) and  
         ( ~"CADENA~".~"ESTADO~" = ~"ESTADO~".~"COD_ESTADO~" ) and  
         ( ~"COD_PARQ~".~"CODIGO~" = ~"CADENA~".~"COD_PARQUE~" ) AND 
         ( ( ~"CADENA~".~"CODIGO~" = 'C' ) AND  
         ( ~"CADENA~".~"ESTADO~" = 'D' ) AND  
         ( ~"CADENA~".~"COD_PARQUE~" = :cod_parque ) AND
		( 'SE' = :cod_producto))   
union
  SELECT ~"CADENA~".~"CODIGO~",   
         ~"CADENA~".~"SERIE~",   
         ~"CADENA~".~"NUMERO~",   
         ~"COD_PARQ~".~"NOMBRE~",   
         ~"PAGO_OFERTA~".~"AREA~",   
         ~"PAGO_OFERTA~".~"SECTOR~",   
         ~"PAGO_OFERTA~".~"SEPULTURA~",   
         ~"CADENA~".~"FECHA_RES~",   
         ~"ESTADO~".~"NOMBRE_ESTADO~" ,
			'' ,
			'',
			'CO' as CODIGO_PRODUCTO
    FROM ~"CADENA~",   
         ~"OFERTA_V~",   
         ~"PAGO_OFERTA~",   
         ~"ESTADO~",
         ~"COD_PARQ~"  
   WHERE ( ~"CADENA~".~"SERIE~" = ~"OFERTA_V~".~"SERIE~" ) and  
         ( ~"CADENA~".~"NUMERO~" = ~"OFERTA_V~".~"NRO_OFERTA~" ) and  
         ( ~"OFERTA_V~".~"SERIE~" = ~"PAGO_OFERTA~".~"SERIE~" ) and  
         ( ~"OFERTA_V~".~"NRO_OFERTA~" = ~"PAGO_OFERTA~".~"NRO_OFERTA~" ) and  
         ( ~"OFERTA_V~".~"ULT_FOLIO~" = ~"PAGO_OFERTA~".~"FOLIO~" ) and  
         ( ~"CADENA~".~"ESTADO~" = ~"ESTADO~".~"COD_ESTADO~" ) and  
         ( ~"COD_PARQ~".~"CODIGO~" = ~"CADENA~".~"COD_PARQUE~" ) AND 
         ( ( ~"CADENA~".~"CODIGO~" = 'U' ) AND  
         ( ~"CADENA~".~"ESTADO~" = 'D' ) AND  
         ( ~"CADENA~".~"COD_PARQUE~" = :cod_parque ) AND
		( 'CO' = :cod_producto))   " arguments=(("cod_parque", number),("cod_producto", string)) )
