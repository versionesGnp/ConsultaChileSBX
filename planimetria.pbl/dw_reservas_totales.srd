 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"reserva_sepultura~" )  TABLE(NAME=~"base_plani~" ) COLUMN(NAME=~"reserva_sepultura.folio_reserva~") COLUMN(NAME=~"reserva_sepultura.area~") COLUMN(NAME=~"reserva_sepultura.sector~") COLUMN(NAME=~"reserva_sepultura.sepultura~") COLUMN(NAME=~"reserva_sepultura.base~") COLUMN(NAME=~"reserva_sepultura.serie~") COLUMN(NAME=~"reserva_sepultura.numero~") COLUMN(NAME=~"reserva_sepultura.rut~") COLUMN(NAME=~"reserva_sepultura.nombre~") COLUMN(NAME=~"reserva_sepultura.a_paterno~") COLUMN(NAME=~"reserva_sepultura.a_materno~") COLUMN(NAME=~"reserva_sepultura.observacion~") COLUMN(NAME=~"reserva_sepultura.fecha~") COLUMN(NAME=~"reserva_sepultura.cod_agente~") COLUMN(NAME=~"reserva_sepultura.estado~") COLUMN(NAME=~"reserva_sepultura.corre_inventario~") COLUMN(NAME=~"reserva_sepultura.fecha_promesa~") COLUMN(NAME=~"reserva_sepultura.capacidad~") COLUMN(NAME=~"base_plani.area~") COLUMN(NAME=~"reserva_sepultura.cod_parque~") COLUMN(NAME=~"reserva_sepultura.tipo_clasifica~") COLUMN(NAME=~"reserva_sepultura.tipo_reserva~") COLUMN(NAME=~"reserva_sepultura.obs_tecnica~")    JOIN (LEFT=~"reserva_sepultura.area~"    OP =~"=~"RIGHT=~"base_plani.area~"    OUTER1 =~"reserva_sepultura.area~" )    JOIN (LEFT=~"reserva_sepultura.cod_parque~"    OP =~"=~"RIGHT=~"base_plani.cod_parque~"    OUTER1 =~"reserva_sepultura.cod_parque~" )    JOIN (LEFT=~"reserva_sepultura.sector~"    OP =~"=~"RIGHT=~"base_plani.sector~"    OUTER1 =~"reserva_sepultura.sector~" )WHERE(    EXP1 =~"~~~"RESERVA_SEPULTURA~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"BASE_PLANI~~~".~~~"CODIGO_PRODUCTO~~~"~"   OP =~"=~"    EXP2 =~":cod_producto~" ) ) ORDER(NAME=~"reserva_sepultura.fecha~" ASC=yes ) ARG(NAME = ~"parque~" TYPE = number)  ARG(NAME = ~"cod_producto~" TYPE = string) " arguments=(("parque", number),("cod_producto", string)) )
