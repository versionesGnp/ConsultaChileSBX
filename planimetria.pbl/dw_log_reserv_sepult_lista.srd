 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"log_reserva_sepultura~" )  TABLE(NAME=~"reserva_sepultura~" ) COLUMN(NAME=~"log_reserva_sepultura.correlativo~") COLUMN(NAME=~"log_reserva_sepultura.area~") COLUMN(NAME=~"log_reserva_sepultura.sector~") COLUMN(NAME=~"log_reserva_sepultura.sepultura~") COLUMN(NAME=~"log_reserva_sepultura.base~") COLUMN(NAME=~"log_reserva_sepultura.serie~") COLUMN(NAME=~"log_reserva_sepultura.numero~") COLUMN(NAME=~"log_reserva_sepultura.folio_reserva~") COLUMN(NAME=~"log_reserva_sepultura.rut~") COLUMN(NAME=~"log_reserva_sepultura.observacion~") COLUMN(NAME=~"log_reserva_sepultura.fecha_reserva~") COLUMN(NAME=~"log_reserva_sepultura.estado~") COLUMN(NAME=~"log_reserva_sepultura.cod_agente~") COLUMN(NAME=~"log_reserva_sepultura.fecha_log~") COLUMN(NAME=~"log_reserva_sepultura.usuario_log~") COLUMN(NAME=~"log_reserva_sepultura.corre_reserva~") COLUMN(NAME=~"reserva_sepultura.estado~")    JOIN (LEFT=~"log_reserva_sepultura.sector~"    OP =~"=~"RIGHT=~"reserva_sepultura.sector~" )    JOIN (LEFT=~"log_reserva_sepultura.sepultura~"    OP =~"=~"RIGHT=~"reserva_sepultura.sepultura~" )    JOIN (LEFT=~"log_reserva_sepultura.folio_reserva~"    OP =~"=~"RIGHT=~"reserva_sepultura.folio_reserva~" )    JOIN (LEFT=~"log_reserva_sepultura.cod_parque~"    OP =~"=~"RIGHT=~"reserva_sepultura.cod_parque~" )WHERE(    EXP1 =~"~~~"LOG_RESERVA_SEPULTURA~~~".~~~"SECTOR~~~"~"   OP =~"=~"    EXP2 =~":SECTOR~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"LOG_RESERVA_SEPULTURA~~~".~~~"SEPULTURA~~~"~"   OP =~"=~"    EXP2 =~":SEPULTURA~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"LOG_RESERVA_SEPULTURA~~~".~~~"CORRE_RESERVA~~~"~"   OP =~"=~"    EXP2 =~":corre~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"LOG_RESERVA_SEPULTURA~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~" ) ) ORDER(NAME=~"log_reserva_sepultura.fecha_reserva~" ASC=no) ARG(NAME = ~"SECTOR~" TYPE = string)  ARG(NAME = ~"SEPULTURA~" TYPE = string)  ARG(NAME = ~"corre~" TYPE = number)  ARG(NAME = ~"parque~" TYPE = number) " arguments=(("SECTOR", string),("SEPULTURA", string),("corre", number),("parque", number)) )
