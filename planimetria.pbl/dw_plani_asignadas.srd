 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"planimetria~" ) COLUMN(NAME=~"planimetria.parque~") COLUMN(NAME=~"planimetria.zona~") COLUMN(NAME=~"planimetria.sector~") COLUMN(NAME=~"planimetria.nro_sistema~") COLUMN(NAME=~"planimetria.sepultura~") COLUMN(NAME=~"planimetria.nro_tecnico~") COLUMN(NAME=~"planimetria.capacidad~") COLUMN(NAME=~"planimetria.tipo_construccion~") COLUMN(NAME=~"planimetria.estado_sepultura~") COLUMN(NAME=~"planimetria.base~") COLUMN(NAME=~"planimetria.serie~") COLUMN(NAME=~"planimetria.nro_contrato~")WHERE(    EXP1 =~"~~~"PLANIMETRIA~~~".~~~"ESTADO_SEPULTURA~~~"~"   OP =~"=~"    EXP2 =~"'A'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"PLANIMETRIA~~~".~~~"SECTOR~~~"~"   OP =~"=~"    EXP2 =~"'A1'~" ) ) ORDER(NAME=~"planimetria.sector~" ASC=yes )  ORDER(NAME=~"planimetria.nro_sistema~" ASC=yes ) " update="PLANIMETRIA" updatewhere=1 updatekeyinplace=no )
