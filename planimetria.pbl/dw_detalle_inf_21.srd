 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"reserva_sepultura~" )  TABLE(NAME=~"reserva_tipo~" )  TABLE(NAME=~"reserva_clasifica~" ) COLUMN(NAME=~"reserva_sepultura.cod_parque~") COLUMN(NAME=~"reserva_sepultura.area~") COLUMN(NAME=~"reserva_sepultura.sector~") COLUMN(NAME=~"reserva_sepultura.sepultura~") COLUMN(NAME=~"reserva_sepultura.tipo_reserva~") COLUMN(NAME=~"reserva_tipo.descripcion~") COLUMN(NAME=~"reserva_sepultura.obs_tecnica~") COLUMN(NAME=~"reserva_clasifica.descripcion~")    JOIN (LEFT=~"reserva_sepultura.tipo_reserva~"    OP =~"=~"RIGHT=~"reserva_tipo.tipo_reserva~" )    JOIN (LEFT=~"reserva_sepultura.tipo_clasifica~"    OP =~"=~"RIGHT=~"reserva_clasifica.tipo_clasifica~" )WHERE(    EXP1 =~"~~~"RESERVA_SEPULTURA~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":ll_parque~" ) ) ARG(NAME = ~"ll_parque~" TYPE = number) " arguments=(("ll_parque", number))  sort="reserva_clasifica_descripcion D reserva_sepultura_area A reserva_sepultura_sector A reserva_sepultura_sepultura A " )
