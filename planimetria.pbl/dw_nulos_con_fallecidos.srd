 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cadena~" )  TABLE(NAME=~"planimetria~" ) COLUMN(NAME=~"planimetria.zona~") COLUMN(NAME=~"planimetria.sector~") COLUMN(NAME=~"planimetria.nro_sistema~") COLUMN(NAME=~"planimetria.sepultura~") COLUMN(NAME=~"planimetria.nro_tecnico~") COLUMN(NAME=~"planimetria.capacidad~") COLUMN(NAME=~"planimetria.tipo_construccion~") COLUMN(NAME=~"planimetria.base~") COLUMN(NAME=~"planimetria.serie~") COLUMN(NAME=~"planimetria.nro_contrato~") COLUMN(NAME=~"planimetria.fallecidos~")    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"planimetria.serie~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"planimetria.base~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"planimetria.nro_contrato~" )WHERE(    EXP1 =~"(~~~"CADENA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'P'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'N'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'R')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"PLANIMETRIA~~~".~~~"FALLECIDOS~~~"~"   OP =~">~"    EXP2 =~"0~" ) ) " )
