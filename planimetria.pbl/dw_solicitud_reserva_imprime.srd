 column=(type=decimal(4) updatewhereclause=yes name=reserva_sepultura_capacidad dbname="reserva_sepultura.capacidad" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"inventario_plani~" )  TABLE(NAME=~"reserva_sepultura~" )  TABLE(NAME=~"agentes~" )  TABLE(NAME=~"estado_reserva~" )  TABLE(NAME=~"encargados~" )  TABLE(NAME=~"log_reserva_sepultura~" ) COLUMN(NAME=~"reserva_sepultura.cod_agente~") COLUMN(NAME=~"agentes.cod_age~") COLUMN(NAME=~"reserva_sepultura.folio_reserva~") COLUMN(NAME=~"reserva_sepultura.area~") COLUMN(NAME=~"reserva_sepultura.sector~") COLUMN(NAME=~"reserva_sepultura.sepultura~") COLUMN(NAME=~"reserva_sepultura.base~") COLUMN(NAME=~"reserva_sepultura.serie~") COLUMN(NAME=~"reserva_sepultura.numero~") COLUMN(NAME=~"reserva_sepultura.rut~") COLUMN(NAME=~"reserva_sepultura.nombre~") COLUMN(NAME=~"reserva_sepultura.a_paterno~") COLUMN(NAME=~"reserva_sepultura.a_materno~") COLUMN(NAME=~"reserva_sepultura.observacion~") COLUMN(NAME=~"reserva_sepultura.fecha~") COLUMN(NAME=~"agentes.nombre~") COLUMN(NAME=~"agentes.a_paterno~") COLUMN(NAME=~"agentes.a_materno~") COLUMN(NAME=~"estado_reserva.descripcion~") COMPUTE(NAME=~"''~") COLUMN(NAME=~"reserva_sepultura.fecha_promesa~") COLUMN(NAME=~"inventario_plani.numero_tec~") COLUMN(NAME=~"inventario_plani.cod_parque~") COLUMN(NAME=~"encargados.nombre~") COLUMN(NAME=~"reserva_sepultura.capacidad~")    JOIN (LEFT=~"reserva_sepultura.cod_agente~"    OP =~"=~"RIGHT=~"agentes.cod_age~"    OUTER1 =~"reserva_sepultura.cod_agente~" )    JOIN (LEFT=~"inventario_plani.sector~"    OP =~"=~"RIGHT=~"reserva_sepultura.sector~" )    JOIN (LEFT=~"inventario_plani.sepultura~"    OP =~"=~"RIGHT=~"reserva_sepultura.sepultura~" )    JOIN (LEFT=~"reserva_sepultura.estado~"    OP =~"=~"RIGHT=~"estado_reserva.codigo~" )    JOIN (LEFT=~"reserva_sepultura.area~"    OP =~"=~"RIGHT=~"log_reserva_sepultura.area~" )    JOIN (LEFT=~"reserva_sepultura.sector~"    OP =~"=~"RIGHT=~"log_reserva_sepultura.sector~" )    JOIN (LEFT=~"reserva_sepultura.sepultura~"    OP =~"=~"RIGHT=~"log_reserva_sepultura.sepultura~" )    JOIN (LEFT=~"reserva_sepultura.base~"    OP =~"=~"RIGHT=~"log_reserva_sepultura.base~" )    JOIN (LEFT=~"reserva_sepultura.serie~"    OP =~"=~"RIGHT=~"log_reserva_sepultura.serie~" )    JOIN (LEFT=~"reserva_sepultura.numero~"    OP =~"=~"RIGHT=~"log_reserva_sepultura.numero~" )    JOIN (LEFT=~"reserva_sepultura.cod_parque~"    OP =~"=~"RIGHT=~"log_reserva_sepultura.cod_parque~" )    JOIN (LEFT=~"log_reserva_sepultura.usuario_log~"    OP =~"=~"RIGHT=~"encargados.codigo_usuario~" )WHERE(    EXP1 =~"~~~"RESERVA_SEPULTURA~~~".~~~"FOLIO_RESERVA~~~"~"   OP =~"=~"    EXP2 =~":correlativo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"RESERVA_SEPULTURA~~~".~~~"SECTOR~~~"~"   OP =~"=~"    EXP2 =~":sector~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"RESERVA_SEPULTURA~~~".~~~"SEPULTURA~~~"~"   OP =~"=~"    EXP2 =~":sepultura~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INVENTARIO_PLANI~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"RESERVA_SEPULTURA~~~".~~~"FECHA~~~"~"   OP =~"=~" NEST = PBSELECT( VERSION(400) TABLE(NAME=~"reserva_sepultura~" ) COMPUTE(NAME=~"max(fecha)~")WHERE(    EXP1 =~"~~~"RESERVA_SEPULTURA~~~".~~~"FOLIO_RESERVA~~~"~"   OP =~"=~"    EXP2 =~":correlativo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"RESERVA_SEPULTURA~~~".~~~"SECTOR~~~"~"   OP =~"=~"    EXP2 =~":sector~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"RESERVA_SEPULTURA~~~".~~~"SEPULTURA~~~"~"   OP =~"=~"    EXP2 =~":sepultura~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"RESERVA_SEPULTURA~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~" ) )) ) ARG(NAME = ~"correlativo~" TYPE = number)  ARG(NAME = ~"sector~" TYPE = string)  ARG(NAME = ~"sepultura~" TYPE = string)  ARG(NAME = ~"parque~" TYPE = number) " arguments=(("correlativo", number),("sector", string),("sepultura", string),("parque", number)) )
