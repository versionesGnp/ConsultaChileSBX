 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"planimetria~" ) COLUMN(NAME=~"planimetria.parque~") COLUMN(NAME=~"planimetria.zona~") COLUMN(NAME=~"planimetria.sector~") COLUMN(NAME=~"planimetria.nro_sistema~") COLUMN(NAME=~"planimetria.sepultura~") COLUMN(NAME=~"planimetria.nro_tecnico~") COLUMN(NAME=~"planimetria.capacidad~") COLUMN(NAME=~"planimetria.tipo_construccion~") COLUMN(NAME=~"planimetria.estado_sepultura~") COLUMN(NAME=~"planimetria.base~") COLUMN(NAME=~"planimetria.serie~") COLUMN(NAME=~"planimetria.nro_contrato~") COLUMN(NAME=~"planimetria.ubs~") COLUMN(NAME=~"planimetria.xx~") COLUMN(NAME=~"planimetria.yy~") COMPUTE(NAME=~"''~") COMPUTE(NAME=~"1~")WHERE(    EXP1 =~"~~~"PLANIMETRIA~~~".~~~"SECTOR~~~"~"   OP =~"=~"    EXP2 =~":gs_sector~" ) ) ORDER(NAME=~"planimetria.nro_sistema~" ASC=yes ) ARG(NAME = ~"gs_sector~" TYPE = string) " arguments=(("gs_sector", string)) )
