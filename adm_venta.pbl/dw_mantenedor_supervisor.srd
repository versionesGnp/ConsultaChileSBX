 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"supervisor~" ) COMPUTE(NAME=~"'','',''~") COLUMN(NAME=~"supervisor.cod_sup~") COLUMN(NAME=~"supervisor.cod_jefe~") COLUMN(NAME=~"supervisor.nombre~") COLUMN(NAME=~"supervisor.a_paterno~") COLUMN(NAME=~"supervisor.a_materno~") COLUMN(NAME=~"supervisor.tipo~") COLUMN(NAME=~"supervisor.fecha_ing~") COLUMN(NAME=~"supervisor.fecha_fin~") COLUMN(NAME=~"supervisor.estado~") COLUMN(NAME=~"supervisor.rut~") COLUMN(NAME=~"supervisor.clasifica~") COLUMN(NAME=~"supervisor.canal~") COLUMN(NAME=~"supervisor.vsp~") COLUMN(NAME=~"supervisor.cod_parque~") COLUMN(NAME=~"supervisor.porc_supervisor~") COLUMN(NAME=~"supervisor.observacion~")WHERE(    EXP1 =~"~~~"SUPERVISOR~~~".~~~"COD_SUP~~~"~"   OP =~"=~"    EXP2 =~":codigo~" ) ) ARG(NAME = ~"codigo~" TYPE = string) " update="SUPERVISOR" updatewhere=0 updatekeyinplace=yes arguments=(("codigo", string)) )
