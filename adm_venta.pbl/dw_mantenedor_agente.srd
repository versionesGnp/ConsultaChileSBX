 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"agentes~" ) COLUMN(NAME=~"agentes.cod_age~") COLUMN(NAME=~"agentes.nombre~") COLUMN(NAME=~"agentes.a_paterno~") COLUMN(NAME=~"agentes.a_materno~") COLUMN(NAME=~"agentes.nro_de_cont~") COLUMN(NAME=~"agentes.fecha_ini~") COLUMN(NAME=~"agentes.fecha_fin~") COLUMN(NAME=~"agentes.estado~") COLUMN(NAME=~"agentes.cod_sup~") COLUMN(NAME=~"agentes.rut~") COLUMN(NAME=~"agentes.tipo_cont~") COLUMN(NAME=~"agentes.meta~") COLUMN(NAME=~"agentes.clasificacion~") COLUMN(NAME=~"agentes.vsp~") COLUMN(NAME=~"agentes.canal~") COMPUTE(NAME=~"'','',''~") COLUMN(NAME=~"agentes.cod_parque~") COLUMN(NAME=~"agentes.observacion~") COLUMN(NAME=~"agentes.depto~") COLUMN(NAME=~"agentes.clave~") COLUMN(NAME=~"agentes.correo~")WHERE(    EXP1 =~"~~~"AGENTES~~~".~~~"COD_AGE~~~"~"   OP =~"=~"    EXP2 =~":codigo~" ) ) ARG(NAME = ~"codigo~" TYPE = string) " update="AGENTES" updatewhere=0 updatekeyinplace=yes arguments=(("codigo", string)) )
