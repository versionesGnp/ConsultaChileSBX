table(column=(type=char(5) updatewhereclause=yes name=cod_age dbname="agentes.cod_age" )
 column=(type=char(20) updatewhereclause=yes name=nombre dbname="agentes.nombre" )
 column=(type=char(50) updatewhereclause=yes name=a_paterno dbname="agentes.a_paterno" )
 column=(type=char(50) updatewhereclause=yes name=a_materno dbname="agentes.a_materno" )
 column=(type=char(1) updatewhereclause=yes name=estado dbname="agentes.estado" values="Activo	A/Inactivo	I/" )
 column=(type=number updatewhereclause=yes name=marca dbname="marca" )
 column=(type=number updatewhereclause=yes name=modifica dbname="modifica" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"agentes~" ) COLUMN(NAME=~"agentes.cod_age~") COLUMN(NAME=~"agentes.nombre~") COLUMN(NAME=~"agentes.a_paterno~") COLUMN(NAME=~"agentes.a_materno~") COLUMN(NAME=~"agentes.estado~") COMPUTE(NAME=~"0 as marca~") COMPUTE(NAME=~"0 as modifica~")WHERE(    EXP1 =~"~~~"AGENTES~~~".~~~"COD_SUP~~~"~"   OP =~"=~"    EXP2 =~":cod_sup~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"AGENTES~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'A'~" ) ) ARG(NAME = ~"cod_sup~" TYPE = string) " arguments=(("cod_sup", string))  sort="cod_age A " )
