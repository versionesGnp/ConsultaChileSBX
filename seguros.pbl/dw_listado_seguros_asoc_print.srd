 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"seguro_asociados~" )  TABLE(NAME=~"tipo_seguro~" )  TABLE(NAME=~"vista_buscar_cttos_en_peso~" )  TABLE(NAME=~"cadena~" ) COLUMN(NAME=~"seguro_asociados.base~") COLUMN(NAME=~"seguro_asociados.serie~") COLUMN(NAME=~"seguro_asociados.numero~") COLUMN(NAME=~"seguro_asociados.cod_seguro~") COLUMN(NAME=~"seguro_asociados.fecha_crea~") COLUMN(NAME=~"seguro_asociados.monto_prima~") COLUMN(NAME=~"seguro_asociados.usuario~") COLUMN(NAME=~"seguro_asociados.estado_reg~") COLUMN(NAME=~"seguro_asociados.folio_seguro~") COLUMN(NAME=~"seguro_asociados.estado_seguro~") COLUMN(NAME=~"tipo_seguro.descripcion~") COLUMN(NAME=~"tipo_seguro.glosa~") COLUMN(NAME=~"vista_buscar_cttos_en_peso.valor_uf~") COLUMN(NAME=~"tipo_seguro.factor_peso~")    JOIN (LEFT=~"seguro_asociados.base~"    OP =~"=~"RIGHT=~"vista_buscar_cttos_en_peso.base~"    OUTER1 =~"seguro_asociados.base~" )    JOIN (LEFT=~"seguro_asociados.serie~"    OP =~"=~"RIGHT=~"vista_buscar_cttos_en_peso.serie~"    OUTER1 =~"seguro_asociados.serie~" )    JOIN (LEFT=~"seguro_asociados.numero~"    OP =~"=~"RIGHT=~"vista_buscar_cttos_en_peso.numero~"    OUTER1 =~"seguro_asociados.numero~" )    JOIN (LEFT=~"seguro_asociados.cod_seguro~"    OP =~"=~"RIGHT=~"tipo_seguro.codigo~" )    JOIN (LEFT=~"seguro_asociados.base~"    OP =~"=~"RIGHT=~"tipo_seguro.base~" )    JOIN (LEFT=~"seguro_asociados.base~"    OP =~"=~"RIGHT=~"cadena.codigo~" )    JOIN (LEFT=~"seguro_asociados.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"seguro_asociados.numero~"    OP =~"=~"RIGHT=~"cadena.numero~" )    JOIN (LEFT=~"cadena.cod_parque~"    OP =~"=~"RIGHT=~"tipo_seguro.cod_parque~" )WHERE(    EXP1 =~"~~~"SEGURO_ASOCIADOS~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SEGURO_ASOCIADOS~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SEGURO_ASOCIADOS~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SEGURO_ASOCIADOS~~~".~~~"ESTADO_REG~~~"~"   OP =~"=~"    EXP2 =~"0~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SEGURO_ASOCIADOS~~~".~~~"ESTADO_SEGURO~~~"~"   OP =~"=~"    EXP2 =~"'A'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"SEGURO_ASOCIADOS~~~".~~~"MONTO_PRIMA~~~"~"   OP =~">~"    EXP2 =~"0~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number) " arguments=(("base", string),("serie", string),("numero", number))  sort="cod_seguro A " )
