table(column=(type=char(1) updatewhereclause=yes name=base dbname="seguro_auxilio_solicitud.base" )
 column=(type=char(1) updatewhereclause=yes name=serie dbname="seguro_auxilio_solicitud.serie" )
 column=(type=decimal(4) updatewhereclause=yes name=numero dbname="seguro_auxilio_solicitud.numero" )
 column=(type=decimal(4) updatewhereclause=yes name=rut_titular dbname="seguro_auxilio_solicitud.rut_titular" )
 column=(type=decimal(4) updatewhereclause=yes name=porce_pagado dbname="seguro_auxilio_solicitud.porce_pagado" )
 column=(type=decimal(4) updatewhereclause=yes name=mora_cred dbname="seguro_auxilio_solicitud.mora_cred" )
 column=(type=decimal(4) updatewhereclause=yes name=mora_mant dbname="seguro_auxilio_solicitud.mora_mant" )
 column=(type=datetime updatewhereclause=yes name=fecha_crea dbname="seguro_auxilio_solicitud.fecha_crea" )
 column=(type=datetime updatewhereclause=yes name=fecha_proceso dbname="seguro_auxilio_solicitud.fecha_proceso" )
 column=(type=char(1) updatewhereclause=yes name=estado_solicitud dbname="seguro_auxilio_solicitud.estado_solicitud" values="P - Pendiente	P/G - Gestionado - con Solicitud	G/" )
 column=(type=char(2000) updatewhereclause=yes name=observacion dbname="seguro_auxilio_solicitud.observacion" )
 column=(type=char(15) updatewhereclause=yes name=oferta_v_cobrador_asig_ult dbname="oferta_v.cobrador_asig_ult" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"seguro_auxilio_solicitud~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"oferta_v~" )  TABLE(NAME=~"pago_oferta~" ) COLUMN(NAME=~"seguro_auxilio_solicitud.base~") COLUMN(NAME=~"seguro_auxilio_solicitud.serie~") COLUMN(NAME=~"seguro_auxilio_solicitud.numero~") COLUMN(NAME=~"seguro_auxilio_solicitud.rut_titular~") COLUMN(NAME=~"seguro_auxilio_solicitud.porce_pagado~") COLUMN(NAME=~"seguro_auxilio_solicitud.mora_cred~") COLUMN(NAME=~"seguro_auxilio_solicitud.mora_mant~") COLUMN(NAME=~"seguro_auxilio_solicitud.fecha_crea~") COLUMN(NAME=~"seguro_auxilio_solicitud.fecha_proceso~") COLUMN(NAME=~"seguro_auxilio_solicitud.estado_solicitud~") COLUMN(NAME=~"seguro_auxilio_solicitud.observacion~") COLUMN(NAME=~"oferta_v.cobrador_asig_ult~")    JOIN (LEFT=~"seguro_auxilio_solicitud.base~"    OP =~"=~"RIGHT=~"cadena.codigo~" )    JOIN (LEFT=~"seguro_auxilio_solicitud.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"seguro_auxilio_solicitud.numero~"    OP =~"=~"RIGHT=~"cadena.numero~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"oferta_v.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"oferta_v.nro_oferta~" )    JOIN (LEFT=~"oferta_v.serie~"    OP =~"=~"RIGHT=~"pago_oferta.serie~" )    JOIN (LEFT=~"oferta_v.nro_oferta~"    OP =~"=~"RIGHT=~"pago_oferta.nro_oferta~" )    JOIN (LEFT=~"oferta_v.ult_folio~"    OP =~"=~"RIGHT=~"pago_oferta.folio~" )WHERE(    EXP1 =~"~~~"SEGURO_AUXILIO_SOLICITUD~~~".~~~"ESTADO_SOLICITUD~~~"~"   OP =~"=~"    EXP2 =~"'P'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"OFERTA_V~~~".~~~"COBRADOR_ASIG_ULT~~~"~"   OP =~"=~"    EXP2 =~":usuario~" ) ) ARG(NAME = ~"usuario~" TYPE = string) " arguments=(("usuario", string)) )
