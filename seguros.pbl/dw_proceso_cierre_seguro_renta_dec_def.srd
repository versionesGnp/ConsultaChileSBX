on~" )    JOIN (LEFT=~"seguro_renta_dec_def.base~"    OP =~"=~"RIGHT=~"seguro_proceso.base~" )    JOIN (LEFT=~"seguro_renta_dec_def.serie~"    OP =~"=~"RIGHT=~"seguro_proceso.serie~" )    JOIN (LEFT=~"seguro_renta_dec_def.numero~"    OP =~"=~"RIGHT=~"seguro_proceso.numero~" )    JOIN (LEFT=~"seguro_renta_dec_def.cod_parque~"    OP =~"=~"RIGHT=~"seguro_proceso.cod_parque~" )    JOIN (LEFT=~"seguro_proceso.tipo_seguro~"    OP =~"=~"RIGHT=~"tipo_seguro.codigo~" )WHERE(    EXP1 =~"~~~"SEGURO_RENTA_DEC_DEF~~~".~~~"FECHA_CIERRE~~~"~"   OP =~"=~"    EXP2 =~":fecha_proc~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SEGURO_RENTA_DEC_DEF~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"SEGURO_PROCESO~~~".~~~"TIPO_SEGURO~~~"~"   OP =~"=~"    EXP2 =~"1~" ) ) ARG(NAME = ~"fecha_proc~" TYPE = datetime)  ARG(NAME = ~"parque~" TYPE = number) " arguments=(("fecha_proc", datetime),("parque", number))  sort="nro_operacion A " )
