 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"tipo_seguro~" ) COLUMN(NAME=~"tipo_seguro.codigo~") COLUMN(NAME=~"tipo_seguro.descripcion~") COLUMN(NAME=~"tipo_seguro.factor_prima~") COLUMN(NAME=~"tipo_seguro.factor~") COLUMN(NAME=~"tipo_seguro.cantidad_beneficiario~") COLUMN(NAME=~"tipo_seguro.factor_peso~") COLUMN(NAME=~"tipo_seguro.folio_inicial~") COLUMN(NAME=~"tipo_seguro.fecha_duracion_vigencia~") COLUMN(NAME=~"tipo_seguro.uf_seguro~") COMPUTE(NAME=~"0~") COMPUTE(NAME=~"0 as edad~") COLUMN(NAME=~"tipo_seguro.glosa~")WHERE(    EXP1 =~"~~~"TIPO_SEGURO~~~".~~~"FACTOR_PRIMA~~~"~"   OP =~">=~"    EXP2 =~"0~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"TIPO_SEGURO~~~".~~~"FECHA_DURACION_VIGENCIA~~~"~"   OP =~">=~"    EXP2 =~"sysdate~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"TIPO_SEGURO~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"TIPO_SEGURO~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~" ) ) ARG(NAME = ~"parque~" TYPE = number)  ARG(NAME = ~"base~" TYPE = string) " arguments=(("parque", number),("base", string))  sort="factor_prima D codigo A " )
