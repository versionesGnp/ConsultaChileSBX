 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"presupuesto_consulta~" )  TABLE(NAME=~"presupuesto_permisos~" ) COLUMN(NAME=~"presupuesto_consulta.anno~") COLUMN(NAME=~"presupuesto_consulta.mes~") COLUMN(NAME=~"presupuesto_consulta.cod_emp~") COLUMN(NAME=~"presupuesto_consulta.cod_cuenta~") COLUMN(NAME=~"presupuesto_consulta.grupo~") COLUMN(NAME=~"presupuesto_consulta.lugar~") COLUMN(NAME=~"presupuesto_consulta.ppto_mes~") COLUMN(NAME=~"presupuesto_consulta.real_mes~") COLUMN(NAME=~"presupuesto_consulta.difer_valor~") COLUMN(NAME=~"presupuesto_consulta.difer_porce~") COLUMN(NAME=~"presupuesto_consulta.unidad~") COLUMN(NAME=~"presupuesto_consulta.codigo_grupo~")    JOIN (LEFT=~"presupuesto_consulta.codigo_grupo~"    OP =~"=~"RIGHT=~"presupuesto_permisos.cod_grupo~" )    JOIN (LEFT=~"presupuesto_consulta.grupo~"    OP =~"=~"RIGHT=~"presupuesto_permisos.grupo~" )    JOIN (LEFT=~"presupuesto_consulta.cod_parque~"    OP =~"=~"RIGHT=~"presupuesto_permisos.cod_parque~" )WHERE(    EXP1 =~"~~~"PRESUPUESTO_CONSULTA~~~".~~~"COD_EMP~~~"~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"PRESUPUESTO_CONSULTA~~~".~~~"ANNO~~~"~"   OP =~"=~"    EXP2 =~":anno~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"PRESUPUESTO_CONSULTA~~~".~~~"MES~~~"~"   OP =~"=~"    EXP2 =~":mes~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"PRESUPUESTO_PERMISOS~~~".~~~"COD_USUARIO~~~"~"   OP =~"=~"    EXP2 =~":usuario~" ) ) ARG(NAME = ~"empresa~" TYPE = string)  ARG(NAME = ~"anno~" TYPE = number)  ARG(NAME = ~"mes~" TYPE = number)  ARG(NAME = ~"usuario~" TYPE = string) " arguments=(("empresa", string),("anno", number),("mes", number),("usuario", string))  sort="codigo_grupo A cod_cuenta A " )
