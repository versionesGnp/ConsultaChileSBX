 column=(type=number updatewhereclause=yes name=dv_prgdettot_mto_debito dbname="dv_prgdettot.mto_debito" )
 column=(type=number updatewhereclause=yes name=dv_prgdettot_mto_credto dbname="dv_prgdettot.mto_credto" )
 column=(type=decimal(4) updatewhereclause=yes name=presupuesto_consulta_cod_parque dbname="presupuesto_consulta.cod_parque" )
 column=(type=number updatewhereclause=yes name=ppto_x_mes dbname="ppto_x_mes" )
 column=(type=number updatewhereclause=yes name=sum_cod_grupo dbname="sum_cod_grupo" )
 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"presupuesto_consulta~" )  TABLE(NAME=~"dv_prgdettot~" )  TABLE(NAME=~"con_pln_cuenta~" ) COLUMN(NAME=~"presupuesto_consulta.lugar~") COLUMN(NAME=~"presupuesto_consulta.codigo_grupo~") COLUMN(NAME=~"presupuesto_consulta.grupo~") COLUMN(NAME=~"con_pln_cuenta.gls_cuenta~") COLUMN(NAME=~"dv_prgdettot.gls_linea~") COLUMN(NAME=~"presupuesto_consulta.anno~") COLUMN(NAME=~"presupuesto_consulta.mes~") COLUMN(NAME=~"presupuesto_consulta.cod_emp~") COLUMN(NAME=~"presupuesto_consulta.real_mes~") COLUMN(NAME=~"dv_prgdettot.mto_debito~") COLUMN(NAME=~"dv_prgdettot.mto_credto~") COLUMN(NAME=~"presupuesto_consulta.cod_parque~") COMPUTE(NAME=~"0 as PPTO_X_MES~") COMPUTE(NAME=~"0 as SUM_COD_GRUPO~")    JOIN (LEFT=~"presupuesto_consulta.cod_emp~"    OP =~"=~"RIGHT=~"dv_prgdettot.cod_empres~" )    JOIN (LEFT=~"presupuesto_consulta.anno~"    OP =~"=~"RIGHT=~"dv_prgdettot.num_periodo~" )    JOIN (LEFT=~"presupuesto_consulta.cod_cuenta~"    OP =~"=~"RIGHT=~"dv_prgdettot.cod_cta_presup~" )    JOIN (LEFT=~"dv_prgdettot.cod_empres~"    OP =~"=~"RIGHT=~"con_pln_cuenta.cod_empres~" )    JOIN (LEFT=~"dv_prgdettot.cod_cuenta~"    OP =~"=~"RIGHT=~"con_pln_cuenta.cod_cuenta~" )    JOIN (LEFT=~"dv_prgdettot.num_periodo~"    OP =~"=~"RIGHT=~"con_pln_cuenta.num_periodo~" )    JOIN (LEFT=~"presupuesto_consulta.cod_mes~"    OP =~"=~"RIGHT=~"dv_prgdettot.cod_mes~" )WHERE(    EXP1 =~"~~~"DV_PRGDETTOT~~~".~~~"COD_EMPRES~~~"~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"DV_PRGDETTOT~~~".~~~"NUM_PERIODO~~~"~"   OP =~"=~"    EXP2 =~":anno~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"DV_PRGDETTOT~~~".~~~"COD_MES~~~"~"   OP =~"=~"    EXP2 =~":mes~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"PRESUPUESTO_CONSULTA~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":cod_parque~" ) ) ORDER(NAME=~"presupuesto_consulta.lugar~" ASC=yes )  ORDER(NAME=~"presupuesto_consulta.codigo_grupo~" ASC=yes )  ORDER(NAME=~"presupuesto_consulta.grupo~" ASC=yes )  ORDER(NAME=~"con_pln_cuenta.gls_cuenta~" ASC=yes )  ORDER(NAME=~"dv_prgdettot.gls_linea~" ASC=yes ) ARG(NAME = ~"empresa~" TYPE = string)  ARG(NAME = ~"anno~" TYPE = number)  ARG(NAME = ~"mes~" TYPE = string)  ARG(NAME = ~"cod_parque~" TYPE = number) " arguments=(("empresa", string),("anno", number),("mes", string),("cod_parque", number))  sort="lugar A codigo_grupo A grupo A con_pln_cuenta_gls_cuenta A dv_prgdettot_gls_linea A " )
