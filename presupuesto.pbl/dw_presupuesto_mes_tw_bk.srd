table(column=(type=decimal(4) updatewhereclause=yes name=lugar dbname="presupuesto_consulta.lugar" )
 column=(type=decimal(4) updatewhereclause=yes name=codigo_grupo dbname="presupuesto_consulta.codigo_grupo" )
 column=(type=char(1000) updatewhereclause=yes name=grupo dbname="presupuesto_consulta.grupo" )
 column=(type=char(30) updatewhereclause=yes name=con_pln_cuenta_gls_cuenta dbname="con_pln_cuenta.gls_cuenta" )
 column=(type=char(30) updatewhereclause=yes name=dv_prgdettot_gls_linea dbname="dv_prgdettot.gls_linea" )
 column=(type=decimal(4) updatewhereclause=yes name=anno dbname="presupuesto_consulta.anno" )
 column=(type=decimal(4) updatewhereclause=yes name=mes dbname="presupuesto_consulta.mes" )
 column=(type=char(10) updatewhereclause=yes name=cod_emp dbname="presupuesto_consulta.cod_emp" )
