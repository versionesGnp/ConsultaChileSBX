 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"presupuesto_consulta~" )  TABLE(NAME=~"con_pln_cuenta~" )  TABLE(NAME=~"dv_prgdettot~" )  TABLE(NAME=~"presupuesto_totales~" )  TABLE(NAME=~"presupuesto_total_final~" ) COLUMN(NAME=~"presupuesto_consulta.anno~") COLUMN(NAME=~"presupuesto_consulta.mes~") COLUMN(NAME=~"presupuesto_consulta.cod_emp~") COLUMN(NAME=~"presupuesto_consulta.cod_cuenta~") COLUMN(NAME=~"presupuesto_consulta.grupo~") COLUMN(NAME=~"presupuesto_consulta.ppto_mes~") COLUMN(NAME=~"presupuesto_consulta.real_mes~") COLUMN(NAME=~"presupuesto_consulta.difer_valor~") COLUMN(NAME=~"presupuesto_consulta.difer_porce~") COLUMN(NAME=~"presupuesto_consulta.codigo_grupo~") COLUMN(NAME=~"con_pln_cuenta.cod_cuenta~") COLUMN(NAME=~"con_pln_cuenta.gls_cuenta~") COLUMN(NAME=~"dv_prgdettot.mto_debito~") COLUMN(NAME=~"dv_prgdettot.mto_credto~") COLUMN(NAME=~"dv_prgdettot.cod_ccosto~") COLUMN(NAME=~"dv_prgdettot.num_comprb~") COLUMN(NAME=~"dv_prgdettot.num_lin_comprb~") COLUMN(NAME=~"dv_prgdettot.gls_linea~") COLUMN(NAME=~"presupuesto_totales.suma_ppto_mes~") COLUMN(NAME=~"presupuesto_totales.suma_real_mes~") COLUMN(NAME=~"presupuesto_total_final.suma_total_ppto_mes~") COLUMN(NAME=~"presupuesto_total_final.suma_total_real_mes~")    JOIN (LEFT=~"con_pln_cuenta.cod_empres~"    OP =~"=~"RIGHT=~"dv_prgdettot.cod_empres~" )    JOIN (LEFT=~"con_pln_cuenta.num_periodo~"    OP =~"=~"RIGHT=~"dv_prgdettot.num_periodo~" )    JOIN (LEFT=~"con_pln_cuenta.cod_cuenta~"    OP =~"=~"RIGHT=~"dv_prgdettot.cod_cuenta~" )    JOIN (LEFT=~"dv_prgdettot.cod_empres~"    OP =~"=~"RIGHT=~"presupuesto_consulta.cod_emp~" )    JOIN (LEFT=~"dv_prgdettot.num_periodo~"    OP =~"=~"RIGHT=~"presupuesto_consulta.anno~" )    JOIN (LEFT=~"dv_prgdettot.cod_cta_presup~"    OP =~"=~"RIGHT=~"presupuesto_consulta.cod_cuenta~" )    JOIN (LEFT=~"presupuesto_totales.anno~"    OP =~"=~"RIGHT=~"presupuesto_consulta.anno~" )    JOIN (LEFT=~"presupuesto_totales.mes~"    OP =~"=~"RIGHT=~"presupuesto_consulta.mes~" )    JOIN (LEFT=~"presupuesto_totales.cod_emp~"    OP =~"=~"RIGHT=~"presupuesto_consulta.cod_emp~" )    JOIN (LEFT=~"presupuesto_consulta.codigo_grupo~"    OP =~"=~"RIGHT=~"presupuesto_totales.codigo_grupo~" )    JOIN (LEFT=~"presupuesto_total_final.anno~"    OP =~"=~"RIGHT=~"presupuesto_consulta.anno~" )    JOIN (LEFT=~"presupuesto_total_final.mes~"    OP =~"=~"RIGHT=~"presupuesto_consulta.mes~" )    JOIN (LEFT=~"presupuesto_total_final.cod_emp~"    OP =~"=~"RIGHT=~"presupuesto_consulta.cod_emp~" )WHERE(    EXP1 =~"~~~"PRESUPUESTO_CONSULTA~~~".~~~"COD_EMP~~~"~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"PRESUPUESTO_CONSULTA~~~".~~~"ANNO~~~"~"   OP =~"=~"    EXP2 =~":anno~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"PRESUPUESTO_CONSULTA~~~".~~~"MES~~~"~"   OP =~"=~"    EXP2 =~":mes~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"DV_PRGDETTOT~~~".~~~"COD_MES~~~"~"   OP =~"=~"    EXP2 =~":cod_mes~" ) ) ARG(NAME = ~"empresa~" TYPE = string)  ARG(NAME = ~"anno~" TYPE = number)  ARG(NAME = ~"mes~" TYPE = number)  ARG(NAME = ~"cod_mes~" TYPE = string) " arguments=(("empresa", string),("anno", number),("mes", number),("cod_mes", string))  sort="codigo_grupo A cod_cuenta A dv_prgdettot_cod_ccosto A con_pln_cuenta_gls_cuenta A dv_prgdettot_num_comprb A dv_prgdettot_num_lin_comprb A " )
