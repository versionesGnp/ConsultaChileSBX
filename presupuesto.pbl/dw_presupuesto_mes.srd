 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"presupuesto_consulta~" ) COLUMN(NAME=~"presupuesto_consulta.anno~") COLUMN(NAME=~"presupuesto_consulta.mes~") COLUMN(NAME=~"presupuesto_consulta.cod_emp~") COLUMN(NAME=~"presupuesto_consulta.cod_cuenta~") COLUMN(NAME=~"presupuesto_consulta.grupo~") COLUMN(NAME=~"presupuesto_consulta.lugar~") COLUMN(NAME=~"presupuesto_consulta.ppto_mes~") COLUMN(NAME=~"presupuesto_consulta.real_mes~") COLUMN(NAME=~"presupuesto_consulta.difer_valor~") COLUMN(NAME=~"presupuesto_consulta.difer_porce~") COLUMN(NAME=~"presupuesto_consulta.unidad~") COLUMN(NAME=~"presupuesto_consulta.codigo_grupo~") COMPUTE(NAME=~"0~")WHERE(    EXP1 =~"~~~"PRESUPUESTO_CONSULTA~~~".~~~"COD_EMP~~~"~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"PRESUPUESTO_CONSULTA~~~".~~~"ANNO~~~"~"   OP =~"=~"    EXP2 =~":anno~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"PRESUPUESTO_CONSULTA~~~".~~~"MES~~~"~"   OP =~"=~"    EXP2 =~":mes~" ) ) ARG(NAME = ~"empresa~" TYPE = string)  ARG(NAME = ~"anno~" TYPE = number)  ARG(NAME = ~"mes~" TYPE = number) " arguments=(("empresa", string),("anno", number),("mes", number))  sort="codigo_grupo A cod_cuenta A " )
