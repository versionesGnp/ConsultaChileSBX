 retrieve="  SELECT ~"MENSAJES~".~"RUT~",   
         ~"MENSAJES~".~"FECHA_CREACION~",   
         ~"MENSAJES~".~"FECHA_FIN~",   
         ~"MENSAJES~".~"AUTOR~",   
         ~"MENSAJES~".~"ESTADO~",   
         ~"MENSAJES~".~"USUARIO_FIN~",   
         ~"MENSAJES~".~"BASE~",   
         ~"MENSAJES~".~"SERIE~",   
         ~"MENSAJES~".~"NUMERO~",   
         ~"MENSAJES~".~"CLASIFICACION_MENSAJE~",   
         ~"MENSAJES~".~"SW_MENSAJE~",   
         ~"CADENA~".~"CODIGO~",   
         ~"CADENA~".~"SERIE~",   
         ~"CADENA~".~"NUMERO~",   
         ~"CLIENTE~".~"NOMBRE~",   
         ~"CLIENTE~".~"A_PATERNO~",   
         ~"CLIENTE~".~"A_MATERNO~",   
         ~"MENSAJES~".~"CORRELATIVO~",   
         ~"MENSAJES~".~"FECHA_GESTION~",   
         ~"MENSAJES~".~"ESTADO_GESTION~",   
         '',   
         '',   
         ~"MENSAJES~".~"MENSAJE~"  ,
         ~"MENSAJES~".~"APLICA_A~",   
         ~"MENSAJES~".~"DESCUENTO~"
    FROM ~"MENSAJES~",   
         ~"CADENA~",   
         ~"CLIENTE~"  
   WHERE ( ~"MENSAJES~".~"RUT~" = ~"CADENA~".~"RUT~" ) and  
         ( ~"CADENA~".~"RUT~" = ~"CLIENTE~".~"RUT~" ) and  
         ( ( ~"MENSAJES~".~"CORRELATIVO~" = :corre ) )    
" update="MENSAJES" updatewhere=0 updatekeyinplace=yes arguments=(("corre", number)) )
