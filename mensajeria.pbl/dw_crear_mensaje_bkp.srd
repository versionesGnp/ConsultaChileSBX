 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"mensajes~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"cliente~" ) COLUMN(NAME=~"mensajes.rut~") COLUMN(NAME=~"mensajes.fecha_creacion~") COLUMN(NAME=~"mensajes.fecha_fin~") COLUMN(NAME=~"mensajes.autor~") COLUMN(NAME=~"mensajes.mensaje~") COLUMN(NAME=~"mensajes.estado~") COLUMN(NAME=~"mensajes.usuario_fin~") COLUMN(NAME=~"mensajes.base~") COLUMN(NAME=~"mensajes.serie~") COLUMN(NAME=~"mensajes.numero~") COLUMN(NAME=~"mensajes.clasificacion_mensaje~") COLUMN(NAME=~"mensajes.sw_mensaje~") COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"cadena.serie~") COLUMN(NAME=~"cadena.numero~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"mensajes.correlativo~") COLUMN(NAME=~"mensajes.fecha_gestion~") COLUMN(NAME=~"mensajes.estado_gestion~") COMPUTE(NAME=~"''~") COMPUTE(NAME=~"''~")    JOIN (LEFT=~"mensajes.base~"    OP =~"=~"RIGHT=~"cadena.codigo~"    OUTER2 =~"cadena.codigo~" )    JOIN (LEFT=~"mensajes.serie~"    OP =~"=~"RIGHT=~"cadena.serie~"    OUTER2 =~"cadena.serie~" )    JOIN (LEFT=~"mensajes.numero~"    OP =~"=~"RIGHT=~"cadena.numero~"    OUTER2 =~"cadena.numero~" )    JOIN (LEFT=~"mensajes.rut~"    OP =~"=~"RIGHT=~"cadena.rut~" )    JOIN (LEFT=~"cadena.rut~"    OP =~"=~"RIGHT=~"cliente.rut~" )WHERE(    EXP1 =~"~~~"MENSAJES~~~".~~~"CORRELATIVO~~~"~"   OP =~"=~"    EXP2 =~":corre~" ) ) ARG(NAME = ~"corre~" TYPE = number) " update="MENSAJES" updatewhere=0 updatekeyinplace=no arguments=(("corre", number)) )
