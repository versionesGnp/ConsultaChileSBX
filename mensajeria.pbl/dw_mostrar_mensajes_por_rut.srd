 column=(type=decimal(2) updatewhereclause=yes name=descuento dbname="mensajes.descuento" )
 retrieve="  SELECT ~"MENSAJES~".~"USUARIO_FIN~",   
         ~"MENSAJES~".~"ESTADO_GESTION~",   
         ~"MENSAJES~".~"FECHA_GESTION~",   
         ~"MENSAJES~".~"MENSAJE~",   
         ~"MENSAJES~".~"RUT~",   
         ~"MENSAJES~".~"FECHA_CREACION~",   
         ~"MENSAJES~".~"FECHA_FIN~",   
         ~"MENSAJES~".~"AUTOR~",   
         ~"MENSAJES~".~"ESTADO~",   
         ~"MENSAJES~".~"BASE~",   
         ~"MENSAJES~".~"SERIE~",   
         ~"MENSAJES~".~"NUMERO~",   
         ~"MENSAJES~".~"CLASIFICACION_MENSAJE~",   
         ~"MENSAJES~".~"SW_MENSAJE~",   
         ~"MENSAJES~".~"CORRELATIVO~"  ,   
         ~"MENSAJES~".~"APLICA_A~"  ,   
         ~"MENSAJES~".~"DESCUENTO~"  
    FROM ~"MENSAJES~"  
   WHERE ( ~"MENSAJES~".~"RUT~" = :rut ) AND  
         ( ~"MENSAJES~".~"ESTADO_GESTION~" = 'A' ) AND  
         ( sysdate <= ~"MENSAJES~".~"FECHA_FIN~" )    
" update="MENSAJES" updatewhere=0 updatekeyinplace=yes arguments=(("rut", number))  sort="fecha_creacion D " )
