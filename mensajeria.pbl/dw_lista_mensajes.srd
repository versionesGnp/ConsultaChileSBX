table(column=(type=decimal(4) update=yes updatewhereclause=yes key=yes name=rut dbname="mensajes.rut" )
 column=(type=datetime update=yes updatewhereclause=yes key=yes name=fecha_creacion dbname="mensajes.fecha_creacion" )
 column=(type=datetime update=yes updatewhereclause=yes name=fecha_fin dbname="mensajes.fecha_fin" )
 column=(type=char(15) update=yes updatewhereclause=yes name=autor dbname="mensajes.autor" )
 column=(type=char(1) update=yes updatewhereclause=yes name=estado dbname="mensajes.estado" )
 column=(type=char(15) update=yes updatewhereclause=yes name=usuario_fin dbname="mensajes.usuario_fin" )
