 column=(type=decimal(2) updatewhereclause=yes name=descuento dbname="mensajes.descuento" )
 retrieve="  SELECT ~"MENSAJES~".~"RUT~",   
         ~"MENSAJES~".~"FECHA_CREACION~",   
         ~"MENSAJES~".~"FECHA_FIN~",   
         ~"MENSAJES~".~"AUTOR~",   
         ~"MENSAJES~".~"ESTADO~",   
         ~"MENSAJES~".~"USUARIO_FIN~",   
         ~"MENSAJES~".~"BASE~",   
         ~"MENSAJES~".~"SERIE~",   
         ~"MENSAJES~".~"NUMERO~",   
         ~"MENSAJES~".~"CLASIFICACION_MENSAJE~",   
         ~"MENSAJES~".~"SW_MENSAJE~",   
         ~"MENSAJES~".~"CORRELATIVO~",   
         ~"MENSAJES~".~"FECHA_GESTION~",   
         ~"MENSAJES~".~"ESTADO_GESTION~",   
         ~"MENSAJES~".~"MENSAJE~"     ,
         ~"MENSAJES~".~"APLICA_A~"     ,
         ~"MENSAJES~".~"DESCUENTO~"  
    FROM ~"MENSAJES~"  
   WHERE ( ~"MENSAJES~".~"FECHA_CREACION~" >= :fecha_ini ) AND  
         ( ~"MENSAJES~".~"FECHA_CREACION~" <= :fecha_fin )    
" update="MENSAJES" updatewhere=1 updatekeyinplace=no arguments=(("fecha_ini", datetime),("fecha_fin", datetime))  sort="fecha_creacion D " )
