 column=(type=decimal(4) updatewhereclause=yes name=clasificacion_mensaje dbname="mensajes.clasificacion_mensaje" )
 column=(type=char(1) update=yes updatewhereclause=yes name=sw_mensaje dbname="mensajes.sw_mensaje" )
 column=(type=decimal(4) update=yes updatewhereclause=yes key=yes name=correlativo dbname="mensajes.correlativo" )
 column=(type=datetime update=yes updatewhereclause=yes name=fecha_gestion dbname="mensajes.fecha_gestion" )
 column=(type=char(1) update=yes updatewhereclause=yes name=estado_gestion dbname="mensajes.estado_gestion" )
