 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ficha_sepultacion~" ) COLUMN(NAME=~"ficha_sepultacion.fecha_sepultacion~") COLUMN(NAME=~"ficha_sepultacion.rut_fallecido~") COLUMN(NAME=~"ficha_sepultacion.dv_fallecido~") COLUMN(NAME=~"ficha_sepultacion.nombre_fallecido~") COLUMN(NAME=~"ficha_sepultacion.ap_paterno_fall~") COLUMN(NAME=~"ficha_sepultacion.ap_materno_fall~") COLUMN(NAME=~"ficha_sepultacion.cod_parque~") COLUMN(NAME=~"ficha_sepultacion.sector~") COLUMN(NAME=~"ficha_sepultacion.sepultura~") COLUMN(NAME=~"ficha_sepultacion.base~") COLUMN(NAME=~"ficha_sepultacion.serie~") COLUMN(NAME=~"ficha_sepultacion.numero~") COLUMN(NAME=~"ficha_sepultacion.rut_titular~") COLUMN(NAME=~"ficha_sepultacion.dv_titular~") COLUMN(NAME=~"ficha_sepultacion.nombre_titular~") COLUMN(NAME=~"ficha_sepultacion.ap_paterno_titular~") COLUMN(NAME=~"ficha_sepultacion.ap_materno_titular~") COLUMN(NAME=~"ficha_sepultacion.hora~") COLUMN(NAME=~"ficha_sepultacion.minutos~") COLUMN(NAME=~"ficha_sepultacion.fecha_defuncion~")WHERE(    EXP1 =~"~~~"FICHA_SEPULTACION~~~".~~~"FECHA_SEPULTACION~~~"~"   OP =~"=~"    EXP2 =~":fecha_sep~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FICHA_SEPULTACION~~~".~~~"SECTOR~~~"~"   OP =~"=~"    EXP2 =~":sector~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FICHA_SEPULTACION~~~".~~~"SEPULTURA~~~"~"   OP =~"=~"    EXP2 =~":sepultura~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FICHA_SEPULTACION~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FICHA_SEPULTACION~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FICHA_SEPULTACION~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~" ) ) ARG(NAME = ~"fecha_sep~" TYPE = datetime)  ARG(NAME = ~"sector~" TYPE = string)  ARG(NAME = ~"sepultura~" TYPE = string)  ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number) " arguments=(("fecha_sep", datetime),("sector", string),("sepultura", string),("base", string),("serie", string),("numero", number))  sort="nombre_fallecido A ap_paterno_fall A ap_materno_fall A " )
