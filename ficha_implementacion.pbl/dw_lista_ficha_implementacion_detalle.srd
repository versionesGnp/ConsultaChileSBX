 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ficha_implementacion~" )  TABLE(NAME=~"ficha_implementacion_asistente~" )  TABLE(NAME=~"encargados~" )  TABLE(NAME=~"cod_parq~" )  TABLE(NAME=~"ficha_implementacion_estado~" ) COLUMN(NAME=~"ficha_implementacion.fecha_ingreso~") COLUMN(NAME=~"ficha_implementacion.folio~") COLUMN(NAME=~"ficha_implementacion.codigo_maestro~") COLUMN(NAME=~"encargados.nombre~") COLUMN(NAME=~"ficha_implementacion.fecha_inspeccion~") COLUMN(NAME=~"ficha_implementacion.hora_inspeccion~") COLUMN(NAME=~"ficha_implementacion.cod_parque~") COLUMN(NAME=~"cod_parq.nombre~") COLUMN(NAME=~"ficha_implementacion.area~") COLUMN(NAME=~"ficha_implementacion.sector~") COLUMN(NAME=~"ficha_implementacion.sepultura~") COLUMN(NAME=~"ficha_implementacion.rut_fallecido~") COLUMN(NAME=~"ficha_implementacion.nombre_fallecido~") COLUMN(NAME=~"ficha_implementacion.ap_paterno_fallecido~") COLUMN(NAME=~"ficha_implementacion.ap_materno_fallecido~") COLUMN(NAME=~"ficha_implementacion.cod_asistente_1~") COLUMN(NAME=~"ficha_implementacion_asistente.nombre_asistente~") COLUMN(NAME=~"ficha_implementacion.cod_asistente_2~") COLUMN(NAME=~"ficha_implementacion.estado_reg~") COLUMN(NAME=~"ficha_implementacion_estado.descripcion~") COLUMN(NAME=~"ficha_implementacion.tipo_ficha_sepultacion~") COLUMN(NAME=~"ficha_implementacion.folio_ficha_sepultacion~") COLUMN(NAME=~"ficha_implementacion.fecha_ficha_sepultacion~") COLUMN(NAME=~"ficha_implementacion.folio_condolencia~") COLUMN(NAME=~"ficha_implementacion.folio_encuesta~") COLUMN(NAME=~"ficha_implementacion.base~") COLUMN(NAME=~"ficha_implementacion.serie~") COLUMN(NAME=~"ficha_implementacion.numero~") COLUMN(NAME=~"ficha_implementacion.rut_titular~") COLUMN(NAME=~"ficha_implementacion.usuario_crea~") COLUMN(NAME=~"ficha_implementacion.hora_inspec~") COLUMN(NAME=~"ficha_implementacion.minutos_inspec~") COLUMN(NAME=~"ficha_implementacion.fecha_gestionado~")    JOIN (LEFT=~"ficha_implementacion.codigo_maestro~"    OP =~"=~"RIGHT=~"encargados.codigo_usuario~"    OUTER1 =~"ficha_implementacion.codigo_maestro~" )    JOIN (LEFT=~"ficha_implementacion.cod_asistente_1~"    OP =~"=~"RIGHT=~"ficha_implementacion_asistente.codigo_asistente~"    OUTER1 =~"ficha_implementacion.cod_asistente_1~" )    JOIN (LEFT=~"ficha_implementacion.cod_parque~"    OP =~"=~"RIGHT=~"cod_parq.codigo~"    OUTER1 =~"ficha_implementacion.cod_parque~" )    JOIN (LEFT=~"ficha_implementacion.estado_reg~"    OP =~"=~"RIGHT=~"ficha_implementacion_estado.estado_reg~" )WHERE(    EXP1 =~"~~~"FICHA_IMPLEMENTACION~~~".~~~"FECHA_INGRESO~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FICHA_IMPLEMENTACION~~~".~~~"FECHA_INGRESO~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = date)  ARG(NAME = ~"fecha_fin~" TYPE = date) " arguments=(("fecha_ini", date),("fecha_fin", date)) )
