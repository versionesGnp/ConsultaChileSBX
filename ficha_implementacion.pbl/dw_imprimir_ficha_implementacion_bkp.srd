 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ficha_implementacion~" )  TABLE(NAME=~"ficha_implementacion_detalle~" )  TABLE(NAME=~"ficha_implementacion_version~" )  TABLE(NAME=~"ficha_implementacion_grupo~" )  TABLE(NAME=~"ficha_implementacion_item~" )  TABLE(NAME=~"ficha_implementacion_gestion~" ) COLUMN(NAME=~"ficha_implementacion.folio~") COLUMN(NAME=~"ficha_implementacion.codigo_maestro~") COLUMN(NAME=~"ficha_implementacion.fecha_inspeccion~") COLUMN(NAME=~"ficha_implementacion.hora_inspeccion~") COLUMN(NAME=~"ficha_implementacion.cod_parque~") COLUMN(NAME=~"ficha_implementacion.area~") COLUMN(NAME=~"ficha_implementacion.sector~") COLUMN(NAME=~"ficha_implementacion.sepultura~") COLUMN(NAME=~"ficha_implementacion.nombre_fallecido~") COLUMN(NAME=~"ficha_implementacion.ap_paterno_fallecido~") COLUMN(NAME=~"ficha_implementacion.ap_materno_fallecido~") COLUMN(NAME=~"ficha_implementacion.cod_asistente_1~") COLUMN(NAME=~"ficha_implementacion.cod_asistente_2~") COLUMN(NAME=~"ficha_implementacion.fecha_ingreso~") COLUMN(NAME=~"ficha_implementacion.estado_reg~") COLUMN(NAME=~"ficha_implementacion.fecha_sistema~") COLUMN(NAME=~"ficha_implementacion.tipo_ficha_sepultacion~") COLUMN(NAME=~"ficha_implementacion.folio_ficha_sepultacion~") COLUMN(NAME=~"ficha_implementacion.fecha_ficha_sepultacion~") COLUMN(NAME=~"ficha_implementacion.folio_condolencia~") COLUMN(NAME=~"ficha_implementacion.folio_encuesta~") COLUMN(NAME=~"ficha_implementacion.rut_fallecido~") COLUMN(NAME=~"ficha_implementacion.base~") COLUMN(NAME=~"ficha_implementacion.serie~") COLUMN(NAME=~"ficha_implementacion.numero~") COLUMN(NAME=~"ficha_implementacion.rut_titular~") COLUMN(NAME=~"ficha_implementacion.usuario_crea~") COLUMN(NAME=~"ficha_implementacion.hora_inspec~") COLUMN(NAME=~"ficha_implementacion.minutos_inspec~") COLUMN(NAME=~"ficha_implementacion_detalle.codigo_grupo~") COLUMN(NAME=~"ficha_implementacion_detalle.codigo_item~") COLUMN(NAME=~"ficha_implementacion_detalle.codigo_gestion~") COLUMN(NAME=~"ficha_implementacion_detalle.observacion~") COLUMN(NAME=~"ficha_implementacion_detalle.fecha_modifica~") COLUMN(NAME=~"ficha_implementacion_detalle.usuario_modifica~") COLUMN(NAME=~"ficha_implementacion_version.codigo~") COLUMN(NAME=~"ficha_implementacion_version.version~") COLUMN(NAME=~"ficha_implementacion_version.fecha~") COLUMN(NAME=~"ficha_implementacion_grupo.descripcion~") COLUMN(NAME=~"ficha_implementacion_item.descripcion~") COLUMN(NAME=~"ficha_implementacion_item.estandar_condiciones~") COLUMN(NAME=~"ficha_implementacion_item.reaccion_solucion~") COLUMN(NAME=~"ficha_implementacion_item.como~") COLUMN(NAME=~"ficha_implementacion_item.imagen_como~") COLUMN(NAME=~"ficha_implementacion_gestion.descripcion~") COLUMN(NAME=~"ficha_implementacion_grupo.orden_grupo~") COLUMN(NAME=~"ficha_implementacion_item.orden_item~") COLUMN(NAME=~"ficha_implementacion_item.orden_grupo~")    JOIN (LEFT=~"ficha_implementacion.folio~"    OP =~"=~"RIGHT=~"ficha_implementacion_detalle.folio~" )    JOIN (LEFT=~"ficha_implementacion_detalle.codigo_grupo~"    OP =~"=~"RIGHT=~"ficha_implementacion_grupo.codigo_grupo~" )    JOIN (LEFT=~"ficha_implementacion_detalle.codigo_grupo~"    OP =~"=~"RIGHT=~"ficha_implementacion_item.codigo_grupo~" )    JOIN (LEFT=~"ficha_implementacion_detalle.codigo_item~"    OP =~"=~"RIGHT=~"ficha_implementacion_item.codigo_item~" )    JOIN (LEFT=~"ficha_implementacion_detalle.codigo_gestion~"    OP =~"=~"RIGHT=~"ficha_implementacion_gestion.codigo_gestion~" )    JOIN (LEFT=~"ficha_implementacion.cod_parque~"    OP =~"=~"RIGHT=~"ficha_implementacion_item.cod_parque~" )WHERE(    EXP1 =~"~~~"FICHA_IMPLEMENTACION~~~".~~~"FOLIO~~~"~"   OP =~"=~"    EXP2 =~":folio~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FICHA_IMPLEMENTACION_VERSION~~~".~~~"ESTADO_REG~~~"~"   OP =~"=~"    EXP2 =~"'V'~" ) ) ARG(NAME = ~"folio~" TYPE = number) " arguments=(("folio", number))  sort="ficha_implementacion_item_orden_grupo A ficha_implementacion_item_orden_item A " )
