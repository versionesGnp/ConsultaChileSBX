 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ficha_implementacion~" )  TABLE(NAME=~"ficha_sepultacion~" ) COLUMN(NAME=~"ficha_implementacion.folio~") COLUMN(NAME=~"ficha_implementacion.codigo_maestro~") COLUMN(NAME=~"ficha_implementacion.fecha_inspeccion~") COLUMN(NAME=~"ficha_implementacion.hora_inspeccion~") COLUMN(NAME=~"ficha_implementacion.cod_parque~") COLUMN(NAME=~"ficha_implementacion.area~") COLUMN(NAME=~"ficha_implementacion.sector~") COLUMN(NAME=~"ficha_implementacion.sepultura~") COLUMN(NAME=~"ficha_implementacion.nombre_fallecido~") COLUMN(NAME=~"ficha_implementacion.ap_paterno_fallecido~") COLUMN(NAME=~"ficha_implementacion.ap_materno_fallecido~") COLUMN(NAME=~"ficha_implementacion.cod_asistente_1~") COLUMN(NAME=~"ficha_implementacion.cod_asistente_2~") COLUMN(NAME=~"ficha_implementacion.fecha_ingreso~") COLUMN(NAME=~"ficha_implementacion.estado_reg~") COLUMN(NAME=~"ficha_implementacion.tipo_ficha_sepultacion~") COLUMN(NAME=~"ficha_implementacion.folio_ficha_sepultacion~") COLUMN(NAME=~"ficha_implementacion.fecha_ficha_sepultacion~") COLUMN(NAME=~"ficha_implementacion.folio_condolencia~") COLUMN(NAME=~"ficha_implementacion.rut_fallecido~") COLUMN(NAME=~"ficha_implementacion.base~") COLUMN(NAME=~"ficha_implementacion.serie~") COLUMN(NAME=~"ficha_implementacion.numero~") COLUMN(NAME=~"ficha_implementacion.rut_titular~") COLUMN(NAME=~"ficha_implementacion.fecha_sistema~") COMPUTE(NAME=~"'' as sw_nuevo~") COLUMN(NAME=~"ficha_implementacion.usuario_crea~") COLUMN(NAME=~"ficha_implementacion.folio_encuesta~") COLUMN(NAME=~"ficha_implementacion.hora_inspec~") COLUMN(NAME=~"ficha_implementacion.minutos_inspec~") COMPUTE(NAME=~"'' as sw_editar~") COLUMN(NAME=~"ficha_sepultacion.sw_condolencia~")    JOIN (LEFT=~"ficha_implementacion.folio_ficha_sepultacion~"    OP =~"=~"RIGHT=~"ficha_sepultacion.correlativo_ficha~" )    JOIN (LEFT=~"ficha_implementacion.cod_parque~"    OP =~"=~"RIGHT=~"ficha_sepultacion.cod_parque~" )WHERE(    EXP1 =~"~~~"FICHA_IMPLEMENTACION~~~".~~~"FOLIO~~~"~"   OP =~"=~"    EXP2 =~":folio~" ) ) ARG(NAME = ~"folio~" TYPE = number) " update="FICHA_IMPLEMENTACION" updatewhere=0 updatekeyinplace=yes arguments=(("folio", number)) )
