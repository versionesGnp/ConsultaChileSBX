 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ficha_implementacion_detalle~" ) COLUMN(NAME=~"ficha_implementacion_detalle.folio~") COLUMN(NAME=~"ficha_implementacion_detalle.codigo_item~") COLUMN(NAME=~"ficha_implementacion_detalle.codigo_gestion~") COLUMN(NAME=~"ficha_implementacion_detalle.observacion~") COLUMN(NAME=~"ficha_implementacion_detalle.fecha_modifica~") COLUMN(NAME=~"ficha_implementacion_detalle.usuario_modifica~") COLUMN(NAME=~"ficha_implementacion_detalle.codigo_grupo~") COMPUTE(NAME=~"'' as sw_nuevo~")WHERE(    EXP1 =~"~~~"FICHA_IMPLEMENTACION_DETALLE~~~".~~~"FOLIO~~~"~"   OP =~"=~"    EXP2 =~":folio~" ) ) ARG(NAME = ~"folio~" TYPE = number) " update="FICHA_IMPLEMENTACION_DETALLE" updatewhere=0 updatekeyinplace=yes arguments=(("folio", number))  sort="codigo_grupo A " )
