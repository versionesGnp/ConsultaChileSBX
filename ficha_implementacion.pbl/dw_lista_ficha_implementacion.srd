 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ficha_implementacion~" )  TABLE(NAME=~"encargados~" )  TABLE(NAME=~"ficha_implementacion_asistente~" ) COLUMN(NAME=~"ficha_implementacion.folio~") COLUMN(NAME=~"ficha_implementacion.codigo_maestro~") COLUMN(NAME=~"encargados.nombre~") COLUMN(NAME=~"ficha_implementacion.fecha_inspeccion~") COLUMN(NAME=~"ficha_implementacion.cod_parque~") COLUMN(NAME=~"ficha_implementacion.area~") COLUMN(NAME=~"ficha_implementacion.sector~") COLUMN(NAME=~"ficha_implementacion.sepultura~") COLUMN(NAME=~"ficha_implementacion.nombre_fallecido~") COLUMN(NAME=~"ficha_implementacion.ap_paterno_fallecido~") COLUMN(NAME=~"ficha_implementacion.ap_materno_fallecido~") COLUMN(NAME=~"ficha_implementacion.cod_asistente_1~") COLUMN(NAME=~"ficha_implementacion_asistente.nombre_asistente~") COLUMN(NAME=~"ficha_implementacion.cod_asistente_2~") COMPUTE(NAME=~"'' as nombre_asistente_2~") COLUMN(NAME=~"ficha_implementacion.fecha_ingreso~") COLUMN(NAME=~"ficha_implementacion.estado_reg~") COLUMN(NAME=~"ficha_implementacion.fecha_sistema~") COLUMN(NAME=~"ficha_implementacion.tipo_ficha_sepultacion~") COLUMN(NAME=~"ficha_implementacion.folio_ficha_sepultacion~") COLUMN(NAME=~"ficha_implementacion.fecha_ficha_sepultacion~") COLUMN(NAME=~"ficha_implementacion.folio_condolencia~") COLUMN(NAME=~"ficha_implementacion.rut_fallecido~") COLUMN(NAME=~"ficha_implementacion.base~") COLUMN(NAME=~"ficha_implementacion.serie~") COLUMN(NAME=~"ficha_implementacion.numero~") COLUMN(NAME=~"ficha_implementacion.rut_titular~") COLUMN(NAME=~"ficha_implementacion.folio_encuesta~") COLUMN(NAME=~"ficha_implementacion.hora_inspec~") COLUMN(NAME=~"ficha_implementacion.minutos_inspec~") COLUMN(NAME=~"ficha_implementacion.fecha_gestionado~") COLUMN(NAME=~"ficha_implementacion.usuario_crea~")    JOIN (LEFT=~"ficha_implementacion.codigo_maestro~"    OP =~"=~"RIGHT=~"encargados.codigo_usuario~"    OUTER1 =~"ficha_implementacion.codigo_maestro~" )    JOIN (LEFT=~"ficha_implementacion.cod_asistente_1~"    OP =~"=~"RIGHT=~"ficha_implementacion_asistente.codigo_asistente~"    OUTER1 =~"ficha_implementacion.cod_asistente_1~" )WHERE(    EXP1 =~"~~~"FICHA_IMPLEMENTACION~~~".~~~"FECHA_INGRESO~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FICHA_IMPLEMENTACION~~~".~~~"FECHA_INGRESO~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FICHA_IMPLEMENTACION~~~".~~~"CODIGO_MAESTRO~~~"~"   OP =~"like~"    EXP2 =~":usuario~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = datetime)  ARG(NAME = ~"fecha_fin~" TYPE = datetime)  ARG(NAME = ~"usuario~" TYPE = string) " arguments=(("fecha_ini", datetime),("fecha_fin", datetime),("usuario", string))  sort="folio A " )
