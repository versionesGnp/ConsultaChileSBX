 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"licencias~" ) COLUMN(NAME=~"licencias.nro_licencia~") COLUMN(NAME=~"licencias.fecha_crea~") COLUMN(NAME=~"licencias.rut_empleado~") COLUMN(NAME=~"licencias.grupo~") COLUMN(NAME=~"licencias.nombre_empleado~") COLUMN(NAME=~"licencias.a_paterno_empleado~") COLUMN(NAME=~"licencias.a_materno_empleado~") COLUMN(NAME=~"licencias.codigo_empleado~") COLUMN(NAME=~"licencias.codigo_enfermedad~") COLUMN(NAME=~"licencias.glosa_enfermedad~") COLUMN(NAME=~"licencias.nro_dias~") COLUMN(NAME=~"licencias.fecha_inicio_licencia~") COLUMN(NAME=~"licencias.fecha_fin_licencia~") COLUMN(NAME=~"licencias.indicador_licencia~") COLUMN(NAME=~"licencias.codigo_supervisor~") COLUMN(NAME=~"licencias.codigo_jefe~") COLUMN(NAME=~"licencias.rut_medico~") COLUMN(NAME=~"licencias.nombre_medico~") COLUMN(NAME=~"licencias.a_paterno_medico~") COLUMN(NAME=~"licencias.a_materno_medico~") COLUMN(NAME=~"licencias.dv_medico~")WHERE(    EXP1 =~"((~~~"LICENCIAS~~~".~~~"FECHA_INICIO_LICENCIA~~~"~"   OP =~">=~"    EXP2 =~":fec_ini~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"LICENCIAS~~~".~~~"FECHA_INICIO_LICENCIA~~~"~"   OP =~"<=~"    EXP2 =~":fec_fin)~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"(~~~"LICENCIAS~~~".~~~"FECHA_FIN_LICENCIA~~~"~"   OP =~">=~"    EXP2 =~":fec_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"LICENCIAS~~~".~~~"FECHA_FIN_LICENCIA~~~"~"   OP =~"<=~"    EXP2 =~":fec_fin))~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"LICENCIAS~~~".~~~"NRO_DIAS~~~"~"   OP =~">=~"    EXP2 =~":nro_dias_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"LICENCIAS~~~".~~~"NRO_DIAS~~~"~"   OP =~"<=~"    EXP2 =~":nro_dias_fin)~" ) ) ARG(NAME = ~"nro_dias_ini~" TYPE = number)  ARG(NAME = ~"nro_dias_fin~" TYPE = number)  ARG(NAME = ~"fec_ini~" TYPE = date)  ARG(NAME = ~"fec_fin~" TYPE = date) " update="LICENCIAS" updatewhere=1 updatekeyinplace=no arguments=(("nro_dias_ini", number),("nro_dias_fin", number),("fec_ini", date),("fec_fin", date))  sort="grupo A codigo_empleado A fecha_inicio_licencia D " )
