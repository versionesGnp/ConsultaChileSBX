 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"licencias~" ) COLUMN(NAME=~"licencias.nro_licencia~") COLUMN(NAME=~"licencias.fecha_crea~") COLUMN(NAME=~"licencias.rut_empleado~") COLUMN(NAME=~"licencias.grupo~") COLUMN(NAME=~"licencias.nombre_empleado~") COLUMN(NAME=~"licencias.a_paterno_empleado~") COLUMN(NAME=~"licencias.a_materno_empleado~") COLUMN(NAME=~"licencias.codigo_empleado~") COLUMN(NAME=~"licencias.codigo_enfermedad~") COLUMN(NAME=~"licencias.glosa_enfermedad~") COLUMN(NAME=~"licencias.nro_dias~") COLUMN(NAME=~"licencias.fecha_inicio_licencia~") COLUMN(NAME=~"licencias.fecha_fin_licencia~") COLUMN(NAME=~"licencias.indicador_licencia~") COLUMN(NAME=~"licencias.codigo_supervisor~") COLUMN(NAME=~"licencias.codigo_jefe~") COLUMN(NAME=~"licencias.rut_medico~") COLUMN(NAME=~"licencias.nombre_medico~") COLUMN(NAME=~"licencias.a_paterno_medico~") COLUMN(NAME=~"licencias.a_materno_medico~") COLUMN(NAME=~"licencias.dv_medico~") COMPUTE(NAME=~"0,0,0~")WHERE(    EXP1 =~"~~~"LICENCIAS~~~".~~~"NRO_LICENCIA~~~"~"   OP =~"=~"    EXP2 =~":licencia~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"LICENCIAS~~~".~~~"RUT_EMPLEADO~~~"~"   OP =~"=~"    EXP2 =~":rut~" ) ) ARG(NAME = ~"licencia~" TYPE = string)  ARG(NAME = ~"rut~" TYPE = number) " update="LICENCIAS" updatewhere=0 updatekeyinplace=yes arguments=(("licencia", string),("rut", number)) )
