 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"jefe_ventas~" )  TABLE(NAME=~"supervisor~" ) COLUMN(NAME=~"supervisor.cod_sup~") COLUMN(NAME=~"supervisor.cod_jefe~") COLUMN(NAME=~"supervisor.nombre~") COLUMN(NAME=~"supervisor.a_paterno~") COLUMN(NAME=~"supervisor.a_materno~") COLUMN(NAME=~"supervisor.fecha_ing~") COLUMN(NAME=~"supervisor.fecha_fin~") COLUMN(NAME=~"supervisor.estado~") COLUMN(NAME=~"supervisor.rut~") COLUMN(NAME=~"supervisor.clasifica~") COLUMN(NAME=~"supervisor.canal~") COLUMN(NAME=~"supervisor.vsp~") COLUMN(NAME=~"supervisor.cod_parque~")    JOIN (LEFT=~"supervisor.cod_jefe~"    OP =~"=~"RIGHT=~"jefe_ventas.jefe_ventas~" )WHERE(    EXP1 =~"~~~"SUPERVISOR~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":ll_parque~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SUPERVISOR~~~".~~~"COD_JEFE~~~"~"   OP =~"=~"    EXP2 =~":ls_jefe~" ) ) ARG(NAME = ~"ll_parque~" TYPE = number)  ARG(NAME = ~"ls_jefe~" TYPE = string) " arguments=(("ll_parque", number),("ls_jefe", string))  sort="supervisor_estado A supervisor_cod_sup A supervisor_fecha_fin D " )
