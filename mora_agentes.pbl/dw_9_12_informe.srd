 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"factura_oferta~" ) COLUMN(NAME=~"factura_oferta.fecha_cierre~") COLUMN(NAME=~"factura_oferta.cod_parque~")WHERE(    EXP1 =~"~~~"FACTURA_OFERTA~~~".~~~"FECHA_CIERRE~~~"~"   OP =~"=~"    EXP2 =~":fecha~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FACTURA_OFERTA~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~" ) ) ARG(NAME = ~"fecha~" TYPE = datetime)  ARG(NAME = ~"parque~" TYPE = number) " arguments=(("fecha", datetime),("parque", number)) )
