 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"oferta_v~" )  TABLE(NAME=~"pago_oferta~" )  TABLE(NAME=~"agentes~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"supervisor~" )  TABLE(NAME=~"tab_uf~" ) COLUMN(NAME=~"oferta_v.serie~") COLUMN(NAME=~"oferta_v.nro_oferta~") COLUMN(NAME=~"oferta_v.fecha~") COLUMN(NAME=~"oferta_v.tot_pagado~") COLUMN(NAME=~"pago_oferta.moneda~") COLUMN(NAME=~"pago_oferta.precio~") COLUMN(NAME=~"agentes.cod_sup~") COLUMN(NAME=~"agentes.fecha_ini~") COLUMN(NAME=~"oferta_v.fecha_ingreso~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"oferta_v.estado_comi~") COLUMN(NAME=~"pago_oferta.fecha_prim~") COLUMN(NAME=~"pago_oferta.nro_cuotas~") COLUMN(NAME=~"oferta_v.cta_pag_s~") COLUMN(NAME=~"pago_oferta.pie~") COLUMN(NAME=~"oferta_v.fecha_com~") COLUMN(NAME=~"pago_oferta.valor_cuota~") COLUMN(NAME=~"oferta_v.porce_venta~") COLUMN(NAME=~"agentes.estado~") COLUMN(NAME=~"oferta_v.cierre_venta_semanal~") COLUMN(NAME=~"oferta_v.cod_age~") COLUMN(NAME=~"cadena.cod_parque~") COLUMN(NAME=~"supervisor.cod_jefe~") COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"tab_uf.valor_uf~") COLUMN(NAME=~"oferta_v.porce_ing_cierre~") COLUMN(NAME=~"cadena.rut~") COLUMN(NAME=~"oferta_v.clasifica_venta~") COLUMN(NAME=~"agentes.cod_parque~") COMPUTE(NAME=~"''~") COMPUTE(NAME=~"0~") COLUMN(NAME=~"agentes.meta~") COMPUTE(NAME=~"''~")    JOIN (LEFT=~"oferta_v.serie~"    OP =~"=~"RIGHT=~"pago_oferta.serie~" )    JOIN (LEFT=~"oferta_v.nro_oferta~"    OP =~"=~"RIGHT=~"pago_oferta.nro_oferta~" )    JOIN (LEFT=~"oferta_v.ult_folio~"    OP =~"=~"RIGHT=~"pago_oferta.folio~" )    JOIN (LEFT=~"oferta_v.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"oferta_v.nro_oferta~"    OP =~"=~"RIGHT=~"cadena.numero~" )    JOIN (LEFT=~"oferta_v.cod_age~"    OP =~"=~"RIGHT=~"agentes.cod_age~" )    JOIN (LEFT=~"agentes.cod_sup~"    OP =~"=~"RIGHT=~"supervisor.cod_sup~" )    JOIN (LEFT=~"oferta_v.cierre_venta~"    OP =~"=~"RIGHT=~"tab_uf.fecha_uf~" )WHERE(    EXP1 =~"~~~"OFERTA_V~~~".~~~"CIERRE_VENTA~~~"~"   OP =~"=~"    EXP2 =~":fecha~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"OFERTA_V~~~".~~~"COD_AGE~~~"~"   OP =~"=~"    EXP2 =~":codigo~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'O'~" ) )    UNION (PBSELECT( VERSION(400) TABLE(NAME=~"anexo_liberador~" )  TABLE(NAME=~"pago_liberador~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"agentes~" )  TABLE(NAME=~"supervisor~" )  TABLE(NAME=~"tab_uf~" ) COLUMN(NAME=~"anexo_liberador.serie_m~") COLUMN(NAME=~"anexo_liberador.nro_liberador~") COLUMN(NAME=~"pago_liberador.fecha~") COLUMN(NAME=~"anexo_liberador.tot_pagado~") COLUMN(NAME=~"pago_liberador.moneda~") COLUMN(NAME=~"pago_liberador.precio~") COLUMN(NAME=~"agentes.cod_sup~") COLUMN(NAME=~"agentes.fecha_ini~") COLUMN(NAME=~"anexo_liberador.fecha_ingreso~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"anexo_liberador.estado_comi~") COLUMN(NAME=~"pago_liberador.fecha_prim~") COLUMN(NAME=~"pago_liberador.nro_cuotas~") COLUMN(NAME=~"anexo_liberador.cta_pag_m~") COLUMN(NAME=~"pago_liberador.pie~") COLUMN(NAME=~"anexo_liberador.fecha_com~") COLUMN(NAME=~"pago_liberador.valor_cuota~") COLUMN(NAME=~"anexo_liberador.porce_age~") COLUMN(NAME=~"agentes.estado~") COLUMN(NAME=~"anexo_liberador.cierre_venta_semanal~") COLUMN(NAME=~"anexo_liberador.cod_agente~") COLUMN(NAME=~"cadena.cod_parque~") COLUMN(NAME=~"supervisor.cod_jefe~") COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"tab_uf.valor_uf~") COLUMN(NAME=~"anexo_liberador.porce_ing_cierre~") COLUMN(NAME=~"cadena.rut~") COLUMN(NAME=~"anexo_liberador.clasifica_venta~") COLUMN(NAME=~"agentes.cod_parque~") COMPUTE(NAME=~"''~") COMPUTE(NAME=~"0~") COLUMN(NAME=~"agentes.meta~") COMPUTE(NAME=~"''~")    JOIN (LEFT=~"anexo_liberador.serie_m~"    OP =~"=~"RIGHT=~"pago_liberador.serie_m~" )    JOIN (LEFT=~"anexo_liberador.nro_liberador~"    OP =~"=~"RIGHT=~"pago_liberador.nro_liberador~" )    JOIN (LEFT=~"anexo_liberador.ult_folio~"    OP =~"=~"RIGHT=~"pago_liberador.folio~" )    JOIN (LE