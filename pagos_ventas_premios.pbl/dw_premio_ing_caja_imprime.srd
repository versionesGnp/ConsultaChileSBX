 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"promesa_premio~" )  TABLE(NAME=~"oferta_v~" )  TABLE(NAME=~"agentes~" )  TABLE(NAME=~"pago_oferta~" )  TABLE(NAME=~"premios_por_caja~" )  TABLE(NAME=~"cierre_pagos_ventas~" ) COLUMN(NAME=~"promesa_premio.base~") COLUMN(NAME=~"promesa_premio.serie~") COLUMN(NAME=~"promesa_premio.numero~") COLUMN(NAME=~"promesa_premio.forma~") COLUMN(NAME=~"promesa_premio.uso~") COLUMN(NAME=~"promesa_premio.fecha~") COLUMN(NAME=~"promesa_premio.monto~") COLUMN(NAME=~"promesa_premio.porcentaje~") COLUMN(NAME=~"agentes.cod_age~") COLUMN(NAME=~"agentes.nombre~") COLUMN(NAME=~"agentes.a_paterno~") COLUMN(NAME=~"agentes.a_materno~") COLUMN(NAME=~"agentes.rut~") COLUMN(NAME=~"pago_oferta.capacidad~") COMPUTE(NAME=~"''~") COLUMN(NAME=~"promesa_premio.parque~") COLUMN(NAME=~"promesa_premio.cod_premio~") COLUMN(NAME=~"premios_por_caja.descripcion~") COLUMN(NAME=~"cierre_pagos_ventas.fecha_inicio~")    JOIN (LEFT=~"promesa_premio.serie~"    OP =~"=~"RIGHT=~"oferta_v.serie~" )    JOIN (LEFT=~"promesa_premio.numero~"    OP =~"=~"RIGHT=~"oferta_v.nro_oferta~" )    JOIN (LEFT=~"oferta_v.serie~"    OP =~"=~"RIGHT=~"pago_oferta.serie~" )    JOIN (LEFT=~"oferta_v.nro_oferta~"    OP =~"=~"RIGHT=~"pago_oferta.nro_oferta~" )    JOIN (LEFT=~"oferta_v.ult_folio~"    OP =~"=~"RIGHT=~"pago_oferta.folio~" )    JOIN (LEFT=~"oferta_v.cod_age~"    OP =~"=~"RIGHT=~"agentes.cod_age~" )    JOIN (LEFT=~"oferta_v.uso~"    OP =~"=~"RIGHT=~"premios_por_caja.uso~" )    JOIN (LEFT=~"promesa_premio.cod_premio~"    OP =~"=~"RIGHT=~"premios_por_caja.codigo~" )    JOIN (LEFT=~"promesa_premio.parque~"    OP =~"=~"RIGHT=~"premios_por_caja.parque~" )    JOIN (LEFT=~"promesa_premio.fecha~"    OP =~"=~"RIGHT=~"cierre_pagos_ventas.fecha_termino~" )WHERE(    EXP1 =~"~~~"PROMESA_PREMIO~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~"'O'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"PROMESA_PREMIO~~~".~~~"FECHA~~~"~"   OP =~"=~"    EXP2 =~":fecha~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"PROMESA_PREMIO~~~".~~~"PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CIERRE_PAGOS_VENTAS~~~".~~~"TIPO_PREMIO~~~"~"   OP =~"=~"    EXP2 =~"3~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CIERRE_PAGOS_VENTAS~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~" ) )    UNION (PBSELECT( VERSION(400) TABLE(NAME=~"promesa_premio~" )  TABLE(NAME=~"anexo_aumento~" )  TABLE(NAME=~"pago_aumento~" )  TABLE(NAME=~"agentes~" )  TABLE(NAME=~"premios_por_caja~" )  TABLE(NAME=~"cierre_pagos_ventas~" ) COLUMN(NAME=~"promesa_premio.base~") COLUMN(NAME=~"promesa_premio.serie~") COLUMN(NAME=~"promesa_premio.numero~") COLUMN(NAME=~"promesa_premio.forma~") COLUMN(NAME=~"promesa_premio.uso~") COLUMN(NAME=~"promesa_premio.fecha~") COLUMN(NAME=~"promesa_premio.monto~") COLUMN(NAME=~"promesa_premio.porcentaje~") COLUMN(NAME=~"agentes.cod_age~") COLUMN(NAME=~"agentes.nombre~") COLUMN(NAME=~"agentes.a_paterno~") COLUMN(NAME=~"agentes.a_materno~") COLUMN(NAME=~"agentes.rut~") COLUMN(NAME=~"pago_aumento.capacidad~") COMPUTE(NAME=~"''~") COLUMN(NAME=~"promesa_premio.parque~") COLUMN(NAME=~"promesa_premio.cod_premio~") COLUMN(NAME=~"premios_por_caja.descripcion~") COLUMN(NAME=~"cierre_pagos_ventas.fecha_inicio~")    JOIN (LEFT=~"promesa_premio.serie~"    OP =~"=~"RIGHT=~"anexo_aumento.serie_m~" )    JOIN (LEFT=~"promesa_premio.numero~"    OP =~"=~"RIGHT=~"anexo_aumento.nro_aumento~" )    JOIN (LEFT=~"anexo_aumento.serie_m~"    OP =~"=~"RIGHT=~"pago_aumento.serie_m~" )    JOIN (LEFT=~"anexo_aumento.nro_aumento~"    OP =~"=~"RIGHT=~"pago_aumento.nro_aumento~" )    JOIN (LEFT=~"anexo_aumento.ult_folio~"    OP =~"=~"RIGHT=~"pago_aumento.folio~" )    JOIN (LEFT=~"anexo_aumento.cod_agente~"    OP =~"=~"RIGHT=~"agentes.cod_age~" )    JOIN (LEFT=~"anexo_aumento.uso~"    OP =~"=~"RIGHT=~"premios_por_caja.uso~" )    JOIN (LEFT=~"promesa_premio.cod_premio~"    OP =~"=~"RIGHT=~"premios_por_caja.codigo~" )    JOIN (LEFT=~"promesa_premio.parque~"    OP =~"=~"RIGHT=~"premios_por_caja.parque~" )    JOIN (LEFT=~"promesa_premio.fecha~"    OP =~"=~"RIGHT=~"cierre_pagos_ventas.fecha_termino~" )WHERE(    EXP1 =~"~~~"PROMESA_PREMIO~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~"'A'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"PROMESA_PREMIO~~~".~~~"FECHA~~~"~"   OP =~"=~"    EXP2 =~":fecha~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"PROMESA_PREMIO~~~".~~~"PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CIERRE_PAGOS_VENTAS~~~".~~~"TIPO_PREMIO~~~"~"   OP =~"=~"    EXP2 =~"3~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CIERRE_PAGOS_VENTAS~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~" ) )) ORDER(NAME=~"9~" ASC=yes ) ARG(NAME = ~"fecha~" TYPE = datetime)  ARG(NAME = ~"parque~" TYPE = number) " arguments=(("fecha", datetime),("parque", number))  sort="premios_por_caja_descripcion A " )
