 column=(type=datetime update=yes updatewhereclause=yes name=oferta_v_u_fecha dbname="oferta_v.u_fecha" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cadena~" )  TABLE(NAME=~"oferta_v~" ) COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"oferta_v.serie~") COLUMN(NAME=~"oferta_v.nro_oferta~") COLUMN(NAME=~"oferta_v.ult_folio~") COLUMN(NAME=~"oferta_v.u_folio~") COLUMN(NAME=~"oferta_v.u_fecha~")    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"oferta_v.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"oferta_v.nro_oferta~" )WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~" ) )    UNION (PBSELECT( VERSION(400) TABLE(NAME=~"cadena~" )  TABLE(NAME=~"anexo_liberador~" ) COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"anexo_liberador.serie_m~") COLUMN(NAME=~"anexo_liberador.nro_liberador~") COLUMN(NAME=~"anexo_liberador.ult_folio~") COLUMN(NAME=~"anexo_liberador.u_folio~") COLUMN(NAME=~"anexo_liberador.u_fecha~")    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"anexo_liberador.serie_m~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"anexo_liberador.nro_liberador~" )WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~" ) ))    UNION (PBSELECT( VERSION(400) TABLE(NAME=~"cadena~" )  TABLE(NAME=~"anexo_aumento~" ) COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"anexo_aumento.serie_m~") COLUMN(NAME=~"anexo_aumento.nro_aumento~") COLUMN(NAME=~"anexo_aumento.ult_folio~") COLUMN(NAME=~"anexo_aumento.u_folio~") COLUMN(NAME=~"anexo_aumento.u_fecha~")    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"anexo_aumento.serie_m~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"anexo_aumento.nro_aumento~" )WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~" ) )) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number) " update="OFERTA_V" updatewhere=0 updatekeyinplace=yes arguments=(("base", string),("serie", string),("numero", number)) )
