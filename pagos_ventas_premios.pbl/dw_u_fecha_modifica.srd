table(column=(type=char(1) updatewhereclause=yes name=cadena_codigo dbname="cadena.codigo" )
 column=(type=char(1) updatewhereclause=yes key=yes name=oferta_v_serie dbname="oferta_v.serie" )
 column=(type=decimal(4) updatewhereclause=yes key=yes name=oferta_v_nro_oferta dbname="oferta_v.nro_oferta" )
