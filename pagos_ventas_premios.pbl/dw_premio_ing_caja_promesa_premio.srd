AME=~"promesa_premio.forma~") COLUMN(NAME=~"promesa_premio.uso~") COLUMN(NAME=~"promesa_premio.fecha~") COLUMN(NAME=~"promesa_premio.monto~") COLUMN(NAME=~"promesa_premio.porcentaje~") COLUMN(NAME=~"promesa_premio.cod_premio~") COLUMN(NAME=~"promesa_premio.fecha_proceso~") COLUMN(NAME=~"promesa_premio.parque~") COLUMN(NAME=~"pago_aumento.capacidad~") COLUMN(NAME=~"anexo_aumento.cod_agente~") COLUMN(NAME=~"agentes.estado~") COMPUTE(NAME=~"''~") COMPUTE(NAME=~"0~") COLUMN(NAME=~"pago_aumento.moneda~") COMPUTE(NAME=~"0~") COMPUTE(NAME=~"0~") COLUMN(NAME=~"pago_aumento.precio~") COLUMN(NAME=~"anexo_aumento.rut~") COLUMN(NAME=~"anexo_aumento.cod_super~") COLUMN(NAME=~"anexo_aumento.cod_jef~")    JOIN (LEFT=~"promesa_premio.serie~"    OP =~"=~"RIGHT=~"anexo_aumento.serie_m~" )    JOIN (LEFT=~"promesa_premio.numero~"    OP =~"=~"RIGHT=~"anexo_aumento.nro_aumento~" )    JOIN (LEFT=~"anexo_aumento.serie_m~"    OP =~"=~"RIGHT=~"pago_aumento.serie_m~" )    JOIN (LEFT=~"anexo_aumento.nro_aumento~"    OP =~"=~"RIGHT=~"pago_aumento.nro_aumento~" )    JOIN (LEFT=~"anexo_aumento.ult_folio~"    OP =~"=~"RIGHT=~"pago_aumento.folio~" )    JOIN (LEFT=~"anexo_aumento.cod_agente~"    OP =~"=~"RIGHT=~"agentes.cod_age~" )WHERE(    EXP1 =~"~~~"PROMESA_PREMIO~~~".~~~"FECHA~~~"~"   OP =~"=~"    EXP2 =~":fecha~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"PROMESA_PREMIO~~~".~~~"PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"PROMESA_PREMIO~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~"'A'~" ) )) ARG(NAME = ~"fecha~" TYPE = datetime)  ARG(NAME = ~"parque~" TYPE = number) " update="PROMESA_PREMIO" updatewhere=0 updatekeyinplace=yes arguments=(("fecha", datetime),("parque", number))  sort="oferta_v_cod_age A cod_premio D " )
