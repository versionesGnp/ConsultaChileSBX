 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"jefe_ventas~" )  TABLE(NAME=~"res_comi~" ) COLUMN(NAME=~"res_comi.cod_age_sup~") COLUMN(NAME=~"res_comi.rut~") COLUMN(NAME=~"res_comi.mont_age_sup~") COLUMN(NAME=~"res_comi.cod_contable~") COLUMN(NAME=~"res_comi.mes~") COLUMN(NAME=~"res_comi.fecha~") COLUMN(NAME=~"res_comi.contrato~") COLUMN(NAME=~"res_comi.serie~") COLUMN(NAME=~"res_comi.porc_ing_caja~") COLUMN(NAME=~"res_comi.porc_venta~") COLUMN(NAME=~"res_comi.total_pago~") COLUMN(NAME=~"res_comi.valor_uf~") COLUMN(NAME=~"res_comi.haber~") COLUMN(NAME=~"res_comi.codigo_com~") COLUMN(NAME=~"res_comi.estado_age_sup~") COLUMN(NAME=~"jefe_ventas.nombre~") COLUMN(NAME=~"jefe_ventas.a_paterno~") COLUMN(NAME=~"jefe_ventas.a_materno~") COLUMN(NAME=~"jefe_ventas.rut~") COLUMN(NAME=~"res_comi.cod_parque~")    JOIN (LEFT=~"res_comi.cod_age_sup~"    OP =~"=~"RIGHT=~"jefe_ventas.jefe_ventas~" )WHERE(    EXP1 =~"~~~"JEFE_VENTAS~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'A'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"RES_COMI~~~".~~~"COD_CONTABLE~~~"~"   OP =~"=~"    EXP2 =~"'021'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"RES_COMI~~~".~~~"FECHA~~~"~"   OP =~"=~"    EXP2 =~":fecha~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"RES_COMI~~~".~~~"COD_AGE_SUP~~~"~"   OP =~"=~"    EXP2 =~":jefe~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"RES_COMI~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~" ) ) ARG(NAME = ~"fecha~" TYPE = datetime)  ARG(NAME = ~"jefe~" TYPE = string)  ARG(NAME = ~"parque~" TYPE = number) " arguments=(("fecha", datetime),("jefe", string),("parque", number)) )
