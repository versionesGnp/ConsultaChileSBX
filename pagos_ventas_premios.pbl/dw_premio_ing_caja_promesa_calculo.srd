 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"promesa_premio~" )  TABLE(NAME=~"oferta_v~" )  TABLE(NAME=~"cadena~" ) COLUMN(NAME=~"promesa_premio.base~") COLUMN(NAME=~"promesa_premio.serie~") COLUMN(NAME=~"promesa_premio.numero~") COLUMN(NAME=~"promesa_premio.forma~") COLUMN(NAME=~"promesa_premio.uso~") COLUMN(NAME=~"promesa_premio.fecha~") COLUMN(NAME=~"promesa_premio.monto~") COLUMN(NAME=~"promesa_premio.porcentaje~") COLUMN(NAME=~"promesa_premio.cod_premio~") COLUMN(NAME=~"promesa_premio.fecha_proceso~") COLUMN(NAME=~"promesa_premio.parque~") COMPUTE(NAME=~"''~") COMPUTE(NAME=~"''~") COMPUTE(NAME=~"''~") COMPUTE(NAME=~"0~") COMPUTE(NAME=~"0~") COMPUTE(NAME=~"''~") COMPUTE(NAME=~"0~") COMPUTE(NAME=~"0~") COMPUTE(NAME=~"''~") COMPUTE(NAME=~"0~") COLUMN(NAME=~"oferta_v.rut~") COLUMN(NAME=~"cadena.codigo~")    JOIN (LEFT=~"promesa_premio.serie~"    OP =~"=~"RIGHT=~"oferta_v.serie~" )    JOIN (LEFT=~"promesa_premio.numero~"    OP =~"=~"RIGHT=~"oferta_v.nro_oferta~" )    JOIN (LEFT=~"oferta_v.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"oferta_v.nro_oferta~"    OP =~"=~"RIGHT=~"cadena.numero~" )WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'O'~" ) )    UNION (PBSELECT( VERSION(400) TABLE(NAME=~"promesa_premio~" )  TABLE(NAME=~"anexo_aumento~" )  TABLE(NAME=~"cadena~" ) COLUMN(NAME=~"promesa_premio.base~") COLUMN(NAME=~"promesa_premio.serie~") COLUMN(NAME=~"promesa_premio.numero~") COLUMN(NAME=~"promesa_premio.forma~") COLUMN(NAME=~"promesa_premio.uso~") COLUMN(NAME=~"promesa_premio.fecha~") COLUMN(NAME=~"promesa_premio.monto~") COLUMN(NAME=~"promesa_premio.porcentaje~") COLUMN(NAME=~"promesa_premio.cod_premio~") COLUMN(NAME=~"promesa_premio.fecha_proceso~") COLUMN(NAME=~"promesa_premio.parque~") COMPUTE(NAME=~"''~") COMPUTE(NAME=~"''~") COMPUTE(NAME=~"''~") COMPUTE(NAME=~"0~") COMPUTE(NAME=~"0~") COMPUTE(NAME=~"''~") COMPUTE(NAME=~"0~") COMPUTE(NAME=~"0~") COMPUTE(NAME=~"''~") COMPUTE(NAME=~"0~") COLUMN(NAME=~"anexo_aumento.rut~") COLUMN(NAME=~"cadena.codigo~")    JOIN (LEFT=~"promesa_premio.serie~"    OP =~"=~"RIGHT=~"anexo_aumento.serie_m~" )    JOIN (LEFT=~"promesa_premio.numero~"    OP =~"=~"RIGHT=~"anexo_aumento.nro_aumento~" )    JOIN (LEFT=~"anexo_aumento.serie_m~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"anexo_aumento.nro_aumento~"    OP =~"=~"RIGHT=~"cadena.numero~" )WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'A'~" ) )) " update="PROMESA_PREMIO" updatewhere=0 updatekeyinplace=yes  sort="cod_premio D " )
