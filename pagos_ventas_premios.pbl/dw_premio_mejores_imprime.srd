 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"promesa_lugar~" )  TABLE(NAME=~"premios_por_caja_mejores~" )  TABLE(NAME=~"agentes~" )  TABLE(NAME=~"cierre_pagos_ventas~" ) COLUMN(NAME=~"promesa_lugar.codigo~") COLUMN(NAME=~"promesa_lugar.ufs~") COLUMN(NAME=~"promesa_lugar.uso~") COLUMN(NAME=~"promesa_lugar.lugar~") COLUMN(NAME=~"promesa_lugar.agente~") COLUMN(NAME=~"promesa_lugar.monto~") COLUMN(NAME=~"promesa_lugar.codigo_premio~") COLUMN(NAME=~"promesa_lugar.fecha~") COLUMN(NAME=~"premios_por_caja_mejores.descripcion~") COLUMN(NAME=~"agentes.nombre~") COLUMN(NAME=~"agentes.a_paterno~") COLUMN(NAME=~"agentes.a_materno~") COLUMN(NAME=~"agentes.rut~") COMPUTE(NAME=~"''~") COLUMN(NAME=~"promesa_lugar.parque~") COLUMN(NAME=~"cierre_pagos_ventas.fecha_inicio~")    JOIN (LEFT=~"promesa_lugar.codigo~"    OP =~"=~"RIGHT=~"agentes.cod_age~" )    JOIN (LEFT=~"promesa_lugar.uso~"    OP =~"=~"RIGHT=~"premios_por_caja_mejores.canal~" )    JOIN (LEFT=~"promesa_lugar.agente~"    OP =~"=~"RIGHT=~"premios_por_caja_mejores.tipo_empleado~" )    JOIN (LEFT=~"promesa_lugar.lugar~"    OP =~"=~"RIGHT=~"premios_por_caja_mejores.codigo~" )    JOIN (LEFT=~"promesa_lugar.parque~"    OP =~"=~"RIGHT=~"premios_por_caja_mejores.parque~" )    JOIN (LEFT=~"promesa_lugar.fecha~"    OP =~"=~"RIGHT=~"cierre_pagos_ventas.fecha_termino~" )    JOIN (LEFT=~"premios_por_caja_mejores.parque~"    OP =~"=~"RIGHT=~"cierre_pagos_ventas.cod_parque~" )    JOIN (LEFT=~"premios_por_caja_mejores.tipo_empleado~"    OP =~"=~"RIGHT=~"cierre_pagos_ventas.tipo_empleado~" )WHERE(    EXP1 =~"((((~~~"PROMESA_LUGAR~~~".~~~"FECHA~~~"~"   OP =~"=~"    EXP2 =~":fecha~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"PROMESA_LUGAR~~~".~~~"PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"PROMESA_LUGAR~~~".~~~"USO~~~"~"   OP =~"=~"    EXP2 =~"'NI'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"PROMESA_LUGAR~~~".~~~"LUGAR~~~"~"   OP =~">=~"    EXP2 =~"1~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"PROMESA_LUGAR~~~".~~~"LUGAR~~~"~"   OP =~"<=~"    EXP2 =~"2~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"PROMESA_LUGAR~~~".~~~"AGENTE~~~"~"   OP =~"=~"    EXP2 =~"'A'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CIERRE_PAGOS_VENTAS~~~".~~~"TIPO_PREMIO~~~"~"   OP =~"=~"    EXP2 =~"3~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CIERRE_PAGOS_VENTAS~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"PREMIOS_POR_CAJA_MEJORES~~~".~~~"PERIODO~~~"~"   OP =~"=~"    EXP2 =~"1))~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"((~~~"PROMESA_LUGAR~~~".~~~"FECHA~~~"~"   OP =~"=~"    EXP2 =~":fecha~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"PROMESA_LUGAR~~~".~~~"PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"PROMESA_LUGAR~~~".~~~"USO~~~"~"   OP =~"=~"    EXP2 =~"'NF'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"PROMESA_LUGAR~~~".~~~"LUGAR~~~"~"   OP =~">=~"    EXP2 =~"1~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"PROMESA_LUGAR~~~".~~~"LUGAR~~~"~"   OP =~"<=~"    EXP2 =~"4~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"PROMESA_LUGAR~~~".~~~"AGENTE~~~"~"   OP =~"=~"    EXP2 =~"'A'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CIERRE_PAGOS_VENTAS~~~".~~~"TIPO_PREMIO~~~"~"   OP =~"=~"    EXP2 =~"3~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CIERRE_PAGOS_VENTAS~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"PREMIOS_POR_CAJA_MEJORES~~~".~~~"PERIODO~~~"~"   OP =~"=~"    EXP2 =~"1))))~" ) ) ORDER(NAME=~"promesa_lugar.agente~" ASC=yes )  ORDER(NAME=~"promesa_lugar.uso~" ASC=yes )  ORDER(NAME=~"promesa_lugar.lugar~" ASC=yes ) ARG(NAME = ~"fecha~" TYPE = datetime)  ARG(NAME = ~"parque~" TYPE = number) " arguments=(("fecha", datetime),("parque", number))  sort="promesa_lugar_uso A promesa_lugar_lugar A " )
