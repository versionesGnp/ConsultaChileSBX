 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cd_folio_detalle_excepcion~" ) COLUMN(NAME=~"cd_folio_detalle_excepcion.base~") COLUMN(NAME=~"cd_folio_detalle_excepcion.serie~") COLUMN(NAME=~"cd_folio_detalle_excepcion.numero~") COLUMN(NAME=~"cd_folio_detalle_excepcion.fecha_crea~") COLUMN(NAME=~"cd_folio_detalle_excepcion.referencia_memo~") COLUMN(NAME=~"cd_folio_detalle_excepcion.codigo_grupo_excepcion~") COLUMN(NAME=~"cd_folio_detalle_excepcion.codigo_excepcion~") COLUMN(NAME=~"cd_folio_detalle_excepcion.fecha_entrega_pendiente~") COLUMN(NAME=~"cd_folio_detalle_excepcion.estado_entrega~") COLUMN(NAME=~"cd_folio_detalle_excepcion.fecha_recepcion_documento~") COLUMN(NAME=~"cd_folio_detalle_excepcion.estado_entrega_opera~") COLUMN(NAME=~"cd_folio_detalle_excepcion.fecha_recepcion_doc_opera~") COLUMN(NAME=~"cd_folio_detalle_excepcion.observacion~") COMPUTE(NAME=~"0 marca~")WHERE(    EXP1 =~"~~~"CD_FOLIO_DETALLE_EXCEPCION~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CD_FOLIO_DETALLE_EXCEPCION~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CD_FOLIO_DETALLE_EXCEPCION~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CD_FOLIO_DETALLE_EXCEPCION~~~".~~~"CODIGO_GRUPO_EXCEPCION~~~"~"   OP =~"=~"    EXP2 =~"4~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number) " update="CD_FOLIO_DETALLE_EXCEPCION" updatewhere=0 updatekeyinplace=yes arguments=(("base", string),("serie", string),("numero", number))  sort="base A serie A numero A " )
