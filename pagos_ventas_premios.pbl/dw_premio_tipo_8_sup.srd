 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"premio_tipo~" ) COLUMN(NAME=~"premio_tipo.descripcion~") COLUMN(NAME=~"premio_tipo.cod_premio~") COLUMN(NAME=~"premio_tipo.cod_contab~") COLUMN(NAME=~"premio_tipo.cargo~") COLUMN(NAME=~"premio_tipo.premio1~") COLUMN(NAME=~"premio_tipo.premio2~") COLUMN(NAME=~"premio_tipo.parque~")WHERE(    EXP1 =~"~~~"PREMIO_TIPO~~~".~~~"COD_PREMIO~~~"~"   OP =~"=~"    EXP2 =~":tipo_premio~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"PREMIO_TIPO~~~".~~~"COD_CONTAB~~~"~"   OP =~"=~"    EXP2 =~":cod_contab~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"PREMIO_TIPO~~~".~~~"CARGO~~~"~"   OP =~"=~"    EXP2 =~":cargo~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"PREMIO_TIPO~~~".~~~"PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~" ) ) ARG(NAME = ~"tipo_premio~" TYPE = number)  ARG(NAME = ~"cod_contab~" TYPE = string)  ARG(NAME = ~"cargo~" TYPE = string)  ARG(NAME = ~"parque~" TYPE = number) " update="PREMIO_TIPO" updatewhere=0 updatekeyinplace=yes arguments=(("tipo_premio", number),("cod_contab", string),("cargo", string),("parque", number)) )
