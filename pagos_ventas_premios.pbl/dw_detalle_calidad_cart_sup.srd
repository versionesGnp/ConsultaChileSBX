 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"agentes~" )  TABLE(NAME=~"clasifica_hist~" ) COLUMN(NAME=~"agentes.cod_age~") COLUMN(NAME=~"agentes.nombre~") COLUMN(NAME=~"agentes.a_paterno~") COLUMN(NAME=~"agentes.a_materno~") COLUMN(NAME=~"agentes.fecha_ini~") COLUMN(NAME=~"agentes.fecha_fin~") COLUMN(NAME=~"agentes.cod_sup~") COLUMN(NAME=~"agentes.estado~") COLUMN(NAME=~"clasifica_hist.fecha_clasifica~") COLUMN(NAME=~"clasifica_hist.tipo_clasifica~")    JOIN (LEFT=~"agentes.cod_age~"    OP =~"=~"RIGHT=~"clasifica_hist.cod_age~" )WHERE(    EXP1 =~"~~~"AGENTES~~~".~~~"COD_SUP~~~"~"   OP =~"=~"    EXP2 =~":cod_sup~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CLASIFICA_HIST~~~".~~~"FECHA_CLASIFICA~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CLASIFICA_HIST~~~".~~~"FECHA_CLASIFICA~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"CLASIFICA_HIST~~~".~~~"TIPO_CLASIFICA~~~"~"   OP =~"=~"    EXP2 =~"'A'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"CLASIFICA_HIST~~~".~~~"TIPO_CLASIFICA~~~"~"   OP =~"=~"    EXP2 =~"'B')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"AGENTES~~~".~~~"TIPO_CONT~~~"~"   OP =~"=~"    EXP2 =~"'4'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"AGENTES~~~".~~~"TIPO_CONT~~~"~"   OP =~"=~"    EXP2 =~"'5')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"AGENTES~~~".~~~"FECHA_FIN~~~"~"   OP =~">=~"    EXP2 =~":fecha_fin~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"AGENTES~~~".~~~"FECHA_INI~~~"~"   OP =~"<=~"    EXP2 =~":fecha_ini~" ) ) ARG(NAME = ~"cod_sup~" TYPE = string)  ARG(NAME = ~"fecha_ini~" TYPE = datetime)  ARG(NAME = ~"fecha_fin~" TYPE = datetime) " arguments=(("cod_sup", string),("fecha_ini", datetime),("fecha_fin", datetime))  sort="clasifica_hist_tipo_clasifica A " )
