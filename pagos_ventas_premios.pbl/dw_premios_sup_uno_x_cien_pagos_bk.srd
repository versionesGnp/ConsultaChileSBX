 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"supervisor~" )  TABLE(NAME=~"oferta_v~" )  TABLE(NAME=~"ingreso~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"comision_promesa~" ) COLUMN(NAME=~"supervisor.cod_sup~") COLUMN(NAME=~"supervisor.rut~") COMPUTE(NAME=~"~~~"SUPERVISOR~~~".~~~"NOMBRE~~~"||' '||~~~"SUPERVISOR~~~".~~~"A_PATERNO~~~"||' '||~~~"SUPERVISOR~~~".~~~"A_MATERNO~~~" as nombre~") COLUMN(NAME=~"supervisor.estado~") COMPUTE(NAME=~"round((sum(~~~"INGRESO~~~".~~~"MONTO~~~" ) )*(1/100),4) as premio~") COMPUTE(NAME=~"''~")    JOIN (LEFT=~"supervisor.cod_sup~"    OP =~"=~"RIGHT=~"oferta_v.cod_sup~" )    JOIN (LEFT=~"oferta_v.serie~"    OP =~"=~"RIGHT=~"ingreso.serie~" )    JOIN (LEFT=~"oferta_v.nro_oferta~"    OP =~"=~"RIGHT=~"ingreso.contrato~" )    JOIN (LEFT=~"ingreso.base~"    OP =~"=~"RIGHT=~"cadena.codigo~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"ingreso.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"ingreso.contrato~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"comision_promesa.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"comision_promesa.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"comision_promesa.numero~" )WHERE(    EXP1 =~"~~~"SUPERVISOR~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'A'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"SUPERVISOR~~~".~~~"CLASIFICA~~~"~"   OP =~"=~"    EXP2 =~"'A'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"SUPERVISOR~~~".~~~"CLASIFICA~~~"~"   OP =~"=~"    EXP2 =~"'B'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"SUPERVISOR~~~".~~~"CLASIFICA~~~"~"   OP =~"=~"    EXP2 =~"'C')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"SUPERVISOR~~~".~~~"COD_SUP~~~"~"   OP =~"<>~"    EXP2 =~"'CS'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~"'O'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"INGRESO~~~".~~~"TIPO_MOV~~~"~"   OP =~"=~"    EXP2 =~"'A'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"TIPO_MOV~~~"~"   OP =~"=~"    EXP2 =~"'E')~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SUPERVISOR~~~".~~~"CANAL~~~"~"   OP =~"=~"    EXP2 =~"'NF'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"(~~~"INGRESO~~~".~~~"FECHA_PAGO~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"FECHA_PAGO~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"CADENA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'V'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'C')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"COMISION_PROMESA~~~".~~~"PORCENTAJE_PAG~~~"~"   OP =~">=~"    EXP2 =~"15~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"PREMIO_ING_CAJA~~~"~"   OP =~"<>~"    EXP2 =~"0~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"SUPERVISOR~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"SUPERVISOR~~~".~~~"COD_JEFE~~~"~"   OP =~"=~"    EXP2 =~":jefe~" )  GROUP(NAME=~"supervisor.cod_sup~") GROUP(NAME=~"supervisor.nombre~") GROUP(NAME=~"supervisor.a_paterno~") GROUP(NAME=~"supervisor.a_materno~") GROUP(NAME=~"supervisor.rut~") GROUP(NAME=~"supervisor.estado~") GROUP(NAME=~"supervisor.clasifica~")) ORDER(NAME=~"supervisor.cod_sup~" ASC=no) ARG(NAME = ~"fecha_ini~" TYPE = datetime)  ARG(NAME = ~"fecha_fin~" TYPE = datetime)  ARG(NAME = ~"parque~" TYPE = number)  ARG(NAME = ~"jefe~" TYPE = string) " arguments=(("fecha_ini", datetime),("fecha_fin", datetime),("parque", number),("jefe", string))  sort="supervisor_cod_sup A " )
