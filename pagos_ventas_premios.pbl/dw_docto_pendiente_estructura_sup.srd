 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cd_folio_detalle_excepcion~" )  TABLE(NAME=~"oferta_v~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"agentes~" )  TABLE(NAME=~"supervisor~" ) COLUMN(NAME=~"cd_folio_detalle_excepcion.base~") COLUMN(NAME=~"cd_folio_detalle_excepcion.serie~") COLUMN(NAME=~"cd_folio_detalle_excepcion.numero~") COLUMN(NAME=~"cd_folio_detalle_excepcion.fecha_crea~") COLUMN(NAME=~"cd_folio_detalle_excepcion.referencia_memo~") COLUMN(NAME=~"cd_folio_detalle_excepcion.codigo_excepcion~") COLUMN(NAME=~"cd_folio_detalle_excepcion.fecha_entrega_pendiente~") COLUMN(NAME=~"cd_folio_detalle_excepcion.estado_entrega~") COLUMN(NAME=~"cd_folio_detalle_excepcion.fecha_recepcion_documento~") COLUMN(NAME=~"cd_folio_detalle_excepcion.estado_entrega_opera~") COLUMN(NAME=~"cd_folio_detalle_excepcion.fecha_recepcion_doc_opera~") COLUMN(NAME=~"cd_folio_detalle_excepcion.observacion~") COLUMN(NAME=~"agentes.cod_age~") COLUMN(NAME=~"agentes.nombre~") COLUMN(NAME=~"agentes.a_paterno~") COLUMN(NAME=~"agentes.a_materno~") COLUMN(NAME=~"supervisor.cod_sup~") COLUMN(NAME=~"supervisor.nombre~") COLUMN(NAME=~"supervisor.a_paterno~") COLUMN(NAME=~"supervisor.a_materno~") COLUMN(NAME=~"cadena.rut~") COMPUTE(NAME=~"11 as cd_folio_ult_estado~") COLUMN(NAME=~"cd_folio_detalle_excepcion.codigo_grupo_excepcion~")    JOIN (LEFT=~"cd_folio_detalle_excepcion.serie~"    OP =~"=~"RIGHT=~"oferta_v.serie~" )    JOIN (LEFT=~"cd_folio_detalle_excepcion.numero~"    OP =~"=~"RIGHT=~"oferta_v.nro_oferta~" )    JOIN (LEFT=~"cd_folio_detalle_excepcion.base~"    OP =~"=~"RIGHT=~"cadena.codigo~" )    JOIN (LEFT=~"oferta_v.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"oferta_v.nro_oferta~"    OP =~"=~"RIGHT=~"cadena.numero~" )    JOIN (LEFT=~"agentes.cod_age~"    OP =~"=~"RIGHT=~"oferta_v.cod_age~" )    JOIN (LEFT=~"agentes.cod_sup~"    OP =~"=~"RIGHT=~"supervisor.cod_sup~" )WHERE(    EXP1 =~"((~~~"SUPERVISOR~~~".~~~"COD_SUP~~~"~"   OP =~"=~"    EXP2 =~":codigo~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"OFERTA_V~~~".~~~"CIERRE_VENTA~~~"~"   OP =~"=~"    EXP2 =~":fecha_cierre~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"CD_FOLIO_DETALLE_EXCEPCION~~~".~~~"CODIGO_GRUPO_EXCEPCION~~~"~"   OP =~"=~"    EXP2 =~"4~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CD_FOLIO_DETALLE_EXCEPCION~~~".~~~"ESTADO_ENTREGA~~~"~"   OP =~"=~"    EXP2 =~"'P'))~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"(~~~"SUPERVISOR~~~".~~~"COD_SUP~~~"~"   OP =~"=~"    EXP2 =~":codigo~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"OFERTA_V~~~".~~~"CIERRE_VENTA~~~"~"   OP =~"=~"    EXP2 =~":fecha_cierre~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"CD_FOLIO_DETALLE_EXCEPCION~~~".~~~"CODIGO_GRUPO_EXCEPCION~~~"~"   OP =~"=~"    EXP2 =~"4~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CD_FOLIO_DETALLE_EXCEPCION~~~".~~~"ESTADO_ENTREGA_OPERA~~~"~"   OP =~"=~"    EXP2 =~"'P')))~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CD_FOLIO_DETALLE_EXCEPCION~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'V'~" ) ) ARG(NAME = ~"codigo~" TYPE = string)  ARG(NAME = ~"fecha_cierre~" TYPE = datetime) " arguments=(("codigo", string),("fecha_cierre", datetime))  sort="agentes_cod_age A " )
