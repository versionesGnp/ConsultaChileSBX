SELECT	sum("INGRESO"."MONTO")
INTO		:ldb_monto_ser
FROM		"INGRESO"  
WHERE	"INGRESO"."BASE" = :as_base AND  
			"INGRESO"."SERIE" = :as_serie AND  
			"INGRESO"."CONTRATO" = :adb_numero AND  
			"INGRESO"."FECHA_PAGO" <= :adt_fec_term AND  
		 	//( "INGRESO"."TIPO_COB" = 'CI' OR "INGRESO"."TIPO_COB" = 'CU' OR "INGRESO"."TIPO_COB" = 'BE') AND
		 	//( "INGRESO"."COD_CAJA" = 'XX' OR "INGRESO"."COD_CAJA" = 'XY' OR "INGRESO"."COD_CAJA" = 'XZ' )  AND  
		 	( "INGRESO"."TIPO_MOV" = 'E' OR "INGRESO"."TIPO_MOV" = 'A' ) and
			 "INGRESO"."PAGO_HIST" = 'A'
USING	sqlca;
if isnull(ldb_monto_ser) then ldb_monto_ser=0
ldb_suma									= ldb_monto_ch + ldb_monto_ef + ldb_monto_ser
if isnull(ldb_suma) then ldb_suma=0
return ldb_suma
end function

