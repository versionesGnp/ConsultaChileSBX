 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"res_comi~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"oferta_v~" )  TABLE(NAME=~"supervisor~" )  TABLE(NAME=~"cierre_pagos_ventas~" ) COLUMN(NAME=~"res_comi.cod_age_sup~") COLUMN(NAME=~"res_comi.rut~") COLUMN(NAME=~"res_comi.mont_age_sup~") COLUMN(NAME=~"res_comi.cod_contable~") COLUMN(NAME=~"res_comi.fecha~") COLUMN(NAME=~"res_comi.contrato~") COLUMN(NAME=~"res_comi.serie~") COLUMN(NAME=~"res_comi.porc_ing_caja~") COLUMN(NAME=~"res_comi.porc_venta~") COLUMN(NAME=~"res_comi.precio~") COLUMN(NAME=~"res_comi.total_pago~") COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"oferta_v.cod_age~") COLUMN(NAME=~"cierre_pagos_ventas.fecha_inicio~") COLUMN(NAME=~"supervisor.cod_parque~") COLUMN(NAME=~"supervisor.estado~") COMPUTE(NAME=~"''~") COLUMN(NAME=~"cadena.rut~")    JOIN (LEFT=~"res_comi.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"res_comi.contrato~"    OP =~"=~"RIGHT=~"cadena.numero~" )    JOIN (LEFT=~"res_comi.serie~"    OP =~"=~"RIGHT=~"oferta_v.serie~" )    JOIN (LEFT=~"res_comi.contrato~"    OP =~"=~"RIGHT=~"oferta_v.nro_oferta~" )    JOIN (LEFT=~"res_comi.cod_age_sup~"    OP =~"=~"RIGHT=~"supervisor.cod_sup~" )    JOIN (LEFT=~"supervisor.cod_parque~"    OP =~"=~"RIGHT=~"cierre_pagos_ventas.cod_parque~" )    JOIN (LEFT=~"res_comi.fecha~"    OP =~"=~"RIGHT=~"cierre_pagos_ventas.fecha_termino~" )WHERE(    EXP1 =~"~~~"RES_COMI~~~".~~~"FECHA~~~"~"   OP =~"=~"    EXP2 =~":fecha_fin~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"RES_COMI~~~".~~~"COD_AGE_SUP~~~"~"   OP =~"=~"    EXP2 =~":cod_sup~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"RES_COMI~~~".~~~"COD_CONTABLE~~~"~"   OP =~"=~"    EXP2 =~"'P09'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CIERRE_PAGOS_VENTAS~~~".~~~"TIPO_PREMIO~~~"~"   OP =~"=~"    EXP2 =~"9~" ) ) ARG(NAME = ~"fecha_fin~" TYPE = datetime)  ARG(NAME = ~"cod_sup~" TYPE = string) " arguments=(("fecha_fin", datetime),("cod_sup", string))  sort="contrato A " )
