 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"agentes~" )  TABLE(NAME=~"res_comi~" ) COLUMN(NAME=~"res_comi.cod_age_sup~") COLUMN(NAME=~"res_comi.cod_contable~") COLUMN(NAME=~"res_comi.total_pago~") COLUMN(NAME=~"agentes.rut~") COLUMN(NAME=~"agentes.nombre~") COLUMN(NAME=~"agentes.a_paterno~") COLUMN(NAME=~"agentes.a_materno~") COLUMN(NAME=~"agentes.cod_parque~") COMPUTE(NAME=~"''~") COMPUTE(NAME=~"''~") COMPUTE(NAME=~"''~") COMPUTE(NAME=~"3~")    JOIN (LEFT=~"res_comi.cod_age_sup~"    OP =~"=~"RIGHT=~"agentes.cod_age~" )    JOIN (LEFT=~"agentes.rut~"    OP =~"=~"RIGHT=~"res_comi.rut~" )WHERE(    EXP1 =~"~~~"RES_COMI~~~".~~~"FECHA~~~"~"   OP =~"=~"    EXP2 =~":fecha~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"RES_COMI~~~".~~~"TOTAL_PAGO~~~"~"   OP =~">~"    EXP2 =~"0~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"RES_COMI~~~".~~~"COD_CONTABLE~~~"~"   OP =~"=~"    EXP2 =~"'080'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"AGENTES~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"AGENTES~~~".~~~"PAGOS_VENTA~~~"~"   OP =~"=~"    EXP2 =~"'S'~" ) )    UNION (PBSELECT( VERSION(400) TABLE(NAME=~"res_comi~" )  TABLE(NAME=~"supervisor~" ) COLUMN(NAME=~"res_comi.cod_age_sup~") COLUMN(NAME=~"res_comi.cod_contable~") COLUMN(NAME=~"res_comi.total_pago~") COLUMN(NAME=~"supervisor.rut~") COLUMN(NAME=~"supervisor.nombre~") COLUMN(NAME=~"supervisor.a_paterno~") COLUMN(NAME=~"supervisor.a_materno~") COLUMN(NAME=~"supervisor.cod_parque~") COMPUTE(NAME=~"''~") COMPUTE(NAME=~"''~") COMPUTE(NAME=~"''~") COMPUTE(NAME=~"2~")    JOIN (LEFT=~"res_comi.cod_age_sup~"    OP =~"=~"RIGHT=~"supervisor.cod_sup~" )    JOIN (LEFT=~"res_comi.rut~"    OP =~"=~"RIGHT=~"supervisor.rut~" )WHERE(    EXP1 =~"~~~"RES_COMI~~~".~~~"FECHA~~~"~"   OP =~"=~"    EXP2 =~":fecha~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"RES_COMI~~~".~~~"TOTAL_PAGO~~~"~"   OP =~">~"    EXP2 =~"0~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"RES_COMI~~~".~~~"COD_CONTABLE~~~"~"   OP =~"=~"    EXP2 =~"'080'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SUPERVISOR~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"SUPERVISOR~~~".~~~"PAGOS_VENTA~~~"~"   OP =~"=~"    EXP2 =~"'S'~" ) ))    UNION (PBSELECT( VERSION(400) TABLE(NAME=~"res_comi~" )  TABLE(NAME=~"jefe_ventas~" ) COLUMN(NAME=~"res_comi.cod_age_sup~") COLUMN(NAME=~"res_comi.cod_contable~") COLUMN(NAME=~"res_comi.total_pago~") COLUMN(NAME=~"jefe_ventas.rut~") COLUMN(NAME=~"jefe_ventas.nombre~") COLUMN(NAME=~"jefe_ventas.a_paterno~") COLUMN(NAME=~"jefe_ventas.a_materno~") COLUMN(NAME=~"jefe_ventas.cod_parque~") COMPUTE(NAME=~"''~") COMPUTE(NAME=~"''~") COMPUTE(NAME=~"''~") COMPUTE(NAME=~"1~")    JOIN (LEFT=~"res_comi.cod_age_sup~"    OP =~"=~"RIGHT=~"jefe_ventas.jefe_ventas~" )    JOIN (LEFT=~"res_comi.rut~"    OP =~"=~"RIGHT=~"jefe_ventas.rut~" )WHERE(    EXP1 =~"~~~"RES_COMI~~~".~~~"FECHA~~~"~"   OP =~"=~"    EXP2 =~":fecha~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"RES_COMI~~~".~~~"TOTAL_PAGO~~~"~"   OP =~">~"    EXP2 =~"0~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"RES_COMI~~~".~~~"COD_CONTABLE~~~"~"   OP =~"=~"    EXP2 =~"'080'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"JEFE_VENTAS~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"JEFE_VENTAS~~~".~~~"PAGOS_VENTA~~~"~"   OP =~"=~"    EXP2 =~"'S'~" ) )) ARG(NAME = ~"fecha~" TYPE = datetime)  ARG(NAME = ~"parque~" TYPE = number) " arguments=(("fecha", datetime),("parque", number))  sort="c_orden A res_comi_total_pago D " )
