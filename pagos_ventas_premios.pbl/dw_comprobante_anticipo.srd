table(column=(type=char(5) updatewhereclause=yes name=res_comi_cod_age_sup dbname="res_comi.cod_age_sup" )
 column=(type=char(3) updatewhereclause=yes name=res_comi_cod_contable dbname="res_comi.cod_contable" )
 column=(type=decimal(4) updatewhereclause=yes name=res_comi_total_pago dbname="res_comi.total_pago" )
 column=(type=decimal(0) updatewhereclause=yes name=agentes_rut dbname="agentes.rut" )
 column=(type=char(20) updatewhereclause=yes name=agentes_nombre dbname="agentes.nombre" )
 column=(type=char(50) updatewhereclause=yes name=agentes_a_paterno dbname="agentes.a_paterno" )
