 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cadena~" )  TABLE(NAME=~"oferta_v~" )  TABLE(NAME=~"pago_oferta~" )  TABLE(NAME=~"tab_uf~" )  TABLE(NAME=~"jefe_ventas~" ) COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"cadena.serie~") COLUMN(NAME=~"cadena.numero~") COLUMN(NAME=~"pago_oferta.moneda~") COLUMN(NAME=~"pago_oferta.precio~") COLUMN(NAME=~"cadena.rut~") COLUMN(NAME=~"tab_uf.valor_uf~") COMPUTE(NAME=~"(SELECT sum(~~~"INGRESO~~~".~~~"MONTO~~~")  FROM ~~~"INGRESO~~~"  WHERE ~~~"INGRESO~~~".~~~"BASE~~~" = ~~~"CADENA~~~".~~~"CODIGO~~~" AND ~~~"INGRESO~~~".~~~"SERIE~~~" = ~~~"CADENA~~~".~~~"SERIE~~~" AND ~~~"INGRESO~~~".~~~"CONTRATO~~~" = ~~~"CADENA~~~".~~~"NUMERO~~~" AND (~~~"INGRESO~~~".~~~"TIPO_MOV~~~" = 'A' OR  ~~~"INGRESO~~~".~~~"TIPO_MOV~~~" = 'E') AND ~~~"INGRESO~~~".~~~"FECHA_PAGO~~~" <= :fecha)  as TOT_PAGADO~") COMPUTE(NAME=~"round(CASE WHEN ~~~"PAGO_OFERTA~~~".~~~"MONEDA~~~" = '1' THEN ~~~"PAGO_OFERTA~~~".~~~"PRECIO~~~" WHEN ~~~"PAGO_OFERTA~~~".~~~"MONEDA~~~" = '2' THEN ~~~"PAGO_OFERTA~~~".~~~"PRECIO~~~" * ~~~"TAB_UF~~~".~~~"VALOR_UF~~~"  END,0) as precio_peso~") COMPUTE(NAME=~"round((SELECT sum(~~~"INGRESO~~~".~~~"MONTO~~~")  FROM ~~~"INGRESO~~~"  WHERE ~~~"INGRESO~~~".~~~"BASE~~~" = ~~~"CADENA~~~".~~~"CODIGO~~~" AND ~~~"INGRESO~~~".~~~"SERIE~~~" = ~~~"CADENA~~~".~~~"SERIE~~~" AND ~~~"INGRESO~~~".~~~"CONTRATO~~~" = ~~~"CADENA~~~".~~~"NUMERO~~~" AND (~~~"INGRESO~~~".~~~"TIPO_MOV~~~" = 'A' OR  ~~~"INGRESO~~~".~~~"TIPO_MOV~~~" = 'E') AND ~~~"INGRESO~~~".~~~"FECHA_PAGO~~~" <= :fecha) / round(CASE WHEN ~~~"PAGO_OFERTA~~~".~~~"MONEDA~~~" = '1' THEN ~~~"PAGO_OFERTA~~~".~~~"PRECIO~~~" WHEN ~~~"PAGO_OFERTA~~~".~~~"MONEDA~~~" = '2' THEN ~~~"PAGO_OFERTA~~~".~~~"PRECIO~~~" * ~~~"TAB_UF~~~".~~~"VALOR_UF~~~"  END,0) * 100,2) as porce_pago~") COLUMN(NAME=~"oferta_v.estado_comi_jv~") COLUMN(NAME=~"oferta_v.estado_bono_jef~") COLUMN(NAME=~"oferta_v.cierre_venta~") COLUMN(NAME=~"oferta_v.cod_jef~") COLUMN(NAME=~"oferta_v.fecha_bono_jef~") COLUMN(NAME=~"oferta_v.fecha~")    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"oferta_v.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"oferta_v.nro_oferta~" )    JOIN (LEFT=~"oferta_v.serie~"    OP =~"=~"RIGHT=~"pago_oferta.serie~" )    JOIN (LEFT=~"oferta_v.nro_oferta~"    OP =~"=~"RIGHT=~"pago_oferta.nro_oferta~" )    JOIN (LEFT=~"oferta_v.ult_folio~"    OP =~"=~"RIGHT=~"pago_oferta.folio~" )    JOIN (LEFT=~"oferta_v.cod_jef~"    OP =~"=~"RIGHT=~"jefe_ventas.jefe_ventas~" )WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'O'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"OFERTA_V~~~".~~~"ESTADO_BONO_JEF~~~"~"   OP =~"=~"    EXP2 =~"'N'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"CADENA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'V'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'C')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"TAB_UF~~~".~~~"FECHA_UF~~~"~"   OP =~"=~"    EXP2 =~":fecha~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"round((SELECT sum(~~~"INGRESO~~~".~~~"MONTO~~~")  FROM ~~~"INGRESO~~~"  WHERE ~~~"INGRESO~~~".~~~"BASE~~~" = ~~~"CADENA~~~".~~~"CODIGO~~~" AND ~~~"INGRESO~~~".~~~"SERIE~~~" = ~~~"CADENA~~~".~~~"SERIE~~~" AND ~~~"INGRESO~~~".~~~"CONTRATO~~~" = ~~~"CADENA~~~".~~~"NUMERO~~~" AND (~~~"INGRESO~~~".~~~"TIPO_MOV~~~" = 'A' OR  ~~~"INGRESO~~~".~~~"TIPO_MOV~~~" = 'E') AND ~~~"INGRESO~~~".~~~"FECHA_PAGO~~~" <= :fecha) / round(CASE WHEN ~~~"PAGO_OFERTA~~~".~~~"MONEDA~~~" = '1' THEN ~~~"PAGO_OFERTA~~~".~~~"PRECIO~~~" WHEN ~~~"PAGO_OFERTA~~~".~~~"MONEDA~~~" = '2' THEN ~~~"PAGO_OFERTA~~~".~~~"PRECIO~~~" * ~~~"TAB_UF~~~".~~~"VALOR_UF~~~"  END,0) * 100,2)~"   OP =~">=~"    EXP2 =~"6.98~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"JEFE_VENTAS~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'A'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"OFERTA_V~~~".~~~"FECHA_BONO_JEF~~~"~"   OP =~"is~"    EXP2 =~"null~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"JEFE_VENTAS~~~".~~~"DEPTO~~~"~"   OP =~"=~"    EXP2 =~"'B'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"JEFE_VENTAS~~~".~~~"DEPTO~~~"~"   OP =~"=~"    EXP2 =~"'X')~" ) )    UNION (PBSELECT( VERSION(400) TABLE(NAME=~"anexo_aumento~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"jefe_ventas~" )  TABLE(NAME=~"pago_aumento~" )  TABLE(NAME=~"tab_uf~" ) COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"cadena.serie~") COLUMN(NAME=~"cadena.numero~") COLUMN(NAME=~"pago_aumento.moneda~") COLUMN(NAME=~"pago_aumento.precio~") COLUMN(NAME=~"cadena.rut~") COLUMN(NAME=~"tab_uf.valor_uf~") COMPUTE(NAME=~"(SELECT sum(~~~"INGRESO~~~".~~~"MONTO~~~")  FROM ~~~"INGRESO~~~"  WHERE ~~~"INGRESO~~~".~~~"BASE~~~" = ~~~"CADENA~~~".~~~"CODIGO~~~" AND ~~~"INGRESO~~~".~~~"SERIE~~~" = ~~~"CADENA~~~".~~~"SERIE~~~" AND ~~~"INGRESO~~~".~~~"CONTRATO~~~" = ~~~"CADENA~~~".~~~"NUMERO~~~" AND (~~~"INGRESO~~~".~~~"TIPO_MOV~~~" = 'A' OR  ~~~"INGRESO~~~".~~~"TIPO_MOV~~~" = 'E') AND ~~~"INGRESO~~~".~~~"FECHA_PAGO~~~" <= :fecha)  as TOT_PAGADO~") COMPUTE(NAME=~"round(CASE WHEN ~~~"PAGO_AUMENTO~~~".~~~"MONEDA~~~" = '1' THEN ~~~"PAGO_AUMENTO~~~".~~~"PRECIO~~~" WHEN ~~~"PAGO_AUMENTO~~~".~~~"MONEDA~~~" = '2' THEN ~~~"PAGO_AUMENTO~~~".~~~"PRECIO~~~" * ~~~"TAB_UF~~~".~~~"VALOR_UF~~~"  END,0) as precio_peso~") COMPUTE(NAME=~"round((SELECT sum(~~~"INGRESO~~~".~~~"MONTO~~~")  FROM ~~~"INGRESO~~~"  WHERE ~~~"INGRESO~~~".~~~"BASE~~~" = ~~~"CADENA~~~".~~~"CODIGO~~~" AND ~~~"INGRESO~~~".~~~"SERIE~~~" = ~~~"CADENA~~~".~~~"SERIE~~~" AND ~~~"INGRESO~~~".~~~"CONTRATO~~~" = ~~~"CADENA~~~".~~~"NUMERO~~~" AND (~~~"INGRESO~~~".~~~"TIPO_MOV~~~" = 'A' OR  ~~~"INGRESO~~~".~~~"TIPO_MOV~~~" = 'E') AND ~~~"INGRESO~~~".~~~"FECHA_PAGO~~~" <= :fecha) / round(CASE WHEN ~~~"PAGO_AUMENTO~~~".~~~"MONEDA~~~" = '1' THEN ~~~"PAGO_AUMENTO~~~".~~~"PRECIO~~~" WHEN ~~~"PAGO_AUMENTO~~~".~~~"MONEDA~~~" = '2' THEN ~~~"PAGO_AUMENTO~~~".~~~"PRECIO~~~" * ~~~"TAB_UF~~~".~~~"VALOR_UF~~~"  END,0) * 100,2) as porce_pago~") COLUMN(NAME=~"anexo_aumento.estado_comi_jv~") COLUMN(NAME=~"anexo_aumento.estado_bono_jef~") COLUMN(NAME=~"anexo_aumento.cierre_venta~") COLUMN(NAME=~"anexo_aumento.cod_jef~") COLUMN(NAME=~"anexo_aumento.fecha_bono_jef~") COLUMN(NAME=~"pago_aumento.fecha~")    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"anexo_aumento.serie_m~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"anexo_aumento.nro_aumento~" )    JOIN (LEFT=~"anexo_aumento.serie_m~"    OP =~"=~"RIGHT=~"pago_aumento.serie_m~" )    JOIN (LEFT=~"anexo_aumento.nro_aumento~"    OP =~"=~"RIGHT=~"pago_aumento.nro_aumento~" )    JOIN (LEFT=~"anexo_aumento.cod_jef~"    OP =~"=~"RIGHT=~"jefe_ventas.jefe_ventas~" )WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'A'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"(~~~"CADENA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'V'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'C')~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"TAB_UF~~~".~~~"FECHA_UF~~~"~"   OP =~"=~"    EXP2 =~":fecha~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"(SELECT sum(~~~"INGRESO~~~".~~~"MONTO~~~")  FROM ~~~"INGRESO~~~"  WHERE ~~~"INGRESO~~~".~~~"BASE~~~" = ~~~"CADENA~~~".~~~"CODIGO~~~" AND ~~~"INGRESO~~~".~~~"SERIE~~~" = ~~~"CADENA~~~".~~~"SERIE~~~" AND ~~~"INGRESO~~~".~~~"CONTRATO~~~" = ~~~"CADENA~~~".~~~"NUMERO~~~" AND (~~~"INGRESO~~~".~~~"TIPO_MOV~~~" = 'A' OR  ~~~"INGRESO~~~".~~~"TIPO_MOV~~~" = 'E') AND ~~~"INGRESO~~~".~~~"FECHA_PAGO~~~" <= :fecha)~"   OP =~">=~"    EXP2 =~"6.98~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"JEFE_VENTAS~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'A'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"(~~~"JEFE_VENTAS~~~".~~~"DEPTO~~~"~"   OP =~"=~"    EXP2 =~"'B'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"JEFE_VENTAS~~~".~~~"DEPTO~~~"~"   OP =~"=~"    EXP2 =~"'X')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"ANEXO_AUMENTO~~~".~~~"ESTADO_BONO_JEF~~~"~"   OP =~"=~"    EXP2 =~"'N'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"ANEXO_AUMENTO~~~".~~~"FECHA_BONO_JEF~~~"~"   OP =~"is~"    EXP2 =~"null~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"ANEXO_AUMENTO~~~".~~~"SERIE_M~~~"~"   OP =~"=~"    EXP2 =~"'A'~" ) )) ARG(NAME = ~"fecha~" TYPE = datetime) " arguments=(("fecha", datetime))  sort="oferta_v_cod_jef A " )
