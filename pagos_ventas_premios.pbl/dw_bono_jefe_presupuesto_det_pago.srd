 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"jefe_ventas~" )  TABLE(NAME=~"res_comi~" ) COLUMN(NAME=~"jefe_ventas.jefe_ventas~") COLUMN(NAME=~"jefe_ventas.nombre~") COLUMN(NAME=~"jefe_ventas.a_paterno~") COLUMN(NAME=~"jefe_ventas.a_materno~") COLUMN(NAME=~"jefe_ventas.rut~") COLUMN(NAME=~"jefe_ventas.estado~") COLUMN(NAME=~"res_comi.serie~") COLUMN(NAME=~"res_comi.contrato~") COLUMN(NAME=~"res_comi.fecha~") COLUMN(NAME=~"res_comi.porc_venta~") COLUMN(NAME=~"res_comi.precio~") COLUMN(NAME=~"res_comi.valor_uf~") COLUMN(NAME=~"res_comi.total_pago~") COLUMN(NAME=~"res_comi.moneda~") COLUMN(NAME=~"res_comi.cod_contable~")    JOIN (LEFT=~"jefe_ventas.jefe_ventas~"    OP =~"=~"RIGHT=~"res_comi.cod_age_sup~" )    JOIN (LEFT=~"jefe_ventas.rut~"    OP =~"=~"RIGHT=~"res_comi.rut~" )WHERE(    EXP1 =~"~~~"JEFE_VENTAS~~~".~~~"JEFE_VENTAS~~~"~"   OP =~"=~"    EXP2 =~":cod_jefe~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"RES_COMI~~~".~~~"FECHA~~~"~"   OP =~"=~"    EXP2 =~":fecha~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"RES_COMI~~~".~~~"COD_CONTABLE~~~"~"   OP =~"=~"    EXP2 =~"'021'~" ) ) ARG(NAME = ~"cod_jefe~" TYPE = string)  ARG(NAME = ~"fecha~" TYPE = datetime) " arguments=(("cod_jefe", string),("fecha", datetime)) )
