 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"premios_mejor_detalle~" )  TABLE(NAME=~"agentes~" )  TABLE(NAME=~"cadena~" ) COLUMN(NAME=~"premios_mejor_detalle.cod_parque_cad~") COLUMN(NAME=~"premios_mejor_detalle.base~") COLUMN(NAME=~"premios_mejor_detalle.serie~") COLUMN(NAME=~"premios_mejor_detalle.numero~") COLUMN(NAME=~"premios_mejor_detalle.cod_age~") COLUMN(NAME=~"premios_mejor_detalle.cod_sup~") COLUMN(NAME=~"premios_mejor_detalle.producc~") COLUMN(NAME=~"premios_mejor_detalle.estado~") COLUMN(NAME=~"premios_mejor_detalle.canal~") COLUMN(NAME=~"premios_mejor_detalle.fecha_prim~") COLUMN(NAME=~"premios_mejor_detalle.ctas_pag_s~") COLUMN(NAME=~"premios_mejor_detalle.mora_cred~") COLUMN(NAME=~"premios_mejor_detalle.nro_cuotas~") COLUMN(NAME=~"premios_mejor_detalle.mora_credito~") COLUMN(NAME=~"premios_mejor_detalle.producc_real~") COLUMN(NAME=~"premios_mejor_detalle.tipo_premio~") COLUMN(NAME=~"premios_mejor_detalle.fecha_fin~") COLUMN(NAME=~"agentes.nombre~") COLUMN(NAME=~"agentes.a_paterno~") COLUMN(NAME=~"agentes.a_materno~") COLUMN(NAME=~"premios_mejor_detalle.parque_age~") COLUMN(NAME=~"cadena.rut~")    JOIN (LEFT=~"premios_mejor_detalle.cod_age~"    OP =~"=~"RIGHT=~"agentes.cod_age~" )    JOIN (LEFT=~"premios_mejor_detalle.base~"    OP =~"=~"RIGHT=~"cadena.codigo~" )    JOIN (LEFT=~"premios_mejor_detalle.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"premios_mejor_detalle.numero~"    OP =~"=~"RIGHT=~"cadena.numero~" )WHERE(    EXP1 =~"~~~"PREMIOS_MEJOR_DETALLE~~~".~~~"FECHA_FIN~~~"~"   OP =~"=~"    EXP2 =~":fecha_fin~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"PREMIOS_MEJOR_DETALLE~~~".~~~"PARQUE_SUP~~~"~"   OP =~"=~"    EXP2 =~":parque~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"PREMIOS_MEJOR_DETALLE~~~".~~~"TIPO_PREMIO~~~"~"   OP =~"=~"    EXP2 =~":tipo_premio~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"PREMIOS_MEJOR_DETALLE~~~".~~~"COD_AGE~~~"~"   OP =~"=~"    EXP2 =~":codigo~" ) ) ARG(NAME = ~"fecha_fin~" TYPE = datetime)  ARG(NAME = ~"parque~" TYPE = number)  ARG(NAME = ~"tipo_premio~" TYPE = number)  ARG(NAME = ~"codigo~" TYPE = string) " arguments=(("fecha_fin", datetime),("parque", number),("tipo_premio", number),("codigo", string)) )
