 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"oferta_v~" )  TABLE(NAME=~"pago_oferta~" )  TABLE(NAME=~"cadena~" ) COLUMN(NAME=~"oferta_v.serie~") COLUMN(NAME=~"oferta_v.nro_oferta~") COLUMN(NAME=~"oferta_v.cod_age~") COLUMN(NAME=~"oferta_v.cod_sup~") COLUMN(NAME=~"pago_oferta.sector~") COLUMN(NAME=~"pago_oferta.area~") COLUMN(NAME=~"oferta_v.tipo_sepult~") COLUMN(NAME=~"oferta_v.tipo_cons~") COLUMN(NAME=~"pago_oferta.capacidad~") COLUMN(NAME=~"pago_oferta.precio~") COLUMN(NAME=~"pago_oferta.fecha_prim~") COLUMN(NAME=~"pago_oferta.moneda~") COLUMN(NAME=~"pago_oferta.uf_dia~") COLUMN(NAME=~"pago_oferta.nro_cuotas~") COLUMN(NAME=~"oferta_v.cta_pag_s~") COLUMN(NAME=~"oferta_v.uso~")    JOIN (LEFT=~"oferta_v.serie~"    OP =~"=~"RIGHT=~"pago_oferta.serie~" )    JOIN (LEFT=~"oferta_v.nro_oferta~"    OP =~"=~"RIGHT=~"pago_oferta.nro_oferta~" )    JOIN (LEFT=~"oferta_v.ult_folio~"    OP =~"=~"RIGHT=~"pago_oferta.folio~" )    JOIN (LEFT=~"pago_oferta.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"pago_oferta.nro_oferta~"    OP =~"=~"RIGHT=~"cadena.numero~" )WHERE(    EXP1 =~"( ( ~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'O' )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"OFERTA_V~~~".~~~"U_FECHA~~~"~"   OP =~">=~"    EXP2 =~":fecha )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"OFERTA_V~~~".~~~"U_FECHA~~~"~"   OP =~"<=~"    EXP2 =~":fecha_term )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"OFERTA_V~~~".~~~"SERIE~~~"~"   OP =~"<>~"    EXP2 =~"'R' )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"OFERTA_V~~~".~~~"USO~~~"~"   OP =~"=~"    EXP2 =~"'NF' ) )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"OFERTA_V~~~".~~~"COD_AGE~~~"~"   OP =~"<>~"    EXP2 =~"'C'~" ) ) ORDER(NAME=~"oferta_v.cod_age~" ASC=yes ) ARG(NAME = ~"fecha~" TYPE = date)  ARG(NAME = ~"fecha_term~" TYPE = date) " filter=" mora <=1" arguments=(("fecha", date),("fecha_term", date))  sort="sum_sum_precio D oferta_v_cod_age A " )
