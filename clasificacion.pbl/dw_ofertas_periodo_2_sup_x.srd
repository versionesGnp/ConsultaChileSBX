 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"oferta_v~" )  TABLE(NAME=~"pago_oferta~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"supervisor~" ) COLUMN(NAME=~"oferta_v.serie~") COLUMN(NAME=~"oferta_v.nro_oferta~") COLUMN(NAME=~"oferta_v.fecha~") COLUMN(NAME=~"oferta_v.cod_age~") COLUMN(NAME=~"oferta_v.cod_sup~") COLUMN(NAME=~"oferta_v.tot_pagado~") COLUMN(NAME=~"pago_oferta.moneda~") COLUMN(NAME=~"pago_oferta.precio~") COLUMN(NAME=~"pago_oferta.uf_dia~") COLUMN(NAME=~"oferta_v.u_folio~") COLUMN(NAME=~"oferta_v.u_fecha~") COMPUTE(NAME=~"0~") COMPUTE(NAME=~"0~") COLUMN(NAME=~"oferta_v.cta_pag_s~") COLUMN(NAME=~"pago_oferta.fecha_prim~") COLUMN(NAME=~"pago_oferta.nro_cuotas~") COMPUTE(NAME=~"0~") COLUMN(NAME=~"oferta_v.estado_comi~") COMPUTE(NAME=~"0~") COLUMN(NAME=~"oferta_v.rut~") COLUMN(NAME=~"pago_oferta.fecha_ult~") COLUMN(NAME=~"oferta_v.forma_pago~") COLUMN(NAME=~"pago_oferta.pie_pagado~") COLUMN(NAME=~"supervisor.cod_sup~") COLUMN(NAME=~"supervisor.nombre~") COLUMN(NAME=~"supervisor.a_paterno~") COLUMN(NAME=~"supervisor.a_materno~") COLUMN(NAME=~"supervisor.clasifica~") COLUMN(NAME=~"supervisor.cod_jefe~") COLUMN(NAME=~"supervisor.canal~")    JOIN (LEFT=~"oferta_v.serie~"    OP =~"=~"RIGHT=~"pago_oferta.serie~" )    JOIN (LEFT=~"oferta_v.nro_oferta~"    OP =~"=~"RIGHT=~"pago_oferta.nro_oferta~" )    JOIN (LEFT=~"oferta_v.ult_folio~"    OP =~"=~"RIGHT=~"pago_oferta.folio~" )    JOIN (LEFT=~"oferta_v.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"oferta_v.nro_oferta~"    OP =~"=~"RIGHT=~"cadena.numero~" )    JOIN (LEFT=~"supervisor.cod_sup~"    OP =~"=~"RIGHT=~"oferta_v.cod_sup~" )WHERE(    EXP1 =~"((~~~"PAGO_OFERTA~~~".~~~"FECHA_PRIM~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"PAGO_OFERTA~~~".~~~"FECHA_PRIM~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin ))~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"OFERTA_V~~~".~~~"COD_SUP~~~"~"   OP =~"=~"    EXP2 =~":AGENTE~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'O'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"OFERTA_V~~~".~~~"TOT_PAGADO~~~"~"   OP =~">~"    EXP2 =~"0~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"OFERTA_V~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~"'I'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"OFERTA_V~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~"'M'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"OFERTA_V~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~"'S')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"CADENA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'C'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'V')~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = date)  ARG(NAME = ~"fecha_fin~" TYPE = date)  ARG(NAME = ~"AGENTE~" TYPE = string) " arguments=(("fecha_ini", date),("fecha_fin", date),("AGENTE", string))  sort="oferta_v_u_fecha A " )
