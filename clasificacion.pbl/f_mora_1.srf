global type f_mora_1 from function_object
end type

forward prototypes
global function integer f_mora_1 (date primer, double pag, double cuotas)
end prototypes

global function integer f_mora_1 (date primer, double pag, double cuotas);double vmes,vano,vcuo_venc,vmora
		  	  
vano = year(date('16/06/200')) - year(DATE(primer))
vano = vano*12	 
vmes = month(date('16/06/200')) - month(DATE(primer))
vcuo_venc = vano + vmes
if day(date('16/06/200'))+5 > day(DATE(Primer)) then
	vcuo_venc = vcuo_venc + 1
end if
if vcuo_venc < 0 then
	vcuo_venc = 0
end if
if vcuo_venc > cuotas then
	vcuo_venc = cuotas
end if
vmora = vcuo_venc - pag
if vmora < 0 then vmora = 0
return(vmora)



               

end function

