 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"oferta_v~" )  TABLE(NAME=~"pago_oferta~" )  TABLE(NAME=~"agentes~" )  TABLE(NAME=~"meta_super~" )  TABLE(NAME=~"ingreso_aux~" ) COLUMN(NAME=~"oferta_v.serie~") COLUMN(NAME=~"oferta_v.nro_oferta~") COLUMN(NAME=~"oferta_v.fecha~") COLUMN(NAME=~"oferta_v.cod_age~") COLUMN(NAME=~"oferta_v.cod_sup~") COLUMN(NAME=~"oferta_v.tot_pagado~") COLUMN(NAME=~"pago_oferta.moneda~") COLUMN(NAME=~"pago_oferta.precio~") COLUMN(NAME=~"pago_oferta.uf_dia~") COLUMN(NAME=~"meta_super.tipo_canal~") COLUMN(NAME=~"ingreso_aux.fecha_pago~") COLUMN(NAME=~"meta_super.abono~") COLUMN(NAME=~"agentes.cod_sup~") COLUMN(NAME=~"agentes.cod_age~") COLUMN(NAME=~"ingreso_aux.folio~")    JOIN (LEFT=~"oferta_v.serie~"    OP =~"=~"RIGHT=~"pago_oferta.serie~" )    JOIN (LEFT=~"oferta_v.nro_oferta~"    OP =~"=~"RIGHT=~"pago_oferta.nro_oferta~" )    JOIN (LEFT=~"oferta_v.ult_folio~"    OP =~"=~"RIGHT=~"pago_oferta.folio~" )    JOIN (LEFT=~"oferta_v.cod_age~"    OP =~"=~"RIGHT=~"agentes.cod_age~" )    JOIN (LEFT=~"agentes.cod_sup~"    OP =~"=~"RIGHT=~"meta_super.cod_sup~" )    JOIN (LEFT=~"ingreso_aux.serie~"    OP =~"=~"RIGHT=~"oferta_v.serie~" )    JOIN (LEFT=~"ingreso_aux.contrato~"    OP =~"=~"RIGHT=~"oferta_v.nro_oferta~" )WHERE(    EXP1 =~"( ( ~~~"INGRESO_AUX~~~".~~~"FECHA_PAGO~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"INGRESO_AUX~~~".~~~"FECHA_PAGO~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin ))~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"INGRESO_AUX~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~"'O'  )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"((~~~"INGRESO_AUX~~~".~~~"TIPO_MOV~~~"~"   OP =~"=~"    EXP2 =~"'A')~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"(~~~"INGRESO_AUX~~~".~~~"TIPO_MOV~~~"~"   OP =~"=~"    EXP2 =~"'E')~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"(~~~"INGRESO_AUX~~~".~~~"TIPO_MOV~~~"~"   OP =~"=~"    EXP2 =~"'I')~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"(~~~"INGRESO_AUX~~~".~~~"TIPO_MOV~~~"~"   OP =~"=~"    EXP2 =~"'K'))~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"OFERTA_V~~~".~~~"COD_AGE~~~"~"   OP =~"=~"    EXP2 =~":AGENTE~" ) ) ORDER(NAME=~"meta_super.tipo_canal~" ASC=yes )  ORDER(NAME=~"agentes.cod_sup~" ASC=yes ) ARG(NAME = ~"fecha_ini~" TYPE = date)  ARG(NAME = ~"fecha_fin~" TYPE = datetime)  ARG(NAME = ~"AGENTE~" TYPE = string) " arguments=(("fecha_ini", date),("fecha_fin", datetime),("AGENTE", string))  sort="meta_super_tipo_canal A agentes_cod_sup A agentes_cod_age A " )
