 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"seguro_rechazos~" )  TABLE(NAME=~"sol_estatus~" )  TABLE(NAME=~"sol_seguro_desg~" ) COLUMN(NAME=~"sol_seguro_desg.nombre_contacto~") COLUMN(NAME=~"sol_seguro_desg.direccion_contacto~") COLUMN(NAME=~"sol_seguro_desg.comuna_contacto~") COLUMN(NAME=~"sol_seguro_desg.ciudad_contacto~") COLUMN(NAME=~"seguro_rechazos.fecha_recepcion~") COLUMN(NAME=~"sol_seguro_desg.nombre~") COLUMN(NAME=~"sol_seguro_desg.ap_paterno~") COLUMN(NAME=~"sol_seguro_desg.ap_materno~") COLUMN(NAME=~"seguro_rechazos.base~") COLUMN(NAME=~"seguro_rechazos.serie~") COLUMN(NAME=~"seguro_rechazos.numero~") COLUMN(NAME=~"seguro_rechazos.motivo_rechazo~")    JOIN (LEFT=~"seguro_rechazos.base~"    OP =~"=~"RIGHT=~"sol_estatus.base~" )    JOIN (LEFT=~"sol_estatus.base~"    OP =~"=~"RIGHT=~"sol_seguro_desg.base~" )    JOIN (LEFT=~"seguro_rechazos.serie~"    OP =~"=~"RIGHT=~"sol_estatus.serie~" )    JOIN (LEFT=~"seguro_rechazos.numero~"    OP =~"=~"RIGHT=~"sol_estatus.numero~" )    JOIN (LEFT=~"sol_estatus.serie~"    OP =~"=~"RIGHT=~"sol_seguro_desg.serie~" )    JOIN (LEFT=~"sol_estatus.numero~"    OP =~"=~"RIGHT=~"sol_seguro_desg.numero~" )    JOIN (LEFT=~"sol_estatus.correlativo~"    OP =~"=~"RIGHT=~"sol_seguro_desg.correlativo~" )WHERE(    EXP1 =~"~~~"SEGURO_RECHAZOS~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SEGURO_RECHAZOS~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SEGURO_RECHAZOS~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"CORRELATIVO~~~"~"   OP =~"=~"    EXP2 =~":correlativo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"CODIGO_SOLICITUD~~~"~"   OP =~"=~"    EXP2 =~"'4'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"SEGURO_RECHAZOS~~~".~~~"FECHA_CREA~~~"~"   OP =~"=~"    EXP2 =~"(SELECT MAX(~~~"SEGURO_RECHAZOS~~~".~~~"FECHA_CREA~~~") FROM ~~~"SEGURO_RECHAZOS~~~" WHERE ( ~~~"SEGURO_RECHAZOS~~~".~~~"BASE~~~" = :base ) AND ( ~~~"SEGURO_RECHAZOS~~~".~~~"SERIE~~~" = :serie ) AND ( ~~~"SEGURO_RECHAZOS~~~".~~~"NUMERO~~~" = :numero ) )~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number)  ARG(NAME = ~"correlativo~" TYPE = number) " arguments=(("base", string),("serie", string),("numero", number),("correlativo", number)) )
