 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"gestion_cobranza~" )  TABLE(NAME=~"ingreso~" )  TABLE(NAME=~"tele_log~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"cadena_mora~" ) COLUMN(NAME=~"gestion_cobranza.base~") COLUMN(NAME=~"gestion_cobranza.serie~") COLUMN(NAME=~"gestion_cobranza.numero~") COLUMN(NAME=~"gestion_cobranza.fecha_asignacion~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"cadena_mora.mora_cred~") COLUMN(NAME=~"cadena_mora.dias_mora_cred~") COLUMN(NAME=~"cadena_mora.fecha_venc_cred~") COLUMN(NAME=~"cadena_mora.mora_mant~") COLUMN(NAME=~"cadena_mora.dias_mora_mant~") COLUMN(NAME=~"cadena_mora.fecha_venc_mant~") COLUMN(NAME=~"cadena_mora.fallecidos~") COLUMN(NAME=~"tele_log.estado~") COLUMN(NAME=~"tele_log.fecha~") COLUMN(NAME=~"tele_log.glosa~") COLUMN(NAME=~"ingreso.tipo_cob~") COLUMN(NAME=~"ingreso.folio~") COLUMN(NAME=~"ingreso.fecha_pago~") COLUMN(NAME=~"ingreso.tipo_mov~") COLUMN(NAME=~"ingreso.monto~") COLUMN(NAME=~"ingreso.cuotas_pag~") COLUMN(NAME=~"ingreso.valor_uf~")    JOIN (LEFT=~"gestion_cobranza.base~"    OP =~"=~"RIGHT=~"tele_log.base~" )    JOIN (LEFT=~"gestion_cobranza.serie~"    OP =~"=~"RIGHT=~"tele_log.serie~" )    JOIN (LEFT=~"gestion_cobranza.numero~"    OP =~"=~"RIGHT=~"tele_log.numero~" )    JOIN (LEFT=~"tele_log.base~"    OP =~"=~"RIGHT=~"ingreso.base~" )    JOIN (LEFT=~"tele_log.serie~"    OP =~"=~"RIGHT=~"ingreso.serie~" )    JOIN (LEFT=~"tele_log.numero~"    OP =~"=~"RIGHT=~"ingreso.contrato~" )    JOIN (LEFT=~"gestion_cobranza.base~"    OP =~"=~"RIGHT=~"cadena.codigo~" )    JOIN (LEFT=~"gestion_cobranza.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"gestion_cobranza.numero~"    OP =~"=~"RIGHT=~"cadena.numero~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"cadena_mora.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"cadena_mora.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"cadena_mora.numero~" )WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"FECHA_PAGO~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"FECHA_PAGO~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"GESTION_COBRANZA~~~".~~~"USUARIO_ASIGNADO~~~"~"   OP =~"=~"    EXP2 =~":usuario~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"TELE_LOG~~~".~~~"FECHA~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"TELE_LOG~~~".~~~"FECHA~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = datetime)  ARG(NAME = ~"fecha_fin~" TYPE = datetime)  ARG(NAME = ~"usuario~" TYPE = string) " arguments=(("fecha_ini", datetime),("fecha_fin", datetime),("usuario", string))  sort="ingreso_tipo_cob A ingreso_folio A ingreso_tipo_mov A " )
