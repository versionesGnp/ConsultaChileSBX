 column=(type=datetime updatewhereclause=yes name=ingreso_fecha_sistema dbname="ingreso.fecha_sistema" )
 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"ingreso~" )  TABLE(NAME=~"cod_movi~" )  TABLE(NAME=~"cod_pago~" ) COLUMN(NAME=~"ingreso.folio~") COLUMN(NAME=~"ingreso.tipo_cob~") COLUMN(NAME=~"ingreso.fecha_pago~") COLUMN(NAME=~"ingreso.tipo_mov~") COLUMN(NAME=~"ingreso.cuotas_pag~") COLUMN(NAME=~"ingreso.monto~") COLUMN(NAME=~"ingreso.pago_hist~") COLUMN(NAME=~"ingreso.valor_uf~") COLUMN(NAME=~"cod_pago.descripcion~") COLUMN(NAME=~"cod_movi.sigla~") COLUMN(NAME=~"ingreso.cod_caja~") COLUMN(NAME=~"ingreso.codigo_otro~") COLUMN(NAME=~"ingreso.servipag~") COLUMN(NAME=~"ingreso.fecha_sistema~")    JOIN (LEFT=~"ingreso.tipo_cob~"    OP =~"=~"RIGHT=~"cod_pago.tipo_cob~"    OUTER1 =~"ingreso.tipo_cob~" )    JOIN (LEFT=~"ingreso.tipo_mov~"    OP =~"=~"RIGHT=~"cod_movi.cod_ing~"    OUTER1 =~"ingreso.tipo_mov~" )WHERE(    EXP1 =~"( ( ~~~"INGRESO~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"INGRESO~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"INGRESO~~~".~~~"CONTRATO~~~"~"   OP =~"=~"    EXP2 =~":numero )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"INGRESO~~~".~~~"FECHA_PAGO~~~"~"   OP =~">=~"    EXP2 =~":fec_ini )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"INGRESO~~~".~~~"FECHA_PAGO~~~"~"   OP =~"<=~"    EXP2 =~":fec_fin ) )~" ) ) ORDER(NAME=~"ingreso.fecha_pago~" ASC=yes ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number)  ARG(NAME = ~"fec_ini~" TYPE = datetime)  ARG(NAME = ~"fec_fin~" TYPE = datetime) " arguments=(("base", string),("serie", string),("numero", number),("fec_ini", datetime),("fec_fin", datetime))  sort="fecha_pago D " )
