 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"vista_listado_mora_cred_mant~" )  TABLE(NAME=~"cliente~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"cod_parq~" )  TABLE(NAME=~"vista_fecha_ultimo_pago~" ) COLUMN(NAME=~"vista_listado_mora_cred_mant.codigo~") COLUMN(NAME=~"vista_listado_mora_cred_mant.descripcion~") COLUMN(NAME=~"vista_listado_mora_cred_mant.serie~") COLUMN(NAME=~"vista_listado_mora_cred_mant.numero~") COLUMN(NAME=~"vista_listado_mora_cred_mant.estado~") COLUMN(NAME=~"vista_listado_mora_cred_mant.nombre_estado~") COLUMN(NAME=~"vista_listado_mora_cred_mant.mora_cred~") COLUMN(NAME=~"vista_listado_mora_cred_mant.dias_mora_cred~") COLUMN(NAME=~"vista_listado_mora_cred_mant.fecha_venc_cred~") COLUMN(NAME=~"vista_listado_mora_cred_mant.mora_mant~") COLUMN(NAME=~"vista_listado_mora_cred_mant.dias_mora_mant~") COLUMN(NAME=~"vista_listado_mora_cred_mant.fecha_venc_mant~") COLUMN(NAME=~"vista_listado_mora_cred_mant.fallecidos~") COLUMN(NAME=~"vista_listado_mora_cred_mant.rut~") COLUMN(NAME=~"vista_listado_mora_cred_mant.dv~") COLUMN(NAME=~"vista_listado_mora_cred_mant.nombre~") COLUMN(NAME=~"vista_listado_mora_cred_mant.a_paterno~") COLUMN(NAME=~"vista_listado_mora_cred_mant.a_materno~") COLUMN(NAME=~"vista_listado_mora_cred_mant.direccion_p~") COLUMN(NAME=~"vista_listado_mora_cred_mant.codigo_ciudad~") COLUMN(NAME=~"vista_listado_mora_cred_mant.ciudad~") COLUMN(NAME=~"vista_listado_mora_cred_mant.codigo_comuna~") COLUMN(NAME=~"vista_listado_mora_cred_mant.comuna~") COLUMN(NAME=~"vista_listado_mora_cred_mant.fono_p~") COLUMN(NAME=~"vista_listado_mora_cred_mant.fono_c~") COLUMN(NAME=~"vista_listado_mora_cred_mant.estado_cobranza~") COLUMN(NAME=~"vista_listado_mora_cred_mant.fecha_cobranza~") COLUMN(NAME=~"vista_listado_mora_cred_mant.glosa_cobranza~") COLUMN(NAME=~"vista_listado_mora_cred_mant.estado_titular~") COLUMN(NAME=~"vista_listado_mora_cred_mant.fecha_prox_llamado~") COMPUTE(NAME=~"0~") COLUMN(NAME=~"cliente.asignado_cobranza~") COLUMN(NAME=~"vista_listado_mora_cred_mant.estado_comi~") COLUMN(NAME=~"vista_listado_mora_cred_mant.ctas_pag_s~") COLUMN(NAME=~"vista_listado_mora_cred_mant.plazo~") COLUMN(NAME=~"vista_listado_mora_cred_mant.tipo_venta~") COLUMN(NAME=~"cadena.cod_parque~") COLUMN(NAME=~"cod_parq.nombre~") COLUMN(NAME=~"vista_listado_mora_cred_mant.mora_cred_pie~") COLUMN(NAME=~"vista_listado_mora_cred_mant.dias_mora_pie~") COLUMN(NAME=~"vista_listado_mora_cred_mant.ctas_pactadas_pie~") COLUMN(NAME=~"vista_listado_mora_cred_mant.ctas_pagadas_pie~") COLUMN(NAME=~"vista_listado_mora_cred_mant.canal~") COLUMN(NAME=~"vista_listado_mora_cred_mant.moneda~") COLUMN(NAME=~"vista_listado_mora_cred_mant.pie~") COMPUTE(NAME=~"''~") COLUMN(NAME=~"vista_fecha_ultimo_pago.fecha_ult_pago~") COMPUTE(NAME=~"TO_DATE('01-01-1901 00:00:00','DD-MM-YYYY HH24:MI:SS') as fecha_tope_digitada~")    JOIN (LEFT=~"vista_listado_mora_cred_mant.codigo~"    OP =~"=~"RIGHT=~"vista_fecha_ultimo_pago.base~"    OUTER1 =~"vista_listado_mora_cred_mant.codigo~" )    JOIN (LEFT=~"vista_listado_mora_cred_mant.serie~"    OP =~"=~"RIGHT=~"vista_fecha_ultimo_pago.serie~"    OUTER1 =~"vista_listado_mora_cred_mant.serie~" )    JOIN (LEFT=~"vista_listado_mora_cred_mant.numero~"    OP =~"=~"RIGHT=~"vista_fecha_ultimo_pago.numero~"    OUTER1 =~"vista_listado_mora_cred_mant.numero~" )    JOIN (LEFT=~"vista_listado_mora_cred_mant.rut~"    OP =~"=~"RIGHT=~"cliente.rut~" )    JOIN (LEFT=~"vista_listado_mora_cred_mant.codigo~"    OP =~"=~"RIGHT=~"cadena.codigo~" )    JOIN (LEFT=~"vista_listado_mora_cred_mant.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"vista_listado_mora_cred_mant.numero~"    OP =~"=~"RIGHT=~"cadena.numero~" )    JOIN (LEFT=~"cadena.cod_parque~"    OP =~"=~"RIGHT=~"cod_parq.codigo~" )WHERE(    EXP1 =~"~~~"VISTA_LISTADO_MORA_CRED_MANT~~~".~~~"FECHA_PROX_LLAMADO~~~"~"   OP =~"<~"    EXP2 =~":fecha~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~" ) ) ARG(NAME = ~"fecha~" TYPE = date)  ARG(NAME = ~"parque~" TYPE = number) " arguments=(("fecha", date),("parque", number))  sort="rut A codigo A " )
