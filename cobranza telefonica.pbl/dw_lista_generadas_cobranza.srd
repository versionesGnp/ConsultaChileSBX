table(column=(type=decimal(4) update=yes updatewhereclause=yes name=codigo dbname="gestion_lista.codigo" )
 column=(type=datetime update=yes updatewhereclause=yes name=fecha dbname="gestion_lista.fecha" )
 column=(type=char(800) update=yes updatewhereclause=yes name=observacion dbname="gestion_lista.observacion" )
 column=(type=char(15) update=yes updatewhereclause=yes name=usuario dbname="gestion_lista.usuario" )
 column=(type=char(1) update=yes updatewhereclause=yes name=estado dbname="gestion_lista.estado" )
 column=(type=char(15) update=yes updatewhereclause=yes name=usuario_asignado dbname="gestion_lista.usuario_asignado" )
 column=(type=char(41) updatewhereclause=yes name=cartera dbname="cartera" )
 column=(type=char(500) updatewhereclause=yes name=gestion_porce_comis_descripcion dbname="gestion_porce_comis.descripcion" )
 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"gestion_lista~" )  TABLE(NAME=~"encargados~" )  TABLE(NAME=~"gestion_porce_comis~" ) COLUMN(NAME=~"gestion_lista.codigo~") COLUMN(NAME=~"gestion_lista.fecha~") COLUMN(NAME=~"gestion_lista.observacion~") COLUMN(NAME=~"gestion_lista.usuario~") COLUMN(NAME=~"gestion_lista.estado~") COLUMN(NAME=~"gestion_lista.usuario_asignado~") COMPUTE(NAME=~"TRIM(to_char(~~~"GESTION_LISTA~~~".~~~"CARTERA_COBRANZA~~~" || '' || to_char(~~~"GESTION_LISTA~~~".~~~"INDICE_CARTERA~~~"))) AS CARTERA~") COLUMN(NAME=~"gestion_porce_comis.descripcion~")    JOIN (LEFT=~"gestion_lista.usuario~"    OP =~"=~"RIGHT=~"encargados.codigo_usuario~" )    JOIN (LEFT=~"gestion_lista.cartera_cobranza~"    OP =~"=~"RIGHT=~"gestion_porce_comis.cartera_cobranza~" )    JOIN (LEFT=~"gestion_lista.indice_cartera~"    OP =~"=~"RIGHT=~"gestion_porce_comis.indice_cartera~" )WHERE(    EXP1 =~"(~~~"GESTION_LISTA~~~".~~~"FECHA~~~"~"   OP =~">=~"    EXP2 =~":fec_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"GESTION_LISTA~~~".~~~"FECHA~~~"~"   OP =~"<=~"    EXP2 =~":fec_fin~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"GESTION_LISTA~~~".~~~"USUARIO~~~"~"   OP =~"=~"    EXP2 =~":usuario_asignador)~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"(~~~"GESTION_LISTA~~~".~~~"FECHA~~~"~"   OP =~">=~"    EXP2 =~":fec_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"GESTION_LISTA~~~".~~~"FECHA~~~"~"   OP =~"<=~"    EXP2 =~":fec_fin~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"ENCARGADOS~~~".~~~"DEPTO~~~"~"   OP =~"=~"    EXP2 =~"'I') ~" ) ) ARG(NAME = ~"fec_ini~" TYPE = date)  ARG(NAME = ~"fec_fin~" TYPE = date)  ARG(NAME = ~"usuario_asignador~" TYPE = string) " arguments=(("fec_ini", date),("fec_fin", date),("usuario_asignador", string))  sort="codigo A " )
