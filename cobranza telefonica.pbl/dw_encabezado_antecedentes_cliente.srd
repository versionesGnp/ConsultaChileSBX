table(column=(type=decimal(4) updatewhereclause=yes name=cliente_rut dbname="cliente.rut" )
 column=(type=char(1) updatewhereclause=yes name=cliente_dv dbname="cliente.dv" )
 column=(type=char(40) updatewhereclause=yes name=cliente_nombre dbname="cliente.nombre" )
 column=(type=char(40) updatewhereclause=yes name=cliente_a_paterno dbname="cliente.a_paterno" )
 column=(type=char(40) updatewhereclause=yes name=cliente_a_materno dbname="cliente.a_materno" )
 column=(type=char(60) updatewhereclause=yes name=cliente_direccion_p dbname="cliente.direccion_p" )
 column=(type=char(60) updatewhereclause=yes name=cliente_poblacion dbname="cliente.poblacion" )
 column=(type=char(10) updatewhereclause=yes name=ciudad_codigo_ciudad dbname="ciudad.codigo_ciudad" )
 column=(type=char(90) updatewhereclause=yes name=ciudad_ciudad dbname="ciudad.ciudad" )
 column=(type=char(10) updatewhereclause=yes name=comuna_codigo_comuna dbname="comuna.codigo_comuna" )
 column=(type=char(90) updatewhereclause=yes name=comuna_comuna dbname="comuna.comuna" )
 column=(type=char(25) updatewhereclause=yes name=cliente_fono_p dbname="cliente.fono_p" )
 column=(type=char(60) updatewhereclause=yes name=cliente_domicilio_c dbname="cliente.domicilio_c" )
 column=(type=char(25) updatewhereclause=yes name=cliente_fono_c dbname="cliente.fono_c" )
 column=(type=char(2) updatewhereclause=yes name=cliente_estado_cobranza dbname="cliente.estado_cobranza" )
 column=(type=datetime updatewhereclause=yes name=cliente_fecha_cobranza dbname="cliente.fecha_cobranza" )
 column=(type=char(500) updatewhereclause=yes name=cliente_glosa_cobranza dbname="cliente.glosa_cobranza" )
 column=(type=char(1) updatewhereclause=yes name=cliente_estado_titular dbname="cliente.estado_titular" values="0 - Activo	0/1 - Fallecido	1/" )
 column=(type=char(1) updatewhereclause=yes name=cliente_asignado_cobranza dbname="cliente.asignado_cobranza" values="Si	S/No	N/" )
 column=(type=datetime updatewhereclause=yes name=cliente_fecha_prox_llamado dbname="cliente.fecha_prox_llamado" )
 column=(type=char(5) updatewhereclause=yes name=cliente_tipo_via dbname="cliente.tipo_via" )
 column=(type=char(15) updatewhereclause=yes name=cliente_numero_particular dbname="cliente.numero_particular" )
 column=(type=char(15) updatewhereclause=yes name=cliente_depto_particular dbname="cliente.depto_particular" )
 column=(type=char(15) updatewhereclause=yes name=cliente_block_particular dbname="cliente.block_particular" )
 column=(type=char(25) updatewhereclause=yes name=cliente_celular dbname="cliente.celular" )
 column=(type=char(300) updatewhereclause=yes name=cliente_email dbname="cliente.email" )
 column=(type=datetime updatewhereclause=yes name=cliente_prox_llamado_cob dbname="cliente.prox_llamado_cob" )
 column=(type=datetime updatewhereclause=yes name=cliente_fecha_compromiso dbname="cliente.fecha_compromiso" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ciudad~" )  TABLE(NAME=~"cliente~" )  TABLE(NAME=~"comuna~" ) COLUMN(NAME=~"cliente.rut~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cliente.direccion_p~") COLUMN(NAME=~"cliente.poblacion~") COLUMN(NAME=~"ciudad.codigo_ciudad~") COLUMN(NAME=~"ciudad.ciudad~") COLUMN(NAME=~"comuna.codigo_comuna~") COLUMN(NAME=~"comuna.comuna~") COLUMN(NAME=~"cliente.fono_p~") COLUMN(NAME=~"cliente.domicilio_c~") COLUMN(NAME=~"cliente.fono_c~") COLUMN(NAME=~"cliente.estado_cobranza~") COLUMN(NAME=~"cliente.fecha_cobranza~") COLUMN(NAME=~"cliente.glosa_cobranza~") COLUMN(NAME=~"cliente.estado_titular~") COLUMN(NAME=~"cliente.asignado_cobranza~") COLUMN(NAME=~"cliente.fecha_prox_llamado~") COLUMN(NAME=~"cliente.tipo_via~") COLUMN(NAME=~"cliente.numero_particular~") COLUMN(NAME=~"cliente.depto_particular~") COLUMN(NAME=~"cliente.block_particular~") COLUMN(NAME=~"cliente.celular~") COLUMN(NAME=~"cliente.email~") COLUMN(NAME=~"cliente.prox_llamado_cob~") COLUMN(NAME=~"cliente.fecha_compromiso~")    JOIN (LEFT=~"ciudad.codigo_ciudad~"    OP =~"=~"RIGHT=~"cliente.ciudad~" )    JOIN (LEFT=~"cliente.comuna~"    OP =~"=~"RIGHT=~"comuna.codigo_comuna~" )WHERE(    EXP1 =~"~~~"CLIENTE~~~".~~~"RUT~~~"~"   OP =~"=~"    EXP2 =~":rut~" ) ) ARG(NAME = ~"rut~" TYPE = number) " arguments=(("rut", number)) )
