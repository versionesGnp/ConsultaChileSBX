 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"carta_log~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"cod_parq~" ) COLUMN(NAME=~"carta_log.base~") COLUMN(NAME=~"carta_log.serie~") COLUMN(NAME=~"carta_log.numero~") COLUMN(NAME=~"carta_log.rut~") COLUMN(NAME=~"carta_log.cod_envio~") COLUMN(NAME=~"carta_log.estado_env~") COLUMN(NAME=~"carta_log.fecha_carta~") COLUMN(NAME=~"carta_log.mora~") COLUMN(NAME=~"carta_log.cod_accion~") COLUMN(NAME=~"carta_log.correlativo~") COLUMN(NAME=~"carta_log.mora_mant~") COLUMN(NAME=~"carta_log.clasificacion~") COLUMN(NAME=~"cod_parq.nombre~")    JOIN (LEFT=~"carta_log.base~"    OP =~"=~"RIGHT=~"cadena.codigo~" )    JOIN (LEFT=~"carta_log.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"carta_log.numero~"    OP =~"=~"RIGHT=~"cadena.numero~" )    JOIN (LEFT=~"cadena.cod_parque~"    OP =~"=~"RIGHT=~"cod_parq.codigo~" )WHERE(    EXP1 =~"~~~"CARTA_LOG~~~".~~~"RUT~~~"~"   OP =~"=~"    EXP2 =~":rut~" ) ) ARG(NAME = ~"rut~" TYPE = number) " update="CARTA_LOG" updatewhere=0 updatekeyinplace=yes arguments=(("rut", number))  sort="fecha_carta D " )
