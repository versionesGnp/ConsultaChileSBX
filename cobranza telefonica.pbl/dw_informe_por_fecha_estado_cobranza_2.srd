 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"tele_log~" )  TABLE(NAME=~"cliente~" )  TABLE(NAME=~"oferta_v~" )  TABLE(NAME=~"anexo_liberador~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"cod_parq~" ) COLUMN(NAME=~"tele_log.rut~") COLUMN(NAME=~"tele_log.estado~") COLUMN(NAME=~"tele_log.fecha~") COLUMN(NAME=~"tele_log.glosa~") COLUMN(NAME=~"tele_log.usuario~") COLUMN(NAME=~"tele_log.base~") COLUMN(NAME=~"tele_log.serie~") COLUMN(NAME=~"tele_log.numero~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"oferta_v.cod_age~") COLUMN(NAME=~"oferta_v.cod_sup~") COLUMN(NAME=~"oferta_v.cod_jef~") COLUMN(NAME=~"anexo_liberador.cod_agente~") COLUMN(NAME=~"anexo_liberador.cod_super~") COLUMN(NAME=~"anexo_liberador.cod_jef~") COLUMN(NAME=~"cod_parq.nombre~")    JOIN (LEFT=~"tele_log.serie~"    OP =~"=~"RIGHT=~"oferta_v.serie~"    OUTER1 =~"tele_log.serie~" )    JOIN (LEFT=~"tele_log.numero~"    OP =~"=~"RIGHT=~"oferta_v.nro_oferta~"    OUTER1 =~"tele_log.numero~" )    JOIN (LEFT=~"tele_log.serie~"    OP =~"=~"RIGHT=~"anexo_liberador.serie_m~"    OUTER1 =~"tele_log.serie~" )    JOIN (LEFT=~"tele_log.numero~"    OP =~"=~"RIGHT=~"anexo_liberador.nro_liberador~"    OUTER1 =~"tele_log.numero~" )    JOIN (LEFT=~"tele_log.rut~"    OP =~"=~"RIGHT=~"cliente.rut~" )    JOIN (LEFT=~"tele_log.base~"    OP =~"=~"RIGHT=~"cadena.codigo~" )    JOIN (LEFT=~"tele_log.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"tele_log.numero~"    OP =~"=~"RIGHT=~"cadena.numero~" )    JOIN (LEFT=~"cadena.cod_parque~"    OP =~"=~"RIGHT=~"cod_parq.codigo~" )WHERE(    EXP1 =~"~~~"TELE_LOG~~~".~~~"FECHA~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"TELE_LOG~~~".~~~"FECHA~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"TELE_LOG~~~".~~~"ESTADO~~~"~"   OP =~"like~"    EXP2 =~":estado~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"TELE_LOG~~~".~~~"USUARIO~~~"~"   OP =~"like~"    EXP2 =~":usuario~" ) ) ORDER(NAME=~"tele_log.fecha~" ASC=yes )  ORDER(NAME=~"tele_log.estado~" ASC=yes ) ARG(NAME = ~"fecha_ini~" TYPE = datetime)  ARG(NAME = ~"fecha_fin~" TYPE = datetime)  ARG(NAME = ~"estado~" TYPE = string)  ARG(NAME = ~"usuario~" TYPE = string) " arguments=(("fecha_ini", datetime),("fecha_fin", datetime),("estado", string),("usuario", string))  sort="solo_fecha A tele_log_estado A " )
