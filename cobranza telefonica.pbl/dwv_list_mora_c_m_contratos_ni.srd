atos_ni.estado_cob_postventa~") COLUMN(NAME=~"vista_listado_contratos_ni.fecha_cob_postventa~") COLUMN(NAME=~"vista_listado_contratos_ni.glosa_cob_postventa~") COLUMN(NAME=~"vista_listado_contratos_ni.u_fecha~") COLUMN(NAME=~"vista_listado_contratos_ni.forma_pago~") COLUMN(NAME=~"vista_listado_contratos_ni.estatus_comision~") COLUMN(NAME=~"vista_listado_contratos_ni.tipo_venta~") COLUMN(NAME=~"vista_listado_contratos_ni.asignado_cobranza~") COLUMN(NAME=~"cliente.asignado_cobranza~") COLUMN(NAME=~"vista_listado_contratos_ni.uso~") COLUMN(NAME=~"cod_parq.nombre~") COLUMN(NAME=~"cadena.cod_parque~") COLUMN(NAME=~"vista_listado_contratos_ni.mora_cred_pie~") COLUMN(NAME=~"vista_listado_contratos_ni.dias_mora_cred_pie~")    JOIN (LEFT=~"cliente.rut~"    OP =~"=~"RIGHT=~"vista_listado_contratos_ni.rut~" )    JOIN (LEFT=~"vista_listado_contratos_ni.codigo~"    OP =~"=~"RIGHT=~"cadena.codigo~" )    JOIN (LEFT=~"vista_listado_contratos_ni.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"vista_listado_contratos_ni.numero~"    OP =~"=~"RIGHT=~"cadena.numero~" )    JOIN (LEFT=~"cadena.cod_parque~"    OP =~"=~"RIGHT=~"cod_parq.codigo~" )WHERE(    EXP1 =~"~~~"VISTA_LISTADO_CONTRATOS_NI~~~".~~~"FECHA_PROX_LLAMADO~~~"~"   OP =~"<=~"    EXP2 =~":fecha~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"VISTA_LISTADO_CONTRATOS_NI~~~".~~~"ASIGNADO_COBRANZA~~~"~"   OP =~"=~"    EXP2 =~"'N'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~" ) ) ARG(NAME = ~"fecha~" TYPE = date)  ARG(NAME = ~"parque~" TYPE = number) " arguments=(("fecha", date),("parque", number)) )
