table(column=(type=decimal(4) update=yes updatewhereclause=yes name=rut dbname="tele_log.rut" )
 column=(type=char(2) update=yes updatewhereclause=yes name=estado dbname="tele_log.estado" )
 column=(type=datetime update=yes updatewhereclause=yes name=fecha dbname="tele_log.fecha" )
 column=(type=char(500) update=yes updatewhereclause=yes name=glosa dbname="tele_log.glosa" )
 column=(type=char(15) update=yes updatewhereclause=yes name=usuario dbname="tele_log.usuario" )
 column=(type=char(1) update=yes updatewhereclause=yes name=base dbname="tele_log.base" )
 column=(type=char(1) update=yes updatewhereclause=yes name=serie dbname="tele_log.serie" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=numero dbname="tele_log.numero" )
 column=(type=char(20) updatewhereclause=yes name=cod_parq_nombre dbname="cod_parq.nombre" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"tele_log~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"cod_parq~" ) COLUMN(NAME=~"tele_log.rut~") COLUMN(NAME=~"tele_log.estado~") COLUMN(NAME=~"tele_log.fecha~") COLUMN(NAME=~"tele_log.glosa~") COLUMN(NAME=~"tele_log.usuario~") COLUMN(NAME=~"tele_log.base~") COLUMN(NAME=~"tele_log.serie~") COLUMN(NAME=~"tele_log.numero~") COLUMN(NAME=~"cod_parq.nombre~")    JOIN (LEFT=~"tele_log.base~"    OP =~"=~"RIGHT=~"cadena.codigo~" )    JOIN (LEFT=~"tele_log.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"tele_log.numero~"    OP =~"=~"RIGHT=~"cadena.numero~" )    JOIN (LEFT=~"cadena.cod_parque~"    OP =~"=~"RIGHT=~"cod_parq.codigo~" )WHERE(    EXP1 =~"~~~"TELE_LOG~~~".~~~"RUT~~~"~"   OP =~"=~"    EXP2 =~":rut~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"TELE_LOG~~~".~~~"FECHA~~~"~"   OP =~">=~"    EXP2 =~":fec_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"TELE_LOG~~~".~~~"FECHA~~~"~"   OP =~"<=~"    EXP2 =~":fec_fin~" ) ) ARG(NAME = ~"rut~" TYPE = number)  ARG(NAME = ~"fec_ini~" TYPE = datetime)  ARG(NAME = ~"fec_fin~" TYPE = datetime) " arguments=(("rut", number),("fec_ini", datetime),("fec_fin", datetime))  sort="fecha D " )
