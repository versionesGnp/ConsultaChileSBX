 column=(type=decimal(4) updatewhereclause=yes name=cadena_cod_parque dbname="cadena.cod_parque" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cliente~" )  TABLE(NAME=~"carta_log~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"cod_parq~" ) COLUMN(NAME=~"cliente.rut~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"carta_log.base~") COLUMN(NAME=~"carta_log.serie~") COLUMN(NAME=~"carta_log.numero~") COLUMN(NAME=~"carta_log.cod_envio~") COLUMN(NAME=~"carta_log.estado_env~") COLUMN(NAME=~"carta_log.fecha_carta~") COLUMN(NAME=~"carta_log.cod_accion~") COLUMN(NAME=~"carta_log.clasificacion~") COLUMN(NAME=~"carta_log.usuario~") COLUMN(NAME=~"carta_log.mora~") COLUMN(NAME=~"carta_log.mora_mant~") COLUMN(NAME=~"cod_parq.nombre~") COLUMN(NAME=~"cadena.cod_parque~")    JOIN (LEFT=~"cliente.rut~"    OP =~"=~"RIGHT=~"carta_log.rut~" )    JOIN (LEFT=~"carta_log.base~"    OP =~"=~"RIGHT=~"cadena.codigo~" )    JOIN (LEFT=~"carta_log.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"carta_log.numero~"    OP =~"=~"RIGHT=~"cadena.numero~" )    JOIN (LEFT=~"cadena.cod_parque~"    OP =~"=~"RIGHT=~"cod_parq.codigo~" )WHERE(    EXP1 =~"to_date(~~~"CARTA_LOG~~~".~~~"FECHA_CARTA~~~")~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"to_date(~~~"CARTA_LOG~~~".~~~"FECHA_CARTA~~~")~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = date)  ARG(NAME = ~"fecha_fin~" TYPE = date)  ARG(NAME = ~"parque~" TYPE = number) " arguments=(("fecha_ini", date),("fecha_fin", date),("parque", number))  sort="carta_log_estado_env A " )
