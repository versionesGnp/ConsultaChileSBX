 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"atencion_log~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"cod_parq~" ) COLUMN(NAME=~"atencion_log.rut~") COLUMN(NAME=~"atencion_log.estado~") COLUMN(NAME=~"atencion_log.fecha~") COLUMN(NAME=~"atencion_log.glosa~") COLUMN(NAME=~"atencion_log.usuario~") COLUMN(NAME=~"atencion_log.base~") COLUMN(NAME=~"atencion_log.serie~") COLUMN(NAME=~"atencion_log.numero~") COLUMN(NAME=~"cod_parq.nombre~")    JOIN (LEFT=~"atencion_log.base~"    OP =~"=~"RIGHT=~"cadena.codigo~" )    JOIN (LEFT=~"atencion_log.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"atencion_log.numero~"    OP =~"=~"RIGHT=~"cadena.numero~" )    JOIN (LEFT=~"cadena.cod_parque~"    OP =~"=~"RIGHT=~"cod_parq.codigo~" )WHERE(    EXP1 =~"~~~"ATENCION_LOG~~~".~~~"RUT~~~"~"   OP =~"=~"    EXP2 =~":rut~" ) ) ARG(NAME = ~"rut~" TYPE = number) " arguments=(("rut", number))  sort="fecha D " )
