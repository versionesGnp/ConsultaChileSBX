global type wf_buscar_cliente from function_object
end type

forward prototypes
global function string wf_buscar_cliente (long al_rut)
end prototypes

global function string wf_buscar_cliente (long al_rut);string	ls_nombre,ls_nom,ls_ap_pat,ls_ap_mat
SELECT	"CLIENTE"."NOMBRE",   
			"CLIENTE"."A_PATERNO",   
			"CLIENTE"."A_MATERNO"  
INTO		:ls_nom,   
			:ls_ap_pat,   
			:ls_ap_mat  
FROM 		"CLIENTE"  
WHERE 	"CLIENTE"."RUT" = :al_rut   
USING		sqlca;
if sqlca.sqlcode=0 then
	ls_nombre	= ls_nom+' '+ls_ap_pat+' '+ls_ap_mat
else
	ls_nombre	= '-'
end if
return(ls_nombre)
end function

