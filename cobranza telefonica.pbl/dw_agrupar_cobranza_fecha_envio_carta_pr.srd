table(column=(type=datetime updatewhereclause=yes name=compute_fecha dbname="compute_fecha" )
 column=(type=number updatewhereclause=yes name=compute_cantidad dbname="compute_cantidad" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"carta_log~" ) COLUMN(NAME=~"carta_log.estado_env~") COLUMN(NAME=~"carta_log.fecha_carta~") COMPUTE(NAME=~"to_date(fecha_carta),to_number(~~~"CARTA_LOG~~~".~~~"ESTADO_ENV~~~")~")WHERE(    EXP1 =~"~~~"CARTA_LOG~~~".~~~"FECHA_CARTA~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CARTA_LOG~~~".~~~"FECHA_CARTA~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = date)  ARG(NAME = ~"fecha_fin~" TYPE = date)  ARG(NAME = ~"parque~" TYPE = number) " arguments=(("fecha_ini", date),("fecha_fin", date),("parque", number))  sort="compute_fecha D " )
compute(band=header[1] alignment="2" expression="'Envio Carta  Fecha '+string( fecha_ini ,~"dd/mm/yyyy~")+' al '+string( fecha_fin ,~"dd/mm/yyyy~")"border="0" color="0" x="9" y="4" height="108" width="658" format="[GENERAL]"  name=compute_4  font.face="Arial" font.height="-8" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127" )
text(band=header[2] alignment="2" text="Fecha" border="6" color="33554432" x="9" y="4" height="56" width="654"  name=compute_fecha_t  font.face="Arial" font.height="-8" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" )
text(band=header[2] alignment="2" text="@compute_0004" border="6" color="33554432" x="672" y="4" height="56" width="206"  name=compute_cantidad_t  font.face="Arial" font.height="-8" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" )
text(band=header[2] alignment="2" text="Total " border="6" color="33554432" x="887" y="4" height="56" width="219"  name=grand_count_compute_0004_t  font.face="Arial" font.height="-8" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" )
column(band=detail id=1 alignment="2" tabsequence=32766 border="0" color="33554432" x="9" y="4" height="64" width="654" format="dd/mm/yyyy"  name=compute_fecha edit.limit=0 edit.case=any edit.focusrectangle=no edit.autoselect=no edit.autohscroll=yes  font.face="Arial" font.height="-8" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" )
column(band=detail id=2 alignment="2" tabsequence=32766 border="5" color="33554432" x="672" y="4" height="64" width="206" format="###,###,###,###,##0"  name=compute_cantidad edit.limit=0 edit.case=any edit.focusrectangle=no edit.autoselect=no edit.autohscroll=yes crosstab.repeat=yes  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
compute(band=detail alignment="1" expression="crosstabsum(1)"border="5" color="33554432" x="887" y="4" height="64" width="219" format="###,###,###,###,##0"  name=grand_count_compute_0004  font.face="Arial" font.height="-10" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127" )
