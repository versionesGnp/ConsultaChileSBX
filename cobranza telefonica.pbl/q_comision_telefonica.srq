PBSELECT( VERSION(400) TABLE(NAME="gestion_cobranza" )  TABLE(NAME="gestion_lista" )  TABLE(NAME="ingreso" ) COLUMN(NAME="ingreso.tipo_cob") COLUMN(NAME="ingreso.folio") COLUMN(NAME="gestion_cobranza.base") COLUMN(NAME="gestion_cobranza.serie") COLUMN(NAME="gestion_cobranza.numero") COLUMN(NAME="gestion_cobranza.usuario_asignado") COLUMN(NAME="gestion_cobranza.fecha_asignacion") COLUMN(NAME="ingreso.monto") COLUMN(NAME="ingreso.tipo_mov")    JOIN (LEFT="ingreso.base"    OP ="="RIGHT="gestion_cobranza.base" )    JOIN (LEFT="ingreso.serie"    OP ="="RIGHT="gestion_cobranza.serie" )    JOIN (LEFT="ingreso.contrato"    OP ="="RIGHT="gestion_cobranza.numero" )    JOIN (LEFT="gestion_cobranza.codigo_grupo"    OP ="="RIGHT="gestion_lista.codigo" )WHERE(    EXP1 ="~"GESTION_LISTA~".~"ESTADO~""   OP ="="    EXP2 ="'P'"    LOGIC ="And" ) WHERE(    EXP1 ="~"INGRESO~".~"FECHA_PAGO~""   OP =">="    EXP2 ="TO_DATE('01-06-2014 00:00:00','DD-MM-YYYY HH24:MI:SS')"    LOGIC ="And" ) WHERE(    EXP1 ="~"INGRESO~".~"FECHA_PAGO~""   OP ="<="    EXP2 ="TO_DATE('30-06-2014 00:00:00','DD-MM-YYYY HH24:MI:SS')"    LOGIC ="And" ) WHERE(    EXP1 ="~"INGRESO~".~"TIPO_MOV~""   OP ="="    EXP2 ="'A'" ) ) 