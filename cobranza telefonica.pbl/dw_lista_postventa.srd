 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cliente~" )  TABLE(NAME=~"tele_log_post_venta~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"cod_parq~" ) COLUMN(NAME=~"tele_log_post_venta.rut~") COLUMN(NAME=~"tele_log_post_venta.estado~") COLUMN(NAME=~"tele_log_post_venta.fecha~") COLUMN(NAME=~"tele_log_post_venta.glosa~") COLUMN(NAME=~"tele_log_post_venta.usuario~") COLUMN(NAME=~"tele_log_post_venta.base~") COLUMN(NAME=~"tele_log_post_venta.serie~") COLUMN(NAME=~"tele_log_post_venta.numero~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cliente.direccion_p~") COLUMN(NAME=~"cliente.poblacion~") COLUMN(NAME=~"cliente.comuna~") COLUMN(NAME=~"cliente.ciudad~") COLUMN(NAME=~"cliente.fono_p~") COLUMN(NAME=~"cliente.fono_c~") COLUMN(NAME=~"cliente.estado_titular~") COLUMN(NAME=~"cliente.tipo_via~") COLUMN(NAME=~"cliente.numero_particular~") COLUMN(NAME=~"cliente.depto_particular~") COLUMN(NAME=~"cliente.block_particular~") COLUMN(NAME=~"cod_parq.nombre~") COLUMN(NAME=~"cadena.cod_parque~")    JOIN (LEFT=~"cliente.rut~"    OP =~"=~"RIGHT=~"tele_log_post_venta.rut~" )    JOIN (LEFT=~"tele_log_post_venta.base~"    OP =~"=~"RIGHT=~"cadena.codigo~" )    JOIN (LEFT=~"tele_log_post_venta.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"tele_log_post_venta.numero~"    OP =~"=~"RIGHT=~"cadena.numero~" )    JOIN (LEFT=~"cadena.cod_parque~"    OP =~"=~"RIGHT=~"cod_parq.codigo~" )WHERE(    EXP1 =~"~~~"TELE_LOG_POST_VENTA~~~".~~~"RUT~~~"~"   OP =~"=~"    EXP2 =~":rut~" ) ) ARG(NAME = ~"rut~" TYPE = number) " arguments=(("rut", number)) )
