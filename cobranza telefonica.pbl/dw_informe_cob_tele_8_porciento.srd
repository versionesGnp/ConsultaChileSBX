 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"cadena~" )  TABLE(NAME=~"gestion_cobranza~" )  TABLE(NAME=~"oferta_v~" )  TABLE(NAME=~"pago_oferta~" )  TABLE(NAME=~"tele_log~" )  TABLE(NAME=~"ciudad~" )  TABLE(NAME=~"cliente~" )  TABLE(NAME=~"comuna~" )  TABLE(NAME=~"cadena_mora~" )  TABLE(NAME=~"agentes~" )  TABLE(NAME=~"jefe_ventas~" )  TABLE(NAME=~"supervisor~" )  TABLE(NAME=~"cod_parq~" ) COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"cadena.serie~") COLUMN(NAME=~"cadena.numero~") COLUMN(NAME=~"cadena.est_cup~") COLUMN(NAME=~"oferta_v.cod_age~") COLUMN(NAME=~"oferta_v.cod_sup~") COLUMN(NAME=~"oferta_v.cod_jef~") COLUMN(NAME=~"cliente.rut~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cliente.direccion_p~") COLUMN(NAME=~"cliente.fono_p~") COLUMN(NAME=~"cliente.fono_c~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"pago_oferta.valor_cuota~") COLUMN(NAME=~"pago_oferta.fecha_ult~") COLUMN(NAME=~"gestion_cobranza.mora_cred~") COLUMN(NAME=~"gestion_cobranza.fecha_venc_cred~") COLUMN(NAME=~"gestion_cobranza.dias_mora_cred~") COLUMN(NAME=~"gestion_cobranza.fallecidos~") COLUMN(NAME=~"ciudad.ciudad~") COLUMN(NAME=~"comuna.comuna~") COLUMN(NAME=~"oferta_v.cta_pag_s~") COLUMN(NAME=~"pago_oferta.nro_cuotas~") COLUMN(NAME=~"agentes.nombre~") COLUMN(NAME=~"agentes.a_paterno~") COLUMN(NAME=~"agentes.a_materno~") COLUMN(NAME=~"agentes.estado~") COLUMN(NAME=~"jefe_ventas.nombre~") COLUMN(NAME=~"jefe_ventas.a_paterno~") COLUMN(NAME=~"jefe_ventas.a_materno~") COLUMN(NAME=~"jefe_ventas.estado~") COLUMN(NAME=~"supervisor.nombre~") COLUMN(NAME=~"supervisor.a_paterno~") COLUMN(NAME=~"supervisor.a_materno~") COLUMN(NAME=~"supervisor.estado~") COLUMN(NAME=~"cod_parq.nombre~") COLUMN(NAME=~"oferta_v.uso~") COLUMN(NAME=~"pago_oferta.moneda~") COLUMN(NAME=~"oferta_v.tot_pagado~") COLUMN(NAME=~"pago_oferta.pie~") COLUMN(NAME=~"pago_oferta.precio~") COLUMN(NAME=~"gestion_cobranza.porce_facturado~") COLUMN(NAME=~"gestion_cobranza.porce_mora_cred~") COLUMN(NAME=~"gestion_cobranza.porce_suma~")    JOIN (LEFT=~"gestion_cobranza.serie~"    OP =~"=~"RIGHT=~"oferta_v.serie~" )    JOIN (LEFT=~"oferta_v.serie~"    OP =~"=~"RIGHT=~"pago_oferta.serie~" )    JOIN (LEFT=~"gestion_cobranza.numero~"    OP =~"=~"RIGHT=~"oferta_v.nro_oferta~" )    JOIN (LEFT=~"oferta_v.nro_oferta~"    OP =~"=~"RIGHT=~"pago_oferta.nro_oferta~" )    JOIN (LEFT=~"oferta_v.ult_folio~"    OP =~"=~"RIGHT=~"pago_oferta.folio~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"gestion_cobranza.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"gestion_cobranza.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"gestion_cobranza.numero~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"tele_log.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"tele_log.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"tele_log.numero~" )    JOIN (LEFT=~"tele_log.rut~"    OP =~"=~"RIGHT=~"cliente.rut~" )    JOIN (LEFT=~"cliente.ciudad~"    OP =~"=~"RIGHT=~"ciudad.codigo_ciudad~" )    JOIN (LEFT=~"cliente.comuna~"    OP =~"=~"RIGHT=~"comuna.codigo_comuna~" )    JOIN (LEFT=~"ciudad.codigo_ciudad~"    OP =~"=~"RIGHT=~"comuna.codigo_ciudad~" )    JOIN (LEFT=~"tele_log.base~"    OP =~"=~"RIGHT=~"cadena_mora.base~" )    JOIN (LEFT=~"tele_log.serie~"    OP =~"=~"RIGHT=~"cadena_mora.serie~" )    JOIN (LEFT=~"tele_log.numero~"    OP =~"=~"RIGHT=~"cadena_mora.numero~" )    JOIN (LEFT=~"agentes.cod_age~"    OP =~"=~"RIGHT=~"oferta_v.cod_age~" )    JOIN (LEFT=~"supervisor.cod_sup~"    OP =~"=~"RIGHT=~"oferta_v.cod_sup~" )    JOIN (LEFT=~"jefe_ventas.jefe_ventas~"    OP =~"=~"RIGHT=~"oferta_v.cod_jef~" )    JOIN (LEFT=~"cadena.cod_parque~"    OP =~"=~"RIGHT=~"cod_parq.codigo~" )WHERE(    EXP1 =~"~~~"TELE_LOG~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~"'O'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"TELE_LOG~~~".~~~"FECHA~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"TELE_LOG~~~".~~~"FECHA~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"GESTION_COBRANZA~~~".~~~"PORCE_FACTURADO~~~"~"   OP =~"<=~"    EXP2 =~"8~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"GESTION_COBRANZA~~~".~~~"PORCE_SUMA~~~"~"   OP =~">=~"    EXP2 =~"7~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = date)  ARG(NAME = ~"fecha_fin~" TYPE = date)  ARG(NAME = ~"parque~" TYPE = number) " arguments=(("fecha_ini", date),("fecha_fin", date),("parque", number))  sort="oferta_v_cod_jef A oferta_v_cod_sup A oferta_v_cod_age A " )
