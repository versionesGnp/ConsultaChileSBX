global type f_buscar_cliente_reprogramacion from function_object
end type

forward prototypes
global function string f_buscar_cliente_reprogramacion (long al_rut)
end prototypes

global function string f_buscar_cliente_reprogramacion (long al_rut);String	ls_nom_comp,ls_nombre,ls_ap_pat,ls_ap_mat

SELECT DISTINCT 	"CLIENTE_DEUDOR_TERCERO"."NOMBRE",   
						"CLIENTE_DEUDOR_TERCERO"."A_PATERNO",   
						"CLIENTE_DEUDOR_TERCERO"."A_MATERNO"  
INTO 					:ls_nombre,   
						:ls_ap_pat,   
						:ls_ap_mat  
FROM 					"CLIENTE_DEUDOR_TERCERO"  
WHERE 				"CLIENTE_DEUDOR_TERCERO"."RUT_TITULAR" = :al_rut   
USING		sqlca;
if sqlca.sqlcode<>0 then
	ls_nom_comp	= '-'
else
	ls_nom_comp	= ls_nombre+' '+ls_ap_pat+' '+ls_ap_mat
end if
return ls_nom_comp;

end function

