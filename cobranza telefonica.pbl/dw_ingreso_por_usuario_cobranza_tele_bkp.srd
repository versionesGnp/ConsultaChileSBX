obranza.estado_cobranza~") COLUMN(NAME=~"gestion_cobranza.fecha_cobranza~") COLUMN(NAME=~"gestion_cobranza.glosa_cobranza~") COLUMN(NAME=~"gestion_cobranza.estado_titular~") COLUMN(NAME=~"gestion_cobranza.fecha_prox_llamado~") COLUMN(NAME=~"gestion_cobranza.estatus_telefonico~") COLUMN(NAME=~"gestion_cobranza.estatus_carta~") COLUMN(NAME=~"gestion_cobranza.estatus_publico~") COLUMN(NAME=~"gestion_cobranza.usuario_asignado~") COLUMN(NAME=~"gestion_cobranza.usuario_asignador~") COLUMN(NAME=~"gestion_cobranza.codigo_grupo~") COLUMN(NAME=~"gestion_cobranza.estado_llamada~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"estado.nombre_estado~") COLUMN(NAME=~"tipo_contrato.descripcion~") COLUMN(NAME=~"cadena.cod_parque~") COLUMN(NAME=~"cod_parq.nombre~") COLUMN(NAME=~"gestion_cobranza.fecha_llamado~") COLUMN(NAME=~"gestion_cobranza.existe_pago~")    JOIN (LEFT=~"gestion_cobranza.base~"    OP =~"=~"RIGHT=~"cadena.codigo~" )    JOIN (LEFT=~"gestion_cobranza.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"gestion_cobranza.numero~"    OP =~"=~"RIGHT=~"cadena.numero~" )    JOIN (LEFT=~"gestion_cobranza.codigo_grupo~"    OP =~"=~"RIGHT=~"gestion_lista.codigo~" )    JOIN (LEFT=~"gestion_cobranza.base~"    OP =~"=~"RIGHT=~"tipo_contrato.codigo~" )    JOIN (LEFT=~"gestion_cobranza.estado~"    OP =~"=~"RIGHT=~"estado.cod_estado~" )    JOIN (LEFT=~"gestion_cobranza.rut~"    OP =~"=~"RIGHT=~"vista_listado_mora_cred_mant.rut~" )    JOIN (LEFT=~"cadena.cod_parque~"    OP =~"=~"RIGHT=~"cod_parq.codigo~" )WHERE(    EXP1 =~"~~~"GESTION_LISTA~~~".~~~"USUARIO_ASIGNADO~~~"~"   OP =~"=~"    EXP2 =~":usuario~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(SUBSTR(to_char(~~~"GESTION_COBRANZA~~~".~~~"FECHA_ASIGNACION~~~",'dd/mm/yyyy' ),4,7)~"   OP =~"=~"    EXP2 =~"SUBSTR(to_char(:fecha,'dd/mm/yyyy' ),4,7)~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"GESTION_COBRANZA~~~".~~~"FECHA_LLAMADO~~~"~"   OP =~"is~"    EXP2 =~"null)~" ) ) ORDER(NAME=~"gestion_lista.codigo~" ASC=yes )  ORDER(NAME=~"gestion_cobranza.base~" ASC=yes ) ARG(NAME = ~"usuario~" TYPE = string)  ARG(NAME = ~"fecha~" TYPE = date) " update="GESTION_COBRANZA" updatewhere=0 updatekeyinplace=yes arguments=(("usuario", string),("fecha", date))  sort="gestion_cobranza_base A gestion_cobranza_numero A " )
