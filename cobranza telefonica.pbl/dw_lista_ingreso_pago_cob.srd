table(column=(type=char(1) updatewhereclause=yes name=gestion_cobranza_base dbname="gestion_cobranza.base" )
 column=(type=char(1) updatewhereclause=yes name=gestion_cobranza_serie dbname="gestion_cobranza.serie" )
 column=(type=decimal(4) updatewhereclause=yes name=gestion_cobranza_numero dbname="gestion_cobranza.numero" )
 column=(type=datetime updatewhereclause=yes name=gestion_cobranza_fecha_asignacion dbname="gestion_cobranza.fecha_asignacion" )
 column=(type=char(15) updatewhereclause=yes name=gestion_cobranza_usuario_asignado dbname="gestion_cobranza.usuario_asignado" )
 column=(type=decimal(4) updatewhereclause=yes name=ingreso_monto dbname="ingreso.monto" )
 column=(type=decimal(2) updatewhereclause=yes name=ingreso_cuotas_pag dbname="ingreso.cuotas_pag" )
 column=(type=char(2) updatewhereclause=yes name=ingreso_tipo_mov dbname="ingreso.tipo_mov" )
 column=(type=datetime updatewhereclause=yes name=ingreso_fecha_pago dbname="ingreso.fecha_pago" )
 column=(type=decimal(4) updatewhereclause=yes name=ingreso_rut dbname="ingreso.rut" )
 column=(type=char(42) updatewhereclause=yes name=cod_cartera dbname="cod_cartera" )
 column=(type=char(800) updatewhereclause=yes name=gestion_lista_observacion dbname="gestion_lista.observacion" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"gestion_cobranza~" )  TABLE(NAME=~"ingreso~" )  TABLE(NAME=~"gestion_lista~" )  TABLE(NAME=~"at_ing_caja_cod_mov~" ) COLUMN(NAME=~"gestion_cobranza.base~") COLUMN(NAME=~"gestion_cobranza.serie~") COLUMN(NAME=~"gestion_cobranza.numero~") COLUMN(NAME=~"gestion_cobranza.fecha_asignacion~") COLUMN(NAME=~"gestion_cobranza.usuario_asignado~") COLUMN(NAME=~"ingreso.monto~") COLUMN(NAME=~"ingreso.cuotas_pag~") COLUMN(NAME=~"ingreso.tipo_mov~") COLUMN(NAME=~"ingreso.fecha_pago~") COLUMN(NAME=~"ingreso.rut~") COMPUTE(NAME=~"~~~"GESTION_LISTA~~~".~~~"CARTERA_COBRANZA~~~"||'-'||~~~"GESTION_LISTA~~~".~~~"INDICE_CARTERA~~~" as cod_cartera~") COLUMN(NAME=~"gestion_lista.observacion~")    JOIN (LEFT=~"gestion_cobranza.serie~"    OP =~"=~"RIGHT=~"ingreso.serie~" )    JOIN (LEFT=~"gestion_cobranza.numero~"    OP =~"=~"RIGHT=~"ingreso.contrato~" )    JOIN (LEFT=~"gestion_cobranza.base~"    OP =~"=~"RIGHT=~"ingreso.base~" )    JOIN (LEFT=~"gestion_cobranza.codigo_grupo~"    OP =~"=~"RIGHT=~"gestion_lista.codigo~" )    JOIN (LEFT=~"ingreso.tipo_cob~"    OP =~"=~"RIGHT=~"at_ing_caja_cod_mov.tipo_cob~" )    JOIN (LEFT=~"ingreso.tipo_mov~"    OP =~"=~"RIGHT=~"at_ing_caja_cod_mov.tipo_mov~" )    JOIN (LEFT=~"ingreso.codigo_otro~"    OP =~"=~"RIGHT=~"at_ing_caja_cod_mov.codigo_otro~" )WHERE(    EXP1 =~"~~~"GESTION_COBRANZA~~~".~~~"FECHA_ASIGNACION~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"GESTION_COBRANZA~~~".~~~"FECHA_ASIGNACION~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"FECHA_PAGO~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"FECHA_PAGO~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"GESTION_COBRANZA~~~".~~~"USUARIO_ASIGNADO~~~"~"   OP =~"=~"    EXP2 =~":usuario_asignado~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"AT_ING_CAJA_COD_MOV~~~".~~~"DEPTO_CARTERA~~~"~"   OP =~"=~"    EXP2 =~"'C'~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = date)  ARG(NAME = ~"fecha_fin~" TYPE = date)  ARG(NAME = ~"usuario_asignado~" TYPE = string) " arguments=(("fecha_ini", date),("fecha_fin", date),("usuario_asignado", string))  sort="ingreso_fecha_pago A gestion_cobranza_numero A " )
