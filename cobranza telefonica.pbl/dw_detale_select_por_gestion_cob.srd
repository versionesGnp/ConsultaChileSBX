 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"gestion_lista~" )  TABLE(NAME=~"gestion_cobranza~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"cod_parq~" ) COLUMN(NAME=~"gestion_lista.codigo~") COLUMN(NAME=~"gestion_lista.fecha~") COLUMN(NAME=~"gestion_lista.observacion~") COLUMN(NAME=~"gestion_lista.usuario~") COLUMN(NAME=~"gestion_lista.estado~") COLUMN(NAME=~"gestion_lista.usuario_asignado~") COLUMN(NAME=~"gestion_cobranza.base~") COLUMN(NAME=~"gestion_cobranza.serie~") COLUMN(NAME=~"gestion_cobranza.numero~") COLUMN(NAME=~"gestion_cobranza.fecha_asignacion~") COLUMN(NAME=~"gestion_cobranza.rut~") COLUMN(NAME=~"gestion_cobranza.estado~") COLUMN(NAME=~"gestion_cobranza.mora_cred~") COLUMN(NAME=~"gestion_cobranza.dias_mora_cred~") COLUMN(NAME=~"gestion_cobranza.fecha_venc_cred~") COLUMN(NAME=~"gestion_cobranza.monto_mora_cred~") COLUMN(NAME=~"gestion_cobranza.gastos_adm_mora_cred~") COLUMN(NAME=~"gestion_cobranza.interes_mora_cred~") COLUMN(NAME=~"gestion_cobranza.total_mora_cred~") COLUMN(NAME=~"gestion_cobranza.mora_mant~") COLUMN(NAME=~"gestion_cobranza.dias_mora_mant~") COLUMN(NAME=~"gestion_cobranza.fecha_venc_mant~") COLUMN(NAME=~"gestion_cobranza.monto_mora_mant~") COLUMN(NAME=~"gestion_cobranza.gastos_adm_mora_mant~") COLUMN(NAME=~"gestion_cobranza.interes_mora_mant~") COLUMN(NAME=~"gestion_cobranza.total_mora_mant~") COLUMN(NAME=~"gestion_cobranza.fallecidos~") COLUMN(NAME=~"gestion_cobranza.dv~") COLUMN(NAME=~"gestion_cobranza.nombre~") COLUMN(NAME=~"gestion_cobranza.a_paterno~") COLUMN(NAME=~"gestion_cobranza.a_materno~") COLUMN(NAME=~"gestion_cobranza.direccion_p~") COLUMN(NAME=~"gestion_cobranza.codigo_ciudad~") COLUMN(NAME=~"gestion_cobranza.ciudad~") COLUMN(NAME=~"gestion_cobranza.codigo_comuna~") COLUMN(NAME=~"gestion_cobranza.comuna~") COLUMN(NAME=~"gestion_cobranza.fono_p~") COLUMN(NAME=~"gestion_cobranza.fono_c~") COLUMN(NAME=~"gestion_cobranza.estado_cobranza~") COLUMN(NAME=~"gestion_cobranza.fecha_cobranza~") COLUMN(NAME=~"gestion_cobranza.glosa_cobranza~") COLUMN(NAME=~"gestion_cobranza.estado_titular~") COLUMN(NAME=~"gestion_cobranza.fecha_prox_llamado~") COLUMN(NAME=~"gestion_cobranza.estatus_telefonico~") COLUMN(NAME=~"gestion_cobranza.estatus_carta~") COLUMN(NAME=~"gestion_cobranza.estatus_publico~") COLUMN(NAME=~"gestion_cobranza.usuario_asignado~") COLUMN(NAME=~"gestion_cobranza.usuario_asignador~") COLUMN(NAME=~"gestion_cobranza.codigo_grupo~") COLUMN(NAME=~"gestion_cobranza.estado_llamada~") COLUMN(NAME=~"cadena.cod_parque~") COLUMN(NAME=~"cod_parq.nombre~") COLUMN(NAME=~"gestion_cobranza.estado_gestion~") COLUMN(NAME=~"gestion_cobranza.estado_comi~")    JOIN (LEFT=~"gestion_lista.codigo~"    OP =~"=~"RIGHT=~"gestion_cobranza.codigo_grupo~" )    JOIN (LEFT=~"gestion_cobranza.base~"    OP =~"=~"RIGHT=~"cadena.codigo~" )    JOIN (LEFT=~"gestion_cobranza.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"gestion_cobranza.numero~"    OP =~"=~"RIGHT=~"cadena.numero~" )    JOIN (LEFT=~"cadena.cod_parque~"    OP =~"=~"RIGHT=~"cod_parq.codigo~" )WHERE(    EXP1 =~"~~~"GESTION_LISTA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~":codigo~" ) ) ARG(NAME = ~"codigo~" TYPE = number) " arguments=(("codigo", number))  sort="gestion_cobranza_rut A gestion_cobranza_base A " )
