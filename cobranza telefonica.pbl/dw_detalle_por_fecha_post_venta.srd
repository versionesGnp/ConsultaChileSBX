 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cliente~" )  TABLE(NAME=~"tele_log_post_venta~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"cod_parq~" ) COLUMN(NAME=~"cliente.rut~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"tele_log_post_venta.estado~") COLUMN(NAME=~"tele_log_post_venta.fecha~") COLUMN(NAME=~"tele_log_post_venta.glosa~") COLUMN(NAME=~"tele_log_post_venta.usuario~") COLUMN(NAME=~"tele_log_post_venta.base~") COLUMN(NAME=~"tele_log_post_venta.serie~") COLUMN(NAME=~"tele_log_post_venta.numero~") COLUMN(NAME=~"cod_parq.nombre~") COLUMN(NAME=~"cadena.cod_parque~")    JOIN (LEFT=~"cliente.rut~"    OP =~"=~"RIGHT=~"tele_log_post_venta.rut~" )    JOIN (LEFT=~"tele_log_post_venta.base~"    OP =~"=~"RIGHT=~"cadena.codigo~" )    JOIN (LEFT=~"tele_log_post_venta.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"tele_log_post_venta.numero~"    OP =~"=~"RIGHT=~"cadena.numero~" )    JOIN (LEFT=~"cadena.cod_parque~"    OP =~"=~"RIGHT=~"cod_parq.codigo~" )WHERE(    EXP1 =~"to_date(~~~"TELE_LOG_POST_VENTA~~~".~~~"FECHA~~~")~"   OP =~"=~"    EXP2 =~":fecha~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~" ) ) ARG(NAME = ~"fecha~" TYPE = date)  ARG(NAME = ~"parque~" TYPE = number) " arguments=(("fecha", date),("parque", number))  sort="tele_log_post_venta_estado A tele_log_post_venta_base A tele_log_post_venta_serie A tele_log_post_venta_numero A " )
