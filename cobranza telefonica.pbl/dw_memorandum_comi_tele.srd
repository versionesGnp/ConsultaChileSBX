 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"comision_telefonica~" )  TABLE(NAME=~"encargados~" ) COLUMN(NAME=~"comision_telefonica.cod_grupo~") COLUMN(NAME=~"comision_telefonica.cod_ejecutivo~") COLUMN(NAME=~"comision_telefonica.fecha_cierre~") COLUMN(NAME=~"comision_telefonica.monto_pagar~") COLUMN(NAME=~"comision_telefonica.fecha_ini~") COLUMN(NAME=~"comision_telefonica.fecha_fin~") COLUMN(NAME=~"comision_telefonica.cantidad_ctto~") COLUMN(NAME=~"comision_telefonica.porcentaje~") COLUMN(NAME=~"comision_telefonica.fecha_crea~") COLUMN(NAME=~"encargados.nombre~") COLUMN(NAME=~"comision_telefonica.total_ingreso_caja~") COLUMN(NAME=~"comision_telefonica.numero_memo~") COLUMN(NAME=~"comision_telefonica.anno_memo~")    JOIN (LEFT=~"comision_telefonica.cod_ejecutivo~"    OP =~"=~"RIGHT=~"encargados.codigo_usuario~" )WHERE(    EXP1 =~"~~~"COMISION_TELEFONICA~~~".~~~"COD_GRUPO~~~"~"   OP =~"=~"    EXP2 =~":grupo~" ) ) ARG(NAME = ~"grupo~" TYPE = number) " arguments=(("grupo", number)) )
