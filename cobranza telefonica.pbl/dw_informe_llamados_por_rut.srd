 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"tele_log~" ) COLUMN(NAME=~"tele_log.rut~") COLUMN(NAME=~"tele_log.estado~") COLUMN(NAME=~"tele_log.fecha~") COLUMN(NAME=~"tele_log.glosa~") COLUMN(NAME=~"tele_log.usuario~") COLUMN(NAME=~"tele_log.base~") COLUMN(NAME=~"tele_log.serie~") COLUMN(NAME=~"tele_log.numero~")WHERE(    EXP1 =~"~~~"TELE_LOG~~~".~~~"FECHA~~~"~"   OP =~">=~"    EXP2 =~"TO_DATE('1-Jan-2005 00:00:00','DD-MON-YYYY HH24:MI:SS')~" ) ) " update="TELE_LOG" updatewhere=1 updatekeyinplace=no  sort="solo_fecha D " )
