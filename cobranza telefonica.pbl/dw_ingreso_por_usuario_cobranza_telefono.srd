on_cobranza.fono_p~") COLUMN(NAME=~"gestion_cobranza.fono_c~") COLUMN(NAME=~"gestion_cobranza.estado_cobranza~") COLUMN(NAME=~"gestion_cobranza.fecha_cobranza~") COLUMN(NAME=~"gestion_cobranza.glosa_cobranza~") COLUMN(NAME=~"gestion_cobranza.estado_titular~") COLUMN(NAME=~"gestion_cobranza.fecha_prox_llamado~") COLUMN(NAME=~"gestion_cobranza.estatus_telefonico~") COLUMN(NAME=~"gestion_cobranza.estatus_carta~") COLUMN(NAME=~"gestion_cobranza.estatus_publico~") COLUMN(NAME=~"gestion_cobranza.usuario_asignado~") COLUMN(NAME=~"gestion_cobranza.usuario_asignador~") COLUMN(NAME=~"gestion_cobranza.codigo_grupo~") COLUMN(NAME=~"gestion_cobranza.estado_llamada~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"estado.nombre_estado~") COLUMN(NAME=~"tipo_contrato.descripcion~") COLUMN(NAME=~"cadena.cod_parque~") COLUMN(NAME=~"cod_parq.nombre~") COLUMN(NAME=~"gestion_cobranza.fecha_llamado~") COLUMN(NAME=~"gestion_cobranza.existe_pago~") COLUMN(NAME=~"cadena_mora.mora_cred~") COLUMN(NAME=~"cadena_mora.dias_mora_cred~") COLUMN(NAME=~"cadena_mora.fecha_venc_cred~") COLUMN(NAME=~"cadena_mora.mora_mant~") COLUMN(NAME=~"cadena_mora.dias_mora_mant~") COLUMN(NAME=~"cadena_mora.fecha_venc_mant~") COLUMN(NAME=~"cliente.prox_llamado_cob~") COLUMN(NAME=~"cliente.rut~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cliente.tipo_via~") COLUMN(NAME=~"tipo_via.descripcion~") COLUMN(NAME=~"cliente.direccion_p~") COLUMN(NAME=~"cliente.numero_particular~") COLUMN(NAME=~"cliente.depto_particular~") COLUMN(NAME=~"cliente.block_particular~") COLUMN(NAME=~"cliente.poblacion~") COLUMN(NAME=~"cliente.sector~") COLUMN(NAME=~"cliente.ciudad~") COLUMN(NAME=~"ciudad.ciudad~") COLUMN(NAME=~"cliente.comuna~") COLUMN(NAME=~"comuna.comuna~") COLUMN(NAME=~"cliente.fono_p~") COLUMN(NAME=~"cliente.fecha_nac~") COLUMN(NAME=~"cliente.domicilio_c~") COLUMN(NAME=~"cliente.fono_c~") COLUMN(NAME=~"cliente.celular~") COLUMN(NAME=~"cliente.email~") COLUMN(NAME=~"cliente.estado_titular~") COLUMN(NAME=~"gestion_lista.fecha_termino_asignacion~") COLUMN(NAME=~"cadena_mora.fallecidos~") COLUMN(NAME=~"gestion_cobranza.estado_gestion~") COLUMN(NAME=~"cadena_mora.ctas_pag_s~") COMPUTE(NAME=~"(SELECT max(~~~"INGRESO~~~".~~~"FECHA_PAGO~~~") FROM ~~~"INGRESO~~~",~~~"AT_ING_CAJA_COD_MOV~~~" WHERE ~~~"INGRESO~~~".~~~"TIPO_COB~~~" = ~~~"AT_ING_CAJA_COD_MOV~~~".~~~"TIPO_COB~~~" AND ~~~"INGRESO~~~".~~~"TIPO_MOV~~~" = ~~~"AT_ING_CAJA_COD_MOV~~~".~~~"TIPO_MOV~~~" AND ~~~"INGRESO~~~".~~~"CODIGO_OTRO~~~" = ~~~"AT_ING_CAJA_COD_MOV~~~".~~~"CODIGO_OTRO~~~" AND ~~~"AT_ING_CAJA_COD_MOV~~~".~~~"DEPTO_CARTERA~~~" = 'C' AND ~~~"INGRESO~~~".~~~"BASE~~~" = ~~~"GESTION_COBRANZA~~~".~~~"BASE~~~" AND ~~~"INGRESO~~~".~~~"SERIE~~~" = ~~~"GESTION_COBRANZA~~~".~~~"SERIE~~~" AND ~~~"INGRESO~~~".~~~"CONTRATO~~~" = ~~~"GESTION_COBRANZA~~~".~~~"NUMERO~~~") as ult_fecha_pago~") COMPUTE(NAME=~"'' AS MONEDA~") COMPUTE(NAME=~"0 AS VALOR_CTA_CRED~") COMPUTE(NAME=~"0 AS VALOR_CTA_MANT~") COLUMN(NAME=~"gestion_cobranza.clasif~")    JOIN (LEFT=~"gestion_cobranza.base~"    OP =~"=~"RIGHT=~"cadena.codigo~" )    JOIN (LEFT=~"gestion_cobranza.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"gestion_cobranza.numero~"    OP =~"=~"RIGHT=~"cadena.numero~" )    JOIN (LEFT=~"gestion_cobranza.codigo_grupo~"    OP =~"=~"RIGHT=~"gestion_lista.codigo~" )    JOIN (LEFT=~"gestion_cobranza.base~"    OP =~"=~"RIGHT=~"tipo_contrato.codigo~" )    JOIN (LEFT=~"cadena.cod_parque~"    OP =~"=~"RIGHT=~"cod_parq.codigo~" )    JOIN (LEFT=~"estado.cod_estado~"    OP =~"=~"RIGHT=~"cadena.estado~" )    JOIN (LEFT=~"cadena_mora.base~"    OP =~"=~"RIGHT=~"cadena.codigo~" )    JOIN (LEFT=~"cadena_mora.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"cadena_mora.numero~"    OP =~"=~"RIGHT=~"cadena.numero~" )    JOIN (LEFT=~"cliente.tipo_via~"    OP =~"=~"RIGHT=~"tipo_via.tipo_via~" )    JOIN (LEFT=~"cliente.comuna~"    OP =~"=~"RIGHT=~"comuna.codigo_comuna~" )    JOIN (LEFT=~"cliente.ciudad~"    OP =~"=~"RIGHT=~"ciudad.codigo_ciudad~" )    JOIN (LEFT=~"cadena.rut~"    OP =~"=~"RIGHT=~"cliente.rut~" )WHERE(    EXP1 =~"~~~"GESTION_LISTA~~~".~~~"USUARIO_ASIGNADO~~~"~"   OP =~"=~"    EXP2 =~":usuario~"    LOGIC =~"and~" ) WHERE(    EXP1 =~":fecha~"   OP =~">=~"    EXP2 =~"~~~"GESTION_COBRANZA~~~".~~~"FECHA_ASIGNACION~~~"~"    LOGIC =~"And~" ) WHERE(    EXP1 =~":fecha~"   OP =~"<=~"    EXP2 =~"~~~"GESTION_COBRANZA~~~".~~~"FEC_TERMINO_ASIG~~~"~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"GESTION_COBRANZA~~~".~~~"ESTADO_GESTION~~~"~"   OP =~"=~"    EXP2 =~"'P'~" ) ) ORDER(NAME=~"gestion_lista.codigo~" ASC=yes )  ORDER(NAME=~"gestion_cobranza.base~" ASC=yes ) ARG(NAME = ~"usuario~" TYPE = string)  ARG(NAME = ~"fecha~" TYPE = date) " update="GESTION_COBRANZA" updatewhere=0 updatekeyinplace=yes arguments=(("usuario", string),("fecha", date))  sort="gestion_cobranza_numero A " )
