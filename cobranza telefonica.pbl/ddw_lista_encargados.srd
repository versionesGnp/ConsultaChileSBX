 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"encargados~" ) COLUMN(NAME=~"encargados.codigo_usuario~") COLUMN(NAME=~"encargados.password~") COLUMN(NAME=~"encargados.nombre~") COLUMN(NAME=~"encargados.acceso~") COLUMN(NAME=~"encargados.depto~") COLUMN(NAME=~"encargados.company~") COLUMN(NAME=~"encargados.fecha_termino~") COLUMN(NAME=~"encargados.opera~") COLUMN(NAME=~"encargados.cons_general~") COLUMN(NAME=~"encargados.solicitudes~")WHERE(    EXP1 =~"~~~"ENCARGADOS~~~".~~~"DEPTO~~~"~"   OP =~"=~"    EXP2 =~"'O'~" ) ) " update="ENCARGADOS" updatewhere=1 updatekeyinplace=no  sort="codigo_usuario A nombre A " )
