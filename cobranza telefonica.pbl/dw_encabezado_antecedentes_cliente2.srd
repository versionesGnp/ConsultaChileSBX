table(column=(type=decimal(4) updatewhereclause=yes name=cliente_rut dbname="cliente.rut" dbalias=".rut" )
 column=(type=char(1) updatewhereclause=yes name=cliente_dv dbname="cliente.dv" dbalias=".dv" )
 column=(type=char(40) updatewhereclause=yes name=cliente_nombre dbname="cliente.nombre" dbalias=".nombre" )
 column=(type=char(40) updatewhereclause=yes name=cliente_a_paterno dbname="cliente.a_paterno" dbalias=".a_paterno" )
 column=(type=char(40) updatewhereclause=yes name=cliente_a_materno dbname="cliente.a_materno" dbalias=".a_materno" )
 column=(type=char(60) updatewhereclause=yes name=cliente_direccion_p dbname="cliente.direccion_p" dbalias=".direccion_p" )
 column=(type=char(60) updatewhereclause=yes name=cliente_poblacion dbname="cliente.poblacion" dbalias=".poblacion" )
 column=(type=char(10) updatewhereclause=yes name=ciudad_codigo_ciudad dbname="ciudad.codigo_ciudad" dbalias=".codigo_ciudad" )
 column=(type=char(90) updatewhereclause=yes name=ciudad_ciudad dbname="ciudad.ciudad" dbalias=".ciudad" )
 column=(type=char(10) updatewhereclause=yes name=comuna_codigo_comuna dbname="comuna.codigo_comuna" dbalias=".codigo_comuna" )
 column=(type=char(90) updatewhereclause=yes name=comuna_comuna dbname="comuna.comuna" dbalias=".comuna" )
 column=(type=char(25) updatewhereclause=yes name=cliente_fono_p dbname="cliente.fono_p" dbalias=".fono_p" )
 column=(type=char(60) updatewhereclause=yes name=cliente_domicilio_c dbname="cliente.domicilio_c" dbalias=".domicilio_c" )
 column=(type=char(25) updatewhereclause=yes name=cliente_fono_c dbname="cliente.fono_c" dbalias=".fono_c" )
 column=(type=char(1) updatewhereclause=yes name=cliente_estado_titular dbname="cliente.estado_titular" dbalias=".estado_titular" values="0 - Activo	0/1 - Fallecido	1/" )
 column=(type=datetime updatewhereclause=yes name=cliente_fecha_prox_llamado dbname="cliente.fecha_prox_llamado" dbalias=".fecha_prox_llamado" )
 column=(type=char(40) updatewhereclause=yes name=cliente_deudor_tercero_nombre dbname="cliente_deudor_tercero.nombre" dbalias=".nombre" )
 column=(type=char(40) updatewhereclause=yes name=cliente_deudor_tercero_a_paterno dbname="cliente_deudor_tercero.a_paterno" dbalias=".a_paterno" )
 column=(type=char(40) updatewhereclause=yes name=cliente_deudor_tercero_a_materno dbname="cliente_deudor_tercero.a_materno" dbalias=".a_materno" )
 column=(type=char(25) updatewhereclause=yes name=cliente_celular dbname="cliente.celular" dbalias=".celular" )
 column=(type=char(300) updatewhereclause=yes name=cliente_email dbname="cliente.email" dbalias=".email" )
 column=(type=datetime updatewhereclause=yes name=cliente_prox_llamado_cob dbname="cliente.prox_llamado_cob" dbalias=".prox_llamado_cob" )
 column=(type=datetime updatewhereclause=yes name=cliente_fecha_compromiso dbname="cliente.fecha_compromiso" dbalias=".fecha_compromiso" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ciudad~" )  TABLE(NAME=~"cliente~" )  TABLE(NAME=~"comuna~" )  TABLE(NAME=~"cliente_deudor_tercero~" ) COLUMN(NAME=~"cliente.rut~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cliente.direccion_p~") COLUMN(NAME=~"cliente.poblacion~") COLUMN(NAME=~"ciudad.codigo_ciudad~") COLUMN(NAME=~"ciudad.ciudad~") COLUMN(NAME=~"comuna.codigo_comuna~") COLUMN(NAME=~"comuna.comuna~") COLUMN(NAME=~"cliente.fono_p~") COLUMN(NAME=~"cliente.domicilio_c~") COLUMN(NAME=~"cliente.fono_c~") COLUMN(NAME=~"cliente.estado_titular~") COLUMN(NAME=~"cliente.fecha_prox_llamado~") COLUMN(NAME=~"cliente_deudor_tercero.nombre~") COLUMN(NAME=~"cliente_deudor_tercero.a_paterno~") COLUMN(NAME=~"cliente_deudor_tercero.a_materno~") COLUMN(NAME=~"cliente.celular~") COLUMN(NAME=~"cliente.email~") COLUMN(NAME=~"cliente.prox_llamado_cob~") COLUMN(NAME=~"cliente.fecha_compromiso~")    JOIN (LEFT=~"cliente.rut~"    OP =~"=~"RIGHT=~"cliente_deudor_tercero.rut_titular~"    OUTER1 =~"cliente.rut~" )    JOIN (LEFT=~"ciudad.codigo_ciudad~"    OP =~"=~"RIGHT=~"cliente.ciudad~" )    JOIN (LEFT=~"cliente.comuna~"    OP =~"=~"RIGHT=~"comuna.codigo_comuna~" )WHERE(    EXP1 =~"~~~"CLIENTE~~~".~~~"RUT~~~"~"   OP =~"=~"    EXP2 =~":rut~" ) ) ARG(NAME = ~"rut~" TYPE = number) " arguments=(("rut", number)) )
