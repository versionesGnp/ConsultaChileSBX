 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"comision_telefonica~" ) COLUMN(NAME=~"comision_telefonica.cod_grupo~") COLUMN(NAME=~"comision_telefonica.cod_ejecutivo~") COLUMN(NAME=~"comision_telefonica.monto_pagar~") COLUMN(NAME=~"comision_telefonica.fecha_ini~") COLUMN(NAME=~"comision_telefonica.fecha_fin~") COLUMN(NAME=~"comision_telefonica.cantidad_ctto~") COLUMN(NAME=~"comision_telefonica.porcentaje~") COLUMN(NAME=~"comision_telefonica.fecha_crea~") COLUMN(NAME=~"comision_telefonica.total_ingreso_caja~") COLUMN(NAME=~"comision_telefonica.numero_memo~") COLUMN(NAME=~"comision_telefonica.anno_memo~") COLUMN(NAME=~"comision_telefonica.estado_proceso~") COLUMN(NAME=~"comision_telefonica.fecha_cierre~") COMPUTE(NAME=~"0 as rut_age~") COLUMN(NAME=~"comision_telefonica.estado_age~") COLUMN(NAME=~"comision_telefonica.cod_age~")WHERE(    EXP1 =~"~~~"COMISION_TELEFONICA~~~".~~~"COD_AGE~~~"~"   OP =~"=~"    EXP2 =~":cod_age~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"COMISION_TELEFONICA~~~".~~~"FECHA_CIERRE~~~"~"   OP =~"=~"    EXP2 =~":fecha_cierre~" ) ) ARG(NAME = ~"cod_age~" TYPE = string)  ARG(NAME = ~"fecha_cierre~" TYPE = datetime) " update="COMISION_TELEFONICA" updatewhere=0 updatekeyinplace=yes arguments=(("cod_age", string),("fecha_cierre", datetime)) )
