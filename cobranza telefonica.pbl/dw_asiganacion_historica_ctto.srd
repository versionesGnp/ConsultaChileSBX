 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"gestion_cobranza~" ) COLUMN(NAME=~"gestion_cobranza.base~") COLUMN(NAME=~"gestion_cobranza.serie~") COLUMN(NAME=~"gestion_cobranza.numero~") COLUMN(NAME=~"gestion_cobranza.fecha_asignacion~") COLUMN(NAME=~"gestion_cobranza.mora_cred~") COLUMN(NAME=~"gestion_cobranza.dias_mora_cred~") COLUMN(NAME=~"gestion_cobranza.fecha_venc_cred~") COLUMN(NAME=~"gestion_cobranza.monto_mora_cred~") COLUMN(NAME=~"gestion_cobranza.mora_mant~") COLUMN(NAME=~"gestion_cobranza.dias_mora_mant~") COLUMN(NAME=~"gestion_cobranza.fecha_venc_mant~") COLUMN(NAME=~"gestion_cobranza.monto_mora_mant~") COLUMN(NAME=~"gestion_cobranza.usuario_asignado~") COLUMN(NAME=~"gestion_cobranza.codigo_grupo~") COLUMN(NAME=~"gestion_cobranza.estado_comi~") COLUMN(NAME=~"gestion_cobranza.estado_gestion~") COLUMN(NAME=~"gestion_cobranza.fec_termino_asig~") COLUMN(NAME=~"gestion_cobranza.rut~")WHERE(    EXP1 =~"~~~"GESTION_COBRANZA~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"GESTION_COBRANZA~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"GESTION_COBRANZA~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"GESTION_COBRANZA~~~".~~~"RUT~~~"~"   OP =~"=~"    EXP2 =~":rut~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number)  ARG(NAME = ~"rut~" TYPE = number) " update="GESTION_COBRANZA" updatewhere=0 updatekeyinplace=no arguments=(("base", string),("serie", string),("numero", number),("rut", number))  sort="fecha_asignacion D " )
