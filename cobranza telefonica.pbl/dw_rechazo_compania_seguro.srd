 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"seguro_rechazos~" ) COLUMN(NAME=~"seguro_rechazos.base~") COLUMN(NAME=~"seguro_rechazos.serie~") COLUMN(NAME=~"seguro_rechazos.numero~") COLUMN(NAME=~"seguro_rechazos.rut_cliente~") COLUMN(NAME=~"seguro_rechazos.fecha_crea~") COLUMN(NAME=~"seguro_rechazos.codigo_compania~") COLUMN(NAME=~"seguro_rechazos.fecha_recepcion~") COLUMN(NAME=~"seguro_rechazos.codigo_carta~") COLUMN(NAME=~"seguro_rechazos.nro_poliza~") COLUMN(NAME=~"seguro_rechazos.motivo_rechazo~") COLUMN(NAME=~"seguro_rechazos.contacto_compania~") COLUMN(NAME=~"seguro_rechazos.estado_reg~") COLUMN(NAME=~"seguro_rechazos.fecha_anulacion_reg~")WHERE(    EXP1 =~"~~~"SEGURO_RECHAZOS~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SEGURO_RECHAZOS~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SEGURO_RECHAZOS~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SEGURO_RECHAZOS~~~".~~~"FECHA_CREA~~~"~"   OP =~"=~"    EXP2 =~":fecha_crea~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number)  ARG(NAME = ~"fecha_crea~" TYPE = datetime) " update="SEGURO_RECHAZOS" updatewhere=0 updatekeyinplace=yes arguments=(("base", string),("serie", string),("numero", number),("fecha_crea", datetime)) )
