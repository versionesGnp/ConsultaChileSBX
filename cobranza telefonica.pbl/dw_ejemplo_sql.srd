 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"ingreso~" )  TABLE(NAME=~"tele_log~" )  TABLE(NAME=~"gestion_cobranza~" ) COLUMN(NAME=~"gestion_cobranza.base~") COLUMN(NAME=~"gestion_cobranza.serie~") COLUMN(NAME=~"gestion_cobranza.numero~") COLUMN(NAME=~"ingreso.tipo_cob~") COLUMN(NAME=~"ingreso.folio~") COLUMN(NAME=~"ingreso.fecha_pago~") COLUMN(NAME=~"ingreso.tipo_mov~") COLUMN(NAME=~"ingreso.monto~") COLUMN(NAME=~"ingreso.cuotas_pag~")    JOIN (LEFT=~"ingreso.serie~"    OP =~"=~"RIGHT=~"tele_log.serie~" )    JOIN (LEFT=~"ingreso.base~"    OP =~"=~"RIGHT=~"tele_log.base~" )    JOIN (LEFT=~"ingreso.contrato~"    OP =~"=~"RIGHT=~"tele_log.numero~" )    JOIN (LEFT=~"ingreso.base~"    OP =~"=~"RIGHT=~"gestion_cobranza.base~" )    JOIN (LEFT=~"ingreso.serie~"    OP =~"=~"RIGHT=~"gestion_cobranza.serie~" )    JOIN (LEFT=~"ingreso.contrato~"    OP =~"=~"RIGHT=~"gestion_cobranza.numero~" )WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"FECHA_PAGO~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"FECHA_PAGO~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"TELE_LOG~~~".~~~"FECHA~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"TELE_LOG~~~".~~~"FECHA~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"GESTION_COBRANZA~~~".~~~"USUARIO_ASIGNADO~~~"~"   OP =~"=~"    EXP2 =~":usuario~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"TELE_LOG~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'0'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"TELE_LOG~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'1'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"TELE_LOG~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'2'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"TELE_LOG~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'11')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"TIPO_MOV~~~"~"   OP =~"=~"    EXP2 =~"'E'~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = datetime)  ARG(NAME = ~"fecha_fin~" TYPE = datetime)  ARG(NAME = ~"usuario~" TYPE = string) " arguments=(("fecha_ini", datetime),("fecha_fin", datetime),("usuario", string))  sort="gestion_cobranza_numero A ingreso_tipo_mov A " )
