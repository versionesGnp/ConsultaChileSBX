 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"seguro_rechazos~" ) COLUMN(NAME=~"seguro_rechazos.base~") COLUMN(NAME=~"seguro_rechazos.serie~") COLUMN(NAME=~"seguro_rechazos.numero~") COLUMN(NAME=~"seguro_rechazos.rut_cliente~") COLUMN(NAME=~"seguro_rechazos.fecha_crea~") COLUMN(NAME=~"seguro_rechazos.codigo_compania~") COLUMN(NAME=~"seguro_rechazos.fecha_recepcion~") COLUMN(NAME=~"seguro_rechazos.codigo_carta~") COLUMN(NAME=~"seguro_rechazos.nro_poliza~") COLUMN(NAME=~"seguro_rechazos.motivo_rechazo~") COLUMN(NAME=~"seguro_rechazos.contacto_compania~") COLUMN(NAME=~"seguro_rechazos.estado_reg~") COLUMN(NAME=~"seguro_rechazos.fecha_anulacion_reg~")WHERE(    EXP1 =~"~~~"SEGURO_RECHAZOS~~~".~~~"FECHA_CREA~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SEGURO_RECHAZOS~~~".~~~"FECHA_CREA~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = datetime)  ARG(NAME = ~"fecha_fin~" TYPE = datetime) " update="SEGURO_RECHAZOS" updatewhere=1 updatekeyinplace=no arguments=(("fecha_ini", datetime),("fecha_fin", datetime))  sort="fecha_crea D base A serie A numero A " )
