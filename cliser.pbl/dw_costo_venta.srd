table(column=(type=decimal(4) update=yes updatewhereclause=yes key=yes name=cod_parque dbname="costo_venta.cod_parque" )
 column=(type=datetime update=yes updatewhereclause=yes key=yes name=desde dbname="costo_venta.desde" )
 column=(type=datetime update=yes updatewhereclause=yes key=yes name=hasta dbname="costo_venta.hasta" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=monto dbname="costo_venta.monto" )
 column=(type=char(50) update=yes updatewhereclause=yes name=tipo dbname="costo_venta.tipo" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=saldo dbname="costo_venta.saldo" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=pmp dbname="costo_venta.pmp" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=saldo_sepultura dbname="costo_venta.saldo_sepultura" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=pmp_r dbname="costo_venta.pmp_r" )
 column=(type=number updatewhereclause=yes name=mes dbname="mes" )
 column=(type=number updatewhereclause=yes name=cant_res dbname="cant_res" )
 column=(type=number updatewhereclause=yes name=cant_vta dbname="cant_vta" )
 column=(type=number updatewhereclause=yes name=valor_resc dbname="valor_resc" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"costo_venta~" ) COLUMN(NAME=~"costo_venta.cod_parque~") COLUMN(NAME=~"costo_venta.desde~") COLUMN(NAME=~"costo_venta.hasta~") COLUMN(NAME=~"costo_venta.monto~") COLUMN(NAME=~"costo_venta.tipo~") COLUMN(NAME=~"costo_venta.saldo~") COLUMN(NAME=~"costo_venta.pmp~") COLUMN(NAME=~"costo_venta.saldo_sepultura~") COLUMN(NAME=~"costo_venta.pmp_r~") COMPUTE(NAME=~"0 as mes~") COMPUTE(NAME=~"0 as cant_res~") COMPUTE(NAME=~"0 as cant_vta~") COMPUTE(NAME=~"0 as valor_resc~")WHERE(    EXP1 =~"~~~"COSTO_VENTA~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"COSTO_VENTA~~~".~~~"DESDE~~~"~"   OP =~">=~"    EXP2 =~":fech_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"COSTO_VENTA~~~".~~~"HASTA~~~"~"   OP =~"<=~"    EXP2 =~":fech_fin~" ) ) ARG(NAME = ~"fech_ini~" TYPE = date)  ARG(NAME = ~"fech_fin~" TYPE = date)  ARG(NAME = ~"parque~" TYPE = number) " update="COSTO_VENTA" updatewhere=1 updatekeyinplace=no arguments=(("fech_ini", date),("fech_fin", date),("parque", number))  sort="hasta A " )
