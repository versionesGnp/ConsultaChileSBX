 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"grl_per_nat~" )  TABLE(NAME=~"grl_ccosto~" )  TABLE(NAME=~"grl_ciudad~" )  TABLE(NAME=~"grl_comuna~" )  TABLE(NAME=~"grl_direcc~" )  TABLE(NAME=~"grl_empres~" )  TABLE(NAME=~"grl_region~" )  TABLE(NAME=~"rem_afp~" )  TABLE(NAME=~"rem_clasemp~" )  TABLE(NAME=~"rem_isapre~" )  TABLE(NAME=~"rem_maeemp~" )  TABLE(NAME=~"rem_tipcalsld~" )  TABLE(NAME=~"rem_tipsld~" ) COLUMN(NAME=~"grl_per_nat.num_rut~") COLUMN(NAME=~"grl_per_nat.cod_sexo~") COLUMN(NAME=~"grl_per_nat.cod_tip_rut_pers~") COLUMN(NAME=~"grl_per_nat.cod_tip_rut~") COLUMN(NAME=~"grl_per_nat.dgv_rut~") COLUMN(NAME=~"grl_per_nat.grl_a_ind_vige~") COLUMN(NAME=~"grl_per_nat.grl_autor_num_rut~") COLUMN(NAME=~"grl_per_nat.grl_autor_fec_transc~") COLUMN(NAME=~"grl_per_nat.grl_autor_hra_transc~") COLUMN(NAME=~"grl_per_nat.nom_patern~") COLUMN(NAME=~"grl_per_nat.nom_matern~") COLUMN(NAME=~"grl_per_nat.nom_nombre~") COLUMN(NAME=~"grl_per_nat.fec_nacimt~") COLUMN(NAME=~"grl_per_nat.a_ind_vige~") COLUMN(NAME=~"grl_per_nat.autor_num_rut~") COLUMN(NAME=~"grl_per_nat.autor_fec_transc~") COLUMN(NAME=~"grl_per_nat.autor_hra_transc~") COLUMN(NAME=~"grl_empres.nom_rznsoc~") COLUMN(NAME=~"rem_afp.gls_codigo~") COLUMN(NAME=~"grl_ccosto.gls_ccosto~") COLUMN(NAME=~"rem_clasemp.gls_codigo~") COLUMN(NAME=~"grl_direcc.gls_direcc~") COLUMN(NAME=~"grl_comuna.gls_comuna~") COLUMN(NAME=~"grl_region.gls_region~") COLUMN(NAME=~"rem_isapre.gls_codigo~") COLUMN(NAME=~"rem_tipsld.gls_codigo~") COLUMN(NAME=~"rem_tipcalsld.gls_codigo~") COLUMN(NAME=~"grl_ciudad.gls_ciudad~")    JOIN (LEFT=~"grl_per_nat.num_rut~"    OP =~"=~"RIGHT=~"rem_maeemp.num_rut~" )    JOIN (LEFT=~"grl_empres.cod_empres~"    OP =~"=~"RIGHT=~"rem_maeemp.cod_empres~" )    JOIN (LEFT=~"rem_maeemp.cod_afprem~"    OP =~"=~"RIGHT=~"rem_afp.cod_afprem~" )    JOIN (LEFT=~"rem_maeemp.grl_cod_empres~"    OP =~"=~"RIGHT=~"grl_ccosto.cod_empres~" )    JOIN (LEFT=~"rem_maeemp.grl_num_periodo~"    OP =~"=~"RIGHT=~"grl_ccosto.num_periodo~" )    JOIN (LEFT=~"rem_maeemp.cod_ccosto~"    OP =~"=~"RIGHT=~"grl_ccosto.cod_ccosto~" )    JOIN (LEFT=~"rem_maeemp.cod_clasempl~"    OP =~"=~"RIGHT=~"rem_clasemp.cod_clasempl~" )    JOIN (LEFT=~"rem_maeemp.num_direcc~"    OP =~"=~"RIGHT=~"grl_direcc.num_direcc~" )    JOIN (LEFT=~"grl_direcc.cod_comuna~"    OP =~"=~"RIGHT=~"grl_comuna.cod_comuna~" )    JOIN (LEFT=~"grl_direcc.cod_ciudad~"    OP =~"=~"RIGHT=~"grl_ciudad.cod_ciudad~" )    JOIN (LEFT=~"grl_direcc.cod_pais~"    OP =~"=~"RIGHT=~"grl_ciudad.cod_pais~" )    JOIN (LEFT=~"grl_direcc.cod_region~"    OP =~"=~"RIGHT=~"grl_region.cod_region~" )    JOIN (LEFT=~"rem_maeemp.cod_isaprerem~"    OP =~"=~"RIGHT=~"rem_isapre.cod_isaprerem~" )    JOIN (LEFT=~"rem_maeemp.tip_sueldo~"    OP =~"=~"RIGHT=~"rem_tipsld.tip_sueldo~" )    JOIN (LEFT=~"rem_maeemp.tip_calculo~"    OP =~"=~"RIGHT=~"rem_tipcalsld.tip_calculo~" )    JOIN (LEFT=~"grl_direcc.num_rut~"    OP =~"=~"RIGHT=~"rem_maeemp.num_rut~" )WHERE(    EXP1 =~"~~~"GRL_PER_NAT~~~".~~~"NUM_RUT~~~"~"   OP =~"=~"    EXP2 =~":rut~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"REM_MAEEMP~~~".~~~"NUM_PERIODO~~~"~"   OP =~"=~"    EXP2 =~"(SELECT max(~~~"REM_MAEEMP~~~".~~~"NUM_PERIODO~~~") FROM ~~~"GRL_PER_NAT~~~", ~~~"REM_MAEEMP~~~" WHERE ( ~~~"REM_MAEEMP~~~".~~~"NUM_RUT~~~" = ~~~"GRL_PER_NAT~~~".~~~"NUM_RUT~~~" ) and ( ( ~~~"GRL_PER_NAT~~~".~~~"NUM_RUT~~~" = :rut ) ) )~" ) ) ARG(NAME = ~"rut~" TYPE = number) " arguments=(("rut", number)) )
