 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"oferta_v~" )  TABLE(NAME=~"cadena~" ) COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"cadena.serie~") COLUMN(NAME=~"cadena.numero~") COLUMN(NAME=~"oferta_v.costo_venta~") COLUMN(NAME=~"oferta_v.unidad_costo~") COLUMN(NAME=~"cadena.fecha_prim_factura~") COLUMN(NAME=~"cadena.cod_parque~") COLUMN(NAME=~"oferta_v.serie~") COLUMN(NAME=~"oferta_v.nro_oferta~")    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"oferta_v.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"oferta_v.nro_oferta~" )WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":ll_parque~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"OFERTA_V~~~".~~~"UNIDAD_COSTO~~~"~"   OP =~"is~"    EXP2 =~"null~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"FECHA_PRIM_FACTURA~~~"~"   OP =~">=~"    EXP2 =~":fech_ini~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"FECHA_PRIM_FACTURA~~~"~"   OP =~"<=~"    EXP2 =~":fech_fin~" ) ) ARG(NAME = ~"ll_parque~" TYPE = number)  ARG(NAME = ~"fech_ini~" TYPE = date)  ARG(NAME = ~"fech_fin~" TYPE = date) " update="OFERTA_V" updatewhere=0 updatekeyinplace=yes arguments=(("ll_parque", number),("fech_ini", date),("fech_fin", date))  sort="cadena_numero A " )
