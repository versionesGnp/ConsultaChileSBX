 OP =~"=~"RIGHT=~"grl_ccosto.num_periodo~" )    JOIN (LEFT=~"rem_maeemp.cod_ccosto~"    OP =~"=~"RIGHT=~"grl_ccosto.cod_ccosto~" )    JOIN (LEFT=~"rem_maeemp.cod_clasempl~"    OP =~"=~"RIGHT=~"rem_clasemp.cod_clasempl~" )    JOIN (LEFT=~"rem_maeemp.grl_num_rut~"    OP =~"=~"RIGHT=~"grl_direcc.num_rut~" )    JOIN (LEFT=~"rem_maeemp.num_direcc~"    OP =~"=~"RIGHT=~"grl_direcc.num_direcc~" )    JOIN (LEFT=~"grl_comuna.cod_comuna~"    OP =~"=~"RIGHT=~"grl_direcc.cod_comuna~" )    JOIN (LEFT=~"grl_ciudad.cod_pais~"    OP =~"=~"RIGHT=~"grl_direcc.cod_pais~" )    JOIN (LEFT=~"grl_ciudad.cod_ciudad~"    OP =~"=~"RIGHT=~"grl_direcc.cod_ciudad~" )    JOIN (LEFT=~"grl_region.cod_region~"    OP =~"=~"RIGHT=~"grl_direcc.cod_region~" )    JOIN (LEFT=~"rem_maeemp.cod_isaprerem~"    OP =~"=~"RIGHT=~"rem_isapre.cod_isaprerem~" )    JOIN (LEFT=~"rem_maeemp.tip_calculo~"    OP =~"=~"RIGHT=~"rem_tipcalsld.tip_calculo~" )    JOIN (LEFT=~"rem_maeemp.tip_sueldo~"    OP =~"=~"RIGHT=~"rem_tipsld.tip_sueldo~" )WHERE(    EXP1 =~"~~~"REM_MAEEMP~~~".~~~"NUM_PERIODO~~~"~"   OP =~"=~"    EXP2 =~"(SELECT max(~~~"REM_MAEEMP~~~".~~~"NUM_PERIODO~~~") FROM ~~~"GRL_PER_NAT~~~", ~~~"REM_MAEEMP~~~" WHERE ( ~~~"REM_MAEEMP~~~".~~~"NUM_RUT~~~" = ~~~"GRL_PER_NAT~~~".~~~"NUM_RUT~~~" ) )~" ) ) ARG(NAME = ~"fecha_hoy~" TYPE = date) " arguments=(("fecha_hoy", date))  sort="nom_patern A nom_matern A nom_nombre A " )
