 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"provision_mantenciones~" ) COLUMN(NAME=~"provision_mantenciones.base~") COLUMN(NAME=~"provision_mantenciones.serie~") COLUMN(NAME=~"provision_mantenciones.numero~") COLUMN(NAME=~"provision_mantenciones.cod_parque~") COLUMN(NAME=~"provision_mantenciones.estado~") COLUMN(NAME=~"provision_mantenciones.fallecido~") COLUMN(NAME=~"provision_mantenciones.fecha_cierre~") COLUMN(NAME=~"provision_mantenciones.ctas_pag~") COLUMN(NAME=~"provision_mantenciones.ctas_mant~") COLUMN(NAME=~"provision_mantenciones.ctas_mora~") COLUMN(NAME=~"provision_mantenciones.porce_pago~") COLUMN(NAME=~"provision_mantenciones.valor_mant~") COLUMN(NAME=~"provision_mantenciones.meses~") COLUMN(NAME=~"provision_mantenciones.fecha_prim_mant~") COLUMN(NAME=~"provision_mantenciones.fecha_ult_venc~")WHERE(    EXP1 =~"~~~"PROVISION_MANTENCIONES~~~".~~~"FECHA_CIERRE~~~"~"   OP =~"=~"    EXP2 =~":fecha_cierre~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"PROVISION_MANTENCIONES~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":ll_parque~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"PROVISION_MANTENCIONES~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":ls_base~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"PROVISION_MANTENCIONES~~~".~~~"PORCE_PAGO~~~"~"   OP =~">=~"    EXP2 =~":ll_porce_ini~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"PROVISION_MANTENCIONES~~~".~~~"PORCE_PAGO~~~"~"   OP =~"<~"    EXP2 =~":ll_porce_fin~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"PROVISION_MANTENCIONES~~~".~~~"FALLECIDO~~~"~"   OP =~"=~"    EXP2 =~":ll_fallecido~" ) ) ARG(NAME = ~"fecha_cierre~" TYPE = date)  ARG(NAME = ~"ll_parque~" TYPE = number)  ARG(NAME = ~"ls_base~" TYPE = string)  ARG(NAME = ~"ll_porce_ini~" TYPE = number)  ARG(NAME = ~"ll_porce_fin~" TYPE = number)  ARG(NAME = ~"ll_fallecido~" TYPE = number) " update="PROVISION_MANTENCIONES" updatewhere=1 updatekeyinplace=no arguments=(("fecha_cierre", date),("ll_parque", number),("ls_base", string),("ll_porce_ini", number),("ll_porce_fin", number),("ll_fallecido", number))  sort="ctas_mant A numero A " )
