 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"costo_venta~" ) COLUMN(NAME=~"costo_venta.cod_parque~") COLUMN(NAME=~"costo_venta.desde~") COLUMN(NAME=~"costo_venta.hasta~") COLUMN(NAME=~"costo_venta.monto~") COLUMN(NAME=~"costo_venta.tipo~")WHERE(    EXP1 =~"~~~"COSTO_VENTA~~~".~~~"DESDE~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"COSTO_VENTA~~~".~~~"HASTA~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = datetime)  ARG(NAME = ~"fecha_fin~" TYPE = datetime) " update="COSTO_VENTA" updatewhere=1 updatekeyinplace=no arguments=(("fecha_ini", datetime),("fecha_fin", datetime))  sort="cod_parque A desde A " )
