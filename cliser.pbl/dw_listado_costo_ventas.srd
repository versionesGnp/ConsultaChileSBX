 column=(type=char(50) update=yes updatewhereclause=yes name=tipo dbname="costo_venta.tipo" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"costo_venta~" ) COLUMN(NAME=~"costo_venta.cod_parque~") COLUMN(NAME=~"costo_venta.desde~") COLUMN(NAME=~"costo_venta.hasta~") COLUMN(NAME=~"costo_venta.monto~") COLUMN(NAME=~"costo_venta.tipo~")WHERE(    EXP1 =~"~~~"COSTO_VENTA~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":ll_parque~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"COSTO_VENTA~~~".~~~"DESDE~~~"~"   OP =~">=~"    EXP2 =~":fech_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"COSTO_VENTA~~~".~~~"HASTA~~~"~"   OP =~"<=~"    EXP2 =~":fech_fin~" ) ) ARG(NAME = ~"ll_parque~" TYPE = number)  ARG(NAME = ~"fech_ini~" TYPE = date)  ARG(NAME = ~"fech_fin~" TYPE = date) " update="COSTO_VENTA" updatewhere=1 updatekeyinplace=no arguments=(("ll_parque", number),("fech_ini", date),("fech_fin", date))  sort="desde D " )
