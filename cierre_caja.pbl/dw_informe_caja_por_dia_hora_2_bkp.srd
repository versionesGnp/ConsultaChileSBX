 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"documentos~" ) COLUMN(NAME=~"documentos.monto~") COLUMN(NAME=~"documentos.cod_caja~") COLUMN(NAME=~"documentos.fecha_pago~") COLUMN(NAME=~"documentos.cod_pago~") COLUMN(NAME=~"documentos.hora_pago~") COLUMN(NAME=~"documentos.minuto_pago~") COLUMN(NAME=~"documentos.folio~") COLUMN(NAME=~"documentos.tipo_cob~") COLUMN(NAME=~"documentos.rezago~") COMPUTE(NAME=~"''~") COLUMN(NAME=~"documentos.nro_cuotas_credito~") COLUMN(NAME=~"documentos.tipo_tarjeta_credito~")WHERE(    EXP1 =~"~~~"DOCUMENTOS~~~".~~~"FECHA_PAGO~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"DOCUMENTOS~~~".~~~"FECHA_PAGO~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = date)  ARG(NAME = ~"fecha_fin~" TYPE = date) " arguments=(("fecha_ini", date),("fecha_fin", date))  sort="fecha_pago A cod_caja A cod_pago A hora_pago A minuto_pago A " )
