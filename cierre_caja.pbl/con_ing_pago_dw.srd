table(column=(type=decimal(4) updatewhereclause=yes name=ingreso_folio dbname="ingreso.folio" dbalias=".folio" )
 column=(type=decimal(4) updatewhereclause=yes name=ingreso_monto dbname="ingreso.monto" dbalias=".monto" )
 column=(type=decimal(4) updatewhereclause=yes name=ingreso_cuotas_pag dbname="ingreso.cuotas_pag" dbalias=".cuotas_pag" )
 column=(type=datetime updatewhereclause=yes name=ingreso_fecha_pago dbname="ingreso.fecha_pago" dbalias=".fecha_pago" )
 column=(type=char(2) updatewhereclause=yes name=ingreso_cod_caja dbname="ingreso.cod_caja" dbalias=".cod_caja" )
 column=(type=char(1) updatewhereclause=yes name=ingreso_rezago dbname="ingreso.rezago" dbalias=".rezago" values="Si	S/No	A/No	 /" )
 column=(type=decimal(4) updatewhereclause=yes name=ingreso_valor_uf dbname="ingreso.valor_uf" dbalias=".valor_uf" )
 column=(type=char(1) updatewhereclause=yes name=ingreso_serie dbname="ingreso.serie" dbalias=".serie" )
 column=(type=decimal(4) updatewhereclause=yes name=ingreso_contrato dbname="ingreso.contrato" dbalias=".contrato" )
 column=(type=char(2) updatewhereclause=yes name=ingreso_tipo_cob dbname="ingreso.tipo_cob" dbalias=".tipo_cob" )
 column=(type=char(1) updatewhereclause=yes name=ingreso_base dbname="ingreso.base" dbalias=".base" )
 column=(type=char(5) updatewhereclause=yes name=ingreso_codigo_otro dbname="ingreso.codigo_otro" dbalias=".codigo_otro" )
 column=(type=datetime updatewhereclause=yes name=ingreso_servipag dbname="ingreso.servipag" dbalias=".servipag" )
 column=(type=char(15) updatewhereclause=yes name=ingreso_usuario dbname="ingreso.usuario" dbalias=".usuario" )
 column=(type=char(2) updatewhereclause=yes name=ingreso_tipo_mov dbname="ingreso.tipo_mov" dbalias=".tipo_mov" )
 column=(type=decimal(4) updatewhereclause=yes name=ingreso_rut dbname="ingreso.rut" dbalias=".rut" )
 column=(type=char(30) updatewhereclause=yes name=cod_movi_des_ing dbname="cod_movi.des_ing" dbalias=".des_ing" )
 column=(type=decimal(4) updatewhereclause=yes name=ingreso_cod_parque dbname="ingreso.cod_parque" dbalias=".cod_parque" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"INGRESO~" )  TABLE(NAME=~"cod_movi~" ) COLUMN(NAME=~"INGRESO.folio~") COLUMN(NAME=~"INGRESO.monto~") COLUMN(NAME=~"INGRESO.cuotas_pag~") COLUMN(NAME=~"INGRESO.fecha_pago~") COLUMN(NAME=~"INGRESO.cod_caja~") COLUMN(NAME=~"INGRESO.rezago~") COLUMN(NAME=~"INGRESO.valor_uf~") COLUMN(NAME=~"INGRESO.serie~") COLUMN(NAME=~"INGRESO.contrato~") COLUMN(NAME=~"INGRESO.tipo_cob~") COLUMN(NAME=~"INGRESO.base~") COLUMN(NAME=~"INGRESO.codigo_otro~") COLUMN(NAME=~"INGRESO.servipag~") COLUMN(NAME=~"INGRESO.usuario~") COLUMN(NAME=~"INGRESO.tipo_mov~") COLUMN(NAME=~"INGRESO.rut~") COLUMN(NAME=~"cod_movi.des_ing~") COLUMN(NAME=~"INGRESO.cod_parque~")    JOIN (LEFT=~"INGRESO.tipo_mov~"    OP =~"=~"RIGHT=~"cod_movi.cod_ing~" )WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"FOLIO~~~"~"   OP =~"=~"    EXP2 =~":folio~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"TIPO_COB~~~"~"   OP =~"=~"    EXP2 =~":tcom1~" ) ) ARG(NAME = ~"folio~" TYPE = number)  ARG(NAME = ~"tcom1~" TYPE = string) " arguments=(("folio", number),("tcom1", string))  sort="ingreso_base A ingreso_serie A ingreso_contrato A ingreso_tipo_mov A ingreso_codigo_otro A " )
