E=~"ingreso.tipo_cob~" ASC=yes )  ORDER(NAME=~"ingreso.monto~" ASC=no) ARG(NAME = ~"fec_ini~" TYPE = date)  ARG(NAME = ~"caja~" TYPE = string)  ARG(NAME = ~"rut~" TYPE = number)  ARG(NAME = ~"folio~" TYPE = number) " arguments=(("fec_ini", date),("caja", string),("rut", number),("folio", number))  sort="ingreso_folio A ingreso_tipo_cob A ingreso_monto D " )
