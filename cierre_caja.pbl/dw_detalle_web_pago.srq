PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME="documentos" )  TABLE(NAME="cadena" )  TABLE(NAME="ingreso" ) COLUMN(NAME="documentos.monto") COLUMN(NAME="documentos.cod_caja") COLUMN(NAME="documentos.fecha_pago") COLUMN(NAME="documentos.cod_pago") COLUMN(NAME="documentos.hora_pago") COLUMN(NAME="documentos.minuto_pago") COLUMN(NAME="documentos.folio") COLUMN(NAME="documentos.tipo_cob") COLUMN(NAME="documentos.rezago") COLUMN(NAME="documentos.nro_cuotas_credito") COLUMN(NAME="documentos.tipo_tarjeta_credito") COLUMN(NAME="documentos.tipo_pago_tarjeta_credito") COLUMN(NAME="documentos.fecha_venc") COLUMN(NAME="cadena.cod_parque")    JOIN (LEFT="ingreso.base"    OP ="="RIGHT="cadena.codigo"    OUTER1 ="ingreso.base" )    JOIN (LEFT="ingreso.serie"    OP ="="RIGHT="cadena.serie"    OUTER1 ="ingreso.serie" )    JOIN (LEFT="ingreso.contrato"    OP ="="RIGHT="cadena.numero"    OUTER1 ="ingreso.contrato" )    JOIN (LEFT="documentos.folio"    OP ="="RIGHT="ingreso.folio" )    JOIN (LEFT="documentos.tipo_cob"    OP ="="RIGHT="ingreso.tipo_cob" )    JOIN (LEFT="documentos.fecha_pago"    OP ="="RIGHT="ingreso.fecha_pago" )WHERE(    EXP1 ="((~"DOCUMENTOS~".~"FECHA_PAGO~""   OP =">="    EXP2 =":fecha_ini"    LOGIC ="And" ) WHERE(    EXP1 ="~"DOCUMENTOS~".~"FECHA_PAGO~""   OP ="<="    EXP2 =":fecha_fin)"    LOGIC ="or" ) WHERE(    EXP1 ="(~"DOCUMENTOS~".~"FECHA_PAGO~""   OP =">="    EXP2 =":fecha_ini"    LOGIC ="And" ) WHERE(    EXP1 ="~"DOCUMENTOS~".~"HORA_PAGO~""   OP =">="    EXP2 =":hora_ini"    LOGIC ="And" ) WHERE(    EXP1 ="~"DOCUMENTOS~".~"MINUTO_PAGO~""   OP =">="    EXP2 =":min_ini)"    LOGIC ="And" ) WHERE(    EXP1 ="(~"DOCUMENTOS~".~"FECHA_PAGO~""   OP ="<="    EXP2 =":fecha_fin"    LOGIC ="And" ) WHERE(    EXP1 ="~"DOCUMENTOS~".~"HORA_PAGO~""   OP ="<="    EXP2 =":hora_fin"    LOGIC ="And" ) WHERE(    EXP1 ="~"DOCUMENTOS~".~"MINUTO_PAGO~""   OP ="<="    EXP2 =":min_fin))" ) )    UNION (PBSELECT( VERSION(400) TABLE(NAME="cadena" )  TABLE(NAME="ingreso" ) COLUMN(NAME="ingreso.monto") COLUMN(NAME="ingreso.cod_caja") COLUMN(NAME="ingreso.fecha_pago") COMPUTE(NAME="'EF'") COMPUTE(NAME="to_number(substr( to_char(~"INGRESO~".~"FECHA_SISTEMA~",'ddmmyyyyhhmm'),9,2))") COMPUTE(NAME="to_number(substr( to_char(~"INGRESO~".~"FECHA_SISTEMA~",'ddmmyyyyhhmm'),11,2))") COLUMN(NAME="ingreso.folio") COLUMN(NAME="ingreso.tipo_cob") COLUMN(NAME="ingreso.rezago") COMPUTE(NAME="0") COMPUTE(NAME="0") COMPUTE(NAME="0") COLUMN(NAME="ingreso.fecha_venc") COLUMN(NAME="cadena.cod_parque")    JOIN (LEFT="ingreso.serie"    OP ="="RIGHT="cadena.serie"    OUTER1 ="ingreso.serie" )    JOIN (LEFT="ingreso.contrato"    OP ="="RIGHT="cadena.numero"    OUTER1 ="ingreso.contrato" )    JOIN (LEFT="ingreso.base"    OP ="="RIGHT="cadena.codigo"    OUTER1 ="ingreso.base" )WHERE(    EXP1 ="(~"INGRESO~".~"FECHA_PAGO~""   OP =">="    EXP2 =":dt_fecha_ini"    LOGIC ="and" ) WHERE(    EXP1 ="~"INGRESO~".~"FECHA_PAGO~""   OP ="<="    EXP2 =":dt_fecha_fin)"    LOGIC ="And" ) WHERE(    EXP1 ="(~"INGRESO~".~"FECHA_SISTEMA~""   OP =">="    EXP2 =":dt_fecha_ini"    LOGIC ="And" ) WHERE(    EXP1 ="~"INGRESO~".~"FECHA_SISTEMA~""   OP ="<="    EXP2 =":dt_fecha_fin)" ) )) ARG(NAME = "fecha_ini" TYPE = date)  ARG(NAME = "hora_ini" TYPE = number)  ARG(NAME = "min_ini" TYPE = number)  ARG(NAME = "fecha_fin" TYPE = date)  ARG(NAME = "hora_fin" TYPE = number)  ARG(NAME = "min_fin" TYPE = number)  ARG(NAME = "dt_fecha_ini" TYPE = datetime)  ARG(NAME = "dt_fecha_fin" TYPE = datetime) 