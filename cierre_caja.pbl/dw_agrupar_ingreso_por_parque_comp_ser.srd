 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"ingreso~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"cliente_rezago~" )  TABLE(NAME=~"cd_folio~" ) COLUMN(NAME=~"ingreso.folio~") COLUMN(NAME=~"ingreso.tipo_cob~") COLUMN(NAME=~"cadena.cod_parque~") COLUMN(NAME=~"cd_folio.cod_parque~") COLUMN(NAME=~"ingreso.cod_caja~")    JOIN (LEFT=~"ingreso.base~"    OP =~"=~"RIGHT=~"cadena.codigo~"    OUTER1 =~"ingreso.base~" )    JOIN (LEFT=~"ingreso.serie~"    OP =~"=~"RIGHT=~"cadena.serie~"    OUTER1 =~"ingreso.serie~" )    JOIN (LEFT=~"ingreso.contrato~"    OP =~"=~"RIGHT=~"cadena.numero~"    OUTER1 =~"ingreso.contrato~" )    JOIN (LEFT=~"ingreso.rut~"    OP =~"=~"RIGHT=~"cliente_rezago.rut~"    OUTER1 =~"ingreso.rut~" )    JOIN (LEFT=~"ingreso.folio~"    OP =~"=~"RIGHT=~"cliente_rezago.folio~"    OUTER1 =~"ingreso.folio~" )    JOIN (LEFT=~"ingreso.tipo_cob~"    OP =~"=~"RIGHT=~"cliente_rezago.cod_pago~"    OUTER1 =~"ingreso.tipo_cob~" )    JOIN (LEFT=~"cliente_rezago.base~"    OP =~"=~"RIGHT=~"cd_folio.base~"    OUTER1 =~"cliente_rezago.base~" )    JOIN (LEFT=~"cliente_rezago.serie~"    OP =~"=~"RIGHT=~"cd_folio.serie~"    OUTER1 =~"cliente_rezago.serie~" )    JOIN (LEFT=~"cliente_rezago.numero~"    OP =~"=~"RIGHT=~"cd_folio.numero~"    OUTER1 =~"cliente_rezago.numero~" )WHERE(    EXP1 =~"(~~~"INGRESO~~~".~~~"SERVIPAG~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"SERVIPAG~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"PAGO_HIST~~~"~"   OP =~"=~"    EXP2 =~"'A'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"FECHA_PAGO~~~"~"   OP =~"<>~"    EXP2 =~"~~~"INGRESO~~~".~~~"SERVIPAG~~~"~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque)~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = date)  ARG(NAME = ~"fecha_fin~" TYPE = date)  ARG(NAME = ~"parque~" TYPE = number) " arguments=(("fecha_ini", date),("fecha_fin", date),("parque", number))  sort="ingreso_cod_caja A " )
