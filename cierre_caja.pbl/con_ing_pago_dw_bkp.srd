 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"INGRESO~" )  TABLE(NAME=~"COD_MOVI~" ) COLUMN(NAME=~"INGRESO.folio~") COLUMN(NAME=~"COD_MOVI.des_ing~") COLUMN(NAME=~"INGRESO.monto~") COLUMN(NAME=~"INGRESO.cuotas_pag~") COLUMN(NAME=~"INGRESO.fecha_pago~") COLUMN(NAME=~"INGRESO.cod_caja~") COLUMN(NAME=~"INGRESO.rezago~") COLUMN(NAME=~"INGRESO.valor_uf~") COLUMN(NAME=~"INGRESO.serie~") COLUMN(NAME=~"INGRESO.contrato~") COLUMN(NAME=~"INGRESO.tipo_cob~") COLUMN(NAME=~"INGRESO.base~") COLUMN(NAME=~"INGRESO.codigo_otro~") COLUMN(NAME=~"INGRESO.servipag~") COLUMN(NAME=~"INGRESO.usuario~") COLUMN(NAME=~"INGRESO.tipo_mov~") COLUMN(NAME=~"INGRESO.rut~")    JOIN (LEFT=~"INGRESO.tipo_mov~"    OP =~"=~"RIGHT=~"COD_MOVI.cod_ing~" )WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"FOLIO~~~"~"   OP =~"=~"    EXP2 =~":folio~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"TIPO_COB~~~"~"   OP =~"=~"    EXP2 =~":tcom~" ) ) ARG(NAME = ~"folio~" TYPE = number)  ARG(NAME = ~"tcom~" TYPE = string) " arguments=(("folio", number),("tcom", string)) )
