 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"DOCUMENTOS~" ) COLUMN(NAME=~"DOCUMENTOS.folio~") COLUMN(NAME=~"DOCUMENTOS.n_cheque~") COLUMN(NAME=~"DOCUMENTOS.cod_banco~") COLUMN(NAME=~"DOCUMENTOS.monto~") COLUMN(NAME=~"DOCUMENTOS.fecha_venc~") COLUMN(NAME=~"DOCUMENTOS.cod_pago~") COLUMN(NAME=~"DOCUMENTOS.estado_ch~")WHERE(    EXP1 =~"~~~"DOCUMENTOS~~~".~~~"FOLIO~~~"~"   OP =~"=~"    EXP2 =~":folio~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"DOCUMENTOS~~~".~~~"TIPO_COB~~~"~"   OP =~"=~"    EXP2 =~":tcom1~" ) ) ORDER(NAME=~"DOCUMENTOS.fecha_venc~" ASC=yes ) ARG(NAME = ~"folio~" TYPE = number)  ARG(NAME = ~"tcom1~" TYPE = string) " arguments=(("folio", number),("tcom1", string)) )
