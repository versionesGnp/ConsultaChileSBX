 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"cliente_rezago~" )  TABLE(NAME=~"nota_de_credito~" ) COLUMN(NAME=~"cliente_rezago.rut~") COLUMN(NAME=~"cliente_rezago.base~") COLUMN(NAME=~"cliente_rezago.serie~") COLUMN(NAME=~"cliente_rezago.numero~") COLUMN(NAME=~"cliente_rezago.nombre~") COLUMN(NAME=~"cliente_rezago.ap_paterno~") COLUMN(NAME=~"cliente_rezago.ap_materno~") COLUMN(NAME=~"cliente_rezago.direccion_part~") COLUMN(NAME=~"cliente_rezago.comuna_part~") COLUMN(NAME=~"cliente_rezago.ciudad_part~") COLUMN(NAME=~"cliente_rezago.telefono_part~") COLUMN(NAME=~"cliente_rezago.fecha_crea~") COLUMN(NAME=~"cliente_rezago.usuario~") COLUMN(NAME=~"cliente_rezago.dv~") COLUMN(NAME=~"cliente_rezago.cod_pago~") COLUMN(NAME=~"cliente_rezago.folio~") COLUMN(NAME=~"cliente_rezago.fecha_pago~") COLUMN(NAME=~"cliente_rezago.estado~") COLUMN(NAME=~"cliente_rezago.caja~") COLUMN(NAME=~"cliente_rezago.fecha_traspaso_rezago~") COLUMN(NAME=~"cliente_rezago.usuario_genera_traspaso~") COLUMN(NAME=~"cliente_rezago.cod_parque~") COLUMN(NAME=~"nota_de_credito.tipo_cob_original~") COLUMN(NAME=~"nota_de_credito.folio_original~")    JOIN (LEFT=~"cliente_rezago.folio~"    OP =~"=~"RIGHT=~"nota_de_credito.folio~"    OUTER1 =~"cliente_rezago.folio~" )    JOIN (LEFT=~"cliente_rezago.cod_pago~"    OP =~"=~"RIGHT=~"nota_de_credito.tipo_cob~"    OUTER1 =~"cliente_rezago.cod_pago~" )    JOIN (LEFT=~"cliente_rezago.fecha_pago~"    OP =~"=~"RIGHT=~"nota_de_credito.fecha_pago~"    OUTER1 =~"cliente_rezago.fecha_pago~" )WHERE(    EXP1 =~"~~~"CLIENTE_REZAGO~~~".~~~"RUT~~~"~"   OP =~"=~"    EXP2 =~":rut~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CLIENTE_REZAGO~~~".~~~"COD_PAGO~~~"~"   OP =~"=~"    EXP2 =~":cod_pago~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CLIENTE_REZAGO~~~".~~~"FOLIO~~~"~"   OP =~"=~"    EXP2 =~":folio~" ) ) ARG(NAME = ~"rut~" TYPE = number)  ARG(NAME = ~"cod_pago~" TYPE = string)  ARG(NAME = ~"folio~" TYPE = number) " arguments=(("rut", number),("cod_pago", string),("folio", number)) )
