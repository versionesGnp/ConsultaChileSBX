 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"nota_de_credito~" ) COLUMN(NAME=~"nota_de_credito.tipo_cob~") COLUMN(NAME=~"nota_de_credito.folio~") COLUMN(NAME=~"nota_de_credito.fecha_pago~") COLUMN(NAME=~"nota_de_credito.tipo_mov~") COLUMN(NAME=~"nota_de_credito.estado~") COLUMN(NAME=~"nota_de_credito.monto~") COLUMN(NAME=~"nota_de_credito.cuotas_pag~") COLUMN(NAME=~"nota_de_credito.base~") COLUMN(NAME=~"nota_de_credito.serie~") COLUMN(NAME=~"nota_de_credito.numero~") COLUMN(NAME=~"nota_de_credito.tipo_cob_original~") COLUMN(NAME=~"nota_de_credito.folio_original~") COLUMN(NAME=~"nota_de_credito.codigo_otro~") COMPUTE(NAME=~"0 as iva~")WHERE(    EXP1 =~"~~~"NOTA_DE_CREDITO~~~".~~~"TIPO_COB_ORIGINAL~~~"~"   OP =~"=~"    EXP2 =~":ls_tipo_comp~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"NOTA_DE_CREDITO~~~".~~~"FOLIO_ORIGINAL~~~"~"   OP =~"=~"    EXP2 =~":ll_folio~" ) ) ARG(NAME = ~"ls_tipo_comp~" TYPE = string)  ARG(NAME = ~"ll_folio~" TYPE = number) " update="NOTA_DE_CREDITO" updatewhere=0 updatekeyinplace=yes arguments=(("ls_tipo_comp", string),("ll_folio", number)) )
