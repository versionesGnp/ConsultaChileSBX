 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"documentos~" )  TABLE(NAME=~"ingreso~" )  TABLE(NAME=~"cliente_rezago~" ) COLUMN(NAME=~"documentos.monto~") COLUMN(NAME=~"documentos.cod_caja~") COLUMN(NAME=~"documentos.rezago~") COLUMN(NAME=~"documentos.cod_pago~") COLUMN(NAME=~"ingreso.rut~") COLUMN(NAME=~"ingreso.contrato~") COMPUTE(NAME=~"0~") COLUMN(NAME=~"cliente_rezago.base~") COLUMN(NAME=~"cliente_rezago.serie~") COLUMN(NAME=~"cliente_rezago.numero~") COLUMN(NAME=~"ingreso.serie~") COLUMN(NAME=~"ingreso.base~") COLUMN(NAME=~"documentos.folio~")    JOIN (LEFT=~"ingreso.rut~"    OP =~"=~"RIGHT=~"cliente_rezago.rut~"    OUTER1 =~"ingreso.rut~" )    JOIN (LEFT=~"ingreso.folio~"    OP =~"=~"RIGHT=~"cliente_rezago.folio~"    OUTER1 =~"ingreso.folio~" )    JOIN (LEFT=~"ingreso.fecha_pago~"    OP =~"=~"RIGHT=~"cliente_rezago.fecha_pago~"    OUTER1 =~"ingreso.fecha_pago~" )    JOIN (LEFT=~"documentos.folio~"    OP =~"=~"RIGHT=~"ingreso.folio~" )    JOIN (LEFT=~"documentos.tipo_cob~"    OP =~"=~"RIGHT=~"ingreso.tipo_cob~" )WHERE(    EXP1 =~"~~~"DOCUMENTOS~~~".~~~"FECHA_PAGO~~~"~"   OP =~"=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"DOCUMENTOS~~~".~~~"COD_CAJA~~~"~"   OP =~"=~"    EXP2 =~":caja~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"DOCUMENTOS~~~".~~~"COD_PAGO~~~"~"   OP =~"=~"    EXP2 =~":cod_pago~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"DOCUMENTOS~~~".~~~"TIPO_COB~~~"~"   OP =~"=~"    EXP2 =~"'BL'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"DOCUMENTOS~~~".~~~"TIPO_COB~~~"~"   OP =~"=~"    EXP2 =~"'B0')~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = datetime)  ARG(NAME = ~"caja~" TYPE = string)  ARG(NAME = ~"cod_pago~" TYPE = string) " arguments=(("fecha_ini", datetime),("caja", string),("cod_pago", string)) )
