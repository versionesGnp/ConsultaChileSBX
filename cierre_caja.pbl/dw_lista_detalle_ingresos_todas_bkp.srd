 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ingreso~" ) COLUMN(NAME=~"ingreso.folio~") COLUMN(NAME=~"ingreso.tipo_cob~") COLUMN(NAME=~"ingreso.fecha_pago~") COLUMN(NAME=~"ingreso.servipag~") COLUMN(NAME=~"ingreso.tipo_mov~") COLUMN(NAME=~"ingreso.monto~") COLUMN(NAME=~"ingreso.cuotas_pag~") COLUMN(NAME=~"ingreso.base~") COLUMN(NAME=~"ingreso.serie~") COLUMN(NAME=~"ingreso.contrato~") COLUMN(NAME=~"ingreso.cod_caja~") COLUMN(NAME=~"ingreso.rezago~") COLUMN(NAME=~"ingreso.valor_uf~") COLUMN(NAME=~"ingreso.rut~") COLUMN(NAME=~"ingreso.cod_age~") COLUMN(NAME=~"ingreso.codigo_otro~") COLUMN(NAME=~"ingreso.usuario~") COMPUTE(NAME=~"0~")WHERE(    EXP1 =~"(~~~"INGRESO~~~".~~~"FECHA_PAGO~~~"~"   OP =~">=~"    EXP2 =~":fecha~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"FECHA_PAGO~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"PAGO_HIST~~~"~"   OP =~"=~"    EXP2 =~"'A'~" ) ) ARG(NAME = ~"caja~" TYPE = string)  ARG(NAME = ~"fecha~" TYPE = date)  ARG(NAME = ~"fecha_fin~" TYPE = date) " arguments=(("caja", string),("fecha", date),("fecha_fin", date))  sort="fecha_pago D folio D monto D " )
