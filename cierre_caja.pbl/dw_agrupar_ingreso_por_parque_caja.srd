 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ingreso~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"cliente_rezago~" )  TABLE(NAME=~"cd_folio~" ) COLUMN(NAME=~"ingreso.folio~") COLUMN(NAME=~"ingreso.tipo_cob~") COLUMN(NAME=~"ingreso.base~") COLUMN(NAME=~"ingreso.serie~") COLUMN(NAME=~"ingreso.contrato~") COLUMN(NAME=~"ingreso.monto~") COLUMN(NAME=~"ingreso.cod_caja~") COLUMN(NAME=~"ingreso.rut~") COLUMN(NAME=~"cadena.cod_parque~") COLUMN(NAME=~"cd_folio.cod_parque~") COLUMN(NAME=~"ingreso.fecha_pago~") COLUMN(NAME=~"ingreso.servipag~") COLUMN(NAME=~"cliente_rezago.base~") COLUMN(NAME=~"cliente_rezago.serie~") COLUMN(NAME=~"cliente_rezago.numero~") COLUMN(NAME=~"ingreso.tipo_mov~") COMPUTE(NAME=~"0~") COLUMN(NAME=~"ingreso.cuotas_pag~") COLUMN(NAME=~"ingreso.rezago~") COLUMN(NAME=~"ingreso.valor_uf~") COLUMN(NAME=~"ingreso.fecha_venc~") COLUMN(NAME=~"ingreso.codigo_otro~")    JOIN (LEFT=~"ingreso.base~"    OP =~"=~"RIGHT=~"cadena.codigo~"    OUTER1 =~"ingreso.base~" )    JOIN (LEFT=~"ingreso.serie~"    OP =~"=~"RIGHT=~"cadena.serie~"    OUTER1 =~"ingreso.serie~" )    JOIN (LEFT=~"ingreso.contrato~"    OP =~"=~"RIGHT=~"cadena.numero~"    OUTER1 =~"ingreso.contrato~" )    JOIN (LEFT=~"ingreso.rut~"    OP =~"=~"RIGHT=~"cliente_rezago.rut~"    OUTER1 =~"ingreso.rut~" )    JOIN (LEFT=~"ingreso.folio~"    OP =~"=~"RIGHT=~"cliente_rezago.folio~"    OUTER1 =~"ingreso.folio~" )    JOIN (LEFT=~"ingreso.tipo_cob~"    OP =~"=~"RIGHT=~"cliente_rezago.cod_pago~"    OUTER1 =~"ingreso.tipo_cob~" )    JOIN (LEFT=~"cliente_rezago.base~"    OP =~"=~"RIGHT=~"cd_folio.base~"    OUTER1 =~"cliente_rezago.base~" )    JOIN (LEFT=~"cliente_rezago.serie~"    OP =~"=~"RIGHT=~"cd_folio.serie~"    OUTER1 =~"cliente_rezago.serie~" )    JOIN (LEFT=~"cliente_rezago.numero~"    OP =~"=~"RIGHT=~"cd_folio.numero~"    OUTER1 =~"cliente_rezago.numero~" )WHERE(    EXP1 =~"(~~~"INGRESO~~~".~~~"FECHA_PAGO~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"FECHA_PAGO~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"PAGO_HIST~~~"~"   OP =~"=~"    EXP2 =~"'A'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"COD_CAJA~~~"~"   OP =~"=~"    EXP2 =~":caja)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"CADENA~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque)~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = datetime)  ARG(NAME = ~"fecha_fin~" TYPE = datetime)  ARG(NAME = ~"caja~" TYPE = string)  ARG(NAME = ~"parque~" TYPE = number) " arguments=(("fecha_ini", datetime),("fecha_fin", datetime),("caja", string),("parque", number))  sort="ingreso_cod_caja A ingreso_contrato A " )
