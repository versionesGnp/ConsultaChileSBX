table(column=(type=char(2) update=yes updatewhereclause=yes name=sector dbname="lista_precio.sector" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=capacidad dbname="lista_precio.capacidad" )
 column=(type=char(2) update=yes updatewhereclause=yes name=canal dbname="lista_precio.canal" )
 column=(type=char(1) update=yes updatewhereclause=yes name=t_const dbname="lista_precio.t_const" )
 column=(type=char(1) update=yes updatewhereclause=yes name=t_sepult dbname="lista_precio.t_sepult" )
 column=(type=decimal(4) updatewhereclause=yes name=cod_parque dbname="lista_precio.cod_parque" )
 column=(type=decimal(4) updatewhereclause=yes name=lista_precio_tipo_producto dbname="lista_precio.tipo_producto" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=liberador dbname="lista_precio.liberador" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=mantencion dbname="lista_precio.mantencion" )
 column=(type=decimal(4) updatewhereclause=yes name=lista_precio_reduccion dbname="lista_precio.reduccion" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=valor dbname="lista_precio.valor" )
 column=(type=char(20) updatewhereclause=yes name=cod_parq_nombre dbname="cod_parq.nombre" )
 column=(type=char(1) updatewhereclause=yes name=lista_precio_estado dbname="lista_precio.estado" values="Activo	A/Inactivo	I/" )
 column=(type=datetime updatewhereclause=yes name=lista_precio_fecha_vigencia dbname="lista_precio.fecha_vigencia" )
 retrieve="  SELECT ~"LISTA_PRECIO~".~"SECTOR~",   
         ~"LISTA_PRECIO~".~"CAPACIDAD~",   
         ~"LISTA_PRECIO~".~"CANAL~",   
         ~"LISTA_PRECIO~".~"T_CONST~",   
         ~"LISTA_PRECIO~".~"T_SEPULT~",
         ~"LISTA_PRECIO~".~"COD_PARQUE~",
         ~"LISTA_PRECIO~".~"TIPO_PRODUCTO~",
         --~"LISTA_PRECIO~".~"DERECHO~",   
         ~"LISTA_PRECIO~".~"LIBERADOR~",   
         ~"LISTA_PRECIO~".~"MANTENCION~",   
         ~"LISTA_PRECIO~".~"REDUCCION~",   
         ~"LISTA_PRECIO~".~"VALOR~",   
         ~"COD_PARQ~".~"NOMBRE~",
         ~"LISTA_PRECIO~".~"ESTADO~",
         ~"LISTA_PRECIO~".~"FECHA_VIGENCIA~"         
    FROM ~"LISTA_PRECIO~",   
         ~"COD_PARQ~"  
   WHERE ( ~"LISTA_PRECIO~".~"COD_PARQUE~" = ~"COD_PARQ~".~"CODIGO~" ) and  
         ( 
         ( ~"LISTA_PRECIO~".~"COD_PARQUE~" = :cod_parque ) --AND   ( ~"LISTA_PRECIO~".~"ESTADO~" = 'A' )
         )   
ORDER BY ~"LISTA_PRECIO~".~"T_SEPULT~" ASC,   
         ~"LISTA_PRECIO~".~"SECTOR~" ASC,   
         ~"LISTA_PRECIO~".~"CAPACIDAD~" ASC,   
         ~"LISTA_PRECIO~".~"CANAL~" ASC   " arguments=(("cod_parque", number)) )
