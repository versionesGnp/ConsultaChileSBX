 retrieve="  SELECT ~"LISTA_PRECIO~".~"SECTOR~",   
         ~"LISTA_PRECIO~".~"CAPACIDAD~",   
         ~"LISTA_PRECIO~".~"CANAL~",   
         ~"LISTA_PRECIO~".~"T_CONST~",   
         ~"LISTA_PRECIO~".~"T_SEPULT~",
         ~"LISTA_PRECIO~".~"COD_PARQUE~",
         ~"LISTA_PRECIO~".~"TIPO_PRODUCTO~",
         ~"LISTA_PRECIO~".~"LIBERADOR~",   
         ~"LISTA_PRECIO~".~"MANTENCION~",   
         ~"LISTA_PRECIO~".~"REDUCCION~",   
         ~"LISTA_PRECIO~".~"VALOR~",   
         ~"COD_PARQ~".~"NOMBRE~",
         ~"LISTA_PRECIO~".~"ESTADO~",
         ~"LISTA_PRECIO~".~"FECHA_VIGENCIA~"  ,       
         ~"LISTA_PRECIO~".~"USUARIO_CREA~"         
    FROM ~"LISTA_PRECIO~",   
         ~"COD_PARQ~"  
   WHERE ( ~"LISTA_PRECIO~".~"COD_PARQUE~" = ~"COD_PARQ~".~"CODIGO~" ) and  
         ( ~"LISTA_PRECIO~".~"SECTOR~" = :cod_SECTOR ) AND  
         ( ~"LISTA_PRECIO~".~"CAPACIDAD~" = :CAPACIDAD ) AND  
         ( ~"LISTA_PRECIO~".~"CANAL~" = :cod_CANAL ) AND  
         ( ~"LISTA_PRECIO~".~"T_CONST~" = :cod_T_CONST ) AND  
         ( ~"LISTA_PRECIO~".~"T_SEPULT~" = :cod_T_SEPULT ) AND  
         ( ~"LISTA_PRECIO~".~"COD_PARQUE~" = :cod_parque ) AND  
         ( ~"LISTA_PRECIO~".~"TIPO_PRODUCTO~" = :cod_TIPO_PRODUCTO )  and 
         (TO_DATE( ~"LISTA_PRECIO~".~"FECHA_VIGENCIA~") = TO_DATE(:fec_vigencia) )  
  
" update="LISTA_PRECIO" updatewhere=0 updatekeyinplace=no arguments=(("cod_sector", string),("capacidad", number),("cod_canal", string),("cod_t_const", string),("cod_t_sepult", string),("cod_parque", number),("cod_tipo_producto", number),("fec_vigencia", datetime)) )
