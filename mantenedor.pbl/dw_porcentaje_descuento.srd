 retrieve="  SELECT ~"MENSAJES_DESCUENTO_PORCENTAJES~".~"ID_PORCENTAJE~", 
         ~"MENSAJES_DESCUENTO_PORCENTAJES~".~"DESCRIPCION~"   ,   
         ~"MENSAJES_DESCUENTO_PORCENTAJES~".~"FECHA_CREACION~",   
         ~"MENSAJES_DESCUENTO_PORCENTAJES~".~"PORCENTAJE~",   
         ~"MENSAJES_DESCUENTO_PORCENTAJES~".~"USUARIO_CREA~",   
         ~"MENSAJES_DESCUENTO_PORCENTAJES~".~"ESTADO~",   
         ~"MENSAJES_DESCUENTO_PORCENTAJES~".~"FECHA_CAMBIO_ESTADO~",   
         ~"MENSAJES_DESCUENTO_PORCENTAJES~".~"USUARIO_MODIFICA~"  
    FROM ~"MENSAJES_DESCUENTO_PORCENTAJES~"  
order by  ~"MENSAJES_DESCUENTO_PORCENTAJES~".~"ID_PORCENTAJE~" asc
" update="MENSAJES_DESCUENTO_PORCENTAJES" updatewhere=1 updatekeyinplace=no )
