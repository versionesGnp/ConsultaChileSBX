 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"fallecidos~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"cliente~" ) COLUMN(NAME=~"fallecidos.sector~") COLUMN(NAME=~"fallecidos.n_sep~") COLUMN(NAME=~"fallecidos.nombres~") COLUMN(NAME=~"fallecidos.ap_paterno~") COLUMN(NAME=~"fallecidos.ap_materno~") COLUMN(NAME=~"fallecidos.fec_sep~") COLUMN(NAME=~"fallecidos.fec_fall~") COLUMN(NAME=~"fallecidos.fec_nac~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cliente.rut~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"cadena.serie~") COLUMN(NAME=~"cadena.numero~")    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"fallecidos.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"fallecidos.ss~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"fallecidos.contrato~" )    JOIN (LEFT=~"cadena.rut~"    OP =~"=~"RIGHT=~"cliente.rut~" )WHERE(    EXP1 =~"~~~"FALLECIDOS~~~".~~~"SECTOR~~~"~"   OP =~"=~"    EXP2 =~":ls_sector~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FALLECIDOS~~~".~~~"N_SEP~~~"~"   OP =~"=~"    EXP2 =~":ls_sepul~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FALLECIDOS~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~" ) ) ARG(NAME = ~"ls_sector~" TYPE = string)  ARG(NAME = ~"ls_sepul~" TYPE = string)  ARG(NAME = ~"parque~" TYPE = number) " arguments=(("ls_sector", string),("ls_sepul", string),("parque", number))  sort="fallecidos_fec_fall A " )
