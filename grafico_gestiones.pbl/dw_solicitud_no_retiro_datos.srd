 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"solicitud_no_retro~" )  TABLE(NAME=~"cliente~" ) COLUMN(NAME=~"solicitud_no_retro.correlativo~") COLUMN(NAME=~"solicitud_no_retro.rut_titular~") COLUMN(NAME=~"solicitud_no_retro.dv_titular~") COLUMN(NAME=~"solicitud_no_retro.base~") COLUMN(NAME=~"solicitud_no_retro.serie~") COLUMN(NAME=~"solicitud_no_retro.numero~") COLUMN(NAME=~"solicitud_no_retro.parque~") COLUMN(NAME=~"solicitud_no_retro.sepultura~") COLUMN(NAME=~"solicitud_no_retro.fallecido~") COLUMN(NAME=~"solicitud_no_retro.motivo_solicitud~") COLUMN(NAME=~"solicitud_no_retro.golsa_solicitud~") COLUMN(NAME=~"solicitud_no_retro.fecha_solicitud~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"solicitud_no_retro.fecha_sistema~") COLUMN(NAME=~"solicitud_no_retro.sector~") COLUMN(NAME=~"solicitud_no_retro.solicitante~")    JOIN (LEFT=~"solicitud_no_retro.rut_titular~"    OP =~"=~"RIGHT=~"cliente.rut~" )WHERE(    EXP1 =~"~~~"SOLICITUD_NO_RETRO~~~".~~~"CORRELATIVO~~~"~"   OP =~"=~"    EXP2 =~":correlativo~" ) ) ARG(NAME = ~"correlativo~" TYPE = number) " arguments=(("correlativo", number)) )
