 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"solicitud_no_retro~" ) COLUMN(NAME=~"solicitud_no_retro.correlativo~") COLUMN(NAME=~"solicitud_no_retro.rut_titular~") COLUMN(NAME=~"solicitud_no_retro.dv_titular~") COLUMN(NAME=~"solicitud_no_retro.base~") COLUMN(NAME=~"solicitud_no_retro.serie~") COLUMN(NAME=~"solicitud_no_retro.numero~") COLUMN(NAME=~"solicitud_no_retro.parque~") COLUMN(NAME=~"solicitud_no_retro.sector~") COLUMN(NAME=~"solicitud_no_retro.sepultura~") COLUMN(NAME=~"solicitud_no_retro.fallecido~") COLUMN(NAME=~"solicitud_no_retro.motivo_solicitud~") COLUMN(NAME=~"solicitud_no_retro.golsa_solicitud~") COLUMN(NAME=~"solicitud_no_retro.fecha_solicitud~") COLUMN(NAME=~"solicitud_no_retro.fecha_sistema~") COLUMN(NAME=~"solicitud_no_retro.solicitante~") COLUMN(NAME=~"solicitud_no_retro.usuario~")WHERE(    EXP1 =~"~~~"SOLICITUD_NO_RETRO~~~".~~~"FECHA_SOLICITUD~~~"~"   OP =~">=~"    EXP2 =~":ld_fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOLICITUD_NO_RETRO~~~".~~~"FECHA_SOLICITUD~~~"~"   OP =~"<=~"    EXP2 =~":ld_fecha_fin~" ) ) ARG(NAME = ~"ld_fecha_ini~" TYPE = date)  ARG(NAME = ~"ld_fecha_fin~" TYPE = date) " update="SOLICITUD_NO_RETRO" updatewhere=1 updatekeyinplace=no arguments=(("ld_fecha_ini", date),("ld_fecha_fin", date))  sort="correlativo A " )
