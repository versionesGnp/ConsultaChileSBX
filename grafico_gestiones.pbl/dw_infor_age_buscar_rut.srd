 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"informe_agente~" )  TABLE(NAME=~"agentes~" )  TABLE(NAME=~"supervisor~" ) COLUMN(NAME=~"informe_agente.correlativo~") COLUMN(NAME=~"informe_agente.rut_contacto~") COLUMN(NAME=~"informe_agente.dv_contacto~") COLUMN(NAME=~"informe_agente.cod_sup~") COLUMN(NAME=~"informe_agente.cod_age~") COLUMN(NAME=~"informe_agente.fecha_reporte~") COLUMN(NAME=~"informe_agente.nombre_contacto~") COLUMN(NAME=~"informe_agente.apellido_paterno_contacto~") COLUMN(NAME=~"informe_agente.apellido_materno_contacto~") COLUMN(NAME=~"supervisor.nombre~") COLUMN(NAME=~"supervisor.a_paterno~") COLUMN(NAME=~"supervisor.a_materno~") COLUMN(NAME=~"agentes.nombre~") COLUMN(NAME=~"agentes.a_paterno~") COLUMN(NAME=~"agentes.a_materno~") COLUMN(NAME=~"informe_agente.estado_gestion~") COLUMN(NAME=~"informe_agente.fecha_prox_contacto~") COLUMN(NAME=~"informe_agente.estado_general~") COLUMN(NAME=~"informe_agente.fecha_sistema~") COLUMN(NAME=~"informe_agente.estado_reg~") COLUMN(NAME=~"informe_agente.tipo_venta~")    JOIN (LEFT=~"informe_agente.cod_sup~"    OP =~"=~"RIGHT=~"supervisor.cod_sup~" )    JOIN (LEFT=~"informe_agente.cod_age~"    OP =~"=~"RIGHT=~"agentes.cod_age~" )WHERE(    EXP1 =~"~~~"INFORME_AGENTE~~~".~~~"RUT_CONTACTO~~~"~"   OP =~"=~"    EXP2 =~":ll_rut~" ) ) ARG(NAME = ~"ll_rut~" TYPE = number) " arguments=(("ll_rut", number))  sort="correlativo A " )
