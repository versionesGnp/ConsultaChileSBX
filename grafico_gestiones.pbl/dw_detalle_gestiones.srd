 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"agentes~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"informe_agente~" )  TABLE(NAME=~"jefe_ventas~" )  TABLE(NAME=~"oferta_v~" )  TABLE(NAME=~"supervisor~" ) COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"cadena.serie~") COLUMN(NAME=~"cadena.numero~") COLUMN(NAME=~"informe_agente.fecha_reporte~") COLUMN(NAME=~"oferta_v.fecha~") COLUMN(NAME=~"jefe_ventas.jefe_ventas~") COLUMN(NAME=~"informe_agente.cod_sup~") COLUMN(NAME=~"informe_agente.cod_age~") COLUMN(NAME=~"supervisor.a_paterno~") COLUMN(NAME=~"supervisor.a_materno~") COLUMN(NAME=~"supervisor.nombre~") COLUMN(NAME=~"jefe_ventas.a_paterno~") COLUMN(NAME=~"jefe_ventas.a_materno~") COLUMN(NAME=~"jefe_ventas.nombre~") COLUMN(NAME=~"oferta_v.nro_oferta~") COLUMN(NAME=~"agentes.a_paterno~") COLUMN(NAME=~"agentes.a_materno~") COLUMN(NAME=~"agentes.nombre~") COLUMN(NAME=~"informe_agente.rut_contacto~") COLUMN(NAME=~"informe_agente.nombre_contacto~") COLUMN(NAME=~"informe_agente.apellido_paterno_contacto~") COLUMN(NAME=~"informe_agente.apellido_materno_contacto~")    JOIN (LEFT=~"supervisor.cod_jefe~"    OP =~"=~"RIGHT=~"jefe_ventas.jefe_ventas~" )    JOIN (LEFT=~"oferta_v.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"oferta_v.nro_oferta~"    OP =~"=~"RIGHT=~"cadena.numero~" )    JOIN (LEFT=~"cadena.rut~"    OP =~"=~"RIGHT=~"informe_agente.rut_contacto~" )    JOIN (LEFT=~"informe_agente.cod_age~"    OP =~"=~"RIGHT=~"agentes.cod_age~" )    JOIN (LEFT=~"supervisor.cod_sup~"    OP =~"=~"RIGHT=~"agentes.cod_sup~" )WHERE(    EXP1 =~"~~~"INFORME_AGENTE~~~".~~~"FECHA_REPORTE~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INFORME_AGENTE~~~".~~~"FECHA_REPORTE~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"JEFE_VENTAS~~~".~~~"JEFE_VENTAS~~~"~"   OP =~"=~"    EXP2 =~":cod_jef~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"INFORME_AGENTE~~~".~~~"COD_SUP~~~"~"   OP =~"=~"    EXP2 =~":cod_sup~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INFORME_AGENTE~~~".~~~"ESTADO_REG~~~"~"   OP =~"=~"    EXP2 =~"'A'~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = datetime)  ARG(NAME = ~"fecha_fin~" TYPE = datetime)  ARG(NAME = ~"cod_jef~" TYPE = string)  ARG(NAME = ~"cod_sup~" TYPE = string) " arguments=(("fecha_ini", datetime),("fecha_fin", datetime),("cod_jef", string),("cod_sup", string))  sort="informe_agente_cod_age A cadena_numero A " )
