 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"solicitud_no_retro~" ) COLUMN(NAME=~"solicitud_no_retro.correlativo~") COLUMN(NAME=~"solicitud_no_retro.rut_titular~") COLUMN(NAME=~"solicitud_no_retro.dv_titular~") COLUMN(NAME=~"solicitud_no_retro.parque~") COLUMN(NAME=~"solicitud_no_retro.sector~") COLUMN(NAME=~"solicitud_no_retro.sepultura~") COLUMN(NAME=~"solicitud_no_retro.fallecido~") COLUMN(NAME=~"solicitud_no_retro.motivo_solicitud~") COLUMN(NAME=~"solicitud_no_retro.fecha_solicitud~")WHERE(    EXP1 =~"~~~"SOLICITUD_NO_RETRO~~~".~~~"PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOLICITUD_NO_RETRO~~~".~~~"SECTOR~~~"~"   OP =~"=~"    EXP2 =~":sector~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOLICITUD_NO_RETRO~~~".~~~"SEPULTURA~~~"~"   OP =~"=~"    EXP2 =~":sepultura~" ) ) ARG(NAME = ~"parque~" TYPE = number)  ARG(NAME = ~"sector~" TYPE = string)  ARG(NAME = ~"sepultura~" TYPE = string) " update="SOLICITUD_NO_RETRO" updatewhere=1 updatekeyinplace=no arguments=(("parque", number),("sector", string),("sepultura", string))  sort="correlativo D " )
