 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"agentes~" )  TABLE(NAME=~"supervisor~" ) COLUMN(NAME=~"agentes.cod_age~") COLUMN(NAME=~"agentes.clave~") COLUMN(NAME=~"agentes.rut~") COLUMN(NAME=~"agentes.nombre~") COLUMN(NAME=~"agentes.a_paterno~") COLUMN(NAME=~"agentes.a_materno~") COLUMN(NAME=~"agentes.cod_sup~") COLUMN(NAME=~"supervisor.nombre~") COLUMN(NAME=~"supervisor.a_paterno~") COLUMN(NAME=~"supervisor.a_materno~") COLUMN(NAME=~"agentes.estado~") COLUMN(NAME=~"agentes.nro_de_cont~") COLUMN(NAME=~"agentes.clasificacion~") COLUMN(NAME=~"agentes.fecha_ini~")    JOIN (LEFT=~"agentes.cod_sup~"    OP =~"=~"RIGHT=~"supervisor.cod_sup~" )WHERE(    EXP1 =~"~~~"AGENTES~~~".~~~"COD_AGE~~~"~"   OP =~"=~"    EXP2 =~":usuario~" ) ) ARG(NAME = ~"usuario~" TYPE = string) " arguments=(("usuario", string)) )
