 column=(type=char(45) updatewhereclause=yes name=ficha_sepultacion_nombre_fallecido dbname="ficha_sepultacion.nombre_fallecido" )
 column=(type=char(20) updatewhereclause=yes name=ficha_sepultacion_ap_paterno_fall dbname="ficha_sepultacion.ap_paterno_fall" )
