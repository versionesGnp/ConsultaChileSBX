 column=(type=decimal(4) updatewhereclause=yes name=ficha_sepultacion_cod_parque dbname="ficha_sepultacion.cod_parque" )
 column=(type=decimal(4) updatewhereclause=yes name=cliente_rut dbname="cliente.rut" )
 column=(type=char(1) updatewhereclause=yes name=cliente_dv dbname="cliente.dv" )
 column=(type=decimal(4) updatewhereclause=yes name=ingreso_monto dbname="ingreso.monto" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cliente~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"ficha_sepultacion~" )  TABLE(NAME=~"ingreso~" ) COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"ficha_sepultacion.fecha_sepultacion~") COLUMN(NAME=~"ficha_sepultacion.hora~") COLUMN(NAME=~"cliente.fono_p~") COLUMN(NAME=~"cliente.celular~") COLUMN(NAME=~"ficha_sepultacion.sector~") COLUMN(NAME=~"ficha_sepultacion.sepultura~") COLUMN(NAME=~"ficha_sepultacion.nombre_fallecido~") COLUMN(NAME=~"ficha_sepultacion.ap_paterno_fall~") COLUMN(NAME=~"ficha_sepultacion.ap_materno_fall~") COLUMN(NAME=~"ficha_sepultacion.cod_parque~") COLUMN(NAME=~"cliente.rut~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"ingreso.monto~")    JOIN (LEFT=~"cliente.rut~"    OP =~"=~"RIGHT=~"cadena.rut~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"ficha_sepultacion.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"ficha_sepultacion.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"ficha_sepultacion.numero~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"ingreso.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"ingreso.contrato~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"ingreso.base~" )    JOIN (LEFT=~"cadena.rut~"    OP =~"=~"RIGHT=~"ingreso.rut~" )WHERE(    EXP1 =~"~~~"CLIENTE~~~".~~~"RUT~~~"~"   OP =~"=~"    EXP2 =~":ll_rut~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FICHA_SEPULTACION~~~".~~~"FECHA_SEPULTACION~~~"~"   OP =~"=~"    EXP2 =~":ldt_fecha~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"TIPO_COB~~~"~"   OP =~"=~"    EXP2 =~":tipo_cob~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"FOLIO~~~"~"   OP =~"=~"    EXP2 =~":folio~" ) ) ARG(NAME = ~"ll_rut~" TYPE = number)  ARG(NAME = ~"ldt_fecha~" TYPE = datetime)  ARG(NAME = ~"tipo_cob~" TYPE = string)  ARG(NAME = ~"folio~" TYPE = number) " arguments=(("ll_rut", number),("ldt_fecha", datetime),("tipo_cob", string),("folio", number)) )
