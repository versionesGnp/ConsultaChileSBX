 column=(type=datetime updatewhereclause=yes name=ficha_sepultacion_fecha_sepultacion dbname="ficha_sepultacion.fecha_sepultacion" )
 column=(type=decimal(4) updatewhereclause=yes name=ficha_sepultacion_hora dbname="ficha_sepultacion.hora" )
 column=(type=char(25) updatewhereclause=yes name=cliente_fono_p dbname="cliente.fono_p" )
 column=(type=char(25) updatewhereclause=yes name=cliente_celular dbname="cliente.celular" )
