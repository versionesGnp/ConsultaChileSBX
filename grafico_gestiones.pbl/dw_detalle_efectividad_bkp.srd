 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"agentes~" )  TABLE(NAME=~"informe_agente~" )  TABLE(NAME=~"jefe_ventas~" )  TABLE(NAME=~"supervisor~" ) COLUMN(NAME=~"informe_agente.nombre_contacto~") COLUMN(NAME=~"informe_agente.fecha_reporte~") COLUMN(NAME=~"jefe_ventas.jefe_ventas~") COLUMN(NAME=~"informe_agente.cod_sup~") COLUMN(NAME=~"informe_agente.cod_age~") COLUMN(NAME=~"supervisor.a_paterno~") COLUMN(NAME=~"supervisor.a_materno~") COLUMN(NAME=~"supervisor.nombre~") COLUMN(NAME=~"jefe_ventas.a_paterno~") COLUMN(NAME=~"jefe_ventas.a_materno~") COLUMN(NAME=~"jefe_ventas.nombre~") COLUMN(NAME=~"agentes.a_paterno~") COLUMN(NAME=~"agentes.a_materno~") COLUMN(NAME=~"agentes.nombre~") COLUMN(NAME=~"informe_agente.rut_contacto~") COLUMN(NAME=~"informe_agente.apellido_paterno_contacto~") COLUMN(NAME=~"informe_agente.apellido_materno_contacto~") COMPUTE(NAME=~"''~") COMPUTE(NAME=~"''~") COMPUTE(NAME=~"0~") COMPUTE(NAME=~"''~") COMPUTE(NAME=~"''~") COLUMN(NAME=~"informe_agente.estado_gestion~") COLUMN(NAME=~"informe_agente.fecha_prox_contacto~") COLUMN(NAME=~"informe_agente.observaciones~") COLUMN(NAME=~"informe_agente.fono_contacto~")    JOIN (LEFT=~"supervisor.cod_jefe~"    OP =~"=~"RIGHT=~"jefe_ventas.jefe_ventas~" )    JOIN (LEFT=~"supervisor.cod_sup~"    OP =~"=~"RIGHT=~"agentes.cod_sup~" )    JOIN (LEFT=~"informe_agente.cod_age~"    OP =~"=~"RIGHT=~"agentes.cod_age~" )WHERE(    EXP1 =~"~~~"INFORME_AGENTE~~~".~~~"FECHA_REPORTE~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INFORME_AGENTE~~~".~~~"FECHA_REPORTE~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"JEFE_VENTAS~~~".~~~"JEFE_VENTAS~~~"~"   OP =~"=~"    EXP2 =~":cod_jef~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"INFORME_AGENTE~~~".~~~"COD_SUP~~~"~"   OP =~"=~"    EXP2 =~":cod_sup~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INFORME_AGENTE~~~".~~~"ESTADO_REG~~~"~"   OP =~"=~"    EXP2 =~"'A'~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = datetime)  ARG(NAME = ~"fecha_fin~" TYPE = datetime)  ARG(NAME = ~"cod_jef~" TYPE = string)  ARG(NAME = ~"cod_sup~" TYPE = string) " arguments=(("fecha_ini", datetime),("fecha_fin", datetime),("cod_jef", string),("cod_sup", string))  sort="informe_agente_cod_age A " )
