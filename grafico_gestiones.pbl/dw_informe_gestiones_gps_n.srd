 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"informe_agente~" ) COLUMN(NAME=~"informe_agente.cod_sup~") COLUMN(NAME=~"informe_agente.cod_age~") COLUMN(NAME=~"informe_agente.fecha_reporte~") COLUMN(NAME=~"informe_agente.nombre_contacto~") COLUMN(NAME=~"informe_agente.apellido_paterno_contacto~") COLUMN(NAME=~"informe_agente.apellido_materno_contacto~") COLUMN(NAME=~"informe_agente.rut_contacto~") COLUMN(NAME=~"informe_agente.dv_contacto~") COLUMN(NAME=~"informe_agente.direccion_contacto~") COLUMN(NAME=~"informe_agente.numero_contacto~") COLUMN(NAME=~"informe_agente.depto_contacto~") COLUMN(NAME=~"informe_agente.block_contacto~") COLUMN(NAME=~"informe_agente.poblacion_villa_contacto~") COLUMN(NAME=~"informe_agente.sector~") COLUMN(NAME=~"informe_agente.ciudad_contacto~") COLUMN(NAME=~"informe_agente.comuna_contacto~") COLUMN(NAME=~"informe_agente.fono_contacto~") COLUMN(NAME=~"informe_agente.estado_gestion~") COLUMN(NAME=~"informe_agente.estado_general~") COLUMN(NAME=~"informe_agente.estado_reg~") COLUMN(NAME=~"informe_agente.tipo_via~")WHERE(    EXP1 =~"~~~"INFORME_AGENTE~~~".~~~"FECHA_REPORTE~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"INFORME_AGENTE~~~".~~~"FECHA_REPORTE~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INFORME_AGENTE~~~".~~~"ESTADO_REG~~~"~"   OP =~"=~"    EXP2 =~"'A'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INFORME_AGENTE~~~".~~~"COD_SUP~~~"~"   OP =~"=~"    EXP2 =~":cod_sup~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = date)  ARG(NAME = ~"fecha_fin~" TYPE = date)  ARG(NAME = ~"cod_sup~" TYPE = string) " arguments=(("fecha_ini", date),("fecha_fin", date),("cod_sup", string))  sort="cod_age A fecha_reporte A " )
