 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"informe_agente~" )  TABLE(NAME=~"supervisor~" )  TABLE(NAME=~"agentes~" )  TABLE(NAME=~"oferta_v~" )  TABLE(NAME=~"cadena~" ) COLUMN(NAME=~"informe_agente.cod_sup~") COLUMN(NAME=~"informe_agente.cod_age~") COLUMN(NAME=~"informe_agente.fecha_reporte~") COLUMN(NAME=~"supervisor.cod_jefe~") COLUMN(NAME=~"supervisor.nombre~") COLUMN(NAME=~"supervisor.a_paterno~") COLUMN(NAME=~"supervisor.a_materno~") COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"cadena.serie~") COLUMN(NAME=~"informe_agente.rut_contacto~") COLUMN(NAME=~"oferta_v.nro_oferta~")    JOIN (LEFT=~"informe_agente.cod_sup~"    OP =~"=~"RIGHT=~"supervisor.cod_sup~" )    JOIN (LEFT=~"agentes.cod_age~"    OP =~"=~"RIGHT=~"informe_agente.cod_age~" )    JOIN (LEFT=~"cadena.rut~"    OP =~"=~"RIGHT=~"informe_agente.rut_contacto~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"oferta_v.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"oferta_v.nro_oferta~" )WHERE(    EXP1 =~"~~~"INFORME_AGENTE~~~".~~~"FECHA_REPORTE~~~"~"   OP =~">=~"    EXP2 =~":fech_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"INFORME_AGENTE~~~".~~~"FECHA_REPORTE~~~"~"   OP =~"<=~"    EXP2 =~":fech_fin~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INFORME_AGENTE~~~".~~~"ESTADO_REG~~~"~"   OP =~"=~"    EXP2 =~"'A'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INFORME_AGENTE~~~".~~~"FECHA_REPORTE~~~"~"   OP =~">=~"    EXP2 =~"~~~"OFERTA_V~~~".~~~"FECHA~~~"~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"SUPERVISOR~~~".~~~"COD_JEFE~~~"~"   OP =~"=~"    EXP2 =~":cod_jef~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"AGENTES~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'A'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"SUPERVISOR~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'A'~" ) ) ORDER(NAME=~"informe_agente.cod_sup~" ASC=yes ) ARG(NAME = ~"fech_ini~" TYPE = datetime)  ARG(NAME = ~"fech_fin~" TYPE = datetime)  ARG(NAME = ~"cod_jef~" TYPE = string) " arguments=(("fech_ini", datetime),("fech_fin", datetime),("cod_jef", string))  sort="cod_age A " )
