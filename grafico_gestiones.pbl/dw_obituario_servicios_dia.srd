table(column=(type=char(100) update=yes updatewhereclause=yes name=fecha dbname="obituario.fecha" )
 column=(type=char(100) update=yes updatewhereclause=yes name=nombre_fall dbname="obituario.nombre_fall" )
 column=(type=char(15) update=yes updatewhereclause=yes name=area dbname="obituario.area" )
 column=(type=char(15) update=yes updatewhereclause=yes name=sector dbname="obituario.sector" )
 column=(type=char(20) update=yes updatewhereclause=yes name=sepultura dbname="obituario.sepultura" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=cod_parque dbname="obituario.cod_parque" )
 column=(type=char(0) updatewhereclause=yes name=c_asistentes dbname="c_asistentes" )
 column=(type=char(0) updatewhereclause=yes name=c_pano dbname="c_pano" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"obituario~" ) COLUMN(NAME=~"obituario.fecha~") COLUMN(NAME=~"obituario.nombre_fall~") COLUMN(NAME=~"obituario.area~") COLUMN(NAME=~"obituario.sector~") COLUMN(NAME=~"obituario.sepultura~") COLUMN(NAME=~"obituario.cod_parque~") COMPUTE(NAME=~"'' as c_asistentes~") COMPUTE(NAME=~"'' as c_pano~")WHERE(    EXP1 =~"~~~"OBITUARIO~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"OBITUARIO~~~".~~~"FECHA~~~"~"   OP =~"=~"    EXP2 =~":fecha~" ) ) ARG(NAME = ~"parque~" TYPE = number)  ARG(NAME = ~"fecha~" TYPE = string) " arguments=(("parque", number),("fecha", string))  sort="area A " )
