 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"sol_estatus~" ) COLUMN(NAME=~"sol_estatus.base~") COLUMN(NAME=~"sol_estatus.serie~") COLUMN(NAME=~"sol_estatus.numero~") COLUMN(NAME=~"sol_estatus.correlativo~") COLUMN(NAME=~"sol_estatus.codigo_solicitud~") COLUMN(NAME=~"sol_estatus.observacion~") COLUMN(NAME=~"sol_estatus.estado_reg~")WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"ESTADO_REG~~~"~"   OP =~"=~"    EXP2 =~"'A'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"CODIGO_SOLICITUD~~~"~"   OP =~"like~"    EXP2 =~":tipo_sol~" ) ) ARG(NAME = ~"tipo_sol~" TYPE = string) " update="SOL_ESTATUS" updatewhere=0 updatekeyinplace=no arguments=(("tipo_sol", string))  sort="base A serie A numero A correlativo A codigo_solicitud A " )
