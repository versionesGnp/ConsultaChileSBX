antencion_l.valor_saldo_insoluto~") COLUMN(NAME=~"repacta_mantencion_l.tipo_reprog~") COLUMN(NAME=~"repacta_mantencion_l.pie~") COLUMN(NAME=~"repacta_mantencion_l.fecha_pie~") COLUMN(NAME=~"repacta_mantencion_l.sub_total~") COLUMN(NAME=~"repacta_mantencion_l.total_cobros~") COLUMN(NAME=~"repacta_mantencion_l.tasa~") COLUMN(NAME=~"repacta_mantencion_l.tasa_interes_cuota~") COLUMN(NAME=~"repacta_mantencion_l.nro_resc~")WHERE(    EXP1 =~"~~~"REPACTA_MANTENCION_L~~~".~~~"BASE_ORIGINAL~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"REPACTA_MANTENCION_L~~~".~~~"SERIE_ORIGINAL~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"REPACTA_MANTENCION_L~~~".~~~"NUMERO_ORIGINAL~~~"~"   OP =~"=~"    EXP2 =~":numero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"REPACTA_MANTENCION_L~~~".~~~"CORRELATIVO~~~"~"   OP =~"=~"    EXP2 =~":corr~" ) ) ORDER(NAME=~"repacta_mantencion_l.correlativo~" ASC=yes ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number)  ARG(NAME = ~"corr~" TYPE = number) " update="REPACTA_MANTENCION_L" updatewhere=0 updatekeyinplace=yes arguments=(("base", string),("serie", string),("numero", number),("corr", number)) )
