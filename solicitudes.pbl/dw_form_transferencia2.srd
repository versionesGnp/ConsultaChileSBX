ME=~"sol_transferencia.domicilio_c_original~") COLUMN(NAME=~"sol_transferencia.fono_c_original~") COLUMN(NAME=~"sol_transferencia.total_renta_original~") COLUMN(NAME=~"sol_transferencia.grupo_f_original~") COLUMN(NAME=~"sol_transferencia.estado_cod_original~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"sol_transferencia.estado_ctto_original~") COLUMN(NAME=~"sol_transferencia.fecha_rescil_original~") COLUMN(NAME=~"sol_estatus.observacion~") COLUMN(NAME=~"sol_transferencia.sector_sepultura~") COLUMN(NAME=~"sol_transferencia.tipo_via~") COLUMN(NAME=~"sol_transferencia.numero_particular~") COLUMN(NAME=~"sol_transferencia.depto_particular~") COLUMN(NAME=~"sol_transferencia.block_particular~") COLUMN(NAME=~"sol_transferencia.tipo_via_original~") COLUMN(NAME=~"sol_transferencia.numero_particular_original~") COLUMN(NAME=~"sol_transferencia.depto_particular_original~") COLUMN(NAME=~"sol_transferencia.block_particular_original~")    JOIN (LEFT=~"cliente.rut~"    OP =~"=~"RIGHT=~"cadena.rut~" )    JOIN (LEFT=~"sol_estatus.base~"    OP =~"=~"RIGHT=~"sol_transferencia.base~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"sol_transferencia.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"sol_transferencia.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"sol_transferencia.numero~" )    JOIN (LEFT=~"sol_transferencia.serie~"    OP =~"=~"RIGHT=~"sol_estatus.serie~" )    JOIN (LEFT=~"sol_transferencia.numero~"    OP =~"=~"RIGHT=~"sol_estatus.numero~" )    JOIN (LEFT=~"sol_transferencia.correlativo~"    OP =~"=~"RIGHT=~"sol_estatus.correlativo~" )WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"CORRELATIVO~~~"~"   OP =~"=~"    EXP2 =~":correlativo~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"CODIGO_SOLICITUD~~~"~"   OP =~"=~"    EXP2 =~":tipo_sol~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number)  ARG(NAME = ~"correlativo~" TYPE = number)  ARG(NAME = ~"tipo_sol~" TYPE = string) " update="SOL_TRANSFERENCIA" updatewhere=0 updatekeyinplace=yes arguments=(("base", string),("serie", string),("numero", number),("correlativo", number),("tipo_sol", string)) )
