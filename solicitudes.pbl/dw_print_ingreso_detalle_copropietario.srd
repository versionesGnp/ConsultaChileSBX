 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"sol_coprop~" )  TABLE(NAME=~"sol_cliente~" )  TABLE(NAME=~"sol_transferencia~" ) COLUMN(NAME=~"sol_coprop.rut~") COLUMN(NAME=~"sol_coprop.dv~") COLUMN(NAME=~"sol_coprop.nombres~") COLUMN(NAME=~"sol_coprop.ap_paterno~") COLUMN(NAME=~"sol_coprop.ap_materno~") COLUMN(NAME=~"sol_coprop.base~") COLUMN(NAME=~"sol_coprop.serie~") COLUMN(NAME=~"sol_coprop.numero~") COLUMN(NAME=~"sol_coprop.rut_cliente~") COLUMN(NAME=~"sol_cliente.rut~") COLUMN(NAME=~"sol_coprop.rut_cliente_tran~") COLUMN(NAME=~"sol_coprop.dv_cliente~") COLUMN(NAME=~"sol_coprop.estado_a_n~")    JOIN (LEFT=~"sol_coprop.base~"    OP =~"=~"RIGHT=~"sol_cliente.base~" )    JOIN (LEFT=~"sol_coprop.serie~"    OP =~"=~"RIGHT=~"sol_cliente.serie~" )    JOIN (LEFT=~"sol_coprop.numero~"    OP =~"=~"RIGHT=~"sol_cliente.numero~" )    JOIN (LEFT=~"sol_coprop.rut_cliente~"    OP =~"=~"RIGHT=~"sol_cliente.rut_cliente_ori~" )    JOIN (LEFT=~"sol_coprop.rut_cliente_tran~"    OP =~"=~"RIGHT=~"sol_cliente.rut~" )    JOIN (LEFT=~"sol_cliente.base~"    OP =~"=~"RIGHT=~"sol_transferencia.base~" )    JOIN (LEFT=~"sol_cliente.serie~"    OP =~"=~"RIGHT=~"sol_transferencia.serie~" )    JOIN (LEFT=~"sol_cliente.numero~"    OP =~"=~"RIGHT=~"sol_transferencia.numero~" )    JOIN (LEFT=~"sol_cliente.correlativo~"    OP =~"=~"RIGHT=~"sol_transferencia.correlativo~" )    JOIN (LEFT=~"sol_cliente.rut_cliente_ori~"    OP =~"=~"RIGHT=~"sol_transferencia.rut_titular~" )WHERE(    EXP1 =~"~~~"SOL_COPROP~~~".~~~"RUT_CLIENTE~~~"~"   OP =~"=~"    EXP2 =~":rut~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_COPROP~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_COPROP~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_COPROP~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"SOL_CLIENTE~~~".~~~"CORRELATIVO~~~"~"   OP =~"=~"    EXP2 =~":corr~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"SOL_COPROP~~~".~~~"ESTADO_A_N~~~"~"   OP =~"=~"    EXP2 =~"'N'~" ) ) ARG(NAME = ~"rut~" TYPE = number)  ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number)  ARG(NAME = ~"corr~" TYPE = number) " update="SOL_COPROP" updatewhere=0 updatekeyinplace=no arguments=(("rut", number),("base", string),("serie", string),("numero", number),("corr", number)) )
