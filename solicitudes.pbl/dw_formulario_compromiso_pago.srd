E=~"sol_compromiso_pago.fecha_rescil_original~") COLUMN(NAME=~"sol_compromiso_pago.tipo_via~") COLUMN(NAME=~"sol_compromiso_pago.numero_particular~") COLUMN(NAME=~"sol_compromiso_pago.depto_particular~") COLUMN(NAME=~"sol_compromiso_pago.block_particular~") COLUMN(NAME=~"sol_compromiso_pago.tipo_via_original~") COLUMN(NAME=~"sol_compromiso_pago.numero_particular_original~") COLUMN(NAME=~"sol_compromiso_pago.depto_particular_original~") COLUMN(NAME=~"sol_compromiso_pago.block_particular_original~") COLUMN(NAME=~"sol_compromiso_pago.area_sep~") COLUMN(NAME=~"sol_compromiso_pago.sector_sep~") COLUMN(NAME=~"sol_compromiso_pago.nro_sepultura~") COLUMN(NAME=~"sol_compromiso_pago.cod_parque~") COLUMN(NAME=~"sol_compromiso_pago.plazo_mant~") COLUMN(NAME=~"sol_compromiso_pago.fecha_prim_mant~") COLUMN(NAME=~"sol_compromiso_pago.monto_cuota_mant~") COLUMN(NAME=~"sol_compromiso_pago.monto_pie_mant~") COLUMN(NAME=~"sol_compromiso_pago.cuotas_pie_mant~") COLUMN(NAME=~"sol_compromiso_pago.uf_dia~") COLUMN(NAME=~"sol_compromiso_pago.cuotas_mora_original~") COLUMN(NAME=~"sol_compromiso_pago.sw_dscto_mora_pagar~") COLUMN(NAME=~"sol_compromiso_pago.sw_dscto_gasto_pagar~") COLUMN(NAME=~"sol_compromiso_pago.mora_pagar_mant~") COLUMN(NAME=~"sol_compromiso_pago.gasto_pagar_mant~") COLUMN(NAME=~"sol_compromiso_pago.mora_pagar_mant_ori~") COLUMN(NAME=~"sol_compromiso_pago.gasto_pagar_mant_ori~") COLUMN(NAME=~"sol_compromiso_pago.modalidad_pago_mant~") COLUMN(NAME=~"cliente.email~")    JOIN (LEFT=~"cliente.rut~"    OP =~"=~"RIGHT=~"cadena.rut~" )    JOIN (LEFT=~"membrete_empresa.cod_parque~"    OP =~"=~"RIGHT=~"sol_compromiso_pago.cod_parque~" )    JOIN (LEFT=~"sol_estatus.base~"    OP =~"=~"RIGHT=~"sol_compromiso_pago.base~" )    JOIN (LEFT=~"sol_estatus.serie~"    OP =~"=~"RIGHT=~"sol_compromiso_pago.serie~" )    JOIN (LEFT=~"sol_estatus.numero~"    OP =~"=~"RIGHT=~"sol_compromiso_pago.numero~" )    JOIN (LEFT=~"sol_estatus.correlativo~"    OP =~"=~"RIGHT=~"sol_compromiso_pago.correlativo~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"sol_compromiso_pago.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"sol_compromiso_pago.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"sol_compromiso_pago.numero~" )WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"CODIGO_SOLICITUD~~~"~"   OP =~"=~"    EXP2 =~":tipo_sol~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"CORRELATIVO~~~"~"   OP =~"=~"    EXP2 =~":corr~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"MEMBRETE_EMPRESA~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":cod_parque~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number)  ARG(NAME = ~"corr~" TYPE = number)  ARG(NAME = ~"tipo_sol~" TYPE = string)  ARG(NAME = ~"cod_parque~" TYPE = number) " update="SOL_COMPROMISO_PAGO" updatewhere=0 updatekeyinplace=yes arguments=(("base", string),("serie", string),("numero", number),("corr", number),("tipo_sol", string),("cod_parque", number)) )
