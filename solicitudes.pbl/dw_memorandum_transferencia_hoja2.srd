 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"pago_oferta~" )  TABLE(NAME=~"sol_transferencia~" )  TABLE(NAME=~"sol_cliente~" )  TABLE(NAME=~"cliente~" )  TABLE(NAME=~"oferta_v~" ) COLUMN(NAME=~"sol_transferencia.base~") COLUMN(NAME=~"sol_transferencia.serie~") COLUMN(NAME=~"sol_transferencia.numero~") COLUMN(NAME=~"cliente.rut~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"pago_oferta.sepultura~") COLUMN(NAME=~"pago_oferta.sector~") COLUMN(NAME=~"pago_oferta.area~") COLUMN(NAME=~"pago_oferta.capacidad~") COLUMN(NAME=~"cliente.sexo~") COLUMN(NAME=~"sol_cliente.rut~") COLUMN(NAME=~"sol_cliente.dv~") COLUMN(NAME=~"sol_cliente.nombres~") COLUMN(NAME=~"sol_cliente.ap_paterno~") COLUMN(NAME=~"sol_cliente.ap_materno~") COLUMN(NAME=~"sol_cliente.sexo~") COLUMN(NAME=~"pago_oferta.fecha_prim~") COLUMN(NAME=~"pago_oferta.nro_tecnico~") COLUMN(NAME=~"cliente.esta_civil~") COLUMN(NAME=~"cliente.direccion_p~") COLUMN(NAME=~"cliente.poblacion~") COLUMN(NAME=~"cliente.comuna~") COLUMN(NAME=~"cliente.fono_p~") COLUMN(NAME=~"sol_cliente.estado_civil~") COLUMN(NAME=~"sol_cliente.direccion_p~") COLUMN(NAME=~"sol_cliente.poblacion~") COLUMN(NAME=~"sol_cliente.comuna~") COLUMN(NAME=~"sol_cliente.fono_p~") COLUMN(NAME=~"cliente.numero_particular~") COLUMN(NAME=~"cliente.depto_particular~") COLUMN(NAME=~"cliente.block_particular~") COLUMN(NAME=~"cliente.tipo_via~") COLUMN(NAME=~"sol_cliente.tipo_via~") COLUMN(NAME=~"sol_cliente.numero_particular~") COLUMN(NAME=~"sol_cliente.depto_particular~") COLUMN(NAME=~"sol_cliente.block_particular~")    JOIN (LEFT=~"pago_oferta.serie~"    OP =~"=~"RIGHT=~"sol_transferencia.serie~" )    JOIN (LEFT=~"sol_cliente.rut_cliente_ori~"    OP =~"=~"RIGHT=~"sol_transferencia.rut_titular~" )    JOIN (LEFT=~"cliente.rut~"    OP =~"=~"RIGHT=~"sol_cliente.rut_cliente_ori~" )    JOIN (LEFT=~"sol_transferencia.numero~"    OP =~"=~"RIGHT=~"pago_oferta.nro_oferta~" )    JOIN (LEFT=~"pago_oferta.serie~"    OP =~"=~"RIGHT=~"oferta_v.serie~" )    JOIN (LEFT=~"pago_oferta.nro_oferta~"    OP =~"=~"RIGHT=~"oferta_v.nro_oferta~" )    JOIN (LEFT=~"pago_oferta.folio~"    OP =~"=~"RIGHT=~"oferta_v.ult_folio~" )WHERE(    EXP1 =~"~~~"SOL_TRANSFERENCIA~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_TRANSFERENCIA~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_TRANSFERENCIA~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_TRANSFERENCIA~~~".~~~"CORRELATIVO~~~"~"   OP =~"=~"    EXP2 =~":corr~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number)  ARG(NAME = ~"corr~" TYPE = number) " arguments=(("base", string),("serie", string),("numero", number),("corr", number)) )
