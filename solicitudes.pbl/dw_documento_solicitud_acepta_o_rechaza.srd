 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"sol_estatus~" )  TABLE(NAME=~"sol_rescilia_cliente~" ) COLUMN(NAME=~"sol_rescilia_cliente.direccion_p~") COLUMN(NAME=~"sol_rescilia_cliente.poblacion~") COLUMN(NAME=~"sol_rescilia_cliente.comuna~") COLUMN(NAME=~"sol_rescilia_cliente.ciudad~") COLUMN(NAME=~"sol_rescilia_cliente.base~") COLUMN(NAME=~"sol_rescilia_cliente.serie~") COLUMN(NAME=~"sol_rescilia_cliente.numero~") COLUMN(NAME=~"sol_rescilia_cliente.correlativo~") COLUMN(NAME=~"sol_rescilia_cliente.nombre~") COLUMN(NAME=~"sol_rescilia_cliente.ap_paterno~") COLUMN(NAME=~"sol_rescilia_cliente.ap_materno~") COLUMN(NAME=~"sol_estatus.estado_reg~") COMPUTE(NAME=~"''~") COLUMN(NAME=~"sol_rescilia_cliente.tipo_via~") COLUMN(NAME=~"sol_rescilia_cliente.numero_particular~") COLUMN(NAME=~"sol_rescilia_cliente.depto_particular~") COLUMN(NAME=~"sol_rescilia_cliente.block_particular~")    JOIN (LEFT=~"sol_estatus.base~"    OP =~"=~"RIGHT=~"sol_rescilia_cliente.base~" )    JOIN (LEFT=~"sol_estatus.serie~"    OP =~"=~"RIGHT=~"sol_rescilia_cliente.serie~" )    JOIN (LEFT=~"sol_estatus.numero~"    OP =~"=~"RIGHT=~"sol_rescilia_cliente.numero~" )    JOIN (LEFT=~"sol_estatus.correlativo~"    OP =~"=~"RIGHT=~"sol_rescilia_cliente.correlativo~" )WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"CORRELATIVO~~~"~"   OP =~"=~"    EXP2 =~":corr~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number)  ARG(NAME = ~"corr~" TYPE = number) " arguments=(("base", string),("serie", string),("numero", number),("corr", number)) )
compute(band=detail alignment="3" expression="if ( conexion ='P' or conexion='M' or conexion='S',   'Informamos a usted, que la solicitud de Resciliación de su contrato fue aceptada, por lo tanto, debe acercarse exclusivamente a nuestras oficinas de Estado 360 quinto piso, de Lunes a Viernes de 9:00 a 17:30 horas, a firmar la documentación correspondiente.      Cualquier duda llame a los teléfonos 3805730 - 3805733 - 3805734.'     ,   'Informamos a usted, que la solicitud de Resciliación de su contrato fue aceptada, por lo tanto, debe acercarse exclusivamente a nuestras oficinas de Ruta 41 Sector Aeropuerto Camino Vicuña, de Lunes a Viernes de 9:00 a 17:30 horas, a firmar la documentación correspondiente.      Cualquier duda llame al teléfono 27 18 01.')"border="0" color="0" x="59" y="400" height="624" width="2944" format="[GENERAL]" html.valueishtml="0"  name=txt_aceptada visible="1~tif (sol_estatus_estado_reg='A',1,0)"  font.face="MS Sans Serif" font.height="-14" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" background.transparency="0" background.gradient.color="8421504" background.gradient.transparency="0" background.gradient.angle="0" background.brushmode="0" background.gradient.repetition.mode="0" background.gradient.repetition.count="0" background.gradient.repetition.length="100" background.gradient.focus="0" background.gradient.scale="100" background.gradient.spread="100" tooltip.backcolor="134217752" tooltip.delay.initial="0" tooltip.delay.visible="32000" tooltip.enabled="0" tooltip.hasclosebutton="0" tooltip.icon="0" tooltip.isbubble="0" tooltip.maxwidth="0" tooltip.textcolor="134217751" tooltip.transparency="0" transparency="0" )
compute(band=detail alignment="3" expression="if (  conexion ='P' or conexion = 'M' or conexion = 'S',  'Informamos a usted, que la solicitud de Resciliación de su contrato fue rechazada, por lo que, ofrecemos reprogramar su deuda y para ello debe acercarse a las oficinas de Estado 360 quinto piso, de Lunes a Viernes de 9:00 a 17:30 horas, dentro de los 15 días hábiles siguientes, a contar de la fecha que indica en esta carta.   Cualquier duda llame a los teléfonos 3805730 - 3805733 - 3805734.' , if ( conexion='C','Informamos a usted, que la solicitud de Resciliación de su contrato fue rechazada, por lo que, ofrecemos reprogramar su deuda y para ello debe acercarse a las oficinas de Av. Costanera N° 2220, todos los días de 9:00 a 17:00 horas, dentro de los 15 días hábiles siguientes, a contar de la fecha que indica en esta carta.   Cualquier duda llame a los teléfonos 285 1528 - 285 1535.' ,  'Informamos a usted, que la solicitud de Resciliación de su contrato fue rechazada, por lo que, ofrecemos reprogramar su deuda y para ello debe acercarse a las oficinas de Ruta 41 Sector Aeropuerto Camino Vicuña, de Lunes a Viernes de 9:00 a 17:30 horas, dentro de los 15 días hábiles siguientes, a contar de la fecha que indica en esta carta.   Cualquier duda llame al teléfono 27 18 01.'))"border="0" color="0" x="55" y="396" height="624" width="2944" format="[GENERAL]" html.valueishtml="0"  name=txt_rechazo visible="1~tif (sol_estatus_estado_reg='I',1,0)"  font.face="MS Sans Serif" font.height="-14" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" background.transparency="0" background.gradient.color="8421504" background.gradient.transparency="0" background.gradient.angle="0" background.brushmode="0" background.gradient.repetition.mode="0" background.gradient.repetition.count="0" background.gradient.repetition.length="100" background.gradient.focus="0" background.gradient.scale="100" background.gradient.spread="1