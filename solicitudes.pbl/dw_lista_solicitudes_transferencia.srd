 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cadena~" )  TABLE(NAME=~"cliente~" )  TABLE(NAME=~"sol_estatus~" )  TABLE(NAME=~"sol_transferencia~" ) COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cliente.rut~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"sol_estatus.base~") COLUMN(NAME=~"sol_estatus.serie~") COLUMN(NAME=~"sol_estatus.numero~") COLUMN(NAME=~"sol_estatus.correlativo~") COLUMN(NAME=~"sol_estatus.codigo_solicitud~") COLUMN(NAME=~"sol_estatus.observacion~") COLUMN(NAME=~"sol_estatus.estado_reg~") COLUMN(NAME=~"sol_transferencia.base~") COLUMN(NAME=~"sol_transferencia.serie~") COLUMN(NAME=~"sol_transferencia.numero~") COLUMN(NAME=~"sol_transferencia.correlativo~") COLUMN(NAME=~"sol_transferencia.rut_titular~") COLUMN(NAME=~"sol_transferencia.fecha_nac~") COLUMN(NAME=~"sol_transferencia.total_renta~") COLUMN(NAME=~"sol_transferencia.grupo_f~") COLUMN(NAME=~"sol_transferencia.fecha_actual~") COLUMN(NAME=~"sol_transferencia.fecha_rescil~") COLUMN(NAME=~"sol_transferencia.mora_mant~") COLUMN(NAME=~"sol_transferencia.mora_credito~") COLUMN(NAME=~"sol_transferencia.area_sepultura~") COLUMN(NAME=~"sol_transferencia.sector_sepultura~") COLUMN(NAME=~"sol_transferencia.sepultura~") COLUMN(NAME=~"sol_transferencia.sepultado~") COLUMN(NAME=~"sol_transferencia.capacidad~") COLUMN(NAME=~"sol_transferencia.ctto_definitivo~") COLUMN(NAME=~"sol_transferencia.titulo_dominio~") COLUMN(NAME=~"sol_transferencia.estatus_operaciones~") COLUMN(NAME=~"sol_transferencia.estatus_informatica~") COLUMN(NAME=~"sol_transferencia.nombre~") COLUMN(NAME=~"sol_transferencia.ap_paterno~") COLUMN(NAME=~"sol_transferencia.ap_materno~") COLUMN(NAME=~"sol_transferencia.mod_ant_cliente~") COLUMN(NAME=~"sol_transferencia.usuario_opera~") COLUMN(NAME=~"sol_transferencia.fecha_opera~") COLUMN(NAME=~"sol_transferencia.usuario_infor~") COLUMN(NAME=~"sol_transferencia.fecha_infor~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"cadena.fecha_res~")    JOIN (LEFT=~"cadena.rut~"    OP =~"=~"RIGHT=~"cliente.rut~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"sol_estatus.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"sol_estatus.numero~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"sol_estatus.base~" )    JOIN (LEFT=~"sol_estatus.base~"    OP =~"=~"RIGHT=~"sol_transferencia.base~" )    JOIN (LEFT=~"sol_estatus.serie~"    OP =~"=~"RIGHT=~"sol_transferencia.serie~" )    JOIN (LEFT=~"sol_estatus.numero~"    OP =~"=~"RIGHT=~"sol_transferencia.numero~" )    JOIN (LEFT=~"sol_estatus.correlativo~"    OP =~"=~"RIGHT=~"sol_transferencia.correlativo~" )WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"CODIGO_SOLICITUD~~~"~"   OP =~"=~"    EXP2 =~":tipo_sol~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number)  ARG(NAME = ~"tipo_sol~" TYPE = string) " update="SOL_TRANSFERENCIA" updatewhere=0 updatekeyinplace=yes arguments=(("base", string),("serie", string),("numero", number),("tipo_sol", string))  sort="sol_estatus_base A sol_estatus_serie A sol_estatus_numero A sol_estatus_correlativo A " )
