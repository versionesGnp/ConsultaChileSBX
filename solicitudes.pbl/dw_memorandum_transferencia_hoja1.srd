table(column=(type=char(1) updatewhereclause=yes name=sol_transferencia_base dbname="sol_transferencia.base" )
 column=(type=char(1) updatewhereclause=yes name=sol_transferencia_serie dbname="sol_transferencia.serie" )
 column=(type=decimal(4) updatewhereclause=yes name=sol_transferencia_numero dbname="sol_transferencia.numero" )
 column=(type=decimal(4) updatewhereclause=yes name=cliente_rut dbname="cliente.rut" )
 column=(type=char(1) updatewhereclause=yes name=cliente_dv dbname="cliente.dv" )
 column=(type=char(20) updatewhereclause=yes name=cliente_nombre dbname="cliente.nombre" )
 column=(type=char(15) updatewhereclause=yes name=cliente_a_paterno dbname="cliente.a_paterno" )
 column=(type=char(15) updatewhereclause=yes name=cliente_a_materno dbname="cliente.a_materno" )
 column=(type=char(8) updatewhereclause=yes name=pago_oferta_sepultura dbname="pago_oferta.sepultura" )
 column=(type=char(8) updatewhereclause=yes name=pago_oferta_sector dbname="pago_oferta.sector" )
 column=(type=char(2) updatewhereclause=yes name=pago_oferta_area dbname="pago_oferta.area" )
 column=(type=decimal(4) updatewhereclause=yes name=pago_oferta_capacidad dbname="pago_oferta.capacidad" )
 column=(type=char(1) updatewhereclause=yes name=cliente_sexo dbname="cliente.sexo" )
 column=(type=decimal(4) updatewhereclause=yes name=sol_cliente_rut dbname="sol_cliente.rut" )
 column=(type=char(1) updatewhereclause=yes name=sol_cliente_dv dbname="sol_cliente.dv" )
 column=(type=char(20) updatewhereclause=yes name=sol_cliente_nombres dbname="sol_cliente.nombres" )
 column=(type=char(15) updatewhereclause=yes name=sol_cliente_ap_paterno dbname="sol_cliente.ap_paterno" )
 column=(type=char(15) updatewhereclause=yes name=sol_cliente_ap_materno dbname="sol_cliente.ap_materno" )
 column=(type=char(1) updatewhereclause=yes name=sol_cliente_sexo dbname="sol_cliente.sexo" )
 column=(type=datetime updatewhereclause=yes name=pago_oferta_fecha_prim dbname="pago_oferta.fecha_prim" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"pago_oferta~" )  TABLE(NAME=~"sol_transferencia~" )  TABLE(NAME=~"sol_cliente~" )  TABLE(NAME=~"cliente~" )  TABLE(NAME=~"oferta_v~" ) COLUMN(NAME=~"sol_transferencia.base~") COLUMN(NAME=~"sol_transferencia.serie~") COLUMN(NAME=~"sol_transferencia.numero~") COLUMN(NAME=~"cliente.rut~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"pago_oferta.sepultura~") COLUMN(NAME=~"pago_oferta.sector~") COLUMN(NAME=~"pago_oferta.area~") COLUMN(NAME=~"pago_oferta.capacidad~") COLUMN(NAME=~"cliente.sexo~") COLUMN(NAME=~"sol_cliente.rut~") COLUMN(NAME=~"sol_cliente.dv~") COLUMN(NAME=~"sol_cliente.nombres~") COLUMN(NAME=~"sol_cliente.ap_paterno~") COLUMN(NAME=~"sol_cliente.ap_materno~") COLUMN(NAME=~"sol_cliente.sexo~") COLUMN(NAME=~"pago_oferta.fecha_prim~")    JOIN (LEFT=~"pago_oferta.serie~"    OP =~"=~"RIGHT=~"sol_transferencia.serie~" )    JOIN (LEFT=~"sol_cliente.rut_cliente_ori~"    OP =~"=~"RIGHT=~"sol_transferencia.rut_titular~" )    JOIN (LEFT=~"cliente.rut~"    OP =~"=~"RIGHT=~"sol_cliente.rut_cliente_ori~" )    JOIN (LEFT=~"sol_transferencia.numero~"    OP =~"=~"RIGHT=~"pago_oferta.nro_oferta~" )    JOIN (LEFT=~"pago_oferta.serie~"    OP =~"=~"RIGHT=~"oferta_v.serie~" )    JOIN (LEFT=~"pago_oferta.nro_oferta~"    OP =~"=~"RIGHT=~"oferta_v.nro_oferta~" )    JOIN (LEFT=~"pago_oferta.folio~"    OP =~"=~"RIGHT=~"oferta_v.ult_folio~" )WHERE(    EXP1 =~"~~~"SOL_TRANSFERENCIA~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_TRANSFERENCIA~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_TRANSFERENCIA~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_TRANSFERENCIA~~~".~~~"CORRELATIVO~~~"~"   OP =~"=~"    EXP2 =~":corr~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number)  ARG(NAME = ~"corr~" TYPE = number) " arguments=(("base", string),("serie", string),("numero", number),("corr", number)) )
text(band=header alignment="2" text="ADMINISTRADORA DEL PRADO Y LA FORESTA SpACEMENTERIO PARQUE EL PRADOAVENIDA CAMINO HENRIQUEZ Nº 4673" border="0" color="0" x="850" y="84" height="192" width="1769" html.valueishtml="0"  name=t_1 visible="1"  font.face="Arial" font.height="-10" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" background.transparency="0" background.gradient.color="8421504" background.gradient.transparency="0" background.gradient.angle="0" background.brushmode="0" background.gradient.repetition.mode="0" background.gradient.repetition.count="0" background.gradient.repetition.length="100" background.gradient.focus="0" background.gradient.scale="100" background.gradient.spread="100" tooltip.backcolor="134217752" tooltip.delay.initial="0" tooltip.delay.visible="32000" tooltip.enabled="0" tooltip.hasclosebutton="0" tooltip.icon="0" tooltip.isbubble="0" tooltip.maxwidth="0" tooltip.textcolor="134217751" tooltip.transparency="0" transparency="0" )
compute(band=detail alignment="3" expression="space(10)+'Adjunto remito a Ud. antecedentes legales por medio de los cuales '+if ( cliente_sexo ='F','la Srta. ','el Sr. ')+', '+ cliente_nombre +' '+ cliente_a_paterno +' '+ cliente_a_materno +', Rut: '+string( cliente_rut ,~"###,###,###,##0~")+' - '+ cliente_dv +', Transfiere '+ IF ( sol_cliente_sexo ='F','a la Srta. ','al Sr. ')+ sol_cliente_nombres +' '+ sol_cliente_ap_paterno +' '+ sol_cliente_ap_materno +', Rut: ' + string( sol_cliente_rut ,~"###,###,###,##0~")+  sol_cliente_dv  +', Sepultura Nº '+ pago_oferta_sepultura +' Sector '+ pago_oferta_sector +', Zona '+ pago_oferta_area +' de '+ pago_oferta_capacidad +' Capacidad, adquirida según Contrato de Compraventa '+ sol_transferencia_serie +' - '+ sol_transferencia_numero +' de fecha '+Day( pago_oferta_fecha_prim )+' de '+ case( Month( pago_oferta_fecha_prim ) when 1 then 'Enero' when 2 then 'Febrero' when 3 then 'Marzo' when 4 then 'Abril' when 5 then 'Mayo' when 6 then 'Junio' when 7 then 'Julio' when 8 then 'Agosto' when 9 then 'Septiembre' when 10 then 'Octubre' when 11 then 'Noviembre' when 12 then 'Diciembre') +' de '+Year( pago_oferta_fecha_prim )+'~~r'+'~~r'+'Lo Anterior para los efectos de disponer, si lo tiene a bien, las modificaciones en la base de datos y poder entregar el nuevo Título de Dominio.'"border="0" color="0" x="174" y="1060" height="1484" width="3127" format="[GENERAL]" html.valueishtml="0"  name=compute_1 visible="1"  font.face="Arial" font.height="-14" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" background.transparency="0" background.gradient.color="8421504" background.gradient.transparency="0" background.gradient.angle="0" background.brushmode="0" background.gradient.repetition.mode="0" background.gradient.repetition.count="0" background.gradient.repetition.length="100" background.gradient.focus="0" background.gradient.scale="100" background.gradient.spread="100" too