 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"sol_cliente~" )  TABLE(NAME=~"cliente~" )  TABLE(NAME=~"sol_estatus~" )  TABLE(NAME=~"sol_pos_efec~" ) COLUMN(NAME=~"sol_cliente.rut~") COLUMN(NAME=~"sol_cliente.dv~") COLUMN(NAME=~"sol_cliente.nombres~") COLUMN(NAME=~"sol_cliente.ap_paterno~") COLUMN(NAME=~"sol_cliente.ap_materno~") COLUMN(NAME=~"sol_cliente.direccion_p~") COLUMN(NAME=~"sol_cliente.poblacion~") COLUMN(NAME=~"sol_cliente.sector~") COLUMN(NAME=~"sol_cliente.comuna~") COLUMN(NAME=~"sol_cliente.ciudad~") COLUMN(NAME=~"sol_cliente.fono_p~") COLUMN(NAME=~"sol_cliente.sexo~") COLUMN(NAME=~"sol_cliente.fecha_nac~") COLUMN(NAME=~"sol_cliente.estado_civil~") COLUMN(NAME=~"sol_cliente.domicilio_c~") COLUMN(NAME=~"sol_cliente.fono_c~") COLUMN(NAME=~"sol_cliente.fecha_ing~") COLUMN(NAME=~"sol_cliente.total_renta~") COLUMN(NAME=~"sol_cliente.grupo_f~") COLUMN(NAME=~"cliente.rut~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cliente.direccion_p~") COLUMN(NAME=~"cliente.poblacion~") COLUMN(NAME=~"cliente.sector~") COLUMN(NAME=~"cliente.comuna~") COLUMN(NAME=~"cliente.ciudad~") COLUMN(NAME=~"cliente.fono_p~") COLUMN(NAME=~"cliente.fecha_nac~") COLUMN(NAME=~"cliente.esta_civil~") COLUMN(NAME=~"cliente.domicilio_c~") COLUMN(NAME=~"cliente.fono_c~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"sol_estatus.estado_reg~") COLUMN(NAME=~"sol_cliente.tipo_via~") COLUMN(NAME=~"sol_cliente.numero_particular~") COLUMN(NAME=~"sol_cliente.depto_particular~") COLUMN(NAME=~"sol_cliente.block_particular~") COLUMN(NAME=~"cliente.tipo_via~") COLUMN(NAME=~"cliente.numero_particular~") COLUMN(NAME=~"cliente.depto_particular~") COLUMN(NAME=~"cliente.block_particular~") COLUMN(NAME=~"sol_estatus.codigo_solicitud~") COLUMN(NAME=~"sol_pos_efec.base~") COLUMN(NAME=~"sol_pos_efec.serie~") COLUMN(NAME=~"sol_pos_efec.numero~") COLUMN(NAME=~"sol_pos_efec.correlativo~")    JOIN (LEFT=~"sol_cliente.rut_cliente_ori~"    OP =~"=~"RIGHT=~"cliente.rut~" )    JOIN (LEFT=~"sol_pos_efec.base~"    OP =~"=~"RIGHT=~"sol_estatus.base~" )    JOIN (LEFT=~"sol_pos_efec.serie~"    OP =~"=~"RIGHT=~"sol_estatus.serie~" )    JOIN (LEFT=~"sol_pos_efec.numero~"    OP =~"=~"RIGHT=~"sol_estatus.numero~" )    JOIN (LEFT=~"sol_pos_efec.correlativo~"    OP =~"=~"RIGHT=~"sol_estatus.correlativo~" )    JOIN (LEFT=~"sol_pos_efec.base~"    OP =~"=~"RIGHT=~"sol_cliente.base~" )    JOIN (LEFT=~"sol_pos_efec.serie~"    OP =~"=~"RIGHT=~"sol_cliente.serie~" )    JOIN (LEFT=~"sol_pos_efec.numero~"    OP =~"=~"RIGHT=~"sol_cliente.numero~" )    JOIN (LEFT=~"sol_pos_efec.correlativo~"    OP =~"=~"RIGHT=~"sol_cliente.correlativo~" )    JOIN (LEFT=~"sol_pos_efec.rut_titular~"    OP =~"=~"RIGHT=~"sol_cliente.rut_cliente_ori~" )WHERE(    EXP1 =~"~~~"SOL_POS_EFEC~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_POS_EFEC~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_POS_EFEC~~~".~~~"CORRELATIVO~~~"~"   OP =~"=~"    EXP2 =~":correlativo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_POS_EFEC~~~".~~~"RUT_TITULAR~~~"~"   OP =~"=~"    EXP2 =~":rut~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number)  ARG(NAME = ~"rut~" TYPE = number)  ARG(NAME = ~"correlativo~" TYPE = number) " arguments=(("base", string),("serie", string),("numero", number),("rut", number),("correlativo", number)) )
