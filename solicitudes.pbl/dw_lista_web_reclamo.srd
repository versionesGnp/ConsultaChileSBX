 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"web_reclamos~" ) COLUMN(NAME=~"web_reclamos.id_reclamo~") COLUMN(NAME=~"web_reclamos.sector~") COLUMN(NAME=~"web_reclamos.sepultura~") COLUMN(NAME=~"web_reclamos.nombre_reclamante~") COLUMN(NAME=~"web_reclamos.email~") COLUMN(NAME=~"web_reclamos.telefono~") COLUMN(NAME=~"web_reclamos.tipo_reclamo~") COLUMN(NAME=~"web_reclamos.sub_reclamo~") COLUMN(NAME=~"web_reclamos.usuario_ingreso~") COLUMN(NAME=~"web_reclamos.fecha_ingreso~") COLUMN(NAME=~"web_reclamos.usuario_gestion~") COLUMN(NAME=~"web_reclamos.fecha_gestion~") COLUMN(NAME=~"web_reclamos.capataz~") COLUMN(NAME=~"web_reclamos.fecha_entrega_cap~") COLUMN(NAME=~"web_reclamos.solucion~") COLUMN(NAME=~"web_reclamos.hora~") COLUMN(NAME=~"web_reclamos.ip~") COLUMN(NAME=~"web_reclamos.correlativo~") COLUMN(NAME=~"web_reclamos.estado_reclamo~") COLUMN(NAME=~"web_reclamos.reclamo~") COLUMN(NAME=~"web_reclamos.cod_parque~") COLUMN(NAME=~"web_reclamos.fecha_d_ingreso~") COLUMN(NAME=~"web_reclamos.fecha_d_gestion~") COLUMN(NAME=~"web_reclamos.fecha_d_entrega_cap~")WHERE(    EXP1 =~"~~~"WEB_RECLAMOS~~~".~~~"SECTOR~~~"~"   OP =~"=~"    EXP2 =~":sector~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"WEB_RECLAMOS~~~".~~~"SEPULTURA~~~"~"   OP =~"=~"    EXP2 =~":sepultura~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"WEB_RECLAMOS~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~" ) ) ARG(NAME = ~"sector~" TYPE = string)  ARG(NAME = ~"sepultura~" TYPE = string)  ARG(NAME = ~"parque~" TYPE = number) " update="WEB_RECLAMOS" updatewhere=1 updatekeyinplace=no arguments=(("sector", string),("sepultura", string),("parque", number))  sort="fecha_d_ingreso D " )
