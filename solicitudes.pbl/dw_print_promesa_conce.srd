cular~") COLUMN(NAME=~"cliente.depto_particular~") COLUMN(NAME=~"cliente.block_particular~") COLUMN(NAME=~"cliente.tipo_via~") COLUMN(NAME=~"tipo_via.descripcion~") COLUMN(NAME=~"ciudad.sigla_ciudad~") COLUMN(NAME=~"comuna.sigla_comuna~") COLUMN(NAME=~"oferta_v.rut~")    JOIN (LEFT=~"repacta_mantencion.rut_cliente~"    OP =~"=~"RIGHT=~"cliente.rut~" )    JOIN (LEFT=~"oferta_v.serie~"    OP =~"=~"RIGHT=~"repacta_mantencion.serie_original~" )    JOIN (LEFT=~"oferta_v.nro_oferta~"    OP =~"=~"RIGHT=~"repacta_mantencion.numero_original~" )    JOIN (LEFT=~"oferta_v.serie~"    OP =~"=~"RIGHT=~"pago_oferta.serie~" )    JOIN (LEFT=~"oferta_v.nro_oferta~"    OP =~"=~"RIGHT=~"pago_oferta.nro_oferta~" )    JOIN (LEFT=~"oferta_v.ult_folio~"    OP =~"=~"RIGHT=~"pago_oferta.folio~" )    JOIN (LEFT=~"repacta_mantencion.usuario~"    OP =~"=~"RIGHT=~"encargados.codigo_usuario~" )    JOIN (LEFT=~"cliente.tipo_via~"    OP =~"=~"RIGHT=~"tipo_via.tipo_via~" )    JOIN (LEFT=~"cliente.comuna~"    OP =~"=~"RIGHT=~"comuna.codigo_comuna~" )    JOIN (LEFT=~"cliente.ciudad~"    OP =~"=~"RIGHT=~"ciudad.codigo_ciudad~" )WHERE(    EXP1 =~"~~~"REPACTA_MANTENCION~~~".~~~"BASE_ORIGINAL~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"REPACTA_MANTENCION~~~".~~~"SERIE_ORIGINAL~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"REPACTA_MANTENCION~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number) " arguments=(("base", string),("serie", string),("numero", number)) )
