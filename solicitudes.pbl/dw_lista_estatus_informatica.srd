 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"sol_estatus~" )  TABLE(NAME=~"sol_reactiva~" ) COLUMN(NAME=~"sol_estatus.base~") COLUMN(NAME=~"sol_estatus.serie~") COLUMN(NAME=~"sol_estatus.numero~") COLUMN(NAME=~"sol_estatus.correlativo~") COLUMN(NAME=~"sol_estatus.codigo_solicitud~") COLUMN(NAME=~"sol_estatus.observacion~") COLUMN(NAME=~"sol_estatus.estado_reg~") COLUMN(NAME=~"sol_reactiva.base~") COLUMN(NAME=~"sol_reactiva.serie~") COLUMN(NAME=~"sol_reactiva.numero~") COLUMN(NAME=~"sol_reactiva.correlativo~") COLUMN(NAME=~"sol_reactiva.estatus_informatica~") COLUMN(NAME=~"sol_reactiva.estatus_operacion~") COLUMN(NAME=~"sol_reactiva.rut_titular~") COLUMN(NAME=~"sol_reactiva.usuario~") COLUMN(NAME=~"sol_reactiva.cod_super~") COLUMN(NAME=~"sol_reactiva.cod_agente~")    JOIN (LEFT=~"sol_estatus.base~"    OP =~"=~"RIGHT=~"sol_reactiva.base~" )    JOIN (LEFT=~"sol_estatus.serie~"    OP =~"=~"RIGHT=~"sol_reactiva.serie~" )    JOIN (LEFT=~"sol_estatus.numero~"    OP =~"=~"RIGHT=~"sol_reactiva.numero~" )    JOIN (LEFT=~"sol_estatus.correlativo~"    OP =~"=~"RIGHT=~"sol_reactiva.correlativo~" )WHERE(    EXP1 =~"~~~"SOL_REACTIVA~~~".~~~"ESTATUS_OPERACION~~~"~"   OP =~"=~"    EXP2 =~"0~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"SOL_REACTIVA~~~".~~~"ESTATUS_INFORMATICA~~~"~"   OP =~"=~"    EXP2 =~"1~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"ESTADO_REG~~~"~"   OP =~"=~"    EXP2 =~"'A'~" ) ) " update="SOL_REACTIVA" updatewhere=0 updatekeyinplace=no  sort="numero A " )
