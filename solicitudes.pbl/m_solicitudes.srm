global type m_solicitudes from menu
m_mantenedor m_mantenedor
m_imprimir m_imprimir
m_herramienta m_herramienta
m_salir m_salir
end type
global m_solicitudes m_solicitudes

on m_solicitudes.create
m_solicitudes=this
call super::create
this.text = "m_solicitudes"
this.menutextcolor = 134217735
this.menubackcolor = 134217732
this.menuhighlightcolor = 134217741
this.textsize = 8
this.weight = 400
this.facename = "Tahoma"
this.titlebackcolor = 134217730
this.bitmapbackcolor = 12632256
this.menubitmaps = true
this.titlegradient = true
this.toolbartextcolor = 134217746
this.toolbarbackcolor = 67108864
this.toolbarhighlightcolor = 134217741
this.toolbargradient = true
this.bitmapgradient = true
this.m_mantenedor=create m_mantenedor
this.m_imprimir=create m_imprimir
this.m_herramienta=create m_herramienta
this.m_salir=create m_salir
this.Item[UpperBound(this.Item)+1]=this.m_mantenedor
this.Item[UpperBound(this.Item)+1]=this.m_imprimir
this.Item[UpperBound(this.Item)+1]=this.m_herramienta
this.Item[UpperBound(this.Item)+1]=this.m_salir
end on

on m_solicitudes.destroy
call super::destroy
destroy(this.m_mantenedor)
destroy(this.m_imprimir)
destroy(this.m_herramienta)
destroy(this.m_salir)
end on

