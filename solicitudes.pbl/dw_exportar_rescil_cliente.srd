 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"tipo_motivo_rescil_cliente~" )  TABLE(NAME=~"sol_rescilia_cliente~" )  TABLE(NAME=~"solicitudes~" )  TABLE(NAME=~"sol_estatus~" )  TABLE(NAME=~"cadena~" ) COLUMN(NAME=~"sol_estatus.base~") COLUMN(NAME=~"sol_estatus.serie~") COLUMN(NAME=~"sol_estatus.numero~") COLUMN(NAME=~"sol_estatus.correlativo~") COLUMN(NAME=~"cadena.cod_parque~") COLUMN(NAME=~"sol_estatus.codigo_solicitud~") COLUMN(NAME=~"solicitudes.descripcion~") COLUMN(NAME=~"sol_estatus.observacion~") COLUMN(NAME=~"tipo_motivo_rescil_cliente.cod_motivo_rescil~") COLUMN(NAME=~"tipo_motivo_rescil_cliente.glosa_motivo_rescil~") COLUMN(NAME=~"sol_estatus.estado_reg~") COLUMN(NAME=~"sol_estatus.rut_cliente~") COLUMN(NAME=~"sol_estatus.fecha_crea~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"sol_rescilia_cliente.rut_titular~") COLUMN(NAME=~"sol_rescilia_cliente.estatus_operacion~") COLUMN(NAME=~"sol_rescilia_cliente.estatus_informatica~") COLUMN(NAME=~"sol_rescilia_cliente.mod_ant_cliente~") COLUMN(NAME=~"sol_rescilia_cliente.usuario_opera~") COLUMN(NAME=~"sol_rescilia_cliente.fecha_opera~") COLUMN(NAME=~"sol_rescilia_cliente.usuario_infor~") COLUMN(NAME=~"sol_rescilia_cliente.fecha_infor~") COLUMN(NAME=~"sol_rescilia_cliente.fecha_actual~")    JOIN (LEFT=~"sol_rescilia_cliente.cod_motivo_rescil~"    OP =~"=~"RIGHT=~"tipo_motivo_rescil_cliente.cod_motivo_rescil~" )    JOIN (LEFT=~"sol_estatus.codigo_solicitud~"    OP =~"=~"RIGHT=~"solicitudes.codigo_solicitud~" )    JOIN (LEFT=~"sol_estatus.rut_cliente~"    OP =~"=~"RIGHT=~"sol_rescilia_cliente.rut_titular~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"sol_estatus.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"sol_estatus.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"sol_estatus.numero~" )WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"CODIGO_SOLICITUD~~~"~"   OP =~"=~"    EXP2 =~":tipo_sol~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"FECHA_CREA~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"FECHA_CREA~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~" ) ) ARG(NAME = ~"tipo_sol~" TYPE = string)  ARG(NAME = ~"fecha_ini~" TYPE = datetime)  ARG(NAME = ~"fecha_fin~" TYPE = datetime) " arguments=(("tipo_sol", string),("fecha_ini", datetime),("fecha_fin", datetime)) )
