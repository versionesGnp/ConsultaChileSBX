table(column=(type=char(1) update=yes updatewhereclause=yes name=base dbname="sol_compromiso_pago_det.base" dbalias=".base" )
 column=(type=char(1) update=yes updatewhereclause=yes name=serie dbname="sol_compromiso_pago_det.serie" dbalias=".serie" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=numero dbname="sol_compromiso_pago_det.numero" dbalias=".numero" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=correlativo dbname="sol_compromiso_pago_det.correlativo" dbalias=".correlativo" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=nro_cuota dbname="sol_compromiso_pago_det.nro_cuota" dbalias=".nro_cuota" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=plazo dbname="sol_compromiso_pago_det.plazo" dbalias=".plazo" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=monto_cuota dbname="sol_compromiso_pago_det.monto_cuota" dbalias=".monto_cuota" )
 column=(type=datetime update=yes updatewhereclause=yes name=fecha_venc dbname="sol_compromiso_pago_det.fecha_venc" dbalias=".fecha_venc" )
 column=(type=char(1) update=yes updatewhereclause=yes name=estado_pago dbname="sol_compromiso_pago_det.estado_pago" dbalias=".estado_pago" values="P - Pendiente	P/G - Gestionado	G/A - Anulado	A/" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=cuota_pag_m dbname="sol_compromiso_pago_det.cuota_pag_m" dbalias=".cuota_pag_m" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=valor_uf dbname="sol_compromiso_pago_det.valor_uf" dbalias=".valor_uf" )
 column=(type=char(1) updatewhereclause=yes name=sol_estatus_estado_reg dbname="sol_estatus.estado_reg" dbalias=".estado_reg" values="A - Activo	A/I - Inactivo	I/" )
 column=(type=number updatewhereclause=yes name=ctas_pag_m dbname="ctas_pag_m" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"sol_compromiso_pago_det~" )  TABLE(NAME=~"sol_estatus~" ) COLUMN(NAME=~"sol_compromiso_pago_det.base~") COLUMN(NAME=~"sol_compromiso_pago_det.serie~") COLUMN(NAME=~"sol_compromiso_pago_det.numero~") COLUMN(NAME=~"sol_compromiso_pago_det.correlativo~") COLUMN(NAME=~"sol_compromiso_pago_det.nro_cuota~") COLUMN(NAME=~"sol_compromiso_pago_det.plazo~") COLUMN(NAME=~"sol_compromiso_pago_det.monto_cuota~") COLUMN(NAME=~"sol_compromiso_pago_det.fecha_venc~") COLUMN(NAME=~"sol_compromiso_pago_det.estado_pago~") COLUMN(NAME=~"sol_compromiso_pago_det.cuota_pag_m~") COLUMN(NAME=~"sol_compromiso_pago_det.valor_uf~") COLUMN(NAME=~"sol_estatus.estado_reg~") COMPUTE(NAME=~"f_retorna_ctas_pag_m(:base,:serie,:numero) as ctas_pag_m~")    JOIN (LEFT=~"sol_compromiso_pago_det.base~"    OP =~"=~"RIGHT=~"sol_estatus.base~" )    JOIN (LEFT=~"sol_compromiso_pago_det.serie~"    OP =~"=~"RIGHT=~"sol_estatus.serie~" )    JOIN (LEFT=~"sol_compromiso_pago_det.numero~"    OP =~"=~"RIGHT=~"sol_estatus.numero~" )    JOIN (LEFT=~"sol_compromiso_pago_det.correlativo~"    OP =~"=~"RIGHT=~"sol_estatus.correlativo~" )WHERE(    EXP1 =~"~~~"SOL_COMPROMISO_PAGO_DET~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_COMPROMISO_PAGO_DET~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_COMPROMISO_PAGO_DET~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"CODIGO_SOLICITUD~~~"~"   OP =~"=~"    EXP2 =~"'27'~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number) " arguments=(("base", string),("serie", string),("numero", number))  sort="nro_cuota A " )
