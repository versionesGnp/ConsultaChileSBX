pag.grupo_f_original~") COLUMN(NAME=~"sol_entrega_pag.estado_cob_original~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"sol_entrega_pag.estado_ctto_original~") COLUMN(NAME=~"sol_entrega_pag.fecha_rescil_original~") COLUMN(NAME=~"sol_estatus.observacion~") COLUMN(NAME=~"sol_entrega_pag.sector_sepultura~") COLUMN(NAME=~"sol_entrega_pag.tipo_via~") COLUMN(NAME=~"sol_entrega_pag.numero_particular~") COLUMN(NAME=~"sol_entrega_pag.depto_particular~") COLUMN(NAME=~"sol_entrega_pag.block_particular~") COLUMN(NAME=~"sol_entrega_pag.tipo_via_original~") COLUMN(NAME=~"sol_entrega_pag.numero_particular_original~") COLUMN(NAME=~"sol_entrega_pag.depto_particular_original~") COLUMN(NAME=~"sol_entrega_pag.block_particular_original~")    JOIN (LEFT=~"cliente.rut~"    OP =~"=~"RIGHT=~"cadena.rut~" )    JOIN (LEFT=~"sol_estatus.base~"    OP =~"=~"RIGHT=~"sol_entrega_pag.base~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"sol_entrega_pag.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"sol_entrega_pag.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"sol_entrega_pag.numero~" )    JOIN (LEFT=~"sol_entrega_pag.serie~"    OP =~"=~"RIGHT=~"sol_estatus.serie~" )    JOIN (LEFT=~"sol_entrega_pag.numero~"    OP =~"=~"RIGHT=~"sol_estatus.numero~" )    JOIN (LEFT=~"sol_entrega_pag.correlativo~"    OP =~"=~"RIGHT=~"sol_estatus.correlativo~" )WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"CORRELATIVO~~~"~"   OP =~"=~"    EXP2 =~":correlativo~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"CODIGO_SOLICITUD~~~"~"   OP =~"=~"    EXP2 =~":tipo_sol~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number)  ARG(NAME = ~"correlativo~" TYPE = number)  ARG(NAME = ~"tipo_sol~" TYPE = string) " update="SOL_ENTREGA_PAG" updatewhere=0 updatekeyinplace=yes arguments=(("base", string),("serie", string),("numero", number),("correlativo", number),("tipo_sol", string)) )
