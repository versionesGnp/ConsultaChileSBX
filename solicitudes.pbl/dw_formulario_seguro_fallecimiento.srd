l~") COLUMN(NAME=~"sol_seguro_fallece.estado_cob_original~") COLUMN(NAME=~"sol_seguro_fallece.estado_ctto_original~") COLUMN(NAME=~"sol_seguro_fallece.fecha_rescil_original~") COLUMN(NAME=~"sol_seguro_fallece.nombre_contacto~") COLUMN(NAME=~"sol_seguro_fallece.fono_contacto~") COLUMN(NAME=~"sol_seguro_fallece.direccion_contacto~") COLUMN(NAME=~"sol_seguro_fallece.tipo_via~") COLUMN(NAME=~"sol_seguro_fallece.numero_particular~") COLUMN(NAME=~"sol_seguro_fallece.depto_particular~") COLUMN(NAME=~"sol_seguro_fallece.block_particular~") COLUMN(NAME=~"sol_seguro_fallece.tipo_via_original~") COLUMN(NAME=~"sol_seguro_fallece.numero_particular_original~") COLUMN(NAME=~"sol_seguro_fallece.depto_particular_original~") COLUMN(NAME=~"sol_seguro_fallece.block_particular_original~") COLUMN(NAME=~"sol_seguro_fallece.ciudad_contacto~") COLUMN(NAME=~"sol_seguro_fallece.comuna_contacto~") COLUMN(NAME=~"sol_seguro_fallece.rut_benef~") COLUMN(NAME=~"sol_seguro_fallece.dv_benef~") COLUMN(NAME=~"sol_seguro_fallece.nombre_benef~") COLUMN(NAME=~"sol_seguro_fallece.ap_paterno_benef~") COLUMN(NAME=~"sol_seguro_fallece.ap_materno_benef~") COLUMN(NAME=~"sol_seguro_fallece.fecha_nac_benef~") COLUMN(NAME=~"sol_seguro_fallece.cod_parentesco~")    JOIN (LEFT=~"cliente.rut~"    OP =~"=~"RIGHT=~"cadena.rut~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"sol_seguro_fallece.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"sol_seguro_fallece.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"sol_seguro_fallece.numero~" )    JOIN (LEFT=~"sol_seguro_fallece.base~"    OP =~"=~"RIGHT=~"sol_estatus.base~" )    JOIN (LEFT=~"sol_seguro_fallece.serie~"    OP =~"=~"RIGHT=~"sol_estatus.serie~" )    JOIN (LEFT=~"sol_seguro_fallece.numero~"    OP =~"=~"RIGHT=~"sol_estatus.numero~" )    JOIN (LEFT=~"sol_seguro_fallece.correlativo~"    OP =~"=~"RIGHT=~"sol_estatus.correlativo~" )WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"CORRELATIVO~~~"~"   OP =~"=~"    EXP2 =~":correlativo~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"CODIGO_SOLICITUD~~~"~"   OP =~"=~"    EXP2 =~":tipo_sol~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number)  ARG(NAME = ~"correlativo~" TYPE = number)  ARG(NAME = ~"tipo_sol~" TYPE = string) " update="SOL_SEGURO_FALLECE" updatewhere=0 updatekeyinplace=yes arguments=(("base", string),("serie", string),("numero", number),("correlativo", number),("tipo_sol", string)) )
