 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"repacta_mantencion~" ) COLUMN(NAME=~"repacta_mantencion.base~") COLUMN(NAME=~"repacta_mantencion.serie~") COLUMN(NAME=~"repacta_mantencion.numero~") COLUMN(NAME=~"repacta_mantencion.base_original~") COLUMN(NAME=~"repacta_mantencion.serie_original~") COLUMN(NAME=~"repacta_mantencion.numero_original~") COLUMN(NAME=~"repacta_mantencion.fecha_crea~") COLUMN(NAME=~"repacta_mantencion.total_deuda~") COLUMN(NAME=~"repacta_mantencion.cuotas_pactadas~") COLUMN(NAME=~"repacta_mantencion.estado_pago~") COLUMN(NAME=~"repacta_mantencion.valor_cuota~") COLUMN(NAME=~"repacta_mantencion.fecha_primera_cta~") COLUMN(NAME=~"repacta_mantencion.cuotas_en_mora~") COLUMN(NAME=~"repacta_mantencion.usuario~") COLUMN(NAME=~"repacta_mantencion.ctas_pagadas~") COLUMN(NAME=~"repacta_mantencion.correlativo~") COLUMN(NAME=~"repacta_mantencion.rut_cliente~") COLUMN(NAME=~"repacta_mantencion.dv_cliente~") COLUMN(NAME=~"repacta_mantencion.total_deuda_uf~") COLUMN(NAME=~"repacta_mantencion.valor_cuota_uf~") COLUMN(NAME=~"repacta_mantencion.interes_cuota_pesos~") COLUMN(NAME=~"repacta_mantencion.interes_deuda_pesos~") COLUMN(NAME=~"repacta_mantencion.por_descuento~") COLUMN(NAME=~"repacta_mantencion.uf_dia~") COLUMN(NAME=~"repacta_mantencion.tipo_moneda~") COLUMN(NAME=~"repacta_mantencion.interes_adm_pesos~") COLUMN(NAME=~"repacta_mantencion.factor_aplicado~") COLUMN(NAME=~"repacta_mantencion.cta_mora_original~") COLUMN(NAME=~"repacta_mantencion.pie~") COLUMN(NAME=~"repacta_mantencion.fecha_pie~") COLUMN(NAME=~"repacta_mantencion.sub_total~") COLUMN(NAME=~"repacta_mantencion.total_cobros~")WHERE(    EXP1 =~"~~~"REPACTA_MANTENCION~~~".~~~"BASE_ORIGINAL~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"REPACTA_MANTENCION~~~".~~~"SERIE_ORIGINAL~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"REPACTA_MANTENCION~~~".~~~"NUMERO_ORIGINAL~~~"~"   OP =~"=~"    EXP2 =~":numero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"REPACTA_MANTENCION~~~".~~~"CORRELATIVO~~~"~"   OP =~"=~"    EXP2 =~":corr~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number)  ARG(NAME = ~"corr~" TYPE = number) " update="REPACTA_MANTENCION" updatewhere=0 updatekeyinplace=yes arguments=(("base", string),("serie", string),("numero", number),("corr", number)) )
