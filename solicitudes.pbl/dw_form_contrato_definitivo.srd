AME=~"sol_contrato_def.grupo_f_original~") COLUMN(NAME=~"sol_contrato_def.estado_cob_original~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"sol_contrato_def.estado_ctto_original~") COLUMN(NAME=~"sol_contrato_def.fecha_rescil_original~") COLUMN(NAME=~"sol_estatus.observacion~") COLUMN(NAME=~"sol_contrato_def.area_sepultura~") COLUMN(NAME=~"sol_contrato_def.sector_sepultura~") COLUMN(NAME=~"sol_contrato_def.tipo_via~") COLUMN(NAME=~"sol_contrato_def.numero_particular~") COLUMN(NAME=~"sol_contrato_def.depto_particular~") COLUMN(NAME=~"sol_contrato_def.block_particular~") COLUMN(NAME=~"sol_contrato_def.tipo_via_original~") COLUMN(NAME=~"sol_contrato_def.numero_particular_original~") COLUMN(NAME=~"sol_contrato_def.depto_particular_original~") COLUMN(NAME=~"sol_contrato_def.block_particular_original~")    JOIN (LEFT=~"cliente.rut~"    OP =~"=~"RIGHT=~"cadena.rut~" )    JOIN (LEFT=~"sol_estatus.base~"    OP =~"=~"RIGHT=~"sol_contrato_def.base~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"sol_contrato_def.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"sol_contrato_def.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"sol_contrato_def.numero~" )    JOIN (LEFT=~"sol_contrato_def.serie~"    OP =~"=~"RIGHT=~"sol_estatus.serie~" )    JOIN (LEFT=~"sol_contrato_def.numero~"    OP =~"=~"RIGHT=~"sol_estatus.numero~" )    JOIN (LEFT=~"sol_contrato_def.correlativo~"    OP =~"=~"RIGHT=~"sol_estatus.correlativo~" )WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"CORRELATIVO~~~"~"   OP =~"=~"    EXP2 =~":correlativo~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"CODIGO_SOLICITUD~~~"~"   OP =~"=~"    EXP2 =~":tipo_sol~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number)  ARG(NAME = ~"correlativo~" TYPE = number)  ARG(NAME = ~"tipo_sol~" TYPE = string) " update="SOL_CONTRATO_DEF" updatewhere=0 updatekeyinplace=yes arguments=(("base", string),("serie", string),("numero", number),("correlativo", number),("tipo_sol", string)) )
