 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"sol_cliente~" )  TABLE(NAME=~"sol_transferencia~" )  TABLE(NAME=~"cliente~" )  TABLE(NAME=~"sol_estatus~" ) COLUMN(NAME=~"sol_cliente.rut~") COLUMN(NAME=~"sol_cliente.dv~") COLUMN(NAME=~"sol_cliente.nombres~") COLUMN(NAME=~"sol_cliente.ap_paterno~") COLUMN(NAME=~"sol_cliente.ap_materno~") COLUMN(NAME=~"sol_cliente.direccion_p~") COLUMN(NAME=~"sol_cliente.poblacion~") COLUMN(NAME=~"sol_cliente.sector~") COLUMN(NAME=~"sol_cliente.comuna~") COLUMN(NAME=~"sol_cliente.ciudad~") COLUMN(NAME=~"sol_cliente.fono_p~") COLUMN(NAME=~"sol_cliente.sexo~") COLUMN(NAME=~"sol_cliente.fecha_nac~") COLUMN(NAME=~"sol_cliente.estado_civil~") COLUMN(NAME=~"sol_cliente.domicilio_c~") COLUMN(NAME=~"sol_cliente.fono_c~") COLUMN(NAME=~"sol_cliente.fecha_ing~") COLUMN(NAME=~"sol_cliente.total_renta~") COLUMN(NAME=~"sol_cliente.grupo_f~") COLUMN(NAME=~"cliente.rut~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cliente.direccion_p~") COLUMN(NAME=~"cliente.poblacion~") COLUMN(NAME=~"cliente.sector~") COLUMN(NAME=~"cliente.comuna~") COLUMN(NAME=~"cliente.ciudad~") COLUMN(NAME=~"cliente.fono_p~") COLUMN(NAME=~"cliente.fecha_nac~") COLUMN(NAME=~"cliente.esta_civil~") COLUMN(NAME=~"cliente.domicilio_c~") COLUMN(NAME=~"cliente.fono_c~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"sol_estatus.estado_reg~") COLUMN(NAME=~"sol_transferencia.base~") COLUMN(NAME=~"sol_transferencia.serie~") COLUMN(NAME=~"sol_transferencia.numero~") COLUMN(NAME=~"sol_transferencia.correlativo~") COLUMN(NAME=~"sol_cliente.tipo_via~") COLUMN(NAME=~"sol_cliente.numero_particular~") COLUMN(NAME=~"sol_cliente.depto_particular~") COLUMN(NAME=~"sol_cliente.block_particular~") COLUMN(NAME=~"cliente.tipo_via~") COLUMN(NAME=~"cliente.numero_particular~") COLUMN(NAME=~"cliente.depto_particular~") COLUMN(NAME=~"cliente.block_particular~") COLUMN(NAME=~"sol_estatus.codigo_solicitud~")    JOIN (LEFT=~"sol_cliente.rut_cliente_ori~"    OP =~"=~"RIGHT=~"sol_transferencia.rut_titular~" )    JOIN (LEFT=~"sol_cliente.base~"    OP =~"=~"RIGHT=~"sol_transferencia.base~" )    JOIN (LEFT=~"sol_cliente.serie~"    OP =~"=~"RIGHT=~"sol_transferencia.serie~" )    JOIN (LEFT=~"sol_cliente.numero~"    OP =~"=~"RIGHT=~"sol_transferencia.numero~" )    JOIN (LEFT=~"sol_cliente.correlativo~"    OP =~"=~"RIGHT=~"sol_transferencia.correlativo~" )    JOIN (LEFT=~"sol_cliente.rut_cliente_ori~"    OP =~"=~"RIGHT=~"cliente.rut~" )    JOIN (LEFT=~"sol_transferencia.base~"    OP =~"=~"RIGHT=~"sol_estatus.base~" )    JOIN (LEFT=~"sol_transferencia.serie~"    OP =~"=~"RIGHT=~"sol_estatus.serie~" )    JOIN (LEFT=~"sol_transferencia.numero~"    OP =~"=~"RIGHT=~"sol_estatus.numero~" )    JOIN (LEFT=~"sol_transferencia.correlativo~"    OP =~"=~"RIGHT=~"sol_estatus.correlativo~" )WHERE(    EXP1 =~"~~~"SOL_TRANSFERENCIA~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_TRANSFERENCIA~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_TRANSFERENCIA~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_TRANSFERENCIA~~~".~~~"CORRELATIVO~~~"~"   OP =~"=~"    EXP2 =~":correlativo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_TRANSFERENCIA~~~".~~~"RUT_TITULAR~~~"~"   OP =~"=~"    EXP2 =~":rut~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number)  ARG(NAME = ~"rut~" TYPE = number)  ARG(NAME = ~"correlativo~" TYPE = number) " arguments=(("base", string),("serie", string),("numero", number),("rut", number),("correlativo", number)) )
