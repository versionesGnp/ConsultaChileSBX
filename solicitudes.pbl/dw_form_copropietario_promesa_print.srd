 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cliente~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"sol_estatus~" )  TABLE(NAME=~"sol_coprop_promesa~" )  TABLE(NAME=~"tipo_via~" )  TABLE(NAME=~"comuna~" ) COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"cadena.fecha_res~") COLUMN(NAME=~"cadena.estado_titulo~") COLUMN(NAME=~"cliente.direccion_p~") COLUMN(NAME=~"cliente.poblacion~") COLUMN(NAME=~"cliente.sector~") COLUMN(NAME=~"cliente.comuna~") COLUMN(NAME=~"cliente.ciudad~") COLUMN(NAME=~"cliente.fono_p~") COLUMN(NAME=~"cliente.sexo~") COLUMN(NAME=~"cliente.fecha_nac~") COLUMN(NAME=~"cliente.esta_civil~") COLUMN(NAME=~"cliente.domicilio_c~") COLUMN(NAME=~"cliente.fono_c~") COLUMN(NAME=~"cliente.fecha_ingr~") COLUMN(NAME=~"cliente.total_rent~") COLUMN(NAME=~"cliente.grupo_f~") COLUMN(NAME=~"cliente.estado_cobranza~") COLUMN(NAME=~"cliente.rut~") COLUMN(NAME=~"cliente.tipo~") COLUMN(NAME=~"sol_estatus.codigo_solicitud~") COLUMN(NAME=~"sol_estatus.estado_reg~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"sol_estatus.observacion~") COLUMN(NAME=~"sol_coprop_promesa.base~") COLUMN(NAME=~"sol_coprop_promesa.serie~") COLUMN(NAME=~"sol_coprop_promesa.numero~") COLUMN(NAME=~"sol_coprop_promesa.correlativo~") COLUMN(NAME=~"sol_coprop_promesa.rut_titular~") COLUMN(NAME=~"sol_coprop_promesa.dv_titular~") COLUMN(NAME=~"sol_coprop_promesa.cod_parque~") COLUMN(NAME=~"sol_coprop_promesa.fecha_creacion~") COLUMN(NAME=~"sol_coprop_promesa.fecha_contrato~") COLUMN(NAME=~"sol_coprop_promesa.uso~") COLUMN(NAME=~"cliente.numero_particular~") COLUMN(NAME=~"cliente.depto_particular~") COLUMN(NAME=~"cliente.block_particular~") COLUMN(NAME=~"cliente.tipo_via~") COLUMN(NAME=~"tipo_via.descripcion~") COLUMN(NAME=~"sol_coprop_promesa.estatus_opera~") COLUMN(NAME=~"sol_coprop_promesa.fecha_opera~") COLUMN(NAME=~"sol_coprop_promesa.usuario_opera~") COLUMN(NAME=~"sol_coprop_promesa.estatus_infor~") COLUMN(NAME=~"sol_coprop_promesa.fecha_infor~") COLUMN(NAME=~"sol_coprop_promesa.usuario_infor~") COLUMN(NAME=~"sol_coprop_promesa.mod_ant_cliente~") COLUMN(NAME=~"comuna.comuna~")    JOIN (LEFT=~"cliente.rut~"    OP =~"=~"RIGHT=~"cadena.rut~" )    JOIN (LEFT=~"sol_estatus.base~"    OP =~"=~"RIGHT=~"sol_coprop_promesa.base~" )    JOIN (LEFT=~"sol_estatus.serie~"    OP =~"=~"RIGHT=~"sol_coprop_promesa.serie~" )    JOIN (LEFT=~"sol_estatus.numero~"    OP =~"=~"RIGHT=~"sol_coprop_promesa.numero~" )    JOIN (LEFT=~"sol_estatus.correlativo~"    OP =~"=~"RIGHT=~"sol_coprop_promesa.correlativo~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"sol_coprop_promesa.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"sol_coprop_promesa.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"sol_coprop_promesa.numero~" )    JOIN (LEFT=~"cliente.tipo_via~"    OP =~"=~"RIGHT=~"tipo_via.tipo_via~" )    JOIN (LEFT=~"cliente.comuna~"    OP =~"=~"RIGHT=~"comuna.codigo_comuna~" )WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"CORRELATIVO~~~"~"   OP =~"=~"    EXP2 =~":correlativo~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"CODIGO_SOLICITUD~~~"~"   OP =~"=~"    EXP2 =~":tipo_sol~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number)  ARG(NAME = ~"correlativo~" TYPE = number)  ARG(NAME = ~"tipo_sol~" TYPE = string) " update="SOL_COPROP_PROMESA" updatewhere=0 updatekeyinplace=yes arguments=(("base", string),("serie", string),("numero", number),("correlativo", number),("tipo_sol", string)) )
