 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"sol_cliente~" ) COLUMN(NAME=~"sol_cliente.rut~") COLUMN(NAME=~"sol_cliente.dv~") COLUMN(NAME=~"sol_cliente.comuna~") COLUMN(NAME=~"sol_cliente.ciudad~") COLUMN(NAME=~"sol_cliente.fono_p~") COLUMN(NAME=~"sol_cliente.sexo~") COLUMN(NAME=~"sol_cliente.fecha_nac~") COLUMN(NAME=~"sol_cliente.estado_civil~") COLUMN(NAME=~"sol_cliente.fono_c~") COLUMN(NAME=~"sol_cliente.fecha_ing~") COLUMN(NAME=~"sol_cliente.total_renta~") COLUMN(NAME=~"sol_cliente.grupo_f~") COLUMN(NAME=~"sol_cliente.usuario~") COLUMN(NAME=~"sol_cliente.base~") COLUMN(NAME=~"sol_cliente.serie~") COLUMN(NAME=~"sol_cliente.numero~") COLUMN(NAME=~"sol_cliente.correlativo~") COLUMN(NAME=~"sol_cliente.rut_cliente_ori~") COLUMN(NAME=~"sol_cliente.tipo_via~") COLUMN(NAME=~"sol_cliente.numero_particular~") COLUMN(NAME=~"sol_cliente.depto_particular~") COLUMN(NAME=~"sol_cliente.block_particular~") COLUMN(NAME=~"sol_cliente.nombres~") COLUMN(NAME=~"sol_cliente.ap_paterno~") COLUMN(NAME=~"sol_cliente.ap_materno~") COLUMN(NAME=~"sol_cliente.direccion_p~") COLUMN(NAME=~"sol_cliente.poblacion~") COLUMN(NAME=~"sol_cliente.sector~") COLUMN(NAME=~"sol_cliente.domicilio_c~")WHERE(    EXP1 =~"~~~"SOL_CLIENTE~~~".~~~"RUT_CLIENTE_ORI~~~"~"   OP =~"=~"    EXP2 =~":rut~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"SOL_CLIENTE~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_CLIENTE~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_CLIENTE~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_CLIENTE~~~".~~~"CORRELATIVO~~~"~"   OP =~"=~"    EXP2 =~":corr~" ) ) ARG(NAME = ~"rut~" TYPE = number)  ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number)  ARG(NAME = ~"corr~" TYPE = number) " update="SOL_CLIENTE" updatewhere=0 updatekeyinplace=yes arguments=(("rut", number),("base", string),("serie", string),("numero", number),("corr", number)) )
