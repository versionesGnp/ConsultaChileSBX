 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cadena_mora~" )  TABLE(NAME=~"cuponeras~" )  TABLE(NAME=~"cuponeras_detalle~" ) COLUMN(NAME=~"cuponeras_detalle.nro_cuota~") COLUMN(NAME=~"cuponeras_detalle.fecha_venc~") COLUMN(NAME=~"cuponeras_detalle.monto_cuota_contrato~")    JOIN (LEFT=~"cadena_mora.base~"    OP =~"=~"RIGHT=~"cuponeras.base~" )    JOIN (LEFT=~"cuponeras.base~"    OP =~"=~"RIGHT=~"cuponeras_detalle.base~" )    JOIN (LEFT=~"cadena_mora.serie~"    OP =~"=~"RIGHT=~"cuponeras.serie~" )    JOIN (LEFT=~"cadena_mora.numero~"    OP =~"=~"RIGHT=~"cuponeras.numero~" )    JOIN (LEFT=~"cuponeras.serie~"    OP =~"=~"RIGHT=~"cuponeras_detalle.serie~" )    JOIN (LEFT=~"cuponeras.numero~"    OP =~"=~"RIGHT=~"cuponeras_detalle.numero~" )    JOIN (LEFT=~"cuponeras.nro_cuponera~"    OP =~"=~"RIGHT=~"cuponeras_detalle.nro_cuponera~" )WHERE(    EXP1 =~"~~~"CADENA_MORA~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CADENA_MORA~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CADENA_MORA~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CUPONERAS~~~".~~~"ESTADO_CUPONERA~~~"~"   OP =~"=~"    EXP2 =~"'V'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CUPONERAS_DETALLE~~~".~~~"FECHA_VENC~~~"~"   OP =~">=~"    EXP2 =~"~~~"CADENA_MORA~~~".~~~"FECHA_VENC_MANT~~~"~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CUPONERAS_DETALLE~~~".~~~"TIPO_MOV~~~"~"   OP =~"=~"    EXP2 =~"'F'~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number) " arguments=(("base", string),("serie", string),("numero", number)) )
