 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cliente~" )  TABLE(NAME=~"sol_estatus~" )  TABLE(NAME=~"sol_mod_antece~" ) COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cliente.rut~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"sol_estatus.base~") COLUMN(NAME=~"sol_estatus.serie~") COLUMN(NAME=~"sol_estatus.numero~") COLUMN(NAME=~"sol_estatus.correlativo~") COLUMN(NAME=~"sol_estatus.codigo_solicitud~") COLUMN(NAME=~"sol_estatus.observacion~") COLUMN(NAME=~"sol_estatus.estado_reg~") COLUMN(NAME=~"sol_mod_antece.rut~") COLUMN(NAME=~"sol_mod_antece.estatus_mod~") COLUMN(NAME=~"sol_mod_antece.estatus_informatica~") COLUMN(NAME=~"sol_mod_antece.estatus_operaciones~") COLUMN(NAME=~"sol_mod_antece.usuario_opera~") COLUMN(NAME=~"sol_mod_antece.fecha_opera~") COLUMN(NAME=~"sol_mod_antece.usuario_infor~") COLUMN(NAME=~"sol_mod_antece.fecha_infor~") COLUMN(NAME=~"sol_mod_antece.nombre_nueva~") COLUMN(NAME=~"sol_mod_antece.ap_paterno_nueva~") COLUMN(NAME=~"sol_mod_antece.ap_materno_nueva~") COLUMN(NAME=~"sol_mod_antece.correlativo~") COLUMN(NAME=~"sol_mod_antece.fecha~")    JOIN (LEFT=~"sol_estatus.rut_cliente~"    OP =~"=~"RIGHT=~"sol_mod_antece.rut~" )    JOIN (LEFT=~"sol_mod_antece.rut~"    OP =~"=~"RIGHT=~"cliente.rut~" )    JOIN (LEFT=~"sol_mod_antece.correlativo~"    OP =~"=~"RIGHT=~"sol_estatus.correlativo~" )WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~" ) ) ARG(NAME = ~"numero~" TYPE = number) " update="SOL_MOD_ANTECE" updatewhere=0 updatekeyinplace=yes arguments=(("numero", number))  sort="sol_estatus_base A sol_estatus_serie A sol_estatus_numero A sol_mod_antece_correlativo A " )
