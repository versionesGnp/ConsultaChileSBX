IN (LEFT=~"sol_estatus.correlativo~"    OP =~"=~"RIGHT=~"sol_coprop_promesa.correlativo~" )WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"CODIGO_SOLICITUD~~~"~"   OP =~"=~"    EXP2 =~":tipo_sol~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number)  ARG(NAME = ~"tipo_sol~" TYPE = string) " update="SOL_COPROP_PROMESA" updatewhere=0 updatekeyinplace=yes arguments=(("base", string),("serie", string),("numero", number),("tipo_sol", string))  sort="sol_estatus_base A sol_estatus_serie A sol_estatus_numero A sol_estatus_correlativo A " )
