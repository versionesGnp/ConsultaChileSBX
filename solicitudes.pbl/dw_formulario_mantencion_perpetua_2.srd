OLUMN(NAME=~"sol_mant_perpetua.estado_ctto_original~") COLUMN(NAME=~"sol_mant_perpetua.fecha_rescil_original~") COLUMN(NAME=~"sol_mant_perpetua.nombre_contacto~") COLUMN(NAME=~"sol_mant_perpetua.fono_contacto~") COLUMN(NAME=~"sol_mant_perpetua.direccion_contacto~") COLUMN(NAME=~"sol_mant_perpetua.tipo_via~") COLUMN(NAME=~"sol_mant_perpetua.numero_particular~") COLUMN(NAME=~"sol_mant_perpetua.depto_particular~") COLUMN(NAME=~"sol_mant_perpetua.block_particular~") COLUMN(NAME=~"sol_mant_perpetua.tipo_via_original~") COLUMN(NAME=~"sol_mant_perpetua.numero_particular_original~") COLUMN(NAME=~"sol_mant_perpetua.depto_particular_original~") COLUMN(NAME=~"sol_mant_perpetua.block_particular_original~") COLUMN(NAME=~"sol_mant_perpetua.ciudad_contacto~") COLUMN(NAME=~"sol_mant_perpetua.comuna_contacto~")    JOIN (LEFT=~"cliente.rut~"    OP =~"=~"RIGHT=~"cadena.rut~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"sol_mant_perpetua.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"sol_mant_perpetua.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"sol_mant_perpetua.numero~" )    JOIN (LEFT=~"sol_mant_perpetua.base~"    OP =~"=~"RIGHT=~"sol_estatus.base~" )    JOIN (LEFT=~"sol_mant_perpetua.serie~"    OP =~"=~"RIGHT=~"sol_estatus.serie~" )    JOIN (LEFT=~"sol_mant_perpetua.numero~"    OP =~"=~"RIGHT=~"sol_estatus.numero~" )    JOIN (LEFT=~"sol_mant_perpetua.correlativo~"    OP =~"=~"RIGHT=~"sol_estatus.correlativo~" )WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"CORRELATIVO~~~"~"   OP =~"=~"    EXP2 =~":correlativo~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"CODIGO_SOLICITUD~~~"~"   OP =~"=~"    EXP2 =~":tipo_sol~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number)  ARG(NAME = ~"correlativo~" TYPE = number)  ARG(NAME = ~"tipo_sol~" TYPE = string) " update="SOL_MANT_PERPETUA" updatewhere=0 updatekeyinplace=yes arguments=(("base", string),("serie", string),("numero", number),("correlativo", number),("tipo_sol", string)) )
