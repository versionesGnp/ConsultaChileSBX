table(column=(type=char(1) update=yes updatewhereclause=yes key=yes name=base dbname="sol_estatus.base" )
 column=(type=char(1) update=yes updatewhereclause=yes key=yes name=serie dbname="sol_estatus.serie" )
 column=(type=decimal(4) update=yes updatewhereclause=yes key=yes name=numero dbname="sol_estatus.numero" )
 column=(type=decimal(4) update=yes updatewhereclause=yes key=yes name=correlativo dbname="sol_estatus.correlativo" )
 column=(type=char(5) update=yes updatewhereclause=yes key=yes name=codigo_solicitud dbname="sol_estatus.codigo_solicitud" )
 column=(type=char(500) update=yes updatewhereclause=yes name=observacion dbname="sol_estatus.observacion" )
 column=(type=char(1) update=yes updatewhereclause=yes name=estado_reg dbname="sol_estatus.estado_reg" values="A - Activo	A/I - Inactivo	I/" )
 column=(type=number updatewhereclause=yes name=estatus_operacion dbname="compute_0008" values="	0/	1" )
 column=(type=number updatewhereclause=yes name=estatus_informatica dbname="compute_0009" values="	0/	1" )
 column=(type=char(0) updatewhereclause=yes name=usuario_opera dbname="compute_0010" )
 column=(type=char(0) updatewhereclause=yes name=fecha_opera dbname="compute_0011" )
 column=(type=char(0) updatewhereclause=yes name=usuario_infor dbname="compute_0012" )
 column=(type=char(0) updatewhereclause=yes name=fecha_infor dbname="compute_0013" )
 column=(type=char(0) updatewhereclause=yes name=mod_ant_cliente dbname="compute_0014" values="Si	S/No	N/" )
 column=(type=number updatewhereclause=yes name=rut_titular dbname="compute_0015" )
 column=(type=number updatewhereclause=yes name=estatus_cupon dbname="compute_0016" values="	0/	1" )
 column=(type=decimal(4) updatewhereclause=yes name=rut_cliente dbname="sol_estatus.rut_cliente" )
 column=(type=datetime update=yes updatewhereclause=yes name=fecha_crea dbname="sol_estatus.fecha_crea" )
 column=(type=decimal(4) updatewhereclause=yes name=cadena_cod_parque dbname="cadena.cod_parque" )
 column=(type=char(1) updatewhereclause=yes name=cadena_estado dbname="cadena.estado" )
 column=(type=char(500) updatewhereclause=yes name=solicitudes_descripcion dbname="solicitudes.descripcion" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"sol_estatus~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"solicitudes~" ) COLUMN(NAME=~"sol_estatus.base~") COLUMN(NAME=~"sol_estatus.serie~") COLUMN(NAME=~"sol_estatus.numero~") COLUMN(NAME=~"sol_estatus.correlativo~") COLUMN(NAME=~"sol_estatus.codigo_solicitud~") COLUMN(NAME=~"sol_estatus.observacion~") COLUMN(NAME=~"sol_estatus.estado_reg~") COMPUTE(NAME=~"0,0,'','','','','',0,0~") COLUMN(NAME=~"sol_estatus.rut_cliente~") COLUMN(NAME=~"sol_estatus.fecha_crea~") COLUMN(NAME=~"cadena.cod_parque~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"solicitudes.descripcion~")    JOIN (LEFT=~"sol_estatus.numero~"    OP =~"=~"RIGHT=~"cadena.numero~" )    JOIN (LEFT=~"sol_estatus.base~"    OP =~"=~"RIGHT=~"cadena.codigo~" )    JOIN (LEFT=~"sol_estatus.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"sol_estatus.codigo_solicitud~"    OP =~"=~"RIGHT=~"solicitudes.codigo_solicitud~" )WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"CODIGO_SOLICITUD~~~"~"   OP =~"like~"    EXP2 =~":tipo_sol~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"FECHA_CREA~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"FECHA_CREA~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~" ) )    UNION (PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"cadena~" )  TABLE(NAME=~"sol_estatus~" )  TABLE(NAME=~"solicitudes~" ) COLUMN(NAME=~"sol_estatus.base~") COLUMN(NAME=~"sol_estatus.serie~") COLUMN(NAME=~"sol_estatus.numero~") COLUMN(NAME=~"sol_estatus.correlativo~") COLUMN(NAME=~"sol_estatus.codigo_solicitud~") COLUMN(NAME=~"sol_estatus.observacion~") COLUMN(NAME=~"sol_estatus.estado_reg~") COMPUTE(NAME=~"0,0,'','','','','',0,0~") COLUMN(NAME=~"sol_estatus.rut_cliente~") COLUMN(NAME=~"sol_estatus.fecha_crea~") COLUMN(NAME=~"cadena.cod_parque~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"solicitudes.descripcion~")    JOIN (LEFT=~"sol_estatus.codigo_solicitud~"    OP =~"=~"RIGHT=~"solicitudes.codigo_solicitud~" )    JOIN (LEFT=~"cadena.rut~"    OP =~"=~"RIGHT=~"sol_estatus.rut_cliente~" )WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"CODIGO_SOLICITUD~~~"~"   OP =~"like~"    EXP2 =~":tipo_sol~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"FECHA_CREA~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"FECHA_CREA~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"CODIGO_SOLICITUD~~~"~"   OP =~"=~"    EXP2 =~"'12'~" ) )) ARG(NAME = ~"tipo_sol~" TYPE = string)  ARG(NAME = ~"fecha_ini~" TYPE = datetime)  ARG(NAME = ~"fecha_fin~" TYPE = datetime) " update="SOL_ESTATUS" updatewhere=0 updatekeyinplace=yes arguments=(("tipo_sol", string),("fecha_ini", datetime),("fecha_fin", datetime))  sort="numero A " )
