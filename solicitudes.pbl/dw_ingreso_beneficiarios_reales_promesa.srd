table(column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=contador dbname="co_prop.contador" )
 column=(type=char(1) update=yes updatewhereclause=yes key=yes name=serie dbname="co_prop.serie" )
 column=(type=decimal(4) update=yes updatewhereclause=yes key=yes name=nro_oferta dbname="co_prop.nro_oferta" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=rut dbname="co_prop.rut" )
 column=(type=char(30) update=yes updatewhereclause=yes name=nombre dbname="co_prop.nombre" )
 column=(type=char(15) update=yes updatewhereclause=yes name=a_paterno dbname="co_prop.a_paterno" )
 column=(type=char(15) update=yes updatewhereclause=yes name=a_materno dbname="co_prop.a_materno" )
 column=(type=char(1) update=yes updatewhereclause=yes name=dv dbname="co_prop.dv" )
 column=(type=char(0) updatewhereclause=yes name=estado dbname="compute_0009" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"co_prop~" ) COLUMN(NAME=~"co_prop.contador~") COLUMN(NAME=~"co_prop.serie~") COLUMN(NAME=~"co_prop.nro_oferta~") COLUMN(NAME=~"co_prop.rut~") COLUMN(NAME=~"co_prop.nombre~") COLUMN(NAME=~"co_prop.a_paterno~") COLUMN(NAME=~"co_prop.a_materno~") COLUMN(NAME=~"co_prop.dv~") COMPUTE(NAME=~"''~")WHERE(    EXP1 =~"~~~"CO_PROP~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":as_serie~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CO_PROP~~~".~~~"NRO_OFERTA~~~"~"   OP =~"=~"    EXP2 =~":an_numero~" ) ) ARG(NAME = ~"as_serie~" TYPE = string)  ARG(NAME = ~"an_numero~" TYPE = number)  ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"sepultura~" TYPE = string)  ARG(NAME = ~"nombre_cliente~" TYPE = string)  ARG(NAME = ~"conexion~" TYPE = string)  ARG(NAME = ~"parque~" TYPE = number) " update="CO_PROP" updatewhere=0 updatekeyinplace=no arguments=(("as_serie", string),("an_numero", number),("base", string),("sepultura", string),("nombre_cliente", string),("conexion", string),("parque", number)) )
compute(band=header alignment="3" expression="'En La Serena a '+day(today())+' de '+case( Month(today()) when 1 then 'Enero' when 2 then 'Febrero' when 3 then 'Marzo' when 4 then 'Abril' when 5 then 'Mayo' when 6 then 'Junio' when 7 then 'Julio' when 8 then 'Agosto' when 9 then 'Septiembre' when 10 then 'Octubre' when 11 then 'Noviembre' when 12 then 'Diciembre')+' de '+year(today())+', entre la sociedad INMOBILIARIA PARQUE DE LA SERENA SpA, RUT.: 96.835.970-3, con domicilio en Ruta 41 Sector Aeropuerto Camino Vicuña, en adelante ~"LA FORESTA~", y do(n)(ña) '+ nombre_cliente +', en adelante ~"EL CLIENTE~", se ha celebrado el contrato de '+if ( base ='O','promesa ','Isacruz ')+'de compraventa de derechos de sepultación Nº '+ base +' - '+ as_serie +' - '+string( an_numero ,~"###,###,###,###,##0~")+' y sus modificaciones posteriores.'"border="0" color="0" x="18" y="516" height="264" width="2583" format="[GENERAL]" html.valueishtml="0"  name=txt_serena visible="1"  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" background.transparency="0" background.gradient.color="8421504" background.gradient.transparency="0" background.gradient.angle="0" background.brushmode="0" background.gradient.repetition.mode="0" background.gradient.repetition.count="0" background.gradient.repetition.length="100" background.gradient.focus="0" background.gradient.scale="100" background.gradient.spread="100" tooltip.backcolor="134217752" tooltip.delay.initial="0" tooltip.delay.visible="32000" tooltip.enabled="0" tooltip.hasclosebutton="0" tooltip.icon="0" tooltip.isbubble="0" tooltip.maxwidth="0" tooltip.textcolor="134217751" tooltip.transparency="0" transparency="0" )
compute(band=header alignment="3" expression="'En Santiago a '+day(today())+' de '+case( Month(today()) when 1 then 'Enero' when 2 then 'Febrero' when 3 then 'Marzo' when 4 then 'Abril' when 5 then 'Mayo' when 6 then 'Junio' when 7 then 'Julio' when 8 then 'Agosto' when 9 then 'Septiembre' when 10 then 'Octubre' when 11 then 'Noviembre' when 12 then 'Diciembre')+' de '+year(today())+', entre la sociedad '+if (  parque =103,'El Retiro e Inversiones S.A.', f_buscar_dato_membrete('empresa'))+', '+if (  parque =103, 'R.U.T. 95.362.000-6', f_buscar_dato_membrete('rut'))+', con domicilio en calle Estado Nº 360, 2 piso, comuna de Santiago, en adelante ~"LA FLORIDA~", y do(n)(ña) '+ nombre_cliente +', en adelante ~"EL CLIENTE~", se ha celebrado el contrato de '+if ( base ='O','promesa ',if (  parque =103, 'promesa ' , 'Isacruz '))+'de compraventa de derechos de sepultación Nº '+ base +' - '+ as_serie +' - '+string( an_numero ,~"###,###,###,###,##0~")+' y sus modificaciones posteriores.'"border="0" color="0" x="18" y="516" height="264" width="2583" format="[GENERAL]" html.valueishtml="0"  name=txt_stgo visible="1"  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" background.transparency="0" background.gradient.color="8421504" background.gradient.transparency="0" background.gradient.angle="0" background.brushmode="0" background.gradient.repetition.mode="0" background.gradient.repetition.count="0" background.gradient.repetition.length="100" background.gradient.focus="0" background.gradient.scale="100" background.gradient.spread="100" tooltip.backcolor="134217752" tooltip.delay.initial="0" tooltip.delay.visible="32000" tooltip.enabled="0" tooltip.hasclosebutton="0" tooltip.icon="0" tooltip.isbubble="0" tooltip.maxwidth="0" tooltip.textcolor="134217751" tooltip.transparency="0" transparency="0" )
compute(band=header alignment="3" expression="'En Concepción a '+day(today())+' de '+case( Month(today()) when 1 then 'Enero' when 2 then 'Febrero' when 3 then 'Marzo' when 4 then 'Abril' when 5 then 'Mayo' when 6 then 'Junio' when 7 then 'Julio' when 8 then 'Agosto' when 9 then 'Septiembre' when 10 then 'Octubre' when 11 then 'Noviembre' when 12 then 'Diciembre')+' de '+year(today())+', entre la sociedad '+if (  parque =801,'Parque de Concepción S.A.', f_buscar_dato_membrete('empresa'))+', '+if (  parque =801, 'R.U.T. 76.703.310-9', f_buscar_dato_membrete('rut'))+', con domicilio en Av. Costanera Nº 2220, comuna de Concepción, en adelante ~"CONCEPCION~", y do(n)(ña) '+ nombre_cliente +', en adelante ~"EL CLIENTE~", se ha celebrado el contrato de '+if ( base ='O','promesa ',if (  parque =801, 'promesa ' , 'Isacruz '))+'de compraventa de derechos de sepultación Nº '+ base +' - '+ as_serie +' - '+string( an_numero ,~"###,###,###,###,##0~")+' y sus modificaciones posteriores.'"border="0" color="0" x="18" y="516" height="264" width="2583" format="[GENERAL]" html.valueishtml="0"  name=txt_conce visible="1"  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" background.transparency="0" background.gradient.color="8421504" background.gradient.transparency="0" background.gradient.angle="0" background.brushmode="0" background.gradient.repetition.mode="0" background.gradient.repetition.count="0" background.gradient.repetition.length="100" background.gradient.focus="0" background.gradient.scale="100" background.gradient.spread="100" tooltip.backcolor="134217752" tooltip.delay.initial="0" tooltip.delay.visible="32000" tooltip.enabled="0" tooltip.hasclosebutton="0" tooltip.icon="0" tooltip.isbubble="0" tooltip.maxwidth="0" tooltip.textcolor="134217751" tooltip.transparency="0" transparency="0" )
