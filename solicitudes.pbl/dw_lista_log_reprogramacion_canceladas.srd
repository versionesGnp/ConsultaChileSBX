 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"log_repacta_canceladas~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"cliente~" ) COLUMN(NAME=~"log_repacta_canceladas.correlativo~") COLUMN(NAME=~"log_repacta_canceladas.base~") COLUMN(NAME=~"log_repacta_canceladas.serie~") COLUMN(NAME=~"log_repacta_canceladas.numero~") COLUMN(NAME=~"log_repacta_canceladas.cuotas_pactadas_original~") COLUMN(NAME=~"log_repacta_canceladas.cuotas_pactadas~") COLUMN(NAME=~"log_repacta_canceladas.fecha~") COLUMN(NAME=~"log_repacta_canceladas.tipo_cliente~") COLUMN(NAME=~"log_repacta_canceladas.base_ctto_original~") COLUMN(NAME=~"log_repacta_canceladas.serie_ctto_original~") COLUMN(NAME=~"log_repacta_canceladas.numero_ctto_original~") COLUMN(NAME=~"log_repacta_canceladas.rut_cliente~") COLUMN(NAME=~"log_repacta_canceladas.cod_pago_reconocimiento~") COLUMN(NAME=~"log_repacta_canceladas.folio_reconocimiento~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"cadena.cod_parque~") COLUMN(NAME=~"cadena.estado~")    JOIN (LEFT=~"log_repacta_canceladas.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"log_repacta_canceladas.base~"    OP =~"=~"RIGHT=~"cadena.codigo~" )    JOIN (LEFT=~"log_repacta_canceladas.numero~"    OP =~"=~"RIGHT=~"cadena.numero~" )    JOIN (LEFT=~"log_repacta_canceladas.rut_cliente~"    OP =~"=~"RIGHT=~"cliente.rut~" )WHERE(    EXP1 =~"~~~"LOG_REPACTA_CANCELADAS~~~".~~~"BASE_CTTO_ORIGINAL~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"LOG_REPACTA_CANCELADAS~~~".~~~"SERIE_CTTO_ORIGINAL~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"LOG_REPACTA_CANCELADAS~~~".~~~"NUMERO_CTTO_ORIGINAL~~~"~"   OP =~"=~"    EXP2 =~":numero~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number) " arguments=(("base", string),("serie", string),("numero", number))  sort="correlativo A " )
