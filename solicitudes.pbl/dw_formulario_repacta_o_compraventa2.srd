pacta_cvta.block_particular_original~") COLUMN(NAME=~"sol_repacta_cvta.area_sep~") COLUMN(NAME=~"sol_repacta_cvta.sector_sep~") COLUMN(NAME=~"sol_repacta_cvta.nro_sepultura~") COLUMN(NAME=~"sol_repacta_cvta.cod_parque~") COLUMN(NAME=~"membrete_empresa.empresa~") COLUMN(NAME=~"membrete_empresa.comuna~") COLUMN(NAME=~"membrete_empresa.rut~") COLUMN(NAME=~"membrete_empresa.direccion~") COLUMN(NAME=~"membrete_empresa.parque~") COLUMN(NAME=~"membrete_empresa.ciudad~")    JOIN (LEFT=~"cliente.rut~"    OP =~"=~"RIGHT=~"cadena.rut~" )    JOIN (LEFT=~"sol_estatus.base~"    OP =~"=~"RIGHT=~"sol_repacta_cvta.base~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"sol_repacta_cvta.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"sol_repacta_cvta.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"sol_repacta_cvta.numero~" )    JOIN (LEFT=~"sol_repacta_cvta.serie~"    OP =~"=~"RIGHT=~"sol_estatus.serie~" )    JOIN (LEFT=~"sol_repacta_cvta.numero~"    OP =~"=~"RIGHT=~"sol_estatus.numero~" )    JOIN (LEFT=~"sol_repacta_cvta.correlativo~"    OP =~"=~"RIGHT=~"sol_estatus.correlativo~" )    JOIN (LEFT=~"sol_repacta_cvta.cod_parque~"    OP =~"=~"RIGHT=~"membrete_empresa.cod_parque~" )WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"CODIGO_SOLICITUD~~~"~"   OP =~"=~"    EXP2 =~":tipo_sol~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"CORRELATIVO~~~"~"   OP =~"=~"    EXP2 =~":corr~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"MEMBRETE_EMPRESA~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":cod_parque~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number)  ARG(NAME = ~"corr~" TYPE = number)  ARG(NAME = ~"tipo_sol~" TYPE = string)  ARG(NAME = ~"cod_parque~" TYPE = number) " arguments=(("base", string),("serie", string),("numero", number),("corr", number),("tipo_sol", string),("cod_parque", number)) )
