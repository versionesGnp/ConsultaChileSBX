o_c_original~") COLUMN(NAME=~"sol_en_demanda.fono_c_original~") COLUMN(NAME=~"sol_en_demanda.total_renta_original~") COLUMN(NAME=~"sol_en_demanda.grupo_f_original~") COLUMN(NAME=~"sol_en_demanda.estado_cod_original~") COLUMN(NAME=~"sol_en_demanda.estado_ctto_original~") COLUMN(NAME=~"sol_en_demanda.fecha_rescil_original~") COLUMN(NAME=~"sol_en_demanda.area_sepultura~") COLUMN(NAME=~"sol_en_demanda.sector_sepultura~") COLUMN(NAME=~"sol_en_demanda.sepultura~") COLUMN(NAME=~"sol_en_demanda.capacidad~") COLUMN(NAME=~"sol_en_demanda.fecha_contrato~") COLUMN(NAME=~"sol_en_demanda.tipo_via~") COLUMN(NAME=~"sol_en_demanda.numero_particular~") COLUMN(NAME=~"sol_en_demanda.depto_particular~") COLUMN(NAME=~"sol_en_demanda.block_particular~") COLUMN(NAME=~"sol_en_demanda.tipo_via_original~") COLUMN(NAME=~"sol_en_demanda.numero_particular_original~") COLUMN(NAME=~"sol_en_demanda.depto_particular_original~") COLUMN(NAME=~"sol_en_demanda.block_particular_original~") COLUMN(NAME=~"sol_en_demanda.estado_ctto_final~") COLUMN(NAME=~"sol_en_demanda.procedimiento~") COLUMN(NAME=~"sol_en_demanda.materia~") COLUMN(NAME=~"sol_en_demanda.rut_empresa_demandante~") COLUMN(NAME=~"sol_en_demanda.abogado_patrocinante~")    JOIN (LEFT=~"cliente.rut~"    OP =~"=~"RIGHT=~"cadena.rut~" )    JOIN (LEFT=~"sol_estatus.base~"    OP =~"=~"RIGHT=~"sol_en_demanda.base~" )    JOIN (LEFT=~"sol_estatus.serie~"    OP =~"=~"RIGHT=~"sol_en_demanda.serie~" )    JOIN (LEFT=~"sol_estatus.numero~"    OP =~"=~"RIGHT=~"sol_en_demanda.numero~" )    JOIN (LEFT=~"sol_estatus.correlativo~"    OP =~"=~"RIGHT=~"sol_en_demanda.correlativo~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"sol_en_demanda.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"sol_en_demanda.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"sol_en_demanda.numero~" )WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"CORRELATIVO~~~"~"   OP =~"=~"    EXP2 =~":correlativo~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"CODIGO_SOLICITUD~~~"~"   OP =~"=~"    EXP2 =~":tipo_sol~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number)  ARG(NAME = ~"correlativo~" TYPE = number)  ARG(NAME = ~"tipo_sol~" TYPE = string) " update="SOL_EN_DEMANDA" updatewhere=0 updatekeyinplace=yes arguments=(("base", string),("serie", string),("numero", number),("correlativo", number),("tipo_sol", string)) )
