compute(band=detail alignment="3" expression="'En '+UPPER( f_buscar_dato_membrete('ciudad'))+ ' a '+string(day(  sol_ultima_voluntad_fecha_creacion  ),'00')+' de '+case( month( sol_ultima_voluntad_fecha_creacion ) when 1 then 'Enero' when 2 then 'Febrero' when 3 then 'Marzo' when 4 then 'Abril' when 5 then 'Mayo' when 6 then 'Junio' when 7 then 'Julio' when 8 then 'Agosto' when 9 then 'Septiembre' when 10 then 'Octubre' when 11 then 'Noviembre' when 12 then 'Diciembre')+' de '+string(year(  sol_ultima_voluntad_fecha_creacion ),'0000')+', por el presente instrumento yo, '+  sol_ultima_voluntad_nombre_titular +' '+  sol_ultima_voluntad_ap_pat_titular +' '+  sol_ultima_voluntad_ap_mat_titular +', Cédula de Indentidad  '+ string(  sol_ultima_voluntad_rut_titular  ,'###,###,###,###')+'-'+ sol_ultima_voluntad_dv_titular +', domiciliado en '+ tipo_via_descripcion +' '+ sol_ultima_voluntad_direccion_p +' Nº: '+ sol_ultima_voluntad_nro_p +if ( sol_ultima_voluntad_depto_p <>'' and  sol_ultima_voluntad_depto_p <>'-' and not isnull( sol_ultima_voluntad_depto_p ),' Depto.: '+ sol_ultima_voluntad_depto_p ,'')+if (   sol_ultima_voluntad_block_p <>'' and   sol_ultima_voluntad_block_p <>'-' and not isnull(   sol_ultima_voluntad_block_p ),' Block: '+   sol_ultima_voluntad_block_p ,'')+', en mi calidad de propietario '+if ( sol_ultima_voluntad_base ='C','Contrato Nº ','Promesa Nº ')+ sol_ultima_voluntad_base +'-'+ sol_ultima_voluntad_serie +'-'+string( sol_ultima_voluntad_numero ,~"###,###,###,###~")+' con fecha '+string( sol_ultima_voluntad_fecha_contrato ,'dd/mm/yyyy')+', la Sepultura Nº '+ sol_ultima_voluntad_sepultura +', Sector '+ sol_ultima_voluntad_sector +', Zona '+ sol_ultima_voluntad_area +' con '+ sol_ultima_voluntad_capacidad + ' Capacidad(es) ' + ', '+ sol_ultima_voluntad_n_reduccion +' reduccion(es), ubicada en el Parque '+UPPER( f_buscar_dato_membrete('parque'))+', comuna de '+UPPER( f_buscar_dato_membrete('comuna'))+', autorizo al citado Parque Cementerio:'"border="0" 