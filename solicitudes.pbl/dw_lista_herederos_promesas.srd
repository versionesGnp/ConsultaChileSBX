 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"sol_cliente~" )  TABLE(NAME=~"sol_coprop~" ) COLUMN(NAME=~"sol_coprop.rut~") COLUMN(NAME=~"sol_coprop.dv~") COLUMN(NAME=~"sol_coprop.nombres~") COLUMN(NAME=~"sol_coprop.ap_paterno~") COLUMN(NAME=~"sol_coprop.ap_materno~") COLUMN(NAME=~"sol_coprop.base~") COLUMN(NAME=~"sol_coprop.serie~") COLUMN(NAME=~"sol_coprop.numero~") COLUMN(NAME=~"sol_coprop.rut_cliente~") COLUMN(NAME=~"sol_coprop.dv_cliente~") COLUMN(NAME=~"sol_coprop.rut_cliente_tran~") COLUMN(NAME=~"sol_coprop.estado_a_n~") COLUMN(NAME=~"sol_coprop.fecha_sistema~")    JOIN (LEFT=~"sol_coprop.base~"    OP =~"=~"RIGHT=~"sol_cliente.base~" )    JOIN (LEFT=~"sol_coprop.serie~"    OP =~"=~"RIGHT=~"sol_cliente.serie~" )    JOIN (LEFT=~"sol_coprop.numero~"    OP =~"=~"RIGHT=~"sol_cliente.numero~" )    JOIN (LEFT=~"sol_coprop.rut_cliente~"    OP =~"=~"RIGHT=~"sol_cliente.rut_cliente_ori~" )WHERE(    EXP1 =~"~~~"SOL_COPROP~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_COPROP~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_COPROP~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_COPROP~~~".~~~"ESTADO_A_N~~~"~"   OP =~"=~"    EXP2 =~"'N'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_CLIENTE~~~".~~~"CORRELATIVO~~~"~"   OP =~"=~"    EXP2 =~"(SELECT MAX(~~~"SOL_CLIENTE~~~".~~~"CORRELATIVO~~~") FROM ~~~"SOL_CLIENTE~~~", ~~~"SOL_COPROP~~~" WHERE ( ~~~"SOL_CLIENTE~~~".~~~"BASE~~~" = ~~~"SOL_COPROP~~~".~~~"BASE~~~" ) and ( ~~~"SOL_CLIENTE~~~".~~~"SERIE~~~" = ~~~"SOL_COPROP~~~".~~~"SERIE~~~" ) and ( ~~~"SOL_CLIENTE~~~".~~~"NUMERO~~~" = ~~~"SOL_COPROP~~~".~~~"NUMERO~~~" ) and ( ~~~"SOL_CLIENTE~~~".~~~"RUT_CLIENTE_ORI~~~" = ~~~"SOL_COPROP~~~".~~~"RUT_CLIENTE~~~" ) and ( ( ~~~"SOL_CLIENTE~~~".~~~"BASE~~~" = :base ) AND ( ~~~"SOL_CLIENTE~~~".~~~"SERIE~~~" = :serie ) AND ( ~~~"SOL_CLIENTE~~~".~~~"NUMERO~~~" = :numero ) AND ( ~~~"SOL_COPROP~~~".~~~"ESTADO_A_N~~~" = 'N' ) ) )~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number) " arguments=(("base", string),("serie", string),("numero", number)) )
