global type f_valida_menu_fallecidos from function_object
end type

forward prototypes
global subroutine f_valida_menu_fallecidos (string ls_tipo, string ls_objeto)
end prototypes

global subroutine f_valida_menu_fallecidos (string ls_tipo, string ls_objeto);CHOOSE CASE ls_tipo
	CASE 'menu'
