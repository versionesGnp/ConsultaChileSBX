			CASE 'm_menu_principal.m_fallecidos0.m_fosacomun.m_informes14'
				m_menu_principal.m_fallecidos0.m_fosacomun.m_informes14.visible								= false

			CASE 'm_menu_principal.m_fallecidos0.m_fichaimplementación'
