				m_menu_principal.m_admventa.m_comisiónfuneraria.m_informes15.m_detallepagos.visible				= false
			CASE 'm_menu_principal.m_admventa.m_comisiónfuneraria.m_informes15.m_detallepagos'
				m_menu_principal.m_admventa.m_comisiónfuneraria.m_informes15.m_detallepagos.visible				= false
		END CHOOSE
//				CASE 'objeto' //no tiene
END CHOOSE
end subroutine

