global type f_valida_objeto_1 from function_object
end type

forward prototypes
global subroutine f_valida_objeto_1 ()
end prototypes

global subroutine f_valida_objeto_1 ();string	ls_objeto,ls_tipo
DECLARE	x1 CURSOR FOR  
SELECT 	"PERFIL_OBJETO"."NOMBRE",   
			"PERFIL_OBJETO"."TIPO"  
FROM 		"PERFIL_OBJETO",   
			"PERFIL_USUARIO"  
WHERE  ( "PERFIL_OBJETO"."CORRELARIVO" = "PERFIL_USUARIO"."CORRELATIVO_OBJETO" ) and  
	  	(( "PERFIL_OBJETO"."VENTANA" = :gs_ventana ) AND  
		 ( "PERFIL_USUARIO"."USUARIO" = :gs_user ) AND 
		 ( "PERFIL_OBJETO"."APLICACION" = 1))   
USING		sqlca;
open x1;
if sqlca.sqlcode=0 then
	DO WHILE sqlca.sqlcode=0
		fetch x1 into :ls_objeto,:ls_tipo;
		if not isnull(ls_objeto) then
			If gs_ventana='w_principal' then
				f_valida_menu(ls_tipo,ls_objeto)
			end if
			If gs_ventana='w_actuliza_pagos_contrato_isa' then
				CHOOSE CASE ls_tipo
					CASE 'objeto'
						CHOOSE CASE ls_objeto
							CASE 'cb_2'
								w_actuliza_pagos_contrato_isa.cb_2.enabled				= false
						END CHOOSE
				END CHOOSE
			end if
			If gs_ventana='w_cobranza_historica' then
				CHOOSE CASE ls_tipo
					CASE 'objeto'
						CHOOSE CASE ls_objeto
							CASE 'cb_estado'
								w_cobranza_historica.tab_1.tabpage_2.cb_estado.enabled				= false
							CASE 'cb_1'
								w_cobranza_historica.cb_1.enabled				= false
						END CHOOSE
				END CHOOSE
			end if
			If gs_ventana='w_cuenta_corriente_contrato_isa' then
				CHOOSE CASE ls_tipo
					CASE 'objeto'
						CHOOSE CASE ls_objeto
							CASE 'cb_5'
								w_cuenta_corriente_contrato_isa.cb_5.enabled				= false
								m_menu_cuenta_corriente_isacruz.m_mantenedor.m_cobranza.enabled		= false
							CASE 'cb_7'
								w_cuenta_corriente_contrato_isa.cb_7.enabled				= false
								m_menu_cuenta_corriente_isacruz.m_mantenedor.m_cuotascrédito.enabled	= false
							CASE 'cb_2'
								w_cuenta_corriente_contrato_isa.cb_2.enabled				= false
								m_menu_cuenta_corriente_isacruz.m_consultar.m_cuotascrédito0.enabled	= false
							CASE 'cb_1'
								w_cuenta_corriente_contrato_isa.cb_1.enabled				= false
								m_menu_cuenta_corriente_isacruz.m_consultar.m_pagosengeneral.enabled	= false
							CASE 'cb_imprimir'
								w_cuenta_corriente_contrato_isa.cb_imprimir.enabled	= false
								m_menu_cuenta_corriente_isacruz.m_imprimir0.enabled						= false
							CASE 'cb_operacion'
								w_cuenta_corriente_contrato_isa.cb_operacion.enabled	= false
								m_menu_cuenta_corriente_isacruz.m_mantenedor.m_operaciones.enabled	= false
							CASE 'cb_3'
								w_cuenta_corriente_contrato_isa.cb_3.enabled				= false
						END CHOOSE
				END CHOOSE
			end if
			If gs_ventana='w_cuenta_corriente_derecho' then
				CHOOSE CASE ls_tipo
					CASE 'objeto'
						CHOOSE CASE ls_objeto
							CASE 'cb_5'
								w_cuenta_corriente_derecho.cb_5.enabled				= false
								m_menu_cuenta_corriente_derecho.m_mantenedor.m_cobranza.enabled		= false
							CASE 'cb_6'
								w_cuenta_corriente_derecho.cb_6.enabled				= false
								m_menu_cuenta_corriente_derecho.m_mantenedor.m_1.enabled					= false
							CASE 'cb_2'
								w_cuenta_corriente_derecho.cb_2.enabled				= false
								m_menu_cuenta_corriente_derecho.m_consultar.m_cuotascrédito0.enabled	= false
							CASE 'cb_1'
								w_cuenta_corriente_derecho.cb_1.enabled				= false
								m_menu_cuenta_corriente_derecho.m_consultar.m_pagosengeneral.enabled	= false
							CASE 'cb_imprimir'
								w_cuenta_corriente_derecho.cb_imprimir.enabled		= false
								m_menu_cuenta_corriente_derecho.m_imprimir0.enabled						= false
							CASE 'cb_operaciones'
								w_cuenta_corriente_derecho.cb_operaciones.enabled	= false
								m_menu_cuenta_corriente_derecho.m_mantenedor.m_operaciones.enabled	= false
						END CHOOSE
				END CHOOSE
			end if
			If gs_ventana='w_cuenta_corriente_liberador' then
				CHOOSE CASE ls_tipo
					CASE 'objeto'
						CHOOSE CASE ls_objeto
							CASE 'cb_5'
								w_cuenta_corriente_liberador.cb_5.enabled					= false
								m_menu_cuenta_corriente_liberador.m_mantenedor.m_cobranza.enabled					= false
							CASE 'cb_1'
								w_cuenta_corriente_liberador.cb_1.enabled					= false
								m_menu_cuenta_corriente_liberador.m_consultar.m_pagosengeneral.enabled			= false
							CASE 'cb_2'
								w_cuenta_corriente_liberador.cb_2.enabled					= false
								m_menu_cuenta_corriente_liberador.m_consultar.m_cuotascrédito0.enabled			= false
							CASE 'cb_imprimir'
								w_cuenta_corriente_liberador.cb_imprimir.enabled		= false
								m_menu_cuenta_corriente_liberador.m_imprimir0.enabled									= false
							CASE 'cb_agente'
								w_cuenta_corriente_liberador.cb_agente.enabled			= false
								m_menu_cuenta_corriente_liberador.m_consultar.m_pagoscomisiónagente.enabled	= false
							CASE 'cb_operaciones'
								w_cuenta_corriente_liberador.cb_operaciones.enabled	= false
								m_menu_cuenta_corriente_liberador.m_mantenedor.m_operaciones.enabled				= false
							CASE 'cb_rescomi_vta'
								w_cuenta_corriente_liberador.cb_rescomi_vta.enabled	= false
								m_menu_cuenta_corriente_liberador.m_consultar.m_pagosventas.enabled				= false
						END CHOOSE
				END CHOOSE
			end if
			If gs_ventana='w_cuenta_corriente_oferta' then
				CHOOSE CASE ls_tipo
					CASE 'objeto'
						CHOOSE CASE ls_objeto
							CASE 'cb_4'
								w_cuenta_corriente_oferta.cb_4.enabled						= false
								m_menu_cuenta_corriente_promesa.m_consultar.m_pagaré.enabled				= false
							CASE 'cb_2'	
								w_cuenta_corriente_oferta.cb_2.enabled						= false
								m_menu_cuenta_corriente_promesa.m_consultar.m_pagosengeneral.enabled		= false
							CASE 'cb_3'
								w_cuenta_corriente_oferta.cb_3.enabled						= false
								m_menu_cuenta_corriente_promesa.m_consultar.m_cuotascrédito0.enabled		= false
							CASE 'cb_1'
								w_cuenta_corriente_oferta.cb_1.enabled						= false
								m_menu_cuenta_corriente_promesa.m_consultar.m_cuotasmantención0.enabled	= false
							CASE 'cb_imprimir'
								w_cuenta_corriente_oferta.cb_imprimir.enabled			= false
								m_menu_cuenta_corriente_promesa.m_imprimir0.enabled							= false
							CASE 'cb_6'
								w_cuenta_corriente_oferta.cb_6.enabled						= false
								m_menu_cuenta_corriente_promesa.m_mantenedor.m_cuotascrédito.enabled		= false
							CASE 'cb_7'
								w_cuenta_corriente_oferta.cb_7.enabled						= false
								m_menu_cuenta_corriente_promesa.m_mantenedor.m_cuotasmantención.enabled	= false
							CASE 'cb_5'
								w_cuenta_corriente_oferta.cb_5.enabled						= false
								m_menu_cuenta_corriente_promesa.m_mantenedor.m_cobranza.enabled			= false
							CASE 'cb_8'
								w_cuenta_corriente_oferta.cb_8.enabled						= false
								m_menu_cuenta_corriente_promesa.m_consultar.m_aval.enabled					= false
							CASE 'cb_9'
								w_cuenta_corriente_oferta.cb_9.enabled						= false
								m_menu_cuenta_corriente_promesa.m_consultar.m_funeraria.enabled			= false
							CASE 'cb_10'
								w_cuenta_corriente_oferta.cb_10.enabled					= false
								m_menu_cuenta_corriente_promesa.m_consultar.m_institución.enabled			= false
							CASE 'cb_agente'
								w_cuenta_corriente_oferta.cb_agente.enabled				= false
								m_menu_cuenta_corriente_promesa.m_consultar.m_pagoscomisiónagente.enabled	= false
							CASE 'cb_operaciones'
								w_cuenta_corriente_oferta.cb_operaciones.enabled		= false
								m_menu_cuenta_corriente_promesa.m_mantenedor.m_operaciones.enabled		= false
							CASE 'cb_rescomi_vta'
								w_cuenta_corriente_oferta.cb_rescomi_vta.enabled		= false
								m_menu_cuenta_corriente_promesa.m_consultar.m_pagosventas.enabled			= false
							CASE 'cb_derecho_especial'
								w_cuenta_corriente_oferta.cb_derecho_especial.enabled	= false
								m_menu_cuenta_corriente_promesa.m_mantenedor.m_derechoespecial.enabled	= false
						END CHOOSE
				END CHOOSE
			end if
			If gs_ventana='w_cuenta_corriente_pagare' then
				CHOOSE CASE ls_tipo
					CASE 'objeto'
						CHOOSE CASE ls_objeto
							CASE 'cb_5'
								w_cuenta_corriente_pagare.cb_5.enabled					= false
								m_menu_cuenta_corriente_pagare.m_mantenedor.m_cobranza.enabled			= false
							CASE 'cb_6'
								w_cuenta_corriente_pagare.cb_6.enabled					= false
								m_menu_cuenta_corriente_pagare.m_mantenedor.m_1.enabled					= false
							CASE 'cb_1'
								w_cuenta_corriente_pagare.cb_1.enabled					= false
								m_menu_cuenta_corriente_pagare.m_consultar.m_pagosengeneral.enabled	= false
							CASE 'cb_2'
								w_cuenta_corriente_pagare.cb_2.enabled					= false
								m_menu_cuenta_corriente_pagare.m_consultar.m_cuotascrédito0.enabled	= false
							CASE 'cb_imprimir'
								w_cuenta_corriente_pagare.cb_imprimir.enabled		= false
								m_menu_cuenta_corriente_pagare.m_imprimir0.enabled							= false
							CASE 'cb_operaciones'
								w_cuenta_corriente_pagare.cb_operaciones.enabled	= false
								m_menu_cuenta_corriente_pagare.m_mantenedor.m_operaciones.enabled		= false
						END CHOOSE
				END CHOOSE
			end if
			If gs_ventana='w_cuenta_corriente_repactar_cta_mant' then
				CHOOSE CASE ls_tipo
					CASE 'objeto'
						CHOOSE CASE ls_objeto
							CASE 'cb_5'
								w_cuenta_corriente_repactar_cta_mant.cb_5.enabled				= false
								m_menu_cuenta_corriente_reprog_mant.m_mantenedor.m_cobranza.enabled			= false
							CASE 'cb_2'
								w_cuenta_corriente_repactar_cta_mant.cb_2.enabled				= false
								m_menu_cuenta_corriente_reprog_mant.m_consultar.m_cuotascrédito0.enabled	= false
							CASE 'cb_1'
								w_cuenta_corriente_repactar_cta_mant.cb_1.enabled				= false
								m_menu_cuenta_corriente_reprog_mant.m_consultar.m_pagosengeneral.enabled	= false
							CASE 'cb_6'
								w_cuenta_corriente_repactar_cta_mant.cb_6.enabled				= false
								m_menu_cuenta_corriente_reprog_mant.m_mantenedor.m_1.enabled					= false
							CASE 'cb_operaciones'
								w_cuenta_corriente_repactar_cta_mant.cb_operaciones.enabled	= false
								m_menu_cuenta_corriente_reprog_mant.m_mantenedor.m_operaciones.enabled		= false
							CASE 'cb_imprimir'
								w_cuenta_corriente_repactar_cta_mant.cb_imprimir.enabled		= false
								m_menu_cuenta_corriente_reprog_mant.m_imprimir0.enabled							= false
							CASE 'cb_3'
								w_cuenta_corriente_repactar_cta_mant.cb_3.enabled				= false
						END CHOOSE
				END CHOOSE
			end if
			If gs_ventana='w_impresion_previa_de_ctta_ctes' then
				CHOOSE CASE ls_tipo
					CASE 'objeto'
						CHOOSE CASE ls_objeto
							CASE 'cb_imprimir'
								w_impresion_previa_de_ctta_ctes.cb_imprimir.enabled	= false
						END CHOOSE
				END CHOOSE
			end if
			If gs_ventana='w_listado_contratos_por_todas_las_tablas' then
				CHOOSE CASE ls_tipo
					CASE 'objeto'
						CHOOSE CASE ls_objeto
							CASE 'cb_ver_cuenta_corriente'
								w_listado_contratos_por_todas_las_tablas.cb_ver_cuenta_corriente.enabled	= false
							CASE 'cb_datos_contrato'
								w_listado_contratos_por_todas_las_tablas.cb_datos_contrato.enabled			= false
							CASE 'cb_datos_repacta'
								w_listado_contratos_por_todas_las_tablas.cb_datos_repacta.enabled				= false
							CASE 'cb_datos_clientes'
								w_listado_contratos_por_todas_las_tablas.cb_datos_clientes.enabled			= false
							CASE 'cb_beneficiarios'
								w_listado_contratos_por_todas_las_tablas.cb_beneficiarios.enabled				= false
							CASE 'cb_5'
								w_listado_contratos_por_todas_las_tablas.cb_5.enabled								= false
							CASE 'cb_6'
								w_listado_contratos_por_todas_las_tablas.cb_6.enabled								= false
							CASE 'cb_7'
								w_listado_contratos_por_todas_las_tablas.cb_7.enabled								= false
							CASE 'cb_fallecidos'
								w_listado_contratos_por_todas_las_tablas.cb_fallecidos.enabled					= false
							CASE 'cb_mensajes'
								w_listado_contratos_por_todas_las_tablas.cb_mensajes.enabled					= false
							CASE 'cb_1'
								w_listado_contratos_por_todas_las_tablas.cb_1.enabled								= false
							CASE 'cb_3'
								w_listado_contratos_por_todas_las_tablas.cb_3.enabled								= false
							CASE 'cb_2'
								w_listado_contratos_por_todas_las_tablas.cb_2.enabled								= false
							CASE 'cb_imprimir'
								w_listado_contratos_por_todas_las_tablas.cb_imprimir.enabled					= false
						END CHOOSE
				END CHOOSE
			end if
			If gs_ventana='w_listado_contratos_rut' then
				CHOOSE CASE ls_tipo
					CASE 'objeto'
						CHOOSE CASE ls_objeto
							CASE 'cb_ver_cuenta_corriente'
								w_listado_contratos_rut.cb_ver_cuenta_corriente.enabled	= false
							CASE 'cb_datos_contrato'
								w_listado_contratos_rut.cb_datos_contrato.enabled			= false
							CASE 'cb_datos_repacta'
								w_listado_contratos_rut.cb_datos_repacta.enabled			= false
							CASE 'cb_datos_clientes'
								w_listado_contratos_rut.cb_datos_clientes.enabled			= false
							CASE 'cb_beneficiarios'
								w_listado_contratos_rut.cb_beneficiarios.enabled			= false
							CASE 'cb_fallecidos'
								w_listado_contratos_rut.cb_fallecidos.enabled				= false
							CASE 'cb_mensajes'
								w_listado_contratos_rut.cb_mensajes.enabled					= false
							CASE 'cb_5'
								w_listado_contratos_rut.cb_5.enabled							= false
							CASE 'cb_6'
								w_listado_contratos_rut.cb_6.enabled							= false
							CASE 'cb_7'
								w_listado_contratos_rut.cb_7.enabled							= false
							CASE 'cb_1'
								w_listado_contratos_rut.cb_1.enabled							= false
							CASE 'cb_3'
								w_listado_contratos_rut.cb_3.enabled							= false
							CASE 'cb_2'
								w_listado_contratos_rut.cb_2.enabled							= false
						END CHOOSE
				END CHOOSE
			end if
			If gs_ventana='w_rescomi_por_vta' then
				CHOOSE CASE ls_tipo
					CASE 'objeto'
						CHOOSE CASE ls_objeto
							CASE 'cb_2'
								w_rescomi_por_vta.cb_2.enabled	= false
						END CHOOSE
				END CHOOSE
			end if
			If gs_ventana='w_ver_cheques' then
				CHOOSE CASE ls_tipo
					CASE 'objeto'
						CHOOSE CASE ls_objeto
							CASE 'cb_2'
								w_ver_cheques.cb_2.enabled			= false
						END CHOOSE
				END CHOOSE
			end if
			If gs_ventana='w_detalle_ventas' then
				CHOOSE CASE ls_tipo
					CASE 'objeto'
						CHOOSE CASE ls_objeto
							CASE 'pb_exportar'
								w_detalle_ventas.pb_exportar.enabled	= false
							CASE 'pb_imprimir'
								w_detalle_ventas.pb_imprimir.enabled	= false
							CASE 'pb_ordenar'
								w_detalle_ventas.pb_ordenar.enabled		= false
							CASE 'pb_filtrar'
								w_detalle_ventas.pb_filtrar.enabled		= false
						END CHOOSE
				END CHOOSE
			end if
			If gs_ventana='w_informe_estado_cartera' then
				CHOOSE CASE ls_tipo
					CASE 'objeto'
						CHOOSE CASE ls_objeto
							CASE 'pb_buscar'
								w_informe_estado_cartera.pb_buscar.enabled			= false
							CASE 'pb_aceptar'
								w_informe_estado_cartera.pb_aceptar.enabled			= false
							CASE 'pb_exportar'
								w_informe_estado_cartera.pb_exportar.enabled			= false
							CASE 'pb_imprimir'
								w_informe_estado_cartera.pb_imprimir.enabled			= false
							CASE 'pb_licencias'
								w_informe_estado_cartera.pb_licencias.enabled		= false
							CASE 'pb_general'
								w_informe_estado_cartera.pb_general.enabled			= false
							CASE 'pb_remuneracion'
								w_informe_estado_cartera.pb_remuneracion.enabled	= false
							CASE 'pb_ordenar'
								w_informe_estado_cartera.pb_ordenar.enabled			= false
							CASE 'pb_filtrar'
								w_informe_estado_cartera.pb_filtrar.enabled			= false
						END CHOOSE
				END CHOOSE
			end if
			If gs_ventana='w_detalle_totales_hist' then
				CHOOSE CASE ls_tipo
					CASE 'objeto'
						CHOOSE CASE ls_objeto
							CASE 'cb_filtrar'
								w_detalle_totales_hist.cb_filtrar.enabled		= false
							CASE 'cb_2'
								w_detalle_totales_hist.cb_2.enabled				= false
							CASE 'cb_3'
								w_detalle_totales_hist.cb_3.enabled				= false
							CASE 'cb_consulta'
								w_detalle_totales_hist.cb_consulta.enabled	= false
							CASE 'cb_4'
								w_detalle_totales_hist.cb_4.enabled				= false
						END CHOOSE
				END CHOOSE
			end if
			If gs_ventana='w_inf_gestion_hist' then
				CHOOSE CASE ls_tipo
					CASE 'objeto'
						CHOOSE CASE ls_objeto
							CASE 'pb_buscar'
								w_inf_gestion_hist.pb_buscar.enabled			= false
							CASE 'pb_aceptar'
								w_inf_gestion_hist.pb_aceptar.enabled			= false
							CASE 'pb_exportar'
								w_inf_gestion_hist.pb_exportar.enabled			= false
							CASE 'pb_imprimir'
								w_inf_gestion_hist.pb_imprimir.enabled			= false
							CASE 'pb_licencias'
								w_inf_gestion_hist.pb_licencias.enabled		= false
							CASE 'pb_ordenar'
								w_inf_gestion_hist.pb_ordenar.enabled			= false
						END CHOOSE
				END CHOOSE
			end if
			If gs_ventana='w_muestra_detalle_cuota_hist' then
				CHOOSE CASE ls_tipo
					CASE 'objeto'
						CHOOSE CASE ls_objeto
							CASE 'cb_filtrar'
								w_muestra_detalle_cuota_hist.cb_filtrar.enabled		= false
							CASE 'cb_2'
								w_muestra_detalle_cuota_hist.cb_2.enabled				= false
							CASE 'cb_3'
								w_muestra_detalle_cuota_hist.cb_3.enabled				= false
							CASE 'cb_consulta'
								w_muestra_detalle_cuota_hist.cb_consulta.enabled	= false
							CASE 'cb_4'
								w_muestra_detalle_cuota_hist.cb_4.enabled				= false
						END CHOOSE
				END CHOOSE
			end if
			If gs_ventana='w_muestra_detalle_gestion_agente_hist' then
				CHOOSE CASE ls_tipo
					CASE 'objeto'
						CHOOSE CASE ls_objeto
							CASE 'cb_imprimir'
								w_muestra_detalle_gestion_agente_hist.cb_imprimir.enabled	= false
							CASE 'cb_exportar'
								w_muestra_detalle_gestion_agente_hist.cb_exportar.enabled	= false
							CASE 'cb_sort'
								w_muestra_detalle_gestion_agente_hist.cb_sort.enabled			= false
						END CHOOSE
				END CHOOSE
			end if
			If gs_ventana='w_muestra_detalle_gestion_hist' then
				CHOOSE CASE ls_tipo
					CASE 'objeto'
						CHOOSE CASE ls_objeto
							CASE 'cb_imprimir'
								w_muestra_detalle_gestion_hist.cb_imprimir.enabled	= false
