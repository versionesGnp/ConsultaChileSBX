global type f_valida_menu_planimetria from function_object
end type

forward prototypes
global subroutine f_valida_menu_planimetria (string ls_tipo, string ls_objeto)
end prototypes

global subroutine f_valida_menu_planimetria (string ls_tipo, string ls_objeto);CHOOSE CASE ls_tipo
	CASE 'menu'
		CHOOSE CASE ls_objeto
			CASE 'm_menu_principal.m_planimetria'
				m_menu_principal.m_planimetria.visible															= false
				m_menu_principal.m_planimetria.m_planoparque.visible										= false
			CASE 'm_menu_principal.m_planimetria.m_planoparque'
				m_menu_principal.m_planimetria.m_planoparque.visible										= false
		END CHOOSE
//				CASE 'objeto' //no tiene
END CHOOSE
end subroutine

