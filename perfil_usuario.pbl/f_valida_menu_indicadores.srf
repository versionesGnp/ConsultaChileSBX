global type f_valida_menu_indicadores from function_object
end type

forward prototypes
global subroutine f_valida_menu_indicadores (string ls_tipo, string ls_objeto)
end prototypes

global subroutine f_valida_menu_indicadores (string ls_tipo, string ls_objeto);CHOOSE CASE ls_tipo
	CASE 'menu'
		CHOOSE CASE ls_objeto
			CASE 'm_menu_principal.m_indicadores'
				m_menu_principal.m_indicadores.visible															= false
		END CHOOSE
//				CASE 'objeto' //no tiene
END CHOOSE
end subroutine

