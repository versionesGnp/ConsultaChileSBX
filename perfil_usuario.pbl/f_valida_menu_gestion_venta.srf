			CASE 'm_menu_principal.m_gestionventa.m_estadocartera.m_38'
				m_menu_principal.m_gestionventa.m_estadocartera.m_38.visible							= false
			CASE 'm_menu_principal.m_gestionventa.m_estadocartera.m_39'
				m_menu_principal.m_gestionventa.m_estadocartera.m_39.visible							= false
			CASE 'm_menu_principal.m_gestionventa.m_promesasperiodo'
				m_menu_principal.m_gestionventa.m_promesasperiodo.visible								= false
				m_menu_principal.m_gestionventa.m_promesasperiodo.m_calculoperiodo.visible			= false
				m_menu_principal.m_gestionventa.m_promesasperiodo.m_calculoperiodocontratosbaseola.visible	= false
				m_menu_principal.m_gestionventa.m_promesasperiodo.m_clasificaciónhistóricasupervisor.visible	= false
			CASE 'm_menu_principal.m_gestionventa.m_promesasperiodo.m_calculoperiodo'
				m_menu_principal.m_gestionventa.m_promesasperiodo.m_calculoperiodo.visible			= false
			CASE 'm_menu_principal.m_gestionventa.m_promesasperiodo.m_calculoperiodocontratosbaseola'
				m_menu_principal.m_gestionventa.m_promesasperiodo.m_calculoperiodocontratosbaseola.visible	= false
			CASE 'm_menu_principal.m_gestionventa.m_promesasperiodo.m_clasificaciónhistóricasupervisor'
				m_menu_principal.m_gestionventa.m_promesasperiodo.m_clasificaciónhistóricasupervisor.visible	= false
			CASE 'm_menu_principal.m_gestionventa.m_moraagente'
				m_menu_principal.m_gestionventa.m_moraagente.visible										= false
		END CHOOSE
//				CASE 'objeto' //no tiene
END CHOOSE
end subroutine

