				m_menu_principal.m_terreno.m_informes3.m_cuadroestadítico.m_gestiónvisitaterreno.visible				= false
			CASE 'm_menu_principal.m_terreno.m_informes3.m_cuadroestadítico.m_gestióntelefónica'
				m_menu_principal.m_terreno.m_informes3.m_cuadroestadítico.m_gestióntelefónica.visible					= false
			CASE 'm_menu_principal.m_terreno.m_informes3.m_cuadroestadítico.m_gestiónvisitaterreno'
				m_menu_principal.m_terreno.m_informes3.m_cuadroestadítico.m_gestiónvisitaterreno.visible				= false
			CASE 'm_menu_principal.m_terreno.m_informes3.m_gestiónporejecutivo'
