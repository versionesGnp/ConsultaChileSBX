global type f_valida_menu_visita_terreno from function_object
end type

forward prototypes
global subroutine f_valida_menu_visita_terreno (string ls_tipo, string ls_objeto)
end prototypes

global subroutine f_valida_menu_visita_terreno (string ls_tipo, string ls_objeto);CHOOSE CASE ls_tipo
	CASE 'menu'
		CHOOSE CASE ls_objeto
			CASE 'm_menu_principal.m_terreno'
				m_menu_principal.m_terreno.visible																						= false
