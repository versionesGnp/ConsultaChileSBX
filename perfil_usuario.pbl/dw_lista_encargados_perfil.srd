 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"encargados~" ) COLUMN(NAME=~"encargados.codigo_usuario~") COLUMN(NAME=~"encargados.password~") COLUMN(NAME=~"encargados.nombre~") COLUMN(NAME=~"encargados.acceso~") COLUMN(NAME=~"encargados.depto~") COLUMN(NAME=~"encargados.company~") COLUMN(NAME=~"encargados.fecha_termino~") COLUMN(NAME=~"encargados.opera~") COLUMN(NAME=~"encargados.cons_general~") COLUMN(NAME=~"encargados.solicitudes~") COLUMN(NAME=~"encargados.digitacion~") COLUMN(NAME=~"encargados.fecha_ingreso~") COLUMN(NAME=~"encargados.fecha_expiracion~") COLUMN(NAME=~"encargados.estado~")WHERE(    EXP1 =~"~~~"ENCARGADOS~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'A'~" ) ) " update="ENCARGADOS" updatewhere=0 updatekeyinplace=yes  sort="nombre A " )
