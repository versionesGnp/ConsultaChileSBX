 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"fallecidos~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"cliente~" ) COLUMN(NAME=~"fallecidos.rut~") COLUMN(NAME=~"fallecidos.dv~") COLUMN(NAME=~"fallecidos.nombres~") COLUMN(NAME=~"fallecidos.ap_paterno~") COLUMN(NAME=~"fallecidos.ap_materno~") COLUMN(NAME=~"fallecidos.fec_nac~") COLUMN(NAME=~"fallecidos.fec_fall~")    JOIN (LEFT=~"cadena.rut~"    OP =~"=~"RIGHT=~"cliente.rut~" )    JOIN (LEFT=~"fallecidos.base~"    OP =~"=~"RIGHT=~"cadena.codigo~" )    JOIN (LEFT=~"fallecidos.ss~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"fallecidos.contrato~"    OP =~"=~"RIGHT=~"cadena.numero~" )WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"RUT~~~"~"   OP =~"=~"    EXP2 =~":rut_titular~" ) ) ARG(NAME = ~"rut_titular~" TYPE = number) " arguments=(("rut_titular", number))  sort="fallecidos_rut A " )
