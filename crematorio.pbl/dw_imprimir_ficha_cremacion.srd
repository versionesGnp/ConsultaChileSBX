 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"fc_cabecera~" )  TABLE(NAME=~"fc_fallecido~" )  TABLE(NAME=~"fc_titular~" )  TABLE(NAME=~"estado_cuerpo~" )  TABLE(NAME=~"funeraria~" )  TABLE(NAME=~"fc_responsable_retiro~" )  TABLE(NAME=~"fc_ceremonia~" )  TABLE(NAME=~"fc_destino_cuerpo~" )  TABLE(NAME=~"cliente~" )  TABLE(NAME=~"fc_arancel~" )  TABLE(NAME=~"fc_carta_declaracion_marcapaso~" )  TABLE(NAME=~"fc_responsable_parque~" )  TABLE(NAME=~"fc_ficha_traslado~" ) COLUMN(NAME=~"fc_cabecera.base~") COLUMN(NAME=~"fc_cabecera.serie~") COLUMN(NAME=~"fc_cabecera.numero~") COLUMN(NAME=~"fc_cabecera.rut_titular~") COLUMN(NAME=~"fc_titular.dv_titular~") COLUMN(NAME=~"fc_titular.nombres~") COLUMN(NAME=~"fc_titular.apellido_paterno~") COLUMN(NAME=~"fc_titular.apellido_materno~") COLUMN(NAME=~"fc_fallecido.rut_fallecido~") COLUMN(NAME=~"fc_fallecido.dv_fallecido~") COLUMN(NAME=~"fc_fallecido.nombres~") COLUMN(NAME=~"fc_fallecido.apellido_paterno~") COLUMN(NAME=~"fc_fallecido.apellido_materno~") COLUMN(NAME=~"fc_fallecido.fecha_defuncion~") COLUMN(NAME=~"fc_fallecido.causa_fallecimiento~") COLUMN(NAME=~"fc_fallecido.fecha_nacimiento~") COLUMN(NAME=~"estado_cuerpo.cuerpo~") COLUMN(NAME=~"fc_fallecido.tamano_cuerpo~") COLUMN(NAME=~"fc_cabecera.fecha_sistema~") COLUMN(NAME=~"fc_titular.celular~") COLUMN(NAME=~"fc_cabecera.folio_crematorio~") COLUMN(NAME=~"fc_fallecido.sexo~") COLUMN(NAME=~"fc_fallecido.enfermedad_obligatoria~") COLUMN(NAME=~"fc_titular.email~") COLUMN(NAME=~"funeraria.nombre~") COLUMN(NAME=~"funeraria.fono~") COLUMN(NAME=~"fc_cabecera.fecha_cineracion~") COLUMN(NAME=~"fc_cabecera.hora_cineracion~") COLUMN(NAME=~"fc_cabecera.minuto_cineracion~") COLUMN(NAME=~"fc_responsable_retiro.fecha_retiro_ceniza~") COLUMN(NAME=~"fc_responsable_retiro.hora_retiro_ceniza~") COLUMN(NAME=~"fc_responsable_retiro.minuto_retiro_ceniza~") COLUMN(NAME=~"fc_responsable_retiro.visualizar_servicio~") COLUMN(NAME=~"fc_ceremonia.observacion~") COLUMN(NAME=~"fc_destino_cuerpo.descripcion~") COLUMN(NAME=~"fc_cabecera.fecha_ingreso_cinerario~") COLUMN(NAME=~"fc_cabecera.hora_ingreso_cinerario~") COLUMN(NAME=~"fc_cabecera.minuto_ingreso_cinerario~") COLUMN(NAME=~"cliente.direccion_p~") COLUMN(NAME=~"cliente.comuna~") COLUMN(NAME=~"cliente.ciudad~") COLUMN(NAME=~"cliente.numero_particular~") COLUMN(NAME=~"cliente.depto_particular~") COLUMN(NAME=~"cliente.block_particular~") COLUMN(NAME=~"fc_arancel.codigo_otro~") COLUMN(NAME=~"fc_cabecera.sw_covid_19~") COLUMN(NAME=~"fc_cabecera.sw_protocolo_covid~") COLUMN(NAME=~"fc_cabecera.fecha_crea~") COLUMN(NAME=~"fc_fallecido.cod_registro_pase~") COLUMN(NAME=~"fc_fallecido.registro_pase~") COLUMN(NAME=~"fc_ceremonia.sw_orador~") COLUMN(NAME=~"fc_carta_declaracion_marcapaso.sw_tiene_marcapaso~") COLUMN(NAME=~"fc_fallecido.observaciones~") COLUMN(NAME=~"fc_responsable_parque.nombre~") COLUMN(NAME=~"fc_responsable_parque.apellido_paterno~") COLUMN(NAME=~"fc_responsable_parque.apellido_materno~") COLUMN(NAME=~"fc_cabecera.usuario_crea~") COLUMN(NAME=~"fc_responsable_retiro.nro_resol_cremacion~") COLUMN(NAME=~"fc_cabecera.horno~") COLUMN(NAME=~"fc_fallecido.codigo_funeraria~") COLUMN(NAME=~"fc_fallecido.observacion_existencia~") COLUMN(NAME=~"fc_fallecido.sw_marcapaso~") COLUMN(NAME=~"fc_fallecido.hora_defuncion~") COLUMN(NAME=~"fc_fallecido.minuto_defuncion~") COLUMN(NAME=~"fc_fallecido.cantidad_hijos~") COLUMN(NAME=~"fc_fallecido.nacionalidad~") COLUMN(NAME=~"fc_fallecido.peso~") COLUMN(NAME=~"fc_fallecido.estado_civil~") COLUMN(NAME=~"fc_fallecido.existencia_elementos~") COLUMN(NAME=~"fc_responsable_retiro.uso_capilla~") COLUMN(NAME=~"fc_responsable_retiro.uso_pergola~") COLUMN(NAME=~"fc_cabecera.cod_parque_destino~")    JOIN (LEFT=~"cliente.rut~"    OP =~"=~"RIGHT=~"fc_cabecera.rut_titular~"    OUTER1 =~"cliente.rut~" )    JOIN (LEFT=~"fc_carta_declaracion_marcapaso.folio_crematorio~"    OP =~"=~"RIGHT=~"fc_cabecera.folio_crematorio~"    OUTER2 =~"fc_cabecera.folio_crematorio~" )    JOIN (LEFT=~"fc_cabecera.folio_crematorio~"    OP =~"=~"RIGHT=~"fc_ficha_traslado.folio_crematorio~"    OUTER1 =~"fc_cabecera.folio_crematorio~" )    JOIN (LEFT=~"fc_ficha_traslado.cod_funeraria~"    OP =~"=~"RIGHT=~"funeraria.rut~"    OUTER1 =~"fc_ficha_traslado.cod_funeraria~" )    JOIN (LEFT=~"fc_cabecera.folio_crematorio~"    OP =~"=~"RIGHT=~"fc_arancel.folio_crematorio~"    OUTER1 =~"fc_cabecera.folio_crematorio~" )    JOIN (LEFT=~"fc_responsable_retiro.folio_crematorio~"    OP =~"=~"RIGHT=~"fc_cabecera.folio_crematorio~"    OUTER2 =~"fc_cabecera.folio_crematorio~" )    JOIN (LEFT=~"estado_cuerpo.codigo~"    OP =~"=~"RIGHT=~"fc_fallecido.estado_cuerpo~"    OUTER2 =~"fc_fallecido.estado_cuerpo~" )    JOIN (LEFT=~"fc_destino_cuerpo.codigo_destino~"    OP =~"=~"RIGHT=~"fc_cabecera.destino_cuerpo~"    OUTER2 =~"fc_cabecera.destino_cuerpo~" )   JOIN (LEFT=~"fc_cabecera.folio_crematorio~"    OP =~"=~"RIGHT=~"fc_fallecido.folio_crematorio~" )    JOIN (LEFT=~"fc_cabecera.folio_crematorio~"    OP =~"=~"RIGHT=~"fc_titular.folio_crematorio~" )    JOIN (LEFT=~"fc_ceremonia.folio_crematorio~"    OP =~"=~"RIGHT=~"fc_cabecera.folio_crematorio~" ) WHERE(    EXP1 =~"~~~"FC_CABECERA~~~".~~~"FOLIO_CREMATORIO~~~"~"   OP =~"=~"    EXP2 =~":folio~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FC_RESPONSABLE_PARQUE~~~".~~~"USUARIO~~~"~"   OP =~"=~"    EXP2 =~"'LVASQUEZ'~" ) ) ARG(NAME = ~"folio~" TYPE = number) " arguments=(("folio", number)) )
