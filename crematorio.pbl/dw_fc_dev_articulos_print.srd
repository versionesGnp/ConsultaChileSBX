 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"fc_carta_devolucion_articulos~" ) COLUMN(NAME=~"fc_carta_devolucion_articulos.folio_crematorio~") COLUMN(NAME=~"fc_carta_devolucion_articulos.nombres_fallecido~") COLUMN(NAME=~"fc_carta_devolucion_articulos.apellido_paterno_fallecido~") COLUMN(NAME=~"fc_carta_devolucion_articulos.apellido_materno_fallecido~") COLUMN(NAME=~"fc_carta_devolucion_articulos.rut_prelacion~") COLUMN(NAME=~"fc_carta_devolucion_articulos.dv_prelacion~") COLUMN(NAME=~"fc_carta_devolucion_articulos.nombres_prelacion~") COLUMN(NAME=~"fc_carta_devolucion_articulos.apellido_paterno_prelacion~") COLUMN(NAME=~"fc_carta_devolucion_articulos.apellido_materno_prelacion~")WHERE(    EXP1 =~"~~~"FC_CARTA_DEVOLUCION_ARTICULOS~~~".~~~"FOLIO_CREMATORIO~~~"~"   OP =~"=~"    EXP2 =~":folio~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FC_CARTA_DEVOLUCION_ARTICULOS~~~".~~~"RUT_PRELACION~~~"~"   OP =~"=~"    EXP2 =~":rut~" ) ) ARG(NAME = ~"folio~" TYPE = number)  ARG(NAME = ~"rut~" TYPE = number) " update="FC_CARTA_DEVOLUCION_ARTICULOS" updatewhere=0 updatekeyinplace=yes arguments=(("folio", number),("rut", number)) )
