 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"fc_cabecera~" )  TABLE(NAME=~"fc_prelacion~" )  TABLE(NAME=~"fc_titular~" )  TABLE(NAME=~"cliente~" ) COLUMN(NAME=~"fc_cabecera.folio_crematorio~") COLUMN(NAME=~"fc_titular.rut_titular~") COLUMN(NAME=~"fc_titular.dv_titular~") COLUMN(NAME=~"fc_titular.nombres~") COLUMN(NAME=~"fc_titular.apellido_paterno~") COLUMN(NAME=~"fc_titular.apellido_materno~") COLUMN(NAME=~"cliente.esta_civil~") COLUMN(NAME=~"cliente.tipo_via~") COLUMN(NAME=~"cliente.direccion_p~") COLUMN(NAME=~"cliente.numero_particular~") COLUMN(NAME=~"cliente.depto_particular~") COLUMN(NAME=~"cliente.block_particular~") COLUMN(NAME=~"cliente.ciudad~") COLUMN(NAME=~"cliente.comuna~") COLUMN(NAME=~"fc_prelacion.rut~") COLUMN(NAME=~"fc_prelacion.dv~") COLUMN(NAME=~"fc_prelacion.nombres~") COLUMN(NAME=~"fc_prelacion.apellido_paterno~") COLUMN(NAME=~"fc_prelacion.apellido_materno~") COLUMN(NAME=~"fc_prelacion.tipo_via~") COLUMN(NAME=~"fc_prelacion.direccion~") COLUMN(NAME=~"fc_prelacion.numero_direc~") COLUMN(NAME=~"fc_prelacion.depto_direc~") COLUMN(NAME=~"fc_prelacion.block_direc~") COLUMN(NAME=~"fc_prelacion.ciudad~") COLUMN(NAME=~"fc_prelacion.comuna~") COLUMN(NAME=~"fc_prelacion.celular~") COLUMN(NAME=~"fc_prelacion.estado_civil~") COLUMN(NAME=~"fc_prelacion.nacionalidad~")    JOIN (LEFT=~"fc_cabecera.rut_titular~"    OP =~"=~"RIGHT=~"cliente.rut~"    OUTER1 =~"fc_cabecera.rut_titular~" )    JOIN (LEFT=~"fc_cabecera.folio_crematorio~"    OP =~"=~"RIGHT=~"fc_prelacion.folio_crematorio~" )    JOIN (LEFT=~"fc_cabecera.rut_titular~"    OP =~"=~"RIGHT=~"fc_titular.rut_titular~" )    JOIN (LEFT=~"fc_cabecera.folio_crematorio~"    OP =~"=~"RIGHT=~"fc_titular.folio_crematorio~" )WHERE(    EXP1 =~"~~~"FC_CABECERA~~~".~~~"FOLIO_CREMATORIO~~~"~"   OP =~"=~"    EXP2 =~":folio~" ) ) ARG(NAME = ~"folio~" TYPE = number) " arguments=(("folio", number)) )
