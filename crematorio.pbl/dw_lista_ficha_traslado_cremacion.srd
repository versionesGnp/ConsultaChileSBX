aslado.serie_funeraria~") COLUMN(NAME=~"fc_ficha_traslado.numero_funeraria~") COLUMN(NAME=~"fc_ficha_traslado.rut_titular_funeraria~")WHERE(    EXP1 =~"~~~"FC_FICHA_TRASLADO~~~".~~~"FECHA_TRASLADO~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FC_FICHA_TRASLADO~~~".~~~"FECHA_TRASLADO~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = datetime)  ARG(NAME = ~"fecha_fin~" TYPE = datetime) " arguments=(("fecha_ini", datetime),("fecha_fin", datetime))  sort="folio_crematorio A folio_traslado A " )
