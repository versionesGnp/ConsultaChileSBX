table(column=(type=number updatewhereclause=yes name=fallecidos_rut dbname="fallecidos.rut" dbalias=".rut" )
 column=(type=char(1) updatewhereclause=yes name=fallecidos_dv dbname="fallecidos.dv" dbalias=".dv" )
 column=(type=char(50) updatewhereclause=yes name=fallecidos_nombres dbname="fallecidos.nombres" dbalias=".nombres" )
 column=(type=char(50) updatewhereclause=yes name=fallecidos_ap_paterno dbname="fallecidos.ap_paterno" dbalias=".ap_paterno" )
 column=(type=char(50) updatewhereclause=yes name=fallecidos_ap_materno dbname="fallecidos.ap_materno" dbalias=".ap_materno" )
 column=(type=datetime updatewhereclause=yes name=fallecidos_fec_fall dbname="fallecidos.fec_fall" dbalias=".fec_fall" )
 column=(type=char(1) updatewhereclause=yes name=cadena_codigo dbname="cadena.codigo" dbalias=".codigo" )
 column=(type=char(1) updatewhereclause=yes name=cadena_serie dbname="cadena.serie" dbalias=".serie" )
 column=(type=decimal(4) updatewhereclause=yes name=cadena_numero dbname="cadena.numero" dbalias=".numero" )
 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"cadena~" )  TABLE(NAME=~"fallecidos~" ) COLUMN(NAME=~"fallecidos.rut~") COLUMN(NAME=~"fallecidos.dv~") COLUMN(NAME=~"fallecidos.nombres~") COLUMN(NAME=~"fallecidos.ap_paterno~") COLUMN(NAME=~"fallecidos.ap_materno~") COLUMN(NAME=~"fallecidos.fec_fall~") COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"cadena.serie~") COLUMN(NAME=~"cadena.numero~")    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"fallecidos.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"fallecidos.ss~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"fallecidos.contrato~" )WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"RUT~~~"~"   OP =~"=~"    EXP2 =~":rut_titular~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FALLECIDOS~~~".~~~"ESTADO_REG~~~"~"   OP =~"=~"    EXP2 =~"'A'~" ) )    UNION (PBSELECT( VERSION(400) TABLE(NAME=~"fc_fallecido~" )  TABLE(NAME=~"fc_cabecera~" ) COLUMN(NAME=~"fc_fallecido.rut_fallecido~") COLUMN(NAME=~"fc_fallecido.dv_fallecido~") COLUMN(NAME=~"fc_fallecido.nombres~") COLUMN(NAME=~"fc_fallecido.apellido_paterno~") COLUMN(NAME=~"fc_fallecido.apellido_materno~") COLUMN(NAME=~"fc_fallecido.fecha_defuncion~") COLUMN(NAME=~"fc_cabecera.base~") COLUMN(NAME=~"fc_cabecera.serie~") COLUMN(NAME=~"fc_cabecera.numero~")    JOIN (LEFT=~"fc_fallecido.folio_crematorio~"    OP =~"=~"RIGHT=~"fc_cabecera.folio_crematorio~" )WHERE(    EXP1 =~"~~~"FC_CABECERA~~~".~~~"RUT_TITULAR~~~"~"   OP =~"=~"    EXP2 =~":rut_titular~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FC_CABECERA~~~".~~~"ESTADO_REG~~~"~"   OP =~"<>~"    EXP2 =~"'I'~" ) )) ARG(NAME = ~"rut_titular~" TYPE = number) " arguments=(("rut_titular", number)) )
