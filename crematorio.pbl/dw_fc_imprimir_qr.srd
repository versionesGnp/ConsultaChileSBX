 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"fc_fallecido~" )  TABLE(NAME=~"fc_cabecera~" )  TABLE(NAME=~"cod_parq~" ) COLUMN(NAME=~"fc_fallecido.folio_crematorio~") COLUMN(NAME=~"fc_fallecido.base~") COLUMN(NAME=~"fc_fallecido.serie~") COLUMN(NAME=~"fc_fallecido.numero~") COLUMN(NAME=~"fc_fallecido.nombres~") COLUMN(NAME=~"fc_fallecido.apellido_paterno~") COLUMN(NAME=~"fc_fallecido.apellido_materno~") COLUMN(NAME=~"fc_fallecido.fecha_defuncion~") COLUMN(NAME=~"fc_fallecido.rut_fallecido~") COLUMN(NAME=~"fc_fallecido.dv_fallecido~") COLUMN(NAME=~"fc_cabecera.fecha_ingreso_cinerario~") COLUMN(NAME=~"fc_cabecera.hora_ingreso_cinerario~") COLUMN(NAME=~"fc_cabecera.minuto_ingreso_cinerario~") COLUMN(NAME=~"fc_cabecera.fecha_cineracion~") COLUMN(NAME=~"fc_cabecera.hora_cineracion~") COLUMN(NAME=~"fc_cabecera.minuto_cineracion~") COLUMN(NAME=~"cod_parq.nombre~")    JOIN (LEFT=~"fc_fallecido.folio_crematorio~"    OP =~"=~"RIGHT=~"fc_cabecera.folio_crematorio~" )    JOIN (LEFT=~"fc_cabecera.cod_parque_destino~"    OP =~"=~"RIGHT=~"cod_parq.codigo~" )WHERE(    EXP1 =~"~~~"FC_FALLECIDO~~~".~~~"FOLIO_CREMATORIO~~~"~"   OP =~"=~"    EXP2 =~":folio~" ) ) ARG(NAME = ~"folio~" TYPE = number) " arguments=(("folio", number)) )
