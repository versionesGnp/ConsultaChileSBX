 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"fc_cabecera~" ) COLUMN(NAME=~"fc_cabecera.folio_crematorio~") COLUMN(NAME=~"fc_cabecera.base~") COLUMN(NAME=~"fc_cabecera.serie~") COLUMN(NAME=~"fc_cabecera.numero~") COLUMN(NAME=~"fc_cabecera.rut_titular~") COLUMN(NAME=~"fc_cabecera.tipo_origen~") COLUMN(NAME=~"fc_cabecera.tipo_solicitud_origen~") COLUMN(NAME=~"fc_cabecera.origen_contrato~") COLUMN(NAME=~"fc_cabecera.forma_venta~") COLUMN(NAME=~"fc_cabecera.estado_pago~") COLUMN(NAME=~"fc_cabecera.rut_fallecido~") COLUMN(NAME=~"fc_cabecera.estado_reg~") COLUMN(NAME=~"fc_cabecera.fecha_crea~") COLUMN(NAME=~"fc_cabecera.fecha_sistema~") COLUMN(NAME=~"fc_cabecera.correlativo_fc~")WHERE(    EXP1 =~"~~~"FC_CABECERA~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FC_CABECERA~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FC_CABECERA~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FC_CABECERA~~~".~~~"ESTADO_REG~~~"~"   OP =~"<>~"    EXP2 =~"'A'~" ) ) ORDER(NAME=~"fc_cabecera.fecha_sistema~" ASC=yes ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number) " update="FC_CABECERA" updatewhere=0 updatekeyinplace=yes arguments=(("base", string),("serie", string),("numero", number)) )
