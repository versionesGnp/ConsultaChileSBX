 retrieve="  SELECT ~"FC_RESPONSABLE_RETIRO~".~"FOLIO_CREMATORIO~",   
         ~"FC_RESPONSABLE_RETIRO~".~"BASE~",   
         ~"FC_RESPONSABLE_RETIRO~".~"SERIE~",   
         ~"FC_RESPONSABLE_RETIRO~".~"NUMERO~",   
         ~"FC_RESPONSABLE_RETIRO~".~"ESTADO_REG~",   
         ~"FC_RESPONSABLE_RETIRO~".~"DESTINO_CUERPO~",   
         ~"FC_RESPONSABLE_RETIRO~".~"VISUALIZAR_SERVICIO~",   
         ~"FC_RESPONSABLE_RETIRO~".~"RUT_RESPONSABLE~",   
         ~"FC_RESPONSABLE_RETIRO~".~"NOMBRE~",   
         ~"FC_RESPONSABLE_RETIRO~".~"APELLIDO_PATERNO~",   
         ~"FC_RESPONSABLE_RETIRO~".~"APELLIDO_MATERNO~",   
         ~"FC_RESPONSABLE_RETIRO~".~"FONO_1~",   
         ~"FC_RESPONSABLE_RETIRO~".~"FONO_2~",   
         'S' AS nuevo,   
         ~"FC_RESPONSABLE_RETIRO~".~"DV_RESPONSABLE~",   
         ~"FC_RESPONSABLE_RETIRO~".~"RESPONSABLE_RETIRO~",   
         ~"FC_RESPONSABLE_RETIRO~".~"FECHA_RETIRO_CENIZA~",   
         ~"FC_RESPONSABLE_RETIRO~".~"HORA_RETIRO_CENIZA~",   
         ~"FC_RESPONSABLE_RETIRO~".~"MINUTO_RETIRO_CENIZA~",   
         ~"FC_RESPONSABLE_RETIRO~".~"SW_PARTICIPA_CREMACION~",   
         ~"FC_RESPONSABLE_RETIRO~".~"USO_CAPILLA~",   
         ~"FC_RESPONSABLE_RETIRO~".~"FECHA_USO_CAPILLA~",   
         ~"FC_RESPONSABLE_RETIRO~".~"HORA_USO_CAPILLA~",   
         ~"FC_RESPONSABLE_RETIRO~".~"MINUTOS_USO_CAPILLA~",   
         ~"FC_RESPONSABLE_RETIRO~".~"USO_PERGOLA~",   
         ~"FC_RESPONSABLE_RETIRO~".~"FECHA_USO_PERGOLA~",   
         ~"FC_RESPONSABLE_RETIRO~".~"HORA_USO_PERGOLA~",   
         ~"FC_RESPONSABLE_RETIRO~".~"MINUTO_USO_PERGOLA~",   
         ~"FC_RESPONSABLE_RETIRO~".~"NRO_RESOL_CREMACION~",   
         ~"FC_RESPONSABLE_RETIRO~".~"NUMERO_ANFORA~"       ,
         ~"FC_RESPONSABLE_RETIRO~".~"FECHA_RESOLUCION~" 
    FROM ~"FC_RESPONSABLE_RETIRO~"  
   WHERE ~"FC_RESPONSABLE_RETIRO~".~"FOLIO_CREMATORIO~" = :folio    
" update="FC_RESPONSABLE_RETIRO" updatewhere=0 updatekeyinplace=yes arguments=(("folio", number)) )
