 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"fc_fallecido~" ) COLUMN(NAME=~"fc_fallecido.folio_crematorio~") COLUMN(NAME=~"fc_fallecido.base~") COLUMN(NAME=~"fc_fallecido.serie~") COLUMN(NAME=~"fc_fallecido.numero~") COLUMN(NAME=~"fc_fallecido.estado_reg~") COLUMN(NAME=~"fc_fallecido.dv_fallecido~") COLUMN(NAME=~"fc_fallecido.nombres~") COLUMN(NAME=~"fc_fallecido.apellido_paterno~") COLUMN(NAME=~"fc_fallecido.apellido_materno~") COLUMN(NAME=~"fc_fallecido.fecha_nacimiento~") COLUMN(NAME=~"fc_fallecido.sexo~") COLUMN(NAME=~"fc_fallecido.fecha_defuncion~") COLUMN(NAME=~"fc_fallecido.annos_difunto~") COLUMN(NAME=~"fc_fallecido.causa_fallecimiento~") COLUMN(NAME=~"fc_fallecido.estado_cuerpo~") COLUMN(NAME=~"fc_fallecido.enfermedad_obligatoria~") COLUMN(NAME=~"fc_fallecido.estado_contrato_sepultura~") COLUMN(NAME=~"fc_fallecido.cod_parque~") COLUMN(NAME=~"fc_fallecido.hora_defuncion~") COLUMN(NAME=~"fc_fallecido.minuto_defuncion~") COLUMN(NAME=~"fc_fallecido.edad_numero~") COLUMN(NAME=~"fc_fallecido.edad_texto~") COLUMN(NAME=~"fc_fallecido.estado_civil~") COLUMN(NAME=~"fc_fallecido.codigo_lugar_fallecimiento~") COLUMN(NAME=~"fc_fallecido.ciudad_fallecimiento~") COLUMN(NAME=~"fc_fallecido.comuna_fallecimiento~") COLUMN(NAME=~"fc_fallecido.codigo_origen_cuerpo~") COLUMN(NAME=~"fc_fallecido.tipo_via_fallecido~") COLUMN(NAME=~"fc_fallecido.direccion_fallecido~") COLUMN(NAME=~"fc_fallecido.numero_fallecido~") COLUMN(NAME=~"fc_fallecido.depto_fallecido~") COLUMN(NAME=~"fc_fallecido.block_fallecido~") COLUMN(NAME=~"fc_fallecido.codigo_funeraria~") COLUMN(NAME=~"fc_fallecido.tamano_cuerpo~") COLUMN(NAME=~"fc_fallecido.existencia_elementos~") COLUMN(NAME=~"fc_fallecido.observaciones~") COMPUTE(NAME=~"'S' AS nuevo~") COLUMN(NAME=~"fc_fallecido.cod_registro_pase~") COLUMN(NAME=~"fc_fallecido.inscripcion_pase~") COLUMN(NAME=~"fc_fallecido.registro_pase~") COLUMN(NAME=~"fc_fallecido.fecha_pase~") COLUMN(NAME=~"fc_fallecido.nacionalidad~") COLUMN(NAME=~"fc_fallecido.rut_fallecido~") COLUMN(NAME=~"fc_fallecido.peso~") COLUMN(NAME=~"fc_fallecido.sw_marcapaso~")WHERE(    EXP1 =~"~~~"FC_FALLECIDO~~~".~~~"FOLIO_CREMATORIO~~~"~"   OP =~"=~"    EXP2 =~":folio~" ) ) ARG(NAME = ~"folio~" TYPE = number) " update="FC_FALLECIDO" updatewhere=0 updatekeyinplace=yes arguments=(("folio", number)) )
