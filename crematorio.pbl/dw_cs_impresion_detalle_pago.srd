 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cs_cabecera~" )  TABLE(NAME=~"cs_detalle_pagos~" )  TABLE(NAME=~"cliente~" ) COLUMN(NAME=~"cs_cabecera.base~") COLUMN(NAME=~"cs_cabecera.serie~") COLUMN(NAME=~"cs_cabecera.numero~") COLUMN(NAME=~"cs_cabecera.estado_contrato~") COLUMN(NAME=~"cs_cabecera.base_original~") COLUMN(NAME=~"cs_cabecera.serie_original~") COLUMN(NAME=~"cs_cabecera.numero_original~") COLUMN(NAME=~"cs_cabecera.rut~") COLUMN(NAME=~"cs_cabecera.dv~") COLUMN(NAME=~"cs_cabecera.usuario~") COLUMN(NAME=~"cs_cabecera.tipo_cob_aux~") COLUMN(NAME=~"cs_cabecera.tipo_cob~") COLUMN(NAME=~"cs_cabecera.total_pesos~") COLUMN(NAME=~"cs_cabecera.cod_parque~") COLUMN(NAME=~"cs_cabecera.codigo_servicio~") COLUMN(NAME=~"cs_detalle_pagos.codigo_otro~") COLUMN(NAME=~"cs_detalle_pagos.monto_peso~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~")    JOIN (LEFT=~"cs_cabecera.base~"    OP =~"=~"RIGHT=~"cs_detalle_pagos.base~" )    JOIN (LEFT=~"cs_cabecera.serie~"    OP =~"=~"RIGHT=~"cs_detalle_pagos.serie~" )    JOIN (LEFT=~"cs_cabecera.numero~"    OP =~"=~"RIGHT=~"cs_detalle_pagos.numero~" )    JOIN (LEFT=~"cs_cabecera.rut~"    OP =~"=~"RIGHT=~"cliente.rut~" )WHERE(    EXP1 =~"~~~"CS_CABECERA~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base_v~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CS_CABECERA~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie_v~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CS_CABECERA~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero_v~" ) ) ARG(NAME = ~"base_v~" TYPE = string)  ARG(NAME = ~"serie_v~" TYPE = string)  ARG(NAME = ~"numero_v~" TYPE = number) " arguments=(("base_v", string),("serie_v", string),("numero_v", number))  sort="cs_detalle_pagos_codigo_otro A " )
