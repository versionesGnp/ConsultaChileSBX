 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"fc_titular~" ) COLUMN(NAME=~"fc_titular.folio_crematorio~") COLUMN(NAME=~"fc_titular.base~") COLUMN(NAME=~"fc_titular.serie~") COLUMN(NAME=~"fc_titular.numero~") COLUMN(NAME=~"fc_titular.estado_reg~") COLUMN(NAME=~"fc_titular.nombres~") COLUMN(NAME=~"fc_titular.apellido_paterno~") COLUMN(NAME=~"fc_titular.apellido_materno~") COLUMN(NAME=~"fc_titular.rut_titular~") COLUMN(NAME=~"fc_titular.dv_titular~") COLUMN(NAME=~"fc_titular.email~") COLUMN(NAME=~"fc_titular.celular~") COMPUTE(NAME=~"'S' AS nuevo~")WHERE(    EXP1 =~"~~~"FC_TITULAR~~~".~~~"FOLIO_CREMATORIO~~~"~"   OP =~"=~"    EXP2 =~":folio~" ) ) ARG(NAME = ~"folio~" TYPE = number) " update="FC_TITULAR" updatewhere=0 updatekeyinplace=yes arguments=(("folio", number)) )
