 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ficha_sepultacion~" ) COLUMN(NAME=~"ficha_sepultacion.hora~") COLUMN(NAME=~"ficha_sepultacion.minutos~") COLUMN(NAME=~"ficha_sepultacion.nombre_fallecido~") COLUMN(NAME=~"ficha_sepultacion.ap_paterno_fall~") COLUMN(NAME=~"ficha_sepultacion.ap_materno_fall~") COLUMN(NAME=~"ficha_sepultacion.sector~") COLUMN(NAME=~"ficha_sepultacion.sepultura~") COLUMN(NAME=~"ficha_sepultacion.cod_parque~") COLUMN(NAME=~"ficha_sepultacion.fecha_sepultacion~")WHERE(    EXP1 =~"~~~"FICHA_SEPULTACION~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":ll_parque~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FICHA_SEPULTACION~~~".~~~"SECTOR~~~"~"   OP =~"=~"    EXP2 =~":ls_sector~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FICHA_SEPULTACION~~~".~~~"SEPULTURA~~~"~"   OP =~"=~"    EXP2 =~":ls_sepultura~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FICHA_SEPULTACION~~~".~~~"FECHA_SEPULTACION~~~"~"   OP =~"=~"    EXP2 =~":ld_fecha_sepult~" ) ) ARG(NAME = ~"ll_parque~" TYPE = number)  ARG(NAME = ~"ls_sector~" TYPE = string)  ARG(NAME = ~"ls_sepultura~" TYPE = string)  ARG(NAME = ~"ld_fecha_sepult~" TYPE = date) " arguments=(("ll_parque", number),("ls_sector", string),("ls_sepultura", string),("ld_fecha_sepult", date)) )
