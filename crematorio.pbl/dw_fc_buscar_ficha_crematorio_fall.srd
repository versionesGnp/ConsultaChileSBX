 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"fc_cabecera~" )  TABLE(NAME=~"fc_fallecido~" ) COLUMN(NAME=~"fc_cabecera.folio_crematorio~") COLUMN(NAME=~"fc_cabecera.base~") COLUMN(NAME=~"fc_cabecera.serie~") COLUMN(NAME=~"fc_cabecera.numero~") COLUMN(NAME=~"fc_cabecera.rut_titular~") COLUMN(NAME=~"fc_cabecera.tipo_origen~") COLUMN(NAME=~"fc_cabecera.tipo_solicitud_origen~") COLUMN(NAME=~"fc_cabecera.origen_contrato~") COLUMN(NAME=~"fc_cabecera.forma_venta~") COLUMN(NAME=~"fc_cabecera.estado_pago~") COLUMN(NAME=~"fc_cabecera.rut_fallecido~") COLUMN(NAME=~"fc_cabecera.estado_documento~") COLUMN(NAME=~"fc_cabecera.prelacion~") COLUMN(NAME=~"fc_cabecera.documentos~") COLUMN(NAME=~"fc_cabecera.recepcion_cuerpo~") COLUMN(NAME=~"fc_cabecera.solicitud_cineracion_seremi~") COLUMN(NAME=~"fc_cabecera.recepcion_servicio~") COLUMN(NAME=~"fc_cabecera.destino_cuerpo~") COLUMN(NAME=~"fc_cabecera.responsable_retiro~") COLUMN(NAME=~"fc_cabecera.agenda_crematorio~") COLUMN(NAME=~"fc_cabecera.agenda_visualizacion~") COLUMN(NAME=~"fc_cabecera.agenda_entrega_ceniza~") COLUMN(NAME=~"fc_cabecera.cierre_ficha_creamacion~") COLUMN(NAME=~"fc_cabecera.estado_reg~") COLUMN(NAME=~"fc_cabecera.fecha_crea~") COLUMN(NAME=~"fc_cabecera.fecha_sistema~") COLUMN(NAME=~"fc_cabecera.usuario_crea~") COLUMN(NAME=~"fc_cabecera.estado_gestion~") COLUMN(NAME=~"fc_cabecera.cod_parque_origen~") COLUMN(NAME=~"fc_cabecera.cod_parque_destino~") COLUMN(NAME=~"fc_cabecera.base_origen~") COLUMN(NAME=~"fc_cabecera.serie_origen~") COLUMN(NAME=~"fc_cabecera.numero_origen~") COLUMN(NAME=~"fc_cabecera.fecha_inactivacion~") COLUMN(NAME=~"fc_cabecera.usuario_inactiva~") COLUMN(NAME=~"fc_fallecido.rut_fallecido~") COLUMN(NAME=~"fc_fallecido.nombres~") COLUMN(NAME=~"fc_fallecido.apellido_paterno~") COLUMN(NAME=~"fc_fallecido.apellido_materno~")    JOIN (LEFT=~"fc_cabecera.folio_crematorio~"    OP =~"=~"RIGHT=~"fc_fallecido.folio_crematorio~" )WHERE(    EXP1 =~"(~~~"FC_CABECERA~~~".~~~"FECHA_CREA~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FC_CABECERA~~~".~~~"FECHA_CREA~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FC_FALLECIDO~~~".~~~"RUT_FALLECIDO~~~"~"   OP =~"=~"    EXP2 =~":rut)~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"(~~~"FC_CABECERA~~~".~~~"FECHA_CREA~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FC_CABECERA~~~".~~~"FECHA_CREA~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FC_FALLECIDO~~~".~~~"NOMBRES~~~"~"   OP =~"like~"    EXP2 =~":nombre)~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"(~~~"FC_CABECERA~~~".~~~"FECHA_CREA~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FC_CABECERA~~~".~~~"FECHA_CREA~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FC_FALLECIDO~~~".~~~"APELLIDO_PATERNO~~~"~"   OP =~"like~"    EXP2 =~":ap_pat)~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = datetime)  ARG(NAME = ~"fecha_fin~" TYPE = datetime)  ARG(NAME = ~"rut~" TYPE = number)  ARG(NAME = ~"nombre~" TYPE = string)  ARG(NAME = ~"ap_pat~" TYPE = string) " arguments=(("fecha_ini", datetime),("fecha_fin", datetime),("rut", number),("nombre", string),("ap_pat", string))  sort="fecha_crea A folio_crematorio A " )
