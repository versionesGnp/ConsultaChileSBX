 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"fc_carta_extraccion~" ) COLUMN(NAME=~"fc_carta_extraccion.numero_crematorio~") COLUMN(NAME=~"fc_carta_extraccion.rut_jefe_parque~") COLUMN(NAME=~"fc_carta_extraccion.nombre_tanatologo~") COLUMN(NAME=~"fc_carta_extraccion.fecha_extraccion~") COLUMN(NAME=~"fc_carta_extraccion.nombre_fallecido~") COLUMN(NAME=~"fc_carta_extraccion.ap_paterno_fallecido~") COLUMN(NAME=~"fc_carta_extraccion.ap_materno_fallecido~") COLUMN(NAME=~"fc_carta_extraccion.rut_fallecido~") COLUMN(NAME=~"fc_carta_extraccion.dv_fallecido~") COLUMN(NAME=~"fc_carta_extraccion.observacion~")WHERE(    EXP1 =~"~~~"FC_CARTA_EXTRACCION~~~".~~~"NUMERO_CREMATORIO~~~"~"   OP =~"=~"    EXP2 =~":folio~" ) ) ARG(NAME = ~"folio~" TYPE = number) " update="FC_CARTA_EXTRACCION" updatewhere=0 updatekeyinplace=yes arguments=(("folio", number)) )
