 retrieve="  SELECT 
		~"FC_DISTRIBUCION~".~"ID_DISTRIBUCION~",    
		~"FC_DISTRIBUCION~".~"FOLIO_CREMATORIO~",   
         ~"FC_DISTRIBUCION~".~"MODELO_ANFORA~",   
         ~"FC_DISTRIBUCION~".~"ORIGEN~",   
         ~"FC_DISTRIBUCION~".~"TAMAÑO~",   
         ~"FC_DISTRIBUCION~".~"CANTIDAD~",   
         ~"FC_DISTRIBUCION~".~"PORCENTAJE~"  
    FROM ~"FC_DISTRIBUCION~"  
   WHERE ~"FC_DISTRIBUCION~".~"FOLIO_CREMATORIO~" = :P_FOLIO_CREMACION    
" update="FC_DISTRIBUCION" updatewhere=0 updatekeyinplace=no arguments=(("P_FOLIO_CREMACION", number)) )
