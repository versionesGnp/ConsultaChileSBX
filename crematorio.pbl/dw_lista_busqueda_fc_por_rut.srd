 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"cadena~" )  TABLE(NAME=~"cliente~" )  TABLE(NAME=~"producto_anexo~" )  TABLE(NAME=~"fc_cabecera~" )  TABLE(NAME=~"producto_tipo_servicio~" )  TABLE(NAME=~"producto_pago~" )  TABLE(NAME=~"producto_tipo_servicio_cant~" ) COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"cadena.serie~") COLUMN(NAME=~"cadena.numero~") COLUMN(NAME=~"cadena.rut~") COLUMN(NAME=~"fc_cabecera.folio_crematorio~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"fc_cabecera.estado_gestion~") COLUMN(NAME=~"producto_tipo_servicio_cant.codigo_servicio~") COLUMN(NAME=~"producto_tipo_servicio.cantidad_fc~") COLUMN(NAME=~"fc_cabecera.correlativo_fc~") COMPUTE(NAME=~"sum( 1 ) as NRO_FILA~") COLUMN(NAME=~"producto_tipo_servicio_cant.correlativo_fc~")    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"fc_cabecera.base~"    OUTER1 =~"cadena.codigo~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"fc_cabecera.serie~"    OUTER1 =~"cadena.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"fc_cabecera.numero~"    OUTER1 =~"cadena.numero~" )    JOIN (LEFT=~"producto_tipo_servicio.codigo_servicio~"    OP =~"=~"RIGHT=~"producto_pago.codigo_servicio~"    OUTER1 =~"producto_tipo_servicio.codigo_servicio~" )    JOIN (LEFT=~"producto_tipo_servicio.codigo_servicio~"    OP =~"=~"RIGHT=~"producto_tipo_servicio_cant.codigo_servicio~"    OUTER1 =~"producto_tipo_servicio.codigo_servicio~" )    JOIN (LEFT=~"cadena.rut~"    OP =~"=~"RIGHT=~"cliente.rut~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"producto_anexo.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"producto_anexo.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"producto_anexo.numero~" )    JOIN (LEFT=~"producto_anexo.base~"    OP =~"=~"RIGHT=~"producto_pago.base~" )    JOIN (LEFT=~"producto_anexo.serie~"    OP =~"=~"RIGHT=~"producto_pago.serie~" )    JOIN (LEFT=~"producto_anexo.numero~"    OP =~"=~"RIGHT=~"producto_pago.numero~" )    JOIN (LEFT=~"producto_anexo.ult_folio~"    OP =~"=~"RIGHT=~"producto_pago.folio~" )WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"RUT~~~"~"   OP =~"=~"    EXP2 =~":rut~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"PRODUCTO_ANEXO~~~".~~~"FECHA_INGRESO~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"PRODUCTO_ANEXO~~~".~~~"FECHA_INGRESO~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FC_CABECERA~~~".~~~"ESTADO_REG~~~"~"   OP =~"<>~"    EXP2 =~"'A'~" )  GROUP(NAME=~"cadena.codigo~") GROUP(NAME=~"cadena.serie~") GROUP(NAME=~"cadena.numero~") GROUP(NAME=~"cadena.rut~") GROUP(NAME=~"fc_cabecera.folio_crematorio~") GROUP(NAME=~"cliente.dv~") GROUP(NAME=~"cliente.nombre~") GROUP(NAME=~"cliente.a_paterno~") GROUP(NAME=~"cliente.a_materno~") GROUP(NAME=~"cadena.estado~") GROUP(NAME=~"fc_cabecera.estado_gestion~") GROUP(NAME=~"producto_tipo_servicio_cant.codigo_servicio~") GROUP(NAME=~"producto_tipo_servicio.cantidad_fc~") GROUP(NAME=~"producto_tipo_servicio_cant.correlativo_fc~") GROUP(NAME=~"producto_tipo_servicio_cant.cantidad_fc~") GROUP(NAME=~"fc_cabecera.correlativo_fc~")) ARG(NAME = ~"rut~" TYPE = number)  ARG(NAME = ~"fecha_ini~" TYPE = datetime)  ARG(NAME = ~"fecha_fin~" TYPE = datetime) " arguments=(("rut", number),("fecha_ini", datetime),("fecha_fin", datetime))  sort="cadena_codigo A cadena_serie A cadena_numero A fc_cabecera_folio_crematorio A producto_tipo_servicio_cant_correlativo_fc A " )
