 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"cs_detalle_pagos~" ) COLUMN(NAME=~"cs_detalle_pagos.base~") COLUMN(NAME=~"cs_detalle_pagos.serie~") COLUMN(NAME=~"cs_detalle_pagos.contrato~") COLUMN(NAME=~"cs_detalle_pagos.estado_contrato~") COLUMN(NAME=~"cs_detalle_pagos.base_original~") COLUMN(NAME=~"cs_detalle_pagos.serie_original~") COLUMN(NAME=~"cs_detalle_pagos.numero_original~") COLUMN(NAME=~"cs_detalle_pagos.rut~") COLUMN(NAME=~"cs_detalle_pagos.dv~") COMPUTE(NAME=~"sum( ~~~"CS_DETALLE_PAGOS~~~".~~~"MONTO_PESOS~~~") as MONTO_PESO~")WHERE(    EXP1 =~"(~~~"CS_DETALLE_PAGOS~~~".~~~"BASE_ORIGINAL~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CS_DETALLE_PAGOS~~~".~~~"SERIE_ORIGINAL~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CS_DETALLE_PAGOS~~~".~~~"NUMERO_ORIGINAL~~~"~"   OP =~"=~"    EXP2 =~":numero)~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"(~~~"CS_DETALLE_PAGOS~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CS_DETALLE_PAGOS~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CS_DETALLE_PAGOS~~~".~~~"CONTRATO~~~"~"   OP =~"=~"    EXP2 =~":numero)~" )  GROUP(NAME=~"cs_detalle_pagos.base~") GROUP(NAME=~"cs_detalle_pagos.serie~") GROUP(NAME=~"cs_detalle_pagos.contrato~") GROUP(NAME=~"cs_detalle_pagos.estado_contrato~") GROUP(NAME=~"cs_detalle_pagos.base_original~") GROUP(NAME=~"cs_detalle_pagos.serie_original~") GROUP(NAME=~"cs_detalle_pagos.numero_original~") GROUP(NAME=~"cs_detalle_pagos.rut~") GROUP(NAME=~"cs_detalle_pagos.dv~")) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number) " arguments=(("base", string),("serie", string),("numero", number))  sort="contrato A estado_contrato A " )
