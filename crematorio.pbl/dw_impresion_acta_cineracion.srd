compute(band=detail alignment="3" expression="'En Santiago de Chile, con fecha '+day( fc_cabecera_fecha_ingreso_cinerario )+ ' de '+case( month( fc_cabecera_fecha_ingreso_cinerario ) when 1 then 'Enero' when 2 then 'Febrero' when 3 then 'Marzo' when 4 then 'Abril' when 5 then 'Mayo' when 6 then 'Junio' when 7 then 'Julio' when 8 then 'Agosto' when 9 then 'Septiembre' when 10 then 'Octubre' when 11 then 'Noviembre' when 12 then 'Diciembre') +' de '+year( fc_cabecera_fecha_ingreso_cinerario ) + ', siendo las '+string( fc_cabecera_hora_ingreso_cinerario ,'00')+':'+string( fc_cabecera_minuto_ingreso_cinerario ,'00')+' horas, se procede con la cineración del señor(a), '+  fc_fallecido_nombres + ' ' + fc_fallecido_apellido_paterno  +' '+  fc_fallecido_apellido_materno +' quien falleció el día '+  day(  fc_fallecido_fecha_defuncion  )+ ' de '+case( month(  fc_fallecido_fecha_defuncion  ) when 1 then 'Enero' when 2 then 'Febrero' when 3 then 'Marzo' when 4 then 'Abril' when 5 then 'Mayo' when 6 then 'Junio' when 7 then 'Julio' when 8 then 'Agosto' when 9 then 'Septiembre' when 10 then 'Octubre' when 11 then 'Noviembre' when 12 then 'Diciembre') +' de '+year(  fc_fallecido_fecha_defuncion  )+'.'"border="0" color="0" x="165" y="132" height="296" width="3214" format="[GENERAL]" html.valueishtml="0"  name=compute_2 visible="1"  font.face="Arial" font.height="-12" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" background.transparency="0" background.gradient.color="8421504" background.gradient.transparency="0" background.gradient.angle="0" background.brushmode="0" background.gradient.repetition.mode="0" background.gradient.repetition.count="0" background.gradient.repetition.length="100" background.gradient.focus="0" background.gradient.scale="100" background.gradient.spread="100" tooltip.backcolor="134217752" tooltip.delay.initial="0" tooltip.delay.visible="32000" tooltip.enabled="0" tooltip.hasclosebutton="0" tooltip.icon="0" tooltip.isbubble="0" tooltip.maxwidth="0" tooltip.textcolor="134217751" tooltip.transparency="0" transparency="0"  height.autosize=yes)
compute(band=detail alignment="3" expression="'La cineración fue solicitada por el señor(a), '+ fc_responsable_retiro_nombre +' '+ fc_responsable_retiro_apellido_paterno +' '+ fc_responsable_retiro_apellido_materno +', con cedula de identidad nacional N° '+string( fc_responsable_retiro_rut_responsable ,'###,###,###,###')+'-'+ fc_responsable_retiro_dv_responsable +', según resolución N° '+ string(fc_responsable_retiro_nro_resol_cremacion) +', de fecha '+ day( fc_responsable_retiro_fecha_retiro_ceniza )+ ' de '+case( month( fc_responsable_retiro_fecha_retiro_ceniza ) when 1 then 'Enero' when 2 then 'Febrero' when 3 then 'Marzo' when 4 then 'Abril' when 5 then 'Mayo' when 6 then 'Junio' when 7 then 'Julio' when 8 then 'Agosto' when 9 then 'Septiembre' when 10 then 'Octubre' when 11 then 'Noviembre' when 12 then 'Diciembre') +' de '+year( fc_responsable_retiro_fecha_retiro_ceniza ) +' y autorizada por el señor Director General del Servicio Nacional de Salud o su Delegado o Subrogante, según consta en dicha solicitud.'"border="0" color="0" x="165" y="416" height="380" width="3214" format="[GENERAL]" html.valueishtml="0"  name=compute_3 visible="1"  font.face="Arial" font.height="-12" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" background.transparency="0" background.gradient.color="8421504" background.gradient.transparency="0" background.gradient.angle="0" background.brushmode="0" background.gradient.repetition.mode="0" background.gradient.repetition.count="0" background.gradient.repetition.length="100" background.gradient.focus="0" background.gradient.scale="100" background.gradient.spread="100" tooltip.backcolor="134217752" tooltip.delay.initial="0" tooltip.delay.visible="32000" tooltip.enabled="0" tooltip.hasclosebutton="0" tooltip.icon="0" tooltip.isbubble="0" tooltip.maxwidth="0" tooltip.textcolor="134217751" tooltip.transparency="0" transparency="0" )
compute(band=detail alignment="3" expression="'Las cenizas fueron entregadas al señor(a), '+ fc_responsable_retiro_nombre +' '+ fc_responsable_retiro_apellido_paterno +' '+ fc_responsable_retiro_apellido_materno +', cedula de identidad nacional N° '+string( fc_responsable_retiro_rut_responsable ,'###,###,###,###')+'-'+ fc_responsable_retiro_dv_responsable +', con domicilio en '+ tipo_via_descripcion +' '+   fc_prelacion_direccion +' # '+  fc_prelacion_numero_direc +', comuna de '+   comuna_comuna +', Región '+ ciudad_sigla_ciudad +'. En cofre sellado, el que fue recibido a su entera satisfacción.'"border="0" color="0" x="165" y="796" height="320" width="3214" format="[GENERAL]" html.valueishtml="0"  name=compute_4 visible="1"  font.face="Arial" font.height="-12" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" background.transparency="0" background.gradient.color="8421504" background.gradient.transparency="0" background.gradient.angle="0" background.brushmode="0" background.gradient.repetition.mode="0" background.gradient.repetition.count="0" background.gradient.repetition.length="100" background.gradient.focus="0" background.gradient.scale="100" background.gradient.spread="100" tooltip.backcolor="134217752" tooltip.delay.initial="0" tooltip.delay.visible="32000" tooltip.enabled="0" tooltip.hasclosebutton="0" tooltip.icon="0" tooltip.isbubble="0" tooltip.maxwidth="0" tooltip.textcolor="134217751" tooltip.transparency="0" transparency="0" )
