 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"fc_cabecera~" )  TABLE(NAME=~"fc_fallecido~" )  TABLE(NAME=~"fc_responsable_parque~" )  TABLE(NAME=~"fc_responsable_retiro~" )  TABLE(NAME=~"ciudad~" )  TABLE(NAME=~"comuna~" )  TABLE(NAME=~"tipo_via~" )  TABLE(NAME=~"fc_prelacion~" ) COLUMN(NAME=~"fc_cabecera.folio_crematorio~") COLUMN(NAME=~"fc_cabecera.fecha_ingreso_cinerario~") COLUMN(NAME=~"fc_cabecera.hora_ingreso_cinerario~") COLUMN(NAME=~"fc_cabecera.minuto_ingreso_cinerario~") COLUMN(NAME=~"fc_responsable_retiro.rut_responsable~") COLUMN(NAME=~"fc_responsable_retiro.dv_responsable~") COLUMN(NAME=~"fc_responsable_retiro.nombre~") COLUMN(NAME=~"fc_responsable_retiro.apellido_paterno~") COLUMN(NAME=~"fc_responsable_retiro.apellido_materno~") COLUMN(NAME=~"fc_responsable_retiro.nro_resol_cremacion~") COLUMN(NAME=~"fc_responsable_retiro.numero_anfora~") COLUMN(NAME=~"fc_responsable_retiro.fecha_retiro_ceniza~") COLUMN(NAME=~"fc_responsable_retiro.hora_retiro_ceniza~") COLUMN(NAME=~"fc_responsable_retiro.minuto_retiro_ceniza~") COLUMN(NAME=~"fc_fallecido.nombres~") COLUMN(NAME=~"fc_fallecido.apellido_paterno~") COLUMN(NAME=~"fc_fallecido.apellido_materno~") COLUMN(NAME=~"fc_fallecido.fecha_defuncion~") COLUMN(NAME=~"fc_responsable_parque.nombre~") COLUMN(NAME=~"fc_responsable_parque.apellido_paterno~") COLUMN(NAME=~"fc_responsable_parque.apellido_materno~") COLUMN(NAME=~"fc_responsable_retiro.fono_1~") COLUMN(NAME=~"fc_responsable_retiro.fono_2~") COLUMN(NAME=~"ciudad.sigla_ciudad~") COLUMN(NAME=~"comuna.comuna~") COLUMN(NAME=~"tipo_via.descripcion~") COLUMN(NAME=~"fc_fallecido.direccion_fallecido~") COLUMN(NAME=~"fc_fallecido.numero_fallecido~") COLUMN(NAME=~"fc_fallecido.depto_fallecido~") COLUMN(NAME=~"fc_fallecido.block_fallecido~") COLUMN(NAME=~"fc_prelacion.direccion~") COLUMN(NAME=~"fc_prelacion.numero_direc~") COLUMN(NAME=~"fc_prelacion.comuna~") COLUMN(NAME=~"fc_prelacion.ciudad~")    JOIN (LEFT=~"fc_fallecido.folio_crematorio~"    OP =~"=~"RIGHT=~"fc_responsable_retiro.folio_crematorio~" )    JOIN (LEFT=~"fc_cabecera.folio_crematorio~"    OP =~"=~"RIGHT=~"fc_responsable_retiro.folio_crematorio~" )    JOIN (LEFT=~"fc_fallecido.comuna_fallecimiento~"    OP =~"=~"RIGHT=~"comuna.codigo_comuna~" )    JOIN (LEFT=~"fc_fallecido.ciudad_fallecimiento~"    OP =~"=~"RIGHT=~"ciudad.codigo_ciudad~" )    JOIN (LEFT=~"fc_fallecido.tipo_via_fallecido~"    OP =~"=~"RIGHT=~"tipo_via.tipo_via~" )    JOIN (LEFT=~"fc_prelacion.folio_crematorio~"    OP =~"=~"RIGHT=~"fc_responsable_retiro.folio_crematorio~" )    JOIN (LEFT=~"fc_prelacion.base~"    OP =~"=~"RIGHT=~"fc_responsable_retiro.base~" )    JOIN (LEFT=~"fc_prelacion.serie~"    OP =~"=~"RIGHT=~"fc_responsable_retiro.serie~" )    JOIN (LEFT=~"fc_prelacion.numero~"    OP =~"=~"RIGHT=~"fc_responsable_retiro.numero~" )    JOIN (LEFT=~"fc_prelacion.rut~"    OP =~"=~"RIGHT=~"fc_responsable_retiro.rut_responsable~" )WHERE(    EXP1 =~"~~~"FC_CABECERA~~~".~~~"FOLIO_CREMATORIO~~~"~"   OP =~"=~"    EXP2 =~":folio~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FC_RESPONSABLE_PARQUE~~~".~~~"JEFE_CREMATORIO~~~"~"   OP =~"=~"    EXP2 =~"'S'~" ) ) ARG(NAME = ~"folio~" TYPE = number) " arguments=(("folio", number)) )
