 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"cuenta_contable_otros~" )  TABLE(NAME=~"ficha_cuenta_contable_otros~" )  TABLE(NAME=~"producto_tipo_servicio~" ) COLUMN(NAME=~"cuenta_contable_otros.codigo_otros~") COLUMN(NAME=~"cuenta_contable_otros.descripcion~") COLUMN(NAME=~"cuenta_contable_otros.valor~") COMPUTE(NAME=~"0 as sw_opcion~") COLUMN(NAME=~"cuenta_contable_otros.tipo_comprobante~") COLUMN(NAME=~"cuenta_contable_otros.tipo_cob~") COLUMN(NAME=~"cuenta_contable_otros.cod_otro_web~") COLUMN(NAME=~"ficha_cuenta_contable_otros.adicional~") COLUMN(NAME=~"ficha_cuenta_contable_otros.tipo_cobro_aux~") COLUMN(NAME=~"producto_tipo_servicio.codigo_servicio~")    JOIN (LEFT=~"ficha_cuenta_contable_otros.codigo_otros~"    OP =~"=~"RIGHT=~"producto_tipo_servicio.codigo_otro~"    OUTER1 =~"ficha_cuenta_contable_otros.codigo_otros~" )    JOIN (LEFT=~"cuenta_contable_otros.codigo_otros~"    OP =~"=~"RIGHT=~"ficha_cuenta_contable_otros.codigo_otros~" )    JOIN (LEFT=~"cuenta_contable_otros.tipo_comprobante~"    OP =~"=~"RIGHT=~"ficha_cuenta_contable_otros.tipo_comprobante~" )WHERE(    EXP1 =~"~~~"FICHA_CUENTA_CONTABLE_OTROS~~~".~~~"TIPO_COMPROBANTE~~~"~"   OP =~"=~"    EXP2 =~":tipo_cob~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FICHA_CUENTA_CONTABLE_OTROS~~~".~~~"TIPO_COBRO_AUX~~~"~"   OP =~"=~"    EXP2 =~":sociedad~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FICHA_CUENTA_CONTABLE_OTROS~~~".~~~"ESTADO_REG~~~"~"   OP =~"=~"    EXP2 =~"'A'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CUENTA_CONTABLE_OTROS~~~".~~~"TIPO_COB~~~"~"   OP =~"=~"    EXP2 =~"'L'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"PRODUCTO_TIPO_SERVICIO~~~".~~~"ESTADO_REGISTRO~~~"~"   OP =~"=~"    EXP2 =~"'V'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"PRODUCTO_TIPO_SERVICIO~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~"1~" ) ) ARG(NAME = ~"uf~" TYPE = number)  ARG(NAME = ~"sociedad~" TYPE = string)  ARG(NAME = ~"tipo_cob~" TYPE = string) " arguments=(("uf", number),("sociedad", string),("tipo_cob", string))  sort="cuenta_contable_otros_codigo_otros A " )
