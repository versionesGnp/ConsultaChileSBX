table(column=(type=char(5) updatewhereclause=yes name=cuenta_contable_otros_codigo_otros dbname="cuenta_contable_otros.codigo_otros" )
 column=(type=char(40) updatewhereclause=yes name=cuenta_contable_otros_descripcion dbname="cuenta_contable_otros.descripcion" )
 column=(type=decimal(4) updatewhereclause=yes name=cuenta_contable_otros_valor dbname="cuenta_contable_otros.valor" )
