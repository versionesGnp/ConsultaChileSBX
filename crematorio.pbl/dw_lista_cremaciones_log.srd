table(column=(type=number updatewhereclause=yes name=correlativo dbname="almacen_cenizas_log.correlativo" dbalias=".correlativo" )
 column=(type=datetime updatewhereclause=yes name=fecha_log dbname="almacen_cenizas_log.fecha_log" dbalias=".fecha_log" )
 column=(type=number updatewhereclause=yes name=niveles dbname="almacen_cenizas_log.niveles" dbalias=".niveles" )
