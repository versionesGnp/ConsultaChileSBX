 column=(type=char(1) updatewhereclause=yes name=base dbname="almacen_cenizas_log.base" dbalias=".base" )
 column=(type=char(1) updatewhereclause=yes name=serie dbname="almacen_cenizas_log.serie" dbalias=".serie" )
