 column=(type=char(50) updatewhereclause=yes name=ap_paterno_fallecido dbname="almacen_cenizas_log.ap_paterno_fallecido" dbalias=".ap_paterno_fallecido" )
 column=(type=char(50) updatewhereclause=yes name=ap_materno_fallecido dbname="almacen_cenizas_log.ap_materno_fallecido" dbalias=".ap_materno_fallecido" )
 column=(type=char(1000) updatewhereclause=yes name=actividad dbname="almacen_cenizas_log.actividad" dbalias=".actividad" )
 column=(type=char(15) updatewhereclause=yes name=usuario dbname="almacen_cenizas_log.usuario" dbalias=".usuario" )
 retrieve="  SELECT ~"ALMACEN_CENIZAS_LOG~".~"CORRELATIVO~",   
         ~"ALMACEN_CENIZAS_LOG~".~"FECHA_LOG~",   
         ~"ALMACEN_CENIZAS_LOG~".~"NIVELES~",   
         ~"ALMACEN_CENIZAS_LOG~".~"RUT_FALLECIDO~",   
         ~"ALMACEN_CENIZAS_LOG~".~"DV~",   
         ~"ALMACEN_CENIZAS_LOG~".~"BASE~",   
         ~"ALMACEN_CENIZAS_LOG~".~"SERIE~",   
         ~"ALMACEN_CENIZAS_LOG~".~"NUMERO~",   
         ~"ALMACEN_CENIZAS_LOG~".~"FECHA_INGRESO_ALMACEN~",   
         ~"ALMACEN_CENIZAS_LOG~".~"FECHA_SALIDA_ALMACEN~",   
         ~"ALMACEN_CENIZAS_LOG~".~"NOMBRE_FALLECIDO~",   
         ~"ALMACEN_CENIZAS_LOG~".~"AP_PATERNO_FALLECIDO~",   
         ~"ALMACEN_CENIZAS_LOG~".~"AP_MATERNO_FALLECIDO~",   
         ~"ALMACEN_CENIZAS_LOG~".~"ACTIVIDAD~",   
         ~"ALMACEN_CENIZAS_LOG~".~"USUARIO~"  
    FROM ~"ALMACEN_CENIZAS_LOG~"   
   WHERE ( to_date(~"ALMACEN_CENIZAS_LOG~".~"FECHA_LOG~") >= :fecha_ini ) AND  
         (to_date(~"ALMACEN_CENIZAS_LOG~".~"FECHA_LOG~") <= :fecha_fin )  
order by ~"ALMACEN_CENIZAS_LOG~".~"CORRELATIVO~" asc" arguments=(("fecha_ini", datetime),("fecha_fin", datetime)) )
