 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"fc_prelacion~" ) COLUMN(NAME=~"fc_prelacion.folio_crematorio~") COLUMN(NAME=~"fc_prelacion.base~") COLUMN(NAME=~"fc_prelacion.serie~") COLUMN(NAME=~"fc_prelacion.numero~") COLUMN(NAME=~"fc_prelacion.estado_reg~") COLUMN(NAME=~"fc_prelacion.parentesco~") COLUMN(NAME=~"fc_prelacion.rut~") COLUMN(NAME=~"fc_prelacion.dv~") COLUMN(NAME=~"fc_prelacion.nombres~") COLUMN(NAME=~"fc_prelacion.apellido_paterno~") COLUMN(NAME=~"fc_prelacion.apellido_materno~") COLUMN(NAME=~"fc_prelacion.tipo_via~") COLUMN(NAME=~"fc_prelacion.direccion~") COLUMN(NAME=~"fc_prelacion.numero_direc~") COLUMN(NAME=~"fc_prelacion.depto_direc~") COLUMN(NAME=~"fc_prelacion.block_direc~") COLUMN(NAME=~"fc_prelacion.ciudad~") COLUMN(NAME=~"fc_prelacion.comuna~") COLUMN(NAME=~"fc_prelacion.telefono_particular~") COLUMN(NAME=~"fc_prelacion.telefono_comercial~") COLUMN(NAME=~"fc_prelacion.celular~") COLUMN(NAME=~"fc_prelacion.correo_electronico~") COLUMN(NAME=~"fc_prelacion.observacion~") COLUMN(NAME=~"fc_prelacion.fecha_crea~") COLUMN(NAME=~"fc_prelacion.usuario_crea~") COLUMN(NAME=~"fc_prelacion.fecha_sistema~")WHERE(    EXP1 =~"~~~"FC_PRELACION~~~".~~~"FOLIO_CREMATORIO~~~"~"   OP =~"=~"    EXP2 =~":folio~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FC_PRELACION~~~".~~~"ESTADO_REG~~~"~"   OP =~"=~"    EXP2 =~"'A'~" ) ) ARG(NAME = ~"folio~" TYPE = number) " update="FC_PRELACION" updatewhere=1 updatekeyinplace=no arguments=(("folio", number)) )
