SANITARIA Y DE ANFORA CON CENIZAS.'"border="0" color="0" x="297" y="276" height="300" width="2949" format="[GENERAL]" html.valueishtml="0"  name=compute_1 visible="1"  font.face="Arial" font.height="-18" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" background.transparency="0" background.gradient.color="8421504" background.gradient.transparency="0" background.gradient.angle="0" background.brushmode="0" background.gradient.repetition.mode="0" background.gradient.repetition.count="0" background.gradient.repetition.length="100" background.gradient.focus="0" background.gradient.scale="100" background.gradient.spread="100" tooltip.backcolor="134217752" tooltip.delay.initial="0" tooltip.delay.visible="32000" tooltip.enabled="0" tooltip.hasclosebutton="0" tooltip.icon="0" tooltip.isbubble="0" tooltip.maxwidth="0" tooltip.textcolor="134217751" tooltip.transparency="0" transparency="0" )
compute(band=detail alignment="3" expression="'En Santiago de Chile, con fecha '+day( fc_cabecera_fecha_ingreso_cinerario )+ ' de '+case( month( fc_cabecera_fecha_ingreso_cinerario ) when 1 then 'Enero' when 2 then 'Febrero' when 3 then 'Marzo' when 4 then 'Abril' when 5 then 'Mayo' when 6 then 'Junio' when 7 then 'Julio' when 8 then 'Agosto' when 9 then 'Septiembre' when 10 then 'Octubre' when 11 then 'Noviembre' when 12 then 'Diciembre') +' de '+year( fc_cabecera_fecha_ingreso_cinerario ) + ', siendo las '+string( fc_cabecera_hora_ingreso_cinerario ,'00')+':'+string( fc_cabecera_minuto_ingreso_cinerario ,'00')+' horas, se procede con la cremación del señor(a), '+  fc_fallecido_nombres + ' ' + fc_fallecido_apellido_paterno  +' '+  fc_fallecido_apellido_materno +' quien falleció el día '+  day(  fc_fallecido_fecha_defuncion  )+ ' de '+case( month(  fc_fallecido_fecha_defuncion  ) when 1 then 'Enero' when 2 then 'Febrero' when 3 then 'Marzo' when 4 then 'Abril' when 5 then 'Mayo' when 6 then 'Junio' when 7 then 'Julio' when 8 then 'Agosto' when 9 then 'Septiembre' when 10 then 'Octubre' when 11 then 'Noviembre' when 12 then 'Diciembre') +' de '+year(  fc_fallecido_fecha_defuncion  )+'.'"border="0" color="0" x="165" y="132" height="296" width="3214" format="[GENERAL]" html.valueishtml="0"  name=compute_2 visible="1"  font.face="Arial" font.height="-12" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" background.transparency="0" background.gradient.color="8421504" background.gradient.transparency="0" background.gradient.angle="0" background.brushmode="0" background.gradient.repetition.mode="0" background.gradient.repetition.count="0" background.gradient.repetition.length="100" background.gradient.focus="0" background.gradient.scale="100" background.gradient.spread="100" tooltip.backcolor="134217752" tooltip.delay.initial="0" tooltip.delay.visible="32000" tooltip.enabled="0" tooltip.hasclosebutton="0" tooltip.icon="0" tooltip.isbubble="0" tooltip.maxwidth="0" tooltip.textcolor="134217751" tooltip.transparency="0" transparency="0"  height.autosize=yes)
compute(band=detail alignment="3" expression="
'La cremación fue solicitada por el (la) señor(a), '+   fc_prelacion_nombres_pre +' '+   fc_prelacion_apellido_paterno_pre +' '+   fc_prelacion_apellido_materno_pre +
', con cédula de identidad nacional N° '+

Replace(
Replace(string(  fc_prelacion_rut_pre  ,'###,###,###,###'), Pos(string(  fc_prelacion_rut_pre  ,'###,###,###,###'), ','), 1, '.')
, Pos(
Replace(string(  fc_prelacion_rut_pre  ,'###,###,###,###'), Pos(string(  fc_prelacion_rut_pre  ,'###,###,###,###'), ','), 1, '.')
, ','), 1, '.')


+'-'+  fc_prelacion_dv_pre  +
', según la resolución N° '+ string(fc_responsable_retiro_nro_resol_cremacion) +', de fecha '+ 

if(
isnull( fc_responsable_retiro_fecha_resolucion ),'S/D',
day(  fc_responsable_retiro_fecha_resolucion  )+ ' de '+case( month(  fc_responsable_retiro_fecha_resolucion  ) when 1 then 'Enero' when 2 then 'Febrero' when 3 then 'Marzo' when 4 then 'Abril' when 5 then 'Mayo' when 6 then 'Junio' when 7 then 'Julio' when 8 then 'Agosto' when 9 then 'Septiembre' when 10 then 'Octubre' when 11 then 'Noviembre' when 12 then 'Diciembre') +' de '+year( fc_responsable_retiro_fecha_resolucion )
)+

' suscrita por el Secretario Regional del Ministerio de Salud de la Región Metropolitana, según consta en dicha Resolución. '

