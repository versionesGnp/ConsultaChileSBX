compute(band=detail alignment="3" expression="'En este acto se hace entrega al cliente de copia de la resolución  N° '+ 

if(isnull(
fc_responsable_retiro_nro_resol_cremacion),'S/D',string(fc_responsable_retiro_nro_resol_cremacion)
)
+
' quien declara en este acto recibirla.'
