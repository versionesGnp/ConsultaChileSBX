 retrieve="  SELECT ~"FC_CABECERA~".~"FOLIO_CREMATORIO~",   
         ~"FC_CABECERA~".~"FECHA_INGRESO_CINERARIO~",   
         ~"FC_CABECERA~".~"HORA_INGRESO_CINERARIO~",   
         ~"FC_CABECERA~".~"MINUTO_INGRESO_CINERARIO~",   
         ~"FC_RESPONSABLE_RETIRO~".~"RUT_RESPONSABLE~",   
         ~"FC_RESPONSABLE_RETIRO~".~"DV_RESPONSABLE~",   
         ~"FC_RESPONSABLE_RETIRO~".~"NOMBRE~",   
         ~"FC_RESPONSABLE_RETIRO~".~"APELLIDO_PATERNO~",   
         ~"FC_RESPONSABLE_RETIRO~".~"APELLIDO_MATERNO~",   
         ~"FC_RESPONSABLE_RETIRO~".~"NRO_RESOL_CREMACION~",   
         ~"FC_RESPONSABLE_RETIRO~".~"NUMERO_ANFORA~",   
         ~"FC_RESPONSABLE_RETIRO~".~"FECHA_RETIRO_CENIZA~",   
         ~"FC_RESPONSABLE_RETIRO~".~"HORA_RETIRO_CENIZA~",   
         ~"FC_RESPONSABLE_RETIRO~".~"MINUTO_RETIRO_CENIZA~",   
         ~"FC_FALLECIDO~".~"NOMBRES~",   
         ~"FC_FALLECIDO~".~"APELLIDO_PATERNO~",   
         ~"FC_FALLECIDO~".~"APELLIDO_MATERNO~",   
         ~"FC_FALLECIDO~".~"FECHA_DEFUNCION~",   
         ~"FC_RESPONSABLE_PARQUE~".~"NOMBRE~",   
         ~"FC_RESPONSABLE_PARQUE~".~"APELLIDO_PATERNO~",   
         ~"FC_RESPONSABLE_PARQUE~".~"APELLIDO_MATERNO~",   
         ~"FC_RESPONSABLE_RETIRO~".~"FONO_1~",   
         ~"FC_RESPONSABLE_RETIRO~".~"FONO_2~",   
         ~"CIUDAD~".~"SIGLA_CIUDAD~",   
         ~"COMUNA~".~"COMUNA~",   
         ~"TIPO_VIA~".~"DESCRIPCION~",   
         ~"FC_FALLECIDO~".~"DIRECCION_FALLECIDO~",   
         ~"FC_FALLECIDO~".~"NUMERO_FALLECIDO~",   
         ~"FC_FALLECIDO~".~"DEPTO_FALLECIDO~",   
         ~"FC_FALLECIDO~".~"BLOCK_FALLECIDO~",  
         ~"FC_PRELACION~".~"RUT~" RUT_PRE,   
         ~"FC_PRELACION~".~"DV~" DV_PRE,   
         ~"FC_PRELACION~".~"NOMBRES~" NOMBRES_PRE,   
         ~"FC_PRELACION~".~"APELLIDO_PATERNO~" APELLIDO_PATERNO_PRE,   
         ~"FC_PRELACION~".~"APELLIDO_MATERNO~" APELLIDO_MATERNO_PRE,    
         ~"FC_PRELACION~".~"DIRECCION~",   
         ~"FC_PRELACION~".~"NUMERO_DIREC~",   
         ~"FC_PRELACION~".~"COMUNA~",   
         ~"FC_PRELACION~".~"CIUDAD~" ,
         ~"FC_TITULAR~".~"NOMBRES~" NOMBRES_T,   
         ~"FC_TITULAR~".~"APELLIDO_PATERNO~" APELLIDO_PATERNO_T,   
         ~"FC_TITULAR~".~"APELLIDO_MATERNO~" APELLIDO_MATERNO_T,   
         ~"FC_TITULAR~".~"RUT_TITULAR~",   
         ~"FC_TITULAR~".~"DV_TITULAR~",
         ~"FC_RESPONSABLE_RETIRO~".~"FECHA_RESOLUCION~"
    FROM ~"FC_CABECERA~",   
         ~"FC_FALLECIDO~",   
         ~"FC_RESPONSABLE_PARQUE~",   
         ~"FC_RESPONSABLE_RETIRO~",   
         ~"CIUDAD~",   
         ~"COMUNA~",   
         ~"TIPO_VIA~",   
         ~"FC_PRELACION~",
         ~"FC_TITULAR~"
   WHERE ( ~"FC_FALLECIDO~".~"FOLIO_CREMATORIO~" = ~"FC_RESPONSABLE_RETIRO~".~"FOLIO_CREMATORIO~" ) and  
         ( ~"FC_CABECERA~".~"FOLIO_CREMATORIO~" = ~"FC_RESPONSABLE_RETIRO~".~"FOLIO_CREMATORIO~" ) and  

         ( ~"FC_FALLECIDO~".~"COMUNA_FALLECIMIENTO~" = ~"COMUNA~".~"CODIGO_COMUNA~" ) and  
      -- ( ~"FC_FALLECIDO~".~"COMUNA_FALLECIMIENTO~" = ~"COMUNA~".~"CODIGO_COMUNA~" ) and  
         ( ~"FC_PRELACION~".~"COMUNA~" = ~"COMUNA~".~"CODIGO_COMUNA~" ) and  


         ( ~"FC_FALLECIDO~".~"CIUDAD_FALLECIMIENTO~" = ~"CIUDAD~".~"CODIGO_CIUDAD~" ) and  
         ( ~"FC_FALLECIDO~".~"TIPO_VIA_FALLECIDO~" = ~"TIPO_VIA~".~"TIPO_VIA~" ) and  
         ( ~"FC_PRELACION~".~"FOLIO_CREMATORIO~" = ~"FC_RESPONSABLE_RETIRO~".~"FOLIO_CREMATORIO~" ) and  
         ( ~"FC_PRELACION~".~"BASE~" = ~"FC_RESPONSABLE_RETIRO~".~"BASE~" ) and  
         ( ~"FC_PRELACION~".~"SERIE~" = ~"FC_RESPONSABLE_RETIRO~".~"SERIE~" ) and  
         ( ~"FC_PRELACION~".~"NUMERO~" = ~"FC_RESPONSABLE_RETIRO~".~"NUMERO~" ) and  
         ( ~"FC_PRELACION~".~"RUT~" = ~"FC_RESPONSABLE_RETIRO~".~"RUT_RESPONSABLE~" ) and  
         ( ~"FC_TITULAR~".~"FOLIO_CREMATORIO~" = ~"FC_CABECERA~".~"FOLIO_CREMATORIO~" ) AND
         ( ( ~"FC_CABECERA~".~"FOLIO_CREMATORIO~" = :folio ) AND  
         ( ~"FC_RESPONSABLE_PARQUE~".~"JEFE_CREMATORIO~" = 'S' ) )    
" arguments=(("folio", number)) )
