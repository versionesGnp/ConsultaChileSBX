compute(band=detail alignment="3" expression="
'Las cenizas son entregadas en este acto al señor(a) , '+
trim( fc_prelacion_nombres_pre ) +' '+ trim( fc_prelacion_apellido_paterno_pre ) +' '+ trim( fc_prelacion_apellido_materno_pre ) +

', cédula nacional de identidad N° '+

Replace(
Replace(string(  fc_responsable_retiro_rut_responsable ,'###,###,###,###'), Pos(string(  fc_responsable_retiro_rut_responsable ,'###,###,###,###'), ','), 1, '.')
, Pos(
Replace(string(  fc_responsable_retiro_rut_responsable ,'###,###,###,###'), Pos(string(  fc_responsable_retiro_rut_responsable ,'###,###,###,###'), ','), 1, '.')
, ','), 1, '.')


+'-'+ fc_responsable_retiro_dv_responsable +
' con domicilio en ' + 
trim(tipo_via_descripcion) +' '+   trim(fc_prelacion_direccion) +' # '+  fc_prelacion_numero_direc +
', comuna de '+   comuna_comuna +', Región '+ ciudad_sigla_ciudad +'. En cofre sellado quien en este acto declara recibirlo a su entera satisfacción.'
