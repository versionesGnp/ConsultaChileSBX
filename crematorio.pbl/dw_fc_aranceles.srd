 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"fc_arancel~" ) COLUMN(NAME=~"fc_arancel.folio_crematorio~") COLUMN(NAME=~"fc_arancel.base~") COLUMN(NAME=~"fc_arancel.serie~") COLUMN(NAME=~"fc_arancel.numero~") COLUMN(NAME=~"fc_arancel.rut_titular~") COLUMN(NAME=~"fc_arancel.tipo_cob~") COLUMN(NAME=~"fc_arancel.folio_pago~") COLUMN(NAME=~"fc_arancel.tipo_mov~") COLUMN(NAME=~"fc_arancel.monto_pago~") COLUMN(NAME=~"fc_arancel.monto_contrato~") COLUMN(NAME=~"fc_arancel.tipo_moneda~") COLUMN(NAME=~"fc_arancel.fecha_pago~") COLUMN(NAME=~"fc_arancel.codigo_otro~") COLUMN(NAME=~"fc_arancel.fecha_crea~") COLUMN(NAME=~"fc_arancel.usuario_crea~") COLUMN(NAME=~"fc_arancel.cod_caja~") COLUMN(NAME=~"fc_arancel.estado_reg~") COMPUTE(NAME=~"'S' AS nuevo~")WHERE(    EXP1 =~"~~~"FC_ARANCEL~~~".~~~"FOLIO_CREMATORIO~~~"~"   OP =~"=~"    EXP2 =~":folio~" ) ) ARG(NAME = ~"folio~" TYPE = number) " update="FC_ARANCEL" updatewhere=0 updatekeyinplace=yes arguments=(("folio", number)) )
