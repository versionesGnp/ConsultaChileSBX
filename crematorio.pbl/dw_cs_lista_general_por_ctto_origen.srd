 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cs_cabecera~" ) COLUMN(NAME=~"cs_cabecera.base~") COLUMN(NAME=~"cs_cabecera.serie~") COLUMN(NAME=~"cs_cabecera.numero~") COLUMN(NAME=~"cs_cabecera.estado_contrato~") COLUMN(NAME=~"cs_cabecera.base_original~") COLUMN(NAME=~"cs_cabecera.serie_original~") COLUMN(NAME=~"cs_cabecera.numero_original~") COLUMN(NAME=~"cs_cabecera.rut~") COLUMN(NAME=~"cs_cabecera.dv~") COLUMN(NAME=~"cs_cabecera.usuario~") COLUMN(NAME=~"cs_cabecera.total_pesos~") COLUMN(NAME=~"cs_cabecera.fecha_crea~") COLUMN(NAME=~"cs_cabecera.fecha_sistema~") COLUMN(NAME=~"cs_cabecera.tipo_cob_aux~") COLUMN(NAME=~"cs_cabecera.tipo_cob~") COLUMN(NAME=~"cs_cabecera.codigo_servicio~") COLUMN(NAME=~"cs_cabecera.uso~") COLUMN(NAME=~"cs_cabecera.cod_parque~") COLUMN(NAME=~"cs_cabecera.depto_usuario~")WHERE(    EXP1 =~"~~~"CS_CABECERA~~~".~~~"BASE_ORIGINAL~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CS_CABECERA~~~".~~~"SERIE_ORIGINAL~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CS_CABECERA~~~".~~~"NUMERO_ORIGINAL~~~"~"   OP =~"=~"    EXP2 =~":numero~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number) " update="CS_CABECERA" updatewhere=1 updatekeyinplace=no arguments=(("base", string),("serie", string),("numero", number))  sort="numero D " )
