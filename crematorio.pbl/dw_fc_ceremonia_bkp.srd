 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"fc_ceremonia~" ) COLUMN(NAME=~"fc_ceremonia.folio_crematorio~") COLUMN(NAME=~"fc_ceremonia.base~") COLUMN(NAME=~"fc_ceremonia.serie~") COLUMN(NAME=~"fc_ceremonia.numero~") COLUMN(NAME=~"fc_ceremonia.estado_reg~") COLUMN(NAME=~"fc_ceremonia.codigo_religion~") COLUMN(NAME=~"fc_ceremonia.codigo_diacono~") COLUMN(NAME=~"fc_ceremonia.codigo_maestro~") COLUMN(NAME=~"fc_ceremonia.observacion~") COMPUTE(NAME=~"'S' AS nuevo~") COLUMN(NAME=~"fc_ceremonia.sw_orador~") COMPUTE(NAME=~"0 AS sw1~") COMPUTE(NAME=~"0 AS sw2~") COMPUTE(NAME=~"0 AS sw3~") COMPUTE(NAME=~"0 AS sw4~")WHERE(    EXP1 =~"~~~"FC_CEREMONIA~~~".~~~"FOLIO_CREMATORIO~~~"~"   OP =~"=~"    EXP2 =~":folio~" ) ) ARG(NAME = ~"folio~" TYPE = number) " update="FC_CEREMONIA" updatewhere=0 updatekeyinplace=yes arguments=(("folio", number)) )
