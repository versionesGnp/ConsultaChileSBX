 retrieve="  SELECT distinct  ~"FC_FALLECIDO~".~"FOLIO_CREMATORIO~",   
         ~"FC_CABECERA~".~"FECHA_CINERACION~",   
         ~"FC_CABECERA~".~"FECHA_INGRESO_CINERARIO~",   
         ~"FC_CABECERA~".~"HORA_CINERACION~",   
         ~"FC_CABECERA~".~"HORA_INGRESO_CINERARIO~",   
         ~"FC_CABECERA~".~"HORNO~",   
         ~"FC_CABECERA~".~"MINUTO_CINERACION~",   
         ~"FC_CABECERA~".~"MINUTO_INGRESO_CINERARIO~",   
         ~"FC_FALLECIDO~".~"ANNOS_DIFUNTO~",   
         ~"FC_FALLECIDO~".~"APELLIDO_MATERNO~",   
         ~"FC_FALLECIDO~".~"APELLIDO_PATERNO~",   
         ~"FC_FALLECIDO~".~"BASE~",   
         ~"FC_FALLECIDO~".~"DV_FALLECIDO~",   
         ~"FC_FALLECIDO~".~"FECHA_DEFUNCION~",   
         ~"FC_FALLECIDO~".~"NOMBRES~",   
         ~"FC_FALLECIDO~".~"NUMERO~",   
         ~"FC_FALLECIDO~".~"RUT_FALLECIDO~",   
         ~"FC_FALLECIDO~".~"SERIE~",   
         ~"FC_RESPONSABLE_RETIRO~".~"APELLIDO_MATERNO~",   
         ~"FC_RESPONSABLE_RETIRO~".~"APELLIDO_PATERNO~",   
         ~"FC_RESPONSABLE_RETIRO~".~"DV_RESPONSABLE~",   
         ~"FC_RESPONSABLE_RETIRO~".~"FECHA_RETIRO_CENIZA~",   
         ~"FC_RESPONSABLE_RETIRO~".~"NOMBRE~",   
         ~"FC_RESPONSABLE_RETIRO~".~"NRO_RESOL_CREMACION~",   
         ~"FC_RESPONSABLE_RETIRO~".~"FECHA_RESOLUCION~",      
         ~"FC_RESPONSABLE_RETIRO~".~"RUT_RESPONSABLE~",   
         ~"COD_PARQ~".~"NOMBRE~"  PARQUE ,         
    CASE 
    WHEN ~"FC_CABECERA~".~"FECHA_INGRESO_CINERARIO~" is null  THEN '00:00'
    ELSE F_175(to_char(~"FC_CABECERA~".~"FECHA_INGRESO_CINERARIO~")||' ' || to_char(~"FC_CABECERA~".~"HORA_INGRESO_CINERARIO~") || ':'|| to_char(~"FC_CABECERA~".~"MINUTO_INGRESO_CINERARIO~")||':00')
    END AS HOR_FIN_CREMACION, 
         ~"FC_RESPONSABLE_RETIRO~".~"NUMERO_ANFORA~"
    FROM ~"FC_RESPONSABLE_RETIRO~",   
         ~"FALLECIDOS_PLANILLA~",   
         ~"FC_FALLECIDO~",   
         ~"FC_CABECERA~",   
         ~"COD_PARQ~"  
   WHERE 
         ( ~"FC_RESPONSABLE_RETIRO~".~"FOLIO_CREMATORIO~" = ~"FC_FALLECIDO~".~"FOLIO_CREMATORIO~" ) and  
         ( ~"FC_CABECERA~".~"FOLIO_CREMATORIO~" = ~"FC_RESPONSABLE_RETIRO~".~"FOLIO_CREMATORIO~" ) and 
         ( ~"FC_CABECERA~".~"COD_PARQUE_DESTINO~" = ~"COD_PARQ~".~"CODIGO~" ) and 
         ( ( ~"FC_FALLECIDO~".~"FOLIO_CREMATORIO~" = :folio ) )    
" arguments=(("folio", number)) )
