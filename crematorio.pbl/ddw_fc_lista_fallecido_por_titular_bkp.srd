 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"ficha_sepultacion~" ) COLUMN(NAME=~"ficha_sepultacion.rut_fallecido~") COLUMN(NAME=~"ficha_sepultacion.dv_fallecido~") COLUMN(NAME=~"ficha_sepultacion.nombre_fallecido~") COLUMN(NAME=~"ficha_sepultacion.ap_paterno_fall~") COLUMN(NAME=~"ficha_sepultacion.ap_materno_fall~") COLUMN(NAME=~"ficha_sepultacion.fecha_defuncion~")WHERE(    EXP1 =~"~~~"FICHA_SEPULTACION~~~".~~~"RUT_TITULAR~~~"~"   OP =~"=~"    EXP2 =~":rut_titular~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FICHA_SEPULTACION~~~".~~~"ESTADO_REG~~~"~"   OP =~"<>~"    EXP2 =~"'A'~" ) ) ARG(NAME = ~"rut_titular~" TYPE = number) " arguments=(("rut_titular", number))  sort="rut_fallecido A " )
