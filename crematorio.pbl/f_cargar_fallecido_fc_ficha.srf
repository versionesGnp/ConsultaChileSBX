global type f_cargar_fallecido_fc_ficha from function_object
end type

forward prototypes
global subroutine f_cargar_fallecido_fc_ficha ()
end prototypes

global subroutine f_cargar_fallecido_fc_ficha ();//Long		ll_fila,ll_llave_fallecido,ll_cod_parque_origen,ll_capacidad,ll_edad
//String		ls_nombre_fallecido,ls_ap_paterno_fallecido,ls_ap_materno_fallecido,ls_area_origen,ls_sector_origen,ls_sepultura_origen,ls_nro_resolucion,&
//			ls_nro_acta,ls_base,ls_serie,ls_cod_registro,ls_observacion,ls_area,ls_nivel,ls_estado_ctto,ls_dv_titular,ls_nom_titular,ls_ap_pat_titular,ls_ap_mat_titular,&
//			ls_tipo_via_titular,ls_direc_titular,ls_nro_direc_titular,ls_depto_titular,ls_block_titular,ls_ciudad_titular,ls_comuna_titular,ls_fono_p_titular,ls_estado_titular,&
//			ls_nro_tecnico,ls_dv_fall,ls_sexo,ls_sector_fc,ls_sepultura_fc
//Datetime	ldt_fecha_traslado,ldt_fecha_resolucion,ldt_fecha_ctto,ldt_fec_nac,ldt_fec_fall
//Double	ll_numero,ll_rut_titular,ll_rut_fall
Long		ll_fila,ll_codigo_funeraria,ll_anno_pase
String		ls_periodo_nacimiento,ls_cod_estado_fall,ls_cod_tamano_cuerpo,ls_cod_obs_cuerpo,ls_causa_fallecimiento,ls_fono_funeraria,ls_cod_registro_pase,ls_registro_pase,ls_sexo_fallecido,ls_pase_sepultacion
Datetime	ldt_fec_sep_ult,ldt_fecha_pase_fall
if isvalid(w_ingreso_ficha_traslado) then
	if isnull(gl_llave_fallecido_fc) then
		ll_fila									= w_lista_fosa_comun_para_fs_parque.dw_lista.getrow()
		if ll_fila > 0 then
			gl_llave_fallecido_fc			= w_lista_fosa_comun_para_fs_parque.dw_lista.getitemnumber(ll_fila,'llave_fallecido')
			gs_nombre_fallecido_fc		= w_lista_fosa_comun_para_fs_parque.dw_lista.getitemstring(ll_fila,'nombre_fallecido')
			gs_ap_paterno_fallecido_fc	= w_lista_fosa_comun_para_fs_parque.dw_lista.getitemstring(ll_fila,'ap_paterno_fallecido')
			gs_ap_materno_fallecido_fc	= w_lista_fosa_comun_para_fs_parque.dw_lista.getitemstring(ll_fila,'ap_materno_fallecido')
			gdt_fecha_traslado_fc		= w_lista_fosa_comun_para_fs_parque.dw_lista.getitemdatetime(ll_fila,'fecha_traslado')
			gl_cod_parque_origen_fc	= w_lista_fosa_comun_para_fs_parque.dw_lista.getitemnumber(ll_fila,'cod_parque_origen')
			gs_area_origen_fc				= w_lista_fosa_comun_para_fs_parque.dw_lista.getitemstring(ll_fila,'area_origen')
			gs_sector_origen_fc			= w_lista_fosa_comun_para_fs_parque.dw_lista.getitemstring(ll_fila,'sector_origen')
			gs_sepultura_origen_fc		= w_lista_fosa_comun_para_fs_parque.dw_lista.getitemstring(ll_fila,'sepultura_origen')
			gs_nro_resolucion_fc			= w_lista_fosa_comun_para_fs_parque.dw_lista.getitemstring(ll_fila,'nro_resolucion')
			gdt_fecha_resolucion_fc		= w_lista_fosa_comun_para_fs_parque.dw_lista.getitemdatetime(ll_fila,'fecha_resolucion')
			gs_nro_acta_fc					= w_lista_fosa_comun_para_fs_parque.dw_lista.getitemstring(ll_fila,'nro_acta')
			gs_base_fc						= w_lista_fosa_comun_para_fs_parque.dw_lista.getitemstring(ll_fila,'base')
			gs_serie_fc						= w_lista_fosa_comun_para_fs_parque.dw_lista.getitemstring(ll_fila,'serie')
			gl_numero_fc					= w_lista_fosa_comun_para_fs_parque.dw_lista.getitemnumber(ll_fila, 'numero')
			gs_cod_registro_fc			= w_lista_fosa_comun_para_fs_parque.dw_lista.getitemstring(ll_fila,'cod_registro')
			gs_observacion_fc				= w_lista_fosa_comun_para_fs_parque.dw_lista.getitemstring(ll_fila,'observacion')
			gs_area_fc						= w_lista_fosa_comun_para_fs_parque.dw_lista.getitemstring(ll_fila,'area')
			gs_sector_fc					= w_lista_fosa_comun_para_fs_parque.dw_lista.getitemstring(ll_fila,'sector')
			gs_sepultura_fc				= w_lista_fosa_comun_para_fs_parque.dw_lista.getitemstring(ll_fila,'sepultura')
			gs_cod_registro_pase_fc		= w_lista_fosa_comun_para_fs_parque.dw_lista.getitemstring(ll_fila,'cod_registro_pase')
			gs_registro_pase_fc			= w_lista_fosa_comun_para_fs_parque.dw_lista.getitemstring(ll_fila,'registro_pase')
			gdt_fecha_pase_fc				= w_lista_fosa_comun_para_fs_parque.dw_lista.getitemdatetime(ll_fila,'fecha_pase')
			gl_anno_pase_fc				= w_lista_fosa_comun_para_fs_parque.dw_lista.getitemnumber(ll_fila,'anno_pase')
			gs_sexo_fallecido_fc			= w_lista_fosa_comun_para_fs_parque.dw_lista.getitemstring(ll_fila,'sexo_fallecido')
			gs_observacion_pase_fc		= w_lista_fosa_comun_para_fs_parque.dw_lista.getitemstring(ll_fila,'observacion_pase')
			gs_cod_estado_fallecido_fc	= w_lista_fosa_comun_para_fs_parque.dw_lista.getitemstring(ll_fila,'cod_estado_fallecido')
			gs_cod_tamano_cuerpo_fc	= w_lista_fosa_comun_para_fs_parque.dw_lista.getitemstring(ll_fila,'cod_tamano_cuerpo')
			gs_cod_obs_cuerpo_fc		= w_lista_fosa_comun_para_fs_parque.dw_lista.getitemstring(ll_fila,'cod_obs_cuerpo')
			gs_causa_fallecimiento_fc	= w_lista_fosa_comun_para_fs_parque.dw_lista.getitemstring(ll_fila,'causa_fallecimiento')

			SELECT 	"FOSA_COMUN"."NIVELES"  
			INTO 		:gs_nivel_fc 
			FROM 	"FOSA_COMUN"  
			WHERE ( "FOSA_COMUN"."COD_PARQUE_ORIGEN" = :gl_cod_parque_origen_fc ) AND  
					  ( "FOSA_COMUN"."AREA_ORIGEN" = :gs_area_origen_fc ) AND  
					  ( "FOSA_COMUN"."SECTOR_ORIGEN" = :gs_sector_origen_fc ) AND  
					  ( "FOSA_COMUN"."SEPULTURA_ORIGEN" = :gs_sepultura_origen_fc ) AND  
					  ( "FOSA_COMUN"."NOMBRE_FALLECIDO" = :gs_nombre_fallecido_fc ) AND  
					  ( "FOSA_COMUN"."AP_PATERNO_FALLECIDO" = :gs_ap_paterno_fallecido_fc ) AND  
					  ( "FOSA_COMUN"."AP_MATERNO_FALLECIDO" = :gs_ap_materno_fallecido_fc ) AND  
					  ( "FOSA_COMUN"."FECHA_TRASLADO" = :gdt_fecha_traslado_fc ) AND  
					  ( "FOSA_COMUN"."CORRELATIVO" = ( 	SELECT 	MIN("FOSA_COMUN"."CORRELATIVO") 
																		FROM 	"FOSA_COMUN" 
																		WHERE 	( "FOSA_COMUN"."COD_PARQUE_ORIGEN" = :gl_cod_parque_origen_fc ) AND
																					( "FOSA_COMUN"."AREA_ORIGEN" = :gs_area_origen_fc ) AND 
																					( "FOSA_COMUN"."SECTOR_ORIGEN" = :gs_sector_origen_fc ) AND 
																					( "FOSA_COMUN"."SEPULTURA_ORIGEN" = :gs_sepultura_origen_fc )  AND
																					( "FOSA_COMUN"."NOMBRE_FALLECIDO" = :gs_nombre_fallecido_fc ) AND  
																					 ( "FOSA_COMUN"."AP_PATERNO_FALLECIDO" = :gs_ap_paterno_fallecido_fc ) AND  
																					 ( "FOSA_COMUN"."AP_MATERNO_FALLECIDO" = :gs_ap_materno_fallecido_fc ) AND  
																					 ( "FOSA_COMUN"."FECHA_TRASLADO" = :gdt_fecha_traslado_fc )   )  )
			USING	sqlca;
//			if sqlca.sqlcode=0 then
				w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'nivel_sepultura_origen',gs_nivel_fc)
				w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'cod_parque_origen',gl_cod_parque_origen_fc)
				w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'nombre_fallecido',gs_nombre_fallecido_fc)
				w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'apellido_paterno_fall',gs_ap_paterno_fallecido_fc)
				w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'apellido_materno_fall',gs_ap_materno_fallecido_fc)
				w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'estado_ctto_fosa','F')
				w_ingreso_ficha_traslado.tab_1.tabpage_3.st_3.text			= 'Ficha de Traslado desde Fosa Común'
				SELECT 	"CADENA"."ESTADO",  	"OFERTA_V"."FECHA",   	"OFERTA_V"."RUT",   	"CLIENTE"."DV",   	"CLIENTE"."NOMBRE",   	"CLIENTE"."A_PATERNO",   	"CLIENTE"."A_MATERNO",   	"CLIENTE"."TIPO_VIA",   	"CLIENTE"."DIRECCION_P",   	"CLIENTE"."NUMERO_PARTICULAR",   	"CLIENTE"."DEPTO_PARTICULAR",   	"CLIENTE"."BLOCK_PARTICULAR",   	"CLIENTE"."CIUDAD",   	"CLIENTE"."COMUNA",   	"CLIENTE"."FONO_P",   	"CLIENTE"."ESTADO_TITULAR",   	"PAGO_OFERTA"."CAPACIDAD",   	"PAGO_OFERTA"."NRO_TECNICO"  	
				INTO 		:gs_estado_ctto_fc,  		:gdt_fecha_ctto_fc,   		:gl_rut_titular_fc,   		:gs_dv_titular_fc,  	:gs_nom_titular_fc,   		:gs_ap_pat_titular_fc,   		:gs_ap_mat_titular_fc, 		:gs_tipo_via_titular_fc, 	:gs_direc_titular_fc,   			:gs_nro_direc_titular_fc,   					:gs_depto_titular_fc,   					:gs_block_titular_fc,  						:gs_ciudad_titular_fc,  	:gs_comuna_titular_fc,  	:gs_fono_p_titular_fc, 	:gs_estado_titular_fc,   				:gl_capacidad_fc,   					:gs_nro_tecnico_fc 
				FROM 	"CADENA",   "CLIENTE",   "OFERTA_V",   "PAGO_OFERTA"  
				WHERE	( "CADENA"."RUT" = "CLIENTE"."RUT" ) and  
							( "OFERTA_V"."SERIE" = "PAGO_OFERTA"."SERIE" ) and  
							( "OFERTA_V"."NRO_OFERTA" = "PAGO_OFERTA"."NRO_OFERTA" ) and  
							( "OFERTA_V"."ULT_FOLIO" = "PAGO_OFERTA"."FOLIO" ) and  
							( "CADENA"."SERIE" = "OFERTA_V"."SERIE" ) and  
							( "CADENA"."NUMERO" = "OFERTA_V"."NRO_OFERTA" ) and  
							( "CADENA"."CODIGO" = "OFERTA_V"."BASE" ) and  
							( ( "CADENA"."CODIGO" = :gs_base_fc ) AND  
							( "CADENA"."SERIE" = :gs_serie_fc ) AND  
							( "CADENA"."NUMERO" = :gl_numero_fc ) AND  
							( "CADENA"."COD_PARQUE" = :gl_cod_parque_origen_fc ) )
				UNION
				SELECT 	"CADENA"."ESTADO",  	"CONTRATO"."FECHA",   "CONTRATO"."RUT",   	"CLIENTE"."DV",   	"CLIENTE"."NOMBRE",   	"CLIENTE"."A_PATERNO",   	"CLIENTE"."A_MATERNO",   	"CLIENTE"."TIPO_VIA",   	"CLIENTE"."DIRECCION_P",   	"CLIENTE"."NUMERO_PARTICULAR",   	"CLIENTE"."DEPTO_PARTICULAR",   	"CLIENTE"."BLOCK_PARTICULAR",   	"CLIENTE"."CIUDAD",   	"CLIENTE"."COMUNA",   	"CLIENTE"."FONO_P",   	"CLIENTE"."ESTADO_TITULAR",   	"CONTRATO"."CAPACIDAD",   	to_char("CONTRATO"."NRO_TEC")
				FROM 	"CADENA",   "CLIENTE",   "CONTRATO"
				WHERE	( "CADENA"."RUT" = "CLIENTE"."RUT" ) and  
							( "CADENA"."SERIE" = "CONTRATO"."SERIE_C" ) and  
							( "CADENA"."NUMERO" = "CONTRATO"."NRO_CONTRATO" ) and  
							( "CADENA"."CODIGO" = :gs_base_fc ) and  
							( ( "CADENA"."SERIE" = :gs_serie_fc ) AND  
							( "CADENA"."NUMERO" = :gl_numero_fc ) AND  
							( "CADENA"."COD_PARQUE" = :gl_cod_parque_origen_fc ) )
				USING	sqlca;
				w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'rut_titular_origen',gl_rut_titular_fc)
				w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'dv_titular_origen',gs_dv_titular_fc)
				w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'nombre_titular_origen',gs_nom_titular_fc)
				w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'apellido_pat_titular_origen',gs_ap_pat_titular_fc)
				w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'apellido_mat_titular_origen',gs_ap_mat_titular_fc)
				w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'tipo_via_origen_titular',gs_tipo_via_titular_fc)
				w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'direccion_titular_origen',gs_direc_titular_fc)
				w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'nro_direc_titular_origen',gs_nro_direc_titular_fc)
				w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'dpto_direc_titular_origen',gs_depto_titular_fc)
				w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'block_direc_titular_origen',gs_block_titular_fc)
				w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'cod_ciudad_titular_origen',gs_ciudad_titular_fc)
				w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'cod_comuna_titular_origen',gs_comuna_titular_fc)
				w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'fono_titular_origen',gs_fono_p_titular_fc)
				w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'fecha_contrato_origen',gdt_fecha_ctto_fc)
				w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'capacidad_origen',gl_capacidad_fc)
				w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'estado_contrato_origen',gs_estado_ctto_fc)
				w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'numero_tecnico_origen',gs_nro_tecnico_fc)
				w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'base_origen',gs_base_fc)
				w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'serie_origen',gs_serie_fc)
				w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'numero_origen',gl_numero_fc)
				w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'sector_origen',gs_sector_fc)
				w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'sepultura_origen',gs_sepultura_fc)
				w_ingreso_ficha_traslado.tab_1.tabpage_1.dw_ant_fall.setitem(1,'nombre_fallecido',gs_nombre_fallecido_fc)
				w_ingreso_ficha_traslado.tab_1.tabpage_1.dw_ant_fall.setitem(1,'apellido_paterno_fall',gs_ap_paterno_fallecido_fc)
				w_ingreso_ficha_traslado.tab_1.tabpage_1.dw_ant_fall.setitem(1,'apellido_materno_fall',gs_ap_materno_fallecido_fc)
				w_ingreso_ficha_traslado.tab_1.tabpage_1.dw_ant_fall.setitem(1,'estado_ctto_fosa','F')
				
				SELECT DISTINCT	"FALLECIDOS"."RUT",  	"FALLECIDOS"."DV",  		"FALLECIDOS"."FEC_NAC", 	"FALLECIDOS"."FEC_FALL",  	"FALLECIDOS"."EDAD",  	"FALLECIDOS"."SEXO"  
				INTO 					:gl_rut_fall_fc,   			:gs_dv_fall_fc,   			:gdt_fec_nac_fc,   				:gdt_fec_fall_fc,   					:gl_edad_fc,   				:gs_sexo_fc  
				FROM 	"FALLECIDOS"  
				WHERE 	"FALLECIDOS"."LLAVE" = :gl_llave_fallecido_fc   ;
	
				w_ingreso_ficha_traslado.tab_1.tabpage_1.dw_ant_fall.setitem(1,'fecha_defuncion',gdt_fec_fall_fc)
				w_ingreso_ficha_traslado.tab_1.tabpage_1.dw_ant_fall.setitem(1,'fecha_nacimiento_fallecido',gdt_fec_nac_fc)
				w_ingreso_ficha_traslado.tab_1.tabpage_1.dw_ant_fall.setitem(1,'rut_fallecido',gl_rut_fall_fc)
				w_ingreso_ficha_traslado.tab_1.tabpage_1.dw_ant_fall.setitem(1,'dv_fallecido',gs_dv_fall_fc)
				w_ingreso_ficha_traslado.tab_1.tabpage_1.dw_ant_fall.setitem(1,'sexo_fallecido',gs_sexo_fc)
				w_ingreso_ficha_traslado.tab_1.tabpage_1.dw_ant_fall.setitem(1,'edad_fallecido',gl_edad_fc)
				w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'fecha_defuncion',gdt_fec_fall_fc)
				w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'fecha_nacimiento_fallecido',gdt_fec_nac_fc)
				w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'rut_fallecido',gl_rut_fall_fc)
				w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'dv_fallecido',gs_dv_fall_fc)
				w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'sexo_fallecido',gs_sexo_fc)
				w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'edad_fallecido',gl_edad_fc)
				w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'fecha_defuncion',gdt_fec_fall_fc)
				w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'fecha_nacimiento_fallecido',gdt_fec_nac_fc)
				w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'rut_fallecido',gl_rut_fall_fc)
				w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'dv_fallecido',gs_dv_fall_fc)
				w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'sexo_fallecido',gs_sexo_fc)
				w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'edad_fallecido',gl_edad_fc)
				w_ingreso_ficha_traslado.tab_1.tabpage_1.dw_ant_fall.setitem(1,'cod_registro_pase',gs_cod_registro_pase_fc)
				w_ingreso_ficha_traslado.tab_1.tabpage_1.dw_ant_fall.setitem(1,'registro_pase',gs_registro_pase_fc)
				w_ingreso_ficha_traslado.tab_1.tabpage_1.dw_ant_fall.setitem(1,'fecha_pase',gdt_fecha_pase_fc)
				w_ingreso_ficha_traslado.tab_1.tabpage_1.dw_ant_fall.setitem(1,'anno_paso',gl_anno_pase_fc)
				w_ingreso_ficha_traslado.tab_1.tabpage_1.dw_ant_fall.setitem(1,'sexo_fallecido',gs_sexo_fallecido_fc)
				w_ingreso_ficha_traslado.tab_1.tabpage_1.dw_ant_fall.setitem(1,'pase_sepultacion',gs_observacion_pase_fc)
				w_ingreso_ficha_traslado.tab_1.tabpage_1.dw_ant_fall.setitem(1,'cod_estado_fallecido',gs_cod_estado_fallecido_fc)
				w_ingreso_ficha_traslado.tab_1.tabpage_1.dw_ant_fall.setitem(1,'cod_tamano_cuerpo',gs_cod_tamano_cuerpo_fc)
				w_ingreso_ficha_traslado.tab_1.tabpage_1.dw_ant_fall.setitem(1,'cod_obs_cuerpo',gs_cod_obs_cuerpo_fc)
				w_ingreso_ficha_traslado.tab_1.tabpage_1.dw_ant_fall.setitem(1,'observacion_fallecido',gs_causa_fallecimiento_fc)
				SELECT DISTINCT 	"FICHA_SEPULTACION"."PERIODO_NACIMIENTO",	"FICHA_SEPULTACION"."FECHA_SEPULTACION",	"FICHA_SEPULTACION"."COD_ESTADO_FALL",  	"FICHA_SEPULTACION"."COD_TAMANO_CUERPO",  	"FICHA_SEPULTACION"."COD_OBS_CUERPO",  		"FICHA_SEPULTACION"."CAUSA_FALLECIMIENTO", 	"FICHA_SEPULTACION"."CODIGO_FUNERARIA",  	"FICHA_SEPULTACION"."FONO_FUNERARIA", 	"FICHA_SEPULTACION"."COD_REGISTRO_PASE",	"FICHA_SEPULTACION"."REGISTRO_PASE",	"FICHA_SEPULTACION"."FECHA_PASE",	"FICHA_SEPULTACION"."ANNO_PASE",	"FICHA_SEPULTACION"."SEXO_FALLECIDO",	"FICHA_SEPULTACION"."PASE_SEPULTACION"  
				INTO						:ls_periodo_nacimiento,									:ldt_fec_sep_ult,											:ls_cod_estado_fall,										:ls_cod_tamano_cuerpo,										:ls_cod_obs_cuerpo,										:ls_causa_fallecimiento,										:ll_codigo_funeraria,										:ls_fono_funeraria,									:ls_cod_registro_pase,									:ls_registro_pase,									:ldt_fecha_pase_fall,							:ll_anno_pase,									:ls_sexo_fallecido,										:ls_pase_sepultacion
				FROM 		  "FICHA_SEPULTACION"  
				WHERE 		( "FICHA_SEPULTACION"."RUT_FALLECIDO" = :gl_rut_fall_fc ) AND  
								("FICHA_SEPULTACION"."ESTADO_REG" = 'P' OR  "FICHA_SEPULTACION"."ESTADO_REG" = 'G')  
				USING		sqlca;
				if sqlca.sqlcode=0 then
					w_ingreso_ficha_traslado.tab_1.tabpage_1.dw_ant_fall.setitem(1,'cod_estado_fallecido',ls_cod_estado_fall)
					w_ingreso_ficha_traslado.tab_1.tabpage_1.dw_ant_fall.setitem(1,'cod_tamano_cuerpo',ls_cod_tamano_cuerpo)
					w_ingreso_ficha_traslado.tab_1.tabpage_1.dw_ant_fall.setitem(1,'cod_obs_cuerpo',ls_cod_obs_cuerpo)
					w_ingreso_ficha_traslado.tab_1.tabpage_1.dw_ant_fall.setitem(1,'observacion_fallecido',ls_causa_fallecimiento)
					w_ingreso_ficha_traslado.tab_1.tabpage_1.dw_ant_fall.setitem(1,'codigo_funeraria',ll_codigo_funeraria)
					w_ingreso_ficha_traslado.tab_1.tabpage_1.dw_ant_fall.setitem(1,'fono_funeraria',ls_fono_funeraria)
					w_ingreso_ficha_traslado.tab_1.tabpage_1.dw_ant_fall.setitem(1,'cod_registro_pase',ls_cod_registro_pase)
					w_ingreso_ficha_traslado.tab_1.tabpage_1.dw_ant_fall.setitem(1,'registro_pase',ls_registro_pase)
					w_ingreso_ficha_traslado.tab_1.tabpage_1.dw_ant_fall.setitem(1,'fecha_pase',ldt_fecha_pase_fall)
					w_ingreso_ficha_traslado.tab_1.tabpage_1.dw_ant_fall.setitem(1,'anno_paso',ll_anno_pase)
					w_ingreso_ficha_traslado.tab_1.tabpage_1.dw_ant_fall.setitem(1,'sexo_fallecido',ls_sexo_fallecido)
					w_ingreso_ficha_traslado.tab_1.tabpage_1.dw_ant_fall.setitem(1,'pase_sepultacion',ls_pase_sepultacion)
					w_ingreso_ficha_traslado.tab_1.tabpage_1.dw_ant_fall.setitem(1,'periodo_nacimiento',ls_periodo_nacimiento)
				end if
				w_ingreso_ficha_traslado.tab_1.tabpage_1.dw_ant_fall.accepttext()
				w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.accepttext()
				close(w_lista_fosa_comun_para_fs)
//			end if
		end if
	else
		w_ingreso_ficha_traslado.tab_1.tabpage_3.st_3.text				= 'Ficha de Traslado desde Fosa Común'
		w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'nivel_sepultura_origen',gs_nivel_fc)
		w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'cod_parque_origen',gl_cod_parque_origen_fc)
		w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'nombre_fallecido',gs_nombre_fallecido_fc)
		w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'apellido_paterno_fall',gs_ap_paterno_fallecido_fc)
		w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'apellido_materno_fall',gs_ap_materno_fallecido_fc)
		w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'rut_titular_origen',gl_rut_titular_fc)
		w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'dv_titular_origen',gs_dv_titular_fc)
		w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'nombre_titular_origen',gs_nom_titular_fc)
		w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'apellido_pat_titular_origen',gs_ap_pat_titular_fc)
		w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'apellido_mat_titular_origen',gs_ap_mat_titular_fc)
		w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'tipo_via_origen_titular',gs_tipo_via_titular_fc)
		w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'direccion_titular_origen',gs_direc_titular_fc)
		w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'nro_direc_titular_origen',gs_nro_direc_titular_fc)
		w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'dpto_direc_titular_origen',gs_depto_titular_fc)
		w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'block_direc_titular_origen',gs_block_titular_fc)
		w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'cod_ciudad_titular_origen',gs_ciudad_titular_fc)
		w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'cod_comuna_titular_origen',gs_comuna_titular_fc)
		w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'fono_titular_origen',gs_fono_p_titular_fc)
		w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'fecha_contrato_origen',gdt_fecha_ctto_fc)
		w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'capacidad_origen',gl_capacidad_fc)
		w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'estado_contrato_origen',gs_estado_ctto_fc)
		w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'numero_tecnico_origen',gs_nro_tecnico_fc)
		w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'base_origen',gs_base_fc)
		w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'serie_origen',gs_serie_fc)
		w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'numero_origen',gl_numero_fc)
		w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'sector_origen',gs_sector_fc)
		w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'sepultura_origen',gs_sepultura_fc)
		w_ingreso_ficha_traslado.tab_1.tabpage_1.dw_ant_fall.setitem(1,'nombre_fallecido',gs_nombre_fallecido_fc)
		w_ingreso_ficha_traslado.tab_1.tabpage_1.dw_ant_fall.setitem(1,'apellido_paterno_fall',gs_ap_paterno_fallecido_fc)
		w_ingreso_ficha_traslado.tab_1.tabpage_1.dw_ant_fall.setitem(1,'apellido_materno_fall',gs_ap_materno_fallecido_fc)
		w_ingreso_ficha_traslado.tab_1.tabpage_1.dw_ant_fall.setitem(1,'fecha_defuncion',gdt_fec_fall_fc)
		w_ingreso_ficha_traslado.tab_1.tabpage_1.dw_ant_fall.setitem(1,'fecha_nacimiento_fallecido',gdt_fec_nac_fc)
		w_ingreso_ficha_traslado.tab_1.tabpage_1.dw_ant_fall.setitem(1,'rut_fallecido',gl_rut_fall_fc)
		w_ingreso_ficha_traslado.tab_1.tabpage_1.dw_ant_fall.setitem(1,'dv_fallecido',gs_dv_fall_fc)
		w_ingreso_ficha_traslado.tab_1.tabpage_1.dw_ant_fall.setitem(1,'sexo_fallecido',gs_sexo_fc)
		w_ingreso_ficha_traslado.tab_1.tabpage_1.dw_ant_fall.setitem(1,'edad_fallecido',gl_edad_fc)
		w_ingreso_ficha_traslado.tab_1.tabpage_1.dw_ant_fall.setitem(1,'cod_registro_pase',gs_cod_registro_pase_fc)
		w_ingreso_ficha_traslado.tab_1.tabpage_1.dw_ant_fall.setitem(1,'registro_pase',gs_registro_pase_fc)
		w_ingreso_ficha_traslado.tab_1.tabpage_1.dw_ant_fall.setitem(1,'fecha_pase',gdt_fecha_pase_fc)
		w_ingreso_ficha_traslado.tab_1.tabpage_1.dw_ant_fall.setitem(1,'anno_paso',gl_anno_pase_fc)
		w_ingreso_ficha_traslado.tab_1.tabpage_1.dw_ant_fall.setitem(1,'sexo_fallecido',gs_sexo_fallecido_fc)
		w_ingreso_ficha_traslado.tab_1.tabpage_1.dw_ant_fall.setitem(1,'pase_sepultacion',gs_observacion_pase_fc)
		w_ingreso_ficha_traslado.tab_1.tabpage_1.dw_ant_fall.setitem(1,'cod_estado_fallecido',gs_cod_estado_fallecido_fc)
		w_ingreso_ficha_traslado.tab_1.tabpage_1.dw_ant_fall.setitem(1,'cod_tamano_cuerpo',gs_cod_tamano_cuerpo_fc)
		w_ingreso_ficha_traslado.tab_1.tabpage_1.dw_ant_fall.setitem(1,'cod_obs_cuerpo',gs_cod_obs_cuerpo_fc)
		w_ingreso_ficha_traslado.tab_1.tabpage_1.dw_ant_fall.setitem(1,'observacion_fallecido',gs_causa_fallecimiento_fc)
		w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'fecha_defuncion',gdt_fec_fall_fc)
		w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'fecha_nacimiento_fallecido',gdt_fec_nac_fc)
		w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'rut_fallecido',gl_rut_fall_fc)
		w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'dv_fallecido',gs_dv_fall_fc)
		w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'sexo_fallecido',gs_sexo_fc)
		w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'edad_fallecido',gl_edad_fc)
		w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'fecha_defuncion',gdt_fec_fall_fc)
		w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'fecha_nacimiento_fallecido',gdt_fec_nac_fc)
		w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'rut_fallecido',gl_rut_fall_fc)
		w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'dv_fallecido',gs_dv_fall_fc)
		w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'sexo_fallecido',gs_sexo_fc)
		w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.setitem(1,'edad_fallecido',gl_edad_fc)
		w_ingreso_ficha_traslado.tab_1.tabpage_3.dw_ficha_sepult.accepttext()
		w_ingreso_ficha_traslado.tab_1.tabpage_1.dw_ant_fall.accepttext()
	end if
end if
end subroutine

