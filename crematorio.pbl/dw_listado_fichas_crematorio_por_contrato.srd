 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cadena~" )  TABLE(NAME=~"fc_cabecera~" )  TABLE(NAME=~"fc_titular~" )  TABLE(NAME=~"fc_fallecido~" )  TABLE(NAME=~"fc_estado_gestion~" )  TABLE(NAME=~"fc_responsable_retiro~" ) COLUMN(NAME=~"fc_cabecera.folio_crematorio~") COLUMN(NAME=~"fc_cabecera.estado_gestion~") COLUMN(NAME=~"fc_estado_gestion.descripcion~") COLUMN(NAME=~"fc_cabecera.base~") COLUMN(NAME=~"fc_cabecera.serie~") COLUMN(NAME=~"fc_cabecera.numero~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"fc_cabecera.rut_titular~") COLUMN(NAME=~"fc_titular.dv_titular~") COLUMN(NAME=~"fc_titular.nombres~") COLUMN(NAME=~"fc_titular.apellido_paterno~") COLUMN(NAME=~"fc_titular.apellido_materno~") COLUMN(NAME=~"fc_titular.celular~") COLUMN(NAME=~"fc_fallecido.rut_fallecido~") COLUMN(NAME=~"fc_fallecido.dv_fallecido~") COLUMN(NAME=~"fc_fallecido.nombres~") COLUMN(NAME=~"fc_fallecido.apellido_paterno~") COLUMN(NAME=~"fc_fallecido.apellido_materno~") COLUMN(NAME=~"fc_fallecido.fecha_defuncion~") COLUMN(NAME=~"fc_fallecido.fecha_nacimiento~") COLUMN(NAME=~"fc_fallecido.estado_cuerpo~") COLUMN(NAME=~"fc_responsable_retiro.rut_responsable~") COLUMN(NAME=~"fc_responsable_retiro.dv_responsable~") COLUMN(NAME=~"fc_responsable_retiro.nombre~") COLUMN(NAME=~"fc_responsable_retiro.apellido_paterno~") COLUMN(NAME=~"fc_responsable_retiro.apellido_materno~") COLUMN(NAME=~"fc_responsable_retiro.fono_1~") COLUMN(NAME=~"fc_responsable_retiro.fono_2~") COLUMN(NAME=~"fc_responsable_retiro.fecha_retiro_ceniza~") COLUMN(NAME=~"fc_responsable_retiro.hora_retiro_ceniza~") COLUMN(NAME=~"fc_responsable_retiro.minuto_retiro_ceniza~") COLUMN(NAME=~"fc_responsable_retiro.nro_resol_cremacion~") COLUMN(NAME=~"fc_responsable_retiro.numero_anfora~")    JOIN (LEFT=~"fc_cabecera.folio_crematorio~"    OP =~"=~"RIGHT=~"fc_titular.folio_crematorio~"    OUTER1 =~"fc_cabecera.folio_crematorio~" )    JOIN (LEFT=~"fc_cabecera.folio_crematorio~"    OP =~"=~"RIGHT=~"fc_fallecido.folio_crematorio~"    OUTER1 =~"fc_cabecera.folio_crematorio~" )    JOIN (LEFT=~"fc_cabecera.folio_crematorio~"    OP =~"=~"RIGHT=~"fc_responsable_retiro.folio_crematorio~"    OUTER1 =~"fc_cabecera.folio_crematorio~" )   JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"fc_cabecera.serie~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"fc_cabecera.base~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"fc_cabecera.numero~" )    JOIN (LEFT=~"fc_cabecera.estado_gestion~"    OP =~"=~"RIGHT=~"fc_estado_gestion.estado_gestion~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number) " arguments=(("base", string),("serie", string),("numero", number))  sort="fc_cabecera_folio_crematorio A " )
