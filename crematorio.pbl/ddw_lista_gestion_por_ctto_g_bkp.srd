 column=(type=decimal(4) updatewhereclause=yes name=producto_tipo_servicio_cant_correlativo_fc dbname="producto_tipo_servicio_cant.correlativo_fc" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"fc_cabecera~" )  TABLE(NAME=~"fc_estado_gestion~" )  TABLE(NAME=~"producto_anexo~" )  TABLE(NAME=~"producto_pago~" )  TABLE(NAME=~"producto_tipo_servicio_cant~" ) COLUMN(NAME=~"fc_cabecera.folio_crematorio~") COLUMN(NAME=~"fc_cabecera.estado_gestion~") COLUMN(NAME=~"fc_estado_gestion.descripcion~") COLUMN(NAME=~"producto_tipo_servicio_cant.cantidad_fc~") COLUMN(NAME=~"producto_tipo_servicio_cant.correlativo_fc~")    JOIN (LEFT=~"fc_cabecera.estado_gestion~"    OP =~"=~"RIGHT=~"fc_estado_gestion.estado_gestion~"    OUTER1 =~"fc_cabecera.estado_gestion~" )    JOIN (LEFT=~"producto_pago.base~"    OP =~"=~"RIGHT=~"fc_cabecera.base~"    OUTER1 =~"producto_pago.base~" )    JOIN (LEFT=~"producto_pago.serie~"    OP =~"=~"RIGHT=~"fc_cabecera.serie~"    OUTER1 =~"producto_pago.serie~" )    JOIN (LEFT=~"producto_pago.numero~"    OP =~"=~"RIGHT=~"fc_cabecera.numero~"    OUTER1 =~"producto_pago.numero~" )    JOIN (LEFT=~"producto_anexo.base~"    OP =~"=~"RIGHT=~"producto_pago.base~" )    JOIN (LEFT=~"producto_anexo.serie~"    OP =~"=~"RIGHT=~"producto_pago.serie~" )    JOIN (LEFT=~"producto_anexo.numero~"    OP =~"=~"RIGHT=~"producto_pago.numero~" )    JOIN (LEFT=~"producto_anexo.ult_folio~"    OP =~"=~"RIGHT=~"producto_pago.folio~" )    JOIN (LEFT=~"producto_pago.serie~"    OP =~"=~"RIGHT=~"producto_tipo_servicio_cant.serie~" )    JOIN (LEFT=~"producto_pago.codigo_servicio~"    OP =~"=~"RIGHT=~"producto_tipo_servicio_cant.codigo_servicio~" )WHERE(    EXP1 =~"~~~"PRODUCTO_ANEXO~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"PRODUCTO_ANEXO~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"PRODUCTO_ANEXO~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number) " arguments=(("base", string),("serie", string),("numero", number))  sort="fc_cabecera_folio_crematorio A " )
