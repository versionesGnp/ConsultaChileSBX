 column=(type=char(1) updatewhereclause=yes name=cadena_codigo dbname="cadena.codigo" dbalias=".codigo" )
 column=(type=char(1) updatewhereclause=yes name=cadena_serie dbname="cadena.serie" dbalias=".serie" )
 column=(type=decimal(4) updatewhereclause=yes name=cadena_numero dbname="cadena.numero" dbalias=".numero" )
 column=(type=datetime updatewhereclause=yes name=producto_pago_fecha dbname="producto_pago.fecha" dbalias=".fecha" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"producto_anexo~" )  TABLE(NAME=~"producto_pago~" )  TABLE(NAME=~"producto_tipo_servicio~" )  TABLE(NAME=~"producto_tipo_servicio_cant~" )  TABLE(NAME=~"fc_cabecera~" )  TABLE(NAME=~"cliente~" )  TABLE(NAME=~"cadena~" ) COLUMN(NAME=~"producto_anexo.base~") COLUMN(NAME=~"producto_anexo.serie~") COLUMN(NAME=~"producto_anexo.numero~") COLUMN(NAME=~"producto_pago.codigo_servicio~") COLUMN(NAME=~"producto_tipo_servicio.descripcion~") COLUMN(NAME=~"producto_tipo_servicio.cantidad_fc~") COLUMN(NAME=~"producto_tipo_servicio_cant.correlativo_fc~") COLUMN(NAME=~"fc_cabecera.correlativo_fc~") COLUMN(NAME=~"fc_cabecera.estado_gestion~") COLUMN(NAME=~"fc_cabecera.folio_crematorio~") COLUMN(NAME=~"fc_cabecera.estado_reg~") COLUMN(NAME=~"producto_anexo.rut~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"cadena.serie~") COLUMN(NAME=~"cadena.numero~") COLUMN(NAME=~"producto_pago.fecha~")    JOIN (LEFT=~"producto_anexo.base~"    OP =~"=~"RIGHT=~"fc_cabecera.base~"    OUTER1 =~"producto_anexo.base~" )    JOIN (LEFT=~"producto_anexo.serie~"    OP =~"=~"RIGHT=~"fc_cabecera.serie~"    OUTER1 =~"producto_anexo.serie~" )    JOIN (LEFT=~"producto_anexo.numero~"    OP =~"=~"RIGHT=~"fc_cabecera.numero~"    OUTER1 =~"producto_anexo.numero~" )    JOIN (LEFT=~"producto_tipo_servicio_cant.correlativo_fc~"    OP =~"=~"RIGHT=~"fc_cabecera.correlativo_fc~"    OUTER1 =~"producto_tipo_servicio_cant.correlativo_fc~" )    JOIN (LEFT=~"producto_anexo.base~"    OP =~"=~"RIGHT=~"producto_pago.base~" )    JOIN (LEFT=~"producto_tipo_servicio.codigo_servicio~"    OP =~"=~"RIGHT=~"producto_tipo_servicio_cant.codigo_servicio~" )    JOIN (LEFT=~"producto_anexo.serie~"    OP =~"=~"RIGHT=~"producto_pago.serie~" )    JOIN (LEFT=~"producto_anexo.numero~"    OP =~"=~"RIGHT=~"producto_pago.numero~" )    JOIN (LEFT=~"producto_pago.codigo_servicio~"    OP =~"=~"RIGHT=~"producto_tipo_servicio.codigo_servicio~" )    JOIN (LEFT=~"producto_anexo.rut~"    OP =~"=~"RIGHT=~"cliente.rut~" )    JOIN (LEFT=~"producto_anexo.base~"    OP =~"=~"RIGHT=~"cadena.codigo~" )    JOIN (LEFT=~"producto_anexo.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"producto_anexo.numero~"    OP =~"=~"RIGHT=~"cadena.numero~" )WHERE(    EXP1 =~"~~~"PRODUCTO_ANEXO~~~".~~~"RUT~~~"~"   OP =~"=~"    EXP2 =~":rut~" ) ) ARG(NAME = ~"rut~" TYPE = number) " arguments=(("rut", number))  sort="producto_anexo_base A producto_anexo_numero A producto_anexo_serie A " )
