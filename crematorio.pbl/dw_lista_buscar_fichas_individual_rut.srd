table(column=(type=char(1) updatewhereclause=yes name=producto_anexo_base dbname="producto_anexo.base" dbalias=".base" )
 column=(type=char(1) updatewhereclause=yes name=producto_anexo_serie dbname="producto_anexo.serie" dbalias=".serie" )
 column=(type=decimal(4) updatewhereclause=yes name=producto_anexo_numero dbname="producto_anexo.numero" dbalias=".numero" )
 column=(type=decimal(4) updatewhereclause=yes name=producto_pago_codigo_servicio dbname="producto_pago.codigo_servicio" dbalias=".codigo_servicio" )
