 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"producto_anexo~" )  TABLE(NAME=~"producto_pago~" )  TABLE(NAME=~"producto_tipo_servicio~" )  TABLE(NAME=~"producto_tipo_servicio_cant~" )  TABLE(NAME=~"fc_cabecera~" )  TABLE(NAME=~"fc_estado_gestion~" ) COLUMN(NAME=~"producto_anexo.base~") COLUMN(NAME=~"producto_anexo.serie~") COLUMN(NAME=~"producto_anexo.numero~") COLUMN(NAME=~"producto_pago.codigo_servicio~") COLUMN(NAME=~"producto_tipo_servicio.descripcion~") COLUMN(NAME=~"producto_tipo_servicio.cantidad_fc~") COLUMN(NAME=~"producto_tipo_servicio_cant.correlativo_fc~") COLUMN(NAME=~"fc_cabecera.correlativo_fc~") COLUMN(NAME=~"fc_cabecera.estado_gestion~") COLUMN(NAME=~"fc_cabecera.folio_crematorio~") COLUMN(NAME=~"fc_cabecera.estado_reg~") COLUMN(NAME=~"fc_estado_gestion.descripcion~")    JOIN (LEFT=~"producto_anexo.base~"    OP =~"=~"RIGHT=~"fc_cabecera.base~"    OUTER1 =~"producto_anexo.base~" )    JOIN (LEFT=~"producto_anexo.serie~"    OP =~"=~"RIGHT=~"fc_cabecera.serie~"    OUTER1 =~"producto_anexo.serie~" )    JOIN (LEFT=~"producto_anexo.numero~"    OP =~"=~"RIGHT=~"fc_cabecera.numero~"    OUTER1 =~"producto_anexo.numero~" )    JOIN (LEFT=~"producto_tipo_servicio_cant.correlativo_fc~"    OP =~"=~"RIGHT=~"fc_cabecera.correlativo_fc~"    OUTER1 =~"producto_tipo_servicio_cant.correlativo_fc~" )    JOIN (LEFT=~"fc_cabecera.estado_gestion~"    OP =~"=~"RIGHT=~"fc_estado_gestion.estado_gestion~"    OUTER1 =~"fc_cabecera.estado_gestion~" )   JOIN (LEFT=~"producto_anexo.base~"    OP =~"=~"RIGHT=~"producto_pago.base~" )    JOIN (LEFT=~"producto_tipo_servicio.codigo_servicio~"    OP =~"=~"RIGHT=~"producto_tipo_servicio_cant.codigo_servicio~" )    JOIN (LEFT=~"producto_anexo.serie~"    OP =~"=~"RIGHT=~"producto_pago.serie~" )    JOIN (LEFT=~"producto_anexo.numero~"    OP =~"=~"RIGHT=~"producto_pago.numero~" )    JOIN (LEFT=~"producto_pago.codigo_servicio~"    OP =~"=~"RIGHT=~"producto_tipo_servicio.codigo_servicio~" ) WHERE(    EXP1 =~"~~~"PRODUCTO_ANEXO~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"PRODUCTO_ANEXO~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"PRODUCTO_ANEXO~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number) " arguments=(("base", string),("serie", string),("numero", number))  sort="producto_tipo_servicio_cant_correlativo_fc A " )
