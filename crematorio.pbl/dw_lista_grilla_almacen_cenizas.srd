table(column=(type=number updatewhereclause=yes name=niveles dbname="almacen_cenizas.niveles" dbalias=".niveles" )
 column=(type=number updatewhereclause=yes name=rut_fallecido dbname="almacen_cenizas.rut_fallecido" dbalias=".rut_fallecido" )
