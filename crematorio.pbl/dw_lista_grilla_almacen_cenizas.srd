 column=(type=char(50) updatewhereclause=yes name=ap_materno_fallecido dbname="almacen_cenizas.ap_materno_fallecido" dbalias=".ap_materno_fallecido" )
 column=(type=datetime updatewhereclause=yes name=fc_cabecera_fecha_ingreso_cinerario dbname="fc_cabecera.fecha_ingreso_cinerario" dbalias=".fecha_ingreso_cinerario" )
 column=(type=decimal(4) updatewhereclause=yes name=fc_cabecera_hora_ingreso_cinerario dbname="fc_cabecera.hora_ingreso_cinerario" dbalias=".hora_ingreso_cinerario" )
 column=(type=decimal(4) updatewhereclause=yes name=fc_cabecera_minuto_ingreso_cinerario dbname="fc_cabecera.minuto_ingreso_cinerario" dbalias=".minuto_ingreso_cinerario" )
 column=(type=number updatewhereclause=yes name=almacen_cenizas_numero_folio dbname="almacen_cenizas.numero_folio" dbalias=".numero_folio" )
 retrieve="  SELECT ~"ALMACEN_CENIZAS~".~"NIVELES~",   
         ~"ALMACEN_CENIZAS~".~"RUT_FALLECIDO~",   
         ~"ALMACEN_CENIZAS~".~"DV~",   
         ~"ALMACEN_CENIZAS~".~"BASE~",   
         ~"ALMACEN_CENIZAS~".~"SERIE~",   
         ~"ALMACEN_CENIZAS~".~"NUMERO~",   
         ~"ALMACEN_CENIZAS~".~"FECHA_INGRESO_ALMACEN~",   
         ~"ALMACEN_CENIZAS~".~"FECHA_SALIDA_ALMACEN~",   
         ~"ALMACEN_CENIZAS~".~"NOMBRE_FALLECIDO~",   
         ~"ALMACEN_CENIZAS~".~"AP_PATERNO_FALLECIDO~",   
         ~"ALMACEN_CENIZAS~".~"AP_MATERNO_FALLECIDO~" ,
         ~"FC_CABECERA~".~"FECHA_INGRESO_CINERARIO~", 
         ~"FC_CABECERA~".~"HORA_INGRESO_CINERARIO~",
         ~"FC_CABECERA~".~"MINUTO_INGRESO_CINERARIO~",   
         ~"ALMACEN_CENIZAS~".~"NUMERO_FOLIO~"
    FROM 
    ~"ALMACEN_CENIZAS~"  LEFT JOIN  ~"FC_CABECERA~"
    ON 
    ~"FC_CABECERA~".~"BASE~" = ~"ALMACEN_CENIZAS~".~"BASE~" AND 
    ~"FC_CABECERA~".~"SERIE~" = ~"ALMACEN_CENIZAS~".~"SERIE~" AND 
    ~"FC_CABECERA~".~"NUMERO~" = ~"ALMACEN_CENIZAS~".~"NUMERO~" AND 
    ~"FC_CABECERA~".~"RUT_FALLECIDO~" = ~"ALMACEN_CENIZAS~".~"RUT_FALLECIDO~"
    ORDER BY ~"ALMACEN_CENIZAS~".~"NIVELES~"

" )
