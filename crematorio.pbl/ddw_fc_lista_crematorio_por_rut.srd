 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"fc_cabecera~" )  TABLE(NAME=~"fc_fallecido~" ) COLUMN(NAME=~"fc_cabecera.folio_crematorio~") COLUMN(NAME=~"fc_cabecera.base~") COLUMN(NAME=~"fc_cabecera.serie~") COLUMN(NAME=~"fc_cabecera.numero~") COLUMN(NAME=~"fc_fallecido.rut_fallecido~") COLUMN(NAME=~"fc_fallecido.dv_fallecido~") COLUMN(NAME=~"fc_fallecido.nombres~") COLUMN(NAME=~"fc_fallecido.apellido_paterno~") COLUMN(NAME=~"fc_fallecido.apellido_materno~") COLUMN(NAME=~"fc_cabecera.estado_reg~")    JOIN (LEFT=~"fc_cabecera.folio_crematorio~"    OP =~"=~"RIGHT=~"fc_fallecido.folio_crematorio~" )WHERE(    EXP1 =~"~~~"FC_CABECERA~~~".~~~"RUT_TITULAR~~~"~"   OP =~"=~"    EXP2 =~":rut_titular~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FC_CABECERA~~~".~~~"ESTADO_REG~~~"~"   OP =~"<>~"    EXP2 =~"'A'~" ) ) ARG(NAME = ~"rut_titular~" TYPE = number) " arguments=(("rut_titular", number))  sort="fc_cabecera_folio_crematorio A " )
