 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"fc_cabecera~" ) COLUMN(NAME=~"fc_cabecera.folio_crematorio~") COLUMN(NAME=~"fc_cabecera.base~") COLUMN(NAME=~"fc_cabecera.serie~") COLUMN(NAME=~"fc_cabecera.numero~") COLUMN(NAME=~"fc_cabecera.rut_titular~") COLUMN(NAME=~"fc_cabecera.tipo_origen~") COLUMN(NAME=~"fc_cabecera.tipo_solicitud_origen~") COLUMN(NAME=~"fc_cabecera.origen_contrato~") COLUMN(NAME=~"fc_cabecera.forma_venta~") COLUMN(NAME=~"fc_cabecera.estado_pago~") COLUMN(NAME=~"fc_cabecera.estado_documento~") COLUMN(NAME=~"fc_cabecera.prelacion~") COLUMN(NAME=~"fc_cabecera.documentos~") COLUMN(NAME=~"fc_cabecera.recepcion_cuerpo~") COLUMN(NAME=~"fc_cabecera.solicitud_cineracion_seremi~") COLUMN(NAME=~"fc_cabecera.recepcion_servicio~") COLUMN(NAME=~"fc_cabecera.destino_cuerpo~") COLUMN(NAME=~"fc_cabecera.agenda_crematorio~") COLUMN(NAME=~"fc_cabecera.agenda_visualizacion~") COLUMN(NAME=~"fc_cabecera.agenda_entrega_ceniza~") COLUMN(NAME=~"fc_cabecera.cierre_ficha_creamacion~") COLUMN(NAME=~"fc_cabecera.estado_reg~") COLUMN(NAME=~"fc_cabecera.fecha_crea~") COLUMN(NAME=~"fc_cabecera.usuario_crea~") COLUMN(NAME=~"fc_cabecera.estado_gestion~") COLUMN(NAME=~"fc_cabecera.responsable_retiro~") COMPUTE(NAME=~"'S' AS nuevo~") COLUMN(NAME=~"fc_cabecera.cod_parque_origen~") COLUMN(NAME=~"fc_cabecera.cod_parque_destino~") COLUMN(NAME=~"fc_cabecera.base_origen~") COLUMN(NAME=~"fc_cabecera.serie_origen~") COLUMN(NAME=~"fc_cabecera.numero_origen~") COLUMN(NAME=~"fc_cabecera.fecha_inactivacion~") COLUMN(NAME=~"fc_cabecera.usuario_inactiva~") COLUMN(NAME=~"fc_cabecera.fecha_cineracion~") COLUMN(NAME=~"fc_cabecera.hora_cineracion~") COLUMN(NAME=~"fc_cabecera.minuto_cineracion~") COLUMN(NAME=~"fc_cabecera.estado_contrato~") COLUMN(NAME=~"fc_cabecera.sw_pregrabar~") COLUMN(NAME=~"fc_cabecera.fecha_ingreso_cinerario~") COLUMN(NAME=~"fc_cabecera.hora_ingreso_cinerario~") COLUMN(NAME=~"fc_cabecera.minuto_ingreso_cinerario~") COLUMN(NAME=~"fc_cabecera.sw_covid_19~") COLUMN(NAME=~"fc_cabecera.sw_protocolo_covid~") COLUMN(NAME=~"fc_cabecera.autoriza_admin_agenda~") COLUMN(NAME=~"fc_cabecera.rut_fallecido~") COLUMN(NAME=~"fc_cabecera.sw_ingreso_parque~") COLUMN(NAME=~"fc_cabecera.horno~") COLUMN(NAME=~"fc_cabecera.correlativo_fc~")WHERE(    EXP1 =~"~~~"FC_CABECERA~~~".~~~"FOLIO_CREMATORIO~~~"~"   OP =~"=~"    EXP2 =~":folio~" ) ) ARG(NAME = ~"folio~" TYPE = number) " update="FC_CABECERA" updatewhere=0 updatekeyinplace=yes arguments=(("folio", number)) )
