 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"cadena~" )  TABLE(NAME=~"cliente~" )  TABLE(NAME=~"producto_anexo~" )  TABLE(NAME=~"fc_cabecera~" ) COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cadena.rut~") COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"cadena.serie~") COLUMN(NAME=~"cadena.numero~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"fc_cabecera.folio_crematorio~") COLUMN(NAME=~"fc_cabecera.estado_gestion~")    JOIN (LEFT=~"cadena.rut~"    OP =~"=~"RIGHT=~"cliente.rut~" )    JOIN (LEFT=~"producto_anexo.base~"    OP =~"=~"RIGHT=~"cadena.codigo~" )    JOIN (LEFT=~"producto_anexo.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"producto_anexo.numero~"    OP =~"=~"RIGHT=~"cadena.numero~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"fc_cabecera.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"fc_cabecera.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"fc_cabecera.numero~" )WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"PRODUCTO_ANEXO~~~".~~~"FECHA_INGRESO~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"PRODUCTO_ANEXO~~~".~~~"FECHA_INGRESO~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number)  ARG(NAME = ~"fecha_ini~" TYPE = datetime)  ARG(NAME = ~"fecha_fin~" TYPE = datetime) " arguments=(("base", string),("serie", string),("numero", number),("fecha_ini", datetime),("fecha_fin", datetime))  sort="cadena_codigo A cadena_serie A cadena_numero A " )
