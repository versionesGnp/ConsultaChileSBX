 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cs_detalle_pagos~" ) COLUMN(NAME=~"cs_detalle_pagos.base~") COLUMN(NAME=~"cs_detalle_pagos.serie~") COLUMN(NAME=~"cs_detalle_pagos.numero~") COLUMN(NAME=~"cs_detalle_pagos.codigo_otro~") COLUMN(NAME=~"cs_detalle_pagos.moneda~") COLUMN(NAME=~"cs_detalle_pagos.monto~") COLUMN(NAME=~"cs_detalle_pagos.monto_peso~") COLUMN(NAME=~"cs_detalle_pagos.fecha_sistema~")WHERE(    EXP1 =~"~~~"CS_DETALLE_PAGOS~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CS_DETALLE_PAGOS~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CS_DETALLE_PAGOS~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number) " update="CS_DETALLE_PAGOS" updatewhere=1 updatekeyinplace=no arguments=(("base", string),("serie", string),("numero", number))  sort="codigo_otro A " )
