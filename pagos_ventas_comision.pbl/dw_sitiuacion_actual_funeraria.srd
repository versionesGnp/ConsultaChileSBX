 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"funeraria_folio_detalle~" )  TABLE(NAME=~"funeraria_pago_comision~" )  TABLE(NAME=~"funeraria_estado~" ) COLUMN(NAME=~"funeraria_pago_comision.base~") COLUMN(NAME=~"funeraria_pago_comision.serie~") COLUMN(NAME=~"funeraria_pago_comision.numero~") COLUMN(NAME=~"funeraria_pago_comision.cod_agente~") COLUMN(NAME=~"funeraria_pago_comision.folio~") COLUMN(NAME=~"funeraria_pago_comision.cod_funeraria~") COLUMN(NAME=~"funeraria_folio_detalle.estado~") COLUMN(NAME=~"funeraria_estado.descripcion~") COLUMN(NAME=~"funeraria_estado.glosa~") COLUMN(NAME=~"funeraria_estado.depto~") COLUMN(NAME=~"funeraria_folio_detalle.cod_parque~") COLUMN(NAME=~"funeraria_folio_detalle.usuario_crea~") COLUMN(NAME=~"funeraria_folio_detalle.fecha_crea~") COLUMN(NAME=~"funeraria_pago_comision.fecha_estado~") COLUMN(NAME=~"funeraria_folio_detalle.usuario_gestor~") COLUMN(NAME=~"funeraria_pago_comision.cod_supervisor~") COLUMN(NAME=~"funeraria_pago_comision.mes_cierre~") COLUMN(NAME=~"funeraria_pago_comision.ano_cierre~") COLUMN(NAME=~"funeraria_pago_comision.num_boleta~") COLUMN(NAME=~"funeraria_pago_comision.num_cheque~")    JOIN (LEFT=~"funeraria_pago_comision.base~"    OP =~"=~"RIGHT=~"funeraria_folio_detalle.base~" )    JOIN (LEFT=~"funeraria_pago_comision.serie~"    OP =~"=~"RIGHT=~"funeraria_folio_detalle.serie~" )    JOIN (LEFT=~"funeraria_pago_comision.numero~"    OP =~"=~"RIGHT=~"funeraria_folio_detalle.numero~" )    JOIN (LEFT=~"funeraria_pago_comision.cod_estado~"    OP =~"=~"RIGHT=~"funeraria_folio_detalle.estado~" )    JOIN (LEFT=~"funeraria_folio_detalle.estado~"    OP =~"=~"RIGHT=~"funeraria_estado.codigo~" )    JOIN (LEFT=~"funeraria_folio_detalle.fecha_estado~"    OP =~"=~"RIGHT=~"funeraria_pago_comision.fecha_estado~" )WHERE(    EXP1 =~"~~~"FUNERARIA_FOLIO_DETALLE~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FUNERARIA_FOLIO_DETALLE~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FUNERARIA_FOLIO_DETALLE~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number) " arguments=(("base", string),("serie", string),("numero", number)) )
