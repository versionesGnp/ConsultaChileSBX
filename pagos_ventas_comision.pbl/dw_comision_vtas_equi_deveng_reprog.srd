 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"vista_comis_reprog~" )  TABLE(NAME=~"tab_uf~" ) COLUMN(NAME=~"vista_comis_reprog.base_original~") COLUMN(NAME=~"vista_comis_reprog.serie_original~") COLUMN(NAME=~"vista_comis_reprog.numero_original~") COLUMN(NAME=~"vista_comis_reprog.base~") COLUMN(NAME=~"vista_comis_reprog.serie~") COLUMN(NAME=~"vista_comis_reprog.numero~") COLUMN(NAME=~"vista_comis_reprog.rut~") COLUMN(NAME=~"vista_comis_reprog.cod_age~") COLUMN(NAME=~"vista_comis_reprog.cargo~") COLUMN(NAME=~"vista_comis_reprog.cierre_venta~") COLUMN(NAME=~"vista_comis_reprog.clasifica_venta~") COLUMN(NAME=~"vista_comis_reprog.moneda~") COLUMN(NAME=~"vista_comis_reprog.precio~") COLUMN(NAME=~"vista_comis_reprog.estado_comi~") COLUMN(NAME=~"vista_comis_reprog.estado_persist_age~") COLUMN(NAME=~"vista_comis_reprog.depto~") COLUMN(NAME=~"vista_comis_reprog.estatus_comision~") COLUMN(NAME=~"vista_comis_reprog.tipo_cont~") COLUMN(NAME=~"vista_comis_reprog.canal~") COLUMN(NAME=~"vista_comis_reprog.porce_venta~") COMPUTE(NAME=~"round((SELECT sum(~~~"INGRESO~~~".~~~"MONTO~~~")  FROM ~~~"INGRESO~~~"  WHERE ~~~"INGRESO~~~".~~~"BASE~~~" = ~~~"VISTA_COMIS_REPROG~~~".~~~"BASE~~~" AND ~~~"INGRESO~~~".~~~"SERIE~~~" = ~~~"VISTA_COMIS_REPROG~~~".~~~"SERIE~~~" AND ~~~"INGRESO~~~".~~~"CONTRATO~~~" = ~~~"VISTA_COMIS_REPROG~~~".~~~"NUMERO~~~" AND (~~~"INGRESO~~~".~~~"TIPO_MOV~~~" = 'A' OR  ~~~"INGRESO~~~".~~~"TIPO_MOV~~~" = 'E' OR  ~~~"INGRESO~~~".~~~"TIPO_MOV~~~" = 'Q') AND ~~~"INGRESO~~~".~~~"FECHA_PAGO~~~" <= :fecha) / round(CASE WHEN ~~~"VISTA_COMIS_REPROG~~~".~~~"MONEDA~~~" = '1' THEN ~~~"VISTA_COMIS_REPROG~~~".~~~"PRECIO~~~" WHEN ~~~"VISTA_COMIS_REPROG~~~".~~~"MONEDA~~~" = '2' THEN ~~~"VISTA_COMIS_REPROG~~~".~~~"PRECIO~~~" * ~~~"TAB_UF~~~".~~~"VALOR_UF~~~"  END,0) * 100,2) as porce_pago~") COLUMN(NAME=~"vista_comis_reprog.fecha~") COLUMN(NAME=~"vista_comis_reprog.estado_comis_new~") COLUMN(NAME=~"vista_comis_reprog.estado_persis_new~")    JOIN (LEFT=~"vista_comis_reprog.fecha~"    OP =~"=~"RIGHT=~"tab_uf.fecha_uf~" )WHERE(    EXP1 =~"~~~"VISTA_COMIS_REPROG~~~".~~~"VALID~~~"~"   OP =~"=~"    EXP2 =~"'SI'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"VISTA_COMIS_REPROG~~~".~~~"ESTADO_PERSIST_AGE~~~"~"   OP =~"<>~"    EXP2 =~"'X'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"VISTA_COMIS_REPROG~~~".~~~"ESTADO_PERSIS_NEW~~~"~"   OP =~"<>~"    EXP2 =~"'X'~" ) ) ARG(NAME = ~"fecha~" TYPE = datetime) " arguments=(("fecha", datetime))  sort="vista_comis_reprog_base_original A vista_comis_reprog_serie_original A vista_comis_reprog_numero_original A vista_comis_reprog_cargo A " )
