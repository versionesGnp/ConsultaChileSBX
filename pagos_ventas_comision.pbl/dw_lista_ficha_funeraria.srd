"ficha_traslado.serie_destino~") COLUMN(NAME=~"ficha_traslado.numero_destino~") COLUMN(NAME=~"ficha_traslado.codigo_funeraria~") COLUMN(NAME=~"ficha_traslado.fecha_contrato_destino~") COLUMN(NAME=~"ficha_traslado.cod_parque_destino~") COLUMN(NAME=~"ficha_traslado.nombre_titular_destino~") COLUMN(NAME=~"ficha_traslado.apellido_pat_titular_destino~") COLUMN(NAME=~"ficha_traslado.apellido_mat_titular_destino~") COLUMN(NAME=~"ficha_traslado.rut_titular_destino~") COLUMN(NAME=~"ficha_traslado.dv_titular_destino~") COLUMN(NAME=~"ficha_traslado.direccion_titular_destino~") COLUMN(NAME=~"ficha_traslado.nro_direc_titular_destino~") COLUMN(NAME=~"ficha_traslado.block_direc_titular_destino~") COLUMN(NAME=~"ficha_traslado.depto_direc_titular_destino~") COLUMN(NAME=~"ficha_traslado.cod_ciudad_titular_destino~") COLUMN(NAME=~"ficha_traslado.cod_comuna_titular_destino~") COLUMN(NAME=~"ficha_traslado.nombre_fallecido~") COLUMN(NAME=~"ficha_traslado.apellido_paterno_fall~") COLUMN(NAME=~"ficha_traslado.apellido_materno_fall~") COLUMN(NAME=~"ficha_traslado.rut_fallecido~") COLUMN(NAME=~"ficha_traslado.dv_fallecido~") COLUMN(NAME=~"ficha_traslado.sector_destino~") COLUMN(NAME=~"ficha_traslado.sepultura_destino~") COLUMN(NAME=~"ficha_traslado.fono_titular_destino~") COLUMN(NAME=~"ficha_traslado.capacidad_destino~") COMPUTE(NAME=~"'T'~")WHERE(    EXP1 =~"~~~"FICHA_TRASLADO~~~".~~~"FECHA_INGRESO_SISTEMA~~~"~"   OP =~">=~"    EXP2 =~":fecha_inicio~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FICHA_TRASLADO~~~".~~~"FECHA_INGRESO_SISTEMA~~~"~"   OP =~"<=~"    EXP2 =~":fecha_termino~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FICHA_TRASLADO~~~".~~~"SERIE_DESTINO~~~"~"   OP =~"<>~"    EXP2 =~"'R'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FICHA_TRASLADO~~~".~~~"SW_DATO_FUNERARIA~~~"~"   OP =~"=~"    EXP2 =~"0~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FICHA_TRASLADO~~~".~~~"TIPO_TRASLADO~~~"~"   OP =~"=~"    EXP2 =~"'E'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FICHA_TRASLADO~~~".~~~"DESTINO_PARQUE~~~"~"   OP =~"=~"    EXP2 =~"'E'~" ) )) ARG(NAME = ~"fecha_inicio~" TYPE = datetime)  ARG(NAME = ~"fecha_termino~" TYPE = datetime) " arguments=(("fecha_inicio", datetime),("fecha_termino", datetime)) )
