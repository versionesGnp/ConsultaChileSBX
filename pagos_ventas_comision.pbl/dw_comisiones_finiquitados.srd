 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"agentes~" )  TABLE(NAME=~"res_comi~" )  TABLE(NAME=~"oferta_v~" )  TABLE(NAME=~"pago_oferta~" )  TABLE(NAME=~"cadena~" ) COLUMN(NAME=~"agentes.nombre~") COLUMN(NAME=~"agentes.a_paterno~") COLUMN(NAME=~"agentes.a_materno~") COLUMN(NAME=~"agentes.rut~") COLUMN(NAME=~"agentes.canal~") COLUMN(NAME=~"agentes.cod_parque~") COLUMN(NAME=~"res_comi.cod_age_sup~") COLUMN(NAME=~"res_comi.mont_age_sup~") COLUMN(NAME=~"res_comi.cod_contable~") COLUMN(NAME=~"res_comi.mes~") COLUMN(NAME=~"res_comi.serie~") COLUMN(NAME=~"res_comi.contrato~") COLUMN(NAME=~"res_comi.fecha~") COLUMN(NAME=~"res_comi.porc_ing_caja~") COLUMN(NAME=~"res_comi.porc_venta~") COLUMN(NAME=~"res_comi.total_pago~") COLUMN(NAME=~"res_comi.valor_uf~") COLUMN(NAME=~"res_comi.haber~") COLUMN(NAME=~"res_comi.codigo_com~") COLUMN(NAME=~"res_comi.estado_age_sup~") COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"cadena.cod_parque~") COLUMN(NAME=~"cadena.rut~") COLUMN(NAME=~"oferta_v.uso~") COLUMN(NAME=~"pago_oferta.area~") COLUMN(NAME=~"pago_oferta.moneda~") COLUMN(NAME=~"pago_oferta.precio~")    JOIN (LEFT=~"agentes.cod_age~"    OP =~"=~"RIGHT=~"res_comi.cod_age_sup~" )    JOIN (LEFT=~"oferta_v.serie~"    OP =~"=~"RIGHT=~"pago_oferta.serie~" )    JOIN (LEFT=~"res_comi.serie~"    OP =~"=~"RIGHT=~"oferta_v.serie~" )    JOIN (LEFT=~"res_comi.contrato~"    OP =~"=~"RIGHT=~"oferta_v.nro_oferta~" )    JOIN (LEFT=~"oferta_v.nro_oferta~"    OP =~"=~"RIGHT=~"pago_oferta.nro_oferta~" )    JOIN (LEFT=~"oferta_v.ult_folio~"    OP =~"=~"RIGHT=~"pago_oferta.folio~" )    JOIN (LEFT=~"pago_oferta.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"pago_oferta.nro_oferta~"    OP =~"=~"RIGHT=~"cadena.numero~" )WHERE(    EXP1 =~"(~~~"AGENTES~~~".~~~"DEPTO~~~"~"   OP =~"=~"    EXP2 =~"'K'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"AGENTES~~~".~~~"DEPTO~~~"~"   OP =~"=~"    EXP2 =~"'M'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"AGENTES~~~".~~~"DEPTO~~~"~"   OP =~"=~"    EXP2 =~"'G'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"AGENTES~~~".~~~"DEPTO~~~"~"   OP =~"=~"    EXP2 =~"'E')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"AGENTES~~~".~~~"COD_AGE~~~"~"   OP =~"=~"    EXP2 =~":codigo~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"RES_COMI~~~".~~~"FECHA~~~"~"   OP =~"<=~"    EXP2 =~":fecha~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"RES_COMI~~~".~~~"COD_CONTABLE~~~"~"   OP =~"=~"    EXP2 =~"'007'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"RES_COMI~~~".~~~"COD_CONTABLE~~~"~"   OP =~"=~"    EXP2 =~"'022'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"RES_COMI~~~".~~~"COD_CONTABLE~~~"~"   OP =~"=~"    EXP2 =~"'023'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"RES_COMI~~~".~~~"COD_CONTABLE~~~"~"   OP =~"=~"    EXP2 =~"'036'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"RES_COMI~~~".~~~"COD_CONTABLE~~~"~"   OP =~"=~"    EXP2 =~"'037'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"RES_COMI~~~".~~~"COD_CONTABLE~~~"~"   OP =~"=~"    EXP2 =~"'069'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"RES_COMI~~~".~~~"COD_CONTABLE~~~"~"   OP =~"=~"    EXP2 =~"'070'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"RES_COMI~~~".~~~"COD_CONTABLE~~~"~"   OP =~"=~"    EXP2 =~"'071'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"RES_COMI~~~".~~~"COD_CONTABLE~~~"~"   OP =~"=~"    EXP2 =~"'072'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"RES_COMI~~~".~~~"COD_CONTABLE~~~"~"   OP =~"=~"    EXP2 =~"'076'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"RES_COMI~~~".~~~"COD_CONTABLE~~~"~"   OP =~"=~"    EXP2 =~"'077'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"RES_COMI~~~".~~~"COD_CONTABLE~~~"~"   OP =~"=~"    EXP2 =~"'089'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"RES_COMI~~~".~~~"COD_CONTABLE~~~"~"   OP =~"=~"    EXP2 =~"'090')~" ) ) ARG(NAME = ~"codigo~" TYPE = string)  ARG(NAME = ~"fecha~" TYPE = datetime) " arguments=(("codigo", string),("fecha", datetime))  sort="res_comi_fecha A " )
