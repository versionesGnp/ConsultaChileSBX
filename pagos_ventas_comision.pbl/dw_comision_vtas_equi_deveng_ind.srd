 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"vista_comis_deveng~" ) COLUMN(NAME=~"vista_comis_deveng.codigo~") COLUMN(NAME=~"vista_comis_deveng.serie~") COLUMN(NAME=~"vista_comis_deveng.numero~") COLUMN(NAME=~"vista_comis_deveng.cod_age~") COLUMN(NAME=~"vista_comis_deveng.canal~") COLUMN(NAME=~"vista_comis_deveng.rut~") COLUMN(NAME=~"vista_comis_deveng.clasifica_venta~") COLUMN(NAME=~"vista_comis_deveng.cargo~") COLUMN(NAME=~"vista_comis_deveng.porce_vta~") COLUMN(NAME=~"vista_comis_deveng.c_primera~") COLUMN(NAME=~"vista_comis_deveng.c_segunda~") COLUMN(NAME=~"vista_comis_deveng.c_tercera~") COLUMN(NAME=~"vista_comis_deveng.c_cuarta~") COLUMN(NAME=~"vista_comis_deveng.c_quinta~") COLUMN(NAME=~"vista_comis_deveng.c_sexta~") COLUMN(NAME=~"vista_comis_deveng.c_septima~") COLUMN(NAME=~"vista_comis_deveng.depto~") COLUMN(NAME=~"vista_comis_deveng.estado~") COLUMN(NAME=~"vista_comis_deveng.estatus_comision~") COMPUTE(NAME=~"'' as canal2~") COLUMN(NAME=~"vista_comis_deveng.cierre_venta~") COLUMN(NAME=~"vista_comis_deveng.tipo_venta~")WHERE(    EXP1 =~"~~~"VISTA_COMIS_DEVENG~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"VISTA_COMIS_DEVENG~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"VISTA_COMIS_DEVENG~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number) " arguments=(("base", string),("serie", string),("numero", number))  sort="codigo A numero A cargo A clasifica_venta A " )
