 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"cadena~" )  TABLE(NAME=~"at_gestion~" ) COLUMN(NAME=~"cadena.estado~") COMPUTE(NAME=~"0 as grupo~") COLUMN(NAME=~"at_gestion.base~") COLUMN(NAME=~"at_gestion.serie~") COLUMN(NAME=~"at_gestion.numero~") COLUMN(NAME=~"at_gestion.fecha_anula_comis~") COLUMN(NAME=~"at_gestion.usuario_anula_comis~") COLUMN(NAME=~"at_gestion.estado_comi~") COLUMN(NAME=~"at_gestion.tipo_gestion~") COLUMN(NAME=~"at_gestion.rut_cliente~") COLUMN(NAME=~"at_gestion.fecha_crea~") COLUMN(NAME=~"at_gestion.codigo_grupo~") COLUMN(NAME=~"at_gestion.fec_ini~") COLUMN(NAME=~"at_gestion.fec_fin~") COLUMN(NAME=~"at_gestion.monto~") COLUMN(NAME=~"at_gestion.estado_gestion~") COLUMN(NAME=~"at_gestion.concepto~") COLUMN(NAME=~"at_gestion.tipo_cobranza~")    JOIN (LEFT=~"at_gestion.base~"    OP =~"=~"RIGHT=~"cadena.codigo~" )    JOIN (LEFT=~"at_gestion.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"at_gestion.numero~"    OP =~"=~"RIGHT=~"cadena.numero~" )WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"AT_GESTION~~~".~~~"TIPO_COBRANZA~~~"~"   OP =~"=~"    EXP2 =~":tipo_cob~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number)  ARG(NAME = ~"tipo_cob~" TYPE = string) " update="AT_GESTION" updatewhere=0 updatekeyinplace=yes arguments=(("base", string),("serie", string),("numero", number),("tipo_cob", string)) )
