 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"comision_compartida~" )  TABLE(NAME=~"oferta_v~" ) COLUMN(NAME=~"comision_compartida.fecha_crea~") COLUMN(NAME=~"comision_compartida.usuario_crea~") COLUMN(NAME=~"comision_compartida.base~") COLUMN(NAME=~"comision_compartida.serie~") COLUMN(NAME=~"comision_compartida.numero~") COLUMN(NAME=~"comision_compartida.codigo_tipo_vta~") COLUMN(NAME=~"comision_compartida.porce_age_orig~") COLUMN(NAME=~"comision_compartida.porce_sup_orig~") COLUMN(NAME=~"comision_compartida.porce_jefe_orig~") COLUMN(NAME=~"comision_compartida.porce_age_1~") COLUMN(NAME=~"comision_compartida.porce_sup_1~") COLUMN(NAME=~"comision_compartida.porce_jefe_1~") COLUMN(NAME=~"comision_compartida.cod_age_2~") COLUMN(NAME=~"comision_compartida.porce_age_2~") COLUMN(NAME=~"comision_compartida.cod_sup_2~") COLUMN(NAME=~"comision_compartida.porce_sup_2~") COLUMN(NAME=~"comision_compartida.cod_jefe_2~") COLUMN(NAME=~"comision_compartida.porce_jefe_2~") COLUMN(NAME=~"comision_compartida.cod_age_3~") COLUMN(NAME=~"comision_compartida.porce_age_3~") COLUMN(NAME=~"comision_compartida.estado~") COLUMN(NAME=~"comision_compartida.fecha_modifica~") COLUMN(NAME=~"oferta_v.cod_age~") COLUMN(NAME=~"oferta_v.cod_sup~") COLUMN(NAME=~"oferta_v.cod_jef~") COLUMN(NAME=~"comision_compartida.tipo_condolencia~")    JOIN (LEFT=~"comision_compartida.serie~"    OP =~"=~"RIGHT=~"oferta_v.serie~" )    JOIN (LEFT=~"comision_compartida.numero~"    OP =~"=~"RIGHT=~"oferta_v.nro_oferta~" )WHERE(    EXP1 =~"~~~"COMISION_COMPARTIDA~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"COMISION_COMPARTIDA~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"COMISION_COMPARTIDA~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"COMISION_COMPARTIDA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'V'~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number) " update="COMISION_COMPARTIDA" updatewhere=0 updatekeyinplace=yes arguments=(("base", string),("serie", string),("numero", number)) )
