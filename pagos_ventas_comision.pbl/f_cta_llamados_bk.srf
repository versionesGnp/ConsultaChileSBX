global function long f_cta_llamados_bk (string as_cod_age, datetime adt_fec_ini, datetime adt_fec_fin, string as_cod_sup);long	ll_cta_llam

//f_cta_llamados(as_cod_age,adt_fec_ini,adt_fec_fin,as_cod_sup)
if as_cod_sup='SU4' then
	if as_cod_age='U3' then
		ll_cta_llam								= 35	
	elseif as_cod_age='U7' then
		ll_cta_llam								= 19	
	elseif as_cod_age='U8' then
		ll_cta_llam								= 17	
	elseif as_cod_age='U13' then
		ll_cta_llam								= 26
	end if
elseif as_cod_sup='0195' then
	if as_cod_age='U3' then
		ll_cta_llam								= 15	
	elseif as_cod_age='U7' then
		ll_cta_llam								= 3	
	elseif as_cod_age='U8' then
		ll_cta_llam								= 8	
	elseif as_cod_age='U13' then
		ll_cta_llam								= 4
	end if
end if
if isnull(ll_cta_llam) then ll_cta_llam=0
return	ll_cta_llam
end function

