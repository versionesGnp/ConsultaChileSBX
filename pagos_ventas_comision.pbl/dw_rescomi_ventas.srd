table(column=(type=char(3) updatewhereclause=yes name=res_comi_cod_contable dbname="res_comi.cod_contable" )
 column=(type=char(35) updatewhereclause=yes name=codigo_contable_descripcion dbname="codigo_contable.descripcion" )
 column=(type=datetime updatewhereclause=yes name=res_comi_fecha dbname="res_comi.fecha" )
 column=(type=char(5) updatewhereclause=yes name=res_comi_cod_age_sup dbname="res_comi.cod_age_sup" )
 column=(type=decimal(4) updatewhereclause=yes name=res_comi_total_pago dbname="res_comi.total_pago" )
 column=(type=decimal(4) updatewhereclause=yes name=res_comi_porc_venta dbname="res_comi.porc_venta" )
