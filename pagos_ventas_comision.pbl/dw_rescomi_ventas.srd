 column=(type=char(1) updatewhereclause=yes name=agentes_cargo dbname="agentes.cargo" values="A-Agente	A/S-Supervisor	S/J-Jefe Ventas	J/" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"codigo_contable~" )  TABLE(NAME=~"res_comi~" )  TABLE(NAME=~"agentes~" ) COLUMN(NAME=~"res_comi.cod_contable~") COLUMN(NAME=~"codigo_contable.descripcion~") COLUMN(NAME=~"res_comi.fecha~") COLUMN(NAME=~"res_comi.cod_age_sup~") COLUMN(NAME=~"res_comi.total_pago~") COLUMN(NAME=~"res_comi.porc_venta~") COLUMN(NAME=~"res_comi.mes~") COLUMN(NAME=~"res_comi.codigo_com~") COLUMN(NAME=~"agentes.cargo~")    JOIN (LEFT=~"codigo_contable.codigo~"    OP =~"=~"RIGHT=~"res_comi.cod_contable~" )    JOIN (LEFT=~"res_comi.cod_age_sup~"    OP =~"=~"RIGHT=~"agentes.cod_age~" )WHERE(    EXP1 =~"~~~"RES_COMI~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"RES_COMI~~~".~~~"CONTRATO~~~"~"   OP =~"=~"    EXP2 =~":numero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"AGENTES~~~".~~~"COD_AGE~~~"~"   OP =~"<>~"    EXP2 =~"'S36'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"AGENTES~~~".~~~"COD_AGE~~~"~"   OP =~"<>~"    EXP2 =~"'S349')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"RES_COMI~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~" ) )    UNION (PBSELECT( VERSION(400) TABLE(NAME=~"codigo_contable~" )  TABLE(NAME=~"res_comi~" )  TABLE(NAME=~"supervisor~" ) COLUMN(NAME=~"res_comi.cod_contable~") COLUMN(NAME=~"codigo_contable.descripcion~") COLUMN(NAME=~"res_comi.fecha~") COLUMN(NAME=~"res_comi.cod_age_sup~") COLUMN(NAME=~"res_comi.total_pago~") COLUMN(NAME=~"res_comi.porc_venta~") COLUMN(NAME=~"res_comi.mes~") COLUMN(NAME=~"res_comi.codigo_com~") COLUMN(NAME=~"supervisor.cargo~")    JOIN (LEFT=~"res_comi.cod_age_sup~"    OP =~"=~"RIGHT=~"supervisor.cod_sup~" )    JOIN (LEFT=~"codigo_contable.codigo~"    OP =~"=~"RIGHT=~"res_comi.cod_contable~" )WHERE(    EXP1 =~"~~~"RES_COMI~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"RES_COMI~~~".~~~"CONTRATO~~~"~"   OP =~"=~"    EXP2 =~":numero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"RES_COMI~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~" ) ))    UNION (PBSELECT( VERSION(400) TABLE(NAME=~"codigo_contable~" )  TABLE(NAME=~"jefe_ventas~" )  TABLE(NAME=~"res_comi~" ) COLUMN(NAME=~"res_comi.cod_contable~") COLUMN(NAME=~"codigo_contable.descripcion~") COLUMN(NAME=~"res_comi.fecha~") COLUMN(NAME=~"res_comi.cod_age_sup~") COLUMN(NAME=~"res_comi.total_pago~") COLUMN(NAME=~"res_comi.porc_venta~") COLUMN(NAME=~"res_comi.mes~") COLUMN(NAME=~"res_comi.codigo_com~") COLUMN(NAME=~"jefe_ventas.cargo~")    JOIN (LEFT=~"codigo_contable.codigo~"    OP =~"=~"RIGHT=~"res_comi.cod_contable~" )    JOIN (LEFT=~"res_comi.cod_age_sup~"    OP =~"=~"RIGHT=~"jefe_ventas.jefe_ventas~" )WHERE(    EXP1 =~"~~~"RES_COMI~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"RES_COMI~~~".~~~"CONTRATO~~~"~"   OP =~"=~"    EXP2 =~":numero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"RES_COMI~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~" ) )) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number) " arguments=(("base", string),("serie", string),("numero", number))  sort="agentes_cargo A res_comi_fecha A res_comi_cod_contable A res_comi_cod_age_sup A " )
