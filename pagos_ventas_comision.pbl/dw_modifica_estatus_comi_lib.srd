table(column=(type=char(1) updatewhereclause=yes key=yes name=anexo_liberador_serie_m dbname="anexo_liberador.serie_m" dbalias=".serie_m" )
 column=(type=decimal(4) updatewhereclause=yes key=yes name=anexo_liberador_nro_liberador dbname="anexo_liberador.nro_liberador" dbalias=".nro_liberador" )
 column=(type=decimal(4) updatewhereclause=yes name=anexo_liberador_rut dbname="anexo_liberador.rut" dbalias=".rut" )
 column=(type=char(1) updatewhereclause=yes name=anexo_liberador_estado_comi dbname="anexo_liberador.estado_comi" dbalias=".estado_comi" )
 column=(type=datetime updatewhereclause=yes name=anexo_liberador_fecha_com dbname="anexo_liberador.fecha_com" dbalias=".fecha_com" )
 column=(type=decimal(2) updatewhereclause=yes name=anexo_liberador_u_folio dbname="anexo_liberador.u_folio" dbalias=".u_folio" )
 column=(type=datetime updatewhereclause=yes name=anexo_liberador_u_fecha dbname="anexo_liberador.u_fecha" dbalias=".u_fecha" )
 column=(type=char(1) update=yes updatewhereclause=yes name=anexo_liberador_estatus_comision dbname="anexo_liberador.estatus_comision" dbalias=".estatus_comision" )
 column=(type=datetime updatewhereclause=yes name=anexo_liberador_cierre_venta dbname="anexo_liberador.cierre_venta" dbalias=".cierre_venta" )
 column=(type=datetime updatewhereclause=yes name=anexo_liberador_cierre_venta_semanal dbname="anexo_liberador.cierre_venta_semanal" dbalias=".cierre_venta_semanal" )
 column=(type=number updatewhereclause=yes name=c_ok dbname="c_ok" values="	1/	0" )
 column=(type=char(2) updatewhereclause=yes name=agentes_canal dbname="agentes.canal" dbalias=".canal" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"agentes~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"anexo_liberador~" ) COLUMN(NAME=~"anexo_liberador.serie_m~") COLUMN(NAME=~"anexo_liberador.nro_liberador~") COLUMN(NAME=~"anexo_liberador.rut~") COLUMN(NAME=~"anexo_liberador.estado_comi~") COLUMN(NAME=~"anexo_liberador.fecha_com~") COLUMN(NAME=~"anexo_liberador.u_folio~") COLUMN(NAME=~"anexo_liberador.u_fecha~") COLUMN(NAME=~"anexo_liberador.estatus_comision~") COLUMN(NAME=~"anexo_liberador.cierre_venta~") COLUMN(NAME=~"anexo_liberador.cierre_venta_semanal~") COMPUTE(NAME=~"0 as c_ok~") COLUMN(NAME=~"agentes.canal~")    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"anexo_liberador.serie_m~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"anexo_liberador.nro_liberador~" )    JOIN (LEFT=~"anexo_liberador.cod_agente~"    OP =~"=~"RIGHT=~"agentes.cod_age~" )WHERE(    EXP1 =~"~~~"ANEXO_LIBERADOR~~~".~~~"ESTATUS_COMISION~~~"~"   OP =~"is~"    EXP2 =~"null~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"AGENTES~~~".~~~"DEPTO~~~"~"   OP =~"=~"    EXP2 =~"'M'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"AGENTES~~~".~~~"DEPTO~~~"~"   OP =~"=~"    EXP2 =~"'K')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"AGENTES~~~".~~~"CANAL~~~"~"   OP =~"=~"    EXP2 =~"'NF'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"AGENTES~~~".~~~"CANAL~~~"~"   OP =~"=~"    EXP2 =~"'NI')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'L'~" ) ) " update="ANEXO_LIBERADOR" updatewhere=0 updatekeyinplace=yes )
