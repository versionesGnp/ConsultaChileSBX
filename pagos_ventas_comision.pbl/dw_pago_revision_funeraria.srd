 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"funeraria_pago_comision~" ) COLUMN(NAME=~"funeraria_pago_comision.cod_funeraria~") COLUMN(NAME=~"funeraria_pago_comision.numero_dato~") COLUMN(NAME=~"funeraria_pago_comision.fecha_cierre~") COLUMN(NAME=~"funeraria_pago_comision.base~") COLUMN(NAME=~"funeraria_pago_comision.serie~") COLUMN(NAME=~"funeraria_pago_comision.numero~") COLUMN(NAME=~"funeraria_pago_comision.porce_comision~") COLUMN(NAME=~"funeraria_pago_comision.total_pago~") COLUMN(NAME=~"funeraria_pago_comision.cod_parque~")WHERE(    EXP1 =~"~~~"FUNERARIA_PAGO_COMISION~~~".~~~"COD_FUNERARIA~~~"~"   OP =~"=~"    EXP2 =~":cod_funeraria~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FUNERARIA_PAGO_COMISION~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":cod_parque~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FUNERARIA_PAGO_COMISION~~~".~~~"MES_CIERRE~~~"~"   OP =~"=~"    EXP2 =~":mes~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FUNERARIA_PAGO_COMISION~~~".~~~"ANO_CIERRE~~~"~"   OP =~"=~"    EXP2 =~":ano~" ) ) ARG(NAME = ~"cod_funeraria~" TYPE = number)  ARG(NAME = ~"cod_parque~" TYPE = number)  ARG(NAME = ~"mes~" TYPE = number)  ARG(NAME = ~"ano~" TYPE = number) " arguments=(("cod_funeraria", number),("cod_parque", number),("mes", number),("ano", number))  sort="numero_dato A " )
