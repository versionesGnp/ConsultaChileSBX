 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"res_comi~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"codigo_contable~" ) COLUMN(NAME=~"cadena.cod_parque~") COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"res_comi.cod_contable~") COLUMN(NAME=~"res_comi.total_pago~") COLUMN(NAME=~"codigo_contable.descripcion~") COMPUTE(NAME=~"(SELECT ~~~"AGENTES~~~".~~~"PAGOS_VENTA~~~" FROM ~~~"AGENTES~~~" WHERE ~~~"AGENTES~~~".~~~"COD_AGE~~~" = ~~~"RES_COMI~~~".~~~"COD_AGE_SUP~~~" AND ~~~"AGENTES~~~".~~~"PAGOS_VENTA~~~" = 'S' UNION SELECT ~~~"SUPERVISOR~~~".~~~"PAGOS_VENTA~~~" FROM ~~~"SUPERVISOR~~~" WHERE ~~~"SUPERVISOR~~~".~~~"COD_SUP~~~" = ~~~"RES_COMI~~~".~~~"COD_AGE_SUP~~~" AND ~~~"SUPERVISOR~~~".~~~"PAGOS_VENTA~~~" = 'S' UNION SELECT ~~~"JEFE_VENTAS~~~".~~~"PAGOS_VENTA~~~" FROM 	~~~"JEFE_VENTAS~~~" WHERE ~~~"JEFE_VENTAS~~~".~~~"JEFE_VENTAS~~~" = ~~~"RES_COMI~~~".~~~"COD_AGE_SUP~~~"	AND ~~~"JEFE_VENTAS~~~".~~~"PAGOS_VENTA~~~" = 'S' ) AS PAGOS_VENTA~")    JOIN (LEFT=~"res_comi.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"res_comi.contrato~"    OP =~"=~"RIGHT=~"cadena.numero~" )    JOIN (LEFT=~"res_comi.cod_contable~"    OP =~"=~"RIGHT=~"codigo_contable.codigo~" )WHERE(    EXP1 =~"((~~~"RES_COMI~~~".~~~"FECHA~~~"~"   OP =~"=~"    EXP2 =~":fecha_cierre~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'L'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"RES_COMI~~~".~~~"COD_CONTABLE~~~"~"   OP =~"=~"    EXP2 =~"'022'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"RES_COMI~~~".~~~"COD_CONTABLE~~~"~"   OP =~"=~"    EXP2 =~"'036'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"RES_COMI~~~".~~~"COD_CONTABLE~~~"~"   OP =~"=~"    EXP2 =~"'053'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"RES_COMI~~~".~~~"COD_CONTABLE~~~"~"   OP =~"=~"    EXP2 =~"'070'))~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"(~~~"RES_COMI~~~".~~~"FECHA~~~"~"   OP =~"=~"    EXP2 =~":fecha_cierre~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'O'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"RES_COMI~~~".~~~"COD_CONTABLE~~~"~"   OP =~"=~"    EXP2 =~"'037'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"RES_COMI~~~".~~~"COD_CONTABLE~~~"~"   OP =~"=~"    EXP2 =~"'007'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"RES_COMI~~~".~~~"COD_CONTABLE~~~"~"   OP =~"=~"    EXP2 =~"'069'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"RES_COMI~~~".~~~"COD_CONTABLE~~~"~"   OP =~"=~"    EXP2 =~"'070'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"RES_COMI~~~".~~~"COD_CONTABLE~~~"~"   OP =~"=~"    EXP2 =~"'071'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"RES_COMI~~~".~~~"COD_CONTABLE~~~"~"   OP =~"=~"    EXP2 =~"'072'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"RES_COMI~~~".~~~"COD_CONTABLE~~~"~"   OP =~"=~"    EXP2 =~"'076'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"RES_COMI~~~".~~~"COD_CONTABLE~~~"~"   OP =~"=~"    EXP2 =~"'077'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"RES_COMI~~~".~~~"COD_CONTABLE~~~"~"   OP =~"=~"    EXP2 =~"'089'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"RES_COMI~~~".~~~"COD_CONTABLE~~~"~"   OP =~"=~"    EXP2 =~"'090'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"RES_COMI~~~".~~~"COD_CONTABLE~~~"~"   OP =~"=~"    EXP2 =~"'023'))~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"(~~~"RES_COMI~~~".~~~"FECHA~~~"~"   OP =~"=~"    EXP2 =~":fecha_cierre~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'A'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"(~~~"RES_COMI~~~".~~~"COD_CONTABLE~~~"~"   OP =~"=~"    EXP2 =~"'050'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"RES_COMI~~~".~~~"COD_CONTABLE~~~"~"   OP =~"=~"    EXP2 =~"'028')))~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(SELECT ~~~"AGENTES~~~".~~~"PAGOS_VENTA~~~" FROM ~~~"AGENTES~~~" WHERE ~~~"AGENTES~~~".~~~"COD_AGE~~~" = ~~~"RES_COMI~~~".~~~"COD_AGE_SUP~~~" AND ~~~"AGENTES~~~".~~~"PAGOS_VENTA~~~" = 'S' UNION SELECT ~~~"SUPERVISOR~~~".~~~"PAGOS_VENTA~~~" FROM ~~~"SUPERVISOR~~~" WHERE ~~~"SUPERVISOR~~~".~~~"COD_SUP~~~" = ~~~"RES_COMI~~~".~~~"COD_AGE_SUP~~~" AND ~~~"SUPERVISOR~~~".~~~"PAGOS_VENTA~~~" = 'S' UNION SELECT ~~~"JEFE_VENTAS~~~".~~~"PAGOS_VENTA~~~" FROM 	~~~"JEFE_VENTAS~~~" WHERE ~~~"JEFE_VENTAS~~~".~~~"JEFE_VENTAS~~~" = ~~~"RES_COMI~~~".~~~"COD_AGE_SUP~~~"	AND ~~~"JEFE_VENTAS~~~".~~~"PAGOS_VENTA~~~" = 'S' )~"   OP =~"=~"    EXP2 =~"'S'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"RES_COMI~~~".~~~"COD_AGE_SUP~~~"~"   OP =~"<>~"    EXP2 =~"'AS'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"RES_COMI~~~".~~~"COD_AGE_SUP~~~"~"   OP =~"<>~"    EXP2 =~"'SS'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"RES_COMI~~~".~~~"COD_AGE_SUP~~~"~"   OP =~"<>~"    EXP2 =~"'JS'~" ) ) ARG(NAME = ~"fecha_cierre~" TYPE = date) " arguments=(("fecha_cierre", date))  sort="cadena_cod_parque A cadena_codigo A res_comi_cod_contable A " )
