 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"oferta_v~" )  TABLE(NAME=~"cadena~" ) COLUMN(NAME=~"oferta_v.serie~") COLUMN(NAME=~"oferta_v.nro_oferta~") COLUMN(NAME=~"oferta_v.porce_venta~") COLUMN(NAME=~"oferta_v.porce_sup~") COLUMN(NAME=~"oferta_v.porce_jefe~") COLUMN(NAME=~"oferta_v.porce_ing_cierre~") COLUMN(NAME=~"oferta_v.clasifica_venta~") COMPUTE(NAME=~"'' as new_clas~")    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"oferta_v.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"oferta_v.nro_oferta~" )WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"OFERTA_V~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"OFERTA_V~~~".~~~"NRO_OFERTA~~~"~"   OP =~"=~"    EXP2 =~":numero~" ) )    UNION (PBSELECT( VERSION(400) TABLE(NAME=~"anexo_liberador~" )  TABLE(NAME=~"cadena~" ) COLUMN(NAME=~"anexo_liberador.serie_m~") COLUMN(NAME=~"anexo_liberador.nro_liberador~") COLUMN(NAME=~"anexo_liberador.porce_age~") COLUMN(NAME=~"anexo_liberador.porce_sup~") COLUMN(NAME=~"anexo_liberador.porce_jefe~") COLUMN(NAME=~"anexo_liberador.porce_ing_cierre~") COLUMN(NAME=~"anexo_liberador.clasifica_venta~") COMPUTE(NAME=~"'' as new_clas~")    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"anexo_liberador.serie_m~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"anexo_liberador.nro_liberador~" )WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"ANEXO_LIBERADOR~~~".~~~"SERIE_M~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"ANEXO_LIBERADOR~~~".~~~"NRO_LIBERADOR~~~"~"   OP =~"=~"    EXP2 =~":numero~" ) ))    UNION (PBSELECT( VERSION(400) TABLE(NAME=~"anexo_aumento~" )  TABLE(NAME=~"cadena~" ) COLUMN(NAME=~"anexo_aumento.serie_m~") COLUMN(NAME=~"anexo_aumento.nro_aumento~") COLUMN(NAME=~"anexo_aumento.porce_age~") COLUMN(NAME=~"anexo_aumento.porce_sup~") COLUMN(NAME=~"anexo_aumento.porce_jefe~") COLUMN(NAME=~"anexo_aumento.porce_ing_cierre~") COLUMN(NAME=~"anexo_aumento.clasifica_venta~") COMPUTE(NAME=~"'' as new_clas~")    JOIN (LEFT=~"anexo_aumento.serie_m~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"anexo_aumento.nro_aumento~"    OP =~"=~"RIGHT=~"cadena.numero~" )WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"ANEXO_AUMENTO~~~".~~~"SERIE_M~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"ANEXO_AUMENTO~~~".~~~"NRO_AUMENTO~~~"~"   OP =~"=~"    EXP2 =~":numero~" ) )) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number) " arguments=(("base", string),("serie", string),("numero", number)) )
