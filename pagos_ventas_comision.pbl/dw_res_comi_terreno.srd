 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cadena~" )  TABLE(NAME=~"res_comi~" )  TABLE(NAME=~"codigo_contable~" ) COLUMN(NAME=~"codigo_contable.codigo~") COLUMN(NAME=~"codigo_contable.descripcion~") COLUMN(NAME=~"res_comi.cod_age_sup~") COLUMN(NAME=~"res_comi.rut~") COLUMN(NAME=~"res_comi.fecha~") COLUMN(NAME=~"res_comi.serie~") COLUMN(NAME=~"res_comi.contrato~") COLUMN(NAME=~"res_comi.porc_venta~") COLUMN(NAME=~"res_comi.total_pago~") COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"res_comi.mes~")    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"res_comi.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"res_comi.contrato~" )    JOIN (LEFT=~"codigo_contable.codigo~"    OP =~"=~"RIGHT=~"res_comi.cod_contable~" )WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"RES_COMI~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"RES_COMI~~~".~~~"CONTRATO~~~"~"   OP =~"=~"    EXP2 =~":numero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"CODIGO_CONTABLE~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'007'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"CODIGO_CONTABLE~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'069'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"CODIGO_CONTABLE~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'070'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"CODIGO_CONTABLE~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'071'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"CODIGO_CONTABLE~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'072'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"CODIGO_CONTABLE~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'076'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"CODIGO_CONTABLE~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'077'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"CODIGO_CONTABLE~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'020'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"CODIGO_CONTABLE~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'P20'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"CODIGO_CONTABLE~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'P21'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"CODIGO_CONTABLE~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'P22')~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number) " arguments=(("base", string),("serie", string),("numero", number))  sort="res_comi_fecha A " )
