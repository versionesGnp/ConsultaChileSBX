 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"vista_encuesta_lista~" ) COLUMN(NAME=~"vista_encuesta_lista.codigo~") COLUMN(NAME=~"vista_encuesta_lista.serie~") COLUMN(NAME=~"vista_encuesta_lista.numero~") COLUMN(NAME=~"vista_encuesta_lista.fec_sep~") COLUMN(NAME=~"vista_encuesta_lista.cod_parque~") COLUMN(NAME=~"vista_encuesta_lista.rut_fall~") COLUMN(NAME=~"vista_encuesta_lista.nombre_falle~") COLUMN(NAME=~"vista_encuesta_lista.ap_pater_fall~") COLUMN(NAME=~"vista_encuesta_lista.ap_mater_fall~") COLUMN(NAME=~"vista_encuesta_lista.rut~") COLUMN(NAME=~"vista_encuesta_lista.nombre_cliente~") COLUMN(NAME=~"vista_encuesta_lista.a_pater_cliente~") COLUMN(NAME=~"vista_encuesta_lista.a_mater_cliente~") COLUMN(NAME=~"vista_encuesta_lista.fono_p~") COLUMN(NAME=~"vista_encuesta_lista.fono_c~") COLUMN(NAME=~"vista_encuesta_lista.celular~") COLUMN(NAME=~"vista_encuesta_lista.usuario_creador~") COLUMN(NAME=~"vista_encuesta_lista.tipo_origen~") COLUMN(NAME=~"vista_encuesta_lista.nombre_user~") COLUMN(NAME=~"vista_encuesta_lista.folio_encuesta~") COLUMN(NAME=~"vista_encuesta_lista.tipo_cliente~") COLUMN(NAME=~"vista_encuesta_lista.estado_box~") COLUMN(NAME=~"vista_encuesta_lista.fecha_box~") COLUMN(NAME=~"vista_encuesta_lista.evalua~") COLUMN(NAME=~"vista_encuesta_lista.sector_sep~") COLUMN(NAME=~"vista_encuesta_lista.sepultura~") COLUMN(NAME=~"vista_encuesta_lista.grupo~") COLUMN(NAME=~"vista_encuesta_lista.correlativo~")WHERE(    EXP1 =~"~~~"VISTA_ENCUESTA_LISTA~~~".~~~"FEC_SEP~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"VISTA_ENCUESTA_LISTA~~~".~~~"FEC_SEP~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"VISTA_ENCUESTA_LISTA~~~".~~~"TIPO_CLIENTE~~~"~"   OP =~"=~"    EXP2 =~":tipo_cliente~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"VISTA_ENCUESTA_LISTA~~~".~~~"USUARIO_CREADOR~~~"~"   OP =~"=~"    EXP2 =~":usuario~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = datetime)  ARG(NAME = ~"fecha_fin~" TYPE = datetime)  ARG(NAME = ~"tipo_cliente~" TYPE = string)  ARG(NAME = ~"usuario~" TYPE = string) " arguments=(("fecha_ini", datetime),("fecha_fin", datetime),("tipo_cliente", string),("usuario", string))  sort="grupo A correlativo A " )
