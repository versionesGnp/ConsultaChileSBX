 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"ugn_ejecutivo_detalle~" )  TABLE(NAME=~"ugn_cliente~" ) COLUMN(NAME=~"ugn_ejecutivo_detalle.grupo~") COLUMN(NAME=~"ugn_ejecutivo_detalle.fecha_gestion~") COLUMN(NAME=~"ugn_ejecutivo_detalle.estado_gestion~") COLUMN(NAME=~"ugn_ejecutivo_detalle.glosa_gestion~") COLUMN(NAME=~"ugn_ejecutivo_detalle.usuario~") COLUMN(NAME=~"ugn_ejecutivo_detalle.fecha_prox_llamado~") COLUMN(NAME=~"ugn_ejecutivo_detalle.correlativo_cliente~") COLUMN(NAME=~"ugn_cliente.nombre~") COLUMN(NAME=~"ugn_cliente.a_paterno~") COLUMN(NAME=~"ugn_cliente.a_materno~") COLUMN(NAME=~"ugn_cliente.ult_fecha_gestion~")    JOIN (LEFT=~"ugn_ejecutivo_detalle.grupo_cliente~"    OP =~"=~"RIGHT=~"ugn_cliente.grupo~" )    JOIN (LEFT=~"ugn_ejecutivo_detalle.correlativo_cliente~"    OP =~"=~"RIGHT=~"ugn_cliente.correlativo~" )WHERE(    EXP1 =~"~~~"UGN_EJECUTIVO_DETALLE~~~".~~~"USUARIO~~~"~"   OP =~"=~"    EXP2 =~":usuario~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"UGN_EJECUTIVO_DETALLE~~~".~~~"ESTADO_GESTION~~~"~"   OP =~"<>~"    EXP2 =~"'0'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"UGN_EJECUTIVO_DETALLE~~~".~~~"FECHA_GESTION~~~"~"   OP =~">=~"    EXP2 =~":fec_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"UGN_EJECUTIVO_DETALLE~~~".~~~"FECHA_GESTION~~~"~"   OP =~"<=~"    EXP2 =~":fec_fin~" ) ) ARG(NAME = ~"usuario~" TYPE = string)  ARG(NAME = ~"fec_ini~" TYPE = date)  ARG(NAME = ~"fec_fin~" TYPE = date) " arguments=(("usuario", string),("fec_ini", date),("fec_fin", date))  sort="grupo A correlativo_cliente A " )
