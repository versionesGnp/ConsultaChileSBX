 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ugn_cliente~" ) COLUMN(NAME=~"ugn_cliente.rut~") COLUMN(NAME=~"ugn_cliente.tipo~") COLUMN(NAME=~"ugn_cliente.nombre~") COLUMN(NAME=~"ugn_cliente.a_paterno~") COLUMN(NAME=~"ugn_cliente.a_materno~") COLUMN(NAME=~"ugn_cliente.direccion_p~") COLUMN(NAME=~"ugn_cliente.poblacion~") COLUMN(NAME=~"ugn_cliente.sector~") COLUMN(NAME=~"ugn_cliente.comuna~") COLUMN(NAME=~"ugn_cliente.ciudad~") COLUMN(NAME=~"ugn_cliente.fono_p~") COLUMN(NAME=~"ugn_cliente.fecha_ingr~") COLUMN(NAME=~"ugn_cliente.usuario~") COLUMN(NAME=~"ugn_cliente.email~") COLUMN(NAME=~"ugn_cliente.celular~") COLUMN(NAME=~"ugn_cliente.numero_particular~") COLUMN(NAME=~"ugn_cliente.depto_particular~") COLUMN(NAME=~"ugn_cliente.block_particular~")WHERE(    EXP1 =~"~~~"UGN_CLIENTE~~~".~~~"GRUPO~~~"~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"UGN_CLIENTE~~~".~~~"FECHA_INGR~~~"~"   OP =~"=~"    EXP2 =~":fech_ingr~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"fech_ingr~" TYPE = datetime) " arguments=(("grupo", number),("fech_ingr", datetime)) )
