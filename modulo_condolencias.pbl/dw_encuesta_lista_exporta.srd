 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"vista_encuesta_lista~" )  TABLE(NAME=~"encuesta~" )  TABLE(NAME=~"cod_parq~" )  TABLE(NAME=~"tipo_venta~" )  TABLE(NAME=~"encuesta_box~" )  TABLE(NAME=~"ficha_sepultacion~" ) COLUMN(NAME=~"vista_encuesta_lista.cod_parque~") COLUMN(NAME=~"cod_parq.nombre~") COLUMN(NAME=~"vista_encuesta_lista.codigo~") COLUMN(NAME=~"vista_encuesta_lista.serie~") COLUMN(NAME=~"vista_encuesta_lista.numero~") COLUMN(NAME=~"vista_encuesta_lista.fec_sep~") COLUMN(NAME=~"vista_encuesta_lista.sector_sep~") COLUMN(NAME=~"vista_encuesta_lista.rut_fall~") COLUMN(NAME=~"vista_encuesta_lista.nombre_falle~") COLUMN(NAME=~"vista_encuesta_lista.ap_pater_fall~") COLUMN(NAME=~"vista_encuesta_lista.ap_mater_fall~") COLUMN(NAME=~"vista_encuesta_lista.rut~") COLUMN(NAME=~"vista_encuesta_lista.nombre_cliente~") COLUMN(NAME=~"vista_encuesta_lista.a_pater_cliente~") COLUMN(NAME=~"vista_encuesta_lista.a_mater_cliente~") COLUMN(NAME=~"vista_encuesta_lista.fono_p~") COLUMN(NAME=~"vista_encuesta_lista.fono_c~") COLUMN(NAME=~"vista_encuesta_lista.celular~") COLUMN(NAME=~"vista_encuesta_lista.usuario_creador~") COLUMN(NAME=~"vista_encuesta_lista.tipo_origen~") COLUMN(NAME=~"tipo_venta.descripcion~") COLUMN(NAME=~"vista_encuesta_lista.nombre_user~") COLUMN(NAME=~"vista_encuesta_lista.folio_encuesta~") COLUMN(NAME=~"vista_encuesta_lista.tipo_cliente~") COMPUTE(NAME=~"(CASE WHEN ~~~"VISTA_ENCUESTA_LISTA~~~".~~~"TIPO_CLIENTE~~~" = 'C' THEN 'CLIENTE' WHEN ~~~"VISTA_ENCUESTA_LISTA~~~".~~~"TIPO_CLIENTE~~~" = 'A' THEN 'ASISTENTE' END) AS TIPO_CLI_DESCRIP~") COLUMN(NAME=~"vista_encuesta_lista.estado_box~") COLUMN(NAME=~"vista_encuesta_lista.fecha_box~") COLUMN(NAME=~"encuesta_box.descripcion~") COMPUTE(NAME=~"(CASE WHEN ~~~"ENCUESTA~~~".~~~"COD_BOX~~~" = 1 THEN 'EFECTIVA' ELSE  'NO EFECTIVA' END) AS ENCUESTA~") COLUMN(NAME=~"vista_encuesta_lista.grupo~") COLUMN(NAME=~"vista_encuesta_lista.correlativo~") COMPUTE(NAME=~"(SELECT ~~~"ENCUESTA_EVALUACION~~~".~~~"COD_ENCUESTA~~~" FROM ~~~"ENCUESTA_EVALUACION~~~"  WHERE ~~~"ENCUESTA_EVALUACION~~~".~~~"FOLIO~~~" = ~~~"VISTA_ENCUESTA_LISTA~~~".~~~"FOLIO_ENCUESTA~~~" AND ~~~"ENCUESTA_EVALUACION~~~".~~~"COD_ENCUESTA~~~" = 1 AND ~~~"ENCUESTA_EVALUACION~~~".~~~"FECHA_CREA~~~" = ~~~"ENCUESTA~~~".~~~"FECHA_CREA~~~") AS NUN_PREG_1~") COMPUTE(NAME=~"(SELECT ~~~"ENCUESTA_ESTADO~~~".~~~"DESCRIPCION~~~" FROM ~~~"ENCUESTA_EVALUACION~~~",~~~"ENCUESTA_ESTADO~~~"  WHERE ~~~"ENCUESTA_EVALUACION~~~".~~~"COD_ENCUESTA~~~"=~~~"ENCUESTA_ESTADO~~~".~~~"COD_ENCUESTA~~~" AND ~~~"ENCUESTA_EVALUACION~~~".~~~"FOLIO~~~" = ~~~"VISTA_ENCUESTA_LISTA~~~".~~~"FOLIO_ENCUESTA~~~" AND ~~~"ENCUESTA_EVALUACION~~~".~~~"COD_ENCUESTA~~~" = 1 AND ~~~"ENCUESTA_EVALUACION~~~".~~~"FECHA_CREA~~~" = ~~~"ENCUESTA~~~".~~~"FECHA_CREA~~~") AS PREG_1~") COMPUTE(NAME=~"(SELECT ~~~"ENCUESTA_EVALUACION~~~".~~~"PUNTOS~~~" FROM ~~~"ENCUESTA_EVALUACION~~~"  WHERE ~~~"ENCUESTA_EVALUACION~~~".~~~"FOLIO~~~" = ~~~"VISTA_ENCUESTA_LISTA~~~".~~~"FOLIO_ENCUESTA~~~" AND ~~~"ENCUESTA_EVALUACION~~~".~~~"COD_ENCUESTA~~~" = 1 AND ~~~"ENCUESTA_EVALUACION~~~".~~~"FECHA_CREA~~~" = ~~~"ENCUESTA~~~".~~~"FECHA_CREA~~~") AS PTOS_PREG_1~") COMPUTE(NAME=~"(SELECT ~~~"ENCUESTA_EVALUACION~~~".~~~"COD_ENCUESTA~~~" FROM ~~~"ENCUESTA_EVALUACION~~~"  WHERE ~~~"ENCUESTA_EVALUACION~~~".~~~"FOLIO~~~" = ~~~"VISTA_ENCUESTA_LISTA~~~".~~~"FOLIO_ENCUESTA~~~" AND ~~~"ENCUESTA_EVALUACION~~~".~~~"COD_ENCUESTA~~~" = 2 AND ~~~"ENCUESTA_EVALUACION~~~".~~~"FECHA_CREA~~~" = ~~~"ENCUESTA~~~".~~~"FECHA_CREA~~~") AS NUN_PREG_2~") COMPUTE(NAME=~"(SELECT ~~~"ENCUESTA_ESTADO~~~".~~~"DESCRIPCION~~~" FROM ~~~"ENCUESTA_EVALUACION~~~",~~~"ENCUESTA_ESTADO~~~"  WHERE ~~~"ENCUESTA_EVALUACION~~~".~~~"COD_ENCUESTA~~~"=~~~"ENCUESTA_ESTADO~~~".~~~"COD_ENCUESTA~~~" AND ~~~"ENCUESTA_EVALUACION~~~".~~~"FOLIO~~~" = ~~~"VISTA_ENCUESTA_LISTA~~~".~~~"FOLIO_ENCUESTA~~~" AND ~~~"ENCUESTA_EVALUACION~~~".~~~"COD_ENCUESTA~~~" = 2 AND ~~~"ENCUESTA_EVALUACION~~~".~~~"FECHA_CREA~~~" = ~~~"ENCUESTA~~~".~~~"FECHA_CREA~~~") AS PREG_2~") COMPUTE(NAME=~"(SELECT ~~~"ENCUESTA_EVALUACION~~~".~~~"PUNTOS~~~" FROM ~~~"ENCUESTA_EVALUACION~~~"  WHERE ~~~"ENCUESTA_EVALUACION~~~".~~~"FOLIO~~~" = ~~~"VISTA_ENCUESTA_LISTA~~~".~~~"FOLIO_ENCUESTA~~~" AND ~~~"ENCUESTA_EVALUACION~~~".~~~"COD_ENCUESTA~~~" = 2 AND ~~~"ENCUESTA_EVALUACION~~~".~~~"FECHA_CREA~~~" = ~~~"ENCUESTA~~~".~~~"FECHA_CREA~~~") AS PTOS_PREG_2~") COMPUTE(NAME=~"(SELECT ~~~"ENCUESTA_EVALUACION~~~".~~~"COD_ENCUESTA~~~" FROM ~~~"ENCUESTA_EVALUACION~~~"  WHERE ~~~"ENCUESTA_EVALUACION~~~".~~~"FOLIO~~~" = ~~~"VISTA_ENCUESTA_LISTA~~~".~~~"FOLIO_ENCUESTA~~~" AND ~~~"ENCUESTA_EVALUACION~~~".~~~"COD_ENCUESTA~~~" = 3 AND ~~~"ENCUESTA_EVALUACION~~~".~~~"FECHA_CREA~~~" = ~~~"ENCUESTA~~~".~~~"FECHA_CREA~~~") AS NUN_PREG_3~") COMPUTE(NAME=~"(SELECT ~~~"ENCUESTA_ESTADO~~~".~~~"DESCRIPCION~~~" FROM ~~~"ENCUESTA_EVALUACION~~~",~~~"ENCUESTA_ESTADO~~~"  WHERE ~~~"ENCUESTA_EVALUACION~~~".~~~"COD_ENCUESTA~~~"=~~~"ENCUESTA_ESTADO~~~".~~~"COD_ENCUESTA~~~" AND ~~~"ENCUESTA_EVALUACION~~~".~~~"FOLIO~~~" = ~~~"VISTA_ENCUESTA_LISTA~~~".~~~"FOLIO_ENCUESTA~~~" AND ~~~"ENCUESTA_EVALUACION~~~".~~~"COD_ENCUESTA~~~" = 3 AND ~~~"ENCUESTA_EVALUACION~~~".~~~"FECHA_CREA~~~" = ~~~"ENCUESTA~~~".~~~"FECHA_CREA~~~") AS PREG_3~") COMPUTE(NAME=~"(SELECT ~~~"ENCUESTA_EVALUACION~~~".~~~"PUNTOS~~~" FROM ~~~"ENCUESTA_EVALUACION~~~"  WHERE ~~~"ENCUESTA_EVALUACION~~~".~~~"FOLIO~~~" = ~~~"VISTA_ENCUESTA_LISTA~~~".~~~"FOLIO_ENCUESTA~~~" AND ~~~"ENCUESTA_EVALUACION~~~".~~~"COD_ENCUESTA~~~" = 3 AND ~~~"ENCUESTA_EVALUACION~~~".~~~"FECHA_CREA~~~" = ~~~"ENCUESTA~~~".~~~"FECHA_CREA~~~") AS PTOS_PREG_3~") COMPUTE(NAME=~"(SELECT ~~~"ENCUESTA_EVALUACION~~~".~~~"COD_ENCUESTA~~~" FROM ~~~"ENCUESTA_EVALUACION~~~"  WHERE ~~~"ENCUESTA_EVALUACION~~~".~~~"FOLIO~~~" = ~~~"VISTA_ENCUESTA_LISTA~~~".~~~"FOLIO_ENCUESTA~~~" AND ~~~"ENCUESTA_EVALUACION~~~".~~~"COD_ENCUESTA~~~" = 4 AND ~~~"ENCUESTA_EVALUACION~~~".~~~"FECHA_CREA~~~" = ~~~"ENCUESTA~~~".~~~"FECHA_CREA~~~") AS NUN_PREG_4~") COMPUTE(NAME=~"(SELECT ~~~"ENCUESTA_ESTADO~~~".~~~"DESCRIPCION~~~" FROM ~~~"ENCUESTA_EVALUACION~~~",~~~"ENCUESTA_ESTADO~~~"  WHERE ~~~"ENCUESTA_EVALUACION~~~".~~~"COD_ENCUESTA~~~"=~~~"ENCUESTA_ESTADO~~~".~~~"COD_ENCUESTA~~~" AND ~~~"ENCUESTA_EVALUACION~~~".~~~"FOLIO~~~" = ~~~"VISTA_ENCUESTA_LISTA~~~".~~~"FOLIO_ENCUESTA~~~" AND ~~~"ENCUESTA_EVALUACION~~~".~~~"COD_ENCUESTA~~~" = 4 AND ~~~"ENCUESTA_EVALUACION~~~".~~~"FECHA_CREA~~~" = ~~~"ENCUESTA~~~".~~~"FECHA_CREA~~~") AS PREG_4~") COMPUTE(NAME=~"(SELECT ~~~"ENCUESTA_EVALUACION~~~".~~~"PUNTOS~~~" FROM ~~~"ENCUESTA_EVALUACION~~~"  WHERE ~~~"ENCUESTA_EVALUACION~~~".~~~"FOLIO~~~" = ~~~"VISTA_ENCUESTA_LISTA~~~".~~~"FOLIO_ENCUESTA~~~" AND ~~~"ENCUESTA_EVALUACION~~~".~~~"COD_ENCUESTA~~~" = 4 AND ~~~"ENCUESTA_EVALUACION~~~".~~~"FECHA_CREA~~~" = ~~~"ENCUESTA~~~".~~~"FECHA_CREA~~~") AS PTOS_PREG_4~") COLUMN(NAME=~"encuesta.observacion~") COLUMN(NAME=~"vista_encuesta_lista.evalua~") COLUMN(NAME=~"encuesta.usuario_crea~") COLUMN(NAME=~"ficha_sepultacion.sw_condolencia~") COLUMN(NAME=~"ficha_sepultacion.sw_tipo_ficha~") COLUMN(NAME=~"ficha_sepultacion.codigo_ejecutivo~")    JOIN (LEFT=~"vista_encuesta_lista.folio_encuesta~"    OP =~"=~"RIGHT=~"encuesta.folio~" )    JOIN (LEFT=~"vista_encuesta_lista.cod_parque~"    OP =~"=~"RIGHT=~"cod_parq.codigo~" )    JOIN (LEFT=~"vista_encuesta_lista.tipo_origen~"    OP =~"=~"RIGHT=~"tipo_venta.tip_venta~" )    JOIN (LEFT=~"encuesta.cod_box~"    OP =~"=~"RIGHT=~"encuesta_box.cod_box~" )    JOIN (LEFT=~"vista_encuesta_lista.numero~"    OP =~"=~"RIGHT=~"ficha_sepultacion.numero~" )    JOIN (LEFT=~"vista_encuesta_lista.serie~"    OP =~"=~"RIGHT=~"ficha_sepultacion.serie~" )    JOIN (LEFT=~"vista_encuesta_lista.codigo~"    OP =~"=~"RIGHT=~"ficha_sepultacion.base~" )    JOIN (LEFT=~"vista_encuesta_lista.fec_sep~"    OP =~"=~"RIGHT=~"ficha_sepultacion.fecha_sepultacion~" )    JOIN (LEFT=~"vista_encuesta_lista.rut_fall~"    OP =~"=~"RIGHT=~"ficha_sepultacion.rut_fallecido~" )WHERE(    EXP1 =~"~~~"VISTA_ENCUESTA_LISTA~~~".~~~"FEC_SEP~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"VISTA_ENCUESTA_LISTA~~~".~~~"FEC_SEP~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = datetime)  ARG(NAME = ~"fecha_fin~" TYPE = datetime) " arguments=(("fecha_ini", datetime),("fecha_fin", datetime))  sort="grupo A correlativo A " )
