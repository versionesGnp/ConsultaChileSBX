 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ugn_cliente~" )  TABLE(NAME=~"ugn_cliente_asignar_falle~" )  TABLE(NAME=~"ugn_gestion_sup~" ) COLUMN(NAME=~"ugn_cliente.grupo~") COLUMN(NAME=~"ugn_cliente.correlativo~") COLUMN(NAME=~"ugn_cliente.rut~") COLUMN(NAME=~"ugn_cliente.dv~") COLUMN(NAME=~"ugn_cliente.nombre~") COLUMN(NAME=~"ugn_cliente.a_paterno~") COLUMN(NAME=~"ugn_cliente.a_materno~") COLUMN(NAME=~"ugn_gestion_sup.estado_gestion~") COLUMN(NAME=~"ugn_gestion_sup.fecha_gestion~") COLUMN(NAME=~"ugn_gestion_sup.glosa_gestion~") COLUMN(NAME=~"ugn_gestion_sup.fecha_prox_llamado~") COLUMN(NAME=~"ugn_gestion_sup.usuario_gestor~") COLUMN(NAME=~"ugn_cliente_asignar_falle.codigo_convenio~") COMPUTE(NAME=~"'SUP' as tipo_gestion~") COLUMN(NAME=~"ugn_cliente.comuna~") COLUMN(NAME=~"ugn_cliente.ciudad~") COLUMN(NAME=~"ugn_cliente.fono_p~") COLUMN(NAME=~"ugn_cliente.fono_c~") COLUMN(NAME=~"ugn_cliente.celular~") COLUMN(NAME=~"ugn_cliente.email~") COLUMN(NAME=~"ugn_cliente.tipo_via~") COLUMN(NAME=~"ugn_cliente.direccion_p~") COLUMN(NAME=~"ugn_cliente.numero_particular~") COLUMN(NAME=~"ugn_cliente.depto_particular~") COLUMN(NAME=~"ugn_cliente.block_particular~") COLUMN(NAME=~"ugn_cliente_asignar_falle.parque~")    JOIN (LEFT=~"ugn_cliente.grupo~"    OP =~"=~"RIGHT=~"ugn_cliente_asignar_falle.grupo~" )    JOIN (LEFT=~"ugn_cliente.correlativo~"    OP =~"=~"RIGHT=~"ugn_gestion_sup.correlativo~" )    JOIN (LEFT=~"ugn_cliente.grupo~"    OP =~"=~"RIGHT=~"ugn_gestion_sup.grupo~" )    JOIN (LEFT=~"ugn_cliente_asignar_falle.grupo~"    OP =~"=~"RIGHT=~"ugn_gestion_sup.grupo~" )WHERE(    EXP1 =~"~~~"UGN_CLIENTE~~~".~~~"GRUPO~~~"~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"UGN_CLIENTE~~~".~~~"CORRELATIVO~~~"~"   OP =~"=~"    EXP2 =~":corre~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"UGN_GESTION_SUP~~~".~~~"ESTADO_GESTION~~~"~"   OP =~"=~"    EXP2 =~":estado_gestion~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"UGN_GESTION_SUP~~~".~~~"FECHA_GESTION~~~"~"   OP =~"=~"    EXP2 =~":fecha_gestion~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"UGN_GESTION_SUP~~~".~~~"GLOSA_GESTION~~~"~"   OP =~"=~"    EXP2 =~":glosa_gestion~" ) )    UNION (PBSELECT( VERSION(400) TABLE(NAME=~"ugn_cliente~" )  TABLE(NAME=~"ugn_ejecutivo~" )  TABLE(NAME=~"ugn_ejecutivo_detalle~" ) COLUMN(NAME=~"ugn_cliente.grupo~") COLUMN(NAME=~"ugn_cliente.correlativo~") COLUMN(NAME=~"ugn_cliente.rut~") COLUMN(NAME=~"ugn_cliente.dv~") COLUMN(NAME=~"ugn_cliente.nombre~") COLUMN(NAME=~"ugn_cliente.a_paterno~") COLUMN(NAME=~"ugn_cliente.a_materno~") COLUMN(NAME=~"ugn_ejecutivo_detalle.estado_gestion~") COLUMN(NAME=~"ugn_ejecutivo_detalle.fecha_gestion~") COLUMN(NAME=~"ugn_ejecutivo_detalle.glosa_gestion~") COLUMN(NAME=~"ugn_ejecutivo_detalle.fecha_prox_llamado~") COLUMN(NAME=~"ugn_ejecutivo_detalle.usuario~") COLUMN(NAME=~"ugn_ejecutivo.codigo_convenio~") COMPUTE(NAME=~"'UGN' as tipo_gestion~") COLUMN(NAME=~"ugn_cliente.comuna~") COLUMN(NAME=~"ugn_cliente.ciudad~") COLUMN(NAME=~"ugn_cliente.fono_p~") COLUMN(NAME=~"ugn_cliente.fono_c~") COLUMN(NAME=~"ugn_cliente.celular~") COLUMN(NAME=~"ugn_cliente.email~") COLUMN(NAME=~"ugn_cliente.tipo_via~") COLUMN(NAME=~"ugn_cliente.direccion_p~") COLUMN(NAME=~"ugn_cliente.numero_particular~") COLUMN(NAME=~"ugn_cliente.depto_particular~") COLUMN(NAME=~"ugn_cliente.block_particular~") COLUMN(NAME=~"ugn_ejecutivo.parque~")    JOIN (LEFT=~"ugn_cliente.grupo~"    OP =~"=~"RIGHT=~"ugn_ejecutivo_detalle.grupo_cliente~" )    JOIN (LEFT=~"ugn_cliente.correlativo~"    OP =~"=~"RIGHT=~"ugn_ejecutivo_detalle.correlativo_cliente~" )    JOIN (LEFT=~"ugn_ejecutivo_detalle.grupo~"    OP =~"=~"RIGHT=~"ugn_ejecutivo.grupo~" )WHERE(    EXP1 =~"~~~"UGN_CLIENTE~~~".~~~"GRUPO~~~"~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"UGN_CLIENTE~~~".~~~"CORRELATIVO~~~"~"   OP =~"=~"    EXP2 =~":corre~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"UGN_EJECUTIVO_DETALLE~~~".~~~"ESTADO_GESTION~~~"~"   OP =~"=~"    EXP2 =~":estado_gestion~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"UGN_EJECUTIVO_DETALLE~~~".~~~"FECHA_GESTION~~~"~"   OP =~"=~"    EXP2 =~":fecha_gestion~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"UGN_EJECUTIVO_DETALLE~~~".~~~"GLOSA_GESTION~~~"~"   OP =~"=~"    EXP2 =~":glosa_gestion~" ) )) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"corre~" TYPE = number)  ARG(NAME = ~"estado_gestion~" TYPE = string)  ARG(NAME = ~"fecha_gestion~" TYPE = datetime)  ARG(NAME = ~"glosa_gestion~" TYPE = string) " arguments=(("grupo", number),("corre", number),("estado_gestion", string),("fecha_gestion", datetime),("glosa_gestion", string))  sort="ugn_gestion_sup_fecha_gestion D " )
