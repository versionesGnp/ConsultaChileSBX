table(column=(type=char(3) updatewhereclause=yes name=c_tipo_ugn dbname="c_tipo_ugn" )
 column=(type=char(15) updatewhereclause=yes name=ugn_cliente_asignar_falle_cod_age dbname="ugn_cliente_asignar_falle.cod_age" )
 column=(type=char(50) updatewhereclause=yes name=agentes_a_paterno dbname="agentes.a_paterno" )
 column=(type=char(20) updatewhereclause=yes name=agentes_nombre dbname="agentes.nombre" )
 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"ugn_gestion_sup~" )  TABLE(NAME=~"ugn_cliente_asignar_falle~" )  TABLE(NAME=~"agentes~" ) COMPUTE(NAME=~"'SUP' as c_tipo_ugn~") COLUMN(NAME=~"ugn_cliente_asignar_falle.cod_age~") COLUMN(NAME=~"agentes.a_paterno~") COMPUTE(NAME=~"~~~"AGENTES~~~".~~~"NOMBRE~~~"~")    JOIN (LEFT=~"ugn_gestion_sup.grupo~"    OP =~"=~"RIGHT=~"ugn_cliente_asignar_falle.grupo~" )    JOIN (LEFT=~"ugn_cliente_asignar_falle.cod_age~"    OP =~"=~"RIGHT=~"agentes.cod_age~" )WHERE(    EXP1 =~"~~~"UGN_CLIENTE_ASIGNAR_FALLE~~~".~~~"COD_SUP~~~"~"   OP =~"=~"    EXP2 =~":usuario~" ) )    UNION (PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"ugn_ejecutivo_detalle~" )  TABLE(NAME=~"encargados~" )  TABLE(NAME=~"agentes~" ) COMPUTE(NAME=~"'UGN' as c_tipo_ugn~") COLUMN(NAME=~"ugn_ejecutivo_detalle.usuario~") COLUMN(NAME=~"agentes.a_paterno~") COLUMN(NAME=~"agentes.nombre~")    JOIN (LEFT=~"ugn_ejecutivo_detalle.usuario~"    OP =~"=~"RIGHT=~"encargados.codigo_usuario~" )    JOIN (LEFT=~"encargados.codigo_usuario~"    OP =~"=~"RIGHT=~"agentes.cod_age~" )WHERE(    EXP1 =~"~~~"ENCARGADOS~~~".~~~"DEPTO~~~"~"   OP =~"=~"    EXP2 =~"'X'~" ) )) ARG(NAME = ~"codigo~" TYPE = string)  ARG(NAME = ~"usuario~" TYPE = string) " filter=" codigo = c_tipo_ugn "arguments=(("codigo", string),("usuario", string))  sort="agentes_nombre A agentes_a_paterno A " )
