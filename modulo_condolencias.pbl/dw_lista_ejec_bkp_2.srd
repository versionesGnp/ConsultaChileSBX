 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"ugn_cliente~" )  TABLE(NAME=~"ugn_cliente_asignar_falle~" ) COLUMN(NAME=~"ugn_cliente.rut~") COLUMN(NAME=~"ugn_cliente.nombre~") COLUMN(NAME=~"ugn_cliente.a_paterno~") COLUMN(NAME=~"ugn_cliente.a_materno~") COLUMN(NAME=~"ugn_cliente.fono_p~") COLUMN(NAME=~"ugn_cliente.fono_c~") COLUMN(NAME=~"ugn_cliente.celular~") COLUMN(NAME=~"ugn_cliente.grupo~") COLUMN(NAME=~"ugn_cliente.correlativo~") COLUMN(NAME=~"ugn_cliente.ult_estado_gestion~") COLUMN(NAME=~"ugn_cliente.ult_fecha_gestion~") COLUMN(NAME=~"ugn_cliente.ult_glosa_gestion~") COLUMN(NAME=~"ugn_cliente.estado_registro~") COLUMN(NAME=~"ugn_cliente.estado_grupo~") COMPUTE(NAME=~"0~") COLUMN(NAME=~"ugn_cliente_asignar_falle.parque~") COLUMN(NAME=~"ugn_cliente.dv~") COLUMN(NAME=~"ugn_cliente.prox_llamado_cob~") COLUMN(NAME=~"ugn_cliente_asignar_falle.tipo_origen~") COLUMN(NAME=~"ugn_cliente_asignar_falle.codigo_convenio~") COMPUTE(NAME=~"'ASIG' as tipo_asigna~")    JOIN (LEFT=~"ugn_cliente.grupo~"    OP =~"=~"RIGHT=~"ugn_cliente_asignar_falle.grupo~" )WHERE(    EXP1 =~"(~~~"UGN_CLIENTE_ASIGNAR_FALLE~~~".~~~"FECHA_INGRESO~~~" + :al_dias)~"   OP =~"<~"    EXP2 =~":fecha_ini~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"UGN_CLIENTE_ASIGNAR_FALLE~~~".~~~"PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"UGN_CLIENTE~~~".~~~"ESTADO_REGISTRO~~~"~"   OP =~"<>~"    EXP2 =~"'B'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"UGN_CLIENTE~~~".~~~"ULT_ESTADO_GESTION~~~"~"   OP =~"<>~"    EXP2 =~"'23'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"UGN_CLIENTE~~~".~~~"ULT_ESTADO_GESTION~~~"~"   OP =~"<>~"    EXP2 =~"'12'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"UGN_CLIENTE~~~".~~~"ULT_ESTADO_GESTION~~~"~"   OP =~"<>~"    EXP2 =~"'24'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"UGN_CLIENTE~~~".~~~"ULT_ESTADO_GESTION~~~"~"   OP =~"<>~"    EXP2 =~"'22'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"UGN_CLIENTE~~~".~~~"ULT_ESTADO_GESTION~~~"~"   OP =~"<>~"    EXP2 =~"'25'~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = date)  ARG(NAME = ~"parque~" TYPE = number)  ARG(NAME = ~"al_dias~" TYPE = number) " arguments=(("fecha_ini", date),("parque", number),("al_dias", number))  sort="ugn_cliente_grupo D ugn_cliente_correlativo A ugn_cliente_a_paterno A ugn_cliente_a_materno A ugn_cliente_nombre A " )
