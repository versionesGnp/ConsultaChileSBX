table(column=(type=char(20) updatewhereclause=yes name=tipo_cli_descrip dbname="tipo_cli_descrip" )
 column=(type=char(20) updatewhereclause=yes name=parque dbname="parque" )
 column=(type=char(20) updatewhereclause=yes name=encuenta dbname="encuenta" )
 column=(type=char(20) updatewhereclause=yes name=maestro dbname="maestro" )
 column=(type=number updatewhereclause=yes name=tot_reg dbname="tot_reg" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"vista_encuesta_lista~" )  TABLE(NAME=~"cod_parq~" )  TABLE(NAME=~"encuesta_box~" )  TABLE(NAME=~"tipo_venta~" )  TABLE(NAME=~"encuesta~" )  TABLE(NAME=~"encuesta_infor_parametro~" ) COMPUTE(NAME=~"(CASE WHEN ~~~"VISTA_ENCUESTA_LISTA~~~".~~~"TIPO_CLIENTE~~~" = 'C' THEN '1-CLIENTE' WHEN ~~~"VISTA_ENCUESTA_LISTA~~~".~~~"TIPO_CLIENTE~~~" = 'A' THEN '2-ASISTENTE' END) AS TIPO_CLI_DESCRIP~") COMPUTE(NAME=~"(CASE WHEN ~~~"ENCUESTA~~~".~~~"COD_BOX~~~" = 1 THEN 'EFECTIVA' ELSE  'NO EFECTIVA' END) AS ENCUENTA~") COMPUTE(NAME=~"(~~~"COD_PARQ~~~".~~~"NOMBRE~~~") AS PARQUE~") COMPUTE(NAME=~"(~~~"VISTA_ENCUESTA_LISTA~~~".~~~"USUARIO_CREADOR~~~"||'-'||~~~"VISTA_ENCUESTA_LISTA~~~".~~~"NOMBRE_USER~~~") AS MAESTRO~") COMPUTE(NAME=~"(~~~"VISTA_ENCUESTA_LISTA~~~".~~~"ESTADO_BOX~~~"||'-'||~~~"ENCUESTA_BOX~~~".~~~"DESCRIPCION~~~") AS ESTADO_BOX~") COMPUTE(NAME=~"1 AS TOT_REG~")    JOIN (LEFT=~"vista_encuesta_lista.cod_parque~"    OP =~"=~"RIGHT=~"cod_parq.codigo~" )    JOIN (LEFT=~"vista_encuesta_lista.tipo_origen~"    OP =~"=~"RIGHT=~"tipo_venta.tip_venta~" )    JOIN (LEFT=~"vista_encuesta_lista.folio_encuesta~"    OP =~"=~"RIGHT=~"encuesta.folio~" )    JOIN (LEFT=~"encuesta.cod_box~"    OP =~"=~"RIGHT=~"encuesta_box.cod_box~" )WHERE(    EXP1 =~"~~~"VISTA_ENCUESTA_LISTA~~~".~~~"FEC_SEP~~~"~"   OP =~">=~"    EXP2 =~"~~~"ENCUESTA_INFOR_PARAMETRO~~~".~~~"FECHA_INI~~~"~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"VISTA_ENCUESTA_LISTA~~~".~~~"FEC_SEP~~~"~"   OP =~"<=~"    EXP2 =~"~~~"ENCUESTA_INFOR_PARAMETRO~~~".~~~"FECHA_FIN~~~"~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"VISTA_ENCUESTA_LISTA~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~"~~~"ENCUESTA_INFOR_PARAMETRO~~~".~~~"COD_PARQUE~~~"~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"ENCUESTA_INFOR_PARAMETRO~~~".~~~"TIPO_INFOR~~~"~"   OP =~"=~"    EXP2 =~"6~" ) ) "  sort="tipo_cli_descrip A parque A encuenta A maestro A " )
