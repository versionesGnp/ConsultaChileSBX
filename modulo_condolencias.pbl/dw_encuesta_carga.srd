 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"encuesta~" ) COLUMN(NAME=~"encuesta.folio~") COLUMN(NAME=~"encuesta.rut~") COLUMN(NAME=~"encuesta.base~") COLUMN(NAME=~"encuesta.serie~") COLUMN(NAME=~"encuesta.numero~") COLUMN(NAME=~"encuesta.observacion~") COLUMN(NAME=~"encuesta.fecha_crea~") COLUMN(NAME=~"encuesta.usuario_crea~") COLUMN(NAME=~"encuesta.estado~") COLUMN(NAME=~"encuesta.cod_box~") COLUMN(NAME=~"encuesta.fecha_box~") COLUMN(NAME=~"encuesta.rut_fallecido~")WHERE(    EXP1 =~"~~~"ENCUESTA~~~".~~~"FOLIO~~~"~"   OP =~"=~"    EXP2 =~":folio~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"ENCUESTA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'V'~" ) ) ARG(NAME = ~"folio~" TYPE = number) " update="ENCUESTA" updatewhere=1 updatekeyinplace=yes arguments=(("folio", number)) )
