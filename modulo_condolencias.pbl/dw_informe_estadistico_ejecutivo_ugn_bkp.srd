 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ugn_cliente~" )  TABLE(NAME=~"ugn_ejecutivo~" )  TABLE(NAME=~"ugn_ejecutivo_detalle~" ) COLUMN(NAME=~"ugn_cliente.ult_estado_gestion~") COLUMN(NAME=~"ugn_cliente.ult_fecha_gestion~")    JOIN (LEFT=~"ugn_cliente.grupo~"    OP =~"=~"RIGHT=~"ugn_ejecutivo_detalle.grupo_cliente~" )    JOIN (LEFT=~"ugn_cliente.correlativo~"    OP =~"=~"RIGHT=~"ugn_ejecutivo_detalle.correlativo_cliente~" )    JOIN (LEFT=~"ugn_ejecutivo_detalle.grupo~"    OP =~"=~"RIGHT=~"ugn_ejecutivo.grupo~" )WHERE(    EXP1 =~"~~~"UGN_CLIENTE~~~".~~~"ULT_FECHA_GESTION~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"UGN_CLIENTE~~~".~~~"ULT_FECHA_GESTION~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"UGN_EJECUTIVO_DETALLE~~~".~~~"USUARIO~~~"~"   OP =~"like~"    EXP2 =~":ejecutivo~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = datetime)  ARG(NAME = ~"fecha_fin~" TYPE = datetime)  ARG(NAME = ~"ejecutivo~" TYPE = string) " arguments=(("fecha_ini", datetime),("fecha_fin", datetime),("ejecutivo", string))  sort="ugn_cliente_ult_fecha_gestion A " )
