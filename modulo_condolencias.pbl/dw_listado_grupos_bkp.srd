 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ugn_cliente_asignar_falle~" ) COLUMN(NAME=~"ugn_cliente_asignar_falle.parque~") COLUMN(NAME=~"ugn_cliente_asignar_falle.grupo~") COLUMN(NAME=~"ugn_cliente_asignar_falle.usuario_creador~") COLUMN(NAME=~"ugn_cliente_asignar_falle.estado_registro~") COLUMN(NAME=~"ugn_cliente_asignar_falle.fecha_ingreso~") COMPUTE(NAME=~"'UGN'~") COLUMN(NAME=~"ugn_cliente_asignar_falle.observacion~") COLUMN(NAME=~"ugn_cliente_asignar_falle.fecha_sepultacion~") COLUMN(NAME=~"ugn_cliente_asignar_falle.nombre_fallecido~") COLUMN(NAME=~"ugn_cliente_asignar_falle.a_paterno_fallecido~") COLUMN(NAME=~"ugn_cliente_asignar_falle.a_materno_fallecido~") COLUMN(NAME=~"ugn_cliente_asignar_falle.tipo_origen~") COLUMN(NAME=~"ugn_cliente_asignar_falle.cod_sup~") COLUMN(NAME=~"ugn_cliente_asignar_falle.cod_age~")WHERE(    EXP1 =~"~~~"UGN_CLIENTE_ASIGNAR_FALLE~~~".~~~"FECHA_INGRESO~~~"~"   OP =~">=~"    EXP2 =~":fec_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"UGN_CLIENTE_ASIGNAR_FALLE~~~".~~~"FECHA_INGRESO~~~"~"   OP =~"<=~"    EXP2 =~":fec_fin~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"UGN_CLIENTE_ASIGNAR_FALLE~~~".~~~"PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~" ) )    UNION (PBSELECT( VERSION(400) TABLE(NAME=~"ugn_ejecutivo~" )  TABLE(NAME=~"ugn_cliente_asignar_falle~" ) COLUMN(NAME=~"ugn_ejecutivo.parque~") COLUMN(NAME=~"ugn_ejecutivo.grupo~") COLUMN(NAME=~"ugn_ejecutivo.usuario_asignador~") COLUMN(NAME=~"ugn_ejecutivo.estado_registro~") COLUMN(NAME=~"ugn_ejecutivo.fecha_asignacion~") COMPUTE(NAME=~"'SUP'~") COLUMN(NAME=~"ugn_ejecutivo.observacion~") COLUMN(NAME=~"ugn_cliente_asignar_falle.fecha_sepultacion~") COLUMN(NAME=~"ugn_cliente_asignar_falle.nombre_fallecido~") COLUMN(NAME=~"ugn_cliente_asignar_falle.a_paterno_fallecido~") COLUMN(NAME=~"ugn_cliente_asignar_falle.a_materno_fallecido~") COLUMN(NAME=~"ugn_cliente_asignar_falle.tipo_origen~") COLUMN(NAME=~"ugn_cliente_asignar_falle.cod_age~") COLUMN(NAME=~"ugn_cliente_asignar_falle.cod_sup~")    JOIN (LEFT=~"ugn_ejecutivo.grupo~"    OP =~"=~"RIGHT=~"ugn_cliente_asignar_falle.grupo~" )WHERE(    EXP1 =~"~~~"UGN_EJECUTIVO~~~".~~~"FECHA_ASIGNACION~~~"~"   OP =~">=~"    EXP2 =~":fec_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"UGN_EJECUTIVO~~~".~~~"FECHA_ASIGNACION~~~"~"   OP =~"<=~"    EXP2 =~":fec_fin~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"UGN_EJECUTIVO~~~".~~~"PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~" ) )) ARG(NAME = ~"fec_ini~" TYPE = date)  ARG(NAME = ~"fec_fin~" TYPE = date)  ARG(NAME = ~"parque~" TYPE = number) " arguments=(("fec_ini", date),("fec_fin", date),("parque", number))  sort="grupo A fecha_ingreso D " )
