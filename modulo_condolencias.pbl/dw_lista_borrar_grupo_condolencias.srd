 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ugn_cliente~" ) COLUMN(NAME=~"ugn_cliente.correlativo~") COLUMN(NAME=~"ugn_cliente.nombre~") COLUMN(NAME=~"ugn_cliente.a_paterno~") COLUMN(NAME=~"ugn_cliente.a_materno~") COLUMN(NAME=~"ugn_cliente.fono_p~") COLUMN(NAME=~"ugn_cliente.celular~")WHERE(    EXP1 =~"~~~"UGN_CLIENTE~~~".~~~"GRUPO~~~"~"   OP =~"=~"    EXP2 =~":ll_grupo~" ) ) ARG(NAME = ~"ll_grupo~" TYPE = number) " arguments=(("ll_grupo", number)) )
