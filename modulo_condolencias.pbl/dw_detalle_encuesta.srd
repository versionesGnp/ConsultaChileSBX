 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ugn_cliente~" )  TABLE(NAME=~"ugn_encuesta_servicio~" ) COLUMN(NAME=~"ugn_cliente.grupo~") COLUMN(NAME=~"ugn_cliente.correlativo~") COLUMN(NAME=~"ugn_cliente.nombre~") COLUMN(NAME=~"ugn_cliente.a_paterno~") COLUMN(NAME=~"ugn_cliente.a_materno~") COLUMN(NAME=~"ugn_encuesta_servicio.nota_servicio~") COLUMN(NAME=~"ugn_encuesta_servicio.nota_maestro_c~")    JOIN (LEFT=~"ugn_cliente.grupo~"    OP =~"=~"RIGHT=~"ugn_encuesta_servicio.grupo~" )    JOIN (LEFT=~"ugn_cliente.correlativo~"    OP =~"=~"RIGHT=~"ugn_encuesta_servicio.correlativo~" )WHERE(    EXP1 =~"~~~"UGN_ENCUESTA_SERVICIO~~~".~~~"NOTA_SERVICIO~~~"~"   OP =~">~"    EXP2 =~"0~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"UGN_ENCUESTA_SERVICIO~~~".~~~"NOTA_MAESTRO_C~~~"~"   OP =~">~"    EXP2 =~"0~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"UGN_ENCUESTA_SERVICIO~~~".~~~"GRUPO~~~"~"   OP =~"=~"    EXP2 =~":ll_grupo~" ) ) ARG(NAME = ~"ll_grupo~" TYPE = number) " arguments=(("ll_grupo", number))  sort="ugn_cliente_grupo A ugn_cliente_correlativo A " )
