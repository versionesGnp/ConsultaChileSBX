 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ugn_ejecutivo_detalle~" )  TABLE(NAME=~"ugn_estado_gestion~" ) COLUMN(NAME=~"ugn_ejecutivo_detalle.fecha_gestion~") COLUMN(NAME=~"ugn_ejecutivo_detalle.usuario~") COLUMN(NAME=~"ugn_estado_gestion.glosa_estado~")    JOIN (LEFT=~"ugn_ejecutivo_detalle.estado_gestion~"    OP =~"=~"RIGHT=~"ugn_estado_gestion.cod_estado~" )WHERE(    EXP1 =~"~~~"UGN_EJECUTIVO_DETALLE~~~".~~~"FECHA_GESTION~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"UGN_EJECUTIVO_DETALLE~~~".~~~"FECHA_GESTION~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"UGN_EJECUTIVO_DETALLE~~~".~~~"USUARIO~~~"~"   OP =~"=~"    EXP2 =~":ejecutivo~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"UGN_EJECUTIVO_DETALLE~~~".~~~"ESTADO_GESTION~~~"~"   OP =~"<>~"    EXP2 =~"'0'~" ) ) ARG(NAME = ~"ejecutivo~" TYPE = string)  ARG(NAME = ~"fecha_ini~" TYPE = date)  ARG(NAME = ~"fecha_fin~" TYPE = date) " arguments=(("ejecutivo", string),("fecha_ini", date),("fecha_fin", date))  sort="ugn_estado_gestion_glosa_estado A " )
