 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"ugn_cliente_asignar_falle~" ) COLUMN(NAME=~"ugn_cliente_asignar_falle.usuario_creador~") COLUMN(NAME=~"ugn_cliente_asignar_falle.parque~") COLUMN(NAME=~"ugn_cliente_asignar_falle.fecha_sepultacion~") COLUMN(NAME=~"ugn_cliente_asignar_falle.nombre_fallecido~") COLUMN(NAME=~"ugn_cliente_asignar_falle.a_paterno_fallecido~") COLUMN(NAME=~"ugn_cliente_asignar_falle.a_materno_fallecido~") COLUMN(NAME=~"ugn_cliente_asignar_falle.rut_fallecido~") COLUMN(NAME=~"ugn_cliente_asignar_falle.dv~")WHERE(    EXP1 =~"~~~"UGN_CLIENTE_ASIGNAR_FALLE~~~".~~~"FECHA_SEPULTACION~~~"~"   OP =~">=~"    EXP2 =~":fec_inicio~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"UGN_CLIENTE_ASIGNAR_FALLE~~~".~~~"FECHA_SEPULTACION~~~"~"   OP =~"<=~"    EXP2 =~":fec_final~" ) ) ARG(NAME = ~"fec_inicio~" TYPE = datetime)  ARG(NAME = ~"fec_final~" TYPE = datetime) " arguments=(("fec_inicio", datetime),("fec_final", datetime))  sort="usuario_creador A fecha_sepultacion A " )
