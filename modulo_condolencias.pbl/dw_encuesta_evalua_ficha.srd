 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"encuesta_estado~" ) COLUMN(NAME=~"encuesta_estado.cod_encuesta~") COLUMN(NAME=~"encuesta_estado.descripcion~") COLUMN(NAME=~"encuesta_estado.puntos~") COMPUTE(NAME=~"0 as nota1~") COMPUTE(NAME=~"0 as nota2~") COMPUTE(NAME=~"0 as nota3~") COMPUTE(NAME=~"0 as nota4~") COMPUTE(NAME=~"0 as nota5~") COMPUTE(NAME=~"0 as nota6~") COMPUTE(NAME=~"0 as nota7~") COMPUTE(NAME=~"0 as nota0~")WHERE(    EXP1 =~"~~~"ENCUESTA_ESTADO~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'V'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"ENCUESTA_ESTADO~~~".~~~"COD_ENCUESTA~~~"~"   OP =~">~"    EXP2 =~"1~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"ENCUESTA_ESTADO~~~".~~~"COD_ENCUESTA~~~"~"   OP =~"<>~"    EXP2 =~"5~" ) ) " )
