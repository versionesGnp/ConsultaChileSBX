 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ugn_cliente_asignar_falle~" )  TABLE(NAME=~"supervisor~" )  TABLE(NAME=~"jefe_ventas~" ) COLUMN(NAME=~"ugn_cliente_asignar_falle.parque~") COLUMN(NAME=~"ugn_cliente_asignar_falle.grupo~") COLUMN(NAME=~"ugn_cliente_asignar_falle.usuario_creador~") COLUMN(NAME=~"ugn_cliente_asignar_falle.estado_registro~") COLUMN(NAME=~"ugn_cliente_asignar_falle.fecha_ingreso~") COMPUTE(NAME=~"'SUP'~") COLUMN(NAME=~"ugn_cliente_asignar_falle.observacion~") COLUMN(NAME=~"ugn_cliente_asignar_falle.fecha_sepultacion~") COLUMN(NAME=~"ugn_cliente_asignar_falle.nombre_fallecido~") COLUMN(NAME=~"ugn_cliente_asignar_falle.a_paterno_fallecido~") COLUMN(NAME=~"ugn_cliente_asignar_falle.a_materno_fallecido~") COLUMN(NAME=~"ugn_cliente_asignar_falle.tipo_origen~") COLUMN(NAME=~"ugn_cliente_asignar_falle.cod_sup~") COLUMN(NAME=~"ugn_cliente_asignar_falle.cod_age~")    JOIN (LEFT=~"ugn_cliente_asignar_falle.cod_sup~"    OP =~"=~"RIGHT=~"supervisor.cod_sup~" )    JOIN (LEFT=~"supervisor.cod_jefe~"    OP =~"=~"RIGHT=~"jefe_ventas.jefe_ventas~" )WHERE(    EXP1 =~"~~~"UGN_CLIENTE_ASIGNAR_FALLE~~~".~~~"FECHA_INGRESO~~~"~"   OP =~">=~"    EXP2 =~":fec_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"UGN_CLIENTE_ASIGNAR_FALLE~~~".~~~"FECHA_INGRESO~~~"~"   OP =~"<=~"    EXP2 =~":fec_fin~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"UGN_CLIENTE_ASIGNAR_FALLE~~~".~~~"PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"JEFE_VENTAS~~~".~~~"JEFE_VENTAS~~~"~"   OP =~"=~"    EXP2 =~":jefe_v~" ) ) ARG(NAME = ~"fec_ini~" TYPE = date)  ARG(NAME = ~"fec_fin~" TYPE = date)  ARG(NAME = ~"parque~" TYPE = number)  ARG(NAME = ~"jefe_v~" TYPE = string) " arguments=(("fec_ini", date),("fec_fin", date),("parque", number),("jefe_v", string))  sort="grupo A fecha_ingreso D cod_sup D " )
