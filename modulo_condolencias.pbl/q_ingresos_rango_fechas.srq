PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME="ugn_cliente" )  TABLE(NAME="ugn_cliente_asignar_falle" ) COLUMN(NAME="ugn_cliente_asignar_falle.fecha_ingreso") COLUMN(NAME="ugn_cliente.grupo") COLUMN(NAME="ugn_cliente.correlativo") COLUMN(NAME="ugn_cliente.nombre") COLUMN(NAME="ugn_cliente.a_paterno") COLUMN(NAME="ugn_cliente.a_materno") COLUMN(NAME="ugn_cliente.fono_p") COLUMN(NAME="ugn_cliente.celular") COLUMN(NAME="ugn_cliente_asignar_falle.parque") COLUMN(NAME="ugn_cliente.comuna") COLUMN(NAME="ugn_cliente.ciudad")    JOIN (LEFT="ugn_cliente.grupo"    OP ="="RIGHT="ugn_cliente_asignar_falle.grupo" )WHERE(    EXP1 ="~"UGN_CLIENTE_ASIGNAR_FALLE~".~"FECHA_INGRESO~""   OP =">="    EXP2 ="TO_DATE('01-09-2013 00:00:00','DD-MM-YYYY HH24:MI:SS')"    LOGIC ="And" ) WHERE(    EXP1 ="~"UGN_CLIENTE_ASIGNAR_FALLE~".~"FECHA_INGRESO~""   OP ="<="    EXP2 ="TO_DATE('30-09-2013 00:00:00','DD-MM-YYYY HH24:MI:SS')" ) ) 