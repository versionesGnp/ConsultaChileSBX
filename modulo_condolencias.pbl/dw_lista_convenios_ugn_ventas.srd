 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"oferta_v~" )  TABLE(NAME=~"tipo_venta~" )  TABLE(NAME=~"cliente~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"pago_oferta~" )  TABLE(NAME=~"convenio_retiro~" ) COLUMN(NAME=~"cadena.cod_parque~") COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"oferta_v.serie~") COLUMN(NAME=~"oferta_v.nro_oferta~") COLUMN(NAME=~"oferta_v.fecha~") COLUMN(NAME=~"oferta_v.rut~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cliente.fono_p~") COLUMN(NAME=~"cliente.celular~") COLUMN(NAME=~"cliente.email~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"oferta_v.tipo_venta~") COLUMN(NAME=~"tipo_venta.descripcion~") COLUMN(NAME=~"oferta_v.cod_age~") COLUMN(NAME=~"oferta_v.cod_sup~") COLUMN(NAME=~"oferta_v.cod_jef~") COLUMN(NAME=~"oferta_v.forma_pago~") COLUMN(NAME=~"oferta_v.uso~") COLUMN(NAME=~"oferta_v.tipo_cons~") COLUMN(NAME=~"oferta_v.tipo_sepult~") COLUMN(NAME=~"pago_oferta.nro_cuotas~") COLUMN(NAME=~"pago_oferta.moneda~") COLUMN(NAME=~"oferta_v.cod_convenio~") COLUMN(NAME=~"convenio_retiro.glosa~")    JOIN (LEFT=~"oferta_v.tipo_venta~"    OP =~"=~"RIGHT=~"tipo_venta.tip_venta~" )    JOIN (LEFT=~"oferta_v.rut~"    OP =~"=~"RIGHT=~"cliente.rut~" )    JOIN (LEFT=~"oferta_v.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"oferta_v.nro_oferta~"    OP =~"=~"RIGHT=~"cadena.numero~" )    JOIN (LEFT=~"oferta_v.serie~"    OP =~"=~"RIGHT=~"pago_oferta.serie~" )    JOIN (LEFT=~"oferta_v.nro_oferta~"    OP =~"=~"RIGHT=~"pago_oferta.nro_oferta~" )    JOIN (LEFT=~"oferta_v.ult_folio~"    OP =~"=~"RIGHT=~"pago_oferta.folio~" )    JOIN (LEFT=~"oferta_v.cod_convenio~"    OP =~"=~"RIGHT=~"convenio_retiro.cod_convenio~" )WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'O'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"OFERTA_V~~~".~~~"FECHA~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"OFERTA_V~~~".~~~"FECHA~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"OFERTA_V~~~".~~~"COD_CONVENIO~~~"~"   OP =~"=~"    EXP2 =~":convenio~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = datetime)  ARG(NAME = ~"fecha_fin~" TYPE = datetime)  ARG(NAME = ~"convenio~" TYPE = number) " arguments=(("fecha_ini", datetime),("fecha_fin", datetime),("convenio", number)) )
