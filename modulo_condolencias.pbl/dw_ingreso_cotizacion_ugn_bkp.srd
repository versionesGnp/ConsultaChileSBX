compute(band=detail alignment="0" expression="'En el caso  de derechos de sepultación prometidos adquirir bajo la condición de Necesidad Futura, ~"EL CLIENTE~"  se obliga a no utilizar tales derechos en el plazo de 180 dias corridos, contados desde la fecha en que efectivamente se haya efectuado el pago del PIE o primera cuota segun corresponda, estipulado en una clausula del contrato vigente. Si el Cliente nacesitara hacer uso de la sepultura antes del término del plazo referido, el precio contado estipulado en el presente contrato se incrementará en el monto equivalente al valor señalado como ~"Derecho Especial Por Uso Anticipado~".'"border="0" color="0" x="0" y="1568" height="244" width="2377" format="[GENERAL]" html.valueishtml="0"  name=compute_20 visible="1~tif (uso='NF',1,0)"  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="81324524" background.transparency="0" background.gradient.color="8421504" background.gradient.transparency="0" background.gradient.angle="0" background.brushmode="0" background.gradient.repetition.mode="0" background.gradient.repetition.count="0" background.gradient.repetition.length="100" background.gradient.focus="0" background.gradient.scale="100" background.gradient.spread="100" tooltip.backcolor="134217752" tooltip.delay.initial="0" tooltip.delay.visible="32000" tooltip.enabled="0" tooltip.hasclosebutton="0" tooltip.icon="0" tooltip.isbubble="0" tooltip.maxwidth="0" tooltip.textcolor="134217751" tooltip.transparency="0" transparency="0" )
