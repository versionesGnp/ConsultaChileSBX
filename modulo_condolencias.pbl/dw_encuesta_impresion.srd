 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"encuesta~" )  TABLE(NAME=~"encuesta_box~" )  TABLE(NAME=~"vista_encuesta_lista~" ) COLUMN(NAME=~"encuesta.folio~") COLUMN(NAME=~"encuesta.rut~") COLUMN(NAME=~"encuesta.base~") COLUMN(NAME=~"encuesta.serie~") COLUMN(NAME=~"encuesta.numero~") COLUMN(NAME=~"encuesta.observacion~") COLUMN(NAME=~"encuesta.fecha_crea~") COLUMN(NAME=~"encuesta.usuario_crea~") COLUMN(NAME=~"encuesta.estado~") COLUMN(NAME=~"encuesta.cod_box~") COLUMN(NAME=~"encuesta.fecha_box~") COLUMN(NAME=~"encuesta_box.descripcion~") COLUMN(NAME=~"vista_encuesta_lista.fec_sep~") COLUMN(NAME=~"vista_encuesta_lista.cod_parque~") COLUMN(NAME=~"vista_encuesta_lista.rut_fall~") COLUMN(NAME=~"vista_encuesta_lista.nombre_falle~") COLUMN(NAME=~"vista_encuesta_lista.ap_pater_fall~") COLUMN(NAME=~"vista_encuesta_lista.ap_mater_fall~") COLUMN(NAME=~"vista_encuesta_lista.rut~") COLUMN(NAME=~"vista_encuesta_lista.nombre_cliente~") COLUMN(NAME=~"vista_encuesta_lista.a_pater_cliente~") COLUMN(NAME=~"vista_encuesta_lista.a_mater_cliente~") COLUMN(NAME=~"vista_encuesta_lista.fono_p~") COLUMN(NAME=~"vista_encuesta_lista.fono_c~") COLUMN(NAME=~"vista_encuesta_lista.celular~") COLUMN(NAME=~"vista_encuesta_lista.tipo_origen~") COLUMN(NAME=~"vista_encuesta_lista.sector_sep~") COLUMN(NAME=~"vista_encuesta_lista.sepultura~") COLUMN(NAME=~"vista_encuesta_lista.usuario_creador~")    JOIN (LEFT=~"encuesta.cod_box~"    OP =~"=~"RIGHT=~"encuesta_box.cod_box~" )    JOIN (LEFT=~"encuesta.folio~"    OP =~"=~"RIGHT=~"vista_encuesta_lista.folio_encuesta~" )WHERE(    EXP1 =~"~~~"ENCUESTA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'V'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"ENCUESTA~~~".~~~"FOLIO~~~"~"   OP =~"=~"    EXP2 =~":folio~" ) ) ARG(NAME = ~"folio~" TYPE = number) " arguments=(("folio", number)) )
