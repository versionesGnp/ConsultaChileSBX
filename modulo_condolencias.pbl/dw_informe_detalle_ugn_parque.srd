 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ugn_cliente~" )  TABLE(NAME=~"ugn_ejecutivo~" )  TABLE(NAME=~"ugn_ejecutivo_detalle~" ) COLUMN(NAME=~"ugn_cliente.rut~") COLUMN(NAME=~"ugn_cliente.dv~") COLUMN(NAME=~"ugn_cliente.nombre~") COLUMN(NAME=~"ugn_cliente.a_paterno~") COLUMN(NAME=~"ugn_cliente.a_materno~") COLUMN(NAME=~"ugn_cliente.fono_p~") COLUMN(NAME=~"ugn_cliente.fono_c~") COLUMN(NAME=~"ugn_cliente.celular~") COLUMN(NAME=~"ugn_cliente.email~") COLUMN(NAME=~"ugn_cliente.grupo~") COLUMN(NAME=~"ugn_cliente.correlativo~") COLUMN(NAME=~"ugn_cliente.ult_estado_gestion~") COLUMN(NAME=~"ugn_cliente.ult_fecha_gestion~") COLUMN(NAME=~"ugn_ejecutivo_detalle.fecha_gestion~") COLUMN(NAME=~"ugn_ejecutivo_detalle.estado_gestion~") COLUMN(NAME=~"ugn_ejecutivo_detalle.glosa_gestion~") COLUMN(NAME=~"ugn_ejecutivo_detalle.usuario~") COLUMN(NAME=~"ugn_ejecutivo_detalle.fecha_prox_llamado~") COLUMN(NAME=~"ugn_ejecutivo.estado_registro~") COLUMN(NAME=~"ugn_ejecutivo.cod_ejecutivo~")    JOIN (LEFT=~"ugn_ejecutivo.grupo~"    OP =~"=~"RIGHT=~"ugn_ejecutivo_detalle.grupo~" )    JOIN (LEFT=~"ugn_cliente.grupo~"    OP =~"=~"RIGHT=~"ugn_ejecutivo_detalle.grupo_cliente~" )    JOIN (LEFT=~"ugn_cliente.correlativo~"    OP =~"=~"RIGHT=~"ugn_ejecutivo_detalle.correlativo_cliente~" )WHERE(    EXP1 =~"~~~"UGN_CLIENTE~~~".~~~"ULT_FECHA_GESTION~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"UGN_CLIENTE~~~".~~~"ULT_FECHA_GESTION~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"UGN_EJECUTIVO~~~".~~~"PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = datetime)  ARG(NAME = ~"fecha_fin~" TYPE = datetime)  ARG(NAME = ~"parque~" TYPE = number) " arguments=(("fecha_ini", datetime),("fecha_fin", datetime),("parque", number))  sort="ugn_cliente_nombre A ugn_cliente_a_paterno A ugn_cliente_a_materno A ugn_cliente_grupo A ugn_cliente_correlativo A ugn_ejecutivo_detalle_fecha_gestion A " )
