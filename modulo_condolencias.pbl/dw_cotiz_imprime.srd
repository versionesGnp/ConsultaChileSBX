 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cotizaciones~" )  TABLE(NAME=~"agentes~" ) COLUMN(NAME=~"cotizaciones.cod_parque~") COLUMN(NAME=~"cotizaciones.ap_paterno_cotizante~") COLUMN(NAME=~"cotizaciones.ap_materno_cotizante~") COLUMN(NAME=~"cotizaciones.rut_cotizante~") COLUMN(NAME=~"cotizaciones.dv_cotizante~") COLUMN(NAME=~"cotizaciones.fono_cotizante~") COLUMN(NAME=~"cotizaciones.fecha~") COLUMN(NAME=~"cotizaciones.tipo_sepultura~") COLUMN(NAME=~"cotizaciones.sector~") COLUMN(NAME=~"cotizaciones.capacidad~") COLUMN(NAME=~"cotizaciones.uf_dia~") COLUMN(NAME=~"cotizaciones.valor_uso_ni~") COLUMN(NAME=~"cotizaciones.pie_minimo_ni~") COLUMN(NAME=~"cotizaciones.dscto_uso_anticipado~") COLUMN(NAME=~"cotizaciones.valor_uso_anticipado~") COLUMN(NAME=~"cotizaciones.pie_minimo_nf~") COLUMN(NAME=~"cotizaciones.plazo~") COLUMN(NAME=~"cotizaciones.valor_cuota~") COLUMN(NAME=~"cotizaciones.valor_mantencion_anual~") COLUMN(NAME=~"cotizaciones.cod_ejecutivo~") COLUMN(NAME=~"cotizaciones.fono_ejecutivo~") COLUMN(NAME=~"cotizaciones.celular_ejecutivo~") COLUMN(NAME=~"cotizaciones.correlativo_interno~") COLUMN(NAME=~"cotizaciones.moneda~") COLUMN(NAME=~"cotizaciones.mail~") COLUMN(NAME=~"cotizaciones.uso~") COLUMN(NAME=~"cotizaciones.numero_reducciones~") COLUMN(NAME=~"cotizaciones.cod_agente~") COLUMN(NAME=~"cotizaciones.canal~") COLUMN(NAME=~"agentes.nombre~") COLUMN(NAME=~"agentes.a_paterno~") COLUMN(NAME=~"agentes.a_materno~") COLUMN(NAME=~"cotizaciones.nombre_cotizante~") COLUMN(NAME=~"cotizaciones.observacion~")    JOIN (LEFT=~"cotizaciones.cod_agente~"    OP =~"=~"RIGHT=~"agentes.cod_age~" )WHERE(    EXP1 =~"~~~"COTIZACIONES~~~".~~~"CORRELATIVO_INTERNO~~~"~"   OP =~"=~"    EXP2 =~":correl~" ) ) ARG(NAME = ~"correl~" TYPE = number) " arguments=(("correl", number)) )
