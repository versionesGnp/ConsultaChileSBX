=~"~~~"VISTA_ENCUESTA_LISTA~~~".~~~"CORRELATIVO~~~"~"   OP =~"=~"    EXP2 =~":correl~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number)  ARG(NAME = ~"fecha_sep~" TYPE = datetime)  ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"correl~" TYPE = number) " arguments=(("base", string),("serie", string),("numero", number),("fecha_sep", datetime),("grupo", number),("correl", number)) )
