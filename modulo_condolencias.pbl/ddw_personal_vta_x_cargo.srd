table(column=(type=char(5) updatewhereclause=yes name=cod_age dbname="agentes.cod_age" dbalias=".cod_age" )
 column=(type=char(20) updatewhereclause=yes name=nombre dbname="agentes.nombre" dbalias=".nombre" )
 column=(type=char(50) updatewhereclause=yes name=a_paterno dbname="agentes.a_paterno" dbalias=".a_paterno" )
 column=(type=char(50) updatewhereclause=yes name=a_materno dbname="agentes.a_materno" dbalias=".a_materno" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"agentes~" )  TABLE(NAME=~"oferta_v~" ) COLUMN(NAME=~"agentes.cod_age~") COLUMN(NAME=~"agentes.nombre~") COLUMN(NAME=~"agentes.a_paterno~") COLUMN(NAME=~"agentes.a_materno~")    JOIN (LEFT=~"agentes.cod_age~"    OP =~"=~"RIGHT=~"oferta_v.cod_age~" )WHERE(    EXP1 =~"~~~"AGENTES~~~".~~~"CARGO~~~"~"   OP =~"=~"    EXP2 =~":cargo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"OFERTA_V~~~".~~~"CIERRE_VENTA~~~"~"   OP =~">=~"    EXP2 =~":fec_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"OFERTA_V~~~".~~~"CIERRE_VENTA~~~"~"   OP =~"<=~"    EXP2 =~":fec_fin~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"AGENTES~~~".~~~"COD_SUP~~~"~"   OP =~"=~"    EXP2 =~":codigo~" ) )    UNION (PBSELECT( VERSION(400) TABLE(NAME=~"supervisor~" )  TABLE(NAME=~"oferta_v~" ) COLUMN(NAME=~"supervisor.cod_sup~") COLUMN(NAME=~"supervisor.nombre~") COLUMN(NAME=~"supervisor.a_paterno~") COLUMN(NAME=~"supervisor.a_materno~")    JOIN (LEFT=~"supervisor.cod_sup~"    OP =~"=~"RIGHT=~"oferta_v.cod_sup~" )WHERE(    EXP1 =~"~~~"SUPERVISOR~~~".~~~"CARGO~~~"~"   OP =~"=~"    EXP2 =~":cargo~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"OFERTA_V~~~".~~~"CIERRE_VENTA~~~"~"   OP =~">=~"    EXP2 =~":fec_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"OFERTA_V~~~".~~~"CIERRE_VENTA~~~"~"   OP =~"<=~"    EXP2 =~":fec_fin~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"SUPERVISOR~~~".~~~"COD_JEFE~~~"~"   OP =~"=~"    EXP2 =~":codigo~" ) ))    UNION (PBSELECT( VERSION(400) TABLE(NAME=~"jefe_ventas~" )  TABLE(NAME=~"oferta_v~" ) COLUMN(NAME=~"jefe_ventas.jefe_ventas~") COLUMN(NAME=~"jefe_ventas.nombre~") COLUMN(NAME=~"jefe_ventas.a_paterno~") COLUMN(NAME=~"jefe_ventas.a_materno~")    JOIN (LEFT=~"jefe_ventas.jefe_ventas~"    OP =~"=~"RIGHT=~"oferta_v.cod_jef~" )WHERE(    EXP1 =~"~~~"JEFE_VENTAS~~~".~~~"CARGO~~~"~"   OP =~"=~"    EXP2 =~":cargo~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"OFERTA_V~~~".~~~"CIERRE_VENTA~~~"~"   OP =~">=~"    EXP2 =~":fec_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"OFERTA_V~~~".~~~"CIERRE_VENTA~~~"~"   OP =~"<=~"    EXP2 =~":fec_fin~" ) )) ARG(NAME = ~"cargo~" TYPE = string)  ARG(NAME = ~"fec_ini~" TYPE = datetime)  ARG(NAME = ~"fec_fin~" TYPE = datetime)  ARG(NAME = ~"codigo~" TYPE = string) " arguments=(("cargo", string),("fec_ini", datetime),("fec_fin", datetime),("codigo", string)) )
