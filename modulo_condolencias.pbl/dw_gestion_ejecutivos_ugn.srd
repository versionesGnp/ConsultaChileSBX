 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ugn_ejecutivo_detalle~" )  TABLE(NAME=~"ugn_cliente~" )  TABLE(NAME=~"ugn_cliente_asignar_falle~" ) COLUMN(NAME=~"ugn_ejecutivo_detalle.fecha_sistema~") COLUMN(NAME=~"ugn_ejecutivo_detalle.estado_gestion~") COLUMN(NAME=~"ugn_ejecutivo_detalle.grupo_cliente~") COLUMN(NAME=~"ugn_ejecutivo_detalle.correlativo_cliente~") COLUMN(NAME=~"ugn_cliente_asignar_falle.parque~") COLUMN(NAME=~"ugn_ejecutivo_detalle.glosa_gestion~") COLUMN(NAME=~"ugn_ejecutivo_detalle.usuario~")    JOIN (LEFT=~"ugn_ejecutivo_detalle.grupo_cliente~"    OP =~"=~"RIGHT=~"ugn_cliente.grupo~" )    JOIN (LEFT=~"ugn_ejecutivo_detalle.correlativo_cliente~"    OP =~"=~"RIGHT=~"ugn_cliente.correlativo~" )    JOIN (LEFT=~"ugn_cliente.grupo~"    OP =~"=~"RIGHT=~"ugn_cliente_asignar_falle.grupo~" )WHERE(    EXP1 =~"~~~"UGN_EJECUTIVO_DETALLE~~~".~~~"USUARIO~~~"~"   OP =~"=~"    EXP2 =~":cod_ejecutivo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"UGN_EJECUTIVO_DETALLE~~~".~~~"FECHA_GESTION~~~"~"   OP =~">=~"    EXP2 =~":fecha_inicial~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"UGN_EJECUTIVO_DETALLE~~~".~~~"FECHA_GESTION~~~"~"   OP =~"<=~"    EXP2 =~":fecha_final~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"UGN_EJECUTIVO_DETALLE~~~".~~~"ESTADO_GESTION~~~"~"   OP =~"<>~"    EXP2 =~"'0'~" ) )    UNION (PBSELECT( VERSION(400) TABLE(NAME=~"ugn_cliente~" )  TABLE(NAME=~"ugn_cliente_asignar_falle~" )  TABLE(NAME=~"ugn_gestion_sup~" ) COLUMN(NAME=~"ugn_gestion_sup.fecha_sistema~") COLUMN(NAME=~"ugn_gestion_sup.estado_gestion~") COLUMN(NAME=~"ugn_gestion_sup.grupo~") COLUMN(NAME=~"ugn_gestion_sup.correlativo~") COLUMN(NAME=~"ugn_cliente_asignar_falle.parque~") COLUMN(NAME=~"ugn_gestion_sup.glosa_gestion~") COLUMN(NAME=~"ugn_gestion_sup.usuario_gestor~")    JOIN (LEFT=~"ugn_cliente.grupo~"    OP =~"=~"RIGHT=~"ugn_gestion_sup.grupo~" )    JOIN (LEFT=~"ugn_cliente.correlativo~"    OP =~"=~"RIGHT=~"ugn_gestion_sup.correlativo~" )    JOIN (LEFT=~"ugn_cliente_asignar_falle.grupo~"    OP =~"=~"RIGHT=~"ugn_cliente.grupo~" )WHERE(    EXP1 =~"~~~"UGN_GESTION_SUP~~~".~~~"USUARIO_GESTOR~~~"~"   OP =~"=~"    EXP2 =~":cod_ejecutivo~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"UGN_GESTION_SUP~~~".~~~"FECHA_GESTION~~~"~"   OP =~">=~"    EXP2 =~":fecha_inicial~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"UGN_GESTION_SUP~~~".~~~"FECHA_GESTION~~~"~"   OP =~"<=~"    EXP2 =~":fecha_final~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"UGN_GESTION_SUP~~~".~~~"ESTADO_GESTION~~~"~"   OP =~"<>~"    EXP2 =~"'0'~" ) )) ARG(NAME = ~"cod_ejecutivo~" TYPE = string)  ARG(NAME = ~"fecha_inicial~" TYPE = date)  ARG(NAME = ~"fecha_final~" TYPE = date) " arguments=(("cod_ejecutivo", string),("fecha_inicial", date),("fecha_final", date))  sort="ugn_ejecutivo_detalle_fecha_sistema A ugn_ejecutivo_detalle_estado_gestion A " )
