 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"ugn_cliente~" )  TABLE(NAME=~"ugn_cliente_asignar_falle~" )  TABLE(NAME=~"ugn_gestion_sup~" ) COLUMN(NAME=~"ugn_cliente.grupo~") COLUMN(NAME=~"ugn_cliente.correlativo~") COLUMN(NAME=~"ugn_cliente.rut~") COLUMN(NAME=~"ugn_cliente.dv~") COLUMN(NAME=~"ugn_cliente.nombre~") COLUMN(NAME=~"ugn_cliente.a_paterno~") COLUMN(NAME=~"ugn_cliente.a_materno~") COLUMN(NAME=~"ugn_cliente.estado_registro~") COLUMN(NAME=~"ugn_cliente.ult_estado_gestion~") COLUMN(NAME=~"ugn_cliente.ult_fecha_gestion~") COLUMN(NAME=~"ugn_cliente.ult_glosa_gestion~") COLUMN(NAME=~"ugn_gestion_sup.estado_gestion~") COLUMN(NAME=~"ugn_gestion_sup.fecha_gestion~") COLUMN(NAME=~"ugn_gestion_sup.fecha_prox_llamado~") COLUMN(NAME=~"ugn_gestion_sup.usuario_gestor~") COLUMN(NAME=~"ugn_cliente_asignar_falle.parque~") COLUMN(NAME=~"ugn_cliente_asignar_falle.fecha_sepultacion~") COLUMN(NAME=~"ugn_cliente_asignar_falle.nombre_fallecido~") COLUMN(NAME=~"ugn_cliente_asignar_falle.a_paterno_fallecido~") COLUMN(NAME=~"ugn_cliente_asignar_falle.a_materno_fallecido~") COLUMN(NAME=~"ugn_cliente_asignar_falle.cod_age~") COLUMN(NAME=~"ugn_cliente_asignar_falle.cod_sup~") COLUMN(NAME=~"ugn_cliente_asignar_falle.observacion~") COLUMN(NAME=~"ugn_cliente.fono_p~") COLUMN(NAME=~"ugn_cliente.celular~")    JOIN (LEFT=~"ugn_cliente_asignar_falle.grupo~"    OP =~"=~"RIGHT=~"ugn_gestion_sup.grupo~" )    JOIN (LEFT=~"ugn_cliente.grupo~"    OP =~"=~"RIGHT=~"ugn_gestion_sup.grupo~" )    JOIN (LEFT=~"ugn_cliente.correlativo~"    OP =~"=~"RIGHT=~"ugn_gestion_sup.correlativo~" )WHERE(    EXP1 =~"~~~"UGN_CLIENTE~~~".~~~"GRUPO~~~"~"   OP =~"=~"    EXP2 =~":grupo~" ) ) ARG(NAME = ~"grupo~" TYPE = number) " arguments=(("grupo", number))  sort="grupo A correlativo A " )
