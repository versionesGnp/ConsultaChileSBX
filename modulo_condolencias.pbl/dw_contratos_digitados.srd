 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"cadena~" )  TABLE(NAME=~"oferta_v~" )  TABLE(NAME=~"ugn_cliente~" )  TABLE(NAME=~"cliente~" ) COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"cadena.serie~") COLUMN(NAME=~"cadena.numero~") COLUMN(NAME=~"cliente.rut~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"oferta_v.cod_age~") COLUMN(NAME=~"oferta_v.cod_sup~") COLUMN(NAME=~"oferta_v.fecha~") COLUMN(NAME=~"cadena.cod_parque~") COLUMN(NAME=~"oferta_v.tipo_venta~")    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"oferta_v.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"oferta_v.nro_oferta~" )    JOIN (LEFT=~"ugn_cliente.rut~"    OP =~"=~"RIGHT=~"cliente.rut~" )    JOIN (LEFT=~"cliente.rut~"    OP =~"=~"RIGHT=~"cadena.rut~" )WHERE(    EXP1 =~"(~~~"UGN_CLIENTE~~~".~~~"RUT~~~"~"   OP =~"=~"    EXP2 =~"~~~"CADENA~~~".~~~"RUT~~~"~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"(~~~"UGN_CLIENTE~~~".~~~"NOMBRE~~~"~"   OP =~"=~"    EXP2 =~"~~~"CLIENTE~~~".~~~"NOMBRE~~~"~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"UGN_CLIENTE~~~".~~~"A_PATERNO~~~"~"   OP =~"=~"    EXP2 =~"~~~"CLIENTE~~~".~~~"A_PATERNO~~~")~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"(~~~"UGN_CLIENTE~~~".~~~"FONO_P~~~"~"   OP =~"=~"    EXP2 =~"~~~"CLIENTE~~~".~~~"FONO_P~~~"~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"UGN_CLIENTE~~~".~~~"FONO_P~~~"~"   OP =~"=~"    EXP2 =~"~~~"CLIENTE~~~".~~~"FONO_C~~~"~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"UGN_CLIENTE~~~".~~~"FONO_P~~~"~"   OP =~"=~"    EXP2 =~"~~~"CLIENTE~~~".~~~"CELULAR~~~"~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"UGN_CLIENTE~~~".~~~"CELULAR~~~"~"   OP =~"=~"    EXP2 =~"~~~"CLIENTE~~~".~~~"FONO_P~~~"~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"UGN_CLIENTE~~~".~~~"CELULAR~~~"~"   OP =~"=~"    EXP2 =~"~~~"CLIENTE~~~".~~~"FONO_C~~~"~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"UGN_CLIENTE~~~".~~~"CELULAR~~~"~"   OP =~"=~"    EXP2 =~"~~~"CLIENTE~~~".~~~"CELULAR~~~")~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"(~~~"UGN_CLIENTE~~~".~~~"TIPO_VIA~~~"~"   OP =~"=~"    EXP2 =~"~~~"CLIENTE~~~".~~~"TIPO_VIA~~~"~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"UGN_CLIENTE~~~".~~~"DIRECCION_P~~~"~"   OP =~"=~"    EXP2 =~"~~~"CLIENTE~~~".~~~"DIRECCION_P~~~"~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"UGN_CLIENTE~~~".~~~"NUMERO_PARTICULAR~~~"~"   OP =~"=~"    EXP2 =~"~~~"CLIENTE~~~".~~~"NUMERO_PARTICULAR~~~"))~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"OFERTA_V~~~".~~~"FECHA~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"OFERTA_V~~~".~~~"FECHA~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"CADENA~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque)~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = datetime)  ARG(NAME = ~"fecha_fin~" TYPE = datetime)  ARG(NAME = ~"parque~" TYPE = number) " arguments=(("fecha_ini", datetime),("fecha_fin", datetime),("parque", number))  sort="oferta_v_fecha D " )
