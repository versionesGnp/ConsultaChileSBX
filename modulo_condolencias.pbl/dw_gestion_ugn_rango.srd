 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ugn_cliente~" )  TABLE(NAME=~"ugn_cliente_asignar_falle~" )  TABLE(NAME=~"ugn_gestion_sup~" ) COLUMN(NAME=~"ugn_gestion_sup.usuario_gestor~") COLUMN(NAME=~"ugn_gestion_sup.fecha_sistema~") COLUMN(NAME=~"ugn_gestion_sup.estado_gestion~") COLUMN(NAME=~"ugn_gestion_sup.fecha_gestion~") COLUMN(NAME=~"ugn_cliente.fono_p~") COLUMN(NAME=~"ugn_cliente.celular~") COLUMN(NAME=~"ugn_cliente.nombre~") COLUMN(NAME=~"ugn_cliente.a_paterno~") COLUMN(NAME=~"ugn_cliente.a_materno~") COLUMN(NAME=~"ugn_gestion_sup.glosa_gestion~") COLUMN(NAME=~"ugn_cliente_asignar_falle.usuario_creador~")    JOIN (LEFT=~"ugn_cliente.grupo~"    OP =~"=~"RIGHT=~"ugn_cliente_asignar_falle.grupo~" )    JOIN (LEFT=~"ugn_cliente.grupo~"    OP =~"=~"RIGHT=~"ugn_gestion_sup.grupo~" )    JOIN (LEFT=~"ugn_cliente.correlativo~"    OP =~"=~"RIGHT=~"ugn_gestion_sup.correlativo~" )WHERE(    EXP1 =~"~~~"UGN_GESTION_SUP~~~".~~~"FECHA_GESTION~~~"~"   OP =~">=~"    EXP2 =~":fec_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"UGN_GESTION_SUP~~~".~~~"FECHA_GESTION~~~"~"   OP =~"<=~"    EXP2 =~":fec_fin~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"UGN_GESTION_SUP~~~".~~~"ESTADO_GESTION~~~"~"   OP =~"<>~"    EXP2 =~"'0'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"UGN_GESTION_SUP~~~".~~~"USUARIO_GESTOR~~~"~"   OP =~"=~"    EXP2 =~":usuario~" ) ) ARG(NAME = ~"fec_ini~" TYPE = date)  ARG(NAME = ~"fec_fin~" TYPE = date)  ARG(NAME = ~"usuario~" TYPE = string) " arguments=(("fec_ini", date),("fec_fin", date),("usuario", string))  sort="ugn_gestion_sup_fecha_sistema A " )
