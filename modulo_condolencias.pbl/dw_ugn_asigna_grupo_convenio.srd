 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ficha_sepultacion~" ) COLUMN(NAME=~"ficha_sepultacion.nombre_fallecido~") COLUMN(NAME=~"ficha_sepultacion.ap_paterno_fall~") COLUMN(NAME=~"ficha_sepultacion.ap_materno_fall~") COLUMN(NAME=~"ficha_sepultacion.rut_fallecido~") COLUMN(NAME=~"ficha_sepultacion.fecha_sepultacion~") COLUMN(NAME=~"ficha_sepultacion.cod_parque~") COLUMN(NAME=~"ficha_sepultacion.dv_fallecido~") COLUMN(NAME=~"ficha_sepultacion.sector~") COLUMN(NAME=~"ficha_sepultacion.sepultura~") COMPUTE(NAME=~"'FS'~") COLUMN(NAME=~"ficha_sepultacion.base~") COLUMN(NAME=~"ficha_sepultacion.serie~") COLUMN(NAME=~"ficha_sepultacion.numero~")WHERE(    EXP1 =~"~~~"FICHA_SEPULTACION~~~".~~~"FECHA_SEPULTACION~~~"~"   OP =~">=~"    EXP2 =~":fech_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FICHA_SEPULTACION~~~".~~~"FECHA_SEPULTACION~~~"~"   OP =~"<=~"    EXP2 =~":fech_fin~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FICHA_SEPULTACION~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~" ) )    UNION (PBSELECT( VERSION(400) TABLE(NAME=~"ficha_traslado~" ) COLUMN(NAME=~"ficha_traslado.nombre_fallecido~") COLUMN(NAME=~"ficha_traslado.apellido_paterno_fall~") COLUMN(NAME=~"ficha_traslado.apellido_materno_fall~") COLUMN(NAME=~"ficha_traslado.rut_fallecido~") COLUMN(NAME=~"ficha_traslado.fecha_traslado~") COLUMN(NAME=~"ficha_traslado.cod_parque~") COLUMN(NAME=~"ficha_traslado.dv_fallecido~") COLUMN(NAME=~"ficha_traslado.sector_origen~") COLUMN(NAME=~"ficha_traslado.sepultura_origen~") COMPUTE(NAME=~"'FT'~") COLUMN(NAME=~"ficha_traslado.base_destino~") COLUMN(NAME=~"ficha_traslado.serie_destino~") COLUMN(NAME=~"ficha_traslado.numero_destino~")WHERE(    EXP1 =~"~~~"FICHA_TRASLADO~~~".~~~"FECHA_TRASLADO~~~"~"   OP =~">=~"    EXP2 =~":fech_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FICHA_TRASLADO~~~".~~~"FECHA_TRASLADO~~~"~"   OP =~"<=~"    EXP2 =~":fech_fin~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FICHA_TRASLADO~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FICHA_TRASLADO~~~".~~~"TIPO_TRASLADO~~~"~"   OP =~"=~"    EXP2 =~"'E'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FICHA_TRASLADO~~~".~~~"DESTINO_PARQUE~~~"~"   OP =~"=~"    EXP2 =~"'E'~" ) )) ARG(NAME = ~"fech_ini~" TYPE = datetime)  ARG(NAME = ~"fech_fin~" TYPE = datetime)  ARG(NAME = ~"parque~" TYPE = number) " arguments=(("fech_ini", datetime),("fech_fin", datetime),("parque", number))  sort="fecha_sepultacion A ap_paterno_fall A ap_materno_fall A nombre_fallecido A " )
