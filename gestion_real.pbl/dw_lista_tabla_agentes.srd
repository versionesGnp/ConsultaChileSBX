 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"agentes~" )  TABLE(NAME=~"supervisor~" )  TABLE(NAME=~"jefe_ventas~" ) COLUMN(NAME=~"agentes.cod_age~") COLUMN(NAME=~"agentes.nombre~") COLUMN(NAME=~"agentes.a_paterno~") COLUMN(NAME=~"agentes.a_materno~") COLUMN(NAME=~"agentes.nro_de_cont~") COLUMN(NAME=~"agentes.fecha_ini~") COLUMN(NAME=~"agentes.fecha_fin~") COLUMN(NAME=~"agentes.estado~") COLUMN(NAME=~"agentes.cod_sup~") COLUMN(NAME=~"agentes.rut~") COLUMN(NAME=~"agentes.tipo_cont~") COLUMN(NAME=~"agentes.meta~") COLUMN(NAME=~"agentes.clasificacion~") COLUMN(NAME=~"agentes.vsp~")    JOIN (LEFT=~"agentes.cod_sup~"    OP =~"=~"RIGHT=~"supervisor.cod_sup~" )    JOIN (LEFT=~"supervisor.cod_jefe~"    OP =~"=~"RIGHT=~"jefe_ventas.jefe_ventas~" )WHERE(    EXP1 =~"~~~"AGENTES~~~".~~~"COD_SUP~~~"~"   OP =~"=~"    EXP2 =~":superv~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"AGENTES~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'A'~" ) ) ARG(NAME = ~"superv~" TYPE = string) " arguments=(("superv", string)) )
