 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"oferta_v~" )  TABLE(NAME=~"pago_oferta~" )  TABLE(NAME=~"agentes~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"jefe_ventas~" )  TABLE(NAME=~"supervisor~" ) COLUMN(NAME=~"oferta_v.serie~") COLUMN(NAME=~"oferta_v.nro_oferta~") COLUMN(NAME=~"oferta_v.fecha~") COLUMN(NAME=~"oferta_v.cod_age~") COLUMN(NAME=~"oferta_v.cod_sup~") COLUMN(NAME=~"oferta_v.tot_pagado~") COLUMN(NAME=~"pago_oferta.moneda~") COLUMN(NAME=~"pago_oferta.precio~") COLUMN(NAME=~"pago_oferta.uf_dia~") COLUMN(NAME=~"agentes.cod_sup~") COLUMN(NAME=~"agentes.cod_age~") COLUMN(NAME=~"oferta_v.u_folio~") COLUMN(NAME=~"oferta_v.u_fecha~") COLUMN(NAME=~"agentes.fecha_ini~") COLUMN(NAME=~"oferta_v.fecha_ingreso~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"oferta_v.estado_comi~") COLUMN(NAME=~"pago_oferta.fecha_prim~") COLUMN(NAME=~"pago_oferta.nro_cuotas~") COLUMN(NAME=~"oferta_v.cta_pag_s~") COLUMN(NAME=~"pago_oferta.pie~") COLUMN(NAME=~"oferta_v.fecha_com~") COLUMN(NAME=~"pago_oferta.valor_cuota~") COLUMN(NAME=~"oferta_v.porce_venta~") COLUMN(NAME=~"jefe_ventas.jefe_ventas~") COLUMN(NAME=~"jefe_ventas.nombre~") COLUMN(NAME=~"jefe_ventas.a_paterno~") COLUMN(NAME=~"jefe_ventas.a_materno~") COLUMN(NAME=~"supervisor.nombre~") COLUMN(NAME=~"supervisor.a_paterno~") COLUMN(NAME=~"supervisor.a_materno~") COLUMN(NAME=~"agentes.nombre~") COLUMN(NAME=~"agentes.a_paterno~") COLUMN(NAME=~"agentes.a_materno~") COLUMN(NAME=~"agentes.estado~") COLUMN(NAME=~"agentes.clasificacion~")    JOIN (LEFT=~"oferta_v.serie~"    OP =~"=~"RIGHT=~"pago_oferta.serie~" )    JOIN (LEFT=~"oferta_v.nro_oferta~"    OP =~"=~"RIGHT=~"pago_oferta.nro_oferta~" )    JOIN (LEFT=~"oferta_v.ult_folio~"    OP =~"=~"RIGHT=~"pago_oferta.folio~" )    JOIN (LEFT=~"oferta_v.cod_age~"    OP =~"=~"RIGHT=~"agentes.cod_age~" )    JOIN (LEFT=~"oferta_v.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"oferta_v.nro_oferta~"    OP =~"=~"RIGHT=~"cadena.numero~" )    JOIN (LEFT=~"agentes.cod_sup~"    OP =~"=~"RIGHT=~"supervisor.cod_sup~" )    JOIN (LEFT=~"supervisor.cod_jefe~"    OP =~"=~"RIGHT=~"jefe_ventas.jefe_ventas~" )    JOIN (LEFT=~"oferta_v.cod_jef~"    OP =~"=~"RIGHT=~"jefe_ventas.jefe_ventas~" )    JOIN (LEFT=~"oferta_v.cod_sup~"    OP =~"=~"RIGHT=~"supervisor.cod_sup~" )WHERE(    EXP1 =~"((~~~"OFERTA_V~~~".~~~"U_FECHA~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"OFERTA_V~~~".~~~"U_FECHA~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin ))~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'O'  )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"OFERTA_V~~~".~~~"COD_AGE~~~"~"   OP =~"=~"    EXP2 =~":cod)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"CADENA~~~".~~~"ESTADO~~~"~"   OP =~"like~"    EXP2 =~":estado)~" ) ) ORDER(NAME=~"oferta_v.u_fecha~" ASC=yes ) ARG(NAME = ~"fecha_ini~" TYPE = datetime)  ARG(NAME = ~"fecha_fin~" TYPE = datetime)  ARG(NAME = ~"cod~" TYPE = string)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"estado~" TYPE = string) " arguments=(("fecha_ini", datetime),("fecha_fin", datetime),("cod", string),("empresa", number),("estado", string))  sort="oferta_v_cod_sup A oferta_v_cod_age A " )
