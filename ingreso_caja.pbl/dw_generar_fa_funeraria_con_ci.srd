 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"producto_ingreso~" )  TABLE(NAME=~"revision_contratos~" )  TABLE(NAME=~"producto_anexo~" ) COLUMN(NAME=~"producto_ingreso.base~") COLUMN(NAME=~"producto_ingreso.serie~") COLUMN(NAME=~"producto_ingreso.numero~") COLUMN(NAME=~"revision_contratos.sw_activa_servicio~") COLUMN(NAME=~"revision_contratos.folio_fa~") COLUMN(NAME=~"revision_contratos.rut~") COLUMN(NAME=~"revision_contratos.dv~") COLUMN(NAME=~"producto_ingreso.tipo_cob~") COLUMN(NAME=~"producto_ingreso.folio~") COLUMN(NAME=~"producto_ingreso.fecha_pago~") COLUMN(NAME=~"revision_contratos.fecha_ctto~") COLUMN(NAME=~"revision_contratos.plazo~") COLUMN(NAME=~"revision_contratos.forma_pago~") COLUMN(NAME=~"revision_contratos.precio~") COLUMN(NAME=~"revision_contratos.valor_cuota~") COLUMN(NAME=~"revision_contratos.fecha_activacion~") COLUMN(NAME=~"revision_contratos.moneda~") COMPUTE(NAME=~"1 as sw_factura~") COLUMN(NAME=~"producto_ingreso.monto~") COLUMN(NAME=~"revision_contratos.base~") COLUMN(NAME=~"revision_contratos.serie~") COLUMN(NAME=~"revision_contratos.numero~") COLUMN(NAME=~"producto_ingreso.caja~") COLUMN(NAME=~"revision_contratos.codigo_servicio~")    JOIN (LEFT=~"producto_ingreso.base~"    OP =~"=~"RIGHT=~"revision_contratos.base~"    OUTER2 =~"revision_contratos.base~" )    JOIN (LEFT=~"producto_ingreso.serie~"    OP =~"=~"RIGHT=~"revision_contratos.serie~"    OUTER2 =~"revision_contratos.serie~" )    JOIN (LEFT=~"producto_ingreso.numero~"    OP =~"=~"RIGHT=~"revision_contratos.numero~"    OUTER2 =~"revision_contratos.numero~" )    JOIN (LEFT=~"revision_contratos.base~"    OP =~"=~"RIGHT=~"producto_anexo.base~" )    JOIN (LEFT=~"revision_contratos.serie~"    OP =~"=~"RIGHT=~"producto_anexo.serie~" )    JOIN (LEFT=~"revision_contratos.numero~"    OP =~"=~"RIGHT=~"producto_anexo.numero~" )WHERE(    EXP1 =~"~~~"REVISION_CONTRATOS~~~".~~~"FECHA_CTTO~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"REVISION_CONTRATOS~~~".~~~"SW_ACTIVA_SERVICIO~~~"~"   OP =~"<>~"    EXP2 =~"1~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"PRODUCTO_INGRESO~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~"'F'~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = date) " arguments=(("fecha_ini", date))  sort="revision_contratos_fecha_ctto A producto_ingreso_base A producto_ingreso_serie A producto_ingreso_numero A producto_ingreso_folio A " )
