 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"cod_movi~" )  TABLE(NAME=~"tab_uf~" )  TABLE(NAME=~"ingreso~" )  TABLE(NAME=~"cuenta_contable_otros~" ) COLUMN(NAME=~"cod_movi.des_ing~") COLUMN(NAME=~"tab_uf.valor_uf~") COLUMN(NAME=~"ingreso.tipo_cob~") COLUMN(NAME=~"ingreso.tipo_mov~") COLUMN(NAME=~"ingreso.monto~") COLUMN(NAME=~"ingreso.cuotas_pag~") COLUMN(NAME=~"ingreso.valor_uf~") COLUMN(NAME=~"ingreso.codigo_otro~") COLUMN(NAME=~"cuenta_contable_otros.descrip_contab_ctecte~")    JOIN (LEFT=~"ingreso.codigo_otro~"    OP =~"=~"RIGHT=~"cuenta_contable_otros.codigo_otros~"    OUTER1 =~"ingreso.codigo_otro~" )    JOIN (LEFT=~"ingreso.tipo_cob~"    OP =~"=~"RIGHT=~"cuenta_contable_otros.tipo_comprobante~"    OUTER1 =~"ingreso.tipo_cob~" )    JOIN (LEFT=~"ingreso.tipo_mov~"    OP =~"=~"RIGHT=~"cuenta_contable_otros.tipo_cob~"    OUTER1 =~"ingreso.tipo_mov~" )    JOIN (LEFT=~"ingreso.fecha_pago~"    OP =~"=~"RIGHT=~"tab_uf.fecha_uf~" )    JOIN (LEFT=~"ingreso.tipo_mov~"    OP =~"=~"RIGHT=~"cod_movi.cod_ing~" )WHERE(    EXP1 =~"(~~~"INGRESO~~~".~~~"TIPO_COB~~~"~"   OP =~"=~"    EXP2 =~"'CI'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"TIPO_COB~~~"~"   OP =~"=~"    EXP2 =~"'CU'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"TIPO_COB~~~"~"   OP =~"=~"    EXP2 =~"'C0')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"FOLIO~~~"~"   OP =~"=~"    EXP2 =~":an_folio~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"FECHA_PAGO~~~"~"   OP =~"=~"    EXP2 =~":fecha~" ) ) ARG(NAME = ~"an_folio~" TYPE = number)  ARG(NAME = ~"fecha~" TYPE = date) " arguments=(("an_folio", number),("fecha", date))  sort="ingreso_tipo_mov A " )
