 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cod_movi~" )  TABLE(NAME=~"facturas_documentos~" )  TABLE(NAME=~"facturas_ingreso~" )  TABLE(NAME=~"bancos~" ) COLUMN(NAME=~"facturas_ingreso.folio~") COLUMN(NAME=~"facturas_ingreso.tipo_cob~") COLUMN(NAME=~"facturas_ingreso.fecha_pago~") COLUMN(NAME=~"facturas_ingreso.tipo_mov~") COLUMN(NAME=~"facturas_ingreso.monto~") COLUMN(NAME=~"facturas_ingreso.cuotas_pag~") COLUMN(NAME=~"facturas_ingreso.base~") COLUMN(NAME=~"facturas_ingreso.serie~") COLUMN(NAME=~"facturas_ingreso.contrato~") COLUMN(NAME=~"facturas_ingreso.cod_caja~") COLUMN(NAME=~"facturas_ingreso.rut~") COLUMN(NAME=~"facturas_ingreso.codigo_otro~") COLUMN(NAME=~"cod_movi.sigla~") COLUMN(NAME=~"facturas_documentos.cod_pago~") COLUMN(NAME=~"facturas_documentos.n_cheque~") COLUMN(NAME=~"facturas_documentos.monto~") COLUMN(NAME=~"facturas_documentos.fecha_venc~") COLUMN(NAME=~"facturas_documentos.num_cheques~") COLUMN(NAME=~"facturas_documentos.estado_ch~") COLUMN(NAME=~"facturas_documentos.glosa_ch~") COLUMN(NAME=~"facturas_documentos.fecha_estado_ch~") COLUMN(NAME=~"facturas_documentos.cod_tarjeta_credito~") COLUMN(NAME=~"facturas_documentos.tipo_tarjeta_credito~") COLUMN(NAME=~"facturas_documentos.nro_cuotas_credito~") COLUMN(NAME=~"facturas_documentos.cod_autorizacion_debito~") COLUMN(NAME=~"facturas_documentos.cod_banco_debito~") COLUMN(NAME=~"facturas_documentos.tipo_pago_tarjeta_credito~") COLUMN(NAME=~"facturas_documentos.hora_pago~") COLUMN(NAME=~"facturas_documentos.minuto_pago~") COLUMN(NAME=~"bancos.descripcion~")    JOIN (LEFT=~"facturas_documentos.cod_banco~"    OP =~"=~"RIGHT=~"bancos.cod_banco~"    OUTER1 =~"facturas_documentos.cod_banco~" )   JOIN (LEFT=~"facturas_ingreso.folio~"    OP =~"=~"RIGHT=~"facturas_documentos.folio~" )    JOIN (LEFT=~"facturas_ingreso.tipo_cob~"    OP =~"=~"RIGHT=~"facturas_documentos.tipo_cob~" )    JOIN (LEFT=~"facturas_ingreso.fecha_pago~"    OP =~"=~"RIGHT=~"facturas_documentos.fecha_pago~" )    JOIN (LEFT=~"facturas_ingreso.tipo_mov~"    OP =~"=~"RIGHT=~"cod_movi.cod_ing~" ) WHERE(    EXP1 =~"~~~"FACTURAS_INGRESO~~~".~~~"FECHA_PAGO~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FACTURAS_INGRESO~~~".~~~"FECHA_PAGO~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FACTURAS_INGRESO~~~".~~~"COD_CAJA~~~"~"   OP =~"=~"    EXP2 =~":caja~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FACTURAS_INGRESO~~~".~~~"PAGO_HIST~~~"~"   OP =~"=~"    EXP2 =~"'A'~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = date)  ARG(NAME = ~"fecha_fin~" TYPE = date)  ARG(NAME = ~"caja~" TYPE = string) " arguments=(("fecha_ini", date),("fecha_fin", date),("caja", string))  sort="facturas_ingreso_fecha_pago A facturas_ingreso_base A facturas_ingreso_contrato A facturas_ingreso_tipo_cob A facturas_ingreso_folio A facturas_documentos_cod_pago D facturas_documentos_fecha_venc A " )
