 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"electronica_fb~" ) COLUMN(NAME=~"electronica_fb.grupo~") COLUMN(NAME=~"electronica_fb.autorizacion_sii~") COLUMN(NAME=~"electronica_fb.codigo_sii~") COLUMN(NAME=~"electronica_fb.estado~") COLUMN(NAME=~"electronica_fb.observacion~") COLUMN(NAME=~"electronica_fb.tipo_documento~") COLUMN(NAME=~"electronica_fb.fecha_inicio~") COLUMN(NAME=~"electronica_fb.fecha_termino~") COLUMN(NAME=~"electronica_fb.rango_inicio~") COLUMN(NAME=~"electronica_fb.rango_termino~") COLUMN(NAME=~"electronica_fb.usuario_crea~") COLUMN(NAME=~"electronica_fb.fecha_crea~") COLUMN(NAME=~"electronica_fb.rut_empresa~")WHERE(    EXP1 =~"~~~"ELECTRONICA_FB~~~".~~~"TIPO_DOCUMENTO~~~"~"   OP =~"=~"    EXP2 =~":tipo_doc~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"ELECTRONICA_FB~~~".~~~"RUT_EMPRESA~~~"~"   OP =~"=~"    EXP2 =~":rut~" ) ) ARG(NAME = ~"tipo_doc~" TYPE = string)  ARG(NAME = ~"rut~" TYPE = string) " update="ELECTRONICA_FB" updatewhere=0 updatekeyinplace=yes arguments=(("tipo_doc", string),("rut", string))  sort="grupo D tipo_documento A " )
