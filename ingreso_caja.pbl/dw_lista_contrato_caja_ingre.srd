 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ingreso~" ) COLUMN(NAME=~"ingreso.folio~") COLUMN(NAME=~"ingreso.base~") COLUMN(NAME=~"ingreso.serie~") COLUMN(NAME=~"ingreso.contrato~") COLUMN(NAME=~"ingreso.monto~") COLUMN(NAME=~"ingreso.cod_caja~") COLUMN(NAME=~"ingreso.tipo_cob~") COLUMN(NAME=~"ingreso.fecha_pago~") COLUMN(NAME=~"ingreso.tipo_mov~") COLUMN(NAME=~"ingreso.rut~") COLUMN(NAME=~"ingreso.usuario~")WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"FOLIO~~~"~"   OP =~"=~"    EXP2 =~":folio~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"TIPO_COB~~~"~"   OP =~"=~"    EXP2 =~":tipo_cob~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"COD_CAJA~~~"~"   OP =~"=~"    EXP2 =~":cod_caja~" ) ) ARG(NAME = ~"folio~" TYPE = number)  ARG(NAME = ~"tipo_cob~" TYPE = string)  ARG(NAME = ~"cod_caja~" TYPE = string) " update="INGRESO" updatewhere=0 updatekeyinplace=no arguments=(("folio", number),("tipo_cob", string),("cod_caja", string)) )
