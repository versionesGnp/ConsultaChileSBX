 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"cadena~" )  TABLE(NAME=~"cliente_rezago~" )  TABLE(NAME=~"oferta_v~" )  TABLE(NAME=~"pago_oferta~" )  TABLE(NAME=~"ingreso~" )  TABLE(NAME=~"tab_uf~" ) COLUMN(NAME=~"cliente_rezago.base~") COLUMN(NAME=~"cliente_rezago.serie~") COLUMN(NAME=~"cliente_rezago.numero~") COLUMN(NAME=~"cadena.rut~") COLUMN(NAME=~"ingreso.tipo_cob~") COLUMN(NAME=~"ingreso.folio~") COLUMN(NAME=~"ingreso.fecha_pago~") COLUMN(NAME=~"ingreso.tipo_mov~") COLUMN(NAME=~"ingreso.monto~") COLUMN(NAME=~"ingreso.cuotas_pag~") COLUMN(NAME=~"ingreso.codigo_otro~") COLUMN(NAME=~"pago_oferta.valor_cuota~") COLUMN(NAME=~"pago_oferta.pie~") COLUMN(NAME=~"oferta_v.valor_cuota_m~") COLUMN(NAME=~"pago_oferta.ctas_pactadas_pie~") COLUMN(NAME=~"pago_oferta.moneda~") COLUMN(NAME=~"tab_uf.valor_uf~") COLUMN(NAME=~"pago_oferta.precio~") COMPUTE(NAME=~"''~")    JOIN (LEFT=~"oferta_v.serie~"    OP =~"=~"RIGHT=~"pago_oferta.serie~" )    JOIN (LEFT=~"oferta_v.nro_oferta~"    OP =~"=~"RIGHT=~"pago_oferta.nro_oferta~" )    JOIN (LEFT=~"oferta_v.ult_folio~"    OP =~"=~"RIGHT=~"pago_oferta.folio~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"oferta_v.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"oferta_v.nro_oferta~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"cliente_rezago.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"cliente_rezago.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"cliente_rezago.numero~" )    JOIN (LEFT=~"cliente_rezago.rut~"    OP =~"=~"RIGHT=~"ingreso.rut~" )    JOIN (LEFT=~"ingreso.fecha_pago~"    OP =~"=~"RIGHT=~"tab_uf.fecha_uf~" )WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"REZAGO~~~"~"   OP =~"=~"    EXP2 =~"'S'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"PAGO_HIST~~~"~"   OP =~"=~"    EXP2 =~"'A'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"CADENA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'V'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'C')~" ) ) "  sort="ingreso_fecha_pago D ingreso_tipo_cob A ingreso_folio A " )
