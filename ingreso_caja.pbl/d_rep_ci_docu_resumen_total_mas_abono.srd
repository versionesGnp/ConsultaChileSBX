table(column=(type=decimal(4) updatewhereclause=yes name=documentos_n_cheque dbname="documentos.n_cheque" dbalias=".n_cheque" )
 column=(type=decimal(4) updatewhereclause=yes name=documentos_monto dbname="documentos.monto" dbalias=".monto" )
 column=(type=datetime updatewhereclause=yes name=documentos_fecha_venc dbname="documentos.fecha_venc" dbalias=".fecha_venc" )
 column=(type=decimal(0) updatewhereclause=yes name=documentos_cod_tarjeta_credito dbname="documentos.cod_tarjeta_credito" dbalias=".cod_tarjeta_credito" )
 column=(type=decimal(0) updatewhereclause=yes name=documentos_nro_cuotas_credito dbname="documentos.nro_cuotas_credito" dbalias=".nro_cuotas_credito" )
 column=(type=char(20) updatewhereclause=yes name=documentos_cod_autorizacion_credito dbname="documentos.cod_autorizacion_credito" dbalias=".cod_autorizacion_credito" )
 column=(type=decimal(0) updatewhereclause=yes name=documentos_tipo_tarjeta_credito dbname="documentos.tipo_tarjeta_credito" dbalias=".tipo_tarjeta_credito" )
 column=(type=decimal(4) updatewhereclause=yes name=cod_banco dbname="documentos.cod_banco" dbalias=".cod_banco" )
 column=(type=char(2) updatewhereclause=yes name=cod_pago dbname="documentos.cod_pago" dbalias=".cod_pago" )
 column=(type=char(100) updatewhereclause=yes name=forma_pago_descripcion dbname="forma_pago.descripcion" dbalias=".descripcion" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"documentos~" )  TABLE(NAME=~"forma_pago~" ) COLUMN(NAME=~"documentos.n_cheque~") COLUMN(NAME=~"documentos.monto~") COLUMN(NAME=~"documentos.fecha_venc~") COLUMN(NAME=~"documentos.cod_tarjeta_credito~") COLUMN(NAME=~"documentos.nro_cuotas_credito~") COLUMN(NAME=~"documentos.cod_autorizacion_credito~") COLUMN(NAME=~"documentos.tipo_tarjeta_credito~") COLUMN(NAME=~"documentos.cod_banco~") COLUMN(NAME=~"documentos.cod_pago~") COLUMN(NAME=~"forma_pago.descripcion~")    JOIN (LEFT=~"documentos.cod_pago~"    OP =~"=~"RIGHT=~"forma_pago.codigo~" )WHERE(    EXP1 =~"~~~"DOCUMENTOS~~~".~~~"FOLIO~~~"~"   OP =~"=~"    EXP2 =~":an_folio~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"DOCUMENTOS~~~".~~~"TIPO_COB~~~"~"   OP =~"=~"    EXP2 =~":tipo_cob~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"DOCUMENTOS~~~".~~~"FECHA_PAGO~~~"~"   OP =~"=~"    EXP2 =~":fecha~" ) ) ARG(NAME = ~"an_folio~" TYPE = number)  ARG(NAME = ~"tipo_cob~" TYPE = string)  ARG(NAME = ~"fecha~" TYPE = date) " arguments=(("an_folio", number),("tipo_cob", string),("fecha", date))  sort="cod_pago A " )
group(level=1 header.height=0 trailer.height=0 by=("cod_pago" ) header.color="536870912" header.transparency="0" header.gradient.color="8421504" header.gradient.transparency="0" header.gradient.angle="0" header.brushmode="0" header.gradient.repetition.mode="0" header.gradient.repetition.count="0" header.gradient.repetition.length="100" header.gradient.focus="0" header.gradient.scale="100" header.gradient.spread="100" trailer.color="536870912" trailer.transparency="0" trailer.gradient.color="8421504" trailer.gradient.transparency="0" trailer.gradient.angle="0" trailer.brushmode="0" trailer.gradient.repetition.mode="0" trailer.gradient.repetition.count="0" trailer.gradient.repetition.length="100" trailer.gradient.focus="0" trailer.gradient.scale="100" trailer.gradient.spread="100"  sort="count(cod_pago for group 1) A " )
