 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"electronica_fb~" )  TABLE(NAME=~"electronica_fb_detalle~" ) COLUMN(NAME=~"electronica_fb_detalle.cod_caja~") COLUMN(NAME=~"electronica_fb_detalle.tipo_documento~") COLUMN(NAME=~"electronica_fb_detalle.estado_reg~")    JOIN (LEFT=~"electronica_fb.grupo~"    OP =~"=~"RIGHT=~"electronica_fb_detalle.grupo~" )    JOIN (LEFT=~"electronica_fb.tipo_documento~"    OP =~"=~"RIGHT=~"electronica_fb_detalle.tipo_documento~" )    JOIN (LEFT=~"electronica_fb.rut_empresa~"    OP =~"=~"RIGHT=~"electronica_fb_detalle.rut_empresa~" )WHERE(    EXP1 =~"~~~"ELECTRONICA_FB~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'P'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"ELECTRONICA_FB_DETALLE~~~".~~~"COD_CAJA~~~"~"   OP =~"like~"    EXP2 =~":caja~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"ELECTRONICA_FB~~~".~~~"RUT_EMPRESA~~~"~"   OP =~"=~"    EXP2 =~":empresa~" ) ) ARG(NAME = ~"caja~" TYPE = string)  ARG(NAME = ~"empresa~" TYPE = string) " arguments=(("caja", string),("empresa", string))  sort="electronica_fb_detalle_cod_caja A " )
