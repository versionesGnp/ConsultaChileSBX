 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cod_movi~" )  TABLE(NAME=~"facturas_ingreso~" ) COLUMN(NAME=~"facturas_ingreso.folio~") COLUMN(NAME=~"facturas_ingreso.tipo_cob~") COLUMN(NAME=~"facturas_ingreso.fecha_pago~") COLUMN(NAME=~"facturas_ingreso.tipo_mov~") COLUMN(NAME=~"facturas_ingreso.monto~") COLUMN(NAME=~"facturas_ingreso.base~") COLUMN(NAME=~"cod_movi.sigla~") COLUMN(NAME=~"facturas_ingreso.cod_caja~") COLUMN(NAME=~"facturas_ingreso.serie~") COLUMN(NAME=~"facturas_ingreso.contrato~")    JOIN (LEFT=~"facturas_ingreso.tipo_mov~"    OP =~"=~"RIGHT=~"cod_movi.cod_ing~" )WHERE(    EXP1 =~"~~~"FACTURAS_INGRESO~~~".~~~"FECHA_PAGO~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FACTURAS_INGRESO~~~".~~~"FECHA_PAGO~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FACTURAS_INGRESO~~~".~~~"PAGO_HIST~~~"~"   OP =~"=~"    EXP2 =~"'A'~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = date)  ARG(NAME = ~"fecha_fin~" TYPE = date) " arguments=(("fecha_ini", date),("fecha_fin", date))  sort="facturas_ingreso_cod_caja A facturas_ingreso_base A facturas_ingreso_serie A facturas_ingreso_contrato A facturas_ingreso_tipo_cob A facturas_ingreso_folio A facturas_ingreso_fecha_pago A " )
