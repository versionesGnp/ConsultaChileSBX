global subroutine f_crear_folio_web_mp (double al_nro_cuota, double al_rut, string as_base, string as_serie, double al_numero, double al_nro_cupon, datetime aldt_fec_vcto, string as_estado_cupon, string as_tipo_mov, string as_tipo_cob_pago, double al_folio_pago, datetime aldt_fecha_pago, double al_monto_ctto, double al_monto_ctto_peso, double al_monto_int_mora, double al_monto_gasto_mora, double al_nro_cuponera, string as_dv, string as_base_asoc, string as_serie_asoc, double al_numero_asoc, string as_tipo_moneda, string as_user, string as_caja, double al_folio)
