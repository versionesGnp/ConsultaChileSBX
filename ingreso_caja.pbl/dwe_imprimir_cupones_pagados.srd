 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"cliente~" )  TABLE(NAME=~"cuponeras~" )  TABLE(NAME=~"cuponeras_detalle~" )  TABLE(NAME=~"cod_parq~" ) COLUMN(NAME=~"cuponeras_detalle.tipo_cob_pago~") COLUMN(NAME=~"cuponeras_detalle.folio_pago~") COLUMN(NAME=~"cliente.rut~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cuponeras.cod_parque~") COLUMN(NAME=~"cod_parq.nombre~")    JOIN (LEFT=~"cuponeras.base~"    OP =~"=~"RIGHT=~"cuponeras_detalle.base~" )    JOIN (LEFT=~"cuponeras.serie~"    OP =~"=~"RIGHT=~"cuponeras_detalle.serie~" )    JOIN (LEFT=~"cuponeras.numero~"    OP =~"=~"RIGHT=~"cuponeras_detalle.numero~" )    JOIN (LEFT=~"cuponeras.nro_cuponera~"    OP =~"=~"RIGHT=~"cuponeras_detalle.nro_cuponera~" )    JOIN (LEFT=~"cliente.rut~"    OP =~"=~"RIGHT=~"cuponeras_detalle.rut~" )    JOIN (LEFT=~"cuponeras.cod_parque~"    OP =~"=~"RIGHT=~"cod_parq.codigo~" )WHERE(    EXP1 =~"~~~"CUPONERAS_DETALLE~~~".~~~"BASE_ASOC~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CUPONERAS_DETALLE~~~".~~~"SERIE_ASOC~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CUPONERAS_DETALLE~~~".~~~"NUMERO_ASOC~~~"~"   OP =~"=~"    EXP2 =~":numero~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CUPONERAS_DETALLE~~~".~~~"FECHA_PAGO~~~"~"   OP =~"=~"    EXP2 =~":fecha_pago~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number)  ARG(NAME = ~"fecha_pago~" TYPE = datetime)  ARG(NAME = ~"pagar~" TYPE = number)  ARG(NAME = ~"paga_con~" TYPE = number)  ARG(NAME = ~"vuelto~" TYPE = number) " arguments=(("base", string),("serie", string),("numero", number),("fecha_pago", datetime),("pagar", number),("paga_con", number),("vuelto", number)) )
