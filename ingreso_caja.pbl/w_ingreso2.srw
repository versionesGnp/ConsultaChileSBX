ld_fec_fin	= date(em_fec_fin.text)
if trim(em_fec_fin.text)='00/00/0000' or isnull(em_fec_fin.text) then
	messagebox("Advertencia","Fecha Periodo Desde Inválida")
	em_fec_fin.setfocus()
else
	if dw_por_facturar.retrieve(ld_fec_fin) = 0 then messagebox("Advertencia","No Registra Dato")
end if
end event

