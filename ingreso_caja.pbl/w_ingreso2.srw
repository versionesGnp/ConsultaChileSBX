st_n_caja.text 														= gs_caja
SELECT 	Count("USUARIO_CAJA_AT"."USUARIO") 
INTO 		:ll_count_usu  
FROM 	"USUARIO_CAJA_AT" 
WHERE ( "USUARIO_CAJA_AT"."USUARIO" = :gs_user ) AND  ( "USUARIO_CAJA_AT"."ESTADO" = 'A' )   ;
if ll_count_usu > 0 then
	DECLARE x1 CURSOR FOR  
	SELECT 		"CODIGO_CAJAS"."COD_CAJA",		"CODIGO_CAJAS"."GLS_CAJA"  
	FROM 		"CODIGO_CAJAS"  
	WHERE 		"CODIGO_CAJAS"."TIPO_CAJA" = 'E' OR "CODIGO_CAJAS"."TIPO_CAJA" = 'D' OR "CODIGO_CAJAS"."TIPO_CAJA" = 'P'
	ORDER BY 	"CODIGO_CAJAS"."COD_CAJA" ASC  
	USING	sqlca;
	open x1;
	if sqlca.sqlcode=0 then
		do while sqlca.sqlcode=0
			fetch x1 into :ls_caja, :ls_glosa_caja;
			if not isnull(ls_caja) then
				ls_string												= ls_caja+'/'+ls_glosa_caja
				st_n_caja.additem(ls_string)
			end if
			Setnull(ls_caja)
		loop
		st_n_caja.additem(gs_caja)
	end if
	close x1;
	st_n_caja.enabled												= true
else
	st_n_caja.additem(gs_caja)
	st_n_caja.enabled												= false
end if
st_n_caja.text 														= gs_caja
