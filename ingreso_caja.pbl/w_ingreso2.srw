event clicked;IF not isnull(gs_base) and not isnull(gs_serie) and gs_base <> "" AND gs_serie <> "" AND gi_numero > 0 THEN
	CHOOSE CASE gs_base
		CASE "O","U","M" // Oferta/Columbario
			if isvalid(w_cuenta_corriente_oferta) then close(w_cuenta_corriente_oferta)
			Open(w_cuenta_corriente_oferta)
			tab_ingreso.tp_ci.cb_ci_borrar.triggerevent(clicked!)
			tab_ingreso.tp_be.cb_be_borrar.triggerevent(clicked!)
			tab_ingreso.tp_cupon.cb_limpiar_cupon.triggerevent(clicked!)
			tab_ingreso.tp_boletas.cb_bl_borrar.triggerevent(clicked!)
			w_cuenta_corriente_oferta.setfocus()
		CASE "L" // Anexo Liberador
			if isvalid(w_cuenta_corriente_liberador) then close(w_cuenta_corriente_liberador)
			Open(w_cuenta_corriente_liberador)
			tab_ingreso.tp_ci.cb_ci_borrar.triggerevent(clicked!)
			tab_ingreso.tp_be.cb_be_borrar.triggerevent(clicked!)
			tab_ingreso.tp_cupon.cb_limpiar_cupon.triggerevent(clicked!)
			tab_ingreso.tp_boletas.cb_bl_borrar.triggerevent(clicked!)
			w_cuenta_corriente_liberador.setfocus()
		CASE "P" // Pagaré
			if isvalid(w_cuenta_corriente_pagare) then close(w_cuenta_corriente_pagare)
			Open(w_cuenta_corriente_pagare)
			tab_ingreso.tp_ci.cb_ci_borrar.triggerevent(clicked!)
			tab_ingreso.tp_be.cb_be_borrar.triggerevent(clicked!)
			tab_ingreso.tp_cupon.cb_limpiar_cupon.triggerevent(clicked!)
			tab_ingreso.tp_boletas.cb_bl_borrar.triggerevent(clicked!)
			w_cuenta_corriente_pagare.setfocus()
		CASE "C" // Contrato ISA
			if isvalid(w_cuenta_corriente_contrato_isa) then close(w_cuenta_corriente_contrato_isa)
			Open(w_cuenta_corriente_contrato_isa)
			tab_ingreso.tp_ci.cb_ci_borrar.triggerevent(clicked!)
			tab_ingreso.tp_be.cb_be_borrar.triggerevent(clicked!)
			tab_ingreso.tp_cupon.cb_limpiar_cupon.triggerevent(clicked!)
			tab_ingreso.tp_boletas.cb_bl_borrar.triggerevent(clicked!)
			w_cuenta_corriente_contrato_isa.setfocus()
		CASE "D" // Derecho
			if isvalid(w_cuenta_corriente_derecho) then close(w_cuenta_corriente_derecho)
			Open(w_cuenta_corriente_derecho)
			tab_ingreso.tp_ci.cb_ci_borrar.triggerevent(clicked!)
			tab_ingreso.tp_be.cb_be_borrar.triggerevent(clicked!)
			tab_ingreso.tp_cupon.cb_limpiar_cupon.triggerevent(clicked!)
			tab_ingreso.tp_boletas.cb_bl_borrar.triggerevent(clicked!)
			w_cuenta_corriente_derecho.setfocus()
		CASE "R" // Derecho
			if isvalid(w_cuenta_corriente_repactar_cta_mant) then close(w_cuenta_corriente_repactar_cta_mant)
			Open(w_cuenta_corriente_repactar_cta_mant)
			tab_ingreso.tp_ci.cb_ci_borrar.triggerevent(clicked!)
			tab_ingreso.tp_be.cb_be_borrar.triggerevent(clicked!)
			tab_ingreso.tp_cupon.cb_limpiar_cupon.triggerevent(clicked!)
			tab_ingreso.tp_boletas.cb_bl_borrar.triggerevent(clicked!)
			w_cuenta_corriente_repactar_cta_mant.setfocus()
		CASE "A"
			if isvalid(w_cuenta_corriente_aumento_capacidad) then close(w_cuenta_corriente_aumento_capacidad)
			Open(w_cuenta_corriente_aumento_capacidad)
			tab_ingreso.tp_ci.cb_ci_borrar.triggerevent(clicked!)
			tab_ingreso.tp_be.cb_be_borrar.triggerevent(clicked!)
			tab_ingreso.tp_cupon.cb_limpiar_cupon.triggerevent(clicked!)
			tab_ingreso.tp_boletas.cb_bl_borrar.triggerevent(clicked!)
			w_cuenta_corriente_aumento_capacidad.setfocus()
		CASE "F","G","V" // Funeraria/CINERARIO/Servicio
			if isvalid(w_cuenta_corriente_funeraria) then close(w_cuenta_corriente_funeraria)
			Open(w_cuenta_corriente_funeraria)
			tab_ingreso.tp_ci.cb_ci_borrar.triggerevent(clicked!)
			tab_ingreso.tp_be.cb_be_borrar.triggerevent(clicked!)
			tab_ingreso.tp_cupon.cb_limpiar_cupon.triggerevent(clicked!)
			tab_ingreso.tp_boletas.cb_bl_borrar.triggerevent(clicked!)
			w_cuenta_corriente_funeraria.setfocus()
		CASE "B"
			if isvalid(w_cuenta_corriente_facturas) then close(w_cuenta_corriente_facturas)
			Open(w_cuenta_corriente_facturas)
			tab_ingreso.tp_ci.cb_ci_borrar.triggerevent(clicked!)
			tab_ingreso.tp_be.cb_be_borrar.triggerevent(clicked!)
			tab_ingreso.tp_cupon.cb_limpiar_cupon.triggerevent(clicked!)
			tab_ingreso.tp_boletas.cb_bl_borrar.triggerevent(clicked!)
			w_cuenta_corriente_facturas.setfocus()
	END CHOOSE
END IF
end event

type cb_cerrar from commandbutton within w_ingreso2
event ue_mousemove pbm_mousemove
integer x = 3337
integer y = 2136
integer width = 357
integer height = 96
integer taborder = 70
integer textsize = -10
integer weight = 700
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string text = "&Cerrar"
end type

event ue_mousemove;tab_ingreso.tp_ci.st_14.visible					= false
tab_ingreso.tp_ci.st_help_insertar.visible		= false
tab_ingreso.tp_ci.st_help_eliminar.visible	= false
tab_ingreso.tp_cupon.st_help_ctto.visible	= false
if is_opcion='FP' and (gs_depto='T' or gs_depto='I') then st_fuera_plazo.visible = true
end event

event clicked;Long		ll_tot_reg,ll_count_reg,ll_folio,ll_ult_folio,ll_ctas_pagadas_pie,ll_calc_ctas,ll_nulo,ll_count_ci,ll_count_abono,ll_count,ll_sw_suma,ll_indi
Datetime	ldt_fecha_prim,ldt_fecha_hoy
String		ls_tcp_ip,ls_nulo,ls_tipo_cob
Double	ll_cupon_mp

Setnull(ll_nulo);Setnull(ls_nulo);Setnull(gs_filtro)
gs_reingreso_be				= 'N'
gs_reingreso_ci				= 'N'
ldt_fecha_hoy					= datetime(date(gdt_fec_sistema),time('00:00:00'))
SELECT	"FICHA_SEPULTACION"."IP"
INTO 		:ls_tcp_ip  
FROM 		"FICHA_SEPULTACION"  
WHERE  ( "FICHA_SEPULTACION"."BASE" = :gs_base ) AND  
		 ( "FICHA_SEPULTACION"."SERIE" = :gs_serie ) AND  
		 ( "FICHA_SEPULTACION"."NUMERO" = :gi_numero ) AND 
		 ( "FICHA_SEPULTACION"."IP" is not Null )   
USING		sqlca;
if not isnull(ls_tcp_ip) and ls_tcp_ip<>'' then
	UPDATE	"FICHA_SEPULTACION"  
	SET 		"FOLIO_COMPROBANTE" = :ll_nulo,
				"IP" = :ls_nulo
	WHERE 	"FICHA_SEPULTACION"."IP" = :ls_tcp_ip   
	USING		sqlca;
	if sqlca.sqlcode=0 then
		commit;
	else
		rollback;
	end if
else
	SELECT	"FICHA_TRASLADO"."IP"
	INTO 		:ls_tcp_ip
	FROM 		"FICHA_TRASLADO"  
	WHERE  ( "FICHA_TRASLADO"."BASE_ORIGEN" = :gs_base ) AND  
			 ( "FICHA_TRASLADO"."SERIE_ORIGEN" = :gs_serie ) AND  
			 ( "FICHA_TRASLADO"."NUMERO_ORIGEN" = :gi_numero ) AND  
			 ( "FICHA_TRASLADO"."IP" is not null )   
	USING		sqlca;
	if not isnull(ls_tcp_ip) and ls_tcp_ip<>'' then
		UPDATE	"FICHA_TRASLADO"  
		SET 		"BOLETA_NRO_ORIGEN" = :ll_nulo,   
					"IP" = :ls_nulo  
		WHERE  ( "FICHA_TRASLADO"."IP" = :ls_tcp_ip ) AND  
				 ( "FICHA_TRASLADO"."BASE_ORIGEN" = :gs_base ) AND  
				 ( "FICHA_TRASLADO"."SERIE_ORIGEN" = :gs_serie ) AND  
				 ( "FICHA_TRASLADO"."NUMERO_ORIGEN" = :gi_numero )   
		USING		sqlca;
		if sqlca.sqlcode=0 then
			commit;
		else
			rollback;
		end if
	else
		SELECT	"FICHA_TRASLADO"."IP"
		INTO 		:ls_tcp_ip
		FROM 		"FICHA_TRASLADO"  
		WHERE  ( "FICHA_TRASLADO"."BASE_DESTINO" = :gs_base ) AND  
				 ( "FICHA_TRASLADO"."SERIE_DESTINO" = :gs_serie ) AND  
				 ( "FICHA_TRASLADO"."NUMERO_DESTINO" = :gi_numero ) AND  
				 ( "FICHA_TRASLADO"."IP" is not null )   
		USING		sqlca;
		if not isnull(ls_tcp_ip) and ls_tcp_ip<>'' then
			UPDATE	"FICHA_TRASLADO"  
			SET 		"BOLETA_NRO_DESTINO" = :ll_nulo,   
						"IP" = :ls_nulo  
			WHERE  ( "FICHA_TRASLADO"."IP" = :ls_tcp_ip ) AND  
					 ( "FICHA_TRASLADO"."BASE_DESTINO" = :gs_base ) AND  
					 ( "FICHA_TRASLADO"."SERIE_DESTINO" = :gs_serie ) AND  
					 ( "FICHA_TRASLADO"."NUMERO_DESTINO" = :gi_numero )   
			USING		sqlca;
			if sqlca.sqlcode=0 then
				commit;
			else
				rollback;
			end if
		end if
	end if
end if
ll_tot_reg			= dw_multiproducto.rowcount()
if ll_tot_reg > 0 and gl_sw_mp = 0 and gl_codigo_mp > 0 then		//and gs_rezago='S'
	if gs_base='M' and ll_tot_reg > 0 then
		SELECT 	Count("INGRESO"."TIPO_COB"  )
		INTO 		:ll_count  
		FROM 	"INGRESO"  
		WHERE 	( "INGRESO"."FOLIO" = :ll_folio ) AND  
					( "INGRESO"."TIPO_COB" = 'CX' ) AND  
					( "INGRESO"."FECHA_PAGO" = :gd_fecha_pago_plazo )   ;
		if isnull(ll_count) then ll_count=0
		if ll_count > 0 then
			ll_sw_suma				= 0
			for ll_indi=1 to ll_tot_reg
				ll_sw_suma ++
				ll_cupon_mp		= dw_multiproducto.getitemnumber(ll_indi,'mpnro_cupon')
				ls_tipo_cob			= dw_multiproducto.getitemstring(ll_indi,'tipodoc')
				if ll_sw_suma = 1 then
					UPDATE 	"CUPONERAS_DETALLE_WEB"  
					SET 		"ESTADO_PAGO_CUPON" = 'A'  
					WHERE 	( "CUPONERAS_DETALLE_WEB"."NRO_CUPON" = :ll_cupon_mp ) AND  
								( "CUPONERAS_DETALLE_WEB"."TIPO_COB_PAGO" = :ls_tipo_cob OR "CUPONERAS_DETALLE_WEB"."TIPO_COB_PAGO" = 'CX' ) AND  
								( "CUPONERAS_DETALLE_WEB"."RUT" = :gi_rut ) AND  
								( "CUPONERAS_DETALLE_WEB"."FECHA_PAGO" = :ldt_fecha_hoy )   
					USING	sqlca;
					if sqlca.sqlcode=0 then
						commit;
						exit;
					else
						rollback;
					end if
				end if

			next
		end if
	end if
end if	
ll_tot_reg								= tab_ingreso.tp_be.dw_detalle_be.rowcount()
if ll_tot_reg>0 then
	ll_count_reg 						= tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob ='A' or tipo_cob ='Q'",1, ll_tot_reg)
	if ll_count_reg>0 and gs_grabar_pie='N' then
		setnull(ldt_fecha_prim)
		ll_folio							= long(tab_ingreso.tp_be.sle_numero_be.text)
//		ldt_fecha_hoy					= datetime(date(gdt_fec_sistema),time('00:00:00'))
		SELECT	Count("DETALLE_PAGO_PIE"."FOLIO")
		INTO 		:ll_count_reg
		FROM 		"DETALLE_PAGO_PIE"
		WHERE  ( "DETALLE_PAGO_PIE"."BASE" = :gs_base ) AND  
				 ( "DETALLE_PAGO_PIE"."SERIE" = :gs_serie ) AND  
				 ( "DETALLE_PAGO_PIE"."NUMERO" = :gi_numero ) AND  
				 ( "DETALLE_PAGO_PIE"."TIPO_COB" = :gs_tipo_cobro ) AND  
				 ( "DETALLE_PAGO_PIE"."FOLIO" = :ll_folio ) AND  
				 ( "DETALLE_PAGO_PIE"."FECHA_PAGO" = :gd_fecha_pago_plazo )   
		USING		sqlca;
		if ll_count_reg>0 then
			UPDATE	"DETALLE_PAGO_PIE"  
			SET 		"TIPO_COB" = null,   
						"FOLIO" = null,   
						"CAJA" = null,   
						"USUARIO" = null,   
						"FECHA_PAGO" = null,   
						"MONTO_PIE_PAGADO_PESO" = null,
						"ESTADO" = 'P'  
			WHERE  ( "DETALLE_PAGO_PIE"."BASE" = :gs_base ) AND  
					 ( "DETALLE_PAGO_PIE"."SERIE" = :gs_serie ) AND  
					 ( "DETALLE_PAGO_PIE"."NUMERO" = :gi_numero ) AND  
					 ( "DETALLE_PAGO_PIE"."TIPO_COB" = :gs_tipo_cobro ) AND  
					 ( "DETALLE_PAGO_PIE"."FOLIO" = :ll_folio ) AND  
					 ( "DETALLE_PAGO_PIE"."FECHA_PAGO" = :gd_fecha_pago_plazo)		//:ldt_fecha_hoy )   
			USING		sqlca;
			if sqlca.sqlcode=0 then
				commit;
				if gs_base = 'O' or gs_base='U' or gs_base='M' then
					SELECT	"PAGO_OFERTA"."FOLIO",
								"PAGO_OFERTA"."CTAS_PAGADAS_PIE",
								"PAGO_OFERTA"."FECHA_PRIM_PIE"
					INTO 		:ll_ult_folio,
								:ll_ctas_pagadas_pie,
								:ldt_fecha_prim
					FROM 	"CADENA",	"OFERTA_V",	"PAGO_OFERTA"  
					WHERE    ( "OFERTA_V"."SERIE" = "PAGO_OFERTA"."SERIE" ) and  
								 ( "OFERTA_V"."NRO_OFERTA" = "PAGO_OFERTA"."NRO_OFERTA" ) and  
								 ( "OFERTA_V"."ULT_FOLIO" = "PAGO_OFERTA"."FOLIO" ) and  
								 ( "CADENA"."SERIE" = "OFERTA_V"."SERIE" ) and  
								 ( "CADENA"."NUMERO" = "OFERTA_V"."NRO_OFERTA" ) and  
								 (("CADENA"."CODIGO" = :gs_base ) AND  
								 ( "CADENA"."SERIE" = :gs_serie ) AND  
								 ( "CADENA"."NUMERO" = :gi_numero ) )   
					USING		sqlca;
					if sqlca.sqlcode=0 then
						ll_calc_ctas	= ll_ctas_pagadas_pie - ll_count_reg
						if ll_calc_ctas<=0 then
							ll_calc_ctas	= 0
						end if
						UPDATE	"PAGO_OFERTA"  
						SET		"CTAS_PAGADAS_PIE" = :ll_calc_ctas,   
									"FECHA_PRIM_PIE" = :ldt_fecha_prim  
						WHERE  ( "PAGO_OFERTA"."SERIE" = :gs_serie ) AND  
								 ( "PAGO_OFERTA"."NRO_OFERTA" = :gi_numero ) AND  
								 ( "PAGO_OFERTA"."FOLIO" = :ll_ult_folio )   
						USING		sqlca;
						if sqlca.sqlcode=0 then
							commit;
						else
							rollback;
						end if
					end if
				elseif gs_base = 'A' then
					SELECT	"PAGO_AUMENTO"."FOLIO",
								"PAGO_AUMENTO"."CTAS_PAGADAS_PIE",
								"PAGO_AUMENTO"."FECHA_PRIM_PIE"
					INTO 		:ll_ult_folio,
								:ll_ctas_pagadas_pie,
								:ldt_fecha_prim
					FROM 	"CADENA",	"ANEXO_AUMENTO",	"PAGO_AUMENTO"  
					WHERE    ( "ANEXO_AUMENTO"."SERIE_M" = "PAGO_AUMENTO"."SERIE_M" ) and  
								 ( "ANEXO_AUMENTO"."NRO_AUMENTO" = "PAGO_AUMENTO"."NRO_AUMENTO" ) and  
								 ( "ANEXO_AUMENTO"."ULT_FOLIO" = "PAGO_AUMENTO"."FOLIO" ) and  
								 ( "CADENA"."SERIE" = "ANEXO_AUMENTO"."SERIE_M" ) and  
								 ( "CADENA"."NUMERO" = "ANEXO_AUMENTO"."NRO_AUMENTO" ) and  
								 (("CADENA"."CODIGO" = :gs_base ) AND  
								 ( "CADENA"."SERIE" = :gs_serie ) AND  
								 ( "CADENA"."NUMERO" = :gi_numero ) )   
					USING		sqlca;
					if sqlca.sqlcode=0 then
						ll_calc_ctas	= ll_ctas_pagadas_pie - ll_count_reg
						if ll_calc_ctas<=0 then
							ll_calc_ctas	= 0
						end if
						UPDATE	"PAGO_AUMENTO"  
						SET		"CTAS_PAGADAS_PIE" = :ll_calc_ctas,   
									"FECHA_PRIM_PIE" = :ldt_fecha_prim  
						WHERE  ( "PAGO_AUMENTO"."SERIE_M" = :gs_serie ) AND  
								 ( "PAGO_AUMENTO"."NRO_AUMENTO" = :gi_numero ) AND  
								 ( "PAGO_AUMENTO"."FOLIO" = :ll_ult_folio )   
						USING		sqlca;
						if sqlca.sqlcode=0 then
							commit;
						else
							rollback;
						end if
					end if
				elseif gs_base='L' then
					SELECT	"PAGO_LIBERADOR"."FOLIO",
								"PAGO_LIBERADOR"."CTAS_PAGADAS_PIE",
								"PAGO_LIBERADOR"."FECHA_PRIM_PIE"
					INTO 		:ll_ult_folio,
								:ll_ctas_pagadas_pie,
								:ldt_fecha_prim
					FROM 	"CADENA",	"ANEXO_LIBERADOR",	"PAGO_LIBERADOR"  
					WHERE    ( "ANEXO_LIBERADOR"."SERIE_M" = "PAGO_LIBERADOR"."SERIE_M" ) and  
								 ( "ANEXO_LIBERADOR"."NRO_LIBERADOR" = "PAGO_LIBERADOR"."NRO_LIBERADOR" ) and  
								 ( "ANEXO_LIBERADOR"."ULT_FOLIO" = "PAGO_LIBERADOR"."FOLIO" ) and  
								 ( "CADENA"."SERIE" = "ANEXO_LIBERADOR"."SERIE_M" ) and  
								 ( "CADENA"."NUMERO" = "ANEXO_LIBERADOR"."NRO_LIBERADOR" ) and  
								 (("CADENA"."CODIGO" = :gs_base ) AND  
								 ( "CADENA"."SERIE" = :gs_serie ) AND  
								 ( "CADENA"."NUMERO" = :gi_numero ) )   
					USING		sqlca;
					if sqlca.sqlcode=0 then
						ll_calc_ctas	= ll_ctas_pagadas_pie - ll_count_reg
						if ll_calc_ctas<=0 then
							ll_calc_ctas	= 0
						end if
						UPDATE	"PAGO_LIBERADOR"  
						SET		"CTAS_PAGADAS_PIE" = :ll_calc_ctas,   
									"FECHA_PRIM_PIE" = :ldt_fecha_prim  
						WHERE  ( "PAGO_LIBERADOR"."SERIE_M" = :gs_serie ) AND  
								 ( "PAGO_LIBERADOR"."NRO_LIBERADOR" = :gi_numero ) AND  
								 ( "PAGO_LIBERADOR"."FOLIO" = :ll_ult_folio )   
						USING		sqlca;
						if sqlca.sqlcode=0 then
							commit;
						else
							rollback;
						end if
					end if
				elseif gs_base='F' or gs_base='G' or gs_base='V' then
					SELECT	"PRODUCTO_PAGO"."FOLIO",
								"PRODUCTO_PAGO"."CTAS_PIE_PAGADAS",
								"PRODUCTO_PAGO"."FECHA_PIE_PRIM"
					INTO 		:ll_ult_folio,
								:ll_ctas_pagadas_pie,
								:ldt_fecha_prim
					FROM 	"CADENA",	"PRODUCTO_ANEXO",	"PRODUCTO_PAGO"  
					WHERE    ( "PRODUCTO_ANEXO"."SERIE" = "PRODUCTO_PAGO"."SERIE" ) and  
								 ( "PRODUCTO_ANEXO"."NUMERO" = "PRODUCTO_PAGO"."NUMERO" ) and  
								 ( "PRODUCTO_ANEXO"."ULT_FOLIO" = "PRODUCTO_PAGO"."FOLIO" ) and  
								 ( "CADENA"."SERIE" = "PRODUCTO_ANEXO"."SERIE" ) and  
								 ( "CADENA"."NUMERO" = "PRODUCTO_ANEXO"."NUMERO" ) and  
								 (("CADENA"."CODIGO" = :gs_base ) AND  
								 ( "CADENA"."SERIE" = :gs_serie ) AND  
								 ( "CADENA"."NUMERO" = :gi_numero ) )   
					USING		sqlca;
					if sqlca.sqlcode=0 then
						ll_calc_ctas	= ll_ctas_pagadas_pie - ll_count_reg
						if ll_calc_ctas<=0 then
							ll_calc_ctas	= 0
						end if
						UPDATE	"PRODUCTO_PAGO"  
						SET		"CTAS_PIE_PAGADAS" = :ll_calc_ctas,   
									"FECHA_PIE_PRIM" = :ldt_fecha_prim  
						WHERE  ( "PRODUCTO_PAGO"."SERIE" = :gs_serie ) AND  
								 ( "PRODUCTO_PAGO"."NUMERO" = :gi_numero ) AND  
								 ( "PRODUCTO_PAGO"."FOLIO" = :ll_ult_folio )   
						USING		sqlca;
						if sqlca.sqlcode=0 then
							commit;
						else
							rollback;
						end if
					end if
				end if
//				SELECT	"PAGO_OFERTA"."FOLIO",
//							"PAGO_OFERTA"."CTAS_PAGADAS_PIE",
//							"PAGO_OFERTA"."FECHA_PRIM_PIE"
//				INTO 		:ll_ult_folio,
//							:ll_ctas_pagadas_pie,
//							:ldt_fecha_prim
//				FROM 		"CADENA",	"OFERTA_V",	"PAGO_OFERTA"  
//				WHERE  ( "OFERTA_V"."SERIE" = "PAGO_OFERTA"."SERIE" ) and  
//						 ( "OFERTA_V"."NRO_OFERTA" = "PAGO_OFERTA"."NRO_OFERTA" ) and  
//						 ( "OFERTA_V"."ULT_FOLIO" = "PAGO_OFERTA"."FOLIO" ) and  
//						 ( "CADENA"."SERIE" = "OFERTA_V"."SERIE" ) and  
//						 ( "CADENA"."NUMERO" = "OFERTA_V"."NRO_OFERTA" ) and  
//						 (("CADENA"."CODIGO" = :gs_base ) AND  
//						 ( "CADENA"."SERIE" = :gs_serie ) AND  
//						 ( "CADENA"."NUMERO" = :gi_numero ) )   
//				USING		sqlca;
//				if sqlca.sqlcode=0 then
//					ll_calc_ctas	= ll_ctas_pagadas_pie - ll_count_reg
//					if ll_calc_ctas<=0 then
//						ll_calc_ctas	= 0
//					end if
//					UPDATE	"PAGO_OFERTA"  
//					SET		"CTAS_PAGADAS_PIE" = :ll_calc_ctas,   
//								"FECHA_PRIM_PIE" = :ldt_fecha_prim  
//					WHERE  ( "PAGO_OFERTA"."SERIE" = :gs_serie ) AND  
//							 ( "PAGO_OFERTA"."NRO_OFERTA" = :gi_numero ) AND  
//							 ( "PAGO_OFERTA"."FOLIO" = :ll_ult_folio )   
//					USING		sqlca;
//					if sqlca.sqlcode=0 then
//						commit;
//					else
//						rollback;
//					end if
//				end if
			else
				rollback;
			end if
		end if
	end if
end if

ll_tot_reg								= tab_ingreso.tp_ci.dw_detalle_ci.rowcount()
if ll_tot_reg>0 then
	ll_count_reg 						= tab_ingreso.tp_ci.dw_detalle_ci.Find("tipo_cob ='A' or tipo_cob ='Q'",1, ll_tot_reg)
	if ll_count_reg>0 and gs_grabar_pie='N' then
		setnull(ldt_fecha_prim)
		ll_folio							= long(tab_ingreso.tp_ci.sle_numero_ci.text)
//		ldt_fecha_hoy					= datetime(date(gdt_fec_sistema),time('00:00:00'))
		SELECT	Count("DETALLE_PAGO_PIE"."FOLIO")
		INTO 		:ll_count_reg
		FROM 		"DETALLE_PAGO_PIE"
		WHERE  ( "DETALLE_PAGO_PIE"."BASE" = :gs_base ) AND  
				 ( "DETALLE_PAGO_PIE"."SERIE" = :gs_serie ) AND  
				 ( "DETALLE_PAGO_PIE"."NUMERO" = :gi_numero ) AND  
				 ( "DETALLE_PAGO_PIE"."TIPO_COB" = :gs_tipo_cobro ) AND  
				 ( "DETALLE_PAGO_PIE"."FOLIO" = :ll_folio ) AND  
				 ( "DETALLE_PAGO_PIE"."FECHA_PAGO" = :gd_fecha_pago_plazo)	//:ldt_fecha_hoy )   
		USING		sqlca;
		if ll_count_reg>0 then
			UPDATE	"DETALLE_PAGO_PIE"  
			SET 		"TIPO_COB" = null,   
						"FOLIO" = null,   
						"CAJA" = null,   
						"USUARIO" = null,   
						"FECHA_PAGO" = null,   
						"MONTO_PIE_PAGADO_PESO" = null,
						"ESTADO" = 'P'  
			WHERE  ( "DETALLE_PAGO_PIE"."BASE" = :gs_base ) AND  
					 ( "DETALLE_PAGO_PIE"."SERIE" = :gs_serie ) AND  
					 ( "DETALLE_PAGO_PIE"."NUMERO" = :gi_numero ) AND  
					 ( "DETALLE_PAGO_PIE"."TIPO_COB" = :gs_tipo_cobro ) AND  
					 ( "DETALLE_PAGO_PIE"."FOLIO" = :ll_folio ) AND  
					 ( "DETALLE_PAGO_PIE"."FECHA_PAGO" = :gd_fecha_pago_plazo )   
			USING		sqlca;
			if sqlca.sqlcode=0 then
				commit;
				if gs_base = 'O' or gs_base='U' or gs_base='M' then
					SELECT	"PAGO_OFERTA"."FOLIO",
								"PAGO_OFERTA"."CTAS_PAGADAS_PIE",
								"PAGO_OFERTA"."FECHA_PRIM_PIE"
					INTO 		:ll_ult_folio,
								:ll_ctas_pagadas_pie,
								:ldt_fecha_prim
					FROM 	"CADENA",	"OFERTA_V",	"PAGO_OFERTA"  
					WHERE    ( "OFERTA_V"."SERIE" = "PAGO_OFERTA"."SERIE" ) and  
								 ( "OFERTA_V"."NRO_OFERTA" = "PAGO_OFERTA"."NRO_OFERTA" ) and  
								 ( "OFERTA_V"."ULT_FOLIO" = "PAGO_OFERTA"."FOLIO" ) and  
								 ( "CADENA"."SERIE" = "OFERTA_V"."SERIE" ) and  
								 ( "CADENA"."NUMERO" = "OFERTA_V"."NRO_OFERTA" ) and  
								 (("CADENA"."CODIGO" = :gs_base ) AND  
								 ( "CADENA"."SERIE" = :gs_serie ) AND  
								 ( "CADENA"."NUMERO" = :gi_numero ) )   
					USING		sqlca;
					if sqlca.sqlcode=0 then
						ll_calc_ctas	= ll_ctas_pagadas_pie - ll_count_reg
						if ll_calc_ctas<=0 then
							ll_calc_ctas	= 0
						end if
						UPDATE	"PAGO_OFERTA"  
						SET		"CTAS_PAGADAS_PIE" = :ll_calc_ctas,   
									"FECHA_PRIM_PIE" = :ldt_fecha_prim  
						WHERE  ( "PAGO_OFERTA"."SERIE" = :gs_serie ) AND  
								 ( "PAGO_OFERTA"."NRO_OFERTA" = :gi_numero ) AND  
								 ( "PAGO_OFERTA"."FOLIO" = :ll_ult_folio )   
						USING		sqlca;
						if sqlca.sqlcode=0 then
							commit;
						else
							rollback;
						end if
					end if
				elseif gs_base = 'A' then
					SELECT	"PAGO_AUMENTO"."FOLIO",
								"PAGO_AUMENTO"."CTAS_PAGADAS_PIE",
								"PAGO_AUMENTO"."FECHA_PRIM_PIE"
					INTO 		:ll_ult_folio,
								:ll_ctas_pagadas_pie,
								:ldt_fecha_prim
					FROM 	"CADENA",	"ANEXO_AUMENTO",	"PAGO_AUMENTO"  
					WHERE    ( "ANEXO_AUMENTO"."SERIE_M" = "PAGO_AUMENTO"."SERIE_M" ) and  
								 ( "ANEXO_AUMENTO"."NRO_AUMENTO" = "PAGO_AUMENTO"."NRO_AUMENTO" ) and  
								 ( "ANEXO_AUMENTO"."ULT_FOLIO" = "PAGO_AUMENTO"."FOLIO" ) and  
								 ( "CADENA"."SERIE" = "ANEXO_AUMENTO"."SERIE_M" ) and  
								 ( "CADENA"."NUMERO" = "ANEXO_AUMENTO"."NRO_AUMENTO" ) and  
								 (("CADENA"."CODIGO" = :gs_base ) AND  
								 ( "CADENA"."SERIE" = :gs_serie ) AND  
								 ( "CADENA"."NUMERO" = :gi_numero ) )   
					USING		sqlca;
					if sqlca.sqlcode=0 then
						ll_calc_ctas	= ll_ctas_pagadas_pie - ll_count_reg
						if ll_calc_ctas<=0 then
							ll_calc_ctas	= 0
						end if
						UPDATE	"PAGO_AUMENTO"  
						SET		"CTAS_PAGADAS_PIE" = :ll_calc_ctas,   
									"FECHA_PRIM_PIE" = :ldt_fecha_prim  
						WHERE  ( "PAGO_AUMENTO"."SERIE_M" = :gs_serie ) AND  
								 ( "PAGO_AUMENTO"."NRO_AUMENTO" = :gi_numero ) AND  
								 ( "PAGO_AUMENTO"."FOLIO" = :ll_ult_folio )   
						USING		sqlca;
						if sqlca.sqlcode=0 then
							commit;
						else
							rollback;
						end if
					end if
				elseif gs_base='L' then
					SELECT	"PAGO_LIBERADOR"."FOLIO",
								"PAGO_LIBERADOR"."CTAS_PAGADAS_PIE",
								"PAGO_LIBERADOR"."FECHA_PRIM_PIE"
					INTO 		:ll_ult_folio,
								:ll_ctas_pagadas_pie,
								:ldt_fecha_prim
					FROM 	"CADENA",	"ANEXO_LIBERADOR",	"PAGO_LIBERADOR"  
					WHERE    ( "ANEXO_LIBERADOR"."SERIE_M" = "PAGO_LIBERADOR"."SERIE_M" ) and  
								 ( "ANEXO_LIBERADOR"."NRO_LIBERADOR" = "PAGO_LIBERADOR"."NRO_LIBERADOR" ) and  
								 ( "ANEXO_LIBERADOR"."ULT_FOLIO" = "PAGO_LIBERADOR"."FOLIO" ) and  
								 ( "CADENA"."SERIE" = "ANEXO_LIBERADOR"."SERIE_M" ) and  
								 ( "CADENA"."NUMERO" = "ANEXO_LIBERADOR"."NRO_LIBERADOR" ) and  
								 (("CADENA"."CODIGO" = :gs_base ) AND  
								 ( "CADENA"."SERIE" = :gs_serie ) AND  
								 ( "CADENA"."NUMERO" = :gi_numero ) )   
					USING		sqlca;
					if sqlca.sqlcode=0 then
						ll_calc_ctas	= ll_ctas_pagadas_pie - ll_count_reg
						if ll_calc_ctas<=0 then
							ll_calc_ctas	= 0
						end if
						UPDATE	"PAGO_LIBERADOR"  
						SET		"CTAS_PAGADAS_PIE" = :ll_calc_ctas,   
									"FECHA_PRIM_PIE" = :ldt_fecha_prim  
						WHERE  ( "PAGO_LIBERADOR"."SERIE_M" = :gs_serie ) AND  
								 ( "PAGO_LIBERADOR"."NRO_LIBERADOR" = :gi_numero ) AND  
								 ( "PAGO_LIBERADOR"."FOLIO" = :ll_ult_folio )   
						USING		sqlca;
						if sqlca.sqlcode=0 then
							commit;
						else
							rollback;
						end if
					end if
				elseif gs_base='F' or gs_base='G' or gs_base='V' then
					SELECT	"PRODUCTO_PAGO"."FOLIO",
								"PRODUCTO_PAGO"."CTAS_PIE_PAGADAS",
								"PRODUCTO_PAGO"."FECHA_PIE_PRIM"
					INTO 		:ll_ult_folio,
								:ll_ctas_pagadas_pie,
								:ldt_fecha_prim
					FROM 	"CADENA",	"PRODUCTO_ANEXO",	"PRODUCTO_PAGO"  
					WHERE    ( "PRODUCTO_ANEXO"."SERIE" = "PRODUCTO_PAGO"."SERIE" ) and  
								 ( "PRODUCTO_ANEXO"."NUMERO" = "PRODUCTO_PAGO"."NUMERO" ) and  
								 ( "PRODUCTO_ANEXO"."ULT_FOLIO" = "PRODUCTO_PAGO"."FOLIO" ) and  
								 ( "CADENA"."SERIE" = "PRODUCTO_ANEXO"."SERIE" ) and  
								 ( "CADENA"."NUMERO" = "PRODUCTO_ANEXO"."NUMERO" ) and  
								 (("CADENA"."CODIGO" = :gs_base ) AND  
								 ( "CADENA"."SERIE" = :gs_serie ) AND  
								 ( "CADENA"."NUMERO" = :gi_numero ) )   
					USING		sqlca;
					if sqlca.sqlcode=0 then
						ll_calc_ctas	= ll_ctas_pagadas_pie - ll_count_reg
						if ll_calc_ctas<=0 then
							ll_calc_ctas	= 0
						end if
						UPDATE	"PRODUCTO_PAGO"  
						SET		"CTAS_PIE_PAGADAS" = :ll_calc_ctas,   
									"FECHA_PIE_PRIM" = :ldt_fecha_prim  
						WHERE  ( "PRODUCTO_PAGO"."SERIE" = :gs_serie ) AND  
								 ( "PRODUCTO_PAGO"."NUMERO" = :gi_numero ) AND  
								 ( "PRODUCTO_PAGO"."FOLIO" = :ll_ult_folio )   
						USING		sqlca;
						if sqlca.sqlcode=0 then
							commit;
						else
							rollback;
						end if
					end if
				end if
//				SELECT	"PAGO_OFERTA"."FOLIO",
//							"PAGO_OFERTA"."CTAS_PAGADAS_PIE",
//							"PAGO_OFERTA"."FECHA_PRIM_PIE"
//				INTO 		:ll_ult_folio,
//							:ll_ctas_pagadas_pie,
//							:ldt_fecha_prim
//				FROM 		"CADENA",	"OFERTA_V",	"PAGO_OFERTA"  
//				WHERE  ( "OFERTA_V"."SERIE" = "PAGO_OFERTA"."SERIE" ) and  
//						 ( "OFERTA_V"."NRO_OFERTA" = "PAGO_OFERTA"."NRO_OFERTA" ) and  
//						 ( "OFERTA_V"."ULT_FOLIO" = "PAGO_OFERTA"."FOLIO" ) and  
//						 ( "CADENA"."SERIE" = "OFERTA_V"."SERIE" ) and  
//						 ( "CADENA"."NUMERO" = "OFERTA_V"."NRO_OFERTA" ) and  
//						 (("CADENA"."CODIGO" = :gs_base ) AND  
//						 ( "CADENA"."SERIE" = :gs_serie ) AND  
//						 ( "CADENA"."NUMERO" = :gi_numero ) )   
//				USING		sqlca;
//				if sqlca.sqlcode=0 then
//					ll_calc_ctas	= ll_ctas_pagadas_pie - ll_count_reg
//					if ll_calc_ctas<=0 then
//						ll_calc_ctas	= 0
//					end if
//					UPDATE	"PAGO_OFERTA"  
//					SET		"CTAS_PAGADAS_PIE" = :ll_calc_ctas,   
//								"FECHA_PRIM_PIE" = :ldt_fecha_prim  
//					WHERE  ( "PAGO_OFERTA"."SERIE" = :gs_serie ) AND  
//							 ( "PAGO_OFERTA"."NRO_OFERTA" = :gi_numero ) AND  
//							 ( "PAGO_OFERTA"."FOLIO" = :ll_ult_folio )   
//					USING		sqlca;
//					if sqlca.sqlcode=0 then
//						commit;
//					else
//						rollback;
//					end if
//				end if
			else
				rollback;
			end if
		end if
	end if
end if
if tab_ingreso.SelectedTab = 1 then
	ll_folio			= gl_folio
	if gl_folio > 0 then
		SELECT	Count("INGRESO"."FOLIO")  
		INTO 		:ll_count_ci  
		FROM 		"INGRESO"  
		WHERE  ( "INGRESO"."TIPO_COB" = 'CU' ) AND  
				 ( "INGRESO"."FOLIO" = :ll_folio )   
		USING		sqlca;
		if ll_count_ci = 0 then
			SELECT	Count("ABONO_CTA_CTE"."FOLIO")  
			INTO 		:ll_count_abono  
			FROM 		"ABONO_CTA_CTE"  
			WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
					 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
					 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
					 ( "ABONO_CTA_CTE"."TIPO_COB" = 'CU' ) AND  
					 ( "ABONO_CTA_CTE"."FOLIO" = :ll_folio ) AND
					 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )  
			USING		sqlca;
			if ll_count_abono > 0 then
				DELETE FROM "ABONO_CTA_CTE"  
				WHERE		( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
							( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
							( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
							( "ABONO_CTA_CTE"."TIPO_COB" = 'CU' ) AND  
							( "ABONO_CTA_CTE"."FOLIO" = :ll_folio ) AND  
							( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
				USING		sqlca;
				if sqlca.sqlcode=0 then
					commit;
				else
					rollback;
					messagebox("Error Eliminar","Error ELIMINAR ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
				end if
			end if
			
			SELECT	Count("ABONO_CTA_CTE"."FOLIO_OCUPA")  
			INTO 		:ll_count_abono  
			FROM 		"ABONO_CTA_CTE"  
			WHERE  ( "ABONO_CTA_CTE"."TIPO_COB_OCUPA" = 'CU' ) AND  
					 ( "ABONO_CTA_CTE"."FOLIO_OCUPA" = :ll_folio ) AND  
					 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'O' )
			USING		sqlca;
			if ll_count_abono > 0 then
				UPDATE	"ABONO_CTA_CTE"  
				SET 		"ESTADO_REG" = 'P',   
							"TIPO_COB_OCUPA" = Null,   
							"FOLIO_OCUPA" = Null,   
							"FECHA_OCUPA" = Null,   
							"MONTO_OCUPA" = Null,   
							"USUARIO_OCUPA" = Null,   
							"CAJA_OCUPA" = Null,   
							"TIPO_MOV_OCUPA" = Null  
				WHERE  ( "ABONO_CTA_CTE"."TIPO_COB_OCUPA" = 'CU' ) AND  
						 ( "ABONO_CTA_CTE"."FOLIO_OCUPA" = :ll_folio ) AND  
						 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'O' )
				USING		sqlca;
				if sqlca.sqlcode=0 then
					commit;
				else
					rollback;
					messagebox("Error Eliminar","Error UPDATE ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
				end if
			end if
			
		end if
	end if
elseif tab_ingreso.SelectedTab = 2 then
	ll_folio							= long(tab_ingreso.tp_ci.sle_numero_ci.text)
	if ll_folio > 0 then
		SELECT	Count("INGRESO"."FOLIO")  
		INTO 		:ll_count_ci  
		FROM 		"INGRESO"  
		WHERE  ( "INGRESO"."TIPO_COB" = :gs_tipo_cobro ) AND  
				 ( "INGRESO"."FOLIO" = :ll_folio )   
		USING		sqlca;
		if ll_count_ci = 0 then
			SELECT	Count("ABONO_CTA_CTE"."FOLIO")  
			INTO 		:ll_count_abono  
			FROM 		"ABONO_CTA_CTE"  
			WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
					 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
					 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
					 ( "ABONO_CTA_CTE"."TIPO_COB" = :gs_tipo_cobro ) AND  
					 ( "ABONO_CTA_CTE"."FOLIO" = :ll_folio ) AND
					 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )  
			USING		sqlca;
			if ll_count_abono > 0 then
				DELETE FROM "ABONO_CTA_CTE"  
				WHERE		( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
							( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
							( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
							( "ABONO_CTA_CTE"."TIPO_COB" = :gs_tipo_cobro ) AND  
							( "ABONO_CTA_CTE"."FOLIO" = :ll_folio ) AND  
							( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
				USING		sqlca;
				if sqlca.sqlcode=0 then
					commit;
				else
					rollback;
					messagebox("Error Eliminar","Error ELIMINAR ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
				end if
			end if
			
			SELECT	Count("ABONO_CTA_CTE"."BASE")  
			INTO 		:ll_count_abono  
			FROM 		"ABONO_CTA_CTE"  
			WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
					 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
					 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
					 ( "ABONO_CTA_CTE"."TIPO_COB" = :gs_tipo_cobro ) AND  
					 ( "ABONO_CTA_CTE"."FOLIO" = :ll_folio ) AND
					 ( "ABONO_CTA_CTE"."TIPO_COB_OCUPA" = :gs_tipo_cobro ) AND  
					 ( "ABONO_CTA_CTE"."FOLIO_OCUPA" = :ll_folio ) AND 
					 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'O' )  
			USING		sqlca;
			if ll_count_abono > 0 then
				DELETE FROM "ABONO_CTA_CTE"  
				WHERE		( "ABONO_CTA_CTE"."TIPO_COB" = :gs_tipo_cobro ) AND  
							( "ABONO_CTA_CTE"."FOLIO" = :ll_folio ) AND  
							( "ABONO_CTA_CTE"."TIPO_COB_OCUPA" = :gs_tipo_cobro ) AND  
							( "ABONO_CTA_CTE"."FOLIO_OCUPA" = :ll_folio ) AND 
							( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
							( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
							( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
							( "ABONO_CTA_CTE"."ESTADO_REG" = 'O' )   
				USING		sqlca;
				if sqlca.sqlcode = 0 then
					commit;
				else
					rollback;
					messagebox("Error Eliminar","Error ELIMINAR ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
				end if
			end if
			
			SELECT	Count("ABONO_CTA_CTE"."FOLIO_OCUPA")  
			INTO 		:ll_count_abono  
			FROM 		"ABONO_CTA_CTE"  
			WHERE  ( "ABONO_CTA_CTE"."TIPO_COB_OCUPA" = :gs_tipo_cobro ) AND  
					 ( "ABONO_CTA_CTE"."FOLIO_OCUPA" = :ll_folio ) AND  
					 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'O' )
			USING		sqlca;
			if ll_count_abono > 0 then
				UPDATE	"ABONO_CTA_CTE"  
				SET 		"ESTADO_REG" = 'P',   
							"TIPO_COB_OCUPA" = Null,   
							"FOLIO_OCUPA" = Null,   
							"FECHA_OCUPA" = Null,   
							"MONTO_OCUPA" = Null,   
							"USUARIO_OCUPA" = Null,   
							"CAJA_OCUPA" = Null,   
							"TIPO_MOV_OCUPA" = Null  
				WHERE  ( "ABONO_CTA_CTE"."TIPO_COB_OCUPA" = :gs_tipo_cobro ) AND  
						 ( "ABONO_CTA_CTE"."FOLIO_OCUPA" = :ll_folio ) AND  
						 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'O' )
				USING		sqlca;
				if sqlca.sqlcode=0 then
					commit;
				else
					rollback;
					messagebox("Error Eliminar","Error UPDATE ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
				end if
			end if
			
		end if
	end if
end if
close(w_ingreso2)
end event

