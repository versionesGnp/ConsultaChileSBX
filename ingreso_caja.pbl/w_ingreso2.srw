event ue_mousemove;tab_ingreso.tp_ci.st_14.visible					= false
tab_ingreso.tp_ci.st_help_insertar.visible		= false
tab_ingreso.tp_ci.st_help_eliminar.visible	= true
tab_ingreso.tp_ci.st_help_descuento.visible	= false
tab_ingreso.tp_ci.st_help_ficha.visible		= false
if is_opcion='FP' and (gs_depto='T' or gs_depto='I') then st_fuera_plazo.visible = true
end event

event clicked;Long		ll_tot_reg,ll_indi,ll_folio,ll_count_reg,ll_row,ll_ult_folio,ll_ctas_pagadas_pie,ll_tot_reg_dw,ll_calc_ctas,ll_ctas_pactadas_pie,ll_nulo,ll_count_abono,ll_count_e,ll_count_f,ll_cod_seguro,&
			ll_cantidad,ll_monto,ll_ctas,ll_ctas_pagadas,ll_ctas_pagadas_1,ll_ctas_pagadas_2,ll_fila,ll_monto_cred,ll_monto_mora_cred,ll_sum_monto_abono,ll_monto_cta,ll_monto_final_cred,&
			ll_monto_mant,ll_monto_mora_mant,ll_monto_final_mant,fila
String		ls_cob,ls_nulo,ls_tcp_ip,ls_tipo_cob,ls_pasa,ls_moneda,ls_string
Datetime	ldt_fecha_hoy,ldt_fecha_prim
Double	ld_monto_uf

Setnull(ll_nulo);Setnull(ls_nulo)
dw_detalle_ci.accepttext()
ls_tipo_cob				= gs_tipo_cobro
if gs_codigo_otro = "" then gs_codigo_otro = '0'
//if ls_tipo_cob = 'S' and gs_codigo_otro <> '0' then
//	wf_validar_descuento()
//end if
IF dw_detalle_ci.RowCount() > 0 Then
	setnull(ldt_fecha_prim)
	ll_row					= dw_detalle_ci.GetRow()
	ls_cob				= dw_detalle_ci.getitemstring(ll_row,'tipo_cob')
	ll_folio				= Long(sle_numero_ci.text)
	ldt_fecha_hoy		= datetime(date(gdt_fec_sistema),time('00:00:00'))
	if (ls_cob='A' or ls_cob='Q') and gs_grabar_pie='N' then //pie
		SELECT	Count("DETALLE_PAGO_PIE"."BASE")  
		INTO 		:ll_count_reg  
		FROM 		"DETALLE_PAGO_PIE"  
		WHERE  ( "DETALLE_PAGO_PIE"."BASE" = :gs_base ) AND  
				 ( "DETALLE_PAGO_PIE"."SERIE" = :gs_serie ) AND  
				 ( "DETALLE_PAGO_PIE"."NUMERO" = :gi_numero ) AND  
				 ( "DETALLE_PAGO_PIE"."TIPO_COB" = :gs_tipo_cobro ) AND  
				 ( "DETALLE_PAGO_PIE"."FOLIO" = :ll_folio ) AND  
				 ( "DETALLE_PAGO_PIE"."FECHA_PAGO" = :gd_fecha_pago_plazo)	//:ldt_fecha_hoy )   
		USING		sqlca;
		if ll_count_reg>0 then
			UPDATE	"DETALLE_PAGO_PIE"  
			SET 		"TIPO_COB" = null,   
						"FOLIO" = null,   
						"CAJA" = null,   
						"USUARIO" = null,   
						"FECHA_PAGO" = null,   
						"MONTO_PIE_PAGADO_PESO" = null,
						"ESTADO" = 'P'  
			WHERE  ( "DETALLE_PAGO_PIE"."BASE" = :gs_base ) AND  
					 ( "DETALLE_PAGO_PIE"."SERIE" = :gs_serie ) AND  
					 ( "DETALLE_PAGO_PIE"."NUMERO" = :gi_numero ) AND  
					 ( "DETALLE_PAGO_PIE"."TIPO_COB" = :gs_tipo_cobro ) AND  
					 ( "DETALLE_PAGO_PIE"."FOLIO" = :ll_folio ) AND  
					 ( "DETALLE_PAGO_PIE"."FECHA_PAGO" = :gd_fecha_pago_plazo)	//ldt_fecha_hoy )   
			USING		sqlca;
			if sqlca.sqlcode=0 then
				commit;
				SELECT	"PAGO_OFERTA"."FOLIO",
							"PAGO_OFERTA"."CTAS_PACTADAS_PIE",
							"PAGO_OFERTA"."CTAS_PAGADAS_PIE",
							"PAGO_OFERTA"."FECHA_PRIM_PIE"
				INTO 		:ll_ult_folio,
							:ll_ctas_pactadas_pie,
							:ll_ctas_pagadas_pie,
							:ldt_fecha_prim
				FROM 		"CADENA",	"OFERTA_V",	"PAGO_OFERTA"  
				WHERE  ( "OFERTA_V"."SERIE" = "PAGO_OFERTA"."SERIE" ) and  
						 ( "OFERTA_V"."NRO_OFERTA" = "PAGO_OFERTA"."NRO_OFERTA" ) and  
						 ( "OFERTA_V"."ULT_FOLIO" = "PAGO_OFERTA"."FOLIO" ) and  
						 ( "CADENA"."SERIE" = "OFERTA_V"."SERIE" ) and  
						 ( "CADENA"."NUMERO" = "OFERTA_V"."NRO_OFERTA" ) and  
						 (("CADENA"."CODIGO" = :gs_base ) AND  
						 ( "CADENA"."SERIE" = :gs_serie ) AND  
						 ( "CADENA"."NUMERO" = :gi_numero ) )   
				USING		sqlca;
				if sqlca.sqlcode=0 then
					ll_calc_ctas	= ll_ctas_pagadas_pie - ll_count_reg
					if ll_calc_ctas<=0 then
						ll_calc_ctas	= 0
					end if
					UPDATE	"PAGO_OFERTA"  
					SET		"CTAS_PAGADAS_PIE" = :ll_calc_ctas,   
								"FECHA_PRIM_PIE" = :ldt_fecha_prim  
					WHERE  ( "PAGO_OFERTA"."SERIE" = :gs_serie ) AND  
							 ( "PAGO_OFERTA"."NRO_OFERTA" = :gi_numero ) AND  
							 ( "PAGO_OFERTA"."FOLIO" = :ll_ult_folio )   
					USING		sqlca;
					if sqlca.sqlcode=0 then
						commit;
					else
						rollback;
					end if
				end if
			else
				rollback;
			end if
		end if
	end if
	if ls_cob='A' then f_validar_pie_pactado_actualizar('CI',dw_detalle_ci.dataobject,gs_base,gs_serie,gi_numero)
	if ls_cob = '1' or ls_cob = '2' or ls_cob = '3' or ls_cob = '4' or ls_cob = '5' or ls_cob = '6' or ls_cob = '7' then
		messagebox("Advertencia","No es Posible Eliminar Item, recuerde debe Eliminar E-Cuota o U-Cuota Reconocimiento")
		dw_detalle_ci.setfocus()
	else
		dw_detalle_ci.DeleteRow(ll_row)
		dw_detalle_ci.accepttext()
		ll_tot_reg_dw			= dw_detalle_ci.RowCount()
		if ls_cob='E' or ls_cob='U' then
			DECLARE x1 CURSOR FOR  
			SELECT	"SEGURO_ASOCIADOS"."COD_SEGURO"  
			FROM 	"SEGURO_ASOCIADOS"  
			WHERE ( "SEGURO_ASOCIADOS"."BASE" = :gs_base ) AND  
					  ( "SEGURO_ASOCIADOS"."SERIE" = :gs_serie ) AND  
					  ( "SEGURO_ASOCIADOS"."NUMERO" = :gi_numero ) AND  
					  ( "SEGURO_ASOCIADOS"."ESTADO_REG" = 0 ) AND  
					  ( "SEGURO_ASOCIADOS"."ESTADO_SEGURO" = 'A' )   
			USING	sqlca;
			open x1;
			if sqlca.sqlcode=0 then
				do while sqlca.sqlcode=0
					fetch x1 into :ll_cod_seguro;
					if not isnull(ll_cod_seguro) then
						ll_fila						= dw_detalle_ci.Find("tipo_cob = '"+string(ll_cod_seguro)+"'",1, ll_tot_reg_dw)
						if ll_fila > 0 then
							dw_detalle_ci.DeleteRow(ll_fila)
							ll_tot_reg_dw			= dw_detalle_ci.RowCount()
						end if
					end if
					setnull(ll_cod_seguro)
				loop
			end if
			close x1;
			dw_detalle_ci.accepttext()
			if dw_detalle_ci.RowCount() > 0 then
				cb_ci_borrar_item.Enabled	= True
				dw_gastos_ci.SetItem(1,"gastos_cob", 0)
				dw_gastos_ci.SetItem(1,"mora", 0)
				dw_gastos_ci.SetItem(1,"subtotal", 0)
				
				dw_gastos_ci.SetItem(1,"mora_cred", 0)
				dw_gastos_ci.SetItem(1,"mora_mant", 0)
				dw_gastos_ci.SetItem(1,"gasto_cred", 0)
				dw_gastos_ci.SetItem(1,"gasto_mant", 0)
				il_int_mora			= 0
				il_int_gc				= 0
				il_suma_dia			= 0
				il_int_gc_cred		= 0
				il_int_gc_mant		= 0
				il_int_gc_cred		= 0
				il_int_gc_mant		= 0
			else
				cbx_paga_ef.enabled	= false
			end if
		end if
		
		if dw_detalle_ci.rowcount()>0 then 
			wf_calcular_interes("E")
	//		wf_calcular_interes("U")
	//		dw_gastos_ci.SetItem(1, "Subtotal",dw_detalle_ci.GetItemNumber(1,"c_subtotal"))
		else
			cb_ci_borrar_item.Enabled	= FALSE
			cbx_paga_ef.enabled			= false
			dw_gastos_ci.SetItem(1,"gastos_cob", 0)
			dw_gastos_ci.SetItem(1,"mora", 0)
			dw_gastos_ci.SetItem(1,"subtotal", 0)
			
			dw_gastos_ci.SetItem(1,"mora_cred", 0)
			dw_gastos_ci.SetItem(1,"mora_mant", 0)
			dw_gastos_ci.SetItem(1,"gasto_cred", 0)
			dw_gastos_ci.SetItem(1,"gasto_mant", 0)
			il_int_mora			= 0
			il_int_gc				= 0
			il_suma_dia			= 0
			il_int_mora_cred	= 0
			il_int_mora_mant	= 0
			il_int_gc_cred		= 0
			il_int_gc_mant		= 0
		end if
	
		if ll_folio > 0 then
			SELECT	Count("ABONO_CTA_CTE"."BASE")  
			INTO 		:ll_count_e  
			FROM 		"ABONO_CTA_CTE"  
			WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
					 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
					 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
					 ( "ABONO_CTA_CTE"."TIPO_COB_OCUPA" = :ls_tipo_cob ) AND  
					 ( "ABONO_CTA_CTE"."FOLIO_OCUPA" = :ll_folio ) AND  
					 ( "ABONO_CTA_CTE"."TIPO_MOV_OCUPA" = 'E' )   
			USING		sqlca;
			
			SELECT	Count("ABONO_CTA_CTE"."BASE")  
			INTO 		:ll_count_f  
			FROM 		"ABONO_CTA_CTE"  
			WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
					 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
					 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
					 ( "ABONO_CTA_CTE"."TIPO_COB_OCUPA" = :ls_tipo_cob ) AND  
					 ( "ABONO_CTA_CTE"."FOLIO_OCUPA" = :ll_folio ) AND  
					 ( "ABONO_CTA_CTE"."TIPO_MOV_OCUPA" = 'F' )   
			USING		sqlca;
		
			
			SELECT	Count("ABONO_CTA_CTE"."BASE")  
			INTO 		:ll_count_abono  
			FROM 		"ABONO_CTA_CTE"  
			WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
					 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
					 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
					 ( "ABONO_CTA_CTE"."TIPO_COB" = :ls_tipo_cob ) AND  
					 ( "ABONO_CTA_CTE"."FOLIO" = :ll_folio ) AND
					 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )  
			USING		sqlca;
			if ll_count_abono > 0 then
				DELETE FROM "ABONO_CTA_CTE"  
				WHERE		( "ABONO_CTA_CTE"."TIPO_COB" = :ls_tipo_cob ) AND  
							( "ABONO_CTA_CTE"."FOLIO" = :ll_folio ) AND  
							( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
							( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
							( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
							( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
				USING		sqlca;
				if sqlca.sqlcode = 0 then
					commit;
					ls_pasa			= 'S'
				else
					rollback;
					messagebox("Error Eliminar","Error ELIMINAR ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
				end if
			end if
			SELECT	Count("ABONO_CTA_CTE"."BASE")  
			INTO 		:ll_count_abono  
			FROM 		"ABONO_CTA_CTE"  
			WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
					 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
					 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
					 ( "ABONO_CTA_CTE"."TIPO_COB" = :ls_tipo_cob ) AND  
					 ( "ABONO_CTA_CTE"."FOLIO" = :ll_folio ) AND
					 ( "ABONO_CTA_CTE"."TIPO_COB_OCUPA" = :ls_tipo_cob ) AND  
					 ( "ABONO_CTA_CTE"."FOLIO_OCUPA" = :ll_folio ) AND 
					 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'O' )  
			USING		sqlca;
			if ll_count_abono > 0 then
				DELETE FROM "ABONO_CTA_CTE"  
				WHERE		( "ABONO_CTA_CTE"."TIPO_COB" = :ls_tipo_cob ) AND  
							( "ABONO_CTA_CTE"."FOLIO" = :ll_folio ) AND  
							( "ABONO_CTA_CTE"."TIPO_COB_OCUPA" = :ls_tipo_cob ) AND  
							( "ABONO_CTA_CTE"."FOLIO_OCUPA" = :ll_folio ) AND 
							( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
							( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
							( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
							( "ABONO_CTA_CTE"."ESTADO_REG" = 'O' )   
				USING		sqlca;
				if sqlca.sqlcode = 0 then
					commit;
					ls_pasa			= 'S'
				else
					rollback;
					messagebox("Error Eliminar","Error ELIMINAR ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
				end if
			end if
			SELECT	Count("ABONO_CTA_CTE"."BASE")  
			INTO 		:ll_count_abono  
			FROM 		"ABONO_CTA_CTE"  
			WHERE  ( "ABONO_CTA_CTE"."TIPO_COB_OCUPA" = :ls_tipo_cob ) AND  
					 ( "ABONO_CTA_CTE"."FOLIO_OCUPA" = :ll_folio ) AND  
					 ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
					 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
					 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
					 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'O' )
			USING		sqlca;
			if ll_count_abono > 0 then
				UPDATE	"ABONO_CTA_CTE"  
				SET 		"ESTADO_REG" = 'P',   
							"TIPO_COB_OCUPA" = Null,   
							"FOLIO_OCUPA" = Null,   
							"FECHA_OCUPA" = Null,   
							"MONTO_OCUPA" = Null,   
							"USUARIO_OCUPA" = Null,   
							"CAJA_OCUPA" = Null,   
							"TIPO_MOV_OCUPA" = Null  
				WHERE  ( "ABONO_CTA_CTE"."TIPO_COB_OCUPA" = :ls_tipo_cob ) AND  
						 ( "ABONO_CTA_CTE"."FOLIO_OCUPA" = :ll_folio ) AND  
						 ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
						 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
						 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
						 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'O' )
				USING		sqlca;
				if sqlca.sqlcode=0 then
					commit;
					ls_pasa			= 'S'
				else
					rollback;
					messagebox("Error Eliminar","Error UPDATE ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
				end if
			end if
			if ls_pasa = 'S' then
				ll_tot_reg		= dw_detalle_ci.rowcount()
				for ll_indi=1 to ll_tot_reg
					ls_tipo_cob	= dw_detalle_ci.getitemstring(ll_indi,'tipo_cob')
					ll_cantidad	= dw_detalle_ci.getitemnumber(ll_indi,'cantidad')
					ll_monto		= dw_detalle_ci.getitemnumber(ll_indi,'monto')
					ld_monto_uf	= dw_detalle_ci.getitemnumber(ll_indi,'monto_uf')
					ls_moneda	= dw_detalle_ci.getitemstring(ll_indi,'moneda')
					if ls_tipo_cob='E' and ll_count_e > 0 then
						if (gs_base='O' or gs_base='U' or gs_base='M') and dw_datos_ci.DataObject='d_datos_cuenta_ci_oferta' then
							ll_ctas				= dw_datos_ci.getitemnumber(1,'pago_oferta_nro_cuotas')
							ll_ctas_pagadas	= dw_datos_ci.getitemnumber(1,'oferta_v_cta_pag_s')
						elseif gs_base='P' and dw_datos_ci.DataObject='d_datos_cuenta_ci_pagare' then
							ll_ctas				= dw_datos_ci.getitemnumber(1,'pagare_plazo')
							ll_ctas_pagadas_1	= dw_datos_ci.getitemnumber(1,'pagare_cta_pag_la')
							ll_ctas_pagadas_2	= dw_datos_ci.getitemnumber(1,'pagare_cta_pag_isa')
							ll_ctas_pagadas	= ll_ctas_pagadas_1 + ll_ctas_pagadas_2
						elseif gs_base='L' and dw_datos_ci.DataObject='d_datos_cuenta_ci_liberador' then
							ll_ctas				= dw_datos_ci.getitemnumber(1,'pago_liberador_nro_cuotas')
							ll_ctas_pagadas	= dw_datos_ci.getitemnumber(1,'anexo_liberador_cta_pag_m')
						elseif gs_base='D' and dw_datos_ci.DataObject='d_datos_cuenta_ci_derecho' then
							ll_ctas				= dw_datos_ci.getitemnumber(1,'derecho_plazo')
							ll_ctas_pagadas_1	= dw_datos_ci.getitemnumber(1,'derecho_cta_pag_la')
							ll_ctas_pagadas_2	= dw_datos_ci.getitemnumber(1,'derecho_cta_pag_isa')
							ll_ctas_pagadas	= ll_ctas_pagadas_1 + ll_ctas_pagadas_2
						elseif gs_base='A' and dw_datos_ci.DataObject='d_datos_cuenta_ci_aumento_capacidad' then
							ll_ctas				= dw_datos_ci.getitemnumber(1,'pago_aumento_nro_cuotas')
							ll_ctas_pagadas	= dw_datos_ci.getitemnumber(1,'anexo_aumento_cta_pag_m')
						elseif gs_base='R' and dw_datos_ci.DataObject='dw_repacta_mant_descripcion_traspaso' then
							ll_ctas				= dw_datos_ci.getitemnumber(1,'cuotas_pactadas')
							ll_ctas_pagadas	= dw_datos_ci.getitemnumber(1,'ctas_pagadas')
						end if
						if gs_base<>'C' then
							
							ll_monto_cred					= round(dw_datos_ci.GetItemNumber(1,"c_valor_cuota_pesos"),0)
							ll_monto_mora_cred			= wf_calcular_solo_mora(ll_indi)
							ll_monto_mora_cred			= ll_monto_mora_cred	+ wf_calcular_solo_gc(ll_indi)
							SELECT	SUM("ABONO_CTA_CTE"."MONTO")  
							INTO 		:ll_sum_monto_abono  
							FROM 		"ABONO_CTA_CTE"  
							WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
									 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
									 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero )  AND 
									 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
							USING		sqlca;
							if ll_sum_monto_abono > 0 then
								ll_monto_cta				= ll_monto_cred * dw_detalle_ci.getitemnumber(ll_indi,'cantidad')
								if ll_sum_monto_abono >= (ll_monto_cta + ll_monto_mora_cred) then
									ll_monto_final_cred	= round(ll_sum_monto_abono - ( ll_monto_cta + ll_monto_mora_cred),0)
									ll_monto_final_cred ++
									UPDATE	"ABONO_CTA_CTE"  
									SET 		"TIPO_COB_OCUPA" = :gs_tipo_cobro,   
												"FOLIO_OCUPA" = :ll_folio,   
												"FECHA_OCUPA" = :ldt_fecha_hoy,   
												"MONTO_OCUPA" = (:ll_monto_cta + :ll_monto_mora_cred) - 1,   
												"USUARIO_OCUPA" = :gs_user,   
												"CAJA_OCUPA" = :gs_caja,   
												"ESTADO_REG" = 'O',
												"TIPO_MOV_OCUPA" = :ls_tipo_cob  
									WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
											 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
											 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
											 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
									USING		sqlca;
									if sqlca.sqlcode=0 then
										commit;
										gdt_fec_sistema	= datetime(date(gdt_fec_sistema), RelativeTime(Now(), 5))
										INSERT INTO "ABONO_CTA_CTE"  
													( "RUT",		"BASE",		"SERIE",		"NUMERO",	"TIPO_COB",	"FOLIO",		"MONTO",						"FECHA_CREA",		"USUARIO_CREA",	"CAJA_CREA",	"ESTADO_REG",	"TIPO_COB_OCUPA",	"FOLIO_OCUPA",	"FECHA_OCUPA",	"MONTO_OCUPA",	"USUARIO_OCUPA",	"CAJA_OCUPA",	"TIPO_MOV_OCUPA" )
										VALUES 	( :gi_rut,	:gs_base,	:gs_serie,	:gi_numero,	:gs_tipo_cobro,			:ll_folio,	:ll_monto_final_cred,	:gdt_fec_sistema,	:gs_user,			:gs_caja,		'P',				null,					null,				null,				null,				null,					null,				null )  
										USING		sqlca;
										if sqlca.sqlcode=0 then
											commit;
										else
											rollback;
											messagebox("Error Grabar","Error al INSERTAR ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
										end if
									else
										rollback;
										messagebox("Error Grabar","Error al UPDATE ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
									end if
								else
									UPDATE	"ABONO_CTA_CTE"  
									SET 		"TIPO_COB_OCUPA" = :gs_tipo_cobro,   
												"FOLIO_OCUPA" = :ll_folio,   
												"FECHA_OCUPA" = :ldt_fecha_hoy,   
												"MONTO_OCUPA" = :ll_sum_monto_abono,   
												"USUARIO_OCUPA" = :gs_user,   
												"CAJA_OCUPA" = :gs_caja,   
												"ESTADO_REG" = 'O',
												"TIPO_MOV_OCUPA" = :ls_tipo_cob
									WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
											 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
											 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
											 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
									USING		sqlca;
									if sqlca.sqlcode=0 then
										commit;
									else
										rollback;
										messagebox("Error Grabar","Error al Update ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
									end if
								end if
							else
								ll_monto_final_cred				= ll_monto_cred
							end if
							
						
						end if
						
					elseif ls_tipo_cob='F' and ll_count_f > 0 then
						ll_monto_mant					= round(dw_datos_ci.GetItemNumber(1,"c_valor_cuota_mantencion_pesos"),0)
						ll_monto_cta					= ll_monto_mant * dw_detalle_ci.getitemnumber(ll_indi,'cantidad')
						SELECT	SUM("ABONO_CTA_CTE"."MONTO")  
						INTO 		:ll_sum_monto_abono  
						FROM 		"ABONO_CTA_CTE"  
						WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
								 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
								 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND
								 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )
						USING		sqlca;
						if ll_sum_monto_abono > 0 then
							ll_monto_mant				= ll_monto_mant - dw_detalle_ci.getitemnumber(ll_indi,'cantidad')
							ll_monto_mora_mant		= wf_calcular_solo_mora_mant(ll_indi)
							ll_monto_mora_mant		= ll_monto_mora_mant + wf_calcular_solo_gc_mant(ll_indi)
							if ll_sum_monto_abono >= (ll_monto_cta + ll_monto_mora_mant)  then
								ll_monto_final_mant	= round(ll_sum_monto_abono - ( ll_monto_cta + ll_monto_mora_mant ) ,0)
								ll_monto_final_mant ++
								UPDATE	"ABONO_CTA_CTE"  
								SET 		"TIPO_COB_OCUPA" = :gs_tipo_cobro,   
											"FOLIO_OCUPA" = :ll_folio,   
											"FECHA_OCUPA" = :ldt_fecha_hoy,   
											"MONTO_OCUPA" = (:ll_monto_cta + :ll_monto_mora_mant) - 1,   
											"USUARIO_OCUPA" = :gs_user,   
											"CAJA_OCUPA" = :gs_caja,   
											"ESTADO_REG" = 'O',
											"TIPO_MOV_OCUPA" = :ls_tipo_cob
								WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
										 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
										 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
										 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
								USING		sqlca;
								if sqlca.sqlcode=0 then
									commit;
									gdt_fec_sistema	= datetime(date(gdt_fec_sistema), RelativeTime(Now(), 10))
									INSERT INTO "ABONO_CTA_CTE"  
												( "RUT",		"BASE",		"SERIE",		"NUMERO",	"TIPO_COB",	"FOLIO",		"MONTO",						"FECHA_CREA",		"USUARIO_CREA",	"CAJA_CREA",	"ESTADO_REG",	"TIPO_COB_OCUPA",	"FOLIO_OCUPA",	"FECHA_OCUPA",	"MONTO_OCUPA",	"USUARIO_OCUPA",	"CAJA_OCUPA",	"TIPO_MOV_OCUPA" )
									VALUES 	( :gi_rut,	:gs_base,	:gs_serie,	:gi_numero,	:gs_tipo_cobro,			:ll_folio,	:ll_monto_final_mant,	:gdt_fec_sistema,	:gs_user,			:gs_caja,		'P',				null,					null,				null,				null,				null,					null,				null )  
									USING		sqlca;
									if sqlca.sqlcode=0 then
										commit;
									else
										rollback;
										messagebox("Error Grabar","Error al INSERTAR ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
									end if
								else
									rollback;
									messagebox("Error Grabar","Error al UPDATE ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
								end if
							else
								UPDATE	"ABONO_CTA_CTE"  
								SET 		"TIPO_COB_OCUPA" = :gs_tipo_cobro,   
											"FOLIO_OCUPA" = :ll_folio,   
											"FECHA_OCUPA" = :ldt_fecha_hoy,   
											"MONTO_OCUPA" = :ll_sum_monto_abono,   
											"USUARIO_OCUPA" = :gs_user,   
											"CAJA_OCUPA" = :gs_caja,   
											"ESTADO_REG" = 'O',
											"TIPO_MOV_OCUPA" = :ls_tipo_cob
								WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
										 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
										 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
										 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
								USING		sqlca;
								if sqlca.sqlcode=0 then
									commit;
								else
									rollback;
									messagebox("Error Grabar","Error al Update ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
								end if
							end if
						end if
					end if
				next
			end if
		end if
	end if
else
	Setnull(ll_nulo);Setnull(ls_nulo)
	SELECT	"FICHA_SEPULTACION"."IP"
	INTO 		:ls_tcp_ip  
	FROM 		"FICHA_SEPULTACION"  
	WHERE  ( "FICHA_SEPULTACION"."BASE" = :gs_base ) AND  
			 ( "FICHA_SEPULTACION"."SERIE" = :gs_serie ) AND  
			 ( "FICHA_SEPULTACION"."NUMERO" = :gi_numero ) AND 
			 ( "FICHA_SEPULTACION"."IP" is not Null )   
	USING		sqlca;
	if not isnull(ls_tcp_ip) and ls_tcp_ip<>'' then
		UPDATE	"FICHA_SEPULTACION"  
		SET 		"FOLIO_COMPROBANTE" = :ll_nulo,
					"IP" = :ls_nulo
		WHERE 	"FICHA_SEPULTACION"."IP" = :ls_tcp_ip   
		USING		sqlca;
		if sqlca.sqlcode=0 then
			commit;
		else
			rollback;
		end if
	else
		SELECT	"FICHA_TRASLADO"."IP"
		INTO 		:ls_tcp_ip
		FROM 		"FICHA_TRASLADO"  
		WHERE  ( "FICHA_TRASLADO"."BASE_ORIGEN" = :gs_base ) AND  
				 ( "FICHA_TRASLADO"."SERIE_ORIGEN" = :gs_serie ) AND  
				 ( "FICHA_TRASLADO"."NUMERO_ORIGEN" = :gi_numero ) AND  
				 ( "FICHA_TRASLADO"."IP" is not null )   
		USING		sqlca;
		if not isnull(ls_tcp_ip) and ls_tcp_ip<>'' then
			UPDATE	"FICHA_TRASLADO"  
			SET 		"BOLETA_NRO_ORIGEN" = :ll_nulo,   
						"IP" = :ls_nulo  
			WHERE  ( "FICHA_TRASLADO"."IP" = :ls_tcp_ip ) AND  
					 ( "FICHA_TRASLADO"."BASE_ORIGEN" = :gs_base ) AND  
					 ( "FICHA_TRASLADO"."SERIE_ORIGEN" = :gs_serie ) AND  
					 ( "FICHA_TRASLADO"."NUMERO_ORIGEN" = :gi_numero )   
			USING		sqlca;
			if sqlca.sqlcode=0 then
				commit;
			else
				rollback;
			end if
		else
			SELECT	"FICHA_TRASLADO"."IP"
			INTO 		:ls_tcp_ip
			FROM 		"FICHA_TRASLADO"  
			WHERE  ( "FICHA_TRASLADO"."BASE_DESTINO" = :gs_base ) AND  
					 ( "FICHA_TRASLADO"."SERIE_DESTINO" = :gs_serie ) AND  
					 ( "FICHA_TRASLADO"."NUMERO_DESTINO" = :gi_numero ) AND  
					 ( "FICHA_TRASLADO"."IP" is not null )   
			USING		sqlca;
			if not isnull(ls_tcp_ip) and ls_tcp_ip<>'' then
				UPDATE	"FICHA_TRASLADO"  
				SET 		"BOLETA_NRO_DESTINO" = :ll_nulo,   
							"IP" = :ls_nulo  
				WHERE  ( "FICHA_TRASLADO"."IP" = :ls_tcp_ip ) AND  
						 ( "FICHA_TRASLADO"."BASE_DESTINO" = :gs_base ) AND  
						 ( "FICHA_TRASLADO"."SERIE_DESTINO" = :gs_serie ) AND  
						 ( "FICHA_TRASLADO"."NUMERO_DESTINO" = :gi_numero )   
				USING		sqlca;
				if sqlca.sqlcode=0 then
					commit;
				else
					rollback;
				end if
			end if
		end if
	end if
	cb_ci_borrar_item.Enabled	= FALSE
	dw_gastos_ci.SetItem(1,"gastos_cob", 0)
	dw_gastos_ci.SetItem(1,"mora", 0)
	dw_gastos_ci.SetItem(1,"subtotal", 0)
	
	dw_gastos_ci.SetItem(1,"mora_cred", 0)
	dw_gastos_ci.SetItem(1,"mora_mant", 0)
	dw_gastos_ci.SetItem(1,"gasto_cred", 0)
	dw_gastos_ci.SetItem(1,"gasto_mant", 0)
	il_int_mora			= 0
	il_int_gc				= 0
	il_suma_dia			= 0
	il_int_mora_cred	= 0
	il_int_mora_mant	= 0
	il_int_gc_cred		= 0
	il_int_gc_mant		= 0
END IF
dw_gastos_ci.SetItem(1, "Subtotal",dw_detalle_ci.GetItemNumber(1,"c_subtotal"))
dw_gastos_ci.accepttext()
ll_monto								= dw_gastos_ci.getitemnumber(1,'c_total')
if ll_monto > 0 then 
	ls_string							= "tipo_cob_otro = '144' or tipo_cob_otro = '76' "
	ll_fila								= dw_detalle_ci.Find(ls_string,  1, ll_tot_reg)
	if ll_fila > 0 then
		ls_tipo_cob	= dw_detalle_ci.getitemstring(fila,'tipo_cob')
		dw_detalle_ci.DeleteRow(ll_fila)
		wf_calcular_interes(ls_tipo_cob)
		dw_detalle_ci.accepttext()
	end if
	cbx_paga_ef.checked			= false
end if

// vhfb -- inicio -- borramos los descuentos ingresados en caso que se elimine la fila de cuota
wf_borra_descuentos (ls_tipo_cob)
// vhfb -- false -- borramos los descuentos ingresados en caso que se elimine la fila de cuota



end event

type cb_ci_insertar from picturebutton within tp_ci
event ue_mousemove pbm_mousemove
integer x = 1463
integer y = 856
integer width = 201
integer height = 164
integer taborder = 40
integer textsize = -9
integer weight = 400
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
boolean enabled = false
string picturename = "Insertar_on.bmp"
string disabledname = "Insertar_off.bmp"
alignment htextalign = left!
end type

event ue_mousemove;tab_ingreso.tp_ci.st_14.visible					= false
tab_ingreso.tp_ci.st_help_insertar.visible		= true
tab_ingreso.tp_ci.st_help_eliminar.visible	= false
tab_ingreso.tp_ci.st_help_descuento.visible	= false
tab_ingreso.tp_ci.st_help_ficha.visible		= false
if is_opcion='FP' and (gs_depto='T' or gs_depto='I') then st_fuera_plazo.visible = true
end event

event clicked;long 		fila,ii_dmora, ii_mora_cobro,ll_tot_reg,ll_indi,ll_cantidad,ll_monto,ll_sw_pasa,ii_inc_gastos,ll_count_reg,ll_fila,ll_count_otro,ll_res,ll_sum_reg,ll_new_reg,ll_total_monto,ll_cod_servicio,&
			ll_plazo,ll_ctas_pag
double 	id_im, id_gc, id_valor_cuota,ld_monto_uf,id_interes_gc,ll_valor_serv,ll_valor_dscto_comer
String		ls_tipo_cob,ls_moneda,ls_tipo_cob_otro,ls_string,ls_codigo_otro_cur,ls_tipo_mov,ls_moneda_ctto,ls_cod_dscto_comer,ls_tipo_l,ls_tipo_s,ls_tipo_cob_serv,ls_uso

if long(sle_numero_ci.text) > 0 then
	ll_sw_pasa		= 0
	ii_inc_gastos 	= 1
	if rb_ci_peso.checked=true then rb_ci_uf.checked=true
	ll_tot_reg		= dw_detalle_ci.rowcount()
	for ll_indi=1 to ll_tot_reg
		ls_tipo_cob	= dw_detalle_ci.getitemstring(ll_indi,'tipo_cob')
		ll_cantidad	= dw_detalle_ci.getitemnumber(ll_indi,'cantidad')
		ll_monto		= dw_detalle_ci.getitemnumber(ll_indi,'monto')
		ld_monto_uf	= dw_detalle_ci.getitemnumber(ll_indi,'monto_uf')
		ls_moneda	= dw_detalle_ci.getitemstring(ll_indi,'moneda')
//		if ls_tipo_cob_otro = "" then ls_tipo_cob_otro = '0'
//		if ls_tipo_cob = 'S' and ls_tipo_cob_otro <> '0' then
//			wf_validar_descuento()
//		end if	
		if ls_tipo_cob='' or isnull(ls_tipo_cob) then
			messagebox("Advertencia","No es posible Insertar nuevo Item, en Fila Nº  "+string(ll_indi)+"  Tipo Cobro Inválido")
			dw_detalle_ci.setfocus()
			dw_detalle_ci.scrolltorow(ll_indi)
			dw_detalle_ci.setcolumn('tipo_cob')
			ll_indi		= ll_tot_reg
			ll_sw_pasa	= 1
		elseif ll_cantidad<=0 or isnull(ll_cantidad) then
			messagebox("Advertencia","No es posible Insertar nuevo Item, en Fila Nº  "+string(ll_indi)+"  Cantidad Inválido")
			dw_detalle_ci.setfocus()
			dw_detalle_ci.scrolltorow(ll_indi)
			dw_detalle_ci.setcolumn('cantidad')
			ll_indi		= ll_tot_reg
			ll_sw_pasa	= 1
		elseif (ll_monto<=0 or isnull(ll_monto)) and (ld_monto_uf<=0 or isnull(ld_monto_uf)) then
			messagebox("Advertencia","No es posible Insertar nuevo Item, en Fila Nº  "+string(ll_indi)+"  Monto Inválido")
			dw_detalle_ci.setfocus()
			dw_detalle_ci.scrolltorow(ll_indi)
			if ls_moneda='P' then
				dw_detalle_ci.setcolumn('monto')
			else
				dw_detalle_ci.setcolumn('monto_uf')
			end if
			ll_indi		= ll_tot_reg
			ll_sw_pasa	= 1
		end if
	next
	if ll_sw_pasa=0 then
		il_modif							= 0
		cbx_sin_mora_ci.enabled	= true
		cbx_sin_gastos_ci.enabled	= true
		cbx_paga_ef.enabled			= true
		setnull(il_cantidad_malo)
		gl_n_cuotas_pag 			= 0
		if gs_base='F' then
			idw_detalle.retrieve('CI')		//CI
			idw_detalle15.retrieve('CI')
			idw_detalle12.retrieve('CI')
			idw_detalle2.retrieve('CI')
			
//			idw_detalle.retrieve('FA')
////			idw_detalle12.retrieve('FA')
//			idw_detalle15.retrieve('CI')
		elseif gs_base='G' or gs_base='V' then
			idw_detalle.retrieve('CI')		//CI
			idw_detalle15.retrieve('CI')
			idw_detalle12.retrieve('CI')
			idw_detalle2.retrieve('CI')
//			idw_detalle.retrieve('FA')
////			idw_detalle12.retrieve('BA')
//			idw_detalle15.retrieve('CI')
		else
			idw_detalle.retrieve(gs_tipo_cobro)
			idw_detalle15.retrieve(gs_tipo_cobro)
		end if
		fila 							= dw_detalle_ci.InsertRow(0)
		dw_detalle_ci.scrolltorow(fila)
		dw_detalle_ci.SetItem(fila, "uf", gd_uf)
		dw_detalle_ci.SetItem(fila, "folio", 0)
		dw_detalle_ci.SetItem(fila, "estado", 'N')
		dw_detalle_ci.SetItem(fila, 'base',gs_base)
		dw_detalle_ci.SetItem(fila, 'serie',gs_serie)
		dw_detalle_ci.SetItem(fila, 'numero',gi_numero)
		if rb_ci_uf.checked=true then
			dw_detalle_ci.SetItem(fila, "moneda",'U')
		else
			dw_detalle_ci.SetItem(fila, "moneda",'P')
		end if
		IF fila = 1 THEN
			IF gs_rezago <> "S" THEN	
				dw_gastos_ci.InsertRow(0)
				cb_ingresar_pago_ci.Enabled	= TRUE
				cb_ci_borrar_item.Enabled 		= true
				pb_ficha.Enabled 					= true
				cbx_paga_ef.enabled				= true
				wf_calcular_interes(ls_tipo_cob)
			ELSE
				id_valor_cuota 			= 0
				ii_dmora 				= 0
				id_gc 						= 0
				id_im 						= 0
				ii_mora_cobro 			= 1
				ii_inc_gastos 			= 1
				dw_gastos_ci.InsertRow(0)
				cb_ingresar_pago_ci.Enabled	= TRUE
				cb_ci_borrar_item.Enabled 		= true
				pb_ficha.Enabled 					= false
				cbx_paga_ef.enabled				= true
			END IF
		END IF
		if gs_base='F' or gs_base='G' or gs_base='V' then
			ls_moneda_ctto						= w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.getitemstring(1,'producto_pago_moneda')
//			if gs_base='F' then
//				ls_string								= "tipo_cob_otro = '85' or tipo_cob_otro = '86' or tipo_cob_otro = '87' or tipo_cob_otro = '88' or tipo_cob_otro = '89' or tipo_cob_otro = '90' or tipo_cob_otro = '91' or tipo_cob_otro = '92'  or tipo_cob_otro = '93' or tipo_cob_otro = '94' or tipo_cob_otro = '95' or tipo_cob_otro = '96' or tipo_cob_otro = '97' or tipo_cob_otro = '98' or tipo_cob_otro = '99' or tipo_cob_otro = '300' or tipo_cob_otro = '301' or tipo_cob_otro = '302' or tipo_cob_otro = '303' or tipo_cob_otro = '304' or tipo_cob_otro = '305' or tipo_cob_otro = '306' or tipo_cob_otro = '307' or tipo_cob_otro = '308' or tipo_cob_otro = '309' or tipo_cob_otro = '309' or tipo_cob_otro = '310' or tipo_cob_otro = '311' or tipo_cob_otro = '312' or tipo_cob_otro = '313' or tipo_cob_otro = '314' or tipo_cob_otro = '315' or tipo_cob_otro = '316' or tipo_cob_otro = '317' or tipo_cob_otro = '318' or tipo_cob_otro = '319' or tipo_cob_otro = '320' or tipo_cob_otro = '321' or tipo_cob_otro = '322' or tipo_cob_otro = '323' or tipo_cob_otro = '324' or tipo_cob_otro = '325' or tipo_cob_otro = '326' or tipo_cob_otro = '327'"
//			elseif gs_base='G' then
//				ls_string								= "tipo_cob_otro = '300' or tipo_cob_otro = '301' or tipo_cob_otro = '302' or tipo_cob_otro = '303' or tipo_cob_otro = '304' or tipo_cob_otro = '305' or tipo_cob_otro = '306' or tipo_cob_otro = '307' or tipo_cob_otro = '308' or tipo_cob_otro = '309' or tipo_cob_otro = '309' or tipo_cob_otro = '310' or tipo_cob_otro = '311' or tipo_cob_otro = '312' or tipo_cob_otro = '313' or tipo_cob_otro = '314' or tipo_cob_otro = '315' or tipo_cob_otro = '316' or tipo_cob_otro = '317' or tipo_cob_otro = '318' or tipo_cob_otro = '319' or tipo_cob_otro = '320' or tipo_cob_otro = '321' or tipo_cob_otro = '322' or tipo_cob_otro = '323' or tipo_cob_otro = '324' or tipo_cob_otro = '325' or tipo_cob_otro = '326' or tipo_cob_otro = '327'"
//			end if
			ls_string									= "cod_servicio > 0"
			ll_fila										= dw_detalle_ci.Find(ls_string, 1, dw_detalle_ci.RowCount())
			if ll_fila = 0 then
				SELECT 	COUNT("VISTA_CONTRATO_FUNERARIA"."CODIGO_OTRO")
				INTO		:ll_count_reg
				FROM 	"VISTA_CONTRATO_FUNERARIA"  
				WHERE 	( "VISTA_CONTRATO_FUNERARIA"."BASE" = :gs_base ) AND  
							( "VISTA_CONTRATO_FUNERARIA"."SERIE" = :gs_serie ) AND  
							( "VISTA_CONTRATO_FUNERARIA"."NUMERO" = :gi_numero ) ;
				if ll_count_reg > 0 then
					SELECT 	Count("INGRESO"."TIPO_COB")
					INTO 		:ll_count_otro  
					FROM 	"INGRESO"  
					WHERE 	("INGRESO"."BASE" = :gs_base AND  "INGRESO"."SERIE" = :gs_serie AND  "INGRESO"."CONTRATO" = :gi_numero AND  "INGRESO"."PAGO_HIST" = 'A' AND "INGRESO"."CODIGO_SERVICIO" > 0) ;
					ll_count_otro = 0		 //Eliminar para produccion
					if ll_count_otro = 0 then
						if gs_rezago=' ' and dw_datos_ci.rowcount() > 0 then
							ll_plazo			= dw_datos_ci.getitemnumber(1,'producto_pago_plazo')
							ll_ctas_pag		= dw_datos_ci.getitemnumber(1,'producto_anexo_cuotas_pag')
							ls_uso			= dw_datos_ci.getitemstring(1,'producto_anexo_uso')
						else
							ll_plazo			= 0
							ll_ctas_pag		= 0
						end if
						if gs_base='F' then
							if ll_plazo > 1 then
								if gs_aplica_a = '' and gd_descuento = 0 then			// vhfb
								if ls_uso = 'NF' then
									messagebox("Advertencia","Recuerde que debe Generar Boleta Afecta para Funeraria NF")
									ll_res		= 2
								else
									ll_res		= messagebox("Advertencia","Recuerde que debe Generar Boleta Afecta para Funeraria NF, desea Asignar Detalle Pago - Servicio Funerario",Exclamation!,YesNo!)
								end if
							else
									ll_res 		=2 
								end if 				
							else
								if gs_aplica_a = '' and gd_descuento = 0 then			// vhfb
								ll_res			= messagebox("Advertencia","Desea Asignar Detalle Pago - Servicio Funerario",Exclamation!,YesNo!)
								else 
									ll_res =2 
								end if 									
							end if
						elseif gs_base='G' then
								if gs_aplica_a = '' and gd_descuento = 0 then			// vhfb
									ll_res				= messagebox("Advertencia","Desea Asignar Detalle Pago - Servicio Crematorio",Exclamation!,YesNo!)
								else 
									ll_res =2 
								end if							
						elseif gs_base='V' then
								if gs_aplica_a = '' and gd_descuento = 0 then			// vhfb
									ll_res				= messagebox("Advertencia","Desea Asignar Detalle Pago - Contrato de Servicio",Exclamation!,YesNo!)
								else 
									ll_res =2 
								end if									
						end if
						if ll_res=1 and ll_plazo > 0 and ll_ctas_pag >= 0 and ll_ctas_pag < ll_plazo then
							ll_sum_reg		= 1
							DECLARE cur_detalle_f CURSOR FOR  
							SELECT 	'E' as TIPO_COB_L,"VISTA_CONTRATO_FUNERARIA"."CODIGO_OTRO",  	"VISTA_CONTRATO_FUNERARIA"."VALOR_PRODUCTO",	'S' as TIPO_COB_S,"VISTA_CONTRATO_FUNERARIA"."CODIGO_DESCTO_COMER" ,	"VISTA_CONTRATO_FUNERARIA"."DESCTO_COMER" ,	"VISTA_CONTRATO_FUNERARIA"."TIPO_COB",		"VISTA_CONTRATO_FUNERARIA"."COD_SERVICIO"
							FROM 	"VISTA_CONTRATO_FUNERARIA"  
							WHERE 	( "VISTA_CONTRATO_FUNERARIA"."BASE" = :gs_base ) AND  
										( "VISTA_CONTRATO_FUNERARIA"."SERIE" = :gs_serie ) AND  
										( "VISTA_CONTRATO_FUNERARIA"."NUMERO" = :gi_numero ) 
							ORDER BY TIPO_COB_L ASC,
										"VISTA_CONTRATO_FUNERARIA"."VALOR_PRODUCTO" DESC,
										"VISTA_CONTRATO_FUNERARIA"."CODIGO_OTRO" ASC
							USING	sqlca;
							open cur_detalle_f;
							ll_fila				= w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.getrow()
							w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.scrolltorow(ll_fila)
							if sqlca.sqlcode = 0 then
								DO WHILE sqlca.sqlcode = 0
									fetch cur_detalle_f into :ls_tipo_l, :ls_codigo_otro_cur, :ll_valor_serv, :ls_tipo_s,  :ls_cod_dscto_comer, :ll_valor_dscto_comer, :ls_tipo_cob_serv, :ll_cod_servicio ;
									if not isnull(ls_codigo_otro_cur) then
										if ls_moneda_ctto = '2' then
											ll_valor_serv						= dw_datos_ci.getitemnumber(1,'producto_pago_valor_cuota')
										elseif ls_moneda_ctto = '1' then
											ll_valor_serv						= dw_datos_ci.getitemnumber(1,'c_valor_cuota_pesos')
										end if
									
										w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.setitem(ll_fila,'tipo_cob',ls_tipo_l)	//ls_tipo_mov)
										w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.setitem(ll_fila,'cantidad',1)
										w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.accepttext()
										w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.setitem(ll_fila,'tipo_cob_otro',ls_codigo_otro_cur)
										w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.setitem(ll_fila,'cod_servicio',ll_cod_servicio)
										w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.accepttext()
										if ls_moneda_ctto = '2' then
											w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.setitem(ll_fila,'moneda','U')
											w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.setitem(ll_fila,'monto_uf',ll_valor_serv)
											w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.setitem(ll_fila,'monto', round( ll_valor_serv * gd_uf,0))
										elseif ls_moneda_ctto = '1' then
											w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.setitem(ll_fila,'moneda','P')
											w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.setitem(ll_fila,'monto',ll_valor_serv)
											w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.setitem(ll_fila,'monto_uf', round( ll_valor_serv / gd_uf,4))
										end if
										w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.accepttext()
										if ll_plazo > 1 and (gs_base='F' or gs_base='G') then ll_valor_dscto_comer=0
										if ll_valor_dscto_comer > 0 then
											ll_fila 							= dw_detalle_ci.InsertRow(0)
											dw_detalle_ci.scrolltorow(ll_fila)
											dw_detalle_ci.SetItem(ll_fila, "uf", gd_uf)
											dw_detalle_ci.SetItem(ll_fila, "folio", 0)
											dw_detalle_ci.SetItem(ll_fila, "estado", 'N')
											dw_detalle_ci.SetItem(ll_fila, 'base',gs_base)
											dw_detalle_ci.SetItem(ll_fila, 'serie',gs_serie)
											dw_detalle_ci.SetItem(ll_fila, 'numero',gi_numero)
											if rb_ci_uf.checked=true then
												dw_detalle_ci.SetItem(ll_fila, "moneda",'U')
											else
												dw_detalle_ci.SetItem(ll_fila, "moneda",'P')
											end if
											w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.setitem(ll_fila,'tipo_cob','S')
											w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.setitem(ll_fila,'cantidad',1)
											w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.accepttext()
											w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.setitem(ll_fila,'tipo_cob_otro',ls_cod_dscto_comer)
											w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.accepttext()
											if ls_moneda_ctto = '2' then
												w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.setitem(ll_fila,'moneda','U')
												w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.setitem(ll_fila,'monto_uf',ll_valor_dscto_comer )	//* -1)
												w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.setitem(ll_fila,'monto', round( ll_valor_dscto_comer * gd_uf,0))	// * -1)
											elseif ls_moneda_ctto = '1' then
												w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.setitem(ll_fila,'moneda','P')
												w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.setitem(ll_fila,'monto',ll_valor_dscto_comer )	//* -1)
												w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.setitem(ll_fila,'monto_uf', round( ll_valor_dscto_comer / gd_uf,4) )	//* -1)
											end if
										end if
										
										ll_sum_reg ++
										if ll_sum_reg <= ll_count_reg and not isnull(ls_codigo_otro_cur) then
											ll_fila			= w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.insertrow(0)
//											ll_fila			= ll_new_reg
											idw_detalle.retrieve(gs_tipo_cobro)
											idw_detalle15.retrieve('CI')
											w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.scrolltorow(ll_fila)
//											ll_fila			= w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.getrow()
											w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.SetItem(ll_fila,'uf', gd_uf)
											w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.SetItem(ll_fila,'folio', 0)
											w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.SetItem(ll_fila,'estado', 'N')
											w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.SetItem(ll_fila,'base',gs_base)
											w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.SetItem(ll_fila,'serie',gs_serie)
											w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.SetItem(ll_fila,'numero',gi_numero)
											w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.setitem(ll_fila,'cantidad',1)
											if ls_moneda_ctto = '2' then
												w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.SetItem(ll_fila, "moneda",'U')
											elseif ls_moneda_ctto = '1' then
												w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.SetItem(ll_fila, "moneda",'P')
											end if
											w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.accepttext()
											w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.scrolltorow(ll_fila)
										end if
									end if
									Setnull(ls_codigo_otro_cur)
								LOOP
							end if
							close cur_detalle_f;
							wf_cargar_seguros_ci()
							w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.SetItem(1,'mora', ROUND(w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.Getitemnumber(1,'mora_cred') + w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.Getitemnumber(1,'mora_mant'),0))
							w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.SetItem(1,'gastos_cob',ROUND(w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.Getitemnumber(1,'gasto_cred') + w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.Getitemnumber(1,'gasto_mant'),0))
							ll_total_monto					= ROUND(w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.GetItemNumber(1,"c_subtotal_total"),0)
							w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.SetItem(1,"Subtotal", ll_total_monto)
							w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.accepttext()
						end if
					end if
				else
					
				end if
			end if
		end if
		dw_gastos_ci.setfocus()
//		dw_detalle_ci.setcolumn('tipo_cob')
	end if
end if
end event

