end event

event clicked;Long		ll_sw_factura,ll_sw_fila,ll_tot_reg,ll_indi,ll_numero,ll_folio_ci,ll_ok_boleta,ll_max_folio_new,ld_monto,ll_cuotas_pag,ll_cod_parque,ll_ctas_pag_s_sap,ll_estado_sap,ll_estado_pago_sap,&
			ll_ctas_pag_ctto,ll_n_cheque,ll_cod_banco,ll_monto,ll_num_cheques,ll_cod_tarjeta_credito,ll_nro_cuotas_credito,ll_tipo_tarjeta_credito,ll_cod_tarjeta_debito,ll_cod_banco_debito,&
			ll_tipo_pago_tarjeta_credito,ll_hora_pago,ll_minuto_pago,ll_pago_cred,ll_total,ll_sum_ef,ll_sum_ch, ll_count_ch,ll_sum_tc,ll_count_tc, ll_sum_td,ll_neto,ll_iva,ll_exento
String		ls_base,ls_serie,ls_doc,ls_cuota,ls_cuota_mant,ls_paga_con,ls_tipo_cob_ci,ls_tipo_mov,ls_rezago,ls_codigo_otro,ls_traspaso,ls_rezago_sap,ls_moneda_sap,ls_pago_hist,ls_cod_age,&
			ls_pago_externo,ls_lugar_externo,ls_viene_de,ls_traspaso_e,ls_convenio_banco,ls_proximo_pago,ls_caja_ci,ls_cod_pago,ls_cod_caja,ls_estado_ch,ls_glosa_ch,ls_cod_autorizacion_credito,&
			ls_cod_autorizacion_debito,ls_traspado_pago,ls_tarjeta_empresa,ls_tipo_cob_aux,ls_cod_autoriza_credito,ls_cod_autoriza_debito,ls_fecha_pago_palabra,ls_monto_total_palabra,&
			ls_nro_contrato,ls_vuelto,ls_pago_ef,ls_pago_ch,ls_pago_tc,ls_pago_td
Date		ldt_fecha_pago_ci, ld_hoy,ldt_fecha_serv
Double	ld_uf,ldb_monto_sap,ldb_monto_uf
Datetime	ldt_fecha_venc,ldt_fecha_ant,ldt_fcha_ant,ldt_servipag,ldt_fecha_traspaso_rezago,ldt_fecha_deposito,ldt_fecha_estado_ch

ld_hoy								= date(gdt_fec_sistema)
ll_tot_reg							= dw_por_facturar.rowcount()
if ll_tot_reg > 0 then
	ll_sw_fila							= dw_por_facturar.Find ( "sw_factura = 0", 1, ll_tot_reg ) 
	if ll_sw_fila = 0 then
		messagebox("Advertencia","Debe Seleccionar CI para generar Factura Funeraria")
	else
		gs_tipo_cobro				= 'FA'
		for ll_indi=ll_sw_fila to ll_tot_reg
			ll_sw_factura			= dw_por_facturar.getitemnumber(ll_indi,'sw_factura')
			if ll_sw_factura=0 then
				gs_base				= dw_por_facturar.getitemstring(ll_indi,'producto_ingreso_base')
				gs_serie				= dw_por_facturar.getitemstring(ll_indi,'producto_ingreso_serie')
				gi_numero			= dw_por_facturar.getitemnumber(ll_indi,'producto_ingreso_numero')
				gi_rut					= dw_por_facturar.getitemnumber(ll_indi,'revision_contratos_rut')
				ls_doc				= gs_base+gs_serie+string(gi_numero)
				ll_folio_ci				= dw_por_facturar.getitemnumber(ll_indi,'producto_ingreso_folio')
				ldt_fecha_pago_ci	= date(dw_por_facturar.getitemdatetime(ll_indi,'producto_ingreso_fecha_pago'))
				ls_tipo_cob_ci		= dw_por_facturar.getitemstring(ll_indi,'producto_ingreso_tipo_cob')
				ls_caja_ci			= dw_por_facturar.getitemstring(ll_indi,'producto_ingreso_caja')
				
				SELECT 	  SUM("INGRESO"."MONTO"  )
				INTO 		  :ll_total  
				FROM 	  "INGRESO"  
				WHERE 	( "INGRESO"."FOLIO" = :ll_folio_ci ) AND  
							( "INGRESO"."TIPO_COB" = :ls_tipo_cob_ci ) AND  
							( "INGRESO"."FECHA_PAGO" = :ldt_fecha_pago_ci ) AND  
							( "INGRESO"."COD_CAJA" = :ls_caja_ci ) AND  
							( "INGRESO"."RUT" = :gi_rut )   ;

				ls_cuota				= ''
				ls_cuota_mant		= ''
				ls_paga_con			= ''
				
				select id_cuponeras_web.nextval into :ll_max_folio_new from dual;

//				SELECT 	MAX("CUPONERAS_DETALLE_WEB"."NRO_CUPON"  )
//				INTO 		:ll_max_folio_new
//				FROM 	"CUPONERAS_DETALLE_WEB"  
//				USING	sqlca;
//
//				if isnull(ll_max_folio_new) or ll_max_folio_new=0 then ll_max_folio_new=0
//				ll_max_folio_new ++
				
				INSERT INTO 	  "CUPONERAS_DETALLE_WEB"  
									( "BASE",		"SERIE",   		"NUMERO",   "NRO_CUPON",   		"RUT",   	"NRO_CUOTA",   	"FECHA_VENC",   	"ESTADO_PAGO_CUPON",   	"TIPO_MOV",   	"TIPO_COB_PAGO",   	"FOLIO_PAGO",   	"FECHA_PAGO",   	"MONTO_CUOTA_CONTRATO",   	"MONTO_CUOTA_PESO",   	"MONTO_INTERES_MORA",   	"MONTO_GASTO_COBRANZA",   	"NRO_CUPONERA",   	"DV",   	"BASE_ASOC",   	"SERIE_ASOC",   	"NUMERO_ASOC",   	"TIPO_MONEDA",   	"CODIGO_DSCTO_FUNERARIA",   	"PIE_PACTADO",   	"USUARIO_CREA",   	"USUARIO_MODIFICA",   	"FECHA_MODIFICA",   	"COD_CAJA" )  	
				VALUES 			( :gs_base,   :gs_serie,   	:gi_numero,  :ll_max_folio_new,   :gi_rut,   1,   					:ld_hoy,   			'C',   								'E',   				'FA',   					:ll_folio_ci,   		:ld_hoy,   			null,   									null,   							null,   								null,   									1,   						null,		null,   				null,   				null,   					null,   					null,   									null,   				:gs_user,   				null,   							null,   						:gs_caja )  ;
				
				
				DECLARE c_ingreso CURSOR FOR  
				SELECT 	"INGRESO"."TIPO_MOV",   	"INGRESO"."MONTO",   	"INGRESO"."CUOTAS_PAG",   	"INGRESO"."REZAGO",   	"INGRESO"."VALOR_UF",   	"INGRESO"."PAGO_HIST",  		"INGRESO"."LUGAR_EXTERNO",   	"INGRESO"."SERVIPAG",   	"INGRESO"."CODIGO_OTRO",   	"INGRESO"."TRASPASO_E",   	"INGRESO"."COD_PARQUE",   	"INGRESO"."ESTADO_SAP",   	"INGRESO"."ESTADO_PAGO_SAP",   	"INGRESO"."CTAS_PAG_CTTO",   	"INGRESO"."MONEDA_SAP",   	"INGRESO"."MONTO_UF",   	"INGRESO"."REZAGO_SAP",   	"INGRESO"."FECHA_DEPOSITO",   	"INGRESO"."CONVENIO_BANCO"  
				FROM 	"INGRESO"  
				WHERE ( "INGRESO"."TIPO_COB" = :ls_tipo_cob_ci ) AND  
						  ( "INGRESO"."FOLIO" = :ll_folio_ci ) AND  
						  ( "INGRESO"."FECHA_PAGO" = :ldt_fecha_pago_ci ) AND  
						  ( "INGRESO"."BASE" = :gs_base ) AND  
						  ( "INGRESO"."SERIE" = :gs_serie ) AND  
						  ( "INGRESO"."CONTRATO" = :gi_numero ) AND
						  ( "INGRESO"."RUT" = :gi_rut ) AND
						  ( "INGRESO"."COD_CAJA" = :ls_caja_ci )
				USING	Trans_1 ;
				open c_ingreso;
				if Trans_1.sqlcode=0 then
					DO WHILE Trans_1.sqlcode=0
					fetch c_ingreso into :ls_tipo_mov,  :ld_monto,  :ll_cuotas_pag, :ls_rezago, 	:ld_uf,  :ls_pago_hist, :ls_lugar_externo, :ldt_servipag, :ls_codigo_otro, :ls_traspaso_e, :ll_cod_parque, :ll_estado_sap, :ll_estado_pago_sap, :ll_ctas_pag_ctto, :ls_moneda_sap, :ldb_monto_uf, :ls_rezago_sap, :ldt_fecha_deposito, :ls_convenio_banco;
						if not isnull(ls_tipo_mov)  then
							if ls_tipo_mov='F' or ls_tipo_mov='E' then
								ls_proximo_pago				= f_retorna_prox_pago_mant( gs_base, gs_serie, gi_numero, ll_cuotas_pag,ls_tipo_mov )
							end if
							INSERT INTO	"INGRESO_NEWSING"  
										 (	"FOLIO", 					"TIPO_COB"   , 		"FECHA_PAGO", 	"TIPO_MOV",	"MONTO" , 	"CUOTAS_PAG", 		"SERIE"  , 				"CONTRATO", 	"COD_CAJA", 		"REZAGO",   	"VALOR_UF", 	"PAGO_HIST", 		"BASE"  , 			"RUT"  , 			"USUARIO", "PAGO_EXTERNO", 	"LUGAR_EXTERNO", 	"VIENE_DE" , 	"CODIGO_OTRO",	"SERVIPAG",		"TRASPASO_E",	"COD_PARQUE",	"FECHA_DEPOSITO",	"REZAGO_SAP",	"CTAS_PAG_CTTO",	"MONTO_UF",		"MONEDA_SAP")  
							VALUES  	 (	:ll_max_folio_new,	:gs_tipo_cobro, 	:ld_hoy,	 			:ls_tipo_mov ,	:ld_monto, 	:ll_cuotas_pag, 		:gs_serie, 				:gi_numero, 	:gs_caja, 			:ls_rezago,  	:ld_uf,   			'A',					:gs_base , 			:gi_rut, 			:gs_user, 	' ', 						'interno',  				' ',		 			 :ls_codigo_otro,	:ld_hoy,				:ls_traspaso,		:ll_cod_parque,		:ld_hoy,					:ls_rezago,			:ll_ctas_pag_s_sap,	:ldb_monto_sap,	:ls_moneda_sap)
							USING		sqlca	;
							if sqlca.sqlcode=0 then
								commit;
							else
								rollback;
							end if
						end if
						Setnull(ls_tipo_mov)
					loop
				end if
				close c_ingreso;
				
				DECLARE   c_documentos CURSOR FOR  
				SELECT 	  "DOCUMENTOS"."N_CHEQUE",   "DOCUMENTOS"."COD_BANCO",   "DOCUMENTOS"."MONTO",   "DOCUMENTOS"."FECHA_VENC",   "DOCUMENTOS"."COD_PAGO",   "DOCUMENTOS"."NUM_CHEQUES",    "DOCUMENTOS"."COD_CAJA",   	"DOCUMENTOS"."ESTADO_CH",   "DOCUMENTOS"."COD_TARJETA_CREDITO",   "DOCUMENTOS"."NRO_CUOTAS_CREDITO",   "DOCUMENTOS"."COD_AUTORIZACION_CREDITO",   "DOCUMENTOS"."TIPO_TARJETA_CREDITO",   "DOCUMENTOS"."COD_TARJETA_DEBITO",   "DOCUMENTOS"."COD_AUTORIZACION_DEBITO",   "DOCUMENTOS"."COD_BANCO_DEBITO",   "DOCUMENTOS"."TIPO_PAGO_TARJETA_CREDITO",   "DOCUMENTOS"."HORA_PAGO",   "DOCUMENTOS"."MINUTO_PAGO",   "DOCUMENTOS"."TIPO_COB_AUX",   "DOCUMENTOS"."ESTADO_PAGO_SAP",   "DOCUMENTOS"."MONTO_UF",   "DOCUMENTOS"."FECHA_DEPOSITO",   "DOCUMENTOS"."CONVENIO_BANCO"  				FROM "DOCUMENTOS"  
				WHERE 	( "DOCUMENTOS"."FOLIO" = :ll_folio_ci ) AND  
							( "DOCUMENTOS"."TIPO_COB" = :ls_tipo_cob_ci ) AND  
							( "DOCUMENTOS"."FECHA_PAGO" = :ldt_fecha_pago_ci ) AND  
							( "DOCUMENTOS"."COD_CAJA" = :ls_caja_ci )   
				USING	Trans_1;
				open c_documentos;
				if Trans_1.sqlcode=0 then
					do while Trans_1.sqlcode=0
						fetch c_documentos into :ll_n_cheque, :ll_cod_banco, :ll_monto, :ldt_fecha_venc, :ls_cod_pago, :ll_num_cheques, :ls_cod_caja, :ls_estado_ch, :ll_cod_tarjeta_credito, :ll_nro_cuotas_credito, :ls_cod_autorizacion_credito, :ll_tipo_tarjeta_credito, :ll_cod_tarjeta_debito, :ls_cod_autorizacion_debito, :ll_cod_banco_debito, :ll_tipo_pago_tarjeta_credito, :ll_hora_pago, :ll_minuto_pago, :ls_tipo_cob_aux, :ll_estado_pago_sap, :ldb_monto_uf, :ldt_fecha_deposito,  :ls_convenio_banco;
						if not isnull(ls_cod_pago)  then
							INSERT INTO	"DOCUMENTOS_NEWSING"  
										 ( "FOLIO"  , 			"TIPO_COB"    , 	"N_CHEQUE" , 	"COD_BANCO", 	"MONTO"  ,	"FECHA_VENC", 	"COD_PAGO", 	"NUM_CHEQUES", 	"REZAGO" , 	"FECHA_PAGO", 	"COD_CAJA",	"COD_TARJETA_CREDITO",		"NRO_CUOTAS_CREDITO",	"COD_AUTORIZACION_CREDITO",	"TIPO_TARJETA_CREDITO",		"COD_TARJETA_DEBITO",	"COD_AUTORIZACION_DEBITO",	"COD_BANCO_DEBITO", 	"TIPO_PAGO_TARJETA_CREDITO",	"HORA_PAGO",		"MINUTO_PAGO",	"TIPO_COB_AUX",	"ESTADO_CH",		"FECHA_DEPOSITO",	"MONTO_UF"		)  
							VALUES 	 ( :ll_max_folio_new, 	:gs_tipo_cobro,		:ll_n_cheque, 	:ll_cod_banco , 	:ll_monto, 	:ldt_fecha_venc, 	:ls_cod_pago, 	:ll_num_cheques , :ls_rezago, :ld_hoy     , 			:gs_caja,			:ll_cod_tarjeta_credito,			:ll_nro_cuotas_credito,		:ls_cod_autoriza_credito,			:ll_tipo_tarjeta_credito,			:ll_cod_tarjeta_debito,		:ls_cod_autoriza_debito,				:ll_cod_banco_debito,		:ll_pago_cred,								:ll_hora_pago,		:ll_minuto_pago,	:ls_tipo_cob_aux,	:ls_estado_ch,		:ldt_fecha_deposito,	:ldb_monto_uf)
							USING		sqlca ;
							if sqlca.sqlcode=0 then
								commit;
							else
								rollback;
							end if
						end if
						Setnull(ls_cod_pago)
					loop

				end if
				close c_documentos;
				
				ls_fecha_pago_palabra			= f_retorna_fecha_palabra(date(ld_hoy))
				ls_monto_total_palabra			= sle_1.uo_convertir_numero(string(ll_total))
				ls_nro_contrato						= gs_base+gs_serie+string(gi_numero)
				ls_paga_con							= string(ll_total)
				ls_vuelto								= '0'
				ll_sum_ef							= ll_total
				
				if isnull(ll_sum_ef) 	then ll_sum_ef=0
				if isnull(ll_sum_ch) 	then ll_sum_ch=0
				if isnull(ll_count_ch) 	then ll_count_ch=0
				if isnull(ll_sum_tc) 	then ll_sum_tc=0
				if isnull(ll_count_tc) 	then ll_count_tc=0
				if isnull(ll_sum_td) 	then ll_sum_td=0
				if ll_sum_ef > 0 then
					ls_pago_ef						= string(ll_sum_ef,'###,###,###,###,##0')
				end if
				if ll_sum_ch > 0 then
					ls_pago_ch						= string(ll_sum_ch,'###,###,###,###,##0')+' # ('+string(ll_count_ch,'###,##0')+')'
				end if
				if ll_sum_tc > 0 then
					ls_pago_tc						= string(ll_sum_tc,'###,###,###,###,##0')+' # ('+string(ll_count_tc,'###,##0')+')'
				end if
				if ll_sum_td > 0 then
					ls_pago_td						= string(ll_sum_td,'###,###,###,###,##0')
				end if
				if gs_tipo_cobro='BA' or gs_tipo_cobro='FA' then
//					ll_total							= long(st_total.text)
					ll_neto							= round(ll_total / idb_iva,0)
					ll_iva								= round(ll_total - ll_neto,0)
					ll_total							= ll_neto + ll_iva
				else
//					ll_total							= long(st_total.text)
					ll_exento							= ll_total
				end if
				if ll_cod_parque=0 or isnull(ll_cod_parque) then
					if gs_conexion = 'Parque El Prado' then 
						ll_cod_parque				= 1
					else
						ll_cod_parque				= 11
					end if
				end if	
				if isnull(ls_fecha_pago_palabra) then ls_fecha_pago_palabra = '-'
				//VALIDAR BIEN
				if ls_rezago='S' then	
					ls_nro_contrato 				= gs_base+gs_serie+string(gi_numero)+' (R)'
				end if
				if isnull(ls_nro_contrato) then ls_nro_contrato	= '-'
				if isnull(ls_paga_con) then ls_paga_con = '-'
				if isnull(ls_vuelto) then ls_vuelto = ''
				
				if isnull(ls_monto_total_palabra) then ls_monto_total_palabra = ''
				if isnull(ls_pago_ef) then ls_pago_ef = ''
				if isnull(ls_pago_ch) then ls_pago_ch = ''
				if isnull(ls_pago_tc) then ls_pago_tc = ''
				if isnull(ls_pago_td) then ls_pago_td = ''
				if isnull(ll_neto) then ll_neto = 0
				if isnull(ll_exento) then ll_exento = 0
				if isnull(ll_iva) then ll_iva = 0
				if isnull(ll_total) then ll_total = 0

				INSERT INTO "INGRESO_NEWSING_CABECERA"  
							( "TIPO_COB",		"FOLIO",					"FECHA_PAGO",	"FECHA_PAGO_PALABRA",	"COD_PARQUE", 	"NRO_CONTRATO", 	"UF_DIA", 	"COD_CAJA", 	"USUARIO", 		"PAGA_CON",	"VUELTO",	"PROXIMO_PAGO",   "MONTO_TOTAL_PALABRA",		"PAGO_EF", 	"PAGO_CH", 	"PAGO_TC", 	"PAGO_TD",		"RUT_CLIENTE",	"REZAGO",		"NETO",		"EXENTO",		"IVA",		"TOTAL",		"IP_PC",		"IP_PRINT",			"CONEXION",	"COD_PARQUE_CTTO") 
				VALUES 	( :gs_tipo_cobro, 	:ll_max_folio_new, 	:ld_hoy,				:ls_fecha_pago_palabra, 	99, 					:ls_nro_contrato, 		:gd_uf,		:gs_caja, 		:gs_user, 		:ls_paga_con,	:ls_vuelto,	:ls_proximo_pago, 	:ls_monto_total_palabra, 		:ls_pago_ef,	:ls_pago_ch,	:ls_pago_tc,		:ls_pago_td,		:gi_rut,				:ls_rezago,		:ll_neto,		:ll_exento,		:ll_iva,	:ll_total,		:gs_tcp_ip,	:gs_tcp_ip_print,	:gs_empresa,	:ll_cod_parque)  
				USING		sqlca;
				if sqlca.sqlcode = 0 then
					commit;
				else
					Rollback;
				end if
				
				DECLARE sp_proc_be PROCEDURE FOR  F_XML_DTEBOX_ADEXUS(:gs_tipo_cobro, :ll_max_folio_new, :ld_hoy, :gs_caja, :gi_rut, 'S', :gs_base, :gs_serie, :gi_numero,'1.0');
				EXECUTE sp_proc_be;
				FETCH sp_proc_be into :ll_ok_boleta ;
				if ll_ok_boleta = 0 then
					messagebox("Advertencia","No es posible Generar Factura Funeraria a "+ls_tipo_cob_ci+' Folio '+string(ll_folio_ci))
				else
					messagebox("Grabar","Grabación Exitosa Factura Funeraria N° "+string(ll_ok_boleta))
					INSERT INTO "PRODUCTO_INGRESO"  
								( "BASE", 	"SERIE", 		"NUMERO", 		"TIPO_COB", 		"FOLIO", 			"FECHA_PAGO", 	"PAGO_HIST",	"MONTO",	"CAJA",		"USUARIO" )  
					VALUES 	( :gs_base,	:gs_serie,   	:gi_numero,   	:gs_tipo_cobro,   	:ll_ok_boleta,   	:ld_hoy,   			'A',				:ll_total,		:gs_caja,		:gs_user)  
					USING	sqlca;
					if sqlca.sqlcode=0 then
						commit;
						UPDATE 	"INGRESO"  
						SET 		"FOLIO" = :ll_ok_boleta,   
									"TIPO_COB" = :gs_tipo_cobro,   
									"NRO_CUPON" = :ll_folio_ci,   
									"TIPO_COB_ORIGINAL" = :ls_tipo_cob_ci,   
									"FECHA_PAGO" = :ld_hoy,   
									"COD_CAJA" = :gs_caja  
						WHERE 	( "INGRESO"."TIPO_COB" = :ls_tipo_cob_ci ) AND  
									( "INGRESO"."FOLIO" = :ll_folio_ci ) AND  
									( "INGRESO"."FECHA_PAGO" = :ldt_fecha_pago_ci ) AND  
									( "INGRESO"."COD_CAJA" = :ls_caja_ci ) AND  
									( "INGRESO"."BASE" = :gs_base ) AND  
									( "INGRESO"."SERIE" = :gs_serie ) AND  
									( "INGRESO"."CONTRATO" = :gi_numero )  
						USING	sqlca;
						if sqlca.sqlcode=0 then
							commit;
						else
							rollback;
						end if
						
						UPDATE 	"DOCUMENTOS"  
						SET 		"FOLIO" = :ll_ok_boleta,   
									"TIPO_COB" = :gs_tipo_cobro,   
									"NRO_CUPON" = :ll_folio_ci,   
									"TIPO_COB_ORIGINAL" = :ls_tipo_cob_ci,   
									"FECHA_PAGO" = :ld_hoy,   
									"COD_CAJA" = :gs_caja  
						WHERE 	( "DOCUMENTOS"."TIPO_COB" = :ls_tipo_cob_ci ) AND  
									( "DOCUMENTOS"."FOLIO" = :ll_folio_ci ) AND  
									( "DOCUMENTOS"."FECHA_PAGO" = :ldt_fecha_pago_ci ) AND  
									( "DOCUMENTOS"."COD_CAJA" = :ls_caja_ci ) 
						USING	sqlca;
						if sqlca.sqlcode=0 then
							commit;
						else
							rollback;
						end if

					else
						rollback;
						messagebox("Error Grabar","Error al Insertar en Tabla PRODUCTO_INGRESO "+sqlca.sqlerrtext)
					end if
				end if
			end if
		next
		
		dw_por_facturar.retrieve(date(em_fec_fin.text))
	end if
end if
end event

type st_17 from statictext within tp_porfacturar
event ue_mousemove pbm_mousemove
integer x = 41
integer y = 32
integer width = 1637
integer height = 72
integer textsize = -11
integer weight = 400
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
long textcolor = 33554432
long backcolor = 67108864
string text = "Listado Comprobantes Funeraria a Facturar"
boolean focusrectangle = false
end type

event ue_mousemove;if is_opcion='FP' and (gs_depto='T' or gs_depto='I') then st_fuera_plazo.visible = true
end event

type dw_por_facturar from datawindow within tp_porfacturar
event ue_mousemove pbm_mousemove
integer x = 41
integer y = 128
integer width = 3561
integer height = 1244
integer taborder = 30
string title = "none"
string dataobject = "dw_generar_fa_funeraria_con_ci"
boolean hscrollbar = true
boolean vscrollbar = true
boolean hsplitscroll = true
borderstyle borderstyle = stylelowered!
end type

event ue_mousemove;if is_opcion='FP' and (gs_depto='T' or gs_depto='I') then st_fuera_plazo.visible = true
end event

event clicked;String		ls_columna,ls_formula
Long		ll_cod_servicio,ll_count_serv

ls_columna					= dwo.name
if row > 0 then
	il_row_factura			= row
	gs_base					= dw_por_facturar.getitemstring(il_row_factura,'revision_contratos_base')
	gs_serie					= dw_por_facturar.getitemstring(il_row_factura,'revision_contratos_serie')
	gi_numero				= dw_por_facturar.getitemnumber(il_row_factura,'revision_contratos_numero')
	gi_rut						= dw_por_facturar.getitemnumber(il_row_factura,'revision_contratos_rut')
	ll_cod_servicio			= dw_por_facturar.getitemnumber(il_row_factura,'revision_contratos_codigo_servicio')
	if gs_base='F' and ll_cod_servicio >= 670 and ll_cod_servicio <= 674 then
		SELECT 	Count("PRODUCTO_GESTION_SERVICIO"."BASE")
		INTO 		:ll_count_serv  
		FROM 	"PRODUCTO_GESTION_SERVICIO"  
		WHERE 	( "PRODUCTO_GESTION_SERVICIO"."BASE" = :gs_base ) AND  
					( "PRODUCTO_GESTION_SERVICIO"."SERIE" = :gs_serie ) AND  
					( "PRODUCTO_GESTION_SERVICIO"."NUMERO" = :gi_numero )   ;
		if ll_count_serv > 0 then
			cb_cta_mortuoria.visible		= true
		else
			cb_cta_mortuoria.visible		= false
		end if
	else
		cb_cta_mortuoria.visible			= false
	end if
	This.SelectRow(0, false)
	This.SelectRow(il_row_factura, true)
else
	if ls_columna='t_pendiente' then
		ls_formula			= "revision_contratos_sw_activa_servicio = 1"
	elseif ls_columna='t_activa_spago' then
		ls_formula			= "revision_contratos_sw_activa_servicio = 2"
	elseif ls_columna='t_activa_cpago' then
		ls_formula			= "revision_contratos_sw_activa_servicio = 0"
	elseif ls_columna='t_todo'  then
		ls_formula			= ''
	end if
	dw_por_facturar.SETfilter(ls_formula)
	dw_por_facturar.filter()
	dw_por_facturar.sort()	
end if
end event

event rowfocuschanged;Long	ll_cod_servicio,ll_count_serv

if getrow() > 0 then
	il_row_factura		= getrow()
	This.SelectRow(0, false)
	This.SelectRow(il_row_factura, true)
	gs_base					= dw_por_facturar.getitemstring(il_row_factura,'revision_contratos_base')
	gs_serie					= dw_por_facturar.getitemstring(il_row_factura,'revision_contratos_serie')
	gi_numero				= dw_por_facturar.getitemnumber(il_row_factura,'revision_contratos_numero')
	gi_rut						= dw_por_facturar.getitemnumber(il_row_factura,'revision_contratos_rut')
	ll_cod_servicio			= dw_por_facturar.getitemnumber(il_row_factura,'revision_contratos_codigo_servicio')
	if gs_base='F' and ll_cod_servicio >= 670 and ll_cod_servicio <= 674 then
		SELECT 	Count("PRODUCTO_GESTION_SERVICIO"."BASE")
		INTO 		:ll_count_serv  
		FROM 	"PRODUCTO_GESTION_SERVICIO"  
		WHERE 	( "PRODUCTO_GESTION_SERVICIO"."BASE" = :gs_base ) AND  
					( "PRODUCTO_GESTION_SERVICIO"."SERIE" = :gs_serie ) AND  
					( "PRODUCTO_GESTION_SERVICIO"."NUMERO" = :gi_numero )   ;
		if ll_count_serv > 0 then
			cb_cta_mortuoria.visible		= true
		else
			cb_cta_mortuoria.visible		= false
		end if
	else
		cb_cta_mortuoria.visible			= false
	end if
end if
end event

type st_n_caja from dropdownpicturelistbox within w_ingreso2
integer x = 978
integer y = 140
integer width = 1527
integer height = 596
integer taborder = 10
integer textsize = -10
integer weight = 700
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "MS Sans Serif"
long textcolor = 33554432
boolean vscrollbar = true
borderstyle borderstyle = stylelowered!
long picturemaskcolor = 536870912
end type

event selectionchanged;String		ls_caja

ls_caja		= st_n_caja.text
if not isnull(ls_caja) then
	gs_caja	= mid(ls_caja,1,2)
end if
end event

