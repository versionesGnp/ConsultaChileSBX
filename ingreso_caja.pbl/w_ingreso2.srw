type dw_mp_rezago from datawindow within tp_ci
integer x = 27
integer y = 400
integer width = 1243
integer height = 108
integer taborder = 90
string title = "none"
string dataobject = "dwe_sw_multiproducto_rezago"
boolean border = false
boolean livescroll = true
end type

event itemchanged;String		ls_columna
Long		ll_cod_mp,ll_fila

this.accepttext()
ls_columna					= dwo.name
choose case ls_columna
	case 'sw_multiproducto'
		gl_sw_mp			= Long(data)
		if gl_sw_mp <> 0 then setnull(gl_codigo_mp)
		
	case 'codigo_producto_mp'
		gl_sw_mp			= dw_mp_rezago.getitemnumber(1,'sw_multiproducto')
		gl_codigo_mp		= Long(data)
		if gl_sw_mp <> 0 then setnull(gl_codigo_mp)
 
end choose
if gl_sw_mp = 0 and gl_codigo_mp > 0 then
	SELECT 	"MPPRODUCTO"."PORCENTAJEPIE" 
	INTO 		:gdb_porce_pie_mp 
	FROM 	"MPPRODUCTO",  "MPPRODUCTODET"  
	WHERE 	( "MPPRODUCTO"."CODIGOMP" = "MPPRODUCTODET"."CODIGOMP" ) and  
				( "MPPRODUCTO"."CODIGOMP" = :gl_codigo_mp )  ;
else
	setnull(gdb_porce_pie_mp)	
end if
this.accepttext()
end event

type cbx_reingresoci from checkbox within tp_ci
boolean visible = false
integer x = 507
integer y = 1416
integer width = 576
integer height = 84
integer textsize = -8
integer weight = 700
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
long textcolor = 33554432
long backcolor = 67108864
boolean enabled = false
string text = " Re-Ingreso Pago"
boolean automatic = false
end type

event clicked;Long		ll_count_nc

if cbx_reingresoci.checked = true then
	gs_reingreso_ci	= 'S'
	SELECT 	count("INGRESO"."TIPO_COB"  )
	INTO 		:ll_count_nc 
	FROM 	"INGRESO"  
	WHERE 	( "INGRESO"."RUT" = :gi_rut ) AND  
				( "INGRESO"."FECHA_PAGO" >= to_date(:gdt_fec_sistema) - 90 ) AND  
				( "INGRESO"."FECHA_PAGO" <= to_date(:gdt_fec_sistema) ) AND  
				( "INGRESO"."TIPO_COB" = 'NC' )  
	USING	sqlca;
	if ll_count_nc = 0 then
		messagebox("Advertencia","Cliente No Registra Anulación de Comprobante")
		cbx_reingresoci.checked	= false
		gs_reingreso_ci				= 'N'
	end if
else
	gs_reingreso_ci					= 'N'
end if
end event

type cbx_paga_ef from checkbox within tp_ci
integer x = 1911
integer y = 64
integer width = 631
integer height = 92
integer textsize = -9
integer weight = 700
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
long textcolor = 255
long backcolor = 67108864
string text = "Paga con EFECTIVO"
end type

event clicked;string		ls_total,ls_digito,ls_tipo_cob,ls_string
Long		ll_largo,ll_monto,ll_digito,ll_sumar,ll_restar,fila,ll_tot_reg,ll_fila,ll_total_monto

ll_tot_reg			= dw_detalle_ci.rowcount()
if gs_rezago='S' then rb_ci_peso.checked=true
if ll_tot_reg > 0 then
	ll_monto			= dw_gastos_ci.getitemnumber(1,'c_total')
	if ll_monto > 0 then 
		il_modif		= 0
		ls_string		= "tipo_cob_otro = '144' or tipo_cob_otro = '76' "
		ll_fila			= dw_detalle_ci.Find(ls_string,  1, ll_tot_reg)
		if ll_fila > 0 then
			ls_tipo_cob	= dw_detalle_ci.getitemstring(fila,'tipo_cob')
			dw_detalle_ci.DeleteRow(ll_fila)
			wf_calcular_interes(ls_tipo_cob)
			dw_detalle_ci.accepttext()
		else
			ls_total		= string(dw_gastos_ci.getitemnumber(1,'c_total'))
			ll_largo		= len(ls_total)
			ls_digito		= mid(ls_total,ll_largo ,1)
			ll_digito		= long(ls_digito)
			if ll_digito > 5 and ll_digito <= 9 then
				ll_sumar	= 10 - ll_digito
				fila 							= dw_detalle_ci.InsertRow(0)
				dw_detalle_ci.scrolltorow(fila)
				dw_detalle_ci.SetItem(fila, "uf", gd_uf)
				dw_detalle_ci.SetItem(fila, "folio", 0)
				dw_detalle_ci.SetItem(fila, "estado", 'N')
				dw_detalle_ci.SetItem(fila, "uf", gd_uf)
				dw_detalle_ci.SetItem(fila, 'cantidad',1)
				dw_detalle_ci.SetItem(fila, 'base',gs_base)
				dw_detalle_ci.SetItem(fila, 'serie',gs_serie)
				dw_detalle_ci.SetItem(fila, 'numero',gi_numero)
//				if rb_ci_uf.checked=true then
//					dw_detalle_ci.SetItem(fila, "moneda",'U')
//				else
					dw_detalle_ci.SetItem(fila, "moneda",'P')
//				end if
				dw_detalle_ci.SetItem(fila,'tipo_cob','L')
				dw_detalle_ci.SetItem(fila,'tipo_cob_otro','76')
				dw_detalle_ci.SetItem(fila,'monto',ll_sumar)
				wf_calcular_interes('L')
				
			elseif ll_digito > 0 and ll_digito <= 5 then
				ll_restar	= ll_digito
				fila 							= dw_detalle_ci.InsertRow(0)
				dw_detalle_ci.scrolltorow(fila)
				dw_detalle_ci.SetItem(fila, "uf", gd_uf)
				dw_detalle_ci.SetItem(fila, "folio", 0)
				dw_detalle_ci.SetItem(fila, "estado", 'N')
				dw_detalle_ci.SetItem(fila, "uf", gd_uf)
				dw_detalle_ci.SetItem(fila, 'cantidad',1)
				dw_detalle_ci.SetItem(fila, 'base',gs_base)
				dw_detalle_ci.SetItem(fila, 'serie',gs_serie)
				dw_detalle_ci.SetItem(fila, 'numero',gi_numero)
//				if rb_ci_uf.checked=true then
//					dw_detalle_ci.SetItem(fila, "moneda",'U')
//				else
					dw_detalle_ci.SetItem(fila, "moneda",'P')
//				end if
				dw_detalle_ci.SetItem(fila,'tipo_cob','S')
				dw_detalle_ci.SetItem(fila,'tipo_cob_otro','144')
				dw_detalle_ci.SetItem(fila,'monto',ll_restar)
				wf_calcular_interes('S')
			else
				cbx_paga_ef.checked	= false
			end if
//			w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.SetItem(1,'mora', ROUND(w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.Getitemnumber(1,'mora_cred') + w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.Getitemnumber(1,'mora_mant'),0))
//			w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.SetItem(1,'gastos_cob',ROUND(w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.Getitemnumber(1,'gasto_cred') + w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.Getitemnumber(1,'gasto_mant'),0))
//			ll_total_monto					= ROUND(w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.GetItemNumber(1,"c_subtotal_total"),0)
//			w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.SetItem(1,"Subtotal", ll_total_monto)
//			w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.accepttext()
		end if
		dw_detalle_ci.accepttext()
	else
		messagebox("Advertencia","Debe ingresar Item de Pago")
		cbx_paga_ef.checked			= false
	end if
else
	cbx_paga_ef.checked				= false
end if
if isnull(w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.Getitemnumber(1,'mora_cred')) then w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.setitem(1,'mora_cred',0) 
if isnull(w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.Getitemnumber(1,'mora_mant')) then w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.setitem(1,'mora_mant',0)
if isnull(w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.Getitemnumber(1,'gasto_cred')) then w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.setitem(1,'gasto_cred',0) 
if isnull(w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.Getitemnumber(1,'gasto_mant')) then w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.setitem(1,'gasto_mant',0)
w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.SetItem(1,'mora', ROUND(w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.Getitemnumber(1,'mora_cred') + w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.Getitemnumber(1,'mora_mant'),0))
w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.SetItem(1,'gastos_cob',ROUND(w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.Getitemnumber(1,'gasto_cred') + w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.Getitemnumber(1,'gasto_mant'),0))
ll_total_monto					= ROUND(w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.GetItemNumber(1,"c_subtotal_total"),0)
w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.SetItem(1,"Subtotal", ll_total_monto)
w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.accepttext()
end event

