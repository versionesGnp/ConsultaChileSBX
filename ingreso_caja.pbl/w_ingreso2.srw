end type

event ue_mousemove;wf_no_mostrar_help()
if is_opcion='FP' and (gs_depto='T' or gs_depto='I') then st_fuera_plazo.visible = true
end event

event clicked;Long		ll_tot_reg2,ll_indi,ll_folio2,ll_count_reg2,ll_ult_folio,ll_ctas_pagadas_pie,ll_calc_ctas,ll_nulo,ll_count_ci,ll_count_abono,ll_tot_reg2_mp,ll_indi_mp,ll_count,ll_sw_suma
String		ls_cob,ls_tcp_ip,ls_nulo2,ls_base_mpdet,ls_tipo_cob2
Double	ll_cupon_mp
Datetime	ldt_fecha_hoy2,ldt_fecha_prim

//SELECT sysdate  INTO :gdt_fec_sistema  FROM "TASA"  WHERE "TASA"."LOOK" = 1   ;
//st_fecha.text					= string(gdt_fec_sistema,'dd/mm/yyyy')

il_modif							= 0
Setnull(gl_sw_mp)
Setnull(gl_codigo_mp)
Setnull(gdb_porce_pie_mp)
gs_tipo_cobro					= 'CI'
gs_tipo_cobro_aux				= gs_tipo_cobro
gs_reingreso_ci				= 'N'
st_toku.visible					= false
Setnull(ll_nulo);Setnull(ls_nulo2)
ll_folio2							= long(sle_numero_ci.text)
cbx_reingresoCI.checked		= false
cbx_reingresoCI.enabled		= false
if cbx_manual_ci.checked = false then
	if ll_folio2 > 0 then
		wf_limpiar_boleta_electronica(ll_folio2)
	end if
end if

SELECT	 "FICHA_SEPULTACION"."IP"
INTO 		 :ls_tcp_ip  
FROM 	 "FICHA_SEPULTACION"  
WHERE  ( "FICHA_SEPULTACION"."BASE" = :gs_base ) AND  
		   ( "FICHA_SEPULTACION"."SERIE" = :gs_serie ) AND  
		   ( "FICHA_SEPULTACION"."NUMERO" = :gi_numero ) AND 
		   ( "FICHA_SEPULTACION"."IP" is not Null )   
USING		sqlca;
if not isnull(ls_tcp_ip) and ls_tcp_ip<>'' then
	UPDATE	"FICHA_SEPULTACION"  
	SET 		"FOLIO_COMPROBANTE" = :ll_nulo,
				"IP" = :ls_nulo2
	WHERE 	"FICHA_SEPULTACION"."IP" = :ls_tcp_ip   
	USING		sqlca;
	if sqlca.sqlcode=0 then
		commit;
	else
		rollback;
	end if
else
	SELECT	 "FICHA_TRASLADO"."IP"
	INTO 		 :ls_tcp_ip
	FROM 	 "FICHA_TRASLADO"  
	WHERE  ( "FICHA_TRASLADO"."BASE_ORIGEN" = :gs_base ) AND  
			   ( "FICHA_TRASLADO"."SERIE_ORIGEN" = :gs_serie ) AND  
			   ( "FICHA_TRASLADO"."NUMERO_ORIGEN" = :gi_numero ) AND  
			   ( "FICHA_TRASLADO"."IP" is not null )   
	USING		sqlca;
	if not isnull(ls_tcp_ip) and ls_tcp_ip<>'' then
		UPDATE	"FICHA_TRASLADO"  
		SET 		"BOLETA_NRO_ORIGEN" = :ll_nulo,   
					"IP" = :ls_nulo2  
		WHERE  ( "FICHA_TRASLADO"."IP" = :ls_tcp_ip ) AND  
				   ( "FICHA_TRASLADO"."BASE_ORIGEN" = :gs_base ) AND  
				   ( "FICHA_TRASLADO"."SERIE_ORIGEN" = :gs_serie ) AND  
				   ( "FICHA_TRASLADO"."NUMERO_ORIGEN" = :gi_numero )   
		USING		sqlca;
		if sqlca.sqlcode=0 then
			commit;
		else
			rollback;
		end if
	else
		SELECT	 "FICHA_TRASLADO"."IP"
		INTO 		 :ls_tcp_ip
		FROM 	 "FICHA_TRASLADO"  
		WHERE  ( "FICHA_TRASLADO"."BASE_DESTINO" = :gs_base ) AND  
				   ( "FICHA_TRASLADO"."SERIE_DESTINO" = :gs_serie ) AND  
				   ( "FICHA_TRASLADO"."NUMERO_DESTINO" = :gi_numero ) AND  
				   ( "FICHA_TRASLADO"."IP" is not null )   
		USING	sqlca;
		if not isnull(ls_tcp_ip) and ls_tcp_ip<>'' then
			UPDATE	"FICHA_TRASLADO"  
			SET 		"BOLETA_NRO_DESTINO" = :ll_nulo,   
						"IP" = :ls_nulo2  
			WHERE  ( "FICHA_TRASLADO"."IP" = :ls_tcp_ip ) AND  
					   ( "FICHA_TRASLADO"."BASE_DESTINO" = :gs_base ) AND  
					   ( "FICHA_TRASLADO"."SERIE_DESTINO" = :gs_serie ) AND  
					   ( "FICHA_TRASLADO"."NUMERO_DESTINO" = :gi_numero )   
			USING	sqlca;
			if sqlca.sqlcode=0 then
				commit;
			else
				rollback;
			end if
		end if
	end if
end if

il_suma_dia								= 0
ll_tot_reg2								= dw_detalle_ci.rowcount()
if ll_tot_reg2>0 then
	ll_count_reg2 						= dw_detalle_ci.Find("tipo_cob ='A' or tipo_cob ='Q'",1, ll_tot_reg2)
	if ll_count_reg2>0 and gs_grabar_pie='N' then
		setnull(ldt_fecha_prim)
		
		ldt_fecha_hoy2					= datetime(date(gdt_fec_sistema),time('00:00:00'))
		SELECT	Count("DETALLE_PAGO_PIE"."FOLIO")
		INTO 		:ll_count_reg2
		FROM 	"DETALLE_PAGO_PIE"
		WHERE  ( "DETALLE_PAGO_PIE"."BASE" = :gs_base ) AND  
				 ( "DETALLE_PAGO_PIE"."SERIE" = :gs_serie ) AND  
				 ( "DETALLE_PAGO_PIE"."NUMERO" = :gi_numero ) AND  
				 ( "DETALLE_PAGO_PIE"."TIPO_COB" = :gs_tipo_cobro ) AND  
				 ( "DETALLE_PAGO_PIE"."FOLIO" = :ll_folio2 ) AND  
				 ( "DETALLE_PAGO_PIE"."FECHA_PAGO" = :gd_fecha_pago_plazo )   
		USING		sqlca;
		if ll_count_reg2>0 then
			UPDATE	"DETALLE_PAGO_PIE"  
			SET 		"TIPO_COB" = null,   
						"FOLIO" = null,   
						"CAJA" = null,   
						"USUARIO" = null,   
						"FECHA_PAGO" = null,   
						"MONTO_PIE_PAGADO_PESO" = null,
						"ESTADO" = 'P'  
			WHERE  ( "DETALLE_PAGO_PIE"."BASE" = :gs_base ) AND  
					 ( "DETALLE_PAGO_PIE"."SERIE" = :gs_serie ) AND  
					 ( "DETALLE_PAGO_PIE"."NUMERO" = :gi_numero ) AND  
					 ( "DETALLE_PAGO_PIE"."TIPO_COB" = :gs_tipo_cobro ) AND  
					 ( "DETALLE_PAGO_PIE"."FOLIO" = :ll_folio2 ) AND  
					 ( "DETALLE_PAGO_PIE"."FECHA_PAGO" = :gd_fecha_pago_plazo )   
			USING		sqlca;
			if sqlca.sqlcode=0 then
				commit;
				if (gs_base = 'O' or gs_base='U' or gs_base='M') then
					SELECT	"PAGO_OFERTA"."FOLIO",
								"PAGO_OFERTA"."CTAS_PAGADAS_PIE",
								"PAGO_OFERTA"."FECHA_PRIM_PIE"
					INTO 		:ll_ult_folio,
								:ll_ctas_pagadas_pie,
								:ldt_fecha_prim
					FROM 	"CADENA",	"OFERTA_V",	"PAGO_OFERTA"  
					WHERE    ( "OFERTA_V"."SERIE" = "PAGO_OFERTA"."SERIE" ) and  
								 ( "OFERTA_V"."NRO_OFERTA" = "PAGO_OFERTA"."NRO_OFERTA" ) and  
								 ( "OFERTA_V"."ULT_FOLIO" = "PAGO_OFERTA"."FOLIO" ) and  
								 ( "CADENA"."SERIE" = "OFERTA_V"."SERIE" ) and  
								 ( "CADENA"."NUMERO" = "OFERTA_V"."NRO_OFERTA" ) and  
								 (("CADENA"."CODIGO" = :gs_base ) AND  
								 ( "CADENA"."SERIE" = :gs_serie ) AND  
								 ( "CADENA"."NUMERO" = :gi_numero ) )   
					USING		sqlca;
					if sqlca.sqlcode=0 then
						ll_calc_ctas	= ll_ctas_pagadas_pie - ll_count_reg2
						if ll_calc_ctas<=0 then
							ll_calc_ctas	= 0
						end if
						UPDATE	"PAGO_OFERTA"  
						SET		"CTAS_PAGADAS_PIE" = :ll_calc_ctas,   
									"FECHA_PRIM_PIE" = :ldt_fecha_prim  
						WHERE  ( "PAGO_OFERTA"."SERIE" = :gs_serie ) AND  
								 ( "PAGO_OFERTA"."NRO_OFERTA" = :gi_numero ) AND  
								 ( "PAGO_OFERTA"."FOLIO" = :ll_ult_folio )   
						USING		sqlca;
						if sqlca.sqlcode=0 then
							commit;
						else
							rollback;
						end if
					end if
				elseif gs_base = 'A' then
					SELECT	"PAGO_AUMENTO"."FOLIO",
								"PAGO_AUMENTO"."CTAS_PAGADAS_PIE",
								"PAGO_AUMENTO"."FECHA_PRIM_PIE"
					INTO 		:ll_ult_folio,
								:ll_ctas_pagadas_pie,
								:ldt_fecha_prim
					FROM 	"CADENA",	"ANEXO_AUMENTO",	"PAGO_AUMENTO"  
					WHERE    ( "ANEXO_AUMENTO"."SERIE_M" = "PAGO_AUMENTO"."SERIE_M" ) and  
								 ( "ANEXO_AUMENTO"."NRO_AUMENTO" = "PAGO_AUMENTO"."NRO_AUMENTO" ) and  
								 ( "ANEXO_AUMENTO"."ULT_FOLIO" = "PAGO_AUMENTO"."FOLIO" ) and  
								 ( "CADENA"."SERIE" = "ANEXO_AUMENTO"."SERIE_M" ) and  
								 ( "CADENA"."NUMERO" = "ANEXO_AUMENTO"."NRO_AUMENTO" ) and  
								 (("CADENA"."CODIGO" = :gs_base ) AND  
								 ( "CADENA"."SERIE" = :gs_serie ) AND  
								 ( "CADENA"."NUMERO" = :gi_numero ) )   
					USING		sqlca;
					if sqlca.sqlcode=0 then
						ll_calc_ctas	= ll_ctas_pagadas_pie - ll_count_reg2
						if ll_calc_ctas<=0 then
							ll_calc_ctas	= 0
						end if
						UPDATE	"PAGO_AUMENTO"  
						SET		"CTAS_PAGADAS_PIE" = :ll_calc_ctas,   
									"FECHA_PRIM_PIE" = :ldt_fecha_prim  
						WHERE  ( "PAGO_AUMENTO"."SERIE_M" = :gs_serie ) AND  
								 ( "PAGO_AUMENTO"."NRO_AUMENTO" = :gi_numero ) AND  
								 ( "PAGO_AUMENTO"."FOLIO" = :ll_ult_folio )   
						USING		sqlca;
						if sqlca.sqlcode=0 then
							commit;
						else
							rollback;
						end if
					end if
				elseif gs_base='L' then
					SELECT	"PAGO_LIBERADOR"."FOLIO",
								"PAGO_LIBERADOR"."CTAS_PAGADAS_PIE",
								"PAGO_LIBERADOR"."FECHA_PRIM_PIE"
					INTO 		:ll_ult_folio,
								:ll_ctas_pagadas_pie,
								:ldt_fecha_prim
					FROM 	"CADENA",	"ANEXO_LIBERADOR",	"PAGO_LIBERADOR"  
					WHERE    ( "ANEXO_LIBERADOR"."SERIE_M" = "PAGO_LIBERADOR"."SERIE_M" ) and  
								 ( "ANEXO_LIBERADOR"."NRO_LIBERADOR" = "PAGO_LIBERADOR"."NRO_LIBERADOR" ) and  
								 ( "ANEXO_LIBERADOR"."ULT_FOLIO" = "PAGO_LIBERADOR"."FOLIO" ) and  
								 ( "CADENA"."SERIE" = "ANEXO_LIBERADOR"."SERIE_M" ) and  
								 ( "CADENA"."NUMERO" = "ANEXO_LIBERADOR"."NRO_LIBERADOR" ) and  
								 (("CADENA"."CODIGO" = :gs_base ) AND  
								 ( "CADENA"."SERIE" = :gs_serie ) AND  
								 ( "CADENA"."NUMERO" = :gi_numero ) )   
					USING		sqlca;
					if sqlca.sqlcode=0 then
						ll_calc_ctas	= ll_ctas_pagadas_pie - ll_count_reg2
						if ll_calc_ctas<=0 then
							ll_calc_ctas	= 0
						end if
						UPDATE	"PAGO_LIBERADOR"  
						SET		"CTAS_PAGADAS_PIE" = :ll_calc_ctas,   
									"FECHA_PRIM_PIE" = :ldt_fecha_prim  
						WHERE  ( "PAGO_LIBERADOR"."SERIE_M" = :gs_serie ) AND  
								 ( "PAGO_LIBERADOR"."NRO_LIBERADOR" = :gi_numero ) AND  
								 ( "PAGO_LIBERADOR"."FOLIO" = :ll_ult_folio )   
						USING		sqlca;
						if sqlca.sqlcode=0 then
							commit;
						else
							rollback;
						end if
					end if
				end if
			else
				rollback;
			end if
		end if
	end if
end if

ll_tot_reg2			= dw_multiproducto.rowcount()
if ll_tot_reg2 > 0 and gl_sw_mp = 0 and gl_codigo_mp > 0 then		//and gs_rezago='S'
	if gs_base='M' and ll_tot_reg2 > 0 then
		SELECT 	Count("INGRESO"."TIPO_COB"  )
		INTO 		:ll_count  
		FROM 	"INGRESO"  
		WHERE 	( "INGRESO"."FOLIO" = :ll_folio2 ) AND  
					( "INGRESO"."TIPO_COB" = 'CX' ) AND  
					( "INGRESO"."FECHA_PAGO" = :gd_fecha_pago_plazo )   ;
		if isnull(ll_count) then ll_count=0
		if ll_count > 0 then
			ll_sw_suma				= 0
			for ll_indi=1 to ll_tot_reg2
				ll_sw_suma ++
				ll_cupon_mp		= dw_multiproducto.getitemnumber(ll_indi,'mpnro_cupon')
				ls_tipo_cob2			= dw_multiproducto.getitemstring(ll_indi,'tipodoc')
				if ll_sw_suma = 1 then
					UPDATE 	"CUPONERAS_DETALLE_WEB"  
					SET 		"ESTADO_PAGO_CUPON" = 'A'  
					WHERE 	( "CUPONERAS_DETALLE_WEB"."NRO_CUPON" = :ll_cupon_mp ) AND  
//								( "CUPONERAS_DETALLE_WEB"."TIPO_COB_PAGO" = :ls_tipo_cob2 OR "CUPONERAS_DETALLE_WEB"."TIPO_COB_PAGO" = 'CX' ) AND  
								( "CUPONERAS_DETALLE_WEB"."RUT" = :gi_rut ) AND  
								( "CUPONERAS_DETALLE_WEB"."FECHA_VENC" = :ldt_fecha_hoy2 )   
					USING	sqlca;
					if sqlca.sqlcode=0 then
						commit;
						exit;
					else
						rollback;
					end if
				end if

			next
		end if
	end if
	
//	ll_cupon_mp						= dw_multiproducto.getitemnumber(1,'mpnro_cupon')
//	UPDATE 	"CUPONERAS_DETALLE_WEB"  
