//st_fecha.text					= string(gdt_fec_sistema,'dd/mm/yyyy')
tab_ingreso.tp_porfacturar.dw_por_facturar.settransobject(sqlca)
tab_ingreso.tp_porfacturar.dw_por_facturar.reset()
Setnull(gs_base);Setnull(gs_serie);Setnull(gi_numero);Setnull(gi_rut);Setnull(gl_folio);Setnull(gs_tipo_cobro);Setnull(gs_nombre_completo)
Setnull(gd_total)
em_fec_fin.text					= '01/'+string(gdt_fec_sistema,'mm/yyyy')
em_folio_factura.text			= ''
em_folio_factura.enabled	= false
tab_ingreso.tp_porfacturar.dw_por_facturar.retrieve(date(em_fec_fin.text))
end event

