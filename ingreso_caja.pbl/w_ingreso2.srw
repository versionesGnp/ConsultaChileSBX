end type

event clicked;Long		ll_min_boleta,ll_grupo,ll_rut,ll_pos,ll_rut_cont,ll_cod_parque,ll_count_pend,ll_cant_folio_p
String		ls_dv,ls_nombre,ls_ap_pat,ls_ap_mat,ls_base,ls_serie,ls_nom_paso,ls_rut_empresa,ls_pasa='S'
datetime	ldt_fecha_pago
Double	ll_numero,ll_numero_cont
	
ll_numero_cont							= Double(dw_be_buscar_cliente.getitemstring(1,'rn_contrato'))
ll_rut_cont								= long(dw_be_buscar_cliente.getitemstring(1,'rl_rut'))
if gs_rezago='S' then
	if tab_ingreso.tp_be.dw_parque_be.rowcount() = 0 then 
		tab_ingreso.tp_be.dw_parque_be.insertrow(0)
		tab_ingreso.tp_be.dw_parque_be.accepttext()
	end if
	ll_cod_parque						= tab_ingreso.tp_be.dw_parque_be.getitemnumber(1,'cod_parque')
	if isnull(ll_cod_parque) or ll_cod_parque=0 then
		ls_pasa							= 'N'
		messagebox("Advertencia","Debe Seleccionar Parque o Producto")
		tab_ingreso.tp_be.dw_parque_be.setfocus()
	else
		gl_cod_parque					= ll_cod_parque
	end if
end if
if ls_pasa='S' then
	if isnull(ll_numero_cont) then ll_numero_cont=0
	if isnull(ll_rut_cont) then ll_rut_cont=0
	if ll_numero_cont<>0 or ll_rut_cont<>0 then
		if cbx_manual_be.checked=false then
			if long(sle_numero_be.text) >= 0 then
				sle_numero_be.text			= ''
				dw_detalle_be.reset()
				dw_gastos_be.reset()
				sle_numero_be.enabled		= true
				cb_be_insertar.enabled		= true
				cb_be_borrar_item.enabled	= true
				pb_ficha_be.enabled			= true
				Long		ll_plazo
				ll_plazo									= 0
				if w_ingreso2.tab_ingreso.tp_be.dw_datos_be.rowcount() > 0 and dw_datos_be.dataobject='d_datos_cuenta_ci_funeraria' then
					ll_plazo								= w_ingreso2.tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'producto_pago_plazo')
				end if
				if rb_be_afecta.checked=true then
					if gs_base='V' then
						gs_tipo_cobro			= "BA"
					elseif gs_base='F' or gs_base='G' then
						if ll_plazo > 1 then
							gs_tipo_cobro		= "BA"
						else
							gs_tipo_cobro		= "FA"
						end if
					else
						gs_tipo_cobro			= "BA"
					end if
					dw_detalle_be.dataobject	= 'de_detalle_ci_3'
					dw_detalle_be.getchild('tipo_cob',idw_detalle2)
					idw_detalle2.settransobject(sqlca)
					idw_detalle2.retrieve(gs_tipo_cobro)
					dw_detalle_be.getchild('tipo_cob_otro',idw_detalle12)
					idw_detalle12.settransobject(sqlca)
					idw_detalle12.retrieve(gs_tipo_cobro)
					idw_detalle4.retrieve(gs_tipo_cobro)	
					
				elseif rb_be_exenta.checked=true then
					if gs_base='F' or gs_base='G' then
						if gs_serie='F' then
							gs_tipo_cobro		= "FA"
						else
							gs_tipo_cobro		= "FE"
						end if
					else
						gs_tipo_cobro			= "BE"
					end if
					dw_detalle_be.dataobject	= 'de_detalle_ci_4'
					dw_detalle_be.getchild('tipo_cob',idw_detalle)
					idw_detalle.settransobject(sqlca)
					idw_detalle.retrieve(gs_tipo_cobro)
					dw_detalle_be.getchild('tipo_cob_otro',idw_detalle12)
					idw_detalle12.settransobject(sqlca)
					idw_detalle12.retrieve(gs_tipo_cobro)
					idw_detalle4.retrieve(gs_tipo_cobro)	
				end if
				dw_detalle_be.settransobject(sqlca)
				if rb_be_afecta.checked=true then 
					SELECT	"MEMBRETE_EMPRESA"."STRING_RUT"
					INTO 		:ls_rut_empresa
					FROM 	"MEMBRETE_EMPRESA"  
					WHERE 	"MEMBRETE_EMPRESA"."COD_PARQUE" = 99   ;
				else
					SELECT	"MEMBRETE_EMPRESA"."STRING_RUT"
					INTO 		:ls_rut_empresa
					FROM 	"MEMBRETE_EMPRESA"  
					WHERE 	"MEMBRETE_EMPRESA"."COD_PARQUE" = :gl_cod_parque   ;
				end if
				if not isnull(ls_rut_empresa) then
					ldt_fecha_pago				= datetime(date(st_fecha.text),time('00:00:00'))
					if gs_rezago <> 'S' then
						ll_rut						= long(dw_be_buscar_cliente.getitemstring(1,'rl_rut'))
						ls_dv						= dw_be_buscar_cliente.getitemstring(1,'cf_obtener_dv')
						ls_nombre				= dw_be_buscar_cliente.getitemstring(1,'rs_nombre')
						ls_ap_pat				= dw_be_buscar_cliente.getitemstring(1,'rs_a_paterno')
						ls_ap_mat				= dw_be_buscar_cliente.getitemstring(1,'rs_a_materno')
						ls_base					= gs_base
						ls_serie					= gs_serie
						ll_numero				= gi_numero
					else
						ll_rut						= gi_rut
						ls_dv						= gf_obtener_dv(ll_rut)
						ls_nom_paso			= gs_nombre_completo
						ll_pos						= Pos(ls_nom_paso, " ")
						ls_nombre				= trim(mid(ls_nom_paso,1,ll_pos))
						ls_nom_paso			= trim(mid(ls_nom_paso,ll_pos))
						ll_pos						= Pos(ls_nom_paso, " ")
						ls_ap_pat				= trim(mid(ls_nom_paso,1,ll_pos))
						ls_nom_paso			= trim(mid(ls_nom_paso,ll_pos))
						ll_pos						= Pos(ls_nom_paso, " ")
						ls_ap_mat				= trim(mid(ls_nom_paso,1,ll_pos))
						ls_base					= mid(gs_contrato_rezago,1,1)
						ls_serie					= mid(gs_contrato_rezago,2,1)
						ll_numero				= Double(mid(gs_contrato_rezago,3))
					end if
					ls_nombre	= ls_nombre +' '+ls_ap_pat+' '+ls_ap_mat
					if len(ls_nombre) > 40 then
						ls_nombre	= mid(ls_nombre,1,40)
					end if
					SQLCA.Lock = "3" 
					ll_min_boleta				= 0
					gl_folio						= ll_min_boleta
					sle_numero_be.text		= string(ll_min_boleta)
					sle_numero_be.enabled	= false
					sle_numero_be.setfocus()
					sle_numero_be.triggerevent(modified!)
				end if
			end if
		else
			idw_detalle.retrieve('BE')		//CI
		end if
	end if
end if
end event

