event itemchanged;string		is_columna2,ls_tipo_cob2,ls_moneda,ls_tipo_cob2_aux,ls_estado_cadena2,ls_descrip_estado,ls_tipo_comp2,ls_texto2,ls_nulo2,ls_pasa,&
			ls_moneda_ctto
long 		il_monto,fila2,ii_dmora, ii_mora_cobro,ii_inc_gastos2, ii_cantidad2, i,ll_ctas=0,ll_count_reg2,ll_folio2,ll_cod_seguro,ll_ctas_pagadas_1=0,ll_fila2,&
			ll_ctas_pagadas_2=0,ll_ctas_pagadas=0,ll_tot_reg2,ll_indi,ll_count_tipo=0,ll_new_seg,ll_cant_e,ll_fila2_gasto
double 	id_im, id_gc, id_valor_cuota,ld_monto,ld_pie_pactado,ldb_prima,ldb_uf
Datetime	ldt_fecha_hoy2

setnull(ls_nulo2)
if cbx_manual_factura.checked = true then
	ls_tipo_comp2					= 'BL'
else
	if rb_fac_afecta.checked=true then
		ls_tipo_comp2				= 'FA'
	elseif rb_fac_exenta.checked=true then
		ls_tipo_comp2				= 'FE'
	end if
end if
ii_inc_gastos2 						= 1
is_columna2 							= GetColumnName()
this.AcceptText()
ll_tot_reg2							= dw_detalle_bl.rowcount()
ldb_uf									= gd_uf
if ll_tot_reg2 > 0 then
	ll_count_reg2 					= dw_detalle_bl.Find("tipo_cob ='A' or tipo_cob ='Q'",1, ll_tot_reg2)
	if ll_count_reg2=0 or isnull(ll_count_reg2) then
		ll_folio2						= long(sle_numero_bl.text)
		ldt_fecha_hoy2				= datetime(date(gdt_fec_sistema),time('00:00:00'))
		UPDATE	"DETALLE_PAGO_PIE"  
		SET 		"TIPO_COB" = null,   
					"FOLIO" = null,   
					"CAJA" = null,   
					"USUARIO" = null,   
					"FECHA_PAGO" = null,   
					"MONTO_PIE_PAGADO_PESO" = null,
					"ESTADO" = 'P'  
		WHERE  ( "DETALLE_PAGO_PIE"."BASE" = :gs_base ) AND  
				 ( "DETALLE_PAGO_PIE"."SERIE" = :gs_serie ) AND  
				 ( "DETALLE_PAGO_PIE"."NUMERO" = :gi_numero ) AND  
				 ( "DETALLE_PAGO_PIE"."TIPO_COB" = :gs_tipo_cobro ) AND  
				 ( "DETALLE_PAGO_PIE"."FOLIO" = :ll_folio2 ) AND  
				 ( "DETALLE_PAGO_PIE"."FECHA_PAGO" = :gd_fecha_pago_plazo )   
		USING		sqlca;
		if sqlca.sqlcode=0 then
			commit;
		else
			rollback;
		end if
	end if
end if
ls_tipo_cob2															= this.getitemstring(row,'tipo_cob')
if dw_datos_bl.rowcount()>0 then 
	if gs_rezago = "S" then
		tab_ingreso.tp_boletas.rb_ci_uf_bl.visible			= true
		tab_ingreso.tp_boletas.rb_ci_peso_bl.visible		= true
		if rb_ci_uf_bl.checked=true then 
			dw_detalle_bl.SetItem(dw_detalle_bl.getrow(), "moneda",'U')
		elseif rb_ci_peso_bl.checked=true then 
			dw_detalle_bl.SetItem(dw_detalle_bl.getrow(), "moneda",'P')
		end if
	else
		if ls_tipo_cob2<>'M' then
			tab_ingreso.tp_boletas.rb_ci_uf_bl.visible		= false
			tab_ingreso.tp_boletas.rb_ci_peso_bl.visible	= false
			tab_ingreso.tp_boletas.rb_ci_peso_bl.checked	= true
			if rb_ci_uf_bl.checked=true then 
				dw_detalle_bl.SetItem(dw_detalle_bl.getrow(), "moneda",'U')
			elseif rb_ci_peso_bl.checked=true then 
				dw_detalle_bl.SetItem(dw_detalle_bl.getrow(), "moneda",'P')
			end if
		end if
	end if
	if gs_base='B' then
		ls_estado_cadena2 = dw_datos_bl.getitemstring(1,'facturas_cadena_estado')
	else
		ls_estado_cadena2 = dw_datos_bl.getitemstring(1,'cadena_estado')
	end if
	SELECT	"ESTADO"."NOMBRE_ESTADO"  
	INTO 		:ls_descrip_estado  
	FROM 	"ESTADO"  
	WHERE 	"ESTADO"."COD_ESTADO" = :ls_estado_cadena2 ;
end if
if gs_rezago <> "S" then 
	if gs_base='B' then
		ls_estado_cadena2	= dw_datos_bl.getitemstring(1,'facturas_cadena_estado')
	else
		ls_estado_cadena2	= dw_datos_bl.getitemstring(1,'cadena_estado')
	end if
end if
if ls_estado_cadena2='S' then
	ll_tot_reg2						= dw_detalle_bl.rowcount()
	if ll_tot_reg2>1 then
		for ll_indi = 1 to ll_tot_reg2
			ls_tipo_cob2_aux		= dw_detalle_bl.getitemstring(ll_indi,'tipo_cob')
			if ls_tipo_cob2 = ls_tipo_cob2_aux then 
				ll_count_tipo ++
				if ll_count_tipo = 2 then
					messagebox("Advertencia","No puede Ingresar Tipo Cobro "+ls_tipo_cob2+" Duplicado")
					dw_detalle_bl.deleterow(ll_indi)
					fila2 				= dw_detalle_bl.InsertRow(0)
					dw_detalle_bl.scrolltorow(fila2)
					dw_detalle_bl.SetItem(fila2, "uf", gd_uf)
					dw_detalle_bl.SetItem(fila2, "iva", idb_iva)
					dw_detalle_bl.SetItem(fila2, "folio", 0)
					dw_detalle_bl.SetItem(fila2, "estado", 'N')
					dw_detalle_bl.SetItem(fila2, "uf", gd_uf)
					if rb_ci_uf_bl.checked=true then
						dw_detalle_bl.SetItem(fila2, "moneda",'U')
					else
						dw_detalle_bl.SetItem(fila2, "moneda",'P')
					end if
					setnull(ls_tipo_cob2);setnull(is_columna2)
					dw_detalle_bl.scrolltorow(row)
					dw_detalle_bl.setfocus()
					dw_detalle_bl.setcolumn('tipo_cob')
					exit
				end if
			end if
		next
	end if	
	if is_columna2 = "tipo_cob" then
		if ls_tipo_cob2='K' then
			IF gs_rezago <> "S" THEN
				if gs_base= 'O' or gs_base='U' or gs_base='M' then
					SetItem(row, "cantidad", dw_datos_bl.GetItemNumber(1,"pago_oferta_nro_cuotas") - dw_datos_bl.GetItemNumber(1,"oferta_v_cta_pag_s"))
				elseif gs_base= 'L' then
					SetItem(row, "cantidad", dw_datos_bl.GetItemNumber(1,"pago_liberador_nro_cuotas") - dw_datos_bl.GetItemNumber(1,"anexo_liberador_cta_pag_m"))
				elseif gs_base= 'F' or gs_base='G' or gs_base='V' then
					SetItem(row, "cantidad", dw_datos_bl.GetItemNumber(1,"producto_pago_plazo") - dw_datos_bl.GetItemNumber(1,"producto_anexo_cuotas_pag"))
				elseif gs_base= 'P' then
					SetItem(row, "cantidad", dw_datos_bl.GetItemNumber(1,"pagare_plazo") - dw_datos_bl.GetItemNumber(1,"c_cuotas_pagadas"))
				elseif gs_base= 'D' then
					SetItem(row, "cantidad", dw_datos_bl.GetItemNumber(1,"derecho_plazo") - dw_datos_bl.GetItemNumber(1,"c_cuotas_pagadas"))
				elseif gs_base= 'A' then
					SetItem(row, "cantidad", dw_datos_bl.GetItemNumber(1,"pago_aumento_nro_cuotas") - dw_datos_bl.GetItemNumber(1,"anexo_aumento_cta_pag_m"))
				end if
				SetItem(row, "monto", dw_datos_bl.GetItemNumber(1,"c_valor_cuota_pesos"))
				if isnull(w_ingreso2.tab_ingreso.tp_boletas.dw_gastos_bl.getitemnumber(1,'gastos_cob')) then
					w_ingreso2.tab_ingreso.tp_boletas.dw_gastos_bl.SetItem(1,'gastos_cob', 0)
				end if
				if isnull(w_ingreso2.tab_ingreso.tp_boletas.dw_gastos_bl.getitemnumber(1,'mora')) then
					w_ingreso2.tab_ingreso.tp_boletas.dw_gastos_bl.SetItem(1,'mora', 0)
				end if
				if isnull(w_ingreso2.tab_ingreso.tp_boletas.dw_gastos_bl.getitemnumber(1,'incluir_gastos')) then
					w_ingreso2.tab_ingreso.tp_boletas.dw_gastos_bl.SetItem(1,'incluir_gastos', 1)
				end if
				dw_gastos_bl.SetItem(1, "Subtotal",GetItemNumber(1,"c_subtotal"))
				dw_gastos_bl.accepttext()
			else
				messagebox("Advertencia","No es Posible Ingresar Seguro de Desgravamen en Rezago")
			end if
			
		elseif ls_tipo_cob2 = 'E' then	//and gs_base='F' 
			SetItem(row, "cantidad", 1)
			IF gs_rezago <> "S" THEN
				SetItem(row, "monto", dw_datos_bl.GetItemNumber(1,"c_valor_cuota_pesos"))
				wf_calcular_intereses_bl(ls_tipo_cob2)
			ELSE 
				SetItem(row, "monto", 0)
			END IF
			ll_cant_e								= dw_detalle_bl.getitemnumber(dw_detalle_bl.getrow(),'cantidad')
			if rb_ci_uf_bl.checked=true then 
				ls_moneda						= 'U'
			elseif rb_ci_peso_bl.checked=true then 
				ls_moneda						= 'P'
			end if
			DECLARE x1 CURSOR FOR  
			SELECT	"SEGURO_ASOCIADOS"."COD_SEGURO",   
						"SEGURO_ASOCIADOS"."MONTO_PRIMA",
						"SEGURO_ASOCIADOS"."MONEDA"
			FROM 	"SEGURO_ASOCIADOS"  
			WHERE ( "SEGURO_ASOCIADOS"."BASE" = :gs_base ) AND  
					  ( "SEGURO_ASOCIADOS"."SERIE" = :gs_serie ) AND  
					  ( "SEGURO_ASOCIADOS"."NUMERO" = :gi_numero ) AND  
					  ( "SEGURO_ASOCIADOS"."ESTADO_REG" = 0 ) AND  
					  ( "SEGURO_ASOCIADOS"."ESTADO_SEGURO" = 'A' )   AND
					  ( "SEGURO_ASOCIADOS"."MONTO_PRIMA" > 0 )
			USING	sqlca;
			open x1;
			if sqlca.sqlcode=0 then
				do while sqlca.sqlcode=0
					fetch x1 into :ll_cod_seguro, :ldb_prima, :ls_moneda_ctto;
					if not isnull(ll_cod_seguro) and ll_cod_seguro>0  then
						ll_new_seg			= dw_detalle_bl.insertrow(0)
						dw_detalle_bl.setitem(ll_new_seg,'iva', idb_iva)
						dw_detalle_bl.setitem(ll_new_seg,'tipo_cob', string(ll_cod_seguro))
						dw_detalle_bl.setitem(ll_new_seg,'cantidad', ll_cant_e)
						if ls_moneda_ctto = '1' then
							dw_detalle_bl.setitem(ll_new_seg,'monto_uf', round( ldb_prima / ldb_uf,4))
							dw_detalle_bl.setitem(ll_new_seg,'monto', ldb_prima)
						elseif ls_moneda_ctto = '2' then
							dw_detalle_bl.setitem(ll_new_seg,'monto_uf', ldb_prima)
							dw_detalle_bl.setitem(ll_new_seg,'monto', round( ldb_prima * ldb_uf,0))
						end if
						dw_detalle_bl.setitem(ll_new_seg,'uf',gd_uf)
						dw_detalle_bl.setitem(ll_new_seg,'estado','S')
						dw_detalle_bl.SetItem(ll_new_seg, "moneda",ls_moneda)
					end if
					setnull(ll_cod_seguro)
				loop
			end if
			close x1;
			dw_detalle_bl.accepttext()
			
		elseif ls_tipo_cob2='S' or ls_tipo_cob2='L' then
			SetItem(row, "monto", 0)
			SetItem(row, "cantidad", 1)
			ls_texto2					= ls_tipo_cob2+'~t'+ls_tipo_comp2
			openwithparm(w_apertura_tipo_cobro_otros,ls_texto2)
			
		elseif ls_tipo_cob2='F' then
			if gs_rezago <> "S" THEN
				CHOOSE CASE gs_base
					CASE "O","U","M"
						IF dw_datos_bl.getitemnumber(1,'oferta_v_cta_pag_m') > 90 then
							messagebox ("Advertencia ", "Este Contrato tiene anexo Liberador de Mantención ",information!)
							RETURN
						end if
					CASE "C"
						IF dw_datos_bl.getitemnumber(1,'contrato_cta_pag_m') > 90 then
							messagebox ("Advertencia ", "Este Contrato tiene anexo Liberador de Mantención ",information!)
							RETURN
						end if
				END CHOOSE
				if gs_base='O' or gs_base='C' or gs_base='U' or gs_base='M' then
					SetItem(row, "cantidad", 1)
					IF gs_rezago <> "S" THEN
						SetItem(row, "monto", dw_datos_bl.GetItemNumber(1,"c_valor_cuota_mantencion_pesos"))
						wf_calcular_intereses_bl(ls_tipo_cob2)
					ELSE 
						SetItem(row, "monto", 0)
					END IF
				else
					messagebox("Advertencia","No es posible Ingresar F-Cuota Mantención, para este tipo de Contrato (Solo O-Promesas y C-Contrato)")
					SetItem(row, "monto", 0)
					SetItem(row, "cantidad", 0)
					dw_detalle_bl.setfocus()
					dw_detalle_bl.setcolumn('tipo_cob')
				end if
			END IF
			
		elseif ls_tipo_cob2='M' then
			if gs_rezago <> "S" THEN
				ls_estado_cadena2 = dw_datos_bl.getitemstring(1,'cadena_estado')
				if ls_estado_cadena2='V' or ls_estado_cadena2='C' or ls_estado_cadena2='S' then
					if gs_base='O' or gs_base='C' or gs_base='U' or gs_base='M' then
						tab_ingreso.tp_boletas.rb_ci_uf_bl.visible		= true
						tab_ingreso.tp_boletas.rb_ci_peso_bl.visible	= false
						tab_ingreso.tp_boletas.rb_ci_uf_bl.checked		= true
						tab_ingreso.tp_boletas.rb_ci_peso_bl.visible	= false
						if rb_ci_uf_bl.checked=true then 
							dw_detalle_bl.SetItem(dw_detalle_bl.getrow(), "moneda",'U')
						elseif rb_ci_peso_bl.checked=true then 
							dw_detalle_bl.SetItem(dw_detalle_bl.getrow(), "moneda",'P')
						end if
						SetItem(row, "cantidad", 1)
					else
						messagebox("Advertencia","No es Posible Ingresar M-Derecho Sepultura para este Tipo de Contrato")
						SetItem(row, "monto", 0)
						SetItem(row, "cantidad", 0)
						dw_detalle_bl.setfocus()
						dw_detalle_bl.setcolumn('tipo_cob')
					end if
				else
					tab_ingreso.tp_boletas.rb_ci_uf_bl.visible			= false
					tab_ingreso.tp_boletas.rb_ci_peso_bl.visible		= false
					tab_ingreso.tp_boletas.rb_ci_uf_bl.checked			= false
					tab_ingreso.tp_boletas.rb_ci_peso_bl.visible		= true
					messagebox("Advertencia","Recuerde que Contrato debe estar V-Vigente o C-Cancelado")
					SetItem(row, "monto", 0)
					SetItem(row, "cantidad", 0)
					dw_detalle_bl.setfocus()
					dw_detalle_bl.setcolumn('tipo_cob')
				end if
			end if
			
		elseif ls_tipo_cob2<>'S' and ls_tipo_cob2<>'K' and ls_tipo_cob2<>'M' and ls_tipo_cob2<>'L' and ls_tipo_cob2<>'F' then
			messagebox("Advertencia","No es Posible Ingresar este Tipo de Cobro")
			dw_detalle_bl.deleterow(row)
			fila2 							= dw_detalle_bl.InsertRow(0)
			dw_detalle_bl.scrolltorow(fila2)
			dw_detalle_bl.SetItem(fila2, "uf", gd_uf)
			dw_detalle_bl.SetItem(fila2, "iva", idb_iva)
			dw_detalle_bl.SetItem(fila2, "folio", 0)
			dw_detalle_bl.SetItem(fila2, "estado", 'N')
			dw_detalle_bl.SetItem(fila2, "uf", gd_uf)
			if rb_ci_uf_bl.checked=true then
				dw_detalle_bl.SetItem(fila2, "moneda",'U')
			else
				dw_detalle_bl.SetItem(fila2, "moneda",'P')
			end if
			setnull(ls_tipo_cob2);setnull(is_columna2)
			dw_detalle_bl.scrolltorow(row)
			dw_detalle_bl.setfocus()
			dw_detalle_bl.setcolumn('tipo_cob')
		END IF
	end if
	this.accepttext()
	dw_gastos_bl.SetItem(1, "Subtotal",GetItemNumber(1,"c_subtotal"))
	dw_gastos_bl.accepttext()
	fila2 							= row
	IF is_columna2 = "cantidad" AND ls_tipo_cob2 = "E" AND GetItemNumber(row, "cantidad") > 0 AND gs_rezago <> "S"  THEN
		ii_cantidad2 				= GetItemNumber(row, "cantidad")
		if (gs_base='O' or gs_base='U' or gs_base='M') and dw_datos_bl.DataObject='d_datos_cuenta_ci_oferta' then
			ll_ctas				= dw_datos_bl.getitemnumber(1,'pago_oferta_nro_cuotas')
			ll_ctas_pagadas	= dw_datos_bl.getitemnumber(1,'oferta_v_cta_pag_s')
		elseif gs_base='P' and dw_datos_bl.DataObject='d_datos_cuenta_ci_pagare' then
			ll_ctas				= dw_datos_bl.getitemnumber(1,'pagare_plazo')
			ll_ctas_pagadas_1	= dw_datos_bl.getitemnumber(1,'pagare_cta_pag_la')
			ll_ctas_pagadas_2	= dw_datos_bl.getitemnumber(1,'pagare_cta_pag_isa')
			ll_ctas_pagadas	= ll_ctas_pagadas_1 + ll_ctas_pagadas_2
		elseif gs_base='L' and dw_datos_bl.DataObject='d_datos_cuenta_ci_liberador' then
			ll_ctas				= dw_datos_bl.getitemnumber(1,'pago_liberador_nro_cuotas')
			ll_ctas_pagadas	= dw_datos_bl.getitemnumber(1,'anexo_liberador_cta_pag_m')
		elseif (gs_base='F' or gs_base='G' or gs_base='V') and dw_datos_bl.DataObject='d_datos_cuenta_ci_funeraria' then
			ll_ctas				= dw_datos_bl.getitemnumber(1,'producto_pago_plazo')
			ll_ctas_pagadas	= dw_datos_bl.getitemnumber(1,'producto_anexo_cuotas_pag')
		elseif gs_base='D' and dw_datos_bl.DataObject='d_datos_cuenta_ci_derecho' then
			ll_ctas				= dw_datos_bl.getitemnumber(1,'derecho_plazo')
			ll_ctas_pagadas_1	= dw_datos_bl.getitemnumber(1,'derecho_cta_pag_la')
			ll_ctas_pagadas_2	= dw_datos_bl.getitemnumber(1,'derecho_cta_pag_isa')
			ll_ctas_pagadas	= ll_ctas_pagadas_1 + ll_ctas_pagadas_2
		elseif gs_base='A' and dw_datos_bl.DataObject='d_datos_cuenta_ci_aumento_capacidad' then
			ll_ctas				= dw_datos_bl.getitemnumber(1,'pago_aumento_nro_cuotas')
			ll_ctas_pagadas	= dw_datos_bl.getitemnumber(1,'anexo_aumento_cta_pag_m')
		end if
		if (ll_ctas_pagadas + ii_cantidad2) > ll_ctas then
			messagebox("Advertencia","Cantidad de Cuotas sobrepasa al Plazo del Crédito")
//			SetItem(row, "monto", 0)
			SetItem(row, "monto", dw_datos_bl.GetItemNumber(1,"c_valor_cuota_pesos"))
			SetItem(row, "cantidad", 1)
			dw_detalle_bl.accepttext()
			dw_detalle_bl.setfocus()
			dw_detalle_bl.setcolumn('cantidad')
		end if
		wf_calcular_intereses_bl(ls_tipo_cob2)
	END IF

elseif ls_estado_cadena2='V' or ls_estado_cadena2='C' or gs_rezago='S' then
	IF ls_tipo_cob2 = "F" or ls_tipo_cob2='E' or ls_tipo_cob2='A' or ls_tipo_cob2='Q' or ls_tipo_cob2='U' or ls_tipo_cob2='S' or ls_tipo_cob2='M' THEN
		ll_tot_reg2						= dw_detalle_bl.rowcount()
		if ll_tot_reg2>1 then
			for ll_indi = 1 to ll_tot_reg2
				ls_tipo_cob2_aux		= dw_detalle_bl.getitemstring(ll_indi,'tipo_cob')
				if ls_tipo_cob2 = ls_tipo_cob2_aux then 
					ll_count_tipo ++
					if ll_count_tipo = 2 then
						messagebox("Advertencia","No puede Ingresar Tipo Cobro "+ls_tipo_cob2+" Duplicado")
						dw_detalle_bl.deleterow(ll_indi)
						fila2 				= dw_detalle_bl.InsertRow(0)
						dw_detalle_bl.scrolltorow(fila2)
						dw_detalle_bl.SetItem(fila2, "uf", gd_uf)
						dw_detalle_bl.SetItem(fila2, "iva", idb_iva)
						dw_detalle_bl.SetItem(fila2, "folio", 0)
						dw_detalle_bl.SetItem(fila2, "estado", 'N')
						dw_detalle_bl.SetItem(fila2, "uf", gd_uf)
						if rb_ci_uf_bl.checked=true then
							dw_detalle_bl.SetItem(fila2, "moneda",'U')
						else
							dw_detalle_bl.SetItem(fila2, "moneda",'P')
						end if
						setnull(ls_tipo_cob2);setnull(is_columna2)
						dw_detalle_bl.scrolltorow(row)
						dw_detalle_bl.setfocus()
						dw_detalle_bl.setcolumn('tipo_cob')
						exit
					end if
				end if
			next
		end if
	end if
	IF is_columna2 = "tipo_cob" THEN
		IF (ls_tipo_cob2 = "E" or ls_tipo_cob2 = "U") and (gs_base='P' or gs_base='R' or gs_base='F' or gs_base='O' or gs_base='M' or gs_base='U' or gs_base='D' or gs_base='A' or gs_base='L' or gs_base='V') THEN //cuota
			IF gs_rezago <> "S" THEN
				if (gs_base='O' or gs_base='U' or gs_base='M') and dw_datos_bl.DataObject='d_datos_cuenta_ci_oferta' then
					ll_ctas				= dw_datos_bl.getitemnumber(1,'pago_oferta_nro_cuotas')
					ll_ctas_pagadas	= dw_datos_bl.getitemnumber(1,'oferta_v_cta_pag_s')
				elseif gs_base='P' and dw_datos_bl.DataObject='d_datos_cuenta_ci_pagare' then
					ll_ctas				= dw_datos_bl.getitemnumber(1,'pagare_plazo')
					ll_ctas_pagadas_1	= dw_datos_bl.getitemnumber(1,'pagare_cta_pag_la')
					ll_ctas_pagadas_2	= dw_datos_bl.getitemnumber(1,'pagare_cta_pag_isa')
					ll_ctas_pagadas	= ll_ctas_pagadas_1 + ll_ctas_pagadas_2
				elseif gs_base='L' and dw_datos_bl.DataObject='d_datos_cuenta_ci_liberador' then
					ll_ctas				= dw_datos_bl.getitemnumber(1,'pago_liberador_nro_cuotas')
					ll_ctas_pagadas	= dw_datos_bl.getitemnumber(1,'anexo_liberador_cta_pag_m')
				elseif (gs_base='F' or gs_base='G' or gs_base='V') and dw_datos_bl.DataObject='d_datos_cuenta_ci_funeraria' then
					ll_ctas				= dw_datos_bl.getitemnumber(1,'producto_pago_plazo')
					ll_ctas_pagadas	= dw_datos_bl.getitemnumber(1,'producto_anexo_cuotas_pag')
				elseif gs_base='D' and dw_datos_bl.DataObject='d_datos_cuenta_ci_derecho' then
					ll_ctas				= dw_datos_bl.getitemnumber(1,'derecho_plazo')
					ll_ctas_pagadas_1	= dw_datos_bl.getitemnumber(1,'derecho_cta_pag_la')
					ll_ctas_pagadas_2	= dw_datos_bl.getitemnumber(1,'derecho_cta_pag_isa')
					ll_ctas_pagadas	= ll_ctas_pagadas_1 + ll_ctas_pagadas_2
				elseif gs_base='A' and dw_datos_bl.DataObject='d_datos_cuenta_ci_aumento_capacidad' then
					ll_ctas				= dw_datos_bl.getitemnumber(1,'pago_aumento_nro_cuotas')
					ll_ctas_pagadas	= dw_datos_bl.getitemnumber(1,'anexo_aumento_cta_pag_m')
				elseif gs_base='R' and dw_datos_bl.DataObject='dw_repacta_mant_descripcion_traspaso' then
					ll_ctas				= dw_datos_bl.getitemnumber(1,'cuotas_pactadas')
					ll_ctas_pagadas	= dw_datos_bl.getitemnumber(1,'ctas_pagadas')
				end if
				
				if gs_base<>'C' then
					if ll_ctas_pagadas>=ll_ctas then
						messagebox("Advertencia","No es Posible Ingresar Cuota, Crédito CANCELADO")
						SetItem(row, "monto", 0)
						SetItem(row, "cantidad", 0)
						dw_detalle_bl.setfocus()
						dw_detalle_bl.setcolumn('tipo_cob')
					else
						SetItem(row, "cantidad", 1)
						SetItem(row, "monto", dw_datos_bl.GetItemNumber(1,"c_valor_cuota_pesos"))
						wf_calcular_intereses_bl(ls_tipo_cob2)
					end if
				elseif gs_base='C' then
					if ll_ctas_pagadas>=ll_ctas then
						messagebox("Advertencia","No es Posible Ingresar Cuota, Crédito CANCELADO")
						SetItem(row, "monto", 0)
						SetItem(row, "cantidad", 0)
						dw_detalle_bl.setfocus()
						dw_detalle_bl.setcolumn('tipo_cob')
					else
						SetItem(row, "cantidad", 1)
						SetItem(row, "monto", dw_datos_bl.GetItemNumber(1,"c_valor_cuota_credito_pesos"))
						wf_calcular_intereses_bl(ls_tipo_cob2)
					end if
				end if
				dw_detalle_bl.accepttext()
				ll_cant_e					= dw_detalle_bl.getitemnumber(dw_detalle_bl.getrow(),'cantidad')
				if rb_ci_uf_bl.checked=true then 
					ls_moneda						= 'U'
				elseif rb_ci_peso_bl.checked=true then 
					ls_moneda						= 'P'
				end if
				DECLARE x2 CURSOR FOR  
				SELECT	"SEGURO_ASOCIADOS"."COD_SEGURO",   
							"SEGURO_ASOCIADOS"."MONTO_PRIMA",
							"SEGURO_ASOCIADOS"."MONEDA"
				FROM 	"SEGURO_ASOCIADOS"  
				WHERE ( "SEGURO_ASOCIADOS"."BASE" = :gs_base ) AND  
						  ( "SEGURO_ASOCIADOS"."SERIE" = :gs_serie ) AND  
						  ( "SEGURO_ASOCIADOS"."NUMERO" = :gi_numero ) AND  
						  ( "SEGURO_ASOCIADOS"."ESTADO_REG" = 0 ) AND  
						  ( "SEGURO_ASOCIADOS"."ESTADO_SEGURO" = 'A' )   AND
						  ( "SEGURO_ASOCIADOS"."MONTO_PRIMA" > 0 )
				USING	sqlca;
				open x2;
				if sqlca.sqlcode=0 then
					do while sqlca.sqlcode=0
						fetch x2 into :ll_cod_seguro, :ldb_prima, :ls_moneda_ctto;
						if not isnull(ll_cod_seguro) and ll_cod_seguro>0  then
							ll_new_seg		= dw_detalle_bl.insertrow(0)
							dw_detalle_bl.setitem(ll_new_seg,'tipo_cob', string(ll_cod_seguro))
							dw_detalle_bl.setitem(ll_new_seg,'iva', idb_iva)
							dw_detalle_bl.setitem(ll_new_seg,'cantidad', ll_cant_e)
							if ls_moneda_ctto = '1' then
								dw_detalle_bl.setitem(ll_new_seg,'monto_uf', round( ldb_prima / ldb_uf,4))
								dw_detalle_bl.setitem(ll_new_seg,'monto', ldb_prima)
							elseif ls_moneda_ctto = '2' then
								dw_detalle_bl.setitem(ll_new_seg,'monto_uf', ldb_prima)
								dw_detalle_bl.setitem(ll_new_seg,'monto', round( ldb_prima * ldb_uf,0))
							end if
							dw_detalle_bl.setitem(ll_new_seg,'uf',gd_uf)
							dw_detalle_bl.setitem(ll_new_seg,'estado','S')
							dw_detalle_bl.SetItem(ll_new_seg, "moneda",ls_moneda)
						end if
						setnull(ll_cod_seguro)
					loop
				end if
				close x2;
				dw_detalle_bl.accepttext()
			else
				SetItem(row, "cantidad", 1)
				SetItem(row, "monto", 0)
			end if
		elseif ls_tipo_cob2 = "F" and (gs_base='C' or gs_base='O' or gs_base='U' or gs_base='M') THEN
			if gs_rezago <> "S" THEN
				CHOOSE CASE gs_base
					CASE "O","U","M"
						IF dw_datos_bl.getitemnumber(1,'oferta_v_cta_pag_m') > 90 then
							messagebox ("Advertencia ", "Este Contrato tiene anexo Liberador de Mantención ",information!)
							RETURN
						end if
					CASE "C"
						IF dw_datos_bl.getitemnumber(1,'contrato_cta_pag_m') > 90 then
							messagebox ("Advertencia ", "Este Contrato tiene anexo Liberador de Mantención ",information!)
							RETURN
						end if
				END CHOOSE
				if gs_base='O' or gs_base='C' or gs_base='U' or gs_base='M' then
					SetItem(row, "cantidad", 1)
					IF gs_rezago <> "S" THEN
						SetItem(row, "monto", dw_datos_bl.GetItemNumber(1,"c_valor_cuota_mantencion_pesos"))
						wf_calcular_intereses_bl(ls_tipo_cob2)
					ELSE 
						SetItem(row, "monto", 0)
					END IF
				else
					messagebox("Advertencia","No es posible Ingresar F-Cuota Mantención, para este tipo de Contrato (Solo O-Promesas y C-Contrato)")
					SetItem(row, "monto", 0)
					SetItem(row, "cantidad", 0)
					dw_detalle_bl.setfocus()
					dw_detalle_bl.setcolumn('tipo_cob')
				end if
			END IF
		elseif ls_tipo_cob2 = 'I' then //Abono
			messagebox("Advertencia","No es Posible Ingresar I-Abono")
			SetItem(row, "monto", 0)
			SetItem(row, "cantidad", 0)
			dw_detalle_bl.setfocus()
			dw_detalle_bl.setcolumn('tipo_cob')
			
		elseIF ls_tipo_cob2 = "M" then //Derecho Sepultacion
			if gs_rezago <> "S" THEN
				ls_estado_cadena2 = dw_datos_bl.getitemstring(1,'cadena_estado')
				if ls_estado_cadena2='V' or ls_estado_cadena2='C' or ls_estado_cadena2='S' then
					if gs_base='O' or gs_base='C' or gs_base='F' or gs_base='G' or gs_base='U' or gs_base='M' then
						tab_ingreso.tp_boletas.rb_ci_uf_bl.visible		= true
						tab_ingreso.tp_boletas.rb_ci_peso_bl.visible	= false
						tab_ingreso.tp_boletas.rb_ci_uf_bl.checked		= true
						tab_ingreso.tp_boletas.rb_ci_peso_bl.visible	= false
						if rb_ci_uf_bl.checked=true then 
							dw_detalle_bl.SetItem(dw_detalle_bl.getrow(), "moneda",'U')
						elseif rb_ci_peso_bl.checked=true then 
							dw_detalle_bl.SetItem(dw_detalle_bl.getrow(), "moneda",'P')
						end if
						SetItem(row, "cantidad", 1)
					else
						messagebox("Advertencia","No es Posible Ingresar M-Derecho Sepultura para este Tipo de Contrato")
						SetItem(row, "monto", 0)
						SetItem(row, "cantidad", 0)
						dw_detalle_bl.setfocus()
						dw_detalle_bl.setcolumn('tipo_cob')
					end if
				else
					tab_ingreso.tp_boletas.rb_ci_uf_bl.visible		= false
					tab_ingreso.tp_boletas.rb_ci_peso_bl.visible	= false
					tab_ingreso.tp_boletas.rb_ci_uf_bl.checked		= false
					tab_ingreso.tp_boletas.rb_ci_peso_bl.visible	= true
					messagebox("Advertencia","Recuerde que Contrato debe estar V-Vigente o C-Cancelado")
					SetItem(row, "monto", 0)
					SetItem(row, "cantidad", 0)
					dw_detalle_bl.setfocus()
					dw_detalle_bl.setcolumn('tipo_cob')
				end if
			else
				tab_ingreso.tp_boletas.rb_ci_uf_bl.visible			= true
				tab_ingreso.tp_boletas.rb_ci_peso_bl.visible		= true
				tab_ingreso.tp_boletas.rb_ci_uf_bl.checked			= true
				if rb_ci_uf_bl.checked=true then 
					dw_detalle_bl.SetItem(dw_detalle_bl.getrow(), "moneda",'U')
				elseif rb_ci_peso_bl.checked=true then 
					dw_detalle_bl.SetItem(dw_detalle_bl.getrow(), "moneda",'P')
				end if
				SetItem(row, "cantidad", 1)
			end if
			
		elseIF ls_tipo_cob2 = "A" or ls_tipo_cob2 = "Q" THEN //pie
			IF gs_rezago <> "S" THEN
				if (gs_base='O' or gs_base='U' or gs_base='M') and dw_datos_bl.DataObject='d_datos_cuenta_ci_oferta' then
					ll_ctas				= dw_datos_bl.getitemnumber(1,'pago_oferta_nro_cuotas')
					ll_ctas_pagadas	= dw_datos_bl.getitemnumber(1,'oferta_v_cta_pag_s')
					ld_pie_pactado		= dw_datos_bl.getitemnumber(1,'pago_oferta_pie')
					
				elseif gs_base='P' and dw_datos_bl.DataObject='d_datos_cuenta_ci_pagare' then
					ll_ctas				= dw_datos_bl.getitemnumber(1,'pagare_plazo')
					ll_ctas_pagadas_1	= dw_datos_bl.getitemnumber(1,'pagare_cta_pag_la')
					ll_ctas_pagadas_2	= dw_datos_bl.getitemnumber(1,'pagare_cta_pag_isa')
					ll_ctas_pagadas	= ll_ctas_pagadas_1 + ll_ctas_pagadas_2
					ld_pie_pactado		= dw_datos_bl.getitemnumber(1,'pagare_pie')
					
				elseif gs_base='L' and dw_datos_bl.DataObject='d_datos_cuenta_ci_liberador' then
					ll_ctas				= dw_datos_bl.getitemnumber(1,'pago_liberador_nro_cuotas')
					ll_ctas_pagadas	= dw_datos_bl.getitemnumber(1,'anexo_liberador_cta_pag_m')
					ld_pie_pactado		= dw_datos_bl.getitemnumber(1,'pago_liberador_pie')
					
				elseif (gs_base='F' or gs_base='G' or gs_base='V') and dw_datos_bl.DataObject='d_datos_cuenta_ci_funeraria' then
					ll_ctas				= dw_datos_bl.getitemnumber(1,'producto_pago_plazo')
					ll_ctas_pagadas	= dw_datos_bl.getitemnumber(1,'producto_anexo_cuotas_pag')
					ld_pie_pactado		= dw_datos_bl.getitemnumber(1,'producto_pago_pie')
					
				elseif gs_base='D' and dw_datos_bl.DataObject='d_datos_cuenta_ci_derecho' then
					ll_ctas				= dw_datos_bl.getitemnumber(1,'derecho_plazo')
					ll_ctas_pagadas_1	= dw_datos_bl.getitemnumber(1,'derecho_cta_pag_la')
					ll_ctas_pagadas_2	= dw_datos_bl.getitemnumber(1,'derecho_cta_pag_isa')
					ll_ctas_pagadas	= ll_ctas_pagadas_1 + ll_ctas_pagadas_2
					ld_pie_pactado		= dw_datos_bl.getitemnumber(1,'derecho_pie')
					
				elseif gs_base='A' and dw_datos_bl.DataObject='d_datos_cuenta_ci_aumento_capacidad' then
					ll_ctas				= dw_datos_bl.getitemnumber(1,'pago_aumento_nro_cuotas')
					ll_ctas_pagadas	= dw_datos_bl.getitemnumber(1,'anexo_aumento_cta_pag_m')
					ld_pie_pactado		= dw_datos_bl.getitemnumber(1,'pago_aumento_pie')
					
				elseif gs_base='R' and dw_datos_bl.DataObject='dw_repacta_mant_descripcion_traspaso' then
					ll_ctas				= 0
					ll_ctas_pagadas	= 0
					ld_pie_pactado		= 0
				end if
				if gs_base<>'C' then
					if ld_pie_pactado=0 or isnull(ld_pie_pactado) then
						messagebox("Advertencia","No es Posible Ingresar A-Pie, NO tiene Valor")
						SetItem(row, "monto", 0)
						SetItem(row, "cantidad", 0)
						dw_detalle_bl.setfocus()
						dw_detalle_bl.setcolumn('tipo_cob')
					else
						if ll_ctas_pagadas>=ll_ctas then
							messagebox("Advertencia","No es Posible Ingresar A-Pie")
							SetItem(row, "monto", 0)
							SetItem(row, "cantidad", 0)
							dw_detalle_bl.setfocus()
							dw_detalle_bl.setcolumn('tipo_cob')
						else
							if gs_base='O' or gs_base='U' or gs_base='M' then
								if dw_datos_bl.getitemnumber(1,'pago_oferta_pie') > 0 and &
									dw_datos_bl.getitemnumber(1,'pago_oferta_ctas_pagadas_pie') >= dw_datos_bl.getitemnumber(1,'pago_oferta_ctas_pactadas_pie') then
									ls_pasa		= 'N'
								else
									ls_pasa		= 'S'
								end if
								if ls_pasa='N' then
									if dw_datos_bl.getitemnumber(1,'pago_oferta_pie') > 0 and dw_datos_bl.getitemnumber(1,'pago_oferta_pie_pagado')>0  then
										ls_pasa	= 'N'
									else
										ls_pasa	= 'S'
									end if
								end if
							elseif gs_base='L' then
								if dw_datos_bl.getitemnumber(1,'pago_liberador_pie') > 0 and dw_datos_bl.getitemnumber(1,'pago_liberador_pie_pagado')>0  then
									ls_pasa		= 'N'
								else
									ls_pasa		= 'S'
								end if
							elseif gs_base='F' or gs_base='G' or gs_base='V' then
								if dw_datos_bl.getitemnumber(1,'producto_pago_pie') > 0 and dw_datos_bl.getitemnumber(1,'producto_pago_pie_pagado')>0  then
									ls_pasa		= 'N'
								else
									ls_pasa		= 'S'
								end if
							elseif gs_base='A' then
								if dw_datos_bl.getitemnumber(1,'pago_aumento_pie') > 0 and dw_datos_bl.getitemnumber(1,'pago_aumento_pie_pagado')>0 then
									ls_pasa		= 'N'
								else
									ls_pasa		= 'S'
								end if
							elseif gs_base='D' then
								if dw_datos_bl.getitemnumber(1,'derecho_pie') > 0 and dw_datos_bl.getitemnumber(1,'derecho_pie_pagado')>0 then
									ls_pasa		= 'N'
								else
									ls_pasa		= 'S'
								end if
							elseif gs_base='R' then
								ls_pasa			= 'N'
							elseif gs_base='P' then
								if dw_datos_bl.getitemnumber(1,'pagare_pie') > 0 and dw_datos_bl.getitemnumber(1,'pagare_pie_pagado')>0  then
									ls_pasa		= 'N'
								else
									ls_pasa		= 'S'
								end if
							end if
							if ls_pasa='N' then
								messagebox("Advertencia","No es Posible Ingresar A-Pie")
								SetItem(row, "monto", 0)
								SetItem(row, "cantidad", 0)
								dw_detalle_bl.setfocus()
								dw_detalle_bl.setcolumn('tipo_cob')
							else								
								gs_grabar_pie		= 'N'
								ls_texto2				= gs_base+'~t'+gs_serie+'~t'+string(gi_numero)+'~t'+gs_tipo_cobro+'~t'+trim(sle_numero_bl.text)
								openwithparm(w_ingreso_pago_pie_pactado,ls_texto2)
								if Message.StringParm = 'N' then
									this.SetItem(row, "cantidad", 1)
									this.SetItem(row, "monto", dw_datos_bl.GetItemNumber(1,"c_valor_pie_pesos"))
									this.accepttext()
								else
									w_ingreso2.tab_ingreso.tp_boletas.dw_detalle_bl.accepttext()
									w_ingreso2.tab_ingreso.tp_boletas.dw_detalle_bl.setfocus()
									w_ingreso2.tab_ingreso.tp_boletas.dw_detalle_bl.triggerevent(itemchanged!)
								end if
							end if
						end if
					end if
				else
					messagebox("Advertencia","No es Posible Ingresar A-Pie a Contrato")
					SetItem(row, "monto", 0)
					SetItem(row, "cantidad", 0)
					dw_detalle_bl.setfocus()
					dw_detalle_bl.setcolumn('tipo_cob')
				end if
			else
				SetItem(row, "cantidad", 1)
				SetItem(row, "monto", 0)
				w_ingreso2.tab_ingreso.tp_boletas.dw_gastos_bl.accepttext()
			end if
		ELSEIF ls_tipo_cob2 = "K" THEN
			if not isnull(ls_descrip_estado) then
				if gs_rezago <> "S" then
					messagebox("Advertencia","Para aplicar este Tipo de Cobro el Estado del Contrato debe estar en: S-Seguro Desgravamen, actualmente se encuentra en: "+ls_descrip_estado)
				else
					messagebox("Advertencia","Para aplicar este Tipo de Cobro el Estado del Contrato debe estar en: S-Seguro Desgravamen, actualmente se está ingresando como Rezago")
				end if
			else
				messagebox("Advertencia","No es Posible Ingresar K-Seguro Desgravamen")
			end if
			SetItem(row, "monto", 0)
			SetItem(row, "cantidad", 0)
			dw_detalle_bl.setfocus()
			dw_detalle_bl.setcolumn('tipo_cob')

		ELSEIF ls_tipo_cob2 = "L" or ls_tipo_cob2 = "S" THEN
			SetItem(row, "monto", 0)
			SetItem(row, "cantidad", 1)
			ls_texto2				= ls_tipo_cob2+'~t'+ls_tipo_comp2
			openwithparm(w_apertura_tipo_cobro_otros,ls_texto2)
		ELSEIF ls_tipo_cob2 = "E" and (gs_base<>'P' and gs_base<>'R' and gs_base<>'F' and gs_base<>'G' and gs_base<>'M' and gs_base<>'O' and gs_base<>'U' and gs_base<>'D' and gs_base<>'A' and gs_base<>'L'  and gs_base<>'V') and gs_rezago <> 'S' THEN
			messagebox("Advertencia","Solo es Posible Ingresar Pago Cuota a Contratos Isa")
			SetItem(row, "monto", 0)
			SetItem(row, "cantidad", 0)
			SetItem(row, "tipo_cob", ls_nulo2)
			dw_detalle_bl.setfocus()
			dw_detalle_bl.setcolumn('tipo_cob')
		ELSEIF ls_tipo_cob2 = "F" and gs_base<>'C' and gs_base<>'O' and gs_base<>'U' and gs_base<>'M' THEN
			messagebox("Advertencia","Solo es Posible Ingresar Pago Mantención a Contratos y Promesas")
			SetItem(row, "monto", 0)
			SetItem(row, "cantidad", 0)
			SetItem(row, "tipo_cob", ls_nulo2)
			dw_detalle_bl.setfocus()
			dw_detalle_bl.setcolumn('tipo_cob')
		else
			SetItem(row, "cantidad", 1)
			SetItem(row, "monto", 0)
		END IF
	END IF
	IF is_columna2 = "monto_uf" and rb_ci_uf_bl.checked=true THEN
		ld_monto	= this.getitemnumber(row,'monto_uf')
		if ld_monto>800 then
			if isnull(il_cantidad_malo) then	il_cantidad_malo	= this.getitemnumber(row,'cantidad')
			messagebox("Advertencia","Revisar Monto Ingresado, recuerde tiene Seleccionado Opción Ingreso MONTO en U.F.")
			SetItem(row, "monto", 0)
			SetItem(row, "cantidad", 0)
		else
			if il_cantidad_malo>0 then this.setitem(row,'cantidad',il_cantidad_malo)
		end if
	end if
	if isnull(w_ingreso2.tab_ingreso.tp_boletas.dw_gastos_bl.getitemnumber(1,'gastos_cob')) then
		w_ingreso2.tab_ingreso.tp_boletas.dw_gastos_bl.SetItem(1,'gastos_cob', 0)
	end if
	if isnull(w_ingreso2.tab_ingreso.tp_boletas.dw_gastos_bl.getitemnumber(1,'mora')) then
		w_ingreso2.tab_ingreso.tp_boletas.dw_gastos_bl.SetItem(1,'mora', 0)
	end if
	if isnull(w_ingreso2.tab_ingreso.tp_boletas.dw_gastos_bl.getitemnumber(1,'incluir_gastos')) then
		w_ingreso2.tab_ingreso.tp_boletas.dw_gastos_bl.SetItem(1,'incluir_gastos', 1)
	end if
	dw_gastos_bl.SetItem(1, "Subtotal",GetItemNumber(1,"c_subtotal"))
	dw_gastos_bl.accepttext()
	fila2 							= row
	IF is_columna2 = "cantidad" AND ls_tipo_cob2 = "E" AND GetItemNumber(row, "cantidad") > 0 AND gs_rezago <> "S" and gs_base <> 'C' THEN
		ii_cantidad2 				= GetItemNumber(row, "cantidad")
		if rb_ci_uf_bl.checked=true then 
			ls_moneda						= 'U'
		elseif rb_ci_peso_bl.checked=true then 
			ls_moneda						= 'P'
		end if
		DECLARE x3 CURSOR FOR  
		SELECT	"SEGURO_ASOCIADOS"."COD_SEGURO"  
		FROM 	"SEGURO_ASOCIADOS"  
		WHERE ( "SEGURO_ASOCIADOS"."BASE" = :gs_base ) AND  
				  ( "SEGURO_ASOCIADOS"."SERIE" = :gs_serie ) AND  
				  ( "SEGURO_ASOCIADOS"."NUMERO" = :gi_numero ) AND  
				  ( "SEGURO_ASOCIADOS"."ESTADO_REG" = 0 ) AND  
				  ( "SEGURO_ASOCIADOS"."ESTADO_SEGURO" = 'A' )   
		USING	sqlca;
		open x3;
		if sqlca.sqlcode=0 then
			do while sqlca.sqlcode=0
				fetch x3 into :ll_cod_seguro;
				if not isnull(ll_cod_seguro) then
					ll_fila2		= dw_detalle_bl.Find("tipo_cob = '"+string(ll_cod_seguro)+"'",1, dw_detalle_bl.RowCount())
					dw_detalle_bl.setitem(ll_fila2,'cantidad',ii_cantidad2)
				end if
				setnull(ll_cod_seguro)
			loop
		end if
		close x3;
		dw_detalle_bl.accepttext()
		if (gs_base='O' or gs_base='U' or gs_base='M') and dw_datos_bl.DataObject='d_datos_cuenta_ci_oferta' then
			ll_ctas				= dw_datos_bl.getitemnumber(1,'pago_oferta_nro_cuotas')
			ll_ctas_pagadas	= dw_datos_bl.getitemnumber(1,'oferta_v_cta_pag_s')
		elseif gs_base='P' and dw_datos_bl.DataObject='d_datos_cuenta_ci_pagare' then
			ll_ctas				= dw_datos_bl.getitemnumber(1,'pagare_plazo')
			ll_ctas_pagadas_1	= dw_datos_bl.getitemnumber(1,'pagare_cta_pag_la')
			ll_ctas_pagadas_2	= dw_datos_bl.getitemnumber(1,'pagare_cta_pag_isa')
			ll_ctas_pagadas	= ll_ctas_pagadas_1 + ll_ctas_pagadas_2
		elseif gs_base='L' and dw_datos_bl.DataObject='d_datos_cuenta_ci_liberador' then
			ll_ctas				= dw_datos_bl.getitemnumber(1,'pago_liberador_nro_cuotas')
			ll_ctas_pagadas	= dw_datos_bl.getitemnumber(1,'anexo_liberador_cta_pag_m')
		elseif (gs_base='F' or gs_base='G'  or gs_base='V') and dw_datos_bl.DataObject='d_datos_cuenta_ci_funeraria' then
			ll_ctas				= dw_datos_bl.getitemnumber(1,'producto_pago_plazo')
			ll_ctas_pagadas	= dw_datos_bl.getitemnumber(1,'producto_anexo_cuotas_pag')
		elseif gs_base='D' and dw_datos_bl.DataObject='d_datos_cuenta_ci_derecho' then
			ll_ctas				= dw_datos_bl.getitemnumber(1,'derecho_plazo')
			ll_ctas_pagadas_1	= dw_datos_bl.getitemnumber(1,'derecho_cta_pag_la')
			ll_ctas_pagadas_2	= dw_datos_bl.getitemnumber(1,'derecho_cta_pag_isa')
			ll_ctas_pagadas	= ll_ctas_pagadas_1 + ll_ctas_pagadas_2
		elseif gs_base='A' and dw_datos_bl.DataObject='d_datos_cuenta_ci_aumento_capacidad' then
			ll_ctas				= dw_datos_bl.getitemnumber(1,'pago_aumento_nro_cuotas')
			ll_ctas_pagadas	= dw_datos_bl.getitemnumber(1,'anexo_aumento_cta_pag_m')
		elseif gs_base='R' and dw_datos_bl.DataObject='dw_repacta_mant_descripcion_traspaso' then
			ll_ctas				= dw_datos_bl.getitemnumber(1,'cuotas_pactadas')
			ll_ctas_pagadas	= dw_datos_bl.getitemnumber(1,'ctas_pagadas')
		end if
		if (ll_ctas_pagadas + ii_cantidad2) > ll_ctas then
			messagebox("Advertencia","Cantidad de Cuotas sobrepasa al Plazo del Crédito")
//			SetItem(row, "monto", 0)
			SetItem(row, "monto", dw_datos_bl.GetItemNumber(1,"c_valor_cuota_pesos"))
			SetItem(row, "cantidad", 1)
			dw_detalle_bl.accepttext()
			dw_detalle_bl.setfocus()
			dw_detalle_bl.setcolumn('cantidad')
		end if
		wf_calcular_intereses_bl(ls_tipo_cob2)
		dw_gastos_bl.SetItem(1, "Subtotal",GetItemNumber(1,"c_subtotal"))
		dw_gastos_bl.accepttext()
	END IF
	IF gs_rezago <> "S" and ls_tipo_cob2 = "E" and gs_base<>'C' THEN
		dw_detalle_bl.SetItem(row, "estado", 'S')
		wf_calcular_intereses_bl(ls_tipo_cob2)
	elseif gs_rezago <> "S" and ls_tipo_cob2 = "F" THEN
		dw_detalle_bl.SetItem(row, "estado", 'S')
		wf_calcular_intereses_bl(ls_tipo_cob2)
	else
		dw_detalle_bl.SetItem(row, "estado", 'N')
	end if
elseif ls_estado_cadena2<>'S' and ls_estado_cadena2<>'V' and ls_estado_cadena2<>'C' then
	messagebox("Advertencia","No es Posible Ingresar este Tipo de Cobro")
	dw_detalle_bl.deleterow(row)
	fila2 					= dw_detalle_bl.InsertRow(0)
	dw_detalle_bl.scrolltorow(fila2)
	dw_detalle_bl.SetItem(fila2, "uf", gd_uf)
	dw_detalle_bl.SetItem(fila2, "iva", idb_iva)
	dw_detalle_bl.SetItem(fila2, "folio", 0)
	dw_detalle_bl.SetItem(fila2, "estado", 'N')
	dw_detalle_bl.SetItem(fila2, "uf", gd_uf)
	if rb_ci_uf_bl.checked=true then
		dw_detalle_bl.SetItem(fila2, "moneda",'U')
	else
		dw_detalle_bl.SetItem(fila2, "moneda",'P')
	end if
	setnull(ls_tipo_cob2);setnull(is_columna2)
	dw_detalle_bl.scrolltorow(row)
	dw_detalle_bl.setfocus()
	dw_detalle_bl.setcolumn('tipo_cob')
end if
ll_tot_reg2		= dw_detalle_bl.rowcount()
if ll_tot_reg2 > 0 then
	ll_fila2_gasto		= dw_detalle_bl.Find( "tipo_cob = 'E' or tipo_cob ='F' or tipo_cob='A' or tipo_cob ='U' or tipo_cob='Q'",1, ll_tot_reg2)
	if ll_fila2_gasto =0 then
		dw_gastos_bl.SetItem(1, "mora",0)
		dw_gastos_bl.SetItem(1, "gastos_cob",0)
		dw_gastos_bl.accepttext()
	end if
end if
end event

