public subroutine wf_calcular_iva_gl (string ls_tipo_cob_2);Long		ll_ctas_pag_m_2,ll_ctas_pac_pie,ll_ctas_pag_pie,ll_fila_a,ii_cantidad_2,ll_cuota_ini_2,ll_cuota_fin_2,ll_cuotas_con_iva,ll_new_iva_2, li_monto_descuento,ll_monto_cuota_afe_2
Double	ll_monto_cuota_reg_3, ll_monto_cuota_reg_2,ll_valor_cuota_f,ldb_iva_2,ll_iva_f_2,ll_mora_mant_2,ll_iva_p_2,ll_gasto_mant_2,ll_iva_r_2,ld_monto_descuento,ll_valor_de_cuota, ll_cuotas_a_procesar
String		ls_moneda,ls_moneda_insert_2,ls_tipo_mov,ls_busca
integer li_posicion,li_cuotas_mora,li_cantidad, t 
LONG LL_VALOR_CUOTA, LL_MONTO_1, LL_MONTO_2
 long ld_iva, ld_iva_descuento

// VHFB -- INICIO -- DETERMINA LA CANTIDAD DE CUOTAS EN MORA SEGUN LA BASE
IF  gd_descuento >0 THEN
	li_cantidad=0
	
	if ls_tipo_base = 'L'  or ls_tipo_base = 'A'   or ls_tipo_base = 'F'     or ls_tipo_base = 'R'       or ls_tipo_base = 'G'  THEN
		ls_busca = 'E'
	ELSE
		ls_busca = 'F'
	end if 
		
	for t = 1 to w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount()
		ls_tipo_cob_2 = w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.getitemstring(t,'tipo_cob')
		if ls_tipo_cob_2 =ls_busca then
			li_cantidad =w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.getitemnumber(t,'cantidad')
			exit
		end if 
	next 
	
	li_cuotas_mora=w_ingreso2.tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'c_cuotas_mora')
	
	if ls_tipo_base = 'O'  or ls_tipo_base = 'U'  THEN
			li_cuotas_mora=w_ingreso2.tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'c_cuotas_mora_m')
	END IF 
	IF ls_tipo_base = 'C'  THEN
			li_cuotas_mora=w_ingreso2.tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'c_cuotas_en_mora')
	END IF 
END IF 


// VHFB -- TERMINO -- DETERMINA LA CANTIDAD DE CUOTAS EN MORA SEGUN LA BASE


if ls_tipo_cob_2 = "E" or ls_tipo_cob_2 = "U" then
	if tab_ingreso.tp_be.dw_datos_be.rowcount() > 0 then
		if gs_base='L' then
			ll_ctas_pag_m_2			= tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'anexo_liberador_cta_pag_m')
			ll_monto_cuota_reg_2	= tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'c_valor_cuota_pesos')
		elseif gs_base='G' or gs_base='F' then
			ll_ctas_pag_m_2			= tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'producto_anexo_cuotas_pag')
			ll_monto_cuota_reg_2	= tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'c_valor_cuota_pesos')
		end if
	else
		ll_ctas_pag_m_2				= 1			
	end if
else
	if gs_base='L' then
		ll_ctas_pac_pie				= tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'pago_liberador_ctas_pactadas_pie')
		ll_ctas_pag_pie				= tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'pago_liberador_ctas_pagadas_pie')
	elseif gs_base='G' or gs_base='F' then
		ll_ctas_pac_pie				= tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'producto_pago_ctas_pie_plazo')
		ll_ctas_pag_pie				= tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'producto_pago_ctas_pie_pagadas')
	end if
	if ll_ctas_pac_pie > 0 then
		ll_ctas_pag_m_2				= ll_ctas_pag_pie
	else
		ll_ctas_pag_m_2				= 0
	end if
end if
if ls_tipo_cob_2='A' then
	ll_fila_a							= tab_ingreso.tp_be.dw_detalle_be.find("tipo_cob='A'",1,tab_ingreso.tp_be.dw_detalle_be.rowcount())
	if ll_fila_a > 0 then
		ll_monto_cuota_reg_2		= tab_ingreso.tp_be.dw_detalle_be.getitemnumber(ll_fila_a,'c_total_linea')
	else
		ll_monto_cuota_reg_2		= tab_ingreso.tp_be.dw_detalle_be.getitemnumber(tab_ingreso.tp_be.dw_detalle_be.getrow(),'c_total_linea')
	end if
else
	if isnull(ll_monto_cuota_reg_2) or ll_monto_cuota_reg_2=0 then ll_monto_cuota_reg_2 = tab_ingreso.tp_be.dw_detalle_be.getitemnumber(tab_ingreso.tp_be.dw_detalle_be.getrow(),'c_total_linea')
end if
if (ls_tipo_cob_2='A' and isnull(ll_monto_cuota_reg_2) and ll_ctas_pac_pie=0 and  (gs_base='G' or gs_base='F')) then
	ll_monto_cuota_reg_2			= tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'producto_pago_pie')
	ls_moneda						= tab_ingreso.tp_be.dw_datos_be.getitemstring(1,'producto_pago_moneda')
	if ls_moneda='1' then
		tab_ingreso.tp_be.dw_detalle_be.setitem(tab_ingreso.tp_be.dw_detalle_be.getrow(),'monto_uf', round( ll_monto_cuota_reg_2 / gd_uf,4))
		tab_ingreso.tp_be.dw_detalle_be.setitem(tab_ingreso.tp_be.dw_detalle_be.getrow(),'monto', ll_monto_cuota_reg_2)
		tab_ingreso.tp_be.dw_detalle_be.SetItem(tab_ingreso.tp_be.dw_detalle_be.getrow(), "moneda",'P')
		tab_ingreso.tp_be.rb_be_peso.checked	= true
	else
		tab_ingreso.tp_be.dw_detalle_be.setitem(tab_ingreso.tp_be.dw_detalle_be.getrow(),'monto_uf', ll_monto_cuota_reg_2)
		tab_ingreso.tp_be.dw_detalle_be.setitem(tab_ingreso.tp_be.dw_detalle_be.getrow(),'monto', round(ll_monto_cuota_reg_2 * gd_uf,0) )
		tab_ingreso.tp_be.dw_detalle_be.SetItem(tab_ingreso.tp_be.dw_detalle_be.getrow(), "moneda",'U')
		tab_ingreso.tp_be.rb_be_uf.checked		= true
	end if
elseif ls_tipo_cob_2='A' and isnull(ll_monto_cuota_reg_2) and ll_ctas_pac_pie=0 and  gs_base='L' then
	ll_monto_cuota_reg_2			= tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'pago_liberador_pie')
	ls_moneda						= tab_ingreso.tp_be.dw_datos_be.getitemstring(1,'pago_liberador_moneda')
end if
ii_cantidad_2 							= tab_ingreso.tp_be.dw_detalle_be.GetItemNumber(tab_ingreso.tp_be.dw_detalle_be.getrow(), "cantidad")

if ii_cantidad_2 = 0 or isnull(ii_cantidad_2) then ii_cantidad_2=1
tab_ingreso.tp_be.dw_detalle_be.Setitem(tab_ingreso.tp_be.dw_detalle_be.getrow(), "cantidad",ii_cantidad_2)
tab_ingreso.tp_be.dw_detalle_be.accepttext()
ll_cuota_ini_2							= ll_ctas_pag_m_2 + 1
ll_cuota_fin_2							= (ll_cuota_ini_2 + ii_cantidad_2) - 1
if gs_tipo_cobro = 'BA' or gs_tipo_cobro = 'FA' then
	if ll_ctas_pac_pie = 0 or isnull(ll_ctas_pac_pie) then
		  SELECT COUNT( "VISTA_MANTEN_IVA"."BASE"  )
		  INTO    :ll_cuotas_con_iva
		  FROM    "VISTA_MANTEN_IVA"  
		  WHERE ( "VISTA_MANTEN_IVA"."BASE" = :gs_base ) AND  
				  ( "VISTA_MANTEN_IVA"."SERIE" = :gs_serie ) AND  
				  ( "VISTA_MANTEN_IVA"."NUMERO" = :gi_numero ) AND
				  ( "VISTA_MANTEN_IVA"."TIPO_MOV" = :ls_tipo_cob_2 ) AND
				  ( "VISTA_MANTEN_IVA"."NRO_CUOTA" >= :ll_cuota_ini_2 ) AND
				  ( "VISTA_MANTEN_IVA"."NRO_CUOTA" <= :ll_cuota_fin_2 ) AND
				  ( "VISTA_MANTEN_IVA"."IVA" > 0 );
		  if isnull(ll_cuotas_con_iva) then ll_cuotas_con_iva=0  
		  ll_valor_cuota_f			= round(ll_monto_cuota_reg_2 / ii_cantidad_2,0)
		
		  SELECT SUM( "VISTA_MANTEN_IVA"."IVA"  )
		  INTO    :ldb_iva_2
		  FROM    "VISTA_MANTEN_IVA"  
		  WHERE ( "VISTA_MANTEN_IVA"."BASE" = :gs_base ) AND  
				  ( "VISTA_MANTEN_IVA"."SERIE" = :gs_serie ) AND  
				  ( "VISTA_MANTEN_IVA"."NUMERO" = :gi_numero ) AND
				  ( "VISTA_MANTEN_IVA"."TIPO_MOV" = :ls_tipo_cob_2 ) AND
				  ( "VISTA_MANTEN_IVA"."NRO_CUOTA" >= :ll_cuota_ini_2 ) AND
				  ( "VISTA_MANTEN_IVA"."NRO_CUOTA" <= :ll_cuota_fin_2 ) ;
		  if ldb_iva_2 > 0 and ll_monto_cuota_reg_2 > 0 then
				gl_iva_exento_f		= ll_monto_cuota_reg_2 - (ll_cuotas_con_iva * ll_valor_cuota_f)
				ll_iva_f_2 				= ldb_iva_2		//round(ll_monto_cuota_reg_2 * (idb_iva - 1),0)
				ll_new_iva_2			= tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob = 'D'", 1, tab_ingreso.tp_be.dw_detalle_be.rowcount())

				  //-------------------------------------------------------------------------------------------------------------
				  // VHFB -- INICIO -- SE REALIZA EL CALCULO DEL IVA SEGUN LAS CUOTAS EN MORA
				  //-------------------------------------------------------------------------------------------------------------
				  if gd_descuento >0 then 
					
						ll_valor_de_cuota = tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'c_valor_cuota_pesos')
						
			
						//-----------------------------------------------------------------------------
						// vhfb - calculamos el iva para las cuotas en mora solamente
						//-----------------------------------------------------------------------------
					    double ll_cuota_a_mas, ll_cuotas_exentas, ll_cuotas_mora_afectas
						 
						IF li_cantidad > li_cuotas_mora and gd_descuento >0 THEN
							
							if li_cantidad > ll_cuotas_con_iva then	
								ll_cuotas_a_procesar = ll_cuotas_con_iva
							else 
								ll_cuotas_a_procesar = li_cantidad
							end if 						
														
							ll_cuotas_exentas          = li_cantidad -  ll_cuotas_con_iva
							ll_cuotas_mora_afectas  = li_cuotas_mora - ll_cuotas_exentas
							ll_cuota_a_mas             = li_cantidad - li_cuotas_mora		
					
							ll_monto_cuota_afe_2 = (ll_valor_de_cuota*ll_cuotas_mora_afectas)				// monto cuotas en mora afectas a descuento
							ld_monto_descuento = ll_monto_cuota_afe_2 * (gd_descuento/100)			// determinamos el monto de descuento
							
							ll_monto_cuota_reg_3 = (ll_valor_de_cuota*(ll_cuota_a_mas))	// monto cuotas en mora no afectas a descuento
							
							ll_iva_f_2 =round ((ll_monto_cuota_afe_2 - ld_monto_descuento + ll_monto_cuota_reg_3)* (idb_iva - 1),0)			
					
							 if round ((ll_monto_cuota_afe_2 - ld_monto_descuento + ll_monto_cuota_reg_3)* (idb_iva - 1),1) - round ((ll_monto_cuota_afe_2 - ld_monto_descuento + ll_monto_cuota_reg_3)* (idb_iva - 1),0)=0.5 then
								 ll_iva_f_2 = round ((ll_monto_cuota_afe_2 - ld_monto_descuento + ll_monto_cuota_reg_3)* (idb_iva - 1) + 0.1,0)
							else
								 ll_iva_f_2 =round ((ll_monto_cuota_afe_2 - ld_monto_descuento + ll_monto_cuota_reg_3)* (idb_iva - 1),0)	
							end if 		
						
						END IF 
						
						//-----------------------------------------------------------------------------
						// vhfb - calculamos el iva para las cuotas iguales en mora solamente
						//-----------------------------------------------------------------------------				
						IF li_cantidad = li_cuotas_mora and gd_descuento >0 THEN
							
							if li_cuotas_mora > ll_cuotas_con_iva then
								ll_cuotas_a_procesar = ll_cuotas_con_iva
							else 
								ll_cuotas_a_procesar = li_cuotas_mora
							end if 							
							
							 ld_monto_descuento =( ll_valor_de_cuota * ll_cuotas_a_procesar)  * (gd_descuento/100)
							 
							 if round (((ll_valor_de_cuota* ll_cuotas_a_procesar) - ld_monto_descuento)* (idb_iva - 1),1) - round (((ll_valor_de_cuota* ll_cuotas_a_procesar) - ld_monto_descuento)* (idb_iva - 1),0) =0.5 then
							 	 ll_iva_f_2 =round (((ll_valor_de_cuota* ll_cuotas_a_procesar) - ld_monto_descuento)* (idb_iva - 1)+0.1,0) 
							else
							 	 ll_iva_f_2 =round (((ll_valor_de_cuota* ll_cuotas_a_procesar) - ld_monto_descuento)* (idb_iva - 1),0)
							end if 
							
							 ll_iva_f_2 =round (ll_iva_f_2,0)	
							 
						END IF 
						
						//-----------------------------------------------------------------------------
						// vhfb - calculamos el iva para las cuotas menores a  en mora solamente
						//-----------------------------------------------------------------------------						
						IF li_cantidad < li_cuotas_mora and gd_descuento >0 THEN
							
							if li_cantidad > ll_cuotas_con_iva then
								ll_cuotas_a_procesar = ll_cuotas_con_iva
							else 
								ll_cuotas_a_procesar = li_cantidad
							end if 	
					
					
							ll_monto_cuota_reg_2 = (ll_valor_de_cuota*(ll_cuotas_a_procesar))					
							
							ld_monto_descuento =( ll_valor_de_cuota * ll_cuotas_a_procesar) * (gd_descuento/100)		
							
							 if round (((ll_valor_de_cuota* li_cantidad) - ld_monto_descuento)* (idb_iva - 1),1) - round (((ll_valor_de_cuota* ll_cuotas_a_procesar) - ld_monto_descuento)* (idb_iva - 1),0)	 =0.5 then
							 	  ll_iva_f_2 =round (((ll_valor_de_cuota* ll_cuotas_a_procesar) - ld_monto_descuento)* (idb_iva - 1)+0.1,0)	
							else
							 	 ll_iva_f_2 =round (((ll_valor_de_cuota* ll_cuotas_a_procesar) - ld_monto_descuento)* (idb_iva - 1),0)	
							end if 							
							
							
							ll_iva_f_2 =round (ll_iva_f_2,0)	
						END IF 	
						
					end if 					
				  //-------------------------------------------------------------------------------------------------------------				  
				  //  VHFB -- TERMINO -- SE REALIZA EL CALCULO DEL IVA SEGUN LAS CUOTAS EN MORA
				  //-------------------------------------------------------------------------------------------------------------						
				
				if ll_new_iva_2 > 0 then
					if ldb_iva_2 > 0 then
						tab_ingreso.tp_be.dw_detalle_be.scrolltorow(ll_new_iva_2)
					else
						tab_ingreso.tp_be.dw_detalle_be.deleterow(ll_new_iva_2)
					end if
				else
					ll_new_iva_2		= tab_ingreso.tp_be.dw_detalle_be.insertrow(0)
				end if
				tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_iva_2,'tipo_cob', 'D')
				if tab_ingreso.tp_be.rb_be_afecta.checked=true then
					tab_ingreso.tp_be.dw_detalle_be.SetItem(ll_new_iva_2, "iva", idb_iva)
				end if
				tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_iva_2,'cantidad', 1)
				ls_moneda_insert_2	= '1'
				if ls_moneda_insert_2 = '1' then
					tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_iva_2,'monto_uf', round( ll_iva_f_2 / gd_uf,4))
					tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_iva_2,'monto', ll_iva_f_2)
				end if
				tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_iva_2,'uf',gd_uf)
				tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_iva_2,'estado','S')
				tab_ingreso.tp_be.dw_detalle_be.SetItem(ll_new_iva_2, "moneda",'P')
		  else
				if ll_ctas_pac_pie > 0 and ll_cuota_ini_2 > 1 then
					//	no hacer nada
				else
					ll_iva_f_2 				= 0
					gl_iva_exento_f			= ll_monto_cuota_reg_2
					ll_new_iva_2			= tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob = 'D'", 1, tab_ingreso.tp_be.dw_detalle_be.rowcount())
					if ll_new_iva_2 > 0 then
						if tab_ingreso.tp_be.dw_detalle_be.getitemnumber(ll_new_iva_2,'monto') <= 0 then tab_ingreso.tp_be.dw_detalle_be.deleterow(ll_new_iva_2)
					end if
				end if
		  end if
		  
		  //-------------------------------------------------------------------------------------------------------------
		  //  mora_cred
		  //-------------------------------------------------------------------------------------------------------------
		  ll_mora_mant_2			= tab_ingreso.tp_be.dw_gastos_be.getitemnumber(1,'mora_cred')
		  //-------------------------------------------------------------------------------------------------------------
		  
		  
		  if ll_mora_mant_2 > 0 then
			if ls_tipo_cob_2='F' then
				ls_tipo_mov		= 'P'
			elseif ls_tipo_cob_2='E' or ls_tipo_cob_2='A' then
				ls_tipo_mov		= 'G'
			end if
			  SELECT  SUM("VISTA_MANTEN_IVA"."IVA")  
			  INTO    	:ldb_iva_2
			  FROM    "VISTA_MANTEN_IVA"  
			  WHERE   ( "VISTA_MANTEN_IVA"."BASE" = :gs_base ) AND  
						  ( "VISTA_MANTEN_IVA"."SERIE" = :gs_serie ) AND  
						  ( "VISTA_MANTEN_IVA"."NUMERO" = :gi_numero ) AND
						  ( "VISTA_MANTEN_IVA"."TIPO_MOV" = :ls_tipo_mov ) AND
						  ( "VISTA_MANTEN_IVA"."NRO_CUOTA" >= :ll_cuota_ini_2 ) AND
						  ( "VISTA_MANTEN_IVA"."NRO_CUOTA" <= :ll_cuota_fin_2 );

				ll_iva_f_2 				= ldb_iva_2	
				ll_new_iva_2			= tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob = 'V'", 1, tab_ingreso.tp_be.dw_detalle_be.rowcount())
					  
			  if ldb_iva_2 > 0 and ll_mora_mant_2 > 0 then
				  //-------------------------------------------------------------------------------------------------------------
				  //  VHFB - INICIO - SE REALIZA EL CALCULO DEL IVA SEGUN MORA CREDITO 
				  //-------------------------------------------------------------------------------------------------------------	
				 
				 IF  gd_descuento = 0 THEN 
					ll_iva_p_2 			= round(ll_mora_mant_2 * (idb_iva - 1),0)			// CALCULO DEL IVA CLASICO
				ELSE
					
					ld_monto_descuento  = ll_mora_mant_2 * (gd_descuento/100)
					
					ll_iva_p_2        			= round((ll_mora_mant_2 - ld_monto_descuento) * (idb_iva - 1),0)			// CALCULO DEL IVA CLASICO
					
					// se aplica el descuento sobre la mora y despues se calcula el iva
					
				END IF 
				  //-------------------------------------------------------------------------------------------------------------
				  //  VHFB - TERMINO - SE REALIZA EL CALCULO DEL IVA SEGUN MORA CREDITO 
				  //-------------------------------------------------------------------------------------------------------------						
					
					ll_new_iva_2		= tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob = 'V'", 1, tab_ingreso.tp_be.dw_detalle_be.rowcount())
					if ll_new_iva_2 > 0 then
						tab_ingreso.tp_be.dw_detalle_be.scrolltorow(ll_new_iva_2)
					else
						ll_new_iva_2		= tab_ingreso.tp_be.dw_detalle_be.insertrow(0)
					end if
					tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_iva_2,'tipo_cob', 'V')
					if tab_ingreso.tp_be.rb_be_afecta.checked=true then
						tab_ingreso.tp_be.dw_detalle_be.SetItem(ll_new_iva_2, "iva", idb_iva)
					end if
					tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_iva_2,'cantidad', 1)
					ls_moneda_insert_2	= '1'
					if ls_moneda_insert_2 = '1' then
						tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_iva_2,'monto_uf', round( ll_iva_p_2 / gd_uf,4))
						tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_iva_2,'monto', ll_iva_p_2)
					end if
					tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_iva_2,'uf',gd_uf)
					tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_iva_2,'estado','S')
					tab_ingreso.tp_be.dw_detalle_be.SetItem(ll_new_iva_2, "moneda",'P')
			  else
					ll_iva_p_2 			= 0
			  end if
		  end if
		  
		  
		  //-------------------------------------------------------------------------------------------------------------
		  // gasto_cred
		  //-------------------------------------------------------------------------------------------------------------
		  ll_gasto_mant_2				= tab_ingreso.tp_be.dw_gastos_be.getitemnumber(1,'gasto_cred')
		  //-------------------------------------------------------------------------------------------------------------
		  
		  
		  if ll_gasto_mant_2 > 0 then
			if ls_tipo_cob_2='F' then
				ls_tipo_mov		= 'R'
			elseif ls_tipo_cob_2='E' or ls_tipo_cob_2='A' then
				ls_tipo_mov		= 'J'
			end if
			  SELECT  SUM("VISTA_MANTEN_IVA"."IVA" ) 
			  INTO    	:ldb_iva_2
			  FROM    "VISTA_MANTEN_IVA"  
			  WHERE ( "VISTA_MANTEN_IVA"."BASE" = :gs_base ) AND  
					  ( "VISTA_MANTEN_IVA"."SERIE" = :gs_serie ) AND  
					  ( "VISTA_MANTEN_IVA"."NUMERO" = :gi_numero ) AND
					  ( "VISTA_MANTEN_IVA"."TIPO_MOV" = :ls_tipo_mov ) AND
					  ( "VISTA_MANTEN_IVA"."NRO_CUOTA" >= :ll_cuota_ini_2 ) AND
					  ( "VISTA_MANTEN_IVA"."NRO_CUOTA" <= :ll_cuota_fin_2 );
			  if ldb_iva_2 > 0 and ll_gasto_mant_2 > 0 then
				
				  //-------------------------------------------------------------------------------------------------------------
				  //  VHFB - INICIO - SE REALIZA EL CALCULO DEL IVA SEGUN MORA CREDITO 
				  //-------------------------------------------------------------------------------------------------------------				
				 IF  gd_descuento = 0 THEN
					ll_iva_r_2 			= round(ll_gasto_mant_2 * (idb_iva - 1),0)		// CALCULO DEL IVA CLASICO
				ELSE
					ld_monto_descuento = ll_gasto_mant_2 * (gd_descuento/100)
					
					ll_iva_r_2 				= round((ll_gasto_mant_2 - ld_monto_descuento) * (idb_iva - 1),0)		// CALCULO DEL IVA CLASICO
					
				END IF 
				  //-------------------------------------------------------------------------------------------------------------
				  //  VHFB - TERMINO - SE REALIZA EL CALCULO DEL IVA SEGUN MORA CREDITO 
				  //-------------------------------------------------------------------------------------------------------------		
					
					ll_new_iva_2		= tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob = 'X'", 1, tab_ingreso.tp_be.dw_detalle_be.rowcount())
					if ll_new_iva_2 > 0 then
						tab_ingreso.tp_be.dw_detalle_be.scrolltorow(ll_new_iva_2)
					else
						ll_new_iva_2		= tab_ingreso.tp_be.dw_detalle_be.insertrow(0)
					end if
					tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_iva_2,'tipo_cob', 'X')
					if tab_ingreso.tp_be.rb_be_afecta.checked=true then
						tab_ingreso.tp_be.dw_detalle_be.SetItem(ll_new_iva_2, "iva", idb_iva)
					end if
					tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_iva_2,'cantidad', 1)
					ls_moneda_insert_2	= '1'
					if ls_moneda_insert_2 = '1' then
						tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_iva_2,'monto_uf', round( ll_iva_r_2 / gd_uf,4))
						tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_iva_2,'monto', ll_iva_r_2)
					end if
					tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_iva_2,'uf',gd_uf)
					tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_iva_2,'estado','S')
					tab_ingreso.tp_be.dw_detalle_be.SetItem(ll_new_iva_2, "moneda",'P')
			  else
					ll_iva_r_2 			= 0
			  end if
		end if
	end if
end if
end subroutine

public subroutine wf_calcular_iva_mant (long ll_ctas_pag_m_2);Double	ll_monto_cuota_reg_2,ll_valor_cuota_f,ldb_iva_2,ll_iva_f_2,ll_iva_p_2,ll_gasto_mant_2,ll_iva_r_2,ll_monto_cuota_reg_3
Long		ii_cantidad_2,ll_cuota_ini_2,ll_cuota_fin_2,ll_cuotas_con_iva,ll_new_iva_2,ll_mora_mant_2,li_cuotas_mora2,ld_monto_descuento,ll_monto_cuota_afe_2, ll_cuotas_a_procesar
String		ls_moneda_insert_2, ls_busca,ls_tipo_cob_2
INTEGER li_cuotas_mora,li_cantidad, T 
 long ld_iva, ld_iva_descuento
LONG LL_VALOR_CUOTA, LL_MONTO_1, LL_MONTO

// VHFB -- INICIO -- DETERMINA LA CANTIDAD DE CUOTAS EN MORA SEGUN LA BASE
IF  gd_descuento >0 THEN
li_cantidad=0

if ls_tipo_base = 'L'  or ls_tipo_base = 'A'   or ls_tipo_base = 'F'     or ls_tipo_base = 'R'  THEN
	ls_busca = 'E'
ELSE
	ls_busca = 'F'
end if 
	
for t = 1 to w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount()
	ls_tipo_cob_2 = w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.getitemstring(t,'tipo_cob')
	if ls_tipo_cob_2 =ls_busca then
		li_cantidad =w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.getitemnumber(t,'cantidad')
		exit
	end if 
next 

li_cuotas_mora=w_ingreso2.tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'c_cuotas_mora')

if ls_tipo_base = 'O'  or ls_tipo_base = 'U'  THEN
		li_cuotas_mora=w_ingreso2.tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'c_cuotas_mora_m')
END IF 
IF ls_tipo_base = 'C'  THEN
		li_cuotas_mora=w_ingreso2.tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'c_cuotas_en_mora')
END IF 
END IF 

// VHFB -- TERMINO -- DETERMINA LA CANTIDAD DE CUOTAS EN MORA SEGUN LA BASE


if gs_tipo_cobro = 'BA' or gs_tipo_cobro = 'FA' then
	ll_monto_cuota_reg_2		= tab_ingreso.tp_be.dw_detalle_be.getitemnumber(tab_ingreso.tp_be.dw_detalle_be.getrow(),'c_total_linea')
	ii_cantidad_2 					= tab_ingreso.tp_be.dw_detalle_be.GetItemNumber(tab_ingreso.tp_be.dw_detalle_be.getrow(), "cantidad")
	if isnull(ii_cantidad_2) or ii_cantidad_2 = 0 then ii_cantidad_2=1
	ll_cuota_ini_2					= ll_ctas_pag_m_2 + 1
	ll_cuota_fin_2					= (ll_cuota_ini_2 + ii_cantidad_2) - 1
	
	  SELECT COUNT( "VISTA_MANTEN_IVA"."BASE"  )
	  INTO    :ll_cuotas_con_iva
	  FROM    "VISTA_MANTEN_IVA"  
	  WHERE ( "VISTA_MANTEN_IVA"."BASE" = :gs_base ) AND  
			  ( "VISTA_MANTEN_IVA"."SERIE" = :gs_serie ) AND  
			  ( "VISTA_MANTEN_IVA"."NUMERO" = :gi_numero ) AND
			  ( "VISTA_MANTEN_IVA"."TIPO_MOV" = 'F' ) AND
			  ( "VISTA_MANTEN_IVA"."NRO_CUOTA" >= :ll_cuota_ini_2 ) AND
			  ( "VISTA_MANTEN_IVA"."NRO_CUOTA" <= :ll_cuota_fin_2 ) AND
			  ( "VISTA_MANTEN_IVA"."IVA" > 0 );
	  if isnull(ll_cuotas_con_iva) then ll_cuotas_con_iva=0  
	  ll_valor_cuota_f			= round(ll_monto_cuota_reg_2 / ii_cantidad_2,0)
	  
	  SELECT SUM( "VISTA_MANTEN_IVA"."IVA"  )
	  INTO    :ldb_iva_2
	  FROM    "VISTA_MANTEN_IVA"  
	  WHERE ( "VISTA_MANTEN_IVA"."BASE" = :gs_base ) AND  
			  ( "VISTA_MANTEN_IVA"."SERIE" = :gs_serie ) AND  
			  ( "VISTA_MANTEN_IVA"."NUMERO" = :gi_numero ) AND
			  ( "VISTA_MANTEN_IVA"."TIPO_MOV" = 'F' ) AND
			  ( "VISTA_MANTEN_IVA"."NRO_CUOTA" >= :ll_cuota_ini_2 ) AND
			  ( "VISTA_MANTEN_IVA"."NRO_CUOTA" <= :ll_cuota_fin_2 ) ;
	  if ldb_iva_2 > 0 and ll_monto_cuota_reg_2 > 0 then
			gl_iva_exento_f		= ll_monto_cuota_reg_2 - (ll_cuotas_con_iva * ll_valor_cuota_f)
			
			ll_iva_f_2 				= ldb_iva_2		//round(ll_monto_cuota_reg_2 * (idb_iva - 1),0)
			ll_new_iva_2			= tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob = 'D'", 1, tab_ingreso.tp_be.dw_detalle_be.rowcount())
			
		  //-------------------------------------------------------------------------------------------------------------
		  //  VHFB -- INICIO -- SE REALIZA EL CALCULO DEL IVA SEGUN LAS CUOTAS EN MORA
		  //-------------------------------------------------------------------------------------------------------------
		  if gd_descuento >0 then 
								
			
				IF li_cantidad > li_cuotas_mora THEN
					//-----------------------------------------------------------------------------
					// vhfb - calculamos el iva para las cuotas en mora solamente
					//-----------------------------------------------------------------------------
					double ll_cuota_a_mas, ll_cuotas_exentas, ll_cuotas_mora_afectas
										
					if li_cuotas_mora > ll_cuotas_con_iva then
					   ll_cuotas_a_procesar = ll_cuotas_con_iva
					else 
						ll_cuotas_a_procesar = li_cuotas_mora
					end if 
			

					ll_cuotas_exentas          = li_cantidad -  ll_cuotas_con_iva
					ll_cuotas_mora_afectas  = li_cuotas_mora - ll_cuotas_exentas
					ll_cuota_a_mas             = li_cantidad - li_cuotas_mora
					
					ll_monto_cuota_afe_2 = (ll_valor_cuota_f *( ll_cuotas_mora_afectas))						// monto cuotas en mora afectas a descuento
					
					ld_monto_descuento = ll_monto_cuota_afe_2 * (gd_descuento/100)			// determinamos el monto de descuento
										
					ll_monto_cuota_reg_3 = (ll_valor_cuota_f*(ll_cuota_a_mas))	// monto cuotas en mora no afectas a descuento
					
					ll_iva_f_2 =round ((ll_monto_cuota_afe_2 - ld_monto_descuento + ll_monto_cuota_reg_3)* (idb_iva - 1),0)	

					
					 if round ((ll_monto_cuota_afe_2 - ld_monto_descuento + ll_monto_cuota_reg_3)* (idb_iva - 1),1) - round ((ll_monto_cuota_afe_2 - ld_monto_descuento + ll_monto_cuota_reg_3)* (idb_iva - 1),0)=0.5 then
						 ll_iva_f_2 = round ((ll_monto_cuota_afe_2 - ld_monto_descuento + ll_monto_cuota_reg_3)* (idb_iva - 1) + 0.1,0)
					else
						 ll_iva_f_2 =round ((ll_monto_cuota_afe_2 - ld_monto_descuento + ll_monto_cuota_reg_3)* (idb_iva - 1),0)	
					end if 							
					
					
					
					
//					ll_monto_cuota_afe_2 = (ll_valor_cuota_f*li_cuotas_mora)						// monto cuotas en mora afectas a descuento
//					ld_monto_descuento = ll_monto_cuota_afe_2 * (gd_descuento/100)			// determinamos el monto de descuento
//					
//					ll_monto_cuota_reg_3 = (ll_valor_cuota_f*(li_cantidad - li_cuotas_mora))	// monto cuotas en mora no afectas a descuento
//					
//					ll_iva_f_2 =round ((ll_monto_cuota_afe_2 - ld_monto_descuento + ll_monto_cuota_reg_3)* (idb_iva - 1),0)						
					
					
					
				
				END IF 

				//-----------------------------------------------------------------------------
				// vhfb - calculamos el iva para las cuotas iguales en mora solamente
				//-----------------------------------------------------------------------------				
				IF li_cantidad = li_cuotas_mora THEN
					
					if li_cuotas_mora > ll_cuotas_con_iva then
					   ll_cuotas_a_procesar = ll_cuotas_con_iva
					else 
						ll_cuotas_a_procesar = li_cuotas_mora
					end if 					
					
					 ld_monto_descuento =( ll_valor_cuota_f *ll_cuotas_a_procesar)  * (gd_descuento/100)				
					 
					 if round (((ll_valor_cuota_f *ll_cuotas_a_procesar) - ld_monto_descuento)* (idb_iva - 1),1)	 - round (((ll_valor_cuota_f *ll_cuotas_a_procesar) - ld_monto_descuento)* (idb_iva - 1),0)	=0.5 then
						 ll_iva_f_2 = round (((ll_valor_cuota_f *ll_cuotas_a_procesar) - ld_monto_descuento)* (idb_iva - 1) + 0.1,0)	
					else
						  ll_iva_f_2 =round (((ll_valor_cuota_f *ll_cuotas_a_procesar) - ld_monto_descuento)* (idb_iva - 1),0)	
					end if 					 
					 
				END IF 
				
							
//				IF li_cantidad = li_cuotas_mora THEN
//					 ld_monto_descuento =( ll_valor_cuota_f *li_cantidad)  * (gd_descuento/100)					
//					 ll_iva_f_2 =round (((ll_valor_cuota_f *li_cantidad) - ld_monto_descuento)* (idb_iva - 1),0)	
//				END IF 
				
				
				//-----------------------------------------------------------------------------
				// vhfb - calculamos el iva para las cuotas menores a  en mora solamente
				//-----------------------------------------------------------------------------						
				IF li_cantidad < li_cuotas_mora  THEN
					
					
					if li_cantidad > ll_cuotas_con_iva then
					   ll_cuotas_a_procesar = ll_cuotas_con_iva
					else 
						ll_cuotas_a_procesar = li_cantidad
					end if 						
					
					ll_monto_cuota_reg_2 = (ll_valor_cuota_f*( ll_cuotas_a_procesar))					
					
					ld_monto_descuento = ( ll_valor_cuota_f *ll_cuotas_a_procesar) * (gd_descuento/100)		

					 if round (((ll_valor_cuota_f *ll_cuotas_a_procesar)  - ld_monto_descuento)* (idb_iva - 1),1)	 - round (((ll_valor_cuota_f *ll_cuotas_a_procesar)  - ld_monto_descuento)* (idb_iva - 1),0)	=0.5 then
						 ll_iva_f_2 = round (((ll_valor_cuota_f *ll_cuotas_a_procesar)  - ld_monto_descuento)* (idb_iva - 1)+0.1,0)	
					else
						  ll_iva_f_2 =round (((ll_valor_cuota_f *ll_cuotas_a_procesar)  - ld_monto_descuento)* (idb_iva - 1),0)	
					end if 
					
					
					

					
					
				END IF 
											
				
			end if 					
		  //-------------------------------------------------------------------------------------------------------------
		  //  VHFB -- TERMINO -- SE REALIZA EL CALCULO DEL IVA SEGUN LAS CUOTAS EN MORA
		  //-------------------------------------------------------------------------------------------------------------			
			
			if ll_new_iva_2 > 0 then
				if ldb_iva_2 > 0 then
					tab_ingreso.tp_be.dw_detalle_be.scrolltorow(ll_new_iva_2)
				else
					tab_ingreso.tp_be.dw_detalle_be.deleterow(ll_new_iva_2)
				end if
			else
				ll_new_iva_2		= tab_ingreso.tp_be.dw_detalle_be.insertrow(0)
			end if
		
			tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_iva_2,'tipo_cob', 'D')
			if tab_ingreso.tp_be.rb_be_afecta.checked=true then
				tab_ingreso.tp_be.dw_detalle_be.SetItem(ll_new_iva_2, "iva", idb_iva)
			end if
			tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_iva_2,'cantidad', 1)
			ls_moneda_insert_2	= '1'
			if ls_moneda_insert_2 = '1' then
				tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_iva_2,'monto_uf', round( ll_iva_f_2 / gd_uf,4))
				tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_iva_2,'monto', ll_iva_f_2)
			end if
			tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_iva_2,'uf',gd_uf)
			tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_iva_2,'estado','S')
			tab_ingreso.tp_be.dw_detalle_be.SetItem(ll_new_iva_2, "moneda",'P')
	  else
			ll_iva_f_2 				= 0
			gl_iva_exento_f		= ll_monto_cuota_reg_2
			ll_new_iva_2			= tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob = 'D'", 1, tab_ingreso.tp_be.dw_detalle_be.rowcount())
			if ll_new_iva_2 > 0 then
				tab_ingreso.tp_be.dw_detalle_be.deleterow(ll_new_iva_2)
			end if
	  end if
	  
	  //-------------------------------------------------------------------------------------------------------------
	  //  MORA CREDITO
	  //-------------------------------------------------------------------------------------------------------------	  
	  
	  ll_mora_mant_2			= tab_ingreso.tp_be.dw_gastos_be.getitemnumber(1,'mora_mant')
	  if ll_mora_mant_2 > 0 then
		  SELECT  SUM("VISTA_MANTEN_IVA"."IVA")  
		  INTO    	:ldb_iva_2
		  FROM    "VISTA_MANTEN_IVA"  
		  WHERE   ( "VISTA_MANTEN_IVA"."BASE" = :gs_base ) AND  
					  ( "VISTA_MANTEN_IVA"."SERIE" = :gs_serie ) AND  
					  ( "VISTA_MANTEN_IVA"."NUMERO" = :gi_numero ) AND
					  ( "VISTA_MANTEN_IVA"."TIPO_MOV" = 'P' ) AND
					  ( "VISTA_MANTEN_IVA"."NRO_CUOTA" >= :ll_cuota_ini_2 ) AND
					  ( "VISTA_MANTEN_IVA"."NRO_CUOTA" <= :ll_cuota_fin_2 );
		  if ldb_iva_2 > 0 and ll_mora_mant_2 > 0 then
			

				  //-------------------------------------------------------------------------------------------------------------
				  //  VHFB - INICIO - SE REALIZA EL CALCULO DEL IVA SEGUN MORA CREDITO 
				  //-------------------------------------------------------------------------------------------------------------				
				 IF  gd_descuento = 0 THEN
					ll_iva_p_2 			= round(ll_mora_mant_2 * (idb_iva - 1),0)			// CALCULO DEL IVA CLASICO
				ELSE
					
					ld_monto_descuento = ll_mora_mant_2 * (gd_descuento/100)
					
					ll_iva_p_2 			= round((ll_mora_mant_2 - ld_monto_descuento) * (idb_iva - 1),0)			// CALCULO DEL IVA CLASICO
					
				END IF 
				  //-------------------------------------------------------------------------------------------------------------
				  //  VHFB - TERMINO - SE REALIZA EL CALCULO DEL IVA SEGUN MORA CREDITO 
				  //-------------------------------------------------------------------------------------------------------------									
			
							
				ll_new_iva_2		= tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob = 'V'", 1, tab_ingreso.tp_be.dw_detalle_be.rowcount())
				if ll_new_iva_2 > 0 then
					tab_ingreso.tp_be.dw_detalle_be.scrolltorow(ll_new_iva_2)
				else
					ll_new_iva_2		= tab_ingreso.tp_be.dw_detalle_be.insertrow(0)
				end if
				tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_iva_2,'tipo_cob', 'V')
				if tab_ingreso.tp_be.rb_be_afecta.checked=true then
					tab_ingreso.tp_be.dw_detalle_be.SetItem(ll_new_iva_2, "iva", idb_iva)
				end if
				tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_iva_2,'cantidad', 1)
				ls_moneda_insert_2	= '1'
				if ls_moneda_insert_2 = '1' then
					tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_iva_2,'monto_uf', round( ll_iva_p_2 / gd_uf,4))
					tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_iva_2,'monto', ll_iva_p_2)
				end if
				tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_iva_2,'uf',gd_uf)
				tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_iva_2,'estado','S')
				tab_ingreso.tp_be.dw_detalle_be.SetItem(ll_new_iva_2, "moneda",'P')
		  else
				ll_iva_p_2 			= 0
		  end if
	  end if
	  
	  //-------------------------------------------------------------------------------------------------------------
	  //  GASTOS MANTENCION
	  //-------------------------------------------------------------------------------------------------------------	  
	  ll_gasto_mant_2				= tab_ingreso.tp_be.dw_gastos_be.getitemnumber(1,'gasto_mant')
	  if ll_gasto_mant_2 > 0 then
		  SELECT  SUM("VISTA_MANTEN_IVA"."IVA" ) 
		  INTO    	:ldb_iva_2
		  FROM    "VISTA_MANTEN_IVA"  
		  WHERE ( "VISTA_MANTEN_IVA"."BASE" = :gs_base ) AND  
				  ( "VISTA_MANTEN_IVA"."SERIE" = :gs_serie ) AND  
				  ( "VISTA_MANTEN_IVA"."NUMERO" = :gi_numero ) AND
				  ( "VISTA_MANTEN_IVA"."TIPO_MOV" = 'R' ) AND
				  ( "VISTA_MANTEN_IVA"."NRO_CUOTA" >= :ll_cuota_ini_2 ) AND
				  ( "VISTA_MANTEN_IVA"."NRO_CUOTA" <= :ll_cuota_fin_2 );
		  if ldb_iva_2 > 0 and ll_gasto_mant_2 > 0 then
			

				  //-------------------------------------------------------------------------------------------------------------
				  //  VHFB - INICIO - SE REALIZA EL CALCULO DEL IVA SEGUN GASTOS
				  //-------------------------------------------------------------------------------------------------------------				
				 IF  gd_descuento = 0 THEN
					ll_iva_r_2 				= round(ll_gasto_mant_2 * (idb_iva - 1),0)		// CALCULO DEL IVA CLASICO
				ELSE

					ld_monto_descuento = ll_gasto_mant_2 * (gd_descuento/100)
					
					ll_iva_r_2 				= round((ll_gasto_mant_2 - ld_monto_descuento) * (idb_iva - 1),0)		// CALCULO DEL IVA CLASICO
				END IF 
				  //-------------------------------------------------------------------------------------------------------------
				  //  VHFB - TERMINO - SE REALIZA EL CALCULO DEL IVA SEGUN MORA GASTOS 
				  //-------------------------------------------------------------------------------------------------------------		
				
				
				ll_new_iva_2 			= tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob = 'X'", 1, tab_ingreso.tp_be.dw_detalle_be.rowcount())
				if ll_new_iva_2 > 0 then
					tab_ingreso.tp_be.dw_detalle_be.scrolltorow(ll_new_iva_2)
				else
					ll_new_iva_2		= tab_ingreso.tp_be.dw_detalle_be.insertrow(0)
				end if
				tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_iva_2,'tipo_cob', 'X')
				if tab_ingreso.tp_be.rb_be_afecta.checked=true then
					tab_ingreso.tp_be.dw_detalle_be.SetItem(ll_new_iva_2, "iva", idb_iva)
				end if
				tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_iva_2,'cantidad', 1)
				ls_moneda_insert_2	= '1'
				if ls_moneda_insert_2 = '1' then
					tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_iva_2,'monto_uf', round( ll_iva_r_2 / gd_uf,4))
					tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_iva_2,'monto', ll_iva_r_2)
				end if
				tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_iva_2,'uf',gd_uf)
				tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_iva_2,'estado','S')
				tab_ingreso.tp_be.dw_detalle_be.SetItem(ll_new_iva_2, "moneda",'P')
		  else
				ll_iva_r_2 			= 0
		  end if
	end if
	  //Fin script nuevo IVA Autor MM 22/12/2022
end if
end subroutine

public subroutine wf_cargar_dwmp (double ld_monto, double ldb_uf, datetime ldt_fecha_hoy, string ls_tipo_cob, string ls_tipo_cob_dscto);Double	ldb_acum_pie,ldb_iva_acum,ldb_porc_pie_mp, ldb_precio_mp, ldb_precio_mpdet, ldb_iva_mpdet, ldb_porc_pie_mp_det, ldb_porcsubtotimp_mpdet,ll_val_item,ll_val_total,&
			ldb_precio_uni_ctto,ldb_pie_uni_ctto,ldb_iva_p,ll_total_ctto,ll_total_pago_ctto,ll_folio,ll_max_folio_new,ll_iva_peso,ll_tot_peso,ll_descuento_mult,ll_rut_mult,ll_mpnumero_mult,&
			ll_mpnro_cupon_mult,ll_nro_cupon_mult,ldb_nufdia_mult,ldb_totaliva_mult,ldb_totalcto_mult,ldb_cal_uf,ll_total_ctto_mult,ll_total_pago_mp
Long		ll_item,ll_fila_mov_existe,ll_fila,ll_new_reg,ll_tot_reg_mp,ll_indi_mp,ll_tot_reg_mult,ll_fila_m,ll_filas_mp,ll_indi_filas_mp,ll_dif_pago,ll_fila_s
String		ls_base_mpdet,ls_ctto,ls_serie,ls_tipo_doc,ls_moneda_ctto,ls_moneda,ls_ctto_mult,ls_mpbase_mult,ls_mpserie_mult,ls_tipodoc_mult

if gl_sw_mp = 0 and gl_codigo_mp > 0 then
	ldb_acum_pie							= 0
	ldb_iva_acum							= 0
	ll_item									= 0
	DECLARE x3 CURSOR FOR  
	SELECT 	"MPPRODUCTO"."PORCENTAJEPIE",  	"MPPRODUCTO"."PRECIO",   	"MPPRODUCTODET"."BASE",   	"MPPRODUCTODET"."PRECIO",   	"MPPRODUCTODET"."IVA",   	"MPPRODUCTODET"."PORCENTAJEPIE" ,   	"MPPRODUCTODET"."PORCSUBTOTALIMP" 
	FROM 	"MPPRODUCTO",   	"MPPRODUCTODET"  
	WHERE 	( "MPPRODUCTO"."CODIGOMP" = "MPPRODUCTODET"."CODIGOMP" ) and  
				( "MPPRODUCTO"."CODIGOMP" = :gl_codigo_mp )   
	USING	Trans_2;
	open x3;
	if Trans_2.sqlcode=0 then
		do while Trans_2.sqlcode=0
			fetch x3 into :ldb_porc_pie_mp, :ldb_precio_mp,	:ls_base_mpdet, :ldb_precio_mpdet, :ldb_iva_mpdet, :ldb_porc_pie_mp_det, :ldb_porcsubtotimp_mpdet;
			if not isnull(ls_base_mpdet) then
				if gs_rezago='S' then
					if gs_conexion	 = "Parque El Prado" then
						ls_ctto				= 'MG'+string(0)
						ls_serie				= 'G'
					elseif gs_conexion	= "Parque La Foresta" then
						ls_ctto				= 'MN'+string(0)
						ls_serie				= 'N'
					end if
					
					ll_fila_mov_existe		= dw_multiproducto.find("tipo_mov='"+ls_tipo_cob+"'",1,dw_multiproducto.rowcount())
					if ll_fila_mov_existe=0 then
						ll_fila					= dw_multiproducto.insertrow(0)
						ll_item ++
					else
						ll_fila					= ll_fila_mov_existe
						ll_item				= dw_multiproducto.getitemnumber(ll_fila,'item')
					end if
					if ll_fila > 0 then
						dw_multiproducto.setitem(ll_fila,'item',ll_item)
						dw_multiproducto.setitem(ll_fila,'contrato',ls_ctto)
						dw_multiproducto.setitem(ll_fila,'rut',gi_rut)
						dw_multiproducto.setitem(ll_fila,'cantidad',1)
						dw_multiproducto.setitem(ll_fila,'tipo_mov',ls_tipo_cob)
						dw_multiproducto.setitem(ll_fila,'mpbase','M')
						dw_multiproducto.setitem(ll_fila,'mpserie','G')
						dw_multiproducto.setitem(ll_fila,'mpnumero',0)
						dw_multiproducto.setitem(ll_fila,'nufdia',gd_uf)
						dw_multiproducto.setitem(ll_fila,'cod_otro_dscto',ls_tipo_cob_dscto)
						
						if ((ls_base_mpdet='O' or ls_base_mpdet='U') and (ls_tipo_cob='E' or ls_tipo_cob='A' or ls_tipo_cob='U' or ls_tipo_cob='Q')) then
							dw_multiproducto.setitem(ll_fila,'tipodoc','CI')
						else
							dw_multiproducto.setitem(ll_fila,'tipodoc','BA')
						end if
					end if
				end if
				if ll_fila > 0 then
					if ll_fila_mov_existe >= 0 then
						if tab_ingreso.tp_ci.rb_ci_peso.checked=true then
							ll_val_item				= dw_multiproducto.getitemnumber(ll_fila,'montoitem')
							ll_val_total				= dw_multiproducto.getitemnumber(ll_fila,'totalitem')
							if isnull(ll_val_item) then ll_val_item=0
							if isnull(ll_val_total) then ll_val_total=0
							ldb_precio_uni_ctto	= ll_val_item + round(((ld_monto * ldb_porcsubtotimp_mpdet) / 100),0)
							dw_multiproducto.setitem(ll_fila,'montoitem',ldb_precio_uni_ctto)
							dw_multiproducto.setitem(ll_fila,'totalitem',ldb_precio_uni_ctto)
							
							dw_multiproducto.setitem(ll_fila,'monto_uf',round(ldb_precio_uni_ctto / ldb_uf,4))
							dw_multiproducto.setitem(ll_fila,'total_uf',round(ldb_precio_uni_ctto / ldb_uf,4))
							dw_multiproducto.setitem(ll_fila,'moneda','1')
							dw_multiproducto.setitem(ll_fila,'tipomoneda','PESO')
						elseif tab_ingreso.tp_ci.rb_ci_uf.checked=true then
							ll_val_item				= dw_multiproducto.getitemnumber(ll_fila,'monto_uf')
							ll_val_total				= dw_multiproducto.getitemnumber(ll_fila,'total_uf')
							if isnull(ll_val_item) then ll_val_item=0
							if isnull(ll_val_total) then ll_val_total=0
							ldb_precio_uni_ctto	= ll_val_item + round(((ld_monto * ldb_porcsubtotimp_mpdet) / 100),4)
							dw_multiproducto.setitem(ll_fila,'monto_uf',ldb_precio_uni_ctto)
							dw_multiproducto.setitem(ll_fila,'total_uf',ldb_precio_uni_ctto)
							
							dw_multiproducto.setitem(ll_fila,'montoitem',round(ldb_precio_uni_ctto * ldb_uf,0))
							dw_multiproducto.setitem(ll_fila,'totalitem',round(ldb_precio_uni_ctto * ldb_uf,0))
							dw_multiproducto.setitem(ll_fila,'moneda','2')
							dw_multiproducto.setitem(ll_fila,'tipomoneda','UF')
						end if
					else
						if tab_ingreso.tp_ci.rb_ci_peso.checked=true then
							ldb_precio_uni_ctto	= round(((ld_monto * ldb_porcsubtotimp_mpdet) / 100),0)
							dw_multiproducto.setitem(ll_fila,'montoitem',ldb_precio_uni_ctto)
							dw_multiproducto.setitem(ll_fila,'totalitem',ldb_precio_uni_ctto)
							
							dw_multiproducto.setitem(ll_fila,'monto_uf',round(ldb_precio_uni_ctto / ldb_uf,4))
							dw_multiproducto.setitem(ll_fila,'total_uf',round(ldb_precio_uni_ctto / ldb_uf,4))
							dw_multiproducto.setitem(ll_fila,'moneda','1')
							dw_multiproducto.setitem(ll_fila,'tipomoneda','PESO')
						elseif tab_ingreso.tp_ci.rb_ci_uf.checked=true then
							ldb_precio_uni_ctto	= round(((ld_monto * ldb_porcsubtotimp_mpdet) / 100),4)
							dw_multiproducto.setitem(ll_fila,'monto_uf',ldb_precio_uni_ctto)
							dw_multiproducto.setitem(ll_fila,'total_uf',ldb_precio_uni_ctto)
							
							dw_multiproducto.setitem(ll_fila,'montoitem',round(ldb_precio_uni_ctto * ldb_uf,0))
							dw_multiproducto.setitem(ll_fila,'totalitem',round(ldb_precio_uni_ctto * ldb_uf,0))
							dw_multiproducto.setitem(ll_fila,'moneda','2')
							dw_multiproducto.setitem(ll_fila,'tipomoneda','UF')
						end if
					end if

					if ll_fila_mov_existe >= 0 then
						ldb_pie_uni_ctto			= ldb_precio_uni_ctto		//round(((ldb_precio_uni_ctto * ldb_porc_pie_mp_det) / 100),4)
						ldb_acum_pie				= ldb_acum_pie + ldb_pie_uni_ctto
						
						if ldb_iva_mpdet > 0 then
							if tab_ingreso.tp_ci.rb_ci_peso.checked=true then
								ldb_iva_p 			= round(ldb_pie_uni_ctto * (idb_iva - 1),0)
								dw_multiproducto.setitem(ll_fila,'totalcto',ldb_precio_uni_ctto + ldb_iva_p)
								dw_multiproducto.setitem(ll_fila,'totaliva',ldb_iva_p)
							elseif tab_ingreso.tp_ci.rb_ci_uf.checked=true then
								ldb_iva_p 			= round(ldb_pie_uni_ctto * (idb_iva - 1),4)
								dw_multiproducto.setitem(ll_fila,'totalcto',round(round((ldb_precio_uni_ctto + ldb_iva_p),4) * ldb_uf,0))
								dw_multiproducto.setitem(ll_fila,'totaliva',round(ldb_iva_p * ldb_uf,0))
							end if
							ldb_iva_acum			= ldb_iva_p		//ldb_iva_acum + ldb_iva_p
						else
							dw_multiproducto.setitem(ll_fila,'totaliva',0)
							if tab_ingreso.tp_ci.rb_ci_peso.checked=true then
								dw_multiproducto.setitem(ll_fila,'totalcto',ldb_precio_uni_ctto)
							elseif tab_ingreso.tp_ci.rb_ci_uf.checked=true then
								dw_multiproducto.setitem(ll_fila,'totalcto',round(ldb_precio_uni_ctto * ldb_uf,0))
							end if
						end if
					else
						ldb_pie_uni_ctto			= ldb_pie_uni_ctto + ldb_precio_uni_ctto		//round(((ldb_precio_uni_ctto * ldb_porc_pie_mp_det) / 100),4)
						ldb_acum_pie				= ldb_acum_pie+ ldb_acum_pie + ldb_pie_uni_ctto
						
						if ldb_iva_mpdet > 0 then
							if tab_ingreso.tp_ci.rb_ci_peso.checked=true then
								ldb_iva_p 			= ldb_iva_p + round(ldb_pie_uni_ctto * (idb_iva - 1),0)
								dw_multiproducto.setitem(ll_fila,'totalcto',ldb_precio_uni_ctto + ldb_iva_p)
								dw_multiproducto.setitem(ll_fila,'totaliva',ldb_iva_p)
							elseif tab_ingreso.tp_ci.rb_ci_uf.checked=true then
								ldb_iva_p 			= ldb_iva_p + round(ldb_pie_uni_ctto * (idb_iva - 1),4)
								dw_multiproducto.setitem(ll_fila,'totalcto',round(round((ldb_precio_uni_ctto + ldb_iva_p),4) * ldb_uf,0))
								dw_multiproducto.setitem(ll_fila,'totaliva',round(ldb_iva_p * ldb_uf,0))
							end if
							ldb_iva_acum			= ldb_iva_p		//ldb_iva_acum + ldb_iva_p
						else
							dw_multiproducto.setitem(ll_fila,'totaliva',0)
							if tab_ingreso.tp_ci.rb_ci_peso.checked=true then
								dw_multiproducto.setitem(ll_fila,'totalcto',ldb_precio_uni_ctto)
							elseif tab_ingreso.tp_ci.rb_ci_uf.checked=true then
								dw_multiproducto.setitem(ll_fila,'totalcto',round(ldb_precio_uni_ctto * ldb_uf,0))
							end if
						end if
					end if
					dw_multiproducto.accepttext()
					ls_tipo_doc					= dw_multiproducto.getitemstring(ll_fila,'tipodoc')
					ll_total_ctto					= dw_multiproducto.getitemnumber(ll_fila,'totalcto')
					ls_moneda_ctto			= dw_multiproducto.getitemstring(ll_fila,'moneda')
					if ls_moneda_ctto='1' then
						ll_total_pago_ctto		= ll_total_ctto
					else
						ll_total_pago_ctto		= round((ll_total_ctto / ldb_uf),4)
					end if
					dw_multiproducto.setitem(ll_fila,'mpnro_cupon',gl_folio)
					if ls_tipo_doc='CI' then
						ll_max_folio_new		= gl_folio
						f_crear_folio_web_mp(1, il_rut, ls_base_mpdet, ls_serie, 0, ll_max_folio_new, ldt_fecha_hoy, 'V', ls_tipo_cob, ls_tipo_doc, ll_max_folio_new, ldt_fecha_hoy, ll_total_pago_ctto, ll_total_ctto, 0, 0, 1, is_dv, 'M', ls_serie, 0, ls_moneda_ctto, gs_user, gs_caja, ll_max_folio_new)
					else
						select id_cuponeras_web.nextval into :ll_max_folio_new from dual;
						f_crear_folio_web_mp(1, il_rut, ls_base_mpdet, ls_serie, 0, ll_max_folio_new, ldt_fecha_hoy, 'V', ls_tipo_cob, ls_tipo_doc, ll_max_folio_new, ldt_fecha_hoy, ll_total_pago_ctto, ll_total_ctto, 0, 0, 1, is_dv, 'M', ls_serie, 0, ls_moneda_ctto, gs_user, gs_caja, ll_max_folio_new)
					end if
				
				end if
			end if
			if ldb_iva_p > 0 then
				if gs_rezago='S' then
//										ll_fila						= dw_detalle_ci.insertrow(0)
					if gs_conexion = "Parque El Prado" then
						ls_ctto				= 'MG'+string(0)
					elseif gs_conexion	= "Parque La Foresta" then
						ls_ctto				= 'MN'+string(0)
					end if
					ll_fila						= dw_multiproducto.find("tipo_mov='D'",1,dw_multiproducto.rowcount())
					if ll_fila = 0 then
						ll_fila					= dw_multiproducto.insertrow(0)
						ll_item ++
						dw_multiproducto.setitem(ll_fila,'item',ll_item)
					end if
					if ll_fila > 0 then
						dw_multiproducto.setitem(ll_fila,'contrato',ls_ctto)
						dw_multiproducto.setitem(ll_fila,'rut',gi_rut)
						dw_multiproducto.setitem(ll_fila,'cantidad',1)
						dw_multiproducto.setitem(ll_fila,'mpbase','M')   
						dw_multiproducto.setitem(ll_fila,'mpserie','G')    
						dw_multiproducto.setitem(ll_fila,'mpnumero',0)
						dw_multiproducto.setitem(ll_fila,'tipo_mov','V')
						dw_multiproducto.setitem(ll_fila,'cod_otro_dscto',ls_tipo_cob_dscto)
	//										dw_multiproducto.setitem(ll_fila,'mpnro_cupon'
	//										dw_multiproducto.setitem(ll_fila,'nro_cupon'
						if ((ls_base_mpdet='O' or ls_base_mpdet='U') and (ls_tipo_cob='E' or ls_tipo_cob='A' or ls_tipo_cob='U' or ls_tipo_cob='Q')) then
							dw_multiproducto.setitem(ll_fila,'tipodoc','CI')
						else
							dw_multiproducto.setitem(ll_fila,'tipodoc','BA')
						end if
						if tab_ingreso.tp_ci.rb_ci_peso.checked=true then
							dw_multiproducto.setitem(ll_fila,'montoitem',round(((ld_monto * ldb_porcsubtotimp_mpdet) / 100),0))
							dw_multiproducto.setitem(ll_fila,'totalcto',ldb_precio_uni_ctto + ldb_iva_p)
							ldb_precio_uni_ctto	= round(ldb_iva_p,0)
							dw_multiproducto.setitem(ll_fila,'montoitem',ldb_precio_uni_ctto)
							dw_multiproducto.setitem(ll_fila,'totalitem',ldb_precio_uni_ctto)
							dw_multiproducto.setitem(ll_fila,'monto_uf',round(ldb_precio_uni_ctto / ldb_uf,4))
							dw_multiproducto.setitem(ll_fila,'total_uf',round(ldb_precio_uni_ctto / ldb_uf,4))
							dw_multiproducto.setitem(ll_fila,'moneda','1')
							dw_multiproducto.setitem(ll_fila,'tipomoneda','PESO')
							dw_multiproducto.setitem(ll_fila,'totaliva',ldb_iva_acum)
							
						elseif tab_ingreso.tp_ci.rb_ci_uf.checked=true then
							dw_multiproducto.setitem(ll_fila,'montoitem',round(round(((ld_monto * ldb_porcsubtotimp_mpdet) / 100),4) * ldb_uf,0) )
							dw_multiproducto.setitem(ll_fila,'totalcto',round(round((ldb_precio_uni_ctto + ldb_iva_p),4) * ldb_uf,0))
							ldb_precio_uni_ctto	= round(ldb_iva_p,4)
							dw_multiproducto.setitem(ll_fila,'monto_uf',ldb_precio_uni_ctto)
							dw_multiproducto.setitem(ll_fila,'total_uf',ldb_precio_uni_ctto)
							dw_multiproducto.setitem(ll_fila,'montoitem',round(ldb_precio_uni_ctto * ldb_uf,0))
							dw_multiproducto.setitem(ll_fila,'totalitem',round(ldb_precio_uni_ctto * ldb_uf,0))
							dw_multiproducto.setitem(ll_fila,'moneda','2')
							dw_multiproducto.setitem(ll_fila,'tipomoneda','UF')
							dw_multiproducto.setitem(ll_fila,'totaliva', round(ldb_iva_acum * ldb_uf,0))
						end if
						dw_multiproducto.setitem(ll_fila,'nufdia',gd_uf)
						dw_multiproducto.setitem(ll_fila,'mpnro_cupon',ll_folio)
					end if
//										dw_multiproducto.setitem(ll_fila,'totalcto',ldb_precio_uni_ctto)
				end if
			end if
			setnull(ls_base_mpdet)
			ldb_iva_p	= 0
		loop
		
	end if
	close x3;

	if ls_tipo_cob='S' then
		if ld_monto <> 0 then
			ll_tot_reg_mult				= dw_multiproducto.rowcount()
			if ll_tot_reg_mult > 0 then
				ll_fila_m					= dw_multiproducto.insertrow(0)
				ll_descuento_mult		= ld_monto * -1
				ls_ctto_mult				= dw_multiproducto.getitemstring(1,'contrato')
				ll_rut_mult				= dw_multiproducto.getitemnumber(1,'rut')
				ls_mpbase_mult		= dw_multiproducto.getitemstring(1,'mpbase')
				ls_mpserie_mult		= dw_multiproducto.getitemstring(1,'mpserie')
				ll_mpnumero_mult		= dw_multiproducto.getitemnumber(1,'mpnumero')
				ll_mpnro_cupon_mult	= dw_multiproducto.getitemnumber(1,'mpnro_cupon')
				ll_nro_cupon_mult		= dw_multiproducto.getitemnumber(1,'nro_cupon')
				ls_tipodoc_mult			= dw_multiproducto.getitemstring(1,'tipodoc')
				ldb_nufdia_mult		= dw_multiproducto.getitemnumber(1,'nufdia')
				ldb_totaliva_mult		= dw_multiproducto.getitemnumber(1,'totaliva')
				ldb_totalcto_mult		= dw_multiproducto.getitemnumber(1,'totalcto')
				
				ll_total_ctto_mult		= ldb_totalcto_mult - ld_monto
				ll_filas_mp				= dw_multiproducto.rowcount()
				ll_total_pago_mp		= tab_ingreso.tp_ci.dw_gastos_ci.getitemnumber(1,'c_total')
				ll_dif_pago				= ll_total_pago_mp - ll_total_ctto_mult
				ll_total_ctto_mult		= ll_total_ctto_mult + ll_dif_pago
				if ll_filas_mp > 0 then
					for ll_indi_filas_mp=1 to ll_filas_mp
						dw_multiproducto.setitem(ll_indi_filas_mp,'totalcto',ll_total_ctto_mult)
					next
					dw_multiproducto.accepttext()
				end if
				
				ldb_cal_uf				= round(ll_descuento_mult / gd_uf,4)
				dw_multiproducto.setitem(ll_fila_m,'item',ll_fila_m)
				dw_multiproducto.setitem(ll_fila_m, 'monto_uf', ldb_cal_uf)
				dw_multiproducto.setitem(ll_fila_m,'total_uf',ldb_cal_uf)
				dw_multiproducto.setitem(ll_fila_m,'moneda','1')
				dw_multiproducto.setitem(ll_fila_m,'tipomoneda','PESO')
				dw_multiproducto.setitem(ll_fila_m,'montoitem',ll_descuento_mult)
				dw_multiproducto.setitem(ll_fila_m,'totalitem',ll_descuento_mult)
				dw_multiproducto.setitem(ll_fila_m,'tipo_mov','S')
				dw_multiproducto.setitem(ll_fila_m,'cantidad',1)
				
				dw_multiproducto.setitem(ll_fila_m,'contrato',ls_ctto_mult)
				dw_multiproducto.setitem(ll_fila_m,'rut',ll_rut_mult)
				dw_multiproducto.setitem(ll_fila_m,'mpbase',ls_mpbase_mult)
				dw_multiproducto.setitem(ll_fila_m,'mpserie',ls_mpserie_mult)
				dw_multiproducto.setitem(ll_fila_m,'mpnumero',ll_mpnumero_mult)
				dw_multiproducto.setitem(ll_fila_m,'mpnro_cupon',ll_mpnro_cupon_mult)
				dw_multiproducto.setitem(ll_fila_m,'nro_cupon',ll_nro_cupon_mult)
				dw_multiproducto.setitem(ll_fila_m,'tipodoc',ls_tipodoc_mult)
				dw_multiproducto.setitem(ll_fila_m,'nufdia',ldb_nufdia_mult)
				dw_multiproducto.setitem(ll_fila_m,'totaliva',ldb_totaliva_mult)
				dw_multiproducto.setitem(ll_fila_m,'cod_otro_dscto',ls_tipo_cob_dscto)
				
				dw_multiproducto.accepttext()
				ldb_totalcto_mult		= dw_multiproducto.getitemnumber(1,'totalcto')
				dw_multiproducto.setitem(ll_fila_m,'totalcto',ll_total_ctto_mult)
				dw_multiproducto.accepttext()
			end if
		end if
	end if
	if ll_fila > 0 then
		if ldb_iva_acum > 0 then
			ll_new_reg					= tab_ingreso.tp_ci.dw_detalle_ci.find("tipo_cob='D'",1,tab_ingreso.tp_ci.dw_detalle_ci.rowcount())
			if ll_new_reg = 0 then
				ll_new_reg				= tab_ingreso.tp_ci.dw_detalle_ci.insertrow(0)
			end if
			tab_ingreso.tp_ci.dw_detalle_ci.setitem(ll_new_reg,'tipo_cob', 'D')
			tab_ingreso.tp_ci.dw_detalle_ci.SetItem(ll_new_reg, "iva", idb_iva)
			tab_ingreso.tp_ci.dw_detalle_ci.setitem(ll_new_reg,'cantidad', 1)
			if tab_ingreso.tp_ci.rb_ci_peso.checked=true then
				ls_moneda				= 'P'
				tab_ingreso.tp_ci.dw_detalle_ci.setitem(ll_new_reg,'monto_uf', round( ldb_iva_acum / ldb_uf,4))
				tab_ingreso.tp_ci.dw_detalle_ci.setitem(ll_new_reg,'monto', ldb_iva_acum)
				ll_iva_peso				= ldb_iva_acum
			elseif tab_ingreso.tp_ci.rb_ci_uf.checked=true then
				ls_moneda				= 'U'
				tab_ingreso.tp_ci.dw_detalle_ci.setitem(ll_new_reg,'monto_uf', ldb_iva_acum)
				tab_ingreso.tp_ci.dw_detalle_ci.setitem(ll_new_reg,'monto', round( ldb_iva_acum * ldb_uf,0))
				ll_iva_peso				=  round( ldb_iva_acum * ldb_uf,0)

			end if
			tab_ingreso.tp_ci.dw_detalle_ci.setitem(ll_new_reg,'uf',gd_uf)
			tab_ingreso.tp_ci.dw_detalle_ci.setitem(ll_new_reg,'estado','S')
		//	gd_uf
			tab_ingreso.tp_ci.dw_detalle_ci.SetItem(ll_new_reg, "moneda",ls_moneda)
		end if
		if isnull(ll_iva_peso) or ll_iva_peso=0 then ll_iva_peso=0
		ll_tot_reg_mp		= dw_multiproducto.rowcount()
		if ll_tot_reg_mp> 0 then
			ll_tot_peso		= dw_multiproducto.getitemnumber(1,'c_tot_peso')
			for ll_indi_mp=1 to ll_tot_reg_mp
				dw_multiproducto.setitem(ll_indi_mp,'totalcto',ll_tot_peso)
				dw_multiproducto.setitem(ll_indi_mp,'totaliva',ll_iva_peso)
			next
		end if
	end if
	
	
end if
end subroutine

public function integer wf_busca_descuento_web ();integer li_existe
li_existe = 0 


SELECT VALOR_dESCUENTO
INTO 
	 :li_existe
FROM 
	 CADENA A
JOIN 
	 WEB_DESCUENTOS_DETALLE B 
	 ON A.CODIGO = B.BASE
	 AND A.SERIE = B.SERIE
	 AND A.NUMERO = B.NUMERO
	 AND A.CODIGO_TRAMO = B.CODIGO_TRAMO
JOIN 
	 WEB_DESCUENTOS_TRAMO C
	 ON C.CODIGO_TRAMO = B.CODIGO_TRAMO
WHERE 
	 C.ESTADO = 'A'
	 AND B.ESTADO_REG = 'V'
	 AND A.NUMERO = :gi_numero
	 AND A.SERIE = :gs_serie
	 AND A.CODIGO = :gs_base
USING SQLCA;


if isnull(li_existe) then
	li_existe = 0 
end if 


ii_desc_web = li_existe

return li_existe
end function

