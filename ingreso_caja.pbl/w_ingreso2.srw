this.sle_1=create sle_1
this.st_fuera_plazo=create st_fuera_plazo
this.dw_impresion=create dw_impresion
this.cb_abono=create cb_abono
this.cb_buscar_cliente=create cb_buscar_cliente
this.st_aviso_ap=create st_aviso_ap
this.dw_detalle_pago_cupon2=create dw_detalle_pago_cupon2
this.dw_dias_mora=create dw_dias_mora
this.cb_ver_cuenta=create cb_ver_cuenta
