event clicked;Double	ll_monto_uf,ll_nulo
String	ls_tipo_cob
setnull(ll_nulo)
if dw_detalle_ci.getrow()>0 then
	ls_tipo_cob		= dw_detalle_ci.getitemstring(dw_detalle_ci.getrow(),'tipo_cob')
	ll_monto_uf		= dw_detalle_ci.getitemnumber(dw_detalle_ci.getrow(), "monto_uf")
	if this.checked=true then 
		if ll_monto_uf>0 then dw_detalle_ci.setitem(dw_detalle_ci.getrow(), "monto_uf",ll_nulo)
		dw_detalle_ci.SetItem(dw_detalle_ci.getrow(), "moneda",'P')
	end if
	dw_detalle_ci.accepttext()
	dw_detalle_ci.triggerevent(itemchanged!)
	dw_detalle_ci.setfocus()
	dw_detalle_ci.scrolltorow(dw_detalle_ci.getrow())
	dw_detalle_ci.setcolumn('monto')
//	wf_calcular_interes(ls_tipo_cob)
end if
end event

