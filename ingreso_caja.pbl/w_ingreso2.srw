tab_ingreso.tp_boletas.st_help_eliminar2.visible	= false
//st_fuera_plazo.visible										= true
end event

event close;Long		ll_folio

CHOOSE CASE tab_ingreso.SelectedTab
	CASE 2 //Comprobante Ingreso
		ll_folio		= long(tab_ingreso.tp_ci.sle_numero_ci.text)
		if tab_ingreso.tp_ci.cbx_manual_ci.checked = false then
			if ll_folio > 0 then
				wf_limpiar_boleta_electronica(ll_folio)
			end if
		end if
	CASE 3 //Boleta/Factura
		ll_folio		= long(tab_ingreso.tp_boletas.sle_numero_bl.text)
		if tab_ingreso.tp_boletas.cbx_manual_factura.checked = false then
			if ll_folio >= 0 then
				wf_limpiar_boleta_electronica(ll_folio)
			end if
		end if
END CHOOSE

Disconnect using Trans_1;
Disconnect using Trans_2;
Disconnect using Trans_5;
Disconnect using Trans_6;
Disconnect using Trans_7;
gs_caja				= is_cod_caja
cb_cerrar.triggerevent(clicked!)
end event

