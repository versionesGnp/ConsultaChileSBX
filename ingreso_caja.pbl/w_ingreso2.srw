event clicked;string		ls_total,ls_digito,ls_tipo_cob,ls_string
Long		ll_largo,ll_monto,ll_digito,ll_sumar,ll_restar,fila,ll_tot_reg,ll_fila,ll_total_monto,ll_total_mora,ll_total_gasto

dw_detalle_be.accepttext()
ll_tot_reg			= dw_detalle_be.rowcount()
if gs_rezago='S' then rb_be_peso.checked=true
if ll_tot_reg > 0 then
	ll_monto			= round(dw_gastos_be.getitemnumber(1,'c_total'),0)
	if ll_monto > 0 then 
		il_modif		= 0
		ls_string		= "tipo_cob_otro = '144' or tipo_cob_otro = '76' "
		ll_fila			= dw_detalle_be.Find(ls_string,  1, ll_tot_reg)
		if ll_fila > 0 then
			ls_tipo_cob	= dw_detalle_be.getitemstring(fila,'tipo_cob')
			dw_detalle_be.DeleteRow(ll_fila)
			wf_calcular_interes(ls_tipo_cob)
			dw_detalle_be.accepttext()
		else
			ls_total		= string(round(dw_gastos_be.getitemnumber(1,'c_total'),0))
			ll_largo		= len(ls_total)
			ls_digito		= mid(ls_total,ll_largo ,1)
			ll_digito		= long(ls_digito)
			if ll_digito > 5 and ll_digito <= 9 then
				ll_sumar	= 10 - ll_digito
				fila 							= dw_detalle_be.InsertRow(0)
				dw_detalle_be.scrolltorow(fila)
				dw_detalle_be.SetItem(fila, "uf", gd_uf)
				dw_detalle_be.SetItem(fila, "folio", 0)
				dw_detalle_be.SetItem(fila, "estado", 'N')
				dw_detalle_be.SetItem(fila, "uf", gd_uf)
				dw_detalle_be.SetItem(fila, 'cantidad',1)
				dw_detalle_be.SetItem(fila, 'base',gs_base)
				dw_detalle_be.SetItem(fila, 'serie',gs_serie)
				dw_detalle_be.SetItem(fila, 'numero',gi_numero)
//				if rb_be_uf.checked=true then
//					dw_detalle_be.SetItem(fila, "moneda",'U')
//				else
					dw_detalle_be.SetItem(fila, "moneda",'P')
//				end if
				dw_detalle_be.SetItem(fila,'tipo_cob','L')
				dw_detalle_be.SetItem(fila,'tipo_cob_otro','76')
				dw_detalle_be.SetItem(fila,'monto',ll_sumar)
				wf_calcular_interes('L')
				
			elseif ll_digito > 0 and ll_digito <= 5 then
				ll_restar	= ll_digito
				fila 							= dw_detalle_be.InsertRow(0)
				dw_detalle_be.scrolltorow(fila)
				dw_detalle_be.SetItem(fila, "uf", gd_uf)
				dw_detalle_be.SetItem(fila, "folio", 0)
				dw_detalle_be.SetItem(fila, "estado", 'N')
				dw_detalle_be.SetItem(fila, "uf", gd_uf)
				dw_detalle_be.SetItem(fila, 'cantidad',1)
				dw_detalle_be.SetItem(fila, 'base',gs_base)
				dw_detalle_be.SetItem(fila, 'serie',gs_serie)
				dw_detalle_be.SetItem(fila, 'numero',gi_numero)
//				if rb_be_uf.checked=true then
//					dw_detalle_be.SetItem(fila, "moneda",'U')
//				else
					dw_detalle_be.SetItem(fila, "moneda",'P')
//				end if
				dw_detalle_be.SetItem(fila,'tipo_cob','S')
				dw_detalle_be.SetItem(fila,'tipo_cob_otro','144')
				dw_detalle_be.SetItem(fila,'monto',ll_restar)
				wf_calcular_interes('S')
			else
				cbx_paga_ef_be.checked	= false
			end if
//			w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1,'mora', ROUND(w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.Getitemnumber(1,'mora_cred') + w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.Getitemnumber(1,'mora_mant'),0))
//			w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1,'gastos_cob',ROUND(w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.Getitemnumber(1,'gasto_cred') + w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.Getitemnumber(1,'gasto_mant'),0))
//			ll_total_monto					= ROUND(w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.GetItemNumber(1,"c_subtotal_total"),0)
//			w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1,"Subtotal", ll_total_monto)
//			w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.accepttext()
		end if
		dw_detalle_be.accepttext()
	else
		messagebox("Advertencia","Debe ingresar Item de Pago")
		cbx_paga_ef_be.checked			= false
	end if
else
	cbx_paga_ef_be.checked				= false
end if
if isnull(w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.Getitemnumber(1,'mora_cred')) then w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.setitem(1,'mora_cred',0)
if isnull(w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.Getitemnumber(1,'gasto_cred')) then w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.setitem(1,'gasto_cred',0)
if isnull(w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.Getitemnumber(1,'mora_mant')) then w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.setitem(1,'mora_mant',0)
if isnull(w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.Getitemnumber(1,'gasto_mant')) then w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.setitem(1,'gasto_mant',0)
ll_total_mora					= w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.Getitemnumber(1,'mora_cred') + w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.Getitemnumber(1,'mora_mant')
ll_total_gasto					= w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.Getitemnumber(1,'gasto_cred') + w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.Getitemnumber(1,'gasto_mant')
w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1,'mora', ROUND(ll_total_mora,0))
w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1,'gastos_cob',ROUND(ll_total_gasto,0))
ll_total_monto					= ROUND(w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.GetItemNumber(1,"c_subtotal_total"),0)
w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1,"Subtotal", ll_total_monto)
w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.accepttext()
end event

type dw_be_buscar_cliente from datawindow within tp_be
event ue_mousemove pbm_mousemove
integer x = 14
integer y = 72
integer width = 2560
integer height = 196
integer taborder = 30
string title = "none"
string dataobject = "de_buscar_cliente"
boolean border = false
boolean livescroll = true
end type

event ue_mousemove;String		ls_numero,ls_ap_pat

wf_no_mostrar_help_be()
if is_opcion='FP' and (gs_depto='T' or gs_depto='I') then st_fuera_plazo.visible = true
il_rut 			= long(tab_ingreso.tp_be.dw_be_buscar_cliente.GetItemString(1,"rl_rut"))
is_dv			= tab_ingreso.tp_be.dw_be_buscar_cliente.GetItemString(1,"dv")
ls_numero	= tab_ingreso.tp_be.dw_be_buscar_cliente.getitemstring(1,'rn_contrato')
ls_ap_pat	= tab_ingreso.tp_be.dw_be_buscar_cliente.getitemstring(1,'rs_a_paterno') 
if isnull(ls_numero) and isnull(ls_ap_pat) and (is_dv='' or isnull(is_dv)) and il_rut > 0 then
	tab_ingreso.tp_be.dw_be_buscar_cliente.setfocus()
	tab_ingreso.tp_be.dw_be_buscar_cliente.setcolumn('dv')
elseif ls_numero='' and ls_ap_pat='' and is_dv='' and il_rut > 0 then
	tab_ingreso.tp_be.dw_be_buscar_cliente.setfocus()
	tab_ingreso.tp_be.dw_be_buscar_cliente.setcolumn('dv')
end if

end event

event itemchanged;string 	is_base, is_serie,ls_fono_p,ls_fono_part,ls_celular,ls_fono_c,ls_fono_pc,ls_fono_cc,ls_string,ls_dv_auto,ls_apellido_paterno,ls_dv,ls_estado,ls_nombre_sol,&
			ls_valida_pagos='S',ls_llave,ls_estado_cadena_2,ls_uso,ls_base_h, ls_serie_h
long 		il_nenc, il_ndat, ll_new,li_opcion,ll_rut_aux,ll_ctas,ll_ctas_pagadas,ll_ctas_pagadas_1,ll_ctas_pagadas_2,ll_estado_carta,ll_count,ll_count_mant,ll_new_reg,&
			ll_cod_parque,ll_ctas_pag_m_2,ll_correlativo,ll_plazo,ll_mora_original,ll_sw_serv,ll_folio_fa,ll_count_ne,ll_res,ll_count_toku,ll_res_toku
Date		ld_fecha_hoy,ldt_fecha_pago
Double	il_numero,ll_numero,ll_rut,ll_monto_pie,ll_cuotas_pie,ldb_valor_cuota,ldb_interes,ldb_gasto,ldb_uf_dia,ll_numero_h
Datetime	ldt_fecha_sol,ldt_fecha_prim,ldt_fecha_activa
INTEGER li_Position

gs_aplica_a = ''
gd_descuento = 0

if isvalid(w_cuenta_corriente_aumento_capacidad) then close(w_cuenta_corriente_aumento_capacidad)
if isvalid(w_cuenta_corriente_contrato_isa) then close(w_cuenta_corriente_contrato_isa)
if isvalid(w_cuenta_corriente_derecho) then close(w_cuenta_corriente_derecho)
if isvalid(w_cuenta_corriente_liberador) then close(w_cuenta_corriente_liberador)
if isvalid(w_cuenta_corriente_oferta) then close(w_cuenta_corriente_oferta)
if isvalid(w_cuenta_corriente_pagare) then close(w_cuenta_corriente_pagare)
if isvalid(w_cuenta_corriente_repactar_cta_mant) then close(w_cuenta_corriente_repactar_cta_mant)
if isvalid(w_cuenta_corriente_funeraria) then close(w_cuenta_corriente_funeraria)
if isvalid(w_listado_contratos) then close(w_listado_contratos)
if isvalid(w_consultar_contato) then close(w_consultar_contato)
this.accepttext()
Setnull(gs_base)
Setnull(gs_serie)
Setnull(gi_numero)
Setnull(gi_rut)
Setnull(gs_grabar_pie)
st_aviso_ap.visible					= false
gs_filtro 								= "cadena_codigo = 'M' OR cadena_codigo = 'O' OR cadena_codigo = 'L' OR cadena_codigo = 'P' OR cadena_codigo = 'D' OR cadena_codigo = 'A' OR cadena_codigo = 'R' OR cadena_codigo = 'C' OR cadena_codigo='F' OR cadena_codigo='G' OR cadena_codigo='U' OR cadena_codigo='V' "

dw_be_buscar_cliente.AcceptText()
il_rut 									= long(tab_ingreso.tp_be.dw_be_buscar_cliente.GetItemString(1,"rl_rut"))
is_dv									= tab_ingreso.tp_be.dw_be_buscar_cliente.GetItemString(1,"dv")	//em_dv_rut.text
ls_dv_auto							= tab_ingreso.tp_be.dw_be_buscar_cliente.getitemstring(1,'cf_obtener_dv')
ls_apellido_paterno 				= tab_ingreso.tp_be.dw_be_buscar_cliente.GetItemString(1,"rs_a_paterno")
ll_numero 							= Double(tab_ingreso.tp_be.dw_be_buscar_cliente.GetItemString(1,"rn_contrato"))
ldt_fecha_pago						= date(st_fecha.text)
if (not isnull(is_dv) and not isnull(ls_dv_auto) and is_dv<>'' and ls_dv_auto<>'' and il_rut > 0) or not isnull(ls_apellido_paterno) or ll_numero > 0  then
	IF il_rut = 0 or isnull(il_rut) THEN
		IF tab_ingreso.tp_be.dw_be_buscar_cliente.GetItemString(1,"rn_contrato") = "" or isnull(tab_ingreso.tp_be.dw_be_buscar_cliente.GetItemString(1,"rn_contrato")) THEN
			gi_tipo_busqueda 			= 2
			gs_apellido_paterno 		= tab_ingreso.tp_be.dw_be_buscar_cliente.GetItemString(1,"rs_a_paterno")
		ELSE 
			gi_numero 					= double(tab_ingreso.tp_be.dw_be_buscar_cliente.GetItemString(1,"rn_contrato"))
			gi_tipo_busqueda 			= 0
		END IF
	ELSE 
		gi_rut 							= long(tab_ingreso.tp_be.dw_be_buscar_cliente.GetItemString(1,"rl_rut"))
		gi_tipo_busqueda 				= 1
	END IF
	if is_dv <> ls_dv_auto and not isnull(is_dv) and not isnull(ls_dv_auto) and is_dv<>'' and ls_dv_auto<>'' then
		messagebox("Advertencia","Rut Inválido")
		tab_ingreso.tp_be.dw_be_buscar_cliente.setfocus()
		tab_ingreso.tp_be.dw_be_buscar_cliente.setcolumn('dv')
//		tab_ingreso.tp_be.em_dv_rut.setfocus()
	else
		Open(w_buscar_cliente)
		IF gf_permitir_ingreso(gs_base, gs_serie, gi_numero) THEN
			Open(w_advertencia)
			gs_rezago 						= " "
			tab_ingreso.tp_be.dw_be_buscar_cliente.AcceptText()
			tab_ingreso.tp_be.cb_be_borrar.SetFocus()
			tab_ingreso.tp_be.cb_be_borrar.TriggerEvent(Clicked!)
			RETURN 0
		else
			if gs_base='F' then
				gs_tipo_cobro_aux				= 'BA'
				SELECT	"REVISION_CONTRATOS"."SW_ACTIVA_SERVICIO",		"REVISION_CONTRATOS"."FOLIO_FA",		"REVISION_CONTRATOS"."FECHA_ACTIVACION",	  	"REVISION_CONTRATOS"."USO"
				INTO 		:ll_sw_serv,   														:ll_folio_fa,   										:ldt_fecha_activa,												:ls_uso  
				FROM 	"REVISION_CONTRATOS"  
				WHERE ( "REVISION_CONTRATOS"."BASE" = :gs_base ) AND  
							( "REVISION_CONTRATOS"."SERIE" = :gs_serie ) AND  
							( "REVISION_CONTRATOS"."NUMERO" = :gi_numero )   ;
				ll_folio_fa	= 0	//eliminar linea			
				if ll_sw_serv = 1 and ls_uso='NI' then
					messagebox("Advertencia","No es posible relizar Pago, No está Activado el Servicio")
					gs_rezago 					= " "
					tab_ingreso.tp_be.dw_be_buscar_cliente.AcceptText()
					tab_ingreso.tp_be.cb_be_borrar.SetFocus()
					tab_ingreso.tp_be.cb_be_borrar.TriggerEvent(Clicked!)
					ls_valida_pagos			= 'N'
					RETURN 0
				elseif ll_folio_fa > 0 and ls_uso='NI' then
					messagebox("Advertencia","No es posible realizar Pago, Tiene Factura Asociada")
					gs_rezago 					= " "
					tab_ingreso.tp_be.dw_be_buscar_cliente.AcceptText()
					tab_ingreso.tp_be.cb_be_borrar.SetFocus()
					tab_ingreso.tp_be.cb_be_borrar.TriggerEvent(Clicked!)
					ls_valida_pagos			= 'N'
					RETURN 0
				end if
			end if
		end if
		if ls_valida_pagos='S' then
			IF NOT ISNULL(gs_base) and gs_base <> ""	AND not isnull(gs_serie) AND gs_serie <> "" AND not isnull(gi_numero) AND gi_numero > 0 and ls_valida_pagos='S' THEN
				il_nenc 							= dw_encabezado_ingreso_cupon.Retrieve(gs_base, gs_serie, gi_numero)
				IF il_nenc > 0 THEN 
					tab_ingreso.tp_be.rb_be_exenta.enabled	= true
//					tab_ingreso.tp_be.cbx_reingresobe.enabled	= true
					tab_ingreso.tp_be.rb_be_afecta.enabled		= true	//false	//true	//false
					gi_rut 						= dw_encabezado_ingreso_cupon.GetItemNumber(1, "cliente_rut")
					tab_ingreso.tp_be.cb_asigna_be.triggerevent(clicked!)
				ELSE
					gi_rut 						= 0
				END IF
				if gi_rut>0 then 
					
					// vhfb - control de descuento web - inicio
					integer Net
					long v_porc
					
					gs_aplica_a = ''
					gd_descuento = 0
					
					gd_descuento = wf_busca_descuento_web()
					if gd_descuento > 0 then
						Net = messagebox('Descuento','Existe un descuento asociado al numero de contrato ingresado : ' + string(gi_numero)+ ' por un : ' +string(ii_desc_web)	+ '  %.'  +  '~r~n'	+ '~r~n'+'  Aplica el Descuento?',Question!,YesNo!)
						IF Net = 1 THEN
								li_Position = POS('ADFGPRL', gs_base)
								if li_Position > 0 then // solo cuotas		
										gs_aplica_a = 'C'
								end if 
								li_Position = POS('CO', gs_base)
								if li_Position > 0 then // solo mantencion		
										gs_aplica_a = 'M'
								end if 					
								// vhfb - termino - 	
						else 
							gd_descuento = 0
						END IF	
					end if 
								// vhfb - control de descuento web - termino	
					
					if isvalid(w_aviso_mensajes) then close(w_aviso_mensajes)
					
						date ld_fec_sistema
						
						ld_fec_sistema = date(gdt_fec_sistema)
					
					SELECT	COUNT("MENSAJES"."FECHA_CREACION")  
					INTO 		:ll_count  
					FROM 	"MENSAJES"  
					WHERE  ( "MENSAJES"."RUT" = :gi_rut ) and
							 ( "MENSAJES"."ESTADO_GESTION" = 'A' ) AND
							 ( "MENSAJES"."SW_MENSAJE" = 'R' ) and
							 ( to_date("MENSAJES"."FECHA_FIN") > :ld_fec_sistema)			// gdt_fec_sistema 
					USING		sqlca;
					if ll_count>0 then
						OpenWithParm(w_aviso_mensajes, "RA")// vhfb
					else
						SELECT	COUNT("MENSAJES"."FECHA_CREACION")  
						INTO 		:ll_count  
						FROM 	"MENSAJES"  
						WHERE  ( "MENSAJES"."BASE" = :gs_base ) and
								 ( "MENSAJES"."SERIE" = :gs_serie ) and
								 ( "MENSAJES"."NUMERO" = :gi_numero ) and
								 ( "MENSAJES"."ESTADO_GESTION" = 'A' ) AND
								 ( "MENSAJES"."SW_MENSAJE" = 'C' ) and
								  ( to_date("MENSAJES"."FECHA_FIN") > :ld_fec_sistema)			// gdt_fec_sistema 
						USING	sqlca;
						if ll_count>0 then
							OpenWithParm(w_aviso_mensajes, "CA")// vhfb
						end if
					end if
				end if
				If gi_rut = 0 THEN
					gs_rezago 						= " "
					tab_ingreso.tp_be.dw_be_buscar_cliente.AcceptText()
					tab_ingreso.tp_be.cb_be_borrar.SetFocus()
					tab_ingreso.tp_be.cb_be_borrar.TriggerEvent(Clicked!)
					RETURN 0
				END IF
				CHOOSE CASE gs_base
					CASE "O","U","M"
						tab_ingreso.tp_be.dw_datos_be.DataObject 	= 'd_datos_cuenta_ci_oferta'
					CASE "L"
						tab_ingreso.tp_be.dw_datos_be.DataObject 	= 'd_datos_cuenta_ci_liberador'
					CASE "P"
						tab_ingreso.tp_be.dw_datos_be.DataObject 	= 'd_datos_cuenta_ci_pagare'
					CASE "D"
						tab_ingreso.tp_be.dw_datos_be.DataObject 	= 'd_datos_cuenta_ci_derecho'
					CASE "C"
						tab_ingreso.tp_be.dw_datos_be.DataObject 	= 'd_datos_cuenta_bl_cto_isa'
					CASE "A"
						tab_ingreso.tp_be.dw_datos_be.DataObject 	= 'd_datos_cuenta_ci_aumento_capacidad'
					CASE "R"
						tab_ingreso.tp_be.dw_datos_be.DataObject 	= 'dw_repacta_mant_descripcion_traspaso'
					CASE "F","G","V"
						tab_ingreso.tp_be.dw_datos_be.DataObject 	= 'd_datos_cuenta_ci_funeraria'
				END CHOOSE
				tab_ingreso.tp_be.dw_datos_be.SetTransObject(SQLCA)
				DECLARE sp_actualizar_cuponeras_1 PROCEDURE FOR sp_actualizar_cuponeras_1(:gs_base,:gs_serie,:gi_numero);
				EXECUTE sp_actualizar_cuponeras_1;
				
				DECLARE sp_nuevo_cadena_mora_2 PROCEDURE FOR sp_nuevo_cadena_mora(:gs_base,:gs_serie,:gi_numero,'M');
				EXECUTE sp_nuevo_cadena_mora_2;
				if gs_base='M' then
					DECLARE x2 CURSOR FOR  
					SELECT 	"CADENA"."CODIGO",   	"CADENA"."SERIE",   	"CADENA"."NUMERO"  
					FROM 	"CADENA"  
					WHERE 	( "CADENA"."MPBASE" = :gs_base ) AND  
								( "CADENA"."MPSERIE" = :gs_serie ) AND  
								( "CADENA"."MPNUMERO" = :gi_numero )   
					USING	sqlca;
					open x2;
					if sqlca.sqlcode=0 then
						DO WHILE sqlca.sqlcode=0
							fetch x2 into :ls_base_h, :ls_serie_h, :ll_numero_h ;
							if not isnull(ls_base_h) then
								DECLARE sp_actualizar_cuponeras_h1 PROCEDURE FOR sp_actualizar_cuponeras_1(:ls_base_h,:ls_serie_h,:ll_numero_h);
								EXECUTE sp_actualizar_cuponeras_h1;
								
								DECLARE sp_nuevo_cadena_mora_h2 PROCEDURE FOR sp_nuevo_cadena_mora(:ls_base_h,:ls_serie_h,:ll_numero_h,'M');
								EXECUTE sp_nuevo_cadena_mora_h2;
							end if
							Setnull(ls_base_h)
						LOOP
					end if
					close x2;
				end if
				il_ndat 															= tab_ingreso.tp_be.dw_datos_be.Retrieve(gs_serie,gi_numero,gs_base)
				if il_ndat > 0 then
					
					datetime		ld_fecha_uf,ld_fecha_hoy_uf
					Double		id_uf
					
					if gs_depto = 'T' or gs_depto='I' then
						ld_fecha_uf				= datetime(date(em_fec_uf.text),time('00:00:00'))
						if date(ld_fecha_uf) > date(gdt_fec_sistema) then
							messagebox("Advertencia","No es posible Ingresar Fecha Superior a hoy "+string(gdt_fec_sistema,'dd/mm/yyyy'))
							em_fec_uf.text		= string(gdt_fec_sistema,'dd/mm/yyyy')
						else
					//		gdt_fec_sistema	= datetime(date(this.text),time(string(gdt_fec_sistema,'hh:mm:ss')))
							SELECT 	"TAB_UF"."VALOR_UF"  
							INTO 		:id_uf  
							FROM 	"TAB_UF"  
							WHERE 	"TAB_UF"."FECHA_UF" = :ld_fecha_uf;
							IF id_uf > 0  THEN 
								gd_uf_dia				= id_uf
								gd_uf 					= id_uf	
								st_uf.text 				= String(id_uf, "###,###,##0.0###")
								if tab_ingreso.tp_be.dw_datos_be.rowcount() > 0 then 
									tab_ingreso.tp_be.dw_datos_be.setitem(1,'fecha_uf',gd_uf)
									tab_ingreso.tp_be.dw_datos_be.accepttext()
								elseif tab_ingreso.tp_ci.dw_datos_ci.rowcount() > 0 then 
									tab_ingreso.tp_ci.dw_datos_ci.setitem(1,'fecha_uf',gd_uf)
									tab_ingreso.tp_ci.dw_datos_ci.accepttext()
								end if
							else
								ld_fecha_hoy_uf		= datetime(date(gdt_fec_sistema),time('00:00:00'))
								SELECT 	"TAB_UF"."VALOR_UF"  
								INTO 		:id_uf  
								FROM 	"TAB_UF"  
								WHERE 	"TAB_UF"."FECHA_UF" = :ld_fecha_hoy_uf;
								IF id_uf > 0  THEN 
									gd_uf_dia				= id_uf
									gd_uf 					= id_uf	
									st_uf.text 				= String(id_uf, "###,###,##0.0###")
									if tab_ingreso.tp_be.dw_datos_be.rowcount() > 0 then 
										tab_ingreso.tp_be.dw_datos_be.setitem(1,'fecha_uf',gd_uf)
										tab_ingreso.tp_be.dw_datos_be.accepttext()
									elseif tab_ingreso.tp_ci.dw_datos_ci.rowcount() > 0 then 
										tab_ingreso.tp_ci.dw_datos_ci.setitem(1,'fecha_uf',gd_uf)
										tab_ingreso.tp_ci.dw_datos_ci.accepttext()
									end if
								end if
							end if
						end if
					end if
					f_validar_pie_pactado_actualizar('BA',dw_datos_be.dataobject,gs_base,gs_serie,gi_numero)
//					SELECT 	  COUNT("INGRESO"."TIPO_COB") 
//					INTO 		  :ll_count_ne  
//					FROM 	  "INGRESO",  	"NOTA_DE_CREDITO"  
//					WHERE 	( "INGRESO"."FOLIO" = "NOTA_DE_CREDITO"."FOLIO" ) and  
//								( "INGRESO"."TIPO_COB" = "NOTA_DE_CREDITO"."TIPO_COB" ) and  
//								( "INGRESO"."FECHA_PAGO" = "NOTA_DE_CREDITO"."FECHA_PAGO" ) and  
//								( "INGRESO"."RUT" = :gi_rut ) AND  
//								( "INGRESO"."FECHA_PAGO" >= to_date(:gdt_fec_sistema) - 90 ) AND  
//								( "INGRESO"."FECHA_PAGO" <= to_date(:gdt_fec_sistema) ) AND  
//								( "NOTA_DE_CREDITO"."TIPO_COB_ORIGINAL" = 'NE' )   
//					USING	sqlca;
//					if ll_count_ne > 0 then
//						ll_res									= messagebox("Advertencia","Cliente Tiene Nota de Crédito Asociada, recuerde habilitar chek por Re-Ingreso 'Desea Activarlo' ",exclamation!,YesNo!,2)
//						if ll_res=1 then
//							cbx_reingresobe.checked	= true
//							cbx_reingresobe.triggerevent(clicked!)
//						else
//							cbx_reingresobe.checked	= false
//							gs_reingreso_be				= 'N'
//						end if
//					end if
					if gs_base='F' or gs_base='V' or gs_base='G' then
//						if gs_serie='F' then
							tab_ingreso.tp_be.rb_be_afecta.checked		= true
//						else
//							tab_ingreso.tp_be.rb_be_exenta.checked	= true
//						end if
//					elseif gs_base='G' then
//						if gs_serie='I' then
//							tab_ingreso.tp_be.rb_be_afecta.checked		= true
//						else
//							tab_ingreso.tp_be.rb_be_exenta.checked	= true
//						end if
					end if
					tab_ingreso.tp_be.dw_datos_be.setitem(1,'fecha_pago',ldt_fecha_pago)
					tab_ingreso.tp_be.dw_datos_be.accepttext()
	//				tab_ingreso.tp_be.dw_abono.retrieve(gs_base,gs_serie,gi_numero)
					ll_estado_carta					= tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'cadena_estado_carta')
					if ll_estado_carta=1 or ll_estado_carta=2 or ll_estado_carta=4 or ll_estado_carta=6 or ll_estado_carta=8 then
						st_aviso_ap.visible			= true
					end if
					IF il_nenc > 0 THEN 
						ls_fono_p					= dw_encabezado_ingreso_cupon.GetitemString(1, "cliente_fono_p")
						if len(ls_fono_p) <= 5 then
							st_aviso_ap.visible	= true
						end if
					end if
					tab_ingreso.tp_be.sle_numero_be.text			= ''
					tab_ingreso.tp_be.dw_detalle_be.reset()
					tab_ingreso.tp_be.dw_gastos_be.reset()
					ll_cod_parque						= tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'cadena_cod_parque')
				end if
				if tab_ingreso.tp_be.dw_datos_be.rowcount() > 0 then
					gl_cod_parque						= tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'cadena_cod_parque')
					if gs_base='O' or gs_base='U' or gs_base='M' then
						ll_ctas							= tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'pago_oferta_nro_cuotas')
						ll_ctas_pagadas				= tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'oferta_v_cta_pag_s')
					elseif gs_base='L' then
						ll_ctas							= tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'pago_liberador_nro_cuotas')
						ll_ctas_pagadas				= tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'anexo_liberador_cta_pag_m')
					elseif gs_base='F' or gs_base='G' or gs_base = 'V' then
						ll_ctas							= tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'producto_pago_plazo')
						ll_ctas_pagadas				= tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'producto_anexo_cuotas_pag')
					elseif gs_base='P' then
						ll_ctas							= tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'pagare_plazo')
						ll_ctas_pagadas_1				= tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'pagare_cta_pag_la')
						ll_ctas_pagadas_2				= tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'pagare_cta_pag_isa')
						ll_ctas_pagadas				= ll_ctas_pagadas_1 + ll_ctas_pagadas_2
					elseif gs_base='D' then
						ll_ctas							= tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'derecho_plazo')
						ll_ctas_pagadas_1				= tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'derecho_cta_pag_la')
						ll_ctas_pagadas_2				= tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'derecho_cta_pag_isa')
						ll_ctas_pagadas				= ll_ctas_pagadas_1 + ll_ctas_pagadas_2
					elseif gs_base='A' then
						ll_ctas							= tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'pago_aumento_nro_cuotas')
						ll_ctas_pagadas				= tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'anexo_aumento_cta_pag_m')
					end if
					if gs_base='O' or gs_base='C' or gs_base='U' or gs_base='M' then
						ll_ctas_pag_m_2					= tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'c_cuotas_mora_m')
						SELECT 	"SOL_ESTATUS"."CORRELATIVO",		"SOL_COMPROMISO_PAGO"."RUT_TITULAR",	"SOL_COMPROMISO_PAGO"."DV",		"SOL_COMPROMISO_PAGO"."FECHA_SOLICITUD",		"SOL_ESTATUS"."ESTADO_REG",	"SOL_COMPROMISO_PAGO"."NOMBRE_CLIENTE",	"SOL_COMPROMISO_PAGO"."FECHA_PRIM_MANT",	"SOL_COMPROMISO_PAGO"."MONTO_PIE_MANT",	"SOL_COMPROMISO_PAGO"."CUOTAS_PIE_MANT",	"SOL_COMPROMISO_PAGO"."PLAZO_MANT",	"SOL_COMPROMISO_PAGO"."MONTO_CUOTA_MANT",	"SOL_COMPROMISO_PAGO"."MORA_PAGAR_MANT",		"SOL_COMPROMISO_PAGO"."GASTO_PAGAR_MANT",	"SOL_COMPROMISO_PAGO"."UF_DIA",	"SOL_COMPROMISO_PAGO"."CUOTAS_MORA_ORIGINAL"
						INTO 		:ll_correlativo,								:ll_rut,													:ls_dv,										:ldt_fecha_sol,													:ls_estado,								:ls_nombre_sol,											:ldt_fecha_prim,												:ll_monto_pie,													:ll_cuotas_pie,													:ll_plazo,													:ldb_valor_cuota,													:ldb_interes,														:ldb_gasto,															:ldb_uf_dia,										:ll_mora_original
						FROM 	"SOL_COMPROMISO_PAGO",   	"SOL_ESTATUS"  
						WHERE 	( "SOL_COMPROMISO_PAGO"."BASE" = "SOL_ESTATUS"."BASE" ) and  
									( "SOL_COMPROMISO_PAGO"."SERIE" = "SOL_ESTATUS"."SERIE" ) and  
									( "SOL_COMPROMISO_PAGO"."NUMERO" = "SOL_ESTATUS"."NUMERO" ) and  
									( "SOL_COMPROMISO_PAGO"."CORRELATIVO" = "SOL_ESTATUS"."CORRELATIVO" ) and  
									( ( "SOL_COMPROMISO_PAGO"."BASE" = :gs_base ) AND  
									( "SOL_COMPROMISO_PAGO"."SERIE" = :gs_serie ) AND  
									( "SOL_COMPROMISO_PAGO"."NUMERO" = :gi_numero ) AND  
									( "SOL_ESTATUS"."CODIGO_SOLICITUD" = '27' ) AND  
									( "SOL_ESTATUS"."ESTADO_REG" = 'A' ) AND  
									( "SOL_COMPROMISO_PAGO"."CORRELATIVO" = (	SELECT 	"SOL_ESTATUS"."CORRELATIVO" 
																										FROM 	"SOL_ESTATUS" 
																										WHERE 	( "SOL_ESTATUS"."BASE" = :gs_base ) AND 
																													( "SOL_ESTATUS"."SERIE" = :gs_serie ) AND 
																													( "SOL_ESTATUS"."NUMERO" = :gi_numero ) AND
																													( "SOL_ESTATUS"."CODIGO_SOLICITUD" = '27' ) AND 
																													( "SOL_ESTATUS"."ESTADO_REG" = 'A' ) ) ) )  
						USING	sqlca;
						if sqlca.sqlcode=0 then
							if isnull(ldb_interes) then ldb_interes=0
							if isnull(ldb_gasto) then ldb_gasto=0
							ls_string	= gs_base+'~t'+gs_serie+'~t'+string(gi_numero)+'~t'+string(ll_rut)+'~t'+string(ll_correlativo)+'~t'+ls_dv+'~t'+ls_estado+'~t'+'27'+'~t'+ls_nombre_sol+'~t'+string(ldt_fecha_prim,'dd/mm/yyyy')+'~t'+string(ll_cuotas_pie)+'~t'+string(ll_monto_pie)+'~t'+string(ldb_uf_dia)+'~t'+ string(ldb_valor_cuota)+'~t'+string(ll_mora_original)+'~t'+string(ldb_interes)+'~t'+string(ldb_gasto)+'~t'+string(ll_ctas_pag_m_2)+'~t'+string(ll_plazo)+'~t'+string(ldt_fecha_sol,'dd/mm/yyyy')
							openwithparm(w_detalle_compromiso_pago,ls_string)
						end if	
					end if
				end if
			//	if ll_ctas_pagadas>=ll_ctas and dw_datos_be.rowcount()>0 and ll_ctas>0 then
			//		messagebox("Advertencia","No es Posible Ingresar C.I., Contrato Nº "+gs_base+'-'+gs_serie+'-'+string(gi_numero,"###,###,###,###,###")+" está CANCELADO")	
			//		cb_be_insertar.Enabled 			= FALSE
			//		cb_be_borrar_item.Enabled 		= FALSE
			//		cb_ingresar_pago_be.Enabled 	= FALSE
			//		sle_numero_be.Enabled 			= FALSE
			//		dw_datos_be.setfocus()
			//	else
					IF il_nenc > 0 THEN
						if gs_base='P' and ll_cod_parque <> 101 then
							MessageBox("Ingreso de Boleta", "No es Posible Ingresar Pagos a Pagaré solo para Parque Canaan, debe Generar CI.")
							tab_ingreso.tp_be.cb_be_borrar.TriggerEvent(Clicked!)
						elseif gs_base='M' then
							MessageBox("Ingreso de Boleta", "No es Posible Ingresar Pagos a Contrato MultiProducto, debe Generar CI.")
							tab_ingreso.tp_be.cb_be_borrar.TriggerEvent(Clicked!)
						else
							tab_ingreso.tp_be.dw_be_buscar_cliente.SetItem(1,"rs_a_paterno", dw_encabezado_ingreso_cupon.GetItemString(1, "cliente_a_paterno"))
							tab_ingreso.tp_be.dw_be_buscar_cliente.SetItem(1,"rs_a_materno", dw_encabezado_ingreso_cupon.GetItemString(1, "cliente_a_materno"))
							tab_ingreso.tp_be.dw_be_buscar_cliente.SetItem(1,"rs_nombre", dw_encabezado_ingreso_cupon.GetItemString(1, "cliente_nombre"))
							tab_ingreso.tp_be.dw_be_buscar_cliente.SetItem(1,"rn_contrato",String(gi_numero)) 
							tab_ingreso.tp_be.dw_be_buscar_cliente.SetItem(1,"rl_rut",String(dw_encabezado_ingreso_cupon.GetItemNumber(1, "cliente_rut")))
							tab_ingreso.tp_be.dw_be_buscar_cliente.SetItem(1,"rs_bs",(gs_base+gs_serie))
							tab_ingreso.tp_be.dw_be_buscar_cliente.SetItem(1,"dv",gf_obtener_dv( Long(dw_encabezado_ingreso_cupon.GetItemNumber(1, "cliente_rut")) ))
							gs_nombre_completo 			= dw_encabezado_ingreso_cupon.GetItemString(1, "cliente_nombre")+ " " +dw_encabezado_ingreso_cupon.GetItemString(1, "cliente_a_paterno") + " " + dw_encabezado_ingreso_cupon.GetItemString(1, "cliente_a_materno")
							gs_rezago 							= " "
							tab_ingreso.tp_be.sle_numero_be.Enabled 			= True
							tab_ingreso.tp_be.cbx_manual_be.enabled			= true
							tab_ingreso.tp_be.cb_asigna_be.enabled			= true
//							tab_ingreso.tp_be.cbx_reingresobe.enabled			= true
							tab_ingreso.tp_be.cb_asigna_be.triggerevent(clicked!)
							////// ver
							tab_ingreso.tp_be.dw_be_buscar_cliente.enabled	= false
		//					tab_ingreso.tp_be.em_dv_rut.enabled				= false
							tab_ingreso.tp_be.sle_numero_be.SetFocus()
						end if
					ELSE
						MessageBox("Ingreso de Boleta", "No se encontró información asociada a ese número de documento.")
						tab_ingreso.tp_be.cb_be_borrar.TriggerEvent(Clicked!)
					END IF	
					ld_fecha_hoy	= date(gdt_fec_sistema)
					ls_string			= string(gi_rut)+'~t'+gs_base+'~t'+gs_serie+'~t'+string(gi_numero)+'~t'+string(ld_fecha_hoy,'dd/mm/yyyy')
			//		openwithparm(w_modificar_telefonos_cliente,ls_string)
			//	end if
				ls_estado_cadena_2				= dw_datos_be.getitemstring(1,'cadena_estado')
				ls_llave							= trim(gs_base+gs_serie+string(gi_numero))
				SELECT	Count("TOKU_SUSCRIPCION_PAC"."ID")
				INTO		:ll_count_toku
				FROM 	"TOKU_SUSCRIPCION_PAC",   "TOKU_CLIENTE"  
				WHERE 	( "TOKU_SUSCRIPCION_PAC"."CLIENTE" = "TOKU_CLIENTE"."ID_TOKU" ) and  
							( "TOKU_SUSCRIPCION_PAC"."ESTADO" = 'chargeable' ) and  
							( "TOKU_CLIENTE"."ID_CLIENTE" = :ls_llave)   ;
				if ll_count_toku > 0 then
					if ls_estado_cadena_2 <> 'S' then
						ll_res_toku				= messagebox("Advertencia","Recuerde Contrato "+gs_base+'-'+gs_serie+'-'+string(gi_numero,'###,###,###,###,###')+ ' tiene Suscripción Convenio PAC (Toku), desea Ingresar Pago',Exclamation!,YesNo!,2)
						if ll_res_toku = 1 then
							st_toku.visible		= false
						else
							st_toku.visible		= true
						end if
					else
						st_toku.visible			= false
					end if
				else
					st_toku.visible				= false
				end if
			ELSE
				IF Long(tab_ingreso.tp_be.dw_be_buscar_cliente.GetItemString(1,"rl_rut")) > 0 THEN 
					//No se encuentra el cliente, preguntar si desea ingresar rezago
					li_opcion 												= MessageBox("Ingreso de Boleta", "No se encontró el Cliente, Contrato no ha sido ingresado o Estado No corresponde, desea ingresar Comprobante de Ingreso en Rezago ?", Exclamation!, YesNo!, 2)
					IF li_opcion = 1 THEN
						tab_ingreso.tp_be.rb_be_exenta.enabled	= true
						tab_ingreso.tp_be.rb_be_afecta.enabled		= true	//false	//true 	//false
						tab_ingreso.tp_be.dw_parque_be.visible		= true
						tab_ingreso.tp_be.gb_1_be.visible				= true
						tab_ingreso.tp_be.rb_be_uf.visible				= true
						tab_ingreso.tp_be.rb_be_peso.visible			= true
						tab_ingreso.tp_be.rb_be_uf.checked			= true
//						tab_ingreso.tp_be.cbx_reingresobe.enabled	= true
						gs_rezago 											= "S"
//						gs_base 												= "O"
						gs_serie 												= "I"
						tab_ingreso.tp_be.dw_datos_be.reset()
						tab_ingreso.tp_be.dw_detalle_be.reset()
						tab_ingreso.tp_be.dw_gastos_be.reset()
						tab_ingreso.tp_be.sle_numero_be.text		= ''
						gi_numero 											= 0
						gi_rut 												= long(tab_ingreso.tp_be.dw_be_buscar_cliente.GetItemString(1,"rl_rut"))
						ls_dv													= tab_ingreso.tp_be.dw_be_buscar_cliente.GetItemString(1,"dv")
						tab_ingreso.tp_be.dw_be_buscar_cliente.reset()
						ll_new												= tab_ingreso.tp_be.dw_be_buscar_cliente.insertrow(0)
						tab_ingreso.tp_be.dw_be_buscar_cliente.scrolltorow(ll_new)
						tab_ingreso.tp_be.dw_be_buscar_cliente.setitem(ll_new,'rl_rut',string(gi_rut))
						tab_ingreso.tp_be.dw_be_buscar_cliente.setitem(ll_new,'dv',ls_dv)
						tab_ingreso.tp_be.dw_be_buscar_cliente.accepttext()
						tab_ingreso.tp_be.dw_be_buscar_cliente.enabled			= false
	//					tab_ingreso.tp_be.em_dv_rut.enabled						= false
						tab_ingreso.tp_be.cbx_manual_be.enabled					= true
						tab_ingreso.tp_be.cb_asigna_be.enabled					= true
						tab_ingreso.tp_be.cb_asigna_be.triggerevent(clicked!)
						tab_ingreso.tp_be.sle_numero_be.Enabled 					= True
			//			tab_ingreso.tp_be.sle_numero_be.SetFocus()
						tab_ingreso.tp_be.dw_parque_be.reset()
						tab_ingreso.tp_be.dw_parque_be.insertrow(0)
						tab_ingreso.tp_be.dw_parque_be.accepttext()
						tab_ingreso.tp_be.dw_parque_be.setfocus()
					ELSE
						tab_ingreso.tp_be.dw_parque_be.visible						= false
						tab_ingreso.tp_be.gb_1_be.visible		= false
						tab_ingreso.tp_be.rb_be_uf.visible		= false
						tab_ingreso.tp_be.rb_be_peso.visible	= false
	//					tab_ingreso.tp_be.em_dv_rut.text								= ''
						gs_rezago 									= " "
						tab_ingreso.tp_be.dw_be_buscar_cliente.AcceptText()
						tab_ingreso.tp_be.cb_be_borrar.SetFocus()
						tab_ingreso.tp_be.cb_be_borrar.TriggerEvent(Clicked!)
					END IF
				ELSE
					//MessageBox("Ingreso de CI", "No se encontró información asociada a ese número de documento.")
					tab_ingreso.tp_be.cb_be_borrar.TriggerEvent(Clicked!)
				END IF
			END IF
		end if
	end if
else
//	tab_ingreso.tp_be.em_dv_rut.setfocus()
	tab_ingreso.tp_be.dw_be_buscar_cliente.setfocus()
	tab_ingreso.tp_be.dw_be_buscar_cliente.setcolumn('dv')
end if

// vhfb - inicio - control para aplciar descuento
IF dw_datos_be.ROWCOUNT()>0 THEN
	if 	gd_descuento > 0 then
		wf_gatilla_descuentos_de()
	end if 
END IF 
// vhfb - termino - control para aplciar descuento







end event

event itemfocuschanged;String		ls_dv_auto,ls_columna,ls_numero,ls_ap_pat,ls_nulo

Setnull(ls_nulo)
dw_be_buscar_cliente.accepttext()
ls_columna		= dwo.name
il_rut 				= long(tab_ingreso.tp_be.dw_be_buscar_cliente.GetItemString(1,"rl_rut"))
is_dv				= tab_ingreso.tp_be.dw_be_buscar_cliente.GetItemString(1,"dv")
ls_dv_auto		= tab_ingreso.tp_be.dw_be_buscar_cliente.getitemstring(1,'cf_obtener_dv')
if not isnull(is_dv) and not isnull(ls_dv_auto) and is_dv<>'' and ls_dv_auto<>'' and il_rut > 0 then
	if is_dv <> ls_dv_auto then
		tab_ingreso.tp_be.dw_be_buscar_cliente.setitem(1,'dv',ls_nulo)
		tab_ingreso.tp_be.dw_be_buscar_cliente.accepttext()
		tab_ingreso.tp_be.dw_be_buscar_cliente.setfocus()
		tab_ingreso.tp_be.dw_be_buscar_cliente.setcolumn('dv')
	end if
end if
if ls_columna='rn_contrato' or ls_columna='rs_a_paterno' then
	ls_numero	= tab_ingreso.tp_be.dw_be_buscar_cliente.getitemstring(1,'rn_contrato')
	ls_ap_pat	= tab_ingreso.tp_be.dw_be_buscar_cliente.getitemstring(1,'rs_a_paterno') 
	if isnull(ls_numero) and isnull(ls_ap_pat) and (is_dv='' or isnull(is_dv)) and il_rut > 0 then
		tab_ingreso.tp_be.dw_be_buscar_cliente.setfocus()
		tab_ingreso.tp_be.dw_be_buscar_cliente.setcolumn('dv')
	elseif ls_numero='' and ls_ap_pat='' and is_dv='' and il_rut > 0 then
		tab_ingreso.tp_be.dw_be_buscar_cliente.setfocus()
		tab_ingreso.tp_be.dw_be_buscar_cliente.setcolumn('dv')
	end if
end if
end event

