event clicked;Long		ll_monto,ll_folio,ll_count_ci,ll_count_abono,ll_tot_reg,ll_indi,ll_cantidad,ll_ctas,ll_ctas_pagadas,&
			ll_ctas_pagadas_1,ll_ctas_pagadas_2,ll_monto_cred,ll_monto_mora_cred,ll_sum_monto_abono,ll_monto_cta,&
			ll_monto_final_cred,ll_res_abono,ll_monto_mant,ll_monto_mora_mant,ll_monto_final_mant,ll_count_e,&
			ll_count_f,ll_tot_filas,ll_fila,ll_linea
Double	ld_monto_uf
String	ls_tipo_cob,ls_moneda,ls_pasa,ls_codigo_otro
Datetime	ldt_fecha_hoy

ls_tipo_cob				= gs_tipo_cobro
ll_folio					= Long(sle_numero_ci.text)
ls_pasa					= 'N'
ldt_fecha_hoy			= datetime(date(gdt_fec_sistema),time('00:00:00'))
if cbx_sin_gastos_ci.checked=true then
	dw_gastos_ci.setitem(1,'gastos_cob',0)
	dw_gastos_ci.setitem(1,'gasto_cred',0)
	dw_gastos_ci.setitem(1,'gasto_mant',0)
	ll_tot_filas		= dw_detalle_ci.RowCount()
	IF ll_tot_filas > 0 Then
		for ll_fila=1 to ll_tot_filas
			ls_codigo_otro	= w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.getitemstring(ll_fila,'tipo_cob_otro')
			if ls_codigo_otro = '133' then
				ll_linea	 		= w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.Find("tipo_cob_otro ='"+ls_codigo_otro+"'",1, ll_tot_filas)
				dw_detalle_ci.DeleteRow(ll_linea)
				w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.accepttext()
				ll_tot_filas				= w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.rowcount()
				ll_fila						= ll_fila - 1
			elseif ls_codigo_otro = '118' then
				ll_linea	 		= w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.Find("tipo_cob_otro ='"+ls_codigo_otro+"'",1, ll_tot_filas)
				dw_detalle_ci.DeleteRow(ll_linea)
				w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.accepttext()
				ll_tot_filas				= w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.rowcount()
				ll_fila						= ll_fila - 1
			end if
		next
	end if
else
	dw_gastos_ci.setitem(1,'gastos_cob', dw_gastos_ci.getitemnumber(1,'gasto_cred') + dw_gastos_ci.getitemnumber(1,'gasto_mant'))
	dw_gastos_ci.accepttext()
	dw_gastos_ci.setitem(1,'gastos_cob', il_int_gc_cred + il_int_gc_mant)	//il_int_gc)
	dw_gastos_ci.setitem(1,'gasto_cred',il_int_gc_cred)
	dw_gastos_ci.setitem(1,'gasto_mant',il_int_gc_mant)
end if
if ll_folio > 0 then
	SELECT	Count("ABONO_CTA_CTE"."BASE")  
	INTO 		:ll_count_e  
	FROM 		"ABONO_CTA_CTE"  
	WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
			 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
			 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
			 ( "ABONO_CTA_CTE"."TIPO_COB_OCUPA" = :ls_tipo_cob ) AND  
			 ( "ABONO_CTA_CTE"."FOLIO_OCUPA" = :ll_folio ) AND  
			 ( "ABONO_CTA_CTE"."TIPO_MOV_OCUPA" = 'E' )   
	USING		sqlca;
	
	SELECT	Count("ABONO_CTA_CTE"."BASE")  
	INTO 		:ll_count_f  
	FROM 		"ABONO_CTA_CTE"  
	WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
			 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
			 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
			 ( "ABONO_CTA_CTE"."TIPO_COB_OCUPA" = :ls_tipo_cob ) AND  
			 ( "ABONO_CTA_CTE"."FOLIO_OCUPA" = :ll_folio ) AND  
			 ( "ABONO_CTA_CTE"."TIPO_MOV_OCUPA" = 'F' )   
	USING		sqlca;

	
	SELECT	Count("ABONO_CTA_CTE"."BASE")  
	INTO 		:ll_count_abono  
	FROM 		"ABONO_CTA_CTE"  
	WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
			 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
			 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
			 ( "ABONO_CTA_CTE"."TIPO_COB" = :ls_tipo_cob ) AND  
			 ( "ABONO_CTA_CTE"."FOLIO" = :ll_folio ) AND
			 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )  
	USING		sqlca;
	if ll_count_abono > 0 then
		DELETE FROM "ABONO_CTA_CTE"  
		WHERE		( "ABONO_CTA_CTE"."TIPO_COB" = :ls_tipo_cob ) AND  
					( "ABONO_CTA_CTE"."FOLIO" = :ll_folio ) AND  
					( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
					( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
					( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
					( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
		USING		sqlca;
		if sqlca.sqlcode = 0 then
			commit;
			ls_pasa			= 'S'
		else
			rollback;
			messagebox("Error Eliminar","Error ELIMINAR ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
		end if
	end if
	SELECT	Count("ABONO_CTA_CTE"."BASE")  
	INTO 		:ll_count_abono  
	FROM 		"ABONO_CTA_CTE"  
	WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
			 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
			 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
			 ( "ABONO_CTA_CTE"."TIPO_COB" = :ls_tipo_cob ) AND  
			 ( "ABONO_CTA_CTE"."FOLIO" = :ll_folio ) AND
			 ( "ABONO_CTA_CTE"."TIPO_COB_OCUPA" = :ls_tipo_cob ) AND  
			 ( "ABONO_CTA_CTE"."FOLIO_OCUPA" = :ll_folio ) AND 
			 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'O' )  
	USING		sqlca;
	if ll_count_abono > 0 then
		DELETE FROM "ABONO_CTA_CTE"  
		WHERE		( "ABONO_CTA_CTE"."TIPO_COB" = :ls_tipo_cob ) AND  
					( "ABONO_CTA_CTE"."FOLIO" = :ll_folio ) AND  
					( "ABONO_CTA_CTE"."TIPO_COB_OCUPA" = :ls_tipo_cob ) AND  
					( "ABONO_CTA_CTE"."FOLIO_OCUPA" = :ll_folio ) AND 
					( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
					( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
					( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
					( "ABONO_CTA_CTE"."ESTADO_REG" = 'O' )   
		USING		sqlca;
		if sqlca.sqlcode = 0 then
			commit;
			ls_pasa			= 'S'
		else
			rollback;
			messagebox("Error Eliminar","Error ELIMINAR ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
		end if
	end if
	SELECT	Count("ABONO_CTA_CTE"."BASE")  
	INTO 		:ll_count_abono  
	FROM 		"ABONO_CTA_CTE"  
	WHERE  ( "ABONO_CTA_CTE"."TIPO_COB_OCUPA" = :ls_tipo_cob ) AND  
			 ( "ABONO_CTA_CTE"."FOLIO_OCUPA" = :ll_folio ) AND  
			 ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
			 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
			 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
			 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'O' )
	USING		sqlca;
	if ll_count_abono > 0 then
		UPDATE	"ABONO_CTA_CTE"  
		SET 		"ESTADO_REG" = 'P',   
					"TIPO_COB_OCUPA" = Null,   
					"FOLIO_OCUPA" = Null,   
					"FECHA_OCUPA" = Null,   
					"MONTO_OCUPA" = Null,   
					"USUARIO_OCUPA" = Null,   
					"CAJA_OCUPA" = Null,   
					"TIPO_MOV_OCUPA" = Null  
		WHERE  ( "ABONO_CTA_CTE"."TIPO_COB_OCUPA" = :ls_tipo_cob ) AND  
				 ( "ABONO_CTA_CTE"."FOLIO_OCUPA" = :ll_folio ) AND  
				 ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
				 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
				 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
				 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'O' )
		USING		sqlca;
		if sqlca.sqlcode=0 then
			commit;
			ls_pasa			= 'S'
		else
			rollback;
			messagebox("Error Eliminar","Error UPDATE ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
		end if
	end if
	if ls_pasa = 'S' then
		ll_tot_reg		= dw_detalle_ci.rowcount()
		for ll_indi=1 to ll_tot_reg
			ls_tipo_cob	= dw_detalle_ci.getitemstring(ll_indi,'tipo_cob')
			ll_cantidad	= dw_detalle_ci.getitemnumber(ll_indi,'cantidad')
			ll_monto		= dw_detalle_ci.getitemnumber(ll_indi,'monto')
			ld_monto_uf	= dw_detalle_ci.getitemnumber(ll_indi,'monto_uf')
			ls_moneda	= dw_detalle_ci.getitemstring(ll_indi,'moneda')
			if ls_tipo_cob='E' and ll_count_e > 0 then
				if (gs_base='O' or gs_base='U' or gs_base='M') and dw_datos_ci.DataObject='d_datos_cuenta_ci_oferta' then
					ll_ctas				= dw_datos_ci.getitemnumber(1,'pago_oferta_nro_cuotas')
					ll_ctas_pagadas	= dw_datos_ci.getitemnumber(1,'oferta_v_cta_pag_s')
				elseif gs_base='P' and dw_datos_ci.DataObject='d_datos_cuenta_ci_pagare' then
					ll_ctas				= dw_datos_ci.getitemnumber(1,'pagare_plazo')
					ll_ctas_pagadas_1	= dw_datos_ci.getitemnumber(1,'pagare_cta_pag_la')
					ll_ctas_pagadas_2	= dw_datos_ci.getitemnumber(1,'pagare_cta_pag_isa')
					ll_ctas_pagadas	= ll_ctas_pagadas_1 + ll_ctas_pagadas_2
				elseif gs_base='L' and dw_datos_ci.DataObject='d_datos_cuenta_ci_liberador' then
					ll_ctas				= dw_datos_ci.getitemnumber(1,'pago_liberador_nro_cuotas')
					ll_ctas_pagadas	= dw_datos_ci.getitemnumber(1,'anexo_liberador_cta_pag_m')
				elseif gs_base='D' and dw_datos_ci.DataObject='d_datos_cuenta_ci_derecho' then
					ll_ctas				= dw_datos_ci.getitemnumber(1,'derecho_plazo')
					ll_ctas_pagadas_1	= dw_datos_ci.getitemnumber(1,'derecho_cta_pag_la')
					ll_ctas_pagadas_2	= dw_datos_ci.getitemnumber(1,'derecho_cta_pag_isa')
					ll_ctas_pagadas	= ll_ctas_pagadas_1 + ll_ctas_pagadas_2
				elseif gs_base='A' and dw_datos_ci.DataObject='d_datos_cuenta_ci_aumento_capacidad' then
					ll_ctas				= dw_datos_ci.getitemnumber(1,'pago_aumento_nro_cuotas')
					ll_ctas_pagadas	= dw_datos_ci.getitemnumber(1,'anexo_aumento_cta_pag_m')
				elseif gs_base='R' and dw_datos_ci.DataObject='dw_repacta_mant_descripcion_traspaso' then
					ll_ctas				= dw_datos_ci.getitemnumber(1,'cuotas_pactadas')
					ll_ctas_pagadas	= dw_datos_ci.getitemnumber(1,'ctas_pagadas')
				end if
				if gs_base<>'C' then
					
					ll_monto_cred					= round(dw_datos_ci.GetItemNumber(1,"c_valor_cuota_pesos"),0)
					ll_monto_mora_cred			= wf_calcular_solo_mora(ll_indi)
					ll_monto_mora_cred			= ll_monto_mora_cred	+ wf_calcular_solo_gc(ll_indi)
					SELECT	SUM("ABONO_CTA_CTE"."MONTO")  
					INTO 		:ll_sum_monto_abono  
					FROM 		"ABONO_CTA_CTE"  
					WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
							 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
							 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero )  AND 
							 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
					USING		sqlca;
					if ll_sum_monto_abono > 0 then
						ll_monto_cta				= ll_monto_cred * dw_detalle_ci.getitemnumber(ll_indi,'cantidad')
						if ll_sum_monto_abono >= (ll_monto_cta + ll_monto_mora_cred) then
							ll_monto_final_cred	= round(ll_sum_monto_abono - ( ll_monto_cta + ll_monto_mora_cred),0)
							ll_monto_final_cred ++
							UPDATE	"ABONO_CTA_CTE"  
							SET 		"TIPO_COB_OCUPA" = :gs_tipo_cobro,   
										"FOLIO_OCUPA" = :ll_folio,   
										"FECHA_OCUPA" = :ldt_fecha_hoy,   
										"MONTO_OCUPA" = (:ll_monto_cta + :ll_monto_mora_cred) - 1,   
										"USUARIO_OCUPA" = :gs_user,   
										"CAJA_OCUPA" = :gs_caja,   
										"ESTADO_REG" = 'O',
										"TIPO_MOV_OCUPA" = :ls_tipo_cob  
							WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
									 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
									 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
									 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
							USING		sqlca;
							if sqlca.sqlcode=0 then
								commit;
								gdt_fec_sistema	= datetime(date(gdt_fec_sistema), RelativeTime(Now(), 5))
								INSERT INTO "ABONO_CTA_CTE"  
											( "RUT",		"BASE",		"SERIE",		"NUMERO",	"TIPO_COB",		"FOLIO",	"MONTO",				"FECHA_CREA",		"USUARIO_CREA",	"CAJA_CREA",	"ESTADO_REG",	"TIPO_COB_OCUPA",	"FOLIO_OCUPA",	"FECHA_OCUPA",	"MONTO_OCUPA",	"USUARIO_OCUPA",	"CAJA_OCUPA",	"TIPO_MOV_OCUPA" )
								VALUES 	( :gi_rut,	:gs_base,	:gs_serie,	:gi_numero,		:gs_tipo_cobro,		:ll_folio,	:ll_monto_final_cred,	:gdt_fec_sistema,	:gs_user,			:gs_caja,		'P',				null,					null,				null,				null,				null,					null,				null )  
								USING		sqlca;
								if sqlca.sqlcode=0 then
									commit;
								else
									rollback;
									messagebox("Error Grabar","Error al INSERTAR ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
								end if
							else
								rollback;
								messagebox("Error Grabar","Error al UPDATE ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
							end if
						else
							UPDATE	"ABONO_CTA_CTE"  
							SET 		"TIPO_COB_OCUPA" = :gs_tipo_cobro,   
										"FOLIO_OCUPA" = :ll_folio,   
										"FECHA_OCUPA" = :ldt_fecha_hoy,   
										"MONTO_OCUPA" = :ll_sum_monto_abono,   
										"USUARIO_OCUPA" = :gs_user,   
										"CAJA_OCUPA" = :gs_caja,   
										"ESTADO_REG" = 'O',
										"TIPO_MOV_OCUPA" = :ls_tipo_cob
							WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
									 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
									 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
									 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
							USING		sqlca;
							if sqlca.sqlcode=0 then
								commit;
							else
								rollback;
								messagebox("Error Grabar","Error al Update ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
							end if
						end if
					else
						ll_monto_final_cred				= ll_monto_cred
					end if
					
				
				end if
				
			elseif ls_tipo_cob='F' and ll_count_f > 0 then
				ll_monto_mant					= round(dw_datos_ci.GetItemNumber(1,"c_valor_cuota_mantencion_pesos"),0)
				ll_monto_cta					= ll_monto_mant * dw_detalle_ci.getitemnumber(ll_indi,'cantidad')
				SELECT	SUM("ABONO_CTA_CTE"."MONTO")  
				INTO 		:ll_sum_monto_abono  
				FROM 		"ABONO_CTA_CTE"  
				WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
						 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
						 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND
						 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )
				USING		sqlca;
				if ll_sum_monto_abono > 0 then
					ll_monto_mant				= ll_monto_mant - dw_detalle_ci.getitemnumber(ll_indi,'cantidad')
					ll_monto_mora_mant		= wf_calcular_solo_mora_mant(ll_indi)
					ll_monto_mora_mant		= ll_monto_mora_mant + wf_calcular_solo_gc_mant(ll_indi)
					if ll_sum_monto_abono >= (ll_monto_cta + ll_monto_mora_mant)  then
						ll_monto_final_mant	= round(ll_sum_monto_abono - ( ll_monto_cta + ll_monto_mora_mant ) ,0)
						ll_monto_final_mant ++
						UPDATE	"ABONO_CTA_CTE"  
						SET 		"TIPO_COB_OCUPA" = :gs_tipo_cobro,   
									"FOLIO_OCUPA" = :ll_folio,   
									"FECHA_OCUPA" = :ldt_fecha_hoy,   
									"MONTO_OCUPA" = (:ll_monto_cta + :ll_monto_mora_mant) - 1,   
									"USUARIO_OCUPA" = :gs_user,   
									"CAJA_OCUPA" = :gs_caja,   
									"ESTADO_REG" = 'O',
									"TIPO_MOV_OCUPA" = :ls_tipo_cob
						WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
								 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
								 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
								 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
						USING		sqlca;
						if sqlca.sqlcode=0 then
							commit;
							gdt_fec_sistema	= datetime(date(gdt_fec_sistema), RelativeTime(Now(), 10))
							INSERT INTO "ABONO_CTA_CTE"  
										( "RUT",		"BASE",		"SERIE",		"NUMERO",	"TIPO_COB",	"FOLIO",		"MONTO",						"FECHA_CREA",		"USUARIO_CREA",	"CAJA_CREA",	"ESTADO_REG",	"TIPO_COB_OCUPA",	"FOLIO_OCUPA",	"FECHA_OCUPA",	"MONTO_OCUPA",	"USUARIO_OCUPA",	"CAJA_OCUPA",	"TIPO_MOV_OCUPA" )
							VALUES 	( :gi_rut,	:gs_base,	:gs_serie,	:gi_numero,	:gs_tipo_cobro,			:ll_folio,	:ll_monto_final_mant,	:gdt_fec_sistema,	:gs_user,			:gs_caja,		'P',				null,					null,				null,				null,				null,					null,				null )  
							USING		sqlca;
							if sqlca.sqlcode=0 then
								commit;
							else
								rollback;
								messagebox("Error Grabar","Error al INSERTAR ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
							end if
						else
							rollback;
							messagebox("Error Grabar","Error al UPDATE ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
						end if
					else
						UPDATE	"ABONO_CTA_CTE"  
						SET 		"TIPO_COB_OCUPA" = :gs_tipo_cobro,   
									"FOLIO_OCUPA" = :ll_folio,   
									"FECHA_OCUPA" = :ldt_fecha_hoy,   
									"MONTO_OCUPA" = :ll_sum_monto_abono,   
									"USUARIO_OCUPA" = :gs_user,   
									"CAJA_OCUPA" = :gs_caja,   
									"ESTADO_REG" = 'O',
									"TIPO_MOV_OCUPA" = :ls_tipo_cob
						WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
								 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
								 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
								 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
						USING		sqlca;
						if sqlca.sqlcode=0 then
							commit;
						else
							rollback;
							messagebox("Error Grabar","Error al Update ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
						end if
					end if
				end if
			end if
		next
	end if
end if
end event

type cbx_sin_mora_ci from checkbox within tp_ci
event ue_mousemove pbm_mousemove
integer x = 1975
integer y = 1328
integer width = 768
integer height = 64
integer textsize = -8
integer weight = 400
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Verdana"
long backcolor = 79741120
boolean enabled = false
string text = "Sin Mora."
boolean lefttext = true
end type

event ue_mousemove;st_14.visible						= false
st_help_insertar.visible		= false
st_help_eliminar.visible		= false
st_help_descuento.visible	= true
if is_opcion='FP' and (gs_depto='T' or gs_depto='I') then st_fuera_plazo.visible = true
end event

event clicked;Long		ll_monto,ll_folio,ll_count_ci,ll_count_abono,ll_tot_reg,ll_indi,ll_cantidad,ll_ctas,ll_ctas_pagadas,&
			ll_ctas_pagadas_1,ll_ctas_pagadas_2,ll_monto_cred,ll_monto_mora_cred,ll_sum_monto_abono,ll_monto_cta,&
			ll_monto_final_cred,ll_res_abono,ll_monto_mant,ll_monto_mora_mant,ll_monto_final_mant,ll_count_e,ll_count_f,ll_tot_filas,ll_fila,ll_linea
Double	ld_monto_uf
String	ls_tipo_cob,ls_moneda,ls_pasa,ls_codigo_otro
Datetime	ldt_fecha_hoy

ls_tipo_cob				= gs_tipo_cobro
ll_folio					= Long(sle_numero_ci.text)
ls_pasa					= 'N'
SELECT sysdate INTO :gdt_fec_sistema FROM "TASA" WHERE "TASA"."LOOK" = 1 ;
ldt_fecha_hoy			= datetime(date(gdt_fec_sistema),time('00:00:00'))
if cbx_sin_mora_ci.checked=true then
	dw_gastos_ci.setitem(1,'mora',0)
	dw_gastos_ci.SetItem(1,"mora_cred", 0)
	dw_gastos_ci.SetItem(1,"mora_mant", 0)
	ll_tot_filas		=  w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.RowCount()
	IF ll_tot_filas > 0 Then
		for ll_fila = 1 to ll_tot_filas
			ls_codigo_otro		= w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.getitemstring(ll_fila,'tipo_cob_otro')
			if ls_codigo_otro = '130' then
				ll_linea	 		= w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.Find("tipo_cob_otro ='"+ls_codigo_otro+"'",1, ll_tot_filas)
				w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.DeleteRow(ll_linea)
				w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.accepttext()
				ll_tot_filas				= w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.rowcount()
				ll_fila						= ll_fila - 1
			elseif ls_codigo_otro = '102' then
			//	ll_linea			= w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.Find('tipo_cob_otro= "102" ',ll_fila,ll_tot_filas)
				ll_linea	 		= w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.Find("tipo_cob_otro ='"+ls_codigo_otro+"'",1, ll_tot_filas)
				w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.DeleteRow(ll_linea)
				w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.accepttext()
				ll_tot_filas				= w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.rowcount()
				ll_fila						= ll_fila - 1
			end if
		next
	end if	
else
	dw_gastos_ci.setitem(1,'mora', dw_gastos_ci.getitemnumber(1,'mora_cred') + dw_gastos_ci.getitemnumber(1,'mora_mant'))
	dw_gastos_ci.accepttext()
	dw_gastos_ci.setitem(1,'mora',il_int_mora)
	dw_gastos_ci.setitem(1,'mora_cred',il_int_mora_cred)
	dw_gastos_ci.setitem(1,'mora_mant',il_int_mora_mant)
end if
if ll_folio > 0 then
	SELECT	Count("ABONO_CTA_CTE"."BASE")  
	INTO 		:ll_count_e  
	FROM 		"ABONO_CTA_CTE"  
	WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
			 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
			 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
			 ( "ABONO_CTA_CTE"."TIPO_COB_OCUPA" = :ls_tipo_cob ) AND  
			 ( "ABONO_CTA_CTE"."FOLIO_OCUPA" = :ll_folio ) AND  
			 ( "ABONO_CTA_CTE"."TIPO_MOV_OCUPA" = 'E' )   
	USING		sqlca;
	
	SELECT	Count("ABONO_CTA_CTE"."BASE")  
	INTO 		:ll_count_f  
	FROM 		"ABONO_CTA_CTE"  
	WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
			 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
			 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
			 ( "ABONO_CTA_CTE"."TIPO_COB_OCUPA" = :ls_tipo_cob ) AND  
			 ( "ABONO_CTA_CTE"."FOLIO_OCUPA" = :ll_folio ) AND  
			 ( "ABONO_CTA_CTE"."TIPO_MOV_OCUPA" = 'F' )   
	USING		sqlca;

	
	SELECT	Count("ABONO_CTA_CTE"."BASE")  
	INTO 		:ll_count_abono  
	FROM 		"ABONO_CTA_CTE"  
	WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
			 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
			 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
			 ( "ABONO_CTA_CTE"."TIPO_COB" = :ls_tipo_cob ) AND  
			 ( "ABONO_CTA_CTE"."FOLIO" = :ll_folio ) AND
			 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )  
	USING		sqlca;
	if ll_count_abono > 0 then
		DELETE FROM "ABONO_CTA_CTE"  
		WHERE		( "ABONO_CTA_CTE"."TIPO_COB" = :ls_tipo_cob ) AND  
					( "ABONO_CTA_CTE"."FOLIO" = :ll_folio ) AND  
					( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
					( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
					( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
					( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
		USING		sqlca;
		if sqlca.sqlcode = 0 then
			commit;
			ls_pasa			= 'S'
		else
			rollback;
			messagebox("Error Eliminar","Error ELIMINAR ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
		end if
	end if
	SELECT	Count("ABONO_CTA_CTE"."BASE")  
	INTO 		:ll_count_abono  
	FROM 		"ABONO_CTA_CTE"  
	WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
			 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
			 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
			 ( "ABONO_CTA_CTE"."TIPO_COB" = :ls_tipo_cob ) AND  
			 ( "ABONO_CTA_CTE"."FOLIO" = :ll_folio ) AND
			 ( "ABONO_CTA_CTE"."TIPO_COB_OCUPA" = :ls_tipo_cob ) AND  
			 ( "ABONO_CTA_CTE"."FOLIO_OCUPA" = :ll_folio ) AND 
			 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'O' )  
	USING		sqlca;
	if ll_count_abono > 0 then
		DELETE FROM "ABONO_CTA_CTE"  
		WHERE		( "ABONO_CTA_CTE"."TIPO_COB" = :ls_tipo_cob ) AND  
					( "ABONO_CTA_CTE"."FOLIO" = :ll_folio ) AND  
					( "ABONO_CTA_CTE"."TIPO_COB_OCUPA" = :ls_tipo_cob ) AND  
					( "ABONO_CTA_CTE"."FOLIO_OCUPA" = :ll_folio ) AND 
					( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
					( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
					( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
					( "ABONO_CTA_CTE"."ESTADO_REG" = 'O' )   
		USING		sqlca;
		if sqlca.sqlcode = 0 then
			commit;
			ls_pasa			= 'S'
		else
			rollback;
			messagebox("Error Eliminar","Error ELIMINAR ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
		end if
	end if
	SELECT	Count("ABONO_CTA_CTE"."BASE")  
	INTO 		:ll_count_abono  
	FROM 		"ABONO_CTA_CTE"  
	WHERE  ( "ABONO_CTA_CTE"."TIPO_COB_OCUPA" = :ls_tipo_cob ) AND  
			 ( "ABONO_CTA_CTE"."FOLIO_OCUPA" = :ll_folio ) AND  
			 ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
			 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
			 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
			 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'O' )
	USING		sqlca;
	if ll_count_abono > 0 then
		UPDATE	"ABONO_CTA_CTE"  
		SET 		"ESTADO_REG" = 'P',   
					"TIPO_COB_OCUPA" = Null,   
					"FOLIO_OCUPA" = Null,   
					"FECHA_OCUPA" = Null,   
					"MONTO_OCUPA" = Null,   
					"USUARIO_OCUPA" = Null,   
					"CAJA_OCUPA" = Null,   
					"TIPO_MOV_OCUPA" = Null  
		WHERE  ( "ABONO_CTA_CTE"."TIPO_COB_OCUPA" = :ls_tipo_cob ) AND  
				 ( "ABONO_CTA_CTE"."FOLIO_OCUPA" = :ll_folio ) AND  
				 ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
				 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
				 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
				 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'O' )
		USING		sqlca;
		if sqlca.sqlcode=0 then
			commit;
			ls_pasa			= 'S'
		else
			rollback;
			messagebox("Error Eliminar","Error UPDATE ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
		end if
	end if
	if ls_pasa = 'S' then
		ll_tot_reg		= dw_detalle_ci.rowcount()
		for ll_indi=1 to ll_tot_reg
			ls_tipo_cob	= dw_detalle_ci.getitemstring(ll_indi,'tipo_cob')
			ll_cantidad	= dw_detalle_ci.getitemnumber(ll_indi,'cantidad')
			ll_monto		= dw_detalle_ci.getitemnumber(ll_indi,'monto')
			ld_monto_uf	= dw_detalle_ci.getitemnumber(ll_indi,'monto_uf')
			ls_moneda	= dw_detalle_ci.getitemstring(ll_indi,'moneda')
			if ls_tipo_cob='E' and ll_count_e > 0 then
				if (gs_base='O' or gs_base='U' or gs_base='M') and dw_datos_ci.DataObject='d_datos_cuenta_ci_oferta' then
					ll_ctas				= dw_datos_ci.getitemnumber(1,'pago_oferta_nro_cuotas')
					ll_ctas_pagadas	= dw_datos_ci.getitemnumber(1,'oferta_v_cta_pag_s')
				elseif gs_base='P' and dw_datos_ci.DataObject='d_datos_cuenta_ci_pagare' then
					ll_ctas				= dw_datos_ci.getitemnumber(1,'pagare_plazo')
					ll_ctas_pagadas_1	= dw_datos_ci.getitemnumber(1,'pagare_cta_pag_la')
					ll_ctas_pagadas_2	= dw_datos_ci.getitemnumber(1,'pagare_cta_pag_isa')
					ll_ctas_pagadas	= ll_ctas_pagadas_1 + ll_ctas_pagadas_2
				elseif gs_base='L' and dw_datos_ci.DataObject='d_datos_cuenta_ci_liberador' then
					ll_ctas				= dw_datos_ci.getitemnumber(1,'pago_liberador_nro_cuotas')
					ll_ctas_pagadas	= dw_datos_ci.getitemnumber(1,'anexo_liberador_cta_pag_m')
				elseif gs_base='D' and dw_datos_ci.DataObject='d_datos_cuenta_ci_derecho' then
					ll_ctas				= dw_datos_ci.getitemnumber(1,'derecho_plazo')
					ll_ctas_pagadas_1	= dw_datos_ci.getitemnumber(1,'derecho_cta_pag_la')
					ll_ctas_pagadas_2	= dw_datos_ci.getitemnumber(1,'derecho_cta_pag_isa')
					ll_ctas_pagadas	= ll_ctas_pagadas_1 + ll_ctas_pagadas_2
				elseif gs_base='A' and dw_datos_ci.DataObject='d_datos_cuenta_ci_aumento_capacidad' then
					ll_ctas				= dw_datos_ci.getitemnumber(1,'pago_aumento_nro_cuotas')
					ll_ctas_pagadas	= dw_datos_ci.getitemnumber(1,'anexo_aumento_cta_pag_m')
				elseif gs_base='R' and dw_datos_ci.DataObject='dw_repacta_mant_descripcion_traspaso' then
					ll_ctas				= dw_datos_ci.getitemnumber(1,'cuotas_pactadas')
					ll_ctas_pagadas	= dw_datos_ci.getitemnumber(1,'ctas_pagadas')
				end if
				if gs_base<>'C' then
					
					ll_monto_cred					= round(dw_datos_ci.GetItemNumber(1,"c_valor_cuota_pesos"),0)
					ll_monto_mora_cred			= wf_calcular_solo_mora(ll_indi)
					ll_monto_mora_cred			= ll_monto_mora_cred	+ wf_calcular_solo_gc(ll_indi)
					SELECT	SUM("ABONO_CTA_CTE"."MONTO")  
					INTO 		:ll_sum_monto_abono  
					FROM 		"ABONO_CTA_CTE"  
					WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
							 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
							 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero )  AND 
							 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
					USING		sqlca;
					if ll_sum_monto_abono > 0 then
						ll_monto_cta				= ll_monto_cred * dw_detalle_ci.getitemnumber(ll_indi,'cantidad')
						if ll_sum_monto_abono >= (ll_monto_cta + ll_monto_mora_cred) then
							ll_monto_final_cred	= round(ll_sum_monto_abono - ( ll_monto_cta + ll_monto_mora_cred),0)
							ll_monto_final_cred ++
							UPDATE	"ABONO_CTA_CTE"  
							SET 		"TIPO_COB_OCUPA" = :gs_tipo_cobro,   
										"FOLIO_OCUPA" = :ll_folio,   
										"FECHA_OCUPA" = :ldt_fecha_hoy,   
										"MONTO_OCUPA" = (:ll_monto_cta + :ll_monto_mora_cred) - 1,   
										"USUARIO_OCUPA" = :gs_user,   
										"CAJA_OCUPA" = :gs_caja,   
										"ESTADO_REG" = 'O',
										"TIPO_MOV_OCUPA" = :ls_tipo_cob  
							WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
									 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
									 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
									 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
							USING		sqlca;
							if sqlca.sqlcode=0 then
								commit;
								gdt_fec_sistema	= datetime(date(gdt_fec_sistema), RelativeTime(Now(), 5))
								INSERT INTO "ABONO_CTA_CTE"  
											( "RUT",		"BASE",		"SERIE",		"NUMERO",	"TIPO_COB",		"FOLIO",		"MONTO",						"FECHA_CREA",		"USUARIO_CREA",	"CAJA_CREA",	"ESTADO_REG",	"TIPO_COB_OCUPA",	"FOLIO_OCUPA",	"FECHA_OCUPA",	"MONTO_OCUPA",	"USUARIO_OCUPA",	"CAJA_OCUPA",	"TIPO_MOV_OCUPA" )
								VALUES 	( :gi_rut,	:gs_base,	:gs_serie,	:gi_numero,		:gs_tipo_cobro,		:ll_folio,	:ll_monto_final_cred,	:gdt_fec_sistema,	:gs_user,			:gs_caja,		'P',				null,					null,				null,				null,				null,					null,				null )  
								USING		sqlca;
								if sqlca.sqlcode=0 then
									commit;
								else
									rollback;
									messagebox("Error Grabar","Error al INSERTAR ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
								end if
							else
								rollback;
								messagebox("Error Grabar","Error al UPDATE ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
							end if
						else
							UPDATE	"ABONO_CTA_CTE"  
							SET 		"TIPO_COB_OCUPA" = :gs_tipo_cobro,   
										"FOLIO_OCUPA" = :ll_folio,   
										"FECHA_OCUPA" = :ldt_fecha_hoy,   
										"MONTO_OCUPA" = :ll_sum_monto_abono,   
										"USUARIO_OCUPA" = :gs_user,   
										"CAJA_OCUPA" = :gs_caja,   
										"ESTADO_REG" = 'O',
										"TIPO_MOV_OCUPA" = :ls_tipo_cob
							WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
									 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
									 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
									 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
							USING		sqlca;
							if sqlca.sqlcode=0 then
								commit;
							else
								rollback;
								messagebox("Error Grabar","Error al Update ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
							end if
						end if
					else
						ll_monto_final_cred				= ll_monto_cred
					end if
					
				
				end if
				
			elseif ls_tipo_cob='F' and ll_count_f > 0 then
				ll_monto_mant					= round(dw_datos_ci.GetItemNumber(1,"c_valor_cuota_mantencion_pesos"),0)
				ll_monto_cta					= ll_monto_mant * dw_detalle_ci.getitemnumber(ll_indi,'cantidad')
				SELECT	SUM("ABONO_CTA_CTE"."MONTO")  
				INTO 		:ll_sum_monto_abono  
				FROM 		"ABONO_CTA_CTE"  
				WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
						 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
						 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND
						 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )
				USING		sqlca;
				if ll_sum_monto_abono > 0 then
					ll_monto_mant				= ll_monto_mant - dw_detalle_ci.getitemnumber(ll_indi,'cantidad')
					ll_monto_mora_mant		= wf_calcular_solo_mora_mant(ll_indi)
					ll_monto_mora_mant		= ll_monto_mora_mant + wf_calcular_solo_gc_mant(ll_indi)
					if ll_sum_monto_abono >= (ll_monto_cta + ll_monto_mora_mant)  then
						ll_monto_final_mant	= round(ll_sum_monto_abono - ( ll_monto_cta + ll_monto_mora_mant ) ,0)
						ll_monto_final_mant ++
						UPDATE	"ABONO_CTA_CTE"  
						SET 		"TIPO_COB_OCUPA" = :gs_tipo_cobro,   
									"FOLIO_OCUPA" = :ll_folio,   
									"FECHA_OCUPA" = :ldt_fecha_hoy,   
									"MONTO_OCUPA" = (:ll_monto_cta + :ll_monto_mora_mant) - 1,   
									"USUARIO_OCUPA" = :gs_user,   
									"CAJA_OCUPA" = :gs_caja,   
									"ESTADO_REG" = 'O',
									"TIPO_MOV_OCUPA" = :ls_tipo_cob
						WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
								 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
								 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
								 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
						USING		sqlca;
						if sqlca.sqlcode=0 then
							commit;
							gdt_fec_sistema	= datetime(date(gdt_fec_sistema), RelativeTime(Now(), 10))
							INSERT INTO "ABONO_CTA_CTE"  
										( "RUT",		"BASE",		"SERIE",		"NUMERO",	"TIPO_COB",	"FOLIO",		"MONTO",						"FECHA_CREA",		"USUARIO_CREA",	"CAJA_CREA",	"ESTADO_REG",	"TIPO_COB_OCUPA",	"FOLIO_OCUPA",	"FECHA_OCUPA",	"MONTO_OCUPA",	"USUARIO_OCUPA",	"CAJA_OCUPA",	"TIPO_MOV_OCUPA" )
							VALUES 	( :gi_rut,	:gs_base,	:gs_serie,	:gi_numero,		:gs_tipo_cobro,			:ll_folio,	:ll_monto_final_mant,	:gdt_fec_sistema,	:gs_user,			:gs_caja,		'P',				null,					null,				null,				null,				null,					null,				null )  
							USING		sqlca;
							if sqlca.sqlcode=0 then
								commit;
							else
								rollback;
								messagebox("Error Grabar","Error al INSERTAR ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
							end if
						else
							rollback;
							messagebox("Error Grabar","Error al UPDATE ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
						end if
					else
						UPDATE	"ABONO_CTA_CTE"  
						SET 		"TIPO_COB_OCUPA" = :gs_tipo_cobro,   
									"FOLIO_OCUPA" = :ll_folio,   
									"FECHA_OCUPA" = :ldt_fecha_hoy,   
									"MONTO_OCUPA" = :ll_sum_monto_abono,   
									"USUARIO_OCUPA" = :gs_user,   
									"CAJA_OCUPA" = :gs_caja,   
									"ESTADO_REG" = 'O',
									"TIPO_MOV_OCUPA" = :ls_tipo_cob
						WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
								 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
								 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
								 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
						USING		sqlca;
						if sqlca.sqlcode=0 then
							commit;
						else
							rollback;
							messagebox("Error Grabar","Error al Update ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
						end if
					end if
				end if
			end if
		next
	end if
end if
end event

