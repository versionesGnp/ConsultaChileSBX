type sle_numero_ci from singlelineedit within tp_ci
event ue_mousemove pbm_mousemove
integer x = 1312
integer y = 680
integer width = 498
integer height = 88
integer taborder = 30
integer textsize = -9
integer weight = 700
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
long backcolor = 16777215
boolean enabled = false
boolean autohscroll = false
borderstyle borderstyle = stylelowered!
end type

event ue_mousemove;st_14.visible						= false
st_help_insertar.visible		= false
st_help_eliminar.visible		= false
st_help_ficha.visible			= false
st_help_descuento.visible	= false
if is_opcion='FP' and (gs_depto='T' or gs_depto='I') then st_fuera_plazo.visible = true

end event

event modified;String		ls_rut_empresa,ls_pasa='S'
Long		ll_folio_aux,ll_folio,ll_min_boleta

ll_folio													= long(sle_numero_ci.text)
if cbx_manual_ci.checked=true then
	gs_tipo_cobro					= "CI"
else
	if rb_bol_afecta.checked=true then
		gs_tipo_cobro				= "CI"
	elseif rb_bol_exenta.checked=true then
		gs_tipo_cobro				= "CI"
	end if
end if
if ll_folio > 0 then
	IF gf_existe_ci(ll_folio,gs_tipo_cobro) THEN
		MessageBox("Ingreso "+gs_tipo_cobro, "El Número de COMPROBANTE INGRESO "+string(ll_folio)+" ya existe")
		sle_numero_ci.text 								= ""
		cb_ci_insertar.Enabled 							= false
		cb_ci_borrar_item.Enabled 						= false
		pb_ficha.Enabled 									= false
		dw_detalle_ci.reset()
		sle_numero_ci.setfocus()
	ELSE
		if cbx_manual_ci.checked=false then
			SELECT		"MEMBRETE_EMPRESA"."STRING_RUT"
			INTO 			:ls_rut_empresa
			FROM 		"MEMBRETE_EMPRESA"  
			WHERE 		"MEMBRETE_EMPRESA"."COD_PARQUE" = :gl_cod_parque   ;
			
			SELECT		"ELECTRONICA_FB_DETALLE"."NRO_DOCUMENTO"  
			INTO 			:ll_folio_aux  
			FROM 		"ELECTRONICA_FB",   
							"ELECTRONICA_FB_DETALLE"  
			WHERE 	  ( "ELECTRONICA_FB"."GRUPO" = "ELECTRONICA_FB_DETALLE"."GRUPO" ) and  
						  ( "ELECTRONICA_FB"."TIPO_DOCUMENTO" = "ELECTRONICA_FB_DETALLE"."TIPO_DOCUMENTO" ) and  
						  (("ELECTRONICA_FB"."ESTADO" = 'P' ) AND  
						  ( "ELECTRONICA_FB_DETALLE"."NRO_DOCUMENTO" = :ll_folio ) AND  
						  ( "ELECTRONICA_FB_DETALLE"."TIPO_DOCUMENTO" = :gs_tipo_cobro ) AND  
						  ( "ELECTRONICA_FB"."RUT_EMPRESA" = :ls_rut_empresa ) AND
						  ( "ELECTRONICA_FB_DETALLE"."ESTADO_REG" = 'P'  ) )   
			USING		sqlca;
			//( ("ELECTRONICA_FB_DETALLE"."ESTADO_REG" = 'P' or "ELECTRONICA_FB_DETALLE"."ESTADO_REG" = 'B' ) ) )   
			if sqlca.sqlcode <> 0 then
				messagebox("Advertencia","Documento N° "+string(ll_folio,'###,###,###,###')+" NO Existe o ya está Gestionado")
				sle_numero_ci.text 							= ''
				cb_ci_insertar.Enabled 						= false
				cb_ci_borrar_item.Enabled 					= false
				pb_ficha.Enabled 								= false
				dw_detalle_ci.reset()
				sle_numero_ci.setfocus()
				ls_pasa											= 'N'
			end if
		end if
		if ls_pasa='S' then
			tab_ingreso.tp_ci.pb_ficha.enabled			= true
			if gs_rezago = "S" then
				tab_ingreso.tp_ci.gb_1.visible				= true
				tab_ingreso.tp_ci.rb_ci_uf.visible			= true
				tab_ingreso.tp_ci.rb_ci_peso.visible		= true
				tab_ingreso.tp_ci.rb_ci_uf.checked		= true
			else
				tab_ingreso.tp_ci.gb_1.visible				= false
				tab_ingreso.tp_ci.rb_ci_uf.visible			= false
				tab_ingreso.tp_ci.rb_ci_peso.visible		= false
				wf_cargar_cupones_ci(gs_base,gs_serie,gi_numero)
			end if
			IF LONG(sle_numero_ci.text)>0 THEN
				cb_ci_insertar.Enabled 						= TRUE
				cb_ci_borrar_item.Enabled 					= TRUE
				pb_ficha.Enabled 								= TRUE
				cb_ci_insertar.setfocus()
			ELSE
				Messagebox("Advertencia","Número de "+gs_tipo_cobro+" debe ser Mayor a 0")
				sle_numero_ci.text							= ''
				sle_numero_ci.setfocus()
			END IF
		end if
	END IF
end if
end event

