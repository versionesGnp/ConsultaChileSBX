ldt_fecha_uf																	= date(em_fec_uf.text)
id_uf 																			= 0
em_fec_uf.text																= st_fecha.text
SELECT 	"TAB_UF"."VALOR_UF"  
INTO 		:id_uf  
FROM 	"TAB_UF"  
WHERE 	"TAB_UF"."FECHA_UF" = :ldt_fecha_uf;		//id_fecha;
IF id_uf > 0  THEN 
	gd_uf_dia				= id_uf
	gd_uf 					= id_uf	
	st_uf.text 				= String(id_uf, "###,###,##0.0###")
	tab_ingreso.tp_ci.dw_ci_buscar_cliente.SetFocus( )
ELSE
	Open(w_mantenedor_uf)
	id_fecha = Date(st_fecha.text)
	id_uf 						= 0
	SELECT 	"TAB_UF"."VALOR_UF"  
	INTO 		:id_uf  
	FROM 	"TAB_UF"  
	WHERE 	"TAB_UF"."FECHA_UF" = :id_fecha
	using		sqlca;
	if sqlca.sqlcode<>0 then
		close(w_ingreso2)
	else
		gd_uf 				= id_uf	
		gd_uf_dia			= id_uf
		st_uf.text 			= String(id_uf, "###,###,##0.0###")
		tab_ingreso.tp_ci.dw_ci_buscar_cliente.SetFocus( )
//		tab_ingreso.tp_cupon.sle_n_contrato.SetFocus( )
	end if
END IF
SELECT 	"TAB_UF"."VALOR_UF"  
INTO 		:id_uf  
FROM 	"TAB_UF"  
WHERE 	"TAB_UF"."FECHA_UF" = :ldt_fecha_uf //		id_fecha
using		sqlca;
if id_uf>0 then
	gd_uf 					= id_uf	
	gd_uf_dia				= id_uf
	tab_ingreso.tp_ci.dw_detalle_ci.getchild('tipo_cob',idw_detalle)
	idw_detalle.settransobject(sqlca)
	idw_detalle.retrieve('CI')
	
	tab_ingreso.tp_be.dw_detalle_be.getchild('tipo_cob',idw_detalle4)
	idw_detalle4.settransobject(sqlca)
	idw_detalle4.retrieve('BE')
	
	tab_ingreso.tp_be.dw_detalle_be.getchild('tipo_cob_otro',idw_detalle12)
	idw_detalle12.settransobject(sqlca)
	idw_detalle12.retrieve('BE')
	
	tab_ingreso.tp_ci.dw_detalle_ci.getchild('tipo_cob_otro',idw_detalle15)
	idw_detalle15.settransobject(sqlca)
	idw_detalle15.retrieve('CI')
	
//	tab_ingreso.tp_boletas.dw_detalle_be.getchild('facturas_ingreso_tipo_mov_1',idw_detalle5)
//	idw_detalle5.settransobject(sqlca)
//	idw_detalle5.retrieve('FE')
	
	tab_ingreso.tp_boletas.dw_detalle_bl.getchild('tipo_cob',idw_detalle2)
	
	idw_detalle2.settransobject(sqlca)
	idw_detalle2.retrieve('FE')
	
	
//	tab_ingreso.tp_ci.dw_detalle_ci.Retrieve()
	
	st_uf.text 							= String(id_uf, "###,###,##0.0###")
	if gs_depto='H' then
		tab_ingreso.SelectedTab		= 5
	else
		tab_ingreso.SelectedTab		= 2
	end if
	
	SELECT 	Count("TIPO_CONTRATO"."CODIGO" ) 
	INTO 		:ll_count_mp  
	FROM 	"TIPO_CONTRATO"  
	WHERE 	"TIPO_CONTRATO"."CODIGO" = 'M'   ;
	if ll_count_mp > 0 and gs_rezago='S' then
		tab_ingreso.tp_ci.dw_mp_rezago.visible			= true
	else
		tab_ingreso.tp_ci.dw_mp_rezago.visible			= False
	end if
else
	close(w_ingreso2)
end if
end event

event mousemove;tab_ingreso.tp_ci.st_14.visible							= false
tab_ingreso.tp_ci.st_help_insertar.visible				= false
tab_ingreso.tp_ci.st_help_eliminar.visible			= false
