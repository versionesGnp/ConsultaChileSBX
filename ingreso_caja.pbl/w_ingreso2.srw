this.pb_1=create pb_1
this.em_fec_fin=create em_fec_fin
this.st_20=create st_20
this.cb_mostrar_factura=create cb_mostrar_factura
this.cb_limpiar_factura=create cb_limpiar_factura
this.pb_factura=create pb_factura
this.em_folio_factura=create em_folio_factura
this.st_18=create st_18
this.cb_imprimir_factura=create cb_imprimir_factura
this.st_17=create st_17
this.dw_por_facturar=create dw_por_facturar
this.Control[]={this.cb_cta_mortuoria,&
this.p_fin,&
this.pb_1,&
this.em_fec_fin,&
this.st_20,&
this.cb_mostrar_factura,&
this.cb_limpiar_factura,&
this.pb_factura,&
this.em_folio_factura,&
this.st_18,&
this.cb_imprimir_factura,&
this.st_17,&
this.dw_por_facturar}
end on

on tp_porfacturar.destroy
destroy(this.cb_cta_mortuoria)
destroy(this.p_fin)
destroy(this.pb_1)
destroy(this.em_fec_fin)
destroy(this.st_20)
destroy(this.cb_mostrar_factura)
destroy(this.cb_limpiar_factura)
destroy(this.pb_factura)
destroy(this.em_folio_factura)
destroy(this.st_18)
destroy(this.cb_imprimir_factura)
destroy(this.st_17)
destroy(this.dw_por_facturar)
end on

