event itemchanged;Long		ll_folio

dw_parque_factura.accepttext()
gl_cod_parque		= dw_parque_factura.getitemnumber(1,'cod_parque')
if gl_cod_parque <> 106 then
	messagebox("Advertencia","Solo es Posible generar Factura Producto Funeraria")
	dw_parque_factura.reset()
	dw_parque_factura.insertrow(0)
	dw_parque_factura.setitem(1,'cod_parque',106)
	dw_parque_factura.accepttext()
	dw_parque_factura.setfocus()
else
	ll_folio				= long(sle_numero_bl.text)
	if cbx_manual_factura.checked = false then
		if ll_folio > 0 then
			wf_limpiar_boleta_electronica(ll_folio)
		end if
	end if
end if
end event

type cb_asigna_folio from picturebutton within tp_boletas
integer x = 1687
integer y = 292
integer width = 146
integer height = 112
integer taborder = 40
integer textsize = -11
integer weight = 700
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Tahoma"
boolean enabled = false
string picturename = "filtrar.bmp"
string disabledname = "filtrar_no.bmp"
alignment htextalign = left!
end type

event clicked;Long		ll_min_boleta,ll_grupo,ll_rut,ll_pos,ll_rut_cont,ll_cod_parque,ll_cant_folio_p,ll_count_pend
datetime	ldt_fecha_pago
String		ls_dv,ls_ap_pat,ls_ap_mat,ls_nombre,ls_base,ls_serie,ls_nom_paso,ls_rut_empresa,ls_pasa='S'
Double	ll_numero,ll_numero_cont

ll_numero_cont							= Double(dw_bl_buscar_cliente.getitemstring(1,'rn_contrato'))
ll_rut_cont								= long(dw_bl_buscar_cliente.getitemstring(1,'rl_rut'))
if gs_rezago='S' then
	ll_cod_parque						= dw_parque_factura.getitemnumber(1,'cod_parque')
	if isnull(ll_cod_parque) or ll_cod_parque=0 then
		ls_pasa							= 'N'
		messagebox("Advertencia","Debe Seleccionar Parque o Producto")
		dw_parque_factura.setfocus()
	else
		gl_cod_parque					= ll_cod_parque
	end if
end if
if ls_pasa='S' then
	if isnull(ll_numero_cont) then ll_numero_cont=0
	if isnull(ll_rut_cont) then ll_rut_cont=0
	if ll_numero_cont<>0 or ll_rut_cont<>0 then
		if cbx_manual_factura.checked=false then
			if sle_numero_bl.text = '' then
				sle_numero_bl.text			= ''
				dw_detalle_bl.reset()
				dw_gastos_bl.reset()
				sle_numero_bl.enabled		= true
				cb_bl_insertar.enabled		= false
				cb_bl_borrar_item.enabled	= false
			//	pb_ficha.enabled				= false
				if rb_fac_afecta.checked = true then
					gs_tipo_cobro				= "FA"
					dw_detalle_bl.dataobject	= 'de_detalle_ci_6'
					dw_detalle_bl.getchild('tipo_cob',idw_detalle2)
					idw_detalle2.settransobject(sqlca)
					idw_detalle2.retrieve(gs_tipo_cobro)
				elseif rb_fac_exenta.checked = true then
					gs_tipo_cobro				= "FE"
					dw_detalle_bl.dataobject	= 'de_detalle_ci_5'
					dw_detalle_bl.getchild('tipo_cob',idw_detalle)
					idw_detalle.settransobject(sqlca)
					idw_detalle.retrieve(gs_tipo_cobro)
				end if
				dw_detalle_bl.settransobject(sqlca)
				SELECT	"MEMBRETE_EMPRESA"."STRING_RUT"
				INTO 		:ls_rut_empresa
				FROM 	"MEMBRETE_EMPRESA"  
				WHERE 	"MEMBRETE_EMPRESA"."COD_PARQUE" = :gl_cod_parque   ;

				SELECT	"ELECTRONICA_FB"."GRUPO"  
				INTO 		:ll_grupo  
				FROM 	"ELECTRONICA_FB"  
				WHERE ( "ELECTRONICA_FB"."TIPO_DOCUMENTO" = :gs_tipo_cobro ) AND  
						  ( "ELECTRONICA_FB"."RUT_EMPRESA" = :ls_rut_empresa ) AND 
						  ( "ELECTRONICA_FB"."ESTADO" = 'P' )   ;
//////////////////////////////////////
				if not isnull(ls_rut_empresa) and ll_grupo > 0 then
					ll_cant_folio_p			= gl_folio_diario * gl_veces_diario
					SELECT	Count("ELECTRONICA_FB_DETALLE"."NRO_DOCUMENTO") 
					INTO		:ll_count_pend
					FROM 	"ELECTRONICA_FB",   
								"ELECTRONICA_FB_DETALLE"  
					WHERE ( "ELECTRONICA_FB"."TIPO_DOCUMENTO" = "ELECTRONICA_FB_DETALLE"."TIPO_DOCUMENTO" ) and  
							  ( "ELECTRONICA_FB"."GRUPO" = "ELECTRONICA_FB_DETALLE"."GRUPO" ) and  
							  ( "ELECTRONICA_FB"."ESTADO" = 'P' ) AND  
							  ( "ELECTRONICA_FB"."TIPO_DOCUMENTO" = :gs_tipo_cobro ) AND 
							  ( "ELECTRONICA_FB_DETALLE"."COD_CAJA" = :gs_caja )   AND
							  ( "ELECTRONICA_FB"."RUT_EMPRESA" = :ls_rut_empresa ) AND 
							  ( "ELECTRONICA_FB_DETALLE"."ESTADO_REG" = 'P' );
					if ll_count_pend < ll_cant_folio_p then
						Messagebox("Advertencia","Recuerde quedan "+String(ll_count_pend)+" Documentos "+gs_tipo_cobro+" PENDIENTES, favor dar aviso Depatamento Informática")
					end if
					
					ldt_fecha_pago				= datetime(date(st_fecha.text),time('00:00:00'))
					if gs_rezago <> 'S' then
						ll_rut						= long(dw_bl_buscar_cliente.getitemstring(1,'rl_rut'))
						gi_rut						= ll_rut
						ls_dv						= dw_bl_buscar_cliente.getitemstring(1,'cf_obtener_dv')
						gs_dv						= ls_dv
						ls_nombre				= dw_bl_buscar_cliente.getitemstring(1,'rs_nombre')
						ls_ap_pat				= dw_bl_buscar_cliente.getitemstring(1,'rs_a_paterno')
						ls_ap_mat				= dw_bl_buscar_cliente.getitemstring(1,'rs_a_materno')
						ls_base					= gs_base
						ls_serie					= gs_serie
						ll_numero				= gi_numero
					else
						ll_rut						= gi_rut
						ls_dv						= gf_obtener_dv(ll_rut)
						gs_dv						= ls_dv
						ls_nom_paso			= gs_nombre_completo
						ll_pos						= Pos(ls_nom_paso, " ")
						ls_nombre				= trim(mid(ls_nom_paso,1,ll_pos))
						ls_nom_paso			= trim(mid(ls_nom_paso,ll_pos))
						ll_pos						= Pos(ls_nom_paso, " ")
						ls_ap_pat				= trim(mid(ls_nom_paso,1,ll_pos))
						ls_nom_paso			= trim(mid(ls_nom_paso,ll_pos))
						ll_pos						= Pos(ls_nom_paso, " ")
						ls_ap_mat				= trim(mid(ls_nom_paso,1,ll_pos))
						ls_base					= mid(gs_contrato_rezago,1,1)
						ls_serie					= mid(gs_contrato_rezago,2,1)
						ll_numero				= Double(mid(gs_contrato_rezago,3))
					end if
					ls_nombre	= ls_nombre +' '+ls_ap_pat+' '+ls_ap_mat
					if len(ls_nombre) > 40 then
						ls_nombre	= mid(ls_nombre,1,40)
					end if
					SQLCA.Lock = "3" 
					
					UPDATE		"ELECTRONICA_FB_DETALLE"  
					SET 			"FECHA_PAGO" = :ldt_fecha_pago,   
									"RUT" = :gi_rut,   
									"ESTADO_REG" = 'P',   
									"DV" = :gs_dv,   
									"NOMBRE_CLIENTE" = :ls_nombre,   
									"USUARIO_CREA" = :gs_user,
									"BASE"  = :ls_base,
									"SERIE" = :ls_serie,
									"NUMERO" = :ll_numero,
									"IP_EQUIPO" = :gs_tcp_ip
					WHERE 	  ( "ELECTRONICA_FB_DETALLE"."GRUPO" = :ll_grupo ) AND  
								  ( "ELECTRONICA_FB_DETALLE"."TIPO_DOCUMENTO" = :gs_tipo_cobro ) AND  
								  ( "ELECTRONICA_FB_DETALLE"."ESTADO_REG" = 'P' )   AND
								  ( "ELECTRONICA_FB_DETALLE"."COD_CAJA" = :gs_caja )   AND
								  ( "ELECTRONICA_FB_DETALLE"."NRO_DOCUMENTO" = (SELECT	MIN("ELECTRONICA_FB_DETALLE"."NRO_DOCUMENTO") 
																										FROM 	"ELECTRONICA_FB",   
																													"ELECTRONICA_FB_DETALLE"  
																										WHERE ( "ELECTRONICA_FB"."TIPO_DOCUMENTO" = "ELECTRONICA_FB_DETALLE"."TIPO_DOCUMENTO" ) and  
																												  ( "ELECTRONICA_FB"."GRUPO" = "ELECTRONICA_FB_DETALLE"."GRUPO" ) and  
																												  ( "ELECTRONICA_FB"."ESTADO" = 'P' ) AND  
																												  ( "ELECTRONICA_FB"."TIPO_DOCUMENTO" = :gs_tipo_cobro ) AND 
																												  ( "ELECTRONICA_FB_DETALLE"."COD_CAJA" = :gs_caja )   AND
																												  ( "ELECTRONICA_FB"."RUT_EMPRESA" = :ls_rut_empresa ) AND 
																												  ( "ELECTRONICA_FB_DETALLE"."ESTADO_REG" = 'P' )) )
					USING		sqlca;
					//								  ( "ELECTRONICA_FB_DETALLE"."NRO_DOCUMENTO" = :gl_folio ) AND  
					if sqlca.sqlcode=0 then
						commit;					
						if gs_rezago <> 'S' then
							SELECT	"ELECTRONICA_FB_DETALLE"."NRO_DOCUMENTO"
							INTO 		:ll_min_boleta
							FROM 	"ELECTRONICA_FB",   
										"ELECTRONICA_FB_DETALLE"  
							WHERE ( "ELECTRONICA_FB"."TIPO_DOCUMENTO" = "ELECTRONICA_FB_DETALLE"."TIPO_DOCUMENTO" ) and  
									  ( "ELECTRONICA_FB"."GRUPO" = "ELECTRONICA_FB_DETALLE"."GRUPO" ) and  
									  (("ELECTRONICA_FB"."ESTADO" = 'P' ) AND  
									  ( "ELECTRONICA_FB"."TIPO_DOCUMENTO" = :gs_tipo_cobro ) AND 
									  ( "ELECTRONICA_FB"."RUT_EMPRESA" = :ls_rut_empresa ) AND 
									  ( "ELECTRONICA_FB_DETALLE"."FECHA_PAGO" = :ldt_fecha_pago ) AND   
									  ( "ELECTRONICA_FB_DETALLE"."RUT" = :gi_rut) AND
									  ( "ELECTRONICA_FB_DETALLE"."DV" = :gs_dv) AND
									  ( "ELECTRONICA_FB_DETALLE"."NOMBRE_CLIENTE" = :ls_nombre) AND
									  ( "ELECTRONICA_FB_DETALLE"."USUARIO_CREA" = :gs_user) AND
									  ( "ELECTRONICA_FB_DETALLE"."BASE"  = :ls_base) AND
									  ( "ELECTRONICA_FB_DETALLE"."SERIE" = :ls_serie) AND
									  ( "ELECTRONICA_FB_DETALLE"."NUMERO" = :ll_numero) AND
									  ( "ELECTRONICA_FB_DETALLE"."IP_EQUIPO" = :gs_tcp_ip) AND
									  ( "ELECTRONICA_FB_DETALLE"."COD_CAJA" = :gs_caja )   AND
									  ( "ELECTRONICA_FB_DETALLE"."ESTADO_REG" = 'P' ) );
						else
							SELECT	"ELECTRONICA_FB_DETALLE"."NRO_DOCUMENTO"
							INTO 		:ll_min_boleta
							FROM 	"ELECTRONICA_FB",   
										"ELECTRONICA_FB_DETALLE"  
							WHERE ( "ELECTRONICA_FB"."TIPO_DOCUMENTO" = "ELECTRONICA_FB_DETALLE"."TIPO_DOCUMENTO" ) and  
									  ( "ELECTRONICA_FB"."GRUPO" = "ELECTRONICA_FB_DETALLE"."GRUPO" ) and  
									  (("ELECTRONICA_FB"."ESTADO" = 'P' ) AND  
									  ( "ELECTRONICA_FB"."TIPO_DOCUMENTO" = :gs_tipo_cobro ) AND 
									  ( "ELECTRONICA_FB"."RUT_EMPRESA" = :ls_rut_empresa ) AND 
									  ( "ELECTRONICA_FB_DETALLE"."FECHA_PAGO" = :ldt_fecha_pago ) AND   
									  ( "ELECTRONICA_FB_DETALLE"."RUT" = :gi_rut) AND
									  ( "ELECTRONICA_FB_DETALLE"."IP_EQUIPO" = :gs_tcp_ip) AND
									  ( "ELECTRONICA_FB_DETALLE"."COD_CAJA" = :gs_caja )   AND
									  ( "ELECTRONICA_FB_DETALLE"."ESTADO_REG" = 'P' ) );
						end if
						gl_folio						= ll_min_boleta
						sle_numero_bl.text		= string(ll_min_boleta)
						sle_numero_bl.enabled	= false
						sle_numero_bl.setfocus()
						sle_numero_bl.triggerevent(modified!)
					else
						rollback;
						messagebox("Error Grabar FACTURA","Error al Grabar FACTURA - Folio NO Disponible para "+gs_tipo_cobro+" SQL: "+sqlca.sqlerrtext)
					end if
				else
					messagebox("Advertencia","No Existe Folio para esta Empresa "+ls_rut_empresa)
				end if
//////////////////////////////////////						  
//				if not isnull(ls_rut_empresa) and ll_grupo > 0 then
//					gl_folio						= ll_min_boleta
//					SELECT	"ELECTRONICA_FB"."GRUPO"  
//					INTO 		:ll_grupo  
