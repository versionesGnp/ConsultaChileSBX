public subroutine wf_proceso_002 (long row);
			sw_ok_002						= 'S'
			il_tot_reg_002					= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount()
			il_fila_002 					= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob ='4' or tipo_cob ='6'",1, il_tot_reg_002)
			if il_fila_002 > 0 then
				il_count_e_002 				= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob ='E' or tipo_cob ='U'",1, il_tot_reg_002)
				if il_count_e_002 = 0 then
					w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1,'gasto_cred', 0)
					w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1,'mora_cred', 0)
					w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.accepttext()
					do while sw_ok_002 = 'S'
						il_fila_002 		= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob ='4' or tipo_cob ='6'",1, il_tot_reg_002)
						if il_fila_002 > 0 then
							w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.deleterow(il_fila_002)
							il_fila_002 		= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob ='4' or tipo_cob ='6'",1, il_tot_reg_002)
							if il_fila_002 = 0 then sw_ok_002 = 'N'
						end if
					loop
				end if
			end if
			if is_tipo_cob_002='K' then
				wf_setear_movK(row)
			elseif is_tipo_cob_002='S' or is_tipo_cob_002='L' then
				w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.getrow(), "monto", 0)
				w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.getrow(), "cantidad", 1)
				is_texto_002	= is_tipo_cob_002+'~t'+is_tipo_comp_002
				
				
				// VHFB -- INCIO -- CONTROL DE INGRESO AUTOMATICO	
				if  gb_aplica = false  then
					openwithparm(w_apertura_tipo_cobro_otros,is_texto_002)
				END IF 
				// VHFB -- TERMINO -- CONTROL DE INGRESO AUTOMATICO			
				
				
			elseif is_tipo_cob_002='F' then
				if w_ingreso2.tab_ingreso.tp_be.rb_be_exenta.checked=true then
					w_ingreso2.tab_ingreso.tp_be.rb_be_exenta.checked		= false
					w_ingreso2.tab_ingreso.tp_be.rb_be_afecta.checked			= true
					w_ingreso2.tab_ingreso.tp_be.rb_be_afecta.triggerevent(clicked!)
				end if
				il_fila_002	= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob ='A' or tipo_cob ='E' or tipo_cob ='Q' or tipo_cob ='U'",1,w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount())
				if il_fila_002 = 0 then
					w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1,'gasto_cred', 0)
					w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1,'mora_cred', 0)
					w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.accepttext()
				end if
				if gs_rezago <> "S" THEN
					if gs_conexion = "Parque Santiago" then
						messagebox("Advertencia","No es posible Ingresar F-Cuota Mantención por Comprobante de Ingreso, en PARQUE SANTIAGO")
						w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(row, "monto", 0)
						w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(row, "tipo_cob", is_nulo_002)
						w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(row, "cantidad", 0)
						w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.accepttext()
						w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setfocus()
						w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setcolumn('tipo_cob')
					elseif is_tipo_cob_002='F' and gs_tipo_cobro='BE' then
						messagebox("Advertencia","No es posible Ingresar F-Cuota Mantención por Boleta Exenta")
						w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(row, "monto", 0)
						w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(row, "tipo_cob", is_nulo_002)
						w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(row, "cantidad", 0)
						w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.accepttext()
						w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setfocus()
						w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setcolumn('tipo_cob')
					elseif is_tipo_cob_002='F' and st_toku.visible=true then
						messagebox("Advertencia","No es posible Ingresar F-Cuota Mantención por estar Suscrito PAC - Toku")
						w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(row, "monto", 0)
						w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(row, "tipo_cob", is_nulo_002)
						w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(row, "cantidad", 0)
						w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.accepttext()
						w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setfocus()
						w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setcolumn('tipo_cob')
					else
						CHOOSE CASE gs_base
							CASE "O","U","M"
								IF w_ingreso2.tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'oferta_v_cta_pag_m') > 90 then
									messagebox ("Advertencia ", "Este Contrato tiene anexo Liberador de Mantención ",information!)
									RETURN
								end if
							CASE "C"
								IF w_ingreso2.tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'contrato_cta_pag_m') > 90 then
									messagebox ("Advertencia ", "Este Contrato tiene anexo Liberador de Mantención ",information!)
									RETURN
								end if
						END CHOOSE
						wf_validar_abono(row)
						
					end if
					//Script nuevo IVA Autor MM 22/12/2022
					if gs_tipo_cobro = 'BA' then
						il_monto_cuota_reg_002		= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.getitemnumber(w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.getrow(),'c_total_linea')
						ii_cantidad_002 					= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.GetItemNumber(w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.getrow(), "cantidad")
						if isnull(ii_cantidad_002) or ii_cantidad_002 = 0 then ii_cantidad_002=1
						il_cuota_ini_002					= il_ctas_pag_m_002 + 1
						il_cuota_fin_002					= (il_cuota_ini_002 + ii_cantidad_002) - 1
						SELECT SUM( "VISTA_MANTEN_IVA"."IVA"  )
						INTO    :idb_iva_002
						FROM    "VISTA_MANTEN_IVA"  
						WHERE ( "VISTA_MANTEN_IVA"."BASE" = :gs_base ) AND  
								  ( "VISTA_MANTEN_IVA"."SERIE" = :gs_serie ) AND  
								  ( "VISTA_MANTEN_IVA"."NUMERO" = :gi_numero ) AND
								  ( "VISTA_MANTEN_IVA"."TIPO_MOV" = 'F' ) AND
								  ( "VISTA_MANTEN_IVA"."NRO_CUOTA" >= :il_cuota_ini_002 ) AND
								  ( "VISTA_MANTEN_IVA"."NRO_CUOTA" <= :il_cuota_fin_002 ) ;
						if idb_iva_002 > 0 and il_monto_cuota_reg_002 > 0 then
								gs_tipo_cobro_aux		= 'BE'
								il_iva_f_002 					= idb_iva_002		//round(il_monto_cuota_reg_002 * (idb_iva - 1),0)
								il_new_iva_002				= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob = 'D'", 1, w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount())
								if il_new_iva_002 > 0 then
									if idb_iva_002 > 0 then
										w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.scrolltorow(il_new_iva_002)
									else
										w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.deleterow(il_new_iva_002)
									end if
								else
									il_new_iva_002			= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.insertrow(0)
								end if
								w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(il_new_iva_002,'tipo_cob', 'D')
								if w_ingreso2.tab_ingreso.tp_be.rb_be_afecta.checked=true then
									w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(il_new_iva_002, "iva", idb_iva)
								end if
								w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(il_new_iva_002,'cantidad', 1)
								is_moneda_insert_002	= '1'
								if is_moneda_insert_002 = '1' then
									w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(il_new_iva_002,'monto_uf', round( il_iva_f_002 / gd_uf,4))
									w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(il_new_iva_002,'monto', il_iva_f_002)
								end if
								w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(il_new_iva_002,'uf',gd_uf)
								w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(il_new_iva_002,'estado','S')
								w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(il_new_iva_002, "moneda",'P')
						  else
								il_iva_f_002 				= 0
								gl_iva_exento_f		= il_monto_cuota_reg_002
								il_new_iva_002			= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob = 'D'", 1, w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount())
								if il_new_iva_002 > 0 then
									w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.deleterow(il_new_iva_002)
								end if
						  end if
						  il_mora_mant_002			=w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.getitemnumber(1,'mora_mant')
						  if il_mora_mant_002 > 0 then
							  SELECT  SUM("VISTA_MANTEN_IVA"."IVA")  
							  INTO    	:idb_iva_002
							  FROM    "VISTA_MANTEN_IVA"  
							  WHERE   ( "VISTA_MANTEN_IVA"."BASE" = :gs_base ) AND  
										  ( "VISTA_MANTEN_IVA"."SERIE" = :gs_serie ) AND  
										  ( "VISTA_MANTEN_IVA"."NUMERO" = :gi_numero ) AND
										  ( "VISTA_MANTEN_IVA"."TIPO_MOV" = 'P' ) AND
										  ( "VISTA_MANTEN_IVA"."NRO_CUOTA" >= :il_cuota_ini_002 ) AND
										  ( "VISTA_MANTEN_IVA"."NRO_CUOTA" <= :il_cuota_fin_002 );
							  if idb_iva_002 > 0 and il_mora_mant_002 > 0 then
									gs_tipo_cobro_aux		= 'BE'
									il_iva_p_002 					= round(il_mora_mant_002 * (idb_iva - 1),0)
									il_new_iva_002				= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob = 'V'", 1, w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount())
									if il_new_iva_002 > 0 then
										w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.scrolltorow(il_new_iva_002)
									else
										il_new_iva_002			= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.insertrow(0)
									end if
									w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(il_new_iva_002,'tipo_cob', 'V')
									if w_ingreso2.tab_ingreso.tp_be.rb_be_afecta.checked=true then
										w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(il_new_iva_002, "iva", idb_iva)
									end if
									w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(il_new_iva_002,'cantidad', 1)
									is_moneda_insert_002	= '1'
									if is_moneda_insert_002 = '1' then
										w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(il_new_iva_002,'monto_uf', round( il_iva_p_002 / gd_uf,4))
										w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(il_new_iva_002,'monto', il_iva_p_002)
									end if
									w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(il_new_iva_002,'uf',gd_uf)
									w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(il_new_iva_002,'estado','S')
									w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(il_new_iva_002, "moneda",'P')
							  else
									il_iva_p_002 			= 0
							  end if
						  end if
						  il_gasto_mant_002				=w_ingreso2.tab_ingreso.tp_be. dw_gastos_be.getitemnumber(1,'gasto_mant')
						  if il_gasto_mant_002 > 0 then
							  SELECT  SUM("VISTA_MANTEN_IVA"."IVA" ) 
							  INTO    	:idb_iva_002
							  FROM    "VISTA_MANTEN_IVA"  
							  WHERE ( "VISTA_MANTEN_IVA"."BASE" = :gs_base ) AND  
									  ( "VISTA_MANTEN_IVA"."SERIE" = :gs_serie ) AND  
									  ( "VISTA_MANTEN_IVA"."NUMERO" = :gi_numero ) AND
									  ( "VISTA_MANTEN_IVA"."TIPO_MOV" = 'R' ) AND
									  ( "VISTA_MANTEN_IVA"."NRO_CUOTA" >= :il_cuota_ini_002 ) AND
									  ( "VISTA_MANTEN_IVA"."NRO_CUOTA" <= :il_cuota_fin_002 );
							  if idb_iva_002 > 0 and il_gasto_mant_002 > 0 then
									gs_tipo_cobro_aux		= 'BE'
									il_iva_r_002 					= round(il_gasto_mant_002 * (idb_iva - 1),0)
									il_new_iva_002				= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob = 'X'", 1, w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount())
									if il_new_iva_002 > 0 then
										w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.scrolltorow(il_new_iva_002)
									else
										il_new_iva_002			= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.insertrow(0)
									end if
									w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(il_new_iva_002,'tipo_cob', 'X')
									if w_ingreso2.tab_ingreso.tp_be.rb_be_afecta.checked=true then
										w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(il_new_iva_002, "iva", idb_iva)
									end if
									w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(il_new_iva_002,'cantidad', 1)
									is_moneda_insert_002	= '1'
									if is_moneda_insert_002 = '1' then
										w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(il_new_iva_002,'monto_uf', round( il_iva_r_002 / gd_uf,4))
										w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(il_new_iva_002,'monto', il_iva_r_002)
									end if
									w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(il_new_iva_002,'uf',gd_uf)
									w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(il_new_iva_002,'estado','S')
									w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(il_new_iva_002, "moneda",'P')
							  else
									il_iva_r_002 			= 0
							  end if
						end if
						  //Fin script nuevo IVA Autor MM 22/12/2022
					end if
				END IF
				
			elseif is_tipo_cob_002='M' then
				gs_tipo_cobro_aux										= 'BE'
				if gs_rezago <> "S" THEN
					is_estado_cadena_002 = w_ingreso2.tab_ingreso.tp_be.dw_datos_be.getitemstring(1,'cadena_estado')
					if is_estado_cadena_002='V' or is_estado_cadena_002='C' or is_estado_cadena_002='S' then
						if gs_base='O' or gs_base='C' or gs_base='U' or gs_base='M' then
							tab_ingreso.tp_be.rb_be_uf.visible		= true
							tab_ingreso.tp_be.rb_be_peso.visible	= false
							tab_ingreso.tp_be.rb_be_uf.checked	= true
							tab_ingreso.tp_be.rb_be_peso.visible	= false
							if w_ingreso2.tab_ingreso.tp_be.rb_be_uf.checked=true then 
								w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.getrow(), "moneda",'U')
							elseif w_ingreso2.tab_ingreso.tp_be.rb_be_peso.checked=true then 
								w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.getrow(), "moneda",'P')
							end if
							if w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.getitemnumber(row,'cantidad') <= 1 or isnull(w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.getitemnumber(row,'cantidad')) then w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(row, "cantidad", 1)
						else
							messagebox("Advertencia","No es Posible Ingresar M-Derecho Sepultura para este Tipo de Contrato")
							w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(row, "monto", 0)
							w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(row, "cantidad", 0)
							w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setfocus()
							w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setcolumn('tipo_cob')
						end if
					else
						tab_ingreso.tp_be.rb_be_uf.visible		= false
						tab_ingreso.tp_be.rb_be_peso.visible	= false
						tab_ingreso.tp_be.rb_be_uf.checked	= false
						tab_ingreso.tp_be.rb_be_peso.visible	= true
						messagebox("Advertencia","Recuerde que Contrato debe estar V-Vigente o C-Cancelado")
						w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(row, "monto", 0)
						w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(row, "cantidad", 0)
						w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setfocus()
						w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setcolumn('tipo_cob')
					end if
				end if
				
			elseif is_tipo_cob_002<>'S' and is_tipo_cob_002<>'K' and is_tipo_cob_002<>'M' and is_tipo_cob_002<>'L' and is_tipo_cob_002<>'F' then
				messagebox("Advertencia","No es Posible Ingresar este Tipo de Cobro")
				w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.deleterow(row)
				fila_002 					= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.InsertRow(0)
				w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.scrolltorow(fila_002)
				w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(fila_002, "uf", gd_uf)
				if w_ingreso2.tab_ingreso.tp_be.rb_be_afecta.checked=true then
					w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(fila_002, "iva", idb_iva)
				end if
				w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(fila_002, "folio", 0)
				w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(fila_002, "estado", 'N')
				w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(fila_002, "uf", gd_uf)
				if w_ingreso2.tab_ingreso.tp_be.rb_be_uf.checked=true then
					w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(fila_002, "moneda",'U')
				else
					w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(fila_002, "moneda",'P')
				end if
				setnull(is_tipo_cob_002);setnull(is_columna_002)
				w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.scrolltorow(row)
				w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setfocus()
				w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setcolumn('tipo_cob')
			END IF


