event clicked;long		ll_indi, ll_tot_reg,ll_monto,ll_cantidad,ll_sw_pasa=0
Double	ld_monto_uf
String	ls_tipo_cob,ls_moneda,ls_tipo_cob_otro,ls_texto

is_pasa_descto='S'
if isvalid(w_forma_pago2) then close(w_forma_pago2)
ll_tot_reg					= dw_detalle_ci.rowcount()
if ll_tot_reg>0 then
	for ll_indi=1 to ll_tot_reg
		ls_tipo_cob			= dw_detalle_ci.getitemstring(ll_indi,'tipo_cob')
		ls_tipo_cob_otro	= dw_detalle_ci.getitemstring(ll_indi,'tipo_cob_otro')
		ll_cantidad			= dw_detalle_ci.getitemnumber(ll_indi,'cantidad')
		ll_monto				= dw_detalle_ci.getitemnumber(ll_indi,'monto')
		ld_monto_uf			= dw_detalle_ci.getitemnumber(ll_indi,'monto_uf')
		ls_moneda			= dw_detalle_ci.getitemstring(ll_indi,'moneda')	
		if ls_tipo_cob_otro = "" then ls_tipo_cob_otro = '0'
//		if ls_tipo_cob = 'S' and ls_tipo_cob_otro <> '0' then
//			wf_validar_descuento()
//		end if	
		if isnull(ls_tipo_cob) or ls_tipo_cob='' then
			messagebox("Advertencia","Error debe ingresar Tipo de Cobro en Fila Nº: "+string(ll_indi))
			dw_detalle_ci.setfocus()
			dw_detalle_ci.scrolltorow(ll_indi)
			dw_detalle_ci.setcolumn('tipo_cob')
			ll_sw_pasa ++
			exit
		elseif ls_tipo_cob='L' and ( isnull(ls_tipo_cob_otro) or ls_tipo_cob_otro='') then
			messagebox("Advertencia","Error debe ingresar Tipo de Cobro en Fila Nº: "+string(ll_indi))
			dw_detalle_ci.setfocus()
			dw_detalle_ci.scrolltorow(ll_indi)
			dw_detalle_ci.setcolumn('tipo_cob')
			ll_sw_pasa ++
			exit
		elseif isnull(ll_cantidad) or ll_cantidad=0 then
			messagebox("Advertencia","Error debe ingresar Cantidad en Fila Nº: "+string(ll_indi))
			dw_detalle_ci.setfocus()
			dw_detalle_ci.scrolltorow(ll_indi)
			dw_detalle_ci.setcolumn('cantidad')
			ll_sw_pasa ++
			exit
		elseif (isnull(ll_monto) or ll_monto=0) and (isnull(ld_monto_uf) or ld_monto_uf=0) then
			messagebox("Advertencia","Error debe ingresar Monto en Fila Nº: "+string(ll_indi))
			dw_detalle_ci.setfocus()
			dw_detalle_ci.scrolltorow(ll_indi)
			if ls_moneda='P' then
				dw_detalle_ci.setcolumn('monto')
			else
				dw_detalle_ci.setcolumn('monto_uf')
			end if
			ll_sw_pasa ++
			exit
		end if
	next	
	if ll_sw_pasa=0 then
		if is_pasa_descto = 'S' then
			if dw_gastos_ci.rowcount()>0 then
				gd_total 						= round(dw_gastos_ci.GetItemNumber(1 , "c_total"),0)
			end if
			if gd_total > 0 then
				if dw_datos_ci.rowcount()>0 then
					gd_fecha_prox_pago	= date(dw_datos_ci.getitemdatetime(1,'c_prox_pago'))
				else
					gd_fecha_prox_pago	= date('01/01/1900')
				end if
				gl_folio 						= Long(sle_numero_ci.text)
				gd_total						= round(gd_total,0)
	//			ls_texto						= f_trans_numero_palabra(gd_total)
	//			messagebox("",ls_texto)
	
				gs_tipo_cobro_aux			= gs_tipo_cobro
				if gs_base='F' or gs_base='V' or (gs_base='G' and gs_serie='E') then
					gs_tipo_cobro_aux		= 'BA'
				elseif gs_base='G' and gs_serie<>'E'  then
					gs_tipo_cobro_aux		= 'BE'
				end if
				Open(w_forma_pago2)

			else
				messagebox("Advertencia","Monto NO debe ser Menor o Igual a CERO")
			end if
		end if	
	end if
else
	cb_ci_insertar.setfocus()
end if
end event

