event clicked;Long		ll_tot_reg,ll_fila,ll_sum_monto_abono,ll_folio,ll_monto_final_mant,ll_res_abono,ll_count_ci,&
			ll_count_abono
String		ls_texto
Datetime	ldt_fecha_hoy

if isvalid(w_forma_pago2) then close(w_forma_pago2)
ll_tot_reg								= dw_detalle_pago_cupon.rowcount()
if ll_tot_reg > 0 then
	SELECT sysdate INTO :gdt_fec_sistema FROM "TASA" WHERE "TASA"."LOOK" = 1   ;
	ldt_fecha_hoy						= datetime(date(gdt_fec_sistema),time('00:00:00'))
	
	ll_fila	= dw_detalle_pago_cupon.Find("estado_reg = 0", 1, ll_tot_reg)
	if ll_fila > 0 then
		gd_total 						= Long(st_total_pagado.text)
		gl_folio 						= dw_detalle_pago_cupon.GetItemNumber(ll_fila, "cuponeras_detalle_nro_cupon")
		if gd_total > 0 then
			if dw_datos_credito_oferta.rowcount()>0 then
				gd_fecha_prox_pago	= date(dw_datos_credito_oferta.getitemdatetime(1,'c_prox_pago'))
			else
				gd_fecha_prox_pago	= date('01/01/1900')
			end if
			gs_rezago 					= " "
			gs_tipo_cobro 				= "CU"
			gd_total						= round(gd_total,0)
			ll_folio						= gl_folio
			if gl_folio > 0 then
				SELECT	Count("INGRESO"."FOLIO")  
				INTO 		:ll_count_ci  
				FROM 		"INGRESO"  
				WHERE  ( "INGRESO"."TIPO_COB" = 'CU' ) AND  
						 ( "INGRESO"."FOLIO" = :ll_folio ) 
				USING		sqlca;
				if ll_count_ci = 0 then
					SELECT	Count("ABONO_CTA_CTE"."FOLIO")  
					INTO 		:ll_count_abono  
					FROM 		"ABONO_CTA_CTE"  
					WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
							 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
							 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
							 ( "ABONO_CTA_CTE"."TIPO_COB" = 'CU' ) AND  
							 ( "ABONO_CTA_CTE"."FOLIO" = :ll_folio ) AND
							 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )  
					USING		sqlca;
					if ll_count_abono > 0 then
						DELETE FROM "ABONO_CTA_CTE"  
						WHERE		( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
									( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
									( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
									( "ABONO_CTA_CTE"."TIPO_COB" = 'CU' ) AND  
									( "ABONO_CTA_CTE"."FOLIO" = :ll_folio ) AND  
									( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
						USING		sqlca;
						if sqlca.sqlcode=0 then
							commit;
						else
							rollback;
							messagebox("Error Eliminar","Error ELIMINAR ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
						end if
					end if
					
					SELECT	Count("ABONO_CTA_CTE"."FOLIO_OCUPA")  
					INTO 		:ll_count_abono  
					FROM 		"ABONO_CTA_CTE"  
					WHERE  ( "ABONO_CTA_CTE"."TIPO_COB_OCUPA" = 'CU' ) AND  
							 ( "ABONO_CTA_CTE"."FOLIO_OCUPA" = :ll_folio ) AND  
							 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'O' )
					USING		sqlca;
					if ll_count_abono > 0 then
						UPDATE	"ABONO_CTA_CTE"  
						SET 		"ESTADO_REG" = 'P',   
									"TIPO_COB_OCUPA" = Null,   
									"FOLIO_OCUPA" = Null,   
									"FECHA_OCUPA" = Null,   
									"MONTO_OCUPA" = Null,   
									"USUARIO_OCUPA" = Null,   
									"CAJA_OCUPA" = Null,   
									"TIPO_MOV_OCUPA" = Null  
						WHERE  ( "ABONO_CTA_CTE"."TIPO_COB_OCUPA" = 'CU' ) AND  
								 ( "ABONO_CTA_CTE"."FOLIO_OCUPA" = :ll_folio ) AND  
								 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'O' )
						USING		sqlca;
						if sqlca.sqlcode=0 then
							commit;
						else
							rollback;
							messagebox("Error Eliminar","Error UPDATE ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
						end if
					end if
					
				end if
			end if
			
			SELECT	SUM("ABONO_CTA_CTE"."MONTO")  
			INTO 		:ll_sum_monto_abono  
			FROM 		"ABONO_CTA_CTE"  
			WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
					 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
					 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND
					 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )
			USING		sqlca;
			if ll_sum_monto_abono > 0 then
				if ll_sum_monto_abono >= gd_total then
					ll_monto_final_mant	= round(ll_sum_monto_abono - ( gd_total ) ,0)
					ll_res_abono			= messagebox("Advertencia Abono","En su Cuenta Corriente Existe Abonado $ "+string(ll_sum_monto_abono,'###,###,###,###,##0')+", se descontará por Concepto Cupon(es) $ "+string(gd_total - 1,'###,###,###,###,##0')+", quedando a su Favor $ "+string(ll_monto_final_mant,'###,###,###,###,##0')+"... desea utilizar Abono Existente",Exclamation!,YesNo!,2)
					if ll_res_abono=1 then
						ll_monto_final_mant ++
						UPDATE	"ABONO_CTA_CTE"  
						SET 		"TIPO_COB_OCUPA" = 'CU',   
									"FOLIO_OCUPA" = :ll_folio,   
									"FECHA_OCUPA" = :ldt_fecha_hoy,   
									"MONTO_OCUPA" = :gd_total - 1,   
									"USUARIO_OCUPA" = :gs_user,   
									"CAJA_OCUPA" = :gs_caja,   
									"ESTADO_REG" = 'O',
									"TIPO_MOV_OCUPA" = 'C',
									"SW_ESTADO_TRANS" = 1  
						WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
								 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
								 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
								 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
						USING		sqlca;
						if sqlca.sqlcode=0 then
							commit;
							INSERT INTO "ABONO_CTA_CTE"  
										( "RUT",		"BASE",		"SERIE",		"NUMERO",	"TIPO_COB",	"FOLIO",		"MONTO",						"FECHA_CREA",		"USUARIO_CREA",	"CAJA_CREA",	"ESTADO_REG",	"TIPO_COB_OCUPA",	"FOLIO_OCUPA",	"FECHA_OCUPA",	"MONTO_OCUPA",	"USUARIO_OCUPA",	"CAJA_OCUPA",	"TIPO_MOV_OCUPA",	"SW_ESTADO_TRANS" )
							VALUES 	( :gi_rut,	:gs_base,	:gs_serie,	:gi_numero,	'CU',			:ll_folio,	:ll_monto_final_mant,	:gdt_fec_sistema,	:gs_user,			:gs_caja,		'P',				null,					null,				null,				null,				null,					null,				null,					2 )  
							USING		sqlca;
							if sqlca.sqlcode=0 then
								commit;
							else
								rollback;
								messagebox("Error Grabar","Error al INSERTAR ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
							end if
						else
							rollback;
							messagebox("Error Grabar","Error al UPDATE ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
						end if
//					else
//						ll_monto_final_mant		= ll_monto_mant
					end if
				else
					ll_res_abono				= messagebox("Advertencia Abono","En su Cuenta Corriente Existe Abonado $ "+string(ll_sum_monto_abono,'###,###,###,###,##0')+", Monto a Cancelar es $ "+string(gd_total - ll_sum_monto_abono,'###,###,###,###,##0')+" y su Saldo quedará en 0"+"... desea utilizar Abono Existente",Exclamation!,YesNo!,2)
					if ll_res_abono = 1 then
						UPDATE	"ABONO_CTA_CTE"  
						SET 		"TIPO_COB_OCUPA" = 'CU',   
									"FOLIO_OCUPA" = :ll_folio,   
									"FECHA_OCUPA" = :ldt_fecha_hoy,   
									"MONTO_OCUPA" = :ll_sum_monto_abono,   
									"USUARIO_OCUPA" = :gs_user,   
									"CAJA_OCUPA" = :gs_caja,   
									"ESTADO_REG" = 'O',
									"TIPO_MOV_OCUPA" = 'C',
									"SW_ESTADO_TRANS" = 1  
						WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
								 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
								 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
								 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
						USING		sqlca;
						if sqlca.sqlcode=0 then
							commit;
						else
							rollback;
							messagebox("Error Grabar","Error al Update ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
						end if
//					else
//						ll_monto_final_mant		= ll_monto_mant
//						SetItem(row, "monto", ll_monto_mant)
					end if
				end if
			end if		
//			ls_texto						= f_trans_numero_palabra(gd_total)
//			messagebox("",ls_texto)
			gs_tipo_cobro_aux				= gs_tipo_cobro
			Open(w_forma_pago2)
		end if
	else
		messagebox("Advertencia","Debe Seleccionar por lo Menos UN Cupón a Cancelar")
	end if
end if
end event

