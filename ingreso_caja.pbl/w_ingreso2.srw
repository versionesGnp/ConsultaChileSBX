						ll_total_monto				= ROUND(w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.GetItemNumber(1,"c_subtotal_total"),0)
						w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1,"Subtotal", ll_total_monto)
						w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.accepttext()
					end if
				end if
			end if
		next
		if tab_ingreso.SelectedTab = 1 then // cupon
		elseif tab_ingreso.SelectedTab = 2 then //Comprobante Ingreso
			if w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.getitemnumber(1,"Subtotal")=0 or isnull(w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.getitemnumber(1,"Subtotal")) then
				w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.SetItem(1,"gastos_cob", 0)
				w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.SetItem(1,"mora", 0)
				
				w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.SetItem(1,"gasto_cred", 0)
				w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.SetItem(1,"gasto_mant", 0)
				w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.SetItem(1,"mora_cred", 0)
				w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.SetItem(1,"mora_mant", 0)
			end if	
		elseif tab_ingreso.SelectedTab = 3 then //Boleta
			if w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.getitemnumber(1,"Subtotal")=0 or isnull(w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.getitemnumber(1,"Subtotal")) then
				w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1,"gastos_cob", 0)
				w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1,"mora", 0)
				
				w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1,"gasto_cred", 0)
				w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1,"gasto_mant", 0)
				w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1,"mora_cred", 0)
				w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1,"mora_mant", 0)
			end if	
		end if
		
	end if
end if
end subroutine

public function long wf_calcular_mora_mant (long ll_indi);Long		ll_ctas_mora,ll_dia_prox_pago,ll_day,ll_month,ll_year,ll_max,ll_new,ll_dias_dif,ll_cant_mant,ll_cant_cred,ii_cantidad,ll_monto_cred,ll_monto,ll_ctas_pag,&
			ll_suma_dias,ll_tot_fila,ll_reg,ll_dias_mora,ll_cuota,ll_valor_int,ll_suma_acum_gc,	ll_gasto_cob,ll_mora,ll_total_monto,ii_dmora,ii_mora_cobro,ii_inc_gastos,&
			i,id_im,id_gc
date		ld_fecha_prox_pago,ld_fecha_inicial,ld_fecha_prox_venc,ld_fecha_hoy
datetime	ldt_fecha_prim
String	ls_fecha,ls_pasa,ls_tipo_cob
Double	id_valor_cuota

SELECT 	"ESTADO_MORA_MANTENCION"."CANTIDAD_MESES", 	"ESTADO_MORA_CREDITO"."CANTIDAD_MESES"  
INTO   	:ll_cant_mant,														:ll_cant_cred
FROM   "CADENA", "ESTADO_MORA_CREDITO", "ESTADO_MORA_MANTENCION"  
WHERE ("CADENA"."ESTADO_MORA_CREDITO" = "ESTADO_MORA_CREDITO"."ESTADO_MORA_CREDITO" ) and  
		( "CADENA"."ESTADO_MORA_MANTENCION" = "ESTADO_MORA_MANTENCION"."ESTADO_MORA_MANTENCION" ) and  
		(("CADENA"."CODIGO" = :gs_base ) AND  
		( "CADENA"."SERIE" = :gs_serie ) AND  
		( "CADENA"."NUMERO" = :gi_numero ) )   ;
		
ld_fecha_hoy					= date(gdt_fec_sistema)
il_int_mora						= 0
il_int_gc							= 0
if tab_ingreso.SelectedTab = 1 then // cupon
elseif tab_ingreso.SelectedTab = 2 then //Comprobante Ingreso
	w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.SetItem(1,'incluir_gastos', 1)
	w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.accepttext()
	w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.accepttext()
	ls_tipo_cob						= w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.getitemstring(ll_indi,"tipo_cob")
	if ls_tipo_cob='E' or ls_tipo_cob='A' or ls_tipo_cob='F' then
		ii_cantidad 					= w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.GetItemNumber(ll_indi,"cantidad")
		ll_monto						= w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.GetItemNumber(ll_indi,"c_total_linea")
		gl_n_cuotas_pag 			= ii_cantidad 
		if ls_tipo_cob='E' then
			ll_cuota					= w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.getitemnumber(1, "c_cuotas_mora")
			id_valor_cuota 			= Round(w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.GetItemNumber(1,"c_valor_cuota_pesos"), 0)
			if gs_base='O' or gs_base='U' or gs_base='M' then
				ldt_fecha_prim		= w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.GetItemdatetime(1,'pago_oferta_fecha_prim')
				ll_ctas_pag			= w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.GetItemnumber(1,'oferta_v_cta_pag_s')
			elseif gs_base='L' then
				ldt_fecha_prim		= w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.GetItemdatetime(1,'pago_liberador_fecha_prim')
				ll_ctas_pag			= w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.GetItemnumber(1,'anexo_liberador_cta_pag_m')
			elseif gs_base='F' or gs_base='G' or gs_base='V' then
				ldt_fecha_prim		= w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.GetItemdatetime(1,'producto_pago_fecha_prim')
				ll_ctas_pag			= w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.GetItemnumber(1,'producto_anexo_cuotas_pag')
			elseif gs_base='A' then
				ldt_fecha_prim		= w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.GetItemdatetime(1,'pago_aumento_fecha_prim')
				ll_ctas_pag			= w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.GetItemnumber(1,'anexo_aumento_cta_pag_m')
			elseif gs_base='R' then
				ldt_fecha_prim		= w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.GetItemdatetime(1,'fecha_primera_cta')
				ll_ctas_pag			= w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.GetItemnumber(1,'ctas_pagadas')
			elseif gs_base='P' then
				ldt_fecha_prim		= w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.GetItemdatetime(1,'pagare_fecha_prim')
				ll_ctas_pag			= w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.GetItemnumber(1,'c_cuotas_pagadas')
			elseif gs_base='D' then
				ldt_fecha_prim		= w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.GetItemdatetime(1,'derecho_fecha_prim')
				ll_ctas_pag			= w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.GetItemnumber(1,'c_cuotas_pagadas')
			end if
			ld_fecha_prox_pago	= date(DATEtime(funcion_venc( ldt_fecha_prim , ll_ctas_pag ))) //-1
			ii_dmora 				= w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.GetItemNumber(1,"c_dias_mora")
			ll_ctas_mora			= w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.GetItemNumber(1,'c_cuotas_mora')
	
		elseif ls_tipo_cob='A' then
			id_valor_cuota 			= ll_monto
			ii_dmora 				= w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.GetItemNumber(1,'c_dias_mora_pie')
		elseif ls_tipo_cob='F' then
			if gs_base='O' or gs_base='C' or gs_base='U' or gs_base='M' then
				id_valor_cuota 		= Round(w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.GetItemNumber(1,"c_valor_cuota_mantencion_pesos"), 0)
				ii_dmora 			= w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.GetItemNumber(1,"c_dias_mora_mant")
			end if
		end if
		id_gc 							= 0
		id_im 							= 0
		if ls_tipo_cob='A' or ls_tipo_cob='E' then
			ii_mora_cobro 			= 1
			ii_inc_gastos 			= 1
		elseif ls_tipo_cob='F' then
			ii_mora_cobro 			= 0
			ii_inc_gastos 			= 0
		end if
		id_gc 							= 0
		id_im 							= 0
		ii_mora_cobro 				= 0
		ii_inc_gastos 				= 0
		FOR i = 1 TO ii_cantidad 
			IF ((ii_dmora - (i - 1) * (ll_cant_mant * 30))) > 5 AND tab_ingreso.tp_ci.cbx_sin_mora_ci.Checked = False THEN 
				ii_mora_cobro		= ((ii_dmora - (i - 1) * (ll_cant_mant * 30)))
				id_im 					= id_im + gf_int_mora(id_tasa_mant, ii_mora_cobro, id_valor_cuota)
				IF ((ii_dmora - (i - 1) * (ll_cant_mant * 30))) > 30 AND tab_ingreso.tp_ci.cbx_sin_gastos_ci.Checked = False THEN 
					 id_gc 			= id_gc + Round(id_valor_cuota * id_factor_gc, 0)
					 ii_inc_gastos 	= 1
				END IF
			ELSE
	//			id_gc 					= 0
	//			id_im 					= 0
	//			ii_mora_cobro		= 0
			END IF
		NEXT
		ll_gasto_cob					= ll_gasto_cob + id_gc
		ll_mora						= ll_mora + id_im
		il_int_mora					= ll_mora
		il_int_gc						= ll_gasto_cob
		w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.accepttext()
		ll_total_monto				= w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.GetItemNumber(1,"c_subtotal_total")
	end if
	if isnull(ll_monto_cred) then ll_monto_cred=0
	if isnull(ll_gasto_cob) then ll_gasto_cob=0
	if isnull(ll_mora) then ll_mora=0
	ll_monto_cred					= ll_monto_cred + ll_gasto_cob + ll_mora
elseif tab_ingreso.SelectedTab = 3 then //Boleta
	w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1,'incluir_gastos', 1)
	w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.accepttext()
	w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.accepttext()
	ls_tipo_cob						= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.getitemstring(ll_indi,"tipo_cob")
	if ls_tipo_cob='E' or ls_tipo_cob='A' or ls_tipo_cob='F' then
		ii_cantidad 					= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.GetItemNumber(ll_indi,"cantidad")
		ll_monto						= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.GetItemNumber(ll_indi,"c_total_linea")
		gl_n_cuotas_pag 			= ii_cantidad 
		if ls_tipo_cob='E' then
			ll_cuota					= w_ingreso2.tab_ingreso.tp_be.dw_datos_be.getitemnumber(1, "c_cuotas_mora")
			id_valor_cuota 			= Round(w_ingreso2.tab_ingreso.tp_be.dw_datos_be.GetItemNumber(1,"c_valor_cuota_pesos"), 0)
			if gs_base='O' or gs_base='U' or gs_base='M' then
				ldt_fecha_prim		= w_ingreso2.tab_ingreso.tp_be.dw_datos_be.GetItemdatetime(1,'pago_oferta_fecha_prim')
				ll_ctas_pag			= w_ingreso2.tab_ingreso.tp_be.dw_datos_be.GetItemnumber(1,'oferta_v_cta_pag_s')
			elseif gs_base='L' then
				ldt_fecha_prim		= w_ingreso2.tab_ingreso.tp_be.dw_datos_be.GetItemdatetime(1,'pago_liberador_fecha_prim')
				ll_ctas_pag			= w_ingreso2.tab_ingreso.tp_be.dw_datos_be.GetItemnumber(1,'anexo_liberador_cta_pag_m')
			elseif gs_base='F' or gs_base='G' or gs_base='V' then
				ldt_fecha_prim		= w_ingreso2.tab_ingreso.tp_be.dw_datos_be.GetItemdatetime(1,'producto_pago_fecha_prim')
				ll_ctas_pag			= w_ingreso2.tab_ingreso.tp_be.dw_datos_be.GetItemnumber(1,'producto_anexo_cuotas_pag')
			elseif gs_base='A' then
				ldt_fecha_prim		= w_ingreso2.tab_ingreso.tp_be.dw_datos_be.GetItemdatetime(1,'pago_aumento_fecha_prim')
				ll_ctas_pag			= w_ingreso2.tab_ingreso.tp_be.dw_datos_be.GetItemnumber(1,'anexo_aumento_cta_pag_m')
			elseif gs_base='R' then
				ldt_fecha_prim		= w_ingreso2.tab_ingreso.tp_be.dw_datos_be.GetItemdatetime(1,'fecha_primera_cta')
				ll_ctas_pag			= w_ingreso2.tab_ingreso.tp_be.dw_datos_be.GetItemnumber(1,'ctas_pagadas')
			elseif gs_base='P' then
				ldt_fecha_prim		= w_ingreso2.tab_ingreso.tp_be.dw_datos_be.GetItemdatetime(1,'pagare_fecha_prim')
				ll_ctas_pag			= w_ingreso2.tab_ingreso.tp_be.dw_datos_be.GetItemnumber(1,'c_cuotas_pagadas')
			elseif gs_base='D' then
				ldt_fecha_prim		= w_ingreso2.tab_ingreso.tp_be.dw_datos_be.GetItemdatetime(1,'derecho_fecha_prim')
				ll_ctas_pag			= w_ingreso2.tab_ingreso.tp_be.dw_datos_be.GetItemnumber(1,'c_cuotas_pagadas')
			end if
			ld_fecha_prox_pago	= date(DATEtime(funcion_venc( ldt_fecha_prim , ll_ctas_pag ))) //-1
			ii_dmora 				= w_ingreso2.tab_ingreso.tp_be.dw_datos_be.GetItemNumber(1,"c_dias_mora")
			ll_ctas_mora			= w_ingreso2.tab_ingreso.tp_be.dw_datos_be.GetItemNumber(1,'c_cuotas_mora')
	
		elseif ls_tipo_cob='A' then
			id_valor_cuota 			= ll_monto
			ii_dmora 				= w_ingreso2.tab_ingreso.tp_be.dw_datos_be.GetItemNumber(1,'c_dias_mora_pie')
		elseif ls_tipo_cob='F' then
			if gs_base='O' or gs_base='C' or gs_base='U' or gs_base='M' then
				id_valor_cuota 		= Round(w_ingreso2.tab_ingreso.tp_be.dw_datos_be.GetItemNumber(1,"c_valor_cuota_mantencion_pesos"), 0)
				ii_dmora 			= w_ingreso2.tab_ingreso.tp_be.dw_datos_be.GetItemNumber(1,"c_dias_mora_mant")
			end if
		end if
		id_gc 							= 0
		id_im 							= 0
		if ls_tipo_cob='A' or ls_tipo_cob='E' then
			ii_mora_cobro 			= 1
			ii_inc_gastos 			= 1
		elseif ls_tipo_cob='F' then
			ii_mora_cobro 			= 0
			ii_inc_gastos 			= 0
		end if
	
	
		id_gc 							= 0
		id_im 							= 0
		ii_mora_cobro 				= 0
		ii_inc_gastos 				= 0
		FOR i = 1 TO ii_cantidad 
			IF ((ii_dmora - (i - 1) * (ll_cant_mant * 30))) > 5 AND tab_ingreso.tp_be.cbx_sin_mora_be.Checked = False THEN 
				ii_mora_cobro		= ((ii_dmora - (i - 1) * (ll_cant_mant * 30)))
				id_im 					= id_im + gf_int_mora(id_tasa_mant, ii_mora_cobro, id_valor_cuota)
				IF ((ii_dmora - (i - 1) * (ll_cant_mant * 30))) > 30 AND tab_ingreso.tp_be.cbx_sin_gastos_be.Checked = False THEN 
					 id_gc 			= id_gc + Round(id_valor_cuota * id_factor_gc, 0)
					 ii_inc_gastos 	= 1
				END IF
			ELSE
	//			id_gc 					= 0
	//			id_im 					= 0
	//			ii_mora_cobro		= 0
			END IF
		NEXT
		ll_gasto_cob					= ll_gasto_cob + id_gc
		ll_mora						= ll_mora + id_im
		il_int_mora					= ll_mora
		il_int_gc						= ll_gasto_cob
		w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.accepttext()
		ll_total_monto				= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.GetItemNumber(1,"c_subtotal_total")
	end if
	if isnull(ll_monto_cred) then ll_monto_cred=0
	if isnull(ll_gasto_cob) then ll_gasto_cob=0
	if isnull(ll_mora) then ll_mora=0
	ll_monto_cred					= ll_monto_cred + ll_gasto_cob + ll_mora
end if


Return (ll_monto_cred)
end function

public subroutine wf_calcular_cant_mant (long ll_row);Long		ll_monto_mant,ll_sum_monto_abono,ll_monto_cta,ll_monto_mora_mant,ll_monto_final_mant,&
			ll_res_abono,ll_folio
datetime	ldt_fecha_hoy
String	ls_tipo_cob

ls_tipo_cob		= tab_ingreso.tp_ci.dw_detalle_ci.getitemstring(ll_row,'tipo_cob')
ldt_fecha_hoy	= datetime(date(gdt_fec_sistema),time('00:00:00'))
ll_folio			= long(tab_ingreso.tp_ci.sle_numero_ci.text)
if tab_ingreso.SelectedTab = 1 then // cupon
elseif tab_ingreso.SelectedTab = 2 then //Comprobante Ingreso
	if tab_ingreso.tp_ci.dw_detalle_ci.getitemnumber(ll_row,'cantidad') <= 1 or isnull(tab_ingreso.tp_ci.dw_detalle_ci.getitemnumber(ll_row,'cantidad')) then tab_ingreso.tp_ci.dw_detalle_ci.SetItem(ll_row, "cantidad", 1)
elseif tab_ingreso.SelectedTab = 3 then //Boleta
	if tab_ingreso.tp_be.dw_detalle_be.getitemnumber(ll_row,'cantidad') <= 1 or isnull(tab_ingreso.tp_be.dw_detalle_be.getitemnumber(ll_row,'cantidad')) then tab_ingreso.tp_be.dw_detalle_be.SetItem(ll_row, "cantidad", 1)
end if
IF gs_rezago <> "S" THEN
	if tab_ingreso.SelectedTab = 1 then // cupon
	elseif tab_ingreso.SelectedTab = 2 then //Comprobante Ingreso
		ll_monto_mant					= round(tab_ingreso.tp_ci.dw_datos_ci.GetItemNumber(1,"c_valor_cuota_mantencion_pesos"),0)
		SELECT	SUM("ABONO_CTA_CTE"."MONTO")  
		INTO 		:ll_sum_monto_abono  
		FROM 	"ABONO_CTA_CTE"  
		WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
				 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
				 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND
				 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )
		USING		sqlca;
		if ll_sum_monto_abono > 0 then
			ll_monto_cta				= ll_monto_mant * tab_ingreso.tp_ci.dw_detalle_ci.getitemnumber(ll_row,'cantidad')
			ll_monto_mora_mant		= wf_calcular_mora_mant(ll_row)
			if ll_sum_monto_abono >= ll_monto_cta then
				ll_monto_final_mant	= round(ll_sum_monto_abono - ( ll_monto_cta + ll_monto_mora_mant),0)
				ll_res_abono			= messagebox("Advertencia Abono","En su Cuenta Corriente Existe Abonado $ "+string(ll_sum_monto_abono,'###,###,###,###,##0')+", se descontará por Concepto de Mantención $ "+string(ll_monto_cta + ll_monto_mora_mant,'###,###,###,###,##0')+", quedando a su Favor $ "+string(ll_monto_final_mant,'###,###,###,###,##0')+"... desea utilizar Abono Existente",Exclamation!,YesNo!,2)
				if ll_res_abono=1 then
					tab_ingreso.tp_ci.dw_detalle_ci.SetItem(ll_row, "monto", ll_monto_mant)
					UPDATE	"ABONO_CTA_CTE"  
					SET 		"TIPO_COB_OCUPA" = :gs_tipo_cobro,   
								"FOLIO_OCUPA" = :ll_folio,   
								"FECHA_OCUPA" = :ldt_fecha_hoy,   
								"MONTO_OCUPA" = :ll_monto_cta,   
								"USUARIO_OCUPA" = :gs_user,   
								"CAJA_OCUPA" = :gs_caja,   
								"ESTADO_REG" = 'O',
								"TIPO_MOV_OCUPA" = 'F'  
					WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
							 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
							 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
							 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
					USING		sqlca;
					if sqlca.sqlcode=0 then
						commit;
						INSERT INTO "ABONO_CTA_CTE"  
									( "RUT",		"BASE",		"SERIE",		"NUMERO",	"TIPO_COB",		"FOLIO",		"MONTO",						"FECHA_CREA",		"USUARIO_CREA",	"CAJA_CREA",	"ESTADO_REG",	"TIPO_COB_OCUPA",	"FOLIO_OCUPA",	"FECHA_OCUPA",	"MONTO_OCUPA",	"USUARIO_OCUPA",	"CAJA_OCUPA",	"TIPO_MOV_OCUPA" )
						VALUES 	( :gi_rut,	:gs_base,	:gs_serie,	:gi_numero,		:gs_tipo_cobro,		:ll_folio,	:ll_monto_final_mant,	:gdt_fec_sistema,	:gs_user,			:gs_caja,		'P',				null,					null,				null,				null,				null,					null,				null )  
						USING		sqlca;
						if sqlca.sqlcode=0 then
							commit;
						else
							rollback;
							messagebox("Error Grabar","Error al INSERTAR ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
						end if
					else
						rollback;
						messagebox("Error Grabar","Error al UPDATE ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
					end if
				else
					ll_monto_final_mant		= ll_monto_mant
					tab_ingreso.tp_ci.dw_detalle_ci.SetItem(ll_row, "monto", ll_monto_mant )
				end if
			else
				ll_res_abono				= messagebox("Advertencia Abono","En su Cuenta Corriente Existe Abonado $ "+string(ll_sum_monto_abono,'###,###,###,###,##0')+", Monto a Cancelar es $ "+string(ll_monto_cta + ll_monto_mora_mant,'###,###,###,###,##0')+" y su Saldo quedará en 0... desea utilizar por Concepto de Mantención Abono Existente",Exclamation!,YesNo!,2)
				if ll_res_abono = 1 then
					tab_ingreso.tp_ci.dw_detalle_ci.SetItem(ll_row, "monto", ll_monto_mant )
					UPDATE	"ABONO_CTA_CTE"  
					SET 		"TIPO_COB_OCUPA" = :gs_tipo_cobro,   
								"FOLIO_OCUPA" = :ll_folio,   
								"FECHA_OCUPA" = :ldt_fecha_hoy,   
								"MONTO_OCUPA" = :ll_sum_monto_abono,   
								"USUARIO_OCUPA" = :gs_user,   
								"CAJA_OCUPA" = :gs_caja,   
								"ESTADO_REG" = 'O',
								"TIPO_MOV_OCUPA" = 'F'  
					WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
							 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
							 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
							 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
					USING		sqlca;
					if sqlca.sqlcode=0 then
						commit;
					else
						rollback;
						messagebox("Error Grabar","Error al Update ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
					end if
				else
					ll_monto_final_mant		= ll_monto_mant
					tab_ingreso.tp_ci.dw_detalle_ci.SetItem(ll_row, "monto", ll_monto_mant )
				end if
			end if
		else
			ll_monto_final_mant				= ll_monto_mant
			tab_ingreso.tp_ci.dw_detalle_ci.SetItem(ll_row, "monto", ll_monto_mant )
		end if
		wf_calcular_interes(ls_tipo_cob)	
	elseif tab_ingreso.SelectedTab = 3 then //Boleta
		if gs_base='O' or gs_base='C' or gs_base='U' or gs_base='M' then
			ll_monto_mant					= round(tab_ingreso.tp_be.dw_datos_be.GetItemNumber(1,"c_valor_cuota_mantencion_pesos"),0)
			SELECT	SUM("ABONO_CTA_CTE"."MONTO")  
			INTO 		:ll_sum_monto_abono  
			FROM 	"ABONO_CTA_CTE"  
			WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
					 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
					 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND
					 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )
			USING		sqlca;
			if ll_sum_monto_abono > 0 then
				ll_monto_cta				= ll_monto_mant * tab_ingreso.tp_be.dw_detalle_be.getitemnumber(ll_row,'cantidad')
				ll_monto_mora_mant		= wf_calcular_mora_mant(ll_row)
				if ll_sum_monto_abono >= ll_monto_cta then
					ll_monto_final_mant	= round(ll_sum_monto_abono - ( ll_monto_cta + ll_monto_mora_mant),0)
					ll_res_abono			= messagebox("Advertencia Abono","En su Cuenta Corriente Existe Abonado $ "+string(ll_sum_monto_abono,'###,###,###,###,##0')+", se descontará por Concepto de Mantención $ "+string(ll_monto_cta + ll_monto_mora_mant,'###,###,###,###,##0')+", quedando a su Favor $ "+string(ll_monto_final_mant,'###,###,###,###,##0')+"... desea utilizar Abono Existente",Exclamation!,YesNo!,2)
					if ll_res_abono=1 then
						tab_ingreso.tp_be.dw_detalle_be.SetItem(ll_row, "monto", ll_monto_mant)
						UPDATE	"ABONO_CTA_CTE"  
						SET 		"TIPO_COB_OCUPA" = :gs_tipo_cobro,   
									"FOLIO_OCUPA" = :ll_folio,   
									"FECHA_OCUPA" = :ldt_fecha_hoy,   
									"MONTO_OCUPA" = :ll_monto_cta,   
									"USUARIO_OCUPA" = :gs_user,   
									"CAJA_OCUPA" = :gs_caja,   
									"ESTADO_REG" = 'O',
									"TIPO_MOV_OCUPA" = 'F'  
						WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
								 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
								 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
								 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
						USING		sqlca;
						if sqlca.sqlcode=0 then
							commit;
							INSERT INTO "ABONO_CTA_CTE"  
										( "RUT",		"BASE",		"SERIE",		"NUMERO",	"TIPO_COB",		"FOLIO",		"MONTO",						"FECHA_CREA",		"USUARIO_CREA",	"CAJA_CREA",	"ESTADO_REG",	"TIPO_COB_OCUPA",	"FOLIO_OCUPA",	"FECHA_OCUPA",	"MONTO_OCUPA",	"USUARIO_OCUPA",	"CAJA_OCUPA",	"TIPO_MOV_OCUPA" )
							VALUES 	( :gi_rut,	:gs_base,	:gs_serie,	:gi_numero,		:gs_tipo_cobro,		:ll_folio,	:ll_monto_final_mant,	:gdt_fec_sistema,	:gs_user,			:gs_caja,		'P',				null,					null,				null,				null,				null,					null,				null )  
							USING		sqlca;
							if sqlca.sqlcode=0 then
								commit;
							else
								rollback;
								messagebox("Error Grabar","Error al INSERTAR ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
							end if
						else
							rollback;
							messagebox("Error Grabar","Error al UPDATE ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
						end if
					else
						ll_monto_final_mant		= ll_monto_mant
						tab_ingreso.tp_be.dw_detalle_be.SetItem(ll_row, "monto", ll_monto_mant )
					end if
				else
					ll_res_abono				= messagebox("Advertencia Abono","En su Cuenta Corriente Existe Abonado $ "+string(ll_sum_monto_abono,'###,###,###,###,##0')+", Monto a Cancelar es $ "+string(ll_monto_cta + ll_monto_mora_mant,'###,###,###,###,##0')+" y su Saldo quedará en 0... desea utilizar por Concepto de Mantención Abono Existente",Exclamation!,YesNo!,2)
					if ll_res_abono = 1 then
						tab_ingreso.tp_be.dw_detalle_be.SetItem(ll_row, "monto", ll_monto_mant )
						UPDATE	"ABONO_CTA_CTE"  
						SET 		"TIPO_COB_OCUPA" = :gs_tipo_cobro,   
									"FOLIO_OCUPA" = :ll_folio,   
									"FECHA_OCUPA" = :ldt_fecha_hoy,   
									"MONTO_OCUPA" = :ll_sum_monto_abono,   
									"USUARIO_OCUPA" = :gs_user,   
									"CAJA_OCUPA" = :gs_caja,   
									"ESTADO_REG" = 'O',
									"TIPO_MOV_OCUPA" = 'F'  
						WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
								 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
								 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
								 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
						USING		sqlca;
						if sqlca.sqlcode=0 then
							commit;
						else
							rollback;
							messagebox("Error Grabar","Error al Update ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
						end if
					else
						ll_monto_final_mant		= ll_monto_mant
						tab_ingreso.tp_be.dw_detalle_be.SetItem(ll_row, "monto", ll_monto_mant )
					end if
				end if
			else
				ll_monto_final_mant				= ll_monto_mant
				tab_ingreso.tp_be.dw_detalle_be.SetItem(ll_row, "monto", ll_monto_mant )
			end if
			wf_calcular_interes(ls_tipo_cob)	
		end if
	end if
	
end if 
end subroutine

public function long wf_calcular_mora (long ll_indi);Long		ll_ctas_mora,ll_dia_prox_pago,ll_day,ll_month,ll_year,ll_max,ll_new,ll_dias_dif,ll_suma_dias,ll_tot_fila,ll_reg,ll_dias_mora,ll_cuota,ll_valor_int,ll_suma_acum_gc,ll_gasto_cob,ll_mora,ll_total_monto,ii_dmora,ii_mora_cobro,ii_inc_gastos,i,id_im,id_gc,&
			ii_cantidad,ll_monto_cred,ll_monto,ll_ctas_pag,ll_cant_mant,ll_cant_cred,ll_acum_dias,ll_sumar_mes,ll_mora_cred,ll_dias_mora_cred,ll_dias
date		ld_fecha_prox_pago,ld_fecha_inicial,ld_fecha_prox_venc,ld_fecha_hoy
datetime	ldt_fecha_prim,ldt_fecha_venc,ldt_fecha_venc_calc,ld_fecha_venc_cred,ldt_fecha_hoy
String	ls_fecha,ls_pasa,ls_tipo_cob
Double	id_valor_cuota,ldb_tasa,id_monto,ldb_val_cta_cred

ld_fecha_hoy					= date(gdt_fec_sistema)
ldt_fecha_hoy					= datetime(date(gdt_fec_sistema),time('00:00:00'))
il_int_mora						= 0
il_int_mora_cred				= 0
il_int_mora_mant				= 0
il_int_gc							= 0
il_int_gc_cred					= 0
il_int_gc_mant					= 0
SELECT 	"ESTADO_MORA_MANTENCION"."CANTIDAD_MESES",	"ESTADO_MORA_CREDITO"."CANTIDAD_MESES"  
 INTO   	:ll_cant_mant,														:ll_cant_cred
 FROM   "CADENA", "ESTADO_MORA_CREDITO", "ESTADO_MORA_MANTENCION"  
 WHERE ("CADENA"."ESTADO_MORA_CREDITO" = "ESTADO_MORA_CREDITO"."ESTADO_MORA_CREDITO" ) and  
		 ( "CADENA"."ESTADO_MORA_MANTENCION" = "ESTADO_MORA_MANTENCION"."ESTADO_MORA_MANTENCION" ) and  
		 (("CADENA"."CODIGO" = :gs_base ) AND  
		 ( "CADENA"."SERIE" = :gs_serie ) AND  
		 ( "CADENA"."NUMERO" = :gi_numero ) )   ;
if tab_ingreso.SelectedTab = 1 then // cupon
elseif tab_ingreso.SelectedTab = 2 then //Comprobante Ingreso
	w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.SetItem(1,'incluir_gastos', 1)
	w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.accepttext()
	w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.accepttext()
	ls_tipo_cob						= w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.getitemstring(ll_indi,"tipo_cob")
	if ls_tipo_cob='E' or ls_tipo_cob='A' or ls_tipo_cob='F' then
		ii_cantidad 					= w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.GetItemNumber(ll_indi,"cantidad")
		ll_monto						= w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.GetItemNumber(ll_indi,"c_total_linea")
		gl_n_cuotas_pag 			= ii_cantidad 
		if ls_tipo_cob='E' then
			ll_cuota					= w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.getitemnumber(1, "c_cuotas_mora")
			id_valor_cuota 			= Round(w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.GetItemNumber(1,"c_valor_cuota_pesos"), 0)
			if gs_base='O' or gs_base='U' or gs_base='M' then
				ldt_fecha_prim		= w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.GetItemdatetime(1,'pago_oferta_fecha_prim')
				ll_ctas_pag			= w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.GetItemnumber(1,'oferta_v_cta_pag_s')
			elseif gs_base='L' then
				ldt_fecha_prim		= w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.GetItemdatetime(1,'pago_liberador_fecha_prim')
				ll_ctas_pag			= w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.GetItemnumber(1,'anexo_liberador_cta_pag_m')
			elseif gs_base='F' or gs_base='G' or gs_base='V' then
				ldt_fecha_prim		= w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.GetItemdatetime(1,'producto_pago_fecha_prim')
				ll_ctas_pag			= w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.GetItemnumber(1,'producto_anexo_cuotas_pag')
			elseif gs_base='A' then
				ldt_fecha_prim		= w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.GetItemdatetime(1,'pago_aumento_fecha_prim')
				ll_ctas_pag			= w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.GetItemnumber(1,'anexo_aumento_cta_pag_m')
			elseif gs_base='R' then
				ldt_fecha_prim		= w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.GetItemdatetime(1,'fecha_primera_cta')
				ll_ctas_pag			= w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.GetItemnumber(1,'ctas_pagadas')
			elseif gs_base='P' then
				ldt_fecha_prim		= w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.GetItemdatetime(1,'pagare_fecha_prim')
				ll_ctas_pag			= w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.GetItemnumber(1,'c_cuotas_pagadas')
			elseif gs_base='D' then
				ldt_fecha_prim		= w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.GetItemdatetime(1,'derecho_fecha_prim')
				ll_ctas_pag			= w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.GetItemnumber(1,'c_cuotas_pagadas')
			end if
			ld_fecha_prox_pago	= date(DATEtime(funcion_venc( ldt_fecha_prim , ll_ctas_pag ))) //-1
			ii_dmora 				= w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.GetItemNumber(1,"c_dias_mora")
			ll_ctas_mora			= w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.GetItemNumber(1,'c_cuotas_mora')
	
		elseif ls_tipo_cob='A' then
			id_valor_cuota 			= ll_monto
			ii_dmora 				= w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.GetItemNumber(1,'c_dias_mora_pie')
		elseif ls_tipo_cob='F' then
			if gs_base='O' or gs_base='C' or gs_base='U' or gs_base='M' then
				id_valor_cuota 		= Round(w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.GetItemNumber(1,"c_valor_cuota_mantencion_pesos"), 0)
				ii_dmora 			= w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.GetItemNumber(1,"c_dias_mora_mant")
			end if
		end if
		id_gc 							= 0
		id_im 							= 0
		if ls_tipo_cob='A' or ls_tipo_cob='E' then
			ii_mora_cobro 			= 1
			ii_inc_gastos 			= 1
		elseif ls_tipo_cob='F' then
			ii_mora_cobro 			= 0
			ii_inc_gastos 			= 0
		end if
	
		ii_dmora 						= w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.GetItemNumber(1,"c_dias_mora")
		ll_ctas_mora				= w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.GetItemNumber(1,'c_cuotas_mora')
		id_valor_cuota				= round(w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.GetItemNumber(1,"c_valor_cuota_pesos"),0)
		ll_cuota						= w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.getitemnumber(1, "c_cuotas_mora")
		ldt_fecha_venc				= w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.getitemdatetime(1, "c_prox_pago")
		ii_mora_cobro 				= 1
		ii_inc_gastos 				= 1
		
		
		
