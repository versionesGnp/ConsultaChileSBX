		Long	ll_cantidad
		ll_cantidad					= Long(tab_ingreso.tp_ci.dw_detalle_ci.rowcount())
		IF is_columna_2 = "cantidad" AND (ls_tipo_cob_2 = "E" or ls_tipo_cob_2 = "U") AND gs_rezago <> "S" and gs_base <> 'C' AND dw_detalle_ci.rowcount() > 0  THEN
			if gs_base='M' and ls_pasa_mult='S' then
				ii_cantidad_2 			= GetItemNumber(row, "cantidad")
				ls_eliminar_s			= 'S'
				do while ls_eliminar_s = 'S'
					ll_fila_s		= tab_ingreso.tp_ci.dw_detalle_ci.find("tipo_cob='S'",1,tab_ingreso.tp_ci.dw_detalle_ci.rowcount())
					if ll_fila_s > 0 then
						tab_ingreso.tp_ci.dw_detalle_ci.deleterow(ll_fila_s)
						tab_ingreso.tp_ci.dw_detalle_ci.accepttext()
					else
						ls_eliminar_s	= 'N'
						exit;
					end if
				loop
				wf_cargar_credito_m(gs_base+gs_serie+string(gi_numero),ls_tipo_cob_2,ii_cantidad_2,'CTO',row,is_columna_2)
			else
				if dw_detalle_ci.GetItemNumber(row, "cantidad") > 0 then
					wf_actualizar_abono(ls_tipo_cob_2)
					ii_cantidad_2 		= GetItemNumber(row, "cantidad")
					
					DECLARE x2 CURSOR FOR  
					SELECT	"SEGURO_ASOCIADOS"."COD_SEGURO"  
					FROM 	"SEGURO_ASOCIADOS"  
					WHERE ( "SEGURO_ASOCIADOS"."BASE" = :gs_base ) AND  
							  ( "SEGURO_ASOCIADOS"."SERIE" = :gs_serie ) AND  
							  ( "SEGURO_ASOCIADOS"."NUMERO" = :gi_numero ) AND  
							  ( "SEGURO_ASOCIADOS"."ESTADO_REG" = 0 ) AND  
							  ( "SEGURO_ASOCIADOS"."ESTADO_SEGURO" = 'A' )   
		//					  ( "SEGURO_ASOCIADOS"."COD_SEGURO" <> 8 )
					USING	sqlca;
					open x2;
					if sqlca.sqlcode=0 then
						do while sqlca.sqlcode=0
							fetch x2 into :ll_cod_seguro;
							if not isnull(ll_cod_seguro) then
								ll_fila_2		= dw_detalle_ci.Find("tipo_cob = '"+string(ll_cod_seguro)+"'",1, dw_detalle_ci.RowCount())
								dw_detalle_ci.setitem(ll_fila_2,'cantidad',ii_cantidad_2)
							end if
							setnull(ll_cod_seguro)
						loop
					end if
					close x2;
					dw_detalle_ci.accepttext()
					if (gs_base='O' or gs_base='U' or gs_base='M') and dw_datos_ci.DataObject='d_datos_cuenta_ci_oferta' then
						ll_ctas				= dw_datos_ci.getitemnumber(1,'pago_oferta_nro_cuotas')
						ll_ctas_pagadas	= dw_datos_ci.getitemnumber(1,'oferta_v_cta_pag_s')
					elseif gs_base='P' and dw_datos_ci.DataObject='d_datos_cuenta_ci_pagare' then
						ll_ctas				= dw_datos_ci.getitemnumber(1,'pagare_plazo')
						ll_ctas_pagadas_1	= dw_datos_ci.getitemnumber(1,'pagare_cta_pag_la')
						ll_ctas_pagadas_2	= dw_datos_ci.getitemnumber(1,'pagare_cta_pag_isa')
						ll_ctas_pagadas	= ll_ctas_pagadas_1 + ll_ctas_pagadas_2
					elseif gs_base='L' and dw_datos_ci.DataObject='d_datos_cuenta_ci_liberador' then
						ll_ctas				= dw_datos_ci.getitemnumber(1,'pago_liberador_nro_cuotas')
						ll_ctas_pagadas	= dw_datos_ci.getitemnumber(1,'anexo_liberador_cta_pag_m')
					elseif (gs_base='F' or gs_base='G' or gs_base='V') and dw_datos_ci.DataObject='d_datos_cuenta_ci_funeraria' then
						ll_ctas				= dw_datos_ci.getitemnumber(1,'producto_pago_plazo')
						ll_ctas_pagadas	= dw_datos_ci.getitemnumber(1,'producto_anexo_cuotas_pag')
					elseif gs_base='D' and dw_datos_ci.DataObject='d_datos_cuenta_ci_derecho' then
						ll_ctas				= dw_datos_ci.getitemnumber(1,'derecho_plazo')
						ll_ctas_pagadas_1	= dw_datos_ci.getitemnumber(1,'derecho_cta_pag_la')
						ll_ctas_pagadas_2	= dw_datos_ci.getitemnumber(1,'derecho_cta_pag_isa')
						ll_ctas_pagadas	= ll_ctas_pagadas_1 + ll_ctas_pagadas_2
					elseif gs_base='A' and dw_datos_ci.DataObject='d_datos_cuenta_ci_aumento_capacidad' then
						ll_ctas				= dw_datos_ci.getitemnumber(1,'pago_aumento_nro_cuotas')
						ll_ctas_pagadas	= dw_datos_ci.getitemnumber(1,'anexo_aumento_cta_pag_m')
					elseif gs_base='R' and dw_datos_ci.DataObject='dw_repacta_mant_descripcion_traspaso' then
						ll_ctas				= dw_datos_ci.getitemnumber(1,'cuotas_pactadas')
						ll_ctas_pagadas	= dw_datos_ci.getitemnumber(1,'ctas_pagadas')
					end if
					if (ll_ctas_pagadas + ii_cantidad_2) > ll_ctas then
						messagebox("Advertencia","Cantidad de Cuotas sobrepasa al Plazo del Crédito")
			//			SetItem(row, "monto", 0)
						dw_detalle_ci.SetItem(row, "cantidad", 0)
						dw_detalle_ci.SetItem(row,'c_total_linea',0)
						dw_gastos_ci.SetItem(1, "Subtotal",0)
						dw_gastos_ci.SetItem(1, "mora",0)
						dw_gastos_ci.SetItem(1, "gastos_cob",0)
						
						dw_gastos_ci.SetItem(1, "mora_cred",0)
						dw_gastos_ci.SetItem(1, "mora_mant",0)
						dw_gastos_ci.SetItem(1, "gasto_cred",0)
						dw_gastos_ci.SetItem(1, "gasto_mant",0)
						
						dw_detalle_ci.accepttext()
						dw_detalle_ci.setfocus()
						dw_detalle_ci.setcolumn('cantidad')
					else
						if this.getitemnumber(row,'cantidad') <= 1 or isnull(this.getitemnumber(row,'cantidad')) then SetItem(row, "cantidad", 1)
						ll_monto_cred					= round(dw_datos_ci.GetItemNumber(1,"c_valor_cuota_pesos"),0)
						ll_monto_mora_cred			= wf_calcular_mora(row)
						SELECT	SUM("ABONO_CTA_CTE"."MONTO")  
						INTO 		:ll_sum_monto_abono  
						FROM 	"ABONO_CTA_CTE"  
						WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
								 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
								 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero )  AND 
								 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
						USING		sqlca;
						if ll_sum_monto_abono > 0 then
							ll_monto_cta				= ll_monto_cred * this.getitemnumber(row,'cantidad')
							if ll_sum_monto_abono >= (ll_monto_cta + ll_monto_mora_cred) then
								ll_monto_final_cred	= round(ll_sum_monto_abono - (ll_monto_cta + ll_monto_mora_cred),0)
								ll_res_abono			= messagebox("Advertencia Abono","En su Cuenta Corriente Existe Abonado $ "+string(ll_sum_monto_abono,'###,###,###,###,##0')+", se descontará por Concepto Crédito $ "+string((ll_monto_cta + ll_monto_mora_cred) - 1,'###,###,###,###,##0')+", quedando a su Favor $ "+string(ll_monto_final_cred,'###,###,###,###,##0')+"... desea utilizar Abono Existente",Exclamation!,YesNo!,2)
								if ll_res_abono=1 then
									SetItem(row, "monto", ll_monto_cred)
									ll_monto_final_cred ++
									UPDATE	"ABONO_CTA_CTE"  
									SET 		"TIPO_COB_OCUPA" = :gs_tipo_cobro,   
												"FOLIO_OCUPA" = :ll_folio_2,   
												"FECHA_OCUPA" = :ldt_fecha_hoy_2,   
												"MONTO_OCUPA" = (:ll_monto_cta + :ll_monto_mora_cred) - 1,   
												"USUARIO_OCUPA" = :gs_user,   
												"CAJA_OCUPA" = :gs_caja,   
												"ESTADO_REG" = 'O',
												"TIPO_MOV_OCUPA" = 'E',
												"SW_ESTADO_TRANS" = 1  
									WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
											 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
											 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
											 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
									USING		sqlca;
									if sqlca.sqlcode=0 then
										commit;
										INSERT INTO "ABONO_CTA_CTE"  
													( "RUT",		"BASE",		"SERIE",		"NUMERO",	"TIPO_COB",	"FOLIO",		"MONTO",						"FECHA_CREA",		"USUARIO_CREA",	"CAJA_CREA",	"ESTADO_REG",	"TIPO_COB_OCUPA",	"FOLIO_OCUPA",	"FECHA_OCUPA",	"MONTO_OCUPA",	"USUARIO_OCUPA",	"CAJA_OCUPA",	"TIPO_MOV_OCUPA",	"SW_ESTADO_TRANS" )
										VALUES 	( :gi_rut,	:gs_base,	:gs_serie,	:gi_numero,:gs_tipo_cobro,			:ll_folio_2,	:ll_monto_final_cred,	:gdt_fec_sistema,	:gs_user,			:gs_caja,		'P',				null,					null,				null,				null,				null,					null,				null,					2 )  
										USING		sqlca;
										if sqlca.sqlcode=0 then
											commit;
										else
											rollback;
											messagebox("Error Grabar","Error al INSERTAR ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
										end if
									else
										rollback;
										messagebox("Error Grabar","Error al UPDATE ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
									end if
								else
									ll_monto_final_cred		= ll_monto_cred
									SetItem(row, "monto", ll_monto_cred )
								end if
							else
								ll_res_abono				= messagebox("Advertencia Abono","En su Cuenta Corriente Existe Abonado $ "+string(ll_sum_monto_abono,'###,###,###,###,##0')+", Monto a Cancelar es $ "+string(ll_monto_cta,'###,###,###,###,##0')+" y su Saldo quedará en 0... desea utilizar por Concepto Crédito Abono Existente",Exclamation!,YesNo!,2)
								if ll_res_abono=1 then
									SetItem(row, "monto", ll_monto_cred )
									UPDATE	"ABONO_CTA_CTE"  
									SET 		"TIPO_COB_OCUPA" = :gs_tipo_cobro,   
												"FOLIO_OCUPA" = :ll_folio_2,   
												"FECHA_OCUPA" = :ldt_fecha_hoy_2,   
												"MONTO_OCUPA" = :ll_sum_monto_abono,   
												"USUARIO_OCUPA" = :gs_user,   
												"CAJA_OCUPA" = :gs_caja,   
												"ESTADO_REG" = 'O',
												"TIPO_MOV_OCUPA" = 'E',
												"SW_ESTADO_TRANS" = 1  
									WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
											 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
											 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
											 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
									USING		sqlca;
									if sqlca.sqlcode=0 then
										commit;
									else
										rollback;
										messagebox("Error Grabar","Error al Update ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
									end if
								else
									ll_monto_final_cred		= ll_monto_cred
									SetItem(row, "monto", ll_monto_cred )
								end if
							end if
						else
							ll_monto_final_cred				= ll_monto_cred
							SetItem(row, "monto", ll_monto_cred )
						end if			
			
						// vhfb - inicion -  actualiza cantidad
						if  (gs_aplica_a ='C' or gs_aplica_a = 'T' )  then			
							wf_actualiza_cantidad();
						end if 
						// vhfb - termino -  actualiza cantidad	
						
					end if
					if gs_base<>'M' then wf_calcular_interes(ls_tipo_cob_2)
					dw_gastos_ci.SetItem(1, "Subtotal",GetItemNumber(1,"c_subtotal"))
					dw_gastos_ci.accepttext()
				end if
			end if
		elseIF is_columna_2 = "cantidad" AND ls_tipo_cob_2 = "F"  AND gs_rezago <> "S" AND this.rowcount() > 0 THEN	
			if gs_base='M' and ls_pasa_mult='S' then
				ii_cantidad_2 			= GetItemNumber(row, "cantidad")
				wf_cargar_credito_m(gs_base+gs_serie+string(gi_numero),ls_tipo_cob_2,ii_cantidad_2,'CTO',row,is_columna_2)
			end if
			if  this.GetItemNumber(row, "cantidad") > 0 then
				wf_actualizar_abono(ls_tipo_cob_2)
				wf_calcular_cant_mant(row)
			end if
		END IF
		IF gs_rezago <> "S" and (ls_tipo_cob_2 = "E" or ls_tipo_cob_2 = "U") and gs_base<>'C' THEN
			dw_detalle_ci.SetItem(row, "estado", 'S')
			if gs_base<>'M' then wf_calcular_interes(ls_tipo_cob_2)
		elseif gs_rezago <> "S" and ls_tipo_cob_2 = "F" THEN
			dw_detalle_ci.SetItem(row, "estado", 'S')
			if gs_base<>'M' then wf_calcular_interes(ls_tipo_cob_2)
		else
			dw_detalle_ci.SetItem(row, "estado", 'N')
		end if
	
	elseif ls_estado_cadena_2<>'S' and ls_estado_cadena_2<>'V' and ls_estado_cadena_2<>'C' then
		messagebox("Advertencia","No es Posible Ingresar este Tipo de Cobro")
		dw_detalle_ci.deleterow(row)
		fila_2 					= dw_detalle_ci.InsertRow(0)
		dw_detalle_ci.scrolltorow(fila_2)
		dw_detalle_ci.SetItem(fila_2, "uf", gd_uf)
		dw_detalle_ci.SetItem(fila_2, "folio", 0)
		if rb_bol_afecta.checked=true then
			dw_detalle_ci.SetItem(fila_2, "iva", idb_iva)
		end if
		dw_detalle_ci.SetItem(fila_2, "estado", 'N')
		dw_detalle_ci.SetItem(fila_2, "uf", gd_uf)
		if rb_ci_uf.checked=true then
			dw_detalle_ci.SetItem(fila_2, "moneda",'U')
		else
			dw_detalle_ci.SetItem(fila_2, "moneda",'P')
		end if
		setnull(ls_tipo_cob_2);setnull(is_columna_2)
		dw_detalle_ci.scrolltorow(row)
		dw_detalle_ci.setfocus()
		dw_detalle_ci.setcolumn('tipo_cob')
	end if
	
	ll_tot_reg_2		= dw_detalle_ci.rowcount()
	if ll_tot_reg_2 > 0 then
		ll_fila_2_gasto		= dw_detalle_ci.Find( "tipo_cob = 'E' or tipo_cob ='F' or tipo_cob='A' or tipo_cob = 'Q' or tipo_cob ='U'",1, ll_tot_reg_2)
		if ll_fila_2_gasto =0 then
			dw_gastos_ci.SetItem(1, "mora",0)
			dw_gastos_ci.SetItem(1, "gastos_cob",0)
			
			dw_gastos_ci.SetItem(1, "mora_cred",0)
			dw_gastos_ci.SetItem(1, "mora_mant",0)
			dw_gastos_ci.SetItem(1, "gasto_cred",0)
			dw_gastos_ci.SetItem(1, "gasto_mant",0)
			
			dw_gastos_ci.accepttext()
		end if
	end if
	w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.accepttext()
	il_fila_desc					= row		//dw_detalle_ci.getrow()
	ls_tipo_cob_2					= dw_detalle_ci.getitemstring(il_fila_desc,'tipo_cob')
	if gs_codigo_otro = "" then gs_codigo_otro = '0'
	if ls_tipo_cob_2 = 'S' and gs_codigo_otro <> '0' then
		gs_codigo_otro			= dw_detalle_ci.getitemstring(il_fila_desc,'tipo_cob_otro')
		wf_validar_descuento()
	end if
	
	ll_monto								= dw_gastos_ci.getitemnumber(1,'c_total')
	if ll_monto > 0 then 
		ls_string							= "tipo_cob_otro = '144' or tipo_cob_otro = '76' "
		ll_fila_2								= dw_detalle_ci.Find(ls_string,  1, ll_tot_reg_2)
		if ll_fila_2 > 0 then
			ls_tipo_cob_2	= dw_detalle_ci.getitemstring(fila_2,'tipo_cob')
			dw_detalle_ci.DeleteRow(ll_fila_2)
			if gs_base<>'M' then wf_calcular_interes(ls_tipo_cob_2)
			dw_detalle_ci.accepttext()
		end if
		cbx_paga_ef.checked			= false
	else
		dw_detalle_ci.accepttext()
		ll_monto_pago					= dw_detalle_ci.getitemnumber(1,'c_subtotal')
		ll_mora_cred					= dw_gastos_ci.getitemnumber(1, "mora_cred")
		ll_mora_mant_2					= dw_gastos_ci.getitemnumber(1, "mora_mant")
		ll_gastos_cred					= dw_gastos_ci.getitemnumber(1, "gasto_cred")
		ll_gastos_mant					= dw_gastos_ci.getitemnumber(1, "gasto_mant")
		ll_suma_total					= ll_monto_pago + ll_mora_cred + ll_mora_mant_2 + ll_gastos_cred + ll_gastos_mant
		dw_gastos_ci.setitem(1,'subtotal',ll_suma_total)
		dw_gastos_ci.accepttext()
		dw_detalle_ci.accepttext()
		dw_detalle_ci.setcolumn('tipo_cob')
	end if
end if
this.accepttext()
end event

event itemfocuschanged;String		ls_columna,ls_tipo_cob,ls_uso
Long		ll_cantidad,ll_ctas,ll_ctas_pagadas,ll_ctas_pagadas_1,ll_ctas_pagadas_2,ll_tot_reg,ll_row,ll_cod_parque,ls_nulo,ll_count_hijo,ll_nulo
Double	ld_monto

Setnull(ls_nulo)
Setnull(ll_nulo)
dw_detalle_ci.accepttext()
ls_tipo_cob					= dw_detalle_ci.getitemstring(row,'tipo_cob')
SELECT 	Count("CADENA"."CODIGO" )
INTO 		:ll_count_hijo
FROM 	"CADENA"  
WHERE 	( "CADENA"."CODIGO" = :gs_base ) AND  
			( "CADENA"."SERIE" = :gs_serie ) AND  
			( "CADENA"."NUMERO" = :gi_numero ) AND  
			( "CADENA"."MPBASE" = 'M' )   ;
if isnull(ll_count_hijo) then ll_count_hijo=0
if (ls_tipo_cob='E' or ls_tipo_cob='F' or ls_tipo_cob='A' ) and ll_count_hijo > 0 then
//	messagebox("Advertencia","No es posible Ingresar este Item de Pago a Contrato que tiene Asociado Contrato Multiproducto, debe Ingresar a Contrato Base M")
	dw_detalle_ci.SetItem(row, "monto", 0)
	dw_detalle_ci.SetItem(row, "cantidad", 0)
	dw_detalle_ci.SetItem(row, "tipo_cob", ls_nulo)
	dw_detalle_ci.accepttext()
	dw_detalle_ci.setfocus()
	dw_detalle_ci.setcolumn('tipo_cob')
end if
if dw_datos_ci.rowcount() > 0 and dw_detalle_ci.rowcount() > 0 then
	ll_tot_reg						= dw_detalle_ci.rowcount()
	ll_row		 						= dw_detalle_ci.Find("tipo_cob ='E' or tipo_cob ='U'",1, ll_tot_reg)
	if ll_row > 0 then
		ls_tipo_cob					= dw_detalle_ci.getitemstring(ll_row,'tipo_cob')
		ll_cantidad 					= dw_detalle_ci.GetItemNumber(ll_row, "cantidad")
		IF ls_tipo_cob = "E" AND gs_rezago <> "S" and gs_base <> 'C' THEN
			if (gs_base='O' or gs_base='U' or gs_base='M') and dw_datos_ci.DataObject='d_datos_cuenta_ci_oferta' then
				ll_ctas				= dw_datos_ci.getitemnumber(1,'pago_oferta_nro_cuotas')
				ll_ctas_pagadas	= dw_datos_ci.getitemnumber(1,'oferta_v_cta_pag_s')
			elseif gs_base='P' and dw_datos_ci.DataObject='d_datos_cuenta_ci_pagare' then
				ll_ctas				= dw_datos_ci.getitemnumber(1,'pagare_plazo')
				ll_ctas_pagadas_1	= dw_datos_ci.getitemnumber(1,'pagare_cta_pag_la')
				ll_ctas_pagadas_2	= dw_datos_ci.getitemnumber(1,'pagare_cta_pag_isa')
				ll_ctas_pagadas	= ll_ctas_pagadas_1 + ll_ctas_pagadas_2
			elseif gs_base='L' and dw_datos_ci.DataObject='d_datos_cuenta_ci_liberador' then
				ll_ctas				= dw_datos_ci.getitemnumber(1,'pago_liberador_nro_cuotas')
				ll_ctas_pagadas	= dw_datos_ci.getitemnumber(1,'anexo_liberador_cta_pag_m')
			elseif gs_base='D' and dw_datos_ci.DataObject='d_datos_cuenta_ci_derecho' then
				ll_ctas				= dw_datos_ci.getitemnumber(1,'derecho_plazo')
				ll_ctas_pagadas_1	= dw_datos_ci.getitemnumber(1,'derecho_cta_pag_la')
				ll_ctas_pagadas_2	= dw_datos_ci.getitemnumber(1,'derecho_cta_pag_isa')
				ll_ctas_pagadas	= ll_ctas_pagadas_1 + ll_ctas_pagadas_2
			elseif gs_base='A' and dw_datos_ci.DataObject='d_datos_cuenta_ci_aumento_capacidad' then
				ll_ctas				= dw_datos_ci.getitemnumber(1,'pago_aumento_nro_cuotas')
				ll_ctas_pagadas	= dw_datos_ci.getitemnumber(1,'anexo_aumento_cta_pag_m')
			elseif gs_base='R' and dw_datos_ci.DataObject='dw_repacta_mant_descripcion_traspaso' then
				ll_ctas				= dw_datos_ci.getitemnumber(1,'cuotas_pactadas')
				ll_ctas_pagadas	= dw_datos_ci.getitemnumber(1,'ctas_pagadas')
			elseif (gs_base='F' or gs_base='G' or gs_base='V') and dw_datos_ci.DataObject='d_datos_cuenta_ci_funeraria' then
				ll_ctas				= dw_datos_ci.getitemnumber(1,'producto_pago_plazo')
				ll_ctas_pagadas	= dw_datos_ci.getitemnumber(1,'producto_anexo_cuotas_pag')
			end if
			if (ll_ctas_pagadas + ll_cantidad) > ll_ctas then
				dw_detalle_ci.SetItem(ll_row, 'cantidad', 0)
				dw_detalle_ci.SetItem(ll_row,'c_total_linea',0)
				dw_detalle_ci.SetItem(ll_row,'monto_uf',0)
				dw_detalle_ci.SetItem(ll_row,'monto',0)
				dw_gastos_ci.SetItem(1, 'Subtotal',0)
				dw_gastos_ci.SetItem(1, 'mora',0)
				dw_gastos_ci.SetItem(1, 'gastos_cob',0)
				
				dw_gastos_ci.SetItem(1, 'mora_cred',0)
				dw_gastos_ci.SetItem(1, 'mora_mant',0)
				dw_gastos_ci.SetItem(1, 'gasto_cred',0)
				dw_gastos_ci.SetItem(1, 'gasto_mant',0)
				dw_detalle_ci.accepttext()
			end if
		end if
		if gs_codigo_otro = "" then gs_codigo_otro = '0'
		if ls_tipo_cob = 'S' and gs_codigo_otro <> '0' then
			wf_validar_descuento()
		end if
	end if
end if
ld_monto	= this.getitemnumber(row,'monto')
if ld_monto < 0 then
	if isnull(il_cantidad_malo) then	il_cantidad_malo	= this.getitemnumber(row,'cantidad')
//	messagebox("Advertencia","Revisar Monto Ingresado, recuerde Ingreso MONTO Mayor a CERO")
	SetItem(row, "monto", 0)
	SetItem(row, "cantidad", 0)
else
	if il_cantidad_malo>0 then this.setitem(row,'cantidad',il_cantidad_malo)
end if

ll_row							= il_fila_desc
ls_tipo_cob					= dw_detalle_ci.getitemstring(ll_row,'tipo_cob')
if not isnull(dw_detalle_ci.getitemstring(ll_row,'tipo_cob_otro')) then gs_codigo_otro	= dw_detalle_ci.getitemstring(ll_row,'tipo_cob_otro')
if ls_tipo_cob = 'S' and (gs_codigo_otro <> '0' or not isnull(gs_codigo_otro)) then
	wf_validar_descuento()
end if
//////Validar

if gs_rezago='S' then
	ll_cod_parque			= dw_parque_boleta.getitemnumber(1,'cod_parque')
else
	ll_cod_parque			= dw_datos_ci.getitemnumber(1,'cadena_cod_parque')
//	if ( (ls_tipo_cob="E" or ls_tipo_cob="U" or ls_tipo_cob="A" or ls_tipo_cob="Q") and (gs_base<>'O' or (gs_base<>'P' and ll_cod_parque <> 101 ))) and il_modif > 0 then
	if ( (ls_tipo_cob="E" or ls_tipo_cob="U" or ls_tipo_cob="A" or ls_tipo_cob="Q") and ((gs_base <> 'O'  and gs_base <> 'U'  and gs_base <> 'M' and gs_base <> 'P' and gs_base <> 'F' and gs_base <> 'G') or (gs_base='P' and ll_cod_parque = 101 ))) and il_modif > 0 then
		dw_detalle_ci.SetItem(row, 'monto', 0)
		dw_detalle_ci.SetItem(row, 'cantidad', 0)
		dw_detalle_ci.SetItem(row,'tipo_cob',ls_nulo)
		dw_detalle_ci.setfocus()
		dw_detalle_ci.setcolumn('tipo_cob')
	end if
end if
ls_tipo_cob					= dw_detalle_ci.getitemstring(row,'tipo_cob')
if not isnull(gs_base) and (ls_tipo_cob='' or ls_tipo_cob='E' or ls_tipo_cob='F' or isnull(ls_tipo_cob)) and st_toku.visible=true then
	dw_detalle_ci.SetItem(row, 'monto', 0)
	dw_detalle_ci.SetItem(row, 'monto_uf', 0)
	dw_detalle_ci.SetItem(row, 'cantidad', 0)
	setnull(ls_tipo_cob)
	dw_detalle_ci.SetItem(row, "tipo_cob", ls_tipo_cob)
	dw_detalle_ci.accepttext()
	dw_detalle_ci.setfocus()
	dw_detalle_ci.setcolumn('tipo_cob')
end if
if dw_datos_ci.dataobject='d_datos_cuenta_ci_funeraria' and dw_datos_ci.rowcount() > 0 then
	ls_uso			= dw_datos_ci.getitemstring(1,'producto_anexo_uso')
	if ls_uso = 'NF' and gs_base='F' then
//		messagebox("Advertencia","Recuerde que debe Generar Boleta Afecta para Funeraria NF")
		dw_detalle_ci.SetItem(row, 'cantidad', ll_nulo )
		dw_detalle_ci.SetItem(row, 'tipo_cob', ls_nulo )
		dw_detalle_ci.SetItem(row, 'tipo_cob_otro', ls_nulo )
		dw_detalle_ci.accepttext()
		dw_detalle_ci.setcolumn('tipo_cob')
	end if
end if
dw_detalle_ci.accepttext()
end event

event losefocus;String	ls_columna,ls_tipo_cob
Long		ll_cantidad,ll_ctas,ll_ctas_pagadas,ll_ctas_pagadas_1,ll_ctas_pagadas_2

dw_detalle_ci.accepttext()
if dw_datos_ci.rowcount() > 0 and dw_detalle_ci.rowcount() > 0 then
	ls_tipo_cob				= dw_detalle_ci.getitemstring(dw_detalle_ci.getrow(),'tipo_cob')
	ll_cantidad 				= dw_detalle_ci.GetItemNumber(dw_detalle_ci.getrow(), "cantidad")
	if gs_codigo_otro = "" then gs_codigo_otro = '0'
	if ls_tipo_cob = 'S' and gs_codigo_otro <> '0' then
		wf_validar_descuento()
	end if
	IF ls_tipo_cob = "E" AND gs_rezago <> "S" and gs_base <> 'C' THEN
		if (gs_base='O' or gs_base='U' or gs_base='M') and dw_datos_ci.DataObject='d_datos_cuenta_ci_oferta' then
			ll_ctas				= dw_datos_ci.getitemnumber(1,'pago_oferta_nro_cuotas')
			ll_ctas_pagadas	= dw_datos_ci.getitemnumber(1,'oferta_v_cta_pag_s')
		elseif gs_base='P' and dw_datos_ci.DataObject='d_datos_cuenta_ci_pagare' then
			ll_ctas				= dw_datos_ci.getitemnumber(1,'pagare_plazo')
			ll_ctas_pagadas_1	= dw_datos_ci.getitemnumber(1,'pagare_cta_pag_la')
			ll_ctas_pagadas_2	= dw_datos_ci.getitemnumber(1,'pagare_cta_pag_isa')
			ll_ctas_pagadas	= ll_ctas_pagadas_1 + ll_ctas_pagadas_2
		elseif gs_base='L' and dw_datos_ci.DataObject='d_datos_cuenta_ci_liberador' then
			ll_ctas				= dw_datos_ci.getitemnumber(1,'pago_liberador_nro_cuotas')
			ll_ctas_pagadas	= dw_datos_ci.getitemnumber(1,'anexo_liberador_cta_pag_m')
		elseif gs_base='D' and dw_datos_ci.DataObject='d_datos_cuenta_ci_derecho' then
			ll_ctas				= dw_datos_ci.getitemnumber(1,'derecho_plazo')
			ll_ctas_pagadas_1	= dw_datos_ci.getitemnumber(1,'derecho_cta_pag_la')
			ll_ctas_pagadas_2	= dw_datos_ci.getitemnumber(1,'derecho_cta_pag_isa')
			ll_ctas_pagadas	= ll_ctas_pagadas_1 + ll_ctas_pagadas_2
		elseif gs_base='A' and dw_datos_ci.DataObject='d_datos_cuenta_ci_aumento_capacidad' then
			ll_ctas				= dw_datos_ci.getitemnumber(1,'pago_aumento_nro_cuotas')
			ll_ctas_pagadas	= dw_datos_ci.getitemnumber(1,'anexo_aumento_cta_pag_m')
		elseif gs_base='R' and dw_datos_ci.DataObject='dw_repacta_mant_descripcion_traspaso' then
			ll_ctas				= dw_datos_ci.getitemnumber(1,'cuotas_pactadas')
			ll_ctas_pagadas	= dw_datos_ci.getitemnumber(1,'ctas_pagadas')
		elseif (gs_base='F' or gs_base='G' or gs_base='V') and dw_datos_ci.DataObject='d_datos_cuenta_ci_funeraria' then
			ll_ctas				= dw_datos_ci.getitemnumber(1,'producto_pago_plazo')
			ll_ctas_pagadas	= dw_datos_ci.getitemnumber(1,'producto_anexo_cuotas_pag')
		end if
		if (ll_ctas_pagadas + ll_cantidad) > ll_ctas then
			dw_detalle_ci.SetItem(dw_detalle_ci.getrow(), "cantidad", 0)
			dw_gastos_ci.SetItem(1, "Subtotal",0)
			dw_gastos_ci.SetItem(1, "mora",0)
			dw_gastos_ci.SetItem(1, "gastos_cob",0)
			
			dw_gastos_ci.SetItem(1, "mora_cred",0)
			dw_gastos_ci.SetItem(1, "mora_mant",0)
			dw_gastos_ci.SetItem(1, "gasto_cred",0)
			dw_gastos_ci.SetItem(1, "gasto_mant",0)
			dw_detalle_ci.accepttext()
		end if
	end if
end if
end event

type st_7 from statictext within tp_ci
