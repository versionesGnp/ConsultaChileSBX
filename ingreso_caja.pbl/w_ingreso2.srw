long backcolor = 67108864
boolean raggedright = true
boolean focusonbuttondown = true
boolean powertips = true
boolean boldselectedtext = true
integer selectedtab = 1
tp_cupon tp_cupon
tp_ci tp_ci
tp_be tp_be
tp_boletas tp_boletas
tp_porfacturar tp_porfacturar
end type

event ue_mousemove;wf_no_mostrar_help()
tab_ingreso.tp_cupon.st_help_ctto.visible	= false
if is_opcion='FP' and (gs_depto='T' or gs_depto='I') then st_fuera_plazo.visible = true

end event

on tab_ingreso.create
this.tp_cupon=create tp_cupon
this.tp_ci=create tp_ci
this.tp_be=create tp_be
this.tp_boletas=create tp_boletas
this.tp_porfacturar=create tp_porfacturar
this.Control[]={this.tp_cupon,&
this.tp_ci,&
this.tp_be,&
this.tp_boletas,&
this.tp_porfacturar}
end on

on tab_ingreso.destroy
destroy(this.tp_cupon)
destroy(this.tp_ci)
destroy(this.tp_be)
destroy(this.tp_boletas)
destroy(this.tp_porfacturar)
end on

event selectionchanged;long	ll_resp

CHOOSE CASE tab_ingreso.SelectedTab
	CASE 1 //Cupón
		wf_limpiar_opciones()
		tab_ingreso.tp_cupon.sle_n_contrato.setfocus()

	CASE 2 //Comprobante Ingreso
		wf_limpiar_opciones()
		tab_ingreso.tp_ci.dw_ci_buscar_cliente.setfocus()
		tab_ingreso.tp_ci.dw_ci_buscar_cliente.setcolumn('rl_rut')

	CASE 3 //Boleta
		wf_limpiar_opciones()
		tab_ingreso.tp_be.dw_be_buscar_cliente.setfocus()
		tab_ingreso.tp_be.dw_be_buscar_cliente.setcolumn('rl_rut')
		
	CASE 4 //Factura EXENTA
		if gs_depto='C' or gs_depto='I'  then 
			tab_ingreso.tp_boletas.cbx_factura_exenta.checked		= true
		else
			tab_ingreso.tp_boletas.cbx_factura_exenta.checked		= false
		end if
		wf_limpiar_opciones()
		tab_ingreso.tp_boletas.dw_bl_buscar_cliente.setfocus()
		tab_ingreso.tp_boletas.dw_bl_buscar_cliente.setcolumn('rl_rut')
		
	CASE 5 //Comprobante Factura
		tab_ingreso.tp_porfacturar.cb_limpiar_factura.triggerevent(clicked!)
		tab_ingreso.tp_porfacturar.em_folio_factura.text				= ''
		tab_ingreso.tp_porfacturar.em_folio_factura.setfocus()
		
END CHOOSE
end event

