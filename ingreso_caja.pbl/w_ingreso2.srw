type dw_detalle_pago_cupon from datawindow within tp_cupon
event ue_mousemove pbm_mousemove
integer x = 1403
integer y = 92
integer width = 2199
integer height = 1280
integer taborder = 20
string title = "none"
string dataobject = "dw_lista_pagar_cupones_vigentes"
boolean vscrollbar = true
borderstyle borderstyle = stylelowered!
end type

event ue_mousemove;Long	ll_monto
if dw_detalle_pago_cupon.rowcount() > 0 then
	ll_monto		= dw_detalle_pago_cupon.getitemnumber(1,'c_suma_total')
	if ll_monto <> long(tab_ingreso.tp_cupon.st_total_pagado.text) then
		tab_ingreso.tp_cupon.st_total_pagado.text	= string(ll_monto,"###,###,###,###,##0")
	end if
end if
tab_ingreso.tp_cupon.st_help_ctto.visible	= false
if is_opcion='FP' and (gs_depto='T' or gs_depto='I') then st_fuera_plazo.visible = true
end event

event clicked;String	ls_columna,ls_tipo_mov,ls_tipo_mov_f,ls_reg_pago
Long		ll_no_pasar,ll_cupon,ll_tot_reg,ll_fila,ll_cuota,ll_cuota_menos_1,ll_indi,&
			ll_fila_menos,ll_cuota_mas_1,ll_fila_mayor,ll_count_malo,ll_estado_reg,ll_fila_mant_0,&
			ll_monto,ll_suma

ls_columna		= dwo.name
ll_tot_reg		= dw_detalle_pago_cupon.rowcount()
if ll_tot_reg > 0 then
	if row > 0 then
		il_row		= row
		This.SelectRow(0, FALSE)
		This.SelectRow(il_row, TRUE)
		This.accepttext()
		ll_fila		= row
		if ll_fila>0 then
			CHOOSE CASE ls_columna
				CASE 'estado_reg'
					ll_no_pasar		= 0
					ll_count_malo	= 0
					ll_cupon			= dw_detalle_pago_cupon.getitemnumber(ll_fila,'cuponeras_detalle_nro_cupon')
					ll_tot_reg		= dw_detalle_pago_cupon.rowcount()
					if ll_cupon > 0 then
						ll_fila		= dw_detalle_pago_cupon.Find("cuponeras_detalle_nro_cupon = "+string(ll_cupon),1, ll_tot_reg)
						if ll_fila > 0 then
							if ll_fila > 0 then
								ls_tipo_mov			= dw_detalle_pago_cupon.getitemstring(ll_fila,'cuponeras_detalle_tipo_mov')
								if ls_tipo_mov='E' then
									ll_cuota				= dw_detalle_pago_cupon.getitemnumber(ll_fila,'cuponeras_detalle_nro_cuota')
									ll_cuota_menos_1	= ll_cuota - 1
									ll_fila_menos		= dw_detalle_pago_cupon.Find("cuponeras_detalle_tipo_mov = '"+ls_tipo_mov+"' and cuponeras_detalle_nro_cuota = "+string(ll_cuota_menos_1),1, ll_tot_reg)
									if ll_fila_menos > 0 then
										if dw_detalle_pago_cupon.getitemnumber(ll_fila_menos,'estado_reg')=0 then
											dw_detalle_pago_cupon.setitem(ll_fila,'estado_reg',0)
											dw_detalle_pago_cupon.setitem(ll_fila,'reg_pago','S')
										else
											dw_detalle_pago_cupon.setitem(ll_fila,'estado_reg',1)
											dw_detalle_pago_cupon.setitem(ll_fila,'reg_pago','N')
											ll_count_malo ++
											messagebox("Advertencia","No Es Posible Cancelar Cupón Nº "+string(ll_cupon)+', cuota Anterior está VIGENTE')
										end if
									end if
									if ll_count_malo=0 then
										ll_cuota_mas_1	= ll_cuota + 1
										ll_fila_mayor		= dw_detalle_pago_cupon.Find("cuponeras_detalle_tipo_mov = '"+ls_tipo_mov+"' and cuponeras_detalle_nro_cuota = "+string(ll_cuota_mas_1),1, ll_tot_reg)
										if ll_fila_mayor > 0 then
											if dw_detalle_pago_cupon.getitemnumber(ll_fila_mayor,'estado_reg')=0 then
												if dw_detalle_pago_cupon.getitemnumber(ll_fila,'estado_reg')=1 then
													dw_detalle_pago_cupon.setitem(ll_fila,'estado_reg',0)
													dw_detalle_pago_cupon.setitem(ll_fila,'reg_pago','S')
													messagebox("Advertencia","Debe Cancelar Cupón Nº "+string(ll_cupon)+', los Pagos deben ser en Orden')
												end if
											else
												dw_detalle_pago_cupon.setitem(ll_fila,'reg_pago','S')
												dw_detalle_pago_cupon.setitem(ll_fila,'estado_reg',1)
											end if
										end if
									end if
	
								elseif ls_tipo_mov='F' then
									for ll_indi=1 to ll_fila
										if ll_indi < ll_fila then
											ls_tipo_mov_f	= dw_detalle_pago_cupon.getitemstring(ll_indi,'cuponeras_detalle_tipo_mov')
											if ls_tipo_mov_f='F' then
												if dw_detalle_pago_cupon.getitemnumber(ll_indi,'estado_reg')=1 then
													dw_detalle_pago_cupon.setitem(ll_fila,'estado_reg',1)
													dw_detalle_pago_cupon.setitem(ll_fila,'reg_pago','N')
													messagebox("Advertencia","No Es Posible Cancelar Cupón Nº "+string(ll_cupon)+', cuota Anterior está VIGENTE')
													ll_no_pasar ++
													exit
												else
													dw_detalle_pago_cupon.setitem(ll_fila,'reg_pago','S')
												end if
											end if
										end if
									next
									if ll_no_pasar	= 0 then
										dw_detalle_pago_cupon.setitem(ll_fila,'reg_pago','S')
									end if
								end if
								ls_tipo_mov		= dw_detalle_pago_cupon.getitemstring(ll_fila,'cuponeras_detalle_tipo_mov')
								ll_estado_reg	= dw_detalle_pago_cupon.getitemnumber(ll_fila,'estado_reg')
								if ls_tipo_mov='E' then
									if ll_estado_reg=0 then
										if (ll_fila + 1) <= dw_detalle_pago_cupon.rowcount() then
											if ll_fila>1 then
												if (dw_detalle_pago_cupon.getitemnumber((ll_fila - 1),'estado_reg')=0 and dw_detalle_pago_cupon.getitemstring((ll_fila - 1),'cuponeras_detalle_tipo_mov')=ls_tipo_mov) or &
													dw_detalle_pago_cupon.getitemnumber((ll_fila + 1),'estado_reg')=0 and dw_detalle_pago_cupon.getitemstring((ll_fila + 1),'cuponeras_detalle_tipo_mov')=ls_tipo_mov then
													
													messagebox("Advertencia","Debe Cancelar Cupón Nº "+string(ll_cupon)+', los Pagos deben ser en Orden')
													dw_detalle_pago_cupon.setitem(ll_fila,'estado_reg',1)
												end if
											else
												if dw_detalle_pago_cupon.getitemnumber((ll_fila + 1),'estado_reg')=0 and dw_detalle_pago_cupon.getitemstring((ll_fila + 1),'cuponeras_detalle_tipo_mov')=ls_tipo_mov then
													messagebox("Advertencia","Debe Cancelar Cupón Nº "+string(ll_cupon)+', los Pagos deben ser en Orden')
													dw_detalle_pago_cupon.setitem(ll_fila,'estado_reg',1)
												end if
											end if
										elseif ll_fila = dw_detalle_pago_cupon.rowcount() then
											dw_detalle_pago_cupon.setitem(ll_fila,'estado_reg',0)
										end if
									end if
								end if
							else
								dw_detalle_pago_cupon.setitem(ll_fila,'reg_pago','S')
							end if
							dw_detalle_pago_cupon.accepttext()
							ls_tipo_mov		= dw_detalle_pago_cupon.getitemstring(ll_fila,'cuponeras_detalle_tipo_mov')
							ll_estado_reg	= dw_detalle_pago_cupon.getitemnumber(ll_fila,'estado_reg')
							if ls_tipo_mov='F' then
								if ll_estado_reg=0 then
									ll_fila_mant_0	= dw_detalle_pago_cupon.Find("cuponeras_detalle_tipo_mov = 'F' and estado_reg = 0",(ll_fila + 1), ll_tot_reg)
									if ll_fila_mant_0 > 0 then
										messagebox("Advertencia","Debe Cancelar Cupón Nº "+string(ll_cupon)+', los Pagos deben ser en Orden')
										dw_detalle_pago_cupon.setitem(ll_fila,'estado_reg',1)
									end if
								end if
							end if
						end if
					end if
			END CHOOSE
		end if
	else
		if ls_columna='t_marcar' then
			if dw_detalle_pago_cupon.object.t_marcar.text	= 'Marcar Todo' then
				for ll_indi=1 to ll_tot_reg
					dw_detalle_pago_cupon.setitem(ll_indi,'estado_reg',0)
				next
				dw_detalle_pago_cupon.object.t_marcar.text	= 'Desmarcar Todo'
			elseif dw_detalle_pago_cupon.object.t_marcar.text	= 'Desmarcar Todo' then
				for ll_indi=1 to ll_tot_reg
					dw_detalle_pago_cupon.setitem(ll_indi,'estado_reg',1)
				next
				dw_detalle_pago_cupon.object.t_marcar.text	= 'Marcar Todo'
			end if
		end if
	end if
	dw_detalle_pago_cupon.accepttext()
end if
end event

event rowfocuschanged;if getrow()>0 then
	il_row	= getrow()
	This.SelectRow(0, FALSE)
	This.SelectRow(il_row, TRUE)
end if
end event

type cb_limpiar_cupon from commandbutton within tp_cupon
event ue_mousemove pbm_mousemove
integer x = 1408
integer y = 1420
integer width = 338
integer height = 96
integer taborder = 20
integer textsize = -9
integer weight = 700
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string text = "&Limpiar"
end type

event ue_mousemove;tab_ingreso.tp_cupon.st_help_ctto.visible	= false
if is_opcion='FP' and (gs_depto='T' or gs_depto='I') then st_fuera_plazo.visible = true
end event

event clicked;Long	ll_folio,ll_count_ci,ll_count_abono

ll_folio			= gl_folio
//SELECT sysdate  INTO :gdt_fec_sistema  FROM "TASA"  WHERE "TASA"."LOOK" = 1   ;
//st_fecha.text					= string(gdt_fec_sistema,'dd/mm/yyyy')
if gl_folio > 0 then
	SELECT	Count("INGRESO"."FOLIO")  
	INTO 		:ll_count_ci  
	FROM 		"INGRESO"  
	WHERE  ( "INGRESO"."TIPO_COB" = 'CU' ) AND  
			 ( "INGRESO"."FOLIO" = :ll_folio )   
	USING		sqlca;
	if ll_count_ci = 0 then
		SELECT	Count("ABONO_CTA_CTE"."FOLIO")  
		INTO 		:ll_count_abono  
		FROM 		"ABONO_CTA_CTE"  
		WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
				 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
				 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
				 ( "ABONO_CTA_CTE"."TIPO_COB" = 'CU' ) AND  
				 ( "ABONO_CTA_CTE"."FOLIO" = :ll_folio ) AND
				 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )  
		USING		sqlca;
		if ll_count_abono > 0 then
			DELETE FROM "ABONO_CTA_CTE"  
			WHERE		( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
						( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
						( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
						( "ABONO_CTA_CTE"."TIPO_COB" = 'CU' ) AND  
						( "ABONO_CTA_CTE"."FOLIO" = :ll_folio ) AND  
						( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
			USING		sqlca;
			if sqlca.sqlcode=0 then
				commit;
			else
				rollback;
				messagebox("Error Eliminar","Error ELIMINAR ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
			end if
		end if
		
		SELECT	Count("ABONO_CTA_CTE"."FOLIO_OCUPA")  
		INTO 		:ll_count_abono  
		FROM 		"ABONO_CTA_CTE"  
		WHERE  ( "ABONO_CTA_CTE"."TIPO_COB_OCUPA" = 'CU' ) AND  
				 ( "ABONO_CTA_CTE"."FOLIO_OCUPA" = :ll_folio ) AND  
				 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'O' )
		USING		sqlca;
		if ll_count_abono > 0 then
			UPDATE	"ABONO_CTA_CTE"  
			SET 		"ESTADO_REG" = 'P',   
						"TIPO_COB_OCUPA" = Null,   
						"FOLIO_OCUPA" = Null,   
						"FECHA_OCUPA" = Null,   
						"MONTO_OCUPA" = Null,   
						"USUARIO_OCUPA" = Null,   
						"CAJA_OCUPA" = Null,   
						"TIPO_MOV_OCUPA" = Null  
			WHERE  ( "ABONO_CTA_CTE"."TIPO_COB_OCUPA" = 'CU' ) AND  
					 ( "ABONO_CTA_CTE"."FOLIO_OCUPA" = :ll_folio ) AND  
					 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'O' )
			USING		sqlca;
			if sqlca.sqlcode=0 then
				commit;
			else
				rollback;
				messagebox("Error Eliminar","Error UPDATE ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
			end if
		end if
	end if
end if

