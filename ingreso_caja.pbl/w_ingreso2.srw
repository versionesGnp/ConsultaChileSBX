event clicked;cb_limpiar_factura.triggerevent(clicked!)
Date	ld_fec_fin

ld_fec_fin	= date(em_fec_fin.text)
if trim(em_fec_fin.text)='00/00/0000' or isnull(em_fec_fin.text) then
	messagebox("Advertencia","Fecha Periodo Desde Inválida")
	em_fec_fin.setfocus()
else
	if tab_ingreso.tp_porfacturar.dw_por_facturar.retrieve(ld_fec_fin) > 0 then
		tab_ingreso.tp_porfacturar.em_folio_factura.text		= ''
		tab_ingreso.tp_porfacturar.em_folio_factura.enabled	= true
	else
		tab_ingreso.tp_porfacturar.em_folio_factura.text		= ''
		tab_ingreso.tp_porfacturar.em_folio_factura.enabled	= false
	end if
end if
end event

