	if il_ncred>0 then
		id_valor_cuota 		= Round(tab_ingreso.tp_cupon.dw_datos_credito_oferta.GetItemNumber(1,"c_valor_cuota_cred_peso"), 0)
		ll_ctas				= tab_ingreso.tp_cupon.dw_datos_credito_oferta.getitemnumber(1,'pago_liberador_nro_cuotas')
		ll_ctas_pagadas	= tab_ingreso.tp_cupon.dw_datos_credito_oferta.getitemnumber(1,'anexo_liberador_cta_pag_m')
		ll_ctas_pag			= ll_ctas_pagadas
		ldt_fecha_prim		= tab_ingreso.tp_cupon.dw_datos_credito_oferta.GetItemdatetime(1,'pago_liberador_fecha_prim')
		ii_dmora 			= tab_ingreso.tp_cupon.dw_datos_credito_oferta.GetItemNumber(1,"c_dias_mora")
		ll_ctas_mora		= tab_ingreso.tp_cupon.dw_datos_credito_oferta.GetItemNumber(1,'c_cuotas_mora')
		ll_cuota				= ll_ctas_mora
		ll_estado_carta		= tab_ingreso.tp_cupon.dw_datos_credito_oferta.GetItemNumber(1,'cadena_estado_carta')
		gl_cod_parque		= tab_ingreso.tp_cupon.dw_datos_credito_oferta.GetItemNumber(1,'cadena_cod_parque')
	end if
	
ElseIF as_base = "F" or as_base="G" THEN
	if as_base="F" then
		tab_ingreso.tp_cupon.st_10.text								= " PRODUCTO FUNERARIO"
	elseif as_base="G" then
		tab_ingreso.tp_cupon.st_10.text								= " PRODUCTO CINERARIO"
	end if
	il_nenc 					= dw_encabezado_ingreso_cupon.Retrieve(as_base, as_serie, al_numero)
	tab_ingreso.tp_cupon.dw_datos_credito_oferta.DataObject 	= 'dw_datos_contrato_funerario'
	tab_ingreso.tp_cupon.dw_datos_credito_oferta.SetTransObject(SQLCA)
	il_ncred 					= tab_ingreso.tp_cupon.dw_datos_credito_oferta.Retrieve(as_serie, al_numero,gd_uf)
	if il_ncred>0 then
		id_valor_cuota 		= Round(tab_ingreso.tp_cupon.dw_datos_credito_oferta.GetItemNumber(1,"c_valor_cuota_cred_peso"), 0)
		ll_ctas				= tab_ingreso.tp_cupon.dw_datos_credito_oferta.getitemnumber(1,'producto_pago_plazo')
		ll_ctas_pagadas	= tab_ingreso.tp_cupon.dw_datos_credito_oferta.getitemnumber(1,'producto_anexo_cuotas_pag')
		ll_ctas_pag			= ll_ctas_pagadas
		ldt_fecha_prim		= tab_ingreso.tp_cupon.dw_datos_credito_oferta.GetItemdatetime(1,'producto_pago_fecha_prim')
		ii_dmora 			= tab_ingreso.tp_cupon.dw_datos_credito_oferta.GetItemNumber(1,"c_dias_mora")
		ll_ctas_mora		= tab_ingreso.tp_cupon.dw_datos_credito_oferta.GetItemNumber(1,'c_cuotas_mora')
		ll_cuota				= ll_ctas_mora
		ll_estado_carta		= tab_ingreso.tp_cupon.dw_datos_credito_oferta.GetItemNumber(1,'cadena_estado_carta')
		gl_cod_parque		= tab_ingreso.tp_cupon.dw_datos_credito_oferta.GetItemNumber(1,'cadena_cod_parque')
	end if
	
ElseIF as_base = "P" THEN 
	tab_ingreso.tp_cupon.st_10.text				= " P A G A R E "
	il_nenc 					= dw_encabezado_ingreso_cupon.Retrieve(as_base, as_serie, al_numero)
	tab_ingreso.tp_cupon.dw_datos_credito_oferta.DataObject = 'dw_datos_contrato_pagare'
	tab_ingreso.tp_cupon.dw_datos_credito_oferta.SetTransObject(SQLCA)
	il_ncred 					= tab_ingreso.tp_cupon.dw_datos_credito_oferta.Retrieve(as_serie, al_numero,gd_uf)
	if il_ncred>0 then
		id_valor_cuota 		= Round(tab_ingreso.tp_cupon.dw_datos_credito_oferta.GetItemNumber(1,"c_valor_cuota_cred_peso"), 0)
		ll_ctas				= tab_ingreso.tp_cupon.dw_datos_credito_oferta.getitemnumber(1,'plazo')
		ll_ctas_pagada_1	= tab_ingreso.tp_cupon.dw_datos_credito_oferta.getitemnumber(1,'cta_pag_la')
		ll_ctas_pagada_2	= tab_ingreso.tp_cupon.dw_datos_credito_oferta.getitemnumber(1,'cta_pag_isa')
		ll_ctas_pagadas	= ll_ctas_pagada_1 + ll_ctas_pagada_2
		ll_ctas_pag			= ll_ctas_pagadas
		ldt_fecha_prim		= tab_ingreso.tp_cupon.dw_datos_credito_oferta.GetItemdatetime(1,'fecha_prim')
		ii_dmora 			= tab_ingreso.tp_cupon.dw_datos_credito_oferta.GetItemNumber(1,"c_dias_mora")
		ll_ctas_mora		= tab_ingreso.tp_cupon.dw_datos_credito_oferta.GetItemNumber(1,'c_cuotas_mora')
		ll_cuota				= ll_ctas_mora
		ll_estado_carta		= tab_ingreso.tp_cupon.dw_datos_credito_oferta.GetItemNumber(1,'cadena_estado_carta')
		gl_cod_parque		= tab_ingreso.tp_cupon.dw_datos_credito_oferta.GetItemNumber(1,'cadena_cod_parque')
	end if
	
ElseIF as_base = "D" THEN 
	tab_ingreso.tp_cupon.st_10.text				= " DERECHO ESPECIAL"
	il_nenc 					= dw_encabezado_ingreso_cupon.Retrieve(as_base, as_serie, al_numero)
	tab_ingreso.tp_cupon.dw_datos_credito_oferta.DataObject	= 'dw_datos_contrato_derecho_especial'
	tab_ingreso.tp_cupon.dw_datos_credito_oferta.SetTransObject(SQLCA)
	il_ncred 					= tab_ingreso.tp_cupon.dw_datos_credito_oferta.Retrieve(as_serie, al_numero,gd_uf)
	if il_ncred>0 then
		id_valor_cuota 	= Round(tab_ingreso.tp_cupon.dw_datos_credito_oferta.GetItemNumber(1,"c_valor_cuota_cred_peso"), 0)
		ll_ctas				= tab_ingreso.tp_cupon.dw_datos_credito_oferta.getitemnumber(1,'derecho_plazo')
		ll_ctas_pagada_1	= tab_ingreso.tp_cupon.dw_datos_credito_oferta.getitemnumber(1,'derecho_cta_pag_la')
		ll_ctas_pagada_2	= tab_ingreso.tp_cupon.dw_datos_credito_oferta.getitemnumber(1,'derecho_cta_pag_isa')
		ll_ctas_pagadas	= ll_ctas_pagada_1 + ll_ctas_pagada_2
		ll_ctas_pag			= ll_ctas_pagadas
		ldt_fecha_prim		= tab_ingreso.tp_cupon.dw_datos_credito_oferta.GetItemdatetime(1,'derecho_fecha_prim')
		ii_dmora 			= tab_ingreso.tp_cupon.dw_datos_credito_oferta.GetItemNumber(1,"c_dias_mora")
		ll_ctas_mora		= tab_ingreso.tp_cupon.dw_datos_credito_oferta.GetItemNumber(1,'c_cuotas_mora')
		ll_cuota				= ll_ctas_mora
		ll_estado_carta		= tab_ingreso.tp_cupon.dw_datos_credito_oferta.GetItemNumber(1,'cadena_estado_carta')
		gl_cod_parque		= tab_ingreso.tp_cupon.dw_datos_credito_oferta.GetItemNumber(1,'cadena_cod_parque')
	end if
	
ElseIF as_base = "A" THEN 
	tab_ingreso.tp_cupon.st_10.text				= " AUMENTO CAPACIDAD"
	il_nenc 					= dw_encabezado_ingreso_cupon.Retrieve(as_base, as_serie, al_numero)
	tab_ingreso.tp_cupon.dw_datos_credito_oferta.DataObject = 'dw_datos_contrato_aumento_capacidad'
	tab_ingreso.tp_cupon.dw_datos_credito_oferta.SetTransObject(SQLCA)
	il_ncred 					= tab_ingreso.tp_cupon.dw_datos_credito_oferta.Retrieve(as_serie, al_numero,gd_uf)
	if il_ncred>0 then
		id_valor_cuota 		= Round(tab_ingreso.tp_cupon.dw_datos_credito_oferta.GetItemNumber(1,"c_valor_cuota_cred_peso"), 0)
		ll_ctas				= tab_ingreso.tp_cupon.dw_datos_credito_oferta.getitemnumber(1,'pago_aumento_nro_cuotas')
		ll_ctas_pagadas	= tab_ingreso.tp_cupon.dw_datos_credito_oferta.getitemnumber(1,'anexo_aumento_cta_pag_m')
		ll_ctas_pag			= ll_ctas_pagadas
		ldt_fecha_prim		= tab_ingreso.tp_cupon.dw_datos_credito_oferta.GetItemdatetime(1,'pago_aumento_fecha_prim')
		ii_dmora 			= tab_ingreso.tp_cupon.dw_datos_credito_oferta.GetItemNumber(1,"c_dias_mora")
		ll_ctas_mora		= tab_ingreso.tp_cupon.dw_datos_credito_oferta.GetItemNumber(1,'c_cuotas_mora')
		ll_cuota				= ll_ctas_mora
		ll_estado_carta		= tab_ingreso.tp_cupon.dw_datos_credito_oferta.GetItemNumber(1,'cadena_estado_carta')
		gl_cod_parque		= tab_ingreso.tp_cupon.dw_datos_credito_oferta.GetItemNumber(1,'cadena_cod_parque')
	end if
	
ElseIF as_base = "C" then
	tab_ingreso.tp_cupon.st_10.text				= " CONTRATO"
	il_nenc 						= dw_encabezado_ingreso_cupon.Retrieve(as_base, as_serie, al_numero)
	tab_ingreso.tp_cupon.dw_datos_credito_oferta.DataObject = 'dw_datos_contrato_isacruz'
	tab_ingreso.tp_cupon.dw_datos_credito_oferta.SetTransObject(SQLCA)
	il_ncred 						= tab_ingreso.tp_cupon.dw_datos_credito_oferta.Retrieve(as_serie, al_numero,gd_uf)
	if il_ncred>0 then
		id_valor_cuota 			= Round(tab_ingreso.tp_cupon.dw_datos_credito_oferta.GetItemNumber(1,"c_valor_cta_mant_peso"), 0)
		ll_ctas					= tab_ingreso.tp_cupon.dw_datos_credito_oferta.getitemnumber(1,'contrato_plazo')
		ll_ctas_pagadas		= tab_ingreso.tp_cupon.dw_datos_credito_oferta.getitemnumber(1,'contrato_cta_pag_m')
		ll_ctas_pag				= ll_ctas_pagadas		
		ll_ctas_mora_mant	= tab_ingreso.tp_cupon.dw_datos_credito_oferta.GetItemNumber(1,'c_cuotas_mora_m')
		ll_estado_carta			= tab_ingreso.tp_cupon.dw_datos_credito_oferta.GetItemNumber(1,'cadena_estado_carta')
		gl_cod_parque			= tab_ingreso.tp_cupon.dw_datos_credito_oferta.GetItemNumber(1,'cadena_cod_parque')
	end if
	
ElseIF as_base = "R" then
	tab_ingreso.tp_cupon.st_10.text				= " REPROG. DE MANTENCION"
	il_nenc 						= dw_encabezado_ingreso_cupon.Retrieve(as_base, as_serie, al_numero)
	tab_ingreso.tp_cupon.dw_datos_credito_oferta.DataObject = 'dw_datos_contrato_reprog_mant'
	tab_ingreso.tp_cupon.dw_datos_credito_oferta.SetTransObject(SQLCA)
	il_ncred 						= tab_ingreso.tp_cupon.dw_datos_credito_oferta.Retrieve(as_serie, al_numero,gd_uf)
	if il_ncred>0 then
		id_valor_cuota 			= Round(tab_ingreso.tp_cupon.dw_datos_credito_oferta.GetItemNumber(1,"c_valor_cuota_cred_peso"), 0)
		ll_ctas					= tab_ingreso.tp_cupon.dw_datos_credito_oferta.getitemnumber(1,'repacta_mantencion_cuotas_pactadas')
		ll_ctas_pagadas		= tab_ingreso.tp_cupon.dw_datos_credito_oferta.getitemnumber(1,'repacta_mantencion_ctas_pagadas')
		ll_ctas_pag				= ll_ctas_pagadas		
		ldt_fecha_prim			= tab_ingreso.tp_cupon.dw_datos_credito_oferta.GetItemdatetime(1,'repacta_mantencion_fecha_primera_cta')
		ii_dmora 				= tab_ingreso.tp_cupon.dw_datos_credito_oferta.GetItemNumber(1,"c_dias_mora")
		ll_ctas_mora			= tab_ingreso.tp_cupon.dw_datos_credito_oferta.GetItemNumber(1,'c_cuotas_mora')		
		ll_estado_carta			= tab_ingreso.tp_cupon.dw_datos_credito_oferta.GetItemNumber(1,'cadena_estado_carta')
		gl_cod_parque			= tab_ingreso.tp_cupon.dw_datos_credito_oferta.GetItemNumber(1,'cadena_cod_parque')
	end if
else
	messagebox("Advertencia","Recuerde Ingresar BASE, SERIE y NUMERO")
	tab_ingreso.tp_cupon.sle_n_contrato.text	= ''
	tab_ingreso.tp_cupon.st_10.text				= ''
	tab_ingreso.tp_cupon.sle_n_contrato.setfocus()
	Return
END IF
ld_fecha_prox_pago			= date(DATEtime(funcion_venc( ldt_fecha_prim , ll_ctas_pag )))
if il_ncred > 0 then
	if ll_estado_carta=1 or ll_estado_carta=2 or ll_estado_carta=4 or ll_estado_carta=6 or &
		ll_estado_carta=8 then
		st_aviso_ap.visible		= true
	end if
end if
IF il_nenc > 0 THEN 
	ls_fono_p					= dw_encabezado_ingreso_cupon.GetitemString(1, "cliente_fono_p")
	if len(ls_fono_p) <= 5 then
		st_aviso_ap.visible		= true
	end if
end if
ll_tot_reg						= tab_ingreso.tp_cupon.dw_detalle_pago_cupon.retrieve(as_base,as_serie,al_numero)
if ll_tot_reg=0 then
	tab_ingreso.tp_cupon.st_sin_cuponera.visible	= true
else
	tab_ingreso.tp_cupon.dw_abono_cupon.retrieve(as_base,as_serie,al_numero)
	tab_ingreso.tp_cupon.st_sin_cuponera.visible	= false
	ll_fila_cred 					= tab_ingreso.tp_cupon.dw_detalle_pago_cupon.Find("cuponeras_detalle_tipo_mov = 'E'", 1, ll_tot_reg)
	if ll_fila_cred > 0 then
		ll_cta_cred				= tab_ingreso.tp_cupon.dw_detalle_pago_cupon.getitemnumber(ll_fila_cred,'cuponeras_detalle_nro_cuota')
	end if
	ll_fila 							= tab_ingreso.tp_cupon.dw_detalle_pago_cupon.Find("cuponeras_detalle_tipo_mov = 'E'", 1, ll_tot_reg)
	if ll_fila > 0 then
		dw_dias_mora.reset()
//		ld_fecha_prox_pago	= date(tab_ingreso.tp_cupon.dw_detalle_pago_cupon.getitemdatetime(ll_fila,'cuponeras_detalle_fecha_venc'))
		ll_dia_prox_pago		= day(ld_fecha_prox_pago)
		ld_fecha_inicial			= ld_fecha_prox_pago
		ll_day						= day(ld_fecha_inicial)
		ll_month					= month(ld_fecha_inicial)
		ll_year					= year(ld_fecha_inicial)
		if (ll_month=1 and ll_day>=31) or (ll_month=2 and ll_day>=28) or (ll_month=3 and ll_day>=31) or &
			(ll_month=4 and ll_day>=30) or (ll_month=5 and ll_day>=31) or (ll_month=6 and ll_day>=30) or &
			(ll_month=7 and ll_day>=31) or (ll_month=8 and ll_day>=31) or (ll_month=9 and ll_day>=30) or &
			(ll_month=10 and ll_day>=31) or (ll_month=11 and ll_day>=30) or (ll_month=12 and ll_day>=31) then
			ls_pasa				= 'S'
		else
			ls_pasa				= 'N'
		end if
		ll_max					= 1000
		FOR i = 1 TO ll_max
			ll_new				= dw_dias_mora.insertrow(0)
			dw_dias_mora.scrolltorow(ll_new)
			ll_day					= ll_dia_prox_pago
			ll_month				= month(ld_fecha_inicial)
			ll_year				= year(ld_fecha_inicial)
			ll_month	++
			if (ll_month=1 and ll_dia_prox_pago>31) then
				ls_pasa			= 'S'
				ll_day				= 31
			elseif (ll_month=2 and ll_dia_prox_pago>28) then
				ls_pasa			= 'S'
				ll_day				= 28
			elseif (ll_month=3 and ll_dia_prox_pago>31) then
				ls_pasa			= 'S'
				ll_day				= 31
			elseif (ll_month=4 and ll_dia_prox_pago>30) then
				ls_pasa			= 'S'
				ll_day				= 30
			elseif (ll_month=5 and ll_dia_prox_pago>31) then
				ls_pasa			= 'S'
				ll_day				= 31
			elseif (ll_month=6 and ll_dia_prox_pago>30) then
				ls_pasa			= 'S'
				ll_day				= 30
			elseif (ll_month=7 and ll_dia_prox_pago>31) then
				ls_pasa			= 'S'
				ll_day				= 31
			elseif (ll_month=8 and ll_dia_prox_pago>31) then
				ls_pasa			= 'S'
				ll_day				= 31
			elseif (ll_month=9 and ll_dia_prox_pago>30) then
				ls_pasa			= 'S'
				ll_day				= 30
			elseif (ll_month=10 and ll_dia_prox_pago>31) then
				ls_pasa			= 'S'
				ll_day				= 31
			elseif (ll_month=11 and ll_dia_prox_pago>30) then
				ls_pasa			= 'S'
				ll_day				= 30
			elseif (ll_month=12 and ll_dia_prox_pago>31) then
				ls_pasa			= 'S'
				ll_day				= 31
			end if
			if ll_month>12 then
				ll_year ++
				ll_month			= 1
				if (ll_month=1 and ls_pasa='S') then
					ls_pasa		= 'S'
					ll_day			= 31
				end if
			end if
			ls_fecha						= string(ll_day,'00')+'/'+string(ll_month,'00')+'/'+string(ll_year,'0000')
			ld_fecha_prox_venc		= date(ls_fecha)
			dw_dias_mora.setitem(ll_new,'fecha_inicial',ld_fecha_inicial)
			if ld_fecha_prox_venc > ld_fecha_hoy then 
				ld_fecha_prox_venc	= ld_fecha_hoy
			end if
			dw_dias_mora.setitem(ll_new,'fecha_venc',ld_fecha_prox_venc)
			if ld_fecha_prox_venc < ld_fecha_hoy then
				ll_dias_dif				= 0
				ll_count_filas			= dw_dias_mora.rowcount()
				if (ll_count_filas / ll_cant_cred ) = int(ll_count_filas / ll_cant_cred )  then
					ll_dias_dif			= DaysAfter(ld_fecha_inicial, ld_fecha_prox_venc)
				end if
				if ll_dias_dif<=0 then ll_dias_dif=0
				dw_dias_mora.setitem(ll_new,'dias_mora',ll_dias_dif)
				ld_fecha_inicial			= ld_fecha_prox_venc
			else
				ll_dias_dif				= 0
				ll_count_filas			= dw_dias_mora.rowcount()
				if ( ll_count_filas / ll_cant_cred ) = int(ll_count_filas / ll_cant_cred ) then
					ll_dias_dif			= DaysAfter(ld_fecha_inicial, ld_fecha_hoy) //ld_fecha_prox_venc)
				end if
				if ll_dias_dif<=0 then ll_dias_dif=0
				dw_dias_mora.setitem(ll_new,'dias_mora',ll_dias_dif)
				ld_fecha_inicial			= ld_fecha_prox_venc
				ll_suma_dias			= ll_suma_dias + ll_dias_dif
				exit
			end if
			ll_suma_dias				= ll_suma_dias + ll_dias_dif
		NEXT
		dw_dias_mora.sort()
		ll_tot_fila							= dw_dias_mora.rowcount()
		for ll_reg=1 to ll_tot_fila
			ll_suma_dias				= ll_suma_dias - ll_dias_mora
			dw_dias_mora.setitem(ll_reg,'suma_dias',ll_suma_dias)
			ll_dias_mora				= dw_dias_mora.getitemnumber(ll_reg,'dias_mora')
		next
		dw_dias_mora.accepttext()

		ll_fila_cred 					= tab_ingreso.tp_cupon.dw_detalle_pago_cupon.Find("cuponeras_detalle_tipo_mov = 'E'", 1, ll_tot_reg)
		if ll_fila_cred > 0 then
			ll_cta_cred				= tab_ingreso.tp_cupon.dw_detalle_pago_cupon.getitemnumber(ll_fila_cred,'cuponeras_detalle_nro_cuota')
		end if
		ll_fila 							= tab_ingreso.tp_cupon.dw_detalle_pago_cupon.Find("cuponeras_detalle_tipo_mov = 'E'", 1, ll_tot_reg)
		for ll_reg=1 to ll_tot_fila
			ll_fila_cred 				= tab_ingreso.tp_cupon.dw_detalle_pago_cupon.Find("cuponeras_detalle_tipo_mov = 'E' and cuponeras_detalle_nro_cuota="+string(ll_cta_cred), 1, ll_tot_reg)
			if ll_fila_cred > 0 then
				tab_ingreso.tp_cupon.dw_detalle_pago_cupon.SetItem(ll_fila_cred, "cuponeras_detalle_monto_cuota_peso", id_valor_cuota)
				ll_cta_cred ++
			end if
		next

		ii_dmora							= 0
		ii_mora_cobro					= 0
		id_im								= 0
		id_gc								= 0
		ll_fila_cred 						= tab_ingreso.tp_cupon.dw_detalle_pago_cupon.Find("cuponeras_detalle_tipo_mov = 'E'", 1, ll_tot_reg)
		if ll_fila_cred > 0 then
			ll_cta_cred					= tab_ingreso.tp_cupon.dw_detalle_pago_cupon.getitemnumber(ll_fila_cred,'cuponeras_detalle_nro_cuota')
		end if
		FOR i = 1 TO ll_ctas_mora		//ii_cantidad
			if ll_tot_fila > 0 and i <= ll_cuota then //ll_ctas_mora
				ii_dmora					= dw_dias_mora.GetItemNumber(i, "suma_dias")
				ll_dias_mora			= dw_dias_mora.GetItemNumber(i, "dias_mora")
				IF (ii_dmora > 5 AND tab_ingreso.tp_ci.cbx_sin_mora_ci.Checked = False) THEN
					ii_mora_cobro   	= ii_dmora
					ll_valor_int			= gf_int_mora(w_ingreso2.tab_ingreso.tp_cupon.dw_datos_credito_oferta.GetItemNumber(1,"c_tasa"), ii_mora_cobro, id_valor_cuota)
					id_im 					= ll_valor_int		//id_im + 
					IF (ii_dmora > ll_dias_mora AND tab_ingreso.tp_cupon.cbx_sin_gastos.Checked = False) THEN    
						id_gc     			= Round(id_valor_cuota * id_factor_gc, 0)
//						ll_suma_acum_gc	= ll_suma_acum_gc + id_gc
					END IF
				END IF  
			end if
			ll_fila_cred 					= tab_ingreso.tp_cupon.dw_detalle_pago_cupon.Find("cuponeras_detalle_tipo_mov = 'E' and cuponeras_detalle_nro_cuota="+string(ll_cta_cred), 1, ll_tot_reg)
			if ll_fila_cred > 0 then
				tab_ingreso.tp_cupon.dw_detalle_pago_cupon.SetItem(ll_fila_cred, "cuponeras_detalle_monto_gasto_cobranza", id_gc)
				tab_ingreso.tp_cupon.dw_detalle_pago_cupon.SetItem(ll_fila_cred, "cuponeras_detalle_monto_interes_mora", id_im)
				ll_cta_cred ++
			end if
		NEXT

	end if 
	for ll_indi=1 to ll_tot_reg
		if tab_ingreso.tp_cupon.dw_detalle_pago_cupon.getitemstring(ll_indi,'cuponeras_detalle_tipo_mov')='E' then
			tab_ingreso.tp_cupon.dw_detalle_pago_cupon.setitem(ll_indi,'cuponeras_detalle_monto_cuota_peso',id_valor_cuota)
			tab_ingreso.tp_cupon.dw_detalle_pago_cupon.SetItem(ll_indi, 'cuponeras_detalle_monto_otros_cobros', ldb_suma_seguro)
		else
			if as_base='O' or as_base='U' or as_base='M' then
				tab_ingreso.tp_cupon.dw_detalle_pago_cupon.setitem(ll_indi,'cuponeras_detalle_monto_cuota_peso',id_valor_cuota_mant)
			elseif as_base='C' then
				tab_ingreso.tp_cupon.dw_detalle_pago_cupon.setitem(ll_indi,'cuponeras_detalle_monto_cuota_peso',id_valor_cuota)
			end if
		end if
		tab_ingreso.tp_cupon.dw_detalle_pago_cupon.setitem(ll_indi,'estado_reg',1)
		tab_ingreso.tp_cupon.dw_detalle_pago_cupon.setitem(ll_indi,'reg_pago','S')
	next
	if ll_ctas_mora_mant > 0 then
		ll_fila_inicial					= 1
		ii_dmora						= 0
		ii_dmora 					= tab_ingreso.tp_cupon.dw_datos_credito_oferta.GetItemNumber(1,"c_dias_mora_mant")
		ll_dias_mora_mant		= ii_dmora
		for ll_indi=1 to ll_ctas_mora_mant
			SELECT "TASA"."GASTO_COB_MORA" INTO :id_interes_gc FROM "TASA" WHERE "TASA"."LOOK" = 1 ;
			if as_base='O' or as_base='U' or as_base='M' then
				ll_valor_cta_mant	= id_valor_cuota_mant
			elseif as_base='C' then
				ll_valor_cta_mant	= id_valor_cuota
			end if
			ii_mora_cobro			= 0
			id_im						= 0
			id_gc						= 0
			
			IF (ll_dias_mora_mant > 5  AND tab_ingreso.tp_cupon.cbx_sin_mora.Checked=False) THEN 
				ii_mora_cobro		= ll_dias_mora_mant
				id_im 					= id_im + gf_int_mora(id_tasa_mant, ii_mora_cobro, ll_valor_cta_mant)
				IF ll_dias_mora_mant > 30 AND tab_ingreso.tp_cupon.cbx_sin_gastos.Checked=False THEN 
					 id_gc 			= id_gc + Round(ll_valor_cta_mant * id_interes_gc, 0) //005// CAMBIO DE 10 A 5%
				END IF
				ll_dias_mora_mant	= ll_dias_mora_mant - (ll_cant_mant * 30)
			else
				ii_mora_cobro 		= 0
				id_im 					= 0
				id_gc 					= 0
			END IF
			ll_fila_mant 				= tab_ingreso.tp_cupon.dw_detalle_pago_cupon.Find("cuponeras_detalle_tipo_mov = 'F'", ll_fila_inicial, ll_tot_reg)
			if ll_fila_mant > 0 then
				tab_ingreso.tp_cupon.dw_detalle_pago_cupon.SetItem(ll_fila_mant, "cuponeras_detalle_monto_gasto_cobranza", id_gc)
				tab_ingreso.tp_cupon.dw_detalle_pago_cupon.SetItem(ll_fila_mant, "cuponeras_detalle_monto_interes_mora", id_im)
				ll_fila_inicial			= ll_fila_mant + 1
			end if
		next
	end if
end if
if dw_encabezado_ingreso_cupon.rowcount()>0 then
	ls_estado						= dw_encabezado_ingreso_cupon.getitemstring(1,'cadena_estado')
end if
if ls_estado<>'V' and ls_estado<>'C' then
	messagebox("Advertencia","No es Posible Ingresar Cupón, Contrato debe estar VIGENTE o CANCELADO")
	gs_base 							= as_base
	gs_serie 							= as_serie
	gi_numero 						= al_numero
	tab_ingreso.tp_cupon.cb_limpiar_cupon.triggerevent(clicked!)
else
	IF gf_permitir_ingreso(as_base, as_serie, al_numero) THEN
		open(w_advertencia)
		tab_ingreso.tp_cupon.sle_n_contrato.SetFocus()
		tab_ingreso.tp_cupon.dw_detalle_pago_cupon.Enabled 	= false
		tab_ingreso.tp_cupon.cb_forma_pago.Enabled 				= false
		tab_ingreso.tp_cupon.dw_detalle_pago_cupon.Reset()
		dw_encabezado_ingreso_cupon.Reset()
		tab_ingreso.tp_cupon.dw_datos_credito_oferta.Reset()
		tab_ingreso.tp_cupon.sle_n_contrato.text					= ''
		tab_ingreso.tp_cupon.st_10.text								= ''
		gs_base 						= "" 
		gs_serie 						= "" 
		gi_numero 					= 0
//		RETURN 0
	END IF
	IF il_nenc > 0 THEN 
		gi_rut 						= dw_encabezado_ingreso_cupon.GetItemNumber(1, "cliente_rut")
//	ELSE
//		gi_rut 						= 0
	END IF
	if gi_rut>0 then 
		if isvalid(w_aviso_mensajes) then close(w_aviso_mensajes)
		SELECT	COUNT("MENSAJES"."FECHA_CREACION")  
		INTO 		:ll_count  
		FROM 		"MENSAJES"  
		WHERE  ( "MENSAJES"."RUT" = :gi_rut ) and
				 ( "MENSAJES"."ESTADO_GESTION" = 'A' ) AND
				 ( "MENSAJES"."SW_MENSAJE" = 'R' ) and
				 ( "MENSAJES"."FECHA_FIN" > :gdt_fec_sistema )
		USING		sqlca;
		if ll_count>0 then
			OpenWithParm(w_aviso_mensajes, "R")
		else
			SELECT	COUNT("MENSAJES"."FECHA_CREACION")  
			INTO 		:ll_count  
			FROM 		"MENSAJES"  
			WHERE  ( "MENSAJES"."BASE" = :gs_base ) and
					 ( "MENSAJES"."SERIE" = :gs_serie ) and
					 ( "MENSAJES"."NUMERO" = :gi_numero ) and
					 ( "MENSAJES"."ESTADO_GESTION" = 'A' ) AND
					 ( "MENSAJES"."SW_MENSAJE" = 'C' ) and
					 ( "MENSAJES"."FECHA_FIN" > :gdt_fec_sistema )
			USING		sqlca;
			if ll_count>0 then
				OpenWithParm(w_aviso_mensajes, "C")
			end if
		end if
	end if
	If gi_rut = 0 or isnull(gi_rut) THEN
		tab_ingreso.tp_cupon.sle_n_contrato.SetFocus()
		tab_ingreso.tp_cupon.cbx_sin_gastos.Enabled 				= false
		tab_ingreso.tp_cupon.cbx_sin_mora.Enabled 				= false
		tab_ingreso.tp_cupon.dw_detalle_pago_cupon.Enabled	= false
		tab_ingreso.tp_cupon.cb_forma_pago.Enabled 				= false
		tab_ingreso.tp_cupon.dw_detalle_pago_cupon.Reset()
		dw_encabezado_ingreso_cupon.Reset()
		tab_ingreso.tp_cupon.dw_datos_credito_oferta.Reset()
		gs_base 																= "" 
		gs_serie 																= "" 
		gi_numero 															= 0
		MessageBox("Error", "No se encuentra la información")
		tab_ingreso.tp_cupon.st_10.text								= ''
		tab_ingreso.tp_cupon.sle_n_contrato.text					= ''
		tab_ingreso.tp_cupon.sle_n_contrato.setfocus()
//		RETURN 0
	END IF
	IF il_ncred > 0 AND il_nenc > 0 THEN
		tab_ingreso.tp_cupon.cbx_sin_gastos.Enabled 				= true
		tab_ingreso.tp_cupon.cbx_sin_mora.Enabled 				= true
		tab_ingreso.tp_cupon.dw_detalle_pago_cupon.Enabled	= true
//			cb_forma_pago.Enabled 			= true
//			dw_detalle_pago_cupon.Reset()
		tab_ingreso.tp_cupon.dw_detalle_pago_cupon.SetFocus()
		gs_base 								= as_base
		gs_serie 								= as_serie
		gi_numero 							= al_numero
		ls_string								= string(gi_rut)+'~t'+gs_base+'~t'+gs_serie+'~t'+string(gi_numero)+'~t'+string(ld_fecha_hoy,'dd/mm/yyyy')
//		openwithparm(w_modificar_telefonos_cliente,ls_string)
	ELSE
		MessageBox("Ingreso de Cupón", "No se encontró información asociada a ese número de documento")
		tab_ingreso.tp_cupon.sle_n_contrato.SetFocus()
		tab_ingreso.tp_cupon.cbx_sin_gastos.Enabled 				= false
		tab_ingreso.tp_cupon.cbx_sin_mora.Enabled 				= false
		tab_ingreso.tp_cupon.dw_detalle_pago_cupon.Enabled	= false
		tab_ingreso.tp_cupon.cb_forma_pago.Enabled 				= false
//			dw_detalle_pago_cupon.Reset()
		dw_encabezado_ingreso_cupon.Reset()
		gs_base 																= "" 
		gs_serie 																= "" 
		gi_numero 															= 0
		gi_rut																	= 0
		tab_ingreso.tp_cupon.sle_n_contrato.text					= ''
		tab_ingreso.tp_cupon.sle_n_contrato.setfocus()
	END IF	
end if
tab_ingreso.tp_cupon.dw_detalle_pago_cupon.accepttext()
end subroutine

public subroutine wf_validar_descuento ();is_pasa_descto		= f_validar_descuentos()

end subroutine

public subroutine wf_no_mostrar_help_be ();tab_ingreso.tp_be.st_31.visible							= false
tab_ingreso.tp_be.st_help_insertar_be.visible		= false
tab_ingreso.tp_be.st_help_eliminar_be.visible		= false
tab_ingreso.tp_be.st_help_descuento_be.visible	= false
tab_ingreso.tp_be.st_help_ficha_be.visible			= false
end subroutine

public subroutine wf_setear_movk (long al_row);IF gs_rezago <> "S" THEN
	if gs_base= 'O' or gs_base='U' or gs_base='M' then
		tab_ingreso.tp_be.dw_detalle_be.SetItem(al_row, "cantidad", tab_ingreso.tp_be.dw_datos_be.GetItemNumber(1,"pago_oferta_nro_cuotas") - tab_ingreso.tp_be.dw_datos_be.GetItemNumber(1,"oferta_v_cta_pag_s"))
	elseif gs_base= 'L' then
		tab_ingreso.tp_be.dw_detalle_be.SetItem(al_row, "cantidad", tab_ingreso.tp_be.dw_datos_be.GetItemNumber(1,"pago_liberador_nro_cuotas") - tab_ingreso.tp_be.dw_datos_be.GetItemNumber(1,"anexo_liberador_cta_pag_m"))
	elseif gs_base= 'F' or gs_base='G' or gs_base='V' then
		tab_ingreso.tp_be.dw_detalle_be.SetItem(al_row, "cantidad", tab_ingreso.tp_be.dw_datos_be.GetItemNumber(1,"producto_pago_plazo") - tab_ingreso.tp_be.dw_datos_be.GetItemNumber(1,"producto_anexo_cuotas_pag"))
	elseif gs_base= 'P' then
		tab_ingreso.tp_be.dw_detalle_be.SetItem(al_row, "cantidad", tab_ingreso.tp_be.dw_datos_be.GetItemNumber(1,"pagare_plazo") - tab_ingreso.tp_be.dw_datos_be.GetItemNumber(1,"c_cuotas_pagadas"))
	elseif gs_base= 'D' then
		tab_ingreso.tp_be.dw_detalle_be.SetItem(al_row, "cantidad", tab_ingreso.tp_be.dw_datos_be.GetItemNumber(1,"derecho_plazo") - tab_ingreso.tp_be.dw_datos_be.GetItemNumber(1,"c_cuotas_pagadas"))
	elseif gs_base= 'A' then
		tab_ingreso.tp_be.dw_detalle_be.SetItem(al_row, "cantidad", tab_ingreso.tp_be.dw_datos_be.GetItemNumber(1,"pago_aumento_nro_cuotas") - tab_ingreso.tp_be.dw_datos_be.GetItemNumber(1,"anexo_aumento_cta_pag_m"))
	end if
	tab_ingreso.tp_be.dw_detalle_be.SetItem(al_row, "monto", tab_ingreso.tp_be.dw_datos_be.GetItemNumber(1,"c_valor_cuota_pesos"))
	if isnull(w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.getitemnumber(1,'gastos_cob')) then
		w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1,'gastos_cob', 0)
		
		w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1,'gasto_cred', 0)
		w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1,'gasto_mant', 0)
	end if
	if isnull(w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.getitemnumber(1,'mora')) then
		w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1,'mora', 0)
		
		w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1,'mora_cred', 0)
		w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1,'mora_mant', 0)
	end if
	if isnull(w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.getitemnumber(1,'incluir_gastos')) then
		w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1,'incluir_gastos', 1)
	end if
	tab_ingreso.tp_be.dw_gastos_be.SetItem(1, "Subtotal",tab_ingreso.tp_be.dw_detalle_be.GetItemNumber(1,"c_subtotal"))
	tab_ingreso.tp_be.dw_gastos_be.accepttext()
else
	messagebox("Advertencia","No es Posible Ingresar Seguro de Desgravamen en Rezago")
end if
end subroutine

public subroutine wf_validar_abono (integer al_row);String			ls_tipo_cob
Long			ll_folio,ll_monto_mant,ll_monto_cta,ll_sum_monto_abono,ll_monto_mora_mant,ll_monto_final_mant,ll_res_abono
datetime		ldt_fecha_hoy

ll_folio									= long(tab_ingreso.tp_be.sle_numero_be.text)
ldt_fecha_hoy							= datetime(date(gdt_fec_sistema),time('00:00:00'))
ls_tipo_cob								= tab_ingreso.tp_be.dw_detalle_be.getitemstring(al_row,'tipo_cob')
if gs_base='O' or gs_base='C' or gs_base='U' or gs_base='M' then
	if tab_ingreso.tp_be.dw_detalle_be.getitemnumber(al_row,'cantidad') <= 1 or isnull(tab_ingreso.tp_be.dw_detalle_be.getitemnumber(al_row,'cantidad')) then tab_ingreso.tp_be.dw_detalle_be.SetItem(al_row, "cantidad", 1)
	IF gs_rezago <> "S" THEN
		ll_monto_mant					= round(tab_ingreso.tp_be.dw_datos_be.GetItemNumber(1,"c_valor_cuota_mantencion_pesos"),0)
		ll_monto_cta					= ll_monto_mant * tab_ingreso.tp_be.dw_detalle_be.getitemnumber(al_row,'cantidad')
		SELECT	SUM("ABONO_CTA_CTE"."MONTO")  
		INTO 		:ll_sum_monto_abono  
		FROM 	"ABONO_CTA_CTE"  
		WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
				 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
				 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND
				 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )
		USING		sqlca;
		if ll_sum_monto_abono > 0 then
			ll_monto_mant				= ll_monto_mant - tab_ingreso.tp_be.dw_detalle_be.getitemnumber(al_row,'cantidad')
			ll_monto_mora_mant		= wf_calcular_mora_mant(al_row)
			if ll_sum_monto_abono >= (ll_monto_cta + ll_monto_mora_mant)  then
				ll_monto_final_mant	= round(ll_sum_monto_abono - ( ll_monto_cta + ll_monto_mora_mant ) ,0)
				ll_res_abono			= messagebox("Advertencia Abono","En su Cuenta Corriente Existe Abonado $ "+string(ll_sum_monto_abono,'###,###,###,###,##0')+", se descontará por Concepto Mantención $ "+string((ll_monto_cta + ll_monto_mora_mant) - 1,'###,###,###,###,##0')+", quedando a su Favor $ "+string(ll_monto_final_mant,'###,###,###,###,##0')+"... desea utilizar Abono Existente",Exclamation!,YesNo!,2)
				if ll_res_abono=1 then
					tab_ingreso.tp_be.dw_detalle_be.SetItem(al_row, "monto", ll_monto_mant)
					ll_monto_final_mant ++
					UPDATE	"ABONO_CTA_CTE"  
					SET 		"TIPO_COB_OCUPA" = :gs_tipo_cobro,   
								"FOLIO_OCUPA" = :ll_folio,   
								"FECHA_OCUPA" = :ldt_fecha_hoy,   
								"MONTO_OCUPA" = (:ll_monto_cta + :ll_monto_mora_mant) - 1,   
								"USUARIO_OCUPA" = :gs_user,   
								"CAJA_OCUPA" = :gs_caja,   
								"ESTADO_REG" = 'O',
								"TIPO_MOV_OCUPA" = 'F',
								"SW_ESTADO_TRANS" = 1
					WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
							 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
							 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
							 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
					USING		sqlca;
					if sqlca.sqlcode=0 then
						commit;
						INSERT INTO "ABONO_CTA_CTE"  
									( "RUT",		"BASE",		"SERIE",		"NUMERO",	"TIPO_COB",	"FOLIO",	"MONTO",				"FECHA_CREA",	"USUARIO_CREA",	"CAJA_CREA",	"ESTADO_REG",	"TIPO_COB_OCUPA",	"FOLIO_OCUPA",	"FECHA_OCUPA",	"MONTO_OCUPA",	"USUARIO_OCUPA",	"CAJA_OCUPA",	"TIPO_MOV_OCUPA",		"SW_ESTADO_TRANS" )
						VALUES 	( :gi_rut,	:gs_base,	:gs_serie,	:gi_numero,	:gs_tipo_cobro,		:ll_folio,	:ll_monto_final_mant,	:gdt_fec_sistema,	:gs_user,			:gs_caja,			'P',						null,						null,					null,					null,					null,						null,					null,							2 )  
						USING		sqlca;
						if sqlca.sqlcode=0 then
							commit;
						else
							rollback;
							messagebox("Error Grabar","Error al INSERTAR ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
						end if
					else
						rollback;
						messagebox("Error Grabar","Error al UPDATE ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
					end if
				else
					ll_monto_final_mant		= ll_monto_mant
					tab_ingreso.tp_be.dw_detalle_be.SetItem(al_row, "monto", ll_monto_mant)
				end if
			else
				ll_res_abono				= messagebox("Advertencia Abono","En su Cuenta Corriente Existe Abonado $ "+string(ll_sum_monto_abono,'###,###,###,###,##0')+", Monto a Cancelar es $ "+string(ll_monto_cta + ll_monto_mora_mant,'###,###,###,###,##0')+" y su Saldo quedará en 0"+"... desea utilizar por Concepto de Mantención Abono Existente",Exclamation!,YesNo!,2)
				if ll_res_abono = 1 then
					tab_ingreso.tp_be.dw_detalle_be.SetItem(al_row, "monto", ll_monto_mant )
					UPDATE	"ABONO_CTA_CTE"  
					SET 		"TIPO_COB_OCUPA" = :gs_tipo_cobro,   
								"FOLIO_OCUPA" = :ll_folio,   
								"FECHA_OCUPA" = :ldt_fecha_hoy,   
								"MONTO_OCUPA" = :ll_sum_monto_abono,   
								"USUARIO_OCUPA" = :gs_user,   
								"CAJA_OCUPA" = :gs_caja,   
								"ESTADO_REG" = 'O',
								"TIPO_MOV_OCUPA" = 'F',
								"SW_ESTADO_TRANS" = 1
					WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
							 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
							 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
							 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
					USING		sqlca;
					if sqlca.sqlcode=0 then
						commit;
					else
						rollback;
						messagebox("Error Grabar","Error al Update ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
					end if
				else
					ll_monto_final_mant		= ll_monto_mant
					tab_ingreso.tp_be.dw_detalle_be.SetItem(al_row, "monto", ll_monto_mant)
				end if
			end if
		else
			ll_monto_final_mant		= ll_monto_mant
			tab_ingreso.tp_be.dw_detalle_be.SetItem(al_row, "monto", ll_monto_mant)
		end if
		
		wf_calcular_interes(ls_tipo_cob)
	ELSE 
		tab_ingreso.tp_be.dw_detalle_be.SetItem(al_row, "monto", 0)
	END IF
else
	messagebox("Advertencia","No es posible Ingresar F-Cuota Mantención, para este tipo de Contrato (Solo O-Promesas y C-Contrato)")
	tab_ingreso.tp_be.dw_detalle_be.SetItem(al_row, "monto", 0)
	tab_ingreso.tp_be.dw_detalle_be.SetItem(al_row, "cantidad", 0)
	tab_ingreso.tp_be.dw_detalle_be.setfocus()
	tab_ingreso.tp_be.dw_detalle_be.setcolumn('tipo_cob')
end if
end subroutine

public subroutine wf_cargar_monto_uf (double ald_monto, long ail_cantidad_malo, long al_row);Long		ll_fila_m,ll_fila_d,ll_new_m
Double	ll_iva_recalc
String		ls_moneda_insert

ald_monto		= tab_ingreso.tp_be.dw_detalle_be.getitemnumber(al_row,'monto_uf')
if ald_monto>800 or ald_monto < 0 then
	if isnull(ail_cantidad_malo) then	ail_cantidad_malo	= tab_ingreso.tp_be.dw_detalle_be.getitemnumber(al_row,'cantidad')
	messagebox("Advertencia","Revisar Monto Ingresado, recuerde tiene Seleccionado Opción Ingreso MONTO en U.F. y Mayor a CERO")
	tab_ingreso.tp_be.dw_detalle_be.SetItem(al_row, "monto", 0)
	tab_ingreso.tp_be.dw_detalle_be.SetItem(al_row, "cantidad", 0)
else
	if gs_tipo_cobro = 'BA' or gs_tipo_cobro = 'FA' then
		if ail_cantidad_malo>0 then tab_ingreso.tp_be.dw_detalle_be.setitem(al_row,'cantidad',ail_cantidad_malo)
		ll_fila_m				= tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob='M'", 1, tab_ingreso.tp_be.dw_detalle_be.rowcount())
		if ll_fila_m > 0 then
			ll_fila_d			= tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob='D'", 1, tab_ingreso.tp_be.dw_detalle_be.rowcount())
			if ll_fila_d > 0 then
				ll_iva_recalc		= round(ald_monto * (idb_iva - 1),4)
//				ll_iva_recalc		= ald_monto - round(ald_monto * (idb_iva - 1),2)
				tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila_d,'monto_uf',ll_iva_recalc)
				tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila_d,'monto', round( ll_iva_recalc * gd_uf,4))
			else
				ll_new_m		= tab_ingreso.tp_be.dw_detalle_be.insertrow(0)
				ll_iva_recalc		= round(ald_monto * (idb_iva - 1),4)
				tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_m,'tipo_cob', 'D')
				tab_ingreso.tp_be.dw_detalle_be.SetItem(ll_new_m, "iva", idb_iva)
				tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_m,'cantidad', 1)
				ls_moneda_insert	= '2'
				if ls_moneda_insert = '2' then
					tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_m,'monto', round( ll_iva_recalc * gd_uf,4))
					tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_m,'monto_uf', ll_iva_recalc)
				end if
				tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_m,'uf',gd_uf)
				tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_m,'estado','S')
				tab_ingreso.tp_be.dw_detalle_be.SetItem(ll_new_m, "moneda",'U')
			end if
		end if
		
		ll_fila_m				= tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob='A' or tipo_cob='E' ", 1, tab_ingreso.tp_be.dw_detalle_be.rowcount())
		if ll_fila_m > 0 then
			ll_fila_d			= tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob='D'", 1, tab_ingreso.tp_be.dw_detalle_be.rowcount())
			if ll_fila_d > 0 then
				ll_iva_recalc		= round(ald_monto * (idb_iva - 1),4)
//				ll_iva_recalc		= ald_monto - round(ald_monto * (idb_iva - 1),2)
				tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila_d,'monto_uf',ll_iva_recalc)
				tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila_d,'monto', round( ll_iva_recalc * gd_uf,4))
			else
				ll_new_m		= tab_ingreso.tp_be.dw_detalle_be.insertrow(0)
				ll_iva_recalc		= round(ald_monto * (idb_iva - 1),4)
				tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_m,'tipo_cob', 'D')
				tab_ingreso.tp_be.dw_detalle_be.SetItem(ll_new_m, "iva", idb_iva)
				tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_m,'cantidad', 1)
				ls_moneda_insert	= '2'
				if ls_moneda_insert = '2' then
					tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_m,'monto', round( ll_iva_recalc * gd_uf,4))
					tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_m,'monto_uf', ll_iva_recalc)
				end if
				tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_m,'uf',gd_uf)
				tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_m,'estado','S')
				tab_ingreso.tp_be.dw_detalle_be.SetItem(ll_new_m, "moneda",'U')
			end if
		end if
		
	end if
end if
end subroutine

public subroutine wf_crear_cupones_mantencion (long al_cantidad);Long		ll_count,ll_mora_mant,ll_estado_mora_mant,ll_ctas_pag_m,ll_cod_parque,ll_plazo,ll_cantidad,ll_res,ll_indi,ll_cant_meses,ll_nro_cuota,ll_cuponera,ll_ctas_pag_s,&
			ll_contar_cup_vig,ll_res2,ll_max_cuota
Double	ll_rut,ldb_valor_cuota_m,ll_cupon,ldb_valor_cuota_c
String		ls_estado_cuponera,ls_estado_ctto,ls_dv,ls_moneda,ls_paso='N'
date		ldt_fecha_venc_mant,ldt_fecha_prox,ldt_fecha_vencimiento,ldt_max_venc,ldt_fecha_prim,ldt_fecha_m

if gs_base='O' or gs_base='C' or gs_base='U' or gs_base='M' then
	ll_cantidad		= al_cantidad
	if ll_cantidad > 0 then
		SELECT 	"CUPONERAS"."ESTADO_CUPONERA" ,	"CUPONERAS"."NRO_CUPONERA"
		INTO 		:ls_estado_cuponera  ,						:ll_cuponera
		FROM 	"CUPONERAS"  
		WHERE 	( "CUPONERAS"."BASE" = :gs_base ) AND  
					( "CUPONERAS"."SERIE" = :gs_serie ) AND  
					( "CUPONERAS"."NUMERO" = :gi_numero ) AND
					( "CUPONERAS"."NRO_CUPONERA" =  (	SELECT 	MAX("CUPONERAS"."NRO_CUPONERA")
																		FROM 	"CUPONERAS"  
																		WHERE 	( "CUPONERAS"."BASE" = :gs_base ) AND  
																					( "CUPONERAS"."SERIE" = :gs_serie ) AND  
																					( "CUPONERAS"."NUMERO" = :gi_numero ) ) )
		USING	sqlca;
					
		SELECT 	count("CUPONERAS"."BASE")
		INTO 		:ll_count
		FROM 	"CUPONERAS"  
		WHERE 	( "CUPONERAS"."BASE" = :gs_base ) AND  
					( "CUPONERAS"."SERIE" = :gs_serie ) AND  
					( "CUPONERAS"."NUMERO" = :gi_numero )
		USING	sqlca;
		if isnull(ls_estado_cuponera) or ls_estado_cuponera='' then ll_count=0
		SELECT 	   "ESTADO_MORA_MANTENCION"."CANTIDAD_MESES",		"PAGO_OFERTA"."NRO_CUOTAS",	"PAGO_OFERTA"."MONEDA",	"CADENA"."COD_PARQUE",	"CADENA"."ESTADO",  	"CADENA"."RUT",   	"CLIENTE"."DV",   	"OFERTA_V"."VALOR_CUOTA_M",   	"CADENA_MORA"."MORA_MANT",   	"CADENA_MORA"."FECHA_VENC_MANT",   	"CADENA"."ESTADO_MORA_MANTENCION",   	"OFERTA_V"."CTA_PAG_M",   	"OFERTA_V"."CTA_PAG_S",		"PAGO_OFERTA"."VALOR_CUOTA" ,	"PAGO_OFERTA"."FECHA_PRIM",	"OFERTA_V"."FECHA_M"
		INTO 		  :ll_cant_meses,														:ll_plazo,									:ls_moneda,							:ll_cod_parque,					:ls_estado_ctto,   			:ll_rut,   					:ls_dv,   				:ldb_valor_cuota_m,   					:ll_mora_mant,   							:ldt_fecha_venc_mant,   							:ll_estado_mora_mant,   							:ll_ctas_pag_m  ,					:ll_ctas_pag_s,						:ldb_valor_cuota_c,						:ldt_fecha_prim,						:ldt_fecha_m
		FROM 	  "CADENA",   "OFERTA_V",   "PAGO_OFERTA",   "CLIENTE",   "CADENA_MORA" ,	"ESTADO_MORA_MANTENCION" 
		WHERE 	( "CADENA"."RUT" = "CLIENTE"."RUT" ) and  
					( "CADENA"."SERIE" = "OFERTA_V"."SERIE" ) and  
					( "CADENA"."NUMERO" = "OFERTA_V"."NRO_OFERTA" ) and  
					( "CADENA"."ESTADO_MORA_MANTENCION" = "ESTADO_MORA_MANTENCION"."ESTADO_MORA_MANTENCION" ) AND
					( "OFERTA_V"."SERIE" = "PAGO_OFERTA"."SERIE" ) and  
					( "OFERTA_V"."NRO_OFERTA" = "PAGO_OFERTA"."NRO_OFERTA" ) and  
					( "OFERTA_V"."ULT_FOLIO" = "PAGO_OFERTA"."FOLIO" ) and  
					( "CADENA"."CODIGO" = "CADENA_MORA"."BASE" ) and  
					( "CADENA"."SERIE" = "CADENA_MORA"."SERIE" ) and  
					( "CADENA"."NUMERO" = "CADENA_MORA"."NUMERO" ) and  
					( "CADENA"."CODIGO" = :gs_base ) AND  
					( "CADENA"."SERIE" = :gs_serie ) AND  
					( "CADENA"."NUMERO" = :gi_numero ) 
		UNION   
		SELECT 	  "ESTADO_MORA_MANTENCION"."CANTIDAD_MESES",		"CONTRATO"."PLAZO",	"CONTRATO"."MONEDA","CADENA"."COD_PARQUE",	"CADENA"."ESTADO",   	"CADENA"."RUT",   	"CLIENTE"."DV",   	"CONTRATO"."VALOR_CUOTA_M",   	"CADENA_MORA"."MORA_MANT",   	"CADENA_MORA"."FECHA_VENC_MANT",   	"CADENA"."ESTADO_MORA_MANTENCION",   	"CONTRATO"."CTA_PAG_M"  ,	0, 0, null, null
		FROM 	  "CADENA",   "CADENA_MORA",   "CLIENTE",   "CONTRATO",	"ESTADO_MORA_MANTENCION"
		WHERE 	( "CADENA"."SERIE" = "CONTRATO"."SERIE_C" ) and  
					( "CADENA"."NUMERO" = "CONTRATO"."NRO_CONTRATO" ) and  
					( "CADENA"."CODIGO" = "CADENA_MORA"."BASE" ) and  
					( "CADENA"."SERIE" = "CADENA_MORA"."SERIE" ) and  
					( "CADENA"."NUMERO" = "CADENA_MORA"."NUMERO" ) and  
					( "CADENA"."ESTADO_MORA_MANTENCION" = "ESTADO_MORA_MANTENCION"."ESTADO_MORA_MANTENCION" ) AND
					( "CADENA"."RUT" = "CLIENTE"."RUT" ) and  
					( "CADENA"."CODIGO" = :gs_base ) AND  
					( "CADENA"."SERIE" = :gs_serie ) AND  
					( "CADENA"."NUMERO" = :gi_numero )    ;
		if ls_estado_ctto='V' or ls_estado_ctto='C' then
			if ll_count >= 0 then
				ll_res 		= 1
//				if ll_cantidad > ( ll_mora_mant + 8 ) then
//					ll_res	= messagebox("Advertencia","Está Seguro de Crear "+string(ll_cantidad) +" Cupones de Mantención",Exclamation!,YesNo!,2)
//				else
//					ll_res	= messagebox("Advertencia","Está Seguro de Crear Cupones de Mantención",Exclamation!,YesNo!,2)
//				end if
			end if
			if ll_res = 1 then
				SELECT 	MAX("CUPONERAS_DETALLE"."NRO_CUPON")  
				INTO 		:ll_cupon  
				FROM 	"CUPONERAS_DETALLE"  ;
				ll_cupon ++
				if ll_count = 0 then
					ll_cuponera	= ll_count + 1
					INSERT INTO "CUPONERAS"  
									( "BASE",   	"SERIE",  	"NUMERO",   	"NRO_CUPONERA",   	"FECHA_CREA",   	"USUARIO_CREADOR",   	"CUPON_INICIAL",   	"CUPON_FINAL",   	"ESTADO_CUPONERA",   	"COD_PARQUE",   	"MONEDA_CTTO",   	"PLAZO",   	"CANT_PRINT",   	"ULT_FECHA_VENC_CRED_PRINT" )  
					VALUES 		( :gs_base,	:gs_serie,   :gi_numero,   	:ll_cuponera,   			:gdt_fec_sistema,	:gs_user,   					1,   						2,   					'V',   								:ll_cod_parque,   	:ls_moneda,   			:ll_plazo,   	0,   					null )  
					USING	sqlca;
					if sqlca.sqlcode=0 then
						commit;
						ls_paso		= 'S'
					else
						rollback;
					end if
					
				elseif ll_count = 1 then
					if (gs_base='O' or gs_base='U' or gs_base='M') and ll_ctas_pag_s < ll_plazo then
						SELECT 	Count("CUPONERAS_DETALLE"."BASE" ) 
						INTO 		:ll_contar_cup_vig  
						FROM 	"CUPONERAS_DETALLE"  
						WHERE ( "CUPONERAS_DETALLE"."BASE" = :gs_base ) AND  
								  ( "CUPONERAS_DETALLE"."SERIE" = :gs_serie ) AND  
								  ( "CUPONERAS_DETALLE"."NUMERO" = :gi_numero ) AND  
								  ( "CUPONERAS_DETALLE"."NRO_CUPONERA" = :ll_cuponera ) AND  
								  ( "CUPONERAS_DETALLE"."ESTADO_PAGO_CUPON" = 'V' )   ;
						if ll_contar_cup_vig = 0 then
//							messagebox("Advertencia","Contrato Tiene Saldo Cuota Crédito, debe tener Cuponera Vigente antes de Crear Cupones de Mantención")
							
							DECLARE sp_proc_genera_cuponera PROCEDURE FOR SP_GENERAR_CUPONERA( :gs_base, :gs_serie, :gi_numero, :ll_plazo, :gs_user, :ll_rut, :ldb_valor_cuota_c, :ldb_valor_cuota_m, :ls_dv, :ll_cod_parque, :ldt_fecha_prim, :ldt_fecha_m, :ls_moneda);
							EXECUTE sp_proc_genera_cuponera;
							if ls_estado_cuponera = 'A' then
								UPDATE	"CUPONERAS"  
								SET 		"ESTADO_CUPONERA" = 'R'  
								WHERE  ( "CUPONERAS"."BASE" = :gs_base ) AND  
										 ( "CUPONERAS"."SERIE" = :gs_serie ) AND  
										 ( "CUPONERAS"."NUMERO" = :gi_numero ) AND  
										 ( "CUPONERAS"."ESTADO_CUPONERA" = :ls_estado_cuponera ) AND  
										 ( "CUPONERAS"."NRO_CUPONERA" = :ll_cuponera )   
								USING		sqlca;
								if sqlca.sqlcode=0 then
									commit;
								else
									rollback;
								end if
								SELECT 	"CUPONERAS"."ESTADO_CUPONERA" ,	"CUPONERAS"."NRO_CUPONERA"
								INTO 		:ls_estado_cuponera  ,						:ll_cuponera
								FROM 	"CUPONERAS"  
								WHERE 	( "CUPONERAS"."BASE" = :gs_base ) AND  
											( "CUPONERAS"."SERIE" = :gs_serie ) AND  
											( "CUPONERAS"."NUMERO" = :gi_numero ) AND
											( "CUPONERAS"."NRO_CUPONERA" =  (	SELECT 	MAX("CUPONERAS"."NRO_CUPONERA")
																								FROM 	"CUPONERAS"  
																								WHERE 	( "CUPONERAS"."BASE" = :gs_base ) AND  
																											( "CUPONERAS"."SERIE" = :gs_serie ) AND  
																											( "CUPONERAS"."NUMERO" = :gi_numero ) ) )
								USING	sqlca;
											
								SELECT 	count("CUPONERAS"."BASE")
								INTO 		:ll_count
								FROM 	"CUPONERAS"  
								WHERE 	( "CUPONERAS"."BASE" = :gs_base ) AND  
											( "CUPONERAS"."SERIE" = :gs_serie ) AND  
											( "CUPONERAS"."NUMERO" = :gi_numero )
								USING	sqlca;
							end if
							ll_res2 = 1
						else
							ll_res2 = 1
						end if
					else
						ll_res2 	= 1
					end if
					
					if ll_res2 = 1 then
						if ls_estado_cuponera <> 'V' and ls_estado_cuponera <> 'C' then
							UPDATE 	"CUPONERAS"  
							SET 		"ESTADO_CUPONERA" = 'V'  
							WHERE ( "CUPONERAS"."BASE" = :gs_base ) AND  
									  ( "CUPONERAS"."SERIE" = :gs_serie ) AND  
									  ( "CUPONERAS"."NUMERO" = :gi_numero )  AND
									  ( "CUPONERAS"."NRO_CUPONERA" = :ll_cuponera )
							USING	sqlca;
							if sqlca.sqlcode=0 then
								commit;
							else
								rollback;
							end if
						end if
						
						ls_paso	= 'S'
					else
						ls_paso	= 'N'
					end if
				elseif ll_count > 1 then
					if (gs_base='O' or gs_base='U' or gs_base='M') and ll_ctas_pag_s < ll_plazo then
						SELECT 	Count("CUPONERAS_DETALLE"."BASE" ) 
						INTO 		:ll_contar_cup_vig  
						FROM 	"CUPONERAS_DETALLE"  
						WHERE ( "CUPONERAS_DETALLE"."BASE" = :gs_base ) AND  
								  ( "CUPONERAS_DETALLE"."SERIE" = :gs_serie ) AND  
								  ( "CUPONERAS_DETALLE"."NUMERO" = :gi_numero ) AND  
								  ( "CUPONERAS_DETALLE"."NRO_CUPONERA" = :ll_cuponera ) AND  
								  ( "CUPONERAS_DETALLE"."ESTADO_PAGO_CUPON" = 'V' )   ;
						if ll_contar_cup_vig = 0 then
//							messagebox("Advertencia","Contrato Tiene Saldo Cuota Crédito, debe tener Cuponera Vigente antes de Crear Cupones de Mantención")
							
							DECLARE sp_proc_genera_cup2 PROCEDURE FOR SP_GENERAR_CUPONERA( :gs_base, :gs_serie, :gi_numero, :ll_plazo, :gs_user, :ll_rut, :ldb_valor_cuota_c, :ldb_valor_cuota_m, :ls_dv, :ll_cod_parque, :ldt_fecha_prim, :ldt_fecha_m, :ls_moneda);
							EXECUTE sp_proc_genera_cup2;
							if ls_estado_cuponera = 'A' then
								UPDATE	"CUPONERAS"  
								SET 		"ESTADO_CUPONERA" = 'R'  
								WHERE  ( "CUPONERAS"."BASE" = :gs_base ) AND  
										 ( "CUPONERAS"."SERIE" = :gs_serie ) AND  
										 ( "CUPONERAS"."NUMERO" = :gi_numero ) AND  
										 ( "CUPONERAS"."ESTADO_CUPONERA" = :ls_estado_cuponera ) AND  
										 ( "CUPONERAS"."NRO_CUPONERA" = :ll_cuponera )   
								USING		sqlca;
								if sqlca.sqlcode=0 then
									commit;
								else
									rollback;
								end if
								SELECT 	"CUPONERAS"."ESTADO_CUPONERA" ,	"CUPONERAS"."NRO_CUPONERA"
								INTO 		:ls_estado_cuponera  ,						:ll_cuponera
								FROM 	"CUPONERAS"  
								WHERE 	( "CUPONERAS"."BASE" = :gs_base ) AND  
											( "CUPONERAS"."SERIE" = :gs_serie ) AND  
											( "CUPONERAS"."NUMERO" = :gi_numero ) AND
											( "CUPONERAS"."NRO_CUPONERA" =  (	SELECT 	MAX("CUPONERAS"."NRO_CUPONERA")
																								FROM 	"CUPONERAS"  
																								WHERE 	( "CUPONERAS"."BASE" = :gs_base ) AND  
																											( "CUPONERAS"."SERIE" = :gs_serie ) AND  
																											( "CUPONERAS"."NUMERO" = :gi_numero ) ) )
								USING	sqlca;
											
								SELECT 	count("CUPONERAS"."BASE")
								INTO 		:ll_count
								FROM 	"CUPONERAS"  
								WHERE 	( "CUPONERAS"."BASE" = :gs_base ) AND  
											( "CUPONERAS"."SERIE" = :gs_serie ) AND  
											( "CUPONERAS"."NUMERO" = :gi_numero )
								USING	sqlca;
							end if
							ll_res2 = 1
						else
							ll_res2 = 1
						end if
					else
						ll_res2 	= 1
					end if
					if ll_res2 = 1 then
						UPDATE 	"CUPONERAS"  
						SET 		"ESTADO_CUPONERA" = 'V'  
						WHERE ( "CUPONERAS"."BASE" = :gs_base ) AND  
								  ( "CUPONERAS"."SERIE" = :gs_serie ) AND  
								  ( "CUPONERAS"."NUMERO" = :gi_numero )  AND
								  ( "CUPONERAS"."NRO_CUPONERA" = :ll_cuponera )
						USING	sqlca;
						if sqlca.sqlcode=0 then
							commit;
							UPDATE 	"CUPONERAS"  
							SET 		"ESTADO_CUPONERA" = 'A'  
							WHERE ( "CUPONERAS"."BASE" = :gs_base ) AND  
									  ( "CUPONERAS"."SERIE" = :gs_serie ) AND  
									  ( "CUPONERAS"."NUMERO" = :gi_numero )  AND
									  ( "CUPONERAS"."NRO_CUPONERA" < :ll_cuponera )
							USING	sqlca;
							if sqlca.sqlcode=0 then
								commit;
								ls_paso	= 'S'
							else
								rollback;
							end if
						else
							rollback;
						end if
						
					end if
				end if
				if ls_paso = 'S' then
					SELECT 	MAX("CUPONERAS_DETALLE"."FECHA_VENC" ) 
					INTO 		:ldt_max_venc  
					FROM 	"CUPONERAS_DETALLE"  
					WHERE ( "CUPONERAS_DETALLE"."BASE" = :gs_base ) AND  
							  ( "CUPONERAS_DETALLE"."SERIE" = :gs_serie ) AND  
							  ( "CUPONERAS_DETALLE"."NUMERO" = :gi_numero ) AND  
							  ( "CUPONERAS_DETALLE"."NRO_CUPONERA" = :ll_cuponera ) AND  
							  ( "CUPONERAS_DETALLE"."ESTADO_PAGO_CUPON" = 'V' ) AND  
							  ( "CUPONERAS_DETALLE"."TIPO_MOV" = 'F' )   ;
					if not isnull(ldt_max_venc) then
						ldt_fecha_venc_mant	= ldt_max_venc
						SELECT 	add_months( :ldt_fecha_venc_mant, :ll_cant_meses) 
						INTO		:ldt_fecha_prox
						FROM		dual;
						ldt_fecha_venc_mant	= ldt_fecha_prox
					end if
					
					SELECT 	count("CUPONERAS_DETALLE"."NRO_CUOTA" ) 
					INTO 		:ll_max_cuota  
					FROM 	"CUPONERAS_DETALLE"  
					WHERE ( "CUPONERAS_DETALLE"."BASE" = :gs_base ) AND  
							  ( "CUPONERAS_DETALLE"."SERIE" = :gs_serie ) AND  
							  ( "CUPONERAS_DETALLE"."NUMERO" = :gi_numero ) AND  
							  ( "CUPONERAS_DETALLE"."NRO_CUPONERA" = :ll_cuponera ) AND  
							  ( "CUPONERAS_DETALLE"."ESTADO_PAGO_CUPON" = 'V' ) AND  
							  ( "CUPONERAS_DETALLE"."TIPO_MOV" = 'F' )   ;
					if isnull(ll_max_cuota) or ll_max_cuota=0 then
						ll_max_cuota	= 0
					end if
					ldt_fecha_prox		= ldt_fecha_venc_mant
					for ll_indi = 1 to ll_cantidad
						ll_nro_cuota = ll_max_cuota + ll_ctas_pag_m + ll_indi
						if not isnull(ldt_fecha_prox) then
							INSERT INTO "CUPONERAS_DETALLE"  
										( "BASE",  	"SERIE",  	"NUMERO",	"NRO_CUPON",  	"RUT",   	"NRO_CUOTA",   	"FECHA_VENC",   	"ESTADO_PAGO_CUPON",   	"TIPO_MOV",   	"TIPO_COB_PAGO",   	"FOLIO_PAGO",   	"FECHA_PAGO",   	"MONTO_CUOTA_CONTRATO",   	"MONTO_CUOTA_PESO",   	"MONTO_INTERES_MORA",   	"MONTO_GASTO_COBRANZA",   	"NRO_CUPONERA",   	"DV",   	"IP_PRINT",   	"USUARIO_PRINT",   	"NUMERO_GRUPO_AVISO",   	"BASE_ASOC",   	"SERIE_ASOC",   	"NUMERO_ASOC",   	"MONTO_OTROS_COBROS",   	"USUARIO_ACTUALIZA_REG",   	"FECHA_ACTUALIZA_REG",   	"CUPON_WEB",   	"SW_GRAN_CUPON" )  
							VALUES 	( :gs_base,	:gs_serie,   :gi_numero,	:ll_cupon,   			:ll_rut,   :ll_nro_cuota,   		:ldt_fecha_prox,   	'V',   								'F',   				null,   					null,   				null,   				:ldb_valor_cuota_m,   				0,   								0,   									0,											:ll_count,   				:ls_dv,   	null,   			null,   					null,   								null,   				null,   				null,   					null,   								:gs_user,   								:gdt_fec_sistema,   				0,   					1 )  
							USING	sqlca;
							if sqlca.sqlcode=0 then
								commit;
								ldt_fecha_venc_mant = ldt_fecha_prox;
								ll_cupon ++
							else
								rollback;
								messagebox("Error Grabar","Error al Grabar Cupon SQL: "+sqlca.sqlerrtext)
							end if
		
						end if
						SELECT 	add_months( :ldt_fecha_venc_mant, :ll_cant_meses) 
						INTO		:ldt_fecha_prox
						FROM		dual;
					next
//					w_ver_cupones.triggerevent(open!)
				end if
			end if
		else
//			messagebox("Advertencia","Recuerde solo puede crear Cupones a Contratos en Estado VIGENTE o PAGADO")
		end if

	end if
else
//	messagebox("Advertencia","Solo se puede Crear Cupones de Mantención a O-PROMESAS y C-CONTRATOS ISA")
end if
end subroutine

public subroutine wf_cargar_monto (double ald_monto, long ail_cantidad_malo, long al_row, long ald_pie_pactado, long al_cuota_ini, long al_cuota_fin, long al_cantidad);String		ls_otro_dscto,ls_tipo_cob_dscto
Long		ll_fila_dscto,ll_fila_pie,ll_tot_reg,ll_count_f,ll_cant_exento,ll_valor_cuota_f,ll_dscto_fila
Double	ll_monto_cta,ll_monto_final,ll_iva_recalc,ll_mora_mant,ll_gasto_mant,ll_monto_pie_ingreso,ll_iva_cuota,ll_iva_f_real,ll_dscto_valor_reg

//if tab_ingreso.tp_be.rb_be_uf.checked=true then
if tab_ingreso.tp_be.dw_detalle_be.getitemstring(al_row,'moneda' ) = 'U' then
	ald_monto						= round(tab_ingreso.tp_be.dw_detalle_be.getitemnumber(al_row,'monto_uf') * gd_uf,0)
//elseif tab_ingreso.tp_be.rb_be_peso.checked=true then
elseif tab_ingreso.tp_be.dw_detalle_be.getitemstring(al_row,'moneda' ) = 'P' then
	ald_monto						= tab_ingreso.tp_be.dw_detalle_be.getitemnumber(al_row,'monto')
end if
if ald_monto < 0 then
	if isnull(ail_cantidad_malo) then	ail_cantidad_malo	= tab_ingreso.tp_be.dw_detalle_be.getitemnumber(al_row,'cantidad')
	messagebox("Advertencia","Revisar Monto Ingresado, recuerde Ingreso MONTO Mayor a CERO")
	tab_ingreso.tp_be.dw_detalle_be.SetItem(al_row, "monto", 0)
	tab_ingreso.tp_be.dw_detalle_be.SetItem(al_row, "cantidad", 0)
else
	if gs_tipo_cobro = 'BA' or gs_tipo_cobro = 'FA' then
		// Recalcular IVA
		ls_otro_dscto				= tab_ingreso.tp_be.dw_detalle_be.getitemstring(al_row,'tipo_cob_otro')
		ls_tipo_cob_dscto			= tab_ingreso.tp_be.dw_detalle_be.getitemstring(al_row,'tipo_cob')
		if ((ls_tipo_cob_dscto='S' and ls_otro_dscto='132') or ls_otro_dscto = 'F') and ald_monto > 0 then	//Descuento Mantencion
			SELECT COUNT( "VISTA_MANTEN_IVA"."BASE"  )
			INTO    :ll_count_f
			FROM    "VISTA_MANTEN_IVA"  
			WHERE ( "VISTA_MANTEN_IVA"."BASE" = :gs_base ) AND  
					  ( "VISTA_MANTEN_IVA"."SERIE" = :gs_serie ) AND  
					  ( "VISTA_MANTEN_IVA"."NUMERO" = :gi_numero ) AND
					  ( "VISTA_MANTEN_IVA"."TIPO_MOV" = 'F' ) AND
					  ( "VISTA_MANTEN_IVA"."NRO_CUOTA" >= :al_cuota_ini ) AND
					  ( "VISTA_MANTEN_IVA"."NRO_CUOTA" <= :al_cuota_fin ) AND
					  ( "VISTA_MANTEN_IVA"."IVA" > 0 ) ;
							  
			if isnull(ll_count_f) then ll_count_f=0
			ll_fila_dscto				= tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob='F'", 1, tab_ingreso.tp_be.dw_detalle_be.rowcount())
			if ll_fila_dscto > 0 then
				ll_monto_cta		= tab_ingreso.tp_be.dw_detalle_be.getitemnumber(ll_fila_dscto,'c_total_linea')
				ll_fila_dscto			= tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob='D'", 1, tab_ingreso.tp_be.dw_detalle_be.rowcount())
				if ll_fila_dscto > 0 then
					ll_monto_final	= ll_monto_cta - ald_monto
					ll_iva_cuota		= (round(ll_monto_final * (idb_iva - 1),0)) / al_cantidad
					ll_iva_f_real		= round(ll_iva_cuota * ll_count_f,0)
					ll_cant_exento	= al_cantidad - ll_count_f
					
					ll_valor_cuota_f= round((ll_monto_final / (ll_cant_exento + ll_count_f)) ,0)
					gl_iva_exento_f	= round(ll_valor_cuota_f * ll_cant_exento,0)
					ll_iva_recalc		= ll_iva_f_real	//round(ll_monto_final * (idb_iva - 1),0)
					tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila_dscto,'monto',ll_iva_recalc)
					tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila_dscto,'monto_uf', round( ll_iva_recalc / gd_uf,4))
				end if
			end if
		elseif ((ls_tipo_cob_dscto='S' and ls_otro_dscto='130') or ls_tipo_cob_dscto='P') and ald_monto > 0 then	//Descuento Interes Mantencion
			ll_mora_mant			= tab_ingreso.tp_be.dw_gastos_be.getitemnumber(1,'mora_mant')
			if ll_mora_mant > 0 then
				ll_fila_dscto			= tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob='V'", 1, tab_ingreso.tp_be.dw_detalle_be.rowcount())
				if ll_fila_dscto > 0 then
					ll_monto_final	= ll_mora_mant - ald_monto
					ll_iva_recalc		= round(ll_monto_final * (idb_iva - 1),0)
					tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila_dscto,'monto',ll_iva_recalc)
					tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila_dscto,'monto_uf', round( ll_iva_recalc / gd_uf,4))
				end if
			end if
		elseif (ls_tipo_cob_dscto='S' and (ls_otro_dscto='103' or ls_otro_dscto='107' or ls_otro_dscto='109' or ls_otro_dscto='113' or ls_otro_dscto='114' or ls_otro_dscto='115' or ls_otro_dscto='122' or ls_otro_dscto='134' or ls_otro_dscto='151' or ls_otro_dscto='155' or ls_otro_dscto='160' or ls_otro_dscto='161') or ls_tipo_cob_dscto='M') and ald_monto > 0 then	//Descuento Derecho Sepultacion
			ll_fila_dscto				= tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob='M'", 1, tab_ingreso.tp_be.dw_detalle_be.rowcount())
			if ll_fila_dscto > 0 then
				ll_monto_cta		= tab_ingreso.tp_be.dw_detalle_be.getitemnumber(ll_fila_dscto,'c_total_linea')
				ll_fila_dscto			= tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob='D'", 1, tab_ingreso.tp_be.dw_detalle_be.rowcount())
				ll_dscto_fila			= tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob='S' and (tipo_cob_otro='103' or tipo_cob_otro='107' or tipo_cob_otro='109' or tipo_cob_otro='113' or tipo_cob_otro='114' or tipo_cob_otro='115' or tipo_cob_otro='122' or tipo_cob_otro='134' or tipo_cob_otro='151' or tipo_cob_otro='155' or tipo_cob_otro='160' or tipo_cob_otro='161')", 1, tab_ingreso.tp_be.dw_detalle_be.rowcount())
				if ll_dscto_fila > 0 then
					ll_dscto_valor_reg	= tab_ingreso.tp_be.dw_detalle_be.getitemnumber(ll_dscto_fila,'c_total_linea')
				else
					ll_dscto_valor_reg	= 0
				end if
				if ll_fila_dscto > 0 then
//					ll_monto_final	= ll_monto_cta - ald_monto
//					ll_monto_final	= ald_monto + ll_dscto_valor_reg
					ll_monto_final	= ll_monto_cta + ll_dscto_valor_reg
					ll_iva_recalc		= round(ll_monto_final * (idb_iva - 1),0)
					tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila_dscto,'monto',ll_iva_recalc)
					tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila_dscto,'monto_uf', round( ll_iva_recalc / gd_uf,4))
				end if
			end if
		elseif ((ls_tipo_cob_dscto='S' and ls_otro_dscto='133') or ls_tipo_cob_dscto='R') and ald_monto > 0 then	//Descuento gasto Cobranza Mantencion
			ll_gasto_mant			= tab_ingreso.tp_be.dw_gastos_be.getitemnumber(1,'gasto_mant')
			if ll_gasto_mant > 0 then
				ll_fila_dscto			= tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob='X'", 1, tab_ingreso.tp_be.dw_detalle_be.rowcount())
				if ll_fila_dscto > 0 then
					ll_monto_final	= ll_gasto_mant - ald_monto
					ll_iva_recalc		= round(ll_monto_final * (idb_iva - 1),0)
					tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila_dscto,'monto',ll_iva_recalc)
					tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila_dscto,'monto_uf', round( ll_iva_recalc / gd_uf,4))
				end if
			end if
		end if
		if gs_base='L' or gs_base='G' or gs_base='F' then
			if ((ls_tipo_cob_dscto='S' and (ls_otro_dscto='108' or ls_otro_dscto='131' or ls_otro_dscto='141' or ls_otro_dscto='145' or ls_otro_dscto='146' or ls_otro_dscto='147' or ls_otro_dscto='154' or ls_otro_dscto='160' or ls_otro_dscto='161')) or ls_tipo_cob_dscto='E' or ls_tipo_cob_dscto='A' or ls_tipo_cob_dscto='U' or ls_tipo_cob_dscto='Q') and ald_monto > 0 then	//Descuento Mantencion
				ll_fila_dscto				= tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob='E' or tipo_cob='A' or tipo_cob='U' or tipo_cob='Q'", 1, tab_ingreso.tp_be.dw_detalle_be.rowcount())
				if ll_fila_dscto > 0 then
					ll_monto_cta		= tab_ingreso.tp_be.dw_detalle_be.getitemnumber(ll_fila_dscto,'c_total_linea')
					ll_fila_dscto			= tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob='D'", 1, tab_ingreso.tp_be.dw_detalle_be.rowcount())
					if ll_fila_dscto > 0 then
						ll_monto_final	= ll_monto_cta - ald_monto
						ll_iva_recalc		= round(ll_monto_final * (idb_iva - 1),0)
						tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila_dscto,'monto',ll_iva_recalc)
						tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila_dscto,'monto_uf', round( ll_iva_recalc / gd_uf,4))
					end if
				end if
			elseif ((ls_tipo_cob_dscto='S' and ls_otro_dscto='102') or ls_tipo_cob_dscto='G' ) and ald_monto > 0 then	//Descuento Interes Mantencion
				ll_mora_mant			= tab_ingreso.tp_be.dw_gastos_be.getitemnumber(1,'mora_cred')
				if ll_mora_mant > 0 then
					ll_fila_dscto			= tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob='V'", 1, tab_ingreso.tp_be.dw_detalle_be.rowcount())
					if ll_fila_dscto > 0 then
						ll_monto_final	= ll_mora_mant - ald_monto
						ll_iva_recalc		= round(ll_monto_final * (idb_iva - 1),0)
						tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila_dscto,'monto',ll_iva_recalc)
						tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila_dscto,'monto_uf', round( ll_iva_recalc / gd_uf,4))
					end if
				end if
			elseif ((ls_tipo_cob_dscto='S' and ls_otro_dscto='118') or ls_tipo_cob_dscto='J') and ald_monto > 0 then	//Descuento gasto Cobranza Mantencion
				ll_gasto_mant			= tab_ingreso.tp_be.dw_gastos_be.getitemnumber(1,'gasto_cred')
				if ll_gasto_mant > 0 then
					ll_fila_dscto			= tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob='X'", 1, tab_ingreso.tp_be.dw_detalle_be.rowcount())
					if ll_fila_dscto > 0 then
						ll_monto_final	= ll_gasto_mant - ald_monto
						ll_iva_recalc		= round(ll_monto_final * (idb_iva - 1),0)
						tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila_dscto,'monto',ll_iva_recalc)
						tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila_dscto,'monto_uf', round( ll_iva_recalc / gd_uf,4))
					end if
				end if
			end if
		end if
	end if
	tab_ingreso.tp_be.dw_detalle_be.accepttext()
	ll_tot_reg		=  tab_ingreso.tp_be.dw_detalle_be.rowcount()
	// Fin Recalculo IVA
	//	Validar PIE
	ll_fila_pie 		= tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob ='A' or tipo_cob ='Q'",1, ll_tot_reg)
	if ll_fila_Pie > 0 then
		ll_monto_pie_ingreso		= round(tab_ingreso.tp_be.dw_detalle_be.getitemnumber(tab_ingreso.tp_be.dw_detalle_be.getrow(),'c_total_linea'),0)
	else
		ll_monto_pie_ingreso		= 0
	end if
	if (gs_base='O' or gs_base='U' or gs_base='M') and ll_fila_Pie > 0 and gs_rezago <> 'S' and ll_fila_Pie = tab_ingreso.tp_be.dw_detalle_be.getrow() then
		if f_valida_pie_pagado(gs_base, gs_serie, gi_numero, tab_ingreso.tp_be.dw_datos_be.getitemstring(1,'pago_oferta_moneda')) + ll_monto_pie_ingreso > ald_pie_pactado  then
			messagebox("Advertencia","Revisar Monto Ingresado, recuerde Ingreso MONTO Mayor a Pie Pactado")
			tab_ingreso.tp_be.dw_detalle_be.SetItem(al_row, "monto", 0)
			tab_ingreso.tp_be.dw_detalle_be.SetItem(al_row, "cantidad", 0)
		end if
	elseif gs_base='L' and ll_fila_Pie > 0 and gs_rezago <> 'S' and ll_fila_Pie = tab_ingreso.tp_be.dw_detalle_be.getrow() then
		if f_valida_pie_pagado(gs_base, gs_serie, gi_numero, tab_ingreso.tp_be.dw_datos_be.getitemstring(1,'pago_liberador_moneda')) + ll_monto_pie_ingreso > ald_pie_pactado  then
			messagebox("Advertencia","Revisar Monto Ingresado, recuerde Ingreso MONTO Mayor a Pie Pactado")
			tab_ingreso.tp_be.dw_detalle_be.SetItem(al_row, "monto", 0)
			tab_ingreso.tp_be.dw_detalle_be.SetItem(al_row, "cantidad", 0)
		end if
	elseif gs_base='A' and ll_fila_Pie > 0 and gs_rezago <> 'S' and ll_fila_Pie = tab_ingreso.tp_be.dw_detalle_be.getrow()  then
		if f_valida_pie_pagado(gs_base, gs_serie, gi_numero, tab_ingreso.tp_be.dw_datos_be.getitemstring(1,'pago_aumento_moneda')) + ll_monto_pie_ingreso > ald_pie_pactado  then
			messagebox("Advertencia","Revisar Monto Ingresado, recuerde Ingreso MONTO Mayor a Pie Pactado")
			tab_ingreso.tp_be.dw_detalle_be.SetItem(al_row, "monto", 0)
			tab_ingreso.tp_be.dw_detalle_be.SetItem(al_row, "cantidad", 0)
		end if
	end if
	if ail_cantidad_malo>0 then tab_ingreso.tp_be.dw_detalle_be.setitem(al_row,'cantidad',ail_cantidad_malo)
end if
end subroutine

public subroutine wf_actualizar (string as_tipo_cob);if tab_ingreso.tp_be.dw_detalle_be.GetItemNumber(1,"c_subtotal") > 0 then wf_calcular_interes(as_tipo_cob)
tab_ingreso.tp_be.dw_detalle_be.accepttext()
if tab_ingreso.tp_be.dw_detalle_be.rowcount() > 0 then
	tab_ingreso.tp_be.dw_gastos_be.SetItem(1, "Subtotal",tab_ingreso.tp_be.dw_detalle_be.GetItemNumber(1,"c_subtotal"))
	tab_ingreso.tp_be.dw_gastos_be.accepttext()
	tab_ingreso.tp_be.dw_gastos_be.accepttext()
	tab_ingreso.tp_be.dw_detalle_be.accepttext()
	tab_ingreso.tp_be.dw_detalle_be.setcolumn('tipo_cob')
end if
tab_ingreso.tp_be.dw_detalle_be.accepttext()
if tab_ingreso.tp_be.dw_detalle_be.GetItemNumber(1,"c_subtotal") > 0 then wf_calcular_interes(as_tipo_cob)
tab_ingreso.tp_be.dw_detalle_be.accepttext()
if tab_ingreso.tp_be.dw_detalle_be.rowcount() > 0 then
	tab_ingreso.tp_be.dw_gastos_be.accepttext()
	tab_ingreso.tp_be.dw_detalle_be.accepttext()
	tab_ingreso.tp_be.dw_detalle_be.setcolumn('tipo_cob')
end if
end subroutine

public subroutine wf_cargar_seguros ();Long		ll_cod_seguro,ll_count_adic,ll_tot_reg,ll_indi,ll_cant_e,ll_new_seg,ll_fila_e
Double	ldb_prima,ldb_uf
String		ls_moneda_ctto,ls_tipo_cob,ls_moneda

ldb_uf									= gd_uf
ll_fila_e								= tab_ingreso.tp_be.dw_detalle_be.find("tipo_cob = 'E' or tipo_cob='K'",1,tab_ingreso.tp_be.dw_detalle_be.rowcount())
if ll_fila_e > 0 then 
	ll_cant_e							= tab_ingreso.tp_be.dw_detalle_be.getitemnumber(ll_fila_e,'cantidad')
end if
DECLARE x1 CURSOR FOR  
SELECT	"SEGURO_ASOCIADOS"."COD_SEGURO",   
			"SEGURO_ASOCIADOS"."MONTO_PRIMA",
			"SEGURO_ASOCIADOS"."MONEDA"
FROM 	"SEGURO_ASOCIADOS"  
WHERE ( "SEGURO_ASOCIADOS"."BASE" = :gs_base ) AND  
		  ( "SEGURO_ASOCIADOS"."SERIE" = :gs_serie ) AND  
		  ( "SEGURO_ASOCIADOS"."NUMERO" = :gi_numero ) AND  
		  ( "SEGURO_ASOCIADOS"."ESTADO_REG" = 0 ) AND  
		  ( "SEGURO_ASOCIADOS"."ESTADO_SEGURO" = 'A' )   AND
		  ( "SEGURO_ASOCIADOS"."MONTO_PRIMA" > 0 ) 
//		  ( "SEGURO_ASOCIADOS"."COD_SEGURO" <> 8 )
USING	sqlca;
open x1;
if sqlca.sqlcode=0 then
	do while sqlca.sqlcode=0
		fetch x1 into :ll_cod_seguro, :ldb_prima, :ls_moneda_ctto;
		if not isnull(ll_cod_seguro) and ll_cod_seguro>0  then
			ll_count_adic			= 0
			ll_tot_reg				= tab_ingreso.tp_be.dw_detalle_be.rowcount()
			for ll_indi =1 to ll_tot_reg
				ls_tipo_cob			= tab_ingreso.tp_be.dw_detalle_be.GetItemString(ll_indi, "tipo_cob")
				if ls_tipo_cob = string(ll_cod_seguro) then
					ll_count_adic ++
					tab_ingreso.tp_be.dw_detalle_be.setitem(ll_indi,'cantidad', ll_cant_e)
				end if
			next
			tab_ingreso.tp_be.dw_detalle_be.accepttext()
			if ll_count_adic = 0 then
				ll_new_seg		= tab_ingreso.tp_be.dw_detalle_be.insertrow(0)
				tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_seg,'tipo_cob', string(ll_cod_seguro))
				if tab_ingreso.tp_be.rb_be_afecta.checked=true then
					tab_ingreso.tp_be.dw_detalle_be.SetItem(ll_new_seg, "iva", idb_iva)
				end if
				tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_seg,'cantidad', ll_cant_e)
				if ls_moneda_ctto = '1' then
					tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_seg,'moneda','P')
					tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_seg,'monto_uf', round( ldb_prima / ldb_uf,4))
					tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_seg,'monto', ldb_prima)
				elseif ls_moneda_ctto = '2' then
					tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_seg,'moneda','U')
					tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_seg,'monto_uf', ldb_prima)
					tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_seg,'monto', round( ldb_prima * ldb_uf,0))
				end if
				tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_seg,'uf',gd_uf)
				tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_seg,'estado','S')
			//	gd_uf
//				tab_ingreso.tp_be.dw_detalle_be.SetItem(ll_new_seg, "moneda",ls_moneda)
			end if
		end if
		setnull(ll_cod_seguro)
	loop
end if
close x1;
tab_ingreso.tp_be.dw_detalle_be.accepttext()
end subroutine

public subroutine wf_cargar_seguros_ci ();Long		ll_cod_seguro,ll_count_adic,ll_tot_reg,ll_indi,ll_cant_e,ll_new_seg,ll_fila_e
Double	ldb_prima,ldb_uf
String		ls_moneda_ctto,ls_tipo_cob,ls_moneda

ldb_uf									= gd_uf
ll_fila_e								= tab_ingreso.tp_ci.dw_detalle_ci.find("tipo_cob = 'E' or tipo_cob='K'",1,tab_ingreso.tp_ci.dw_detalle_ci.rowcount())
if ll_fila_e > 0 then 
	ll_cant_e							= tab_ingreso.tp_ci.dw_detalle_ci.getitemnumber(ll_fila_e,'cantidad')
end if
DECLARE x1 CURSOR FOR  
SELECT	"SEGURO_ASOCIADOS"."COD_SEGURO",   
			"SEGURO_ASOCIADOS"."MONTO_PRIMA",
			"SEGURO_ASOCIADOS"."MONEDA"
FROM 	"SEGURO_ASOCIADOS"  
WHERE ( "SEGURO_ASOCIADOS"."BASE" = :gs_base ) AND  
		  ( "SEGURO_ASOCIADOS"."SERIE" = :gs_serie ) AND  
		  ( "SEGURO_ASOCIADOS"."NUMERO" = :gi_numero ) AND  
		  ( "SEGURO_ASOCIADOS"."ESTADO_REG" = 0 ) AND  
		  ( "SEGURO_ASOCIADOS"."ESTADO_SEGURO" = 'A' )   AND
		  ( "SEGURO_ASOCIADOS"."MONTO_PRIMA" > 0 ) 
//		  ( "SEGURO_ASOCIADOS"."COD_SEGURO" <> 8 )
USING	sqlca;
open x1;
if sqlca.sqlcode=0 then
	do while sqlca.sqlcode=0
		fetch x1 into :ll_cod_seguro, :ldb_prima, :ls_moneda_ctto;
		if not isnull(ll_cod_seguro) and ll_cod_seguro>0  then
			ll_count_adic			= 0
			ll_tot_reg				= tab_ingreso.tp_ci.dw_detalle_ci.rowcount()
			for ll_indi =1 to ll_tot_reg
				ls_tipo_cob			= tab_ingreso.tp_ci.dw_detalle_ci.GetItemString(ll_indi, "tipo_cob")
				if ls_tipo_cob = string(ll_cod_seguro) then
					ll_count_adic ++
					tab_ingreso.tp_ci.dw_detalle_ci.setitem(ll_indi,'cantidad', ll_cant_e)
				end if
			next
			tab_ingreso.tp_ci.dw_detalle_ci.accepttext()
			if ll_count_adic = 0 then
				ll_new_seg		= tab_ingreso.tp_ci.dw_detalle_ci.insertrow(0)
				tab_ingreso.tp_ci.dw_detalle_ci.setitem(ll_new_seg,'tipo_cob', string(ll_cod_seguro))
//				if tab_ingreso.tp_ci.rb_be_afecta.checked=true then
//					tab_ingreso.tp_ci.dw_detalle_ci.SetItem(ll_new_seg, "iva", idb_iva)
//				end if
				tab_ingreso.tp_ci.dw_detalle_ci.setitem(ll_new_seg,'cantidad', ll_cant_e)
				if ls_moneda_ctto = '1' then
					tab_ingreso.tp_ci.dw_detalle_ci.setitem(ll_new_seg,'moneda','P')
					tab_ingreso.tp_ci.dw_detalle_ci.setitem(ll_new_seg,'monto_uf', round( ldb_prima / ldb_uf,4))
					tab_ingreso.tp_ci.dw_detalle_ci.setitem(ll_new_seg,'monto', ldb_prima)
				elseif ls_moneda_ctto = '2' then
					tab_ingreso.tp_ci.dw_detalle_ci.setitem(ll_new_seg,'moneda','U')
					tab_ingreso.tp_ci.dw_detalle_ci.setitem(ll_new_seg,'monto_uf', ldb_prima)
					tab_ingreso.tp_ci.dw_detalle_ci.setitem(ll_new_seg,'monto', round( ldb_prima * ldb_uf,0))
				end if
				tab_ingreso.tp_ci.dw_detalle_ci.setitem(ll_new_seg,'uf',gd_uf)
				tab_ingreso.tp_ci.dw_detalle_ci.setitem(ll_new_seg,'estado','S')
			//	gd_uf
//				tab_ingreso.tp_ci.dw_detalle_ci.SetItem(ll_new_seg, "moneda",ls_moneda)
			end if
		end if
		setnull(ll_cod_seguro)
	loop
end if
close x1;
tab_ingreso.tp_ci.dw_detalle_ci.accepttext()
end subroutine

public subroutine wf_cargar_iva (string as_tipo_cob, long al_row);Long		ll_ctas_pag_m,ii_cantidad,ll_cuota_ini,ll_cuota_fin,ll_cuotas_con_iva,ll_new_iva
Double	ll_monto_cuota_reg,ll_valor_cuota_f,ldb_iva,ll_iva_f,ll_mora_mant,ll_iva_p,ll_gasto_mant,ll_iva_r
String		ls_moneda_insert

if (as_tipo_cob = "E" or as_tipo_cob="A" or as_tipo_cob = "U" or as_tipo_cob="Q") and ( gs_base='L' or gs_base='G' or gs_base='F' ) and gs_rezago <> 'S' then
		if tab_ingreso.tp_be.dw_datos_be.rowcount() > 0 then
			if gs_base='L' then
				ll_ctas_pag_m		= tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'anexo_liberador_cta_pag_m')
			elseif gs_base='G' or gs_base='F' then
				ll_ctas_pag_m		= tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'producto_anexo_cuotas_pag')
			end if
		else
			ll_ctas_pag_m			= 1
		end if
		ll_monto_cuota_reg		= tab_ingreso.tp_be.dw_detalle_be.getitemnumber(tab_ingreso.tp_be.dw_detalle_be.getrow(),'c_total_linea')
		ii_cantidad 					= tab_ingreso.tp_be.dw_detalle_be.GetItemNumber(al_row, "cantidad")
		if isnull(ii_cantidad) or ii_cantidad = 0 then ii_cantidad=1
		ll_cuota_ini					= ll_ctas_pag_m + 1
		ll_cuota_fin					= (ll_cuota_ini + ii_cantidad) - 1
		if gs_tipo_cobro = 'BA' or gs_tipo_cobro='FA' then
			if ii_cantidad = 0 then ii_cantidad=1
			SELECT COUNT( "VISTA_MANTEN_IVA"."BASE"  )
		  	INTO    :ll_cuotas_con_iva
		  	FROM    "VISTA_MANTEN_IVA"  
		  	WHERE ( "VISTA_MANTEN_IVA"."BASE" = :gs_base ) AND  
				  ( "VISTA_MANTEN_IVA"."SERIE" = :gs_serie ) AND  
				  ( "VISTA_MANTEN_IVA"."NUMERO" = :gi_numero ) AND
				  ( "VISTA_MANTEN_IVA"."TIPO_MOV" = :as_tipo_cob ) AND
				  ( "VISTA_MANTEN_IVA"."NRO_CUOTA" >= :ll_cuota_ini ) AND
				  ( "VISTA_MANTEN_IVA"."NRO_CUOTA" <= :ll_cuota_fin ) AND
				  ( "VISTA_MANTEN_IVA"."IVA" > 0 );
		  	if isnull(ll_cuotas_con_iva) then ll_cuotas_con_iva=0  
		  	ll_valor_cuota_f			= round(ll_monto_cuota_reg / ii_cantidad,0)
			
			SELECT SUM( "VISTA_MANTEN_IVA"."IVA"  )
			INTO    :ldb_iva
			FROM    "VISTA_MANTEN_IVA"  
			WHERE ( "VISTA_MANTEN_IVA"."BASE" = :gs_base ) AND  
					  ( "VISTA_MANTEN_IVA"."SERIE" = :gs_serie ) AND  
					  ( "VISTA_MANTEN_IVA"."NUMERO" = :gi_numero ) AND
					  ( "VISTA_MANTEN_IVA"."TIPO_MOV" = :as_tipo_cob ) AND
					  ( "VISTA_MANTEN_IVA"."NRO_CUOTA" >= :ll_cuota_ini ) AND
					  ( "VISTA_MANTEN_IVA"."NRO_CUOTA" <= :ll_cuota_fin ) ;
			if ldb_iva > 0 and ll_monto_cuota_reg > 0 then
					gl_iva_exento_f		= ll_monto_cuota_reg - (ll_cuotas_con_iva * ll_valor_cuota_f)
					ll_iva_f 				= ldb_iva		//round(ll_monto_cuota_reg * (idb_iva - 1),0)
					ll_new_iva			= tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob = 'D'", 1, tab_ingreso.tp_be.dw_detalle_be.rowcount())
					if ll_new_iva > 0 then
						if ldb_iva > 0 then
							tab_ingreso.tp_be.dw_detalle_be.scrolltorow(ll_new_iva)
						else
							tab_ingreso.tp_be.dw_detalle_be.deleterow(ll_new_iva)
						end if
					else
						ll_new_iva		= tab_ingreso.tp_be.dw_detalle_be.insertrow(0)
					end if
					
					tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_iva,'tipo_cob', 'D')
					if tab_ingreso.tp_be.rb_be_afecta.checked=true then
						tab_ingreso.tp_be.dw_detalle_be.SetItem(ll_new_iva, "iva", idb_iva)
					end if
					tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_iva,'cantidad', 1)
					ls_moneda_insert	= '1'
					if ls_moneda_insert = '1' then
						tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_iva,'monto_uf', round( ll_iva_f / gd_uf,4))
						tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_iva,'monto', ll_iva_f)
					end if
					tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_iva,'uf',gd_uf)
					tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_iva,'estado','S')
					tab_ingreso.tp_be.dw_detalle_be.SetItem(ll_new_iva, "moneda",'P')
			  else
					ll_iva_f 				= 0
					gl_iva_exento_f		= ll_monto_cuota_reg
					ll_new_iva			= tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob = 'D'", 1, tab_ingreso.tp_be.dw_detalle_be.rowcount())
					if ll_new_iva > 0 then
						tab_ingreso.tp_be.dw_detalle_be.deleterow(ll_new_iva)
					end if
			end if
			ll_mora_mant			= tab_ingreso.tp_be.dw_gastos_be.getitemnumber(1,'mora_cred')
			if ll_mora_mant > 0 then
				  SELECT  SUM("VISTA_MANTEN_IVA"."IVA")  
				  INTO    	:ldb_iva
				  FROM    "VISTA_MANTEN_IVA"  
				  WHERE   ( "VISTA_MANTEN_IVA"."BASE" = :gs_base ) AND  
							  ( "VISTA_MANTEN_IVA"."SERIE" = :gs_serie ) AND  
							  ( "VISTA_MANTEN_IVA"."NUMERO" = :gi_numero ) AND
							  ( "VISTA_MANTEN_IVA"."TIPO_MOV" = 'G' ) AND
							  ( "VISTA_MANTEN_IVA"."NRO_CUOTA" >= :ll_cuota_ini ) AND
							  ( "VISTA_MANTEN_IVA"."NRO_CUOTA" <= :ll_cuota_fin );
				  if ldb_iva > 0 and ll_mora_mant > 0 then
						ll_iva_p 			= round(ll_mora_mant * (idb_iva - 1),0)
						ll_new_iva		= tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob = 'V'", 1, tab_ingreso.tp_be.dw_detalle_be.rowcount())
						if ll_new_iva > 0 then
							tab_ingreso.tp_be.dw_detalle_be.scrolltorow(ll_new_iva)
						else
							ll_new_iva		= tab_ingreso.tp_be.dw_detalle_be.insertrow(0)
						end if
						tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_iva,'tipo_cob', 'V')
						if tab_ingreso.tp_be.rb_be_afecta.checked=true then
							tab_ingreso.tp_be.dw_detalle_be.SetItem(ll_new_iva, "iva", idb_iva)
						end if
						tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_iva,'cantidad', 1)
						ls_moneda_insert	= '1'
						if ls_moneda_insert = '1' then
							tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_iva,'monto_uf', round( ll_iva_p / gd_uf,4))
							tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_iva,'monto', ll_iva_p)
						end if
						tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_iva,'uf',gd_uf)
						tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_iva,'estado','S')
						tab_ingreso.tp_be.dw_detalle_be.SetItem(ll_new_iva, "moneda",'P')
				  else
						ll_iva_p 			= 0
				  end if
			end if
			ll_gasto_mant				= tab_ingreso.tp_be.dw_gastos_be.getitemnumber(1,'gasto_cred')
			if ll_gasto_mant > 0 then
				  SELECT SUM("VISTA_MANTEN_IVA"."IVA" ) 
				  INTO    	:ldb_iva
				  FROM    "VISTA_MANTEN_IVA"  
				  WHERE ( "VISTA_MANTEN_IVA"."BASE" = :gs_base ) AND  
						  ( "VISTA_MANTEN_IVA"."SERIE" = :gs_serie ) AND  
						  ( "VISTA_MANTEN_IVA"."NUMERO" = :gi_numero ) AND
						  ( "VISTA_MANTEN_IVA"."TIPO_MOV" = 'J' ) AND
						  ( "VISTA_MANTEN_IVA"."NRO_CUOTA" >= :ll_cuota_ini ) AND
						  ( "VISTA_MANTEN_IVA"."NRO_CUOTA" <= :ll_cuota_fin );
				  if ldb_iva > 0 and ll_gasto_mant > 0 then
						ll_iva_r 			= round(ll_gasto_mant * (idb_iva - 1),0)
						ll_new_iva		= tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob = 'X'", 1, tab_ingreso.tp_be.dw_detalle_be.rowcount())
						if ll_new_iva > 0 then
							tab_ingreso.tp_be.dw_detalle_be.scrolltorow(ll_new_iva)
						else
							ll_new_iva		= tab_ingreso.tp_be.dw_detalle_be.insertrow(0)
						end if
						tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_iva,'tipo_cob', 'X')
						if tab_ingreso.tp_be.rb_be_afecta.checked=true then
							tab_ingreso.tp_be.dw_detalle_be.SetItem(ll_new_iva, "iva", idb_iva)
						end if
						tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_iva,'cantidad', 1)
						ls_moneda_insert	= '1'
						if ls_moneda_insert = '1' then
							tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_iva,'monto_uf', round( ll_iva_r / gd_uf,4))
							tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_iva,'monto', ll_iva_r)
						end if
						tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_iva,'uf',gd_uf)
						tab_ingreso.tp_be.dw_detalle_be.setitem(ll_new_iva,'estado','S')
						tab_ingreso.tp_be.dw_detalle_be.SetItem(ll_new_iva, "moneda",'P')
				  else
						ll_iva_r 			= 0
				  end if
			end if
		end if
		//Fin script nuevo IVA Autor MM 22/12/2022
	end if
end subroutine

public subroutine wf_ing_item_automatico (string p_item, string p_codigo);string ls_tipo_cob_2
integer li_fila, t ,ll_found,li_posicion
real li_monto, li_calculo 

w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.accepttext()
w_ingreso2.tab_ingreso.tp_ci.cb_ci_insertar.triggerevent(clicked!)
li_fila = w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.rowcount()

IF P_CODIGO <> '' THEN
		w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.setitem(w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.getrow(),'tipo_cob_otro',P_CODIGO)
		w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.accepttext()
END IF 


IF ls_tipo_base = 'F' AND P_CODIGO = '' THEN
	// VHFB - validamos que no exista previamente un registro 
	ll_found = w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.Find("tipo_cob = 'E'", 1, w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.rowcount())
	
	IF ll_found > 0 THEN
			RETURN
	 END IF 				 
	// validamos que no existiera error en el ingreso de 
END IF 


w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.scrolltorow(li_fila)
w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.setitem(li_fila,'tipo_cob',p_item)

DWObject ldw_Object
ldw_Object = w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.Object.tipo_cob 
w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.Event ItemChanged(li_fila, ldw_Object,p_item )


IF P_CODIGO <> '' THEN
		ll_found = w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.Find("tipo_cob = 'E'", 1, w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.rowcount())
		li_monto = w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.getitemnumber(ll_found,'monto') 
		if isnull(li_monto)  or li_monto = 0 then
			return
		end if 
END IF 
li_monto=0

if p_codigo <> '' then
		w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.scrolltorow(w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.rowcount())
		w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.setfocus()
		
		if w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.rowcount() > 0 then
			
			choose case p_codigo
				case '131'		
					for t = 1 to w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.rowcount()
						ls_tipo_cob_2 = w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.getitemstring(t,'tipo_cob')
						if ls_tipo_cob_2 = 'E' then
							li_monto =w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.getitemnumber(t,'monto')
							exit
						end if 
					next 	
				case '102'		
					li_monto = w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.getitemnumber(1,'mora_cred')
				case '118'		
					li_monto = w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.getitemnumber(1,'gasto_cred')
					
				case '149'		
					
					li_posicion =  w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.Find("tipo_cob = '4'", 1, w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.rowcount())
					if li_posicion > 0 then
						li_monto = w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.getitemnumber(li_posicion,'monto')
					else
						li_monto = 0 
					end if 					
					
				case '150'		
					
					li_posicion =  w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.Find("tipo_cob = '6'", 1, w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.rowcount())
					if li_posicion > 0 then
						li_monto = w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.getitemnumber(li_posicion,'monto')
					else
						li_monto = 0 
					end if 
					
					
			end choose 		
			
			if li_monto  > 0 then
				li_calculo =round(li_monto * (gd_descuento/100),0)
			else
				li_calculo  = 0 
			end if 
			
			w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.SetItem(w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.rowcount(), "monto",li_calculo )
		end if 
end if 
end subroutine

public subroutine wf_actualiza_cantidad ();// actualiza la cantidad de items
integer t , li_cantidad,li_cuotas_mora ,li_posicion
string ls_tipo_cob_2, ls_tipo_cob_2_otro
real lr_monto,  lr_monto2
li_cantidad=0

for t = 1 to w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.rowcount()
	
	ls_tipo_cob_2 = w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.getitemstring(t,'tipo_cob')

	if ls_tipo_cob_2 = 'E' then
		li_cantidad =w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.getitemnumber(t,'cantidad')
		lr_monto =w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.getitemnumber(t,'monto')
		exit
	end if 
next 

li_cuotas_mora=w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.getitemnumber(1,'c_cuotas_mora')

//------------------------------------------------------------------------------------------------------------------------
// SE COMENTA PARA QUE EL DESCUENTO APLIQUE PARA TODAS LAS CUOTAS QUE SE QUIERAN PAGAR
// CAMBIO REQ - 24/10/2025
//------------------------------------------------------------------------------------------------------------------------
//if li_cantidad > li_cuotas_mora then
//   li_cantidad = li_cuotas_mora
//end if 

t=1
if li_cantidad >0 then
		for t = 1 to w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.rowcount()
			
			ls_tipo_cob_2 = w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.getitemstring(t,'tipo_cob')
			ls_tipo_cob_2_otro = w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.getitemstring(t,'tipo_cob_otro')

			choose case ls_tipo_cob_2_otro
				case '102'		
					lr_monto = w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.getitemnumber(1,'mora_cred')
				case '118'		
					lr_monto = w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.getitemnumber(1,'gasto_cred')
				case '149'		
					li_posicion =  w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.Find("tipo_cob = '4'", 1, w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.rowcount())
					if li_posicion > 0 then
						lr_monto = w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.getitemnumber(li_posicion,'monto')					
					end if 					
				case '150'		
					li_posicion =  w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.Find("tipo_cob = '6'", 1, w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.rowcount())
					if li_posicion > 0 then
						lr_monto = w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.getitemnumber(li_posicion,'monto')					
					end if 
			end choose 			

			if ls_tipo_cob_2 = 'S' and  (ls_tipo_cob_2_otro = '131' or  ls_tipo_cob_2_otro = '102' or  ls_tipo_cob_2_otro = '118' or  ls_tipo_cob_2_otro = '149' or  ls_tipo_cob_2_otro = '150' )then
				//w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.setitem(t,'cantidad',li_cantidad)
				
				IF ls_tipo_cob_2_otro = '131' or  ls_tipo_cob_2_otro = '149' or  ls_tipo_cob_2_otro = '150' THEN
				    lr_monto =(round( ( lr_monto* li_cantidad) * (gd_descuento/100),0))  
				ELSE 
				    lr_monto =(round(lr_monto * (gd_descuento/100),0))
				END IF  
		
				w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.setitem(t,'monto',lr_monto)
			end if 
		
		next 
end if 



end subroutine

public subroutine wf_gatilla_descuentos ();INTEGER ll_found,li_fila2, li_cantidad2,li_monto2
if gs_aplica_a ='C' or gs_aplica_a ='T'  then
	    gb_aplica = true
		real li_monto, li_calculo
		w_ingreso2.tab_ingreso.tp_ci.cb_asigna_ci.triggerevent(clicked!)
		
		ls_tipo_base=left(w_ingreso2.tab_ingreso.tp_ci.dw_ci_buscar_cliente.getitemstring(1,'rs_bs'),1)
		
		ll_found = w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.Find("tipo_cob = 'E'", 1, w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.rowcount())
		IF ll_found = 0 THEN
				wf_ing_item_automatico('E','')	
	    END IF 

				// validamos que no existiera error en el ingreso de  F
		li_fila2 = w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.Find("tipo_cob = 'E' ",1, w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.rowcount())
		if li_fila2 > 0 then
				li_cantidad2 = w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.getitemnumber(1, 'cantidad')
				li_monto2 = w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.getitemnumber(1, 'monto')
		 end if 
		
		if li_fila2 = 0  or li_cantidad2 = 0 or li_monto2 = 0 then
			gb_aplica = false
			w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.reset()
			return
		end if 		 
		// descuento credito ------------------------------------------------------------------------------------------------------------------------
		
		ll_found = w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.Find("tipo_cob_otro = '131'", 1, w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.rowcount())		
		
		IF ll_found = 0 THEN
		wf_ing_item_automatico('S','131')	// descuento 
	    END IF 
		 

		
		if w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.rowcount()>0 then
			
				if  w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.getitemnumber(1,'mora_cred') > 0 then
		
						ll_found = w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.Find("tipo_cob_otro = '102'", 1, w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.rowcount())		
						
						IF ll_found = 0 THEN
						wf_ing_item_automatico('S','102')	// descuento 	
						 END IF 					
	
				end if 
				if  w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.getitemnumber(1,'gasto_cred') > 0 then
						ll_found = w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.Find("tipo_cob_otro = '118'", 1, w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.rowcount())		
						
						IF ll_found = 0 THEN
						wf_ing_item_automatico('S','118')	// descuento 
						 END IF					

				end if 
				
				//VHFB -- INICIO -- PARA CODIGOS 4 Y 6 
				IF w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.Find("tipo_cob = '4'", 1, w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.rowcount()) > 0 THEN
					
						ll_found = w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.Find("tipo_cob_otro = '149'", 1, w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.rowcount())		
						
						IF ll_found = 0 THEN
								wf_ing_item_automatico('S','149')	// descuento 
						 END IF	
				END IF 
				
				IF w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.Find("tipo_cob = '6'", 1, w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.rowcount()) > 0 THEN
					
						ll_found = w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.Find("tipo_cob_otro = '150'", 1, w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.rowcount())		
						
						IF ll_found = 0 THEN
								wf_ing_item_automatico('S','150')	// descuento 
						 END IF	
				END IF 
				
				
				//VHFB -- TERMINO -- PARA CODIGOS 4 Y 6
				
				
		end if 
		
		//// descuento credito ------------------------------------------------------------------------------------------------------------------------
		gb_aplica = false
end if 

if w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.rowcount()>0 then
	
		w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.accepttext()
		w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.SetItem(1, "Subtotal",w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.GetItemNumber(1,"c_subtotal"))
		w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.accepttext()
		
end if 		




end subroutine

public subroutine wf_gatilla_descuentos_de ();INTEGER ll_found, li_fila2, li_cantidad2, li_monto2
string ls_rs_bs
real li_monto, li_calculo	, li_monto_cuota

ls_tipo_base=left(w_ingreso2.tab_ingreso.tp_be.dw_be_buscar_cliente.getitemstring(1,'rs_bs'),1)

if (gs_aplica_a ='M' or gs_aplica_a ='T') or  & 
  (gs_aplica_a ='C' and ls_tipo_base = 'L') 	or &		
  (gs_aplica_a ='C' and ls_tipo_base = 'A')  or	&	
  (gs_aplica_a ='C' and ls_tipo_base = 'D') or	&
  (gs_aplica_a ='C' and ls_tipo_base = 'R') OR	&
  (gs_aplica_a ='C' and ls_tipo_base = 'G') OR	&
  (gs_aplica_a ='C' and ls_tipo_base = 'F') 	&
  then
	
		gb_aplica = true

		
		//-------------------------------------------------------------------
		// VHFB - CONTROLAMOS PROCESO PARA MANTENCION
		//-------------------------------------------------------------------
	    if gs_aplica_a <> 'C' and (ls_tipo_base <> 'L'  and ls_tipo_base <> 'A' and ls_tipo_base <> 'D' and ls_tipo_base <> 'R' and ls_tipo_base <> 'F')    then
				
				// VHFB - validamos que no exista previamente un registro F
				ll_found = w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob = 'F'", 1, w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount())
				
				IF ll_found = 0 THEN
						wf_ing_item_automatico_de('F','')	
				 END IF 
				 
				// validamos que no existiera error en el ingreso de  F
				li_fila2 = w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob = 'F' ",1, w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount())
				if li_fila2 > 0 then
						li_cantidad2 = w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.getitemnumber(1, 'cantidad')
						li_monto2 = w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.getitemnumber(1, 'monto')
			    end if 
				
				if li_fila2 = 0  or li_cantidad2 = 0 or li_monto2 = 0 then
					gb_aplica = false
					w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.reset()
					return
				end if 
				
				// descuento credito ------------------------------------------------------------------------------------------------------------------------
				ll_found = w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob_otro = '132'", 1, w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount())		
				
				IF ll_found = 0 THEN
				wf_ing_item_automatico_de('S','132')	// descuento 
				 END IF				
				
				w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.accepttext()
				if  w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.rowcount()>0 then 
				
						if  w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.getitemnumber(1,'mora_mant') >0 then
							ll_found = w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob_otro = '130'", 1, w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount())		
							
							IF ll_found = 0 THEN
							wf_ing_item_automatico_de('S','130')	// descuento 
							 END IF										
						end if 
						if w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.getitemnumber(1,'gasto_mant') > 0 then
							ll_found = w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob_otro = '133'", 1, w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount())		
							
							IF ll_found = 0 THEN
							wf_ing_item_automatico_de('S','133')	// descuento 
							 END IF								
							
						end if 
						
				end if 
				//// descuento credito ------------------------------------------------------------------------------------------------------------------------

		end if  
		
		//-------------------------------------------------------------------
		// VHFB - CONTROLAMOS PROCESO PARA CUOTA
		//-------------------------------------------------------------------
	    if gs_aplica_a = 'C' or (gs_aplica_a ='T' and ls_tipo_base = 'L' ) or (gs_aplica_a ='T' and ls_tipo_base = 'A' )  or (gs_aplica_a ='T' and ls_tipo_base = 'D' ) or (gs_aplica_a ='T' and ls_tipo_base = 'R' )  or (gs_aplica_a ='T' and ls_tipo_base = 'F' ) then				
				// VHFB - validamos que no exista previamente un registro
				ll_found = w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob = 'E'", 1, w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount())
				
				IF ll_found = 0 THEN
						wf_ing_item_automatico_de('E','')	
				 END IF 				 
				// validamos que no existiera error en el ingreso de 
				li_monto_cuota=0
				li_fila2 = w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob = 'E' ",1, w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount())

				
				if li_fila2 > 0 then
					
						li_monto_cuota = w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.getitemnumber(li_fila2, 'monto')
						
						if li_monto_cuota = 0 or isnull(li_monto_cuota) then
							messagebox("Advertencia","Cuota no presenta monto por lo que no se puede continuar asignando los descuentos asociados.", StopSign!)
							return
						end if
					
						li_cantidad2 = w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.getitemnumber(1, 'cantidad')
						li_monto2 = w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.getitemnumber(1, 'monto')
			    end if 
				
				if li_fila2 = 0 or li_cantidad2 = 0 or li_monto2 = 0 then
					gb_aplica = false
					w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.reset()
					return
				end if 
				
				// descuento credito ------------------------------------------------------------------------------------------------------------------------
				ll_found = w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob_otro = '131'", 1, w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount())		
				
				IF ll_found = 0 THEN
					wf_ing_item_automatico_de('S','131')	// descuento 
				 END IF				

				
				if  w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.rowcount()>0 then
					
					if  w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.getitemnumber(1,'mora_cred') >0 then
							ll_found = w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob_otro = '102'", 1, w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount())		
							
							IF ll_found = 0 THEN
								wf_ing_item_automatico_de('S','102')	// descuento 
							 END IF							
							
					end if
					
					if w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.getitemnumber(1,'gasto_cred') > 0 then
							ll_found = w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob_otro = '118'", 1, w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount())		
							
							IF ll_found = 0 THEN
								wf_ing_item_automatico_de('S','118')	// descuento 
							 END IF		
				    end if 
					//VHFB -- INICIO -- PARA CODIGOS 4 Y 6 
					IF w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob = '4'", 1, w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount()) > 0 THEN
						
							ll_found = w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob_otro = '149'", 1, w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount())		
							
							IF ll_found = 0 THEN
									wf_ing_item_automatico_de('S','149')	// descuento 
							 END IF	
					END IF 
					
					IF w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob = '6'", 1, w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount()) > 0 THEN
						
							ll_found = w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob_otro = '150'", 1, w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount())		
							
							IF ll_found = 0 THEN
									wf_ing_item_automatico_de('S','150')	// descuento 
							 END IF	
					END IF 
					
					
					//VHFB -- TERMINO -- PARA CODIGOS 4 Y 6 						 
				end if 
				// descuento credito ------------------------------------------------------------------------------------------------------------------------				

			end if  
gb_aplica = false		


if w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount()>0 then
	
		w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.accepttext()
		w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1, "Subtotal",w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.GetItemNumber(1,"c_subtotal"))
		w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.accepttext()
		
end if 		

		
end if 
end subroutine

public subroutine wf_ing_item_automatico_de (string p_item, string p_codigo);string ls_tipo_cob_2
integer li_fila, t , li_fila2, ll_found, li_posicion
real li_monto, li_calculo 

w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.accepttext()
w_ingreso2.tab_ingreso.tp_be.cb_be_insertar.triggerevent(clicked!)
li_fila = w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount()

IF P_CODIGO <> '' THEN
		w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.getrow(),'tipo_cob_otro',P_CODIGO)
		w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.accepttext()
END IF 

IF ls_tipo_base = 'F' AND P_CODIGO = '' THEN
	// VHFB - INICIO
	ll_found = w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob = 'E'", 1, w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount())
	
	IF ll_found > 0 THEN
			RETURN
	 END IF 				 
	//VHFB - TREMINO
END IF 


w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.scrolltorow(li_fila)
w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(li_fila,'tipo_cob',p_item)

DWObject ldw_Object
ldw_Object = w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.Object.tipo_cob 
w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.Event ItemChanged(li_fila, ldw_Object,p_item )

IF ls_tipo_base = 'F' AND P_CODIGO = '' THEN
		ll_found = w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob = 'E'", 1, w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount())
		li_monto = w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.getitemnumber(ll_found,'monto')
		if isnull(li_monto)  or li_monto = 0 then
			return
		end if 
end if 

li_monto = 0 

if p_codigo <> '' then
	
	if ls_tipo_base <> 'L' AND ls_tipo_base <> 'A'  AND ls_tipo_base <> 'D'  AND ls_tipo_base <> 'F'  AND ls_tipo_base <> 'G' then
		w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.scrolltorow(w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount())
		w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setfocus()
		
		if w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount() > 0 then
			
			choose case p_codigo
				case '132'		
					for t = 1 to w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount()
						ls_tipo_cob_2 = w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.getitemstring(t,'tipo_cob')
						if ls_tipo_cob_2 = 'F' then
							li_monto =w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.getitemnumber(t,'monto')
							exit
						end if 
					next 										
				case '130'		
					li_monto = w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.getitemnumber(1,'mora_mant')
				case '133'		
					li_monto = w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.getitemnumber(1,'gasto_mant')
			end choose 		
			
			li_calculo =round(li_monto * (gd_descuento/100),0)
			w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount(), "monto",li_calculo )
			
			IF  p_codigo = '132' THEN
				wf_itemchange(w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount(), STRING(li_monto) )
			END IF
			
		end if 
	end if 
	
	if ls_tipo_base = 'L'  OR ls_tipo_base = 'A'   OR ls_tipo_base = 'D'  OR ls_tipo_base = 'R'   OR ls_tipo_base = 'F'   OR ls_tipo_base = 'G' then
		// vhfb -- inicio --para control de cuota de liberador
		w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.scrolltorow(w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount())
		w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setfocus()
		
		if w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount() > 0 then
			
			choose case p_codigo
				case '131'		
					for t = 1 to w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount()
						ls_tipo_cob_2 = w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.getitemstring(t,'tipo_cob')
						if ls_tipo_cob_2 = 'E' then
							li_monto =w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.getitemnumber(t,'monto')
							exit
						end if 
					next 	
				case '102'		
					li_monto = w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.getitemnumber(1,'mora_cred')
				case '118'		
					li_monto = w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.getitemnumber(1,'gasto_cred')
					
				case '149'		
					
					li_posicion =  w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob = '4'", 1, w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount())
					if li_posicion > 0 then
						li_monto = w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.getitemnumber(li_posicion,'monto')
					else
						li_monto = 0 
					end if 					
					
				case '150'		
					
					li_posicion =  w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob = '6'", 1, w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount())
					if li_posicion > 0 then
						li_monto = w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.getitemnumber(li_posicion,'monto')
					else
						li_monto = 0 
					end if 
					
															
			end choose 			
			
			if li_monto > 0 then
				li_calculo =round(li_monto * (gd_descuento/100),0)
			else 
				li_calculo =0
			end if  
			
			w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount(), "monto",li_calculo )

			
		end if 
	end if 
//		// vhfb -- termino --para control de cuota de liberador		
		
		
		
		
end if 
end subroutine

public subroutine wf_actualiza_cantidad_be ();// actualiza la cantidad de items
integer t , li_cantidad	, li_cuotas_mora,li_posicion
string ls_tipo_cob_2, ls_tipo_cob_2_otro, ls_busca
real lr_monto,  lr_monto2
li_cantidad=0

if ls_tipo_base = 'L'  or ls_tipo_base = 'A'   or ls_tipo_base = 'F'     or ls_tipo_base = 'R'     or ls_tipo_base = 'G'  THEN
	ls_busca = 'E'
ELSE
	ls_busca = 'F'
end if 
	
for t = 1 to w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount()
	ls_tipo_cob_2 = w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.getitemstring(t,'tipo_cob')
	if ls_tipo_cob_2 =ls_busca then
		li_cantidad =w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.getitemnumber(t,'cantidad')		
		lr_monto   =w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.getitemnumber(t,'monto')
		exit
	end if 
next 

// VHFB -- INICIO -- DETERMINA LA CANTIDAD DE CUOTAS EN MORA SEGUN LA BASE
li_cuotas_mora=w_ingreso2.tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'c_cuotas_mora')

if ls_tipo_base = 'O'  or ls_tipo_base = 'U'  THEN
		li_cuotas_mora=w_ingreso2.tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'c_cuotas_mora_m')
END IF 
IF ls_tipo_base = 'C'  THEN
		li_cuotas_mora=w_ingreso2.tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'c_cuotas_en_mora')
END IF 

//------------------------------------------------------------------------------------------------------------------------
// SE COMENTA PARA QUE EL DESCUENTO APLIQUE PARA TODAS LAS CUOTAS QUE SE QUIERAN PAGAR
// CAMBIO REQ - 24/10/2025
//------------------------------------------------------------------------------------------------------------------------
//if li_cantidad > li_cuotas_mora then
//   li_cantidad = li_cuotas_mora
//end if 
// VHFB -- TERMINO -- DETERMINA LA CANTIDAD DE CUOTAS EN MORA SEGUN LA BASE

t=1

if ls_busca = 'F'  THEN
	if li_cantidad >0 then
			for t = 1 to w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount()
				
				ls_tipo_cob_2 = w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.getitemstring(t,'tipo_cob')
				ls_tipo_cob_2_otro = w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.getitemstring(t,'tipo_cob_otro')
	
				choose case ls_tipo_cob_2_otro
					case '130'		
						lr_monto = w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.getitemnumber(1,'mora_mant')
					case '133'		
						lr_monto = w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.getitemnumber(1,'gasto_mant')
				case '149'		
					
					li_posicion =  w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob = '4'", 1, w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount())
					if li_posicion > 0 then
						lr_monto = w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.getitemnumber(li_posicion,'monto')					
					end if 					
				case '150'		
					li_posicion =  w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob = '6'", 1,w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount())
					if li_posicion > 0 then
						lr_monto = w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.getitemnumber(li_posicion,'monto')					
					end if 						
				end choose 	
	
				if ls_tipo_cob_2 = 'S' and  (ls_tipo_cob_2_otro = '132' or  ls_tipo_cob_2_otro = '130' or  ls_tipo_cob_2_otro = '133' or  ls_tipo_cob_2_otro = '149' or  ls_tipo_cob_2_otro = '150' ) then
									
				IF ls_tipo_cob_2_otro = '132' OR ls_tipo_cob_2_otro = '149'  OR ls_tipo_cob_2_otro = '150'  THEN
					lr_monto =(round(  (lr_monto * (gd_descuento/100) * li_cantidad),0)) 
				ELSE 
				    lr_monto =(round(lr_monto * (gd_descuento/100),0))
				END IF 
				
					w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(t,'monto',lr_monto)
					
				end if 
			
			next 
	end if 

end if 

if ls_busca = 'E'  THEN
		if li_cantidad >0 then
				for t = 1 to w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount()
					
					ls_tipo_cob_2 = w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.getitemstring(t,'tipo_cob')
					ls_tipo_cob_2_otro = w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.getitemstring(t,'tipo_cob_otro')
		
					choose case ls_tipo_cob_2_otro
						case '102'		
							lr_monto = w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.getitemnumber(1,'mora_cred')
						case '118'		
							lr_monto = w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.getitemnumber(1,'gasto_cred')
					case '149'		
						
						li_posicion =  w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob = '4'", 1, w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount())
						if li_posicion > 0 then
							lr_monto = w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.getitemnumber(li_posicion,'monto')					
						end if 					
					case '150'		
						li_posicion =  w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob = '6'", 1,w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount())
						if li_posicion > 0 then
							lr_monto = w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.getitemnumber(li_posicion,'monto')					
						end if 						
					end choose 		
		
					if ls_tipo_cob_2 = 'S' and  (ls_tipo_cob_2_otro = '131'  or  ls_tipo_cob_2_otro = '102' or  ls_tipo_cob_2_otro = '118' or  ls_tipo_cob_2_otro = '149' or  ls_tipo_cob_2_otro = '150') then	
						//w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(t,'cantidad',li_cantidad)
						
						IF ls_tipo_cob_2_otro = '131' OR ls_tipo_cob_2_otro = '149'  OR ls_tipo_cob_2_otro = '150' THEN 							 
							lr_monto =(round(  (lr_monto * (gd_descuento/100) * li_cantidad),0)) 
						ELSE 
							lr_monto =(round(lr_monto * (gd_descuento/100),0)) 
						END IF  
				
						  w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(t,'monto',lr_monto)
						  
					end if 
				
				next 
				
				 // VHFB -- INICIO -- RECALCULO E IVA
				
				li_posicion =  w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob = 'E'", 1, w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount())		// iva
				
				IF  li_posicion > 0  THEN	
					wf_itemchange(w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount(), '1' )
				END IF
				 // VHFB -- TERMINO -- RECALCULO E IVA		
						 
		end if 
end if 
 







end subroutine

public subroutine wf_borra_descuentos_de (string p_tipo_cobro);integer t_fila, t_fila2	

// vhfb --  elimina lsa filas automaticas si se elimna el item de mantencion o cuotas

t_fila = 0

if 	p_tipo_cobro =  'F'  then	// vhfb
		if w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount() > 0 then
				t_fila = w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob_otro = '132' ",1, w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount())
				if t_fila > 0 then
					w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.deleterow(t_fila)
				end if
				t_fila = w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob_otro = '130' ",1, w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount())
				if t_fila > 0 then
					w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.deleterow(t_fila)
				end if
				t_fila = w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob_otro = '133' ",1, w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount())
				if t_fila > 0 then
					w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.deleterow(t_fila)
				end if
		end if 
end if 
if 	p_tipo_cobro =  'E'  then	// vhfb
		if w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount() > 0 then
				t_fila = w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob_otro = '131' ",1, w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount())
				if t_fila > 0 then
					w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.deleterow(t_fila)
				end if
				t_fila = w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob_otro = '102' ",1, w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount())
				if t_fila > 0 then
					w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.deleterow(t_fila)
				end if
				t_fila = w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob_otro = '118' ",1, w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount())
				if t_fila > 0 then
					w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.deleterow(t_fila)
				end if
		end if 
end if 

end subroutine

public subroutine wf_borra_descuentos (string p_tipo_cob);integer t_fila, t_fila2	

// vhfb --  elimina lsa filas automaticas si se elimna el item de cuota

t_fila = 0

if p_tipo_cob = 'E' then
		if w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.rowcount() > 0 then
				t_fila = w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.Find("tipo_cob_otro = '131' ",1, w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.rowcount())
				if t_fila > 0 then
					w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.deleterow(t_fila)
				end if
				t_fila = w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.Find("tipo_cob_otro = '102' ",1, w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.rowcount())
				if t_fila > 0 then
					w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.deleterow(t_fila)
				end if
				t_fila = w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.Find("tipo_cob_otro = '118' ",1, w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.rowcount())
				if t_fila > 0 then
					w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.deleterow(t_fila)
				end if
		end if 
end if 


end subroutine

public subroutine wf_cargar_credito_m (string as_ctto, string as_tipo_cob, long al_cantidad, string as_tipo_ctto, long al_fila_m, string as_columna);Long		ll_tot_reg_m,ll_fila_m,ll_indi_m,ll_cantidad_m,ll_fila,ll_tot_reg_mult
String		ls_tipo_mov_m,ls_moneda_m,ls_ctto_mult,ls_mpbase_mult,ls_mpserie_mult,ls_tipodoc_mult
Double	ldb_uf_m,ldb_monto_item_m,ll_cupon_m,ll_descuento_mult,ll_rut_mult,ll_mpnumero_mult,ll_mpnro_cupon_mult,ll_nro_cupon_mult,ldb_nufdia_mult,ldb_totaliva_mult,ldb_totalcto_mult,&
			ldb_cal_uf,ll_suma_mora,ll_suma_gasto,ll_c_subtotal


ll_tot_reg_m					= dw_multiproducto.retrieve(as_ctto,as_tipo_cob,gi_rut,al_cantidad,as_tipo_ctto)
dw_multiproducto_det.retrieve(as_ctto,as_tipo_cob,gi_rut,al_cantidad,'DET')
ll_suma_mora					= 0
ll_suma_gasto					= 0
tab_ingreso.tp_ci.dw_gastos_ci.setitem(1,'mora_cred',0)
tab_ingreso.tp_ci.dw_gastos_ci.setitem(1,'gasto_cred',0)
tab_ingreso.tp_ci.dw_gastos_ci.setitem(1,'gasto_mant',0)
tab_ingreso.tp_ci.dw_gastos_ci.setitem(1,'mora_mant',0)
tab_ingreso.tp_ci.dw_gastos_ci.setitem(1,'mora',0)
tab_ingreso.tp_ci.dw_gastos_ci.setitem(1,'gastos_cob',0)
tab_ingreso.tp_ci.dw_gastos_ci.accepttext()
if ll_tot_reg_m > 0 then
	if as_columna='tipo_cob' then
		ll_fila_m						= al_fila_m
		for ll_indi_m=1 to ll_tot_reg_m
			ls_tipo_mov_m			= dw_multiproducto.getitemstring(ll_indi_m,'tipo_mov')
			ll_cantidad_m			= dw_multiproducto.getitemnumber(ll_indi_m,'cantidad')
			ldb_uf_m					= dw_multiproducto.getitemnumber(ll_indi_m,'monto_uf')
			ldb_monto_item_m	= dw_multiproducto.getitemnumber(ll_indi_m,'montoitem')
			ls_moneda_m			= dw_multiproducto.getitemstring(ll_indi_m,'moneda')
			ll_cupon_m				= dw_multiproducto.getitemnumber(ll_indi_m,'mpnro_cupon')
			if ll_indi_m > 1 and ls_tipo_mov_m<>'J' and ls_tipo_mov_m<>'G' and ls_tipo_mov_m<>'R' and ls_tipo_mov_m<>'P' then
				ll_fila_m				= tab_ingreso.tp_ci.dw_detalle_ci.insertrow(0)
				tab_ingreso.tp_ci.dw_detalle_ci.SetItem(ll_fila_m, 'uf', gd_uf)
			end if
			if ls_tipo_mov_m<>'J' and ls_tipo_mov_m<>'G' and ls_tipo_mov_m<>'R' and ls_tipo_mov_m<>'P' then
				tab_ingreso.tp_ci.dw_detalle_ci.setitem(ll_fila_m,'tipo_cob', ls_tipo_mov_m)
				tab_ingreso.tp_ci.dw_detalle_ci.setitem(ll_fila_m,'cantidad', ll_cantidad_m)
				if ls_tipo_mov_m='D' or ls_tipo_mov_m='X' or ls_tipo_mov_m='V' then ls_moneda_m='1'
				if ls_moneda_m = '1' then
					tab_ingreso.tp_ci.dw_detalle_ci.SetItem(ll_fila_m, 'moneda','P')
					tab_ingreso.tp_ci.dw_detalle_ci.setitem(ll_fila_m,'monto_uf', ldb_uf_m)
					tab_ingreso.tp_ci.dw_detalle_ci.setitem(ll_fila_m,'monto', ldb_monto_item_m)
				elseif ls_moneda_m = '2' then
					tab_ingreso.tp_ci.dw_detalle_ci.SetItem(ll_fila_m, 'moneda','U')
					tab_ingreso.tp_ci.dw_detalle_ci.setitem(ll_fila_m,'monto_uf',  ldb_uf_m)
					tab_ingreso.tp_ci.dw_detalle_ci.setitem(ll_fila_m,'monto', ldb_monto_item_m)
				end if
				tab_ingreso.tp_ci.dw_detalle_ci.setitem(ll_fila_m,'estado','S')
			end if
			if ls_tipo_mov_m='G' then
				tab_ingreso.tp_ci.dw_gastos_ci.setitem(1,'mora_cred',ldb_monto_item_m)
				ll_suma_mora			= ll_suma_mora + ldb_monto_item_m
			elseif ls_tipo_mov_m='J' then
				tab_ingreso.tp_ci.dw_gastos_ci.setitem(1,'gasto_cred',ldb_monto_item_m)
				ll_suma_gasto			= ll_suma_gasto + ldb_monto_item_m
			elseif ls_tipo_mov_m='R' then
				tab_ingreso.tp_ci.dw_gastos_ci.setitem(1,'gasto_mant',ldb_monto_item_m)
				ll_suma_gasto			= ll_suma_gasto + ldb_monto_item_m
			elseif ls_tipo_mov_m = 'P' then
				tab_ingreso.tp_ci.dw_gastos_ci.setitem(1,'mora_mant',ldb_monto_item_m)
				ll_suma_mora			= ll_suma_mora + ldb_monto_item_m
			end if
		next
		ll_c_subtotal						= round(tab_ingreso.tp_ci.dw_detalle_ci.getitemnumber(1,'c_subtotal'),0)
		tab_ingreso.tp_ci.dw_gastos_ci.setitem(1,'subtotal',ll_c_subtotal)
		tab_ingreso.tp_ci.dw_gastos_ci.setitem(1,'mora',ll_suma_mora)
		tab_ingreso.tp_ci.dw_gastos_ci.setitem(1,'gastos_cob',ll_suma_gasto)
		tab_ingreso.tp_ci.dw_gastos_ci.accepttext()

	elseif as_columna='cantidad' then
		for ll_indi_m=1 to ll_tot_reg_m
			ls_tipo_mov_m			= dw_multiproducto.getitemstring(ll_indi_m,'tipo_mov')
			ll_cantidad_m			= dw_multiproducto.getitemnumber(ll_indi_m,'cantidad')
			ldb_uf_m					= dw_multiproducto.getitemnumber(ll_indi_m,'monto_uf')
			ldb_monto_item_m	= dw_multiproducto.getitemnumber(ll_indi_m,'montoitem')
			ls_moneda_m			= dw_multiproducto.getitemstring(ll_indi_m,'moneda')
			ll_cupon_m				= dw_multiproducto.getitemnumber(ll_indi_m,'mpnro_cupon')
			ll_fila						= tab_ingreso.tp_ci.dw_detalle_ci.find("tipo_cob = '"+ ls_tipo_mov_m +"' ",1,ll_tot_reg_m)
			if isnull(ll_fila) then ll_fila=0
			if ll_fila = 0 and ls_tipo_mov_m<>'J' and ls_tipo_mov_m<>'G' and ls_tipo_mov_m<>'R' and ls_tipo_mov_m<>'P' then
				ll_fila					= tab_ingreso.tp_ci.dw_detalle_ci.insertrow(0)
			end if
			if ls_tipo_mov_m<>'J' and ls_tipo_mov_m<>'G' and ls_tipo_mov_m<>'R' and ls_tipo_mov_m<>'P' then
				tab_ingreso.tp_ci.dw_detalle_ci.setitem(ll_fila,'tipo_cob', ls_tipo_mov_m)
				tab_ingreso.tp_ci.dw_detalle_ci.setitem(ll_fila,'cantidad', ll_cantidad_m)
				if ls_tipo_mov_m='D' or ls_tipo_mov_m='X' or ls_tipo_mov_m='V' then ls_moneda_m='1'
	//			if (ls_tipo_mov_m='E' or ls_tipo_mov_m='F') and ll_cantidad_m > 1 then
	//				ldb_uf_m				= round(ldb_uf_m / ll_cantidad_m,4)
	//			end if
				if ls_moneda_m = '1' then
					tab_ingreso.tp_ci.dw_detalle_ci.SetItem(ll_fila, 'moneda','P')
					tab_ingreso.tp_ci.dw_detalle_ci.setitem(ll_fila,'monto_uf', round( ldb_uf_m,4))
					tab_ingreso.tp_ci.dw_detalle_ci.setitem(ll_fila,'monto', ldb_monto_item_m)
				elseif ls_moneda_m = '2' then
					tab_ingreso.tp_ci.dw_detalle_ci.SetItem(ll_fila, 'moneda','U')
					tab_ingreso.tp_ci.dw_detalle_ci.setitem(ll_fila,'monto_uf', round( ldb_uf_m,4))
					tab_ingreso.tp_ci.dw_detalle_ci.setitem(ll_fila,'monto', ldb_monto_item_m)
				end if
				tab_ingreso.tp_ci.dw_detalle_ci.setitem(ll_fila,'estado','S')
			end if
			if ls_tipo_mov_m='G' then
				tab_ingreso.tp_ci.dw_gastos_ci.setitem(1,'mora_cred',ldb_monto_item_m)
				ll_suma_mora			= ll_suma_mora + ldb_monto_item_m
			elseif ls_tipo_mov_m='J' then
				tab_ingreso.tp_ci.dw_gastos_ci.setitem(1,'gasto_cred',ldb_monto_item_m)
				ll_suma_gasto			= ll_suma_gasto + ldb_monto_item_m
			elseif ls_tipo_mov_m='R' then
				tab_ingreso.tp_ci.dw_gastos_ci.setitem(1,'gasto_mant',ldb_monto_item_m)
				ll_suma_gasto			= ll_suma_gasto + ldb_monto_item_m
			elseif ls_tipo_mov_m = 'P' then
				tab_ingreso.tp_ci.dw_gastos_ci.setitem(1,'mora_mant',ldb_monto_item_m)
				ll_suma_mora			= ll_suma_mora + ldb_monto_item_m
			end if
		next
		ll_c_subtotal						= round(tab_ingreso.tp_ci.dw_detalle_ci.getitemnumber(1,'c_subtotal'),0)
		tab_ingreso.tp_ci.dw_gastos_ci.setitem(1,'subtotal',ll_c_subtotal)
		tab_ingreso.tp_ci.dw_gastos_ci.setitem(1,'mora',ll_suma_mora)
		tab_ingreso.tp_ci.dw_gastos_ci.setitem(1,'gastos_cob',ll_suma_gasto)
		tab_ingreso.tp_ci.dw_gastos_ci.accepttext()
	end if
	tab_ingreso.tp_ci.dw_detalle_ci.accepttext()
//else
//	if as_columna='cantidad' then
//		if as_tipo_cob = 'S' then
//			ll_tot_reg_mult				= dw_multiproducto.rowcount()
//			if ll_tot_reg_mult > 0 then
//				ll_fila_m					= dw_multiproducto.insertrow(0)
//				ll_descuento_mult		= tab_ingreso.tp_ci.dw_detalle_ci.getitemnumber(al_fila_m,'c_total_linea')
//				ls_ctto_mult				= dw_multiproducto.getitemstring(1,'contrato')
//				ll_rut_mult				= dw_multiproducto.getitemnumber(1,'rut')
//				ls_mpbase_mult		= dw_multiproducto.getitemstring(1,'mpbase')
//				ls_mpserie_mult		= dw_multiproducto.getitemstring(1,'mpserie')
//				ll_mpnumero_mult		= dw_multiproducto.getitemnumber(1,'mpnumero')
//				ll_mpnro_cupon_mult	= dw_multiproducto.getitemnumber(1,'mpnro_cupon')
//				ll_nro_cupon_mult		= dw_multiproducto.getitemnumber(1,'nro_cupon')
//				ls_tipodoc_mult			= dw_multiproducto.getitemstring(1,'tipodoc')
//				ldb_nufdia_mult		= dw_multiproducto.getitemnumber(1,'nufdia')
//				ldb_totaliva_mult		= dw_multiproducto.getitemnumber(1,'totaliva')
//				ldb_totalcto_mult		= dw_multiproducto.getitemnumber(1,'totalcto')
//
//				ldb_cal_uf				= round(ll_descuento_mult / gd_uf,4)
//				dw_multiproducto.setitem(ll_fila_m, 'monto_uf', ldb_cal_uf)
//				dw_multiproducto.setitem(ll_fila_m,'total_uf',ldb_cal_uf)
//				dw_multiproducto.setitem(ll_fila_m,'moneda','1')
//				dw_multiproducto.setitem(ll_fila_m,'tipomoneda','PESO')
//				dw_multiproducto.setitem(ll_fila_m,'montoitem',ll_descuento_mult)
//				dw_multiproducto.setitem(ll_fila_m,'totalitem',ll_descuento_mult)
//				dw_multiproducto.setitem(ll_fila_m,'tipo_mov','S')
//				dw_multiproducto.setitem(ll_fila_m,'cantidad',1)
//				dw_multiproducto.accepttext()
//			end if
//		end if
//	end if
end if
end subroutine

public subroutine wf_limpiar_multiproducto (long al_row);String		ls_nulo

Setnull(ls_nulo)
messagebox("Advertencia","No es posible Ingresar Item de Pago a Contrato Asociado Multiproducto, debe Ingresar un C.I. a Contrato Base M")
tab_ingreso.tp_be.dw_detalle_be.SetItem(al_row, "monto", 0)
tab_ingreso.tp_be.dw_detalle_be.SetItem(al_row, "cantidad", 0)
tab_ingreso.tp_be.dw_detalle_be.SetItem(al_row, "tipo_cob", ls_nulo)
tab_ingreso.tp_be.dw_detalle_be.accepttext()
tab_ingreso.tp_be.dw_detalle_be.setfocus()
tab_ingreso.tp_be.dw_detalle_be.setcolumn('tipo_cob')
end subroutine

public subroutine wf_itemchange (long row, string data);string		is_columna,ls_tipo_cob,ls_moneda,ls_tipo_cob_aux,ls_estado_cadena,ls_descrip_estado,ls_tipo_comp,ls_texto,ls_nulo,ls_pasa,ls_string,&
			ls_moneda_ctto,ls_pasa_valida,ls_cod_dscto,ls_moneda_insert,sw_ok,ls_otro_dscto,ls_tipo_cob_dscto,ls_moneda_prod,ls_codigo_dscto,&
			ls_tipo_l,ls_codigo_otro_cur,ls_tipo_s,ls_cod_dscto_comer,ls_tipo_cob_serv,ls_tipo_servicio,ls_monda_det
long 		il_monto,fila,ii_dmora, ii_mora_cobro,ii_inc_gastos, ii_cantidad, ll_fila,ll_factor_peso,ll_count_e,ll_fila_reg,ll_monto,ll_cuota_ini,ll_cuota_fin,&
			ll_ctas,ll_count_reg,ll_folio,ll_ctas_pagadas_1,ll_ctas_pagadas_2,ll_ctas_pagadas,ll_cod_seguro,ll_ctas_pag_m,ll_fila_iva,ll_iva_recalc,&
			ll_tot_reg,ll_indi,ll_res,ll_sum_monto_abono,ll_monto_mant,ll_monto_final_mant,ll_count_tipo,ll_cant_e,ll_new_iva,ll_fila_dscto,ll_monto_final,&
			ll_monto_cred,ll_monto_final_cred,ll_res_abono,ll_monto_mora_cred,ll_monto_mora_mant,ll_new_seg,ll_fila_gasto,ll_resp_m,ll_resp_f,&
			ll_fila_cred,ll_fila_mant,ll_count_adic,ll_fila_pie,ll_row,ll_gasto_cob,ll_mora,ll_incluir_gastos,ll_cod_parque,ll_count_benef,ll_tot_reg_benef,ll_fila_benef,&
			ll_ctas_pac_pie,ll_ctas_pag_pie,ll_fila_m,ll_fila_d,ll_new_m,ll_count_f,ll_crear,ll_fila_fm,ll_fila_iva_a,ll_nulo,ll_cuotas_con_iva,ll_count_pie_pac,ll_fila_a,&
			ll_codigo_servicio,ll_plazo,ll_cod_servicio, ll_plazo_serv,ll_count_crem,ll_contar,ll_sum_reg,ll_sw_pago_reg,ll_fila_invalid,ll_count_hijo
double 	id_im, id_gc, id_valor_cuota,ld_monto,ld_pie_pactado,ll_monto_cta,ldb_prima,ldb_uf,ll_monto_pie_ingreso,ldb_valor_pie_reg,ll_monto_pago,ll_mora_cred,&
			ll_mora_mant,ll_gastos_cred,ll_gastos_mant,ll_suma_total,ldb_iva,ll_monto_cuota_reg,ll_iva_f,ll_iva_p,ll_gasto_mant,ll_iva_r,ll_monto_pie_rez,ll_iva_pie_rez,&
			ll_valor_cuota_f,ldb_valor_def_pie,ldb_valor_def_reg,ldb_pie_pesos,ldb_monto_dscto,ll_valor_serv,ll_valor_dscto_comer,ll_monto_det,ldb_valor_sumado,&
			ldb_valor_cuota,ldb_valor_seg,ldb_val_cta_ctto,ldb_valor_cuota_peso
Datetime	ldt_fecha_hoy

w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.accepttext()
Setnull(ll_nulo)
il_modif ++
//gl_iva_exento_f	= 0
ll_sw_pago_reg	= 0
sw_ok				= 'S'
ll_count_tipo		= 0
ll_ctas				= 0
ll_ctas_pagadas_1	= 0
ll_ctas_pagadas_2	= 0
ll_ctas_pagadas	= 0
if isnull(il_cantidad_malo) then il_cantidad_malo=0
SELECT sysdate INTO :gdt_fec_sistema FROM "TASA" WHERE "TASA"."LOOK" = 1   ;
if gs_base='O' or gs_base='C' or gs_base='U' or gs_base='M' then
	SELECT	"OFERTA_V"."CTA_PAG_M"  
	INTO 		:ll_ctas_pag_m  
	FROM 	"OFERTA_V",   "CADENA"  
	WHERE 	( "OFERTA_V"."SERIE" = "CADENA"."SERIE" ) and  
				( "OFERTA_V"."NRO_OFERTA" = "CADENA"."NUMERO" ) and  
				( ( "CADENA"."CODIGO" = :gs_base ) AND  
				( "OFERTA_V"."SERIE" = :gs_serie ) AND  
				( "OFERTA_V"."NRO_OFERTA" = :gi_numero ) )   
	UNION   
	SELECT 	"CONTRATO"."CTA_PAG_M"  
	FROM 	"CADENA",   "CONTRATO"  
	WHERE 	( "CADENA"."SERIE" = "CONTRATO"."SERIE_C" ) and  
				( "CADENA"."NUMERO" = "CONTRATO"."NRO_CONTRATO" ) and  
				( ( "CADENA"."CODIGO" = :gs_base ) AND  
				( "CADENA"."SERIE" = :gs_serie ) AND  
				( "CADENA"."NUMERO" = :gi_numero ) )   ;
	if isnull(ll_ctas_pag_m) then ll_ctas_pag_m=0
end if
ls_tipo_comp						= gs_tipo_cobro
setnull(ls_nulo)
ii_inc_gastos 						= 1
is_columna 							= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.GetColumnName()
ll_folio								= long(w_ingreso2.tab_ingreso.tp_be.sle_numero_be.text)
ldt_fecha_hoy						= datetime(date(gdt_fec_sistema),time('00:00:00'))
ll_tot_reg							= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount()
if ll_tot_reg>0 then
	ll_count_reg 					= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob ='A' or tipo_cob ='Q'",1, ll_tot_reg)
	if ll_count_reg=0 or isnull(ll_count_reg) then
		UPDATE	"DETALLE_PAGO_PIE"  
		SET 		"TIPO_COB" = null,   
					"FOLIO" = null,   
					"CAJA" = null,   
					"USUARIO" = null,   
					"FECHA_PAGO" = null,   
					"MONTO_PIE_PAGADO_PESO" = null,
					"ESTADO" = 'P'  
		WHERE  ( "DETALLE_PAGO_PIE"."BASE" = :gs_base ) AND  
				 ( "DETALLE_PAGO_PIE"."SERIE" = :gs_serie ) AND  
				 ( "DETALLE_PAGO_PIE"."NUMERO" = :gi_numero ) AND  
				 ( "DETALLE_PAGO_PIE"."TIPO_COB" = :gs_tipo_cobro ) AND  
				 ( "DETALLE_PAGO_PIE"."FOLIO" = :ll_folio ) AND  
				 ( "DETALLE_PAGO_PIE"."FECHA_PAGO" = :gd_fecha_pago_plazo )   
		USING		sqlca;
		if sqlca.sqlcode=0 then
			commit;
		else
			rollback;
		end if
	end if
end if
ls_tipo_cob			= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.getitemstring(w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.getrow(),'tipo_cob')
ll_count_hijo		= f_retorna_cant_ctomp_hijos(gs_base,gs_serie,gi_numero)
if ((ls_tipo_cob='E' or ls_tipo_cob='F' or ls_tipo_cob='A' ) and ll_count_hijo > 0) or gs_base='M' then
	wf_limpiar_multiproducto(row)
else
	if w_ingreso2.tab_ingreso.tp_be.dw_datos_be.rowcount()>0 then 
		if gs_rezago = "S" then
			w_ingreso2.tab_ingreso.tp_be.rb_be_uf.visible			= true
			w_ingreso2.tab_ingreso.tp_be.rb_be_peso.visible		= true
			if w_ingreso2.tab_ingreso.tp_be.rb_be_uf.checked=true then 
				w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.getrow(), "moneda",'U')
			elseif w_ingreso2.tab_ingreso.tp_be.rb_be_peso.checked=true then 
				w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.getrow(), "moneda",'P')
			end if
		else
			if ls_tipo_cob<>'M' then
				w_ingreso2.tab_ingreso.tp_be.rb_be_uf.visible		= false
				w_ingreso2.tab_ingreso.tp_be.rb_be_peso.visible	= false
				w_ingreso2.tab_ingreso.tp_be.rb_be_peso.checked	= true
				if w_ingreso2.tab_ingreso.tp_be.rb_be_uf.checked=true then 
					w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.getrow(), "moneda",'U')
				elseif w_ingreso2.tab_ingreso.tp_be.rb_be_peso.checked=true then 
					w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.getrow(), "moneda",'P')
				end if
			end if
		end if
		ls_estado_cadena	= w_ingreso2.tab_ingreso.tp_be.dw_datos_be.getitemstring(1,'cadena_estado')
		ll_cod_parque		= w_ingreso2.tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'cadena_cod_parque')
		SELECT	"ESTADO"."NOMBRE_ESTADO"  
		INTO 		:ls_descrip_estado  
		FROM 	"ESTADO"  
		WHERE 	"ESTADO"."COD_ESTADO" = :ls_estado_cadena ;
	end if
	if w_ingreso2.tab_ingreso.tp_be.rb_be_afecta.checked=true then
		w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.getrow(), "iva", idb_iva)
	end if
	w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.accepttext()
	if ls_estado_cadena='S' then
		ll_tot_reg							= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount()
		if ll_tot_reg>1 then
			for ll_indi = 1 to ll_tot_reg
				ls_tipo_cob_aux			= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.getitemstring(ll_indi,'tipo_cob')
				if ls_tipo_cob = ls_tipo_cob_aux then 
					ll_count_tipo ++
					if ll_count_tipo = 2 then
						messagebox("Advertencia","No puede Ingresar Tipo Cobro "+ls_tipo_cob+" Duplicado")
						w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.deleterow(ll_indi)
						fila 					= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.scrolltorow(fila)
						w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.scrolltorow(fila)
						w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(fila, "uf", gd_uf)
						if w_ingreso2.tab_ingreso.tp_be.rb_be_afecta.checked=true then
							w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(fila, "iva", idb_iva)
						end if
						w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(fila, "folio", 0)
						w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(fila, "estado", 'N')
						w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(fila, "uf", gd_uf)
						if w_ingreso2.tab_ingreso.tp_be.rb_be_uf.checked=true then
							w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(fila, "moneda",'U')
						else
							w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(fila, "moneda",'P')
						end if
						setnull(ls_tipo_cob);setnull(is_columna)
						w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.scrolltorow(row)
						w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setfocus()
						w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setcolumn('tipo_cob')
						exit
					end if
				end if
			next
		end if	

		
		w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.accepttext()
		w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1, "Subtotal",w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.GetItemNumber(1,"c_subtotal"))  
		w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.accepttext()
		fila 							= row
		
		
		IF is_columna = "monto" or is_columna='monto_uf' THEN
			w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.accepttext()
			if is_columna = "monto" then
				ld_monto					= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.getitemnumber(row,'monto')
			elseif  is_columna='monto_uf' then
				ld_monto					= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.getitemnumber(row,'monto_uf')
			end if
			ll_monto_cuota_reg		= tab_ingreso.tp_be.dw_detalle_be.getitemnumber(tab_ingreso.tp_be.dw_detalle_be.getrow(),'c_total_linea')
			ll_fila_fm						= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob = 'F' or tipo_cob='E'", 1, w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount())
			if ll_fila_fm > 0 and gs_tipo_cobro = 'BA' then
				ii_cantidad 				= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.GetItemNumber(ll_fila_fm, "cantidad")
			else
				ii_cantidad 				= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.GetItemNumber(row, "cantidad")
			end if
			if isnull(ii_cantidad) or ii_cantidad = 0 then ii_cantidad=1
			ll_cuota_ini					= ll_ctas_pag_m + 1
			ll_cuota_fin					= (ll_cuota_ini + ii_cantidad) - 1
			
			
			wf_cargar_monto(ld_monto, il_cantidad_malo, row, ld_pie_pactado,ll_cuota_ini,ll_cuota_fin, ii_cantidad )
	
		end if
		if isvalid(w_ingreso2) then
			w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.accepttext()
			if w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.rowcount() = 0 then w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.insertrow(0)
			ll_gasto_cob					= w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.getitemnumber(1,'gastos_cob')
			ll_mora						= w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.getitemnumber(1,'mora')
			ll_incluir_gastos			= w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.getitemnumber(1,'incluir_gastos')
			if ll_gasto_cob > 0 then
				// Mantener Valores
			else
				w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1,'gastos_cob', 0)
				w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1,'gasto_cred', 0)
				w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1,'gasto_mant', 0)
			end if
			if ll_mora > 0 then
				// Mantener Valores
			else
				w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1,'mora', 0)
				w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1,'mora_cred', 0)
				w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1,'mora_mant', 0)
			end if
			if ll_incluir_gastos = 0 then
				// Mantener Valores
			else
				w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1,'incluir_gastos', 1)
			end if
			w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1, "Subtotal",w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.GetItemNumber(1,"c_subtotal"))
			w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.accepttext()
			w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.accepttext()
		end if
		fila 						= row
		Long	ll_cantidad
		ll_cantidad				= Long(w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount())
		IF is_columna = "cantidad" AND (ls_tipo_cob = "E" or ls_tipo_cob = "U") AND gs_rezago <> "S" and gs_base <> 'C' AND w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount() > 0  THEN
			if w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.GetItemNumber(row, "cantidad") > 0 then
				wf_actualizar_abono(ls_tipo_cob)
				ii_cantidad 		= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.GetItemNumber(row, "cantidad")
				
				DECLARE x2 CURSOR FOR  
				SELECT	"SEGURO_ASOCIADOS"."COD_SEGURO"  
				FROM 	"SEGURO_ASOCIADOS"  
				WHERE ( "SEGURO_ASOCIADOS"."BASE" = :gs_base ) AND  
						  ( "SEGURO_ASOCIADOS"."SERIE" = :gs_serie ) AND  
						  ( "SEGURO_ASOCIADOS"."NUMERO" = :gi_numero ) AND  
						  ( "SEGURO_ASOCIADOS"."ESTADO_REG" = 0 ) AND  
						  ( "SEGURO_ASOCIADOS"."ESTADO_SEGURO" = 'A' )   
	//					  ( "SEGURO_ASOCIADOS"."COD_SEGURO" <> 8 )
				USING	sqlca;
				open x2;
				if sqlca.sqlcode=0 then
					do while sqlca.sqlcode=0
						fetch x2 into :ll_cod_seguro;
						if not isnull(ll_cod_seguro) then
							ll_fila		= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob = '"+string(ll_cod_seguro)+"'",1, w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount())
							w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(ll_fila,'cantidad',ii_cantidad)
						end if
						setnull(ll_cod_seguro)
					loop
				end if
				close x2;
				w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.accepttext()
				if (gs_base='O' or gs_base='U' or gs_base='M') and w_ingreso2.tab_ingreso.tp_be.dw_datos_be.DataObject='d_datos_cuenta_ci_oferta' then
					ll_ctas				= w_ingreso2.tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'pago_oferta_nro_cuotas')
					ll_ctas_pagadas	= w_ingreso2.tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'oferta_v_cta_pag_s')
				elseif gs_base='P' and w_ingreso2.tab_ingreso.tp_be.dw_datos_be.DataObject='d_datos_cuenta_ci_pagare' then
					ll_ctas				= w_ingreso2.tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'pagare_plazo')
					ll_ctas_pagadas_1	= w_ingreso2.tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'pagare_cta_pag_la')
					ll_ctas_pagadas_2	= w_ingreso2.tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'pagare_cta_pag_isa')
					ll_ctas_pagadas	= ll_ctas_pagadas_1 + ll_ctas_pagadas_2
				elseif gs_base='L' and w_ingreso2.tab_ingreso.tp_be.dw_datos_be.DataObject='d_datos_cuenta_ci_liberador' then
					ll_ctas				= w_ingreso2.tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'pago_liberador_nro_cuotas')
					ll_ctas_pagadas	= w_ingreso2.tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'anexo_liberador_cta_pag_m')
				elseif (gs_base='F' or gs_base='G' or gs_base='V') and w_ingreso2.tab_ingreso.tp_be.dw_datos_be.DataObject='d_datos_cuenta_ci_funeraria' then
					ll_ctas				= w_ingreso2.tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'producto_pago_plazo')
					ll_ctas_pagadas	= w_ingreso2.tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'producto_anexo_cuotas_pag')
				elseif gs_base='D' and w_ingreso2.tab_ingreso.tp_be.dw_datos_be.DataObject='d_datos_cuenta_ci_derecho' then
					ll_ctas				= w_ingreso2.tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'derecho_plazo')
					ll_ctas_pagadas_1	= w_ingreso2.tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'derecho_cta_pag_la')
					ll_ctas_pagadas_2	= w_ingreso2.tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'derecho_cta_pag_isa')
					ll_ctas_pagadas	= ll_ctas_pagadas_1 + ll_ctas_pagadas_2
				elseif gs_base='A' and w_ingreso2.tab_ingreso.tp_be.dw_datos_be.DataObject='d_datos_cuenta_ci_aumento_capacidad' then
					ll_ctas				= w_ingreso2.tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'pago_aumento_nro_cuotas')
					ll_ctas_pagadas	= w_ingreso2.tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'anexo_aumento_cta_pag_m')
				elseif gs_base='R' and w_ingreso2.tab_ingreso.tp_be.dw_datos_be.DataObject='dw_repacta_mant_descripcion_traspaso' then
					ll_ctas				= w_ingreso2.tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'cuotas_pactadas')
					ll_ctas_pagadas	= w_ingreso2.tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'ctas_pagadas')
				end if
				if (ll_ctas_pagadas + ii_cantidad) > ll_ctas then
					messagebox("Advertencia","Cantidad de Cuotas sobrepasa al Plazo del Crédito")
		//			w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(row, "monto", 0)
					w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(row, "cantidad", 0)
					w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(row,'c_total_linea',0)
					w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1, "Subtotal",0)
					w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1, "mora",0)
					w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1, "gastos_cob",0)
					
					w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1, "mora_cred",0)
					w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1, "mora_mant",0)
					w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1, "gasto_cred",0)
					w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1, "gasto_mant",0)
					
					w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.accepttext()
					w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setfocus()
					w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setcolumn('cantidad')
				else
					if w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.getitemnumber(row,'cantidad') <= 1 or isnull(w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.getitemnumber(row,'cantidad')) then w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(row, "cantidad", 1)
					ll_monto_cred					= round(w_ingreso2.tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,"c_valor_cuota_pesos"),0)
					ll_monto_mora_cred			= wf_calcular_mora(row)
					SELECT	SUM("ABONO_CTA_CTE"."MONTO")  
					INTO 		:ll_sum_monto_abono  
					FROM 	"ABONO_CTA_CTE"  
					WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
							 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
							 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero )  AND 
							 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
					USING		sqlca;
					if ll_sum_monto_abono > 0 then
						ll_monto_cta				= ll_monto_cred * w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.getitemnumber(row,'cantidad')
						if ll_sum_monto_abono >= (ll_monto_cta + ll_monto_mora_cred) then
							ll_monto_final_cred	= round(ll_sum_monto_abono - (ll_monto_cta + ll_monto_mora_cred),0)
							ll_res_abono			= messagebox("Advertencia Abono","En su Cuenta Corriente Existe Abonado $ "+string(ll_sum_monto_abono,'###,###,###,###,##0')+", se descontará por Concepto Crédito $ "+string((ll_monto_cta + ll_monto_mora_cred) - 1,'###,###,###,###,##0')+", quedando a su Favor $ "+string(ll_monto_final_cred,'###,###,###,###,##0')+"... desea utilizar Abono Existente",Exclamation!,YesNo!,2)
							if ll_res_abono=1 then
								w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(row, "monto", ll_monto_cred)
								ll_monto_final_cred ++
								UPDATE	"ABONO_CTA_CTE"  
								SET 		"TIPO_COB_OCUPA" = :gs_tipo_cobro,   
											"FOLIO_OCUPA" = :ll_folio,   
											"FECHA_OCUPA" = :ldt_fecha_hoy,   
											"MONTO_OCUPA" = (:ll_monto_cta + :ll_monto_mora_cred) - 1,   
											"USUARIO_OCUPA" = :gs_user,   
											"CAJA_OCUPA" = :gs_caja,   
											"ESTADO_REG" = 'O',
											"TIPO_MOV_OCUPA" = 'E',
											"SW_ESTADO_TRANS" = 1  
								WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
										 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
										 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
										 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
								USING		sqlca;
								if sqlca.sqlcode=0 then
									commit;
									INSERT INTO "ABONO_CTA_CTE"  
												( "RUT",		"BASE",		"SERIE",		"NUMERO",	"TIPO_COB",	"FOLIO",		"MONTO",						"FECHA_CREA",		"USUARIO_CREA",	"CAJA_CREA",	"ESTADO_REG",	"TIPO_COB_OCUPA",	"FOLIO_OCUPA",	"FECHA_OCUPA",	"MONTO_OCUPA",	"USUARIO_OCUPA",	"CAJA_OCUPA",	"TIPO_MOV_OCUPA",	"SW_ESTADO_TRANS" )
									VALUES 	( :gi_rut,	:gs_base,	:gs_serie,	:gi_numero,:gs_tipo_cobro,			:ll_folio,	:ll_monto_final_cred,	:gdt_fec_sistema,	:gs_user,			:gs_caja,		'P',				null,					null,				null,				null,				null,					null,				null,					2 )  
									USING		sqlca;
									if sqlca.sqlcode=0 then
										commit;
									else
										rollback;
										messagebox("Error Grabar","Error al INSERTAR ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
									end if
								else
									rollback;
									messagebox("Error Grabar","Error al UPDATE ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
								end if
							else
								ll_monto_final_cred		= ll_monto_cred
								w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(row, "monto", ll_monto_cred )
							end if
						else
							ll_res_abono				= messagebox("Advertencia Abono","En su Cuenta Corriente Existe Abonado $ "+string(ll_sum_monto_abono,'###,###,###,###,##0')+", Monto a Cancelar es $ "+string(ll_monto_cta,'###,###,###,###,##0')+" y su Saldo quedará en 0... desea utilizar por Concepto Crédito Abono Existente",Exclamation!,YesNo!,2)
							if ll_res_abono=1 then
								w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(row, "monto", ll_monto_cred )
								UPDATE	"ABONO_CTA_CTE"  
								SET 		"TIPO_COB_OCUPA" = :gs_tipo_cobro,   
											"FOLIO_OCUPA" = :ll_folio,   
											"FECHA_OCUPA" = :ldt_fecha_hoy,   
											"MONTO_OCUPA" = :ll_sum_monto_abono,   
											"USUARIO_OCUPA" = :gs_user,   
											"CAJA_OCUPA" = :gs_caja,   
											"ESTADO_REG" = 'O',
											"TIPO_MOV_OCUPA" = 'E',
											"SW_ESTADO_TRANS" = 1  
								WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
										 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
										 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
										 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
								USING		sqlca;
								if sqlca.sqlcode=0 then
									commit;
								else
									rollback;
									messagebox("Error Grabar","Error al Update ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
								end if
							else
								ll_monto_final_cred		= ll_monto_cred
								w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(row, "monto", ll_monto_cred )
							end if
						end if
					else
						ll_monto_final_cred				= ll_monto_cred
						w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(row, "monto", ll_monto_cred )
					end if			
		
				end if
				wf_calcular_interes(ls_tipo_cob)
				w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1, "Subtotal",w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.GetItemNumber(1,"c_subtotal"))
				w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.accepttext()
			end if
			
		elseIF is_columna = "cantidad" AND ls_tipo_cob = "F"  AND gs_rezago <> "S" AND w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount() > 0 THEN	
			if  w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.getitemNumber(row, "cantidad") > 0 then
				wf_actualizar_abono(ls_tipo_cob)
				wf_calcular_cant_mant(row)
				wf_calcular_interes(ls_tipo_cob)
				w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.accepttext()
				//Script nuevo IVA Autor MM 22/12/2022
				wf_calcular_iva_mant(ll_ctas_pag_m)
	
			end if
		END IF
		
		// vhfb - inicion -  actualiza cantidad			
		 if  (gs_aplica_a ='M' or gs_aplica_a ='T') or  (gs_aplica_a ='C' and (ls_tipo_base = 'L' or ls_tipo_base = 'A' or ls_tipo_base = 'F' ))  then		
			IF is_columna = "cantidad" AND (ls_tipo_cob = "F"  OR ((gs_aplica_a ='C'  OR gs_aplica_a ='T' ) and (ls_tipo_base = 'L'  or ls_tipo_base = 'A'   or ls_tipo_base = 'F'    or ls_tipo_base = 'R'  )) ) AND w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount() > 0 THEN	
				wf_actualiza_cantidad_be();
			end if 
		end if 
		// vhfb - termino -  actualiza cantidad
			
		IF gs_rezago <> "S" and (ls_tipo_cob = "E" or ls_tipo_cob = "U") and gs_base<>'C' THEN
			w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(row, "estado", 'S')
			wf_calcular_interes(ls_tipo_cob)
		elseif gs_rezago <> "S" and ls_tipo_cob = "F" THEN
			w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(row, "estado", 'S')
			wf_calcular_interes(ls_tipo_cob)
		else
			w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(row, "estado", 'N')
		end if
	
	elseif ls_estado_cadena<>'S' and ls_estado_cadena<>'V' and ls_estado_cadena<>'C' then
		messagebox("Advertencia","No es Posible Ingresar este Tipo de Cobro")
		w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.deleterow(row)
		fila 					= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.scrolltorow(fila)
		w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.scrolltorow(fila)
		w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(fila, "uf", gd_uf)
		w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(fila, "folio", 0)
		if w_ingreso2.tab_ingreso.tp_be.rb_be_afecta.checked=true then
			w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(fila, "iva", idb_iva)
		end if
		w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(fila, "estado", 'N')
		w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(fila, "uf", gd_uf)
		if w_ingreso2.tab_ingreso.tp_be.rb_be_uf.checked=true then
			w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(fila, "moneda",'U')
		else
			w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(fila, "moneda",'P')
		end if
		setnull(ls_tipo_cob);setnull(is_columna)
		w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.scrolltorow(row)
		w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setfocus()
		w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setcolumn('tipo_cob')
	end if
	
	ll_tot_reg		= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount()
	if ll_tot_reg > 0 then
		ll_fila_gasto		= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.Find( "tipo_cob = 'E' or tipo_cob ='F' or tipo_cob='A' or tipo_cob = 'Q' or tipo_cob ='U'",1, ll_tot_reg)
		if ll_fila_gasto =0 then
			w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1, "mora",0)
			w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1, "gastos_cob",0)
			
			w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1, "mora_cred",0)
			w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1, "mora_mant",0)
			w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1, "gasto_cred",0)
			w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1, "gasto_mant",0)
			
			w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.accepttext()
		end if
	end if
	w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.accepttext()
	il_fila_desc					=w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.getrow()
	ls_tipo_cob					= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.getitemstring(il_fila_desc,'tipo_cob')
	if gs_codigo_otro = "" then gs_codigo_otro = '0'
	if ls_tipo_cob = 'S' and gs_codigo_otro <> '0' then
		gs_codigo_otro			= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.getitemstring(il_fila_desc,'tipo_cob_otro')
		wf_validar_descuento()
	end if
	ll_monto								= w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.getitemnumber(1,'c_total')
	if ll_monto > 0 then 
		ls_string							= "tipo_cob_otro = '144' or tipo_cob_otro = '76' "
		ll_fila								= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.Find(ls_string,  1, ll_tot_reg)
		if ll_fila > 0 then
			ls_tipo_cob	= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.getitemstring(fila,'tipo_cob')
			w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.DeleteRow(ll_fila)
			wf_calcular_interes(ls_tipo_cob)
			w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.accepttext()
		end if
		w_ingreso2.tab_ingreso.tp_be.cbx_paga_ef_be.checked			= false
	end if
	w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.accepttext()
	
	
	if (ls_tipo_cob = "E" or ls_tipo_cob = "A" or ls_tipo_cob = "U" or ls_tipo_cob="Q") and (gs_base='L' or gs_base='G' or gs_base='F') and gs_rezago <> 'S' then
		//Script nuevo IVA Autor MM 22/12/2022
		wf_calcular_iva_gl(ls_tipo_cob)
	
	end if
		IF is_columna = "monto" or is_columna='monto_uf' or is_columna='canidad' THEN
			w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.accepttext()
			if is_columna = "monto" then
				ld_monto					= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.getitemnumber(row,'monto')
			elseif  is_columna='monto_uf' then
				ld_monto					= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.getitemnumber(row,'monto_uf')
			end if
			ll_monto_cuota_reg		= tab_ingreso.tp_be.dw_detalle_be.getitemnumber(tab_ingreso.tp_be.dw_detalle_be.getrow(),'c_total_linea')
			ll_fila_fm						= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob = 'F' or tipo_cob='E'", 1, w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount())
			if ll_fila_fm > 0 and gs_tipo_cobro = 'BA' then
				ii_cantidad 				= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.GetItemNumber(ll_fila_fm, "cantidad")
			else
				ii_cantidad 				= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.GetItemNumber(row, "cantidad")
			end if
			if isnull(ii_cantidad) or ii_cantidad = 0 then ii_cantidad=1
			ll_cuota_ini					= ll_ctas_pag_m + 1
			ll_cuota_fin					= (ll_cuota_ini + ii_cantidad) - 1
			wf_cargar_monto(ld_monto, il_cantidad_malo, row, ld_pie_pactado,ll_cuota_ini,ll_cuota_fin, ii_cantidad )
	
		end if
	//if is_columna = "cantidad" or is_columna="monto" or is_columna="monto_uf" then
	//	wf_cargar_iva(ls_tipo_cob,row)
	//end if
	w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.accepttext()
	wf_actualizar(ls_tipo_cob)
end if
w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.accepttext()
end subroutine

public subroutine wf_limpiar_dw_registro (long al_row);messagebox("Advertencia","Cantidad de Cuotas sobrepasa al Plazo del Crédito")


tab_ingreso.tp_be.dw_detalle_be.reset()
tab_ingreso.tp_be.dw_detalle_be.accepttext()


// vhfb - inicio - control para aplciar descuento
IF tab_ingreso.tp_be.dw_datos_be.ROWCOUNT()>0 THEN
	if 	gd_descuento > 0 then
		wf_gatilla_descuentos_de()
	end if 
END IF 
// vhfb - termino - control para aplciar descuento

return

tab_ingreso.tp_be.dw_detalle_be.SetItem(al_row,'c_total_linea',0)
tab_ingreso.tp_be.dw_gastos_be.SetItem(1, "Subtotal",0)
tab_ingreso.tp_be.dw_gastos_be.SetItem(1, "mora",0)
tab_ingreso.tp_be.dw_gastos_be.SetItem(1, "gastos_cob",0)
tab_ingreso.tp_be.dw_gastos_be.SetItem(1, "mora_cred",0)
tab_ingreso.tp_be.dw_gastos_be.SetItem(1, "gasto_cred",0)
tab_ingreso.tp_be.dw_gastos_be.SetItem(1, "mora_mant",0)

tab_ingreso.tp_be.dw_detalle_be.SetItem(al_row, "cantidad",1)

tab_ingreso.tp_be.dw_detalle_be.accepttext()
tab_ingreso.tp_be.dw_detalle_be.setfocus()
tab_ingreso.tp_be.dw_detalle_be.setcolumn('monto')
end subroutine

public subroutine wf_proceso_001 ();		SELECT sysdate INTO :gdt_fec_sistema FROM "TASA" WHERE "TASA"."LOOK" = 1   ;
		if gs_base='O' or gs_base='C' or gs_base='U' or gs_base='M' then
			SELECT	"OFERTA_V"."CTA_PAG_M"  
			INTO 		:il_ctas_pag_m_001  
			FROM 	"OFERTA_V",   "CADENA"  
			WHERE 	( "OFERTA_V"."SERIE" = "CADENA"."SERIE" ) and  
						( "OFERTA_V"."NRO_OFERTA" = "CADENA"."NUMERO" ) and  
						( ( "CADENA"."CODIGO" = :gs_base ) AND  
						( "OFERTA_V"."SERIE" = :gs_serie ) AND  
						( "OFERTA_V"."NRO_OFERTA" = :gi_numero ) )   
			UNION   
			SELECT 	"CONTRATO"."CTA_PAG_M"  
			FROM 	"CADENA",   "CONTRATO"  
			WHERE 	( "CADENA"."SERIE" = "CONTRATO"."SERIE_C" ) and  
						( "CADENA"."NUMERO" = "CONTRATO"."NRO_CONTRATO" ) and  
						( ( "CADENA"."CODIGO" = :gs_base ) AND  
						( "CADENA"."SERIE" = :gs_serie ) AND  
						( "CADENA"."NUMERO" = :gi_numero ) )   ;
			if isnull(il_ctas_pag_m_001) then il_ctas_pag_m_001=0
		end if
		is_tipo_comp_001						= gs_tipo_cobro
		setnull(is_nulo_001)
		il_inc_gastos_001 						= 1
		is_columna_001 							= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.GetColumnName()
		il_folio_001								= long(w_ingreso2.tab_ingreso.tp_be.sle_numero_be.text)
		idt_fecha_hoy_001						= datetime(date(gdt_fec_sistema),time('00:00:00'))
		il_tot_reg_001							= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount()
		if il_tot_reg_001>0 then
			il_count_reg_001 					= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob ='A' or tipo_cob ='Q'",1, il_tot_reg_001)
			if il_count_reg_001=0 or isnull(il_count_reg_001) then
				UPDATE	"DETALLE_PAGO_PIE"  
				SET 		"TIPO_COB" = null,   
							"FOLIO" = null,   
							"CAJA" = null,   
							"USUARIO" = null,   
							"FECHA_PAGO" = null,   
							"MONTO_PIE_PAGADO_PESO" = null,
							"ESTADO" = 'P'  
				WHERE  ( "DETALLE_PAGO_PIE"."BASE" = :gs_base ) AND  
						 ( "DETALLE_PAGO_PIE"."SERIE" = :gs_serie ) AND  
						 ( "DETALLE_PAGO_PIE"."NUMERO" = :gi_numero ) AND  
						 ( "DETALLE_PAGO_PIE"."TIPO_COB" = :gs_tipo_cobro ) AND  
						 ( "DETALLE_PAGO_PIE"."FOLIO" = :il_folio_001 ) AND  
						 ( "DETALLE_PAGO_PIE"."FECHA_PAGO" = :gd_fecha_pago_plazo )   
				USING		sqlca;
				if sqlca.sqlcode=0 then
					commit;
				else
					rollback;
				end if
			end if
		end if


//
//
//		SELECT sysdate INTO :gdt_fec_sistema FROM "TASA" WHERE "TASA"."LOOK" = 1   ;
//		if gs_base='O' or gs_base='C' or gs_base='U' or gs_base='M' then
