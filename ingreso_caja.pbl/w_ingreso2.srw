event clicked;IF dw_detalle_bl.RowCount() >0 Then
	dw_detalle_bl.DeleteRow(dw_detalle_bl.GetRow())
	IF dw_detalle_bl.RowCount() >0 Then
		dw_gastos_bl.SetItem(1, "Subtotal",dw_detalle_bl.GetItemNumber(1,"c_subtotal"))
	else
		cb_bl_borrar_item.Enabled	= FALSE
		dw_gastos_bl.SetItem(1,"gastos_cob", 0)
		dw_gastos_bl.SetItem(1,"mora", 0)
		dw_gastos_bl.SetItem(1,"subtotal", 0)
	end if
else
	cb_bl_borrar_item.Enabled		= FALSE
	dw_gastos_bl.SetItem(1,"gastos_cob", 0)
	dw_gastos_bl.SetItem(1,"mora", 0)
	dw_gastos_bl.SetItem(1,"subtotal", 0)
END IF
if gs_rezago='S' then
	rb_ci_uf_bl.visible					= true
	rb_ci_uf_bl.checked				= true
	rb_ci_peso_bl.visible				= true
	rb_ci_peso_bl.checked			= false
else
	rb_ci_uf_bl.visible					= false
	rb_ci_uf_bl.checked				= false
	rb_ci_peso_bl.visible				= false
	rb_ci_peso_bl.checked			= true
end if
dw_gastos_bl.accepttext()
end event

type cb_bl_insertar from picturebutton within tp_boletas
event ue_mousemove pbm_mousemove
integer x = 1458
integer y = 856
integer width = 201
integer height = 164
integer taborder = 50
integer textsize = -9
integer weight = 400
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
boolean enabled = false
string picturename = "Insertar_on.bmp"
string disabledname = "Insertar_off.bmp"
alignment htextalign = left!
end type

event ue_mousemove;st_19.visible					= false
st_help_insertar2.visible	= true
st_help_eliminar2.visible	= false
if is_opcion='FP' and (gs_depto='T' or gs_depto='I') then st_fuera_plazo.visible = true
end event

event clicked;long 		fila,ii_dmora, ii_mora_cobro,ll_tot_reg,ll_indi,ll_cantidad,ll_monto,ll_sw_pasa=0,&
			ii_inc_gastos = 1
double 	id_im, id_gc, id_valor_cuota,ld_monto_uf,id_interes_gc
String	ls_tipo_cob,ls_moneda

if long(sle_numero_bl.text) > 0 then
	ll_tot_reg		= dw_detalle_bl.rowcount()
	for ll_indi=1 to ll_tot_reg
		ls_tipo_cob	= dw_detalle_bl.getitemstring(ll_indi,'tipo_cob')
		ll_cantidad	= dw_detalle_bl.getitemnumber(ll_indi,'cantidad')
		ll_monto		= dw_detalle_bl.getitemnumber(ll_indi,'monto')
		ld_monto_uf	= dw_detalle_bl.getitemnumber(ll_indi,'monto_uf')
		ls_moneda	= dw_detalle_bl.getitemstring(ll_indi,'moneda')
		if ls_tipo_cob='' or isnull(ls_tipo_cob) then
			messagebox("Advertencia","No es posible Insertar nuevo Item, en Fila Nº  "+string(ll_indi)+"  Tipo Cobro Inválido")
			dw_detalle_bl.setfocus()
			dw_detalle_bl.scrolltorow(ll_indi)
			dw_detalle_bl.setcolumn('tipo_cob')
			ll_indi		= ll_tot_reg
			ll_sw_pasa	= 1
		elseif ll_cantidad<=0 or isnull(ll_cantidad) then
			messagebox("Advertencia","No es posible Insertar nuevo Item, en Fila Nº  "+string(ll_indi)+"  Cantidad Inválido")
			dw_detalle_bl.setfocus()
			dw_detalle_bl.scrolltorow(ll_indi)
			dw_detalle_bl.setcolumn('cantidad')
			ll_indi		= ll_tot_reg
			ll_sw_pasa	= 1
		elseif (ll_monto<=0 or isnull(ll_monto)) and (ld_monto_uf<=0 or isnull(ld_monto_uf)) then
			messagebox("Advertencia","No es posible Insertar nuevo Item, en Fila Nº  "+string(ll_indi)+"  Monto Inválido")
			dw_detalle_bl.setfocus()
			dw_detalle_bl.scrolltorow(ll_indi)
			if ls_moneda='P' then
				dw_detalle_bl.setcolumn('monto')
			else
				dw_detalle_bl.setcolumn('monto_uf')
			end if
			ll_indi			= ll_tot_reg
			ll_sw_pasa	= 1
		end if
	next
	if ll_sw_pasa=0 then
		cbx_sin_mora_bl.enabled		= true
		cbx_sin_gastos_bl.enabled		= true
		setnull(il_cantidad_malo)
		gl_n_cuotas_pag 					= 0
		dw_detalle_bl.getchild('tipo_cob',idw_detalle3)
		idw_detalle3.settransobject(sqlca)
		if idw_detalle3.retrieve(gs_tipo_cobro)=0 then
			idw_detalle3.insertrow(0)
		end if
		fila 									= dw_detalle_bl.InsertRow(0)
		dw_detalle_bl.scrolltorow(fila)
		dw_detalle_bl.SetItem(fila, "uf", gd_uf)
		if rb_fac_afecta.checked=true then
			dw_detalle_bl.SetItem(fila, "iva", idb_iva)
		end if
		dw_detalle_bl.SetItem(fila, "folio", 0)
		dw_detalle_bl.SetItem(fila, "estado", 'N')
		dw_detalle_bl.SetItem(fila, "uf", gd_uf)
		if rb_ci_uf_bl.checked=true then
			dw_detalle_bl.SetItem(fila, "moneda",'U')
		else
			dw_detalle_bl.SetItem(fila, "moneda",'P')
		end if
		IF fila = 1 THEN
			IF gs_rezago <> "S" THEN	
				dw_gastos_bl.InsertRow(0)
				cb_ingresar_pago_bl.Enabled	= TRUE
				cb_bl_borrar_item.Enabled 		= true
//				pb_ficha.Enabled 					= true
				wf_calcular_intereses_bl(ls_tipo_cob)
		  ELSE
				id_valor_cuota 						= 0
				ii_dmora 							= 0
				id_gc 									= 0
				id_im 									= 0
				ii_mora_cobro 						= 1
				ii_inc_gastos 						= 1
				dw_gastos_bl.InsertRow(0)
				cb_ingresar_pago_bl.Enabled	= TRUE
				cb_bl_borrar_item.Enabled 		= true
//				pb_ficha.Enabled 					= false
		  END IF
		END IF
		dw_detalle_bl.setfocus()
		dw_detalle_bl.setcolumn('tipo_cob')
	end if
end if
end event

type cb_ingresar_pago_bl from commandbutton within tp_boletas
event ue_mousemove pbm_mousemove
integer x = 2875
integer y = 1420
integer width = 727
integer height = 96
integer taborder = 90
integer textsize = -9
integer weight = 700
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string text = "Ingresar &Forma de Pago"
end type

event ue_mousemove;st_19.visible					= false
st_help_insertar2.visible	= false
st_help_eliminar2.visible	= false
if is_opcion='FP' and (gs_depto='T' or gs_depto='I') then st_fuera_plazo.visible = true
end event

event clicked;long		ll_dia,ll_mes,ll_anno,ll_cta_pag_m,ll_indi,ll_tot_reg,ll_cantidad,&
			ll_monto,ll_sw_pasa
date		ld_fecha_m
Double	ld_monto_uf
String	ls_fecha,ls_tipo_cob,ls_moneda,ls_tipo_cob_otro

if isvalid(w_forma_pago2) then close(w_forma_pago2)
ll_tot_reg					= dw_detalle_bl.rowcount()
if ll_tot_reg>0 then
	for ll_indi=1 to ll_tot_reg
		ls_tipo_cob			= dw_detalle_bl.getitemstring(ll_indi,'tipo_cob')
		ls_tipo_cob_otro	= dw_detalle_bl.getitemstring(ll_indi,'tipo_cob_otro')
		ll_cantidad			= dw_detalle_bl.getitemnumber(ll_indi,'cantidad')
		ll_monto				= dw_detalle_bl.getitemnumber(ll_indi,'monto')
		ld_monto_uf			= dw_detalle_bl.getitemnumber(ll_indi,'monto_uf')
		ls_moneda			= dw_detalle_bl.getitemstring(ll_indi,'moneda')
		if isnull(ls_tipo_cob) or ls_tipo_cob='' then
			messagebox("Advertencia","Error debe ingresar Tipo de Cobro en Fila Nº: "+string(ll_indi))
			dw_detalle_bl.setfocus()
			dw_detalle_bl.scrolltorow(ll_indi)
			dw_detalle_bl.setcolumn('tipo_cob')
			ll_sw_pasa ++
			exit
		elseif ls_tipo_cob='L' and ( isnull(ls_tipo_cob_otro) or ls_tipo_cob_otro='') then
			messagebox("Advertencia","Error debe ingresar Tipo de Cobro en Fila Nº: "+string(ll_indi))
			dw_detalle_bl.setfocus()
			dw_detalle_bl.scrolltorow(ll_indi)
			dw_detalle_bl.setcolumn('tipo_cob')
			ll_sw_pasa ++
			exit
		elseif isnull(ll_cantidad) or ll_cantidad=0 then
			messagebox("Advertencia","Error debe ingresar Cantidad en Fila Nº: "+string(ll_indi))
			dw_detalle_bl.setfocus()
			dw_detalle_bl.scrolltorow(ll_indi)
			dw_detalle_bl.setcolumn('cantidad')
			ll_sw_pasa ++
			exit
		elseif (isnull(ll_monto) or ll_monto=0) and (isnull(ld_monto_uf) or ld_monto_uf=0) then
			messagebox("Advertencia","Error debe ingresar Monto en Fila Nº: "+string(ll_indi))
			dw_detalle_bl.setfocus()
			dw_detalle_bl.scrolltorow(ll_indi)
			if ls_moneda='P' then
				dw_detalle_bl.setcolumn('monto')
			else
				dw_detalle_bl.setcolumn('monto_uf')
			end if
			ll_sw_pasa ++
			exit
		end if
	next	
	if ll_sw_pasa=0 then
		if dw_gastos_bl.rowcount()>0 then
			gd_total 						= Round(dw_gastos_bl.GetItemNumber(1 , "c_total"),0)
		end if
		if dw_datos_bl.rowcount()>0 then
			if gs_base='O' or gs_base='U' or gs_base='M' then
				ld_fecha_m				= date(dw_datos_bl.getitemdatetime(1,'oferta_v_fecha_m'))
				ll_cta_pag_m			= dw_datos_bl.getitemnumber(1,'oferta_v_cta_pag_m')
				ll_dia						= day(ld_fecha_m)
				ll_mes					= month(ld_fecha_m)
				ll_anno					= year(ld_fecha_m) + ll_cta_pag_m
				ls_fecha					= string(ll_dia,"00")+'/'+string(ll_mes,"00")+'/'+string(ll_anno,"0000")
				gd_fecha_prox_pago	= date(ls_fecha)
			elseif gs_base='C' then
				ld_fecha_m				= date(dw_datos_bl.getitemdatetime(1,'contrato_fecha_m'))
				ll_cta_pag_m			= dw_datos_bl.getitemnumber(1,'contrato_cta_pag_m')
				ll_dia						= day(ld_fecha_m)
				ll_mes					= month(ld_fecha_m)
				ll_anno					= year(ld_fecha_m) + ll_cta_pag_m
				ls_fecha					= string(ll_dia,"00")+'/'+string(ll_mes,"00")+'/'+string(ll_anno,"0000")
				gd_fecha_prox_pago	= date(ls_fecha)
			elseif gs_base='F' or gs_base='G' or gs_base='V' then
				ld_fecha_m				= date(dw_datos_bl.getitemdatetime(1,'cadena_mora_fecha_venc_cred'))
				ll_cta_pag_m			= dw_datos_bl.getitemnumber(1,'producto_anexo_cuotas_pag')
				ll_dia						= day(ld_fecha_m)
				ll_mes					= month(ld_fecha_m)
				ll_anno					= year(ld_fecha_m) + ll_cta_pag_m
				ls_fecha					= string(ll_dia,"00")+'/'+string(ll_mes,"00")+'/'+string(ll_anno,"0000")
				gd_fecha_prox_pago	= date(ls_fecha)
			end if
		else
			gd_fecha_prox_pago		= date('01/01/1900')
		end if
		if cbx_manual_factura.checked=true then
			gs_tipo_cobro 				= "BL"
		else
			if rb_fac_afecta.checked=true then 
				gs_tipo_cobro 			= "FA"
			elseif rb_fac_exenta.checked=true then
				gs_tipo_cobro 			= "FE"
			end if
		end if
		gl_folio 							= Long(sle_numero_bl.text)
		gd_total							= round(gd_total,0)
		gs_tipo_cobro_aux				= gs_tipo_cobro
		if gd_total>0 then Open(w_forma_pago2)
	end if
else
	messagebox("Advertencia","Debe Ingresar Detalle de Pago")
	cb_bl_insertar.setfocus()
end if
end event

