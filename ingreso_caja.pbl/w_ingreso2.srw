						ldb_tasa										= w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.GetItemNumber(1,"c_tasa")
						ldt_fecha_venc								= w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.getitemdatetime(1, "c_prox_pago")
