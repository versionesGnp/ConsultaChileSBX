end subroutine

public subroutine wf_calcular_intereses_bl (string as_cobro);Long		ii_cantidad,ii_dmora,ii_mora_cobro,ii_inc_gastos,i,ll_gasto_cob,ll_mora,ll_gastos,ll_tot_reg,ll_indi,ll_monto,ll_total_monto,ll_cuota,ll_day,ll_month,ll_year,&
			ll_suma_dias,ll_tot_fila,ll_reg,ll_dias_mora,ll_ctas_mora,ll_calc_dias,ld_dias_sum_mora,ldb_mora=0,id_valor_cuota,id_im, id_gc,ll_new,ll_dias_dif,ll_ctas_pag,&
			ldb_suma_gasto_cob=0,ll_max,ll_dia_prox_pago,ll_suma_acum_gc,ll_valor_int,ll_acum_gasto,ll_acum_mora,ll_cant_mant,ll_cant_cred,ll_acum_dias,ll_dias_mora_cred,&
			ll_sumar_mes,ll_mora_cred,ll_dias
String	ls_tipo_cob,ls_pasa,ls_fecha
Date		ld_fecha_prox_pago,ld_fecha_hoy,ld_fecha_inicial,ld_fecha_prox_venc
Datetime	ldt_fecha_prim,ldt_fecha_venc_calc,ldt_fecha_venc,ld_fecha_venc_cred,ldt_fecha_hoy
Double	ldb_valor,ldb_tasa,ldb_val_cta_cred,id_monto

IF gs_rezago <> "S" THEN
	SELECT 	"ESTADO_MORA_MANTENCION"."CANTIDAD_MESES", 	"ESTADO_MORA_CREDITO"."CANTIDAD_MESES"  
	INTO   	:ll_cant_mant,														:ll_cant_cred
	FROM   "CADENA", "ESTADO_MORA_CREDITO", "ESTADO_MORA_MANTENCION"  
	WHERE ("CADENA"."ESTADO_MORA_CREDITO" = "ESTADO_MORA_CREDITO"."ESTADO_MORA_CREDITO" ) and  
			( "CADENA"."ESTADO_MORA_MANTENCION" = "ESTADO_MORA_MANTENCION"."ESTADO_MORA_MANTENCION" ) and  
			(("CADENA"."CODIGO" = :gs_base ) AND  
			( "CADENA"."SERIE" = :gs_serie ) AND  
			( "CADENA"."NUMERO" = :gi_numero ) )   ;
	ld_fecha_hoy							= date(gdt_fec_sistema)
	ldt_fecha_hoy							= datetime( date(ld_fecha_hoy),time('00:00:00'))
	il_int_mora								= 0
	il_int_mora_cred						= 0
	il_int_mora_mant						= 0
	il_int_gc									= 0
	il_int_gc_cred							= 0
	il_int_gc_mant							= 0
	
	if isnull(w_ingreso2.tab_ingreso.tp_boletas.dw_gastos_bl.getitemnumber(1,'gastos_cob')) then
		w_ingreso2.tab_ingreso.tp_boletas.dw_gastos_bl.setitem(1,'gastos_cob',0)
	end if
	if isnull(w_ingreso2.tab_ingreso.tp_boletas.dw_gastos_bl.getitemnumber(1,'mora')) then
		w_ingreso2.tab_ingreso.tp_boletas.dw_gastos_bl.setitem(1,'mora',0)
	end if
	ll_acum_gasto							= w_ingreso2.tab_ingreso.tp_boletas.dw_gastos_bl.getitemnumber(1,'gastos_cob')
	ll_acum_mora							= w_ingreso2.tab_ingreso.tp_boletas.dw_gastos_bl.getitemnumber(1,'mora')
	if isnull(ll_acum_gasto) then ll_acum_gasto=0
	if isnull(ll_acum_mora) then ll_acum_mora=0
//	w_ingreso2.tab_ingreso.tp_boletas.dw_gastos_bl.SetItem(1,'gastos_cob', 0)
//	w_ingreso2.tab_ingreso.tp_boletas.dw_gastos_bl.SetItem(1,'mora', 0)
	w_ingreso2.tab_ingreso.tp_boletas.dw_gastos_bl.SetItem(1,'incluir_gastos', 1)
	w_ingreso2.tab_ingreso.tp_boletas.dw_detalle_bl.accepttext()
	w_ingreso2.tab_ingreso.tp_boletas.dw_gastos_bl.accepttext()
	ll_tot_reg								= w_ingreso2.tab_ingreso.tp_boletas.dw_detalle_bl.rowcount()
	if ll_tot_reg>0 then
		for ll_indi=1 to ll_tot_reg
			ll_cuota							= w_ingreso2.tab_ingreso.tp_boletas.dw_datos_bl.getitemnumber(1, "c_cuotas_mora")
			ls_tipo_cob						= w_ingreso2.tab_ingreso.tp_boletas.dw_detalle_bl.getitemstring(ll_indi,"tipo_cob")
			if ll_cuota>0 then
				if ls_tipo_cob='E' or ls_tipo_cob='A' or ls_tipo_cob='F' then
					ii_cantidad 				= w_ingreso2.tab_ingreso.tp_boletas.dw_detalle_bl.GetItemNumber(ll_indi,"cantidad")
					ll_monto					= w_ingreso2.tab_ingreso.tp_boletas.dw_detalle_bl.GetItemNumber(ll_indi,"c_total_linea")
					gl_n_cuotas_pag 		= ii_cantidad 
					if ls_tipo_cob='E' then
						id_valor_cuota 		= Round(w_ingreso2.tab_ingreso.tp_boletas.dw_datos_bl.GetItemNumber(1,"c_valor_cuota_pesos"), 0)
						if gs_base='O' or gs_base='U' or gs_base='M' then
							ldt_fecha_prim			= w_ingreso2.tab_ingreso.tp_boletas.dw_datos_bl.GetItemdatetime(1,'pago_oferta_fecha_prim')
							ll_ctas_pag				= w_ingreso2.tab_ingreso.tp_boletas.dw_datos_bl.GetItemnumber(1,'oferta_v_cta_pag_s')
						elseif gs_base='L' then
							ldt_fecha_prim			= w_ingreso2.tab_ingreso.tp_boletas.dw_datos_bl.GetItemdatetime(1,'pago_liberador_fecha_prim')
							ll_ctas_pag				= w_ingreso2.tab_ingreso.tp_boletas.dw_datos_bl.GetItemnumber(1,'anexo_liberador_cta_pag_m')
						elseif gs_base='F' or gs_base='G' or gs_base='V' then
							ldt_fecha_prim			= w_ingreso2.tab_ingreso.tp_boletas.dw_datos_bl.GetItemdatetime(1,'producto_pago_fecha_prim')
							ll_ctas_pag				= w_ingreso2.tab_ingreso.tp_boletas.dw_datos_bl.GetItemnumber(1,'producto_anexo_cuotas_pag')
						elseif gs_base='A' then
							ldt_fecha_prim			= w_ingreso2.tab_ingreso.tp_boletas.dw_datos_bl.GetItemdatetime(1,'pago_aumento_fecha_prim')
							ll_ctas_pag				= w_ingreso2.tab_ingreso.tp_boletas.dw_datos_bl.GetItemnumber(1,'anexo_aumento_cta_pag_m')
						elseif gs_base='R' then
							ldt_fecha_prim			= w_ingreso2.tab_ingreso.tp_boletas.dw_datos_bl.GetItemdatetime(1,'fecha_primera_cta')
							ll_ctas_pag				= w_ingreso2.tab_ingreso.tp_boletas.dw_datos_bl.GetItemnumber(1,'ctas_pagadas')
						elseif gs_base='P' then
							ldt_fecha_prim			= w_ingreso2.tab_ingreso.tp_boletas.dw_datos_bl.GetItemdatetime(1,'pagare_fecha_prim')
							ll_ctas_pag				= w_ingreso2.tab_ingreso.tp_boletas.dw_datos_bl.GetItemnumber(1,'c_cuotas_pagadas')
						elseif gs_base='D' then
							ldt_fecha_prim			= w_ingreso2.tab_ingreso.tp_boletas.dw_datos_bl.GetItemdatetime(1,'derecho_fecha_prim')
							ll_ctas_pag				= w_ingreso2.tab_ingreso.tp_boletas.dw_datos_bl.GetItemnumber(1,'c_cuotas_pagadas')
						end if
						ld_fecha_prox_pago		= date(DATEtime(funcion_venc( ldt_fecha_prim , ll_ctas_pag ))) //-1
						ii_dmora 					= w_ingreso2.tab_ingreso.tp_boletas.dw_datos_bl.GetItemNumber(1,"c_dias_mora")
						ll_ctas_mora				= w_ingreso2.tab_ingreso.tp_boletas.dw_datos_bl.GetItemNumber(1,'c_cuotas_mora')

					elseif ls_tipo_cob='A' then
						id_valor_cuota 				= ll_monto
						ii_dmora 					= w_ingreso2.tab_ingreso.tp_boletas.dw_datos_bl.GetItemNumber(1,'c_dias_mora_pie')
					elseif ls_tipo_cob='F' then
						if gs_base='O' or gs_base='C' or gs_base='U' or gs_base='M' then
							id_valor_cuota 			= Round(w_ingreso2.tab_ingreso.tp_boletas.dw_datos_bl.GetItemNumber(1,"c_valor_cuota_mantencion_pesos"), 0)
							ii_dmora 				= w_ingreso2.tab_ingreso.tp_boletas.dw_datos_bl.GetItemNumber(1,"c_dias_mora_mant")
						end if
					end if
					id_gc 								= 0
					id_im 								= 0
					if ls_tipo_cob='A' or ls_tipo_cob='E' then
						ii_mora_cobro 				= 1
						ii_inc_gastos 				= 1
					elseif ls_tipo_cob='F' then
						ii_mora_cobro 				= 0
						ii_inc_gastos 				= 0
					end if
					if ls_tipo_cob='E' then
//						dw_dias_mora.reset()
//						ll_dia_prox_pago			= day(ld_fecha_prox_pago)
//						ld_fecha_inicial				= ld_fecha_prox_pago
//						ll_day							= day(ld_fecha_inicial)
//						ll_month						= month(ld_fecha_inicial)
//						ll_year						= year(ld_fecha_inicial)
//						if (ll_month=1 and ll_day>=31) or (ll_month=2 and ll_day>=28) or (ll_month=3 and ll_day>=31) or &
//							(ll_month=4 and ll_day>=30) or (ll_month=5 and ll_day>=31) or (ll_month=6 and ll_day>=30) or &
//							(ll_month=7 and ll_day>=31) or (ll_month=8 and ll_day>=31) or (ll_month=9 and ll_day>=30) or &
//							(ll_month=10 and ll_day>=31) or (ll_month=11 and ll_day>=30) or (ll_month=12 and ll_day>=31) then
//							ls_pasa					= 'S'
//						else
//							ls_pasa					= 'N'
//						end if
//						ll_max						= 1000
//						FOR i = 1 TO ll_max
//							ll_new					= dw_dias_mora.insertrow(0)
//							dw_dias_mora.scrolltorow(ll_new)
//							ll_day						= day(ld_fecha_inicial)
//							ll_month					= month(ld_fecha_inicial)
//							ll_year					= year(ld_fecha_inicial)
//							ll_month	++
//							if (ll_month=1 and ll_dia_prox_pago>31) then
//								ls_pasa				= 'S'
//								ll_day					= 31
//							elseif (ll_month=2 and ll_dia_prox_pago>28) then
//								ls_pasa				= 'S'
//								ll_day					= 28
//							elseif (ll_month=3 and ll_dia_prox_pago>31) then
//								ls_pasa				= 'S'
//								ll_day					= 31
//							elseif (ll_month=4 and ll_dia_prox_pago>30) then
//								ls_pasa				= 'S'
//								ll_day					= 30
//							elseif (ll_month=5 and ll_dia_prox_pago>31) then
//								ls_pasa				= 'S'
//								ll_day					= 31
//							elseif (ll_month=6 and ll_dia_prox_pago>30) then
//								ls_pasa				= 'S'
//								ll_day					= 30
//							elseif (ll_month=7 and ll_dia_prox_pago>31) then
//								ls_pasa				= 'S'
//								ll_day					= 31
//							elseif (ll_month=8 and ll_dia_prox_pago>31) then
//								ls_pasa				= 'S'
//								ll_day					= 31
//							elseif (ll_month=9 and ll_dia_prox_pago>30) then
//								ls_pasa				= 'S'
//								ll_day					= 30
//							elseif (ll_month=10 and ll_dia_prox_pago>31) then
//								ls_pasa				= 'S'
//								ll_day					= 31
//							elseif (ll_month=11 and ll_dia_prox_pago>30) then
//								ls_pasa				= 'S'
//								ll_day					= 30
//							elseif (ll_month=12 and ll_dia_prox_pago>31) then
//								ls_pasa				= 'S'
//								ll_day					= 31
//							end if
//							if ll_month>12 then
//								ll_year ++
//								ll_month				= 1
//								if (ll_month=1 and ls_pasa='S') then
//									ls_pasa			= 'S'
//									ll_day				= 31
//								end if
//							end if
//							ls_fecha						= string(ll_day,'00')+'/'+string(ll_month,'00')+'/'+string(ll_year,'0000')
//							ld_fecha_prox_venc		= date(ls_fecha)
//							dw_dias_mora.setitem(ll_new,'fecha_inicial',ld_fecha_inicial)
//							if ld_fecha_prox_venc > ld_fecha_hoy then 
//								ld_fecha_prox_venc	= ld_fecha_hoy
//							end if
//							dw_dias_mora.setitem(ll_new,'fecha_venc',ld_fecha_prox_venc)
//							if ld_fecha_prox_venc < ld_fecha_hoy then
//								ll_dias_dif				= 0
//								ll_dias_dif				= DaysAfter(ld_fecha_inicial, ld_fecha_prox_venc)
//								if ll_dias_dif<=0 then ll_dias_dif=0
//								dw_dias_mora.setitem(ll_new,'dias_mora',ll_dias_dif)
//								ld_fecha_inicial			= ld_fecha_prox_venc
//							else
//								ll_dias_dif				= 0
//								ll_dias_dif				= DaysAfter(ld_fecha_inicial, ld_fecha_hoy) //ld_fecha_prox_venc)
//								if ll_dias_dif<=0 then ll_dias_dif=0
//								dw_dias_mora.setitem(ll_new,'dias_mora',ll_dias_dif)
//								ld_fecha_inicial			= ld_fecha_prox_venc
//								ll_suma_dias			= ll_suma_dias + ll_dias_dif
//								exit
//							end if
//							ll_suma_dias				= ll_suma_dias + ll_dias_dif
//						NEXT
//						ll_tot_fila							= dw_dias_mora.rowcount()
//						for ll_reg=1 to ll_tot_fila
//							ll_suma_dias				= ll_suma_dias - ll_dias_mora
//							dw_dias_mora.setitem(ll_reg,'suma_dias',ll_suma_dias)
//							ll_dias_mora				= dw_dias_mora.getitemnumber(ll_reg,'dias_mora')
//						next
//						dw_dias_mora.accepttext()
//						ii_dmora							= 0
//						ii_mora_cobro					= 0
//						id_im								= 0
//						id_gc								= 0
//						FOR i = 1 TO ll_tot_fila //ii_cantidad
//					      if ll_tot_fila > 0 and i <= ll_cuota then //ll_ctas_mora
//					 			ii_dmora					= dw_dias_mora.GetItemNumber(i, "suma_dias")
//					 			ll_dias_mora			= dw_dias_mora.GetItemNumber(i, "dias_mora")
//								IF (ii_dmora > 5 AND tab_ingreso.tp_boletas.cbx_sin_mora_bl.Checked = False) THEN
//									ii_mora_cobro   	= ii_dmora
//									ll_valor_int			= gf_int_mora(w_ingreso2.tab_ingreso.tp_boletas.dw_datos_bl.GetItemNumber(1,"c_tasa"), ii_mora_cobro, id_valor_cuota)
//									id_im 					= id_im + ll_valor_int
//									IF (ii_dmora > ll_dias_mora AND tab_ingreso.tp_boletas.cbx_sin_gastos_bl.Checked = False) THEN    
//										id_gc     			= Round(id_valor_cuota * id_factor_gc, 0)
//										ll_suma_acum_gc	= ll_suma_acum_gc + id_gc
//									END IF
//								END IF  
//							end if
//						NEXT

				/////// Mirko Inicio
						ll_acum_dias		= ii_dmora
						ll_dias_mora_cred	= ii_dmora
						ll_sumar_mes		= 1
						 id_im 					= 0
						 id_gc 					= 0
						 ll_indi 					= 1
						ldb_tasa					= w_ingreso2.tab_ingreso.tp_boletas.dw_datos_bl.GetItemNumber(1,"c_tasa")
						ldt_fecha_venc			= w_ingreso2.tab_ingreso.tp_boletas.dw_datos_bl.getitemdatetime(1, "c_prox_pago")
						ldb_val_cta_cred		= id_valor_cuota
						ll_mora_cred			= ll_ctas_mora			
						FOR i = 1 TO ii_cantidad
							if ll_mora_cred > 0 then 
								if ll_sumar_mes <= ll_mora_cred then
									 IF ll_acum_dias > 5 and ll_dias_mora_cred > 5 THEN  
										  ii_mora_cobro		= ll_acum_dias
										  id_monto			= (ldb_tasa / 36000) * ldb_val_cta_cred
										  id_monto 			= round((id_monto * ii_mora_cobro), 0)
										  id_im				= id_monto
										  IF ll_acum_dias > 30 THEN
											if gs_base='G' then
												id_gc 			= Truncate(ldb_val_cta_cred * id_factor_gc, 0)
											else
												id_gc 			= Round(ldb_val_cta_cred * id_factor_gc, 0)
											end if
										  else
											id_gc		= 0
										  END IF;
										  ldt_fecha_venc_calc			= ldt_fecha_venc
										  SELECT add_months( :ldt_fecha_venc_calc, :ll_cant_cred ) INTO :ld_fecha_venc_cred  FROM dual ;
//										  ld_fecha_venc_cred			= datetime(RelativeDate( date( ldt_fecha_venc_calc), ll_cant_cred ))
					
										  if ld_fecha_venc_cred > ldt_fecha_hoy then
											ld_fecha_venc_cred		= ldt_fecha_hoy
										  else
											ldt_fecha_venc				= ld_fecha_venc_cred
										  end if
					
										  ll_dias							= DaysAfter(date( ld_fecha_venc_cred) , date(ldt_fecha_venc_calc) )  // ld_fecha_venc_cred - ldt_fecha_venc_calc
										  ll_acum_dias					= ll_acum_dias + ll_dias
									 else    
										  ii_mora_cobro					= 0
										  id_im							= 0
										  id_gc							= 0
									 end if
								else
									 id_im 								= 0
									 id_gc 								= 0
								end if;
							else
								id_im 										= 0
								id_gc 										= 0
							end if;
							ll_mora										= ll_mora + id_im
							ll_suma_acum_gc							= ll_suma_acum_gc + id_gc
							 
							ll_sumar_mes								= ll_sumar_mes + 1
				///////////Mirko Fin		
						NEXT

						ll_gasto_cob						= ll_gasto_cob + ll_suma_acum_gc//id_gc// + ll_acum_gasto
//						ll_mora								= ll_mora + id_im// + ll_acum_mora
//						ll_mora								= ll_mora + ll_suma_acum_gc//id_im
//						ll_gasto_cob						= ll_gasto_cob + id_gc
						w_ingreso2.tab_ingreso.tp_boletas.dw_gastos_bl.SetItem(1,"gastos_cob", ll_gasto_cob)//ll_suma_acum_gc )// + ll_acum_gasto
						w_ingreso2.tab_ingreso.tp_boletas.dw_gastos_bl.SetItem(1,"mora", ll_mora)//id_im )//+ ll_acum_mora
						il_int_mora							= ll_mora			// id_im
						il_int_gc								= ll_gasto_cob		//ll_suma_acum_gc
//						id_im									= ll_acum_id_im
						w_ingreso2.tab_ingreso.tp_boletas.dw_detalle_bl.accepttext()
						ll_total_monto						= w_ingreso2.tab_ingreso.tp_boletas.dw_detalle_bl.GetItemNumber(1,"c_subtotal_total")
						w_ingreso2.tab_ingreso.tp_boletas.dw_gastos_bl.SetItem(1,"Subtotal", ll_total_monto)
						w_ingreso2.tab_ingreso.tp_boletas.dw_gastos_bl.accepttext()
						
					elseif ls_tipo_cob='A' then
						FOR i = 1 TO ii_cantidad 
							if i > 1 then
								il_suma_dia ++
								ii_dmora				= ii_dmora - il_suma_dia
							else
								il_suma_dia			= 0
							end if
							IF ((ii_dmora - (i - 1) * (ll_cant_cred * 30))) > 5 AND tab_ingreso.tp_boletas.cbx_sin_mora_bl.Checked = False THEN
								ii_mora_cobro 		= ((ii_dmora - (i - 1) * (ll_cant_cred * 30)))
								id_im 					= id_im + gf_int_mora(w_ingreso2.tab_ingreso.tp_boletas.dw_datos_bl.GetItemNumber(1,"c_tasa"), ii_mora_cobro, id_valor_cuota)
								IF ((ii_dmora - (i - 1) * (ll_cant_cred * 30))) > 30 AND tab_ingreso.tp_boletas.cbx_sin_gastos_bl.Checked = False THEN		
									id_gc 				= id_gc + Round(id_valor_cuota * id_factor_gc, 0)
									ii_inc_gastos	= 1
								END IF
							ELSE
//								ii_mora_cobro 		= 0
//								id_im 					= 0
//								id_gc 					= 0
							END IF	
						NEXT
						ll_gasto_cob					= ll_gasto_cob + id_gc //+ ll_acum_gasto
						ll_mora						= ll_mora + id_im //+ ll_acum_mora
						w_ingreso2.tab_ingreso.tp_boletas.dw_gastos_bl.SetItem(1,"gastos_cob", ll_gasto_cob)
						w_ingreso2.tab_ingreso.tp_boletas.dw_gastos_bl.SetItem(1,"mora", ll_mora)
						il_int_mora					= ll_mora
						il_int_gc						= ll_gasto_cob
						w_ingreso2.tab_ingreso.tp_boletas.dw_detalle_bl.accepttext()
						ll_total_monto				= w_ingreso2.tab_ingreso.tp_boletas.dw_detalle_bl.GetItemNumber(1,"c_subtotal_total")
						w_ingreso2.tab_ingreso.tp_boletas.dw_gastos_bl.SetItem(1,"Subtotal", ll_total_monto)
						w_ingreso2.tab_ingreso.tp_boletas.dw_gastos_bl.accepttext()
						
					elseif ls_tipo_cob='F' then
						id_gc 							= 0
						id_im 							= 0
						ii_mora_cobro 				= 0
						ii_inc_gastos 				= 0
						FOR i = 1 TO ii_cantidad 
							IF ((ii_dmora - (i - 1) * (ll_cant_mant * 30))) > 5 AND tab_ingreso.tp_boletas.cbx_sin_mora_bl.Checked = False THEN 
								ii_mora_cobro		= ((ii_dmora - (i - 1) * (ll_cant_mant * 30)))
								id_im 					= id_im + gf_int_mora(id_tasa_mant, ii_mora_cobro, id_valor_cuota)
								IF ((ii_dmora - (i - 1) * (ll_cant_mant * 30))) > 30 AND tab_ingreso.tp_boletas.cbx_sin_gastos_bl.Checked = False THEN 
									 id_gc 			= id_gc + Round(id_valor_cuota * id_factor_gc, 0)
									 ii_inc_gastos 	= 1
								END IF
							ELSE
//								id_gc 					= 0
//								id_im 					= 0
//								ii_mora_cobro		= 0
							END IF
						NEXT
						ll_gasto_cob				= ll_gasto_cob + id_gc// + ll_acum_gasto
						ll_mora						= ll_mora + id_im// + ll_acum_mora
						w_ingreso2.tab_ingreso.tp_boletas.dw_gastos_bl.SetItem(1,"gastos_cob", ll_gasto_cob)
						w_ingreso2.tab_ingreso.tp_boletas.dw_gastos_bl.SetItem(1,"mora", ll_mora)
						il_int_mora					= ll_mora
						il_int_gc						= ll_gasto_cob
						w_ingreso2.tab_ingreso.tp_boletas.dw_detalle_bl.accepttext()
						ll_total_monto				= w_ingreso2.tab_ingreso.tp_boletas.dw_detalle_bl.GetItemNumber(1,"c_subtotal_total")
						w_ingreso2.tab_ingreso.tp_boletas.dw_gastos_bl.SetItem(1,"Subtotal", ll_total_monto)
						w_ingreso2.tab_ingreso.tp_boletas.dw_gastos_bl.accepttext()
					end if
				end if
			end if
		next
		
		if w_ingreso2.tab_ingreso.tp_boletas.dw_gastos_bl.getitemnumber(1,"Subtotal")=0 or isnull(w_ingreso2.tab_ingreso.tp_boletas.dw_gastos_bl.getitemnumber(1,"Subtotal")) then
			w_ingreso2.tab_ingreso.tp_boletas.dw_gastos_bl.SetItem(1,"gastos_cob", 0)
			w_ingreso2.tab_ingreso.tp_boletas.dw_gastos_bl.SetItem(1,"mora", 0)
		end if	
	end if
end if
end subroutine

public subroutine wf_limpiar_opciones ();tab_ingreso.tp_cupon.cb_limpiar_cupon.triggerevent(clicked!)
tab_ingreso.tp_ci.cb_ci_borrar.triggerevent(clicked!)
tab_ingreso.tp_boletas.cb_bl_borrar.triggerevent(clicked!)
tab_ingreso.tp_be.cb_be_borrar.triggerevent(clicked!)
//tab_ingreso.tp_boletas.cb_bl_borrar.triggerevent(clicked!)
//tab_ingreso.tp_repacta_bl_mant.cb_bl_borrar_repac.triggerevent(clicked!)
//tab_ingreso.tp_traspaso.cb_ci_borrar_2.triggerevent(clicked!)
end subroutine

public subroutine wf_calcular_interes (string as_cobro);Long		ii_cantidad,ii_dmora,ii_mora_cobro,ii_inc_gastos,i,ll_gasto_cob,ll_mora,ll_gastos,	ll_tot_reg,ll_indi,ll_monto,ll_total_monto,ll_cant_mant,&
			ll_cuota,ll_day,ll_month,ll_year,ll_suma_dias,ll_tot_fila,ll_reg,ll_dias_mora,ll_ctas_mora,ll_calc_dias,ld_dias_sum_mora,ll_cant_cred,&
			ldb_mora=0,id_valor_cuota,id_im, id_gc,ll_new,ll_dias_dif,ll_ctas_pag,ldb_suma_gasto_cob=0,ll_max,ll_dia_prox_pago,ll_mora_cred,ll_gasto_cred,&
			ll_suma_acum_gc,ll_valor_int,ll_acum_gasto,ll_acum_mora,ll_count_filas,ll_count_f,ll_count_e,ll_acum_id_im,ll_acum_id_gc,ll_cant,ll_mora_mant,ll_gasto_mant,ll_acum_dias,&
			ll_dias_mora_cred,ll_sumar_mes,ll_dias
String		ls_tipo_cob,ls_pasa,ls_fecha,ls_tipo_cob_reg
Date		ld_fecha_prox_pago,ld_fecha_hoy,ld_fecha_inicial,ld_fecha_prox_venc
Datetime	ldt_fecha_prim,ldt_fecha_venc_calc,ldt_fecha_venc,ld_fecha_venc_cred,ldt_fecha_hoy
Double	ldb_valor,ldb_tasa,ldb_val_cta_cred,id_monto

if tab_ingreso.SelectedTab = 1 then // cupon
elseif tab_ingreso.SelectedTab = 2 then //Comprobante Ingreso
	w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.accepttext()
elseif tab_ingreso.SelectedTab = 3 then //Boleta
	w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.accepttext()
end if
IF gs_rezago <> "S" THEN
	SELECT 	"ESTADO_MORA_MANTENCION"."CANTIDAD_MESES", 	"ESTADO_MORA_CREDITO"."CANTIDAD_MESES"  
	INTO   	:ll_cant_mant,														:ll_cant_cred
	FROM   "CADENA", "ESTADO_MORA_CREDITO", "ESTADO_MORA_MANTENCION"  
	WHERE ("CADENA"."ESTADO_MORA_CREDITO" = "ESTADO_MORA_CREDITO"."ESTADO_MORA_CREDITO" ) and  
			( "CADENA"."ESTADO_MORA_MANTENCION" = "ESTADO_MORA_MANTENCION"."ESTADO_MORA_MANTENCION" ) and  
			(("CADENA"."CODIGO" = :gs_base ) AND  
			( "CADENA"."SERIE" = :gs_serie ) AND  
			( "CADENA"."NUMERO" = :gi_numero ) )   ;
			
	ld_fecha_hoy							= date(gdt_fec_sistema)
	ldt_fecha_hoy							= datetime(date(gdt_fec_sistema),time('00:00:00'))
	il_int_mora								= 0
	il_int_mora_cred						= 0
	il_int_mora_mant						= 0
	il_int_gc									= 0
	il_int_gc_cred							= 0
	il_int_gc_mant							= 0
	if tab_ingreso.SelectedTab = 1 then // cupon
	elseif tab_ingreso.SelectedTab = 2 then //Comprobante Ingreso
		if isnull(w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.getitemnumber(1,'gastos_cob')) then
			w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.setitem(1,'gastos_cob',0)
		end if
		if isnull(w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.getitemnumber(1,'mora')) then
			w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.setitem(1,'mora',0)
		end if
		if isnull(w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.getitemnumber(1,'gasto_mant')) then
			w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.setitem(1,'gasto_mant',0)
		end if
		if isnull(w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.getitemnumber(1,'mora_mant')) then
			w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.setitem(1,'mora_mant',0)
		end if
		ll_acum_gasto						= w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.getitemnumber(1,'gastos_cob')
		ll_acum_mora						= w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.getitemnumber(1,'mora')
	elseif tab_ingreso.SelectedTab = 3 then //Boleta
		if isnull(w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.getitemnumber(1,'gastos_cob')) then
			w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.setitem(1,'gastos_cob',0)
		end if
		if isnull(w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.getitemnumber(1,'mora')) then
			w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.setitem(1,'mora',0)
		end if
		if isnull(w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.getitemnumber(1,'gasto_mant')) then
			w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.setitem(1,'gasto_mant',0)
		end if
		if isnull(w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.getitemnumber(1,'mora_mant')) then
			w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.setitem(1,'mora_mant',0)
		end if
		ll_acum_gasto						= w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.getitemnumber(1,'gastos_cob')
		ll_acum_mora						= w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.getitemnumber(1,'mora')
	end if
	
	if isnull(ll_acum_gasto) then ll_acum_gasto=0
	if isnull(ll_acum_mora) then ll_acum_mora=0
	if tab_ingreso.SelectedTab = 1 then // cupon
	elseif tab_ingreso.SelectedTab = 2 then //Comprobante Ingreso
		ls_tipo_cob_reg					= w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.getitemstring(w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.getrow(),"tipo_cob")
	elseif tab_ingreso.SelectedTab = 3 then //Boleta
		ls_tipo_cob_reg					= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.getitemstring(w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.getrow(),"tipo_cob")
	end if
	//if ls_tipo_cob_reg='E' or ls_tipo_cob_reg='A' or ls_tipo_cob_reg='Q' or ls_tipo_cob_reg='U' then
	if ls_tipo_cob_reg<>'F' then
		if tab_ingreso.SelectedTab = 1 then // cupon
		elseif tab_ingreso.SelectedTab = 2 then //Comprobante Ingreso
			ll_count_f 				= w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.Find("tipo_cob ='F'",1, ll_tot_reg)
		elseif tab_ingreso.SelectedTab = 3 then //Boleta
			ll_count_f 				= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob ='F'",1, ll_tot_reg)
		end if
		
		if ll_count_f = 0 then
			if tab_ingreso.SelectedTab = 1 then // cupon
			elseif tab_ingreso.SelectedTab = 2 then //Comprobante Ingreso
				w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.SetItem(1,'gasto_mant', 0)
				w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.SetItem(1,'mora_mant', 0)
				ll_mora_cred		= w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.getitemnumber(1,'mora_cred')
				ll_gasto_cred		= w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.getitemnumber(1,'gasto_cred')
				if isnull(ll_mora_cred) then ll_mora_cred=0
				if isnull(ll_gasto_cred) then ll_gasto_cred=0
				w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.SetItem(1,'mora',ll_mora_cred)
				w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.SetItem(1,'gastos_cob',ll_gasto_cred)
				w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.accepttext()
			elseif tab_ingreso.SelectedTab = 3 then //Boleta
				w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1,'gasto_mant', 0)
				w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1,'mora_mant', 0)
				ll_mora_cred		= w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.getitemnumber(1,'mora_cred')
				ll_gasto_cred		= w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.getitemnumber(1,'gasto_cred')
				if isnull(ll_mora_cred) then ll_mora_cred=0
				if isnull(ll_gasto_cred) then ll_gasto_cred=0
				w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1,'mora',ll_mora_cred)
				w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1,'gastos_cob',ll_gasto_cred)
				w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.accepttext()
			end if
			
		end if
	elseif ls_tipo_cob_reg='F' then
		if tab_ingreso.SelectedTab = 1 then // cupon
		elseif tab_ingreso.SelectedTab = 2 then //Comprobante Ingreso
			ll_count_e 				= w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.Find("tipo_cob ='E' or tipo_cob ='A' or tipo_cob ='Q' or tipo_cob ='U'",1, ll_tot_reg)
			if ll_count_e = 0 then
				w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.SetItem(1,'gasto_cred', 0)
				w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.SetItem(1,'mora_cred', 0)
				ll_mora_mant		= w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.getitemnumber(1,'mora_mant')
				ll_gasto_mant		= w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.getitemnumber(1,'gasto_mant')
				if isnull(ll_mora_mant) then ll_mora_mant=0
				if isnull(ll_gasto_mant) then ll_gasto_mant=0
				w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.SetItem(1,'mora',ll_mora_mant)
				w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.SetItem(1,'gastos_cob',ll_gasto_mant)
				w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.accepttext()
			end if
		elseif tab_ingreso.SelectedTab = 3 then //Boleta
			ll_count_e 				= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob ='E' or tipo_cob ='A' or tipo_cob ='Q' or tipo_cob ='U'",1, ll_tot_reg)
			if ll_count_e = 0 then
				w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1,'gasto_cred', 0)
				w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1,'mora_cred', 0)
				ll_mora_mant		= w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.getitemnumber(1,'mora_mant')
				ll_gasto_mant		= w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.getitemnumber(1,'gasto_mant')
				if isnull(ll_mora_mant) then ll_mora_mant=0
				if isnull(ll_gasto_mant) then ll_gasto_mant=0
				w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1,'mora',ll_mora_mant)
				w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1,'gastos_cob',ll_gasto_mant)
				w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.accepttext()
			end if
		end if
	end if
//	w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.SetItem(1,'gastos_cob', 0)
//	w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.SetItem(1,'mora', 0)
	if tab_ingreso.SelectedTab = 1 then // cupon
	elseif tab_ingreso.SelectedTab = 2 then //Comprobante Ingreso
		w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.SetItem(1,'incluir_gastos', 1)
		w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.accepttext()
		w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.accepttext()
		ll_tot_reg								= w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.rowcount()
	elseif tab_ingreso.SelectedTab = 3 then //Boleta
		w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1,'incluir_gastos', 1)
		w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.accepttext()
		w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.accepttext()
		ll_tot_reg								= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount()
	end if
	if ll_tot_reg > 0 then
		for ll_indi = 1 to ll_tot_reg
			if tab_ingreso.SelectedTab = 1 then // cupon
			elseif tab_ingreso.SelectedTab = 2 then //Comprobante Ingreso
				ls_tipo_cob						= w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.getitemstring(ll_indi,"tipo_cob")
			elseif tab_ingreso.SelectedTab = 3 then //Boleta
				ls_tipo_cob						= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.getitemstring(ll_indi,"tipo_cob")
			end if
			if ls_tipo_cob='E' or ls_tipo_cob='A' or ls_tipo_cob='Q' or ls_tipo_cob='U' or ls_tipo_cob='F' then
				if tab_ingreso.SelectedTab = 1 then // cupon
				elseif tab_ingreso.SelectedTab = 2 then //Comprobante Ingreso
					ii_cantidad 					= w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.GetItemNumber(ll_indi,"cantidad")
					ll_monto						= w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.GetItemNumber(ll_indi,"c_total_linea")
					gl_n_cuotas_pag 			= ii_cantidad 
					if ls_tipo_cob='E' or ls_tipo_cob='U' then
						ll_cuota					= w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.getitemnumber(1, "c_cuotas_mora")
						id_valor_cuota 			= Round(w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.GetItemNumber(1,"c_valor_cuota_pesos"), 0)
						if gs_base='O' or gs_base='U' or gs_base='M' then
							ldt_fecha_prim		= w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.GetItemdatetime(1,'pago_oferta_fecha_prim')
							ll_ctas_pag			= w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.GetItemnumber(1,'oferta_v_cta_pag_s')
						elseif gs_base='L' then
							ldt_fecha_prim		= w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.GetItemdatetime(1,'pago_liberador_fecha_prim')
							ll_ctas_pag			= w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.GetItemnumber(1,'anexo_liberador_cta_pag_m')
						elseif gs_base='F' or gs_base='G' or gs_base='V' then
							ldt_fecha_prim		= w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.GetItemdatetime(1,'producto_pago_fecha_prim')
							ll_ctas_pag			= w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.GetItemnumber(1,'producto_anexo_cuotas_pag')
						elseif gs_base='A' then
							ldt_fecha_prim		= w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.GetItemdatetime(1,'pago_aumento_fecha_prim')
							ll_ctas_pag			= w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.GetItemnumber(1,'anexo_aumento_cta_pag_m')
						elseif gs_base='R' then
							ldt_fecha_prim		= w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.GetItemdatetime(1,'fecha_primera_cta')
							ll_ctas_pag			= w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.GetItemnumber(1,'ctas_pagadas')
						elseif gs_base='P' then
							ldt_fecha_prim		= w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.GetItemdatetime(1,'pagare_fecha_prim')
							ll_ctas_pag			= w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.GetItemnumber(1,'c_cuotas_pagadas')
						elseif gs_base='D' then
							ldt_fecha_prim		= w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.GetItemdatetime(1,'derecho_fecha_prim')
							ll_ctas_pag			= w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.GetItemnumber(1,'c_cuotas_pagadas')
						end if
						ld_fecha_prox_pago	= date(DATEtime(funcion_venc( ldt_fecha_prim , ll_ctas_pag ))) //-1
						ii_dmora 				= w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.GetItemNumber(1,"c_dias_mora")
						ll_ctas_mora			= w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.GetItemNumber(1,'c_cuotas_mora')
	
					elseif ls_tipo_cob='A' or ls_tipo_cob='Q' then
						id_valor_cuota 			= ll_monto
						ii_dmora 				= w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.GetItemNumber(1,'c_dias_mora_pie')
					elseif ls_tipo_cob='F' then
						if gs_base='O' or gs_base='C' or gs_base='U' or gs_base='M' then
							id_valor_cuota 		= Round(w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.GetItemNumber(1,"c_valor_cuota_mantencion_pesos"), 0)
