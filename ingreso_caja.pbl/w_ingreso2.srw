this.st_help_descuento_be=create st_help_descuento_be
this.pb_ficha_be=create pb_ficha_be
this.st_help_ficha_be=create st_help_ficha_be
this.cb_be_borrar_item=create cb_be_borrar_item
this.st_help_eliminar_be=create st_help_eliminar_be
this.cb_be_insertar=create cb_be_insertar
this.st_help_insertar_be=create st_help_insertar_be
this.cb_be_borrar=create cb_be_borrar
this.cb_ingresar_pago_be=create cb_ingresar_pago_be
this.cbx_sin_gastos_be=create cbx_sin_gastos_be
this.cbx_sin_mora_be=create cbx_sin_mora_be
this.dw_detalle_be=create dw_detalle_be
this.sle_numero_be=create sle_numero_be
this.st_26=create st_26
this.st_24=create st_24
this.st_23=create st_23
this.rb_be_exenta=create rb_be_exenta
this.rb_be_afecta=create rb_be_afecta
this.dw_datos_be=create dw_datos_be
this.cb_asigna_be=create cb_asigna_be
this.st_22=create st_22
this.rb_be_peso=create rb_be_peso
this.rb_be_uf=create rb_be_uf
this.cbx_paga_ef_be=create cbx_paga_ef_be
this.dw_be_buscar_cliente=create dw_be_buscar_cliente
this.gb_1_be=create gb_1_be
this.st_25=create st_25
this.dw_gastos_be=create dw_gastos_be
this.dw_parque_be=create dw_parque_be
this.st_31=create st_31
this.Control[]={this.cbx_reingresobe,&
this.cbx_manual_be,&
this.st_help_descuento_be,&
this.pb_ficha_be,&
this.st_help_ficha_be,&
this.cb_be_borrar_item,&
this.st_help_eliminar_be,&
this.cb_be_insertar,&
this.st_help_insertar_be,&
this.cb_be_borrar,&
this.cb_ingresar_pago_be,&
this.cbx_sin_gastos_be,&
this.cbx_sin_mora_be,&
this.dw_detalle_be,&
this.sle_numero_be,&
this.st_26,&
this.st_24,&
this.st_23,&
this.rb_be_exenta,&
this.rb_be_afecta,&
this.dw_datos_be,&
this.cb_asigna_be,&
this.st_22,&
this.rb_be_peso,&
this.rb_be_uf,&
this.cbx_paga_ef_be,&
this.dw_be_buscar_cliente,&
this.gb_1_be,&
this.st_25,&
this.dw_gastos_be,&
this.dw_parque_be,&
this.st_31}
end on

on tp_be.destroy
destroy(this.cbx_reingresobe)
destroy(this.cbx_manual_be)
destroy(this.st_help_descuento_be)
destroy(this.pb_ficha_be)
destroy(this.st_help_ficha_be)
destroy(this.cb_be_borrar_item)
destroy(this.st_help_eliminar_be)
destroy(this.cb_be_insertar)
destroy(this.st_help_insertar_be)
destroy(this.cb_be_borrar)
destroy(this.cb_ingresar_pago_be)
destroy(this.cbx_sin_gastos_be)
destroy(this.cbx_sin_mora_be)
destroy(this.dw_detalle_be)
destroy(this.sle_numero_be)
destroy(this.st_26)
destroy(this.st_24)
destroy(this.st_23)
destroy(this.rb_be_exenta)
destroy(this.rb_be_afecta)
destroy(this.dw_datos_be)
destroy(this.cb_asigna_be)
destroy(this.st_22)
destroy(this.rb_be_peso)
destroy(this.rb_be_uf)
destroy(this.cbx_paga_ef_be)
destroy(this.dw_be_buscar_cliente)
destroy(this.gb_1_be)
destroy(this.st_25)
destroy(this.dw_gastos_be)
destroy(this.dw_parque_be)
destroy(this.st_31)
end on

type cbx_reingresobe from checkbox within tp_be
boolean visible = false
integer x = 507
integer y = 1412
integer width = 576
integer height = 84
integer textsize = -8
integer weight = 700
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
long textcolor = 33554432
long backcolor = 67108864
boolean enabled = false
string text = " Re-Ingreso Pago"
boolean automatic = false
end type

event clicked;Long	ll_count_ne

if cbx_reingresobe.checked = true then
	gs_reingreso_be	= 'S'
	SELECT 	count("INGRESO"."TIPO_COB"  )
	INTO 		:ll_count_ne  
	FROM 	"INGRESO"  
	WHERE 	( "INGRESO"."RUT" = :gi_rut ) AND  
				( "INGRESO"."TIPO_COB" = 'NE' )  
	USING	sqlca;
	if ll_count_ne = 0 then
		messagebox("Advertencia","Cliente No Registra Nota de Crédito Electrónica")
		cbx_reingresobe.checked	= false
		gs_reingreso_be				= 'N'
	end if
else
	gs_reingreso_be					= 'N'
end if
end event

type cbx_manual_be from checkbox within tp_be
event ue_mousemove pbm_mousemove
boolean visible = false
integer x = 1294
integer y = 304
integer width = 379
integer height = 92
integer textsize = -11
integer weight = 700
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Tahoma"
long backcolor = 79741120
string text = "Manual"
end type

event ue_mousemove;if is_opcion='FP' and (gs_depto='T' or gs_depto='I') then st_fuera_plazo.visible = true
end event

event clicked;Long		ll_min_boleta,ll_rut,ll_grupo,ll_pos,ll_folio
datetime	ldt_fecha_pago
String		ls_dv,ls_nombre,ls_ap_pat,ls_ap_mat,ls_nom_paso,ls_base,ls_serie
Double	ll_numero

ll_folio									= long(sle_numero_be.text)
if cbx_manual_be.checked=true then
	if ll_folio > 0 then
		wf_limpiar_boleta_electronica(ll_folio)
	end if
	sle_numero_be.text				= ''
	dw_detalle_be.reset()
	dw_gastos_be.reset()
	sle_numero_be.enabled			= true
	cb_be_insertar.enabled			= false
	cb_be_borrar_item.enabled		= false
	pb_ficha_be.enabled				= false
	gs_tipo_cobro						= "BE"
	cb_asigna_be.enabled			= false
//	rb_be_exento.checked			= true
//	rb_be_afecto.checked				= false
//	rb_be_exento.enabled			= false
//	rb_be_afecto.enabled				= false
	sle_numero_be.setfocus()
else
	sle_numero_be.text				= ''
	dw_detalle_be.reset()
	dw_gastos_be.reset()
	cb_asigna_be.enabled			= true
//	rb_be_exento.checked			= true
//	rb_be_afecto.checked				= false
//	rb_be_exento.enabled			= true
//	rb_be_afecto.enabled				= true
	cb_asigna_be.setfocus()
end if
end event

