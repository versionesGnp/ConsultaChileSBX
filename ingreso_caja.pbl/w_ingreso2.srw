//			ls_fecha						= string(ll_day,'00')+'/'+string(ll_month,'00')+'/'+string(ll_year,'0000')
//			ld_fecha_prox_venc		= date(ls_fecha)
//			dw_dias_mora.setitem(ll_new,'fecha_inicial',ld_fecha_inicial)
//			if ld_fecha_prox_venc > ld_fecha_hoy then 
//				ld_fecha_prox_venc	= ld_fecha_hoy
//			end if
//			dw_dias_mora.setitem(ll_new,'fecha_venc',ld_fecha_prox_venc)
//			if ld_fecha_prox_venc < ld_fecha_hoy then
//				ll_dias_dif				= 0
//				ll_dias_dif				= DaysAfter(ld_fecha_inicial, ld_fecha_prox_venc)
//				if ll_dias_dif<=0 then ll_dias_dif=0
//				dw_dias_mora.setitem(ll_new,'dias_mora',ll_dias_dif)
//				ld_fecha_inicial			= ld_fecha_prox_venc
//			else
//				ll_dias_dif				= 0
//				ll_dias_dif				= DaysAfter(ld_fecha_inicial, ld_fecha_hoy) //ld_fecha_prox_venc)
//				if ll_dias_dif<=0 then ll_dias_dif=0
//				dw_dias_mora.setitem(ll_new,'dias_mora',ll_dias_dif)
//				ld_fecha_inicial			= ld_fecha_prox_venc
//				ll_suma_dias			= ll_suma_dias + ll_dias_dif
//				exit
//			end if
//			ll_suma_dias				= ll_suma_dias + ll_dias_dif
//		NEXT
//		ll_tot_fila							= dw_dias_mora.rowcount()
//		for ll_reg=1 to ll_tot_fila
//			ll_suma_dias				= ll_suma_dias - ll_dias_mora
//			dw_dias_mora.setitem(ll_reg,'suma_dias',ll_suma_dias)
//			ll_dias_mora				= dw_dias_mora.getitemnumber(ll_reg,'dias_mora')
//		next
//		dw_dias_mora.accepttext()
//		ii_dmora							= 0
//		ii_mora_cobro					= 0
//		id_im								= 0
//		id_gc								= 0
//		FOR i = 1 TO ii_cantidad
//			if ll_tot_fila > 0 and i <= ll_cuota then //ll_ctas_mora
//				ii_dmora					= dw_dias_mora.GetItemNumber(i, "suma_dias")
//				ll_dias_mora			= dw_dias_mora.GetItemNumber(i, "dias_mora")
//				IF (ii_dmora > 5 AND tab_ingreso.tp_be.cbx_sin_mora_be.Checked = False) THEN
//					ii_mora_cobro   	= ii_dmora
//					ll_valor_int			= gf_int_mora(w_ingreso2.tab_ingreso.tp_be.dw_datos_be.GetItemNumber(1,"c_tasa"), ii_mora_cobro, id_valor_cuota)
//					id_im 					= id_im + ll_valor_int
//					IF (ii_dmora > ll_dias_mora AND tab_ingreso.tp_be.cbx_sin_gastos_be.Checked = False) THEN    
//						id_gc     			= Round(id_valor_cuota * id_factor_gc, 0)
//						ll_suma_acum_gc	= ll_suma_acum_gc + id_gc
//					END IF
//				END IF  
//			end if
//		NEXT
/////// Mirko Inicio
		ll_acum_dias		= ii_dmora
		ll_dias_mora_cred	= ii_dmora
   		ll_sumar_mes		= 1
          id_im 					= 0
          id_gc 					= 0
          ll_indi 					= 1
		ldb_tasa				= w_ingreso2.tab_ingreso.tp_be.dw_datos_be.GetItemNumber(1,"c_tasa")
		ldb_val_cta_cred	= id_valor_cuota
		ll_mora_cred		= ll_ctas_mora			
		FOR i = 1 TO ii_cantidad
			if ll_mora_cred > 0 then 
				if ll_sumar_mes <= ll_mora_cred then
					 IF ll_acum_dias > 5 and ll_dias_mora_cred > 5 THEN  
						  ii_mora_cobro		= ll_acum_dias
						  id_monto			= (ldb_tasa / 36000) * ldb_val_cta_cred
						  id_monto 			= round((id_monto * ii_mora_cobro), 0)
						  id_im				= id_monto
						  IF ll_acum_dias > 30 THEN
							id_gc 		= Round(ldb_val_cta_cred * id_factor_gc, 0)
						  else
							id_gc		= 0
						  END IF;
						  ldt_fecha_venc_calc			= ldt_fecha_venc
						  SELECT add_months( :ldt_fecha_venc_calc, :ll_cant_cred ) INTO :ld_fecha_venc_cred  FROM dual ;
//						  ld_fecha_venc_cred			= datetime(RelativeDate( date( ldt_fecha_venc_calc), ll_cant_cred ))
	
						  if ld_fecha_venc_cred > ldt_fecha_hoy then
								ld_fecha_venc_cred	= ldt_fecha_hoy
						  else
								ldt_fecha_venc			= ld_fecha_venc_cred
						  end if
	
						  ll_dias							= DaysAfter(date( ld_fecha_venc_cred) , date(ldt_fecha_venc_calc) )  // ld_fecha_venc_cred - ldt_fecha_venc_calc
						  ll_acum_dias					= ll_acum_dias + ll_dias
					 else    
						  ii_mora_cobro					= 0
						  id_im							= 0
						  id_gc							= 0
					 end if
				else
					 id_im 								= 0
					 id_gc 								= 0
				end if;
		  	else
				id_im 										= 0
				id_gc 										= 0
		  	end if;
			ll_mora										= ll_mora + id_im
			ll_suma_acum_gc							= ll_suma_acum_gc + id_gc
			 
			ll_sumar_mes								= ll_sumar_mes + 1
///////////Mirko Fin		
		NEXT

		ll_gasto_cob									= ll_gasto_cob + ll_suma_acum_gc//id_gc// + ll_acum_gasto
		ll_mora											= ll_mora + id_im	// + ll_acum_mora
		id_im												= ll_mora
		if isnull(ll_gasto_cob) then ll_gasto_cob=0
		if isnull(ll_mora) then ll_mora=0
		w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.accepttext()
		ll_total_monto									= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.GetItemNumber(1,"c_subtotal_total")
		w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.accepttext()
	end if
	ll_monto_cred										= ll_monto_cred + ll_mora
end if

Return (ll_monto_cred)
end function

public subroutine wf_actualizar_abono (string as_tipo_mov);Long		ll_folio,ll_count_e,ll_count_f,ll_count_abono,ll_tot_reg,ll_indi,ll_cantidad,ll_ctas,&
			ll_ctas_pagadas,ll_ctas_pagadas_1,ll_ctas_pagadas_2,ll_monto_cred,ll_monto_mora_cred,&
			ll_sum_monto_abono,ll_monto_cta,ll_monto_final_cred,ll_monto_mant,ll_monto_mora_mant,&
			ll_monto_final_mant
String	ls_tipo_cob,ls_pasa,ls_tipo_mov_sel
Datetime	ldt_fecha_hoy

ls_tipo_cob				= gs_tipo_cobro
ls_pasa					= 'N'
SELECT sysdate INTO :gdt_fec_sistema FROM "TASA" WHERE "TASA"."LOOK" = 1 ;
ldt_fecha_hoy			= datetime(date(gdt_fec_sistema),time('00:00:00'))
if tab_ingreso.SelectedTab = 1 then // cupon
elseif tab_ingreso.SelectedTab = 2 then //Comprobante Ingreso
	ll_folio					= Long(tab_ingreso.tp_ci.sle_numero_ci.text)
elseif tab_ingreso.SelectedTab = 3 then //Boleta
	ll_folio					= Long(tab_ingreso.tp_be.sle_numero_be.text)
end if
if ll_folio > 0 then
	SELECT	Count("ABONO_CTA_CTE"."BASE")  
	INTO 		:ll_count_e
	FROM 	"ABONO_CTA_CTE"  
	WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
			 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
			 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
			 ( "ABONO_CTA_CTE"."TIPO_COB_OCUPA" = :ls_tipo_cob ) AND  
			 ( "ABONO_CTA_CTE"."FOLIO_OCUPA" = :ll_folio ) AND  
			 ( "ABONO_CTA_CTE"."TIPO_MOV_OCUPA" = 'E' )   
	USING		sqlca;
	
	SELECT	Count("ABONO_CTA_CTE"."BASE")  
	INTO 		:ll_count_f  
	FROM 	"ABONO_CTA_CTE"  
	WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
			 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
			 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
			 ( "ABONO_CTA_CTE"."TIPO_COB_OCUPA" = :ls_tipo_cob ) AND  
			 ( "ABONO_CTA_CTE"."FOLIO_OCUPA" = :ll_folio ) AND  
			 ( "ABONO_CTA_CTE"."TIPO_MOV_OCUPA" = 'F' )   
	USING		sqlca;

	
	SELECT	Count("ABONO_CTA_CTE"."BASE")  
	INTO 		:ll_count_abono  
	FROM 	"ABONO_CTA_CTE"  
	WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
			 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
			 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
			 ( "ABONO_CTA_CTE"."TIPO_COB" = :ls_tipo_cob ) AND  
			 ( "ABONO_CTA_CTE"."FOLIO" = :ll_folio ) AND
			 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )  
	USING		sqlca;
	if ll_count_abono > 0 then
		DELETE FROM "ABONO_CTA_CTE"  
		WHERE		( "ABONO_CTA_CTE"."TIPO_COB" = :ls_tipo_cob ) AND  
					( "ABONO_CTA_CTE"."FOLIO" = :ll_folio ) AND  
					( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
					( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
					( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
					( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
		USING		sqlca;
		if sqlca.sqlcode = 0 then
			commit;
			ls_pasa			= 'S'
		else
			rollback;
			messagebox("Error Eliminar","Error ELIMINAR ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
		end if
	end if
	SELECT	Count("ABONO_CTA_CTE"."BASE")  
	INTO 		:ll_count_abono  
	FROM 	"ABONO_CTA_CTE"  
	WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
			 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
			 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
			 ( "ABONO_CTA_CTE"."TIPO_COB" = :ls_tipo_cob ) AND  
			 ( "ABONO_CTA_CTE"."FOLIO" = :ll_folio ) AND
			 ( "ABONO_CTA_CTE"."TIPO_COB_OCUPA" = :ls_tipo_cob ) AND  
			 ( "ABONO_CTA_CTE"."FOLIO_OCUPA" = :ll_folio ) AND 
			 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'O' )  
	USING		sqlca;
	if ll_count_abono > 0 then
		DELETE FROM "ABONO_CTA_CTE"  
		WHERE	( "ABONO_CTA_CTE"."TIPO_COB" = :ls_tipo_cob ) AND  
					( "ABONO_CTA_CTE"."FOLIO" = :ll_folio ) AND  
					( "ABONO_CTA_CTE"."TIPO_COB_OCUPA" = :ls_tipo_cob ) AND  
					( "ABONO_CTA_CTE"."FOLIO_OCUPA" = :ll_folio ) AND 
					( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
					( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
					( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
					( "ABONO_CTA_CTE"."ESTADO_REG" = 'O' )   
		USING		sqlca;
		if sqlca.sqlcode = 0 then
			commit;
			ls_pasa			= 'S'
		else
			rollback;
			messagebox("Error Eliminar","Error ELIMINAR ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
		end if
	end if
	SELECT	Count("ABONO_CTA_CTE"."BASE")  
	INTO 		:ll_count_abono  
	FROM 	"ABONO_CTA_CTE"  
	WHERE  ( "ABONO_CTA_CTE"."TIPO_COB_OCUPA" = :ls_tipo_cob ) AND  
			 ( "ABONO_CTA_CTE"."FOLIO_OCUPA" = :ll_folio ) AND  
			 ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
			 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
			 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
			 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'O' )
	USING		sqlca;
	if ll_count_abono > 0 then
		UPDATE	"ABONO_CTA_CTE"  
		SET 		"ESTADO_REG" = 'P',   
					"TIPO_COB_OCUPA" = Null,   
					"FOLIO_OCUPA" = Null,   
					"FECHA_OCUPA" = Null,   
					"MONTO_OCUPA" = Null,   
					"USUARIO_OCUPA" = Null,   
					"CAJA_OCUPA" = Null,   
					"TIPO_MOV_OCUPA" = Null  
		WHERE  ( "ABONO_CTA_CTE"."TIPO_COB_OCUPA" = :ls_tipo_cob ) AND  
				 ( "ABONO_CTA_CTE"."FOLIO_OCUPA" = :ll_folio ) AND  
				 ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
				 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
				 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
				 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'O' )
		USING		sqlca;
		if sqlca.sqlcode=0 then
			commit;
			ls_pasa			= 'S'
		else
			rollback;
			messagebox("Error Eliminar","Error UPDATE ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
		end if
	end if
	if ls_pasa = 'S' then
		if tab_ingreso.SelectedTab = 1 then // cupon
		elseif tab_ingreso.SelectedTab = 2 then //Comprobante Ingreso
			ll_tot_reg					= tab_ingreso.tp_ci.dw_detalle_ci.rowcount()
			if ll_tot_reg > 0 then		
				for ll_indi= 1 to ll_tot_reg
					ls_tipo_mov_sel	= tab_ingreso.tp_ci.dw_detalle_ci.getitemstring(ll_indi,'tipo_cob')
					ll_cantidad			= tab_ingreso.tp_ci.dw_detalle_ci.getitemnumber(ll_indi,'cantidad')
					if as_tipo_mov <> ls_tipo_mov_sel and ls_tipo_mov_sel = 'F' and ll_count_f > 0 then
						//mantencion
						ll_monto_mant					= round(tab_ingreso.tp_ci.dw_datos_ci.GetItemNumber(1,"c_valor_cuota_mantencion_pesos"),0)
						ll_monto_cta					= ll_monto_mant * ll_cantidad
						SELECT	SUM("ABONO_CTA_CTE"."MONTO")  
						INTO 		:ll_sum_monto_abono  
						FROM 	"ABONO_CTA_CTE"  
						WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
								 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
								 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND
								 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )
						USING		sqlca;
						if ll_sum_monto_abono > 0 then
							ll_monto_mant				= ll_monto_mant - ll_cantidad
							ll_monto_mora_mant		= wf_calcular_mora_mant(ll_indi)
							if ll_sum_monto_abono >= (ll_monto_cta + ll_monto_mora_mant)  then
								ll_monto_final_mant	= round(ll_sum_monto_abono - ( ll_monto_cta + ll_monto_mora_mant ) ,0)
								ll_monto_final_mant ++
								UPDATE	"ABONO_CTA_CTE"  
								SET 		"TIPO_COB_OCUPA" = :gs_tipo_cobro,   
											"FOLIO_OCUPA" = :ll_folio,   
											"FECHA_OCUPA" = :ldt_fecha_hoy,   
											"MONTO_OCUPA" = (:ll_monto_cta + :ll_monto_mora_mant) - 1,   
											"USUARIO_OCUPA" = :gs_user,   
											"CAJA_OCUPA" = :gs_caja,   
											"ESTADO_REG" = 'O',
											"TIPO_MOV_OCUPA" = :ls_tipo_mov_sel
								WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
										 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
										 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
										 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
								USING		sqlca;
								if sqlca.sqlcode=0 then
									commit;
									SELECT sysdate INTO :gdt_fec_sistema FROM "TASA" WHERE "TASA"."LOOK" = 1 ;
									gdt_fec_sistema	= datetime(date(gdt_fec_sistema), RelativeTime(Now(), 10))
									INSERT INTO "ABONO_CTA_CTE"  
												( "RUT",		"BASE",		"SERIE",		"NUMERO",	"TIPO_COB",	"FOLIO",		"MONTO",						"FECHA_CREA",		"USUARIO_CREA",	"CAJA_CREA",	"ESTADO_REG",	"TIPO_COB_OCUPA",	"FOLIO_OCUPA",	"FECHA_OCUPA",	"MONTO_OCUPA",	"USUARIO_OCUPA",	"CAJA_OCUPA",	"TIPO_MOV_OCUPA" )
									VALUES 	( :gi_rut,	:gs_base,	:gs_serie,	:gi_numero,		:gs_tipo_cobro,	:ll_folio,	:ll_monto_final_mant,	:gdt_fec_sistema,	:gs_user,			:gs_caja,		'P',				null,					null,				null,				null,				null,					null,				null )  
									USING		sqlca;
									if sqlca.sqlcode=0 then
										commit;
									else
										rollback;
										messagebox("Error Grabar","Error al INSERTAR ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
									end if
								else
									rollback;
									messagebox("Error Grabar","Error al UPDATE ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
								end if
							else
								UPDATE	"ABONO_CTA_CTE"  
								SET 		"TIPO_COB_OCUPA" = :gs_tipo_cobro,   
											"FOLIO_OCUPA" = :ll_folio,   
											"FECHA_OCUPA" = :ldt_fecha_hoy,   
