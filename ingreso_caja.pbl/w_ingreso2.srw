event open;double	id_uf
date 		id_fecha,ldt_fecha_uf
String		ls_fecha,ls_caja, ls_glosa_caja,ls_string
Datetime	ldt_max_fecha_cierre
Long		ll_dia,ll_mes,ll_year,ll_mes_cierre,ll_count_usu,ll_count_mp

setnull(gs_tipo_cobro)
setnull(gs_filtro)
Setnull(gl_sw_mp)
Setnull(gl_codigo_mp)
Setnull(gdb_porce_pie_mp)
connect using Trans_1;
connect using Trans_2;
connect using Trans_5;
connect using Trans_6;
connect using Trans_7;
is_cod_caja															= gs_caja
st_toku.visible														= false
gs_reingreso_be													= 'N'
gs_reingreso_ci													= 'N'
////////////Modificar
//gdt_fec_sistema													= DATETIME(date('03/10/2017'),time('10:00:00'))
is_opcion																= Message.StringParm
if gs_depto='T' or gs_depto='I' then
	st_21.visible														= true
	em_fec_uf.visible												= true
else
	st_21.visible														= false
	em_fec_uf.visible												= false
end if
if is_opcion='FP' and (gs_depto='T' or gs_depto='I') then
	this.title															= 'Ingreso de Caja <<  FUERA DE PLAZO  >>'
	SELECT	MAX("FACTURA_OFERTA"."FECHA_CIERRE")  
	INTO 		:ldt_max_fecha_cierre  
	FROM 	"FACTURA_OFERTA"  ;
	ll_dia																= day(date(gdt_fec_sistema))
	ll_mes															= month(date(gdt_fec_sistema))
	ll_year															= year(date(gdt_fec_sistema))
	ll_mes_cierre													= month(date(ldt_max_fecha_cierre))
	ll_mes															= ll_mes - 1
	if ll_mes = 0 then
		ll_mes														= 12
		ll_year														= ll_year - 1
	end if
	if ll_mes <> ll_mes_cierre then
		if ll_mes=1 then
			ll_dia														= 31
		elseif ll_mes=2 then
			if int(ll_year/4) = ll_year/4 then
				ll_dia													= 29
			else
				ll_dia													= 28
			end if
		elseif ll_mes=3 then
			ll_dia														= 31
		elseif ll_mes=4 then
			ll_dia														= 30
		elseif ll_mes=5 then
			ll_dia														= 31
		elseif ll_mes=6 then
			ll_dia														= 30
		elseif ll_mes=7 then
			ll_dia														= 31
		elseif ll_mes=8 then
			ll_dia														= 31
		elseif ll_mes=9 then
			ll_dia														= 30
		elseif ll_mes=10 then
			ll_dia														= 31
		elseif ll_mes=11 then
			ll_dia														= 30
		elseif ll_mes=12 then
			ll_dia														= 31
		end if
		ls_fecha														= string(ll_dia,'00')+'/'+string(ll_mes,'00')+'/'+string(ll_year)
		st_fecha.text												= ls_fecha
		em_fec_uf.text												= ls_fecha
		em_fecha_ant.text											= ls_fecha
	else
		messagebox("Advertencia","No es posible Ingresar Pago Fuera de Plazo, Ya Existe Ultimo Proceso Facturación")
		st_fecha.text 												= String(gdt_fec_sistema, "dd/mm/yyyy")
		em_fec_uf.text												= String(gdt_fec_sistema, "dd/mm/yyyy")
		em_fecha_ant.text											= String(gdt_fec_sistema, "dd/mm/yyyy")
	end if
	if gs_depto='I' then
		em_fecha_ant.enabled									= true
		em_fecha_ant.visible										= true
		st_27.visible													= true
	else
		em_fecha_ant.enabled									= false
		em_fecha_ant.visible										= false
		st_27.visible													= false
	end if
else
	st_fecha.text 													= String(gdt_fec_sistema, "dd/mm/yyyy")
	em_fec_uf.text													= String(gdt_fec_sistema, "dd/mm/yyyy")
	em_fecha_ant.text												= String(gdt_fec_sistema, "dd/mm/yyyy")
	String(gdt_fec_sistema, "dd/mm/yyyy")
	this.title															= 'Ingreso de Caja'
	if gs_depto='I' then
		em_fecha_ant.enabled									= true
		em_fecha_ant.visible										= true
		st_27.visible													= true
	else
		em_fecha_ant.enabled									= false
		em_fecha_ant.visible										= false
		st_27.visible													= false
	end if
end if
idt_fecha_hoy														= datetime(date(st_fecha.text),time('00:00:00'))
gd_fecha_pago_plazo												= date(st_fecha.text)
gd_hoy																= idt_fecha_hoy
SELECT	"TASA"."IVA"  INTO :idb_iva  FROM 	"TASA"  WHERE "TASA"."LOOK" = 1   ;
if gs_depto='I' or gs_depto='H' then
	cb_abono.visible												= true
	tab_ingreso.tp_porfacturar.visible							= true
else
	cb_abono.visible												= false
	tab_ingreso.tp_porfacturar.visible							= false
end if
if gs_depto='C' then
	tab_ingreso.tp_cupon.visible								= false	//true
	tab_ingreso.tp_be.visible										= false
	tab_ingreso.tp_ci.visible										= false
	tab_ingreso.tp_boletas.visible								= true
	tab_ingreso.tp_ci.cbx_manual_ci.visible					= false
	tab_ingreso.tp_ci.cbx_manual_ci.checked				= false
	tab_ingreso.tp_ci.cb_asigna_ci.visible						= true
	tab_ingreso.tp_ci.rb_bol_afecta.visible					= false	//true
	tab_ingreso.tp_ci.rb_bol_exenta.visible					= false	//true
	tab_ingreso.tp_boletas.rb_fac_exenta.checked			= true
	tab_ingreso.tp_boletas.rb_fac_afecta.checked			= false
	
elseif gs_depto='J' or gs_depto='T' then
	tab_ingreso.tp_cupon.visible								= false	//true
	tab_ingreso.tp_be.visible										= true
	tab_ingreso.tp_ci.visible										= true
	tab_ingreso.tp_boletas.visible								= false
	tab_ingreso.tp_ci.cbx_manual_ci.visible					= false
	tab_ingreso.tp_ci.cb_asigna_ci.visible						= true
	tab_ingreso.tp_ci.cbx_manual_ci.checked				= false
	tab_ingreso.tp_ci.rb_bol_exenta.visible					= false
	tab_ingreso.tp_ci.rb_bol_afecta.visible					= false	//true
elseif gs_depto='I' then
	tab_ingreso.tp_cupon.visible								= false	//true
	tab_ingreso.tp_be.visible										= true
	tab_ingreso.tp_ci.visible										= true
	tab_ingreso.tp_boletas.visible								= true
	tab_ingreso.tp_ci.cbx_manual_ci.visible					= false
	tab_ingreso.tp_ci.cb_asigna_ci.visible						= true
	tab_ingreso.tp_ci.cbx_manual_ci.checked				= false
	tab_ingreso.tp_ci.rb_bol_exenta.visible					= false
	tab_ingreso.tp_ci.rb_bol_afecta.visible					= false	//true
	tab_ingreso.tp_boletas.rb_fac_exenta.checked			= true
	tab_ingreso.tp_boletas.rb_fac_afecta.checked			= false
elseif gs_depto='H' then
	tab_ingreso.tp_cupon.visible								= false	//true
	tab_ingreso.tp_be.visible										= false
	tab_ingreso.tp_ci.visible										= false
	tab_ingreso.tp_boletas.visible								= false
	tab_ingreso.tp_ci.cbx_manual_ci.visible					= false
	tab_ingreso.tp_ci.cb_asigna_ci.visible						= false
	tab_ingreso.tp_ci.cbx_manual_ci.checked				= false
	tab_ingreso.tp_ci.rb_bol_exenta.visible					= false
	tab_ingreso.tp_ci.rb_bol_afecta.visible					= false	//true
	tab_ingreso.tp_boletas.rb_fac_exenta.checked			= true
	tab_ingreso.tp_boletas.rb_fac_afecta.checked			= false
	tab_ingreso.tp_porfacturar.dw_por_facturar.settransobject(sqlca)
	if tab_ingreso.tp_porfacturar.dw_por_facturar.retrieve(id_fecha) > 0 then
		tab_ingreso.tp_porfacturar.em_folio_factura.text		= ''
		tab_ingreso.tp_porfacturar.em_folio_factura.enabled	= true
	else
		tab_ingreso.tp_porfacturar.em_folio_factura.text		= ''
		tab_ingreso.tp_porfacturar.em_folio_factura.enabled	= false
	end if
	tab_ingreso.tp_porfacturar.dw_por_facturar.accepttext()
	tab_ingreso.tp_porfacturar.dw_por_facturar.setfocus()
end if
//tab_ingreso.tp_ci.cbx_manual_ci.triggerevent(clicked!)
tab_ingreso.tp_ci.cbx_manual_ci.enabled					= false
tab_ingreso.tp_be.cb_asigna_be.enabled					= false
tab_ingreso.tp_boletas.cb_asigna_folio.enabled			= false
