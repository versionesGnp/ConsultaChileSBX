type cb_asigna_ci from picturebutton within tp_ci
integer x = 1687
integer y = 292
integer width = 146
integer height = 112
integer taborder = 40
integer textsize = -11
integer weight = 700
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Tahoma"
boolean enabled = false
string picturename = "filtrar.bmp"
string disabledname = "filtrar_no.bmp"
alignment htextalign = left!
end type

event clicked;Long		ll_min_boleta,ll_grupo,ll_rut,ll_pos,ll_rut_cont,ll_cod_parque,ll_count_pend,ll_cant_folio_p,ll_sw_mp,ll_codigo_mp
String		ls_dv,ls_nombre,ls_ap_pat,ls_ap_mat,ls_base,ls_serie,ls_nom_paso,ls_rut_empresa,ls_pasa='S'
datetime	ldt_fecha_pago
Double	ll_numero,ll_numero_cont
	
gs_tipo_cobro							= 'CI'
ll_numero_cont							= Double(dw_ci_buscar_cliente.getitemstring(1,'rn_contrato'))
ll_rut_cont								= long(dw_ci_buscar_cliente.getitemstring(1,'rl_rut'))
if gs_rezago='S' then
	ll_cod_parque						= dw_parque_boleta.getitemnumber(1,'cod_parque')
	ll_sw_mp							= dw_mp_rezago.getitemnumber(1,'sw_multiproducto')
	ll_codigo_mp						= dw_mp_rezago.getitemnumber(1,'codigo_producto_mp')
	if isnull(ll_cod_parque) or ll_cod_parque=0 then
		ls_pasa							= 'N'
		messagebox("Advertencia","Debe Seleccionar Parque o Producto")
		dw_parque_boleta.setfocus()
	else
		gl_cod_parque					= ll_cod_parque
	end if
end if
if ls_pasa='S' then
	if isnull(ll_numero_cont) then ll_numero_cont=0
	if isnull(ll_rut_cont) then ll_rut_cont=0
	if ll_numero_cont<>0 or ll_rut_cont<>0 then
		if cbx_manual_ci.checked=false then
			if sle_numero_ci.text = '' then
				sle_numero_ci.text			= ''
				dw_detalle_ci.reset()
				dw_gastos_ci.reset()
				sle_numero_ci.enabled		= true
				cb_ci_insertar.enabled		= false
				cb_ci_borrar_item.enabled	= false
				pb_ficha.enabled				= false
				if rb_bol_afecta.checked=true then
					gs_tipo_cobro				= "CI"
					dw_detalle_ci.dataobject	= 'de_detalle_ci_2'
					dw_detalle_ci.getchild('tipo_cob',idw_detalle2)
					idw_detalle2.settransobject(sqlca)
					if gs_base='F' or gs_base='G' or gs_base='V' then
						if gs_base='F' then
							idw_detalle2.retrieve('FA')
							idw_detalle12.retrieve('FA')
							idw_detalle.retrieve('FA')
							idw_detalle15.retrieve('CI')
						elseif gs_base='G' or gs_base='V' then
							idw_detalle2.retrieve('BA')
							idw_detalle12.retrieve('BA')
							idw_detalle.retrieve('BA')
							idw_detalle15.retrieve('CI')
						end if
						idw_detalle15.retrieve('CI')
					else
						idw_detalle2.retrieve(gs_tipo_cobro)
						idw_detalle12.retrieve(gs_tipo_cobro)
						idw_detalle.retrieve(gs_tipo_cobro)
						idw_detalle15.retrieve(gs_tipo_cobro)
					end if
				elseif rb_bol_exenta.checked=true then
					gs_tipo_cobro				= "CI"
					dw_detalle_ci.dataobject	= 'de_detalle_ci_2'
					dw_detalle_ci.getchild('tipo_cob',idw_detalle)
					idw_detalle.settransobject(sqlca)
					if gs_base='F' then
						idw_detalle.retrieve('FA')
						idw_detalle2.retrieve('FA')
						idw_detalle12.retrieve('FA')
						idw_detalle15.retrieve('CI')
					elseif gs_base='G' then
						idw_detalle.retrieve('BA')
						idw_detalle12.retrieve('BA')
						idw_detalle2.retrieve('BA')
						idw_detalle15.retrieve('CI')
					else
						idw_detalle.retrieve(gs_tipo_cobro)
						idw_detalle12.retrieve(gs_tipo_cobro)
						idw_detalle2.retrieve(gs_tipo_cobro)
						idw_detalle15.retrieve(gs_tipo_cobro)
					end if
				end if
				dw_detalle_ci.settransobject(sqlca)
				
				SELECT	"MEMBRETE_EMPRESA"."STRING_RUT"
				INTO 		:ls_rut_empresa
				FROM 	"MEMBRETE_EMPRESA"  
				WHERE 	"MEMBRETE_EMPRESA"."COD_PARQUE" = :gl_cod_parque   ;

				SELECT	"ELECTRONICA_FB"."GRUPO"  
				INTO 		:ll_grupo  
				FROM 	"ELECTRONICA_FB"  
				WHERE ( "ELECTRONICA_FB"."TIPO_DOCUMENTO" = :gs_tipo_cobro ) AND  
						  ( "ELECTRONICA_FB"."RUT_EMPRESA" = :ls_rut_empresa ) AND 
						  ( "ELECTRONICA_FB"."ESTADO" = 'P' )   ;
				if not isnull(ls_rut_empresa) and ll_grupo > 0 then
					ll_cant_folio_p			= gl_folio_diario * gl_veces_diario
					SELECT	Count("ELECTRONICA_FB_DETALLE"."NRO_DOCUMENTO") 
					INTO		:ll_count_pend
					FROM 	"ELECTRONICA_FB",   
								"ELECTRONICA_FB_DETALLE"  
					WHERE ( "ELECTRONICA_FB"."TIPO_DOCUMENTO" = "ELECTRONICA_FB_DETALLE"."TIPO_DOCUMENTO" ) and  
							  ( "ELECTRONICA_FB"."GRUPO" = "ELECTRONICA_FB_DETALLE"."GRUPO" ) and  
							  ( "ELECTRONICA_FB"."ESTADO" = 'P' ) AND  
							  ( "ELECTRONICA_FB"."TIPO_DOCUMENTO" = :gs_tipo_cobro ) AND 
							  ( "ELECTRONICA_FB_DETALLE"."COD_CAJA" = :gs_caja )   AND
							  ( "ELECTRONICA_FB"."RUT_EMPRESA" = :ls_rut_empresa ) AND 
							  ( "ELECTRONICA_FB_DETALLE"."ESTADO_REG" = 'P' );
					if ll_count_pend < ll_cant_folio_p then
						Messagebox("Advertencia","Recuerde quedan "+String(ll_count_pend)+" Documentos "+gs_tipo_cobro+" PENDIENTES, favor dar aviso Depatamento Informática")
					end if
					ldt_fecha_pago				= datetime(date(st_fecha.text),time('00:00:00'))
					if gs_rezago <> 'S' then
						ll_rut						= long(dw_ci_buscar_cliente.getitemstring(1,'rl_rut'))
						ls_dv						= dw_ci_buscar_cliente.getitemstring(1,'cf_obtener_dv')
						ls_nombre				= dw_ci_buscar_cliente.getitemstring(1,'rs_nombre')
						ls_ap_pat				= dw_ci_buscar_cliente.getitemstring(1,'rs_a_paterno')
						ls_ap_mat				= dw_ci_buscar_cliente.getitemstring(1,'rs_a_materno')
						ls_base					= gs_base
						ls_serie					= gs_serie
						ll_numero				= gi_numero
					else
						ll_rut						= gi_rut
						ls_dv						= gf_obtener_dv(ll_rut)
						ls_nom_paso			= gs_nombre_completo
						ll_pos						= Pos(ls_nom_paso, " ")
						ls_nombre				= trim(mid(ls_nom_paso,1,ll_pos))
						ls_nom_paso			= trim(mid(ls_nom_paso,ll_pos))
						ll_pos						= Pos(ls_nom_paso, " ")
						ls_ap_pat				= trim(mid(ls_nom_paso,1,ll_pos))
						ls_nom_paso			= trim(mid(ls_nom_paso,ll_pos))
						ll_pos						= Pos(ls_nom_paso, " ")
						ls_ap_mat				= trim(mid(ls_nom_paso,1,ll_pos))
						ls_base					= mid(gs_contrato_rezago,1,1)
						ls_serie					= mid(gs_contrato_rezago,2,1)
						ll_numero				= Double(mid(gs_contrato_rezago,3))
					end if
					ls_nombre	= ls_nombre +' '+ls_ap_pat+' '+ls_ap_mat
					if len(ls_nombre) > 40 then
						ls_nombre	= mid(ls_nombre,1,40)
					end if
					SQLCA.Lock = "3" 
					
					UPDATE		"ELECTRONICA_FB_DETALLE"  
					SET 			"FECHA_PAGO" = :ldt_fecha_pago,   
									"RUT" = :gi_rut,   
									"ESTADO_REG" = 'P',   
									"DV" = :gs_dv,   
									"NOMBRE_CLIENTE" = :ls_nombre,   
									"USUARIO_CREA" = :gs_user,
									"BASE"  = :ls_base,
									"SERIE" = :ls_serie,
									"NUMERO" = :ll_numero,
									"IP_EQUIPO" = :gs_tcp_ip
					WHERE 	  ( "ELECTRONICA_FB_DETALLE"."GRUPO" = :ll_grupo ) AND  
								  ( "ELECTRONICA_FB_DETALLE"."TIPO_DOCUMENTO" = :gs_tipo_cobro ) AND  
								  ( "ELECTRONICA_FB_DETALLE"."ESTADO_REG" = 'P' )   AND
								  ( "ELECTRONICA_FB_DETALLE"."COD_CAJA" = :gs_caja )   AND
								  ( "ELECTRONICA_FB_DETALLE"."NRO_DOCUMENTO" = (SELECT	MIN("ELECTRONICA_FB_DETALLE"."NRO_DOCUMENTO") 
																										FROM 	"ELECTRONICA_FB",   
																													"ELECTRONICA_FB_DETALLE"  
																										WHERE ( "ELECTRONICA_FB"."TIPO_DOCUMENTO" = "ELECTRONICA_FB_DETALLE"."TIPO_DOCUMENTO" ) and  
																												  ( "ELECTRONICA_FB"."GRUPO" = "ELECTRONICA_FB_DETALLE"."GRUPO" ) and  
																												  ( "ELECTRONICA_FB"."ESTADO" = 'P' ) AND  
																												  ( "ELECTRONICA_FB"."TIPO_DOCUMENTO" = :gs_tipo_cobro ) AND 
																												  ( "ELECTRONICA_FB_DETALLE"."COD_CAJA" = :gs_caja )   AND
																												  ( "ELECTRONICA_FB"."RUT_EMPRESA" = :ls_rut_empresa ) AND 
																												  ( "ELECTRONICA_FB_DETALLE"."ESTADO_REG" = 'P' )) )
					USING		sqlca;
					//								  ( "ELECTRONICA_FB_DETALLE"."NRO_DOCUMENTO" = :gl_folio ) AND  
					if sqlca.sqlcode=0 then
						commit;					
						if gs_rezago <> 'S' then
							SELECT	"ELECTRONICA_FB_DETALLE"."NRO_DOCUMENTO"
							INTO 		:ll_min_boleta
							FROM 	"ELECTRONICA_FB",   
										"ELECTRONICA_FB_DETALLE"  
							WHERE ( "ELECTRONICA_FB"."TIPO_DOCUMENTO" = "ELECTRONICA_FB_DETALLE"."TIPO_DOCUMENTO" ) and  
									  ( "ELECTRONICA_FB"."GRUPO" = "ELECTRONICA_FB_DETALLE"."GRUPO" ) and  
									  (("ELECTRONICA_FB"."ESTADO" = 'P' ) AND  
									  ( "ELECTRONICA_FB"."TIPO_DOCUMENTO" = :gs_tipo_cobro ) AND 
									  ( "ELECTRONICA_FB"."RUT_EMPRESA" = :ls_rut_empresa ) AND 
									  ( "ELECTRONICA_FB_DETALLE"."FECHA_PAGO" = :ldt_fecha_pago ) AND   
									  ( "ELECTRONICA_FB_DETALLE"."RUT" = :gi_rut) AND
									  ( "ELECTRONICA_FB_DETALLE"."DV" = :gs_dv) AND
									  ( "ELECTRONICA_FB_DETALLE"."NOMBRE_CLIENTE" = :ls_nombre) AND
									  ( "ELECTRONICA_FB_DETALLE"."USUARIO_CREA" = :gs_user) AND
									  ( "ELECTRONICA_FB_DETALLE"."BASE"  = :ls_base) AND
									  ( "ELECTRONICA_FB_DETALLE"."SERIE" = :ls_serie) AND
									  ( "ELECTRONICA_FB_DETALLE"."NUMERO" = :ll_numero) AND
									  ( "ELECTRONICA_FB_DETALLE"."IP_EQUIPO" = :gs_tcp_ip) AND
									  ( "ELECTRONICA_FB_DETALLE"."COD_CAJA" = :gs_caja )   AND
									  ( "ELECTRONICA_FB_DETALLE"."ESTADO_REG" = 'P' ) );
						else
							SELECT	"ELECTRONICA_FB_DETALLE"."NRO_DOCUMENTO"
							INTO 		:ll_min_boleta
							FROM 	"ELECTRONICA_FB",   
										"ELECTRONICA_FB_DETALLE"  
							WHERE ( "ELECTRONICA_FB"."TIPO_DOCUMENTO" = "ELECTRONICA_FB_DETALLE"."TIPO_DOCUMENTO" ) and  
									  ( "ELECTRONICA_FB"."GRUPO" = "ELECTRONICA_FB_DETALLE"."GRUPO" ) and  
									  (("ELECTRONICA_FB"."ESTADO" = 'P' ) AND  
									  ( "ELECTRONICA_FB"."TIPO_DOCUMENTO" = :gs_tipo_cobro ) AND 
									  ( "ELECTRONICA_FB"."RUT_EMPRESA" = :ls_rut_empresa ) AND 
									  ( "ELECTRONICA_FB_DETALLE"."FECHA_PAGO" = :ldt_fecha_pago ) AND   
									  ( "ELECTRONICA_FB_DETALLE"."RUT" = :gi_rut) AND
									  ( "ELECTRONICA_FB_DETALLE"."IP_EQUIPO" = :gs_tcp_ip) AND
									  ( "ELECTRONICA_FB_DETALLE"."COD_CAJA" = :gs_caja )   AND
									  ( "ELECTRONICA_FB_DETALLE"."ESTADO_REG" = 'P' ) );
						end if
						gl_folio						= ll_min_boleta
						sle_numero_ci.text		= string(ll_min_boleta)
						sle_numero_ci.enabled	= false
						sle_numero_ci.setfocus()
						sle_numero_ci.triggerevent(modified!)
					else
						rollback;
						messagebox("Error Grabar CI","Error al Grabar CI - Folio NO Disponible para "+gs_tipo_cobro+" SQL: "+sqlca.sqlerrtext)
					end if
				else
					messagebox("Advertencia","No Existe Folio para esta Empresa "+ls_rut_empresa)
				end if
				
			end if
		else
			idw_detalle.retrieve('CI')		//CI
			idw_detalle15.retrieve('CI')
			idw_detalle12.retrieve('CI')
			idw_detalle2.retrieve('CI')
		end if
	end if
end if
end event

type cbx_manual_ci from checkbox within tp_ci
event ue_mousemove pbm_mousemove
boolean visible = false
integer x = 1294
integer y = 304
integer width = 379
integer height = 92
integer textsize = -11
integer weight = 700
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Tahoma"
long backcolor = 79741120
string text = "Manual"
end type

event ue_mousemove;if is_opcion='FP' and (gs_depto='T' or gs_depto='I') then st_fuera_plazo.visible = true
end event

event clicked;Long		ll_min_boleta,ll_rut,ll_grupo,ll_pos,ll_folio
datetime	ldt_fecha_pago
String		ls_dv,ls_nombre,ls_ap_pat,ls_ap_mat,ls_nom_paso,ls_base,ls_serie
Double	ll_numero

ll_folio								= long(sle_numero_ci.text)
if cbx_manual_ci.checked=true then
	if ll_folio > 0 then
		wf_limpiar_boleta_electronica(ll_folio)
	end if
	sle_numero_ci.text			= ''
	dw_detalle_ci.reset()
	dw_gastos_ci.reset()
	sle_numero_ci.enabled		= true
	cb_ci_insertar.enabled		= false
	cb_ci_borrar_item.enabled	= false
	pb_ficha.enabled				= false
	gs_tipo_cobro					= "BE"
	cb_asigna_ci.enabled			= false
//	rb_ci_exento.checked			= true
//	rb_ci_afecto.checked			= false
//	rb_ci_exento.enabled			= false
//	rb_ci_afecto.enabled			= false
	sle_numero_ci.setfocus()
else
	sle_numero_ci.text			= ''
	dw_detalle_ci.reset()
	dw_gastos_ci.reset()
	cb_asigna_ci.enabled			= true
//	rb_ci_exento.checked			= true
//	rb_ci_afecto.checked			= false
//	rb_ci_exento.enabled			= true
//	rb_ci_afecto.enabled			= true
	cb_asigna_ci.setfocus()
end if
end event

