type cbx_paga_ef_be from checkbox within tp_be
integer x = 1911
integer y = 64
integer width = 631
integer height = 92
integer textsize = -9
integer weight = 700
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
