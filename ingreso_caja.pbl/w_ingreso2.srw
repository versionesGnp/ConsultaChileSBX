type dw_bl_buscar_cliente from datawindow within tp_boletas
event ue_mousemove pbm_mousemove
integer x = 14
integer y = 72
integer width = 2533
integer height = 196
integer taborder = 40
string title = "none"
string dataobject = "de_buscar_cliente"
boolean border = false
boolean livescroll = true
end type

event ue_mousemove;String		ls_numero,ls_ap_pat

st_19.visible					= false
st_help_insertar2.visible	= false
st_help_eliminar2.visible	= false
if is_opcion='FP' and (gs_depto='T' or gs_depto='I') then st_fuera_plazo.visible = true

il_rut 			= long(dw_bl_buscar_cliente.GetItemString(1,"rl_rut"))
is_dv			= dw_bl_buscar_cliente.GetItemString(1,"dv")
ls_numero	= dw_bl_buscar_cliente.getitemstring(1,'rn_contrato')
ls_ap_pat	= dw_bl_buscar_cliente.getitemstring(1,'rs_a_paterno') 
if isnull(ls_numero) and isnull(ls_ap_pat) and (is_dv='' or isnull(is_dv)) and il_rut > 0 then
	dw_bl_buscar_cliente.setfocus()
	dw_bl_buscar_cliente.setcolumn('dv')
elseif ls_numero='' and ls_ap_pat='' and is_dv='' and il_rut > 0 then
	dw_bl_buscar_cliente.setfocus()
	dw_bl_buscar_cliente.setcolumn('dv')
end if

end event

event itemchanged;string 	is_base, is_serie,ls_fono_p,ls_fono_part,ls_celular,ls_fono_c,ls_fono_pc,ls_fono_cc,ls_string,ls_dv_auto,ls_apellido_paterno,ls_dv
long 		il_nenc, il_ndat, ll_new,li_opcion,ll_rut_aux,ll_ctas,ll_ctas_pagadas,	ll_ctas_pagadas_1,ll_ctas_pagadas_2,ll_estado_carta,ll_count,&
			ll_count_mant,ll_new_reg
Date		ld_fecha_hoy
Double	il_numero,ll_numero

this.accepttext()
if gs_depto = 'I' or gs_depto = 'C' then
	if cbx_manual_factura.checked=true then
		gs_tipo_cobro				= "BL"
	elseif gs_depto='C' then
		gs_tipo_cobro				= "FE"
	else
		gs_tipo_cobro				= "FA"
	end if
	Setnull(gs_base)
	Setnull(gs_serie)
	Setnull(gi_numero)
	Setnull(gi_rut)
	Setnull(gs_grabar_pie)
	st_aviso_ap.visible					= false
	gs_filtro 								= "facturas_cadena_codigo = 'B'"
	dw_bl_buscar_cliente.AcceptText()
	il_rut 									= long(dw_bl_buscar_cliente.GetItemString(1,"rl_rut"))
	is_dv									= dw_bl_buscar_cliente.GetItemString(1,"dv")
	ls_dv_auto							= dw_bl_buscar_cliente.getitemstring(1,'cf_obtener_dv')
	ls_apellido_paterno 				= dw_bl_buscar_cliente.GetItemString(1,"rs_a_paterno")
	ll_numero 							= Double(dw_bl_buscar_cliente.GetItemString(1,"rn_contrato"))
	if (not isnull(is_dv) and not isnull(ls_dv_auto) and is_dv<>'' and ls_dv_auto<>'' and il_rut > 0) or not isnull(ls_apellido_paterno) or ll_numero > 0  then
		il_rut 								= long(dw_bl_buscar_cliente.GetItemString(1,"rl_rut"))
		IF il_rut = 0 or isnull(il_rut) THEN
			IF dw_bl_buscar_cliente.GetItemString(1,"rn_contrato") = "" or isnull(dw_bl_buscar_cliente.GetItemString(1,"rn_contrato")) THEN
				gi_tipo_busqueda 		= 2
				gs_apellido_paterno 	= dw_bl_buscar_cliente.GetItemString(1,"rs_a_paterno")
			ELSE 
				gi_numero 				= Double(dw_bl_buscar_cliente.GetItemString(1,"rn_contrato"))
				gi_tipo_busqueda 		= 0
			END IF
		ELSE 
			gi_rut 						= long(dw_bl_buscar_cliente.GetItemString(1,"rl_rut"))
			gi_tipo_busqueda 			= 1
		END IF
		if cbx_factura_exenta.checked=true then
			open(w_buscar_cliente_factura_exenta)
		else
			open(w_buscar_cliente_factura_exenta)	//Open(w_buscar_cliente)
		end if
		IF gf_permitir_ingreso(gs_base, gs_serie, gi_numero) THEN
			Open(w_advertencia)
			gs_rezago 					= " "
			dw_bl_buscar_cliente.AcceptText()
			cb_bl_borrar.SetFocus()
			cb_bl_borrar.TriggerEvent(Clicked!)
			RETURN 0
		END IF
		IF NOT ISNULL(gs_base) and gs_base <> ""	AND not isnull(gs_serie) AND gs_serie <> "" AND not isnull(gi_numero) AND gi_numero > 0 THEN
			il_nenc 						= dw_encabezado_ingreso_cupon.Retrieve(gs_base, gs_serie, gi_numero)
			IF il_nenc > 0 THEN 
				gi_rut 					= dw_encabezado_ingreso_cupon.GetItemNumber(1, "cliente_rut")
			ELSE
				gi_rut 					= 0
			END IF
			if gi_rut>0 then 
				if isvalid(w_aviso_mensajes) then close(w_aviso_mensajes)
				SELECT	COUNT("MENSAJES"."FECHA_CREACION")  
				INTO 		:ll_count  
				FROM 	"MENSAJES"  
				WHERE  ( "MENSAJES"."RUT" = :gi_rut ) and
						 ( "MENSAJES"."ESTADO_GESTION" = 'A' ) AND
						 ( "MENSAJES"."SW_MENSAJE" = 'R' ) and
						 ( "MENSAJES"."FECHA_FIN" > :gdt_fec_sistema )
				USING		sqlca;
				if ll_count>0 then
					OpenWithParm(w_aviso_mensajes, "R")
				else
					SELECT	COUNT("MENSAJES"."FECHA_CREACION")  
					INTO 		:ll_count  
					FROM 	"MENSAJES"  
					WHERE  ( "MENSAJES"."BASE" = :gs_base ) and
							 ( "MENSAJES"."SERIE" = :gs_serie ) and
							 ( "MENSAJES"."NUMERO" = :gi_numero ) and
							 ( "MENSAJES"."ESTADO_GESTION" = 'A' ) AND
							 ( "MENSAJES"."SW_MENSAJE" = 'C' ) and
							 ( "MENSAJES"."FECHA_FIN" > :gdt_fec_sistema )
					USING		sqlca;
					if ll_count>0 then
						OpenWithParm(w_aviso_mensajes, "C")
					end if
				end if
			end if
			If gi_rut = 0 THEN
				gs_rezago 				= " "
				dw_bl_buscar_cliente.AcceptText()
				cb_bl_borrar.SetFocus()
				cb_bl_borrar.TriggerEvent(Clicked!)
				RETURN 0
			END IF
			CHOOSE CASE gs_base
				CASE "O","U","M"
					dw_datos_bl.DataObject 	= 'd_datos_cuenta_ci_oferta'
				CASE "L"
					dw_datos_bl.DataObject 	= 'd_datos_cuenta_ci_liberador'
				CASE "P"
					dw_datos_bl.DataObject 	= 'd_datos_cuenta_ci_pagare'
				CASE "D"
					dw_datos_bl.DataObject 	= 'd_datos_cuenta_ci_derecho'
				CASE "C"
					dw_datos_bl.DataObject 	= 'd_datos_cuenta_bl_cto_isa'
				CASE "A"
					dw_datos_bl.DataObject 	= 'd_datos_cuenta_ci_aumento_capacidad'
				CASE "R"
					dw_datos_bl.DataObject 	= 'dw_repacta_mant_descripcion_traspaso'
				CASE "F","G"
					dw_datos_bl.DataObject 	= 'd_datos_cuenta_ci_funeraria'
				CASE "B"
					dw_datos_bl.DataObject 	= 'd_datos_cuenta_cliente_factura'
			END CHOOSE
			dw_datos_bl.SetTransObject(SQLCA)
			il_ndat 								= dw_datos_bl.Retrieve(gs_serie,gi_numero,gs_base)
			if il_ndat>0 then
				if gs_base <> 'B' then
					ll_estado_carta				= dw_datos_bl.getitemnumber(1,'cadena_estado_carta')
					if ll_estado_carta=1 or ll_estado_carta=2 or ll_estado_carta=4 or ll_estado_carta=6 or ll_estado_carta=8 then
						st_aviso_ap.visible		= true
					end if
					IF il_nenc > 0 THEN 
						ls_fono_p				= dw_encabezado_ingreso_cupon.GetitemString(1, "cliente_fono_p")
						if len(ls_fono_p) <= 5 then
							st_aviso_ap.visible	= true
						end if
					end if
				end if
				sle_numero_bl.text			= ''
				dw_detalle_bl.reset()
				dw_gastos_bl.reset()
			end if
			if gs_base = 'B' then
				gl_cod_parque					= dw_datos_bl.getitemnumber(1,'facturas_cadena_cod_parque')
			else
				gl_cod_parque					= dw_datos_bl.getitemnumber(1,'cadena_cod_parque')
			end if
			if gs_base='O' or gs_base='U' or gs_base='M' then
				ll_ctas							= dw_datos_bl.getitemnumber(1,'pago_oferta_nro_cuotas')
				ll_ctas_pagadas				= dw_datos_bl.getitemnumber(1,'oferta_v_cta_pag_s')
			elseif gs_base='L' then
				ll_ctas							= dw_datos_bl.getitemnumber(1,'pago_liberador_nro_cuotas')
				ll_ctas_pagadas				= dw_datos_bl.getitemnumber(1,'anexo_liberador_cta_pag_m')
			elseif gs_base='F' or gs_base='G'  or gs_base='V' then
				ll_ctas							= dw_datos_bl.getitemnumber(1,'producto_pago_plazo')
				ll_ctas_pagadas				= dw_datos_bl.getitemnumber(1,'producto_anexo_cuotas_pag')
			elseif gs_base='P' then
				ll_ctas							= dw_datos_bl.getitemnumber(1,'pagare_plazo')
				ll_ctas_pagadas_1				= dw_datos_bl.getitemnumber(1,'pagare_cta_pag_la')
				ll_ctas_pagadas_2				= dw_datos_bl.getitemnumber(1,'pagare_cta_pag_isa')
				ll_ctas_pagadas				= ll_ctas_pagadas_1 + ll_ctas_pagadas_2
			elseif gs_base='D' then
				ll_ctas							= dw_datos_bl.getitemnumber(1,'derecho_plazo')
				ll_ctas_pagadas_1				= dw_datos_bl.getitemnumber(1,'derecho_cta_pag_la')
				ll_ctas_pagadas_2				= dw_datos_bl.getitemnumber(1,'derecho_cta_pag_isa')
				ll_ctas_pagadas				= ll_ctas_pagadas_1 + ll_ctas_pagadas_2
			elseif gs_base='A' then
				ll_ctas							= dw_datos_bl.getitemnumber(1,'pago_aumento_nro_cuotas')
				ll_ctas_pagadas				= dw_datos_bl.getitemnumber(1,'anexo_aumento_cta_pag_m')
			end if
		//	if ll_ctas_pagadas>=ll_ctas and dw_datos_bl.rowcount()>0 and ll_ctas>0 then
		//		messagebox("Advertencia","No es Posible Ingresar C.I., Contrato Nº "+gs_base+'-'+gs_serie+'-'+string(gi_numero,"###,###,###,###,###")+" está CANCELADO")	
		//		cb_ci_insertar.Enabled 			= FALSE
		//		cb_bl_borrar_item.Enabled 		= FALSE
		//		cb_ingresar_pago_ci.Enabled 	= FALSE
		//		sle_numero_bl.Enabled 			= FALSE
		//		dw_datos_bl.setfocus()
		//	else
				IF il_nenc > 0 THEN
					dw_bl_buscar_cliente.SetItem(1,"rs_a_paterno", dw_encabezado_ingreso_cupon.GetItemString(1, "cliente_a_paterno"))
					dw_bl_buscar_cliente.SetItem(1,"rs_a_materno", dw_encabezado_ingreso_cupon.GetItemString(1, "cliente_a_materno"))
					dw_bl_buscar_cliente.SetItem(1,"rs_nombre", dw_encabezado_ingreso_cupon.GetItemString(1, "cliente_nombre"))
					dw_bl_buscar_cliente.SetItem(1,"rn_contrato",String(gi_numero)) 
					dw_bl_buscar_cliente.SetItem(1,"rl_rut",String(dw_encabezado_ingreso_cupon.GetItemNumber(1, "cliente_rut")))
					dw_bl_buscar_cliente.SetItem(1,"rs_bs",(gs_base+gs_serie))
					dw_bl_buscar_cliente.SetItem(1,"dv",gf_obtener_dv( Long(dw_encabezado_ingreso_cupon.GetItemNumber(1, "cliente_rut")) ))
					gs_nombre_completo 				= dw_encabezado_ingreso_cupon.GetItemString(1, "cliente_nombre")+ " " +dw_encabezado_ingreso_cupon.GetItemString(1, "cliente_a_paterno") + " " + dw_encabezado_ingreso_cupon.GetItemString(1, "cliente_a_materno")
					gs_rezago 								= " "
					sle_numero_bl.Enabled 				= True
					cbx_manual_factura.enabled		= true
					cb_asigna_folio.enabled				= true
					////// ver
					dw_bl_buscar_cliente.enabled		= false
					sle_numero_bl.SetFocus()
				ELSE
					MessageBox("Ingreso de BL", "No se encontró información asociada a ese número de documento.")
					cb_bl_borrar.TriggerEvent(Clicked!)
				END IF	
				ld_fecha_hoy							= date(gdt_fec_sistema)
				ls_string									= string(gi_rut)+'~t'+gs_base+'~t'+gs_serie+'~t'+string(gi_numero)+'~t'+string(ld_fecha_hoy,'dd/mm/yyyy')
	//			openwithparm(w_modificar_telefonos_cliente,ls_string)
		//	end if
		ELSE
			IF Long(dw_bl_buscar_cliente.GetItemString(1,"rl_rut")) > 0 THEN 
				//No se encuentra el cliente, preguntar si desea ingresar rezago
				li_opcion 													= MessageBox("Ingreso de BL", "No se encontró el Cliente, Contrato no ha sido ingresado o Estado No corresponde, desea ingresar Boleta en Rezago ?", Exclamation!, YesNo!, 2)
				IF li_opcion = 1 THEN
					dw_parque_factura.visible							= true
					tab_ingreso.tp_boletas.gb_2.visible				= true
					tab_ingreso.tp_boletas.rb_ci_uf_bl.visible		= true
					tab_ingreso.tp_boletas.rb_ci_peso_bl.visible	= true
					tab_ingreso.tp_boletas.rb_ci_uf_bl.checked		= true
					gs_rezago 												= "S"
//					gs_base 													= "O"
					gs_serie 													= "I"
					dw_datos_bl.reset()
					dw_detalle_bl.reset()
					dw_gastos_bl.reset()
					sle_numero_bl.text									= ''
					gi_numero 												= 0
					gi_rut 													= long(dw_bl_buscar_cliente.GetItemString(1,"rl_rut"))
					ls_dv 														= dw_bl_buscar_cliente.GetItemString(1,"dv")
					dw_bl_buscar_cliente.reset()
					ll_new													= dw_bl_buscar_cliente.insertrow(0)
					dw_bl_buscar_cliente.scrolltorow(ll_new)
					dw_bl_buscar_cliente.setitem(ll_new,'rl_rut',string(gi_rut))
					dw_bl_buscar_cliente.setitem(ll_new,'dv',ls_dv)
					dw_bl_buscar_cliente.accepttext()
					dw_bl_buscar_cliente.enabled						= false
					sle_numero_bl.Enabled 								= True
					cbx_manual_factura.enabled						= true
					cb_asigna_folio.enabled								= true
					dw_parque_factura.reset()
					dw_parque_factura.insertrow(0)
					dw_parque_factura.setitem(1,'cod_parque',106)
					dw_parque_factura.accepttext()
					dw_parque_factura.SetFocus()
				ELSE
					dw_parque_factura.reset()
					dw_parque_factura.visible							= false
					tab_ingreso.tp_boletas.gb_2.visible				= false
					tab_ingreso.tp_boletas.rb_ci_uf_bl.visible		= false
					tab_ingreso.tp_boletas.rb_ci_peso_bl.visible	= false
					gs_rezago 												= " "
					dw_bl_buscar_cliente.AcceptText()
					cb_bl_borrar.SetFocus()
					cb_bl_borrar.TriggerEvent(Clicked!)
				END IF
			ELSE
				//MessageBox("Ingreso de CI", "No se encontró información asociada a ese número de documento.")
				cb_bl_borrar.TriggerEvent(Clicked!)
			END IF
		END IF
	else
		dw_bl_buscar_cliente.setfocus()
		dw_bl_buscar_cliente.setcolumn('dv')
	end if
else
	messagebox("Advertencia","Solo es Posible Ingresar Factura a Producto FUNERARIO")
	cb_bl_borrar.TriggerEvent(Clicked!)
end if
end event

event itemfocuschanged;String		ls_dv_auto,ls_columna,ls_numero,ls_ap_pat,ls_nulo

dw_bl_buscar_cliente.accepttext()
Setnull(ls_nulo)
ls_columna		= dwo.name
il_rut 				= long(dw_bl_buscar_cliente.GetItemString(1,"rl_rut"))
is_dv				= dw_bl_buscar_cliente.GetItemString(1,"dv")
ls_dv_auto		= dw_bl_buscar_cliente.getitemstring(1,'cf_obtener_dv')
if not isnull(is_dv) and not isnull(ls_dv_auto) and is_dv<>'' and ls_dv_auto<>'' and il_rut > 0 then
	if is_dv <> ls_dv_auto then
		dw_bl_buscar_cliente.setitem(1,"dv",ls_nulo)
		dw_bl_buscar_cliente.accepttext()
		dw_bl_buscar_cliente.setfocus()
		dw_bl_buscar_cliente.setcolumn('dv')
	end if
end if
if ls_columna='rn_contrato' or ls_columna='rs_a_paterno' then
	ls_numero	= dw_bl_buscar_cliente.getitemstring(1,'rn_contrato')
	ls_ap_pat	= dw_bl_buscar_cliente.getitemstring(1,'rs_a_paterno') 
	if isnull(ls_numero) and isnull(ls_ap_pat) and (is_dv='' or isnull(is_dv)) and il_rut > 0 then
		dw_bl_buscar_cliente.setfocus()
		dw_bl_buscar_cliente.setcolumn('dv')
	elseif ls_numero='' and ls_ap_pat='' and is_dv='' and il_rut > 0 then
		dw_bl_buscar_cliente.setfocus()
		dw_bl_buscar_cliente.setcolumn('dv')
	end if
end if
end event

