									WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
											 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
											 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
											 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
									USING		sqlca;
									if sqlca.sqlcode=0 then
										commit;
									else
										rollback;
										messagebox("Error Grabar","Error al Update ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
									end if
								end if
							else
								ll_monto_final_cred				= ll_monto_cred
							end if
						end if
					end if
				next
			end if
		end if
	end if
end if
end subroutine

public subroutine wf_limpiar_boleta_electronica (long al_folio);Long		ll_grupo,ll_nulo
datetime	ldt_fecha_pago,ldt_nulo
String		ls_nulo,ls_rut_empresa

Setnull(ll_nulo);Setnull(ldt_nulo);Setnull(ls_nulo)

SELECT	"MEMBRETE_EMPRESA"."STRING_RUT"
INTO 		:ls_rut_empresa
FROM 	"MEMBRETE_EMPRESA"  
WHERE 	"MEMBRETE_EMPRESA"."COD_PARQUE" = :gl_cod_parque   ;

SELECT	"ELECTRONICA_FB"."GRUPO"  
INTO 		:ll_grupo  
FROM 	"ELECTRONICA_FB"  
WHERE ( "ELECTRONICA_FB"."TIPO_DOCUMENTO" = :gs_tipo_cobro ) AND  
		  ( "ELECTRONICA_FB"."RUT_EMPRESA" = :ls_rut_empresa ) AND 
		  ( "ELECTRONICA_FB"."ESTADO" = 'P' )   ;
if ll_grupo > 0 then
	ldt_fecha_pago				= datetime(date(st_fecha.text),time('00:00:00'))
	UPDATE		"ELECTRONICA_FB_DETALLE"  
	SET 			"FECHA_PAGO" = :ldt_nulo,   
					"RUT" = :ll_nulo,   
					"ESTADO_REG" = 'P',   
					"DV" = :ls_nulo,   
					"NOMBRE_CLIENTE" = :ls_nulo,   
					"USUARIO_CREA" = :ls_nulo,
					"BASE"  = :ls_nulo,
					"SERIE" = :ls_nulo,
					"NUMERO" = :ll_nulo
	WHERE 	  ( "ELECTRONICA_FB_DETALLE"."GRUPO" = :ll_grupo ) AND  
				  ( "ELECTRONICA_FB_DETALLE"."TIPO_DOCUMENTO" = :gs_tipo_cobro ) AND  
				  ( "ELECTRONICA_FB_DETALLE"."NRO_DOCUMENTO" = :al_folio ) AND  
				   ( "ELECTRONICA_FB_DETALLE"."COD_CAJA" = :gs_caja )   AND
				  ( "ELECTRONICA_FB_DETALLE"."ESTADO_REG" = 'P' )   
	USING		sqlca;
	if sqlca.sqlcode=0 then
		commit;
	else
		rollback;
		messagebox("Error Limpiar BOLETA","Error al Limpiar BOLETA SQL: "+sqlca.sqlerrtext)
	end if
end if
end subroutine

public subroutine wf_cargar_cupones_ci (string as_base, string as_serie, double al_numero);Long		ll_tot_reg,ll_fila_cred,ll_cta_cred,ll_fila,ll_dia_prox_pago,ll_day,ll_month,ll_year,ll_max,i,ll_new,ll_dias_dif,ll_suma_dias,ll_tot_fila,ll_reg,ll_dias_mora,ii_dmora,&
			ii_mora_cobro,id_im,id_gc,ll_indi,ll_ctas_mora_mant,ll_fila_inicial,ll_dias_mora_mant,ll_valor_cta_mant,ll_fila_mant,il_nenc,ll_ctas,ll_ctas_pagadas,ll_ctas_pag,&
			ll_ctas_mora,ll_cant_mant,ll_cant_cred,ll_ctas_pagada_1,ll_ctas_pagada_2
Date		ld_fecha_prox_pago,ld_fecha_inicial,ld_fecha_prox_venc,ld_fecha_hoy
Datetime	ldt_fecha_prim
String	ls_pasa,ls_fecha
Double	id_valor_cuota,id_valor_cuota_mant,id_interes_gc

SELECT 	"ESTADO_MORA_MANTENCION"."CANTIDAD_MESES", 	"ESTADO_MORA_CREDITO"."CANTIDAD_MESES"  
INTO   	:ll_cant_mant,														:ll_cant_cred
FROM   "CADENA", "ESTADO_MORA_CREDITO", "ESTADO_MORA_MANTENCION"  
WHERE ("CADENA"."ESTADO_MORA_CREDITO" = "ESTADO_MORA_CREDITO"."ESTADO_MORA_CREDITO" ) and  
		( "CADENA"."ESTADO_MORA_MANTENCION" = "ESTADO_MORA_MANTENCION"."ESTADO_MORA_MANTENCION" ) and  
		(("CADENA"."CODIGO" = :as_base ) AND  
		( "CADENA"."SERIE" = :as_serie ) AND  
		( "CADENA"."NUMERO" = :al_numero ) )   ;
		
ld_fecha_hoy					= date(gdt_fec_sistema)
ll_ctas_mora_mant			= 0
if tab_ingreso.SelectedTab = 1 then // cupon
elseif tab_ingreso.SelectedTab = 2 then //Comprobante Ingreso
	IF as_base = "O" or as_base="U" or as_base="M" THEN 
		il_nenc 						= tab_ingreso.tp_ci.dw_datos_ci.rowcount()
		if il_nenc>0 then
			id_valor_cuota 			= Round(tab_ingreso.tp_ci.dw_datos_ci.GetItemNumber(1,"c_valor_cuota_pesos"), 0)
			id_valor_cuota_mant	= Round(tab_ingreso.tp_ci.dw_datos_ci.GetItemNumber(1,"c_valor_cuota_mantencion_pesos"), 0)
			ll_ctas					= tab_ingreso.tp_ci.dw_datos_ci.getitemnumber(1,'pago_oferta_nro_cuotas')
			ll_ctas_pagadas		= tab_ingreso.tp_ci.dw_datos_ci.getitemnumber(1,'oferta_v_cta_pag_s')
			ll_ctas_pag				= ll_ctas_pagadas
			ldt_fecha_prim			= tab_ingreso.tp_ci.dw_datos_ci.GetItemdatetime(1,'pago_oferta_fecha_prim')
			ii_dmora 				= tab_ingreso.tp_ci.dw_datos_ci.GetItemNumber(1,"c_dias_mora")
			ll_ctas_mora			= tab_ingreso.tp_ci.dw_datos_ci.GetItemNumber(1,'c_cuotas_mora')
			ll_ctas_mora_mant	= tab_ingreso.tp_ci.dw_datos_ci.GetItemNumber(1,'c_cuotas_mora_m')
		end if
	
	ElseIF as_base = "L" THEN 
		il_nenc 						= tab_ingreso.tp_ci.dw_datos_ci.rowcount()
		if il_nenc>0 then
			id_valor_cuota 			= Round(tab_ingreso.tp_ci.dw_datos_ci.GetItemNumber(1,"c_valor_cuota_pesos"), 0)
			ll_ctas					= tab_ingreso.tp_ci.dw_datos_ci.getitemnumber(1,'pago_liberador_nro_cuotas')
			ll_ctas_pagadas		= tab_ingreso.tp_ci.dw_datos_ci.getitemnumber(1,'anexo_liberador_cta_pag_m')
			ll_ctas_pag				= ll_ctas_pagadas
			ldt_fecha_prim			= tab_ingreso.tp_ci.dw_datos_ci.GetItemdatetime(1,'pago_liberador_fecha_prim')
			ii_dmora 				= tab_ingreso.tp_ci.dw_datos_ci.GetItemNumber(1,"c_dias_mora")
			ll_ctas_mora			= tab_ingreso.tp_ci.dw_datos_ci.GetItemNumber(1,'c_cuotas_mora')
		end if
		
	ElseIF as_base = "F" or as_base="G" THEN 
		il_nenc 						= tab_ingreso.tp_ci.dw_datos_ci.rowcount()
		if il_nenc>0 then
			id_valor_cuota 			= Round(tab_ingreso.tp_ci.dw_datos_ci.GetItemNumber(1,"c_valor_cuota_pesos"), 0)
			ll_ctas					= tab_ingreso.tp_ci.dw_datos_ci.getitemnumber(1,'producto_pago_plazo')
			ll_ctas_pagadas		= tab_ingreso.tp_ci.dw_datos_ci.getitemnumber(1,'producto_anexo_cuotas_pag')
			ll_ctas_pag				= ll_ctas_pagadas
			ldt_fecha_prim			= tab_ingreso.tp_ci.dw_datos_ci.GetItemdatetime(1,'producto_pago_fecha_prim')
			ii_dmora 				= tab_ingreso.tp_ci.dw_datos_ci.GetItemNumber(1,"c_dias_mora")
			ll_ctas_mora			= tab_ingreso.tp_ci.dw_datos_ci.GetItemNumber(1,'c_cuotas_mora')
		end if
		
	ElseIF as_base = "P" THEN 
		il_nenc 						= tab_ingreso.tp_ci.dw_datos_ci.rowcount()
		if il_nenc>0 then
			id_valor_cuota 			= Round(tab_ingreso.tp_ci.dw_datos_ci.GetItemNumber(1,"c_valor_cuota_pesos"), 0)
			ll_ctas					= tab_ingreso.tp_ci.dw_datos_ci.getitemnumber(1,'pagare_plazo')
			ll_ctas_pagada_1		= tab_ingreso.tp_ci.dw_datos_ci.getitemnumber(1,'pagare_cta_pag_la')
			ll_ctas_pagada_2		= tab_ingreso.tp_ci.dw_datos_ci.getitemnumber(1,'pagare_cta_pag_isa')
			ll_ctas_pagadas		= ll_ctas_pagada_1 + ll_ctas_pagada_2
			ll_ctas_pag				= ll_ctas_pagadas
			ldt_fecha_prim			= tab_ingreso.tp_ci.dw_datos_ci.GetItemdatetime(1,'pagare_fecha_prim')
			ii_dmora 				= tab_ingreso.tp_ci.dw_datos_ci.GetItemNumber(1,"c_dias_mora")
			ll_ctas_mora			= tab_ingreso.tp_ci.dw_datos_ci.GetItemNumber(1,'c_cuotas_mora')
		end if
		
	ElseIF as_base = "D" THEN 
		il_nenc 						= tab_ingreso.tp_ci.dw_datos_ci.rowcount()
		if il_nenc>0 then
			id_valor_cuota 			= Round(tab_ingreso.tp_ci.dw_datos_ci.GetItemNumber(1,"c_valor_cuota_pesos"), 0)
			ll_ctas					= tab_ingreso.tp_ci.dw_datos_ci.getitemnumber(1,'derecho_plazo')
			ll_ctas_pagada_1		= tab_ingreso.tp_ci.dw_datos_ci.getitemnumber(1,'derecho_cta_pag_la')
			ll_ctas_pagada_2		= tab_ingreso.tp_ci.dw_datos_ci.getitemnumber(1,'derecho_cta_pag_isa')
			ll_ctas_pagadas		= ll_ctas_pagada_1 + ll_ctas_pagada_2
			ll_ctas_pag				= ll_ctas_pagadas
			ldt_fecha_prim			= tab_ingreso.tp_ci.dw_datos_ci.GetItemdatetime(1,'derecho_fecha_prim')
			ii_dmora 				= tab_ingreso.tp_ci.dw_datos_ci.GetItemNumber(1,"c_dias_mora")
			ll_ctas_mora			= tab_ingreso.tp_ci.dw_datos_ci.GetItemNumber(1,'c_cuotas_mora')
		end if
		
	ElseIF as_base = "A" THEN 
		il_nenc 						= tab_ingreso.tp_ci.dw_datos_ci.rowcount()
		if il_nenc>0 then
			id_valor_cuota 			= Round(tab_ingreso.tp_ci.dw_datos_ci.GetItemNumber(1,"c_valor_cuota_pesos"), 0)
			ll_ctas					= tab_ingreso.tp_ci.dw_datos_ci.getitemnumber(1,'pago_aumento_nro_cuotas')
			ll_ctas_pagadas		= tab_ingreso.tp_ci.dw_datos_ci.getitemnumber(1,'anexo_aumento_cta_pag_m')
			ll_ctas_pag				= ll_ctas_pagadas
			ldt_fecha_prim			= tab_ingreso.tp_ci.dw_datos_ci.GetItemdatetime(1,'pago_aumento_fecha_prim')
			ii_dmora 				= tab_ingreso.tp_ci.dw_datos_ci.GetItemNumber(1,"c_dias_mora")
			ll_ctas_mora			= tab_ingreso.tp_ci.dw_datos_ci.GetItemNumber(1,'c_cuotas_mora')
		end if
		
	ElseIF as_base = "C" then
		il_nenc 						= tab_ingreso.tp_ci.dw_datos_ci.rowcount()
		if il_nenc>0 then
			id_valor_cuota 			= Round(tab_ingreso.tp_ci.dw_datos_ci.GetItemNumber(1,"c_valor_cuota_mantencion_pesos"), 0)
			ll_ctas					= tab_ingreso.tp_ci.dw_datos_ci.getitemnumber(1,'contrato_plazo')
			ll_ctas_pagadas		= tab_ingreso.tp_ci.dw_datos_ci.getitemnumber(1,'contrato_cta_pag_m')
			ll_ctas_pag				= ll_ctas_pagadas		
			ll_ctas_mora_mant	= tab_ingreso.tp_ci.dw_datos_ci.GetItemNumber(1,'c_cuotas_en_mora')
			ii_dmora 				= tab_ingreso.tp_ci.dw_datos_ci.GetItemNumber(1,"c_dias_mora_mant")
		end if
		
	ElseIF as_base = "R" then
		il_nenc 						= tab_ingreso.tp_ci.dw_datos_ci.rowcount()
		if il_nenc>0 then
			id_valor_cuota 			= Round(tab_ingreso.tp_ci.dw_datos_ci.GetItemNumber(1,"valor_cuota"), 0)
			ll_ctas					= tab_ingreso.tp_ci.dw_datos_ci.getitemnumber(1,'cuotas_pactadas')
			ll_ctas_pagadas		= tab_ingreso.tp_ci.dw_datos_ci.getitemnumber(1,'ctas_pagadas')
			ll_ctas_pag				= ll_ctas_pagadas		
			ldt_fecha_prim			= tab_ingreso.tp_ci.dw_datos_ci.GetItemdatetime(1,'fecha_primera_cta')
			ii_dmora 				= tab_ingreso.tp_ci.dw_datos_ci.GetItemNumber(1,"c_dias_mora")
			ll_ctas_mora			= tab_ingreso.tp_ci.dw_datos_ci.GetItemNumber(1,'c_cuotas_mora')		
		end if
	END IF
	ll_tot_reg						= dw_detalle_pago_cupon2.retrieve(as_base,as_serie,al_numero)
	if ll_tot_reg=0 then
		tab_ingreso.tp_cupon.st_sin_cuponera.visible	= true
	else
		tab_ingreso.tp_cupon.st_sin_cuponera.visible	= false
		ll_fila_cred 					= dw_detalle_pago_cupon2.Find("cuponeras_detalle_tipo_mov = 'E'", 1, ll_tot_reg)
		if ll_fila_cred > 0 then
			ll_cta_cred				= dw_detalle_pago_cupon2.getitemnumber(ll_fila_cred,'cuponeras_detalle_nro_cuota')
		end if
		ll_fila 							= dw_detalle_pago_cupon2.Find("cuponeras_detalle_tipo_mov = 'E'", 1, ll_tot_reg)
		if ll_fila > 0 then
			dw_dias_mora.reset()
			ld_fecha_prox_pago	= date(dw_detalle_pago_cupon2.getitemdatetime(ll_fila,'cuponeras_detalle_fecha_venc'))
			ld_fecha_inicial			= ld_fecha_prox_pago
			ll_dia_prox_pago		= day(ld_fecha_prox_pago)
			ll_day						= day(ld_fecha_inicial)
			ll_month					= month(ld_fecha_inicial)
			ll_year					= year(ld_fecha_inicial)
			if (ll_month=1 and ll_day>=31) or (ll_month=2 and ll_day>=28) or (ll_month=3 and ll_day>=31) or &
				(ll_month=4 and ll_day>=30) or (ll_month=5 and ll_day>=31) or (ll_month=6 and ll_day>=30) or &
				(ll_month=7 and ll_day>=31) or (ll_month=8 and ll_day>=31) or (ll_month=9 and ll_day>=30) or &
				(ll_month=10 and ll_day>=31) or (ll_month=11 and ll_day>=30) or (ll_month=12 and ll_day>=31) then
				ls_pasa				= 'S'
			else
				ls_pasa				= 'N'
			end if
			ll_max					= 1000
			FOR i = 1 TO ll_max //ll_ctas_mora
				ll_new				= dw_dias_mora.insertrow(0)
				dw_dias_mora.scrolltorow(ll_new)
				ll_day					= day(ld_fecha_inicial)
				ll_month				= month(ld_fecha_inicial)
				ll_year				= year(ld_fecha_inicial)
				ll_month	++
				if (ll_month=1 and ll_dia_prox_pago>31) then
					ls_pasa			= 'S'
					ll_day				= 31
				elseif (ll_month=2 and ll_dia_prox_pago>28) then
					ls_pasa			= 'S'
					ll_day				= 28
				elseif (ll_month=3 and ll_dia_prox_pago>31) then
					ls_pasa			= 'S'
					ll_day				= 31
				elseif (ll_month=4 and ll_dia_prox_pago>30) then
					ls_pasa			= 'S'
					ll_day				= 30
				elseif (ll_month=5 and ll_dia_prox_pago>31) then
					ls_pasa			= 'S'
					ll_day				= 31
				elseif (ll_month=6 and ll_dia_prox_pago>30) then
					ls_pasa			= 'S'
					ll_day				= 30
				elseif (ll_month=7 and ll_dia_prox_pago>31) then
					ls_pasa			= 'S'
					ll_day				= 31
				elseif (ll_month=8 and ll_dia_prox_pago>31) then
					ls_pasa			= 'S'
					ll_day				= 31
				elseif (ll_month=9 and ll_dia_prox_pago>30) then
					ls_pasa			= 'S'
					ll_day				= 30
				elseif (ll_month=10 and ll_dia_prox_pago>31) then
					ls_pasa			= 'S'
					ll_day				= 31
				elseif (ll_month=11 and ll_dia_prox_pago>30) then
					ls_pasa			= 'S'
					ll_day				= 30
				elseif (ll_month=12 and ll_dia_prox_pago>31) then
					ls_pasa			= 'S'
					ll_day				= 31
				end if
				if ll_month>12 then
					ll_year ++
					ll_month			= 1
					if (ll_month=1 and ls_pasa='S') then
						ls_pasa		= 'S'
						ll_day			= 31
					end if
				end if
				ls_fecha						= string(ll_day,'00')+'/'+string(ll_month,'00')+'/'+string(ll_year,'0000')
				ld_fecha_prox_venc		= date(ls_fecha)
				dw_dias_mora.setitem(ll_new,'fecha_inicial',ld_fecha_inicial)
				if ld_fecha_prox_venc > ld_fecha_hoy then 
					ld_fecha_prox_venc	= ld_fecha_hoy
				end if
				dw_dias_mora.setitem(ll_new,'fecha_venc',ld_fecha_prox_venc)
				if ld_fecha_prox_venc < ld_fecha_hoy then
					ll_dias_dif				= 0
					ll_dias_dif				= DaysAfter(ld_fecha_inicial, ld_fecha_prox_venc)
					if ll_dias_dif<=0 then ll_dias_dif=0
					dw_dias_mora.setitem(ll_new,'dias_mora',ll_dias_dif)
					ld_fecha_inicial			= ld_fecha_prox_venc
				else
					ll_dias_dif				= 0
					ll_dias_dif				= DaysAfter(ld_fecha_inicial, ld_fecha_hoy) //ld_fecha_prox_venc)
					if ll_dias_dif<=0 then ll_dias_dif=0
					dw_dias_mora.setitem(ll_new,'dias_mora',ll_dias_dif)
					ld_fecha_inicial			= ld_fecha_prox_venc
					ll_suma_dias			= ll_suma_dias + ll_dias_dif
					exit
				end if
				ll_suma_dias				= ll_suma_dias + ll_dias_dif
			NEXT
			ll_tot_fila	= dw_dias_mora.rowcount()
			for ll_reg=1 to ll_tot_fila
				ll_suma_dias				= ll_suma_dias - ll_dias_mora
				dw_dias_mora.setitem(ll_reg,'suma_dias',ll_suma_dias)
				ll_dias_mora				= dw_dias_mora.getitemnumber(ll_reg,'dias_mora')
			next
			for ll_reg=1 to ll_tot_fila
				ii_dmora						= 0
				ii_mora_cobro				= 0
				id_im							= 0
				id_gc							= 0
				if ll_tot_fila>0 then
					ii_dmora 				= dw_dias_mora.GetItemNumber(ll_reg, "suma_dias")
					ll_dias_mora			= dw_dias_mora.GetItemNumber(ll_reg, "dias_mora")
					IF ii_dmora > 5 THEN
						ii_mora_cobro 		= ii_dmora
						id_im 					= gf_int_mora(tab_ingreso.tp_ci.dw_datos_ci.GetItemNumber(1, "c_tasa"), ii_mora_cobro, id_valor_cuota)
						IF ii_dmora > ll_dias_mora THEN		
							id_gc 				= Round(id_valor_cuota * id_factor_gc, 0)
						END IF
					END IF	
				end if
				ll_fila_cred 					= dw_detalle_pago_cupon2.Find("cuponeras_detalle_tipo_mov = 'E' and cuponeras_detalle_nro_cuota="+string(ll_cta_cred), 1, ll_tot_reg)
				if ll_fila_cred > 0 then
					dw_detalle_pago_cupon2.SetItem(ll_fila_cred, "cuponeras_detalle_monto_cuota_peso", id_valor_cuota)
					dw_detalle_pago_cupon2.SetItem(ll_fila_cred, "cuponeras_detalle_monto_gasto_cobranza", id_gc)
					dw_detalle_pago_cupon2.SetItem(ll_fila_cred, "cuponeras_detalle_monto_interes_mora", id_im)
					ll_cta_cred ++
				end if
			next
		end if 
		for ll_indi=1 to ll_tot_reg
			if dw_detalle_pago_cupon2.getitemstring(ll_indi,'cuponeras_detalle_tipo_mov')='E' then
				dw_detalle_pago_cupon2.setitem(ll_indi,'cuponeras_detalle_monto_cuota_peso',id_valor_cuota)
			else
				if as_base='O' or as_base='U' or as_base='M' then
					dw_detalle_pago_cupon2.setitem(ll_indi,'cuponeras_detalle_monto_cuota_peso',id_valor_cuota_mant)
				elseif as_base='C' then
					dw_detalle_pago_cupon2.setitem(ll_indi,'cuponeras_detalle_monto_cuota_peso',id_valor_cuota)
				end if
			end if
			dw_detalle_pago_cupon2.setitem(ll_indi,'estado_reg',1)
			dw_detalle_pago_cupon2.setitem(ll_indi,'reg_pago','S')
		next
		if ll_ctas_mora_mant > 0 then
			ll_fila_inicial					= 1
			ii_dmora						= 0
			ii_dmora 					= tab_ingreso.tp_ci.dw_datos_ci.GetItemNumber(1,"c_dias_mora_mant")
			ll_dias_mora_mant		= ii_dmora
			for ll_indi=1 to ll_ctas_mora_mant
				SELECT "TASA"."GASTO_COB_MORA" INTO :id_interes_gc FROM "TASA" WHERE "TASA"."LOOK" = 1 ;
				if as_base='O' or as_base='U' or as_base='M' then
					ll_valor_cta_mant	= id_valor_cuota_mant
				elseif as_base='C' then
					ll_valor_cta_mant	= id_valor_cuota
				end if
				ii_mora_cobro			= 0
				id_im						= 0
				id_gc						= 0
				IF ll_dias_mora_mant > 5 THEN 
					ii_mora_cobro		= ll_dias_mora_mant
					id_im 					= id_im + gf_int_mora(id_tasa_mant, ii_mora_cobro, ll_valor_cta_mant)
					IF ll_dias_mora_mant > 30 THEN 
						 id_gc 			= id_gc + Round(ll_valor_cta_mant * id_interes_gc, 0) //005// CAMBIO DE 10 A 5%
					END IF
					ll_dias_mora_mant	= ll_dias_mora_mant - ((ll_cant_mant * 30))
				else
					ii_mora_cobro 		= 0
					id_im 					= 0
					id_gc 					= 0
				END IF
				ll_fila_mant 				= dw_detalle_pago_cupon2.Find("cuponeras_detalle_tipo_mov = 'F'", ll_fila_inicial, ll_tot_reg)
				if ll_fila_mant > 0 then
					dw_detalle_pago_cupon2.SetItem(ll_fila_mant, "cuponeras_detalle_monto_gasto_cobranza", id_gc)
					dw_detalle_pago_cupon2.SetItem(ll_fila_mant, "cuponeras_detalle_monto_interes_mora", id_im)
					ll_fila_inicial	= ll_fila_mant + 1
				end if
			next
		end if
	end if
elseif tab_ingreso.SelectedTab = 3 then //Boleta
	IF as_base = "O" or as_base="U" or as_base='M' THEN 
		il_nenc 						= tab_ingreso.tp_be.dw_datos_be.rowcount()
		if il_nenc>0 then
			id_valor_cuota 			= Round(tab_ingreso.tp_be.dw_datos_be.GetItemNumber(1,"c_valor_cuota_pesos"), 0)
			id_valor_cuota_mant	= Round(tab_ingreso.tp_be.dw_datos_be.GetItemNumber(1,"c_valor_cuota_mantencion_pesos"), 0)
			ll_ctas					= tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'pago_oferta_nro_cuotas')
			ll_ctas_pagadas		= tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'oferta_v_cta_pag_s')
			ll_ctas_pag				= ll_ctas_pagadas
			ldt_fecha_prim			= tab_ingreso.tp_be.dw_datos_be.GetItemdatetime(1,'pago_oferta_fecha_prim')
			ii_dmora 				= tab_ingreso.tp_be.dw_datos_be.GetItemNumber(1,"c_dias_mora")
			ll_ctas_mora			= tab_ingreso.tp_be.dw_datos_be.GetItemNumber(1,'c_cuotas_mora')
			ll_ctas_mora_mant	= tab_ingreso.tp_be.dw_datos_be.GetItemNumber(1,'c_cuotas_mora_m')
		end if
	
	ElseIF as_base = "L" THEN 
		il_nenc 						= tab_ingreso.tp_be.dw_datos_be.rowcount()
		if il_nenc>0 then
			id_valor_cuota 			= Round(tab_ingreso.tp_be.dw_datos_be.GetItemNumber(1,"c_valor_cuota_pesos"), 0)
			ll_ctas					= tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'pago_liberador_nro_cuotas')
			ll_ctas_pagadas		= tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'anexo_liberador_cta_pag_m')
			ll_ctas_pag				= ll_ctas_pagadas
			ldt_fecha_prim			= tab_ingreso.tp_be.dw_datos_be.GetItemdatetime(1,'pago_liberador_fecha_prim')
			ii_dmora 				= tab_ingreso.tp_be.dw_datos_be.GetItemNumber(1,"c_dias_mora")
			ll_ctas_mora			= tab_ingreso.tp_be.dw_datos_be.GetItemNumber(1,'c_cuotas_mora')
		end if
		
	ElseIF as_base = "F" or as_base="G" THEN 
		il_nenc 						= tab_ingreso.tp_be.dw_datos_be.rowcount()
		if il_nenc>0 then
			id_valor_cuota 			= Round(tab_ingreso.tp_be.dw_datos_be.GetItemNumber(1,"c_valor_cuota_pesos"), 0)
			ll_ctas					= tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'producto_pago_plazo')
			ll_ctas_pagadas		= tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'producto_anexo_cuotas_pag')
			ll_ctas_pag				= ll_ctas_pagadas
			ldt_fecha_prim			= tab_ingreso.tp_be.dw_datos_be.GetItemdatetime(1,'producto_pago_fecha_prim')
			ii_dmora 				= tab_ingreso.tp_be.dw_datos_be.GetItemNumber(1,"c_dias_mora")
			ll_ctas_mora			= tab_ingreso.tp_be.dw_datos_be.GetItemNumber(1,'c_cuotas_mora')
		end if
		
	ElseIF as_base = "P" THEN 
		il_nenc 						= tab_ingreso.tp_be.dw_datos_be.rowcount()
		if il_nenc>0 then
			id_valor_cuota 			= Round(tab_ingreso.tp_be.dw_datos_be.GetItemNumber(1,"c_valor_cuota_pesos"), 0)
			ll_ctas					= tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'pagare_plazo')
			ll_ctas_pagada_1		= tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'pagare_cta_pag_la')
			ll_ctas_pagada_2		= tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'pagare_cta_pag_isa')
			ll_ctas_pagadas		= ll_ctas_pagada_1 + ll_ctas_pagada_2
			ll_ctas_pag				= ll_ctas_pagadas
			ldt_fecha_prim			= tab_ingreso.tp_be.dw_datos_be.GetItemdatetime(1,'pagare_fecha_prim')
			ii_dmora 				= tab_ingreso.tp_be.dw_datos_be.GetItemNumber(1,"c_dias_mora")
			ll_ctas_mora			= tab_ingreso.tp_be.dw_datos_be.GetItemNumber(1,'c_cuotas_mora')
		end if
		
	ElseIF as_base = "D" THEN 
		il_nenc 						= tab_ingreso.tp_be.dw_datos_be.rowcount()
		if il_nenc>0 then
			id_valor_cuota 			= Round(tab_ingreso.tp_be.dw_datos_be.GetItemNumber(1,"c_valor_cuota_pesos"), 0)
			ll_ctas					= tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'derecho_plazo')
			ll_ctas_pagada_1		= tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'derecho_cta_pag_la')
			ll_ctas_pagada_2		= tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'derecho_cta_pag_isa')
			ll_ctas_pagadas		= ll_ctas_pagada_1 + ll_ctas_pagada_2
			ll_ctas_pag				= ll_ctas_pagadas
			ldt_fecha_prim			= tab_ingreso.tp_be.dw_datos_be.GetItemdatetime(1,'derecho_fecha_prim')
			ii_dmora 				= tab_ingreso.tp_be.dw_datos_be.GetItemNumber(1,"c_dias_mora")
			ll_ctas_mora			= tab_ingreso.tp_be.dw_datos_be.GetItemNumber(1,'c_cuotas_mora')
		end if
		
	ElseIF as_base = "A" THEN 
		il_nenc 						= tab_ingreso.tp_be.dw_datos_be.rowcount()
		if il_nenc>0 then
			id_valor_cuota 			= Round(tab_ingreso.tp_be.dw_datos_be.GetItemNumber(1,"c_valor_cuota_pesos"), 0)
			ll_ctas					= tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'pago_aumento_nro_cuotas')
			ll_ctas_pagadas		= tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'anexo_aumento_cta_pag_m')
			ll_ctas_pag				= ll_ctas_pagadas
			ldt_fecha_prim			= tab_ingreso.tp_be.dw_datos_be.GetItemdatetime(1,'pago_aumento_fecha_prim')
			ii_dmora 				= tab_ingreso.tp_be.dw_datos_be.GetItemNumber(1,"c_dias_mora")
			ll_ctas_mora			= tab_ingreso.tp_be.dw_datos_be.GetItemNumber(1,'c_cuotas_mora')
		end if
		
	ElseIF as_base = "C" then
		il_nenc 						= tab_ingreso.tp_be.dw_datos_be.rowcount()
		if il_nenc>0 then
			id_valor_cuota 			= Round(tab_ingreso.tp_be.dw_datos_be.GetItemNumber(1,"c_valor_cuota_mantencion_pesos"), 0)
			ll_ctas					= tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'contrato_plazo')
			ll_ctas_pagadas		= tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'contrato_cta_pag_m')
			ll_ctas_pag				= ll_ctas_pagadas		
			ll_ctas_mora_mant	= tab_ingreso.tp_be.dw_datos_be.GetItemNumber(1,'c_cuotas_en_mora')
			ii_dmora 				= tab_ingreso.tp_be.dw_datos_be.GetItemNumber(1,"c_dias_mora_mant")
		end if
		
	ElseIF as_base = "R" then
		il_nenc 						= tab_ingreso.tp_be.dw_datos_be.rowcount()
		if il_nenc>0 then
			id_valor_cuota 			= Round(tab_ingreso.tp_be.dw_datos_be.GetItemNumber(1,"valor_cuota"), 0)
			ll_ctas					= tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'cuotas_pactadas')
			ll_ctas_pagadas		= tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'ctas_pagadas')
			ll_ctas_pag				= ll_ctas_pagadas		
			ldt_fecha_prim			= tab_ingreso.tp_be.dw_datos_be.GetItemdatetime(1,'fecha_primera_cta')
			ii_dmora 				= tab_ingreso.tp_be.dw_datos_be.GetItemNumber(1,"c_dias_mora")
			ll_ctas_mora			= tab_ingreso.tp_be.dw_datos_be.GetItemNumber(1,'c_cuotas_mora')		
		end if
	END IF
	ll_tot_reg						= dw_detalle_pago_cupon2.retrieve(as_base,as_serie,al_numero)
	if ll_tot_reg=0 then
		tab_ingreso.tp_cupon.st_sin_cuponera.visible	= true
	else
		tab_ingreso.tp_cupon.st_sin_cuponera.visible	= false
		ll_fila_cred 					= dw_detalle_pago_cupon2.Find("cuponeras_detalle_tipo_mov = 'E'", 1, ll_tot_reg)
		if ll_fila_cred > 0 then
			ll_cta_cred				= dw_detalle_pago_cupon2.getitemnumber(ll_fila_cred,'cuponeras_detalle_nro_cuota')
		end if
		ll_fila 							= dw_detalle_pago_cupon2.Find("cuponeras_detalle_tipo_mov = 'E'", 1, ll_tot_reg)
		if ll_fila > 0 then
			dw_dias_mora.reset()
			ld_fecha_prox_pago	= date(dw_detalle_pago_cupon2.getitemdatetime(ll_fila,'cuponeras_detalle_fecha_venc'))
			ld_fecha_inicial			= ld_fecha_prox_pago
			ll_dia_prox_pago		= day(ld_fecha_prox_pago)
			ll_day						= day(ld_fecha_inicial)
			ll_month					= month(ld_fecha_inicial)
			ll_year					= year(ld_fecha_inicial)
			if (ll_month=1 and ll_day>=31) or (ll_month=2 and ll_day>=28) or (ll_month=3 and ll_day>=31) or &
				(ll_month=4 and ll_day>=30) or (ll_month=5 and ll_day>=31) or (ll_month=6 and ll_day>=30) or &
				(ll_month=7 and ll_day>=31) or (ll_month=8 and ll_day>=31) or (ll_month=9 and ll_day>=30) or &
				(ll_month=10 and ll_day>=31) or (ll_month=11 and ll_day>=30) or (ll_month=12 and ll_day>=31) then
				ls_pasa				= 'S'
			else
				ls_pasa				= 'N'
			end if
			ll_max					= 1000
			FOR i = 1 TO ll_max //ll_ctas_mora
				ll_new				= dw_dias_mora.insertrow(0)
				dw_dias_mora.scrolltorow(ll_new)
				ll_day					= day(ld_fecha_inicial)
				ll_month				= month(ld_fecha_inicial)
				ll_year				= year(ld_fecha_inicial)
				ll_month	++
				if (ll_month=1 and ll_dia_prox_pago>31) then
					ls_pasa			= 'S'
					ll_day				= 31
				elseif (ll_month=2 and ll_dia_prox_pago>28) then
					ls_pasa			= 'S'
					ll_day				= 28
				elseif (ll_month=3 and ll_dia_prox_pago>31) then
					ls_pasa			= 'S'
					ll_day				= 31
				elseif (ll_month=4 and ll_dia_prox_pago>30) then
					ls_pasa			= 'S'
					ll_day				= 30
				elseif (ll_month=5 and ll_dia_prox_pago>31) then
					ls_pasa			= 'S'
					ll_day				= 31
				elseif (ll_month=6 and ll_dia_prox_pago>30) then
					ls_pasa			= 'S'
					ll_day				= 30
				elseif (ll_month=7 and ll_dia_prox_pago>31) then
					ls_pasa			= 'S'
					ll_day				= 31
				elseif (ll_month=8 and ll_dia_prox_pago>31) then
					ls_pasa			= 'S'
					ll_day				= 31
				elseif (ll_month=9 and ll_dia_prox_pago>30) then
					ls_pasa			= 'S'
					ll_day				= 30
				elseif (ll_month=10 and ll_dia_prox_pago>31) then
					ls_pasa			= 'S'
					ll_day				= 31
				elseif (ll_month=11 and ll_dia_prox_pago>30) then
					ls_pasa			= 'S'
					ll_day				= 30
				elseif (ll_month=12 and ll_dia_prox_pago>31) then
					ls_pasa			= 'S'
					ll_day				= 31
				end if
				if ll_month>12 then
					ll_year ++
					ll_month			= 1
					if (ll_month=1 and ls_pasa='S') then
						ls_pasa		= 'S'
						ll_day			= 31
					end if
				end if
				ls_fecha						= string(ll_day,'00')+'/'+string(ll_month,'00')+'/'+string(ll_year,'0000')
				ld_fecha_prox_venc		= date(ls_fecha)
				dw_dias_mora.setitem(ll_new,'fecha_inicial',ld_fecha_inicial)
				if ld_fecha_prox_venc > ld_fecha_hoy then 
					ld_fecha_prox_venc	= ld_fecha_hoy
				end if
				dw_dias_mora.setitem(ll_new,'fecha_venc',ld_fecha_prox_venc)
				if ld_fecha_prox_venc < ld_fecha_hoy then
					ll_dias_dif				= 0
					ll_dias_dif				= DaysAfter(ld_fecha_inicial, ld_fecha_prox_venc)
					if ll_dias_dif<=0 then ll_dias_dif=0
					dw_dias_mora.setitem(ll_new,'dias_mora',ll_dias_dif)
					ld_fecha_inicial			= ld_fecha_prox_venc
				else
					ll_dias_dif				= 0
					ll_dias_dif				= DaysAfter(ld_fecha_inicial, ld_fecha_hoy) //ld_fecha_prox_venc)
					if ll_dias_dif<=0 then ll_dias_dif=0
					dw_dias_mora.setitem(ll_new,'dias_mora',ll_dias_dif)
					ld_fecha_inicial			= ld_fecha_prox_venc
					ll_suma_dias			= ll_suma_dias + ll_dias_dif
					exit
				end if
				ll_suma_dias				= ll_suma_dias + ll_dias_dif
			NEXT
			ll_tot_fila	= dw_dias_mora.rowcount()
			for ll_reg=1 to ll_tot_fila
				ll_suma_dias				= ll_suma_dias - ll_dias_mora
				dw_dias_mora.setitem(ll_reg,'suma_dias',ll_suma_dias)
				ll_dias_mora				= dw_dias_mora.getitemnumber(ll_reg,'dias_mora')
			next
			for ll_reg=1 to ll_tot_fila
				ii_dmora						= 0
				ii_mora_cobro				= 0
				id_im							= 0
				id_gc							= 0
				if ll_tot_fila>0 then
					ii_dmora 				= dw_dias_mora.GetItemNumber(ll_reg, "suma_dias")
					ll_dias_mora			= dw_dias_mora.GetItemNumber(ll_reg, "dias_mora")
					IF ii_dmora > 5 THEN
						ii_mora_cobro 		= ii_dmora
						id_im 					= gf_int_mora(tab_ingreso.tp_be.dw_datos_be.GetItemNumber(1, "c_tasa"), ii_mora_cobro, id_valor_cuota)
						IF ii_dmora > ll_dias_mora THEN		
							id_gc 				= Round(id_valor_cuota * id_factor_gc, 0)
						END IF
					END IF	
				end if
				ll_fila_cred 					= dw_detalle_pago_cupon2.Find("cuponeras_detalle_tipo_mov = 'E' and cuponeras_detalle_nro_cuota="+string(ll_cta_cred), 1, ll_tot_reg)
				if ll_fila_cred > 0 then
					dw_detalle_pago_cupon2.SetItem(ll_fila_cred, "cuponeras_detalle_monto_cuota_peso", id_valor_cuota)
					dw_detalle_pago_cupon2.SetItem(ll_fila_cred, "cuponeras_detalle_monto_gasto_cobranza", id_gc)
					dw_detalle_pago_cupon2.SetItem(ll_fila_cred, "cuponeras_detalle_monto_interes_mora", id_im)
					ll_cta_cred ++
				end if
			next
		end if 
		for ll_indi=1 to ll_tot_reg
			if dw_detalle_pago_cupon2.getitemstring(ll_indi,'cuponeras_detalle_tipo_mov')='E' then
				dw_detalle_pago_cupon2.setitem(ll_indi,'cuponeras_detalle_monto_cuota_peso',id_valor_cuota)
			else
				if as_base='O' or as_base='U' or as_base='M' then
					dw_detalle_pago_cupon2.setitem(ll_indi,'cuponeras_detalle_monto_cuota_peso',id_valor_cuota_mant)
				elseif as_base='C' then
					dw_detalle_pago_cupon2.setitem(ll_indi,'cuponeras_detalle_monto_cuota_peso',id_valor_cuota)
				end if
			end if
			dw_detalle_pago_cupon2.setitem(ll_indi,'estado_reg',1)
			dw_detalle_pago_cupon2.setitem(ll_indi,'reg_pago','S')
		next
		if ll_ctas_mora_mant > 0 then
			ll_fila_inicial					= 1
			ii_dmora						= 0
			ii_dmora 					= tab_ingreso.tp_be.dw_datos_be.GetItemNumber(1,"c_dias_mora_mant")
			ll_dias_mora_mant		= ii_dmora
			for ll_indi=1 to ll_ctas_mora_mant
				SELECT "TASA"."GASTO_COB_MORA" INTO :id_interes_gc FROM "TASA" WHERE "TASA"."LOOK" = 1 ;
				if as_base='O' or as_base='U' or as_base='M' then
					ll_valor_cta_mant	= id_valor_cuota_mant
				elseif as_base='C' then
					ll_valor_cta_mant	= id_valor_cuota
				end if
				ii_mora_cobro			= 0
				id_im						= 0
				id_gc						= 0
				IF ll_dias_mora_mant > 5 THEN 
					ii_mora_cobro		= ll_dias_mora_mant
					id_im 					= id_im + gf_int_mora(id_tasa_mant, ii_mora_cobro, ll_valor_cta_mant)
					IF ll_dias_mora_mant > 30 THEN 
						 id_gc 			= id_gc + Round(ll_valor_cta_mant * id_interes_gc, 0) //005// CAMBIO DE 10 A 5%
					END IF
					ll_dias_mora_mant	= ll_dias_mora_mant - ((ll_cant_mant * 30))
				else
					ii_mora_cobro 		= 0
					id_im 					= 0
					id_gc 					= 0
				END IF
				ll_fila_mant 				= dw_detalle_pago_cupon2.Find("cuponeras_detalle_tipo_mov = 'F'", ll_fila_inicial, ll_tot_reg)
				if ll_fila_mant > 0 then
					dw_detalle_pago_cupon2.SetItem(ll_fila_mant, "cuponeras_detalle_monto_gasto_cobranza", id_gc)
					dw_detalle_pago_cupon2.SetItem(ll_fila_mant, "cuponeras_detalle_monto_interes_mora", id_im)
					ll_fila_inicial	= ll_fila_mant + 1
				end if
			next
		end if
	end if
end if
end subroutine

public subroutine wf_cargar_datos (string as_base, string as_serie, double al_numero);Long		il_nenc,il_ncred,ll_ctas,ll_ctas_pagadas,ll_ctas_pagada_1,ll_ctas_pagada_2,ll_tot_reg,ll_indi,ll_fila,ll_dia_prox_pago,ll_day,ll_month,ll_year,ll_max,i,&
			ll_new,ll_dias_dif,ll_suma_dias,ll_tot_fila,ll_reg,ll_dias_mora,ii_dmora,ii_mora_cobro,id_im,id_gc,ll_ctas_pag,ll_ctas_mora,ll_fila_cred,ll_cta_cred,&
			ll_ctas_mora_mant,ll_dias_mora_mant,ll_fila_inicial,ll_fila_mant,ll_estado_carta,ll_count,ll_count_mant,ll_new_reg,ll_count_peso,ll_cod_seguro,ll_cant_mant,&
			ll_cant_cred,ll_count_filas,ll_cuota,ll_valor_int,ll_suma_acum_gc
String		ls_estado,ls_pasa,ls_fecha,ls_fono_p,ls_fono_part,ls_celular,ls_fono_c,ls_fono_pc,ls_fono_cc,ls_string,ls_moneda
Date		ld_fecha_prox_pago,ld_fecha_inicial,ld_fecha_prox_venc,ld_fecha_hoy
Datetime	ldt_fecha_prim
Double	id_valor_cuota,id_valor_cuota_mant,id_interes_gc,ll_valor_cta_mant,ldb_suma_seguro=0,ldb_suma

ld_fecha_hoy											= date(gdt_fec_sistema)
ll_ctas_mora_mant									= 0
tab_ingreso.tp_cupon.st_total_pagado.text		= '0'
st_aviso_ap.visible										= false
SELECT 	"ESTADO_MORA_MANTENCION"."CANTIDAD_MESES", 	"ESTADO_MORA_CREDITO"."CANTIDAD_MESES"  
INTO   	:ll_cant_mant,														:ll_cant_cred
FROM   "CADENA", "ESTADO_MORA_CREDITO", "ESTADO_MORA_MANTENCION"  
WHERE ("CADENA"."ESTADO_MORA_CREDITO" = "ESTADO_MORA_CREDITO"."ESTADO_MORA_CREDITO" ) and  
		( "CADENA"."ESTADO_MORA_MANTENCION" = "ESTADO_MORA_MANTENCION"."ESTADO_MORA_MANTENCION" ) and  
		(("CADENA"."CODIGO" = :as_base ) AND  
		( "CADENA"."SERIE" = :as_serie ) AND  
		( "CADENA"."NUMERO" = :al_numero ) )   ;
		
SELECT	SUM("SEGURO_ASOCIADOS"."MONTO_PRIMA")
INTO 		:ldb_suma
FROM 	"SEGURO_ASOCIADOS"  
WHERE ( "SEGURO_ASOCIADOS"."BASE" = :as_base ) AND  
		  ( "SEGURO_ASOCIADOS"."SERIE" = :as_serie ) AND  
		  ( "SEGURO_ASOCIADOS"."NUMERO" = :al_numero ) AND  
		  ( "SEGURO_ASOCIADOS"."ESTADO_REG" = 0 ) AND  
		  ( "SEGURO_ASOCIADOS"."ESTADO_SEGURO" = 'A' )  AND
		  ( "SEGURO_ASOCIADOS"."MONTO_PRIMA" > 0 );

SELECT DISTINCT	"SEGURO_ASOCIADOS"."MONEDA"  
INTO 		:ls_moneda  
FROM 	"SEGURO_ASOCIADOS"  
WHERE ( "SEGURO_ASOCIADOS"."BASE" = :as_base ) AND  
		  ( "SEGURO_ASOCIADOS"."SERIE" = :as_serie ) AND  
		  ( "SEGURO_ASOCIADOS"."NUMERO" = :al_numero ) AND  
		  ( "SEGURO_ASOCIADOS"."ESTADO_REG" = 0 ) AND  
		  ( "SEGURO_ASOCIADOS"."ESTADO_SEGURO" = 'A' )   AND
		  ( "SEGURO_ASOCIADOS"."MONTO_PRIMA" > 0 ) ;

if ls_moneda='1' then
	ldb_suma_seguro		= ldb_suma
elseif ls_moneda='2' then
	ldb_suma_seguro		= ROUND(ldb_suma * gd_uf,0)
end if
IF as_base = "O" or as_base="U" or as_base="M" THEN 
	tab_ingreso.tp_cupon.st_10.text				= " P RO M E S A "
	il_nenc 						= dw_encabezado_ingreso_cupon.Retrieve(as_base, as_serie, al_numero)
	tab_ingreso.tp_cupon.dw_datos_credito_oferta.DataObject = 'dw_datos_contrato_promesa'
	tab_ingreso.tp_cupon.dw_datos_credito_oferta.SetTransObject(SQLCA)
	il_ncred 						= tab_ingreso.tp_cupon.dw_datos_credito_oferta.Retrieve(as_serie, al_numero,gd_uf)
	if il_ncred>0 then
		id_valor_cuota 			= Round(tab_ingreso.tp_cupon.dw_datos_credito_oferta.GetItemNumber(1,"c_valor_cuota_cred_peso"), 0)
		id_valor_cuota_mant	= Round(tab_ingreso.tp_cupon.dw_datos_credito_oferta.GetItemNumber(1,"c_valor_cuota_mant_peso"), 0)
		ll_ctas					= tab_ingreso.tp_cupon.dw_datos_credito_oferta.getitemnumber(1,'pago_oferta_nro_cuotas')
		ll_ctas_pagadas		= tab_ingreso.tp_cupon.dw_datos_credito_oferta.getitemnumber(1,'oferta_v_cta_pag_s')
		ll_ctas_pag				= ll_ctas_pagadas
		ldt_fecha_prim			= tab_ingreso.tp_cupon.dw_datos_credito_oferta.GetItemdatetime(1,'pago_oferta_fecha_prim')
		ii_dmora 				= tab_ingreso.tp_cupon.dw_datos_credito_oferta.GetItemNumber(1,"c_dias_mora")
		ll_ctas_mora			= tab_ingreso.tp_cupon.dw_datos_credito_oferta.GetItemNumber(1,'c_cuotas_mora')
		ll_cuota					= ll_ctas_mora
		ll_ctas_mora_mant	= tab_ingreso.tp_cupon.dw_datos_credito_oferta.GetItemNumber(1,'c_cuotas_mora_m')
		ll_estado_carta			= tab_ingreso.tp_cupon.dw_datos_credito_oferta.GetItemNumber(1,'cadena_estado_carta')
		gl_cod_parque			= tab_ingreso.tp_cupon.dw_datos_credito_oferta.GetItemNumber(1,'cadena_cod_parque')
	end if

ElseIF as_base = "L" THEN 
	tab_ingreso.tp_cupon.st_10.text				= " ANEXO LIBERADOR"
	il_nenc 					= dw_encabezado_ingreso_cupon.Retrieve(as_base, as_serie, al_numero)
	tab_ingreso.tp_cupon.dw_datos_credito_oferta.DataObject = 'dw_datos_contrato_liberador'
