type sle_n_contrato from editmask within tp_cupon
event ue_mousemove pbm_mousemove
integer x = 293
integer y = 20
integer width = 667
integer height = 88
integer taborder = 10
integer textsize = -10
integer weight = 700
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
long backcolor = 16776960
alignment alignment = center!
textcase textcase = upper!
borderstyle borderstyle = stylelowered!
maskdatatype maskdatatype = stringmask!
string mask = "!!!!!!!!!!!!!!!"
end type

event ue_mousemove;tab_ingreso.tp_cupon.st_help_ctto.visible	= true
if is_opcion='FP' and (gs_depto='T' or gs_depto='I') then st_fuera_plazo.visible = true
end event

event modified;string 	is_base, is_serie, ls_estado
long 		il_nenc, il_ncred,ll_ctas,ll_ctas_pagadas,ll_ctas_pagada_1,&
			ll_tot_reg,ll_indi,ll_ctas_pagada_2
Double	il_numero

IF len(sle_n_contrato.text) >= 3 THEN
	il_contar_g ++
	il_contar_ctto				= il_contar_g
	is_base 						= Mid(sle_n_contrato.text, 1, 1)
	is_serie 						= Mid(sle_n_contrato.text, 2, 1)
	il_numero 					= Double(Mid(sle_n_contrato.text, 3, len(sle_n_contrato.text)-2))
	wf_cargar_datos(is_base,is_serie,il_numero)
else
//	messagebox("Advertencia","Recuerde Ingresar BASE, SERIE y NUMERO")
	sle_n_contrato.setfocus()
END IF
end event

type st_2 from statictext within tp_cupon
event ue_mousemove pbm_mousemove
integer y = 32
integer width = 279
integer height = 72
integer textsize = -8
