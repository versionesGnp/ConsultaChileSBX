				ll_ctas_pag			= w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.GetItemnumber(1,'ctas_pagadas')
			elseif gs_base='P' then
				ldt_fecha_prim		= w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.GetItemdatetime(1,'pagare_fecha_prim')
				ll_ctas_pag			= w_ingreso2.tab_ingreso.tp_ci.dw_datos_ci.GetItemnumber(1,'c_cuotas_pagadas')
			elseif gs_base='D' then
