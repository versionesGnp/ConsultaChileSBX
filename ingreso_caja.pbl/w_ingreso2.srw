dw_detalle_pago_cupon2.Reset()
//tab_ingreso.tp_be.dw_abono.Reset()
dw_parque_be.reset()
dw_parque_be.visible							= false
dw_dias_mora.Reset()
dw_be_buscar_cliente.enabled				= true
cbx_sin_mora_be.checked					= false
cbx_sin_gastos_be.checked					= false
cbx_sin_mora_be.enabled					= false
cbx_sin_gastos_be.enabled					= false
st_aviso_ap.visible								= false
cbx_paga_ef_be.checked						= false
cbx_paga_ef_be.enabled						= false
//wf_limpiar_opciones()
dw_be_buscar_cliente.setfocus()
dw_be_buscar_cliente.setcolumn('rl_rut')
Setnull(gs_grabar_pie)
Setnull(gl_cod_parque)
Setnull(gi_rut)
Setnull(gs_base)
Setnull(gs_serie)
Setnull(gi_numero)
Setnull(gs_rezago)
Setnull(gs_moneda_rezago)
Setnull(gd_total)
end event

type cb_ingresar_pago_be from commandbutton within tp_be
event ue_mousemove pbm_mousemove
integer x = 2875
integer y = 1420
integer width = 727
integer height = 96
integer taborder = 60
integer textsize = -9
integer weight = 700
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string text = "Ingresar &Forma de Pago"
end type

event ue_mousemove;wf_no_mostrar_help_be()
if is_opcion='FP' and (gs_depto='T' or gs_depto='I') then st_fuera_plazo.visible = true
end event

event clicked;long		ll_indi, ll_tot_reg,ll_monto,ll_cantidad,ll_sw_pasa=0,ll_fila_iva,ll_monto_iva,ll_fila,ll_fila_ba_inmob,ll_fila_iva_e,ll_fila_iva_l,ll_fila_otro,ll_fila_mf,ll_fila_22,ll_fila_cred,ll_fila_otros,&
			ll_fila_mortuoria
Double	ld_monto_uf
String	ls_tipo_cob,ls_moneda,ls_tipo_cob_otro,ls_texto,ls_valida,ls_string_iva,ls_string_otro,ls_string

SetPointer ( Cross! )
is_pasa_descto				= 'S'
ls_valida						= 'S'
gl_valor_iva					= 0
ll_sw_pasa					= 0
if isvalid(w_forma_pago2) then close(w_forma_pago2)
ll_tot_reg					= dw_detalle_be.rowcount()
if ll_tot_reg>0 then
	ls_string					= "cod_servicio > 0"
	ll_fila						= dw_detalle_be.Find(ls_string, 1, dw_detalle_be.RowCount())
	ll_fila_22					= dw_detalle_be.Find("tipo_cob_otro = '22' ", 1, dw_detalle_be.RowCount())
	if ll_fila = 0 then
		if gs_base = 'G' and ll_fila_22 > 0 then
			gs_tipo_cobro	= 'FA'
//		else
//			gs_tipo_cobro	= 'BA'
		end if
	end if
	ll_fila_mortuoria						= dw_detalle_be.Find("tipo_cob_otro = '490' or tipo_cob_otro = '491' ", 1, dw_detalle_be.RowCount())
	if ll_fila_mortuoria > 0 and gs_base='F' then
		gs_tipo_cobro	= 'FA'
	end if
	
	for ll_indi=1 to ll_tot_reg
		ls_tipo_cob			= dw_detalle_be.getitemstring(ll_indi,'tipo_cob')
		ls_tipo_cob_otro	= dw_detalle_be.getitemstring(ll_indi,'tipo_cob_otro')
		ll_cantidad			= dw_detalle_be.getitemnumber(ll_indi,'cantidad')
		ll_monto				= dw_detalle_be.getitemnumber(ll_indi,'monto')
		ld_monto_uf			= dw_detalle_be.getitemnumber(ll_indi,'monto_uf')
		ls_moneda			= dw_detalle_be.getitemstring(ll_indi,'moneda')	
		if ls_tipo_cob_otro = "" then ls_tipo_cob_otro = '0'
//		if ls_tipo_cob = 'S' and ls_tipo_cob_otro <> '0' then
//			wf_validar_descuento()
//		end if	
		if isnull(ls_tipo_cob) or ls_tipo_cob='' then
			messagebox("Advertencia","Error debe ingresar Tipo de Cobro en Fila Nº: "+string(ll_indi))
			dw_detalle_be.setfocus()
			dw_detalle_be.scrolltorow(ll_indi)
			dw_detalle_be.setcolumn('tipo_cob')
			ll_sw_pasa ++
			exit
		elseif ls_tipo_cob='L' and ( isnull(ls_tipo_cob_otro) or ls_tipo_cob_otro='') then
			messagebox("Advertencia","Error debe ingresar Tipo de Cobro en Fila Nº: "+string(ll_indi))
			dw_detalle_be.setfocus()
			dw_detalle_be.scrolltorow(ll_indi)
			dw_detalle_be.setcolumn('tipo_cob')
			ll_sw_pasa ++
			exit
		elseif isnull(ll_cantidad) or ll_cantidad=0 then
			messagebox("Advertencia","Error debe ingresar Cantidad en Fila Nº: "+string(ll_indi))
			dw_detalle_be.setfocus()
			dw_detalle_be.scrolltorow(ll_indi)
			dw_detalle_be.setcolumn('cantidad')
			ll_sw_pasa ++
			exit
		elseif (isnull(ll_monto) or ll_monto=0) and (isnull(ld_monto_uf) or ld_monto_uf=0) then
			messagebox("Advertencia","Error debe ingresar Monto en Fila Nº: "+string(ll_indi))
			dw_detalle_be.setfocus()
			dw_detalle_be.scrolltorow(ll_indi)
			if ls_moneda='P' then
				dw_detalle_be.setcolumn('monto')
			else
				dw_detalle_be.setcolumn('monto_uf')
			end if
			ll_sw_pasa ++
			exit
		end if
	next	
	if ll_sw_pasa=0 then
		if is_pasa_descto = 'S' then
			if dw_gastos_be.rowcount()>0 then
				gd_total 							= round(dw_gastos_be.GetItemNumber(1 , "c_total"),0)
			end if
			if gd_total > 0 then
				if dw_datos_be.rowcount()>0 then
					gd_fecha_prox_pago		= date(dw_datos_be.getitemdatetime(1,'c_prox_pago'))
				else
					gd_fecha_prox_pago		= date('01/01/1900')
				end if
				gl_folio 							= Long(sle_numero_be.text)
				gd_total							= round(gd_total,0)
	//			ls_texto							= f_trans_numero_palabra(gd_total)
	//			messagebox("",ls_texto)
//				gl_valor_iva
//				gs_tipo_cobro_aux				= gs_tipo_cobro
				ll_fila_iva 						= dw_detalle_be.Find("tipo_cob = 'F' or tipo_cob = 'M' ", 1, dw_detalle_be.rowcount())
				ll_fila_ba_inmob				= dw_detalle_be.Find("tipo_cob = 'L' and ( tipo_cob_otro = '16' or  tipo_cob_otro = '19' or  tipo_cob_otro = '20' or  tipo_cob_otro = '346' or  tipo_cob_otro = '5' or   tipo_cob_otro = '63' )", 1, dw_detalle_be.rowcount())
				if ll_fila_iva > 0 then
					ll_fila_iva 					= dw_detalle_be.Find("tipo_cob = 'D'", 1, dw_detalle_be.rowcount())
					if ll_fila_iva > 0 then
						ll_monto_iva			= dw_detalle_be.getitemnumber(ll_fila_iva,'monto')
						gl_valor_iva				= gl_valor_iva + ll_monto_iva
						gs_tipo_cobro_aux		= 'BE'
					end if
					ll_fila_iva 					= dw_detalle_be.Find("tipo_cob = 'V'", 1, dw_detalle_be.rowcount())
					if ll_fila_iva > 0 then
						ll_monto_iva			= dw_detalle_be.getitemnumber(ll_fila_iva,'monto')
						gl_valor_iva				= gl_valor_iva + ll_monto_iva
						gs_tipo_cobro_aux		= 'BE'
					end if
					ll_fila_iva 					= dw_detalle_be.Find("tipo_cob = 'X'", 1, dw_detalle_be.rowcount())
					if ll_fila_iva > 0 then
						ll_monto_iva			= dw_detalle_be.getitemnumber(ll_fila_iva,'monto')
						gl_valor_iva				= gl_valor_iva + ll_monto_iva
						gs_tipo_cobro_aux		= 'BE'
					end if
				elseif gs_base = 'L' or gs_rezago='S' then
					ll_fila_iva 					= dw_detalle_be.Find("tipo_cob = 'D'", 1, dw_detalle_be.rowcount())
					if ll_fila_iva > 0 then
						ll_monto_iva			= dw_detalle_be.getitemnumber(ll_fila_iva,'monto')
						gl_valor_iva				= gl_valor_iva + ll_monto_iva
						gs_tipo_cobro_aux		= 'BE'
					end if
					ll_fila_iva 					= dw_detalle_be.Find("tipo_cob = 'V'", 1, dw_detalle_be.rowcount())
					if ll_fila_iva > 0 then
						ll_monto_iva			= dw_detalle_be.getitemnumber(ll_fila_iva,'monto')
						gl_valor_iva				= gl_valor_iva + ll_monto_iva
						gs_tipo_cobro_aux		= 'BE'
					end if
					ll_fila_iva 					= dw_detalle_be.Find("tipo_cob = 'X'", 1, dw_detalle_be.rowcount())
					if ll_fila_iva > 0 then
						ll_monto_iva			= dw_detalle_be.getitemnumber(ll_fila_iva,'monto')
						gl_valor_iva				= gl_valor_iva + ll_monto_iva
						gs_tipo_cobro_aux		= 'BE'
					end if
				elseif ll_fila_ba_inmob > 0 then
					gs_tipo_cobro_aux			= 'BE'
				end if
				ll_fila_iva 						= dw_detalle_be.Find("tipo_cob = 'F' or tipo_cob = 'M'", 1, dw_detalle_be.rowcount())
				ll_fila_iva_e 						= dw_detalle_be.Find("tipo_cob = 'E' ", 1, dw_detalle_be.rowcount())
				if gs_base='G' and gd_total = 1 and (gs_tipo_cobro<>'CI' and gs_tipo_cobro<>'BE') then 
					
				else
					if rb_be_exenta.checked = false and gd_total = 1 then 
						gs_tipo_cobro 				= 'BE' 
						rb_be_exenta.checked	= true
					elseif rb_be_exenta.checked = true and gd_total = 1 then 
						gs_tipo_cobro 				= 'BE' 
					end if
				end if
				ll_fila_mf		 						= dw_detalle_be.Find("tipo_cob = 'F' or tipo_cob = 'M' ", 1, dw_detalle_be.rowcount())
				if ll_fila_mf > 0 and gd_total > 1 and rb_be_exenta.checked=true then
					messagebox("Advertencia","No es Posible Generar Boleta EXENTA")
					ls_valida						= 'N'
				elseif gs_base='G' and gd_total = 1 and (gs_tipo_cobro<>'CI' and gs_tipo_cobro<>'BE' ) then 
					messagebox("Advertencia","Debe Generar Comprobante de Ingreso o Boleta EXENTA")
					ls_valida						= 'N'
				elseif gs_base = 'G' and ll_fila_22 > 0 and gs_tipo_cobro = 'FA' then
					messagebox("Advertencia","Debe Generar Comprobante de Ingreso")
					ls_valida						= 'N'
				elseif (ll_fila_iva > 0 and gs_tipo_cobro = 'BE' and tab_ingreso.tp_be.dw_gastos_be.getitemnumber(1,'c_total') <> 1) AND (gs_base='O' or gs_base='U' or gs_base='C' or gs_base='M' ) and (dw_gastos_be.getitemnumber(1,'mora_mant') > 0 or dw_gastos_be.getitemnumber(1,'gasto_mant') > 0)  then
					messagebox("Advertencia","Debe Generar Boleta AFECTA")
					ls_valida						= 'N'
					tab_ingreso.tp_be.rb_be_afecta.checked		= true
					tab_ingreso.tp_be.rb_be_afecta.triggerevent(clicked!)
				elseif (ll_fila_iva_e > 0 and gs_tipo_cobro = 'BE' and tab_ingreso.tp_be.dw_gastos_be.getitemnumber(1,'c_total') <> 1) AND (gs_base='L') and (dw_gastos_be.getitemnumber(1,'mora_cred') > 0 or dw_gastos_be.getitemnumber(1,'gasto_cred') > 0)  then
					messagebox("Advertencia","Debe Generar Boleta AFECTA")
					ls_valida						= 'N'
					tab_ingreso.tp_be.rb_be_afecta.checked		= true
					tab_ingreso.tp_be.rb_be_afecta.triggerevent(clicked!)
					
				elseif (gl_valor_iva = 0 and gs_tipo_cobro = 'BA') and ll_fila_iva > 0 then
					messagebox("Advertencia","Debe Generar Boleta EXENTA")
					ls_valida						= 'N'
					tab_ingreso.tp_be.rb_be_exenta.checked	= true
					tab_ingreso.tp_be.rb_be_exenta.triggerevent(clicked!)
				elseif (gl_valor_iva = 0 and gs_tipo_cobro = 'BA') and ll_fila_iva_e  > 0 and gs_base='L' then
					messagebox("Advertencia","Debe Generar Boleta EXENTA")
					ls_valida						= 'N'
					tab_ingreso.tp_be.rb_be_exenta.checked	= true
					tab_ingreso.tp_be.rb_be_exenta.triggerevent(clicked!)
				elseif (gs_tipo_cobro = 'BA' or gs_tipo_cobro = 'FA') and gd_total = 1 then
					messagebox("Advertencia","Debe Generar Boleta EXENTA")
					ls_valida						= 'N'
					tab_ingreso.tp_be.rb_be_exenta.checked	= true
					tab_ingreso.tp_be.rb_be_exenta.triggerevent(clicked!)
				else
					if gs_tipo_cobro = 'BA' and gs_base='G' then
						ll_fila_cred				= dw_detalle_be.Find("tipo_cob = 'E' or tipo_cob='A' ", 1, dw_detalle_be.rowcount())
						if ll_fila_cred > 0 then
							ll_fila_otros			= dw_detalle_be.find("tipo_cob='L' and (tipo_cob_otro <> '3' and tipo_cob_otro <> '76') ",1,dw_detalle_be.rowcount())
							if ll_fila_cred > 0 and ll_fila_otros > 0 then
								messagebox("Advertencia","Recuerde que debe Eliminar Pagos Adicionales y Generar Boleta de Servicio con estos Items")
								ls_valida						= 'N'
								dw_detalle_be.setfocus()
//								tab_ingreso.tp_be.rb_be_afecta.checked		= true
//								tab_ingreso.tp_be.rb_be_afecta.triggerevent(clicked!)
							end if
						end if
					end if
					if ls_valida='S' then
						ls_string_iva					= "tipo_cob='D' or tipo_cob='X' or tipo_cob='V' "
						ll_fila_iva_l					= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.find(ls_string_iva, 1, w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount())
						if ll_fila_iva_l > 0  then
							ls_string_otro			= "tipo_cob='L' and (tipo_cob_otro <> '3' and tipo_cob_otro <> '76') "
							ll_fila_otro				= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.find(ls_string_otro, 1, w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount())
							if ll_fila_otro > 0 then 
								messagebox("Advertencia","Debe Generar otra Boleta Afecta para Items Otros")
								ls_valida				= 'N'
							end if
						end if
					end if
				end if
				if ls_valida='S' then Open(w_forma_pago2)
			else
				messagebox("Advertencia","Monto NO debe ser Menor o Igual a CERO")
			end if
		end if	
	end if
else
	cb_be_insertar.setfocus()
end if
SetPointer ( Arrow! )
end event

type cbx_sin_gastos_be from checkbox within tp_be
event ue_mousemove pbm_mousemove
integer x = 1975
integer y = 1428
integer width = 768
integer height = 64
integer textsize = -8
integer weight = 400
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Verdana"
long backcolor = 79741120
boolean enabled = false
string text = "Sin Gastos de Cobranza."
boolean lefttext = true
end type

event ue_mousemove;st_31.visible							= false
st_help_insertar_be.visible		= false
st_help_eliminar_be.visible		= false
st_help_descuento_be.visible	= true
if is_opcion='FP' and (gs_depto='T' or gs_depto='I') then st_fuera_plazo.visible = true

end event

event clicked;Long		ll_monto,ll_folio,ll_count_ci,ll_count_abono,ll_tot_reg,ll_indi,ll_cantidad,ll_ctas,ll_ctas_pagadas,ll_fila_x,ll_monto_iva,ll_subtotal,&
			ll_ctas_pagadas_1,ll_ctas_pagadas_2,ll_monto_cred,ll_monto_mora_cred,ll_sum_monto_abono,ll_monto_cta,&
			ll_monto_final_cred,ll_res_abono,ll_monto_mant,ll_monto_mora_mant,ll_monto_final_mant,ll_count_e,&
			ll_count_f,ll_tot_filas,ll_fila,ll_linea 
Double	ld_monto_uf
String		ls_tipo_cob,ls_moneda,ls_pasa,ls_codigo_otro,ls_tipo_cob_det
Datetime	ldt_fecha_hoy

ls_tipo_cob				= gs_tipo_cobro
ll_folio					= Long(sle_numero_be.text)
ls_pasa					= 'N'
ldt_fecha_hoy			= datetime(date(gdt_fec_sistema),time('00:00:00'))
if cbx_sin_gastos_be.checked=true then
	dw_gastos_be.setitem(1,'gastos_cob',0)
	dw_gastos_be.setitem(1,'gasto_cred',0)
	dw_gastos_be.setitem(1,'gasto_mant',0)
	ll_tot_filas		= dw_detalle_be.RowCount()
	IF ll_tot_filas > 0 Then
		for ll_fila=1 to ll_tot_filas
			ls_codigo_otro		= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.getitemstring(ll_fila,'tipo_cob_otro')
			if ls_codigo_otro = '133' then
				ll_linea	 		= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob_otro ='"+ls_codigo_otro+"'",1, ll_tot_filas)
				dw_detalle_be.DeleteRow(ll_linea)
				w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.accepttext()
				ll_tot_filas				= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount()
				ll_fila						= ll_fila - 1
			elseif ls_codigo_otro = '118' then
				ll_linea	 		= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob_otro ='"+ls_codigo_otro+"'",1, ll_tot_filas)
				dw_detalle_be.DeleteRow(ll_linea)
				w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.accepttext()
				ll_tot_filas				= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount()
				ll_fila						= ll_fila - 1
			end if
		next
		ll_tot_filas				= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount()
		ll_fila_x					= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob='X' ",1,ll_tot_filas)
		if ll_fila_x > 0 then
			ll_monto_iva		= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.getitemnumber(ll_fila_x,'c_total_linea')
			ll_subtotal			= w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.getitemnumber(1,'subtotal')
			ll_subtotal			= ll_subtotal - ll_monto_iva
			w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.setitem(1,'subtotal',ll_subtotal)
			w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.DeleteRow(ll_fila_x)
			w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.accepttext()
		end if
	end if
else
	dw_gastos_be.setitem(1,'gastos_cob', dw_gastos_be.getitemnumber(1,'gasto_cred') + dw_gastos_be.getitemnumber(1,'gasto_mant'))
	dw_gastos_be.accepttext()
	dw_gastos_be.setitem(1,'gastos_cob', il_int_gc_cred + il_int_gc_mant)	//il_int_gc)
	dw_gastos_be.setitem(1,'gasto_cred',il_int_gc_cred)
	dw_gastos_be.setitem(1,'gasto_mant',il_int_gc_mant)
end if
if ll_folio > 0 then
	SELECT	Count("ABONO_CTA_CTE"."BASE")  
	INTO 		:ll_count_e  
	FROM 		"ABONO_CTA_CTE"  
	WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
			 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
			 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
			 ( "ABONO_CTA_CTE"."TIPO_COB_OCUPA" = :ls_tipo_cob ) AND  
			 ( "ABONO_CTA_CTE"."FOLIO_OCUPA" = :ll_folio ) AND  
			 ( "ABONO_CTA_CTE"."TIPO_MOV_OCUPA" = 'E' )   
	USING		sqlca;
	
	SELECT	Count("ABONO_CTA_CTE"."BASE")  
	INTO 		:ll_count_f  
	FROM 		"ABONO_CTA_CTE"  
	WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
			 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
			 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
			 ( "ABONO_CTA_CTE"."TIPO_COB_OCUPA" = :ls_tipo_cob ) AND  
			 ( "ABONO_CTA_CTE"."FOLIO_OCUPA" = :ll_folio ) AND  
			 ( "ABONO_CTA_CTE"."TIPO_MOV_OCUPA" = 'F' )   
	USING		sqlca;

	
	SELECT	Count("ABONO_CTA_CTE"."BASE")  
	INTO 		:ll_count_abono  
	FROM 		"ABONO_CTA_CTE"  
	WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
			 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
			 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
			 ( "ABONO_CTA_CTE"."TIPO_COB" = :ls_tipo_cob ) AND  
			 ( "ABONO_CTA_CTE"."FOLIO" = :ll_folio ) AND
			 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )  
	USING		sqlca;
	if ll_count_abono > 0 then
		DELETE FROM "ABONO_CTA_CTE"  
		WHERE		( "ABONO_CTA_CTE"."TIPO_COB" = :ls_tipo_cob ) AND  
					( "ABONO_CTA_CTE"."FOLIO" = :ll_folio ) AND  
					( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
					( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
					( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
					( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
		USING		sqlca;
		if sqlca.sqlcode = 0 then
			commit;
			ls_pasa			= 'S'
		else
			rollback;
			messagebox("Error Eliminar","Error ELIMINAR ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
		end if
	end if
	SELECT	Count("ABONO_CTA_CTE"."BASE")  
	INTO 		:ll_count_abono  
	FROM 		"ABONO_CTA_CTE"  
	WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
			 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
			 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
			 ( "ABONO_CTA_CTE"."TIPO_COB" = :ls_tipo_cob ) AND  
			 ( "ABONO_CTA_CTE"."FOLIO" = :ll_folio ) AND
			 ( "ABONO_CTA_CTE"."TIPO_COB_OCUPA" = :ls_tipo_cob ) AND  
			 ( "ABONO_CTA_CTE"."FOLIO_OCUPA" = :ll_folio ) AND 
			 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'O' )  
	USING		sqlca;
	if ll_count_abono > 0 then
		DELETE FROM "ABONO_CTA_CTE"  
		WHERE		( "ABONO_CTA_CTE"."TIPO_COB" = :ls_tipo_cob ) AND  
					( "ABONO_CTA_CTE"."FOLIO" = :ll_folio ) AND  
					( "ABONO_CTA_CTE"."TIPO_COB_OCUPA" = :ls_tipo_cob ) AND  
					( "ABONO_CTA_CTE"."FOLIO_OCUPA" = :ll_folio ) AND 
					( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
					( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
					( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
					( "ABONO_CTA_CTE"."ESTADO_REG" = 'O' )   
		USING		sqlca;
		if sqlca.sqlcode = 0 then
			commit;
			ls_pasa			= 'S'
		else
			rollback;
			messagebox("Error Eliminar","Error ELIMINAR ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
		end if
	end if
	SELECT	Count("ABONO_CTA_CTE"."BASE")  
	INTO 		:ll_count_abono  
	FROM 		"ABONO_CTA_CTE"  
	WHERE  ( "ABONO_CTA_CTE"."TIPO_COB_OCUPA" = :ls_tipo_cob ) AND  
			 ( "ABONO_CTA_CTE"."FOLIO_OCUPA" = :ll_folio ) AND  
			 ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
			 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
			 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
			 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'O' )
	USING		sqlca;
	if ll_count_abono > 0 then
		UPDATE	"ABONO_CTA_CTE"  
		SET 		"ESTADO_REG" = 'P',   
					"TIPO_COB_OCUPA" = Null,   
					"FOLIO_OCUPA" = Null,   
					"FECHA_OCUPA" = Null,   
					"MONTO_OCUPA" = Null,   
					"USUARIO_OCUPA" = Null,   
					"CAJA_OCUPA" = Null,   
					"TIPO_MOV_OCUPA" = Null  
		WHERE  ( "ABONO_CTA_CTE"."TIPO_COB_OCUPA" = :ls_tipo_cob ) AND  
				 ( "ABONO_CTA_CTE"."FOLIO_OCUPA" = :ll_folio ) AND  
				 ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
				 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
				 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
				 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'O' )
		USING		sqlca;
		if sqlca.sqlcode=0 then
			commit;
			ls_pasa			= 'S'
		else
			rollback;
			messagebox("Error Eliminar","Error UPDATE ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
		end if
	end if
	if ls_pasa = 'S' then
		ll_tot_reg		= dw_detalle_be.rowcount()
		for ll_indi=1 to ll_tot_reg
			ls_tipo_cob	= dw_detalle_be.getitemstring(ll_indi,'tipo_cob')
			ll_cantidad	= dw_detalle_be.getitemnumber(ll_indi,'cantidad')
			ll_monto		= dw_detalle_be.getitemnumber(ll_indi,'monto')
			ld_monto_uf	= dw_detalle_be.getitemnumber(ll_indi,'monto_uf')
			ls_moneda	= dw_detalle_be.getitemstring(ll_indi,'moneda')
			if ls_tipo_cob='E' and ll_count_e > 0 then
				if (gs_base='O' or gs_base='U' or gs_base='M') and dw_datos_be.DataObject='d_datos_cuenta_ci_oferta' then
					ll_ctas				= dw_datos_be.getitemnumber(1,'pago_oferta_nro_cuotas')
					ll_ctas_pagadas	= dw_datos_be.getitemnumber(1,'oferta_v_cta_pag_s')
				elseif gs_base='P' and dw_datos_be.DataObject='d_datos_cuenta_ci_pagare' then
					ll_ctas				= dw_datos_be.getitemnumber(1,'pagare_plazo')
					ll_ctas_pagadas_1	= dw_datos_be.getitemnumber(1,'pagare_cta_pag_la')
					ll_ctas_pagadas_2	= dw_datos_be.getitemnumber(1,'pagare_cta_pag_isa')
					ll_ctas_pagadas	= ll_ctas_pagadas_1 + ll_ctas_pagadas_2
				elseif gs_base='L' and dw_datos_be.DataObject='d_datos_cuenta_ci_liberador' then
					ll_ctas				= dw_datos_be.getitemnumber(1,'pago_liberador_nro_cuotas')
					ll_ctas_pagadas	= dw_datos_be.getitemnumber(1,'anexo_liberador_cta_pag_m')
				elseif gs_base='D' and dw_datos_be.DataObject='d_datos_cuenta_ci_derecho' then
					ll_ctas				= dw_datos_be.getitemnumber(1,'derecho_plazo')
					ll_ctas_pagadas_1	= dw_datos_be.getitemnumber(1,'derecho_cta_pag_la')
					ll_ctas_pagadas_2	= dw_datos_be.getitemnumber(1,'derecho_cta_pag_isa')
					ll_ctas_pagadas	= ll_ctas_pagadas_1 + ll_ctas_pagadas_2
				elseif gs_base='A' and dw_datos_be.DataObject='d_datos_cuenta_ci_aumento_capacidad' then
					ll_ctas				= dw_datos_be.getitemnumber(1,'pago_aumento_nro_cuotas')
					ll_ctas_pagadas	= dw_datos_be.getitemnumber(1,'anexo_aumento_cta_pag_m')
				elseif gs_base='R' and dw_datos_be.DataObject='dw_repacta_mant_descripcion_traspaso' then
					ll_ctas				= dw_datos_be.getitemnumber(1,'cuotas_pactadas')
					ll_ctas_pagadas	= dw_datos_be.getitemnumber(1,'ctas_pagadas')
				end if
				if gs_base<>'C' then
					
					ll_monto_cred					= round(dw_datos_be.GetItemNumber(1,"c_valor_cuota_pesos"),0)
					ll_monto_mora_cred			= wf_calcular_solo_mora(ll_indi)
					ll_monto_mora_cred			= ll_monto_mora_cred	+ wf_calcular_solo_gc(ll_indi)
					SELECT	SUM("ABONO_CTA_CTE"."MONTO")  
					INTO 		:ll_sum_monto_abono  
					FROM 		"ABONO_CTA_CTE"  
					WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
							 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
							 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero )  AND 
							 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
					USING		sqlca;
					if ll_sum_monto_abono > 0 then
						ll_monto_cta				= ll_monto_cred * dw_detalle_be.getitemnumber(ll_indi,'cantidad')
						if ll_sum_monto_abono >= (ll_monto_cta + ll_monto_mora_cred) then
							ll_monto_final_cred	= round(ll_sum_monto_abono - ( ll_monto_cta + ll_monto_mora_cred),0)
							ll_monto_final_cred ++
							UPDATE	"ABONO_CTA_CTE"  
							SET 		"TIPO_COB_OCUPA" = :gs_tipo_cobro,   
										"FOLIO_OCUPA" = :ll_folio,   
										"FECHA_OCUPA" = :ldt_fecha_hoy,   
										"MONTO_OCUPA" = (:ll_monto_cta + :ll_monto_mora_cred) - 1,   
										"USUARIO_OCUPA" = :gs_user,   
										"CAJA_OCUPA" = :gs_caja,   
										"ESTADO_REG" = 'O',
										"TIPO_MOV_OCUPA" = :ls_tipo_cob  
							WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
									 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
									 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
									 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
							USING		sqlca;
							if sqlca.sqlcode=0 then
								commit;
								gdt_fec_sistema	= datetime(date(gdt_fec_sistema), RelativeTime(Now(), 5))
								INSERT INTO "ABONO_CTA_CTE"  
											( "RUT",		"BASE",		"SERIE",		"NUMERO",	"TIPO_COB",		"FOLIO",	"MONTO",				"FECHA_CREA",		"USUARIO_CREA",	"CAJA_CREA",	"ESTADO_REG",	"TIPO_COB_OCUPA",	"FOLIO_OCUPA",	"FECHA_OCUPA",	"MONTO_OCUPA",	"USUARIO_OCUPA",	"CAJA_OCUPA",	"TIPO_MOV_OCUPA" )
								VALUES 	( :gi_rut,	:gs_base,	:gs_serie,	:gi_numero,		:gs_tipo_cobro,		:ll_folio,	:ll_monto_final_cred,	:gdt_fec_sistema,	:gs_user,			:gs_caja,		'P',				null,					null,				null,				null,				null,					null,				null )  
								USING		sqlca;
								if sqlca.sqlcode=0 then
									commit;
								else
									rollback;
									messagebox("Error Grabar","Error al INSERTAR ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
								end if
							else
								rollback;
								messagebox("Error Grabar","Error al UPDATE ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
							end if
						else
							UPDATE	"ABONO_CTA_CTE"  
							SET 		"TIPO_COB_OCUPA" = :gs_tipo_cobro,   
										"FOLIO_OCUPA" = :ll_folio,   
										"FECHA_OCUPA" = :ldt_fecha_hoy,   
										"MONTO_OCUPA" = :ll_sum_monto_abono,   
										"USUARIO_OCUPA" = :gs_user,   
										"CAJA_OCUPA" = :gs_caja,   
										"ESTADO_REG" = 'O',
										"TIPO_MOV_OCUPA" = :ls_tipo_cob
							WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
									 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
									 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
									 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
							USING		sqlca;
							if sqlca.sqlcode=0 then
								commit;
							else
								rollback;
								messagebox("Error Grabar","Error al Update ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
							end if
						end if
					else
						ll_monto_final_cred				= ll_monto_cred
					end if
					
				
				end if
				
			elseif ls_tipo_cob='F' and ll_count_f > 0 then
				ll_monto_mant					= round(dw_datos_be.GetItemNumber(1,"c_valor_cuota_mantencion_pesos"),0)
				ll_monto_cta					= ll_monto_mant * dw_detalle_be.getitemnumber(ll_indi,'cantidad')
				SELECT	SUM("ABONO_CTA_CTE"."MONTO")  
				INTO 		:ll_sum_monto_abono  
				FROM 		"ABONO_CTA_CTE"  
				WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
						 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
						 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND
						 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )
				USING		sqlca;
				if ll_sum_monto_abono > 0 then
					ll_monto_mant				= ll_monto_mant - dw_detalle_be.getitemnumber(ll_indi,'cantidad')
					ll_monto_mora_mant		= wf_calcular_solo_mora_mant(ll_indi)
					ll_monto_mora_mant		= ll_monto_mora_mant + wf_calcular_solo_gc_mant(ll_indi)
					if ll_sum_monto_abono >= (ll_monto_cta + ll_monto_mora_mant)  then
						ll_monto_final_mant	= round(ll_sum_monto_abono - ( ll_monto_cta + ll_monto_mora_mant ) ,0)
						ll_monto_final_mant ++
						UPDATE	"ABONO_CTA_CTE"  
						SET 		"TIPO_COB_OCUPA" = :gs_tipo_cobro,   
									"FOLIO_OCUPA" = :ll_folio,   
									"FECHA_OCUPA" = :ldt_fecha_hoy,   
									"MONTO_OCUPA" = (:ll_monto_cta + :ll_monto_mora_mant) - 1,   
									"USUARIO_OCUPA" = :gs_user,   
									"CAJA_OCUPA" = :gs_caja,   
									"ESTADO_REG" = 'O',
									"TIPO_MOV_OCUPA" = :ls_tipo_cob
						WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
								 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
								 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
								 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
						USING		sqlca;
						if sqlca.sqlcode=0 then
							commit;
							gdt_fec_sistema	= datetime(date(gdt_fec_sistema), RelativeTime(Now(), 10))
							INSERT INTO "ABONO_CTA_CTE"  
										( "RUT",		"BASE",		"SERIE",		"NUMERO",	"TIPO_COB",	"FOLIO",		"MONTO",						"FECHA_CREA",		"USUARIO_CREA",	"CAJA_CREA",	"ESTADO_REG",	"TIPO_COB_OCUPA",	"FOLIO_OCUPA",	"FECHA_OCUPA",	"MONTO_OCUPA",	"USUARIO_OCUPA",	"CAJA_OCUPA",	"TIPO_MOV_OCUPA" )
							VALUES 	( :gi_rut,	:gs_base,	:gs_serie,	:gi_numero,	:gs_tipo_cobro,			:ll_folio,	:ll_monto_final_mant,	:gdt_fec_sistema,	:gs_user,			:gs_caja,		'P',				null,					null,				null,				null,				null,					null,				null )  
							USING		sqlca;
							if sqlca.sqlcode=0 then
								commit;
							else
								rollback;
								messagebox("Error Grabar","Error al INSERTAR ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
							end if
						else
							rollback;
							messagebox("Error Grabar","Error al UPDATE ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
						end if
					else
						UPDATE	"ABONO_CTA_CTE"  
						SET 		"TIPO_COB_OCUPA" = :gs_tipo_cobro,   
									"FOLIO_OCUPA" = :ll_folio,   
									"FECHA_OCUPA" = :ldt_fecha_hoy,   
									"MONTO_OCUPA" = :ll_sum_monto_abono,   
									"USUARIO_OCUPA" = :gs_user,   
									"CAJA_OCUPA" = :gs_caja,   
									"ESTADO_REG" = 'O',
									"TIPO_MOV_OCUPA" = :ls_tipo_cob
						WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
								 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
								 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
								 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
						USING		sqlca;
						if sqlca.sqlcode=0 then
							commit;
						else
							rollback;
							messagebox("Error Grabar","Error al Update ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
						end if
					end if
				end if
			end if
		next
	end if
end if
end event

type cbx_sin_mora_be from checkbox within tp_be
event ue_mousemove pbm_mousemove
integer x = 1975
integer y = 1328
integer width = 768
integer height = 64
integer textsize = -8
integer weight = 400
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Verdana"
long backcolor = 79741120
boolean enabled = false
string text = "Sin Mora."
boolean lefttext = true
end type

event ue_mousemove;st_31.visible							= false
st_help_insertar_be.visible		= false
st_help_eliminar_be.visible		= false
st_help_descuento_be.visible	= true
if is_opcion='FP' and (gs_depto='T' or gs_depto='I') then st_fuera_plazo.visible = true
end event

event clicked;Long		ll_monto,ll_folio,ll_count_ci,ll_count_abono,ll_tot_reg,ll_indi,ll_cantidad,ll_ctas,ll_ctas_pagadas,ll_fila_v,ll_monto_iva,ll_subtotal,&
			ll_ctas_pagadas_1,ll_ctas_pagadas_2,ll_monto_cred,ll_monto_mora_cred,ll_sum_monto_abono,ll_monto_cta,&
			ll_monto_final_cred,ll_res_abono,ll_monto_mant,ll_monto_mora_mant,ll_monto_final_mant,ll_count_e,ll_count_f,ll_tot_filas,ll_fila,ll_linea
Double	ld_monto_uf
String		ls_tipo_cob,ls_moneda,ls_pasa,ls_codigo_otro,ls_tipo_cob_det
Datetime	ldt_fecha_hoy

ls_tipo_cob				= gs_tipo_cobro
ll_folio					= Long(sle_numero_be.text)
ls_pasa					= 'N'
SELECT sysdate INTO :gdt_fec_sistema FROM "TASA" WHERE "TASA"."LOOK" = 1 ;
ldt_fecha_hoy			= datetime(date(gdt_fec_sistema),time('00:00:00'))
if cbx_sin_mora_be.checked=true then
	dw_gastos_be.setitem(1,'mora',0)
	dw_gastos_be.SetItem(1,"mora_cred", 0)
	dw_gastos_be.SetItem(1,"mora_mant", 0)
	ll_tot_filas		=  w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.RowCount()
	IF ll_tot_filas > 0 Then
		for ll_fila = 1 to ll_tot_filas
			ls_codigo_otro		= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.getitemstring(ll_fila,'tipo_cob_otro')
			if ls_codigo_otro = '130' then
				ll_linea	 		= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob_otro ='"+ls_codigo_otro+"'",1, ll_tot_filas)
				w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.DeleteRow(ll_linea)
				w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.accepttext()
				ll_tot_filas				= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount()
				ll_fila						= ll_fila - 1
			elseif ls_codigo_otro = '102' then
			//	ll_linea			= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.Find('tipo_cob_otro= "102" ',ll_fila,ll_tot_filas)
				ll_linea	 		= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob_otro ='"+ls_codigo_otro+"'",1, ll_tot_filas)
				w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.DeleteRow(ll_linea)
				w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.accepttext()
				ll_tot_filas		= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount()
				ll_fila				= ll_fila - 1
			end if
		next
		
		ll_tot_filas				= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.rowcount()
		ll_fila_v					= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.Find("tipo_cob='V' ",1,ll_tot_filas)
		if ll_fila_v > 0 then
			ll_monto_iva		= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.getitemnumber(ll_fila_v,'c_total_linea')
			ll_subtotal			= w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.getitemnumber(1,'subtotal')
			ll_subtotal			= ll_subtotal - ll_monto_iva
			w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.setitem(1,'subtotal',ll_subtotal)
			w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.DeleteRow(ll_fila_v)
			w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.accepttext()
		end if
	end if	
else
	dw_gastos_be.setitem(1,'mora', dw_gastos_be.getitemnumber(1,'mora_cred') + dw_gastos_be.getitemnumber(1,'mora_mant'))
	dw_gastos_be.accepttext()
	dw_gastos_be.setitem(1,'mora',il_int_mora)
	dw_gastos_be.setitem(1,'mora_cred',il_int_mora_cred)
	dw_gastos_be.setitem(1,'mora_mant',il_int_mora_mant)
end if
if ll_folio > 0 then
	SELECT	Count("ABONO_CTA_CTE"."BASE")  
	INTO 		:ll_count_e  
	FROM 		"ABONO_CTA_CTE"  
	WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
			 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
			 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
			 ( "ABONO_CTA_CTE"."TIPO_COB_OCUPA" = :ls_tipo_cob ) AND  
			 ( "ABONO_CTA_CTE"."FOLIO_OCUPA" = :ll_folio ) AND  
			 ( "ABONO_CTA_CTE"."TIPO_MOV_OCUPA" = 'E' )   
	USING		sqlca;
	
	SELECT	Count("ABONO_CTA_CTE"."BASE")  
	INTO 		:ll_count_f  
	FROM 		"ABONO_CTA_CTE"  
	WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
			 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
			 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
			 ( "ABONO_CTA_CTE"."TIPO_COB_OCUPA" = :ls_tipo_cob ) AND  
			 ( "ABONO_CTA_CTE"."FOLIO_OCUPA" = :ll_folio ) AND  
			 ( "ABONO_CTA_CTE"."TIPO_MOV_OCUPA" = 'F' )   
	USING		sqlca;

	
	SELECT	Count("ABONO_CTA_CTE"."BASE")  
	INTO 		:ll_count_abono  
	FROM 		"ABONO_CTA_CTE"  
	WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
			 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
			 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
			 ( "ABONO_CTA_CTE"."TIPO_COB" = :ls_tipo_cob ) AND  
			 ( "ABONO_CTA_CTE"."FOLIO" = :ll_folio ) AND
			 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )  
	USING		sqlca;
	if ll_count_abono > 0 then
		DELETE FROM "ABONO_CTA_CTE"  
		WHERE		( "ABONO_CTA_CTE"."TIPO_COB" = :ls_tipo_cob ) AND  
					( "ABONO_CTA_CTE"."FOLIO" = :ll_folio ) AND  
					( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
					( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
					( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
					( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
		USING		sqlca;
		if sqlca.sqlcode = 0 then
			commit;
			ls_pasa			= 'S'
		else
			rollback;
			messagebox("Error Eliminar","Error ELIMINAR ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
		end if
	end if
	SELECT	Count("ABONO_CTA_CTE"."BASE")  
	INTO 		:ll_count_abono  
	FROM 		"ABONO_CTA_CTE"  
	WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
			 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
			 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
			 ( "ABONO_CTA_CTE"."TIPO_COB" = :ls_tipo_cob ) AND  
			 ( "ABONO_CTA_CTE"."FOLIO" = :ll_folio ) AND
			 ( "ABONO_CTA_CTE"."TIPO_COB_OCUPA" = :ls_tipo_cob ) AND  
			 ( "ABONO_CTA_CTE"."FOLIO_OCUPA" = :ll_folio ) AND 
			 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'O' )  
	USING		sqlca;
	if ll_count_abono > 0 then
		DELETE FROM "ABONO_CTA_CTE"  
		WHERE		( "ABONO_CTA_CTE"."TIPO_COB" = :ls_tipo_cob ) AND  
					( "ABONO_CTA_CTE"."FOLIO" = :ll_folio ) AND  
					( "ABONO_CTA_CTE"."TIPO_COB_OCUPA" = :ls_tipo_cob ) AND  
					( "ABONO_CTA_CTE"."FOLIO_OCUPA" = :ll_folio ) AND 
					( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
					( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
					( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
					( "ABONO_CTA_CTE"."ESTADO_REG" = 'O' )   
		USING		sqlca;
		if sqlca.sqlcode = 0 then
			commit;
			ls_pasa			= 'S'
		else
			rollback;
			messagebox("Error Eliminar","Error ELIMINAR ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
		end if
	end if
	SELECT	Count("ABONO_CTA_CTE"."BASE")  
	INTO 		:ll_count_abono  
	FROM 		"ABONO_CTA_CTE"  
	WHERE  ( "ABONO_CTA_CTE"."TIPO_COB_OCUPA" = :ls_tipo_cob ) AND  
			 ( "ABONO_CTA_CTE"."FOLIO_OCUPA" = :ll_folio ) AND  
			 ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
			 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
			 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
			 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'O' )
	USING		sqlca;
	if ll_count_abono > 0 then
		UPDATE	"ABONO_CTA_CTE"  
		SET 		"ESTADO_REG" = 'P',   
					"TIPO_COB_OCUPA" = Null,   
					"FOLIO_OCUPA" = Null,   
					"FECHA_OCUPA" = Null,   
					"MONTO_OCUPA" = Null,   
					"USUARIO_OCUPA" = Null,   
					"CAJA_OCUPA" = Null,   
					"TIPO_MOV_OCUPA" = Null  
		WHERE  ( "ABONO_CTA_CTE"."TIPO_COB_OCUPA" = :ls_tipo_cob ) AND  
				 ( "ABONO_CTA_CTE"."FOLIO_OCUPA" = :ll_folio ) AND  
				 ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
				 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
				 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
				 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'O' )
		USING		sqlca;
		if sqlca.sqlcode=0 then
			commit;
			ls_pasa			= 'S'
		else
			rollback;
			messagebox("Error Eliminar","Error UPDATE ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
		end if
	end if
	if ls_pasa = 'S' then
		ll_tot_reg		= dw_detalle_be.rowcount()
		for ll_indi=1 to ll_tot_reg
			ls_tipo_cob	= dw_detalle_be.getitemstring(ll_indi,'tipo_cob')
			ll_cantidad	= dw_detalle_be.getitemnumber(ll_indi,'cantidad')
			ll_monto		= dw_detalle_be.getitemnumber(ll_indi,'monto')
			ld_monto_uf	= dw_detalle_be.getitemnumber(ll_indi,'monto_uf')
			ls_moneda	= dw_detalle_be.getitemstring(ll_indi,'moneda')
			if ls_tipo_cob='E' and ll_count_e > 0 then
				if (gs_base='O' or gs_base='U' or gs_base='M') and dw_datos_be.DataObject='d_datos_cuenta_ci_oferta' then
					ll_ctas				= dw_datos_be.getitemnumber(1,'pago_oferta_nro_cuotas')
					ll_ctas_pagadas	= dw_datos_be.getitemnumber(1,'oferta_v_cta_pag_s')
				elseif gs_base='P' and dw_datos_be.DataObject='d_datos_cuenta_ci_pagare' then
					ll_ctas				= dw_datos_be.getitemnumber(1,'pagare_plazo')
					ll_ctas_pagadas_1	= dw_datos_be.getitemnumber(1,'pagare_cta_pag_la')
					ll_ctas_pagadas_2	= dw_datos_be.getitemnumber(1,'pagare_cta_pag_isa')
					ll_ctas_pagadas	= ll_ctas_pagadas_1 + ll_ctas_pagadas_2
				elseif gs_base='L' and dw_datos_be.DataObject='d_datos_cuenta_ci_liberador' then
					ll_ctas				= dw_datos_be.getitemnumber(1,'pago_liberador_nro_cuotas')
					ll_ctas_pagadas	= dw_datos_be.getitemnumber(1,'anexo_liberador_cta_pag_m')
				elseif gs_base='D' and dw_datos_be.DataObject='d_datos_cuenta_ci_derecho' then
					ll_ctas				= dw_datos_be.getitemnumber(1,'derecho_plazo')
					ll_ctas_pagadas_1	= dw_datos_be.getitemnumber(1,'derecho_cta_pag_la')
					ll_ctas_pagadas_2	= dw_datos_be.getitemnumber(1,'derecho_cta_pag_isa')
					ll_ctas_pagadas	= ll_ctas_pagadas_1 + ll_ctas_pagadas_2
				elseif gs_base='A' and dw_datos_be.DataObject='d_datos_cuenta_ci_aumento_capacidad' then
					ll_ctas				= dw_datos_be.getitemnumber(1,'pago_aumento_nro_cuotas')
					ll_ctas_pagadas	= dw_datos_be.getitemnumber(1,'anexo_aumento_cta_pag_m')
				elseif gs_base='R' and dw_datos_be.DataObject='dw_repacta_mant_descripcion_traspaso' then
					ll_ctas				= dw_datos_be.getitemnumber(1,'cuotas_pactadas')
					ll_ctas_pagadas	= dw_datos_be.getitemnumber(1,'ctas_pagadas')
				end if
				if gs_base<>'C' then
					
					ll_monto_cred					= round(dw_datos_be.GetItemNumber(1,"c_valor_cuota_pesos"),0)
					ll_monto_mora_cred			= wf_calcular_solo_mora(ll_indi)
					ll_monto_mora_cred			= ll_monto_mora_cred	+ wf_calcular_solo_gc(ll_indi)
					SELECT	SUM("ABONO_CTA_CTE"."MONTO")  
					INTO 		:ll_sum_monto_abono  
					FROM 		"ABONO_CTA_CTE"  
					WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
							 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
							 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero )  AND 
							 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
					USING		sqlca;
					if ll_sum_monto_abono > 0 then
						ll_monto_cta				= ll_monto_cred * dw_detalle_be.getitemnumber(ll_indi,'cantidad')
						if ll_sum_monto_abono >= (ll_monto_cta + ll_monto_mora_cred) then
							ll_monto_final_cred	= round(ll_sum_monto_abono - ( ll_monto_cta + ll_monto_mora_cred),0)
							ll_monto_final_cred ++
							UPDATE	"ABONO_CTA_CTE"  
							SET 		"TIPO_COB_OCUPA" = :gs_tipo_cobro,   
										"FOLIO_OCUPA" = :ll_folio,   
										"FECHA_OCUPA" = :ldt_fecha_hoy,   
										"MONTO_OCUPA" = (:ll_monto_cta + :ll_monto_mora_cred) - 1,   
										"USUARIO_OCUPA" = :gs_user,   
										"CAJA_OCUPA" = :gs_caja,   
										"ESTADO_REG" = 'O',
										"TIPO_MOV_OCUPA" = :ls_tipo_cob  
							WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
									 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
									 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
									 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
							USING		sqlca;
							if sqlca.sqlcode=0 then
								commit;
								gdt_fec_sistema	= datetime(date(gdt_fec_sistema), RelativeTime(Now(), 5))
								INSERT INTO "ABONO_CTA_CTE"  
											( "RUT",		"BASE",		"SERIE",		"NUMERO",	"TIPO_COB",		"FOLIO",		"MONTO",						"FECHA_CREA",		"USUARIO_CREA",	"CAJA_CREA",	"ESTADO_REG",	"TIPO_COB_OCUPA",	"FOLIO_OCUPA",	"FECHA_OCUPA",	"MONTO_OCUPA",	"USUARIO_OCUPA",	"CAJA_OCUPA",	"TIPO_MOV_OCUPA" )
								VALUES 	( :gi_rut,	:gs_base,	:gs_serie,	:gi_numero,		:gs_tipo_cobro,		:ll_folio,	:ll_monto_final_cred,	:gdt_fec_sistema,	:gs_user,			:gs_caja,		'P',				null,					null,				null,				null,				null,					null,				null )  
								USING		sqlca;
								if sqlca.sqlcode=0 then
									commit;
								else
									rollback;
									messagebox("Error Grabar","Error al INSERTAR ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
								end if
							else
								rollback;
								messagebox("Error Grabar","Error al UPDATE ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
							end if
						else
							UPDATE	"ABONO_CTA_CTE"  
							SET 		"TIPO_COB_OCUPA" = :gs_tipo_cobro,   
										"FOLIO_OCUPA" = :ll_folio,   
										"FECHA_OCUPA" = :ldt_fecha_hoy,   
										"MONTO_OCUPA" = :ll_sum_monto_abono,   
										"USUARIO_OCUPA" = :gs_user,   
										"CAJA_OCUPA" = :gs_caja,   
										"ESTADO_REG" = 'O',
										"TIPO_MOV_OCUPA" = :ls_tipo_cob
							WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
									 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
									 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
									 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
							USING		sqlca;
							if sqlca.sqlcode=0 then
								commit;
							else
								rollback;
								messagebox("Error Grabar","Error al Update ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
							end if
						end if
					else
						ll_monto_final_cred				= ll_monto_cred
					end if
					
				
				end if
				
			elseif ls_tipo_cob='F' and ll_count_f > 0 then
				ll_monto_mant					= round(dw_datos_be.GetItemNumber(1,"c_valor_cuota_mantencion_pesos"),0)
				ll_monto_cta					= ll_monto_mant * dw_detalle_be.getitemnumber(ll_indi,'cantidad')
				SELECT	SUM("ABONO_CTA_CTE"."MONTO")  
				INTO 		:ll_sum_monto_abono  
				FROM 		"ABONO_CTA_CTE"  
				WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
						 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
						 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND
						 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )
				USING		sqlca;
				if ll_sum_monto_abono > 0 then
					ll_monto_mant				= ll_monto_mant - dw_detalle_be.getitemnumber(ll_indi,'cantidad')
					ll_monto_mora_mant		= wf_calcular_solo_mora_mant(ll_indi)
					ll_monto_mora_mant		= ll_monto_mora_mant + wf_calcular_solo_gc_mant(ll_indi)
					if ll_sum_monto_abono >= (ll_monto_cta + ll_monto_mora_mant)  then
						ll_monto_final_mant	= round(ll_sum_monto_abono - ( ll_monto_cta + ll_monto_mora_mant ) ,0)
						ll_monto_final_mant ++
						UPDATE	"ABONO_CTA_CTE"  
						SET 		"TIPO_COB_OCUPA" = :gs_tipo_cobro,   
									"FOLIO_OCUPA" = :ll_folio,   
									"FECHA_OCUPA" = :ldt_fecha_hoy,   
									"MONTO_OCUPA" = (:ll_monto_cta + :ll_monto_mora_mant) - 1,   
									"USUARIO_OCUPA" = :gs_user,   
									"CAJA_OCUPA" = :gs_caja,   
									"ESTADO_REG" = 'O',
									"TIPO_MOV_OCUPA" = :ls_tipo_cob
						WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
								 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
								 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
								 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
						USING		sqlca;
						if sqlca.sqlcode=0 then
							commit;
							gdt_fec_sistema	= datetime(date(gdt_fec_sistema), RelativeTime(Now(), 10))
							INSERT INTO "ABONO_CTA_CTE"  
										( "RUT",		"BASE",		"SERIE",		"NUMERO",	"TIPO_COB",	"FOLIO",		"MONTO",						"FECHA_CREA",		"USUARIO_CREA",	"CAJA_CREA",	"ESTADO_REG",	"TIPO_COB_OCUPA",	"FOLIO_OCUPA",	"FECHA_OCUPA",	"MONTO_OCUPA",	"USUARIO_OCUPA",	"CAJA_OCUPA",	"TIPO_MOV_OCUPA" )
							VALUES 	( :gi_rut,	:gs_base,	:gs_serie,	:gi_numero,		:gs_tipo_cobro,			:ll_folio,	:ll_monto_final_mant,	:gdt_fec_sistema,	:gs_user,			:gs_caja,		'P',				null,					null,				null,				null,				null,					null,				null )  
							USING		sqlca;
							if sqlca.sqlcode=0 then
								commit;
							else
								rollback;
								messagebox("Error Grabar","Error al INSERTAR ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
							end if
						else
							rollback;
							messagebox("Error Grabar","Error al UPDATE ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
						end if
					else
						UPDATE	"ABONO_CTA_CTE"  
						SET 		"TIPO_COB_OCUPA" = :gs_tipo_cobro,   
									"FOLIO_OCUPA" = :ll_folio,   
									"FECHA_OCUPA" = :ldt_fecha_hoy,   
									"MONTO_OCUPA" = :ll_sum_monto_abono,   
									"USUARIO_OCUPA" = :gs_user,   
									"CAJA_OCUPA" = :gs_caja,   
									"ESTADO_REG" = 'O',
									"TIPO_MOV_OCUPA" = :ls_tipo_cob
						WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
								 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
								 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
								 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
						USING		sqlca;
						if sqlca.sqlcode=0 then
							commit;
						else
							rollback;
							messagebox("Error Grabar","Error al Update ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
						end if
					end if
				end if
			end if
		next
	end if
end if
end event

type dw_detalle_be from datawindow within tp_be
event ue_mousemove pbm_mousemove
integer x = 1902
integer y = 364
integer width = 1687
integer height = 724
integer taborder = 90
string dataobject = "de_detalle_ci_3"
boolean hscrollbar = true
boolean vscrollbar = true
borderstyle borderstyle = stylelowered!
end type

event ue_mousemove;Long		ll_tot_reg,ll_monto,ll_fila
String		ls_string

wf_no_mostrar_help_be()
if is_opcion='FP' and (gs_depto='T' or gs_depto='I') then st_fuera_plazo.visible = true

end event

event itemchanged;string		is_columna,ls_tipo_cob,ls_moneda,ls_tipo_cob_aux,ls_estado_cadena,ls_descrip_estado,ls_tipo_comp,ls_texto,ls_nulo,ls_pasa,ls_string,&
			ls_moneda_ctto,ls_pasa_valida,ls_cod_dscto,ls_moneda_insert,sw_ok,ls_otro_dscto,ls_tipo_cob_dscto,ls_moneda_prod,ls_codigo_dscto,&
			ls_tipo_l,ls_codigo_otro_cur,ls_tipo_s,ls_cod_dscto_comer,ls_tipo_cob_serv,ls_tipo_servicio,ls_monda_det
long 		il_monto,fila,ii_dmora, ii_mora_cobro,ii_inc_gastos, ii_cantidad, ll_fila,ll_factor_peso,ll_count_e,ll_fila_reg,ll_monto,ll_cuota_ini,ll_cuota_fin,&
			ll_ctas,ll_count_reg,ll_folio,ll_ctas_pagadas_1,ll_ctas_pagadas_2,ll_ctas_pagadas,ll_cod_seguro,ll_ctas_pag_m,ll_fila_iva,ll_iva_recalc,&
			ll_tot_reg,ll_indi,ll_res,ll_sum_monto_abono,ll_monto_mant,ll_monto_final_mant,ll_count_tipo,ll_cant_e,ll_new_iva,ll_fila_dscto,ll_monto_final,&
			ll_monto_cred,ll_monto_final_cred,ll_res_abono,ll_monto_mora_cred,ll_monto_mora_mant,ll_new_seg,ll_fila_gasto,ll_resp_m,ll_resp_f,&
			ll_fila_cred,ll_fila_mant,ll_count_adic,ll_fila_pie,ll_row,ll_gasto_cob,ll_mora,ll_incluir_gastos,ll_cod_parque,ll_count_benef,ll_tot_reg_benef,ll_fila_benef,&
			ll_ctas_pac_pie,ll_ctas_pag_pie,ll_fila_m,ll_fila_d,ll_new_m,ll_count_f,ll_crear,ll_fila_fm,ll_fila_iva_a,ll_nulo,ll_cuotas_con_iva,ll_count_pie_pac,ll_fila_a,&
			ll_codigo_servicio,ll_plazo,ll_cod_servicio, ll_plazo_serv,ll_count_crem,ll_contar,ll_sum_reg,ll_sw_pago_reg,ll_fila_invalid,ll_count_hijo,ll_cantidad
double 	id_im, id_gc, id_valor_cuota,ld_monto,ld_pie_pactado,ll_monto_cta,ldb_prima,ldb_uf,ll_monto_pie_ingreso,ldb_valor_pie_reg,ll_monto_pago,ll_mora_cred,&
			ll_mora_mant,ll_gastos_cred,ll_gastos_mant,ll_suma_total,ldb_iva,ll_monto_cuota_reg,ll_iva_f,ll_iva_p,ll_gasto_mant,ll_iva_r,ll_monto_pie_rez,ll_iva_pie_rez,&
			ll_valor_cuota_f,ldb_valor_def_pie,ldb_valor_def_reg,ldb_pie_pesos,ldb_monto_dscto,ll_valor_serv,ll_valor_dscto_comer,ll_monto_det,ldb_valor_sumado,&
			ldb_valor_cuota,ldb_valor_seg,ldb_val_cta_ctto,ldb_valor_cuota_peso
Datetime	ldt_fecha_hoy
//


//string		ls_moneda,ls_tipo_cob_aux,ls_descrip_estado,ls_pasa,ls_string,&
//			ls_moneda_ctto,ls_pasa_valida,ls_cod_dscto,s_otro_dscto,ls_tipo_cob_dscto,ls_moneda_prod,ls_codigo_dscto,&
//			ls_tipo_l,ls_codigo_otro_cur,ls_tipo_s,ls_cod_dscto_comer,ls_tipo_cob_serv,ls_tipo_servicio,ls_monda_det
//			//ls_tipo_comp,ls_nulo,is_columna,sw_ok,ls_tipo_cob,ls_texto,ls_moneda_insert,ls_estado_cadena,
//long 		il_monto,ii_dmora, ii_mora_cobro,  ll_fila,ll_factor_peso,ll_monto,&
//			ll_ctas,ll_ctas_pagadas_1,ll_ctas_pagadas_2,ll_ctas_pagadas,ll_cod_seguro,ll_fila_iva,ll_iva_recalc,&
//			ll_indi,ll_res,ll_sum_monto_abono,ll_monto_mant,ll_monto_final_mant,ll_count_tipo,ll_cant_e,ll_fila_dscto,ll_monto_final,&
//			ll_monto_cred,ll_monto_final_cred,ll_res_abono,ll_monto_mora_cred,ll_monto_mora_mant,ll_new_seg,ll_fila_gasto,ll_resp_m,ll_resp_f,&
//			ll_fila_mant,ll_count_adic,ll_fila_pie,ll_row,ll_gasto_cob,ll_mora,ll_incluir_gastos,ll_cod_parque,ll_count_benef,ll_tot_reg_benef,ll_fila_benef,&
//			ll_ctas_pac_pie,ll_ctas_pag_pie,ll_fila_m,ll_fila_d,ll_new_m,ll_count_f,ll_crear,ll_fila_fm,ll_fila_iva_a,ll_nulo,ll_cuotas_con_iva,ll_count_pie_pac,ll_fila_a,&
//			ll_codigo_servicio,ll_plazo,ll_cod_servicio, ll_plazo_serv,ll_count_crem,ll_contar,ll_sum_reg,ll_sw_pago_reg,ll_fila_invalid,ll_count_hijo
//			//,ll_ctas_pag_m, ii_inc_gastos,ll_folio,ll_tot_reg,ll_count_reg,ll_fila_reg,ll_count_e,ll_fila_cred,ii_cantidad,ll_cuota_ini,ll_cuota_fin,ll_new_iva,fila,
//			
//double 	id_im, id_gc, id_valor_cuota,ld_monto,ld_pie_pactado,ll_monto_cta,ldb_prima,ldb_uf,ll_monto_pie_ingreso,ldb_valor_pie_reg,ll_monto_pago,ll_mora_cred,&
//			ll_gastos_cred,ll_gastos_mant,ll_suma_total,ll_monto_pie_rez,ll_iva_pie_rez,&
//			ll_valor_cuota_f,ldb_valor_def_pie,ldb_valor_def_reg,ldb_pie_pesos,ldb_monto_dscto,ll_valor_serv,ll_valor_dscto_comer,ll_monto_det,ldb_valor_sumado,&
//			ldb_valor_cuota,ldb_valor_seg,ldb_val_cta_ctto,ldb_valor_cuota_peso
//			//ll_monto_cuota_reg,ldb_iva,ll_iva_f,ll_mora_mant,ll_iva_p,ll_gasto_mant,ll_iva_r,
//double    ld_monto_descuento			
////Datetime	ldt_fecha_hoy

// vhfb
long ld_monto_descuento

this.accepttext()
Setnull(ll_nulo)
il_modif ++
//gl_iva_exento_f	= 0
ll_sw_pago_reg	= 0
sw_ok				= 'S'
ll_count_tipo		= 0
ll_ctas				= 0
ll_ctas_pagadas_1	= 0
ll_ctas_pagadas_2	= 0
ll_ctas_pagadas	= 0
if isnull(il_cantidad_malo) then il_cantidad_malo=0

// vhfb - inicio - carga de variables de instancia para wf_proceso_001
il_ctas_pag_m_001 = ll_ctas_pag_m
il_inc_gastos_001 = ii_inc_gastos
il_folio_001      = ll_folio
il_tot_reg_001    = ll_tot_reg
il_count_reg_001  = ll_count_reg
is_tipo_comp_001  = ls_tipo_comp
is_nulo_001       = ls_nulo
is_columna_001    = is_columna
idt_fecha_hoy_001 = ldt_fecha_hoy
// vhfb - termino - carga de variables de instancia para wf_proceso_001

wf_proceso_001() // vhfb

// vhfb - inicio - retorno de variables de wf_proceso_001
ll_ctas_pag_m  = il_ctas_pag_m_001
ii_inc_gastos  = il_inc_gastos_001
ll_folio       = il_folio_001     
ll_tot_reg     = il_tot_reg_001   
ll_count_reg   = il_count_reg_001 
ls_tipo_comp   = is_tipo_comp_001 
ls_nulo        = is_nulo_001      
is_columna     = is_columna_001   
ldt_fecha_hoy  = idt_fecha_hoy_001
// vhfb - termino -  retorno de variables de wf_proceso_001

ls_tipo_cob			= dw_detalle_be.getitemstring(dw_detalle_be.getrow(),'tipo_cob')
ll_count_hijo		= f_retorna_cant_ctomp_hijos(gs_base,gs_serie,gi_numero)


//----------------------------------------------------------------------
// s_tipo_cob='E' or ls_tipo_cob='F' or ls_tipo_cob='A' 
//----------------------------------------------------------------------

ls_tipo_cob			= dw_detalle_be.getitemstring(dw_detalle_be.getrow(),'tipo_cob')
ll_count_hijo		= f_retorna_cant_ctomp_hijos(gs_base,gs_serie,gi_numero)
if ((ls_tipo_cob='E' or ls_tipo_cob='F' or ls_tipo_cob='A' ) and ll_count_hijo > 0) or gs_base='M' then
	wf_limpiar_multiproducto(row)
else
	if dw_datos_be.rowcount()>0 then 
		if gs_rezago = "S" then
			tab_ingreso.tp_be.rb_be_uf.visible			= true
			tab_ingreso.tp_be.rb_be_peso.visible		= true
			if rb_be_uf.checked=true then 
				dw_detalle_be.SetItem(dw_detalle_be.getrow(), "moneda",'U')
			elseif rb_be_peso.checked=true then 
				dw_detalle_be.SetItem(dw_detalle_be.getrow(), "moneda",'P')
			end if
		else
			if ls_tipo_cob<>'M' then
				tab_ingreso.tp_be.rb_be_uf.visible		= false
				tab_ingreso.tp_be.rb_be_peso.visible	= false
				tab_ingreso.tp_be.rb_be_peso.checked	= true
				if rb_be_uf.checked=true then 
					dw_detalle_be.SetItem(dw_detalle_be.getrow(), "moneda",'U')
				elseif rb_be_peso.checked=true then 
					dw_detalle_be.SetItem(dw_detalle_be.getrow(), "moneda",'P')
				end if
			end if
		end if
		ls_estado_cadena	= dw_datos_be.getitemstring(1,'cadena_estado')
		ll_cod_parque		= dw_datos_be.getitemnumber(1,'cadena_cod_parque')
		SELECT	"ESTADO"."NOMBRE_ESTADO"  
		INTO 		:ls_descrip_estado  
		FROM 	"ESTADO"  
		WHERE 	"ESTADO"."COD_ESTADO" = :ls_estado_cadena ;
	end if
	if rb_be_afecta.checked=true then
		dw_detalle_be.SetItem(dw_detalle_be.getrow(), "iva", idb_iva)
	end if
	dw_detalle_be.accepttext()
	if ls_estado_cadena='S' then
		ll_tot_reg							= dw_detalle_be.rowcount()
		if ll_tot_reg>1 then
			for ll_indi = 1 to ll_tot_reg
				ls_tipo_cob_aux			= dw_detalle_be.getitemstring(ll_indi,'tipo_cob')
				if ls_tipo_cob = ls_tipo_cob_aux then 
					ll_count_tipo ++
					if ll_count_tipo = 2 then
						messagebox("Advertencia","No puede Ingresar Tipo Cobro "+ls_tipo_cob+" Duplicado")
						dw_detalle_be.deleterow(ll_indi)
						fila 					= dw_detalle_be.InsertRow(0)
						dw_detalle_be.scrolltorow(fila)
						dw_detalle_be.SetItem(fila, "uf", gd_uf)
						if rb_be_afecta.checked=true then
							dw_detalle_be.SetItem(fila, "iva", idb_iva)
						end if
						dw_detalle_be.SetItem(fila, "folio", 0)
						dw_detalle_be.SetItem(fila, "estado", 'N')
						dw_detalle_be.SetItem(fila, "uf", gd_uf)
						if rb_be_uf.checked=true then
							dw_detalle_be.SetItem(fila, "moneda",'U')
						else
							dw_detalle_be.SetItem(fila, "moneda",'P')
						end if
						setnull(ls_tipo_cob);setnull(is_columna)
						dw_detalle_be.scrolltorow(row)
						dw_detalle_be.setfocus()
						dw_detalle_be.setcolumn('tipo_cob')
						exit
					end if
				end if
			next
		end if	

		//----------------------------------------------------------------------
		// is_columna = "tipo_cob"
		//----------------------------------------------------------------------
		if is_columna = "tipo_cob" then
			
			// vhfb - inicio - carga de variables de instancia para wf_proceso_002
			
			sw_ok_002 = sw_ok
			is_tipo_cob_002 = ls_tipo_cob
			is_texto_002 = ls_texto
			is_moneda_insert_002 = ls_moneda_insert
			is_estado_cadena_002 = ls_estado_cadena
			il_fila_reg_002 = ll_fila_reg
			il_count_e_002 = ll_count_e
			il_fila_cred_002 = ll_fila_cred
			ii_cantidad_002 = ii_cantidad
			il_cuota_ini_002 = ll_cuota_ini
			il_cuota_fin_002 = ll_cuota_fin
			il_new_iva_002 = ll_new_iva
			il_fila_002 = fila
			il_monto_cuota_reg_002 = ll_monto_cuota_reg
			idb_iva_002 = ldb_iva
			il_iva_f_002 = ll_iva_f
			il_mora_mant_002 = ll_mora_mant
			il_iva_p_002 = ll_iva_p
			il_gasto_mant_002 = ll_gasto_mant
			il_iva_r_002 = ll_iva_r
			is_tipo_comp_002  = ls_tipo_comp
			is_tipo_comp_002  = ls_tipo_comp
			// vhfb - termino - carga de variables de instancia para wf_proceso_002			
			wf_proceso_002(row)
			// vhfb - inicio - retorno de variables de wf_proceso_002
			ls_tipo_comp  = is_tipo_comp_002
			sw_ok              =  sw_ok_002              
			ls_tipo_cob        =  is_tipo_cob_002        
			ls_texto           =  is_texto_002           
			ls_moneda_insert   =  is_moneda_insert_002   
			ls_estado_cadena   =  is_estado_cadena_002   
			ll_fila_reg        =  il_fila_reg_002        
			ll_count_e         =  il_count_e_002         
			ll_fila_cred       =  il_fila_cred_002       
			ii_cantidad        =  ii_cantidad_002        
			ll_cuota_ini       =  il_cuota_ini_002       
			ll_cuota_fin       =  il_cuota_fin_002       
			ll_new_iva         =  il_new_iva_002         
			fila               =  il_fila_002            
			ll_monto_cuota_reg =  il_monto_cuota_reg_002 
			ldb_iva            =  idb_iva_002            
			ll_iva_f           =  il_iva_f_002           
			ll_mora_mant       =  il_mora_mant_002       
			ll_iva_p           =  il_iva_p_002           
			ll_gasto_mant      =  il_gasto_mant_002      
			ll_iva_r           =  il_iva_r_002           
			ls_tipo_comp   =  is_tipo_comp_002
			// vhfb - inicio - retorno de variables de wf_proceso_002

		end if
		
		this.accepttext()
		dw_gastos_be.SetItem(1, "Subtotal",GetItemNumber(1,"c_subtotal"))
		dw_detalle_be.accepttext()
		fila 							= row
		
		
		//----------------------------------------------------------------------
		// is_columna = "cantidad" AND (ls_tipo_cob = "E" or ls_tipo_cob = "U") AND GetItemNumber(row, "cantidad") > 0 AND gs_rezago <> "S"
		//----------------------------------------------------------------------
		IF is_columna = "cantidad" AND (ls_tipo_cob = "E" or ls_tipo_cob = "U") AND GetItemNumber(row, "cantidad") > 0 AND gs_rezago <> "S"  THEN
			wf_actualizar_abono(ls_tipo_cob)
			ii_cantidad 			= GetItemNumber(row, "cantidad")
			if (gs_base='O' or gs_base='U' or gs_base='M') and dw_datos_be.DataObject='d_datos_cuenta_ci_oferta' then
				ll_ctas				= dw_datos_be.getitemnumber(1,'pago_oferta_nro_cuotas')
				ll_ctas_pagadas	= dw_datos_be.getitemnumber(1,'oferta_v_cta_pag_s')
			elseif gs_base='P' and dw_datos_be.DataObject='d_datos_cuenta_ci_pagare' then
				ll_ctas				= dw_datos_be.getitemnumber(1,'pagare_plazo')
				ll_ctas_pagadas_1	= dw_datos_be.getitemnumber(1,'pagare_cta_pag_la')
				ll_ctas_pagadas_2	= dw_datos_be.getitemnumber(1,'pagare_cta_pag_isa')
				ll_ctas_pagadas	= ll_ctas_pagadas_1 + ll_ctas_pagadas_2
			elseif gs_base='L' and dw_datos_be.DataObject='d_datos_cuenta_ci_liberador' then
				ll_ctas				= dw_datos_be.getitemnumber(1,'pago_liberador_nro_cuotas')
				ll_ctas_pagadas	= dw_datos_be.getitemnumber(1,'anexo_liberador_cta_pag_m')
			elseif (gs_base='F' or gs_base='G' or gs_base='V') and dw_datos_be.DataObject='d_datos_cuenta_ci_funeraria' then
				ll_ctas				= dw_datos_be.getitemnumber(1,'producto_pago_plazo')
				ll_ctas_pagadas	= dw_datos_be.getitemnumber(1,'producto_anexo_cuotas_pag')
				ls_moneda_ctto	= dw_datos_be.getitemstring(1,'producto_pago_moneda')
			elseif gs_base='D' and dw_datos_be.DataObject='d_datos_cuenta_ci_derecho' then
				ll_ctas				= dw_datos_be.getitemnumber(1,'derecho_plazo')
				ll_ctas_pagadas_1	= dw_datos_be.getitemnumber(1,'derecho_cta_pag_la')
				ll_ctas_pagadas_2	= dw_datos_be.getitemnumber(1,'derecho_cta_pag_isa')
				ll_ctas_pagadas	= ll_ctas_pagadas_1 + ll_ctas_pagadas_2
			elseif gs_base='A' and dw_datos_be.DataObject='d_datos_cuenta_ci_aumento_capacidad' then
				ll_ctas				= dw_datos_be.getitemnumber(1,'pago_aumento_nro_cuotas')
				ll_ctas_pagadas	= dw_datos_be.getitemnumber(1,'anexo_aumento_cta_pag_m')
			end if
			if (ll_ctas_pagadas + ii_cantidad) > ll_ctas then
				wf_limpiar_dw_registro(row)
				RETURN 1
			else
				ll_monto_cred					= round(dw_datos_be.GetItemNumber(1,"c_valor_cuota_pesos"),0)
				ll_monto_mora_cred			= wf_calcular_mora(row)
				SELECT	SUM("ABONO_CTA_CTE"."MONTO")  
				INTO 		:ll_sum_monto_abono  
				FROM 		"ABONO_CTA_CTE"  
				WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
						 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
						 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero )  AND 
						 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
				USING		sqlca;
				if ll_sum_monto_abono > 0 then
					ll_monto_cta				= ll_monto_cred * this.getitemnumber(row,'cantidad')
					if ll_sum_monto_abono >= (ll_monto_cta + ll_monto_mora_cred) then
						ll_monto_final_cred	= round(ll_sum_monto_abono - (ll_monto_cta + ll_monto_mora_cred),0)
						ll_res_abono			= messagebox("Advertencia Abono","En su Cuenta Corriente Existe Abonado $ "+string(ll_sum_monto_abono,'###,###,###,###,##0')+", se descontará por Concepto Crédito $ "+string((ll_monto_cta + ll_monto_mora_cred) - 1,'###,###,###,###,##0')+", quedando a su Favor $ "+string(ll_monto_final_cred,'###,###,###,###,##0')+"... desea utilizar Abono Existente ",Exclamation!,YesNo!,2)
						if ll_res_abono=1 then
							SetItem(row, "monto", ll_monto_cred)
							ll_monto_final_cred ++
							UPDATE	"ABONO_CTA_CTE"  
							SET 		"TIPO_COB_OCUPA" = :gs_tipo_cobro,   
										"FOLIO_OCUPA" = :ll_folio,   
										"FECHA_OCUPA" = :ldt_fecha_hoy,   
										"MONTO_OCUPA" = (:ll_monto_cta + :ll_monto_mora_cred) - 1,   
										"USUARIO_OCUPA" = :gs_user,   
										"CAJA_OCUPA" = :gs_caja,   
										"ESTADO_REG" = 'O',
										"TIPO_MOV_OCUPA" = 'E',
										"SW_ESTADO_TRANS" = 1
							WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
									 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
									 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
									 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
							USING		sqlca;
							if sqlca.sqlcode=0 then
								commit;
								INSERT INTO "ABONO_CTA_CTE"  
											( "RUT",	"BASE",		"SERIE",		"NUMERO",	"TIPO_COB",		"FOLIO",	"MONTO",				"FECHA_CREA",	"USUARIO_CREA",	"CAJA_CREA",	"ESTADO_REG",	"TIPO_COB_OCUPA",	"FOLIO_OCUPA",	"FECHA_OCUPA",	"MONTO_OCUPA",	"USUARIO_OCUPA",	"CAJA_OCUPA",	"TIPO_MOV_OCUPA",	"SW_ESTADO_TRANS" )
								VALUES 	( :gi_rut,	:gs_base,	:gs_serie,	:gi_numero,	:gs_tipo_cobro,		:ll_folio,	:ll_monto_final_cred,	:gdt_fec_sistema,	:gs_user,			:gs_caja,			'P',						null,						null,					null,					null,					null,						null,					null,						2 )  
								USING		sqlca;
								if sqlca.sqlcode=0 then
									commit;
								else
									rollback;
									messagebox("Error Grabar","Error al INSERTAR ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
								end if
							else
								rollback;
								messagebox("Error Grabar","Error al UPDATE ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
							end if
						else
							ll_monto_final_cred		= ll_monto_cred
							SetItem(row, "monto", ll_monto_cred)
						end if
					else
						ll_res_abono				= messagebox("Advertencia Abono","En su Cuenta Corriente Existe Abonado $ "+string(ll_sum_monto_abono,'###,###,###,###,##0')+", Monto a Cancelar es $ "+string(ll_monto_cta + ll_monto_mora_cred,'###,###,###,###,##0')+" y su Saldo quedará en 0... desea utilizar por Concepto Crédito Abono Existente",Exclamation!,YesNo!,2)
						if ll_res_abono=1 then
							SetItem(row, "monto", ll_monto_cred )
							UPDATE	"ABONO_CTA_CTE"  
							SET 		"TIPO_COB_OCUPA" = :gs_tipo_cobro,   
										"FOLIO_OCUPA" = :ll_folio,   
										"FECHA_OCUPA" = :ldt_fecha_hoy,   
										"MONTO_OCUPA" = :ll_sum_monto_abono,   
										"USUARIO_OCUPA" = :gs_user,   
										"CAJA_OCUPA" = :gs_caja,   
										"ESTADO_REG" = 'O',
										"TIPO_MOV_OCUPA" = 'E',
										"SW_ESTADO_TRANS" = 1  
							WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
									 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
									 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
									 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
							USING		sqlca;
							if sqlca.sqlcode=0 then
								commit;
							else
								rollback;
								messagebox("Error Grabar","Error al Update ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
							end if
						else
							ll_monto_final_cred		= ll_monto_cred
							SetItem(row, "monto", ll_monto_cred)
						end if
					end if
				else
					ll_monto_final_cred				= ll_monto_cred
					SetItem(row, "monto", ll_monto_cred)
				end if
				
			end if
			wf_calcular_interes(ls_tipo_cob)
	
		//----------------------------------------------------------------------
		// is_columna = "cantidad" AND ls_tipo_cob = "F" AND GetItemNumber(row, "cantidad") > 0 AND gs_rezago <> "S"
		//----------------------------------------------------------------------	
	
		elseIF is_columna = "cantidad" AND ls_tipo_cob = "F" AND GetItemNumber(row, "cantidad") > 0 AND gs_rezago <> "S"  THEN
			wf_actualizar_abono(ls_tipo_cob)
			wf_calcular_cant_mant(row)
			//Script nuevo IVA Autor MM 22/12/2022
			if gs_tipo_cobro = 'BA' then
				ll_monto_cuota_reg		= tab_ingreso.tp_be.dw_detalle_be.getitemnumber(tab_ingreso.tp_be.dw_detalle_be.getrow(),'c_total_linea')
				ii_cantidad 					= GetItemNumber(row, "cantidad")
				if isnull(ii_cantidad) or ii_cantidad = 0 then ii_cantidad=1
				ll_cuota_ini					= ll_ctas_pag_m + 1
				ll_cuota_fin					= (ll_cuota_ini + ii_cantidad) - 1
		
				  SELECT  SUM("VISTA_MANTEN_IVA"."IVA" ) 
				  INTO    :ldb_iva
				  FROM    "VISTA_MANTEN_IVA"  
				  WHERE ( "VISTA_MANTEN_IVA"."BASE" = :gs_base ) AND  
							( "VISTA_MANTEN_IVA"."SERIE" = :gs_serie ) AND  
							( "VISTA_MANTEN_IVA"."NUMERO" = :gi_numero ) AND
							( "VISTA_MANTEN_IVA"."TIPO_MOV" = 'F' ) AND
							( "VISTA_MANTEN_IVA"."NRO_CUOTA" >= :ll_cuota_ini ) AND
							( "VISTA_MANTEN_IVA"."NRO_CUOTA" <= :ll_cuota_fin );
				  if ldb_iva > 0 and ll_monto_cuota_reg > 0 then
						ll_iva_f 				= ldb_iva		//round(ll_monto_cuota_reg * (idb_iva - 1),0)							// vhfb -- aqui cambiar iva con descuento
						
						// VHFB - INICIO - CALCULO DESCUENTO IVA
						IF gd_descuento > 0 THEN
							
						    ld_monto_descuento = ll_monto_cuota_reg * (gd_descuento/100)
						   
						    ll_iva_f =round ((ll_monto_cuota_reg - ld_monto_descuento)* (idb_iva - 1),0)
						END IF 
						// VHFB - TERMINO - CALCULO DESCUENTO IVA
						
						ll_new_iva			= dw_detalle_be.Find("tipo_cob = 'D'", 1, dw_detalle_be.rowcount())
						if ll_new_iva > 0 then
							if ldb_iva > 0 then
								dw_detalle_be.scrolltorow(ll_new_iva)
							else
								dw_detalle_be.deleterow(ll_new_iva)
							end if
						else
							ll_new_iva		= dw_detalle_be.insertrow(0)
						end if
						dw_detalle_be.setitem(ll_new_iva,'tipo_cob', 'D')
						if rb_be_afecta.checked=true then
							dw_detalle_be.SetItem(ll_new_iva, "iva", idb_iva)
						end if
						dw_detalle_be.setitem(ll_new_iva,'cantidad', 1)
						ls_moneda_insert	= '1'
						if ls_moneda_insert = '1' then
							dw_detalle_be.setitem(ll_new_iva,'monto_uf', round( ll_iva_f / gd_uf,4))
							dw_detalle_be.setitem(ll_new_iva,'monto', ll_iva_f)
						end if
						dw_detalle_be.setitem(ll_new_iva,'uf',gd_uf)
						dw_detalle_be.setitem(ll_new_iva,'estado','S')
						dw_detalle_be.SetItem(ll_new_iva, "moneda",'P')
				  else
						ll_iva_f 				= 0
						gl_iva_exento_f		= ll_monto_cuota_reg
						ll_new_iva			= dw_detalle_be.Find("tipo_cob = 'D'", 1, dw_detalle_be.rowcount())
						if ll_new_iva > 0 then
							dw_detalle_be.deleterow(ll_new_iva)
						end if
				  end if
				  ll_mora_mant			= dw_gastos_be.getitemnumber(1,'mora_mant')
				  if ll_mora_mant > 0 then
					  SELECT  SUM("VISTA_MANTEN_IVA"."IVA")  
					  INTO    	:ldb_iva
					  FROM    "VISTA_MANTEN_IVA"  
					  WHERE ( "VISTA_MANTEN_IVA"."BASE" = :gs_base ) AND  
								( "VISTA_MANTEN_IVA"."SERIE" = :gs_serie ) AND  
								( "VISTA_MANTEN_IVA"."NUMERO" = :gi_numero ) AND
								( "VISTA_MANTEN_IVA"."TIPO_MOV" = 'P' ) AND
								( "VISTA_MANTEN_IVA"."NRO_CUOTA" >= :ll_cuota_ini ) AND
								( "VISTA_MANTEN_IVA"."NRO_CUOTA" <= :ll_cuota_fin );
					  if ldb_iva > 0 and ll_mora_mant > 0 then
						
						// VHFB - INICIO - CALCULO DESCUENTO IVA
						IF gd_descuento > 0 THEN
							
						    ld_monto_descuento = ll_mora_mant * (gd_descuento/100)
						   
						    ll_iva_p =round ((ll_mora_mant - ld_monto_descuento)* (idb_iva - 1),0)
						ELSE
							ll_iva_p 			= round(ll_mora_mant * (idb_iva - 1),0)
						END IF 
						// VHFB - TERMINO - CALCULO DESCUENTO IVA		
						
							//ll_iva_p 			= round(ll_mora_mant * (idb_iva - 1),0)
							ll_new_iva		= dw_detalle_be.Find("tipo_cob = 'V'", 1, dw_detalle_be.rowcount())
							if ll_new_iva > 0 then
								dw_detalle_be.scrolltorow(ll_new_iva)
							else
								ll_new_iva		= dw_detalle_be.insertrow(0)
							end if
							dw_detalle_be.setitem(ll_new_iva,'tipo_cob', 'V')
							if rb_be_afecta.checked=true then
								dw_detalle_be.SetItem(ll_new_iva, "iva", idb_iva)
							end if
							dw_detalle_be.setitem(ll_new_iva,'cantidad', 1)
							ls_moneda_insert	= '1'
							if ls_moneda_insert = '1' then
								dw_detalle_be.setitem(ll_new_iva,'monto_uf', round( ll_iva_p / gd_uf,4))
								dw_detalle_be.setitem(ll_new_iva,'monto', ll_iva_p)
							end if
							dw_detalle_be.setitem(ll_new_iva,'uf',gd_uf)
							dw_detalle_be.setitem(ll_new_iva,'estado','S')
							dw_detalle_be.SetItem(ll_new_iva, "moneda",'P')
					  else
							ll_iva_p 			= 0
					  end if
				  end if
				  ll_gasto_mant				= dw_gastos_be.getitemnumber(1,'gasto_mant')
				  if ll_gasto_mant > 0 then
					  SELECT  SUM("VISTA_MANTEN_IVA"."IVA")  
					  INTO    	:ldb_iva
					  FROM    "VISTA_MANTEN_IVA"  
					  WHERE ( "VISTA_MANTEN_IVA"."BASE" = :gs_base ) AND  
								( "VISTA_MANTEN_IVA"."SERIE" = :gs_serie ) AND  
								( "VISTA_MANTEN_IVA"."NUMERO" = :gi_numero ) AND
								( "VISTA_MANTEN_IVA"."TIPO_MOV" = 'R' ) AND
								( "VISTA_MANTEN_IVA"."NRO_CUOTA" >= :ll_cuota_ini ) AND
								( "VISTA_MANTEN_IVA"."NRO_CUOTA" <= :ll_cuota_fin );
					  if ldb_iva > 0 and ll_gasto_mant > 0 then
						
						// VHFB - INICIO - CALCULO DESCUENTO IVA
						IF gd_descuento > 0 THEN
							
						    ld_monto_descuento = ll_gasto_mant * (gd_descuento/100)
						   
						    ll_iva_r =round ((ll_gasto_mant - ld_monto_descuento)* (idb_iva - 1),0)
						ELSE
							ll_iva_r 			= round(ll_gasto_mant * (idb_iva - 1),0)
						END IF 
						// VHFB - TERMINO - CALCULO DESCUENTO IVA							
						
						
							//ll_iva_r 			= round(ll_gasto_mant * (idb_iva - 1),0)
							ll_new_iva		= dw_detalle_be.Find("tipo_cob = 'X'", 1, dw_detalle_be.rowcount())
							if ll_new_iva > 0 then
								dw_detalle_be.scrolltorow(ll_new_iva)
							else
								ll_new_iva		= dw_detalle_be.insertrow(0)
							end if
							dw_detalle_be.setitem(ll_new_iva,'tipo_cob', 'X')
							if rb_be_afecta.checked=true then
								dw_detalle_be.SetItem(ll_new_iva, "iva", idb_iva)
							end if
							dw_detalle_be.setitem(ll_new_iva,'cantidad', 1)
							ls_moneda_insert	= '1'
							if ls_moneda_insert = '1' then
								dw_detalle_be.setitem(ll_new_iva,'monto_uf', round( ll_iva_r / gd_uf,4))
								dw_detalle_be.setitem(ll_new_iva,'monto', ll_iva_r)
							end if
							dw_detalle_be.setitem(ll_new_iva,'uf',gd_uf)
							dw_detalle_be.setitem(ll_new_iva,'estado','S')
							dw_detalle_be.SetItem(ll_new_iva, "moneda",'P')
					  else
							ll_iva_r 			= 0
					  end if
				end if
				  //Fin script nuevo IVA Autor MM 22/12/2022
			end if
		END IF

		
		//----------------------------------------------------------------------
		// ls_estado_cadena='V' or ls_estado_cadena='C' or gs_rezago='S'
		//----------------------------------------------------------------------		
		
	elseif ls_estado_cadena='V' or ls_estado_cadena='C' or gs_rezago='S' then
		sw_ok						= 'S'
		ll_tot_reg					= dw_detalle_be.rowcount()
		ll_fila_reg 					= dw_detalle_be.Find("tipo_cob ='4' or tipo_cob ='6'",1, ll_tot_reg)
		if ll_fila_reg > 0 then
			ll_count_e 				= dw_detalle_be.Find("tipo_cob ='E' or tipo_cob ='U'",1, ll_tot_reg)
			if ll_count_e = 0 then
				w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1,'gasto_cred', 0)
				w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1,'mora_cred', 0)
				w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.accepttext()
				do while sw_ok = 'S'
					ll_fila_reg 		= dw_detalle_be.Find("tipo_cob ='4' or tipo_cob ='6'",1, ll_tot_reg)
					if ll_fila_reg > 0 then
						dw_detalle_be.deleterow(ll_fila_reg)
						ll_fila_reg 		= dw_detalle_be.Find("tipo_cob ='4' or tipo_cob ='6'",1, ll_tot_reg)
						if ll_fila_reg = 0 then sw_ok = 'N'
					end if
				loop
			end if
		end if
		
		//----------------------------------------------------------------------
		// ls_tipo_cob = "F" or ls_tipo_cob='E' or ls_tipo_cob='A' or ls_tipo_cob='S' or ls_tipo_cob='M' 
		//----------------------------------------------------------------------		
		
		
		IF ls_tipo_cob = "F" or ls_tipo_cob='E' or ls_tipo_cob='A' or ls_tipo_cob='S' or ls_tipo_cob='M' THEN
			if ls_tipo_cob='F' then
				SELECT 	Count("CUPONERAS_DETALLE"."TIPO_MOV"  )
				INTO 		:ll_count_f 
				FROM 	"CUPONERAS",   "CUPONERAS_DETALLE"
				WHERE 	( "CUPONERAS"."BASE" = "CUPONERAS_DETALLE"."BASE" ) and  
							( "CUPONERAS"."SERIE" = "CUPONERAS_DETALLE"."SERIE" ) and  
							( "CUPONERAS"."NUMERO" = "CUPONERAS_DETALLE"."NUMERO" ) and  
							( "CUPONERAS"."NRO_CUPONERA" = "CUPONERAS_DETALLE"."NRO_CUPONERA" ) and  
							( ( "CUPONERAS"."BASE" = :gs_base ) AND  
							( "CUPONERAS"."SERIE" = :gs_serie ) AND  
							( "CUPONERAS"."NUMERO" = :gi_numero ) AND  
							( "CUPONERAS_DETALLE"."TIPO_MOV" = 'F' ) AND  
							( "CUPONERAS_DETALLE"."ESTADO_PAGO_CUPON" = 'V' ) AND
							("CUPONERAS"."ESTADO_CUPONERA" = 'V' OR  "CUPONERAS"."ESTADO_CUPONERA" = 'C') )	   ;
				if isnull(ll_count_f) then ll_count_f=0
				
				SELECT 	"CADENA_MORA"."MORA_MANT"  
				INTO 		:ll_mora_mant  
				FROM 	"CADENA_MORA"  
				WHERE 	( "CADENA_MORA"."BASE" = :gs_base ) AND  
							( "CADENA_MORA"."SERIE" = :gs_serie ) AND  
							( "CADENA_MORA"."NUMERO" = :gi_numero )   ;
				if isnull(ll_mora_mant) then ll_mora_mant=0	
				ii_cantidad 					= GetItemNumber(this.getrow(), "cantidad")
//				if ll_count_f <= (ll_mora_mant + 1) then
//					ll_crear		= (ll_mora_mant + 1) - ll_count_f
				if ll_count_f <= (ll_mora_mant + ii_cantidad) then
					ll_crear		= (ll_mora_mant + ii_cantidad) - ll_count_f
					wf_crear_cupones_mantencion(ll_crear)
				end if
	
			
			end if
			if (gs_base = 'F' or gs_base = 'G' or gs_base='V') and ls_tipo_cob = 'E' and gi_numero > 0 then
				dw_detalle_be.setitem(dw_detalle_be.getrow(),'cod_servicio',dw_datos_be.getitemnumber(1,'producto_pago_codigo_servicio'))
				dw_detalle_be.accepttext()
			end if
			ll_tot_reg						= dw_detalle_be.rowcount()
	//		if gs_base='L' and rb_be_afecta.checked=true then
	//			messagebox("Advertencia","Pago Cuota Crédito a Contrato Anexo Liberador debe Generar Boleta Afecta")
	//			rb_be_exenta.checked	= false
	//			rb_be_afecta.checked		= true
	//			rb_be_afecta.triggerevent(clicked!)
	//			Setnull(ls_tipo_cob);Setnull(is_columna)
	//		if (ls_tipo_cob = 'A' and gs_base='L') and rb_be_exenta.checked=true then
	//			messagebox("Advertencia","Pago Pie Crédito a Contrato Anexo Liberador debe Generar Boleta Afecta")
	//			rb_be_exenta.checked	= false
	//			rb_be_afecta.checked		= true
	//			rb_be_afecta.triggerevent(clicked!)
	//			Setnull(ls_tipo_cob);Setnull(is_columna)
			if ls_tipo_cob='F' and st_toku.visible=true then
				messagebox("Advertencia","No es posible Ingresar F-Cuota Mantención por estar Suscrito PAC - Toku")
				SetItem(row, "monto", 0)
				SetItem(row, "monto_uf", 0)
				SetItem(row, "tipo_cob", ls_nulo)
				SetItem(row, "cantidad", 0)
				this.accepttext()
				setnull(ls_tipo_cob)
				dw_detalle_be.setfocus()
				dw_detalle_be.setcolumn('tipo_cob')
			elseif ls_tipo_cob='E' and st_toku.visible=true then
				messagebox("Advertencia","No es posible Ingresar E-Cuota Crédito por estar Suscrito PAC - Toku")
				SetItem(row, "monto", 0)
				SetItem(row, "monto_uf", 0)
				SetItem(row, "tipo_cob", ls_nulo)
				SetItem(row, "cantidad", 0)
				this.accepttext()
				setnull(ls_tipo_cob)
				dw_detalle_be.setfocus()
				dw_detalle_be.setcolumn('tipo_cob')
			end if
			if ll_tot_reg > 1 then
				for ll_indi = 1 to ll_tot_reg
					ls_tipo_cob_aux		= dw_detalle_be.getitemstring(ll_indi,'tipo_cob')
					if ls_tipo_cob = ls_tipo_cob_aux then 
						ll_count_tipo ++
						ls_pasa_valida		= 'N'
						if ll_count_tipo = 7 and (ls_tipo_cob = 'L' or ls_tipo_cob = 'S') then
							ls_pasa_valida	= 'S'
						elseif ls_tipo_cob <> 'L' and ls_tipo_cob <> 'S' and ll_count_tipo > 1 then
							ls_pasa_valida	= 'S'
						end if
						if ls_pasa_valida = 'S' then
							messagebox("Advertencia","No puede Ingresar Tipo Cobro "+ls_tipo_cob+" Duplicado")
							dw_detalle_be.deleterow(ll_indi)
							fila 					= dw_detalle_be.InsertRow(0)
							dw_detalle_be.scrolltorow(fila)
							dw_detalle_be.SetItem(fila, "uf", gd_uf)
							if rb_be_afecta.checked=true then
								dw_detalle_be.SetItem(fila, "iva", idb_iva)
							end if
							dw_detalle_be.SetItem(fila, "folio", 0)
							dw_detalle_be.SetItem(fila, "estado", 'N')
							dw_detalle_be.SetItem(fila, "uf", gd_uf)
							if rb_be_uf.checked=true then
								dw_detalle_be.SetItem(fila, "moneda",'U')
							else
								dw_detalle_be.SetItem(fila, "moneda",'P')
							end if
							setnull(ls_tipo_cob);setnull(is_columna)
							dw_detalle_be.scrolltorow(row)
							dw_detalle_be.setfocus()
							dw_detalle_be.setcolumn('tipo_cob')
							exit
						end if
					end if
				next
			end if
		end if
		
		
		//----------------------------------------------------------------------
		// is_columna = "tipo_cob"
		//----------------------------------------------------------------------		
		
		
		IF is_columna = "tipo_cob" THEN
			IF ls_tipo_cob = "E" or ls_tipo_cob = "U" THEN //cuota
				ll_fila_mant	= dw_detalle_be.Find("tipo_cob ='F'",1, dw_detalle_be.rowcount())
				if ll_fila_mant = 0 then
					w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1,'gasto_mant', 0)
					w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1,'mora_mant', 0)
					w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.accepttext()
				end if
				IF gs_rezago <> "S" THEN
					if (gs_base='O' or gs_base='U' or gs_base='M') and dw_datos_be.DataObject='d_datos_cuenta_ci_oferta' then
						ll_ctas				= dw_datos_be.getitemnumber(1,'pago_oferta_nro_cuotas')
						ll_ctas_pagadas	= dw_datos_be.getitemnumber(1,'oferta_v_cta_pag_s')
					elseif gs_base='P' and dw_datos_be.DataObject='d_datos_cuenta_ci_pagare' then
						ll_ctas				= dw_datos_be.getitemnumber(1,'pagare_plazo')
						ll_ctas_pagadas_1	= dw_datos_be.getitemnumber(1,'pagare_cta_pag_la')
						ll_ctas_pagadas_2	= dw_datos_be.getitemnumber(1,'pagare_cta_pag_isa')
						ll_ctas_pagadas	= ll_ctas_pagadas_1 + ll_ctas_pagadas_2
					elseif gs_base='L' and dw_datos_be.DataObject='d_datos_cuenta_ci_liberador' then
						ll_ctas				= dw_datos_be.getitemnumber(1,'pago_liberador_nro_cuotas')
						ll_ctas_pagadas	= dw_datos_be.getitemnumber(1,'anexo_liberador_cta_pag_m')
					elseif (gs_base='F' or gs_base='G' or gs_base='V') and dw_datos_be.DataObject='d_datos_cuenta_ci_funeraria' then
						ll_ctas				= dw_datos_be.getitemnumber(1,'producto_pago_plazo')
						ll_ctas_pagadas	= dw_datos_be.getitemnumber(1,'producto_anexo_cuotas_pag')
					elseif gs_base='D' and dw_datos_be.DataObject='d_datos_cuenta_ci_derecho' then
						ll_ctas				= dw_datos_be.getitemnumber(1,'derecho_plazo')
						ll_ctas_pagadas_1	= dw_datos_be.getitemnumber(1,'derecho_cta_pag_la')
						ll_ctas_pagadas_2	= dw_datos_be.getitemnumber(1,'derecho_cta_pag_isa')
						ll_ctas_pagadas	= ll_ctas_pagadas_1 + ll_ctas_pagadas_2
					elseif gs_base='A' and dw_datos_be.DataObject='d_datos_cuenta_ci_aumento_capacidad' then
						ll_ctas				= dw_datos_be.getitemnumber(1,'pago_aumento_nro_cuotas')
						ll_ctas_pagadas	= dw_datos_be.getitemnumber(1,'anexo_aumento_cta_pag_m')
					elseif gs_base='R' and dw_datos_be.DataObject='dw_repacta_mant_descripcion_traspaso' then
						ll_ctas				= dw_datos_be.getitemnumber(1,'cuotas_pactadas')
						ll_ctas_pagadas	= dw_datos_be.getitemnumber(1,'ctas_pagadas')
					elseif (gs_base='F' or gs_base='G' or gs_base='V') and dw_datos_be.DataObject='d_datos_cuenta_ci_funeraria' then
						ll_ctas				= dw_datos_be.getitemnumber(1,'producto_pago_plazo')
						ll_ctas_pagadas	= dw_datos_be.getitemnumber(1,'producto_anexo_cuotas_pag')
						ls_moneda_ctto	= dw_datos_be.getitemstring(1,'producto_pago_moneda')
					end if
					if gs_base = 'O' or gs_base='U' or gs_base='M' then
						messagebox("Advertencia","No es Posible Ingresar Cuota, debe Generar CI")
						dw_detalle_be.setitem(row,'tipo_cob','')
						SetItem(row, "monto", 0)
						SetItem(row, "cantidad", 0)
						dw_detalle_be.setfocus()
						dw_detalle_be.setcolumn('tipo_cob')
					elseif gs_base = 'P' and ll_cod_parque<>101 then
						messagebox("Advertencia","No es Posible Ingresar Cuota, debe Generar CI")
						dw_detalle_be.setitem(row,'tipo_cob','')
						SetItem(row, "monto", 0)
						SetItem(row, "cantidad", 0)
						dw_detalle_be.setfocus()
						dw_detalle_be.setcolumn('tipo_cob')
					elseif gs_base<>'C' then
						if ll_ctas_pagadas>=ll_ctas then
							messagebox("Advertencia","No es Posible Ingresar Cuota, Crédito CANCELADO")
							SetItem(row, "monto", 0)
							SetItem(row, "cantidad", 0)
							dw_detalle_be.setfocus()
							dw_detalle_be.setcolumn('tipo_cob')
						else
							if this.getitemnumber(row,'cantidad') <= 1 or isnull(this.getitemnumber(row,'cantidad')) then SetItem(row, "cantidad", 1)
							ll_monto_cred					= round(dw_datos_be.GetItemNumber(1,"c_valor_cuota_pesos"),0)
							if gs_base='F' then
								ldb_monto_dscto			= 0
								SELECT 	"VISTA_CONTRATO_FUNERARIA"."CODIGO_DESCTO_COMER" ,	"VISTA_CONTRATO_FUNERARIA"."DESCTO_COMER"
								INTO		:ls_codigo_dscto,																:ldb_monto_dscto													
								FROM 	"VISTA_CONTRATO_FUNERARIA"  
								WHERE 	( "VISTA_CONTRATO_FUNERARIA"."BASE" = :gs_base ) AND  
											( "VISTA_CONTRATO_FUNERARIA"."SERIE" = :gs_serie ) AND  
											( "VISTA_CONTRATO_FUNERARIA"."NUMERO" = :gi_numero ) AND 
											( "VISTA_CONTRATO_FUNERARIA"."TIPO_SERVICIO" = 'G' ) AND 
											( "VISTA_CONTRATO_FUNERARIA"."PLAZO" = 1 )
								ORDER BY "VISTA_CONTRATO_FUNERARIA"."VALOR_PRODUCTO" DESC,
											"VISTA_CONTRATO_FUNERARIA"."CODIGO_OTRO" ASC;
								if ldb_monto_dscto < 1500 and ldb_monto_dscto > 0 then
									ldb_monto_dscto		= round(ldb_monto_dscto * gd_uf,0)
									ll_monto_cred			= ll_monto_cred + ldb_monto_dscto
								elseif ldb_monto_dscto >= 1500 then
									ll_monto_cred			= ll_monto_cred + ldb_monto_dscto
								end if
							end if
							ll_monto_mora_cred			= wf_calcular_mora(row)
							SELECT	SUM("ABONO_CTA_CTE"."MONTO")  
							INTO 		:ll_sum_monto_abono  
							FROM 	"ABONO_CTA_CTE"  
							WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
									 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
									 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero )  AND 
									 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
							USING		sqlca;
							if ll_sum_monto_abono > 0 then
								ll_monto_cta				= ll_monto_cred * this.getitemnumber(row,'cantidad')
								if ll_sum_monto_abono >= (ll_monto_cta + ll_monto_mora_cred) then
									ll_monto_final_cred	= round(ll_sum_monto_abono - ( ll_monto_cta + ll_monto_mora_cred),0)
									ll_res_abono			= messagebox("Advertencia Abono","En su Cuenta Corriente Existe Abonado $ "+string(ll_sum_monto_abono,'###,###,###,###,##0')+", se descontará por Concepto Crédito $ "+string((ll_monto_cta + ll_monto_mora_cred) - 1,'###,###,###,###,##0')+", quedando a su Favor $ "+string(ll_monto_final_cred,'###,###,###,###,##0')+"... desea utilizar Abono Existente ",Exclamation!,YesNo!,2)
									if ll_res_abono=1 then
										SetItem(row, "monto", ll_monto_cred)
										ll_monto_final_cred ++
										UPDATE	"ABONO_CTA_CTE"  
										SET 		"TIPO_COB_OCUPA" = :gs_tipo_cobro,   
													"FOLIO_OCUPA" = :ll_folio,   
													"FECHA_OCUPA" = :ldt_fecha_hoy,   
													"MONTO_OCUPA" = (:ll_monto_cta + :ll_monto_mora_cred) - 1,   
													"USUARIO_OCUPA" = :gs_user,   
													"CAJA_OCUPA" = :gs_caja,   
													"ESTADO_REG" = 'O',
													"TIPO_MOV_OCUPA" = 'E',
													"SW_ESTADO_TRANS" = 1  
										WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
												 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
												 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
												 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
										USING		sqlca;
										if sqlca.sqlcode=0 then
											commit;
											INSERT INTO "ABONO_CTA_CTE"  
														( "RUT",		"BASE",		"SERIE",		"NUMERO",	"TIPO_COB",		"FOLIO",		"MONTO",						"FECHA_CREA",		"USUARIO_CREA",	"CAJA_CREA",	"ESTADO_REG",	"TIPO_COB_OCUPA",	"FOLIO_OCUPA",	"FECHA_OCUPA",	"MONTO_OCUPA",	"USUARIO_OCUPA",	"CAJA_OCUPA",	"TIPO_MOV_OCUPA",	"SW_ESTADO_TRANS" )
											VALUES 	( :gi_rut,		:gs_base,	:gs_serie,	:gi_numero,	:gs_tipo_cobro,		:ll_folio,		:ll_monto_final_cred,	:gdt_fec_sistema,	:gs_user,			:gs_caja,		'P',				null,					null,				null,				null,				null,					null,				null,					2 )  
											USING		sqlca;
											if sqlca.sqlcode=0 then
												commit;
											else
												rollback;
												messagebox("Error Grabar","Error al INSERTAR ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
											end if
										else
											rollback;
											messagebox("Error Grabar","Error al UPDATE ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
										end if
									else
										ll_monto_final_cred		= ll_monto_cred
										SetItem(row, "monto", ll_monto_cred )
									end if
								else
									ll_res_abono					= messagebox("Advertencia Abono","En su Cuenta Corriente Existe Abonado $ "+string(ll_sum_monto_abono,'###,###,###,###,##0')+", Saldo quedará en 0... desea utilizar por Concepto Crédito Abono Existente",Exclamation!,YesNo!,2)
									if ll_res_abono=1 then
										SetItem(row, "monto", ll_monto_cred )
										UPDATE	"ABONO_CTA_CTE"  
										SET 		"TIPO_COB_OCUPA" = :gs_tipo_cobro,   
													"FOLIO_OCUPA" = :ll_folio,   
													"FECHA_OCUPA" = :ldt_fecha_hoy,   
													"MONTO_OCUPA" = :ll_sum_monto_abono,   
													"USUARIO_OCUPA" = :gs_user,   
													"CAJA_OCUPA" = :gs_caja,   
													"ESTADO_REG" = 'O',
													"TIPO_MOV_OCUPA" = 'E',
													"SW_ESTADO_TRANS" = 1  
										WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
												 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
												 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
												 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
										USING		sqlca;
										if sqlca.sqlcode=0 then
											commit;
										else
											rollback;
											messagebox("Error Grabar","Error al Update ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
										end if
									else
										ll_monto_final_cred		= ll_monto_cred
										SetItem(row, "monto", ll_monto_cred )
									end if
								end if
							else
								if gs_base='F' or gs_base='G' or gs_base='V' then
									ll_plazo						= ll_ctas
									ll_contar						= 0
									if (gs_base='F' or gs_base='G' or gs_base='V') and dw_datos_be.DataObject='d_datos_cuenta_ci_funeraria' then
										ls_moneda_ctto	= dw_datos_be.getitemstring(1,'producto_pago_moneda')
									end if
									SELECT 	COUNT("VISTA_CONTRATO_FUNERARIA"."CODIGO_OTRO")
									INTO		:ll_count_reg
									FROM 	"VISTA_CONTRATO_FUNERARIA"  
									WHERE 	( "VISTA_CONTRATO_FUNERARIA"."BASE" = :gs_base ) AND  
												( "VISTA_CONTRATO_FUNERARIA"."SERIE" = :gs_serie ) AND  
												( "VISTA_CONTRATO_FUNERARIA"."NUMERO" = :gi_numero ) ;
									if isnull(ll_count_reg) then ll_count_reg=0
									
									DECLARE cur_detalle_f CURSOR FOR  
									SELECT 	'E' as TIPO_COB_L,"VISTA_CONTRATO_FUNERARIA"."CODIGO_OTRO",  	"VISTA_CONTRATO_FUNERARIA"."VALOR_PRODUCTO",	'S' as TIPO_COB_S,"VISTA_CONTRATO_FUNERARIA"."CODIGO_DESCTO_COMER" ,	"VISTA_CONTRATO_FUNERARIA"."DESCTO_COMER" ,	"VISTA_CONTRATO_FUNERARIA"."TIPO_COB",		"VISTA_CONTRATO_FUNERARIA"."COD_SERVICIO",		"VISTA_CONTRATO_FUNERARIA"."TIPO_SERVICIO", "VISTA_CONTRATO_FUNERARIA"."PLAZO"
									FROM 	"VISTA_CONTRATO_FUNERARIA"  
									WHERE 	( "VISTA_CONTRATO_FUNERARIA"."BASE" = :gs_base ) AND  
												( "VISTA_CONTRATO_FUNERARIA"."SERIE" = :gs_serie ) AND  
												( "VISTA_CONTRATO_FUNERARIA"."NUMERO" = :gi_numero ) 
									ORDER BY TIPO_COB_L ASC,
												"VISTA_CONTRATO_FUNERARIA"."VALOR_PRODUCTO" DESC,
												"VISTA_CONTRATO_FUNERARIA"."CODIGO_OTRO" ASC
									USING	Sqlca;		//Trans_2;
									open cur_detalle_f;
									ll_fila				= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.getrow()
									w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.scrolltorow(ll_fila)
									if Sqlca.sqlcode = 0 then
										if ll_plazo = 1 and ll_ctas_pagadas = 0 then
											DO WHILE Sqlca.sqlcode = 0
												fetch cur_detalle_f into :ls_tipo_l, :ls_codigo_otro_cur, :ll_valor_serv, :ls_tipo_s,  :ls_cod_dscto_comer, :ll_valor_dscto_comer, :ls_tipo_cob_serv, :ll_cod_servicio, :ls_tipo_servicio, :ll_plazo_serv ;
												if gs_base <> 'V' then gs_tipo_cobro	= ls_tipo_cob_serv
//												if ls_tipo_servicio='A' then
//													ls_tipo_l									= 'L'
//												end if
												if gs_tipo_cobro = 'BA' or gs_tipo_cobro = 'FA' then
													if ls_moneda_ctto='1' and ll_valor_serv=1 then
														if gs_base <> 'V' then
															gs_tipo_cobro					= 'BE'
															rb_be_exenta.checked		= true
														end if
													else
														rb_be_afecta.checked			= true
													end if
												elseif gs_tipo_cobro = 'BE' or gs_tipo_cobro = 'FE' then
													rb_be_exenta.checked		= true
												end if
												if not isnull(ls_codigo_otro_cur) and ls_tipo_cob_serv = gs_tipo_cobro then
													SELECT 	Count("INGRESO"."TIPO_COB" ) 
													INTO 		:ll_count_crem  
													FROM 	"INGRESO"  
													WHERE 	( "INGRESO"."CODIGO_OTRO" = :ls_codigo_otro_cur ) AND  
																( "INGRESO"."BASE" = :gs_base ) AND  
																( "INGRESO"."SERIE" = :gs_serie ) AND  
																( "INGRESO"."CONTRATO" = :gi_numero ) 
													USING	Trans_1;
													if ll_plazo > 1 then ll_count_crem = 0
													if ll_count_crem = 0 then
	//													if ls_tipo_servicio = 'A' then
	//														ll_cod_servicio		= 0
	//														ls_tipo_l				= 'L'
	//													end if
														w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'tipo_cob',ls_tipo_l)
	
														w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'cod_servicio',ll_cod_servicio)
														w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'cantidad',1)
														w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.accepttext()
														w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'tipo_cob_otro',ls_codigo_otro_cur)
														w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.accepttext()
														if gs_base = 'V' then
															SELECT 		"CS_DETALLE_PAGOS"."MONEDA",   	(sum( "CS_DETALLE_PAGOS"."MONTO") - 1) as MONTO  
															INTO 			:ls_monda_det,   							:ll_monto_det  
															FROM 		"CS_CABECERA",   "CS_DETALLE_PAGOS"  
															WHERE 		( "CS_CABECERA"."BASE" = "CS_DETALLE_PAGOS"."BASE" ) and  
																			( "CS_CABECERA"."SERIE" = "CS_DETALLE_PAGOS"."SERIE" ) and  
																			( "CS_CABECERA"."NUMERO" = "CS_DETALLE_PAGOS"."NUMERO" ) and  
																			( ( "CS_CABECERA"."BASE" = :gs_base ) AND  
																			( "CS_CABECERA"."SERIE" = :gs_serie ) AND  
																			( "CS_CABECERA"."NUMERO" = :gi_numero ) )   
															GROUP BY	"CS_DETALLE_PAGOS"."MONEDA"  ;
															ls_moneda_ctto		= ls_monda_det
															ll_valor_serv			= ll_monto_det
															if ls_moneda_ctto = '2' then
																if ll_valor_serv > 500 then
																	w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'moneda','P')
																	w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'monto',ll_valor_serv)
																	w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'monto_uf', round( ll_valor_serv / gd_uf,4))
																else
																	w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'moneda','U')
																	w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'monto_uf',ll_valor_serv)
																	w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'monto', round( ll_valor_serv * gd_uf,0))
																end if
															elseif ls_moneda_ctto = '1' then
																w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'moneda','P')
																w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'monto',ll_valor_serv)
																w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'monto_uf', round( ll_valor_serv / gd_uf,4))
															end if
															w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.accepttext()
	
														else
	//														if ls_tipo_l='E' and ll_contar=0 then
	//															SELECT 	SUM("VISTA_CONTRATO_FUNERARIA"."VALOR_PRODUCTO")
	//															INTO		:ldb_valor_sumado
	//															FROM 	"VISTA_CONTRATO_FUNERARIA"  
	//															WHERE 	( "VISTA_CONTRATO_FUNERARIA"."BASE" = :gs_base ) AND  
	//																		( "VISTA_CONTRATO_FUNERARIA"."SERIE" = :gs_serie ) AND  
	//																		( "VISTA_CONTRATO_FUNERARIA"."NUMERO" = :gi_numero ) ;
	//															ll_contar ++
	//															if ldb_valor_sumado > 0 then ll_valor_serv = ldb_valor_sumado
	//														end if
															if ls_moneda_ctto = '2' then
																if ll_valor_serv > 500 then
																	w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'moneda','P')
																	w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'monto',ll_valor_serv)
																	w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'monto_uf', round( ll_valor_serv / gd_uf,4))
																else
																	w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'moneda','U')
																	w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'monto_uf',ll_valor_serv)
																	w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'monto', round( ll_valor_serv * gd_uf,0))
																end if
															elseif ls_moneda_ctto = '1' then
																w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'moneda','P')
																w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'monto',ll_valor_serv)
																w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'monto_uf', round( ll_valor_serv / gd_uf,4))
															end if
															w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.accepttext()
															if ll_valor_dscto_comer > 0 then
																ll_fila 							= dw_detalle_be.InsertRow(0)
																dw_detalle_be.scrolltorow(ll_fila)
																dw_detalle_be.SetItem(ll_fila, "uf", gd_uf)
																dw_detalle_be.SetItem(ll_fila, "folio", 0)
																dw_detalle_be.SetItem(ll_fila, "estado", 'N')
																dw_detalle_be.SetItem(ll_fila, 'base',gs_base)
																dw_detalle_be.SetItem(ll_fila, 'serie',gs_serie)
																dw_detalle_be.SetItem(ll_fila, 'numero',gi_numero)
																dw_detalle_be.setitem(ll_fila,'cod_servicio',ll_cod_servicio)
																if rb_be_uf.checked=true then
																	dw_detalle_be.SetItem(ll_fila, "moneda",'U')
																else
																	dw_detalle_be.SetItem(ll_fila, "moneda",'P')
																end if
																w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'tipo_cob','S')
																w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'cantidad',1)
																w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.accepttext()
																w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'tipo_cob_otro',ls_cod_dscto_comer)
																w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.accepttext()
																if ls_moneda_ctto = '2' then
																	w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'moneda','U')
																	w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'monto_uf',ll_valor_dscto_comer )
																	w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'monto', round( ll_valor_dscto_comer * gd_uf,0) )
																elseif ls_moneda_ctto = '1' then
																	w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'moneda','P')
																	w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'monto',ll_valor_dscto_comer)
																	w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'monto_uf', round( ll_valor_dscto_comer / gd_uf,4) )
																end if
															end if
														
															ll_sum_reg ++
															if ll_sum_reg <= ll_count_reg and not isnull(ls_codigo_otro_cur) then
																ll_fila	= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.insertrow(0)
																idw_detalle.retrieve(gs_tipo_cobro)
																idw_detalle12.retrieve(gs_tipo_cobro)
																w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.scrolltorow(ll_fila)
																w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(ll_fila,'uf', gd_uf)
																w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(ll_fila,'folio', 0)
																w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(ll_fila,'estado', 'N')
																w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(ll_fila,'base',gs_base)
																w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(ll_fila,'serie',gs_serie)
																w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(ll_fila,'numero',gi_numero)
																w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'cantidad',1)
																if ls_moneda_ctto = '2' then
																	w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(ll_fila, "moneda",'U')
																elseif ls_moneda_ctto = '1' then
																	w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(ll_fila, "moneda",'P')
																end if
																w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.accepttext()
																w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.scrolltorow(ll_fila)
															end if
														end if
													else
														if ll_sw_pago_reg=0 then
	//														messagebox("Advertencia","Pago Ya Registrado")
															w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.deleterow(ll_fila)
															ll_sw_pago_reg++
														end if
													end if
												end if
												Setnull(ls_codigo_otro_cur)
											LOOP
										//elseif ll_plazo > 1 and ldb_valor_cuota > 0 and ll_ctas_pagadas < ll_plazo  then			/// vhfb
										elseif ll_plazo > 1 and ll_ctas_pagadas < ll_plazo  then
											
											// vhfb - inicio - rescate valor cuota
											IF ldb_valor_cuota = 0 THEN		
												
												if ls_moneda_ctto='1' then	
													ldb_valor_cuota = w_ingreso2.tab_ingreso.tp_be.dw_datos_be.getitemnumber(1, 'c_valor_cuota_pesos')
												end if 

												if ls_moneda_ctto='2' then		// uf
													ldb_valor_cuota = w_ingreso2.tab_ingreso.tp_be.dw_datos_be.getitemnumber(1, 'producto_pago_valor_cuota')
												end if 
												
											END IF 
											// vhfb - termino - rescate valor cuota											
											
											ldb_valor_seg				= 0
											ldb_val_cta_ctto			= ldb_valor_cuota - ldb_valor_seg
											if ls_moneda_ctto='2' then
												ldb_valor_cuota		= ldb_val_cta_ctto
												ldb_valor_cuota_peso	= round( ldb_val_cta_ctto * gd_uf,0)
											elseif ls_moneda_ctto='1' then
												ldb_valor_cuota		= ldb_val_cta_ctto
												ldb_valor_cuota_peso	= ldb_val_cta_ctto
											end if
											w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'tipo_cob','E')
											w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'cod_servicio',ll_cod_servicio)
											w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'cantidad',1)
											w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.accepttext()
											w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'tipo_cob_otro',ls_codigo_otro_cur)
											w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.accepttext()
											if ls_moneda_ctto = '2' then
												if ll_valor_serv > 500 then
													w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'moneda','P')
													w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'monto',ldb_valor_cuota_peso)
													w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'monto_uf', ldb_valor_cuota)		//round( ldb_valor_cuota_peso / gd_uf,2))
												else
													w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'moneda','U')
													w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'monto_uf',ldb_valor_cuota )		//ll_valor_serv)
													w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'monto', ldb_valor_cuota_peso)	//round( ll_valor_serv * gd_uf,0))
												end if
											elseif ls_moneda_ctto = '1' then
												w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'moneda','P')
												w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'monto', ldb_valor_cuota_peso)	//ll_valor_serv)
												w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'monto_uf', ldb_valor_cuota)		//round( ll_valor_serv / gd_uf,2))
											end if
										end if
									end if
									wf_calcular_interes('E')
									wf_calcular_iva_gl(ls_tipo_cob)
									
	//								INCORPORAR IVA
								else
									ll_monto_final_cred				= ll_monto_cred
									SetItem(row, "monto", ll_monto_cred )
									ll_cant_e								= dw_detalle_be.getitemnumber(row,'cantidad')
									if rb_be_uf.checked=true then 
										ls_moneda						= 'U'
									elseif rb_be_peso.checked=true then 
										ls_moneda						= 'P'
									end if
								end if
								ll_fila_invalid							= dw_detalle_be.find(' isnull(tipo_cob) ', 1 , dw_detalle_be.rowcount())
								if ll_fila_invalid > 0 then
									dw_detalle_be.deleterow(ll_fila_invalid)
								end if
								dw_detalle_be.accepttext()
								wf_cargar_seguros()
	//							if ldb_monto_dscto > 0 then
	//								ll_fila 							= dw_detalle_be.InsertRow(0)
	//								ll_codigo_servicio			= dw_detalle_be.getitemnumber(1,'cod_servicio')
	//								dw_detalle_be.scrolltorow(ll_fila)
	//								dw_detalle_be.SetItem(ll_fila, "uf", gd_uf)
	//								dw_detalle_be.SetItem(ll_fila, "folio", 0)
	//								dw_detalle_be.SetItem(ll_fila, "estado", 'N')
	//								dw_detalle_be.SetItem(ll_fila, 'base',gs_base)
	//								dw_detalle_be.SetItem(ll_fila, 'serie',gs_serie)
	//								dw_detalle_be.SetItem(ll_fila, 'numero',gi_numero)
	//								dw_detalle_be.setitem(ll_fila,'cod_servicio',ll_codigo_servicio)
	//								ls_moneda_ctto					= '1'
	//								rb_be_peso.checked				= true
	//								if rb_be_uf.checked=true then
	//									dw_detalle_be.SetItem(ll_fila, "moneda",'U')
	//								else
	//									dw_detalle_be.SetItem(ll_fila, "moneda",'P')
	//								end if
	//								w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'tipo_cob','S')
	//								w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'cantidad',1)
	//								w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.accepttext()
	//								w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'tipo_cob_otro',ls_codigo_dscto)
	//								w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.accepttext()
	//								if ls_moneda_ctto = '2' then
	//									w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'moneda','U')
	//									w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'monto_uf',ldb_monto_dscto )
	//									w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'monto', round( ldb_monto_dscto * gd_uf,0) )
	//								elseif ls_moneda_ctto = '1' then
	//									w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'moneda','P')
	//									w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'monto',ldb_monto_dscto)
	//									w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'monto_uf', round( ldb_monto_dscto / gd_uf,2) )
	//								end if
	//							end if
							end if
							wf_calcular_interes(ls_tipo_cob)
						end if
					elseif gs_base='C' then
						messagebox("Advertencia","No es Posible Ingresar Cuota a Contrato")
						dw_detalle_be.deleterow(row)
						fila 					= dw_detalle_be.InsertRow(0)
						dw_detalle_be.scrolltorow(fila)
						dw_detalle_be.SetItem(fila, "uf", gd_uf)
						dw_detalle_be.SetItem(fila, "folio", 0)
						if rb_be_afecta.checked=true then
							dw_detalle_be.SetItem(fila, "iva", idb_iva)
						end if
						dw_detalle_be.SetItem(fila, "estado", 'N')
						dw_detalle_be.SetItem(fila, "uf", gd_uf)
						if rb_be_uf.checked=true then
							dw_detalle_be.SetItem(fila, "moneda",'U')
						else
							dw_detalle_be.SetItem(fila, "moneda",'P')
						end if
						setnull(ls_tipo_cob);setnull(is_columna)
						dw_detalle_be.scrolltorow(row)
						dw_detalle_be.setfocus()
						dw_detalle_be.setcolumn('tipo_cob')
					end if
				else
					if this.getitemnumber(row,'cantidad') <= 1 or isnull(this.getitemnumber(row,'cantidad')) then SetItem(row, "cantidad", 1)
					SetItem(row, "monto", 0)
				end if
			elseIF ls_tipo_cob = "F" THEN
				if gs_rezago <> "S" THEN
					if gs_conexion = "Parque Santiago" then
						messagebox("Advertencia","No es posible Ingresar F-Cuota Mantención por Comprobante de Ingreso, en PARQUE SANTIAGO")
						SetItem(row, "monto", 0)
						SetItem(row, "tipo_cob", ls_nulo)
						SetItem(row, "cantidad", 0)
						this.accepttext()
						dw_detalle_be.setfocus()
						dw_detalle_be.setcolumn('tipo_cob')
					else
						CHOOSE CASE gs_base
							CASE "O","U","M"
								IF dw_datos_be.getitemnumber(1,'oferta_v_cta_pag_m') > 90 then
									messagebox ("Advertencia ", "Este Contrato tiene anexo Liberador de Mantención ",information!)
									RETURN
								end if
							CASE "C"
								IF dw_datos_be.getitemnumber(1,'contrato_cta_pag_m') > 90 then
									messagebox ("Advertencia ", "Este Contrato tiene anexo Liberador de Mantención ",information!)
									RETURN
								end if
						END CHOOSE
						if gs_base='O' or gs_base='C' or gs_base='U' or gs_base='M' then
							if this.getitemnumber(row,'cantidad') <= 1 or isnull(this.getitemnumber(row,'cantidad')) then SetItem(row, "cantidad", 1)
							IF gs_rezago <> "S" THEN
								ll_monto_mant					= round(dw_datos_be.GetItemNumber(1,"c_valor_cuota_mantencion_pesos"),0)
								SELECT	SUM("ABONO_CTA_CTE"."MONTO")  
								INTO 		:ll_sum_monto_abono  
								FROM 	"ABONO_CTA_CTE"  
								WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
										 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
										 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND
										 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )
								USING		sqlca;
								if ll_sum_monto_abono > 0 then
									ll_monto_cta				= ll_monto_mant * this.getitemnumber(row,'cantidad')
									ll_monto_mora_mant		= wf_calcular_mora_mant(row)
									if ll_sum_monto_abono >= (ll_monto_cta + ll_monto_mora_mant) then
										ll_monto_final_mant	= round(ll_sum_monto_abono - ( ll_monto_cta + ll_monto_mora_mant),0)
										ll_res_abono			= messagebox("Advertencia Abono","En su Cuenta Corriente Existe Abonado $ "+string(ll_sum_monto_abono,'###,###,###,###,##0')+", se descontará por Concepto de Mantención $ "+string((ll_monto_cta + ll_monto_mora_mant) - 1,'###,###,###,###,##0')+", quedando a su Favor $ "+string(ll_monto_final_mant,'###,###,###,###,##0')+"... desea utilizar Abono Existente",Exclamation!,YesNo!,2)
										if ll_res_abono=1 then
											SetItem(row, "monto", ll_monto_mant)
											ll_monto_final_mant ++
											UPDATE	"ABONO_CTA_CTE"  
											SET 		"TIPO_COB_OCUPA" = :gs_tipo_cobro,   
														"FOLIO_OCUPA" = :ll_folio,   
														"FECHA_OCUPA" = :ldt_fecha_hoy,   
														"MONTO_OCUPA" = (:ll_monto_cta + :ll_monto_mora_mant) - 1,   
														"USUARIO_OCUPA" = :gs_user,   
														"CAJA_OCUPA" = :gs_caja,   
														"ESTADO_REG" = 'O',
														"TIPO_MOV_OCUPA" = 'F',
														"SW_ESTADO_TRANS" = 1  
											WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
													 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
													 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
													 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
											USING		sqlca;
											if sqlca.sqlcode=0 then
												commit;
												INSERT INTO "ABONO_CTA_CTE"  
															( "RUT",		"BASE",		"SERIE",		"NUMERO",	"TIPO_COB",	"FOLIO",		"MONTO",						"FECHA_CREA",		"USUARIO_CREA",	"CAJA_CREA",	"ESTADO_REG",	"TIPO_COB_OCUPA",	"FOLIO_OCUPA",	"FECHA_OCUPA",	"MONTO_OCUPA",	"USUARIO_OCUPA",	"CAJA_OCUPA",	"TIPO_MOV_OCUPA",	"SW_ESTADO_TRANS" )
												VALUES 	( :gi_rut,	:gs_base,	:gs_serie,	:gi_numero,	:gs_tipo_cobro,			:ll_folio,	:ll_monto_final_mant,	:gdt_fec_sistema,	:gs_user,			:gs_caja,		'P',				null,					null,				null,				null,				null,					null,				null,					2 )  
												USING		sqlca;
												if sqlca.sqlcode=0 then
													commit;
												else
													rollback;
													messagebox("Error Grabar","Error al INSERTAR ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
												end if
											else
												rollback;
												messagebox("Error Grabar","Error al UPDATE ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
											end if
										else
											ll_monto_final_mant		= ll_monto_mant
											SetItem(row, "monto", ll_monto_mant )
										end if
									else
										ll_res_abono				= messagebox("Advertencia Abono","En su Cuenta Corriente Existe Abonado $ "+string(ll_sum_monto_abono,'###,###,###,###,##0')+", Monto a Cancelar es $ "+string(ll_monto_cta,'###,###,###,###,##0')+" y su Saldo quedará en 0... desea utilizar por Concepto de Mantención Abono Existente",Exclamation!,YesNo!,2)
										if ll_res_abono = 1 then
											SetItem(row, "monto", ll_monto_mant )
											UPDATE	"ABONO_CTA_CTE"  
											SET 		"TIPO_COB_OCUPA" = :gs_tipo_cobro,   
														"FOLIO_OCUPA" = :ll_folio,   
														"FECHA_OCUPA" = :ldt_fecha_hoy,   
														"MONTO_OCUPA" = :ll_sum_monto_abono,   
														"USUARIO_OCUPA" = :gs_user,   
														"CAJA_OCUPA" = :gs_caja,   
														"ESTADO_REG" = 'O',
														"TIPO_MOV_OCUPA" = 'F',
														"SW_ESTADO_TRANS" = 1  
											WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
													 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
													 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
													 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
											USING		sqlca;
											if sqlca.sqlcode=0 then
												commit;
											else
												rollback;
												messagebox("Error Grabar","Error al Update ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
											end if
										else
											ll_monto_final_mant		= ll_monto_mant
											SetItem(row, "monto", ll_monto_mant )
										end if
									end if
								else
									ll_monto_final_mant		= ll_monto_mant
									SetItem(row, "monto", ll_monto_mant )
								end if
								ll_tot_reg_benef	= dw_detalle_be.rowcount()
								ll_fila_benef	 		= dw_detalle_be.Find("tipo_cob = 'M'", 1, ll_tot_reg_benef)
								if ll_fila_benef > 0 then
									SELECT 	count("TIPO_PROMOCION_ASOCIADOS"."BASE"  )
									INTO 		:ll_count_benef  
									FROM 	"BENEFICIOS_COMPLEMENTARIO_DET", 		"TIPO_PROMOCION_ASOCIADOS"  
									WHERE ( "BENEFICIOS_COMPLEMENTARIO_DET"."CODIGO" = "TIPO_PROMOCION_ASOCIADOS"."COD_BENEFICIO" ) and  
											  ( "BENEFICIOS_COMPLEMENTARIO_DET"."CODIGO_BENEFICIO" = "TIPO_PROMOCION_ASOCIADOS"."COD_BENEF_DETALLE" ) and  
											  ( "TIPO_PROMOCION_ASOCIADOS"."BASE" = :gs_base ) AND  
											  ( "TIPO_PROMOCION_ASOCIADOS"."SERIE" = :gs_serie ) AND  
											  ( "TIPO_PROMOCION_ASOCIADOS"."NUMERO" = :gi_numero ) AND  
											  ( "TIPO_PROMOCION_ASOCIADOS"."ESTADO" = 'P' ) AND  
											  ( "BENEFICIOS_COMPLEMENTARIO_DET"."COD_MOV_CONSULTA" = 'M' )   ;
									if ll_count_benef > 0 then
										ll_resp_m	= messagebox("Advertencia","Contrato "+gs_base+'-'+gs_serie+'-'+string(gi_numero)+" tiene Beneficio Derecho Sepultación Gratis PENDIENTE, desea aplicar Descuento",Exclamation!,YesNo!,2)
										if ll_resp_m = 1 then
											SELECT 	"FICHA_CUENTA_CONTABLE_OTROS"."CODIGO_OTROS"  
											INTO 		:ls_cod_dscto  
											FROM 	"FICHA_CUENTA_CONTABLE_OTROS"  
											WHERE ( "FICHA_CUENTA_CONTABLE_OTROS"."TIPO_COB" = 'S' ) AND  
													  ( "FICHA_CUENTA_CONTABLE_OTROS"."TIPO_FICHA" = 'M' ) AND  
													  ( "FICHA_CUENTA_CONTABLE_OTROS"."TIPO_COMPROBANTE" = 'BE' ) 
											USING	sqlca;
											if sqlca.sqlcode=0 then
												fila 							= dw_detalle_be.InsertRow(0)
												dw_detalle_be.scrolltorow(fila)
												dw_detalle_be.SetItem(fila, 'uf', gd_uf)
												dw_detalle_be.SetItem(fila, 'folio', 0)
												dw_detalle_be.SetItem(fila, "estado", 'N')
												dw_detalle_be.SetItem(fila, "uf", gd_uf)
												dw_detalle_be.SetItem(fila, 'base',gs_base)
												dw_detalle_be.SetItem(fila, 'serie',gs_serie)
												dw_detalle_be.SetItem(fila, 'numero',gi_numero)
												if rb_be_uf.checked=true then
													dw_detalle_be.SetItem(fila, "moneda",'U')
												else
													dw_detalle_be.SetItem(fila, "moneda",'P')
												end if
												dw_detalle_be.SetItem(fila, "cantidad", 1)
												dw_detalle_be.SetItem(fila, 'tipo_cob_otro',ls_cod_dscto)
												dw_detalle_be.SetItem(fila, 'tipo_cob','S')
												dw_detalle_be.SetItem(fila, "monto", ll_monto_mant - 1)
												dw_detalle_be.SetItem(fila, "monto_uf", ll_monto_mant - 1)
												dw_detalle_be.accepttext()
											end if
										end if
									end if
								end if
								
								ll_tot_reg_benef	= dw_detalle_be.rowcount()
								ll_fila_benef	 		= dw_detalle_be.Find("tipo_cob = 'F'", 1, ll_tot_reg_benef)
								if ll_fila_benef > 0 then
									SELECT 	count("TIPO_PROMOCION_ASOCIADOS"."BASE"  )
									INTO 		:ll_count_benef  
									FROM 	"BENEFICIOS_COMPLEMENTARIO_DET", 		"TIPO_PROMOCION_ASOCIADOS"  
									WHERE ( "BENEFICIOS_COMPLEMENTARIO_DET"."CODIGO" = "TIPO_PROMOCION_ASOCIADOS"."COD_BENEFICIO" ) and  
											  ( "BENEFICIOS_COMPLEMENTARIO_DET"."CODIGO_BENEFICIO" = "TIPO_PROMOCION_ASOCIADOS"."COD_BENEF_DETALLE" ) and  
											  ( "TIPO_PROMOCION_ASOCIADOS"."BASE" = :gs_base ) AND  
											  ( "TIPO_PROMOCION_ASOCIADOS"."SERIE" = :gs_serie ) AND  
											  ( "TIPO_PROMOCION_ASOCIADOS"."NUMERO" = :gi_numero ) AND  
											  ( "TIPO_PROMOCION_ASOCIADOS"."ESTADO" = 'P' ) AND  
											  ( "BENEFICIOS_COMPLEMENTARIO_DET"."COD_MOV_CONSULTA" = 'F' )   ;
									if ll_count_benef > 0 then
										ll_resp_f	= messagebox("Advertencia","Contrato "+gs_base+'-'+gs_serie+'-'+string(gi_numero)+" tiene Beneficio Cuota Mantención Gratis PENDIENTE, desea aplicar Descuento",Exclamation!,YesNo!,2)
										if ll_resp_f = 1 then
											ls_cod_dscto		= '132'
											if not isnull(ls_cod_dscto) then
												fila 							= dw_detalle_be.InsertRow(0)
												gs_tipo_cobro 				= 'BE'
												rb_be_exenta.checked	= true
												dw_detalle_be.scrolltorow(fila)
												dw_detalle_be.SetItem(fila, 'uf', gd_uf)
												dw_detalle_be.SetItem(fila, 'folio', 0)
												dw_detalle_be.SetItem(fila, "estado", 'N')
												dw_detalle_be.SetItem(fila, "uf", gd_uf)
												dw_detalle_be.SetItem(fila, 'base',gs_base)
												dw_detalle_be.SetItem(fila, 'serie',gs_serie)
												dw_detalle_be.SetItem(fila, 'numero',gi_numero)
												if rb_be_uf.checked=true then
													dw_detalle_be.SetItem(fila, "moneda",'U')
												else
													dw_detalle_be.SetItem(fila, "moneda",'P')
												end if
												dw_detalle_be.SetItem(fila, "cantidad", 1)
												dw_detalle_be.SetItem(fila, 'tipo_cob_otro',ls_cod_dscto)
												dw_detalle_be.SetItem(fila, 'tipo_cob','S')
												dw_detalle_be.SetItem(fila, "monto", ll_monto_mant - 1)
												dw_detalle_be.SetItem(fila, "monto_uf", ll_monto_mant - 1)
												dw_detalle_be.accepttext()
											end if
										end if
									end if
								end if
								wf_calcular_interes(ls_tipo_cob)
								//Script nuevo IVA Autor MM 22/12/2022
								if gs_tipo_cobro = 'BA' then
									ll_monto_cuota_reg		= tab_ingreso.tp_be.dw_detalle_be.getitemnumber(tab_ingreso.tp_be.dw_detalle_be.getrow(),'c_total_linea')
									ii_cantidad 					= GetItemNumber(row, "cantidad")
									if isnull(ii_cantidad) or ii_cantidad = 0 then ii_cantidad=1
									ll_cuota_ini					= ll_ctas_pag_m + 1
									ll_cuota_fin					= (ll_cuota_ini + ii_cantidad) - 1
									  SELECT  SUM("VISTA_MANTEN_IVA"."IVA")  
									  INTO    :ldb_iva
									  FROM    "VISTA_MANTEN_IVA"  
									  WHERE ( "VISTA_MANTEN_IVA"."BASE" = :gs_base ) AND  
												( "VISTA_MANTEN_IVA"."SERIE" = :gs_serie ) AND  
												( "VISTA_MANTEN_IVA"."NUMERO" = :gi_numero ) AND
												( "VISTA_MANTEN_IVA"."TIPO_MOV" = 'F' ) AND
												( "VISTA_MANTEN_IVA"."NRO_CUOTA" >= :ll_cuota_ini ) AND
												( "VISTA_MANTEN_IVA"."NRO_CUOTA" <= :ll_cuota_fin );
									  if ldb_iva > 0 and ll_monto_cuota_reg > 0 then
											ll_iva_f 				= ldb_iva		//round(ll_monto_cuota_reg * (idb_iva - 1),0)							// vhfb -- aqui cambiar iva con descuento
											
											// VHFB - INICIO - CALCULO DESCUENTO IVA
											IF gd_descuento > 0 THEN
												
												 ld_monto_descuento = ll_monto_cuota_reg * (gd_descuento/100)
												
												 ldb_iva =round ((ll_monto_cuota_reg - ld_monto_descuento)* (idb_iva - 1),0)
											END IF 
											// VHFB - TERMINO - CALCULO DESCUENTO IVA				
											
											ll_new_iva			= dw_detalle_be.Find("tipo_cob = 'D'", 1, dw_detalle_be.rowcount())
											if ll_new_iva > 0 then
												if ldb_iva > 0 then
													dw_detalle_be.scrolltorow(ll_new_iva)
												else
													dw_detalle_be.deleterow(ll_new_iva)
												end if
											else
												ll_new_iva		= dw_detalle_be.insertrow(0)
											end if
											dw_detalle_be.setitem(ll_new_iva,'tipo_cob', 'D')
											if rb_be_afecta.checked=true then
												dw_detalle_be.SetItem(ll_new_iva, "iva", idb_iva)
											end if
											dw_detalle_be.setitem(ll_new_iva,'cantidad', 1)
											ls_moneda_insert	= '1'
											if ls_moneda_insert = '1' then
												dw_detalle_be.setitem(ll_new_iva,'monto_uf', round( ll_iva_f / gd_uf,4))
												dw_detalle_be.setitem(ll_new_iva,'monto', ll_iva_f)
											end if
											dw_detalle_be.setitem(ll_new_iva,'uf',gd_uf)
											dw_detalle_be.setitem(ll_new_iva,'estado','S')
											dw_detalle_be.SetItem(ll_new_iva, "moneda",'P')
									  else
											ll_iva_f 				= 0
											gl_iva_exento_f		= ll_monto_cuota_reg
											ll_new_iva			= dw_detalle_be.Find("tipo_cob = 'D'", 1, dw_detalle_be.rowcount())
											if ll_new_iva > 0 then
												dw_detalle_be.deleterow(ll_new_iva)
											end if
									  end if
									  ll_mora_mant			= dw_gastos_be.getitemnumber(1,'mora_mant')
									  if ll_mora_mant > 0 then
										  SELECT SUM( "VISTA_MANTEN_IVA"."IVA" )
										  INTO    	:ldb_iva
										  FROM    "VISTA_MANTEN_IVA"  
										  WHERE ( "VISTA_MANTEN_IVA"."BASE" = :gs_base ) AND  
													( "VISTA_MANTEN_IVA"."SERIE" = :gs_serie ) AND  
													( "VISTA_MANTEN_IVA"."NUMERO" = :gi_numero ) AND
													( "VISTA_MANTEN_IVA"."TIPO_MOV" = 'P' ) AND
													 ( "VISTA_MANTEN_IVA"."NRO_CUOTA" >= :ll_cuota_ini ) AND
													 ( "VISTA_MANTEN_IVA"."NRO_CUOTA" <= :ll_cuota_fin );
										  if ldb_iva > 0 and ll_mora_mant > 0 then
											
											// VHFB - INICIO - CALCULO DESCUENTO IVA - MORA
											IF gd_descuento > 0 THEN
												
												 ld_monto_descuento = ll_mora_mant * (gd_descuento/100)
												
												 ll_iva_p =round ((ll_mora_mant - ld_monto_descuento)* (idb_iva - 1),0)
												 
											ELSE
											
												ll_iva_p 			= round(ll_mora_mant * (idb_iva - 1),0)
												
											END IF 
											// VHFB - TERMINO - CALCULO DESCUENTO IVA			
											
											//	ll_iva_p 			= round(ll_mora_mant * (idb_iva - 1),0)
												ll_new_iva		= dw_detalle_be.Find("tipo_cob = 'V'", 1, dw_detalle_be.rowcount())
												if ll_new_iva > 0 then
													dw_detalle_be.scrolltorow(ll_new_iva)
												else
													ll_new_iva		= dw_detalle_be.insertrow(0)
												end if
												dw_detalle_be.setitem(ll_new_iva,'tipo_cob', 'V')
												if rb_be_afecta.checked=true then
													dw_detalle_be.SetItem(ll_new_iva, "iva", idb_iva)
												end if
												dw_detalle_be.setitem(ll_new_iva,'cantidad', 1)
												ls_moneda_insert	= '1'
												if ls_moneda_insert = '1' then
													dw_detalle_be.setitem(ll_new_iva,'monto_uf', round( ll_iva_p / gd_uf,4))
													dw_detalle_be.setitem(ll_new_iva,'monto', ll_iva_p)
												end if
												dw_detalle_be.setitem(ll_new_iva,'uf',gd_uf)
												dw_detalle_be.setitem(ll_new_iva,'estado','S')
												dw_detalle_be.SetItem(ll_new_iva, "moneda",'P')
										  else
												ll_iva_p 			= 0
										  end if
									  end if
									  ll_gasto_mant				= dw_gastos_be.getitemnumber(1,'gasto_mant')
									  if ll_gasto_mant > 0 then
										  SELECT SUM( "VISTA_MANTEN_IVA"."IVA"  )
										  INTO    	:ldb_iva
										  FROM    "VISTA_MANTEN_IVA"  
										  WHERE ( "VISTA_MANTEN_IVA"."BASE" = :gs_base ) AND  
													( "VISTA_MANTEN_IVA"."SERIE" = :gs_serie ) AND  
													( "VISTA_MANTEN_IVA"."NUMERO" = :gi_numero ) AND
													( "VISTA_MANTEN_IVA"."TIPO_MOV" = 'R' )  AND
													 ( "VISTA_MANTEN_IVA"."NRO_CUOTA" >= :ll_cuota_ini ) AND
													 ( "VISTA_MANTEN_IVA"."NRO_CUOTA" <= :ll_cuota_fin );
										  if ldb_iva > 0 and ll_gasto_mant > 0 then
											
											// VHFB - INICIO - CALCULO DESCUENTO IVA - MORA - GASTO COBRANZA
											IF gd_descuento > 0 THEN
												
												 ld_monto_descuento = ll_gasto_mant * (gd_descuento/100)
												
												 ll_iva_r =round ((ll_gasto_mant - ld_monto_descuento)* (idb_iva - 1),0)
												 
											ELSE
											
												ll_iva_r 			= round(ll_gasto_mant * (idb_iva - 1),0)
												
											END IF 
											// VHFB - TERMINO - CALCULO DESCUENTO IVA											
											
												//ll_iva_r 			= round(ll_gasto_mant * (idb_iva - 1),0)
												ll_new_iva		= dw_detalle_be.Find("tipo_cob = 'X'", 1, dw_detalle_be.rowcount())
												if ll_new_iva > 0 then
													dw_detalle_be.scrolltorow(ll_new_iva)
												else
													ll_new_iva		= dw_detalle_be.insertrow(0)
												end if
												dw_detalle_be.setitem(ll_new_iva,'tipo_cob', 'X')
												if rb_be_afecta.checked=true then
													dw_detalle_be.SetItem(ll_new_iva, "iva", idb_iva)
												end if
												dw_detalle_be.setitem(ll_new_iva,'cantidad', 1)
												ls_moneda_insert	= '1'
												if ls_moneda_insert = '1' then
													dw_detalle_be.setitem(ll_new_iva,'monto_uf', round( ll_iva_r / gd_uf,4))
													dw_detalle_be.setitem(ll_new_iva,'monto', ll_iva_r)
												end if
												dw_detalle_be.setitem(ll_new_iva,'uf',gd_uf)
												dw_detalle_be.setitem(ll_new_iva,'estado','S')
												dw_detalle_be.SetItem(ll_new_iva, "moneda",'P')
										  else
												ll_iva_r 			= 0
										  end if
									end if
								end if
							ELSE 
								SetItem(row, "monto", 0)
							END IF
						else
							messagebox("Advertencia","No es posible Ingresar F-Cuota Mantención, para este tipo de Contrato (Solo O-Promesas y C-Contrato)")
							SetItem(row, "monto", 0)
							SetItem(row, "tipo_cob", ls_nulo)
							SetItem(row, "cantidad", 0)
							this.accepttext()
							dw_detalle_be.setfocus()
							dw_detalle_be.setcolumn('tipo_cob')
						end if
					end if
				END IF
			elseif ls_tipo_cob = 'I' then //Abono
				messagebox("Advertencia","No es Posible Ingresar I-Abono")
				SetItem(row, "monto", 0)
				SetItem(row, "cantidad", 0)
				dw_detalle_be.setfocus()
				dw_detalle_be.setcolumn('tipo_cob')
			elseIF ls_tipo_cob = "M" then //Derecho Sepultacion
				if gs_rezago <> "S" THEN
					ls_estado_cadena 										= dw_datos_be.getitemstring(1,'cadena_estado')
					if ls_estado_cadena='V' or ls_estado_cadena='C' or ls_estado_cadena='S' then
						if gs_base='O' or gs_base='C' or gs_base='U' or gs_base='M' then
							tab_ingreso.tp_be.rb_be_uf.visible			= true
							tab_ingreso.tp_be.rb_be_peso.visible		= false
							tab_ingreso.tp_be.rb_be_uf.checked		= true
							tab_ingreso.tp_be.rb_be_peso.visible		= false
							if rb_be_uf.checked=true then 
								dw_detalle_be.SetItem(dw_detalle_be.getrow(), "moneda",'U')
							elseif rb_be_peso.checked=true then 
								dw_detalle_be.SetItem(dw_detalle_be.getrow(), "moneda",'P')
							end if
							if this.getitemnumber(row,'cantidad') <= 1 or isnull(this.getitemnumber(row,'cantidad')) then SetItem(row, "cantidad", 1)
						else
							messagebox("Advertencia","No es Posible Ingresar M-Derecho Sepultura para este Tipo de Contrato")
							SetItem(row, "monto", 0)
							SetItem(row, "cantidad", 0)
							dw_detalle_be.setfocus()
							dw_detalle_be.setcolumn('tipo_cob')
						end if
					else
						tab_ingreso.tp_be.rb_be_uf.visible		= false
						tab_ingreso.tp_be.rb_be_peso.visible	= false
						tab_ingreso.tp_be.rb_be_uf.checked		= false
						tab_ingreso.tp_be.rb_be_peso.visible	= true
						messagebox("Advertencia","Recuerde que Contrato debe estar V-Vigente o C-Cancelado")
						SetItem(row, "monto", 0)
						SetItem(row, "cantidad", 0)
						dw_detalle_be.setfocus()
						dw_detalle_be.setcolumn('tipo_cob')
					end if
				else
					tab_ingreso.tp_be.rb_be_uf.visible			= true
					tab_ingreso.tp_be.rb_be_peso.visible		= true
					tab_ingreso.tp_be.rb_be_uf.checked			= true
					if rb_be_uf.checked=true then 
						dw_detalle_be.SetItem(dw_detalle_be.getrow(), "moneda",'U')
					elseif rb_be_peso.checked=true then 
						dw_detalle_be.SetItem(dw_detalle_be.getrow(), "moneda",'P')
					end if
					if this.getitemnumber(row,'cantidad') <= 1 or isnull(this.getitemnumber(row,'cantidad')) then SetItem(row, "cantidad", 1)
				end if
				
			elseIF ls_tipo_cob = "A" or ls_tipo_cob = "Q" THEN //pie
				IF gs_rezago <> "S" THEN
					ls_estado_cadena 		= dw_datos_be.getitemstring(1,'cadena_estado')
					if (gs_base='O' or gs_base='U' or gs_base='M') and dw_datos_be.DataObject='d_datos_cuenta_ci_oferta' then
						ll_ctas				= dw_datos_be.getitemnumber(1,'pago_oferta_nro_cuotas')
						ll_ctas_pagadas	= dw_datos_be.getitemnumber(1,'oferta_v_cta_pag_s')
						ld_pie_pactado		= dw_datos_be.getitemnumber(1,'pago_oferta_pie')
						
					elseif gs_base='P' and dw_datos_be.DataObject='d_datos_cuenta_ci_pagare' then
						ll_ctas				= dw_datos_be.getitemnumber(1,'pagare_plazo')
						ll_ctas_pagadas_1	= dw_datos_be.getitemnumber(1,'pagare_cta_pag_la')
						ll_ctas_pagadas_2	= dw_datos_be.getitemnumber(1,'pagare_cta_pag_isa')
						ll_ctas_pagadas	= ll_ctas_pagadas_1 + ll_ctas_pagadas_2
						ld_pie_pactado		= dw_datos_be.getitemnumber(1,'pagare_pie')
						
					elseif gs_base='L' and dw_datos_be.DataObject='d_datos_cuenta_ci_liberador' then
						ll_ctas				= dw_datos_be.getitemnumber(1,'pago_liberador_nro_cuotas')
						ll_ctas_pagadas	= dw_datos_be.getitemnumber(1,'anexo_liberador_cta_pag_m')
						ld_pie_pactado		= dw_datos_be.getitemnumber(1,'pago_liberador_pie')
						
					elseif (gs_base='F' or gs_base='G' or gs_base='V') and dw_datos_be.DataObject='d_datos_cuenta_ci_funeraria' then
						ll_ctas				= dw_datos_be.getitemnumber(1,'producto_pago_plazo')
						ll_ctas_pagadas	= dw_datos_be.getitemnumber(1,'producto_anexo_cuotas_pag')
						ld_pie_pactado		= dw_datos_be.getitemnumber(1,'producto_pago_pie')
						
					elseif gs_base='D' and dw_datos_be.DataObject='d_datos_cuenta_ci_derecho' then
						ll_ctas				= dw_datos_be.getitemnumber(1,'derecho_plazo')
						ll_ctas_pagadas_1	= dw_datos_be.getitemnumber(1,'derecho_cta_pag_la')
						ll_ctas_pagadas_2	= dw_datos_be.getitemnumber(1,'derecho_cta_pag_isa')
						ll_ctas_pagadas	= ll_ctas_pagadas_1 + ll_ctas_pagadas_2
						ld_pie_pactado		= dw_datos_be.getitemnumber(1,'derecho_pie')
						
					elseif gs_base='A' and dw_datos_be.DataObject='d_datos_cuenta_ci_aumento_capacidad' then
						ll_ctas				= dw_datos_be.getitemnumber(1,'pago_aumento_nro_cuotas')
						ll_ctas_pagadas	= dw_datos_be.getitemnumber(1,'anexo_aumento_cta_pag_m')
						ld_pie_pactado		= dw_datos_be.getitemnumber(1,'pago_aumento_pie')
						
					elseif gs_base='R' and dw_datos_be.DataObject='dw_repacta_mant_descripcion_traspaso' then
						ll_ctas				= 0
						ll_ctas_pagadas	= 0
						ld_pie_pactado		= 0
					end if
					if gs_base<>'C' then
						if gs_base = 'O' or gs_base='U' or gs_base='M' then
							messagebox("Advertencia","No es Posible Ingresar Cuota, debe Generar CI")
							SetItem(row, "monto", 0)
							SetItem(row, "cantidad", 0)
							dw_detalle_be.setfocus()
							dw_detalle_be.setcolumn('tipo_cob')
						elseif gs_base = 'P' and ll_cod_parque<>101 then
							messagebox("Advertencia","No es Posible Ingresar Cuota, debe Generar CI")
							SetItem(row, "monto", 0)
							SetItem(row, "cantidad", 0)
							dw_detalle_be.setfocus()
							dw_detalle_be.setcolumn('tipo_cob')
						elseif ld_pie_pactado=0 or isnull(ld_pie_pactado) then
							messagebox("Advertencia","No es Posible Ingresar A-Pie, NO tiene Valor")
							SetItem(row, "monto", 0)
							SetItem(row, "cantidad", 0)
							dw_detalle_be.setfocus()
							dw_detalle_be.setcolumn('tipo_cob')
						else
							if ll_ctas_pagadas>=ll_ctas and ls_estado_cadena='C' then
								messagebox("Advertencia","No es Posible Ingresar A-Pie")
								SetItem(row, "monto", 0)
								SetItem(row, "cantidad", 0)
								dw_detalle_be.setfocus()
								dw_detalle_be.setcolumn('tipo_cob')
							else
								if gs_base='O' or gs_base='U' or gs_base='M' then
									if dw_datos_be.getitemnumber(1,'pago_oferta_pie') > 0 and &
										dw_datos_be.getitemnumber(1,'pago_oferta_ctas_pagadas_pie') >= dw_datos_be.getitemnumber(1,'pago_oferta_ctas_pactadas_pie') and dw_datos_be.getitemnumber(1,'pago_oferta_ctas_pactadas_pie') > 0 then
										ls_pasa	= 'N'
									else
										ls_pasa	= 'S'
									end if
									if ls_pasa='N' then
										if dw_datos_be.getitemnumber(1,'c_valor_pie_pesos') > 0 and dw_datos_be.getitemnumber(1,'pago_oferta_pie_pagado') > 0  then
											ls_pasa	= 'N'
										else
											ls_pasa	= 'S'
										end if
									end if
									//	valida PIE Promesa
									if ls_pasa='S' then
										ll_fila_pie 		= dw_detalle_be.Find("tipo_cob ='A' or tipo_cob ='Q'",1, ll_tot_reg)
										if ll_fila_Pie > 0 then
											ll_monto_pie_ingreso		= round(dw_detalle_be.getitemnumber(dw_detalle_be.getrow(),'c_total_linea'),0)
										else
											ll_monto_pie_ingreso		= 0
										end if
										if isnull(ll_monto_pie_ingreso) then ll_monto_pie_ingreso=0
										ldb_valor_pie_reg				= round(f_valida_pie_pagado(gs_base, gs_serie, gi_numero, dw_datos_be.getitemstring(1,'pago_oferta_moneda')),0)
										if ldb_valor_pie_reg + ll_monto_pie_ingreso > ld_pie_pactado  then
											ls_pasa	= 'N'
										else
											ls_pasa	= 'S'
										end if
									end if
								elseif gs_base='L' then
									if dw_datos_be.getitemnumber(1,'pago_liberador_pie') > 0 and &
										dw_datos_be.getitemnumber(1,'pago_liberador_ctas_pagadas_pie') >= dw_datos_be.getitemnumber(1,'pago_liberador_ctas_pactadas_pie') and dw_datos_be.getitemnumber(1,'pago_liberador_ctas_pactadas_pie') > 0 then
										ls_pasa	= 'N'
									else
										ls_pasa	= 'S'
									end if
									if ls_pasa='S' then
										if dw_datos_be.getitemnumber(1,'c_valor_pie_pesos') > 0 and dw_datos_be.getitemnumber(1,'pago_liberador_pie_pagado')>0 and dw_datos_be.getitemnumber(1,'pago_liberador_ctas_pagadas_pie') = dw_datos_be.getitemnumber(1,'pago_liberador_ctas_pactadas_pie') then
											ls_pasa	= 'N'
										else
											ls_pasa	= 'S'
										end if
									end if
									//	valida PIE Liberador
									if ls_pasa='S' then
										ll_fila_pie 		= dw_detalle_be.Find("tipo_cob ='A' or tipo_cob ='Q'",1, ll_tot_reg)
										if ll_fila_Pie > 0 then
											ll_monto_pie_ingreso		= round(dw_detalle_be.getitemnumber(dw_detalle_be.getrow(),'c_total_linea'),0)
										else
											ll_monto_pie_ingreso		= 0
										end if
										if isnull(ll_monto_pie_ingreso) then ll_monto_pie_ingreso=0
										ldb_valor_pie_reg				= round(f_valida_pie_pagado(gs_base, gs_serie, gi_numero, dw_datos_be.getitemstring(1,'pago_liberador_moneda')),0)
										if ldb_valor_pie_reg + ll_monto_pie_ingreso > ld_pie_pactado  then
											ls_pasa	= 'N'
										else
											ls_pasa	= 'S'
											ldb_pie_pesos				= round(dw_datos_be.getitemnumber(1,'c_valor_pie_pesos'),0)
											if dw_datos_be.getitemnumber(1,'pago_liberador_ctas_pactadas_pie')=0 and ldb_pie_pesos > 0 then
												this.SetItem(row, "monto", dw_datos_be.GetItemNumber(1,"c_valor_pie_pesos"))
												this.accepttext()
											end if
										end if
									end if
								elseif gs_base='F' or gs_base='G' or gs_base='V' then
									if dw_datos_be.getitemnumber(1,'producto_pago_pie') > 0 and &
										dw_datos_be.getitemnumber(1,'producto_pago_ctas_pie_pagadas') >= dw_datos_be.getitemnumber(1,'producto_pago_ctas_pie_plazo') and dw_datos_be.getitemnumber(1,'producto_pago_ctas_pie_plazo') > 0 then
										ls_pasa	= 'N'
									else
										ls_pasa	= 'S'
									end if
									if ls_pasa='S' then
										if dw_datos_be.getitemnumber(1,'c_valor_pie_pesos') = dw_datos_be.getitemnumber(1,'producto_pago_pie_pagado') and dw_datos_be.getitemnumber(1,'c_valor_pie_pesos') > 0 and dw_datos_be.getitemnumber(1,'producto_pago_pie_pagado') > 0 and dw_datos_be.getitemnumber(1,'producto_pago_ctas_pie_pagadas') = dw_datos_be.getitemnumber(1,'producto_pago_ctas_pie_plazo') then
											ls_pasa	= 'N'
										else
											ls_pasa	= 'S'
										end if
									end if
									//	valida PIE Funeraria
									if ls_pasa='S' then
										ll_cod_servicio	= dw_datos_be.getitemnumber(1,'producto_pago_codigo_servicio')
										ll_fila_pie 		= dw_detalle_be.Find("tipo_cob ='A' or tipo_cob ='Q'",1, ll_tot_reg)
										if ll_fila_Pie > 0 then
											ll_monto_pie_ingreso		= round(dw_detalle_be.getitemnumber(dw_detalle_be.getrow(),'c_total_linea'),0)
											dw_detalle_be.setitem(dw_detalle_be.getrow(),'cod_servicio',ll_cod_servicio)
										else
											ll_monto_pie_ingreso		= 0
										end if
										if isnull(ll_monto_pie_ingreso) then ll_monto_pie_ingreso=0
										if ll_monto_pie_ingreso=0 then
											ll_monto_pie_ingreso		= dw_datos_be.getitemnumber(1,'producto_pago_pie')
										end if
										ls_moneda_prod				= dw_datos_be.getitemstring(1,'producto_pago_moneda')
										
										ldb_valor_pie_reg				= round(f_valida_pie_pagado(gs_base, gs_serie, gi_numero, dw_datos_be.getitemstring(1,'producto_pago_moneda')),0)
										if ls_moneda_prod='1' then
											if ll_monto_pie_ingreso > 100 then
												ldb_valor_def_pie		= ll_monto_pie_ingreso
											else
												ldb_valor_def_pie		= round(ll_monto_pie_ingreso / gd_uf, 2)
											end if
											if ldb_valor_pie_reg > 100 then
												ldb_valor_def_reg		= ldb_valor_pie_reg
											else
												ldb_valor_def_reg		= round(ldb_valor_pie_reg / gd_uf, 2)
											end if
										elseif ls_moneda_prod='2' then
											if ll_monto_pie_ingreso > 100 then
												ldb_valor_def_pie		= round(ll_monto_pie_ingreso / gd_uf, 2)
											else
												ldb_valor_def_pie		= ll_monto_pie_ingreso
											end if
											if ldb_valor_pie_reg > 100 then
												ldb_valor_def_reg		= round(ldb_valor_pie_reg / gd_uf, 2)
											else
												ldb_valor_def_reg		= ldb_valor_pie_reg
											end if
										end if
	//									if ldb_valor_pie_reg + ll_monto_pie_ingreso > ld_pie_pactado  then
										if round(ldb_valor_def_reg + ldb_valor_def_pie,2) > round(ld_pie_pactado,2)  then
											ls_pasa	= 'N'
										else
											ls_pasa	= 'S'
											
											if gs_base='F' or gs_base='G' then
												if ls_moneda_prod='1' then
													rb_be_uf.checked			= false
													rb_be_peso.checked		= true
													dw_detalle_be.SetItem(dw_detalle_be.getrow(), "moneda",'P')
													dw_detalle_be.SetItem(dw_detalle_be.getrow(), "cantidad",1)
												elseif ls_moneda_prod='2' then
													rb_be_uf.checked			= true
													rb_be_peso.checked		= false 
													dw_detalle_be.SetItem(dw_detalle_be.getrow(), "moneda",'U')
													dw_detalle_be.SetItem(dw_detalle_be.getrow(), "cantidad",1)
												end if
												if ls_moneda_prod='1' then
													dw_detalle_be.setitem(dw_detalle_be.getrow(),'monto_uf', round( ll_monto_pie_ingreso / gd_uf,4))
													dw_detalle_be.setitem(dw_detalle_be.getrow(),'monto', ll_monto_pie_ingreso)
													
												elseif ls_moneda_prod='2' then
													dw_detalle_be.setitem(dw_detalle_be.getrow(),'monto_uf', ll_monto_pie_ingreso)
													dw_detalle_be.setitem(dw_detalle_be.getrow(),'monto', round( ll_monto_pie_ingreso * gd_uf,0)  )
												end if
											end if
	//										if ls_moneda_insert = '1' then
	//											dw_detalle_be.setitem(ll_new_iva,'monto_uf', round( ll_iva_f / gd_uf,4))
	//											dw_detalle_be.setitem(ll_new_iva,'monto', ll_iva_f)
	//										end if
	
										end if
										dw_detalle_be.accepttext()
									end if
								elseif gs_base='A' then
									if dw_datos_be.getitemnumber(1,'pago_aumento_pie') > 0 and &
										dw_datos_be.getitemnumber(1,'pago_aumento_ctas_pagadas_pie') >= dw_datos_be.getitemnumber(1,'pago_aumento_ctas_pactadas_pie') and dw_datos_be.getitemnumber(1,'pago_aumento_ctas_pactadas_pie') > 0 then
										ls_pasa	= 'N'
									else
										ls_pasa	= 'S'
									end if
									//	valida PIE Aumento
									if ls_pasa='S' then
										ll_fila_pie 		= dw_detalle_be.Find("tipo_cob ='A' or tipo_cob ='Q'",1, ll_tot_reg)
										if ll_fila_Pie > 0 then
											ll_monto_pie_ingreso		= round(dw_detalle_be.getitemnumber(dw_detalle_be.getrow(),'c_total_linea'),0)
										else
											ll_monto_pie_ingreso		= 0
										end if
										if isnull(ll_monto_pie_ingreso) then ll_monto_pie_ingreso=0
										ldb_valor_pie_reg				= round(f_valida_pie_pagado(gs_base, gs_serie, gi_numero, dw_datos_be.getitemstring(1,'pago_aumento_moneda')),0)
										if ldb_valor_pie_reg + ll_monto_pie_ingreso > ld_pie_pactado  then
											ls_pasa	= 'N'
										else
											ls_pasa	= 'S'
											ldb_pie_pesos				= round(dw_datos_be.getitemnumber(1,'c_valor_pie_pesos'),0)
											if dw_datos_be.getitemnumber(1,'pago_aumento_ctas_pactadas_pie')=0 and ldb_pie_pesos > 0 then
												this.SetItem(row, "monto", dw_datos_be.GetItemNumber(1,"c_valor_pie_pesos"))
												this.SetItem(row, "cantidad", 1)
												this.accepttext()
											end if
										end if
									end if
								elseif gs_base='D' then
									if dw_datos_be.getitemnumber(1,'c_valor_pie_pesos') > 0 and dw_datos_be.getitemnumber(1,'derecho_pie_pagado')>0 then
										ls_pasa	= 'N'
									else
										ls_pasa	= 'S'
									end if
								elseif gs_base='R' then
									ls_pasa	= 'N'
								elseif gs_base='P' then
									if dw_datos_be.getitemnumber(1,'c_valor_pie_pesos') > 0 and dw_datos_be.getitemnumber(1,'pagare_pie_pagado')>0  then
										ls_pasa	= 'N'
									else
										ls_pasa	= 'S'
									end if
								end if
								if ls_pasa='N' then
									messagebox("Advertencia","No es Posible Ingresar A-Pie")
									SetItem(row, "monto", 0)
									SetItem(row, "cantidad", 0)
									dw_detalle_be.setfocus()
									dw_detalle_be.setcolumn('tipo_cob')
								else								
									gs_grabar_pie	= 'N'
									if ((gs_base='F' or gs_base='G') and ls_tipo_cob = 'A') or ((gs_base='F' or gs_base='G') and ls_tipo_cob = 'Q') then
										gs_tipo_cobro			= 'BA'
									end if
									SELECT 	Count("DETALLE_PAGO_PIE"."BASE")
									INTO 		:ll_count_pie_pac  
									FROM 	"DETALLE_PAGO_PIE"  
									WHERE 	( "DETALLE_PAGO_PIE"."BASE" = :gs_base ) AND  
												( "DETALLE_PAGO_PIE"."SERIE" = :gs_serie ) AND  
												( "DETALLE_PAGO_PIE"."NUMERO" = :gi_numero ) AND  
												( "DETALLE_PAGO_PIE"."ESTADO" = 'P' )   ;
									if ll_count_pie_pac > 0 then
										ls_texto			= gs_base+'~t'+gs_serie+'~t'+string(gi_numero)+'~t'+gs_tipo_cobro+'~t'+trim(sle_numero_be.text)
										openwithparm(w_ingreso_pago_pie_pactado,ls_texto)
										if Message.StringParm = 'N' then
											if this.getitemnumber(row,'cantidad') <= 1 or isnull(this.getitemnumber(row,'cantidad')) then SetItem(row, "cantidad", 1)
											this.SetItem(row, "monto", dw_datos_be.GetItemNumber(1,"c_valor_pie_pesos"))
											this.accepttext()
											
										else
											w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.accepttext()
											w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setfocus()
	//										w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.triggerevent(itemchanged!)
										end if
									end if
								end if
							end if
						end if
					else
						messagebox("Advertencia","No es Posible Ingresar A-Pie a Contrato")
						SetItem(row, "monto", 0)
						SetItem(row, "cantidad", 0)
						dw_detalle_be.setfocus()
						dw_detalle_be.setcolumn('tipo_cob')
					end if
				else
					if this.getitemnumber(row,'cantidad') <= 1 or isnull(this.getitemnumber(row,'cantidad')) then SetItem(row, "cantidad", 1)
					SetItem(row, "monto", 0)
					w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.accepttext()
				end if
			ELSEIF ls_tipo_cob = "K" THEN
				if not isnull(ls_descrip_estado) then
					if gs_rezago <> "S" then
						messagebox("Advertencia","Para aplicar este Tipo de Cobro el Estado del Contrato debe estar en: S-Seguro Desgravamen, actualmente se encuentra en: "+ls_descrip_estado)
					else
						messagebox("Advertencia","Para aplicar este Tipo de Cobro el Estado del Contrato debe estar en: S-Seguro Desgravamen, actualmente se está ingresando como Rezago")
					end if
				else
					messagebox("Advertencia","No es Posible Ingresar K-Seguro Desgravamen")
				end if
				SetItem(row, "monto", 0)
				SetItem(row, "cantidad", 0)
				dw_detalle_be.setfocus()
				dw_detalle_be.setcolumn('tipo_cob')
			elseif ls_tipo_cob = 'D' or ls_tipo_cob='V' or ls_tipo_cob='X' then
				ll_new_iva						= dw_detalle_be.Find("tipo_cob = 'F'", 1, dw_detalle_be.rowcount())
				if ll_new_iva > 0 then
					messagebox("Advertencia","No es Posible Ingresar IVA, debe existir asociado pago F-Cuota Mantención o E-Cuota Credito Anexo Liberador")
					SetItem(row, "monto", 0)
					SetItem(row, "cantidad", 0)
					dw_detalle_be.setfocus()
					dw_detalle_be.setcolumn('tipo_cob')
				else
					dw_detalle_be.accepttext()
					if gs_rezago = 'S' then
						ll_fila_iva_a				= dw_detalle_be.Find("tipo_cob = 'A' or tipo_cob = 'E' or tipo_cob='M' ", 1, dw_detalle_be.rowcount())
						if ll_fila_iva_a > 0 then
							if ls_tipo_cob = 'D' then
								ll_monto_pie_rez	= dw_detalle_be.getitemnumber(ll_fila_iva_a,'c_total_linea')		//'monto_uf')
								if isnull(ll_monto_pie_rez) or ll_monto_pie_rez=0 then
									ll_cantidad			= dw_detalle_be.getitemnumber(ll_fila_iva_a,'cantidad')
									ll_monto_pie_rez	= dw_detalle_be.getitemnumber(ll_fila_iva_a,'c_total_linea'	)   //'monto')
									ll_iva_pie_rez		= round(ll_monto_pie_rez * (idb_iva - 1),4)
									dw_detalle_be.setitem(ll_fila_iva_a,'cantidad',1)
									dw_detalle_be.setitem(row,'monto',ll_iva_pie_rez)
									dw_detalle_be.setitem(row,'monto_uf', round( ll_iva_pie_rez / gd_uf,4))
								else
									ll_iva_pie_rez		= round(ll_monto_pie_rez * (idb_iva - 1),4)
									dw_detalle_be.setitem(row,'cantidad',1)
									dw_detalle_be.setitem(row,'monto_uf',round( ll_iva_pie_rez / gd_uf,4))
									dw_detalle_be.setitem(row,'monto',  ll_iva_pie_rez )
								end if
							else
								messagebox("Advertencia","Para Rezago, solo es posible Ingresar Item D-Iva Cuota")
								dw_detalle_be.setitem(row,'cantidad', ll_nulo)
								dw_detalle_be.setitem(row,'monto_uf', ll_nulo)
								dw_detalle_be.setitem(row,'monto', ll_nulo)
							end if
							dw_detalle_be.accepttext()
						end if
					end if
	//				aca voy mirko
				end if
				
			ELSEIF ls_tipo_cob = "L" or ls_tipo_cob = "S" THEN
				SetItem(this.getrow(), "monto", 0)
				if this.getitemnumber(this.getrow(),'cantidad') <= 1 or isnull(this.getitemnumber(this.getrow(),'cantidad')) then 
					this.SetItem(this.getrow(), "cantidad", 1)
				end if
				ls_texto			= ls_tipo_cob+'~t'+ls_tipo_comp
				// VHFB -- INCIO -- CONTROL DE INGRESO AUTOMATICO	
				if gb_aplica = false then
				openwithparm(w_apertura_tipo_cobro_otros,ls_texto)
				END IF 
				// VHFB -- TERMINO -- CONTROL DE INGRESO AUTOMATICO			
	
			ELSEIF ls_tipo_cob = "4" or ls_tipo_cob = "6" THEN
				ll_fila_cred		= dw_detalle_be.Find("tipo_cob = 'E' or tipo_cob = 'U'", 1, dw_detalle_be.RowCount())
				if ll_fila_cred = 0 then
					messagebox("Advertencia","No es Posible Ingresar Tipo Cobro, debe existir Pago Crédido")
					dw_detalle_be.SetItem(this.getrow(), "monto", 0)
					dw_detalle_be.SetItem(this.getrow(), "cantidad", 0)
					dw_detalle_be.setfocus()
					dw_detalle_be.setcolumn('tipo_cob')	
				end if
			else
				if this.rowcount() > 0 then
					if this.getitemnumber(this.getrow(),'cantidad') <= 1 or isnull(this.getitemnumber(this.getrow(),'cantidad')) then SetItem(this.getrow(), "cantidad", 1)
					SetItem(row, "monto", 0)
				end if
			END IF
		END IF
		
		
		//----------------------------------------------------------------------
		// is_columna = "tipo_cob"
		//----------------------------------------------------------------------
		
		IF is_columna = "monto_uf" and rb_be_uf.checked=true THEN
			ld_monto		= this.getitemnumber(row,'monto_uf')
			wf_cargar_monto_uf(ld_monto, il_cantidad_malo, row )
		end if
					
					
					
		//----------------------------------------------------------------------
		// is_columna = "monto" or is_columna='monto_uf'
		//----------------------------------------------------------------------					
					
		IF is_columna = "monto" or is_columna='monto_uf' THEN
			this.accepttext()
			if is_columna = "monto" then
				ld_monto					= this.getitemnumber(row,'monto')
			elseif  is_columna='monto_uf' then
				ld_monto					= this.getitemnumber(row,'monto_uf')
			end if
			ll_monto_cuota_reg		= tab_ingreso.tp_be.dw_detalle_be.getitemnumber(tab_ingreso.tp_be.dw_detalle_be.getrow(),'c_total_linea')
			ll_fila_fm						= dw_detalle_be.Find("tipo_cob = 'F' or tipo_cob='E'", 1, dw_detalle_be.rowcount())
			if ll_fila_fm > 0 and gs_tipo_cobro = 'BA' then
				ii_cantidad 				= GetItemNumber(ll_fila_fm, "cantidad")
			else
				ii_cantidad 				= GetItemNumber(row, "cantidad")
			end if
			if isnull(ii_cantidad) or ii_cantidad = 0 then ii_cantidad=1
			ll_cuota_ini					= ll_ctas_pag_m + 1
			ll_cuota_fin					= (ll_cuota_ini + ii_cantidad) - 1
			wf_cargar_monto(ld_monto, il_cantidad_malo, row, ld_pie_pactado,ll_cuota_ini,ll_cuota_fin, ii_cantidad )
	
		end if
		if isvalid(w_ingreso2) then
			w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.accepttext()
			if w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.rowcount() = 0 then w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.insertrow(0)
			ll_gasto_cob					= w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.getitemnumber(1,'gastos_cob')
			ll_mora						= w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.getitemnumber(1,'mora')
			ll_incluir_gastos			= w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.getitemnumber(1,'incluir_gastos')
			if ll_gasto_cob > 0 then
				// Mantener Valores
			else
				w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1,'gastos_cob', 0)
				w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1,'gasto_cred', 0)
				w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1,'gasto_mant', 0)
			end if
			if ll_mora > 0 then
				// Mantener Valores
			else
				w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1,'mora', 0)
				w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1,'mora_cred', 0)
				w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1,'mora_mant', 0)
			end if
			if ll_incluir_gastos = 0 then
				// Mantener Valores
			else
				w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1,'incluir_gastos', 1)
			end if
			dw_gastos_be.SetItem(1, "Subtotal",dw_detalle_be.GetItemNumber(1,"c_subtotal"))
			dw_gastos_be.accepttext()
			w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.accepttext()
		end if
		fila 						= row
		ll_cantidad				= Long(tab_ingreso.tp_be.dw_detalle_be.rowcount())
		
		
		
		//----------------------------------------------------------------------
		// is_columna = "cantidad" AND (ls_tipo_cob = "E" or ls_tipo_cob = "U") AND gs_rezago <> "S" and gs_base <> 'C' AND dw_detalle_be.rowcount() > 0
		//----------------------------------------------------------------------		
		
		IF is_columna = "cantidad" AND (ls_tipo_cob = "E" or ls_tipo_cob = "U") AND gs_rezago <> "S" and gs_base <> 'C' AND dw_detalle_be.rowcount() > 0  THEN
			if dw_detalle_be.GetItemNumber(row, "cantidad") > 0 then
				wf_actualizar_abono(ls_tipo_cob)
				ii_cantidad 		= GetItemNumber(row, "cantidad")
				
				DECLARE x2 CURSOR FOR  
				SELECT	"SEGURO_ASOCIADOS"."COD_SEGURO"  
				FROM 	"SEGURO_ASOCIADOS"  
				WHERE ( "SEGURO_ASOCIADOS"."BASE" = :gs_base ) AND  
						  ( "SEGURO_ASOCIADOS"."SERIE" = :gs_serie ) AND  
						  ( "SEGURO_ASOCIADOS"."NUMERO" = :gi_numero ) AND  
						  ( "SEGURO_ASOCIADOS"."ESTADO_REG" = 0 ) AND  
						  ( "SEGURO_ASOCIADOS"."ESTADO_SEGURO" = 'A' )   
	//					  ( "SEGURO_ASOCIADOS"."COD_SEGURO" <> 8 )
				USING	sqlca;
				open x2;
				if sqlca.sqlcode=0 then
					do while sqlca.sqlcode=0
						fetch x2 into :ll_cod_seguro;
						if not isnull(ll_cod_seguro) then
							ll_fila		= dw_detalle_be.Find("tipo_cob = '"+string(ll_cod_seguro)+"'",1, dw_detalle_be.RowCount())
							dw_detalle_be.setitem(ll_fila,'cantidad',ii_cantidad)
						end if
						setnull(ll_cod_seguro)
					loop
				end if
				close x2;
				dw_detalle_be.accepttext()
				if (gs_base='O' or gs_base='U' or gs_base='M') and dw_datos_be.DataObject='d_datos_cuenta_ci_oferta' then
					ll_ctas				= dw_datos_be.getitemnumber(1,'pago_oferta_nro_cuotas')
					ll_ctas_pagadas	= dw_datos_be.getitemnumber(1,'oferta_v_cta_pag_s')
				elseif gs_base='P' and dw_datos_be.DataObject='d_datos_cuenta_ci_pagare' then
					ll_ctas				= dw_datos_be.getitemnumber(1,'pagare_plazo')
					ll_ctas_pagadas_1	= dw_datos_be.getitemnumber(1,'pagare_cta_pag_la')
					ll_ctas_pagadas_2	= dw_datos_be.getitemnumber(1,'pagare_cta_pag_isa')
					ll_ctas_pagadas	= ll_ctas_pagadas_1 + ll_ctas_pagadas_2
				elseif gs_base='L' and dw_datos_be.DataObject='d_datos_cuenta_ci_liberador' then
					ll_ctas				= dw_datos_be.getitemnumber(1,'pago_liberador_nro_cuotas')
					ll_ctas_pagadas	= dw_datos_be.getitemnumber(1,'anexo_liberador_cta_pag_m')
				elseif (gs_base='F' or gs_base='G' or gs_base='V') and dw_datos_be.DataObject='d_datos_cuenta_ci_funeraria' then
					ll_ctas				= dw_datos_be.getitemnumber(1,'producto_pago_plazo')
					ll_ctas_pagadas	= dw_datos_be.getitemnumber(1,'producto_anexo_cuotas_pag')
				elseif gs_base='D' and dw_datos_be.DataObject='d_datos_cuenta_ci_derecho' then
					ll_ctas				= dw_datos_be.getitemnumber(1,'derecho_plazo')
					ll_ctas_pagadas_1	= dw_datos_be.getitemnumber(1,'derecho_cta_pag_la')
					ll_ctas_pagadas_2	= dw_datos_be.getitemnumber(1,'derecho_cta_pag_isa')
					ll_ctas_pagadas	= ll_ctas_pagadas_1 + ll_ctas_pagadas_2
				elseif gs_base='A' and dw_datos_be.DataObject='d_datos_cuenta_ci_aumento_capacidad' then
					ll_ctas				= dw_datos_be.getitemnumber(1,'pago_aumento_nro_cuotas')
					ll_ctas_pagadas	= dw_datos_be.getitemnumber(1,'anexo_aumento_cta_pag_m')
				elseif gs_base='R' and dw_datos_be.DataObject='dw_repacta_mant_descripcion_traspaso' then
					ll_ctas				= dw_datos_be.getitemnumber(1,'cuotas_pactadas')
					ll_ctas_pagadas	= dw_datos_be.getitemnumber(1,'ctas_pagadas')
				end if
				if (ll_ctas_pagadas + ii_cantidad) > ll_ctas then
					wf_limpiar_dw_registro(row)
					RETURN 1
				else
					if this.getitemnumber(row,'cantidad') <= 1 or isnull(this.getitemnumber(row,'cantidad')) then SetItem(row, "cantidad", 1)
					ll_monto_cred					= round(dw_datos_be.GetItemNumber(1,"c_valor_cuota_pesos"),0)
					ll_monto_mora_cred			= wf_calcular_mora(row)
					SELECT	SUM("ABONO_CTA_CTE"."MONTO")  
					INTO 		:ll_sum_monto_abono  
					FROM 	"ABONO_CTA_CTE"  
					WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
							 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
							 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero )  AND 
							 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
					USING		sqlca;
					if ll_sum_monto_abono > 0 then
						ll_monto_cta				= ll_monto_cred * this.getitemnumber(row,'cantidad')
						if ll_sum_monto_abono >= (ll_monto_cta + ll_monto_mora_cred) then
							ll_monto_final_cred	= round(ll_sum_monto_abono - (ll_monto_cta + ll_monto_mora_cred),0)
							ll_res_abono			= messagebox("Advertencia Abono","En su Cuenta Corriente Existe Abonado $ "+string(ll_sum_monto_abono,'###,###,###,###,##0')+", se descontará por Concepto Crédito $ "+string((ll_monto_cta + ll_monto_mora_cred) - 1,'###,###,###,###,##0')+", quedando a su Favor $ "+string(ll_monto_final_cred,'###,###,###,###,##0')+"... desea utilizar Abono Existente",Exclamation!,YesNo!,2)
							if ll_res_abono=1 then
								SetItem(row, "monto", ll_monto_cred)
								ll_monto_final_cred ++
								UPDATE	"ABONO_CTA_CTE"  
								SET 		"TIPO_COB_OCUPA" = :gs_tipo_cobro,   
											"FOLIO_OCUPA" = :ll_folio,   
											"FECHA_OCUPA" = :ldt_fecha_hoy,   
											"MONTO_OCUPA" = (:ll_monto_cta + :ll_monto_mora_cred) - 1,   
											"USUARIO_OCUPA" = :gs_user,   
											"CAJA_OCUPA" = :gs_caja,   
											"ESTADO_REG" = 'O',
											"TIPO_MOV_OCUPA" = 'E',
											"SW_ESTADO_TRANS" = 1  
								WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
										 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
										 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
										 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
								USING		sqlca;
								if sqlca.sqlcode=0 then
									commit;
									INSERT INTO "ABONO_CTA_CTE"  
												( "RUT",		"BASE",		"SERIE",		"NUMERO",	"TIPO_COB",	"FOLIO",		"MONTO",						"FECHA_CREA",		"USUARIO_CREA",	"CAJA_CREA",	"ESTADO_REG",	"TIPO_COB_OCUPA",	"FOLIO_OCUPA",	"FECHA_OCUPA",	"MONTO_OCUPA",	"USUARIO_OCUPA",	"CAJA_OCUPA",	"TIPO_MOV_OCUPA",	"SW_ESTADO_TRANS" )
									VALUES 	( :gi_rut,	:gs_base,	:gs_serie,	:gi_numero,:gs_tipo_cobro,			:ll_folio,	:ll_monto_final_cred,	:gdt_fec_sistema,	:gs_user,			:gs_caja,		'P',				null,					null,				null,				null,				null,					null,				null,					2 )  
									USING		sqlca;
									if sqlca.sqlcode=0 then
										commit;
									else
										rollback;
										messagebox("Error Grabar","Error al INSERTAR ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
									end if
								else
									rollback;
									messagebox("Error Grabar","Error al UPDATE ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
								end if
							else
								ll_monto_final_cred		= ll_monto_cred
								SetItem(row, "monto", ll_monto_cred )
							end if
						else
							ll_res_abono				= messagebox("Advertencia Abono","En su Cuenta Corriente Existe Abonado $ "+string(ll_sum_monto_abono,'###,###,###,###,##0')+", Monto a Cancelar es $ "+string(ll_monto_cta,'###,###,###,###,##0')+" y su Saldo quedará en 0... desea utilizar por Concepto Crédito Abono Existente",Exclamation!,YesNo!,2)
							if ll_res_abono=1 then
								SetItem(row, "monto", ll_monto_cred )
								UPDATE	"ABONO_CTA_CTE"  
								SET 		"TIPO_COB_OCUPA" = :gs_tipo_cobro,   
											"FOLIO_OCUPA" = :ll_folio,   
											"FECHA_OCUPA" = :ldt_fecha_hoy,   
											"MONTO_OCUPA" = :ll_sum_monto_abono,   
											"USUARIO_OCUPA" = :gs_user,   
											"CAJA_OCUPA" = :gs_caja,   
											"ESTADO_REG" = 'O',
											"TIPO_MOV_OCUPA" = 'E',
											"SW_ESTADO_TRANS" = 1  
								WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
										 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
										 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
										 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
								USING		sqlca;
								if sqlca.sqlcode=0 then
									commit;
								else
									rollback;
									messagebox("Error Grabar","Error al Update ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
								end if
							else
								ll_monto_final_cred		= ll_monto_cred
								SetItem(row, "monto", ll_monto_cred )
							end if
						end if
					else
						ll_monto_final_cred				= ll_monto_cred
						SetItem(row, "monto", ll_monto_cred )
					end if			
		
				end if
				wf_calcular_interes(ls_tipo_cob)
				dw_gastos_be.SetItem(1, "Subtotal",GetItemNumber(1,"c_subtotal"))
				dw_gastos_be.accepttext()
			end if
			
		elseIF is_columna = "cantidad" AND ls_tipo_cob = "F"  AND gs_rezago <> "S" AND this.rowcount() > 0 THEN	
			if  this.GetItemNumber(row, "cantidad") > 0 then
				wf_actualizar_abono(ls_tipo_cob)
				wf_calcular_cant_mant(row)
				wf_calcular_interes(ls_tipo_cob)
				dw_gastos_be.accepttext()
				//Script nuevo IVA Autor MM 22/12/2022
				wf_calcular_iva_mant(ll_ctas_pag_m)
	
			end if
		END IF
		
		// vhfb - inicion -  actualiza cantidad			
		 if  (gs_aplica_a ='M' or gs_aplica_a ='T') or  (gs_aplica_a ='C' and (ls_tipo_base = 'L' or ls_tipo_base = 'A' or ls_tipo_base = 'F' or ls_tipo_base = 'G'))  then		
			IF is_columna = "cantidad" AND (ls_tipo_cob = "F"  OR ((gs_aplica_a ='C'  OR gs_aplica_a ='T' ) and (ls_tipo_base = 'L'  or ls_tipo_base = 'A'   or ls_tipo_base = 'F'    or ls_tipo_base = 'R'    or ls_tipo_base = 'G' )) ) AND this.rowcount() > 0 THEN	
				wf_actualiza_cantidad_be();
			end if 
		end if 
		// vhfb - termino -  actualiza cantidad
			
		IF gs_rezago <> "S" and (ls_tipo_cob = "E" or ls_tipo_cob = "U") and gs_base<>'C' THEN
			dw_detalle_be.SetItem(row, "estado", 'S')
			wf_calcular_interes(ls_tipo_cob)
		elseif gs_rezago <> "S" and ls_tipo_cob = "F" THEN
			dw_detalle_be.SetItem(row, "estado", 'S')
			wf_calcular_interes(ls_tipo_cob)
		else
			dw_detalle_be.SetItem(row, "estado", 'N')
		end if
	
	elseif ls_estado_cadena<>'S' and ls_estado_cadena<>'V' and ls_estado_cadena<>'C' then
		messagebox("Advertencia","No es Posible Ingresar este Tipo de Cobro")
		dw_detalle_be.deleterow(row)
		fila 					= dw_detalle_be.InsertRow(0)
		dw_detalle_be.scrolltorow(fila)
		dw_detalle_be.SetItem(fila, "uf", gd_uf)
		dw_detalle_be.SetItem(fila, "folio", 0)
		if rb_be_afecta.checked=true then
			dw_detalle_be.SetItem(fila, "iva", idb_iva)
		end if
		dw_detalle_be.SetItem(fila, "estado", 'N')
		dw_detalle_be.SetItem(fila, "uf", gd_uf)
		if rb_be_uf.checked=true then
			dw_detalle_be.SetItem(fila, "moneda",'U')
		else
			dw_detalle_be.SetItem(fila, "moneda",'P')
		end if
		setnull(ls_tipo_cob);setnull(is_columna)
		dw_detalle_be.scrolltorow(row)
		dw_detalle_be.setfocus()
		dw_detalle_be.setcolumn('tipo_cob')
	end if
	
	ll_tot_reg		= dw_detalle_be.rowcount()
	if ll_tot_reg > 0 then
		ll_fila_gasto		= dw_detalle_be.Find( "tipo_cob = 'E' or tipo_cob ='F' or tipo_cob='A' or tipo_cob = 'Q' or tipo_cob ='U'",1, ll_tot_reg)
		if ll_fila_gasto =0 then
			dw_gastos_be.SetItem(1, "mora",0)
			dw_gastos_be.SetItem(1, "gastos_cob",0)
			
			dw_gastos_be.SetItem(1, "mora_cred",0)
			dw_gastos_be.SetItem(1, "mora_mant",0)
			dw_gastos_be.SetItem(1, "gasto_cred",0)
			dw_gastos_be.SetItem(1, "gasto_mant",0)
			
			dw_gastos_be.accepttext()
		end if
	end if
	w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.accepttext()
	il_fila_desc					= dw_detalle_be.getrow()
	ls_tipo_cob					= dw_detalle_be.getitemstring(il_fila_desc,'tipo_cob')
	if gs_codigo_otro = "" then gs_codigo_otro = '0'
	if ls_tipo_cob = 'S' and gs_codigo_otro <> '0' then
		gs_codigo_otro			= dw_detalle_be.getitemstring(il_fila_desc,'tipo_cob_otro')
		wf_validar_descuento()
	end if
	ll_monto								= dw_gastos_be.getitemnumber(1,'c_total')
	if ll_monto > 0 then 
		ls_string							= "tipo_cob_otro = '144' or tipo_cob_otro = '76' "
		ll_fila								= dw_detalle_be.Find(ls_string,  1, ll_tot_reg)
		if ll_fila > 0 then
			ls_tipo_cob	= dw_detalle_be.getitemstring(fila,'tipo_cob')
			dw_detalle_be.DeleteRow(ll_fila)
			wf_calcular_interes(ls_tipo_cob)
			dw_detalle_be.accepttext()
		end if
		cbx_paga_ef_be.checked			= false
	end if
	dw_detalle_be.accepttext()
	
	
	if (ls_tipo_cob = "D" or ls_tipo_cob = "E" or ls_tipo_cob = "A" or ls_tipo_cob = "U" or ls_tipo_cob="Q") and (gs_base='L' or gs_base='G' or gs_base='F') and gs_rezago <> 'S' then
		//Script nuevo IVA Autor MM 22/12/2022
		wf_calcular_iva_gl(ls_tipo_cob)
	end if
	
		//----------------------------------------------------------------------
		// is_columna = "monto" or is_columna='monto_uf' or is_columna='canidad'
		//----------------------------------------------------------------------
	
		IF is_columna = "monto" or is_columna='monto_uf' or is_columna='canidad' THEN
			this.accepttext()
			if is_columna = "monto" then
				ld_monto					= this.getitemnumber(row,'monto')
			elseif  is_columna='monto_uf' then
				ld_monto					= this.getitemnumber(row,'monto_uf')
			end if
			ll_monto_cuota_reg		= tab_ingreso.tp_be.dw_detalle_be.getitemnumber(tab_ingreso.tp_be.dw_detalle_be.getrow(),'c_total_linea')
			ll_fila_fm						= dw_detalle_be.Find("tipo_cob = 'F' or tipo_cob='E'", 1, dw_detalle_be.rowcount())
			if ll_fila_fm > 0 and gs_tipo_cobro = 'BA' then
				ii_cantidad 				= GetItemNumber(ll_fila_fm, "cantidad")
			else
				ii_cantidad 				= GetItemNumber(row, "cantidad")
			end if
			if isnull(ii_cantidad) or ii_cantidad = 0 then ii_cantidad=1
			ll_cuota_ini					= ll_ctas_pag_m + 1
			ll_cuota_fin					= (ll_cuota_ini + ii_cantidad) - 1
			wf_cargar_monto(ld_monto, il_cantidad_malo, row, ld_pie_pactado,ll_cuota_ini,ll_cuota_fin, ii_cantidad )
	
		end if
	//if is_columna = "cantidad" or is_columna="monto" or is_columna="monto_uf" then
	//	wf_cargar_iva(ls_tipo_cob,row)
	//end if
	dw_detalle_be.accepttext()
	wf_actualizar(ls_tipo_cob)
end if
dw_detalle_be.accepttext()
end event

event itemfocuschanged;String		ls_columna,ls_tipo_cob2,ls_nulo2
Long		ll_cantidad,ll_ctas,ll_ctas_pagadas,ll_ctas_pagadas_1,ll_ctas_pagadas_2,ll_tot_reg2,ll_row,ll_cod_parque,ll_count_hijo
Double	ld_monto

this.accepttext()
Setnull(ls_nulo2)
if il_modif > 0 then
	if dw_datos_be.rowcount() > 0 and dw_detalle_be.rowcount() > 0 then
		ls_tipo_cob2					= dw_detalle_be.getitemstring(this.getrow(),'tipo_cob')
		SELECT 	Count("CADENA"."CODIGO" )
		INTO 		:ll_count_hijo
		FROM 	"CADENA"  
		WHERE 	( "CADENA"."CODIGO" = :gs_base ) AND  
					( "CADENA"."SERIE" = :gs_serie ) AND  
					( "CADENA"."NUMERO" = :gi_numero ) AND  
					( "CADENA"."MPBASE" = 'M' )   ;
		if isnull(ll_count_hijo) then ll_count_hijo=0
		if ((ls_tipo_cob2='E' or ls_tipo_cob2='F' or ls_tipo_cob2='A' ) and ll_count_hijo > 0) or gs_base='M' then
		//	messagebox("Advertencia","No es posible Ingresar este Item de Pago a Contrato que tiene Asociado Contrato Multiproducto, debe Ingresar a Contrato Base M")
			dw_detalle_be.SetItem(row, "monto", 0)
			dw_detalle_be.SetItem(row, "cantidad", 0)
			dw_detalle_be.SetItem(row, "tipo_cob", ls_nulo2)
			dw_detalle_be.accepttext()
			dw_detalle_be.setfocus()
			dw_detalle_be.setcolumn('tipo_cob')
		end if
		ll_tot_reg2					= dw_detalle_be.rowcount()
		ls_tipo_cob2					= dw_detalle_be.getitemstring(this.getrow(),'tipo_cob')
		ll_row		 					= dw_detalle_be.Find("tipo_cob ='E' or tipo_cob ='U'",1, ll_tot_reg2)
		if ll_row > 0 then
			ls_tipo_cob2					= dw_detalle_be.getitemstring(ll_row,'tipo_cob')
			ll_cantidad 					= dw_detalle_be.GetItemNumber(ll_row, "cantidad")
			IF ls_tipo_cob2 = "E" AND gs_rezago <> "S" and gs_base <> 'C' THEN
				if (gs_base='O' or gs_base='U' or gs_base='M') and dw_datos_be.DataObject='d_datos_cuenta_ci_oferta' then
					ll_ctas				= dw_datos_be.getitemnumber(1,'pago_oferta_nro_cuotas')
					ll_ctas_pagadas	= dw_datos_be.getitemnumber(1,'oferta_v_cta_pag_s')
				elseif gs_base='P' and dw_datos_be.DataObject='d_datos_cuenta_ci_pagare' then
					ll_ctas				= dw_datos_be.getitemnumber(1,'pagare_plazo')
					ll_ctas_pagadas_1	= dw_datos_be.getitemnumber(1,'pagare_cta_pag_la')
					ll_ctas_pagadas_2	= dw_datos_be.getitemnumber(1,'pagare_cta_pag_isa')
					ll_ctas_pagadas	= ll_ctas_pagadas_1 + ll_ctas_pagadas_2
				elseif gs_base='L' and dw_datos_be.DataObject='d_datos_cuenta_ci_liberador' then
					ll_ctas				= dw_datos_be.getitemnumber(1,'pago_liberador_nro_cuotas')
					ll_ctas_pagadas	= dw_datos_be.getitemnumber(1,'anexo_liberador_cta_pag_m')
				elseif gs_base='D' and dw_datos_be.DataObject='d_datos_cuenta_ci_derecho' then
					ll_ctas				= dw_datos_be.getitemnumber(1,'derecho_plazo')
					ll_ctas_pagadas_1	= dw_datos_be.getitemnumber(1,'derecho_cta_pag_la')
					ll_ctas_pagadas_2	= dw_datos_be.getitemnumber(1,'derecho_cta_pag_isa')
					ll_ctas_pagadas	= ll_ctas_pagadas_1 + ll_ctas_pagadas_2
				elseif gs_base='A' and dw_datos_be.DataObject='d_datos_cuenta_ci_aumento_capacidad' then
					ll_ctas				= dw_datos_be.getitemnumber(1,'pago_aumento_nro_cuotas')
					ll_ctas_pagadas	= dw_datos_be.getitemnumber(1,'anexo_aumento_cta_pag_m')
				elseif gs_base='R' and dw_datos_be.DataObject='dw_repacta_mant_descripcion_traspaso' then
					ll_ctas				= dw_datos_be.getitemnumber(1,'cuotas_pactadas')
					ll_ctas_pagadas	= dw_datos_be.getitemnumber(1,'ctas_pagadas')
				elseif (gs_base='F' or gs_base='G' or gs_base='V') and dw_datos_be.DataObject='d_datos_cuenta_ci_funeraria' then
					ll_ctas				= dw_datos_be.getitemnumber(1,'producto_pago_plazo')
					ll_ctas_pagadas	= dw_datos_be.getitemnumber(1,'producto_anexo_cuotas_pag')
				end if
				if (ll_ctas_pagadas + ll_cantidad) > ll_ctas then
					dw_detalle_be.SetItem(ll_row, "cantidad", 0)
					dw_detalle_be.SetItem(ll_row,'c_total_linea',0)
					dw_detalle_be.SetItem(ll_row,'monto_uf',0)
					dw_detalle_be.SetItem(ll_row,'monto',0)
					dw_gastos_be.SetItem(1, "Subtotal",0)
					dw_gastos_be.SetItem(1, "mora",0)
					dw_gastos_be.SetItem(1, "gastos_cob",0)
					
					dw_gastos_be.SetItem(1, "mora_cred",0)
					dw_gastos_be.SetItem(1, "mora_mant",0)
					dw_gastos_be.SetItem(1, "gasto_cred",0)
					dw_gastos_be.SetItem(1, "gasto_mant",0)
					dw_detalle_be.accepttext()
				end if
			end if
			ll_cod_parque		= dw_datos_be.getitemnumber(1,'cadena_cod_parque')
			if (gs_base = 'O' or gs_base='U' or gs_base='M') then
				dw_detalle_be.setitem(row,'tipo_cob','')
				SetItem(row, "monto", 0)
				SetItem(row, "cantidad", 0)
				dw_detalle_be.setfocus()
				dw_detalle_be.setcolumn('tipo_cob')
			elseif gs_base = 'P' and ll_cod_parque<>101 then
				dw_detalle_be.setitem(row,'tipo_cob','')
				SetItem(row, "monto", 0)
				SetItem(row, "cantidad", 0)
				dw_detalle_be.setfocus()
				dw_detalle_be.setcolumn('tipo_cob')
			end if
			if gs_codigo_otro = "" then gs_codigo_otro = '0'
			if ls_tipo_cob2 = 'S' and gs_codigo_otro <> '0' then
				wf_validar_descuento()
			end if
		
		end if
	end if
	ld_monto				= this.getitemnumber(row,'monto')
	ls_tipo_cob2			= dw_detalle_be.getitemstring(this.getrow(),'tipo_cob')
	if ld_monto < 0 then
		if isnull(il_cantidad_malo) then	il_cantidad_malo	= this.getitemnumber(row,'cantidad')
	//	messagebox("Advertencia","Revisar Monto Ingresado, recuerde Ingreso MONTO Mayor a CERO")
		SetItem(row, "monto", 0)
		SetItem(row, "cantidad", 0)
	else
		if il_cantidad_malo>0 then this.setitem(row,'cantidad',il_cantidad_malo)
	end if
	if not isnull(gs_base) and (ls_tipo_cob2='' or isnull(ls_tipo_cob2))  then		//and st_toku.visible=true
		SetItem(row, "monto", 0)
		SetItem(row, "monto_uf", 0)
		SetItem(row, "tipo_cob", ls_nulo2)
		SetItem(row, "cantidad", 0)
		this.accepttext()
		setnull(ls_tipo_cob2)
		dw_detalle_be.setfocus()
		dw_detalle_be.setcolumn('tipo_cob')
	end if
	ll_row							= il_fila_desc
//	ls_tipo_cob2					= dw_detalle_be.getitemstring(ll_row,'tipo_cob')
//	if not isnull(dw_detalle_be.getitemstring(ll_row,'tipo_cob_otro')) then gs_codigo_otro	= dw_detalle_be.getitemstring(ll_row,'tipo_cob_otro')
	if ls_tipo_cob2 = 'S' and (gs_codigo_otro <> '0' or not isnull(gs_codigo_otro)) then
		wf_validar_descuento()
	end if
end if
this.accepttext()
end event

event losefocus;String	ls_columna,ls_tipo_cob
Long		ll_cantidad,ll_ctas,ll_ctas_pagadas,ll_ctas_pagadas_1,ll_ctas_pagadas_2

dw_detalle_be.accepttext()
if dw_datos_be.rowcount() > 0 and dw_detalle_be.rowcount() > 0 then
	ls_tipo_cob				= this.getitemstring(this.rowcount(),'tipo_cob')
	ll_cantidad 				= this.GetItemNumber(this.rowcount(), "cantidad")
	if gs_codigo_otro = "" then gs_codigo_otro = '0'
	if ls_tipo_cob = 'S' and gs_codigo_otro <> '0' then
		wf_validar_descuento()
	end if
	IF ls_tipo_cob = "E" AND gs_rezago <> "S" and gs_base <> 'C' THEN
		if (gs_base='O' or gs_base='U' or gs_base='M') and dw_datos_be.DataObject='d_datos_cuenta_ci_oferta' then
			ll_ctas				= dw_datos_be.getitemnumber(1,'pago_oferta_nro_cuotas')
			ll_ctas_pagadas	= dw_datos_be.getitemnumber(1,'oferta_v_cta_pag_s')
		elseif gs_base='P' and dw_datos_be.DataObject='d_datos_cuenta_ci_pagare' then
			ll_ctas				= dw_datos_be.getitemnumber(1,'pagare_plazo')
			ll_ctas_pagadas_1	= dw_datos_be.getitemnumber(1,'pagare_cta_pag_la')
			ll_ctas_pagadas_2	= dw_datos_be.getitemnumber(1,'pagare_cta_pag_isa')
			ll_ctas_pagadas	= ll_ctas_pagadas_1 + ll_ctas_pagadas_2
		elseif gs_base='L' and dw_datos_be.DataObject='d_datos_cuenta_ci_liberador' then
			ll_ctas				= dw_datos_be.getitemnumber(1,'pago_liberador_nro_cuotas')
			ll_ctas_pagadas	= dw_datos_be.getitemnumber(1,'anexo_liberador_cta_pag_m')
		elseif gs_base='D' and dw_datos_be.DataObject='d_datos_cuenta_ci_derecho' then
			ll_ctas				= dw_datos_be.getitemnumber(1,'derecho_plazo')
			ll_ctas_pagadas_1	= dw_datos_be.getitemnumber(1,'derecho_cta_pag_la')
			ll_ctas_pagadas_2	= dw_datos_be.getitemnumber(1,'derecho_cta_pag_isa')
			ll_ctas_pagadas	= ll_ctas_pagadas_1 + ll_ctas_pagadas_2
		elseif gs_base='A' and dw_datos_be.DataObject='d_datos_cuenta_ci_aumento_capacidad' then
			ll_ctas				= dw_datos_be.getitemnumber(1,'pago_aumento_nro_cuotas')
			ll_ctas_pagadas	= dw_datos_be.getitemnumber(1,'anexo_aumento_cta_pag_m')
		elseif gs_base='R' and dw_datos_be.DataObject='dw_repacta_mant_descripcion_traspaso' then
			ll_ctas				= dw_datos_be.getitemnumber(1,'cuotas_pactadas')
			ll_ctas_pagadas	= dw_datos_be.getitemnumber(1,'ctas_pagadas')
		elseif (gs_base='F' or gs_base='G' or gs_base='V') and dw_datos_be.DataObject='d_datos_cuenta_ci_funeraria' then
			ll_ctas				= dw_datos_be.getitemnumber(1,'producto_pago_plazo')
			ll_ctas_pagadas	= dw_datos_be.getitemnumber(1,'producto_anexo_cuotas_pag')
		end if
		if (ll_ctas_pagadas + ll_cantidad) > ll_ctas then
			this.SetItem(this.rowcount(), "cantidad", 0)
			dw_gastos_be.SetItem(1, "Subtotal",0)
			dw_gastos_be.SetItem(1, "mora",0)
			dw_gastos_be.SetItem(1, "gastos_cob",0)
			
			dw_gastos_be.SetItem(1, "mora_cred",0)
			dw_gastos_be.SetItem(1, "mora_mant",0)
			dw_gastos_be.SetItem(1, "gasto_cred",0)
			dw_gastos_be.SetItem(1, "gasto_mant",0)
			dw_detalle_be.accepttext()
		end if
	end if
end if
end event

event itemerror;RETURN 1
end event

type sle_numero_be from singlelineedit within tp_be
event ue_mousemove pbm_mousemove
integer x = 1312
integer y = 676
integer width = 498
integer height = 92
integer taborder = 40
integer textsize = -9
integer weight = 700
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
long backcolor = 16777215
boolean enabled = false
boolean autohscroll = false
borderstyle borderstyle = stylelowered!
end type

event ue_mousemove;st_31.visible							= false
st_help_insertar_be.visible		= false
st_help_eliminar_be.visible		= false
st_help_ficha_be.visible			= false
st_help_descuento_be.visible	= false
if is_opcion='FP' and (gs_depto='T' or gs_depto='I') then st_fuera_plazo.visible = true

end event

event modified;String		ls_rut_empresa,ls_pasa
Long		ll_folio_aux,ll_folio,ll_min_boleta

ls_pasa								='S'
ll_folio								= long(sle_numero_be.text)
if cbx_manual_be.checked=true then
	gs_tipo_cobro					= "BE"
else
	if rb_be_afecta.checked=true then
		if gs_base='F' then
			if gs_serie = 'F' then
				gs_tipo_cobro		= "FA"
			else
				gs_tipo_cobro		= "FE"
			end if
		else
			gs_tipo_cobro			= "BA"
		end if
	elseif rb_be_exenta.checked=true then
		if gs_base='F' then
			if gs_serie = 'F' then
				gs_tipo_cobro		= "FA"
			else
				gs_tipo_cobro		= "FE"
			end if
		else
			gs_tipo_cobro			= "BE"
		end if
	end if
end if
if ll_folio > 0 then
	IF gf_existe_ci(ll_folio,gs_tipo_cobro) THEN
		MessageBox("Ingreso "+gs_tipo_cobro, "El Número de COMPROBANTE INGRESO "+string(ll_folio)+" ya existe")
		sle_numero_be.text 								= ""
		cb_be_insertar.Enabled 							= false
		cb_be_borrar_item.Enabled 					= false
		pb_ficha_be.Enabled 								= false
		dw_detalle_be.reset()
		sle_numero_be.setfocus()
	ELSE
		if cbx_manual_be.checked=false then
			if rb_be_afecta.checked=true then
				SELECT		"MEMBRETE_EMPRESA"."STRING_RUT"
				INTO 			:ls_rut_empresa
				FROM 		"MEMBRETE_EMPRESA"  
				WHERE 		"MEMBRETE_EMPRESA"."COD_PARQUE" = 99   ;
			elseif rb_be_exenta.checked=true then
				SELECT		"MEMBRETE_EMPRESA"."STRING_RUT"
				INTO 			:ls_rut_empresa
				FROM 		"MEMBRETE_EMPRESA"  
				WHERE 		"MEMBRETE_EMPRESA"."COD_PARQUE" = :gl_cod_parque   ;
			end if
			SELECT		"ELECTRONICA_FB_DETALLE"."NRO_DOCUMENTO"  
			INTO 			:ll_folio_aux  
			FROM 		"ELECTRONICA_FB",   
							"ELECTRONICA_FB_DETALLE"  
			WHERE 	  ( "ELECTRONICA_FB"."GRUPO" = "ELECTRONICA_FB_DETALLE"."GRUPO" ) and  
						  ( "ELECTRONICA_FB"."TIPO_DOCUMENTO" = "ELECTRONICA_FB_DETALLE"."TIPO_DOCUMENTO" ) and  
						  (("ELECTRONICA_FB"."ESTADO" = 'P' ) AND  
						  ( "ELECTRONICA_FB_DETALLE"."NRO_DOCUMENTO" = :ll_folio ) AND  
						  ( "ELECTRONICA_FB_DETALLE"."TIPO_DOCUMENTO" = :gs_tipo_cobro ) AND  
						  ( "ELECTRONICA_FB"."RUT_EMPRESA" = :ls_rut_empresa ) AND
						  ( "ELECTRONICA_FB_DETALLE"."ESTADO_REG" = 'P'  ) )   
			USING		sqlca;
			//( ("ELECTRONICA_FB_DETALLE"."ESTADO_REG" = 'P' or "ELECTRONICA_FB_DETALLE"."ESTADO_REG" = 'B' ) ) )   
			if sqlca.sqlcode <> 0 then
				messagebox("Advertencia","Documento N° "+string(ll_folio,'###,###,###,###')+" NO Existe o ya está Gestionado")
				sle_numero_be.text 							= ''
				cb_be_insertar.Enabled 						= false
				cb_be_borrar_item.Enabled 				= false
				pb_ficha_be.Enabled 							= false
				dw_detalle_be.reset()
				sle_numero_be.setfocus()
				ls_pasa											= 'N'
			end if
		end if
		if ls_pasa='S' then
			tab_ingreso.tp_be.pb_ficha_be.enabled		= true
			if gs_rezago = "S" then
				tab_ingreso.tp_be.gb_1_be.visible			= true
				tab_ingreso.tp_be.rb_be_uf.visible			= true
				tab_ingreso.tp_be.rb_be_peso.visible		= true
				tab_ingreso.tp_be.rb_be_uf.checked		= true
			else
				tab_ingreso.tp_be.gb_1_be.visible			= false
				tab_ingreso.tp_be.rb_be_uf.visible			= false
				tab_ingreso.tp_be.rb_be_peso.visible		= false
				wf_cargar_cupones_ci(gs_base,gs_serie,gi_numero)
			end if
			IF LONG(sle_numero_be.text)>0 THEN
				cb_be_insertar.Enabled 						= TRUE
				cb_be_borrar_item.Enabled 				= TRUE
				pb_ficha_be.Enabled 							= TRUE
				cb_be_insertar.setfocus()
			ELSE
				Messagebox("Advertencia","Número de "+gs_tipo_cobro+" debe ser Mayor a 0")
				sle_numero_be.text							= ''
				sle_numero_be.setfocus()
			END IF
		end if
	END IF
end if
end event

