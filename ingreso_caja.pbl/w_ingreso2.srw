//				ll_day					= 31
//			elseif (ll_month=8 and ll_dia_prox_pago>31) then
//				ls_pasa				= 'S'
//				ll_day					= 31
//			elseif (ll_month=9 and ll_dia_prox_pago>30) then
//				ls_pasa				= 'S'
//				ll_day					= 30
//			elseif (ll_month=10 and ll_dia_prox_pago>31) then
//				ls_pasa				= 'S'
//				ll_day					= 31
