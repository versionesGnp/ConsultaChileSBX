event clicked;Long		ll_plazo,ll_fila_a
ll_plazo									= 0

// vhfb= 0
if gs_base='F' then
	tab_ingreso.tp_be.rb_be_afecta.checked		= true
	return
end if 
// vhfb



if gs_base = 'F' or gs_base = 'G'  or gs_base='V' then
	if w_ingreso2.tab_ingreso.tp_be.dw_datos_be.rowcount() > 0 then
		ll_plazo								= w_ingreso2.tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'producto_pago_plazo')
	end if
	if  gs_base='V' then
		gs_tipo_cobro					= 'BE'
	elseif gs_serie = 'F' or gs_base = 'G' then
//		if ll_plazo > 1 then
			gs_tipo_cobro				= 'BE'
//		else
//			gs_tipo_cobro				= 'FA'
//		end if
	end if
	gs_tipo_cobro_aux					= 'BA'
else
	gs_tipo_cobro						= 'BE'
	gs_tipo_cobro_aux					= 'BE'
end if
ll_fila_a									= dw_detalle_be.find("tipo_cob='A'",1,dw_detalle_be.rowcount())
if ll_fila_a > 0 then f_validar_pie_pactado_actualizar('BA',dw_datos_be.dataobject,gs_base,gs_serie,gi_numero)

idw_detalle4.retrieve(gs_tipo_cobro)
idw_detalle12.retrieve(gs_tipo_cobro)
sle_numero_be.text					= ''
dw_detalle_be.reset()
dw_gastos_be.reset()

