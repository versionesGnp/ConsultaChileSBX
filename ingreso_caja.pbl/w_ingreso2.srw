		id_gc 							= 0
		id_im 							= 0
		ii_mora_cobro 				= 0
		ii_inc_gastos 				= 0
		FOR i = 1 TO ii_cantidad 
			IF ((ii_dmora - (i - 1) * (ll_cant_mant * 30))) > 5 AND tab_ingreso.tp_ci.cbx_sin_mora_ci.Checked = False THEN 
				ii_mora_cobro		= ((ii_dmora - (i - 1) * (ll_cant_mant * 30)))
				id_im 					= id_im + gf_int_mora(id_tasa_mant, ii_mora_cobro, id_valor_cuota)
				IF ((ii_dmora - (i - 1) * (ll_cant_mant * 30))) > 30 AND tab_ingreso.tp_ci.cbx_sin_gastos_ci.Checked = False THEN 
					 id_gc 			= id_gc + Round(id_valor_cuota * id_factor_gc, 0)
					 ii_inc_gastos = 1
				END IF
			ELSE
	//			id_gc 					= 0
	//			id_im 					= 0
	//			ii_mora_cobro		= 0
			END IF
		NEXT
		ll_gasto_cob					= ll_gasto_cob + id_gc// + ll_acum_gasto
		ll_mora						= ll_mora + id_im// + ll_acum_mora
	//	il_int_mora					= ll_mora
	//	il_int_gc						= ll_gasto_cob
		w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.accepttext()
		ll_total_monto				= w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.GetItemNumber(1,"c_subtotal_total")
	end if
	if isnull(ll_monto_cred) then ll_monto_cred=0
	if isnull(ll_gasto_cob) then ll_gasto_cob=0
	if isnull(ll_mora) then ll_mora=0
	ll_monto_cred					= ll_monto_cred + ll_gasto_cob
elseif tab_ingreso.SelectedTab = 3 then //Boleta
	w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1,'incluir_gastos', 1)
	w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.accepttext()
	w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.accepttext()
	ls_tipo_cob						= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.getitemstring(ll_indi,"tipo_cob")
	if ls_tipo_cob='E' or ls_tipo_cob='A' or ls_tipo_cob='F' then
		ii_cantidad 					= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.GetItemNumber(ll_indi,"cantidad")
		ll_monto						= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.GetItemNumber(ll_indi,"c_total_linea")
		gl_n_cuotas_pag 			= ii_cantidad 
		if ls_tipo_cob='E' then
			ll_cuota					= w_ingreso2.tab_ingreso.tp_be.dw_datos_be.getitemnumber(1, "c_cuotas_mora")
			id_valor_cuota 			= Round(w_ingreso2.tab_ingreso.tp_be.dw_datos_be.GetItemNumber(1,"c_valor_cuota_pesos"), 0)
			if gs_base='O' or gs_base='U' or gs_base='M' then
				ldt_fecha_prim		= w_ingreso2.tab_ingreso.tp_be.dw_datos_be.GetItemdatetime(1,'pago_oferta_fecha_prim')
				ll_ctas_pag			= w_ingreso2.tab_ingreso.tp_be.dw_datos_be.GetItemnumber(1,'oferta_v_cta_pag_s')
			elseif gs_base='L' then
				ldt_fecha_prim		= w_ingreso2.tab_ingreso.tp_be.dw_datos_be.GetItemdatetime(1,'pago_liberador_fecha_prim')
				ll_ctas_pag			= w_ingreso2.tab_ingreso.tp_be.dw_datos_be.GetItemnumber(1,'anexo_liberador_cta_pag_m')
			elseif gs_base='F' or gs_base='G' or gs_base='V' then
				ldt_fecha_prim		= w_ingreso2.tab_ingreso.tp_be.dw_datos_be.GetItemdatetime(1,'producto_pago_fecha_prim')
				ll_ctas_pag			= w_ingreso2.tab_ingreso.tp_be.dw_datos_be.GetItemnumber(1,'producto_anexo_cuotas_pag')
			elseif gs_base='A' then
				ldt_fecha_prim		= w_ingreso2.tab_ingreso.tp_be.dw_datos_be.GetItemdatetime(1,'pago_aumento_fecha_prim')
				ll_ctas_pag			= w_ingreso2.tab_ingreso.tp_be.dw_datos_be.GetItemnumber(1,'anexo_aumento_cta_pag_m')
			elseif gs_base='R' then
				ldt_fecha_prim		= w_ingreso2.tab_ingreso.tp_be.dw_datos_be.GetItemdatetime(1,'fecha_primera_cta')
				ll_ctas_pag			= w_ingreso2.tab_ingreso.tp_be.dw_datos_be.GetItemnumber(1,'ctas_pagadas')
			elseif gs_base='P' then
				ldt_fecha_prim		= w_ingreso2.tab_ingreso.tp_be.dw_datos_be.GetItemdatetime(1,'pagare_fecha_prim')
				ll_ctas_pag			= w_ingreso2.tab_ingreso.tp_be.dw_datos_be.GetItemnumber(1,'c_cuotas_pagadas')
			elseif gs_base='D' then
				ldt_fecha_prim		= w_ingreso2.tab_ingreso.tp_be.dw_datos_be.GetItemdatetime(1,'derecho_fecha_prim')
				ll_ctas_pag			= w_ingreso2.tab_ingreso.tp_be.dw_datos_be.GetItemnumber(1,'c_cuotas_pagadas')
			end if
			ld_fecha_prox_pago	= date(DATEtime(funcion_venc( ldt_fecha_prim , ll_ctas_pag ))) //-1
			ii_dmora 				= w_ingreso2.tab_ingreso.tp_be.dw_datos_be.GetItemNumber(1,"c_dias_mora")
			ll_ctas_mora			= w_ingreso2.tab_ingreso.tp_be.dw_datos_be.GetItemNumber(1,'c_cuotas_mora')
	
		elseif ls_tipo_cob='A' then
			id_valor_cuota 			= ll_monto
			ii_dmora 				= w_ingreso2.tab_ingreso.tp_be.dw_datos_be.GetItemNumber(1,'c_dias_mora_pie')
		elseif ls_tipo_cob='F' then
			if gs_base='O' or gs_base='C' or gs_base='U' or gs_base='M' then
				id_valor_cuota 		= Round(w_ingreso2.tab_ingreso.tp_be.dw_datos_be.GetItemNumber(1,"c_valor_cuota_mantencion_pesos"), 0)
				ii_dmora 			= w_ingreso2.tab_ingreso.tp_be.dw_datos_be.GetItemNumber(1,"c_dias_mora_mant")
			end if
		end if
		id_gc 							= 0
		id_im 							= 0
		if ls_tipo_cob='A' or ls_tipo_cob='E' then
			ii_mora_cobro 			= 1
			ii_inc_gastos 			= 1
		elseif ls_tipo_cob='F' then
			ii_mora_cobro 			= 0
			ii_inc_gastos 			= 0
		end if
	
	
		id_gc 							= 0
		id_im 							= 0
		ii_mora_cobro 				= 0
		ii_inc_gastos 				= 0
		FOR i = 1 TO ii_cantidad 
			IF ((ii_dmora - (i - 1) * (ll_cant_mant * 30))) > 5 AND tab_ingreso.tp_be.cbx_sin_mora_be.Checked = False THEN 
				ii_mora_cobro		= ((ii_dmora - (i - 1) * (ll_cant_mant * 30)))
				id_im 					= id_im + gf_int_mora(id_tasa_mant, ii_mora_cobro, id_valor_cuota)
				IF ((ii_dmora - (i - 1) * (ll_cant_mant * 30))) > 30 AND tab_ingreso.tp_be.cbx_sin_gastos_be.Checked = False THEN 
					 id_gc 			= id_gc + Round(id_valor_cuota * id_factor_gc, 0)
					 ii_inc_gastos = 1
				END IF
			ELSE
	//			id_gc 					= 0
	//			id_im 					= 0
	//			ii_mora_cobro		= 0
			END IF
		NEXT
		ll_gasto_cob					= ll_gasto_cob + id_gc// + ll_acum_gasto
		ll_mora						= ll_mora + id_im// + ll_acum_mora
	//	il_int_mora					= ll_mora
	//	il_int_gc						= ll_gasto_cob
		w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.accepttext()
		ll_total_monto				= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.GetItemNumber(1,"c_subtotal_total")
	end if
	if isnull(ll_monto_cred) then ll_monto_cred=0
	if isnull(ll_gasto_cob) then ll_gasto_cob=0
	if isnull(ll_mora) then ll_mora=0
	ll_monto_cred					= ll_monto_cred + ll_gasto_cob
end if
Return (ll_monto_cred)
end function

public function long wf_calcular_solo_gc (long ll_indi);Long		ll_ctas_mora,ll_dia_prox_pago,ll_day,ll_month,ll_year,ll_max,ll_new,ll_dias_dif,ll_suma_dias,ll_tot_fila,ll_reg,ll_dias_mora,ll_cuota,ll_valor_int,ll_suma_acum_gc,&
			ll_gasto_cob,ll_mora,ll_total_monto,ii_dmora,ii_mora_cobro,ii_inc_gastos,i,id_im,id_gc,ii_cantidad,ll_monto_cred,ll_monto,ll_ctas_pag,ll_acum_dias,ll_dias_mora_cred,&
			ll_sumar_mes,ll_mora_cred,ll_cant_mant,ll_cant_cred,ll_dias
date		ld_fecha_prox_pago,ld_fecha_inicial,ld_fecha_prox_venc,ld_fecha_hoy
datetime	ldt_fecha_prim,ldt_fecha_venc_calc,ldt_fecha_venc,ld_fecha_venc_cred,ldt_fecha_hoy
String	ls_fecha,ls_pasa,ls_tipo_cob
Double	id_valor_cuota,ldb_tasa,ldb_val_cta_cred,id_monto

ld_fecha_hoy							= date(gdt_fec_sistema)
ldt_fecha_hoy							= datetime(date(ld_fecha_hoy),time('00:00:00'))
SELECT 	"ESTADO_MORA_MANTENCION"."CANTIDAD_MESES",	"ESTADO_MORA_CREDITO"."CANTIDAD_MESES"  
 INTO   	:ll_cant_mant,														:ll_cant_cred
 FROM   "CADENA", "ESTADO_MORA_CREDITO", "ESTADO_MORA_MANTENCION"  
 WHERE ("CADENA"."ESTADO_MORA_CREDITO" = "ESTADO_MORA_CREDITO"."ESTADO_MORA_CREDITO" ) and  
		 ( "CADENA"."ESTADO_MORA_MANTENCION" = "ESTADO_MORA_MANTENCION"."ESTADO_MORA_MANTENCION" ) and  
		 (("CADENA"."CODIGO" = :gs_base ) AND  
		 ( "CADENA"."SERIE" = :gs_serie ) AND  
		 ( "CADENA"."NUMERO" = :gi_numero ) )   ;
