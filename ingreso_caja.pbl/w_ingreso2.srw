event clicked;long 		fila,ii_dmora, ii_mora_cobro,ll_tot_reg,ll_indi,ll_cantidad,ll_monto,ll_sw_pasa,ii_inc_gastos,ll_fila,ll_count_reg,ll_count_otro,ll_res,ll_cod_servicio,ll_fila_e,ll_ctas_pag_m,&
			ll_sum_reg,ll_new_reg,ll_total_monto,ll_count_fe,ll_count_crem,ll_sw_pago_reg,ll_plazo,ll_plazo_serv,ll_cod_seguro,ll_count_adic,ll_new_seg,ll_plazo_pie,ll_ctas_pag_pie,&
			ll_cantidad_cta,ll_cuota_ini,ll_cuota_fin,ll_new_iva,ll_contar
double 	id_im, id_gc, id_valor_cuota,ld_monto_uf,id_interes_gc,ll_valor_serv,ll_valor_dscto_comer,ldb_valor_cuota,ldb_valor_cuota_peso,ll_ctas_pagadas,ldb_valor_seg,ldb_val_cta_ctto,&
			ldb_prima,  ll_monto_det,ldb_precio,ll_pie,ll_monto_cuota_reg,ldb_iva,ll_iva_f,ll_mora_mant,ll_iva_p,ll_gasto_mant,ll_iva_r,ll_pie_pagado,ll_sum_pie,ldb_valor_sumado,&
			ldb_valor
String		ls_tipo_cob,ls_moneda,ls_tipo_cob_otro,ls_moneda_ctto,ls_string,ls_codigo_otro_cur,ls_tipo_mov,ls_cod_dscto_comer,ls_tipo_l,ls_tipo_s,ls_tipo_cob_serv,ls_tipo_servicio,&
			ls_moneda_ctto_seg,ls_monda_det,ls_tipov_cob,ls_tipov_cob_aux,ls_moneda_insert,ls_descrip

ll_sw_pasa			= 0
ii_inc_gastos 		= 1
ll_sw_pago_reg	= 0
//ls_tipo_mov			= 'L'

if long(sle_numero_be.text) >= 0 then
//	if rb_be_afecta.checked=true then rb_be_afecta.triggerevent(clicked!)
//	if rb_be_exenta.checked=true then rb_be_exenta.triggerevent(clicked!)
	if rb_be_peso.checked=true then rb_be_uf.checked=true
	ll_tot_reg		= dw_detalle_be.rowcount()
	for ll_indi=1 to ll_tot_reg
		ls_tipo_cob		= dw_detalle_be.getitemstring(ll_indi,'tipo_cob')
		ll_cod_servicio	= dw_detalle_be.getitemnumber(ll_indi,'cod_servicio')
		ll_cantidad		= dw_detalle_be.getitemnumber(ll_indi,'cantidad')
		ll_monto			= dw_detalle_be.getitemnumber(ll_indi,'monto')
		ld_monto_uf		= dw_detalle_be.getitemnumber(ll_indi,'monto_uf')
		ls_moneda		= dw_detalle_be.getitemstring(ll_indi,'moneda')
//		if ls_tipo_cob_otro = "" then ls_tipo_cob_otro = '0'
//		if ls_tipo_cob = 'S' and ls_tipo_cob_otro <> '0' then
//			wf_validar_descuento()
//		end if	
		if ls_tipo_cob='' or isnull(ls_tipo_cob) then
			messagebox("Advertencia","No es posible Insertar nuevo Item, en Fila Nº  "+string(ll_indi)+"  Tipo Cobro Inválido")
			dw_detalle_be.setfocus()
			dw_detalle_be.scrolltorow(ll_indi)
			dw_detalle_be.setcolumn('tipo_cob')
			ll_indi		= ll_tot_reg
			ll_sw_pasa	= 1
		elseif ll_cantidad<=0 or isnull(ll_cantidad) then
			messagebox("Advertencia","No es posible Insertar nuevo Item, en Fila Nº  "+string(ll_indi)+"  Cantidad Inválido")
			dw_detalle_be.setfocus()
			dw_detalle_be.scrolltorow(ll_indi)
			dw_detalle_be.setcolumn('cantidad')
			ll_indi		= ll_tot_reg
			ll_sw_pasa	= 1
		elseif (ll_monto<=0 or isnull(ll_monto)) and (ld_monto_uf<=0 or isnull(ld_monto_uf)) then
			messagebox("Advertencia","No es posible Insertar nuevo Item, en Fila Nº  "+string(ll_indi)+"  Monto Inválido")
			dw_detalle_be.setfocus()
			dw_detalle_be.scrolltorow(ll_indi)
			if ls_moneda='P' then
				dw_detalle_be.setcolumn('monto')
			else
				dw_detalle_be.setcolumn('monto_uf')
			end if
			ll_indi		= ll_tot_reg
			ll_sw_pasa	= 1
		end if
	next
	if ll_sw_pasa=0 then
	//	if is_pasa_descto = 'S' then
			il_modif							= 0
			cbx_sin_mora_be.enabled	= true
			cbx_sin_gastos_be.enabled	= true
			cbx_paga_ef_be.enabled		= true
			setnull(il_cantidad_malo)
			gl_n_cuotas_pag 			= 0
			tab_ingreso.tp_be.dw_detalle_be.getchild('tipo_cob_otro',idw_detalle12)
			idw_detalle12.settransobject(sqlca)
			idw_detalle4.retrieve(gs_tipo_cobro)
			idw_detalle12.retrieve(gs_tipo_cobro)
			fila 							= dw_detalle_be.InsertRow(0)
			dw_detalle_be.scrolltorow(fila)
			dw_detalle_be.SetItem(fila, "uf", gd_uf)
			dw_detalle_be.SetItem(fila, "folio", 0)
			dw_detalle_be.SetItem(fila, "estado", 'N')
			dw_detalle_be.SetItem(fila, "uf", gd_uf)
			dw_detalle_be.SetItem(fila, 'base',gs_base)
			dw_detalle_be.SetItem(fila, 'serie',gs_serie)
			dw_detalle_be.SetItem(fila, 'numero',gi_numero)
			if rb_be_uf.checked=true then
				dw_detalle_be.SetItem(fila, "moneda",'U')
			else
				dw_detalle_be.SetItem(fila, "moneda",'P')
			end if
			IF fila = 1 THEN
				IF gs_rezago <> "S" THEN	
					dw_gastos_be.InsertRow(0)
					cb_ingresar_pago_be.Enabled	= TRUE
					cb_be_borrar_item.Enabled 		= true
					pb_ficha_be.Enabled 					= true
					cbx_paga_ef_be.enabled				= true
					wf_calcular_interes(ls_tipo_cob)
			  ELSE
					id_valor_cuota 			= 0
					ii_dmora 				= 0
					id_gc 						= 0
					id_im 						= 0
					ii_mora_cobro 			= 1
					ii_inc_gastos 			= 1
					dw_gastos_be.InsertRow(0)
					cb_ingresar_pago_be.Enabled	= TRUE
					cb_be_borrar_item.Enabled 	= true
					pb_ficha_be.Enabled 				= false
					cbx_paga_ef_be.enabled			= true
			  END IF
			END IF
			if gs_base='F' or gs_base='G'  or gs_base='V' then
				ls_moneda_ctto						= w_ingreso2.tab_ingreso.tp_be.dw_datos_be.getitemstring(1,'producto_pago_moneda')
				ll_plazo									= w_ingreso2.tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'producto_pago_plazo')
				ldb_valor_cuota						= w_ingreso2.tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'producto_pago_valor_cuota')
				ldb_valor_cuota_peso					= w_ingreso2.tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'c_valor_cuota_pesos')
				ll_ctas_pagadas						= w_ingreso2.tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'producto_anexo_cuotas_pag')
				ll_cod_servicio							= w_ingreso2.tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'producto_pago_codigo_servicio')
				ll_plazo_pie								= w_ingreso2.tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'producto_pago_ctas_pie_plazo')
				ll_ctas_pag_pie							= w_ingreso2.tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'producto_pago_ctas_pie_pagadas')
				ll_pie										= w_ingreso2.tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'producto_pago_pie')
				ll_pie_pagado							= w_ingreso2.tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'producto_pago_pie_pagado')
				ls_string									= "cod_servicio > 0"
				ldb_precio								= w_ingreso2.tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'producto_pago_precio')
				ll_fila										= dw_detalle_be.Find(ls_string, 1, dw_detalle_be.RowCount())
				if ll_fila = 0 then
					SELECT 	COUNT("VISTA_CONTRATO_FUNERARIA"."CODIGO_OTRO")
					INTO		:ll_count_reg
					FROM 	"VISTA_CONTRATO_FUNERARIA"  
					WHERE 	( "VISTA_CONTRATO_FUNERARIA"."BASE" = :gs_base ) AND  
								( "VISTA_CONTRATO_FUNERARIA"."SERIE" = :gs_serie ) AND  
								( "VISTA_CONTRATO_FUNERARIA"."NUMERO" = :gi_numero ) ;
					if ll_count_reg > 0 then
						SELECT 	Count("INGRESO"."TIPO_COB")
						INTO 		:ll_count_otro  
						FROM 	"INGRESO"  
						WHERE 	("INGRESO"."BASE" = :gs_base AND  "INGRESO"."SERIE" = :gs_serie AND  "INGRESO"."CONTRATO" = :gi_numero AND  "INGRESO"."PAGO_HIST" = 'A' AND "INGRESO"."CODIGO_SERVICIO" > 0 AND ("INGRESO"."TIPO_COB" = 'FA' or "INGRESO"."TIPO_COB" = 'CU') ) ;
						if ll_plazo > 1 and ll_ctas_pagadas < ll_plazo then
							ll_count_otro 						= 0 
						end if
						ll_count_otro = 0		 //Eliminar para produccion
						if gs_base='V' then
							if ls_moneda_ctto = '1' and ldb_precio = 1 then
								rb_be_exenta.checked			= true
								gs_tipo_cobro						= 'BE'
							else
								gs_tipo_cobro						= 'BA'
								rb_be_afecta.checked				= true
							end if
						end if
						if ll_count_otro = 0 then
							if gs_base='F' and ( gs_serie='F' or gs_serie='I' )then
								if ls_moneda_ctto = '1' and ldb_precio = 1 then
									rb_be_exenta.checked		= true
									gs_tipo_cobro					= 'BE'
								else
									rb_be_afecta.checked			= true
									if ll_plazo > 1 then
										gs_tipo_cobro				= 'BA'
									else
										gs_tipo_cobro				= 'FA'
									end if
								end if
								
								if gs_aplica_a = '' and gd_descuento = 0 then			// vhfb
								ll_res		= messagebox("Advertencia","Desea Asignar Detalle Pago - Servicio Funerario",Exclamation!,YesNo!)
								else 
									ll_res =2 
								end if 								
							elseif gs_base='F' and ( gs_serie='C' or gs_serie='E' ) then
								if ls_moneda_ctto = '1' and ldb_precio = 1 then
									rb_be_exenta.checked		= true
									gs_tipo_cobro					= 'BE'
								else
									rb_be_afecta.checked			= true
									if ll_plazo > 1 then
										gs_tipo_cobro				= 'BA'
									else
										gs_tipo_cobro				= 'FA'
									end if
								end if
								
								if gs_aplica_a = '' and gd_descuento = 0 then			// vhfb
								ll_res		= messagebox("Advertencia","Desea Asignar Detalle Pago - Servicio Crematorio",Exclamation!,YesNo!)
								else 
									ll_res =2 
								end if 								
								
								
							elseif gs_base='G' and (gs_serie='I' OR gs_serie='E' or gs_serie='N' or gs_serie='X' ) then
								if ls_moneda_ctto = '1' and ldb_precio = 1 then
									rb_be_exenta.checked		= true
									gs_tipo_cobro					= 'BE'
								else
									rb_be_afecta.checked			= true
									gs_tipo_cobro					= 'BA'
//									if ll_plazo > 1 then
//										gs_tipo_cobro				= 'BA'
//									else
//										gs_tipo_cobro				= 'FA'
//									end if
								end if
								idw_detalle12.retrieve(gs_tipo_cobro)
								SELECT 	SUM("INGRESO"."MONTO")
								INTO 		:ll_sum_pie  
								FROM 	"INGRESO"  
								WHERE 	( "INGRESO"."BASE" = :gs_base ) AND  
											( "INGRESO"."SERIE" = :gs_serie ) AND  
											( "INGRESO"."CONTRATO" = :gi_numero ) AND  
											( "INGRESO"."TIPO_MOV" = 'A' )  AND
											( "INGRESO"."PAGO_HIST" = 'A' );

								if (ll_ctas_pag_pie < ll_plazo_pie and ll_plazo_pie > 0 and ll_pie > 0) or (ll_plazo_pie=0 and ll_pie > 0 and ll_pie_pagado < ll_sum_pie) then
									messagebox("Advertencia","Debe Ingresar Pie - Servicio Crematorio")
									ll_res				= 0
								else
								if gs_aplica_a = '' and gd_descuento = 0 then			// vhfb
									ll_res				= messagebox("Advertencia","Desea Asignar Detalle Pago - Servicio Crematorio",Exclamation!,YesNo!)
								else 
									ll_res =2 
								end if 											
									
								end if
//								ll_res				= messagebox("Advertencia","Desea Asignar Detalle Pago - Servicio Crematorio",Exclamation!,YesNo!)
							elseif gs_base='V' then
								SELECT	"CS_CABECERA"."TIPO_COB",  	"CS_CABECERA"."TIPO_COB_AUX"  
								INTO 		:ls_tipov_cob,   						:ls_tipov_cob_aux  
								FROM 	"CS_CABECERA"  
								WHERE 	( "CS_CABECERA"."BASE" = :gs_base ) AND  
											( "CS_CABECERA"."SERIE" = :gs_serie ) AND  
											( "CS_CABECERA"."NUMERO" = :gi_numero )   ;
								gs_tipo_cobro					= ls_tipov_cob
								if gs_tipo_cobro='BA' or gs_tipo_cobro='FA' then
									rb_be_afecta.checked		= true
								else
									rb_be_exenta.checked	= true
								end if
								gs_tipo_cobro_aux				= ls_tipov_cob_aux
								idw_detalle12.retrieve(gs_tipo_cobro)
								ll_res				= messagebox("Advertencia","Desea Asignar Detalle Pago - Contrato de Servicio",Exclamation!,YesNo!)
							end if
							if ll_res=1 then
								ll_sum_reg		= 1
								SELECT 	count("INGRESO"."TIPO_COB")  
								INTO 		:ll_count_fe  
								FROM 	"INGRESO"  
								WHERE 	( "INGRESO"."BASE" = :gs_base ) AND  
											( "INGRESO"."SERIE" = :gs_serie ) AND  
											( "INGRESO"."CONTRATO" = :gi_numero ) AND  
											( "INGRESO"."PAGO_HIST" = 'A' ) AND
											( "INGRESO"."TIPO_COB" = :gs_tipo_cobro or "INGRESO"."TIPO_COB" = 'CU')   ;
								if isnull( ll_count_fe ) then  ll_count_fe=0
								if ll_count_fe = 0 then
									if gs_base='G' and (gs_serie='I' OR gs_serie='E' or gs_serie='N' or gs_serie='X') then
										if ls_moneda_ctto = '1' and ldb_precio = 1 then
											rb_be_exenta.checked		= true
											gs_tipo_cobro					= 'BE'
										else
											rb_be_afecta.checked			= true
//											if ll_plazo > 1 then
												gs_tipo_cobro				= 'BA'
//											else
//												gs_tipo_cobro				= 'FA'
//											end if
										end if
										idw_detalle12.retrieve(gs_tipo_cobro)
									end if
								else
									if gs_base='G' and (gs_serie='I' OR gs_serie='E' or gs_serie='N' or gs_serie='X') then
										if ls_moneda_ctto = '1' and ldb_precio = 1 then
											rb_be_exenta.checked		= true
											gs_tipo_cobro					= 'BE'
										else
											rb_be_afecta.checked			= true
//											if ll_plazo > 1 then
												gs_tipo_cobro				= 'BA'
//											else
//												gs_tipo_cobro				= 'FA'
//											end if
										end if
//										gs_tipo_cobro					= 'FA'		//'BA'
										idw_detalle12.retrieve(gs_tipo_cobro)
									end if
								end if
								ll_contar										= 0
								//SELECT DISTINCT	"CUENTA_CONTABLE_OTROS"."CODIGO_OTROS",  	"PRODUCTO_VENTA_ASOCIADA"."VALOR_PRODUCTO"  
								DECLARE cur_detalle_f CURSOR FOR  
								SELECT 	'E' as TIPO_COB_L,"VISTA_CONTRATO_FUNERARIA"."CODIGO_OTRO",  	"VISTA_CONTRATO_FUNERARIA"."VALOR_PRODUCTO",	'S' as TIPO_COB_S,"VISTA_CONTRATO_FUNERARIA"."CODIGO_DESCTO_COMER" ,	"VISTA_CONTRATO_FUNERARIA"."DESCTO_COMER" ,	"VISTA_CONTRATO_FUNERARIA"."TIPO_COB",		"VISTA_CONTRATO_FUNERARIA"."COD_SERVICIO",		"VISTA_CONTRATO_FUNERARIA"."TIPO_SERVICIO", "VISTA_CONTRATO_FUNERARIA"."PLAZO"
								FROM 	"VISTA_CONTRATO_FUNERARIA"  
								WHERE 	( "VISTA_CONTRATO_FUNERARIA"."BASE" = :gs_base ) AND  
											( "VISTA_CONTRATO_FUNERARIA"."SERIE" = :gs_serie ) AND  
											( "VISTA_CONTRATO_FUNERARIA"."NUMERO" = :gi_numero ) 
								ORDER BY TIPO_COB_L ASC,
											"VISTA_CONTRATO_FUNERARIA"."VALOR_PRODUCTO" DESC,
											"VISTA_CONTRATO_FUNERARIA"."CODIGO_OTRO" ASC
								USING	Sqlca;		//Trans_2;
								open cur_detalle_f;
								ll_fila				= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.getrow()
								w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.scrolltorow(ll_fila)
								if Sqlca.sqlcode = 0 then
									if ll_plazo = 1 and ll_ctas_pagadas = 0 then
										DO WHILE Sqlca.sqlcode = 0
											fetch cur_detalle_f into :ls_tipo_l, :ls_codigo_otro_cur, :ll_valor_serv, :ls_tipo_s,  :ls_cod_dscto_comer, :ll_valor_dscto_comer, :ls_tipo_cob_serv, :ll_cod_servicio, :ls_tipo_servicio, :ll_plazo_serv ;
											if gs_base <> 'V' then gs_tipo_cobro	= ls_tipo_cob_serv
//											if ls_tipo_servicio='A' then
//												ls_tipo_l									= 'L'
//												SELECT DISTINCT	"CUENTA_CONTABLE_OTROS"."DESCRIPCION",	"CUENTA_CONTABLE_OTROS"."VALOR"
//												INTO 		:ls_descrip  ,															:ldb_valor
//												FROM 	"CUENTA_CONTABLE_OTROS"  
//												WHERE 	( "CUENTA_CONTABLE_OTROS"."CODIGO_OTROS" = :ls_codigo_otro_cur ) AND  
//															( "CUENTA_CONTABLE_OTROS"."TIPO_COMPROBANTE" = :ls_tipo_cob_serv )  
//												USING	Trans_1;
//												if Trans_1.sqlcode=0 then
//													messagebox("Advertencia","Recuerde que debe Eliminar Pagos Adicionales y Generar Otra "+ls_tipo_cob_serv+" para Servicios "+ls_codigo_otro_cur+' - '+ls_descrip+ " Valor $ "+string(ldb_valor))
//												end if
//											end if
											if gs_tipo_cobro = 'BA' or gs_tipo_cobro = 'FA' then
												if ls_moneda_ctto='1' and ll_valor_serv=1 then
													if gs_base <> 'V' then
														gs_tipo_cobro					= 'BE'
														rb_be_exenta.checked		= true
													end if
												else
													rb_be_afecta.checked			= true
												end if
											elseif gs_tipo_cobro = 'BE' or gs_tipo_cobro = 'FE' then
												rb_be_exenta.checked		= true
											end if
											if not isnull(ls_codigo_otro_cur) and ls_tipo_cob_serv = gs_tipo_cobro then
												SELECT 	Count("INGRESO"."TIPO_COB" ) 
												INTO 		:ll_count_crem  
												FROM 	"INGRESO"  
												WHERE 	( "INGRESO"."CODIGO_OTRO" = :ls_codigo_otro_cur ) AND  
															( "INGRESO"."BASE" = :gs_base ) AND  
															( "INGRESO"."SERIE" = :gs_serie ) AND  
															( "INGRESO"."CONTRATO" = :gi_numero ) 
												USING	Trans_1;
												if ll_plazo > 1 then ll_count_crem = 0
												if ll_count_crem = 0 then
//													if ls_tipo_servicio = 'A' then
//														ll_cod_servicio		= 0
//														ls_tipo_l				= 'L'
//													end if
													w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'tipo_cob',ls_tipo_l)

													w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'cod_servicio',ll_cod_servicio)
													w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'cantidad',1)
													w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.accepttext()
													w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'tipo_cob_otro',ls_codigo_otro_cur)
													w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.accepttext()
													if gs_base = 'V' then
														SELECT 		"CS_DETALLE_PAGOS"."MONEDA",   	(sum( "CS_DETALLE_PAGOS"."MONTO") - 1) as MONTO  
														INTO 			:ls_monda_det,   							:ll_monto_det  
														FROM 		"CS_CABECERA",   "CS_DETALLE_PAGOS"  
														WHERE 		( "CS_CABECERA"."BASE" = "CS_DETALLE_PAGOS"."BASE" ) and  
																		( "CS_CABECERA"."SERIE" = "CS_DETALLE_PAGOS"."SERIE" ) and  
																		( "CS_CABECERA"."NUMERO" = "CS_DETALLE_PAGOS"."NUMERO" ) and  
																		( ( "CS_CABECERA"."BASE" = :gs_base ) AND  
																		( "CS_CABECERA"."SERIE" = :gs_serie ) AND  
																		( "CS_CABECERA"."NUMERO" = :gi_numero ) )   
														GROUP BY	"CS_DETALLE_PAGOS"."MONEDA"  ;
														ls_moneda_ctto		= ls_monda_det
														ll_valor_serv			= ll_monto_det
														if ls_moneda_ctto = '2' then
															if ll_valor_serv > 500 then
																w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'moneda','P')
																w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'monto',ll_valor_serv)
																w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'monto_uf', round( ll_valor_serv / gd_uf,4))
															else
																w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'moneda','U')
																w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'monto_uf',ll_valor_serv)
																w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'monto', round( ll_valor_serv * gd_uf,0))
															end if
														elseif ls_moneda_ctto = '1' then
															w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'moneda','P')
															w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'monto',ll_valor_serv)
															w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'monto_uf', round( ll_valor_serv / gd_uf,4))
														end if
														w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.accepttext()

													else
//														if ls_tipo_l='E' and ll_contar=0 then
//															SELECT 	SUM("VISTA_CONTRATO_FUNERARIA"."VALOR_PRODUCTO")
//															INTO		:ldb_valor_sumado
//															FROM 	"VISTA_CONTRATO_FUNERARIA"  
//															WHERE 	( "VISTA_CONTRATO_FUNERARIA"."BASE" = :gs_base ) AND  
//																		( "VISTA_CONTRATO_FUNERARIA"."SERIE" = :gs_serie ) AND  
//																		( "VISTA_CONTRATO_FUNERARIA"."NUMERO" = :gi_numero ) ;
//															ll_contar ++
//															if ldb_valor_sumado > 0 then ll_valor_serv = ldb_valor_sumado
//														end if
														if ls_moneda_ctto = '2' then
															if ll_valor_serv > 500 then
																w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'moneda','P')
																w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'monto',ll_valor_serv)
																w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'monto_uf', round( ll_valor_serv / gd_uf,4))
															else
																w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'moneda','U')
																w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'monto_uf',ll_valor_serv)
																w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'monto', round( ll_valor_serv * gd_uf,0))
															end if
														elseif ls_moneda_ctto = '1' then
															w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'moneda','P')
															w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'monto',ll_valor_serv)
															w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'monto_uf', round( ll_valor_serv / gd_uf,4))
														end if
														w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.accepttext()
														if ll_valor_dscto_comer > 0 then
															ll_fila 							= dw_detalle_be.InsertRow(0)
															dw_detalle_be.scrolltorow(ll_fila)
															dw_detalle_be.SetItem(ll_fila, "uf", gd_uf)
															dw_detalle_be.SetItem(ll_fila, "folio", 0)
															dw_detalle_be.SetItem(ll_fila, "estado", 'N')
															dw_detalle_be.SetItem(ll_fila, 'base',gs_base)
															dw_detalle_be.SetItem(ll_fila, 'serie',gs_serie)
															dw_detalle_be.SetItem(ll_fila, 'numero',gi_numero)
															dw_detalle_be.setitem(ll_fila,'cod_servicio',ll_cod_servicio)
															if rb_be_uf.checked=true then
																dw_detalle_be.SetItem(ll_fila, "moneda",'U')
															else
																dw_detalle_be.SetItem(ll_fila, "moneda",'P')
															end if
															w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'tipo_cob','S')
															w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'cantidad',1)
															w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.accepttext()
															w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'tipo_cob_otro',ls_cod_dscto_comer)
															w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.accepttext()
															if ls_moneda_ctto = '2' then
																w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'moneda','U')
																w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'monto_uf',ll_valor_dscto_comer )
																w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'monto', round( ll_valor_dscto_comer * gd_uf,0) )
															elseif ls_moneda_ctto = '1' then
																w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'moneda','P')
																w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'monto',ll_valor_dscto_comer)
																w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'monto_uf', round( ll_valor_dscto_comer / gd_uf,4) )
															end if
														end if
													
														ll_sum_reg ++
														if ll_sum_reg <= ll_count_reg and not isnull(ls_codigo_otro_cur) then
															ll_fila	= w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.insertrow(0)
															idw_detalle.retrieve(gs_tipo_cobro)
															idw_detalle12.retrieve(gs_tipo_cobro)
															w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.scrolltorow(ll_fila)
															w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(ll_fila,'uf', gd_uf)
															w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(ll_fila,'folio', 0)
															w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(ll_fila,'estado', 'N')
															w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(ll_fila,'base',gs_base)
															w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(ll_fila,'serie',gs_serie)
															w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(ll_fila,'numero',gi_numero)
															w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'cantidad',1)
															if ls_moneda_ctto = '2' then
																w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(ll_fila, "moneda",'U')
															elseif ls_moneda_ctto = '1' then
																w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.SetItem(ll_fila, "moneda",'P')
															end if
															w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.accepttext()
															w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.scrolltorow(ll_fila)
														end if
													end if
												else
													if ll_sw_pago_reg=0 then
//														messagebox("Advertencia","Pago Ya Registrado")
														w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.deleterow(ll_fila)
														ll_sw_pago_reg++
													end if
												end if
											end if
											Setnull(ls_codigo_otro_cur)
										LOOP
									elseif ll_plazo > 1 and ldb_valor_cuota > 0 and ll_ctas_pagadas < ll_plazo  then
//										SELECT	SUM("SEGURO_ASOCIADOS"."MONTO_PRIMA")
//										INTO		:ldb_valor_seg
//										FROM 	"SEGURO_ASOCIADOS"  
//										WHERE ( "SEGURO_ASOCIADOS"."BASE" = :gs_base ) AND  
//												  ( "SEGURO_ASOCIADOS"."SERIE" = :gs_serie ) AND  
//												  ( "SEGURO_ASOCIADOS"."NUMERO" = :gi_numero ) AND  
//												  ( "SEGURO_ASOCIADOS"."ESTADO_REG" = 0 ) AND  
//												  ( "SEGURO_ASOCIADOS"."ESTADO_SEGURO" = 'A' )   AND
//												  ( "SEGURO_ASOCIADOS"."MONTO_PRIMA" > 0 ) AND
//												  ( "SEGURO_ASOCIADOS"."COD_SEGURO" <> 8 );
										ldb_valor_seg				= 0
										ldb_val_cta_ctto			= ldb_valor_cuota - ldb_valor_seg
										if ls_moneda_ctto='2' then
											ldb_valor_cuota		= ldb_val_cta_ctto
											ldb_valor_cuota_peso	= round( ldb_val_cta_ctto * gd_uf,0)
										elseif ls_moneda_ctto='1' then
											ldb_valor_cuota		= ldb_val_cta_ctto
											ldb_valor_cuota_peso	= ldb_val_cta_ctto
										end if
										w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'tipo_cob','E')
										w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'cod_servicio',ll_cod_servicio)
										w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'cantidad',1)
										w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.accepttext()
										w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'tipo_cob_otro',ls_codigo_otro_cur)
										w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.accepttext()
										if ls_moneda_ctto = '2' then
											if ll_valor_serv > 500 then
												w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'moneda','P')
												w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'monto',ldb_valor_cuota_peso)
												w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'monto_uf', ldb_valor_cuota)		//round( ldb_valor_cuota_peso / gd_uf,2))
											else
												w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'moneda','U')
												w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'monto_uf',ldb_valor_cuota )		//ll_valor_serv)
												w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'monto', ldb_valor_cuota_peso)	//round( ll_valor_serv * gd_uf,0))
											end if
										elseif ls_moneda_ctto = '1' then
											w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'moneda','P')
											w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'monto', ldb_valor_cuota_peso)	//ll_valor_serv)
											w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.setitem(ll_fila,'monto_uf', ldb_valor_cuota)		//round( ll_valor_serv / gd_uf,2))
										end if
									end if
								end if
								close cur_detalle_f;
								SELECT	SUM("SEGURO_ASOCIADOS"."MONTO_PRIMA")
								INTO		:ldb_valor_seg
								FROM 	"SEGURO_ASOCIADOS"  
								WHERE ( "SEGURO_ASOCIADOS"."BASE" = :gs_base ) AND  
										  ( "SEGURO_ASOCIADOS"."SERIE" = :gs_serie ) AND  
										  ( "SEGURO_ASOCIADOS"."NUMERO" = :gi_numero ) AND  
										  ( "SEGURO_ASOCIADOS"."ESTADO_REG" = 0 ) AND  
										  ( "SEGURO_ASOCIADOS"."ESTADO_SEGURO" = 'A' )   AND
										  ( "SEGURO_ASOCIADOS"."MONTO_PRIMA" > 0 ) ;
								if ldb_valor_seg > 0 then
									DECLARE x1 CURSOR FOR  
									SELECT	"SEGURO_ASOCIADOS"."COD_SEGURO",   
												"SEGURO_ASOCIADOS"."MONTO_PRIMA",
												"SEGURO_ASOCIADOS"."MONEDA"
									FROM 	"SEGURO_ASOCIADOS"  
									WHERE ( "SEGURO_ASOCIADOS"."BASE" = :gs_base ) AND  
											  ( "SEGURO_ASOCIADOS"."SERIE" = :gs_serie ) AND  
											  ( "SEGURO_ASOCIADOS"."NUMERO" = :gi_numero ) AND  
											  ( "SEGURO_ASOCIADOS"."ESTADO_REG" = 0 ) AND  
											  ( "SEGURO_ASOCIADOS"."ESTADO_SEGURO" = 'A' )   AND
											  ( "SEGURO_ASOCIADOS"."MONTO_PRIMA" > 0 ) 
//											  ( "SEGURO_ASOCIADOS"."COD_SEGURO" <> 8 )
									USING	sqlca;
									open x1;
									if sqlca.sqlcode=0 then
										do while sqlca.sqlcode=0
											fetch x1 into :ll_cod_seguro, :ldb_prima, :ls_moneda_ctto_seg;
											if not isnull(ll_cod_seguro) and ll_cod_seguro>0  then
												ll_count_adic			= 0
												ll_tot_reg				= dw_detalle_be.rowcount()
												for ll_indi =1 to ll_tot_reg
													ls_tipo_cob			= dw_detalle_be.GetItemString(ll_indi, "tipo_cob")
													if ls_tipo_cob = string(ll_cod_seguro) then
														ll_count_adic ++
														dw_detalle_be.setitem(ll_indi,'cantidad', 1)
													end if
												next
												dw_detalle_be.accepttext()
												if ll_count_adic = 0 then
													ll_new_seg		= dw_detalle_be.insertrow(0)
													dw_detalle_be.setitem(ll_new_seg,'tipo_cob', string(ll_cod_seguro))
													if rb_be_afecta.checked=true then
														dw_detalle_be.SetItem(ll_new_seg, "iva", idb_iva)
													end if
													dw_detalle_be.setitem(ll_new_seg,'cantidad', 1)
													dw_detalle_be.setitem(ll_new_seg,'cod_servicio',ll_cod_servicio)
													if ls_moneda_ctto_seg = '1' then
														dw_detalle_be.setitem(ll_new_seg,'monto_uf', round( ldb_prima / gd_uf,4))
														dw_detalle_be.setitem(ll_new_seg,'monto', ldb_prima)
													elseif ls_moneda_ctto_seg = '2' then
														dw_detalle_be.setitem(ll_new_seg,'monto_uf', ldb_prima)
														dw_detalle_be.setitem(ll_new_seg,'monto', round( ldb_prima * gd_uf,0))
													end if
													dw_detalle_be.setitem(ll_new_seg,'uf',gd_uf)
													dw_detalle_be.setitem(ll_new_seg,'estado','S')
												//	gd_uf
													if ls_moneda_ctto_seg='1' then
														dw_detalle_be.SetItem(ll_new_seg, "moneda",'P')
													else
														dw_detalle_be.SetItem(ll_new_seg, "moneda",'U')
													end if
												end if
											end if
											setnull(ll_cod_seguro)
										loop
									end if
									close x1;
									
								end if
								wf_calcular_interes('E')
								if isnull( w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.getitemnumber(1,'c_total')) or w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.getitemnumber(1,'c_total')=0 then
									w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1,'mora', ROUND(w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.Getitemnumber(1,'mora_cred') + w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.Getitemnumber(1,'mora_mant'),0))
									w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1,'gastos_cob',ROUND(w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.Getitemnumber(1,'gasto_cred') + w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.Getitemnumber(1,'gasto_mant'),0))
									ll_total_monto					= ROUND(w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.GetItemNumber(1,"c_subtotal_total"),0)
									w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1,"Subtotal", ll_total_monto)
								end if
								w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.accepttext()
								dw_detalle_be.accepttext()
								dw_gastos_be.accepttext()
								if gs_base = 'G' or gs_base = 'F' then
									//Script nuevo IVA Autor MM 22/12/2022
									if gs_tipo_cobro = 'BA' or gs_tipo_cobro='FA' then
										ll_fila_e							= tab_ingreso.tp_be.dw_detalle_be.find("tipo_cob = 'E' ",1,tab_ingreso.tp_be.dw_detalle_be.rowcount())
										if ll_fila_e > 0 then
											ll_ctas_pag_m				= tab_ingreso.tp_be.dw_datos_be.getitemnumber(1,'producto_anexo_cuotas_pag')
											ll_monto_cuota_reg		= tab_ingreso.tp_be.dw_detalle_be.getitemnumber(ll_fila_e,'c_total_linea')
											ll_cantidad_cta				= tab_ingreso.tp_be.dw_detalle_be.GetItemNumber(ll_fila_e, "cantidad")
											if isnull(ll_cantidad_cta) or ll_cantidad_cta = 0 then ll_cantidad_cta=1
											ll_cuota_ini					= ll_ctas_pag_m + 1
											ll_cuota_fin					= (ll_cuota_ini + ll_cantidad_cta) - 1
											SELECT SUM( "VISTA_MANTEN_IVA"."IVA"  )
											INTO    :ldb_iva
											FROM    "VISTA_MANTEN_IVA"  
											WHERE ( "VISTA_MANTEN_IVA"."BASE" = :gs_base ) AND  
													  ( "VISTA_MANTEN_IVA"."SERIE" = :gs_serie ) AND  
													  ( "VISTA_MANTEN_IVA"."NUMERO" = :gi_numero ) AND
													  ( "VISTA_MANTEN_IVA"."TIPO_MOV" = 'E' ) AND
													  ( "VISTA_MANTEN_IVA"."NRO_CUOTA" >= :ll_cuota_ini ) AND
													  ( "VISTA_MANTEN_IVA"."NRO_CUOTA" <= :ll_cuota_fin ) ;
											if ldb_iva > 0 and ll_monto_cuota_reg > 0 then
													if gs_base='G' then
														gs_tipo_cobro_aux		= 'BE'
													elseif gs_base='F' then
														gs_tipo_cobro_aux		= 'BA'
													end if
													ll_iva_f 						= ldb_iva		//round(ll_monto_cuota_reg * (idb_iva - 1),0)
													ll_new_iva					= dw_detalle_be.Find("tipo_cob = 'D'", 1, dw_detalle_be.rowcount())
													if ll_new_iva > 0 then
														if ldb_iva > 0 then
															dw_detalle_be.scrolltorow(ll_new_iva)
														else
															dw_detalle_be.deleterow(ll_new_iva)
														end if
													else
														ll_new_iva				= dw_detalle_be.insertrow(0)
													end if
													dw_detalle_be.setitem(ll_new_iva,'tipo_cob', 'D')
													dw_detalle_be.setitem(ll_new_iva,'cod_servicio',ll_cod_servicio)
													if rb_be_afecta.checked=true then
														dw_detalle_be.SetItem(ll_new_iva, "iva", idb_iva)
													end if
													dw_detalle_be.setitem(ll_new_iva,'cantidad', 1)
													ls_moneda_insert	= '1'
													if ls_moneda_insert = '1' then
														dw_detalle_be.setitem(ll_new_iva,'monto_uf', round( ll_iva_f / gd_uf,4))
														dw_detalle_be.setitem(ll_new_iva,'monto', ll_iva_f)
													end if
													dw_detalle_be.setitem(ll_new_iva,'uf',gd_uf)
													dw_detalle_be.setitem(ll_new_iva,'estado','S')
													dw_detalle_be.SetItem(ll_new_iva, "moneda",'P')
											  else
													ll_iva_f 				= 0
													gl_iva_exento_f		= ll_monto_cuota_reg
													ll_new_iva			= dw_detalle_be.Find("tipo_cob = 'D'", 1, dw_detalle_be.rowcount())
													if ll_new_iva > 0 then
														dw_detalle_be.deleterow(ll_new_iva)
													end if
											  end if
											  ll_mora_mant			= dw_gastos_be.getitemnumber(1,'mora_cred')
											  if ll_mora_mant > 0 then
												  SELECT  SUM("VISTA_MANTEN_IVA"."IVA")  
												  INTO    	:ldb_iva
												  FROM    "VISTA_MANTEN_IVA"  
												  WHERE   ( "VISTA_MANTEN_IVA"."BASE" = :gs_base ) AND  
															  ( "VISTA_MANTEN_IVA"."SERIE" = :gs_serie ) AND  
															  ( "VISTA_MANTEN_IVA"."NUMERO" = :gi_numero ) AND
															  ( "VISTA_MANTEN_IVA"."TIPO_MOV" = 'G' ) AND
															  ( "VISTA_MANTEN_IVA"."NRO_CUOTA" >= :ll_cuota_ini ) AND
															  ( "VISTA_MANTEN_IVA"."NRO_CUOTA" <= :ll_cuota_fin );
												  if ldb_iva > 0 and ll_mora_mant > 0 then
														if gs_base='G' then
															gs_tipo_cobro_aux		= 'BE'
														elseif gs_base='F' then
															gs_tipo_cobro_aux		= 'BA'
														end if
														ll_iva_p 					= round(ll_mora_mant * (idb_iva - 1),0)
														ll_new_iva				= dw_detalle_be.Find("tipo_cob = 'V'", 1, dw_detalle_be.rowcount())
														if ll_new_iva > 0 then
															dw_detalle_be.scrolltorow(ll_new_iva)
														else
															ll_new_iva			= dw_detalle_be.insertrow(0)
														end if
														dw_detalle_be.setitem(ll_new_iva,'tipo_cob', 'V')
														dw_detalle_be.setitem(ll_new_iva,'cod_servicio',ll_cod_servicio)
														if rb_be_afecta.checked=true then
															dw_detalle_be.SetItem(ll_new_iva, "iva", idb_iva)
														end if
														dw_detalle_be.setitem(ll_new_iva,'cantidad', 1)
														ls_moneda_insert	= '1'
														if ls_moneda_insert = '1' then
															dw_detalle_be.setitem(ll_new_iva,'monto_uf', round( ll_iva_p / gd_uf,4))
															dw_detalle_be.setitem(ll_new_iva,'monto', ll_iva_p)
														end if
														dw_detalle_be.setitem(ll_new_iva,'uf',gd_uf)
														dw_detalle_be.setitem(ll_new_iva,'estado','S')
														dw_detalle_be.SetItem(ll_new_iva, "moneda",'P')
												  else
														ll_iva_p 			= 0
												  end if
											  end if
											  ll_gasto_mant				= dw_gastos_be.getitemnumber(1,'gasto_cred')
											  if ll_gasto_mant > 0 then
												  SELECT  SUM("VISTA_MANTEN_IVA"."IVA" ) 
												  INTO    	:ldb_iva
												  FROM    "VISTA_MANTEN_IVA"  
												  WHERE ( "VISTA_MANTEN_IVA"."BASE" = :gs_base ) AND  
														  ( "VISTA_MANTEN_IVA"."SERIE" = :gs_serie ) AND  
														  ( "VISTA_MANTEN_IVA"."NUMERO" = :gi_numero ) AND
														  ( "VISTA_MANTEN_IVA"."TIPO_MOV" = 'J' ) AND
														  ( "VISTA_MANTEN_IVA"."NRO_CUOTA" >= :ll_cuota_ini ) AND
														  ( "VISTA_MANTEN_IVA"."NRO_CUOTA" <= :ll_cuota_fin );
												  if ldb_iva > 0 and ll_gasto_mant > 0 then
														if gs_base='G' then
															gs_tipo_cobro_aux		= 'BE'
														elseif gs_base='F' then
															gs_tipo_cobro_aux		= 'BA'
														end if
														ll_iva_r 						= round(ll_gasto_mant * (idb_iva - 1),0)
														ll_new_iva					= dw_detalle_be.Find("tipo_cob = 'X'", 1, dw_detalle_be.rowcount())
														if ll_new_iva > 0 then
															dw_detalle_be.scrolltorow(ll_new_iva)
														else
															ll_new_iva				= dw_detalle_be.insertrow(0)
														end if
														dw_detalle_be.setitem(ll_new_iva,'tipo_cob', 'X')
														dw_detalle_be.setitem(ll_new_iva,'cod_servicio',ll_cod_servicio)
														if rb_be_afecta.checked=true then
															dw_detalle_be.SetItem(ll_new_iva, "iva", idb_iva)
														end if
														dw_detalle_be.setitem(ll_new_iva,'cantidad', 1)
														ls_moneda_insert	= '1'
														if ls_moneda_insert = '1' then
															dw_detalle_be.setitem(ll_new_iva,'monto_uf', round( ll_iva_r / gd_uf,4))
															dw_detalle_be.setitem(ll_new_iva,'monto', ll_iva_r)
														end if
														dw_detalle_be.setitem(ll_new_iva,'uf',gd_uf)
														dw_detalle_be.setitem(ll_new_iva,'estado','S')
														dw_detalle_be.SetItem(ll_new_iva, "moneda",'P')
												  else
														ll_iva_r 			= 0
												  end if
											end if
										end if
									end if
									//Fin script nuevo IVA Autor MM 22/12/2022
									//ls_string		= "isnull(tipo_cob_otro) "
									ls_string			= "isnull(cod_servicio) "
									ll_fila				= dw_detalle_be.Find(ls_string, 1, dw_detalle_be.RowCount())
									if ll_fila > 0 then
										dw_detalle_be.deleterow(ll_fila)
									end if
								end if
								
								wf_calcular_interes('E')
								if isnull( w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.getitemnumber(1,'c_total')) or w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.getitemnumber(1,'c_total')=0 then
									w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1,'mora', ROUND(w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.Getitemnumber(1,'mora_cred') + w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.Getitemnumber(1,'mora_mant'),0))
									w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1,'gastos_cob',ROUND(w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.Getitemnumber(1,'gasto_cred') + w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.Getitemnumber(1,'gasto_mant'),0))
									ll_total_monto					= ROUND(w_ingreso2.tab_ingreso.tp_be.dw_detalle_be.GetItemNumber(1,"c_subtotal_total"),0)
									w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.SetItem(1,"Subtotal", ll_total_monto)
								end if
								w_ingreso2.tab_ingreso.tp_be.dw_gastos_be.accepttext()
							end if
						else
							if ll_plazo = 1 and ll_count_otro = 1 then
								messagebox("Advertencia","Pago Ya Registrado")
							elseif ll_plazo > 1 and ll_ctas_pagadas >= ll_plazo then
								messagebox("Advertencia","Contrato está Pagado")
							end if
//							dw_detalle_be.reset()
						end if
					end if
				end if
			end if
			dw_gastos_be.setfocus()
//			dw_detalle_be.setcolumn('tipo_cob')
	//	end if	
	end if
end if
end event

type st_help_insertar_be from statictext within tp_be
event ue_mousemove pbm_mousemove
boolean visible = false
integer x = 1390
integer y = 796
integer width = 343
integer height = 64
integer textsize = -8
integer weight = 400
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
long backcolor = 28573695
string text = "Insertar Item"
alignment alignment = center!
boolean border = true
boolean focusrectangle = false
end type

event ue_mousemove;wf_no_mostrar_help()
if is_opcion='FP' and (gs_depto='T' or gs_depto='I') then st_fuera_plazo.visible = true
end event

type cb_be_borrar from commandbutton within tp_be
event ue_mousemove pbm_mousemove
integer x = 32
integer y = 1412
integer width = 393
integer height = 96
integer taborder = 40
integer textsize = -9
integer weight = 700
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string text = "&Limpiar"
end type

event ue_mousemove;wf_no_mostrar_help_be()
if is_opcion='FP' and (gs_depto='T' or gs_depto='I') then st_fuera_plazo.visible = true
end event

event clicked;Long		ll_tot_reg,ll_indi,ll_folio,ll_count_reg,ll_ult_folio,ll_ctas_pagadas_pie,&
			ll_calc_ctas,ll_nulo,ll_count_ci,ll_count_abono
String	ls_cob,ls_tcp_ip,ls_nulo
Datetime	ldt_fecha_hoy,ldt_fecha_prim

//SELECT sysdate  INTO :gdt_fec_sistema  FROM "TASA"  WHERE "TASA"."LOOK" = 1   ;
//st_fecha.text					= string(gdt_fec_sistema,'dd/mm/yyyy')
gl_n_cuotas_pag 				= 0
il_modif							= 0
gl_valor_iva						= 0
gl_iva_exento_f					= 0
Setnull(gl_sw_mp)
Setnull(gl_codigo_mp)
cbx_reingresobe.checked	= false
cbx_reingresobe.enabled		= false
st_toku.visible					= false
Setnull(ll_nulo);Setnull(ls_nulo)
if rb_be_afecta.checked=true then
	gs_tipo_cobro				= 'BA'
	gs_tipo_cobro_aux			= 'BE'
elseif rb_be_exenta.checked=true then
	gs_tipo_cobro				= 'BE'
	gs_tipo_cobro_aux			= 'BE'
end if
Setnull(gs_tipo_cobro_aux2)
gs_reingreso_be				= 'N'
//idw_detalle2.retrieve(gs_tipo_cobro)
ll_folio							= long(sle_numero_be.text)
if cbx_manual_be.checked = false then
	if ll_folio > 0 then
		wf_limpiar_boleta_electronica(ll_folio)
	end if
end if
SELECT	 "FICHA_SEPULTACION"."IP"
INTO 		 :ls_tcp_ip  
FROM 	 "FICHA_SEPULTACION"  
WHERE  ( "FICHA_SEPULTACION"."BASE" = :gs_base ) AND  
		   ( "FICHA_SEPULTACION"."SERIE" = :gs_serie ) AND  
		   ( "FICHA_SEPULTACION"."NUMERO" = :gi_numero ) AND 
		   ( "FICHA_SEPULTACION"."IP" is not Null )   
USING		sqlca;
if not isnull(ls_tcp_ip) and ls_tcp_ip<>'' then
	UPDATE	"FICHA_SEPULTACION"  
	SET 		"FOLIO_COMPROBANTE" = :ll_nulo,
				"IP" = :ls_nulo
	WHERE 	"FICHA_SEPULTACION"."IP" = :ls_tcp_ip   
	USING		sqlca;
	if sqlca.sqlcode=0 then
		commit;
	else
		rollback;
	end if
else
	SELECT	 "FICHA_TRASLADO"."IP"
	INTO 		 :ls_tcp_ip
	FROM 	 "FICHA_TRASLADO"  
	WHERE  ( "FICHA_TRASLADO"."BASE_ORIGEN" = :gs_base ) AND  
			   ( "FICHA_TRASLADO"."SERIE_ORIGEN" = :gs_serie ) AND  
			   ( "FICHA_TRASLADO"."NUMERO_ORIGEN" = :gi_numero ) AND  
			   ( "FICHA_TRASLADO"."IP" is not null )   
	USING		sqlca;
	if not isnull(ls_tcp_ip) and ls_tcp_ip<>'' then
		UPDATE	"FICHA_TRASLADO"  
		SET 		"BOLETA_NRO_ORIGEN" = :ll_nulo,   
					"IP" = :ls_nulo  
		WHERE  ( "FICHA_TRASLADO"."IP" = :ls_tcp_ip ) AND  
				   ( "FICHA_TRASLADO"."BASE_ORIGEN" = :gs_base ) AND  
				   ( "FICHA_TRASLADO"."SERIE_ORIGEN" = :gs_serie ) AND  
				   ( "FICHA_TRASLADO"."NUMERO_ORIGEN" = :gi_numero )   
		USING		sqlca;
		if sqlca.sqlcode=0 then
			commit;
		else
			rollback;
		end if
	else
		SELECT	 "FICHA_TRASLADO"."IP"
		INTO 		 :ls_tcp_ip
		FROM 	 "FICHA_TRASLADO"  
		WHERE  ( "FICHA_TRASLADO"."BASE_DESTINO" = :gs_base ) AND  
				   ( "FICHA_TRASLADO"."SERIE_DESTINO" = :gs_serie ) AND  
				   ( "FICHA_TRASLADO"."NUMERO_DESTINO" = :gi_numero ) AND  
				   ( "FICHA_TRASLADO"."IP" is not null )   
		USING	sqlca;
		if not isnull(ls_tcp_ip) and ls_tcp_ip<>'' then
			UPDATE	"FICHA_TRASLADO"  
			SET 		"BOLETA_NRO_DESTINO" = :ll_nulo,   
						"IP" = :ls_nulo  
			WHERE  ( "FICHA_TRASLADO"."IP" = :ls_tcp_ip ) AND  
					   ( "FICHA_TRASLADO"."BASE_DESTINO" = :gs_base ) AND  
					   ( "FICHA_TRASLADO"."SERIE_DESTINO" = :gs_serie ) AND  
					   ( "FICHA_TRASLADO"."NUMERO_DESTINO" = :gi_numero )   
			USING	sqlca;
			if sqlca.sqlcode=0 then
				commit;
			else
				rollback;
			end if
		end if
	end if
end if
il_suma_dia								= 0
ll_tot_reg								= dw_detalle_be.rowcount()
if ll_tot_reg>0 then
	ll_count_reg 						= dw_detalle_be.Find("tipo_cob ='A' or tipo_cob ='Q'",1, ll_tot_reg)
	if ll_count_reg>0 and gs_grabar_pie='N' then
		setnull(ldt_fecha_prim)
		
		ldt_fecha_hoy					= datetime(date(gdt_fec_sistema),time('00:00:00'))
		SELECT	Count("DETALLE_PAGO_PIE"."FOLIO")
		INTO 		:ll_count_reg
		FROM 	"DETALLE_PAGO_PIE"
		WHERE  ( "DETALLE_PAGO_PIE"."BASE" = :gs_base ) AND  
				 ( "DETALLE_PAGO_PIE"."SERIE" = :gs_serie ) AND  
				 ( "DETALLE_PAGO_PIE"."NUMERO" = :gi_numero ) AND  
				 ( "DETALLE_PAGO_PIE"."TIPO_COB" = :gs_tipo_cobro ) AND  
				 ( "DETALLE_PAGO_PIE"."FOLIO" = :ll_folio ) AND  
				 ( "DETALLE_PAGO_PIE"."FECHA_PAGO" = :gd_fecha_pago_plazo )   
		USING		sqlca;
		if ll_count_reg>0 then
			UPDATE	"DETALLE_PAGO_PIE"  
			SET 		"TIPO_COB" = null,   
						"FOLIO" = null,   
						"CAJA" = null,   
						"USUARIO" = null,   
						"FECHA_PAGO" = null,   
						"MONTO_PIE_PAGADO_PESO" = null,
						"ESTADO" = 'P'  
			WHERE  ( "DETALLE_PAGO_PIE"."BASE" = :gs_base ) AND  
					 ( "DETALLE_PAGO_PIE"."SERIE" = :gs_serie ) AND  
					 ( "DETALLE_PAGO_PIE"."NUMERO" = :gi_numero ) AND  
					 ( "DETALLE_PAGO_PIE"."TIPO_COB" = :gs_tipo_cobro ) AND  
					 ( "DETALLE_PAGO_PIE"."FOLIO" = :ll_folio ) AND  
					 ( "DETALLE_PAGO_PIE"."FECHA_PAGO" = :gd_fecha_pago_plazo )   
			USING		sqlca;
			if sqlca.sqlcode=0 then
				commit;
				if gs_base = 'O' or gs_base='U' or gs_base='M' then
					SELECT	"PAGO_OFERTA"."FOLIO",
								"PAGO_OFERTA"."CTAS_PAGADAS_PIE",
								"PAGO_OFERTA"."FECHA_PRIM_PIE"
					INTO 		:ll_ult_folio,
								:ll_ctas_pagadas_pie,
								:ldt_fecha_prim
					FROM 	"CADENA",	"OFERTA_V",	"PAGO_OFERTA"  
					WHERE    ( "OFERTA_V"."SERIE" = "PAGO_OFERTA"."SERIE" ) and  
								 ( "OFERTA_V"."NRO_OFERTA" = "PAGO_OFERTA"."NRO_OFERTA" ) and  
								 ( "OFERTA_V"."ULT_FOLIO" = "PAGO_OFERTA"."FOLIO" ) and  
								 ( "CADENA"."SERIE" = "OFERTA_V"."SERIE" ) and  
								 ( "CADENA"."NUMERO" = "OFERTA_V"."NRO_OFERTA" ) and  
								 (("CADENA"."CODIGO" = :gs_base ) AND  
								 ( "CADENA"."SERIE" = :gs_serie ) AND  
								 ( "CADENA"."NUMERO" = :gi_numero ) )   
					USING		sqlca;
					if sqlca.sqlcode=0 then
						ll_calc_ctas	= ll_ctas_pagadas_pie - ll_count_reg
						if ll_calc_ctas<=0 then
							ll_calc_ctas	= 0
						end if
						UPDATE	"PAGO_OFERTA"  
						SET		"CTAS_PAGADAS_PIE" = :ll_calc_ctas,   
									"FECHA_PRIM_PIE" = :ldt_fecha_prim  
						WHERE  ( "PAGO_OFERTA"."SERIE" = :gs_serie ) AND  
								 ( "PAGO_OFERTA"."NRO_OFERTA" = :gi_numero ) AND  
								 ( "PAGO_OFERTA"."FOLIO" = :ll_ult_folio )   
						USING		sqlca;
						if sqlca.sqlcode=0 then
							commit;
						else
							rollback;
						end if
					end if
				elseif gs_base = 'A' then
					SELECT	"PAGO_AUMENTO"."FOLIO",
								"PAGO_AUMENTO"."CTAS_PAGADAS_PIE",
								"PAGO_AUMENTO"."FECHA_PRIM_PIE"
					INTO 		:ll_ult_folio,
								:ll_ctas_pagadas_pie,
								:ldt_fecha_prim
					FROM 	"CADENA",	"ANEXO_AUMENTO",	"PAGO_AUMENTO"  
					WHERE    ( "ANEXO_AUMENTO"."SERIE_M" = "PAGO_AUMENTO"."SERIE_M" ) and  
								 ( "ANEXO_AUMENTO"."NRO_AUMENTO" = "PAGO_AUMENTO"."NRO_AUMENTO" ) and  
								 ( "ANEXO_AUMENTO"."ULT_FOLIO" = "PAGO_AUMENTO"."FOLIO" ) and  
								 ( "CADENA"."SERIE" = "ANEXO_AUMENTO"."SERIE_M" ) and  
								 ( "CADENA"."NUMERO" = "ANEXO_AUMENTO"."NRO_AUMENTO" ) and  
								 (("CADENA"."CODIGO" = :gs_base ) AND  
								 ( "CADENA"."SERIE" = :gs_serie ) AND  
								 ( "CADENA"."NUMERO" = :gi_numero ) )   
					USING		sqlca;
					if sqlca.sqlcode=0 then
						ll_calc_ctas	= ll_ctas_pagadas_pie - ll_count_reg
						if ll_calc_ctas<=0 then
							ll_calc_ctas	= 0
						end if
						UPDATE	"PAGO_AUMENTO"  
						SET		"CTAS_PAGADAS_PIE" = :ll_calc_ctas,   
									"FECHA_PRIM_PIE" = :ldt_fecha_prim  
						WHERE  ( "PAGO_AUMENTO"."SERIE_M" = :gs_serie ) AND  
								 ( "PAGO_AUMENTO"."NRO_AUMENTO" = :gi_numero ) AND  
								 ( "PAGO_AUMENTO"."FOLIO" = :ll_ult_folio )   
						USING		sqlca;
						if sqlca.sqlcode=0 then
							commit;
						else
							rollback;
						end if
					end if
				elseif gs_base='L' then
					SELECT	"PAGO_LIBERADOR"."FOLIO",
								"PAGO_LIBERADOR"."CTAS_PAGADAS_PIE",
								"PAGO_LIBERADOR"."FECHA_PRIM_PIE"
					INTO 		:ll_ult_folio,
								:ll_ctas_pagadas_pie,
								:ldt_fecha_prim
					FROM 	"CADENA",	"ANEXO_LIBERADOR",	"PAGO_LIBERADOR"  
					WHERE    ( "ANEXO_LIBERADOR"."SERIE_M" = "PAGO_LIBERADOR"."SERIE_M" ) and  
								 ( "ANEXO_LIBERADOR"."NRO_LIBERADOR" = "PAGO_LIBERADOR"."NRO_LIBERADOR" ) and  
								 ( "ANEXO_LIBERADOR"."ULT_FOLIO" = "PAGO_LIBERADOR"."FOLIO" ) and  
								 ( "CADENA"."SERIE" = "ANEXO_LIBERADOR"."SERIE_M" ) and  
								 ( "CADENA"."NUMERO" = "ANEXO_LIBERADOR"."NRO_LIBERADOR" ) and  
								 (("CADENA"."CODIGO" = :gs_base ) AND  
								 ( "CADENA"."SERIE" = :gs_serie ) AND  
								 ( "CADENA"."NUMERO" = :gi_numero ) )   
					USING		sqlca;
					if sqlca.sqlcode=0 then
						ll_calc_ctas	= ll_ctas_pagadas_pie - ll_count_reg
						if ll_calc_ctas<=0 then
							ll_calc_ctas	= 0
						end if
						UPDATE	"PAGO_LIBERADOR"  
						SET		"CTAS_PAGADAS_PIE" = :ll_calc_ctas,   
									"FECHA_PRIM_PIE" = :ldt_fecha_prim  
						WHERE  ( "PAGO_LIBERADOR"."SERIE_M" = :gs_serie ) AND  
								 ( "PAGO_LIBERADOR"."NRO_LIBERADOR" = :gi_numero ) AND  
								 ( "PAGO_LIBERADOR"."FOLIO" = :ll_ult_folio )   
						USING		sqlca;
						if sqlca.sqlcode=0 then
							commit;
						else
							rollback;
						end if
					end if
				elseif gs_base='F' or gs_base='G' or gs_base='V' then
					SELECT	"PRODUCTO_PAGO"."FOLIO",
								"PRODUCTO_PAGO"."CTAS_PIE_PAGADAS",
								"PRODUCTO_PAGO"."FECHA_PIE_PRIM"
					INTO 		:ll_ult_folio,
								:ll_ctas_pagadas_pie,
								:ldt_fecha_prim
					FROM 	"CADENA",	"PRODUCTO_ANEXO",	"PRODUCTO_PAGO"  
					WHERE    ( "PRODUCTO_ANEXO"."SERIE" = "PRODUCTO_PAGO"."SERIE" ) and  
								 ( "PRODUCTO_ANEXO"."NUMERO" = "PRODUCTO_PAGO"."NUMERO" ) and  
								 ( "PRODUCTO_ANEXO"."ULT_FOLIO" = "PRODUCTO_PAGO"."FOLIO" ) and  
								 ( "CADENA"."SERIE" = "PRODUCTO_ANEXO"."SERIE" ) and  
								 ( "CADENA"."NUMERO" = "PRODUCTO_ANEXO"."NUMERO" ) and  
								 (("CADENA"."CODIGO" = :gs_base ) AND  
								 ( "CADENA"."SERIE" = :gs_serie ) AND  
								 ( "CADENA"."NUMERO" = :gi_numero ) )   
					USING		sqlca;
					if sqlca.sqlcode=0 then
						ll_calc_ctas	= ll_ctas_pagadas_pie - ll_count_reg
						if ll_calc_ctas<=0 then
							ll_calc_ctas	= 0
						end if
						UPDATE	"PRODUCTO_PAGO"  
						SET		"CTAS_PIE_PAGADAS" = :ll_calc_ctas,   
									"FECHA_PIE_PRIM" = :ldt_fecha_prim  
						WHERE  ( "PRODUCTO_PAGO"."SERIE" = :gs_serie ) AND  
								 ( "PRODUCTO_PAGO"."NUMERO" = :gi_numero ) AND  
								 ( "PRODUCTO_PAGO"."FOLIO" = :ll_ult_folio )   
						USING		sqlca;
						if sqlca.sqlcode=0 then
							commit;
						else
							rollback;
						end if
					end if
				end if
			else
				rollback;
			end if
		end if
	end if
end if

if ll_folio > 0 then
	SELECT	Count("INGRESO"."FOLIO")  
	INTO 		:ll_count_ci  
	FROM 	"INGRESO"  
	WHERE  ( "INGRESO"."TIPO_COB" = :gs_tipo_cobro ) AND  
			   ( "INGRESO"."FOLIO" = :ll_folio )   
	USING		sqlca;
	if ll_count_ci = 0 then
		SELECT	Count("ABONO_CTA_CTE"."FOLIO")  
		INTO 		:ll_count_abono  
		FROM 	"ABONO_CTA_CTE"  
		WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
				 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
				 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
				 ( "ABONO_CTA_CTE"."TIPO_COB" = :gs_tipo_cobro ) AND  
				 ( "ABONO_CTA_CTE"."FOLIO" = :ll_folio ) AND
				 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )  
		USING		sqlca;
		if ll_count_abono > 0 then
			DELETE FROM "ABONO_CTA_CTE"  
			WHERE		( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
						( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
						( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
						( "ABONO_CTA_CTE"."TIPO_COB" = :gs_tipo_cobro ) AND  
						( "ABONO_CTA_CTE"."FOLIO" = :ll_folio ) AND  
						( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
			USING		sqlca;
			if sqlca.sqlcode=0 then
				commit;
			else
				rollback;
				messagebox("Error Eliminar","Error ELIMINAR ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
			end if
		end if
		
		SELECT	Count("ABONO_CTA_CTE"."BASE")  
		INTO 		:ll_count_abono  
		FROM 	"ABONO_CTA_CTE"  
		WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
				 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
				 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
				 ( "ABONO_CTA_CTE"."TIPO_COB" = :gs_tipo_cobro ) AND  
				 ( "ABONO_CTA_CTE"."FOLIO" = :ll_folio ) AND
				 ( "ABONO_CTA_CTE"."TIPO_COB_OCUPA" = :gs_tipo_cobro ) AND  
				 ( "ABONO_CTA_CTE"."FOLIO_OCUPA" = :ll_folio ) AND 
				 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'O' )  
		USING		sqlca;
		if ll_count_abono > 0 then
			DELETE FROM "ABONO_CTA_CTE"  
			WHERE	( "ABONO_CTA_CTE"."TIPO_COB" = :gs_tipo_cobro ) AND  
						( "ABONO_CTA_CTE"."FOLIO" = :ll_folio ) AND  
						( "ABONO_CTA_CTE"."TIPO_COB_OCUPA" = :gs_tipo_cobro ) AND  
						( "ABONO_CTA_CTE"."FOLIO_OCUPA" = :ll_folio ) AND 
						( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
				 		( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
				 		( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
						( "ABONO_CTA_CTE"."ESTADO_REG" = 'O' )   
			USING		sqlca;
			if sqlca.sqlcode = 0 then
				commit;
			else
				rollback;
				messagebox("Error Eliminar","Error ELIMINAR ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
			end if
		end if
		
		SELECT	Count("ABONO_CTA_CTE"."FOLIO_OCUPA")  
		INTO 		:ll_count_abono  
		FROM 		"ABONO_CTA_CTE"  
		WHERE  ( "ABONO_CTA_CTE"."TIPO_COB_OCUPA" = :gs_tipo_cobro ) AND  
				 ( "ABONO_CTA_CTE"."FOLIO_OCUPA" = :ll_folio ) AND  
				 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'O' )
		USING		sqlca;
		if ll_count_abono > 0 then
			UPDATE	"ABONO_CTA_CTE"  
			SET 		"ESTADO_REG" = 'P',   
						"TIPO_COB_OCUPA" = Null,   
						"FOLIO_OCUPA" = Null,   
						"FECHA_OCUPA" = Null,   
						"MONTO_OCUPA" = Null,   
						"USUARIO_OCUPA" = Null,   
						"CAJA_OCUPA" = Null,   
						"TIPO_MOV_OCUPA" = Null  
			WHERE  ( "ABONO_CTA_CTE"."TIPO_COB_OCUPA" = :gs_tipo_cobro ) AND  
					 ( "ABONO_CTA_CTE"."FOLIO_OCUPA" = :ll_folio ) AND  
					 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'O' )
			USING		sqlca;
			if sqlca.sqlcode=0 then
				commit;
			else
				rollback;
				messagebox("Error Eliminar","Error UPDATE ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
			end if
		end if
		
	end if
end if
dw_be_buscar_cliente.SetItem(1,"rs_a_paterno", "")
dw_be_buscar_cliente.SetItem(1,"rs_a_materno", "")
dw_be_buscar_cliente.SetItem(1,"rs_nombre", "")
dw_be_buscar_cliente.SetItem(1,"rn_contrato","")
dw_be_buscar_cliente.SetItem(1,"rl_rut","")
dw_be_buscar_cliente.SetItem(1,"dv","")
dw_be_buscar_cliente.SetItem(1,"rs_bs","")
setnull(il_cantidad_malo)
cb_be_insertar.Enabled 						= FALSE
cb_be_borrar_item.Enabled 					= FALSE
cb_ingresar_pago_be.Enabled 				= FALSE
sle_numero_be.Enabled 						= FALSE
pb_ficha_be.enabled							= FALSE
cbx_manual_be.checked						= false
rb_be_exenta.checked						= true
rb_be_afecta.checked							= false
rb_be_exenta.enabled						= false
rb_be_afecta.enabled							= false
dw_be_buscar_cliente.enabled				= true
//cbx_manual_be.triggerevent(clicked!)
tab_ingreso.tp_be.gb_1_be.visible			= false
tab_ingreso.tp_be.rb_be_uf.visible			= false
tab_ingreso.tp_be.rb_be_peso.visible		= false
tab_ingreso.tp_be.rb_be_uf.checked		= false
tab_ingreso.tp_be.rb_be_peso.checked	= false
tab_ingreso.tp_be.cb_asigna_be.enabled= false
//setnull(gs_base);setnull(gs_serie);setnull(gi_numero)
gs_filtro											= ''
dw_detalle_be.Reset()
dw_gastos_be.Reset()
dw_datos_be.Reset()
sle_numero_be.text 							= ""
dw_be_buscar_cliente.reset()
