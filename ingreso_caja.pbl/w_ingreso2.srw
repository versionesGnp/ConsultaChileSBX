event clicked;Long		ll_tot_reg,ll_indi,ll_folio,ll_count_reg,ll_row,ll_ult_folio,ll_ctas_pagadas_pie,ll_tot_reg_dw,ll_calc_ctas,ll_ctas_pactadas_pie,ll_nulo,ll_count_abono,ll_count_e,ll_count_f,ll_cod_seguro,&
			ll_cantidad,ll_monto,ll_ctas,ll_ctas_pagadas,ll_ctas_pagadas_1,ll_ctas_pagadas_2,ll_fila,ll_monto_cred,ll_monto_mora_cred,ll_sum_monto_abono,ll_monto_cta,ll_monto_final_cred,&
			ll_monto_mant,ll_monto_mora_mant,ll_monto_final_mant,fila,ll_fila_iva,ll_fila_mant,ll_ctas_pag_m,ii_cantidad,ll_cuota_ini,ll_cuota_fin,ll_new_iva,ll_fila_cred
String		ls_cob,ls_nulo,ls_tcp_ip,ls_tipo_cob,ls_pasa,ls_moneda,ls_string,ls_moneda_insert,ls_elimina,ls_mov_mora,ls_mov_gasto
Datetime	ldt_fecha_hoy,ldt_fecha_prim
Double	ld_monto_uf,ll_monto_cuota_reg,ldb_iva,ll_iva_f,ll_mora_mant,ll_iva_p,ll_gasto_mant,ll_iva_r,ll_calcular_iva

Setnull(ll_nulo);Setnull(ls_nulo)
dw_detalle_be.accepttext()
ls_elimina				= 'N'
ls_tipo_cob				= gs_tipo_cobro
if gs_codigo_otro = "" then gs_codigo_otro = '0'
//if ls_tipo_cob = 'S' and gs_codigo_otro <> '0' then
//	wf_validar_descuento()
//end if
IF dw_detalle_be.RowCount() > 0 Then
	setnull(ldt_fecha_prim)
	ll_row					= dw_detalle_be.GetRow()
	ls_cob				= dw_detalle_be.getitemstring(ll_row,'tipo_cob')
	
	ls_tipo_cob = ls_cob		// vhfb
	
	ll_folio				= Long(sle_numero_be.text)
	ldt_fecha_hoy		= datetime(date(gdt_fec_sistema),time('00:00:00'))
	if (ls_cob='A' or ls_cob='Q') and gs_grabar_pie='N' then //pie
		SELECT	Count("DETALLE_PAGO_PIE"."BASE")  
		INTO 		:ll_count_reg  
		FROM 		"DETALLE_PAGO_PIE"  
		WHERE  ( "DETALLE_PAGO_PIE"."BASE" = :gs_base ) AND  
				 ( "DETALLE_PAGO_PIE"."SERIE" = :gs_serie ) AND  
				 ( "DETALLE_PAGO_PIE"."NUMERO" = :gi_numero ) AND  
				 ( "DETALLE_PAGO_PIE"."TIPO_COB" = :gs_tipo_cobro ) AND  
				 ( "DETALLE_PAGO_PIE"."FOLIO" = :ll_folio ) AND  
				 ( "DETALLE_PAGO_PIE"."FECHA_PAGO" = :gd_fecha_pago_plazo )   
		USING		sqlca;
		if ll_count_reg>0 then
			UPDATE	"DETALLE_PAGO_PIE"  
			SET 		"TIPO_COB" = null,   
						"FOLIO" = null,   
						"CAJA" = null,   
						"USUARIO" = null,   
						"FECHA_PAGO" = null,   
						"MONTO_PIE_PAGADO_PESO" = null,
						"ESTADO" = 'P'  
			WHERE  ( "DETALLE_PAGO_PIE"."BASE" = :gs_base ) AND  
					 ( "DETALLE_PAGO_PIE"."SERIE" = :gs_serie ) AND  
					 ( "DETALLE_PAGO_PIE"."NUMERO" = :gi_numero ) AND  
					 ( "DETALLE_PAGO_PIE"."TIPO_COB" = :gs_tipo_cobro ) AND  
					 ( "DETALLE_PAGO_PIE"."FOLIO" = :ll_folio ) AND  
					 ( "DETALLE_PAGO_PIE"."FECHA_PAGO" = :gd_fecha_pago_plazo )   
			USING		sqlca;
			if sqlca.sqlcode=0 then
				commit;
				SELECT	"PAGO_OFERTA"."FOLIO",
							"PAGO_OFERTA"."CTAS_PACTADAS_PIE",
							"PAGO_OFERTA"."CTAS_PAGADAS_PIE",
							"PAGO_OFERTA"."FECHA_PRIM_PIE"
				INTO 		:ll_ult_folio,
							:ll_ctas_pactadas_pie,
							:ll_ctas_pagadas_pie,
							:ldt_fecha_prim
				FROM 		"CADENA",	"OFERTA_V",	"PAGO_OFERTA"  
				WHERE  ( "OFERTA_V"."SERIE" = "PAGO_OFERTA"."SERIE" ) and  
						 ( "OFERTA_V"."NRO_OFERTA" = "PAGO_OFERTA"."NRO_OFERTA" ) and  
						 ( "OFERTA_V"."ULT_FOLIO" = "PAGO_OFERTA"."FOLIO" ) and  
						 ( "CADENA"."SERIE" = "OFERTA_V"."SERIE" ) and  
						 ( "CADENA"."NUMERO" = "OFERTA_V"."NRO_OFERTA" ) and  
						 (("CADENA"."CODIGO" = :gs_base ) AND  
						 ( "CADENA"."SERIE" = :gs_serie ) AND  
						 ( "CADENA"."NUMERO" = :gi_numero ) )   
				USING		sqlca;
				if sqlca.sqlcode=0 then
					ll_calc_ctas	= ll_ctas_pagadas_pie - ll_count_reg
					if ll_calc_ctas<=0 then
						ll_calc_ctas	= 0
					end if
					UPDATE	"PAGO_OFERTA"  
					SET		"CTAS_PAGADAS_PIE" = :ll_calc_ctas,   
								"FECHA_PRIM_PIE" = :ldt_fecha_prim  
					WHERE  ( "PAGO_OFERTA"."SERIE" = :gs_serie ) AND  
							 ( "PAGO_OFERTA"."NRO_OFERTA" = :gi_numero ) AND  
							 ( "PAGO_OFERTA"."FOLIO" = :ll_ult_folio )   
					USING		sqlca;
					if sqlca.sqlcode=0 then
						commit;
					else
						rollback;
					end if
				end if
			else
				rollback;
			end if
		end if
	end if
	if ls_cob='A' then f_validar_pie_pactado_actualizar('BA',dw_datos_be.dataobject,gs_base,gs_serie,gi_numero)
	ll_fila_iva					= dw_detalle_be.Find("tipo_cob = 'M' or tipo_cob = 'F'", 1, dw_detalle_be.RowCount())
	if ll_fila_iva > 0 then
		ls_elimina			= 'S'
	else
		ll_fila_iva				= dw_detalle_be.Find("tipo_cob = 'E' ", 1, dw_detalle_be.RowCount())
		if ll_fila_iva > 0 and gs_base='L' then
			ls_elimina		= 'S'
		end if
	end if
		
	if ls_cob = '1' or ls_cob = '2' or ls_cob = '3' or ls_cob = '4' or ls_cob = '5' or ls_cob = '6' or ls_cob = '7' then
		messagebox("Advertencia","No es Posible Eliminar Item, recuerde debe Eliminar E-Cuota o U-Cuota Reconocimiento")
		dw_detalle_be.setfocus()
	elseif gs_base='L' and (ls_cob = 'D' or ls_cob = 'V' or ls_cob = 'X') and ls_elimina='S' then
		messagebox("Advertencia","No es Posible Eliminar Item, recuerde debe Eliminar E-Cuota Crédio")
		dw_detalle_be.setfocus()
	elseif (gs_base='U' and ls_elimina='S' and (ls_cob = 'D' or ls_cob = 'V' or ls_cob = 'X')) or (gs_base='O' and ls_elimina='S' and (ls_cob = 'D' or ls_cob = 'V' or ls_cob = 'X')) or (gs_base='C' and ls_elimina='S' and (ls_cob = 'D' or ls_cob = 'V' or ls_cob = 'X')) then
		messagebox("Advertencia","No es Posible Eliminar Item, recuerde debe Eliminar F-Cuota Mantención o  M-Derecho Sepultación")
		dw_detalle_be.setfocus()
	else
		dw_detalle_be.DeleteRow(ll_row)
		dw_detalle_be.accepttext()
		ll_tot_reg_dw			= dw_detalle_be.RowCount()
		if ls_cob='E' or ls_cob='U' then
			DECLARE x1 CURSOR FOR  
			SELECT	"SEGURO_ASOCIADOS"."COD_SEGURO"  
			FROM 	"SEGURO_ASOCIADOS"  
			WHERE ( "SEGURO_ASOCIADOS"."BASE" = :gs_base ) AND  
					  ( "SEGURO_ASOCIADOS"."SERIE" = :gs_serie ) AND  
					  ( "SEGURO_ASOCIADOS"."NUMERO" = :gi_numero ) AND  
					  ( "SEGURO_ASOCIADOS"."ESTADO_REG" = 0 ) AND  
					  ( "SEGURO_ASOCIADOS"."ESTADO_SEGURO" = 'A' )   
			USING	sqlca;
			open x1;
			if sqlca.sqlcode=0 then
				do while sqlca.sqlcode=0
					fetch x1 into :ll_cod_seguro;
					if not isnull(ll_cod_seguro) then
						ll_fila						= dw_detalle_be.Find("tipo_cob = '"+string(ll_cod_seguro)+"'",1, ll_tot_reg_dw)
						if ll_fila > 0 then
							dw_detalle_be.DeleteRow(ll_fila)
							ll_tot_reg_dw			= dw_detalle_be.RowCount()
						end if
					end if
					setnull(ll_cod_seguro)
				loop
			end if
			close x1;
			dw_detalle_be.accepttext()
			if dw_detalle_be.RowCount() > 0 then
				cb_be_borrar_item.Enabled	= True
				dw_gastos_be.SetItem(1,"gastos_cob", 0)
				dw_gastos_be.SetItem(1,"mora", 0)
				dw_gastos_be.SetItem(1,"subtotal", 0)
				
				dw_gastos_be.SetItem(1,"mora_cred", 0)
				dw_gastos_be.SetItem(1,"mora_mant", 0)
				dw_gastos_be.SetItem(1,"gasto_cred", 0)
				dw_gastos_be.SetItem(1,"gasto_mant", 0)
				il_int_mora			= 0
				il_int_gc				= 0
				il_suma_dia			= 0
				il_int_gc_cred		= 0
				il_int_gc_mant		= 0
				il_int_gc_cred		= 0
				il_int_gc_mant		= 0
			else
				cbx_paga_ef_be.enabled	= false
			end if
		end if
		
		if dw_detalle_be.rowcount()>0 then 
			wf_calcular_interes("E")
	//		wf_calcular_interes("U")
	//		dw_gastos_be.SetItem(1, "Subtotal",dw_detalle_be.GetItemNumber(1,"c_subtotal"))
		else
			cb_be_borrar_item.Enabled	= FALSE
			cbx_paga_ef_be.enabled			= false
			dw_gastos_be.SetItem(1,"gastos_cob", 0)
			dw_gastos_be.SetItem(1,"mora", 0)
			dw_gastos_be.SetItem(1,"subtotal", 0)
			
			dw_gastos_be.SetItem(1,"mora_cred", 0)
			dw_gastos_be.SetItem(1,"mora_mant", 0)
			dw_gastos_be.SetItem(1,"gasto_cred", 0)
			dw_gastos_be.SetItem(1,"gasto_mant", 0)
			il_int_mora			= 0
			il_int_gc				= 0
			il_suma_dia			= 0
			il_int_mora_cred	= 0
			il_int_mora_mant	= 0
			il_int_gc_cred		= 0
			il_int_gc_mant		= 0
		end if
		if (gs_base='G' and (ls_cob='E' or ls_cob='U')) or (gs_base='L' and (ls_cob='E' or ls_cob='U')) or ls_cob='F' or ls_cob='M' then
			ll_tot_reg_dw			= dw_detalle_be.rowcount()
			ll_fila						= dw_detalle_be.Find("tipo_cob = 'D'",1, ll_tot_reg_dw)
			if ll_fila > 0 then
				dw_detalle_be.DeleteRow(ll_fila)
				dw_detalle_be.accepttext()
			end if
			ll_tot_reg_dw			= dw_detalle_be.rowcount()
			ll_fila						= dw_detalle_be.Find("tipo_cob = 'V'",1, ll_tot_reg_dw)
			if ll_fila > 0 then
				dw_detalle_be.DeleteRow(ll_fila)
				dw_detalle_be.accepttext()
			end if
			ll_tot_reg_dw			= dw_detalle_be.rowcount()
			ll_fila						= dw_detalle_be.Find("tipo_cob = 'X'",1, ll_tot_reg_dw)
			if ll_fila > 0 then
				dw_detalle_be.DeleteRow(ll_fila)
				dw_detalle_be.accepttext()
			end if
		elseif ls_cob='S' then
			ll_tot_reg_dw			= dw_detalle_be.rowcount()
			ll_fila						= dw_detalle_be.Find("tipo_cob = 'D'",1, ll_tot_reg_dw)
			if ll_fila > 0 then
				messagebox("Advertencia","Recuerde se Eliminarán Todos Los Items de Pagos")
				dw_detalle_be.reset()
				dw_detalle_be.accepttext()
			end if
			ll_tot_reg_dw			= dw_detalle_be.rowcount()
			ll_fila						= dw_detalle_be.Find("tipo_cob = 'V'",1, ll_tot_reg_dw)
			if ll_fila > 0 then
				messagebox("Advertencia","Recuerde se Eliminarán Todos Los Items de Pagos")
				dw_detalle_be.reset()
				dw_detalle_be.accepttext()
			end if
			ll_tot_reg_dw			= dw_detalle_be.rowcount()
			ll_fila						= dw_detalle_be.Find("tipo_cob = 'X'",1, ll_tot_reg_dw)
			if ll_fila > 0 then
				messagebox("Advertencia","Recuerde se Eliminarán Todos Los Items de Pagos")
				dw_detalle_be.reset()
				dw_detalle_be.accepttext()
			end if
		end if
		dw_detalle_be.accepttext()
		wf_calcular_interes(ls_tipo_cob)
		if ll_folio > 0 then
			SELECT	Count("ABONO_CTA_CTE"."BASE")  
			INTO 		:ll_count_e  
			FROM 		"ABONO_CTA_CTE"  
			WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
					 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
					 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
					 ( "ABONO_CTA_CTE"."TIPO_COB_OCUPA" = :ls_tipo_cob ) AND  
					 ( "ABONO_CTA_CTE"."FOLIO_OCUPA" = :ll_folio ) AND  
					 ( "ABONO_CTA_CTE"."TIPO_MOV_OCUPA" = 'E' )   
			USING		sqlca;
			
			SELECT	Count("ABONO_CTA_CTE"."BASE")  
			INTO 		:ll_count_f  
			FROM 		"ABONO_CTA_CTE"  
			WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
					 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
					 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
					 ( "ABONO_CTA_CTE"."TIPO_COB_OCUPA" = :ls_tipo_cob ) AND  
					 ( "ABONO_CTA_CTE"."FOLIO_OCUPA" = :ll_folio ) AND  
					 ( "ABONO_CTA_CTE"."TIPO_MOV_OCUPA" = 'F' )   
			USING		sqlca;
		
			
			SELECT	Count("ABONO_CTA_CTE"."BASE")  
			INTO 		:ll_count_abono  
			FROM 		"ABONO_CTA_CTE"  
			WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
					 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
					 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
					 ( "ABONO_CTA_CTE"."TIPO_COB" = :ls_tipo_cob ) AND  
					 ( "ABONO_CTA_CTE"."FOLIO" = :ll_folio ) AND
					 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )  
			USING		sqlca;
			if ll_count_abono > 0 then
				DELETE FROM "ABONO_CTA_CTE"  
				WHERE		( "ABONO_CTA_CTE"."TIPO_COB" = :ls_tipo_cob ) AND  
							( "ABONO_CTA_CTE"."FOLIO" = :ll_folio ) AND  
							( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
							( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
							( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
							( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
				USING		sqlca;
				if sqlca.sqlcode = 0 then
					commit;
					ls_pasa			= 'S'
				else
					rollback;
					messagebox("Error Eliminar","Error ELIMINAR ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
				end if
			end if
			SELECT	Count("ABONO_CTA_CTE"."BASE")  
			INTO 		:ll_count_abono  
			FROM 		"ABONO_CTA_CTE"  
			WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
					 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
					 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
					 ( "ABONO_CTA_CTE"."TIPO_COB" = :ls_tipo_cob ) AND  
					 ( "ABONO_CTA_CTE"."FOLIO" = :ll_folio ) AND
					 ( "ABONO_CTA_CTE"."TIPO_COB_OCUPA" = :ls_tipo_cob ) AND  
					 ( "ABONO_CTA_CTE"."FOLIO_OCUPA" = :ll_folio ) AND 
					 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'O' )  
			USING		sqlca;
			if ll_count_abono > 0 then
				DELETE FROM "ABONO_CTA_CTE"  
				WHERE		( "ABONO_CTA_CTE"."TIPO_COB" = :ls_tipo_cob ) AND  
							( "ABONO_CTA_CTE"."FOLIO" = :ll_folio ) AND  
							( "ABONO_CTA_CTE"."TIPO_COB_OCUPA" = :ls_tipo_cob ) AND  
							( "ABONO_CTA_CTE"."FOLIO_OCUPA" = :ll_folio ) AND 
							( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
							( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
							( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
							( "ABONO_CTA_CTE"."ESTADO_REG" = 'O' )   
				USING		sqlca;
				if sqlca.sqlcode = 0 then
					commit;
					ls_pasa			= 'S'
				else
					rollback;
					messagebox("Error Eliminar","Error ELIMINAR ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
				end if
			end if
			SELECT	Count("ABONO_CTA_CTE"."BASE")  
			INTO 		:ll_count_abono  
			FROM 		"ABONO_CTA_CTE"  
			WHERE  ( "ABONO_CTA_CTE"."TIPO_COB_OCUPA" = :ls_tipo_cob ) AND  
					 ( "ABONO_CTA_CTE"."FOLIO_OCUPA" = :ll_folio ) AND  
					 ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
					 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
					 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
					 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'O' )
			USING		sqlca;
			if ll_count_abono > 0 then
				UPDATE	"ABONO_CTA_CTE"  
				SET 		"ESTADO_REG" = 'P',   
							"TIPO_COB_OCUPA" = Null,   
							"FOLIO_OCUPA" = Null,   
							"FECHA_OCUPA" = Null,   
							"MONTO_OCUPA" = Null,   
							"USUARIO_OCUPA" = Null,   
							"CAJA_OCUPA" = Null,   
							"TIPO_MOV_OCUPA" = Null  
				WHERE  ( "ABONO_CTA_CTE"."TIPO_COB_OCUPA" = :ls_tipo_cob ) AND  
						 ( "ABONO_CTA_CTE"."FOLIO_OCUPA" = :ll_folio ) AND  
						 ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
						 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
						 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
						 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'O' )
				USING		sqlca;
				if sqlca.sqlcode=0 then
					commit;
					ls_pasa			= 'S'
				else
					rollback;
					messagebox("Error Eliminar","Error UPDATE ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
				end if
			end if
			if ls_pasa = 'S' then
				ll_tot_reg		= dw_detalle_be.rowcount()
				for ll_indi=1 to ll_tot_reg
					ls_tipo_cob	= dw_detalle_be.getitemstring(ll_indi,'tipo_cob')
					ll_cantidad	= dw_detalle_be.getitemnumber(ll_indi,'cantidad')
					ll_monto		= dw_detalle_be.getitemnumber(ll_indi,'monto')
					ld_monto_uf	= dw_detalle_be.getitemnumber(ll_indi,'monto_uf')
					ls_moneda	= dw_detalle_be.getitemstring(ll_indi,'moneda')
					if ls_tipo_cob='E' and ll_count_e > 0 then
						if (gs_base='O' or gs_base='U' or gs_base='M') and dw_datos_be.DataObject='d_datos_cuenta_be_oferta' then
							ll_ctas				= dw_datos_be.getitemnumber(1,'pago_oferta_nro_cuotas')
							ll_ctas_pagadas	= dw_datos_be.getitemnumber(1,'oferta_v_cta_pag_s')
						elseif gs_base='P' and dw_datos_be.DataObject='d_datos_cuenta_be_pagare' then
							ll_ctas				= dw_datos_be.getitemnumber(1,'pagare_plazo')
							ll_ctas_pagadas_1	= dw_datos_be.getitemnumber(1,'pagare_cta_pag_la')
							ll_ctas_pagadas_2	= dw_datos_be.getitemnumber(1,'pagare_cta_pag_isa')
							ll_ctas_pagadas	= ll_ctas_pagadas_1 + ll_ctas_pagadas_2
						elseif gs_base='L' and dw_datos_be.DataObject='d_datos_cuenta_be_liberador' then
							ll_ctas				= dw_datos_be.getitemnumber(1,'pago_liberador_nro_cuotas')
							ll_ctas_pagadas	= dw_datos_be.getitemnumber(1,'anexo_liberador_cta_pag_m')
						elseif gs_base='D' and dw_datos_be.DataObject='d_datos_cuenta_be_derecho' then
							ll_ctas				= dw_datos_be.getitemnumber(1,'derecho_plazo')
							ll_ctas_pagadas_1	= dw_datos_be.getitemnumber(1,'derecho_cta_pag_la')
							ll_ctas_pagadas_2	= dw_datos_be.getitemnumber(1,'derecho_cta_pag_isa')
							ll_ctas_pagadas	= ll_ctas_pagadas_1 + ll_ctas_pagadas_2
						elseif gs_base='A' and dw_datos_be.DataObject='d_datos_cuenta_be_aumento_capacidad' then
							ll_ctas				= dw_datos_be.getitemnumber(1,'pago_aumento_nro_cuotas')
							ll_ctas_pagadas	= dw_datos_be.getitemnumber(1,'anexo_aumento_cta_pag_m')
						elseif gs_base='R' and dw_datos_be.DataObject='dw_repacta_mant_descripcion_traspaso' then
							ll_ctas				= dw_datos_be.getitemnumber(1,'cuotas_pactadas')
							ll_ctas_pagadas	= dw_datos_be.getitemnumber(1,'ctas_pagadas')
						elseif (gs_base='G' or gs_base='F' or gs_base='V') and dw_datos_be.DataObject='d_datos_cuenta_ci_funeraria' then
							ll_ctas				= dw_datos_be.getitemnumber(1,'producto_pago_plazo')
							ll_ctas_pagadas	= dw_datos_be.getitemnumber(1,'producto_anexo_cuotas_pag')
						end if
						if gs_base<>'C' then
							
							ll_monto_cred					= round(dw_datos_be.GetItemNumber(1,"c_valor_cuota_pesos"),0)
							ll_monto_mora_cred			= wf_calcular_solo_mora(ll_indi)
							ll_monto_mora_cred			= ll_monto_mora_cred	+ wf_calcular_solo_gc(ll_indi)
							SELECT	SUM("ABONO_CTA_CTE"."MONTO")  
							INTO 		:ll_sum_monto_abono  
							FROM 		"ABONO_CTA_CTE"  
							WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
									 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
									 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero )  AND 
									 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
							USING		sqlca;
							if ll_sum_monto_abono > 0 then
								ll_monto_cta				= ll_monto_cred * dw_detalle_be.getitemnumber(ll_indi,'cantidad')
								if ll_sum_monto_abono >= (ll_monto_cta + ll_monto_mora_cred) then
									ll_monto_final_cred	= round(ll_sum_monto_abono - ( ll_monto_cta + ll_monto_mora_cred),0)
									ll_monto_final_cred ++
									UPDATE	"ABONO_CTA_CTE"  
									SET 		"TIPO_COB_OCUPA" = :gs_tipo_cobro,   
												"FOLIO_OCUPA" = :ll_folio,   
												"FECHA_OCUPA" = :ldt_fecha_hoy,   
												"MONTO_OCUPA" = (:ll_monto_cta + :ll_monto_mora_cred) - 1,   
												"USUARIO_OCUPA" = :gs_user,   
												"CAJA_OCUPA" = :gs_caja,   
												"ESTADO_REG" = 'O',
												"TIPO_MOV_OCUPA" = :ls_tipo_cob  
									WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
											 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
											 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
											 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
									USING		sqlca;
									if sqlca.sqlcode=0 then
										commit;
										gdt_fec_sistema	= datetime(date(gdt_fec_sistema), RelativeTime(Now(), 5))
										INSERT INTO "ABONO_CTA_CTE"  
													( "RUT",		"BASE",		"SERIE",		"NUMERO",	"TIPO_COB",	"FOLIO",		"MONTO",						"FECHA_CREA",		"USUARIO_CREA",	"CAJA_CREA",	"ESTADO_REG",	"TIPO_COB_OCUPA",	"FOLIO_OCUPA",	"FECHA_OCUPA",	"MONTO_OCUPA",	"USUARIO_OCUPA",	"CAJA_OCUPA",	"TIPO_MOV_OCUPA" )
										VALUES 	( :gi_rut,	:gs_base,	:gs_serie,	:gi_numero,	:gs_tipo_cobro,			:ll_folio,	:ll_monto_final_cred,	:gdt_fec_sistema,	:gs_user,			:gs_caja,		'P',				null,					null,				null,				null,				null,					null,				null )  
										USING		sqlca;
										if sqlca.sqlcode=0 then
											commit;
										else
											rollback;
											messagebox("Error Grabar","Error al INSERTAR ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
										end if
									else
										rollback;
										messagebox("Error Grabar","Error al UPDATE ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
									end if
								else
									UPDATE	"ABONO_CTA_CTE"  
									SET 		"TIPO_COB_OCUPA" = :gs_tipo_cobro,   
												"FOLIO_OCUPA" = :ll_folio,   
												"FECHA_OCUPA" = :ldt_fecha_hoy,   
												"MONTO_OCUPA" = :ll_sum_monto_abono,   
												"USUARIO_OCUPA" = :gs_user,   
												"CAJA_OCUPA" = :gs_caja,   
												"ESTADO_REG" = 'O',
												"TIPO_MOV_OCUPA" = :ls_tipo_cob
									WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
											 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
											 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
											 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
									USING		sqlca;
									if sqlca.sqlcode=0 then
										commit;
									else
										rollback;
										messagebox("Error Grabar","Error al Update ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
									end if
								end if
							else
								ll_monto_final_cred				= ll_monto_cred
							end if
							
						
						end if
						
					elseif ls_tipo_cob='F' and ll_count_f > 0 then
						ll_monto_mant					= round(dw_datos_be.GetItemNumber(1,"c_valor_cuota_mantencion_pesos"),0)
						ll_monto_cta					= ll_monto_mant * dw_detalle_be.getitemnumber(ll_indi,'cantidad')
						SELECT	SUM("ABONO_CTA_CTE"."MONTO")  
						INTO 		:ll_sum_monto_abono  
						FROM 		"ABONO_CTA_CTE"  
						WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
								 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
								 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND
								 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )
						USING		sqlca;
						if ll_sum_monto_abono > 0 then
							ll_monto_mant				= ll_monto_mant - dw_detalle_be.getitemnumber(ll_indi,'cantidad')
							ll_monto_mora_mant		= wf_calcular_solo_mora_mant(ll_indi)
							ll_monto_mora_mant		= ll_monto_mora_mant + wf_calcular_solo_gc_mant(ll_indi)
							if ll_sum_monto_abono >= (ll_monto_cta + ll_monto_mora_mant)  then
								ll_monto_final_mant	= round(ll_sum_monto_abono - ( ll_monto_cta + ll_monto_mora_mant ) ,0)
								ll_monto_final_mant ++
								UPDATE	"ABONO_CTA_CTE"  
								SET 		"TIPO_COB_OCUPA" = :gs_tipo_cobro,   
											"FOLIO_OCUPA" = :ll_folio,   
											"FECHA_OCUPA" = :ldt_fecha_hoy,   
											"MONTO_OCUPA" = (:ll_monto_cta + :ll_monto_mora_mant) - 1,   
											"USUARIO_OCUPA" = :gs_user,   
											"CAJA_OCUPA" = :gs_caja,   
											"ESTADO_REG" = 'O',
											"TIPO_MOV_OCUPA" = :ls_tipo_cob
								WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
										 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
										 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
										 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
								USING		sqlca;
								if sqlca.sqlcode=0 then
									commit;
									gdt_fec_sistema	= datetime(date(gdt_fec_sistema), RelativeTime(Now(), 10))
									INSERT INTO "ABONO_CTA_CTE"  
												( "RUT",		"BASE",		"SERIE",		"NUMERO",	"TIPO_COB",	"FOLIO",		"MONTO",						"FECHA_CREA",		"USUARIO_CREA",	"CAJA_CREA",	"ESTADO_REG",	"TIPO_COB_OCUPA",	"FOLIO_OCUPA",	"FECHA_OCUPA",	"MONTO_OCUPA",	"USUARIO_OCUPA",	"CAJA_OCUPA",	"TIPO_MOV_OCUPA" )
									VALUES 	( :gi_rut,	:gs_base,	:gs_serie,	:gi_numero,	:gs_tipo_cobro,			:ll_folio,	:ll_monto_final_mant,	:gdt_fec_sistema,	:gs_user,			:gs_caja,		'P',				null,					null,				null,				null,				null,					null,				null )  
									USING		sqlca;
									if sqlca.sqlcode=0 then
										commit;
									else
										rollback;
										messagebox("Error Grabar","Error al INSERTAR ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
									end if
								else
									rollback;
									messagebox("Error Grabar","Error al UPDATE ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
								end if
							else
								UPDATE	"ABONO_CTA_CTE"  
								SET 		"TIPO_COB_OCUPA" = :gs_tipo_cobro,   
											"FOLIO_OCUPA" = :ll_folio,   
											"FECHA_OCUPA" = :ldt_fecha_hoy,   
											"MONTO_OCUPA" = :ll_sum_monto_abono,   
											"USUARIO_OCUPA" = :gs_user,   
											"CAJA_OCUPA" = :gs_caja,   
											"ESTADO_REG" = 'O',
											"TIPO_MOV_OCUPA" = :ls_tipo_cob
								WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
										 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
										 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
										 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
								USING		sqlca;
								if sqlca.sqlcode=0 then
									commit;
								else
									rollback;
									messagebox("Error Grabar","Error al Update ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
								end if
							end if
						end if
					end if
				next
			end if
		end if
	end if
else
	Setnull(ll_nulo);Setnull(ls_nulo)
	SELECT	"FICHA_SEPULTACION"."IP"
	INTO 		:ls_tcp_ip  
	FROM 		"FICHA_SEPULTACION"  
	WHERE  ( "FICHA_SEPULTACION"."BASE" = :gs_base ) AND  
			 ( "FICHA_SEPULTACION"."SERIE" = :gs_serie ) AND  
			 ( "FICHA_SEPULTACION"."NUMERO" = :gi_numero ) AND 
			 ( "FICHA_SEPULTACION"."IP" is not Null )   
	USING		sqlca;
	if not isnull(ls_tcp_ip) and ls_tcp_ip<>'' then
		UPDATE	"FICHA_SEPULTACION"  
		SET 		"FOLIO_COMPROBANTE" = :ll_nulo,
					"IP" = :ls_nulo
		WHERE 	"FICHA_SEPULTACION"."IP" = :ls_tcp_ip   
		USING		sqlca;
		if sqlca.sqlcode=0 then
			commit;
		else
			rollback;
		end if
	else
		SELECT	"FICHA_TRASLADO"."IP"
		INTO 		:ls_tcp_ip
		FROM 		"FICHA_TRASLADO"  
		WHERE  ( "FICHA_TRASLADO"."BASE_ORIGEN" = :gs_base ) AND  
				 ( "FICHA_TRASLADO"."SERIE_ORIGEN" = :gs_serie ) AND  
				 ( "FICHA_TRASLADO"."NUMERO_ORIGEN" = :gi_numero ) AND  
				 ( "FICHA_TRASLADO"."IP" is not null )   
		USING		sqlca;
		if not isnull(ls_tcp_ip) and ls_tcp_ip<>'' then
			UPDATE	"FICHA_TRASLADO"  
			SET 		"BOLETA_NRO_ORIGEN" = :ll_nulo,   
						"IP" = :ls_nulo  
			WHERE  ( "FICHA_TRASLADO"."IP" = :ls_tcp_ip ) AND  
					 ( "FICHA_TRASLADO"."BASE_ORIGEN" = :gs_base ) AND  
					 ( "FICHA_TRASLADO"."SERIE_ORIGEN" = :gs_serie ) AND  
					 ( "FICHA_TRASLADO"."NUMERO_ORIGEN" = :gi_numero )   
			USING		sqlca;
			if sqlca.sqlcode=0 then
				commit;
			else
				rollback;
			end if
		else
			SELECT	"FICHA_TRASLADO"."IP"
			INTO 		:ls_tcp_ip
			FROM 		"FICHA_TRASLADO"  
			WHERE  ( "FICHA_TRASLADO"."BASE_DESTINO" = :gs_base ) AND  
					 ( "FICHA_TRASLADO"."SERIE_DESTINO" = :gs_serie ) AND  
					 ( "FICHA_TRASLADO"."NUMERO_DESTINO" = :gi_numero ) AND  
					 ( "FICHA_TRASLADO"."IP" is not null )   
			USING		sqlca;
			if not isnull(ls_tcp_ip) and ls_tcp_ip<>'' then
				UPDATE	"FICHA_TRASLADO"  
				SET 		"BOLETA_NRO_DESTINO" = :ll_nulo,   
							"IP" = :ls_nulo  
				WHERE  ( "FICHA_TRASLADO"."IP" = :ls_tcp_ip ) AND  
						 ( "FICHA_TRASLADO"."BASE_DESTINO" = :gs_base ) AND  
						 ( "FICHA_TRASLADO"."SERIE_DESTINO" = :gs_serie ) AND  
						 ( "FICHA_TRASLADO"."NUMERO_DESTINO" = :gi_numero )   
				USING		sqlca;
				if sqlca.sqlcode=0 then
					commit;
				else
					rollback;
				end if
			end if
		end if
	end if
	gl_valor_iva						= 0
	cb_be_borrar_item.Enabled	= FALSE
	dw_gastos_be.SetItem(1,"gastos_cob", 0)
	dw_gastos_be.SetItem(1,"mora", 0)
	dw_gastos_be.SetItem(1,"subtotal", 0)
	
	dw_gastos_be.SetItem(1,"mora_cred", 0)
	dw_gastos_be.SetItem(1,"mora_mant", 0)
	dw_gastos_be.SetItem(1,"gasto_cred", 0)
	dw_gastos_be.SetItem(1,"gasto_mant", 0)
	il_int_mora			= 0
	il_int_gc				= 0
	il_suma_dia			= 0
	il_int_mora_cred	= 0
	il_int_mora_mant	= 0
	il_int_gc_cred		= 0
	il_int_gc_mant		= 0
END IF
dw_gastos_be.SetItem(1, "Subtotal",dw_detalle_be.GetItemNumber(1,"c_subtotal"))
dw_gastos_be.accepttext()
ll_monto								= dw_gastos_be.getitemnumber(1,'c_total')
if ll_monto > 0 then 
	ls_string							= "tipo_cob_otro = '144' or tipo_cob_otro = '76' "
	ll_fila								= dw_detalle_be.Find(ls_string,  1, ll_tot_reg)
	if ll_fila > 0 then
		ls_tipo_cob	= dw_detalle_be.getitemstring(fila,'tipo_cob')
		dw_detalle_be.DeleteRow(ll_fila)
		wf_calcular_interes(ls_tipo_cob)
		dw_detalle_be.accepttext()
	end if
	cbx_paga_ef_be.checked			= false
end if

//Script nuevo IVA Autor MM 22/12/2022
if gs_tipo_cobro = 'BA' then
	ll_fila_mant				= dw_detalle_be.Find("tipo_cob = 'F'", 1, dw_detalle_be.rowcount())
	if ll_fila_mant > 0 then
		ls_tipo_cob			= 'F'
	else
		ll_fila_cred				= dw_detalle_be.Find("tipo_cob = 'E' or tipo_cob='A' ", 1, dw_detalle_be.rowcount())
		if ll_fila_cred > 0 then
			ls_tipo_cob			= dw_detalle_be.getitemstring(ll_fila_cred,'tipo_cob')
		end if
	end if
	if gs_base='O' or gs_base='C' or gs_base='U' or gs_base='M' then
		SELECT	"OFERTA_V"."CTA_PAG_M"  
		INTO 		:ll_ctas_pag_m  
		FROM 	"OFERTA_V",   "CADENA"  
		WHERE 	( "OFERTA_V"."SERIE" = "CADENA"."SERIE" ) and  
					( "OFERTA_V"."NRO_OFERTA" = "CADENA"."NUMERO" ) and  
					( ( "CADENA"."CODIGO" = :gs_base ) AND  
					( "OFERTA_V"."SERIE" = :gs_serie ) AND  
					( "OFERTA_V"."NRO_OFERTA" = :gi_numero ) )   
		UNION   
		SELECT 	"CONTRATO"."CTA_PAG_M"  
		FROM 	"CADENA",   "CONTRATO"  
		WHERE 	( "CADENA"."SERIE" = "CONTRATO"."SERIE_C" ) and  
					( "CADENA"."NUMERO" = "CONTRATO"."NRO_CONTRATO" ) and  
					( ( "CADENA"."CODIGO" = :gs_base ) AND  
					( "CADENA"."SERIE" = :gs_serie ) AND  
					( "CADENA"."NUMERO" = :gi_numero ) )   ;
		if isnull(ll_ctas_pag_m) then ll_ctas_pag_m=0
	end if
	if ll_fila_mant > 0 or ll_fila_cred > 0 then
		if ls_tipo_cob = 'F' then
			ll_monto_cuota_reg		= round(tab_ingreso.tp_be.dw_detalle_be.getitemnumber(ll_fila_mant,'c_total_linea'),0)
			ii_cantidad 					= tab_ingreso.tp_be.dw_detalle_be.getitemnumber(ll_fila_mant, "cantidad")
			ls_mov_mora				= 'P'
			ls_mov_gasto				= 'R'
		elseif ls_tipo_cob = 'E' or ls_tipo_cob = 'A' then
			ll_monto_cuota_reg		= round(tab_ingreso.tp_be.dw_detalle_be.getitemnumber(ll_fila_cred,'c_total_linea'),0)
			ii_cantidad 					= tab_ingreso.tp_be.dw_detalle_be.getitemnumber(ll_fila_cred, "cantidad")
			ls_mov_mora				= 'G'
			ls_mov_gasto				= 'J'
		end if
		if isnull(ii_cantidad) or ii_cantidad = 0 then ii_cantidad=1
		ll_cuota_ini					= ll_ctas_pag_m + 1
		ll_cuota_fin					= (ll_cuota_ini + ii_cantidad) - 1
		SELECT SUM( "VISTA_MANTEN_IVA"."IVA"  )
		INTO    :ldb_iva
		FROM    "VISTA_MANTEN_IVA"  
		WHERE ( "VISTA_MANTEN_IVA"."BASE" = :gs_base ) AND  
				  ( "VISTA_MANTEN_IVA"."SERIE" = :gs_serie ) AND  
				  ( "VISTA_MANTEN_IVA"."NUMERO" = :gi_numero ) AND
				  ( "VISTA_MANTEN_IVA"."TIPO_MOV" = :ls_tipo_cob ) AND
				  ( "VISTA_MANTEN_IVA"."NRO_CUOTA" >= :ll_cuota_ini ) AND
				  ( "VISTA_MANTEN_IVA"."NRO_CUOTA" <= :ll_cuota_fin ) ;
		if ldb_iva > 0 and ll_monto_cuota_reg > 0 then
				gs_tipo_cobro_aux		= 'BE'
				ll_calcular_iva			= round(ll_monto_cuota_reg * (idb_iva - 1),0)
				
				ll_iva_f 					= ldb_iva	
				if ll_calcular_iva <> ll_iva_f then ll_iva_f=ll_calcular_iva
				ll_new_iva				= dw_detalle_be.Find("tipo_cob = 'D'", 1, dw_detalle_be.rowcount())
				if ll_new_iva > 0 then
					if ldb_iva > 0 then
						dw_detalle_be.scrolltorow(ll_new_iva)
					else
						dw_detalle_be.deleterow(ll_new_iva)
					end if
				else
					ll_new_iva			= dw_detalle_be.insertrow(0)
				end if
				dw_detalle_be.setitem(ll_new_iva,'tipo_cob', 'D')
				if rb_be_afecta.checked=true then
					dw_detalle_be.SetItem(ll_new_iva, "iva", idb_iva)
				end if
				dw_detalle_be.setitem(ll_new_iva,'cantidad', 1)
				ls_moneda_insert	= '1'
				if ls_moneda_insert = '1' then
					dw_detalle_be.setitem(ll_new_iva,'monto_uf', round( ll_iva_f / gd_uf,4))
					dw_detalle_be.setitem(ll_new_iva,'monto', ll_iva_f)
				end if
				dw_detalle_be.setitem(ll_new_iva,'uf',gd_uf)
				dw_detalle_be.setitem(ll_new_iva,'estado','S')
				dw_detalle_be.SetItem(ll_new_iva, "moneda",'P')
		  else
				ll_iva_f 				= 0
				gl_iva_exento_f		= ll_monto_cuota_reg
				ll_new_iva			= dw_detalle_be.Find("tipo_cob = 'D'", 1, dw_detalle_be.rowcount())
				if ll_new_iva > 0 then
					dw_detalle_be.deleterow(ll_new_iva)
				end if
		  end if
		  ll_mora_mant			= round(dw_gastos_be.getitemnumber(1,'mora_mant'),0)
		  if ll_mora_mant > 0 then
			  SELECT  SUM("VISTA_MANTEN_IVA"."IVA")  
			  INTO    	:ldb_iva
			  FROM    "VISTA_MANTEN_IVA"  
			  WHERE   ( "VISTA_MANTEN_IVA"."BASE" = :gs_base ) AND  
						  ( "VISTA_MANTEN_IVA"."SERIE" = :gs_serie ) AND  
						  ( "VISTA_MANTEN_IVA"."NUMERO" = :gi_numero ) AND
						  ( "VISTA_MANTEN_IVA"."TIPO_MOV" = :ls_mov_mora ) AND
						  ( "VISTA_MANTEN_IVA"."NRO_CUOTA" >= :ll_cuota_ini ) AND
						  ( "VISTA_MANTEN_IVA"."NRO_CUOTA" <= :ll_cuota_fin );
			  if ldb_iva > 0 and ll_mora_mant > 0 then
					gs_tipo_cobro_aux		= 'BE'
					ll_iva_p 					= round(ll_mora_mant * (idb_iva - 1),0)
					ll_new_iva				= dw_detalle_be.Find("tipo_cob = 'V'", 1, dw_detalle_be.rowcount())
					if ll_new_iva > 0 then
						dw_detalle_be.scrolltorow(ll_new_iva)
					else
						ll_new_iva			= dw_detalle_be.insertrow(0)
					end if
					dw_detalle_be.setitem(ll_new_iva,'tipo_cob', 'V')
					if rb_be_afecta.checked=true then
						dw_detalle_be.SetItem(ll_new_iva, "iva", idb_iva)
					end if
					dw_detalle_be.setitem(ll_new_iva,'cantidad', 1)
					ls_moneda_insert	= '1'
					if ls_moneda_insert = '1' then
						dw_detalle_be.setitem(ll_new_iva,'monto_uf', round( ll_iva_p / gd_uf,4))
						dw_detalle_be.setitem(ll_new_iva,'monto', ll_iva_p)
					end if
					dw_detalle_be.setitem(ll_new_iva,'uf',gd_uf)
					dw_detalle_be.setitem(ll_new_iva,'estado','S')
					dw_detalle_be.SetItem(ll_new_iva, "moneda",'P')
			  else
					ll_iva_p 			= 0
			  end if
		  end if
		  ll_gasto_mant				= round(dw_gastos_be.getitemnumber(1,'gasto_mant'),0)
		  if ll_gasto_mant > 0 then
			  SELECT  SUM("VISTA_MANTEN_IVA"."IVA" ) 
			  INTO    	:ldb_iva
			  FROM    "VISTA_MANTEN_IVA"  
			  WHERE ( "VISTA_MANTEN_IVA"."BASE" = :gs_base ) AND  
					  ( "VISTA_MANTEN_IVA"."SERIE" = :gs_serie ) AND  
					  ( "VISTA_MANTEN_IVA"."NUMERO" = :gi_numero ) AND
					  ( "VISTA_MANTEN_IVA"."TIPO_MOV" = :ls_mov_gasto ) AND
					  ( "VISTA_MANTEN_IVA"."NRO_CUOTA" >= :ll_cuota_ini ) AND
					  ( "VISTA_MANTEN_IVA"."NRO_CUOTA" <= :ll_cuota_fin );
			  if ldb_iva > 0 and ll_gasto_mant > 0 then
					gs_tipo_cobro_aux		= 'BE'
					ll_iva_r 					= round(ll_gasto_mant * (idb_iva - 1),0)
					ll_new_iva				= dw_detalle_be.Find("tipo_cob = 'X'", 1, dw_detalle_be.rowcount())
					if ll_new_iva > 0 then
						dw_detalle_be.scrolltorow(ll_new_iva)
					else
						ll_new_iva			= dw_detalle_be.insertrow(0)
					end if
					dw_detalle_be.setitem(ll_new_iva,'tipo_cob', 'X')
					if rb_be_afecta.checked=true then
						dw_detalle_be.SetItem(ll_new_iva, "iva", idb_iva)
					end if
					dw_detalle_be.setitem(ll_new_iva,'cantidad', 1)
					ls_moneda_insert	= '1'
					if ls_moneda_insert = '1' then
						dw_detalle_be.setitem(ll_new_iva,'monto_uf', round( ll_iva_r / gd_uf,4))
						dw_detalle_be.setitem(ll_new_iva,'monto', ll_iva_r)
					end if
					dw_detalle_be.setitem(ll_new_iva,'uf',gd_uf)
					dw_detalle_be.setitem(ll_new_iva,'estado','S')
					dw_detalle_be.SetItem(ll_new_iva, "moneda",'P')
			  else
					ll_iva_r 			= 0
			  end if
		end if
	//	  Fin script nuevo IVA Autor MM 22/12/2022
		dw_detalle_be.accepttext()
		dw_gastos_be.SetItem(1, "Subtotal",round(dw_detalle_be.GetItemNumber(1,"c_subtotal"),0))
		dw_detalle_be.accepttext()
	end if
end if

// vhfb -- inicio -- borramos los descuentos ingresados en caso que se elimine la fila de cuota
wf_borra_descuentos_de(ls_tipo_cob)
// vhfb -- false -- borramos los descuentos ingresados en caso que se elimine la fila de cuota



