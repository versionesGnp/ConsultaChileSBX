end if
end event

type dw_ci_buscar_cliente from datawindow within tp_ci
event ue_mousemove pbm_mousemove
integer x = 14
integer y = 72
integer width = 2560
integer height = 196
integer taborder = 20
string title = "none"
string dataobject = "de_buscar_cliente"
boolean border = false
boolean livescroll = true
end type

event ue_mousemove;String		ls_numero,ls_ap_pat

wf_no_mostrar_help()
if is_opcion='FP' and (gs_depto='T' or gs_depto='I') then st_fuera_plazo.visible = true
il_rut 			= long(dw_ci_buscar_cliente.GetItemString(1,"rl_rut"))
is_dv			= dw_ci_buscar_cliente.GetItemString(1,"dv")
ls_numero	= dw_ci_buscar_cliente.getitemstring(1,'rn_contrato')
ls_ap_pat	= dw_ci_buscar_cliente.getitemstring(1,'rs_a_paterno') 
if isnull(ls_numero) and isnull(ls_ap_pat) and (is_dv='' or isnull(is_dv)) and il_rut > 0 then
	dw_ci_buscar_cliente.setfocus()
	dw_ci_buscar_cliente.setcolumn('dv')
elseif ls_numero='' and ls_ap_pat='' and is_dv='' and il_rut > 0 then
	dw_ci_buscar_cliente.setfocus()
	dw_ci_buscar_cliente.setcolumn('dv')
end if

end event

event itemchanged;string 	is_base, is_serie,ls_fono_p,ls_fono_part,ls_celular,ls_fono_c,ls_fono_pc,ls_fono_cc,ls_string,ls_dv_auto,ls_apellido_paterno,ls_dv,ls_estado,ls_nombre_sol,ls_llave,ls_estado_cadena_2,&
			ls_base_h, ls_serie_h
long 		il_nenc, il_ndat, ll_new,li_opcion,ll_rut_aux,ll_ctas,ll_ctas_pagadas,ll_ctas_pagadas_1,ll_ctas_pagadas_2,ll_estado_carta,ll_count,ll_count_mant,ll_new_reg,&
			ll_cod_parque,ll_correlativo,ll_plazo,ll_mora_original,ll_ctas_pag_m_2,ll_count_fa,ll_res_fa,ll_sw_activa_serv,ll_count_nc,ll_res,ll_count_toku,ll_res_toku,ll_new_mp
Date		ld_fecha_hoy,ldt_fecha_pago
Double	il_numero,ll_numero,ll_rut,ll_monto_pie,ll_cuotas_pie,ldb_valor_cuota,ldb_interes,ldb_gasto,ldb_uf_dia,ll_numero_h
datetime	ldt_fecha_sol,ldt_fecha_prim

gs_aplica_a = ''
gd_descuento = 0

if isvalid(w_cuenta_corriente_aumento_capacidad) then close(w_cuenta_corriente_aumento_capacidad)
if isvalid(w_cuenta_corriente_contrato_isa) then close(w_cuenta_corriente_contrato_isa)
if isvalid(w_cuenta_corriente_derecho) then close(w_cuenta_corriente_derecho)
if isvalid(w_cuenta_corriente_liberador) then close(w_cuenta_corriente_liberador)
if isvalid(w_cuenta_corriente_oferta) then close(w_cuenta_corriente_oferta)
if isvalid(w_cuenta_corriente_pagare) then close(w_cuenta_corriente_pagare)
if isvalid(w_cuenta_corriente_repactar_cta_mant) then close(w_cuenta_corriente_repactar_cta_mant)
if isvalid(w_cuenta_corriente_funeraria) then close(w_cuenta_corriente_funeraria)
if isvalid(w_listado_contratos) then close(w_listado_contratos)
if isvalid(w_consultar_contato) then close(w_consultar_contato)
gs_tipo_cobro						= 'CI'
this.accepttext()
Setnull(gs_base)
Setnull(gs_serie)
Setnull(gi_numero)
Setnull(gi_rut)
Setnull(gs_grabar_pie)
st_aviso_ap.visible					= false
gs_filtro 								= "cadena_codigo = 'M' OR cadena_codigo = 'U' OR cadena_codigo = 'O' OR cadena_codigo = 'L' OR cadena_codigo = 'P' OR cadena_codigo = 'D' OR cadena_codigo = 'A' OR cadena_codigo = 'R' OR cadena_codigo = 'C' or cadena_codigo='F' or cadena_codigo='G' or cadena_codigo='V'"

dw_ci_buscar_cliente.AcceptText()
il_rut 									= long(dw_ci_buscar_cliente.GetItemString(1,"rl_rut"))
is_dv									= dw_ci_buscar_cliente.GetItemString(1,"dv")	//em_dv_rut.text
ls_dv_auto							= dw_ci_buscar_cliente.getitemstring(1,'cf_obtener_dv')
ls_apellido_paterno 				= dw_ci_buscar_cliente.GetItemString(1,"rs_a_paterno")
ll_numero 							= Double(dw_ci_buscar_cliente.GetItemString(1,"rn_contrato"))
ldt_fecha_pago						= date(st_fecha.text)
if (not isnull(is_dv) and not isnull(ls_dv_auto) and is_dv<>'' and ls_dv_auto<>'' and il_rut > 0) or not isnull(ls_apellido_paterno) or ll_numero > 0  then
	IF il_rut = 0 or isnull(il_rut) THEN
		IF dw_ci_buscar_cliente.GetItemString(1,"rn_contrato") = "" or isnull(dw_ci_buscar_cliente.GetItemString(1,"rn_contrato")) THEN
			gi_tipo_busqueda 			= 2
			gs_apellido_paterno 		= dw_ci_buscar_cliente.GetItemString(1,"rs_a_paterno")
		ELSE 
			gi_numero 					= double(dw_ci_buscar_cliente.GetItemString(1,"rn_contrato"))
			gi_tipo_busqueda 			= 0
		END IF
	ELSE 
		gi_rut 							= long(dw_ci_buscar_cliente.GetItemString(1,"rl_rut"))
		gi_tipo_busqueda 				= 1
	END IF
	if is_dv <> ls_dv_auto and not isnull(is_dv) and not isnull(ls_dv_auto) and is_dv<>'' and ls_dv_auto<>'' then
		messagebox("Advertencia","Rut Inválido")
		dw_ci_buscar_cliente.setfocus()
		dw_ci_buscar_cliente.setcolumn('dv')
//		em_dv_rut.setfocus()
	else
		Open(w_buscar_cliente)
		IF gf_permitir_ingreso(gs_base, gs_serie, gi_numero) THEN
			Open(w_advertencia)
			gs_rezago 						= " "
			dw_ci_buscar_cliente.AcceptText()
			cb_ci_borrar.SetFocus()
			cb_ci_borrar.TriggerEvent(Clicked!)
			RETURN 0
		END IF
		IF NOT ISNULL(gs_base) and gs_base <> ""	AND not isnull(gs_serie) AND gs_serie <> "" AND not isnull(gi_numero) AND gi_numero > 0 THEN
			
			il_nenc 							= dw_encabezado_ingreso_cupon.Retrieve(gs_base, gs_serie, gi_numero)
			IF il_nenc > 0 THEN 
				gi_rut 						= dw_encabezado_ingreso_cupon.GetItemNumber(1, "cliente_rut")
			ELSE
				gi_rut 						= 0
			END IF
			if gi_rut>0 then 
				if isvalid(w_aviso_mensajes) then close(w_aviso_mensajes)
				
				
					// vhfb - control de descuento web - inicio				
					date ld_fec_sistema
					integer Net
					long v_porc
					ld_fec_sistema = date(gdt_fec_sistema)
					
					gs_aplica_a = ''
					gd_descuento = 0
					
					gd_descuento = wf_busca_descuento_web()
					if gd_descuento > 0 then
						Net = messagebox('Descuento','Existe un descuento asociado al numero de contrato ingresado : ' + string(gi_numero)+ ' por un : ' +string(ii_desc_web)	+ '  %.'  +  '~r~n'	+ '~r~n'+'  Aplica el Descuento?',Question!,YesNo!)
						IF Net = 1 THEN
								gs_aplica_a = 'T'
						else
							gd_descuento = 0
						END IF	
					end if 
					// vhfb - control de descuento web - termino
				
				
				SELECT	COUNT("MENSAJES"."FECHA_CREACION")  
				INTO 		:ll_count  
				FROM 	"MENSAJES"  
				WHERE  ( "MENSAJES"."RUT" = :gi_rut ) and
						 ( "MENSAJES"."ESTADO_GESTION" = 'A' ) AND
						 ( "MENSAJES"."SW_MENSAJE" = 'R' ) and
						 ( to_date("MENSAJES"."FECHA_FIN") >  :ld_fec_sistema )			//:gdt_fec_sistema
				USING		sqlca;
				if ll_count>0 then
					OpenWithParm(w_aviso_mensajes, "RA")	// vhfb
				else
					SELECT	COUNT("MENSAJES"."FECHA_CREACION")  
					INTO 		:ll_count  
					FROM 	"MENSAJES"  
					WHERE  ( "MENSAJES"."BASE" = :gs_base ) and
							 ( "MENSAJES"."SERIE" = :gs_serie ) and
							 ( "MENSAJES"."NUMERO" = :gi_numero ) and
							 ( "MENSAJES"."ESTADO_GESTION" = 'A' ) AND
							 ( "MENSAJES"."SW_MENSAJE" = 'C' ) and
							 ( "MENSAJES"."FECHA_FIN" > :gdt_fec_sistema )
					USING	sqlca;
					if ll_count>0 then
						OpenWithParm(w_aviso_mensajes, "CA")// vhfb
					end if
				end if
			end if
			If gi_rut = 0 THEN
				gs_rezago 						= " "
				dw_ci_buscar_cliente.AcceptText()
				cb_ci_borrar.SetFocus()
				cb_ci_borrar.TriggerEvent(Clicked!)
				RETURN 0
			END IF
			CHOOSE CASE gs_base
				CASE "O","U","M"
					dw_datos_ci.DataObject 	= 'd_datos_cuenta_ci_oferta'
				CASE "L"
					dw_datos_ci.DataObject 	= 'd_datos_cuenta_ci_liberador'
				CASE "P"
					dw_datos_ci.DataObject 	= 'd_datos_cuenta_ci_pagare'
				CASE "D"
					dw_datos_ci.DataObject 	= 'd_datos_cuenta_ci_derecho'
				CASE "C"
					dw_datos_ci.DataObject 	= 'd_datos_cuenta_bl_cto_isa'
				CASE "A"
					dw_datos_ci.DataObject 	= 'd_datos_cuenta_ci_aumento_capacidad'
				CASE "R"
					dw_datos_ci.DataObject 	= 'dw_repacta_mant_descripcion_traspaso'
				CASE "F","G","V"
					dw_datos_ci.DataObject 	= 'd_datos_cuenta_ci_funeraria'
			END CHOOSE
			dw_datos_ci.SetTransObject(SQLCA)
			DECLARE sp_actualizar_cuponeras_1 PROCEDURE FOR sp_actualizar_cuponeras_1(:gs_base,:gs_serie,:gi_numero);
			EXECUTE sp_actualizar_cuponeras_1;
			
			DECLARE sp_nuevo_cadena_mora_2 PROCEDURE FOR sp_nuevo_cadena_mora(:gs_base,:gs_serie,:gi_numero,'M');
			EXECUTE sp_nuevo_cadena_mora_2;
			if gs_base='M' then
				DECLARE x2 CURSOR FOR  
				SELECT 	"CADENA"."CODIGO",   	"CADENA"."SERIE",   	"CADENA"."NUMERO"  
				FROM 	"CADENA"  
				WHERE 	( "CADENA"."MPBASE" = :gs_base ) AND  
							( "CADENA"."MPSERIE" = :gs_serie ) AND  
							( "CADENA"."MPNUMERO" = :gi_numero )   
				USING	sqlca;
				open x2;
				if sqlca.sqlcode=0 then
					DO WHILE sqlca.sqlcode=0
						fetch x2 into :ls_base_h, :ls_serie_h, :ll_numero_h ;
						if not isnull(ls_base_h) then
							DECLARE sp_actualizar_cuponeras_h1 PROCEDURE FOR sp_actualizar_cuponeras_1(:ls_base_h,:ls_serie_h,:ll_numero_h);
							EXECUTE sp_actualizar_cuponeras_h1;
							
							DECLARE sp_nuevo_cadena_mora_h2 PROCEDURE FOR sp_nuevo_cadena_mora(:ls_base_h,:ls_serie_h,:ll_numero_h,'M');
							EXECUTE sp_nuevo_cadena_mora_h2;
						end if
						Setnull(ls_base_h)
					LOOP
				end if
				close x2;
			end if
			il_ndat 								= dw_datos_ci.Retrieve(gs_serie,gi_numero, gs_base)
			if il_ndat > 0 then
				
				datetime		ld_fecha_uf,ld_fecha_hoy_uf
				Double		id_uf
				if gs_base='M' then
					gl_sw_mp			= 0
					gl_codigo_mp		= dw_datos_ci.getitemnumber(1,'cadena_codigomp')
				end if		
				if gs_depto = 'T' or gs_depto='I' then
					ld_fecha_uf				= datetime(date(em_fec_uf.text),time('00:00:00'))
					if date(ld_fecha_uf) > date(gdt_fec_sistema) then
						messagebox("Advertencia","No es posible Ingresar Fecha Superior a hoy "+string(gdt_fec_sistema,'dd/mm/yyyy'))
						em_fec_uf.text		= string(gdt_fec_sistema,'dd/mm/yyyy')
					else
				//		gdt_fec_sistema	= datetime(date(this.text),time(string(gdt_fec_sistema,'hh:mm:ss')))
						SELECT 	"TAB_UF"."VALOR_UF"  
						INTO 		:id_uf  
						FROM 	"TAB_UF"  
						WHERE 	"TAB_UF"."FECHA_UF" = :ld_fecha_uf;
						IF id_uf > 0  THEN 
							gd_uf_dia				= id_uf
							gd_uf 					= id_uf	
							st_uf.text 				= String(id_uf, "###,###,##0.0###")
							if tab_ingreso.tp_be.dw_datos_be.rowcount() > 0 then 
								tab_ingreso.tp_be.dw_datos_be.setitem(1,'fecha_uf',gd_uf)
								tab_ingreso.tp_be.dw_datos_be.accepttext()
							elseif tab_ingreso.tp_ci.dw_datos_ci.rowcount() > 0 then 
								tab_ingreso.tp_ci.dw_datos_ci.setitem(1,'fecha_uf',gd_uf)
								tab_ingreso.tp_ci.dw_datos_ci.accepttext()
							end if
						else
							ld_fecha_hoy_uf		= datetime(date(gdt_fec_sistema),time('00:00:00'))
							SELECT 	"TAB_UF"."VALOR_UF"  
							INTO 		:id_uf  
							FROM 	"TAB_UF"  
							WHERE 	"TAB_UF"."FECHA_UF" = :ld_fecha_hoy_uf;
							IF id_uf > 0  THEN 
								gd_uf_dia				= id_uf
								gd_uf 					= id_uf	
								st_uf.text 				= String(id_uf, "###,###,##0.0###")
								if tab_ingreso.tp_be.dw_datos_be.rowcount() > 0 then 
									tab_ingreso.tp_be.dw_datos_be.setitem(1,'fecha_uf',gd_uf)
									tab_ingreso.tp_be.dw_datos_be.accepttext()
								elseif tab_ingreso.tp_ci.dw_datos_ci.rowcount() > 0 then 
									tab_ingreso.tp_ci.dw_datos_ci.setitem(1,'fecha_uf',gd_uf)
									tab_ingreso.tp_ci.dw_datos_ci.accepttext()
								end if
							end if
						end if
					end if
				end if
				f_validar_pie_pactado_actualizar('CI',dw_datos_ci.dataobject,gs_base,gs_serie,gi_numero)
//				SELECT 	  COUNT("INGRESO"."TIPO_COB") 
//				INTO 		  :ll_count_nc  
//				FROM 	  "INGRESO",  	"NOTA_DE_CREDITO"  
//				WHERE 	( "INGRESO"."FOLIO" = "NOTA_DE_CREDITO"."FOLIO" ) and  
//							( "INGRESO"."TIPO_COB" = "NOTA_DE_CREDITO"."TIPO_COB" ) and  
//							( "INGRESO"."FECHA_PAGO" = "NOTA_DE_CREDITO"."FECHA_PAGO" ) and  
//							( "INGRESO"."RUT" = :gi_rut ) AND  
//							( "INGRESO"."FECHA_PAGO" >= to_date(:gdt_fec_sistema) - 90 ) AND  
//							( "INGRESO"."FECHA_PAGO" <= to_date(:gdt_fec_sistema) ) AND  
//							( "NOTA_DE_CREDITO"."TIPO_COB_ORIGINAL" = 'NC' )   
//				USING	sqlca;
//				if ll_count_nc > 0 then
//					ll_res								= messagebox("Advertencia","Cliente Tiene Nota de Crédito Asociada, recuerde habilitar chek por Re-Ingreso 'Desea Activarlo' ",exclamation!,YesNo!,2)
//					if ll_res=1 then
//						cbx_reingresoci.checked	= true
//						cbx_reingresoci.triggerevent(clicked!)
//					else
//						cbx_reingresoci.checked	= false  
//						gs_reingreso_ci			= 'N'
//					end if
//				end if
				dw_datos_ci.setitem(1,'fecha_pago',ldt_fecha_pago)
				if gs_base='O' or gs_base='C' or gs_base='U' or gs_base='M' then
					ll_ctas_pag_m_2			= dw_datos_ci.getitemnumber(1,'c_cuotas_mora_m')
					SELECT 	"SOL_ESTATUS"."CORRELATIVO",		"SOL_COMPROMISO_PAGO"."RUT_TITULAR",	"SOL_COMPROMISO_PAGO"."DV",		"SOL_COMPROMISO_PAGO"."FECHA_SOLICITUD",		"SOL_ESTATUS"."ESTADO_REG",	"SOL_COMPROMISO_PAGO"."NOMBRE_CLIENTE",	"SOL_COMPROMISO_PAGO"."FECHA_PRIM_MANT",	"SOL_COMPROMISO_PAGO"."MONTO_PIE_MANT",	"SOL_COMPROMISO_PAGO"."CUOTAS_PIE_MANT",	"SOL_COMPROMISO_PAGO"."PLAZO_MANT",	"SOL_COMPROMISO_PAGO"."MONTO_CUOTA_MANT",	"SOL_COMPROMISO_PAGO"."MORA_PAGAR_MANT",		"SOL_COMPROMISO_PAGO"."GASTO_PAGAR_MANT",	"SOL_COMPROMISO_PAGO"."UF_DIA",	"SOL_COMPROMISO_PAGO"."CUOTAS_MORA_ORIGINAL"
					INTO 		:ll_correlativo,								:ll_rut,													:ls_dv,										:ldt_fecha_sol,													:ls_estado,								:ls_nombre_sol,											:ldt_fecha_prim,												:ll_monto_pie,													:ll_cuotas_pie,													:ll_plazo,													:ldb_valor_cuota,													:ldb_interes,														:ldb_gasto,															:ldb_uf_dia,										:ll_mora_original
					FROM 	"SOL_COMPROMISO_PAGO",   	"SOL_ESTATUS"  
					WHERE 	( "SOL_COMPROMISO_PAGO"."BASE" = "SOL_ESTATUS"."BASE" ) and  
								( "SOL_COMPROMISO_PAGO"."SERIE" = "SOL_ESTATUS"."SERIE" ) and  
								( "SOL_COMPROMISO_PAGO"."NUMERO" = "SOL_ESTATUS"."NUMERO" ) and  
								( "SOL_COMPROMISO_PAGO"."CORRELATIVO" = "SOL_ESTATUS"."CORRELATIVO" ) and  
								( ( "SOL_COMPROMISO_PAGO"."BASE" = :gs_base ) AND  
								( "SOL_COMPROMISO_PAGO"."SERIE" = :gs_serie ) AND  
								( "SOL_COMPROMISO_PAGO"."NUMERO" = :gi_numero ) AND  
								( "SOL_ESTATUS"."CODIGO_SOLICITUD" = '27' ) AND  
								( "SOL_ESTATUS"."ESTADO_REG" = 'A' ) AND  
								( "SOL_COMPROMISO_PAGO"."CORRELATIVO" = (	SELECT 	"SOL_ESTATUS"."CORRELATIVO" 
																									FROM 	"SOL_ESTATUS" 
																									WHERE 	( "SOL_ESTATUS"."BASE" = :gs_base ) AND 
																												( "SOL_ESTATUS"."SERIE" = :gs_serie ) AND 
																												( "SOL_ESTATUS"."NUMERO" = :gi_numero ) AND
																												( "SOL_ESTATUS"."CODIGO_SOLICITUD" = '27' ) AND 
																												( "SOL_ESTATUS"."ESTADO_REG" = 'A' ) ) ) )  
					USING	sqlca;
					if sqlca.sqlcode=0 then
						if isnull(ldb_interes) then ldb_interes=0
						if isnull(ldb_gasto) then ldb_gasto=0
						ls_string	= gs_base+'~t'+gs_serie+'~t'+string(gi_numero)+'~t'+string(ll_rut)+'~t'+string(ll_correlativo)+'~t'+ls_dv+'~t'+ls_estado+'~t'+'27'+'~t'+ls_nombre_sol+'~t'+string(ldt_fecha_prim,'dd/mm/yyyy')+'~t'+string(ll_cuotas_pie)+'~t'+string(ll_monto_pie)+'~t'+string(ldb_uf_dia)+'~t'+ string(ldb_valor_cuota)+'~t'+string(ll_mora_original)+'~t'+string(ldb_interes)+'~t'+string(ldb_gasto)+'~t'+string(ll_ctas_pag_m_2)+'~t'+string(ll_plazo)+'~t'+string(ldt_fecha_sol,'dd/mm/yyyy')
						openwithparm(w_detalle_compromiso_pago,ls_string)
					end if	
				end if
				
				dw_datos_ci.accepttext()
				dw_abono.retrieve(gs_base,gs_serie,gi_numero)
				ll_estado_carta					= dw_datos_ci.getitemnumber(1,'cadena_estado_carta')
				if ll_estado_carta=1 or ll_estado_carta=2 or ll_estado_carta=4 or ll_estado_carta=6 or ll_estado_carta=8 then
					st_aviso_ap.visible			= true
				end if
				IF il_nenc > 0 THEN 
					ls_fono_p					= dw_encabezado_ingreso_cupon.GetitemString(1, "cliente_fono_p")
					if len(ls_fono_p) <= 5 then
						st_aviso_ap.visible	= true
					end if
				end if
				sle_numero_ci.text			= ''
				dw_detalle_ci.reset()
				dw_gastos_ci.reset()
				
				ll_cod_parque					= dw_datos_ci.getitemnumber(1,'cadena_cod_parque')
//				if gs_base <> 'O' or (gs_base<>'P' and ll_cod_parque <> 101) then
////					MessageBox("Ingreso de CI", "No es Posible Ingresar Pagos Asociado a Contrato Señalado, debe generar Boleta Electrónica")
//					cb_ci_borrar.TriggerEvent(Clicked!)
//					il_nenc							= 0
//				end if
				ls_estado_cadena_2				= dw_datos_ci.getitemstring(1,'cadena_estado')
				ls_llave							= trim(gs_base+gs_serie+string(gi_numero))
				SELECT	Count("TOKU_SUSCRIPCION_PAC"."ID")
				INTO		:ll_count_toku
				FROM 	"TOKU_SUSCRIPCION_PAC",   "TOKU_CLIENTE"  
				WHERE 	( "TOKU_SUSCRIPCION_PAC"."CLIENTE" = "TOKU_CLIENTE"."ID_TOKU" ) and  
							( "TOKU_SUSCRIPCION_PAC"."ESTADO" = 'chargeable' ) and  
							( "TOKU_CLIENTE"."ID_CLIENTE" = :ls_llave)   ;
				if ll_count_toku > 0 then
					if ls_estado_cadena_2 <> 'S' then
						ll_res_toku				= messagebox("Advertencia","Recuerde Contrato "+gs_base+'-'+gs_serie+'-'+string(gi_numero,'###,###,###,###,###')+ ' tiene Suscripción Convenio PAC (Toku), desea Ingresar Pago',Exclamation!,YesNo!,2)
						if ll_res_toku=1 then
							st_toku.visible		= false
						else
							st_toku.visible		= true
						end if
					else
						st_toku.visible			= false
					end if
				else
					st_toku.visible				= false
				end if

			end if
			if dw_datos_ci.rowcount() > 0 then
				gl_cod_parque						= dw_datos_ci.getitemnumber(1,'cadena_cod_parque')
				if gs_base='F' then
					idw_detalle.retrieve('FA')
				elseif gs_base='G' then
					idw_detalle.retrieve('FE')
				elseif gs_base='V' then
					idw_detalle.retrieve('BA')
				else
					idw_detalle.retrieve('BE')
				end if
				if gs_base='O' or gs_base='U' or gs_base='M' then
					ll_ctas							= dw_datos_ci.getitemnumber(1,'pago_oferta_nro_cuotas')
					ll_ctas_pagadas				= dw_datos_ci.getitemnumber(1,'oferta_v_cta_pag_s')
				elseif gs_base='L' then
					ll_ctas							= dw_datos_ci.getitemnumber(1,'pago_liberador_nro_cuotas')
					ll_ctas_pagadas				= dw_datos_ci.getitemnumber(1,'anexo_liberador_cta_pag_m')
				elseif gs_base='F' or gs_base='G' or gs_base='V' then
					ll_ctas							= dw_datos_ci.getitemnumber(1,'producto_pago_plazo')
					ll_ctas_pagadas				= dw_datos_ci.getitemnumber(1,'producto_anexo_cuotas_pag')
				elseif gs_base='P' then
					ll_ctas							= dw_datos_ci.getitemnumber(1,'pagare_plazo')
					ll_ctas_pagadas_1				= dw_datos_ci.getitemnumber(1,'pagare_cta_pag_la')
					ll_ctas_pagadas_2				= dw_datos_ci.getitemnumber(1,'pagare_cta_pag_isa')
					ll_ctas_pagadas				= ll_ctas_pagadas_1 + ll_ctas_pagadas_2
				elseif gs_base='D' then
					ll_ctas							= dw_datos_ci.getitemnumber(1,'derecho_plazo')
					ll_ctas_pagadas_1				= dw_datos_ci.getitemnumber(1,'derecho_cta_pag_la')
					ll_ctas_pagadas_2				= dw_datos_ci.getitemnumber(1,'derecho_cta_pag_isa')
					ll_ctas_pagadas				= ll_ctas_pagadas_1 + ll_ctas_pagadas_2
				elseif gs_base='A' then
					ll_ctas							= dw_datos_ci.getitemnumber(1,'pago_aumento_nro_cuotas')
					ll_ctas_pagadas				= dw_datos_ci.getitemnumber(1,'anexo_aumento_cta_pag_m')
				end if
			end if
		//	if ll_ctas_pagadas>=ll_ctas and dw_datos_ci.rowcount()>0 and ll_ctas>0 then
		//		messagebox("Advertencia","No es Posible Ingresar C.I., Contrato Nº "+gs_base+'-'+gs_serie+'-'+string(gi_numero,"###,###,###,###,###")+" está CANCELADO")	
		//		cb_ci_insertar.Enabled 			= FALSE
		//		cb_ci_borrar_item.Enabled 		= FALSE
		//		cb_ingresar_pago_ci.Enabled 	= FALSE
		//		sle_numero_ci.Enabled 			= FALSE
		//		dw_datos_ci.setfocus()
		//	else
				IF il_nenc > 0 THEN
					if gs_base='O' or gs_base='U'  or gs_base='M' or (gs_base='P' and ll_cod_parque <> 101) then
						dw_ci_buscar_cliente.SetItem(1,"rs_a_paterno", dw_encabezado_ingreso_cupon.GetItemString(1, "cliente_a_paterno"))
						dw_ci_buscar_cliente.SetItem(1,"rs_a_materno", dw_encabezado_ingreso_cupon.GetItemString(1, "cliente_a_materno"))
						dw_ci_buscar_cliente.SetItem(1,"rs_nombre", dw_encabezado_ingreso_cupon.GetItemString(1, "cliente_nombre"))
						dw_ci_buscar_cliente.SetItem(1,"rn_contrato",String(gi_numero)) 
						dw_ci_buscar_cliente.SetItem(1,"rl_rut",String(dw_encabezado_ingreso_cupon.GetItemNumber(1, "cliente_rut")))
						dw_ci_buscar_cliente.SetItem(1,"rs_bs",(gs_base+gs_serie))
						gs_nombre_completo 				= dw_encabezado_ingreso_cupon.GetItemString(1, "cliente_nombre")+ " " +dw_encabezado_ingreso_cupon.GetItemString(1, "cliente_a_paterno") + " " + dw_encabezado_ingreso_cupon.GetItemString(1, "cliente_a_materno")
						gs_rezago 							= " "
						sle_numero_ci.Enabled 			= True
						cbx_manual_ci.enabled			= true
						cb_asigna_ci.enabled				= true
//						cbx_reingresoci.enabled			= true
						////// ver
						dw_ci_buscar_cliente.enabled	= false
	//					em_dv_rut.enabled				= false
						sle_numero_ci.SetFocus()
					else
						if gs_base='F' or gs_base='G' then //or gs_base='V' then
							SELECT	 COUNT(DISTINCT "PRODUCTO_INGRESO"."FOLIO"  )
							INTO		:ll_count_fa
							FROM 	"PRODUCTO_INGRESO"  
							WHERE ( "PRODUCTO_INGRESO"."BASE" = :gs_base ) AND  
										( "PRODUCTO_INGRESO"."SERIE" = :gs_serie ) AND  
										( "PRODUCTO_INGRESO"."NUMERO" = :gi_numero ) AND  
										( "PRODUCTO_INGRESO"."PAGO_HIST" = 'A' )   ;
							ll_count_fa 						= 0 	//Eliminar Linea	
							if ll_count_fa > 0 then
	//								ll_res_fa						= messagebox("Advertencia","Existe "+string(ll_count_fa)+" Pago(s) por Funeraria, desea continuar el Ingreso de Comprobante",Exclamation!,YesNo!)
								messagebox("Advertencia","Existe "+string(ll_count_fa)+" Pago(s) por Servicio, No es posible continuar el Ingreso de Comprobante")
								ll_res_fa						= 2
							else
								SELECT 		"REVISION_CONTRATOS"."SW_ACTIVA_SERVICIO"  
								INTO 			:ll_sw_activa_serv  
								FROM 		"REVISION_CONTRATOS"  
								WHERE 	 ( "REVISION_CONTRATOS"."BASE" = :gs_base ) AND  
											 ( "REVISION_CONTRATOS"."SERIE" = :gs_serie ) AND  
											 ( "REVISION_CONTRATOS"."NUMERO" = :gi_numero )   ;
								if ll_sw_activa_serv <> 1 then
									messagebox("Advertencia","Recuerde Servicio está Activado")		//, debe Generar Documento Electrónico
									ll_count_fa 						= 0
									ll_sw_activa_serv 				= 1
								end if
							end if
							if (ll_count_fa = 0 or ll_res_fa = 1) and ll_sw_activa_serv = 1 then
								dw_ci_buscar_cliente.SetItem(1,"rs_a_paterno", dw_encabezado_ingreso_cupon.GetItemString(1, "cliente_a_paterno"))
								dw_ci_buscar_cliente.SetItem(1,"rs_a_materno", dw_encabezado_ingreso_cupon.GetItemString(1, "cliente_a_materno"))
								dw_ci_buscar_cliente.SetItem(1,"rs_nombre", dw_encabezado_ingreso_cupon.GetItemString(1, "cliente_nombre"))
								dw_ci_buscar_cliente.SetItem(1,"rn_contrato",String(gi_numero)) 
								dw_ci_buscar_cliente.SetItem(1,"rl_rut",String(dw_encabezado_ingreso_cupon.GetItemNumber(1, "cliente_rut")))
								dw_ci_buscar_cliente.SetItem(1,"dv",gf_obtener_dv( Long(dw_encabezado_ingreso_cupon.GetItemNumber(1, "cliente_rut")) ))
								dw_ci_buscar_cliente.SetItem(1,"rs_bs",(gs_base+gs_serie))
								gs_nombre_completo 			= dw_encabezado_ingreso_cupon.GetItemString(1, "cliente_nombre")+ " " +dw_encabezado_ingreso_cupon.GetItemString(1, "cliente_a_paterno") + " " + dw_encabezado_ingreso_cupon.GetItemString(1, "cliente_a_materno")
								gs_rezago 							= " "
								sle_numero_ci.Enabled 			= True
								cbx_manual_ci.enabled			= true
								cb_asigna_ci.enabled				= true
//								cbx_reingresoci.enabled			= true
								dw_ci_buscar_cliente.enabled	= false
								sle_numero_ci.SetFocus()
							elseif ll_sw_activa_serv = 1 then
								dw_ci_buscar_cliente.SetItem(1,"rs_a_paterno", dw_encabezado_ingreso_cupon.GetItemString(1, "cliente_a_paterno"))
								dw_ci_buscar_cliente.SetItem(1,"rs_a_materno", dw_encabezado_ingreso_cupon.GetItemString(1, "cliente_a_materno"))
								dw_ci_buscar_cliente.SetItem(1,"rs_nombre", dw_encabezado_ingreso_cupon.GetItemString(1, "cliente_nombre"))
								dw_ci_buscar_cliente.SetItem(1,"rn_contrato",String(gi_numero)) 
								dw_ci_buscar_cliente.SetItem(1,"rl_rut",String(dw_encabezado_ingreso_cupon.GetItemNumber(1, "cliente_rut")))
								dw_ci_buscar_cliente.SetItem(1,"dv",gf_obtener_dv( Long(dw_encabezado_ingreso_cupon.GetItemNumber(1, "cliente_rut")) ))
								dw_ci_buscar_cliente.SetItem(1,"rs_bs",(gs_base+gs_serie))
								gs_nombre_completo 			= dw_encabezado_ingreso_cupon.GetItemString(1, "cliente_nombre")+ " " +dw_encabezado_ingreso_cupon.GetItemString(1, "cliente_a_paterno") + " " + dw_encabezado_ingreso_cupon.GetItemString(1, "cliente_a_materno")
								gs_rezago 							= " "
								sle_numero_ci.Enabled 			= True
								cbx_manual_ci.enabled			= true
								cb_asigna_ci.enabled				= true
//								cbx_reingresoci.enabled			= true
								dw_ci_buscar_cliente.enabled	= false
								sle_numero_ci.SetFocus()
							else
								cb_ci_borrar.TriggerEvent(Clicked!)
							end if
						else
							MessageBox("Ingreso de CI", "No es Posible Ingresar CI a Contrato Nº "+gs_base+'-'+gs_serie+'-'+string(gi_numero,"###,###,###,###,###")+", debe Generar Documento Electrónico")
							cb_ci_borrar.TriggerEvent(Clicked!)
						end if
//						MessageBox("Ingreso de CI", "No es Posible Ingresar CI a Contrato Nº "+gs_base+'-'+gs_serie+'-'+string(gi_numero,"###,###,###,###,###")+", debe generar Boleta Electrónica")
//						cb_ci_borrar.TriggerEvent(Clicked!)
					end if
				ELSE
					MessageBox("Ingreso de CI", "No se encontró información asociada a ese número de documento.")
					cb_ci_borrar.TriggerEvent(Clicked!)
				END IF	
				ld_fecha_hoy	= date(gdt_fec_sistema)
				ls_string			= string(gi_rut)+'~t'+gs_base+'~t'+gs_serie+'~t'+string(gi_numero)+'~t'+string(ld_fecha_hoy,'dd/mm/yyyy')
		//		openwithparm(w_modificar_telefonos_cliente,ls_string)
		//	end if
		ELSE
			IF Long(dw_ci_buscar_cliente.GetItemString(1,"rl_rut")) > 0 THEN 
				//No se encuentra el cliente, preguntar si desea ingresar rezago
				li_opcion 								= MessageBox("Ingreso de CI", "No se encontró el Cliente, Contrato no ha sido ingresado o Estado No corresponde, desea ingresar Comprobante de Ingreso en Rezago ?", Exclamation!, YesNo!, 2)
				IF li_opcion = 1 THEN
					dw_parque_boleta.visible				= true
					dw_mp_rezago.visible					= true
					tab_ingreso.tp_ci.gb_1.visible			= true
					tab_ingreso.tp_ci.rb_ci_uf.visible		= true
					tab_ingreso.tp_ci.rb_ci_peso.visible	= true
					tab_ingreso.tp_ci.rb_ci_uf.checked	= true
					gs_rezago 									= "S"
//					gs_base 										= "O"
					gs_serie 										= "I"
					dw_datos_ci.reset()
					dw_detalle_ci.reset()
					dw_gastos_ci.reset()
					sle_numero_ci.text						= ''
					gi_numero 									= 0
					gi_rut 										= long(dw_ci_buscar_cliente.GetItemString(1,"rl_rut"))
					ls_dv											= dw_ci_buscar_cliente.GetItemString(1,"dv")
					dw_ci_buscar_cliente.reset()
					ll_new										= dw_ci_buscar_cliente.insertrow(0)
					dw_ci_buscar_cliente.scrolltorow(ll_new)
					dw_ci_buscar_cliente.setitem(ll_new,'rl_rut',string(gi_rut))
					dw_ci_buscar_cliente.setitem(ll_new,'dv',ls_dv)
					dw_ci_buscar_cliente.accepttext()
					dw_ci_buscar_cliente.enabled			= false
//					em_dv_rut.enabled						= false
					cbx_manual_ci.enabled					= true
					cb_asigna_ci.enabled						= true
					sle_numero_ci.Enabled 					= True
//					cbx_reingresoci.enabled					= true
		//			sle_numero_ci.SetFocus()
					dw_parque_boleta.reset()
					dw_parque_boleta.insertrow(0)
					
					dw_mp_rezago.reset()
					ll_new_mp									= dw_mp_rezago.insertrow(0)
					dw_mp_rezago.setitem(ll_new_mp,'sw_multiproducto',1)
					dw_mp_rezago.accepttext()
					dw_parque_boleta.setfocus()
				ELSE
					dw_parque_boleta.visible				= false
					tab_ingreso.tp_ci.gb_1.visible			= false
					tab_ingreso.tp_ci.rb_ci_uf.visible		= false
					tab_ingreso.tp_ci.rb_ci_peso.visible	= false
//					em_dv_rut.text								= ''
					gs_rezago 									= " "
					dw_ci_buscar_cliente.AcceptText()
					cb_ci_borrar.SetFocus()
					cb_ci_borrar.TriggerEvent(Clicked!)
				END IF
			ELSE
				//MessageBox("Ingreso de CI", "No se encontró información asociada a ese número de documento.")
				cb_ci_borrar.TriggerEvent(Clicked!)
			END IF
		END IF
	end if
else
//	em_dv_rut.setfocus()
	dw_ci_buscar_cliente.setfocus()
	dw_ci_buscar_cliente.setcolumn('dv')
end if


// vhfb - inicio - control para aplciar descuento
IF dw_datos_ci.ROWCOUNT()>0 THEN
	if 	gd_descuento > 0 then
		 wf_gatilla_descuentos()
	end if 
END IF 
// vhfb - termino - control para aplciar descuento





	
end event

event itemfocuschanged;String		ls_dv_auto,ls_columna,ls_numero,ls_ap_pat,ls_nulo

Setnull(ls_nulo)
dw_ci_buscar_cliente.accepttext()
ls_columna		= dwo.name
il_rut 				= long(dw_ci_buscar_cliente.GetItemString(1,"rl_rut"))
is_dv				= dw_ci_buscar_cliente.GetItemString(1,"dv")
ls_dv_auto		= dw_ci_buscar_cliente.getitemstring(1,'cf_obtener_dv')
if not isnull(is_dv) and not isnull(ls_dv_auto) and is_dv<>'' and ls_dv_auto<>'' and il_rut > 0 then
	if is_dv <> ls_dv_auto then
		dw_ci_buscar_cliente.setitem(1,'dv',ls_nulo)
		dw_ci_buscar_cliente.accepttext()
		dw_ci_buscar_cliente.setfocus()
		dw_ci_buscar_cliente.setcolumn('dv')
	end if
end if
if ls_columna='rn_contrato' or ls_columna='rs_a_paterno' then
	ls_numero	= dw_ci_buscar_cliente.getitemstring(1,'rn_contrato')
	ls_ap_pat	= dw_ci_buscar_cliente.getitemstring(1,'rs_a_paterno') 
	if isnull(ls_numero) and isnull(ls_ap_pat) and (is_dv='' or isnull(is_dv)) and il_rut > 0 then
		dw_ci_buscar_cliente.setfocus()
		dw_ci_buscar_cliente.setcolumn('dv')
	elseif ls_numero='' and ls_ap_pat='' and is_dv='' and il_rut > 0 then
		dw_ci_buscar_cliente.setfocus()
		dw_ci_buscar_cliente.setcolumn('dv')
	end if
end if
end event

