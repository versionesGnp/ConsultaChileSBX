boolean hscrollbar = true
boolean vscrollbar = true
borderstyle borderstyle = stylelowered!
end type

event ue_mousemove;Long		ll_tot_reg,ll_monto,ll_fila
String		ls_string

wf_no_mostrar_help()
if is_opcion='FP' and (gs_depto='T' or gs_depto='I') then st_fuera_plazo.visible = true

end event

event itemchanged;string		is_columna_2,ls_tipo_cob_2,ls_moneda,ls_tipo_cob_2_aux,ls_estado_cadena_2,ls_descrip_estado,ls_tipo_comp_2,ls_texto_2,ls_nulo_2,ls_pasa,ls_string,ls_ctto,ls_tipo_doc,&
			ls_moneda_ctto,ls_pasa_valida,ls_estado_ctto,ls_tipo_mov_m,sw_ok_2,ls_base_mpdet,ls_pasa_val,ls_uso,ls_serie,ls_pasa_mult,ls_tipo_cob_dscto,ls_eliminar_s
long 		il_monto,fila_2,ii_dmora, ii_mora_cobro,ii_inc_gastos_2, ii_cantidad_2, i,ll_fila_2,ll_factor_peso,ll_count_e_2,ll_fila_2_reg,ll_monto,ll_ctas=0,ll_count_reg_2,ll_folio_2,ll_ctas_pagadas_1=0,ll_ctas_pagadas_2=0,ll_ctas_pagadas=0,ll_cod_seguro,&
			ll_tot_reg_2,ll_indi,ll_res,ll_sum_monto_abono,ll_monto_mant,ll_monto_final_mant,ll_count_tipo=0,ll_cant_e,ll_monto_cred,ll_monto_final_cred,ll_res_abono,ll_monto_mora_cred,ll_monto_mora_mant,ll_new_seg,ll_fila_2_gasto,&
			ll_fila_2_cred,ll_fila_2_mant,ll_count_adic,ll_fila_2_pie,ll_row,ll_gasto_cob,ll_mora,ll_incluir_gastos,ll_cod_parque,ll_count_hijo,ll_sw_mp,ll_codigo_mp,ll_new_reg,ll_item,ll_nulo,ll_fila_2_mov_existe,ll_tot_reg_2_mp,ll_indi_mp,ll_count_f,&
			ll_crear,ll_buscar_ea,ll_buscar_fa,ll_buscar_fe,ll_fila_s
double 	id_im, id_gc, id_valor_cuota,ld_monto,ld_pie_pactado,ll_monto_cta,ldb_prima,ldb_uf,ll_monto_pie_ingreso,ldb_valor_pie_reg,ll_monto_pago,ll_mora_cred,ll_mora_mant_2,ldb_acum_pie,ldb_iva_p,ldb_iva_acum,&
			ll_gastos_cred,ll_gastos_mant,ll_suma_total,ldb_porc_pie_mp, ldb_precio_mp,ldb_precio_mpdet, ldb_iva_mpdet, ldb_porc_pie_mp_det,ldb_porcsubtotimp_mpdet,ldb_precio_uni_ctto,ldb_pie_uni_ctto,&
			ll_monto_tot_reg,ll_total_ctto,ll_total_pago_ctto,ll_max_folio_new,ll_folio_2_elect,ll_val_item,ll_val_total,ll_iva_peso,ll_tot_peso
Datetime	ldt_fecha_hoy_2
integer ii_cantidad_2_original, li_cuotas_mora	
//d_arch_mul_cajnomina_presencial
Setnull(ll_nulo)
ls_pasa_mult	= 'S'
ll_val_item		= 0
ll_val_total		= 0  
ii_cantidad_2_original = this.GetItemNumber(row, "cantidad") // vhfb
ls_pasa_val		= 'S'
this.accepttext()
is_columna_2 	= GetColumnName()
ldb_uf				= gd_uf
sw_ok_2			= 'S'
if is_columna_2 = "cantidad" then
	//integer ii_cantidad_2_original		// vhfb
	ii_cantidad_2_original = this.GetItemNumber(row, "cantidad") // vhfb
end if 

this.accepttext()
il_modif ++
if isnull(il_cantidad_malo) then il_cantidad_malo=0
SELECT sysdate INTO :gdt_fec_sistema FROM "TASA" WHERE "TASA"."LOOK" = 1   ;
ls_tipo_comp_2						= gs_tipo_cobro
setnull(ls_nulo_2)
ii_inc_gastos_2 					= 1
is_columna_2 						= GetColumnName()
ll_folio_2								= long(sle_numero_ci.text)
ldt_fecha_hoy_2						= datetime(date(gdt_fec_sistema),time('00:00:00'))
ll_tot_reg_2							= dw_detalle_ci.rowcount()
if ll_tot_reg_2>0 then
	ll_count_reg_2 					= dw_detalle_ci.Find("tipo_cob ='A' or tipo_cob ='Q'",1, ll_tot_reg_2)
	if ll_count_reg_2=0 or isnull(ll_count_reg_2) then
		UPDATE	"DETALLE_PAGO_PIE"  
		SET 		"TIPO_COB" = null,   
					"FOLIO" = null,   
					"CAJA" = null,   
					"USUARIO" = null,   
					"FECHA_PAGO" = null,   
					"MONTO_PIE_PAGADO_PESO" = null,
					"ESTADO" = 'P'  
		WHERE  ( "DETALLE_PAGO_PIE"."BASE" = :gs_base ) AND  
				 ( "DETALLE_PAGO_PIE"."SERIE" = :gs_serie ) AND  
				 ( "DETALLE_PAGO_PIE"."NUMERO" = :gi_numero ) AND  
				 ( "DETALLE_PAGO_PIE"."TIPO_COB" = :gs_tipo_cobro ) AND  
				 ( "DETALLE_PAGO_PIE"."FOLIO" = :ll_folio_2 ) AND  
				 ( "DETALLE_PAGO_PIE"."FECHA_PAGO" = :gd_fecha_pago_plazo )   
		USING		sqlca;
		if sqlca.sqlcode=0 then
			commit;
		else
			rollback;
		end if
	end if
end if
ls_tipo_cob_2												= this.getitemstring(row,'tipo_cob')
SELECT 	Count("CADENA"."CODIGO" )
INTO 		:ll_count_hijo
FROM 	"CADENA"  
WHERE 	( "CADENA"."CODIGO" = :gs_base ) AND  
			( "CADENA"."SERIE" = :gs_serie ) AND  
			( "CADENA"."NUMERO" = :gi_numero ) AND  
			( "CADENA"."MPBASE" = 'M' )   ;
if isnull(ll_count_hijo) then ll_count_hijo=0
if (ls_tipo_cob_2='E' or ls_tipo_cob_2='F' or ls_tipo_cob_2='A' ) and ll_count_hijo > 0 then
	messagebox("Advertencia","No es posible Ingresar Item de Pago a Contrato Asociado Multiproducto, debe Ingresar a Contrato Base M")
	dw_detalle_ci.SetItem(row, "monto", 0)
	dw_detalle_ci.SetItem(row, "cantidad", 0)
	dw_detalle_ci.SetItem(row, "tipo_cob", ls_nulo_2)
	dw_detalle_ci.accepttext()
	dw_detalle_ci.setfocus()
	dw_detalle_ci.setcolumn('tipo_cob')
elseif (ls_tipo_cob_2='F' and ll_count_hijo = 0) and gs_base<>'M' then
	messagebox("Advertencia","No es posible Ingresar Pago F-Cuota Manteción, debe Generar Boleta Afecta")
	dw_detalle_ci.SetItem(row, "monto", 0)
	dw_detalle_ci.SetItem(row, "cantidad", 0)
	dw_detalle_ci.SetItem(row, "tipo_cob", ls_nulo_2)
	dw_detalle_ci.accepttext()
	dw_detalle_ci.setfocus()
	dw_detalle_ci.setcolumn('tipo_cob')
else
	if dw_datos_ci.rowcount()>0 then 
		if gs_rezago = "S" then
			ll_cod_parque									= dw_parque_boleta.getitemnumber(1,'cod_parque')
			ll_sw_mp										= dw_mp_rezago.getitemnumber(1,'sw_multiproducto')
			ll_codigo_mp									= dw_mp_rezago.getitemnumber(1,'codigo_producto_mp')
			tab_ingreso.tp_ci.rb_ci_uf.visible			= true
			tab_ingreso.tp_ci.rb_ci_peso.visible		= true
			if rb_ci_uf.checked=true then 
				dw_detalle_ci.SetItem(dw_detalle_ci.getrow(), 'moneda','U')
			elseif rb_ci_peso.checked=true then 
				dw_detalle_ci.SetItem(dw_detalle_ci.getrow(), 'moneda','P')
			end if
		else
			ll_cod_parque									= dw_datos_ci.getitemnumber(1,'cadena_cod_parque')
			if ls_tipo_cob_2<>'M' then
				tab_ingreso.tp_ci.rb_ci_uf.visible		= false
				tab_ingreso.tp_ci.rb_ci_peso.visible	= false
				tab_ingreso.tp_ci.rb_ci_peso.checked	= true
				if rb_ci_uf.checked=true then 
					dw_detalle_ci.SetItem(dw_detalle_ci.getrow(), 'moneda','U')
				elseif rb_ci_peso.checked=true then 
					dw_detalle_ci.SetItem(dw_detalle_ci.getrow(), 'moneda','P')
				end if
			end if
		end if
		ls_estado_cadena_2 = dw_datos_ci.getitemstring(1,'cadena_estado')
		SELECT	"ESTADO"."NOMBRE_ESTADO"  
		INTO 		:ls_descrip_estado  
		FROM 	"ESTADO"  
		WHERE 	"ESTADO"."COD_ESTADO" = :ls_estado_cadena_2 ;
	end if
	if rb_bol_afecta.checked=true then
		dw_detalle_ci.SetItem(dw_detalle_ci.getrow(), "iva", idb_iva)
	end if
	dw_detalle_ci.accepttext()
	if ls_estado_cadena_2='S' then
		ll_tot_reg_2							= dw_detalle_ci.rowcount()
		if ll_tot_reg_2>1 then
			for ll_indi = 1 to ll_tot_reg_2
				ls_tipo_cob_2_aux			= dw_detalle_ci.getitemstring(ll_indi,'tipo_cob')
				if ls_tipo_cob_2 = ls_tipo_cob_2_aux then 
					ll_count_tipo ++
					if ll_count_tipo = 2 then
						messagebox("Advertencia","No puede Ingresar Tipo Cobro "+ls_tipo_cob_2+" Duplicado")
						dw_detalle_ci.deleterow(ll_indi)
						fila_2 					= dw_detalle_ci.InsertRow(0)
						dw_detalle_ci.scrolltorow(fila_2)
						dw_detalle_ci.SetItem(fila_2, 'uf', gd_uf)
						if rb_bol_afecta.checked=true then
							dw_detalle_ci.SetItem(fila_2, 'iva', idb_iva)
						end if
						dw_detalle_ci.SetItem(fila_2, 'folio', 0)
						dw_detalle_ci.SetItem(fila_2, 'estado', 'N')
						dw_detalle_ci.SetItem(fila_2, 'uf', gd_uf)
						if rb_ci_uf.checked=true then
							dw_detalle_ci.SetItem(fila_2, 'moneda','U')
						else
							dw_detalle_ci.SetItem(fila_2, 'moneda','P')
						end if
						setnull(ls_tipo_cob_2);setnull(is_columna_2)
						dw_detalle_ci.scrolltorow(row)
						dw_detalle_ci.setfocus()
						dw_detalle_ci.setcolumn('tipo_cob')
						exit
					end if
				end if
			next
		end if	
		if is_columna_2 = "tipo_cob" then
			sw_ok_2						= 'S'
			ll_tot_reg_2					= dw_detalle_ci.rowcount()
			ll_fila_2_reg 					= dw_detalle_ci.Find("tipo_cob ='4' or tipo_cob ='6'",1, ll_tot_reg_2)
			if ll_fila_2_reg > 0 then
				ll_count_e_2 				= dw_detalle_ci.Find("tipo_cob ='E' or tipo_cob ='U'",1, ll_tot_reg_2)
				if ll_count_e_2 = 0 then
					w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.SetItem(1,'gasto_cred', 0)
					w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.SetItem(1,'mora_cred', 0)
					w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.accepttext()
					do while sw_ok_2 = 'S'
						ll_fila_2_reg 		= dw_detalle_ci.Find("tipo_cob ='4' or tipo_cob ='6'",1, ll_tot_reg_2)
						if ll_fila_2_reg > 0 then
							dw_detalle_ci.deleterow(ll_fila_2_reg)
							ll_fila_2_reg 		= dw_detalle_ci.Find("tipo_cob ='4' or tipo_cob ='6'",1, ll_tot_reg_2)
							if ll_fila_2_reg = 0 then sw_ok_2 = 'N'
						end if
					loop
				end if
			end if
			if ls_tipo_cob_2='K' then
				IF gs_rezago <> "S" THEN
					if gs_base= 'O' or gs_base='U' or gs_base='M' then
						SetItem(row, 'cantidad', dw_datos_ci.GetItemNumber(1,'pago_oferta_nro_cuotas') - dw_datos_ci.GetItemNumber(1,'oferta_v_cta_pag_s'))
					elseif gs_base= 'L' then
						SetItem(row, 'cantidad', dw_datos_ci.GetItemNumber(1,'pago_liberador_nro_cuotas') - dw_datos_ci.GetItemNumber(1,'anexo_liberador_cta_pag_m'))
					elseif gs_base= 'F' or gs_base='G' or gs_base='V' then
						SetItem(row, 'cantidad', dw_datos_ci.GetItemNumber(1,'producto_pago_plazo') - dw_datos_ci.GetItemNumber(1,'producto_anexo_cuotas_pag'))
					elseif gs_base= 'P' then
						SetItem(row, 'cantidad', dw_datos_ci.GetItemNumber(1,'pagare_plazo') - dw_datos_ci.GetItemNumber(1,'c_cuotas_pagadas'))
					elseif gs_base= 'D' then
						SetItem(row, 'cantidad', dw_datos_ci.GetItemNumber(1,'derecho_plazo') - dw_datos_ci.GetItemNumber(1,'c_cuotas_pagadas'))
					elseif gs_base= 'A' then
						SetItem(row, 'cantidad', dw_datos_ci.GetItemNumber(1,'pago_aumento_nro_cuotas') - dw_datos_ci.GetItemNumber(1,'anexo_aumento_cta_pag_m'))
					end if
					SetItem(row, 'monto', dw_datos_ci.GetItemNumber(1,'c_valor_cuota_pesos'))
					if isnull(w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.getitemnumber(1,'gastos_cob')) then
						w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.SetItem(1,'gastos_cob', 0)
						
						w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.SetItem(1,'gasto_cred', 0)
						w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.SetItem(1,'gasto_mant', 0)
					end if
					if isnull(w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.getitemnumber(1,'mora')) then
						w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.SetItem(1,'mora', 0)
						
						w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.SetItem(1,'mora_cred', 0)
						w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.SetItem(1,'mora_mant', 0)
					end if
					if isnull(w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.getitemnumber(1,'incluir_gastos')) then
						w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.SetItem(1,'incluir_gastos', 1)
					end if
					dw_gastos_ci.SetItem(1, 'Subtotal',GetItemNumber(1,'c_subtotal'))
					dw_gastos_ci.accepttext()
				else
					messagebox("Advertencia","No es Posible Ingresar Seguro de Desgravamen en Rezago")
				end if
				
			elseif ls_tipo_cob_2='S' or ls_tipo_cob_2='L' then
				SetItem(row, "monto", 0)
				SetItem(row, "cantidad", 1)
				ls_texto_2	= ls_tipo_cob_2+'~t'+ls_tipo_comp_2
				
				// VHFB -- INCIO -- CONTROL DE INGRESO AUTOMATICO	
				if gb_aplica = false then
				openwithparm(w_apertura_tipo_cobro_otros,ls_texto_2)
				END IF 
				// VHFB -- TERMINO -- CONTROL DE INGRESO AUTOMATICO	
				if gs_base<>'M' then wf_calcular_interes(ls_tipo_cob_2)
				
			elseif ls_tipo_cob_2='F' then
				ll_fila_2_cred	= dw_detalle_ci.Find("tipo_cob ='A' or tipo_cob ='E' or tipo_cob ='Q' or tipo_cob ='U'",1,dw_detalle_ci.rowcount())
				if ll_fila_2_cred = 0 then
					w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.SetItem(1,'gasto_cred', 0)
					w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.SetItem(1,'mora_cred', 0)
					w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.accepttext()
				end if
				if gs_rezago <> "S" THEN
					if gs_conexion = "Parque Santiago" then
						messagebox("Advertencia","No es posible Ingresar F-Cuota Mantención por Comprobante de Ingreso, en PARQUE SANTIAGO")
						SetItem(row, "monto", 0)
						SetItem(row, "cantidad", 0)
						dw_detalle_ci.setfocus()
						dw_detalle_ci.setcolumn('tipo_cob')
					elseif ls_tipo_cob_2='F' and st_toku.visible=true then
						messagebox("Advertencia","No es posible Ingresar F-Cuota Mantención por estar Suscrito PAC - Toku")
						SetItem(row, "monto", 0)
						SetItem(row, "tipo_cob", ls_nulo_2)
						SetItem(row, "cantidad", 0)
						this.accepttext()
						dw_detalle_ci.setfocus()
						dw_detalle_ci.setcolumn('tipo_cob')
					else
						CHOOSE CASE gs_base
							CASE "O","U","M"
								IF dw_datos_ci.getitemnumber(1,'oferta_v_cta_pag_m') > 90 then
									messagebox ("Advertencia ", "Este Contrato tiene anexo Liberador de Mantención ",information!)
									RETURN
								end if
							CASE "C"
								IF dw_datos_ci.getitemnumber(1,'contrato_cta_pag_m') > 90 then
									messagebox ("Advertencia ", "Este Contrato tiene anexo Liberador de Mantención ",information!)
									RETURN
								end if
						END CHOOSE
						if gs_base='O' or gs_base='C' or gs_base='U' or gs_base='M' then
							if this.getitemnumber(row,'cantidad') <= 1 or isnull(this.getitemnumber(row,'cantidad')) then SetItem(row, "cantidad", 1)
							IF gs_rezago <> "S" THEN
								ll_monto_mant					= round(dw_datos_ci.GetItemNumber(1,"c_valor_cuota_mantencion_pesos"),0)
								ll_monto_cta					= ll_monto_mant * this.getitemnumber(row,'cantidad')
								SELECT	SUM("ABONO_CTA_CTE"."MONTO")  
								INTO 		:ll_sum_monto_abono  
								FROM 	"ABONO_CTA_CTE"  
								WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
										 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
										 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND
										 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )
								USING		sqlca;
								if ll_sum_monto_abono > 0 then
									ll_monto_mant				= ll_monto_mant - this.getitemnumber(row,'cantidad')
									ll_monto_mora_mant		= wf_calcular_mora_mant(row)
									if ll_sum_monto_abono >= (ll_monto_cta + ll_monto_mora_mant)  then
										ll_monto_final_mant	= round(ll_sum_monto_abono - ( ll_monto_cta + ll_monto_mora_mant ) ,0)
										ll_res_abono			= messagebox("Advertencia Abono","En su Cuenta Corriente Existe Abonado $ "+string(ll_sum_monto_abono,'###,###,###,###,##0')+", se descontará por Concepto Mantención $ "+string((ll_monto_cta + ll_monto_mora_mant) - 1,'###,###,###,###,##0')+", quedando a su Favor $ "+string(ll_monto_final_mant,'###,###,###,###,##0')+"... desea utilizar Abono Existente",Exclamation!,YesNo!,2)
										if ll_res_abono=1 then
											SetItem(row, "monto", ll_monto_mant)
											ll_monto_final_mant ++
											UPDATE	"ABONO_CTA_CTE"  
											SET 		"TIPO_COB_OCUPA" = :gs_tipo_cobro,   
														"FOLIO_OCUPA" = :ll_folio_2,   
														"FECHA_OCUPA" = :ldt_fecha_hoy_2,   
														"MONTO_OCUPA" = (:ll_monto_cta + :ll_monto_mora_mant) - 1,   
														"USUARIO_OCUPA" = :gs_user,   
														"CAJA_OCUPA" = :gs_caja,   
														"ESTADO_REG" = 'O',
														"TIPO_MOV_OCUPA" = 'F',
														"SW_ESTADO_TRANS" = 1
											WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
													 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
													 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
													 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
											USING		sqlca;
											if sqlca.sqlcode=0 then
												commit;
												INSERT INTO "ABONO_CTA_CTE"  
															( "RUT",		"BASE",		"SERIE",		"NUMERO",	"TIPO_COB",	"FOLIO",		"MONTO",						"FECHA_CREA",		"USUARIO_CREA",	"CAJA_CREA",	"ESTADO_REG",	"TIPO_COB_OCUPA",	"FOLIO_OCUPA",	"FECHA_OCUPA",	"MONTO_OCUPA",	"USUARIO_OCUPA",	"CAJA_OCUPA",	"TIPO_MOV_OCUPA",	"SW_ESTADO_TRANS" )
												VALUES 	( :gi_rut,	:gs_base,	:gs_serie,	:gi_numero,	:gs_tipo_cobro,			:ll_folio_2,	:ll_monto_final_mant,	:gdt_fec_sistema,	:gs_user,			:gs_caja,		'P',				null,					null,				null,				null,				null,					null,				null,					2 )  
												USING		sqlca;
												if sqlca.sqlcode=0 then
													commit;
												else
													rollback;
													messagebox("Error Grabar","Error al INSERTAR ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
												end if
											else
												rollback;
												messagebox("Error Grabar","Error al UPDATE ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
											end if
										else
											ll_monto_final_mant		= ll_monto_mant
											SetItem(row, "monto", ll_monto_mant)
										end if
									else
										ll_res_abono				= messagebox("Advertencia Abono","En su Cuenta Corriente Existe Abonado $ "+string(ll_sum_monto_abono,'###,###,###,###,##0')+", Monto a Cancelar es $ "+string(ll_monto_cta + ll_monto_mora_mant,'###,###,###,###,##0')+" y su Saldo quedará en 0"+"... desea utilizar por Concepto de Mantención Abono Existente",Exclamation!,YesNo!,2)
										if ll_res_abono = 1 then
											SetItem(row, "monto", ll_monto_mant )
											UPDATE	"ABONO_CTA_CTE"  
											SET 		"TIPO_COB_OCUPA" = :gs_tipo_cobro,   
														"FOLIO_OCUPA" = :ll_folio_2,   
														"FECHA_OCUPA" = :ldt_fecha_hoy_2,   
														"MONTO_OCUPA" = :ll_sum_monto_abono,   
														"USUARIO_OCUPA" = :gs_user,   
														"CAJA_OCUPA" = :gs_caja,   
														"ESTADO_REG" = 'O',
														"TIPO_MOV_OCUPA" = 'F',
														"SW_ESTADO_TRANS" = 1
											WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
													 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
													 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
													 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
											USING		sqlca;
											if sqlca.sqlcode=0 then
												commit;
											else
												rollback;
												messagebox("Error Grabar","Error al Update ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
											end if
										else
											ll_monto_final_mant		= ll_monto_mant
											SetItem(row, "monto", ll_monto_mant)
										end if
									end if
								else
									ll_monto_final_mant		= ll_monto_mant
									SetItem(row, "monto", ll_monto_mant)
								end if
								
								if gs_base<>'M' then wf_calcular_interes(ls_tipo_cob_2)
							ELSE 
								SetItem(row, "monto", 0)
							END IF
						else
							messagebox("Advertencia","No es posible Ingresar F-Cuota Mantención, para este tipo de Contrato (Solo O-Promesas y C-Contrato)")
							SetItem(row, "monto", 0)
							SetItem(row, "cantidad", 0)
							dw_detalle_ci.setfocus()
							dw_detalle_ci.setcolumn('tipo_cob')
						end if
					end if
				END IF
				
			elseif ls_tipo_cob_2='M' then
				if gs_rezago <> "S" THEN
					ls_estado_cadena_2 = dw_datos_ci.getitemstring(1,'cadena_estado')
					if ls_estado_cadena_2='V' or ls_estado_cadena_2='C' or ls_estado_cadena_2='S' then
						if gs_base='O' or gs_base='C' or gs_base='U' or gs_base='M' then
							tab_ingreso.tp_ci.rb_ci_uf.visible		= true
							tab_ingreso.tp_ci.rb_ci_peso.visible	= false
							tab_ingreso.tp_ci.rb_ci_uf.checked	= true
							tab_ingreso.tp_ci.rb_ci_peso.visible	= false
							if rb_ci_uf.checked=true then 
								dw_detalle_ci.SetItem(dw_detalle_ci.getrow(), "moneda",'U')
							elseif rb_ci_peso.checked=true then 
								dw_detalle_ci.SetItem(dw_detalle_ci.getrow(), "moneda",'P')
							end if
							if this.getitemnumber(row,'cantidad') <= 1 or isnull(this.getitemnumber(row,'cantidad')) then SetItem(row, "cantidad", 1)
						else
							messagebox("Advertencia","No es Posible Ingresar M-Derecho Sepultura para este Tipo de Contrato")
							SetItem(row, "monto", 0)
							SetItem(row, "cantidad", 0)
							dw_detalle_ci.setfocus()
							dw_detalle_ci.setcolumn('tipo_cob')
						end if
					else
						tab_ingreso.tp_ci.rb_ci_uf.visible		= false
						tab_ingreso.tp_ci.rb_ci_peso.visible	= false
						tab_ingreso.tp_ci.rb_ci_uf.checked	= false
						tab_ingreso.tp_ci.rb_ci_peso.visible	= true
						messagebox("Advertencia","Recuerde que Contrato debe estar V-Vigente o C-Cancelado")
						SetItem(row, "monto", 0)
						SetItem(row, "cantidad", 0)
						dw_detalle_ci.setfocus()
						dw_detalle_ci.setcolumn('tipo_cob')
					end if
				end if
				
			elseif ls_tipo_cob_2<>'S' and ls_tipo_cob_2<>'K' and ls_tipo_cob_2<>'M' and ls_tipo_cob_2<>'L' and ls_tipo_cob_2<>'F' then
				messagebox("Advertencia","No es Posible Ingresar este Tipo de Cobro")
				dw_detalle_ci.deleterow(row)
				fila_2 					= dw_detalle_ci.InsertRow(0)
				dw_detalle_ci.scrolltorow(fila_2)
				dw_detalle_ci.SetItem(fila_2, "uf", gd_uf)
				if rb_bol_afecta.checked=true then
					dw_detalle_ci.SetItem(fila_2, "iva", idb_iva)
				end if
				dw_detalle_ci.SetItem(fila_2, "folio", 0)
				dw_detalle_ci.SetItem(fila_2, "estado", 'N')
				dw_detalle_ci.SetItem(fila_2, "uf", gd_uf)
				if rb_ci_uf.checked=true then
					dw_detalle_ci.SetItem(fila_2, "moneda",'U')
				else
					dw_detalle_ci.SetItem(fila_2, "moneda",'P')
				end if
				setnull(ls_tipo_cob_2);setnull(is_columna_2)
				dw_detalle_ci.scrolltorow(row)
				dw_detalle_ci.setfocus()
				dw_detalle_ci.setcolumn('tipo_cob')
			END IF
		end if
		this.accepttext()
		dw_gastos_ci.SetItem(1, "Subtotal",GetItemNumber(1,"c_subtotal"))
	//	dw_gastos_ci.SetItem(1, "Subtotal",0)
		dw_detalle_ci.accepttext()
		fila_2 							= row
		IF is_columna_2 = "cantidad" AND (ls_tipo_cob_2 = "E" or ls_tipo_cob_2 = "U") AND GetItemNumber(row, "cantidad") > 0 AND gs_rezago <> "S"  THEN
	//		if ( (ls_tipo_cob_2="E" or ls_tipo_cob_2="U") and (gs_base<>'O' or (gs_base<>'P' and ll_cod_parque <> 101 ))) then
	//		//////Validar
	//			if ls_tipo_cob_2 = "E" then
	//				messagebox("Advertencia","No es posible Ingresar E-Cuota por Comprobante de Ingreso, recuerde solo se consideran Promesas y Pagaré (excluyendo Pagaré Canaán)")
	//			elseif ls_tipo_cob_2 = "U" then 
	//				messagebox("Advertencia","No es posible Ingresar U-Cuota de Reconocimiento por Comprobante de Ingreso, recuerde solo se consideran Promesas y Pagaré (excluyendo Pagaré Canaán)")
	//			end if
	//			SetItem(row, "monto", 0)
	//			SetItem(row, "cantidad", 0)
	//			dw_detalle_ci.setfocus()
	//			dw_detalle_ci.setcolumn('tipo_cob')
	//		end if
			wf_actualizar_abono(ls_tipo_cob_2)
			ii_cantidad_2 			= GetItemNumber(row, "cantidad")
			if (gs_base='O' or gs_base='U' or gs_base='M') and dw_datos_ci.DataObject='d_datos_cuenta_ci_oferta' then
				ll_ctas				= dw_datos_ci.getitemnumber(1,'pago_oferta_nro_cuotas')
				ll_ctas_pagadas	= dw_datos_ci.getitemnumber(1,'oferta_v_cta_pag_s')
			elseif gs_base='P' and dw_datos_ci.DataObject='d_datos_cuenta_ci_pagare' then
				ll_ctas				= dw_datos_ci.getitemnumber(1,'pagare_plazo')
				ll_ctas_pagadas_1	= dw_datos_ci.getitemnumber(1,'pagare_cta_pag_la')
				ll_ctas_pagadas_2	= dw_datos_ci.getitemnumber(1,'pagare_cta_pag_isa')
				ll_ctas_pagadas	= ll_ctas_pagadas_1 + ll_ctas_pagadas_2
			elseif gs_base='L' and dw_datos_ci.DataObject='d_datos_cuenta_ci_liberador' then
				ll_ctas				= dw_datos_ci.getitemnumber(1,'pago_liberador_nro_cuotas')
				ll_ctas_pagadas	= dw_datos_ci.getitemnumber(1,'anexo_liberador_cta_pag_m')
			elseif (gs_base='F' or gs_base='G' or gs_base='V') and dw_datos_ci.DataObject='d_datos_cuenta_ci_funeraria' then
				ll_ctas				= dw_datos_ci.getitemnumber(1,'producto_pago_plazo')
				ll_ctas_pagadas	= dw_datos_ci.getitemnumber(1,'producto_anexo_cuotas_pag')
			elseif gs_base='D' and dw_datos_ci.DataObject='d_datos_cuenta_ci_derecho' then
				ll_ctas				= dw_datos_ci.getitemnumber(1,'derecho_plazo')
				ll_ctas_pagadas_1	= dw_datos_ci.getitemnumber(1,'derecho_cta_pag_la')
				ll_ctas_pagadas_2	= dw_datos_ci.getitemnumber(1,'derecho_cta_pag_isa')
				ll_ctas_pagadas	= ll_ctas_pagadas_1 + ll_ctas_pagadas_2
			elseif gs_base='A' and dw_datos_ci.DataObject='d_datos_cuenta_ci_aumento_capacidad' then
				ll_ctas				= dw_datos_ci.getitemnumber(1,'pago_aumento_nro_cuotas')
				ll_ctas_pagadas	= dw_datos_ci.getitemnumber(1,'anexo_aumento_cta_pag_m')
			end if
			if (ll_ctas_pagadas + ii_cantidad_2) > ll_ctas then
				messagebox("Advertencia","Cantidad de Cuotas sobrepasa al Plazo del Crédito")
	//			SetItem(row, "monto", 0)
				dw_detalle_ci.SetItem(row, "cantidad", 0)
				dw_detalle_ci.SetItem(row,'c_total_linea',0)
				
				dw_gastos_ci.SetItem(1, "Subtotal",0)
				dw_gastos_ci.SetItem(1, "mora",0)
				dw_gastos_ci.SetItem(1, "gastos_cob",0)
				
				dw_gastos_ci.SetItem(1, "gasto_cob",0)
				dw_gastos_ci.SetItem(1, "gasto_cob",0)
				dw_gastos_ci.SetItem(1, "mora_cred",0)
				dw_gastos_ci.SetItem(1, "mora_mant",0)
				
				dw_detalle_ci.accepttext()
				dw_detalle_ci.setfocus()
				dw_detalle_ci.setcolumn('cantidad')
			else
				ll_monto_cred					= round(dw_datos_ci.GetItemNumber(1,"c_valor_cuota_pesos"),0)
				ll_monto_mora_cred			= wf_calcular_mora(row)
				SELECT	SUM("ABONO_CTA_CTE"."MONTO")  
				INTO 		:ll_sum_monto_abono  
				FROM 		"ABONO_CTA_CTE"  
				WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
						 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
						 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero )  AND 
						 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
				USING		sqlca;
				if ll_sum_monto_abono > 0 then
					ll_monto_cta				= ll_monto_cred * this.getitemnumber(row,'cantidad')
					if ll_sum_monto_abono >= (ll_monto_cta + ll_monto_mora_cred) then
						ll_monto_final_cred	= round(ll_sum_monto_abono - (ll_monto_cta + ll_monto_mora_cred),0)
						ll_res_abono			= messagebox("Advertencia Abono","En su Cuenta Corriente Existe Abonado $ "+string(ll_sum_monto_abono,'###,###,###,###,##0')+", se descontará por Concepto Crédito $ "+string((ll_monto_cta + ll_monto_mora_cred) - 1,'###,###,###,###,##0')+", quedando a su Favor $ "+string(ll_monto_final_cred,'###,###,###,###,##0')+"... desea utilizar Abono Existente ",Exclamation!,YesNo!,2)
						if ll_res_abono=1 then
							SetItem(row, "monto", ll_monto_cred)
							ll_monto_final_cred ++
							UPDATE	"ABONO_CTA_CTE"  
							SET 		"TIPO_COB_OCUPA" = :gs_tipo_cobro,   
										"FOLIO_OCUPA" = :ll_folio_2,   
										"FECHA_OCUPA" = :ldt_fecha_hoy_2,   
										"MONTO_OCUPA" = (:ll_monto_cta + :ll_monto_mora_cred) - 1,   
										"USUARIO_OCUPA" = :gs_user,   
										"CAJA_OCUPA" = :gs_caja,   
										"ESTADO_REG" = 'O',
										"TIPO_MOV_OCUPA" = 'E',
										"SW_ESTADO_TRANS" = 1
							WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
									 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
									 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
									 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
							USING		sqlca;
							if sqlca.sqlcode=0 then
								commit;
								INSERT INTO "ABONO_CTA_CTE"  
											( "RUT",		"BASE",		"SERIE",		"NUMERO",	"TIPO_COB",	"FOLIO",		"MONTO",						"FECHA_CREA",		"USUARIO_CREA",	"CAJA_CREA",	"ESTADO_REG",	"TIPO_COB_OCUPA",	"FOLIO_OCUPA",	"FECHA_OCUPA",	"MONTO_OCUPA",	"USUARIO_OCUPA",	"CAJA_OCUPA",	"TIPO_MOV_OCUPA",	"SW_ESTADO_TRANS" )
								VALUES 	( :gi_rut,	:gs_base,	:gs_serie,	:gi_numero,	:gs_tipo_cobro,			:ll_folio_2,	:ll_monto_final_cred,	:gdt_fec_sistema,	:gs_user,			:gs_caja,		'P',				null,					null,				null,				null,				null,					null,				null,					2 )  
								USING		sqlca;
								if sqlca.sqlcode=0 then
									commit;
								else
									rollback;
									messagebox("Error Grabar","Error al INSERTAR ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
								end if
							else
								rollback;
								messagebox("Error Grabar","Error al UPDATE ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
							end if
						else
							ll_monto_final_cred		= ll_monto_cred
							SetItem(row, "monto", ll_monto_cred)
						end if
					else
						ll_res_abono				= messagebox("Advertencia Abono","En su Cuenta Corriente Existe Abonado $ "+string(ll_sum_monto_abono,'###,###,###,###,##0')+", Monto a Cancelar es $ "+string(ll_monto_cta + ll_monto_mora_cred,'###,###,###,###,##0')+" y su Saldo quedará en 0... desea utilizar por Concepto Crédito Abono Existente",Exclamation!,YesNo!,2)
						if ll_res_abono=1 then
							SetItem(row, "monto", ll_monto_cred )
							UPDATE	"ABONO_CTA_CTE"  
							SET 		"TIPO_COB_OCUPA" = :gs_tipo_cobro,   
										"FOLIO_OCUPA" = :ll_folio_2,   
										"FECHA_OCUPA" = :ldt_fecha_hoy_2,   
										"MONTO_OCUPA" = :ll_sum_monto_abono,   
										"USUARIO_OCUPA" = :gs_user,   
										"CAJA_OCUPA" = :gs_caja,   
										"ESTADO_REG" = 'O',
										"TIPO_MOV_OCUPA" = 'E',
										"SW_ESTADO_TRANS" = 1  
							WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
									 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
									 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
									 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
							USING		sqlca;
							if sqlca.sqlcode=0 then
								commit;
							else
								rollback;
								messagebox("Error Grabar","Error al Update ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
							end if
						else
							ll_monto_final_cred		= ll_monto_cred
							SetItem(row, "monto", ll_monto_cred)
						end if
					end if
				else
					ll_monto_final_cred				= ll_monto_cred
					SetItem(row, "monto", ll_monto_cred)
				end if
				
			end if
			if gs_base<>'M' then wf_calcular_interes(ls_tipo_cob_2)
	
		elseIF is_columna_2 = "cantidad" AND ls_tipo_cob_2 = "F" AND GetItemNumber(row, "cantidad") > 0 AND gs_rezago <> "S"  THEN
			wf_actualizar_abono(ls_tipo_cob_2)
			wf_calcular_cant_mant(row)
			SELECT 	Count("CUPONERAS_DETALLE"."TIPO_MOV"  )
			INTO 		:ll_count_f 
			FROM 	"CUPONERAS",   "CUPONERAS_DETALLE"
			WHERE 	( "CUPONERAS"."BASE" = "CUPONERAS_DETALLE"."BASE" ) and  
						( "CUPONERAS"."SERIE" = "CUPONERAS_DETALLE"."SERIE" ) and  
						( "CUPONERAS"."NUMERO" = "CUPONERAS_DETALLE"."NUMERO" ) and  
						( "CUPONERAS"."NRO_CUPONERA" = "CUPONERAS_DETALLE"."NRO_CUPONERA" ) and  
						( ( "CUPONERAS"."BASE" = :gs_base ) AND  
						( "CUPONERAS"."SERIE" = :gs_serie ) AND  
						( "CUPONERAS"."NUMERO" = :gi_numero ) AND  
						( "CUPONERAS_DETALLE"."TIPO_MOV" = 'F' ) AND  
						( "CUPONERAS_DETALLE"."ESTADO_PAGO_CUPON" = 'V' ) AND
						("CUPONERAS"."ESTADO_CUPONERA" = 'V' OR  "CUPONERAS"."ESTADO_CUPONERA" = 'C') )	   ;
			if isnull(ll_count_f) then ll_count_f=0
			
			SELECT 	"CADENA_MORA"."MORA_MANT"  
			INTO 		:ll_mora_mant_2  
			FROM 	"CADENA_MORA"  
			WHERE 	( "CADENA_MORA"."BASE" = :gs_base ) AND  
						( "CADENA_MORA"."SERIE" = :gs_serie ) AND  
						( "CADENA_MORA"."NUMERO" = :gi_numero )   ;
			if isnull(ll_mora_mant_2) then ll_mora_mant_2=0	
			ii_cantidad_2 					= GetItemNumber(this.getrow(), "cantidad")
//				if ll_count_f <= (ll_mora_mant_2 + 1) then
//					ll_crear		= (ll_mora_mant_2 + 1) - ll_count_f
			if ll_count_f <= (ll_mora_mant_2 + ii_cantidad_2) then
				ll_crear		= (ll_mora_mant_2 + ii_cantidad_2) - ll_count_f
				wf_crear_cupones_mantencion(ll_crear)
			end if
		END IF
	
	elseif ls_estado_cadena_2='V' or ls_estado_cadena_2='C' or gs_rezago='S' then
		if ls_tipo_cob_2='F' and st_toku.visible=true then
			messagebox("Advertencia","No es posible Ingresar F-Cuota Mantención por estar Suscrito PAC - Toku")
			dw_detalle_ci.SetItem(row, "monto", 0)
			dw_detalle_ci.SetItem(row, "monto_uf", 0)
			setnull(ls_tipo_cob_2)
			dw_detalle_ci.SetItem(row, "tipo_cob", ls_tipo_cob_2)
			dw_detalle_ci.SetItem(row, "cantidad", 0)
			dw_detalle_ci.accepttext()
			dw_detalle_ci.setfocus()
			dw_detalle_ci.setcolumn('tipo_cob')
		elseif ls_tipo_cob_2='E' and st_toku.visible=true then
			messagebox("Advertencia","No es posible Ingresar E-Cuota Crédito por estar Suscrito PAC - Toku")
			dw_detalle_ci.SetItem(row, "monto", 0)
			dw_detalle_ci.SetItem(row, "monto_uf", 0)
			setnull(ls_tipo_cob_2)
			dw_detalle_ci.SetItem(row, "tipo_cob", ls_tipo_cob_2)
			dw_detalle_ci.SetItem(row, "cantidad", 0)
			dw_detalle_ci.accepttext()
			dw_detalle_ci.setfocus()
			dw_detalle_ci.setcolumn('tipo_cob')
		end if
		sw_ok_2						= 'S'
		ll_tot_reg_2					= dw_detalle_ci.rowcount()
		ll_fila_2_reg 					= dw_detalle_ci.Find("tipo_cob ='4' or tipo_cob ='6'",1, ll_tot_reg_2)
		if ll_fila_2_reg > 0 then
			ll_count_e_2 				= dw_detalle_ci.Find("tipo_cob ='E' or tipo_cob ='U'",1, ll_tot_reg_2)
			if ll_count_e_2 = 0 then
				w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.SetItem(1,'gasto_cred', 0)
				w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.SetItem(1,'mora_cred', 0)
				w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.accepttext()
				do while sw_ok_2 = 'S'
					ll_fila_2_reg 		= dw_detalle_ci.Find("tipo_cob ='4' or tipo_cob ='6'",1, ll_tot_reg_2)
					if ll_fila_2_reg > 0 then
						dw_detalle_ci.deleterow(ll_fila_2_reg)
						ll_fila_2_reg 		= dw_detalle_ci.Find("tipo_cob ='4' or tipo_cob ='6'",1, ll_tot_reg_2)
						if ll_fila_2_reg = 0 then sw_ok_2 = 'N'
					end if
				loop
			end if
		end if
		IF ls_tipo_cob_2 = "F" or ls_tipo_cob_2='E' or ls_tipo_cob_2='A' or ls_tipo_cob_2='S' or ls_tipo_cob_2='M' THEN
			ll_tot_reg_2						= dw_detalle_ci.rowcount()
			if ll_tot_reg_2 > 1 then
				
				for ll_indi = 1 to ll_tot_reg_2
					ls_tipo_cob_2_aux		= dw_detalle_ci.getitemstring(ll_indi,'tipo_cob')
					if ls_tipo_cob_2 = ls_tipo_cob_2_aux then 
						ll_count_tipo ++
						ls_pasa_valida		= 'N'
						if ll_count_tipo = 7 and (ls_tipo_cob_2 = 'L' or ls_tipo_cob_2 = 'S') then
							ls_pasa_valida	= 'S'
						elseif ls_tipo_cob_2 <> 'L' and ls_tipo_cob_2 <> 'S' and ll_count_tipo > 1 then
							ls_pasa_valida	= 'S'
						end if
						if ls_pasa_valida = 'S' then
							messagebox("Advertencia","No puede Ingresar Tipo Cobro "+ls_tipo_cob_2+" Duplicado")
							dw_detalle_ci.deleterow(ll_indi)
							fila_2 					= dw_detalle_ci.InsertRow(0)
							dw_detalle_ci.scrolltorow(fila_2)
							dw_detalle_ci.SetItem(fila_2, "uf", gd_uf)
							if rb_bol_afecta.checked=true then
								dw_detalle_ci.SetItem(fila_2, "iva", idb_iva)
							end if
							dw_detalle_ci.SetItem(fila_2, "folio", 0)
							dw_detalle_ci.SetItem(fila_2, "estado", 'N')
							dw_detalle_ci.SetItem(fila_2, "uf", gd_uf)
							if rb_ci_uf.checked=true then
								dw_detalle_ci.SetItem(fila_2, "moneda",'U')
							else
								dw_detalle_ci.SetItem(fila_2, "moneda",'P')
							end if
							setnull(ls_tipo_cob_2);setnull(is_columna_2)
							dw_detalle_ci.scrolltorow(row)
							dw_detalle_ci.setfocus()
							dw_detalle_ci.setcolumn('tipo_cob')
							exit
						end if
					end if
				next
				if ls_tipo_cob_2='F' then
					ll_buscar_ea				= dw_detalle_ci.find("tipo_cob='E' or tipo_cob='A' ",1,ll_tot_reg_2)
					if ll_buscar_ea > 0 then
						messagebox("Advertencia","No puede Ingresar Tipo Cobro "+ls_tipo_cob_2+", Existe Pago Asociado a E-Cuota Credito o A-Pie Multiproducto")
						dw_detalle_ci.deleterow(row)
						row						= 1
						ls_pasa_mult			= 'N'
						dw_detalle_ci.scrolltorow(1)
					end if
				elseif ls_tipo_cob_2='E' then
					ll_buscar_fa				= dw_detalle_ci.find("tipo_cob='F' or tipo_cob='A' ",1,ll_tot_reg_2)
					if ll_buscar_fa > 0 then
						messagebox("Advertencia","No puede Ingresar Tipo Cobro "+ls_tipo_cob_2+", Existe Pago Asociado a F-Mantención o A-Pie Multiproducto")
						dw_detalle_ci.deleterow(row)
						row						= 1
						ls_pasa_mult			= 'N'
						dw_detalle_ci.scrolltorow(1)
					end if
				elseif ls_tipo_cob_2='A' then
					ll_buscar_fe				= dw_detalle_ci.find("tipo_cob='F' or tipo_cob='E' ",1,ll_tot_reg_2)
					if ll_buscar_fe > 0 then
						messagebox("Advertencia","No puede Ingresar Tipo Cobro "+ls_tipo_cob_2+", Existe Pago Asociado a E-Cuota Credito o F-Mantención Multiproducto")
						dw_detalle_ci.deleterow(row)
						row						= 1
						ls_pasa_mult			= 'N'
						dw_detalle_ci.scrolltorow(1)
					end if
				end if
			end if
			if gs_base<>'M' then wf_calcular_interes(ls_tipo_cob_2)
		end if
		IF is_columna_2 = "tipo_cob" THEN
	
			IF ls_tipo_cob_2 = "E" or ls_tipo_cob_2 = "U" THEN //cuota
	//			if ( (ls_tipo_cob_2="E" or ls_tipo_cob_2="U") and (gs_base<>'O' or (gs_base<>'P' and ll_cod_parque <> 101 ))) then
	//			//////Validar
	//				if ls_tipo_cob_2 = "E" then
	//					messagebox("Advertencia","No es posible Ingresar E-Cuota por Comprobante de Ingreso, recuerde solo se consideran Promesas y Pagaré (excluyendo Pagaré Canaán)")
	//				elseif ls_tipo_cob_2 = "U" then 
	//					messagebox("Advertencia","No es posible Ingresar U-Cuota de Reconocimiento por Comprobante de Ingreso, recuerde solo se consideran Promesas y Pagaré (excluyendo Pagaré Canaán)")
	//				end if
	//				SetItem(row, "monto", 0)
	//				SetItem(row, "cantidad", 0)
	//				dw_detalle_ci.setfocus()
	//				dw_detalle_ci.setcolumn('tipo_cob')
	//			else		
					ll_fila_2_mant	= dw_detalle_ci.Find("tipo_cob ='F'",1, dw_detalle_ci.rowcount())
					if ll_fila_2_mant = 0 then
						w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.SetItem(1,'gasto_mant', 0)
						w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.SetItem(1,'mora_mant', 0)
						w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.accepttext()
					end if
					IF gs_rezago <> "S" THEN
						if (gs_base='O' or gs_base='U' or gs_base='M') and dw_datos_ci.DataObject='d_datos_cuenta_ci_oferta' then
							ll_ctas				= dw_datos_ci.getitemnumber(1,'pago_oferta_nro_cuotas')
							ll_ctas_pagadas	= dw_datos_ci.getitemnumber(1,'oferta_v_cta_pag_s')
						elseif gs_base='P' and dw_datos_ci.DataObject='d_datos_cuenta_ci_pagare' then
							ll_ctas				= dw_datos_ci.getitemnumber(1,'pagare_plazo')
							ll_ctas_pagadas_1	= dw_datos_ci.getitemnumber(1,'pagare_cta_pag_la')
							ll_ctas_pagadas_2	= dw_datos_ci.getitemnumber(1,'pagare_cta_pag_isa')
							ll_ctas_pagadas	= ll_ctas_pagadas_1 + ll_ctas_pagadas_2
						elseif gs_base='L' and dw_datos_ci.DataObject='d_datos_cuenta_ci_liberador' then
							ll_ctas				= dw_datos_ci.getitemnumber(1,'pago_liberador_nro_cuotas')
							ll_ctas_pagadas	= dw_datos_ci.getitemnumber(1,'anexo_liberador_cta_pag_m')
						elseif (gs_base='F' or gs_base='G' or gs_base='V') and dw_datos_ci.DataObject='d_datos_cuenta_ci_funeraria' then
							ll_ctas				= dw_datos_ci.getitemnumber(1,'producto_pago_plazo')
							ll_ctas_pagadas	= dw_datos_ci.getitemnumber(1,'producto_anexo_cuotas_pag')
						elseif gs_base='D' and dw_datos_ci.DataObject='d_datos_cuenta_ci_derecho' then
							ll_ctas				= dw_datos_ci.getitemnumber(1,'derecho_plazo')
							ll_ctas_pagadas_1	= dw_datos_ci.getitemnumber(1,'derecho_cta_pag_la')
							ll_ctas_pagadas_2	= dw_datos_ci.getitemnumber(1,'derecho_cta_pag_isa')
							ll_ctas_pagadas	= ll_ctas_pagadas_1 + ll_ctas_pagadas_2
						elseif gs_base='A' and dw_datos_ci.DataObject='d_datos_cuenta_ci_aumento_capacidad' then
							ll_ctas				= dw_datos_ci.getitemnumber(1,'pago_aumento_nro_cuotas')
							ll_ctas_pagadas	= dw_datos_ci.getitemnumber(1,'anexo_aumento_cta_pag_m')
						elseif gs_base='R' and dw_datos_ci.DataObject='dw_repacta_mant_descripcion_traspaso' then
							ll_ctas				= dw_datos_ci.getitemnumber(1,'cuotas_pactadas')
							ll_ctas_pagadas	= dw_datos_ci.getitemnumber(1,'ctas_pagadas')
						elseif (gs_base='F' or gs_base='G' or gs_base='V') and dw_datos_ci.DataObject='d_datos_cuenta_ci_funeraria' then
							ll_ctas				= dw_datos_ci.getitemnumber(1,'producto_pago_plazo')
							ll_ctas_pagadas	= dw_datos_ci.getitemnumber(1,'producto_anexo_cuotas_pag')
						end if
						if gs_base<>'C' then
							if ll_ctas_pagadas>=ll_ctas then
								messagebox("Advertencia","No es Posible Ingresar Cuota, Crédito CANCELADO")
								SetItem(row, "monto", 0)
								SetItem(row, "cantidad", 0)
								dw_detalle_ci.setfocus()
								dw_detalle_ci.setcolumn('tipo_cob')
							else
								if this.getitemnumber(row,'cantidad') <= 1 or isnull(this.getitemnumber(row,'cantidad')) then SetItem(row, "cantidad", 1)
								if gs_base='M' and ls_pasa_mult='S' then
									wf_cargar_credito_m(gs_base+gs_serie+string(gi_numero),ls_tipo_cob_2,1,'CTO',row,is_columna_2)
								else
									ll_monto_cred					= round(dw_datos_ci.GetItemNumber(1,"c_valor_cuota_pesos"),0)
									ll_monto_mora_cred			= wf_calcular_mora(row)
									SELECT	SUM("ABONO_CTA_CTE"."MONTO")  
									INTO 		:ll_sum_monto_abono  
									FROM 	"ABONO_CTA_CTE"  
									WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
											 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
											 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero )  AND 
											 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
									USING		sqlca;
									if ll_sum_monto_abono > 0 then
										ll_monto_cta				= ll_monto_cred * this.getitemnumber(row,'cantidad')
										if ll_sum_monto_abono >= (ll_monto_cta + ll_monto_mora_cred) then
											ll_monto_final_cred	= round(ll_sum_monto_abono - ( ll_monto_cta + ll_monto_mora_cred),0)
											ll_res_abono			= messagebox("Advertencia Abono","En su Cuenta Corriente Existe Abonado $ "+string(ll_sum_monto_abono,'###,###,###,###,##0')+", se descontará por Concepto Crédito $ "+string((ll_monto_cta + ll_monto_mora_cred) - 1,'###,###,###,###,##0')+", quedando a su Favor $ "+string(ll_monto_final_cred,'###,###,###,###,##0')+"... desea utilizar Abono Existente ",Exclamation!,YesNo!,2)
											if ll_res_abono=1 then
												SetItem(row, "monto", ll_monto_cred)
												ll_monto_final_cred ++
												UPDATE	"ABONO_CTA_CTE"  
												SET 		"TIPO_COB_OCUPA" = :gs_tipo_cobro,   
															"FOLIO_OCUPA" = :ll_folio_2,   
															"FECHA_OCUPA" = :ldt_fecha_hoy_2,   
															"MONTO_OCUPA" = (:ll_monto_cta + :ll_monto_mora_cred) - 1,   
															"USUARIO_OCUPA" = :gs_user,   
															"CAJA_OCUPA" = :gs_caja,   
															"ESTADO_REG" = 'O',
															"TIPO_MOV_OCUPA" = 'E',
															"SW_ESTADO_TRANS" = 1  
												WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
														 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
														 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
														 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
												USING		sqlca;
												if sqlca.sqlcode=0 then
													commit;
													INSERT INTO "ABONO_CTA_CTE"  
																( "RUT",		"BASE",		"SERIE",		"NUMERO",	"TIPO_COB",		"FOLIO",		"MONTO",						"FECHA_CREA",		"USUARIO_CREA",	"CAJA_CREA",	"ESTADO_REG",	"TIPO_COB_OCUPA",	"FOLIO_OCUPA",	"FECHA_OCUPA",	"MONTO_OCUPA",	"USUARIO_OCUPA",	"CAJA_OCUPA",	"TIPO_MOV_OCUPA",	"SW_ESTADO_TRANS" )
													VALUES 	( :gi_rut,		:gs_base,	:gs_serie,	:gi_numero,	:gs_tipo_cobro,		:ll_folio_2,		:ll_monto_final_cred,	:gdt_fec_sistema,	:gs_user,			:gs_caja,		'P',				null,					null,				null,				null,				null,					null,				null,					2 )  
													USING		sqlca;
													if sqlca.sqlcode=0 then
														commit;
													else
														rollback;
														messagebox("Error Grabar","Error al INSERTAR ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
													end if
												else
													rollback;
													messagebox("Error Grabar","Error al UPDATE ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
												end if
											else
												ll_monto_final_cred		= ll_monto_cred
												SetItem(row, "monto", ll_monto_cred )
											end if
										else
											ll_res_abono					= messagebox("Advertencia Abono","En su Cuenta Corriente Existe Abonado $ "+string(ll_sum_monto_abono,'###,###,###,###,##0')+", Saldo quedará en 0... desea utilizar por Concepto Crédito Abono Existente",Exclamation!,YesNo!,2)
											if ll_res_abono=1 then
												SetItem(row, "monto", ll_monto_cred )
												UPDATE	"ABONO_CTA_CTE"  
												SET 		"TIPO_COB_OCUPA" = :gs_tipo_cobro,   
															"FOLIO_OCUPA" = :ll_folio_2,   
															"FECHA_OCUPA" = :ldt_fecha_hoy_2,   
															"MONTO_OCUPA" = :ll_sum_monto_abono,   
															"USUARIO_OCUPA" = :gs_user,   
															"CAJA_OCUPA" = :gs_caja,   
															"ESTADO_REG" = 'O',
															"TIPO_MOV_OCUPA" = 'E',
															"SW_ESTADO_TRANS" = 1  
												WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
														 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
														 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
														 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
												USING		sqlca;
												if sqlca.sqlcode=0 then
													commit;
												else
													rollback;
													messagebox("Error Grabar","Error al Update ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
												end if
											else
												ll_monto_final_cred		= ll_monto_cred
												SetItem(row, "monto", ll_monto_cred )
											end if
										end if
									else
										if dw_datos_ci.dataobject='d_datos_cuenta_ci_funeraria' and dw_datos_ci.rowcount() > 0 then
											ls_uso			= dw_datos_ci.getitemstring(1,'producto_anexo_uso')
											if ls_uso = 'NF' and gs_base='F' then
												messagebox("Advertencia","Recuerde que debe Generar Boleta Afecta para Funeraria NF")
												ls_pasa_val	= 'N'
												this.SetItem(row, "cantidad", ll_nulo )
												this.SetItem(row, "tipo_cob", ls_nulo_2 )
												this.accepttext()
											end if
										end if
										if ls_pasa_val='S' then
											ll_monto_final_cred				= ll_monto_cred
											SetItem(row, "monto", ll_monto_cred )
											ll_cant_e								= dw_detalle_ci.getitemnumber(row,'cantidad')
											if rb_ci_uf.checked=true then 
												ls_moneda						= 'U'
											elseif rb_ci_peso.checked=true then 
												ls_moneda						= 'P'
											end if
											ldb_uf									= gd_uf
				
											DECLARE x1 CURSOR FOR  
											SELECT	"SEGURO_ASOCIADOS"."COD_SEGURO",   
														"SEGURO_ASOCIADOS"."MONTO_PRIMA",
														"SEGURO_ASOCIADOS"."MONEDA"
											FROM 	"SEGURO_ASOCIADOS"  
											WHERE ( "SEGURO_ASOCIADOS"."BASE" = :gs_base ) AND  
													  ( "SEGURO_ASOCIADOS"."SERIE" = :gs_serie ) AND  
													  ( "SEGURO_ASOCIADOS"."NUMERO" = :gi_numero ) AND  
													  ( "SEGURO_ASOCIADOS"."ESTADO_REG" = 0 ) AND  
													  ( "SEGURO_ASOCIADOS"."ESTADO_SEGURO" = 'A' )   AND
													  ( "SEGURO_ASOCIADOS"."MONTO_PRIMA" > 0 ) 
											USING	sqlca;
											open x1;
											if sqlca.sqlcode=0 then
												do while sqlca.sqlcode=0
													fetch x1 into :ll_cod_seguro, :ldb_prima, :ls_moneda_ctto;
													if not isnull(ll_cod_seguro) and ll_cod_seguro>0  then
														ll_count_adic			= 0
														ll_tot_reg_2				= dw_detalle_ci.rowcount()
														for ll_indi =1 to ll_tot_reg_2
															ls_tipo_cob_2			= dw_detalle_ci.GetItemString(ll_indi, "tipo_cob")
															if ls_tipo_cob_2 = string(ll_cod_seguro) then
																ll_count_adic ++
																dw_detalle_ci.setitem(ll_indi,'cantidad', ll_cant_e)
															end if
														next
														dw_detalle_ci.accepttext()
														if ll_count_adic = 0 then
															ll_new_seg		= dw_detalle_ci.insertrow(0)
															dw_detalle_ci.setitem(ll_new_seg,'tipo_cob', string(ll_cod_seguro))
															if rb_bol_afecta.checked=true then
																dw_detalle_ci.SetItem(ll_new_seg, "iva", idb_iva)
															end if
															dw_detalle_ci.setitem(ll_new_seg,'cantidad', ll_cant_e)
															if ls_moneda_ctto = '1' then
																dw_detalle_ci.setitem(ll_new_seg,'monto_uf', round( ldb_prima / ldb_uf,4))
																dw_detalle_ci.setitem(ll_new_seg,'monto', ldb_prima)
															elseif ls_moneda_ctto = '2' then
																dw_detalle_ci.setitem(ll_new_seg,'monto_uf', ldb_prima)
																dw_detalle_ci.setitem(ll_new_seg,'monto', round( ldb_prima * ldb_uf,0))
															end if
															dw_detalle_ci.setitem(ll_new_seg,'uf',gd_uf)
															dw_detalle_ci.setitem(ll_new_seg,'estado','S')
														//	gd_uf
															dw_detalle_ci.SetItem(ll_new_seg, "moneda",ls_moneda)
														end if
													end if
													setnull(ll_cod_seguro)
												loop
											end if
											close x1;
										end if
										dw_detalle_ci.accepttext()
									end if
									
									if gs_base<>'M' then wf_calcular_interes(ls_tipo_cob_2)
								end if
							end if
						elseif gs_base='C' then
							messagebox("Advertencia","No es Posible Ingresar Cuota a Contrato")
							dw_detalle_ci.deleterow(row)
							fila_2 					= dw_detalle_ci.InsertRow(0)
							dw_detalle_ci.scrolltorow(fila_2)
							dw_detalle_ci.SetItem(fila_2, "uf", gd_uf)
							dw_detalle_ci.SetItem(fila_2, "folio", 0)
							if rb_bol_afecta.checked=true then
								dw_detalle_ci.SetItem(fila_2, "iva", idb_iva)
							end if
							dw_detalle_ci.SetItem(fila_2, "estado", 'N')
							dw_detalle_ci.SetItem(fila_2, "uf", gd_uf)
							if rb_ci_uf.checked=true then
								dw_detalle_ci.SetItem(fila_2, "moneda",'U')
							else
								dw_detalle_ci.SetItem(fila_2, "moneda",'P')
							end if
							setnull(ls_tipo_cob_2);setnull(is_columna_2)
							dw_detalle_ci.scrolltorow(row)
							dw_detalle_ci.setfocus()
							dw_detalle_ci.setcolumn('tipo_cob')
						end if
					else
						if this.getitemnumber(row,'cantidad') <= 1 or isnull(this.getitemnumber(row,'cantidad')) then SetItem(row, "cantidad", 1)
						SetItem(row, "monto", 0)
					end if
	//			end if
			elseIF ls_tipo_cob_2 = "F" THEN
				if gs_rezago <> "S" THEN
					if gs_conexion = "Parque Santiago" then
						messagebox("Advertencia","No es posible Ingresar F-Cuota Mantención por Comprobante de Ingreso, en PARQUE SANTIAGO")
						SetItem(row, "monto", 0)
						SetItem(row, "cantidad", 0)
						dw_detalle_ci.setfocus()
						dw_detalle_ci.setcolumn('tipo_cob')
					else
						CHOOSE CASE gs_base
							CASE "O","U","M"
								IF dw_datos_ci.getitemnumber(1,'oferta_v_cta_pag_m') > 90 then
									messagebox ("Advertencia ", "Este Contrato tiene anexo Liberador de Mantención ",information!)
									RETURN
								end if
							CASE "C"
								IF dw_datos_ci.getitemnumber(1,'contrato_cta_pag_m') > 90 then
									messagebox ("Advertencia ", "Este Contrato tiene anexo Liberador de Mantención ",information!)
									RETURN
								end if
						END CHOOSE
						if gs_base='O' or gs_base='C' or gs_base='U' or gs_base='M' then
							if this.getitemnumber(row,'cantidad') <= 1 or isnull(this.getitemnumber(row,'cantidad')) then SetItem(row, "cantidad", 1)
							if gs_base='M' and ls_pasa_mult='S' then
								wf_cargar_credito_m(gs_base+gs_serie+string(gi_numero),ls_tipo_cob_2,1,'CTO',row,is_columna_2)
							else
								IF gs_rezago <> "S" THEN
									ll_monto_mant					= round(dw_datos_ci.GetItemNumber(1,"c_valor_cuota_mantencion_pesos"),0)
									SELECT	SUM("ABONO_CTA_CTE"."MONTO")  
									INTO 		:ll_sum_monto_abono  
									FROM 	"ABONO_CTA_CTE"  
									WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
											 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
											 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND
											 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )
									USING		sqlca;
									if ll_sum_monto_abono > 0 then
										ll_monto_cta				= ll_monto_mant * this.getitemnumber(row,'cantidad')
										ll_monto_mora_mant		= wf_calcular_mora_mant(row)
										if ll_sum_monto_abono >= (ll_monto_cta + ll_monto_mora_mant) then
											ll_monto_final_mant	= round(ll_sum_monto_abono - ( ll_monto_cta + ll_monto_mora_mant),0)
											ll_res_abono			= messagebox("Advertencia Abono","En su Cuenta Corriente Existe Abonado $ "+string(ll_sum_monto_abono,'###,###,###,###,##0')+", se descontará por Concepto de Mantención $ "+string((ll_monto_cta + ll_monto_mora_mant) - 1,'###,###,###,###,##0')+", quedando a su Favor $ "+string(ll_monto_final_mant,'###,###,###,###,##0')+"... desea utilizar Abono Existente",Exclamation!,YesNo!,2)
											if ll_res_abono=1 then
												SetItem(row, "monto", ll_monto_mant)
												ll_monto_final_mant ++
												UPDATE	"ABONO_CTA_CTE"  
												SET 		"TIPO_COB_OCUPA" = :gs_tipo_cobro,   
															"FOLIO_OCUPA" = :ll_folio_2,   
															"FECHA_OCUPA" = :ldt_fecha_hoy_2,   
															"MONTO_OCUPA" = (:ll_monto_cta + :ll_monto_mora_mant) - 1,   
															"USUARIO_OCUPA" = :gs_user,   
															"CAJA_OCUPA" = :gs_caja,   
															"ESTADO_REG" = 'O',
															"TIPO_MOV_OCUPA" = 'F',
															"SW_ESTADO_TRANS" = 1  
												WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
														 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
														 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
														 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
												USING		sqlca;
												if sqlca.sqlcode=0 then
													commit;
													INSERT INTO "ABONO_CTA_CTE"  
																( "RUT",		"BASE",		"SERIE",		"NUMERO",	"TIPO_COB",	"FOLIO",		"MONTO",						"FECHA_CREA",		"USUARIO_CREA",	"CAJA_CREA",	"ESTADO_REG",	"TIPO_COB_OCUPA",	"FOLIO_OCUPA",	"FECHA_OCUPA",	"MONTO_OCUPA",	"USUARIO_OCUPA",	"CAJA_OCUPA",	"TIPO_MOV_OCUPA",	"SW_ESTADO_TRANS" )
													VALUES 	( :gi_rut,	:gs_base,	:gs_serie,	:gi_numero,	:gs_tipo_cobro,			:ll_folio_2,	:ll_monto_final_mant,	:gdt_fec_sistema,	:gs_user,			:gs_caja,		'P',				null,					null,				null,				null,				null,					null,				null,					2 )  
													USING		sqlca;
													if sqlca.sqlcode=0 then
														commit;
													else
														rollback;
														messagebox("Error Grabar","Error al INSERTAR ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
													end if
												else
													rollback;
													messagebox("Error Grabar","Error al UPDATE ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
												end if
											else
												ll_monto_final_mant		= ll_monto_mant
												SetItem(row, "monto", ll_monto_mant )
											end if
										else
											ll_res_abono				= messagebox("Advertencia Abono","En su Cuenta Corriente Existe Abonado $ "+string(ll_sum_monto_abono,'###,###,###,###,##0')+", Monto a Cancelar es $ "+string(ll_monto_cta,'###,###,###,###,##0')+" y su Saldo quedará en 0... desea utilizar por Concepto de Mantención Abono Existente",Exclamation!,YesNo!,2)
											if ll_res_abono = 1 then
												SetItem(row, "monto", ll_monto_mant )
												UPDATE	"ABONO_CTA_CTE"  
												SET 		"TIPO_COB_OCUPA" = :gs_tipo_cobro,   
															"FOLIO_OCUPA" = :ll_folio_2,   
															"FECHA_OCUPA" = :ldt_fecha_hoy_2,   
															"MONTO_OCUPA" = :ll_sum_monto_abono,   
															"USUARIO_OCUPA" = :gs_user,   
															"CAJA_OCUPA" = :gs_caja,   
															"ESTADO_REG" = 'O',
															"TIPO_MOV_OCUPA" = 'F',
															"SW_ESTADO_TRANS" = 1  
												WHERE  ( "ABONO_CTA_CTE"."BASE" = :gs_base ) AND  
														 ( "ABONO_CTA_CTE"."SERIE" = :gs_serie ) AND  
														 ( "ABONO_CTA_CTE"."NUMERO" = :gi_numero ) AND  
														 ( "ABONO_CTA_CTE"."ESTADO_REG" = 'P' )   
												USING		sqlca;
												if sqlca.sqlcode=0 then
													commit;
												else
													rollback;
													messagebox("Error Grabar","Error al Update ABONO_CTA_CTE SQL: "+sqlca.sqlerrtext)
												end if
											else
												ll_monto_final_mant		= ll_monto_mant
												SetItem(row, "monto", ll_monto_mant )
											end if
										end if
									else
										ll_monto_final_mant		= ll_monto_mant
										SetItem(row, "monto", ll_monto_mant )
									end if
									if gs_base<>'M' then wf_calcular_interes(ls_tipo_cob_2)
								ELSE 
									SetItem(row, "monto", 0)
								END IF
							end if
						else
							messagebox("Advertencia","No es posible Ingresar F-Cuota Mantención, para este tipo de Contrato (Solo O-Promesas y C-Contrato)")
							SetItem(row, "monto", 0)
							SetItem(row, "cantidad", 0)
							dw_detalle_ci.setfocus()
							dw_detalle_ci.setcolumn('tipo_cob')
						end if
					end if
				END IF
			elseif ls_tipo_cob_2 = 'I' then //Abono
				messagebox("Advertencia","No es Posible Ingresar I-Abono")
				SetItem(row, "monto", 0)
				SetItem(row, "cantidad", 0)
				dw_detalle_ci.setfocus()
				dw_detalle_ci.setcolumn('tipo_cob')
			elseIF ls_tipo_cob_2 = "M" then //Derecho Sepultacion
				if gs_rezago <> "S" THEN
					ls_estado_cadena_2 										= dw_datos_ci.getitemstring(1,'cadena_estado')
					if ls_estado_cadena_2='V' or ls_estado_cadena_2='C' or ls_estado_cadena_2='S' then
						if gs_base='O' or gs_base='C' or gs_base='U' or gs_base='M' then
							tab_ingreso.tp_ci.rb_ci_uf.visible			= true
							tab_ingreso.tp_ci.rb_ci_peso.visible		= false
							tab_ingreso.tp_ci.rb_ci_uf.checked		= true
							tab_ingreso.tp_ci.rb_ci_peso.visible		= false
							if rb_ci_uf.checked=true then 
								dw_detalle_ci.SetItem(dw_detalle_ci.getrow(), "moneda",'U')
							elseif rb_ci_peso.checked=true then 
								dw_detalle_ci.SetItem(dw_detalle_ci.getrow(), "moneda",'P')
							end if
							if this.getitemnumber(row,'cantidad') <= 1 or isnull(this.getitemnumber(row,'cantidad')) then SetItem(row, "cantidad", 1)
						else
							messagebox("Advertencia","No es Posible Ingresar M-Derecho Sepultura para este Tipo de Contrato")
							SetItem(row, "monto", 0)
							SetItem(row, "cantidad", 0)
							dw_detalle_ci.setfocus()
							dw_detalle_ci.setcolumn('tipo_cob')
						end if
					else
						tab_ingreso.tp_ci.rb_ci_uf.visible		= false
						tab_ingreso.tp_ci.rb_ci_peso.visible	= false
						tab_ingreso.tp_ci.rb_ci_uf.checked		= false
						tab_ingreso.tp_ci.rb_ci_peso.visible	= true
						messagebox("Advertencia","Recuerde que Contrato debe estar V-Vigente o C-Cancelado")
						SetItem(row, "monto", 0)
						SetItem(row, "cantidad", 0)
						dw_detalle_ci.setfocus()
						dw_detalle_ci.setcolumn('tipo_cob')
					end if
				else
					tab_ingreso.tp_ci.rb_ci_uf.visible			= true
					tab_ingreso.tp_ci.rb_ci_peso.visible		= true
					tab_ingreso.tp_ci.rb_ci_uf.checked			= true
					if rb_ci_uf.checked=true then 
						dw_detalle_ci.SetItem(dw_detalle_ci.getrow(), "moneda",'U')
					elseif rb_ci_peso.checked=true then 
						dw_detalle_ci.SetItem(dw_detalle_ci.getrow(), "moneda",'P')
					end if
					if this.getitemnumber(row,'cantidad') <= 1 or isnull(this.getitemnumber(row,'cantidad')) then SetItem(row, "cantidad", 1)
				end if
				
			elseIF ls_tipo_cob_2 = "A" or ls_tipo_cob_2 = "Q" THEN //pie
				if gs_base='M' and ls_pasa_mult='S' then
					wf_cargar_credito_m(gs_base+gs_serie+string(gi_numero),ls_tipo_cob_2,1,'CTO',row,is_columna_2)
				else
					IF gs_rezago <> "S" THEN
						ls_estado_cadena_2 		= dw_datos_ci.getitemstring(1,'cadena_estado')
						if (gs_base='O' or gs_base='U' or gs_base='M') and dw_datos_ci.DataObject='d_datos_cuenta_ci_oferta' then
							ll_ctas				= dw_datos_ci.getitemnumber(1,'pago_oferta_nro_cuotas')
							ll_ctas_pagadas	= dw_datos_ci.getitemnumber(1,'oferta_v_cta_pag_s')
							ld_pie_pactado		= dw_datos_ci.getitemnumber(1,'pago_oferta_pie')
							
						elseif gs_base='P' and dw_datos_ci.DataObject='d_datos_cuenta_ci_pagare' then
							ll_ctas				= dw_datos_ci.getitemnumber(1,'pagare_plazo')
							ll_ctas_pagadas_1	= dw_datos_ci.getitemnumber(1,'pagare_cta_pag_la')
							ll_ctas_pagadas_2	= dw_datos_ci.getitemnumber(1,'pagare_cta_pag_isa')
							ll_ctas_pagadas	= ll_ctas_pagadas_1 + ll_ctas_pagadas_2
							ld_pie_pactado		= dw_datos_ci.getitemnumber(1,'pagare_pie')
							
						elseif gs_base='L' and dw_datos_ci.DataObject='d_datos_cuenta_ci_liberador' then
							ll_ctas				= dw_datos_ci.getitemnumber(1,'pago_liberador_nro_cuotas')
							ll_ctas_pagadas	= dw_datos_ci.getitemnumber(1,'anexo_liberador_cta_pag_m')
							ld_pie_pactado		= dw_datos_ci.getitemnumber(1,'pago_liberador_pie')
							
						elseif (gs_base='F' or gs_base='G' or gs_base='V') and dw_datos_ci.DataObject='d_datos_cuenta_ci_funeraria' then
							ll_ctas				= dw_datos_ci.getitemnumber(1,'producto_pago_plazo')
							ll_ctas_pagadas	= dw_datos_ci.getitemnumber(1,'producto_anexo_cuotas_pag')
							ld_pie_pactado		= dw_datos_ci.getitemnumber(1,'producto_pago_pie')
							
						elseif gs_base='D' and dw_datos_ci.DataObject='d_datos_cuenta_ci_derecho' then
							ll_ctas				= dw_datos_ci.getitemnumber(1,'derecho_plazo')
							ll_ctas_pagadas_1	= dw_datos_ci.getitemnumber(1,'derecho_cta_pag_la')
							ll_ctas_pagadas_2	= dw_datos_ci.getitemnumber(1,'derecho_cta_pag_isa')
							ll_ctas_pagadas	= ll_ctas_pagadas_1 + ll_ctas_pagadas_2
							ld_pie_pactado		= dw_datos_ci.getitemnumber(1,'derecho_pie')
							
						elseif gs_base='A' and dw_datos_ci.DataObject='d_datos_cuenta_ci_aumento_capacidad' then
							ll_ctas				= dw_datos_ci.getitemnumber(1,'pago_aumento_nro_cuotas')
							ll_ctas_pagadas	= dw_datos_ci.getitemnumber(1,'anexo_aumento_cta_pag_m')
							ld_pie_pactado		= dw_datos_ci.getitemnumber(1,'pago_aumento_pie')
							
						elseif gs_base='R' and dw_datos_ci.DataObject='dw_repacta_mant_descripcion_traspaso' then
							ll_ctas				= 0
							ll_ctas_pagadas	= 0
							ld_pie_pactado		= 0
						end if
						if gs_base<>'C' then
							if ld_pie_pactado=0 or isnull(ld_pie_pactado) then
								messagebox("Advertencia","No es Posible Ingresar A-Pie, NO tiene Valor")
								SetItem(row, "monto", 0)
								SetItem(row, "cantidad", 0)
								dw_detalle_ci.setfocus()
								dw_detalle_ci.setcolumn('tipo_cob')
							else
								if ll_ctas_pagadas>=ll_ctas and ls_estado_cadena_2='C' then
									messagebox("Advertencia","No es Posible Ingresar A-Pie")
									SetItem(row, "monto", 0)
									SetItem(row, "cantidad", 0)
									dw_detalle_ci.setfocus()
									dw_detalle_ci.setcolumn('tipo_cob')
								else
									if gs_base='O' or gs_base='U' or gs_base='M' then
										if dw_datos_ci.getitemnumber(1,'pago_oferta_pie') > 0 and &
											dw_datos_ci.getitemnumber(1,'pago_oferta_ctas_pagadas_pie') >= dw_datos_ci.getitemnumber(1,'pago_oferta_ctas_pactadas_pie') and dw_datos_ci.getitemnumber(1,'pago_oferta_ctas_pactadas_pie') > 0 then
											ls_pasa	= 'N'
										else
											ls_pasa	= 'S'
										end if
										if ls_pasa='N' then
											if dw_datos_ci.getitemnumber(1,'c_valor_pie_pesos') > 0 and dw_datos_ci.getitemnumber(1,'pago_oferta_pie_pagado')>0  then
												ls_pasa	= 'N'
											else
												ls_pasa	= 'S'
											end if
										end if
										//	valida PIE Promesa
										if ls_pasa='S' then
											ll_fila_2_pie 		= dw_detalle_ci.Find("tipo_cob ='A' or tipo_cob ='Q'",1, ll_tot_reg_2)
											if ll_fila_2_Pie > 0 then
												ll_monto_pie_ingreso		= round(dw_detalle_ci.getitemnumber(dw_detalle_ci.getrow(),'c_total_linea'),0)
											else
												ll_monto_pie_ingreso		= 0
											end if
											if isnull(ll_monto_pie_ingreso) then ll_monto_pie_ingreso=0
											ldb_valor_pie_reg				= round(f_valida_pie_pagado(gs_base, gs_serie, gi_numero, dw_datos_ci.getitemstring(1,'pago_oferta_moneda')),0)
											if ldb_valor_pie_reg + ll_monto_pie_ingreso > ld_pie_pactado  then
												ls_pasa	= 'N'
											else
												ls_pasa	= 'S'
											end if
										end if
									elseif gs_base='L' then
										if dw_datos_ci.getitemnumber(1,'pago_liberador_pie') > 0 and &
											dw_datos_ci.getitemnumber(1,'pago_liberador_ctas_pagadas_pie') >= dw_datos_ci.getitemnumber(1,'pago_liberador_ctas_pactadas_pie') and dw_datos_ci.getitemnumber(1,'pago_liberador_ctas_pactadas_pie') > 0 then
											ls_pasa	= 'N'
										else
											ls_pasa	= 'S'
										end if
										if ls_pasa='S' then
											if dw_datos_ci.getitemnumber(1,'c_valor_pie_pesos') > 0 and dw_datos_ci.getitemnumber(1,'pago_liberador_pie_pagado')>0  then
												ls_pasa	= 'N'
											else
												ls_pasa	= 'S'
											end if
										end if
										//	valida PIE Liberador
										if ls_pasa='S' then
											ll_fila_2_pie 		= dw_detalle_ci.Find("tipo_cob ='A' or tipo_cob ='Q'",1, ll_tot_reg_2)
											if ll_fila_2_Pie > 0 then
												ll_monto_pie_ingreso		= round(dw_detalle_ci.getitemnumber(dw_detalle_ci.getrow(),'c_total_linea'),0)
											else
												ll_monto_pie_ingreso		= 0
											end if
											if isnull(ll_monto_pie_ingreso) then ll_monto_pie_ingreso=0
											ldb_valor_pie_reg				= round(f_valida_pie_pagado(gs_base, gs_serie, gi_numero, dw_datos_ci.getitemstring(1,'pago_liberador_moneda')),0)
											if ldb_valor_pie_reg + ll_monto_pie_ingreso > ld_pie_pactado  then
												ls_pasa	= 'N'
											else
												ls_pasa	= 'S'
											end if
										end if
									elseif gs_base='F' or gs_base='G' or gs_base='V' then
										if dw_datos_ci.getitemnumber(1,'c_valor_pie_pesos') > 0 and dw_datos_ci.getitemnumber(1,'producto_pago_pie_pagado')>0  then
											ls_pasa	= 'N'
										else
											ls_pasa	= 'S'
										end if
									elseif gs_base='A' then
										if dw_datos_ci.getitemnumber(1,'pago_aumento_pie') > 0 and &
											dw_datos_ci.getitemnumber(1,'pago_aumento_ctas_pagadas_pie') >= dw_datos_ci.getitemnumber(1,'pago_aumento_ctas_pactadas_pie') and dw_datos_ci.getitemnumber(1,'pago_aumento_ctas_pactadas_pie') > 0 then
											ls_pasa	= 'N'
										else
											ls_pasa	= 'S'
										end if
										//	valida PIE Aumento
										if ls_pasa='S' then
											ll_fila_2_pie 		= dw_detalle_ci.Find("tipo_cob ='A' or tipo_cob ='Q'",1, ll_tot_reg_2)
											if ll_fila_2_Pie > 0 then
												ll_monto_pie_ingreso		= round(dw_detalle_ci.getitemnumber(dw_detalle_ci.getrow(),'c_total_linea'),0)
											else
												ll_monto_pie_ingreso		= 0
											end if
											if isnull(ll_monto_pie_ingreso) then ll_monto_pie_ingreso=0
											ldb_valor_pie_reg				= round(f_valida_pie_pagado(gs_base, gs_serie, gi_numero, dw_datos_ci.getitemstring(1,'pago_aumento_moneda')),0)
											if ldb_valor_pie_reg + ll_monto_pie_ingreso > ld_pie_pactado  then
												ls_pasa	= 'N'
											else
												ls_pasa	= 'S'
											end if
										end if
									elseif gs_base='D' then
										if dw_datos_ci.getitemnumber(1,'c_valor_pie_pesos') > 0 and dw_datos_ci.getitemnumber(1,'derecho_pie_pagado')>0 then
											ls_pasa	= 'N'
										else
											ls_pasa	= 'S'
										end if
									elseif gs_base='R' then
										ls_pasa	= 'N'
									elseif gs_base='P' then
										if dw_datos_ci.getitemnumber(1,'c_valor_pie_pesos') > 0 and dw_datos_ci.getitemnumber(1,'pagare_pie_pagado')>0  then
											ls_pasa	= 'N'
										else
											ls_pasa	= 'S'
										end if
									end if
									if ls_pasa='N' then
										messagebox("Advertencia","No es Posible Ingresar A-Pie")
										SetItem(row, "monto", 0)
										SetItem(row, "cantidad", 0)
										dw_detalle_ci.setfocus()
										dw_detalle_ci.setcolumn('tipo_cob')
									else								
										gs_grabar_pie	= 'N'
										if dw_datos_ci.dataobject='d_datos_cuenta_ci_funeraria' and dw_datos_ci.rowcount() > 0 then
											ls_uso			= dw_datos_ci.getitemstring(1,'producto_anexo_uso')
											if ls_uso = 'NF' and gs_base='F' then
												messagebox("Advertencia","Recuerde que debe Generar Boleta Afecta para Funeraria NF")
												ls_pasa_val	= 'N'
												this.SetItem(row, "cantidad", ll_nulo )
												this.SetItem(row, "tipo_cob", ls_nulo_2 )
												this.accepttext()
											end if
										end if
										if ls_pasa_val='S' then
											ls_texto_2			= gs_base+'~t'+gs_serie+'~t'+string(gi_numero)+'~t'+gs_tipo_cobro+'~t'+trim(sle_numero_ci.text)
											openwithparm(w_ingreso_pago_pie_pactado,ls_texto_2)
											if Message.StringParm = 'N' then
												if this.getitemnumber(row,'cantidad') <= 1 or isnull(this.getitemnumber(row,'cantidad')) then SetItem(row, "cantidad", 1)
												this.SetItem(row, "monto", dw_datos_ci.GetItemNumber(1,"c_valor_pie_pesos"))
												this.accepttext()
											else
												w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.accepttext()
												w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.setfocus()
												w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.triggerevent(itemchanged!)
											end if
										end if
									end if
								end if
							end if
						else
							messagebox("Advertencia","No es Posible Ingresar A-Pie a Contrato")
							SetItem(row, "monto", 0)
							SetItem(row, "cantidad", 0)
							dw_detalle_ci.setfocus()
							dw_detalle_ci.setcolumn('tipo_cob')
						end if
					else
						gs_grabar_pie	= 'N'
						
						SELECT	DISTINCT 	"DETALLE_PAGO_PIE"."BASE", 	"DETALLE_PAGO_PIE"."SERIE", 	"DETALLE_PAGO_PIE"."NUMERO" ,		"CADENA"."ESTADO"   
						INTO 						:gs_base,   							:gs_serie,   								:gi_numero ,								:ls_estado_ctto
						FROM 	"DETALLE_PAGO_PIE",  	"CUPONERAS_DETALLE_WEB" ,		"CADENA"
						WHERE 	( "DETALLE_PAGO_PIE"."BASE" = "CUPONERAS_DETALLE_WEB"."BASE" ) and  
									( "DETALLE_PAGO_PIE"."SERIE" = "CUPONERAS_DETALLE_WEB"."SERIE" ) and  
									( "DETALLE_PAGO_PIE"."NUMERO" = "CUPONERAS_DETALLE_WEB"."NUMERO" ) and  
									( detalle_pago_pie.serie = cadena.serie (+)) and  
									( detalle_pago_pie.base = cadena.codigo (+)) and  
									( detalle_pago_pie.numero = cadena.numero (+)) and  
									( "CUPONERAS_DETALLE_WEB"."RUT" = :gi_rut ) AND  
									( "CUPONERAS_DETALLE_WEB"."PIE_PACTADO" = 'AA' )   
						USING	sqlca;
						if sqlca.sqlcode=0 then
							if (ls_estado_ctto = 'V' or isnull(ls_estado_ctto)) and gs_rezago<>'S' then
								ls_texto_2			= gs_base+'~t'+gs_serie+'~t'+string(gi_numero)+'~t'+gs_tipo_cobro+'~t'+trim(sle_numero_ci.text)
								openwithparm(w_ingreso_pago_pie_pactado,ls_texto_2)
							else
								gi_numero		= 0
							end if
						end if
						if Message.StringParm = 'N' then
							if this.getitemnumber(row,'cantidad') <= 1 or isnull(this.getitemnumber(row,'cantidad')) then SetItem(row, "cantidad", 1)
	//						this.SetItem(row, "monto", dw_datos_ci.GetItemNumber(1,"c_valor_pie_pesos"))
							this.accepttext()
						else
							w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.accepttext()
							w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.setfocus()
							w_ingreso2.tab_ingreso.tp_ci.dw_detalle_ci.triggerevent(itemchanged!)
						end if
						if this.getitemnumber(row,'cantidad') <= 1 or isnull(this.getitemnumber(row,'cantidad')) then SetItem(row, "cantidad", 1)
						SetItem(row, "monto", 0)
						w_ingreso2.tab_ingreso.tp_ci.dw_gastos_ci.accepttext()
					end if
				end if
			ELSEIF ls_tipo_cob_2 = "K" THEN
				if not isnull(ls_descrip_estado) then
					if gs_rezago <> "S" then
						messagebox("Advertencia","Para aplicar este Tipo de Cobro el Estado del Contrato debe estar en: S-Seguro Desgravamen, actualmente se encuentra en: "+ls_descrip_estado)
					else
						messagebox("Advertencia","Para aplicar este Tipo de Cobro el Estado del Contrato debe estar en: S-Seguro Desgravamen, actualmente se está ingresando como Rezago")
					end if
				else
					messagebox("Advertencia","No es Posible Ingresar K-Seguro Desgravamen")
				end if
				SetItem(row, "monto", 0)
				SetItem(row, "cantidad", 0)
				dw_detalle_ci.setfocus()
				dw_detalle_ci.setcolumn('tipo_cob')
	
			ELSEIF ls_tipo_cob_2 = "L" or ls_tipo_cob_2 = "S" THEN
				SetItem(row, "monto", 0)
				if this.getitemnumber(row,'cantidad') <= 1 or isnull(this.getitemnumber(row,'cantidad')) then SetItem(row, "cantidad", 1)
				ls_texto_2			= ls_tipo_cob_2+'~t'+ls_tipo_comp_2
	
				// VHFB -- INCIO -- CONTROL DE INGRESO AUTOMATICO	
				if gb_aplica = false then
				openwithparm(w_apertura_tipo_cobro_otros,ls_texto_2)
				END IF 
				// VHFB -- TERMINO -- CONTROL DE INGRESO AUTOMATICO	
				
				
			ELSEIF ls_tipo_cob_2 = "4" or ls_tipo_cob_2 = "6" THEN
				ll_fila_2_cred		= dw_detalle_ci.Find("tipo_cob = 'E' or tipo_cob = 'U'", 1, dw_detalle_ci.RowCount())
				if ll_fila_2_cred = 0 then
					messagebox("Advertencia","No es Posible Ingresar Tipo Cobro, debe existir Pago Crédido")
					dw_detalle_ci.SetItem(row, "monto", 0)
					dw_detalle_ci.SetItem(row, "cantidad", 0)
					dw_detalle_ci.setfocus()
					dw_detalle_ci.setcolumn('tipo_cob')	
				end if
			else
				if this.getitemnumber(row,'cantidad') <= 1 or isnull(this.getitemnumber(row,'cantidad')) then SetItem(row, "cantidad", 1)
				SetItem(row, "monto", 0)
			END IF
		END IF
		IF is_columna_2 = "monto_uf" and rb_ci_uf.checked=true THEN
			ld_monto				= this.getitemnumber(row,'monto_uf')
			ls_tipo_cob_2			= this.getitemstring(row,'tipo_cob')
			ll_monto_tot_reg	= round(this.getitemnumber(row,'c_total_linea'),0)
			if ld_monto>800 or ld_monto < 0 then
				if isnull(il_cantidad_malo) then	il_cantidad_malo	= this.getitemnumber(row,'cantidad')
				messagebox("Advertencia","Revisar Monto Ingresado, recuerde tiene Seleccionado Opción Ingreso MONTO en U.F. y Mayor a CERO")
				SetItem(row, "monto", 0)
				SetItem(row, "cantidad", 0)
			else
				if il_cantidad_malo>0 then 
					this.setitem(row,'cantidad',il_cantidad_malo)
				else
					if gl_sw_mp = 0 and gl_codigo_mp > 0 then
						ldb_acum_pie							= 0
						ldb_iva_acum							= 0
						ll_item									= 0
						DECLARE x3 CURSOR FOR  
						SELECT 	"MPPRODUCTO"."PORCENTAJEPIE",  	"MPPRODUCTO"."PRECIO",   	"MPPRODUCTODET"."BASE",   	"MPPRODUCTODET"."PRECIO",   	"MPPRODUCTODET"."IVA",   	"MPPRODUCTODET"."PORCENTAJEPIE" ,   	"MPPRODUCTODET"."PORCSUBTOTALIMP" 
						FROM 	"MPPRODUCTO",   	"MPPRODUCTODET"  
						WHERE 	( "MPPRODUCTO"."CODIGOMP" = "MPPRODUCTODET"."CODIGOMP" ) and  
									( "MPPRODUCTO"."CODIGOMP" = :gl_codigo_mp )   
						USING	Trans_2;
						open x3;
						if Trans_2.sqlcode=0 then
							do while Trans_2.sqlcode=0
								fetch x3 into :ldb_porc_pie_mp, :ldb_precio_mp,	:ls_base_mpdet, :ldb_precio_mpdet, :ldb_iva_mpdet, :ldb_porc_pie_mp_det, :ldb_porcsubtotimp_mpdet;
								if not isnull(ls_base_mpdet) then
									if gs_rezago='S' then
										if gs_conexion	 = "Parque El Prado" then
											ls_ctto				= 'MG'+string(0)
											ls_serie				= 'G'
										elseif gs_conexion	= "Parque La Foresta" then
											ls_ctto				= 'MN'+string(0)
											ls_serie				= 'N'
										end if
										ll_fila_2_mov_existe	= dw_multiproducto.find("tipo_mov='"+ls_tipo_cob_2+"'",1,dw_multiproducto.rowcount())
										if ll_fila_2_mov_existe=0 then
											ll_fila_2				= dw_multiproducto.insertrow(0)
											ll_item ++
										else
											ll_fila_2				= ll_fila_2_mov_existe
											ll_item				= dw_multiproducto.getitemnumber(ll_fila_2,'item')
										end if
										dw_multiproducto.setitem(ll_fila_2,'item',ll_item)
										dw_multiproducto.setitem(ll_fila_2,'contrato',ls_ctto)
										dw_multiproducto.setitem(ll_fila_2,'rut',gi_rut)
										dw_multiproducto.setitem(ll_fila_2,'cantidad',1)
