event modified;if cbx_manual_factura.checked=true then
	gs_tipo_cobro												= "BL"
else
	if rb_fac_afecta.checked=true then
		gs_tipo_cobro											= "FA"
	elseif rb_fac_exenta.checked=true then
		gs_tipo_cobro											= "FE"
	end if	
end if

IF gf_existe_boleta(long(sle_numero_bl.text),gs_tipo_cobro) THEN
	MessageBox("Ingreso Boletas", "El Número de Factura ya existe !")
	sle_numero_bl.text 										= ""
	cb_bl_insertar.Enabled 									= false
	cb_bl_borrar_item.Enabled 								= false
	dw_detalle_bl.reset()
	sle_numero_bl.setfocus()
ELSE
	if gs_rezago = "S" then
		tab_ingreso.tp_boletas.rb_ci_uf_bl.visible		= true
		tab_ingreso.tp_boletas.rb_ci_peso_bl.visible	= true
		tab_ingreso.tp_boletas.rb_ci_uf_bl.checked		= true
	else
		tab_ingreso.tp_boletas.rb_ci_uf_bl.visible		= false
		tab_ingreso.tp_boletas.rb_ci_peso_bl.visible	= false
	end if
	IF LONG(sle_numero_bl.text)>0 THEN
		cb_bl_insertar.Enabled 								= TRUE
		cb_bl_borrar_item.Enabled 							= TRUE
		cb_bl_insertar.setfocus()
	ELSE
		Messagebox("Advertencia","Número de Boleta debe ser Mayor a 0")
		sle_numero_bl.text									= ''
		sle_numero_bl.setfocus()
	END IF
END IF
end event

