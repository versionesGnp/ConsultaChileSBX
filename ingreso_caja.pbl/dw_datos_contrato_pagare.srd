 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"pagare~" )  TABLE(NAME=~"cod_parq~" )  TABLE(NAME=~"tasa~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"cadena_mora~" ) COLUMN(NAME=~"pagare.serie_p~") COLUMN(NAME=~"pagare.tasa~") COLUMN(NAME=~"pagare.valor_cuo~") COLUMN(NAME=~"pagare.fecha_prim~") COLUMN(NAME=~"pagare.fecha_ult~") COLUMN(NAME=~"pagare.plazo~") COLUMN(NAME=~"pagare.cta_pag_la~") COLUMN(NAME=~"pagare.cta_pag_isa~") COLUMN(NAME=~"pagare.moneda~") COLUMN(NAME=~"pagare.parque~") COLUMN(NAME=~"cod_parq.codigo~") COLUMN(NAME=~"cod_parq.nombre~") COLUMN(NAME=~"pagare.nro_pagare~") COLUMN(NAME=~"tasa.tasa_m~") COLUMN(NAME=~"tasa.tasa_a~") COLUMN(NAME=~"tasa.tasa_int_p~") COLUMN(NAME=~"tasa.tasa_int_uf~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"pagare.tot_pagado~") COLUMN(NAME=~"cadena.estado_carta~") COLUMN(NAME=~"cadena_mora.mora_cred~") COLUMN(NAME=~"cadena_mora.dias_mora_cred~") COLUMN(NAME=~"cadena_mora.fecha_venc_cred~") COLUMN(NAME=~"cadena.cod_parque~") COLUMN(NAME=~"pagare.pie~") COLUMN(NAME=~"pagare.pie_pagado~")    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"cadena_mora.serie~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"cadena_mora.base~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"cadena_mora.numero~" )    JOIN (LEFT=~"pagare.serie_p~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"pagare.nro_pagare~"    OP =~"=~"RIGHT=~"cadena.numero~" )    JOIN (LEFT=~"cod_parq.codigo~"    OP =~"=~"RIGHT=~"cadena.cod_parque~" )WHERE(    EXP1 =~"~~~"PAGARE~~~".~~~"SERIE_P~~~"~"   OP =~"=~"    EXP2 =~":as_serie~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"PAGARE~~~".~~~"NRO_PAGARE~~~"~"   OP =~"=~"    EXP2 =~":an_numero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'P'~" ) ) ARG(NAME = ~"as_serie~" TYPE = string)  ARG(NAME = ~"an_numero~" TYPE = number)  ARG(NAME = ~"uf_dia~" TYPE = number) " arguments=(("as_serie", string),("an_numero", number),("uf_dia", number)) )
