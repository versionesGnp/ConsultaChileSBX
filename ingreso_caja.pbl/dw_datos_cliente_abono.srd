 column=(type=char(90) updatewhereclause=yes name=ciudad_sigla_ciudad dbname="ciudad.sigla_ciudad" )
 column=(type=char(90) updatewhereclause=yes name=comuna_sigla_comuna dbname="comuna.sigla_comuna" )
 column=(type=char(25) updatewhereclause=yes name=cliente_fono_p dbname="cliente.fono_p" )
 column=(type=datetime updatewhereclause=yes name=cliente_fecha_nac dbname="cliente.fecha_nac" )
 column=(type=char(1) updatewhereclause=yes name=cliente_estado_titular dbname="cliente.estado_titular" values="0 - Activo	0/1 - fallecido	1/" )
 column=(type=char(25) updatewhereclause=yes name=cliente_fono_c dbname="cliente.fono_c" )
 column=(type=char(25) updatewhereclause=yes name=cliente_celular dbname="cliente.celular" )
 column=(type=char(300) updatewhereclause=yes name=cliente_email dbname="cliente.email" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cliente~" )  TABLE(NAME=~"ciudad~" )  TABLE(NAME=~"comuna~" )  TABLE(NAME=~"tipo_via~" ) COLUMN(NAME=~"cliente.rut~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"tipo_via.descripcion~") COLUMN(NAME=~"cliente.direccion_p~") COLUMN(NAME=~"cliente.numero_particular~") COLUMN(NAME=~"cliente.depto_particular~") COLUMN(NAME=~"cliente.block_particular~") COLUMN(NAME=~"cliente.poblacion~") COLUMN(NAME=~"cliente.sector~") COLUMN(NAME=~"ciudad.sigla_ciudad~") COLUMN(NAME=~"comuna.sigla_comuna~") COLUMN(NAME=~"cliente.fono_p~") COLUMN(NAME=~"cliente.fecha_nac~") COLUMN(NAME=~"cliente.estado_titular~") COLUMN(NAME=~"cliente.fono_c~") COLUMN(NAME=~"cliente.celular~") COLUMN(NAME=~"cliente.email~")    JOIN (LEFT=~"cliente.ciudad~"    OP =~"=~"RIGHT=~"ciudad.codigo_ciudad~" )    JOIN (LEFT=~"cliente.comuna~"    OP =~"=~"RIGHT=~"comuna.codigo_comuna~" )    JOIN (LEFT=~"cliente.tipo_via~"    OP =~"=~"RIGHT=~"tipo_via.tipo_via~" )WHERE(    EXP1 =~"~~~"CLIENTE~~~".~~~"RUT~~~"~"   OP =~"=~"    EXP2 =~":rut~" ) ) ARG(NAME = ~"rut~" TYPE = number) " arguments=(("rut", number)) )
