 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"vista_listado_cttos_calculo~" ) COLUMN(NAME=~"vista_listado_cttos_calculo.base~") COLUMN(NAME=~"vista_listado_cttos_calculo.serie~") COLUMN(NAME=~"vista_listado_cttos_calculo.numero~") COLUMN(NAME=~"vista_listado_cttos_calculo.precio~") COLUMN(NAME=~"vista_listado_cttos_calculo.pie~") COLUMN(NAME=~"vista_listado_cttos_calculo.tasa~") COLUMN(NAME=~"vista_listado_cttos_calculo.tasa_base~") COLUMN(NAME=~"vista_listado_cttos_calculo.plazo~") COLUMN(NAME=~"vista_listado_cttos_calculo.valor_cuota~") COLUMN(NAME=~"vista_listado_cttos_calculo.moneda~") COLUMN(NAME=~"vista_listado_cttos_calculo.tipo_cobro~") COLUMN(NAME=~"vista_listado_cttos_calculo.estado_ctto~") COLUMN(NAME=~"vista_listado_cttos_calculo.gastos_adm~") COLUMN(NAME=~"vista_listado_cttos_calculo.fecha_prim~") COLUMN(NAME=~"vista_listado_cttos_calculo.tasa_interes_cuota~") COMPUTE(NAME=~"0 as estado_reg~")WHERE(    EXP1 =~"~~~"VISTA_LISTADO_CTTOS_CALCULO~~~".~~~"CREADA~~~"~"   OP =~"<>~"    EXP2 =~"'S'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"VISTA_LISTADO_CTTOS_CALCULO~~~".~~~"ESTADO_CTTO~~~"~"   OP =~"=~"    EXP2 =~"'V'~" ) ) ORDER(NAME=~"vista_listado_cttos_calculo.numero~" ASC=yes ) "  sort="numero A " )
