_parque~")    JOIN (LEFT=~"facturas_ingreso.rut~"    OP =~"=~"RIGHT=~"facturas_cliente_exentas.rut~" )    JOIN (LEFT=~"facturas_cadena.codigo~"    OP =~"=~"RIGHT=~"facturas_ingreso.base~" )    JOIN (LEFT=~"facturas_cadena.serie~"    OP =~"=~"RIGHT=~"facturas_ingreso.serie~" )    JOIN (LEFT=~"facturas_cadena.numero~"    OP =~"=~"RIGHT=~"facturas_ingreso.contrato~" )WHERE(    EXP1 =~"~~~"FACTURAS_CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FACTURAS_CADENA~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FACTURAS_CADENA~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number) " arguments=(("base", string),("serie", string),("numero", number))  sort="facturas_ingreso_fecha_pago D facturas_ingreso_tipo_cob A facturas_ingreso_folio A facturas_ingreso_tipo_mov A " )
