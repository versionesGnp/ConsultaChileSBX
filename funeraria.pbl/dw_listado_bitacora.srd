 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cliente~" )  TABLE(NAME=~"producto_anexo~" )  TABLE(NAME=~"producto_beneficiario~" ) COLUMN(NAME=~"producto_anexo.base~") COLUMN(NAME=~"producto_anexo.serie~") COLUMN(NAME=~"producto_anexo.numero~") COLUMN(NAME=~"cliente.rut~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cliente.fono_p~") COLUMN(NAME=~"cliente.fono_c~") COLUMN(NAME=~"cliente.celular~") COLUMN(NAME=~"producto_beneficiario.rut~") COLUMN(NAME=~"producto_beneficiario.dv~") COLUMN(NAME=~"producto_beneficiario.nombre~") COLUMN(NAME=~"producto_beneficiario.a_paterno~") COLUMN(NAME=~"producto_beneficiario.a_materno~") COLUMN(NAME=~"producto_anexo.cod_agente~")    JOIN (LEFT=~"producto_anexo.base~"    OP =~"=~"RIGHT=~"producto_beneficiario.base~"    OUTER1 =~"producto_anexo.base~" )    JOIN (LEFT=~"producto_anexo.serie~"    OP =~"=~"RIGHT=~"producto_beneficiario.serie~"    OUTER1 =~"producto_anexo.serie~" )    JOIN (LEFT=~"producto_anexo.numero~"    OP =~"=~"RIGHT=~"producto_beneficiario.numero~"    OUTER1 =~"producto_anexo.numero~" )    JOIN (LEFT=~"cliente.rut~"    OP =~"=~"RIGHT=~"producto_anexo.rut~" )WHERE(    EXP1 =~"~~~"PRODUCTO_ANEXO~~~".~~~"FECHA_INGRESO~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"PRODUCTO_ANEXO~~~".~~~"FECHA_INGRESO~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"PRODUCTO_ANEXO~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~"'F'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"PRODUCTO_ANEXO~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~"'I')~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = date)  ARG(NAME = ~"fecha_fin~" TYPE = date) " arguments=(("fecha_ini", date),("fecha_fin", date))  sort="producto_anexo_base A producto_anexo_serie A producto_anexo_numero A " )
