table(column=(type=char(1) updatewhereclause=yes name=base dbname="revision_contratos.base" )
 column=(type=char(1) updatewhereclause=yes name=serie dbname="revision_contratos.serie" )
 column=(type=decimal(0) updatewhereclause=yes name=numero dbname="revision_contratos.numero" )
 column=(type=decimal(0) updatewhereclause=yes name=rut dbname="revision_contratos.rut" )
 column=(type=char(1) updatewhereclause=yes name=dv dbname="revision_contratos.dv" )
 column=(type=char(15) updatewhereclause=yes name=usuario_crea dbname="revision_contratos.usuario_crea" )
 column=(type=datetime updatewhereclause=yes name=fecha_crea dbname="revision_contratos.fecha_crea" )
 column=(type=char(1) updatewhereclause=yes name=estado_revision dbname="revision_contratos.estado_revision" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"revision_contratos~" ) COLUMN(NAME=~"revision_contratos.base~") COLUMN(NAME=~"revision_contratos.serie~") COLUMN(NAME=~"revision_contratos.numero~") COLUMN(NAME=~"revision_contratos.rut~") COLUMN(NAME=~"revision_contratos.dv~") COLUMN(NAME=~"revision_contratos.usuario_crea~") COLUMN(NAME=~"revision_contratos.fecha_crea~") COLUMN(NAME=~"revision_contratos.estado_revision~")WHERE(    EXP1 =~"~~~"REVISION_CONTRATOS~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"REVISION_CONTRATOS~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"REVISION_CONTRATOS~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"REVISION_CONTRATOS~~~".~~~"RUT~~~"~"   OP =~"=~"    EXP2 =~":rut~" ) ) ARG(NAME = ~"rut~" TYPE = number)  ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number) " arguments=(("rut", number),("base", string),("serie", string),("numero", number)) )
