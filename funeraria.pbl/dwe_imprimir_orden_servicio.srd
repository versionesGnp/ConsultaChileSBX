table(column=(type=char(1) updatewhereclause=yes name=base dbname="producto_beneficiario.base" )
 column=(type=char(1) updatewhereclause=yes name=serie dbname="producto_beneficiario.serie" )
 column=(type=decimal(4) updatewhereclause=yes name=numero dbname="producto_beneficiario.numero" )
 column=(type=decimal(4) updatewhereclause=yes name=rut dbname="producto_beneficiario.rut" )
 column=(type=char(1) updatewhereclause=yes name=dv dbname="producto_beneficiario.dv" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"producto_beneficiario~" ) COLUMN(NAME=~"producto_beneficiario.base~") COLUMN(NAME=~"producto_beneficiario.serie~") COLUMN(NAME=~"producto_beneficiario.numero~") COLUMN(NAME=~"producto_beneficiario.rut~") COLUMN(NAME=~"producto_beneficiario.dv~")WHERE(    EXP1 =~"~~~"PRODUCTO_BENEFICIARIO~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"PRODUCTO_BENEFICIARIO~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"PRODUCTO_BENEFICIARIO~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"PRODUCTO_BENEFICIARIO~~~".~~~"RUT~~~"~"   OP =~"=~"    EXP2 =~":rut~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number)  ARG(NAME = ~"rut~" TYPE = number) " arguments=(("base", string),("serie", string),("numero", number),("rut", number)) )
