_dia~") COLUMN(NAME=~"producto_pago.moneda~") COLUMN(NAME=~"producto_pago.fecha_pie~") COLUMN(NAME=~"producto_pago.fecha_prim~") COLUMN(NAME=~"producto_pago.fecha_ult~") COLUMN(NAME=~"producto_pago.codigo_servicio~") COLUMN(NAME=~"producto_anexo.forma_pago~") COLUMN(NAME=~"producto_pago.tasa~") COLUMN(NAME=~"producto_anexo.uso~") COLUMN(NAME=~"producto_anexo.porce_age~") COLUMN(NAME=~"producto_anexo.porce_sup~") COLUMN(NAME=~"producto_anexo.porce_jefe~") COLUMN(NAME=~"producto_pago.capacidad~") COLUMN(NAME=~"producto_anexo.tipo_beneficiarios~") COLUMN(NAME=~"cadena.estado_gestion_crematorio~") COLUMN(NAME=~"producto_pago.ctas_pie_plazo~") COLUMN(NAME=~"producto_pago.ctas_pie_pagadas~") COLUMN(NAME=~"producto_anexo.anexo_dacion~") COLUMN(NAME=~"producto_tipo_servicio.cantidad_fc~") COMPUTE(NAME=~"(SELECT COUNT(~~~"FC_CABECERA~~~".~~~"BASE~~~")  FROM ~~~"FC_CABECERA~~~" WHERE ( ~~~"FC_CABECERA~~~".~~~"BASE~~~" = 'G') AND ( ~~~"FC_CABECERA~~~".~~~"SERIE~~~" = :as_serie) AND ( ~~~"FC_CABECERA~~~".~~~"NUMERO~~~" = :an_numero ) AND ( ~~~"FC_CABECERA~~~".~~~"ESTADO_REG~~~" <> 'A' ) ) as contar_servicio~") COLUMN(NAME=~"producto_pago.precio_venta~") COMPUTE(NAME=~"0 as sw_activa_servicio_1~") COLUMN(NAME=~"revision_contratos.sw_activa_servicio~") COLUMN(NAME=~"cs_cabecera.base_original~") COLUMN(NAME=~"cs_cabecera.serie_original~") COLUMN(NAME=~"cs_cabecera.numero_original~") COMPUTE(NAME=~"(SELECT COUNT(~~~"CS_CABECERA~~~".~~~"BASE_ORIGINAL~~~") FROM ~~~"CS_CABECERA~~~"  WHERE ( ~~~"CS_CABECERA~~~".~~~"BASE_ORIGINAL~~~" = :as_base ) AND ( ~~~"CS_CABECERA~~~".~~~"SERIE_ORIGINAL~~~" = :as_serie ) AND ( ~~~"CS_CABECERA~~~".~~~"NUMERO_ORIGINAL~~~" = :an_numero ) ) as contar_ctto_ser~")    JOIN (LEFT=~"cadena.estado_carta~"    OP =~"=~"RIGHT=~"estado_envio.codigo_num~"    OUTER1 =~"cadena.estado_carta~" )    JOIN (LEFT=~"producto_anexo.rut~"    OP =~"=~"RIGHT=~"cliente.rut~"    OUTER1 =~"producto_anexo.rut~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"revision_contratos.base~"    OUTER1 =~"cadena.codigo~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"revision_contratos.serie~"    OUTER1 =~"cadena.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"revision_contratos.numero~"    OUTER1 =~"cadena.numero~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"cs_cabecera.base~"    OUTER1 =~"cadena.codigo~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"cs_cabecera.serie~"    OUTER1 =~"cadena.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"cs_cabecera.numero~"    OUTER1 =~"cadena.numero~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"cadena_mora.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"cadena_mora.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"cadena_mora.numero~" )    JOIN (LEFT=~"producto_anexo.base~"    OP =~"=~"RIGHT=~"cadena.codigo~" )    JOIN (LEFT=~"producto_anexo.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"producto_anexo.numero~"    OP =~"=~"RIGHT=~"cadena.numero~" )    JOIN (LEFT=~"producto_anexo.base~"    OP =~"=~"RIGHT=~"producto_pago.base~" )    JOIN (LEFT=~"producto_anexo.serie~"    OP =~"=~"RIGHT=~"producto_pago.serie~" )    JOIN (LEFT=~"producto_anexo.numero~"    OP =~"=~"RIGHT=~"producto_pago.numero~" )    JOIN (LEFT=~"producto_anexo.ult_folio~"    OP =~"=~"RIGHT=~"producto_pago.folio~" )    JOIN (LEFT=~"producto_pago.codigo_servicio~"    OP =~"=~"RIGHT=~"producto_tipo_servicio.codigo_servicio~" )    JOIN (LEFT=~"cadena.cod_parque~"    OP =~"=~"RIGHT=~"producto_tipo_servicio.cod_parque~" )    JOIN (LEFT=~"producto_pago.capacidad~"    OP =~"=~"RIGHT=~"producto_tipo_servicio.cantidad_fc~" )WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":as_serie~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":an_numero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~":as_base~" ) ) ARG(NAME = ~"as_serie~" TYPE = string)  ARG