 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"revision_contratos~" )  TABLE(NAME=~"producto_beneficiario~" ) COLUMN(NAME=~"producto_beneficiario.tipo_beneficiario~") COLUMN(NAME=~"producto_beneficiario.nombre~") COLUMN(NAME=~"producto_beneficiario.a_paterno~") COLUMN(NAME=~"producto_beneficiario.a_materno~") COLUMN(NAME=~"producto_beneficiario.rut~") COLUMN(NAME=~"producto_beneficiario.dv~") COLUMN(NAME=~"producto_beneficiario.fecha_nac~") COMPUTE(NAME=~" (SELECT	~~~"FALLECIDOS~~~".~~~"FEC_FALL~~~" FROM ~~~"FALLECIDOS~~~" WHERE ~~~"FALLECIDOS~~~".~~~"RUT~~~" = ~~~"PRODUCTO_BENEFICIARIO~~~".~~~"RUT~~~" AND ~~~"FALLECIDOS~~~".~~~"BASE~~~" = ~~~"PRODUCTO_BENEFICIARIO~~~".~~~"BASE~~~" AND ~~~"FALLECIDOS~~~".~~~"SS~~~" = ~~~"PRODUCTO_BENEFICIARIO~~~".~~~"SERIE~~~" AND ~~~"FALLECIDOS~~~".~~~"CONTRATO~~~" = ~~~"PRODUCTO_BENEFICIARIO~~~".~~~"NUMERO~~~") AS FECHA_DEFUNCION~") COLUMN(NAME=~"producto_beneficiario.parentesco~") COLUMN(NAME=~"producto_beneficiario.estado_civil~") COLUMN(NAME=~"producto_beneficiario.contacto_nombre~") COLUMN(NAME=~"producto_beneficiario.direccion_retiro~") COLUMN(NAME=~"producto_beneficiario.numero_retiro~") COLUMN(NAME=~"producto_beneficiario.comuna_retiro~") COLUMN(NAME=~"producto_beneficiario.ciudad_retiro~") COLUMN(NAME=~"producto_beneficiario.direccion_velatorio~") COLUMN(NAME=~"producto_beneficiario.numero_velatorio~") COLUMN(NAME=~"producto_beneficiario.comuna_velatorio~") COLUMN(NAME=~"producto_beneficiario.ciudad_velatorio~") COLUMN(NAME=~"producto_beneficiario.cementerio~") COLUMN(NAME=~"producto_beneficiario.contacto_fono_part~") COLUMN(NAME=~"producto_beneficiario.contacto_fono_celular~") COLUMN(NAME=~"producto_beneficiario.fecha_salida_velatorio~") COLUMN(NAME=~"producto_beneficiario.fecha_sepultacion~") COLUMN(NAME=~"producto_beneficiario.peso~") COLUMN(NAME=~"producto_beneficiario.estatura~") COMPUTE(NAME=~"( SELECT ~~~"COMUNA~~~".~~~"COMUNA~~~" FROM ~~~"COMUNA~~~" WHERE ~~~"COMUNA~~~".~~~"CODIGO_COMUNA~~~" = ~~~"PRODUCTO_BENEFICIARIO~~~".~~~"COMUNA_RETIRO~~~") AS COMUNA_RET~") COMPUTE(NAME=~"( SELECT ~~~"COMUNA~~~".~~~"COMUNA~~~" FROM ~~~"COMUNA~~~" WHERE ~~~"COMUNA~~~".~~~"CODIGO_COMUNA~~~" = ~~~"PRODUCTO_BENEFICIARIO~~~".~~~"COMUNA_VELATORIO~~~") AS COMUNA_VEL~") COMPUTE(NAME=~"(SELECT ~~~"CIUDAD~~~".~~~"SIGLA_CIUDAD~~~" FROM ~~~"CIUDAD~~~" WHERE ~~~"CIUDAD~~~".~~~"CODIGO_CIUDAD~~~" = ~~~"PRODUCTO_BENEFICIARIO~~~".~~~"CIUDAD_RETIRO~~~" ) AS CIUDAD_RET~") COMPUTE(NAME=~"(SELECT ~~~"CIUDAD~~~".~~~"SIGLA_CIUDAD~~~" FROM ~~~"CIUDAD~~~" WHERE ~~~"CIUDAD~~~".~~~"CODIGO_CIUDAD~~~" = ~~~"PRODUCTO_BENEFICIARIO~~~".~~~"CIUDAD_VELATORIO~~~" ) AS CIUDAD_VEL~") COLUMN(NAME=~"producto_beneficiario.nacionalidad~") COLUMN(NAME=~"producto_beneficiario.estado_cuerpo~")    JOIN (LEFT=~"revision_contratos.base~"    OP =~"=~"RIGHT=~"producto_beneficiario.base~" )    JOIN (LEFT=~"revision_contratos.serie~"    OP =~"=~"RIGHT=~"producto_beneficiario.serie~" )    JOIN (LEFT=~"revision_contratos.numero~"    OP =~"=~"RIGHT=~"producto_beneficiario.numero~" )WHERE(    EXP1 =~"~~~"REVISION_CONTRATOS~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"REVISION_CONTRATOS~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"REVISION_CONTRATOS~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"PRODUCTO_BENEFICIARIO~~~".~~~"RUT~~~"~"   OP =~"=~"    EXP2 =~":rut~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number)  ARG(NAME = ~"rut~" TYPE = number) " arguments=(("base", string),("serie", string),("numero", number),("rut", number)) )
