 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"producto_tipo_servicio_deta~" )  TABLE(NAME=~"producto_lista_precio~" ) COMPUTE(NAME=~"0 as marca~") COLUMN(NAME=~"producto_tipo_servicio_deta.codigo_detalle~") COLUMN(NAME=~"producto_tipo_servicio_deta.descripcion~") COLUMN(NAME=~"producto_tipo_servicio_deta.codigo_servicio~") COLUMN(NAME=~"producto_lista_precio.uso~") COLUMN(NAME=~"producto_lista_precio.moneda~") COMPUTE(NAME=~"(CASE WHEN ~~~"PRODUCTO_TIPO_SERVICIO_DETA~~~".~~~"CODIGO_DETALLE~~~" = 1 THEN ~~~"PRODUCTO_LISTA_PRECIO~~~".~~~"VALOR~~~" ELSE 0 END) AS VALOR~") COLUMN(NAME=~"producto_tipo_servicio_deta.estado_registro~")    JOIN (LEFT=~"producto_tipo_servicio_deta.codigo_servicio~"    OP =~"=~"RIGHT=~"producto_lista_precio.codigo_servicio~" )    JOIN (LEFT=~"producto_tipo_servicio_deta.uso~"    OP =~"=~"RIGHT=~"producto_lista_precio.uso~" )    JOIN (LEFT=~"producto_tipo_servicio_deta.moneda~"    OP =~"=~"RIGHT=~"producto_lista_precio.moneda~" )WHERE(    EXP1 =~"~~~"PRODUCTO_LISTA_PRECIO~~~".~~~"TIPO_BENEFICIARIO~~~"~"   OP =~"=~"    EXP2 =~":tipo_benef~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"PRODUCTO_LISTA_PRECIO~~~".~~~"CANTIDAD_BENEF~~~"~"   OP =~"=~"    EXP2 =~":cant_benef~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"PRODUCTO_TIPO_SERVICIO_DETA~~~".~~~"CODIGO_SERVICIO~~~"~"   OP =~"=~"    EXP2 =~":cod_servicio~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"PRODUCTO_LISTA_PRECIO~~~".~~~"USO~~~"~"   OP =~"=~"    EXP2 =~":uso~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"PRODUCTO_LISTA_PRECIO~~~".~~~"MONEDA~~~"~"   OP =~"=~"    EXP2 =~":moneda~" ) ) ARG(NAME = ~"tipo_benef~" TYPE = number)  ARG(NAME = ~"cant_benef~" TYPE = number)  ARG(NAME = ~"cod_servicio~" TYPE = number)  ARG(NAME = ~"uso~" TYPE = string)  ARG(NAME = ~"moneda~" TYPE = string) " arguments=(("tipo_benef", number),("cant_benef", number),("cod_servicio", number),("uso", string),("moneda", string)) )
