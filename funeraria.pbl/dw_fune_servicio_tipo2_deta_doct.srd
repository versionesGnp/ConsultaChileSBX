table(column=(type=char(2) updatewhereclause=yes name=documentos_cod_pago dbname="documentos.cod_pago" )
 column=(type=number updatewhereclause=yes name=cod_1 dbname="cod_1" values="	1/	0" )
 column=(type=number updatewhereclause=yes name=cod_2 dbname="cod_2" values="	1/	0" )
 column=(type=number updatewhereclause=yes name=cod_3 dbname="cod_3" values="	1/	0" )
 column=(type=number updatewhereclause=yes name=cod_4 dbname="cod_4" values="	1/	0" )
 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"cadena~" )  TABLE(NAME=~"ingreso~" )  TABLE(NAME=~"documentos~" ) COLUMN(NAME=~"documentos.cod_pago~") COMPUTE(NAME=~"(CASE WHEN ~~~"DOCUMENTOS~~~".~~~"COD_PAGO~~~" = 'EF' THEN 1 ELSE 0 END) AS COD_1~") COMPUTE(NAME=~"(CASE WHEN ~~~"DOCUMENTOS~~~".~~~"COD_PAGO~~~" = 'CH' THEN 1 ELSE 0 END) AS COD_2~") COMPUTE(NAME=~"(CASE WHEN ~~~"DOCUMENTOS~~~".~~~"COD_PAGO~~~" = 'TD' THEN 1 ELSE 0 END) AS COD_3~") COMPUTE(NAME=~"(CASE WHEN ~~~"DOCUMENTOS~~~".~~~"COD_PAGO~~~" = 'TC' THEN 1 ELSE 0 END) AS COD_4~")    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"ingreso.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"ingreso.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"ingreso.contrato~" )    JOIN (LEFT=~"ingreso.folio~"    OP =~"=~"RIGHT=~"documentos.folio~" )    JOIN (LEFT=~"ingreso.tipo_cob~"    OP =~"=~"RIGHT=~"documentos.tipo_cob~" )    JOIN (LEFT=~"ingreso.fecha_pago~"    OP =~"=~"RIGHT=~"documentos.fecha_pago~" )WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"INGRESO~~~".~~~"TIPO_MOV~~~"~"   OP =~"=~"    EXP2 =~"'L'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"TIPO_MOV~~~"~"   OP =~"=~"    EXP2 =~"'S')~" )  GROUP(NAME=~"documentos.cod_pago~")) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number) " arguments=(("base", string),("serie", string),("numero", number)) )
