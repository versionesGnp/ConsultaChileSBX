 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"producto_gestion_servicio~" )  TABLE(NAME=~"producto_estado_activa~" ) COLUMN(NAME=~"producto_gestion_servicio.base~") COLUMN(NAME=~"producto_gestion_servicio.serie~") COLUMN(NAME=~"producto_gestion_servicio.numero~") COLUMN(NAME=~"producto_gestion_servicio.codigo_servicio~") COLUMN(NAME=~"producto_gestion_servicio.correlativo~") COLUMN(NAME=~"producto_gestion_servicio.estado_registro~") COLUMN(NAME=~"producto_gestion_servicio.rut_beneficiario~") COLUMN(NAME=~"producto_gestion_servicio.dv_beneficiario~") COLUMN(NAME=~"producto_gestion_servicio.sw_activacion~") COLUMN(NAME=~"producto_gestion_servicio.fecha_activacion~") COLUMN(NAME=~"producto_gestion_servicio.usuario_activacion~") COLUMN(NAME=~"producto_estado_activa.descripcion~")    JOIN (LEFT=~"producto_gestion_servicio.sw_activacion~"    OP =~"=~"RIGHT=~"producto_estado_activa.estado_activa~"    OUTER1 =~"producto_gestion_servicio.sw_activacion~" )WHERE(    EXP1 =~"~~~"PRODUCTO_GESTION_SERVICIO~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"PRODUCTO_GESTION_SERVICIO~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"PRODUCTO_GESTION_SERVICIO~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number) " arguments=(("base", string),("serie", string),("numero", number))  sort="correlativo A " )
