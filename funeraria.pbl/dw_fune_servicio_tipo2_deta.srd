table(column=(type=char(1) updatewhereclause=yes name=cadena_codigo dbname="cadena.codigo" )
 column=(type=char(1) updatewhereclause=yes name=cadena_serie dbname="cadena.serie" )
 column=(type=decimal(4) updatewhereclause=yes name=cadena_numero dbname="cadena.numero" )
 column=(type=char(40) updatewhereclause=yes name=cuenta_contable_otros_descripcion dbname="cuenta_contable_otros.descripcion" )
 column=(type=decimal(4) updatewhereclause=yes name=ingreso_monto dbname="ingreso.monto" )
 column=(type=char(30) updatewhereclause=yes name=cod_movi_des_ing dbname="cod_movi.des_ing" )
 column=(type=char(2) updatewhereclause=yes name=ingreso_tipo_mov dbname="ingreso.tipo_mov" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cadena~" )  TABLE(NAME=~"ingreso~" )  TABLE(NAME=~"cuenta_contable_otros~" )  TABLE(NAME=~"cod_movi~" ) COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"cadena.serie~") COLUMN(NAME=~"cadena.numero~") COLUMN(NAME=~"cuenta_contable_otros.descripcion~") COLUMN(NAME=~"ingreso.monto~") COLUMN(NAME=~"cod_movi.des_ing~") COLUMN(NAME=~"ingreso.tipo_mov~")    JOIN (LEFT=~"ingreso.codigo_otro~"    OP =~"=~"RIGHT=~"cuenta_contable_otros.codigo_otros~"    OUTER1 =~"ingreso.codigo_otro~" )    JOIN (LEFT=~"ingreso.tipo_mov~"    OP =~"=~"RIGHT=~"cuenta_contable_otros.tipo_cob~"    OUTER1 =~"ingreso.tipo_mov~" )    JOIN (LEFT=~"ingreso.tipo_cob~"    OP =~"=~"RIGHT=~"cuenta_contable_otros.tipo_comprobante~"    OUTER1 =~"ingreso.tipo_cob~" )    JOIN (LEFT=~"ingreso.tipo_mov~"    OP =~"=~"RIGHT=~"cod_movi.cod_ing~"    OUTER1 =~"ingreso.tipo_mov~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"ingreso.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"ingreso.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"ingreso.contrato~" )WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number) " arguments=(("base", string),("serie", string),("numero", number)) )
