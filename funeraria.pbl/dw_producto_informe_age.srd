 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"vista_funeraria_informes~" ) COLUMN(NAME=~"vista_funeraria_informes.codigo~") COLUMN(NAME=~"vista_funeraria_informes.serie~") COLUMN(NAME=~"vista_funeraria_informes.numero~") COLUMN(NAME=~"vista_funeraria_informes.estado~") COLUMN(NAME=~"vista_funeraria_informes.rut~") COLUMN(NAME=~"vista_funeraria_informes.nombre~") COLUMN(NAME=~"vista_funeraria_informes.a_paterno~") COLUMN(NAME=~"vista_funeraria_informes.a_materno~") COLUMN(NAME=~"vista_funeraria_informes.cod_parque~") COLUMN(NAME=~"vista_funeraria_informes.cod_agente~") COLUMN(NAME=~"vista_funeraria_informes.cod_super~") COLUMN(NAME=~"vista_funeraria_informes.codigo_servicio~") COLUMN(NAME=~"vista_funeraria_informes.descripcion~") COLUMN(NAME=~"vista_funeraria_informes.precio~") COLUMN(NAME=~"vista_funeraria_informes.moneda~") COLUMN(NAME=~"vista_funeraria_informes.uf_dia~") COLUMN(NAME=~"vista_funeraria_informes.fecha~") COLUMN(NAME=~"vista_funeraria_informes.uso~") COLUMN(NAME=~"vista_funeraria_informes.sw_activa_servicio~") COMPUTE(NAME=~"1 as registos~") COLUMN(NAME=~"vista_funeraria_informes.valor_uf~") COLUMN(NAME=~"vista_funeraria_informes.valor_clp~") COMPUTE(NAME=~"(CASE WHEN ~~~"VISTA_FUNERARIA_INFORMES~~~".~~~"SW_ACTIVA_SERVICIO~~~" = 0 THEN 1 ELSE 0 END ) AS cod_0~") COMPUTE(NAME=~"(CASE WHEN ~~~"VISTA_FUNERARIA_INFORMES~~~".~~~"SW_ACTIVA_SERVICIO~~~" = 1 THEN 1 ELSE 0 END ) AS cod_1~") COMPUTE(NAME=~"(CASE WHEN ~~~"VISTA_FUNERARIA_INFORMES~~~".~~~"SW_ACTIVA_SERVICIO~~~" = 2 THEN 1 ELSE 0 END ) AS cod_2~")WHERE(    EXP1 =~"~~~"VISTA_FUNERARIA_INFORMES~~~".~~~"FECHA~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"VISTA_FUNERARIA_INFORMES~~~".~~~"FECHA~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = datetime)  ARG(NAME = ~"fecha_fin~" TYPE = datetime) " arguments=(("fecha_ini", datetime),("fecha_fin", datetime))  sort="cod_agente A codigo_servicio A " )
