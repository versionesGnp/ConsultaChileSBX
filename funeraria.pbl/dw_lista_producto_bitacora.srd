 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"vista_producto_lista_2~" ) COLUMN(NAME=~"vista_producto_lista_2.base~") COLUMN(NAME=~"vista_producto_lista_2.serie~") COLUMN(NAME=~"vista_producto_lista_2.numero~") COLUMN(NAME=~"vista_producto_lista_2.rut~") COLUMN(NAME=~"vista_producto_lista_2.dv~") COLUMN(NAME=~"vista_producto_lista_2.sw_activa_servicio~") COLUMN(NAME=~"vista_producto_lista_2.descripcion~") COLUMN(NAME=~"vista_producto_lista_2.folio_fa~") COLUMN(NAME=~"vista_producto_lista_2.fecha_activacion~") COLUMN(NAME=~"vista_producto_lista_2.precio~") COLUMN(NAME=~"vista_producto_lista_2.fecha_ingreso~") COLUMN(NAME=~"vista_producto_lista_2.parque~") COLUMN(NAME=~"vista_producto_lista_2.estado_revision~") COLUMN(NAME=~"vista_producto_lista_2.area~") COLUMN(NAME=~"vista_producto_lista_2.tipo_sepult~") COLUMN(NAME=~"vista_producto_lista_2.moneda~") COMPUTE(NAME=~"(SELECT DISTINCT PRODUCTO_INGRESO.TIPO_COB FROM PRODUCTO_INGRESO WHERE PRODUCTO_INGRESO.BASE =  (~~~"VISTA_PRODUCTO_LISTA_2~~~".~~~"BASE~~~") AND PRODUCTO_INGRESO.SERIE =  (~~~"VISTA_PRODUCTO_LISTA_2~~~".~~~"SERIE~~~") AND PRODUCTO_INGRESO.NUMERO =  (~~~"VISTA_PRODUCTO_LISTA_2~~~".~~~"NUMERO~~~") AND PRODUCTO_INGRESO.PAGO_HIST = 'A' AND PRODUCTO_INGRESO.TIPO_COB = 'FA') AS TIPO_FA~") COMPUTE(NAME=~"(SELECT DISTINCT PRODUCTO_INGRESO.TIPO_COB FROM PRODUCTO_INGRESO WHERE PRODUCTO_INGRESO.BASE =  (~~~"VISTA_PRODUCTO_LISTA_2~~~".~~~"BASE~~~") AND PRODUCTO_INGRESO.SERIE =  (~~~"VISTA_PRODUCTO_LISTA_2~~~".~~~"SERIE~~~") AND PRODUCTO_INGRESO.NUMERO =  (~~~"VISTA_PRODUCTO_LISTA_2~~~".~~~"NUMERO~~~") AND PRODUCTO_INGRESO.PAGO_HIST = 'A' AND PRODUCTO_INGRESO.TIPO_COB = 'CI') AS TIPO_CI~") COMPUTE(NAME=~"(SELECT DISTINCT PRODUCTO_INGRESO.FOLIO FROM PRODUCTO_INGRESO WHERE PRODUCTO_INGRESO.BASE = (~~~"VISTA_PRODUCTO_LISTA_2~~~".~~~"BASE~~~") AND PRODUCTO_INGRESO.SERIE = (~~~"VISTA_PRODUCTO_LISTA_2~~~".~~~"SERIE~~~") AND PRODUCTO_INGRESO.NUMERO = (~~~"VISTA_PRODUCTO_LISTA_2~~~".~~~"NUMERO~~~") AND PRODUCTO_INGRESO.PAGO_HIST = 'A' AND PRODUCTO_INGRESO.TIPO_COB = 'CI') AS TIPO_CI_FOLIO~") COLUMN(NAME=~"vista_producto_lista_2.tipo_beneficiarios~") COLUMN(NAME=~"vista_producto_lista_2.codigo_servicio~") COLUMN(NAME=~"vista_producto_lista_2.capacidad~") COLUMN(NAME=~"vista_producto_lista_2.uso~")WHERE(    EXP1 =~"~~~"VISTA_PRODUCTO_LISTA_2~~~".~~~"FECHA_INGRESO~~~"~"   OP =~">=~"    EXP2 =~":ls_fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"VISTA_PRODUCTO_LISTA_2~~~".~~~"FECHA_INGRESO~~~"~"   OP =~"<=~"    EXP2 =~":ls_fecha_fin~" ) ) ARG(NAME = ~"ls_fecha_ini~" TYPE = datetime)  ARG(NAME = ~"ls_fecha_fin~" TYPE = datetime) " arguments=(("ls_fecha_ini", datetime),("ls_fecha_fin", datetime))  sort="serie A numero A " )
