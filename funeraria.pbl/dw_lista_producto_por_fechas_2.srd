 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"vista_producto_lista_2~" ) COLUMN(NAME=~"vista_producto_lista_2.base~") COLUMN(NAME=~"vista_producto_lista_2.serie~") COLUMN(NAME=~"vista_producto_lista_2.numero~") COLUMN(NAME=~"vista_producto_lista_2.rut~") COLUMN(NAME=~"vista_producto_lista_2.dv~") COLUMN(NAME=~"vista_producto_lista_2.sw_activa_servicio~") COLUMN(NAME=~"vista_producto_lista_2.descripcion~") COLUMN(NAME=~"vista_producto_lista_2.folio_fa~") COLUMN(NAME=~"vista_producto_lista_2.fecha_activacion~") COLUMN(NAME=~"vista_producto_lista_2.precio~") COLUMN(NAME=~"vista_producto_lista_2.fecha_ingreso~") COLUMN(NAME=~"vista_producto_lista_2.parque~") COLUMN(NAME=~"vista_producto_lista_2.estado_revision~") COLUMN(NAME=~"vista_producto_lista_2.area~") COLUMN(NAME=~"vista_producto_lista_2.tipo_sepult~") COLUMN(NAME=~"vista_producto_lista_2.moneda~") COMPUTE(NAME=~"(SELECT DISTINCT PRODUCTO_INGRESO.TIPO_COB FROM PRODUCTO_INGRESO WHERE PRODUCTO_INGRESO.BASE =  (~~~"VISTA_PRODUCTO_LISTA_2~~~".~~~"BASE~~~") AND PRODUCTO_INGRESO.SERIE =  (~~~"VISTA_PRODUCTO_LISTA_2~~~".~~~"SERIE~~~") AND PRODUCTO_INGRESO.NUMERO =  (~~~"VISTA_PRODUCTO_LISTA_2~~~".~~~"NUMERO~~~") AND PRODUCTO_INGRESO.PAGO_HIST = 'A' AND PRODUCTO_INGRESO.TIPO_COB = 'FA') AS TIPO_FA~") COMPUTE(NAME=~"(SELECT DISTINCT PRODUCTO_INGRESO.TIPO_COB FROM PRODUCTO_INGRESO WHERE PRODUCTO_INGRESO.BASE =  (~~~"VISTA_PRODUCTO_LISTA_2~~~".~~~"BASE~~~") AND PRODUCTO_INGRESO.SERIE =  (~~~"VISTA_PRODUCTO_LISTA_2~~~".~~~"SERIE~~~") AND PRODUCTO_INGRESO.NUMERO =  (~~~"VISTA_PRODUCTO_LISTA_2~~~".~~~"NUMERO~~~") AND PRODUCTO_INGRESO.PAGO_HIST = 'A' AND PRODUCTO_INGRESO.TIPO_COB = 'CI') AS TIPO_CI~") COMPUTE(NAME=~"(SELECT DISTINCT MIN(PRODUCTO_INGRESO.FOLIO) FROM PRODUCTO_INGRESO WHERE PRODUCTO_INGRESO.BASE = (~~~"VISTA_PRODUCTO_LISTA_2~~~".~~~"BASE~~~") AND PRODUCTO_INGRESO.SERIE = (~~~"VISTA_PRODUCTO_LISTA_2~~~".~~~"SERIE~~~") AND PRODUCTO_INGRESO.NUMERO = (~~~"VISTA_PRODUCTO_LISTA_2~~~".~~~"NUMERO~~~") AND PRODUCTO_INGRESO.PAGO_HIST = 'A' AND PRODUCTO_INGRESO.TIPO_COB = 'CI') AS TIPO_CI_FOLIO~") COLUMN(NAME=~"vista_producto_lista_2.tipo_beneficiarios~") COLUMN(NAME=~"vista_producto_lista_2.codigo_servicio~") COLUMN(NAME=~"vista_producto_lista_2.capacidad~") COLUMN(NAME=~"vista_producto_lista_2.uso~") COLUMN(NAME=~"vista_producto_lista_2.correlativo~") COLUMN(NAME=~"vista_producto_lista_2.rut_beneficiario~") COLUMN(NAME=~"vista_producto_lista_2.dv_beneficiario~") COLUMN(NAME=~"vista_producto_lista_2.fecha_activa2~") COLUMN(NAME=~"vista_producto_lista_2.sw_activacion~") COLUMN(NAME=~"vista_producto_lista_2.quien_paga~") COLUMN(NAME=~"vista_producto_lista_2.tipo_cob_pago~") COLUMN(NAME=~"vista_producto_lista_2.folio_pago~") COLUMN(NAME=~"vista_producto_lista_2.fecha_pago~")WHERE(    EXP1 =~"~~~"VISTA_PRODUCTO_LISTA_2~~~".~~~"FECHA_INGRESO~~~"~"   OP =~">=~"    EXP2 =~":ls_fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"VISTA_PRODUCTO_LISTA_2~~~".~~~"FECHA_INGRESO~~~"~"   OP =~"<=~"    EXP2 =~":ls_fecha_fin~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"VISTA_PRODUCTO_LISTA_2~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":as_base~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"((~~~"VISTA_PRODUCTO_LISTA_2~~~".~~~"SW_ACTIVA_SERVICIO~~~"~"   OP =~"=~"    EXP2 =~"0~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"VISTA_PRODUCTO_LISTA_2~~~".~~~"SW_ACTIVA_SERVICIO~~~"~"   OP =~"=~"    EXP2 =~"2)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"VISTA_PRODUCTO_LISTA_2~~~".~~~"CORRELATIVO~~~"~"   OP =~"is~"    EXP2 =~"null))~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"((~~~"VISTA_PRODUCTO_LISTA_2~~~".~~~"SW_ACTIVACION~~~"~"   OP =~"=~"    EXP2 =~"0~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"VISTA_PRODUCTO_LISTA_2~~~".~~~"SW_ACTIVACION~~~"~"   OP =~"=~"    EXP2 =~"2~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"VISTA_PRODUCTO_LISTA_2~~~".~~~"SW_ACTIVA_SERVICIO~~~"~"   OP =~"=~"    EXP2 =~"0~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"VISTA_PRODUCTO_LISTA_2~~~".~~~"SW_ACTIVA_SERVICIO~~~"~"   OP =~"=~"    EXP2 =~"2)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"VISTA_PRODUCTO_LISTA_2~~~".~~~"CORRELATIVO~~~"~"   OP =~">=~"    EXP2 =~"1~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"VISTA_PRODUCTO_LISTA_2~~~".~~~"CAPACIDAD~~~"~"   OP =~">~"    EXP2 =~"1~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"VISTA_PRODUCTO_LISTA_2~~~".~~~"RUT_BENEFICIARIO~~~"~"   OP =~">~"    EXP2 =~"0)~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"(~~~"VISTA_PRODUCTO_LISTA_2~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":as_base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"VISTA_PRODUCTO_LISTA_2~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~"'G'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"(~~~"VISTA_PRODUCTO_LISTA_2~~~".~~~"SW_ACTIVA_SERVICIO~~~"~"   OP =~"=~"    EXP2 =~"0~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"VISTA_PRODUCTO_LISTA_2~~~".~~~"SW_ACTIVA_SERVICIO~~~"~"   OP =~"=~"    EXP2 =~"2))~" ) ) ARG(NAME = ~"ls_fecha_ini~" TYPE = datetime)  ARG(NAME = ~"ls_fecha_fin~" TYPE = datetime)  ARG(NAME = ~"as_base~" TYPE = string) " arguments=(("ls_fecha_ini", datetime),("ls_fecha_fin", datetime),("as_base", string))  sort="fecha_activacion A base A serie A numero A correlativo A " )
