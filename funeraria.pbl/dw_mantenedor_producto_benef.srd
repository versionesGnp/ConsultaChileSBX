~"producto_beneficiario.cementerio~") COLUMN(NAME=~"producto_beneficiario.contacto_fono_celular~") COLUMN(NAME=~"producto_beneficiario.fecha_salida_velatorio~") COLUMN(NAME=~"producto_beneficiario.fecha_sepultacion~") COLUMN(NAME=~"producto_beneficiario.contacto_fono_part~") COLUMN(NAME=~"producto_beneficiario.peso~") COLUMN(NAME=~"producto_beneficiario.estatura~") COLUMN(NAME=~"producto_beneficiario.estado_cuerpo~") COLUMN(NAME=~"producto_beneficiario.tanatopraxia~") COLUMN(NAME=~"producto_beneficiario.vehiculo_adicional~") COLUMN(NAME=~"producto_beneficiario.urna_largo~") COLUMN(NAME=~"producto_beneficiario.urna_ancho~") COLUMN(NAME=~"producto_beneficiario.urna_alto~") COLUMN(NAME=~"producto_beneficiario.urna_color~") COLUMN(NAME=~"producto_beneficiario.registro_civil_tram~") COLUMN(NAME=~"producto_beneficiario.certificado_medico~") COLUMN(NAME=~"producto_beneficiario.cap_cirios_natural~") COLUMN(NAME=~"producto_beneficiario.cap_cirios_electricos~") COLUMN(NAME=~"producto_beneficiario.cap_libro_condolencia~") COLUMN(NAME=~"producto_beneficiario.cap_cruz~") COLUMN(NAME=~"producto_beneficiario.cap_rozas_urna~") COLUMN(NAME=~"producto_beneficiario.cap_cinta_identifica~") COLUMN(NAME=~"producto_beneficiario.observacion~") COLUMN(NAME=~"producto_beneficiario.viaje_traslado~") COLUMN(NAME=~"producto_beneficiario.usuario_modif~") COLUMN(NAME=~"producto_beneficiario.fecha_modif~") COLUMN(NAME=~"producto_beneficiario.nacionalidad~") COMPUTE(NAME=~"'D1' as version~") COLUMN(NAME=~"producto_beneficiario.serv_adiciona_01~") COLUMN(NAME=~"producto_beneficiario.serv_adiciona_02~") COLUMN(NAME=~"producto_beneficiario.serv_adiciona_03~")WHERE(    EXP1 =~"~~~"PRODUCTO_BENEFICIARIO~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"PRODUCTO_BENEFICIARIO~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"PRODUCTO_BENEFICIARIO~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"PRODUCTO_BENEFICIARIO~~~".~~~"ESTADO_REG~~~"~"   OP =~"=~"    EXP2 =~"'V'~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number) " update="PRODUCTO_BENEFICIARIO" updatewhere=0 updatekeyinplace=yes arguments=(("base", string),("serie", string),("numero", number))  sort="folio A " )
