table(column=(type=decimal(4) updatewhereclause=yes name=producto_tipo_servicio_codigo_servicio dbname="producto_tipo_servicio.codigo_servicio" )
 column=(type=char(60) updatewhereclause=yes name=producto_tipo_servicio_descripcion dbname="producto_tipo_servicio.descripcion" )
 column=(type=number updatewhereclause=yes name=cod_01 dbname="cod_01" values="	1/	0" )
 column=(type=decimal(4) updatewhereclause=yes name=producto_pago_precio dbname="producto_pago.precio" )
 column=(type=char(1) updatewhereclause=yes name=cadena_codigo dbname="cadena.codigo" )
 column=(type=char(1) updatewhereclause=yes name=cadena_serie dbname="cadena.serie" )
 column=(type=decimal(4) updatewhereclause=yes name=cadena_numero dbname="cadena.numero" )
 column=(type=number updatewhereclause=yes name=serv dbname="serv" )
 column=(type=number updatewhereclause=yes name=anexo dbname="anexo" )
 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"cadena~" )  TABLE(NAME=~"producto_anexo~" )  TABLE(NAME=~"producto_pago~" )  TABLE(NAME=~"producto_tipo_servicio~" ) COLUMN(NAME=~"producto_tipo_servicio.codigo_servicio~") COLUMN(NAME=~"producto_tipo_servicio.descripcion~") COMPUTE(NAME=~"(CASE WHEN ~~~"PRODUCTO_TIPO_SERVICIO~~~".~~~"CODIGO_SERVICIO~~~" = 0 THEN 0 ELSE 1 END) as cod_01~") COLUMN(NAME=~"producto_pago.precio~") COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"cadena.serie~") COLUMN(NAME=~"cadena.numero~") COMPUTE(NAME=~"(SELECT SUM(~~~"PRODUCTO_VENTA_ASOCIADA~~~".~~~"VALOR_PRODUCTO~~~") FROM ~~~"PRODUCTO_VENTA_ASOCIADA~~~" WHERE ~~~"PRODUCTO_VENTA_ASOCIADA~~~".~~~"BASE~~~" = ~~~"CADENA~~~".~~~"CODIGO~~~" AND ~~~"PRODUCTO_VENTA_ASOCIADA~~~".~~~"SERIE~~~" = ~~~"CADENA~~~".~~~"SERIE~~~" AND ~~~"PRODUCTO_VENTA_ASOCIADA~~~".~~~"NUMERO~~~" = ~~~"CADENA~~~".~~~"NUMERO~~~" AND ~~~"PRODUCTO_VENTA_ASOCIADA~~~".~~~"COD_DETALLE~~~" = 1 AND ~~~"PRODUCTO_VENTA_ASOCIADA~~~".~~~"ESTADO~~~" = 'D' ) AS SERV~") COMPUTE(NAME=~"(SELECT SUM(~~~"PRODUCTO_VENTA_ASOCIADA~~~".~~~"VALOR_PRODUCTO~~~") FROM ~~~"PRODUCTO_VENTA_ASOCIADA~~~" WHERE ~~~"PRODUCTO_VENTA_ASOCIADA~~~".~~~"BASE~~~" = ~~~"CADENA~~~".~~~"CODIGO~~~" AND ~~~"PRODUCTO_VENTA_ASOCIADA~~~".~~~"SERIE~~~" = ~~~"CADENA~~~".~~~"SERIE~~~" AND ~~~"PRODUCTO_VENTA_ASOCIADA~~~".~~~"NUMERO~~~" = ~~~"CADENA~~~".~~~"NUMERO~~~" AND ~~~"PRODUCTO_VENTA_ASOCIADA~~~".~~~"COD_DETALLE~~~" > 100 AND ~~~"PRODUCTO_VENTA_ASOCIADA~~~".~~~"ESTADO~~~" = 'D' ) AS ANEXO~")    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"producto_anexo.base~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"producto_pago.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"producto_anexo.serie~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"producto_pago.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"producto_anexo.numero~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"producto_pago.numero~" )    JOIN (LEFT=~"producto_anexo.ult_folio~"    OP =~"=~"RIGHT=~"producto_pago.folio~" )    JOIN (LEFT=~"producto_pago.codigo_servicio~"    OP =~"=~"RIGHT=~"producto_tipo_servicio.codigo_servicio~" )WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number) " arguments=(("base", string),("serie", string),("numero", number)) )
