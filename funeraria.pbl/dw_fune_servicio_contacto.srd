 column=(type=char(90) updatewhereclause=yes name=ciudad_ciudad dbname="ciudad.ciudad" )
 column=(type=char(70) updatewhereclause=yes name=producto_beneficiario_contacto_nombre dbname="producto_beneficiario.contacto_nombre" )
 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"revision_contratos~" )  TABLE(NAME=~"producto_beneficiario~" )  TABLE(NAME=~"ciudad~" )  TABLE(NAME=~"comuna~" ) COLUMN(NAME=~"revision_contratos.base~") COLUMN(NAME=~"revision_contratos.serie~") COLUMN(NAME=~"revision_contratos.numero~") COLUMN(NAME=~"producto_beneficiario.direccion_velatorio~") COLUMN(NAME=~"producto_beneficiario.numero_velatorio~") COLUMN(NAME=~"producto_beneficiario.cementerio~") COLUMN(NAME=~"producto_beneficiario.contacto_fono_part~") COLUMN(NAME=~"producto_beneficiario.contacto_fono_celular~") COLUMN(NAME=~"producto_beneficiario.fecha_salida_velatorio~") COLUMN(NAME=~"producto_beneficiario.fecha_sepultacion~") COLUMN(NAME=~"producto_beneficiario.comuna_velatorio~") COLUMN(NAME=~"producto_beneficiario.ciudad_velatorio~") COLUMN(NAME=~"comuna.comuna~") COLUMN(NAME=~"ciudad.ciudad~") COLUMN(NAME=~"producto_beneficiario.contacto_nombre~")    JOIN (LEFT=~"revision_contratos.base~"    OP =~"=~"RIGHT=~"producto_beneficiario.base~" )    JOIN (LEFT=~"revision_contratos.serie~"    OP =~"=~"RIGHT=~"producto_beneficiario.serie~" )    JOIN (LEFT=~"revision_contratos.numero~"    OP =~"=~"RIGHT=~"producto_beneficiario.numero~" )    JOIN (LEFT=~"producto_beneficiario.comuna_velatorio~"    OP =~"=~"RIGHT=~"comuna.codigo_comuna~" )    JOIN (LEFT=~"producto_beneficiario.ciudad_velatorio~"    OP =~"=~"RIGHT=~"ciudad.codigo_ciudad~" )WHERE(    EXP1 =~"~~~"REVISION_CONTRATOS~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"REVISION_CONTRATOS~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"REVISION_CONTRATOS~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number) " arguments=(("base", string),("serie", string),("numero", number)) )
