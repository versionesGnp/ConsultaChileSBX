 column=(type=datetime updatewhereclause=yes name=producto_beneficiario_fecha_sepultacion dbname="producto_beneficiario.fecha_sepultacion" )
 column=(type=char(20) updatewhereclause=yes name=producto_beneficiario_comuna_velatorio dbname="producto_beneficiario.comuna_velatorio" )
 column=(type=char(15) updatewhereclause=yes name=producto_beneficiario_ciudad_velatorio dbname="producto_beneficiario.ciudad_velatorio" )
