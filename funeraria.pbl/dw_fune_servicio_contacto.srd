 column=(type=char(60) updatewhereclause=yes name=producto_beneficiario_direccion_velatorio dbname="producto_beneficiario.direccion_velatorio" )
 column=(type=char(15) updatewhereclause=yes name=producto_beneficiario_numero_velatorio dbname="producto_beneficiario.numero_velatorio" )
 column=(type=decimal(4) updatewhereclause=yes name=producto_beneficiario_cementerio dbname="producto_beneficiario.cementerio" )
 column=(type=char(25) updatewhereclause=yes name=producto_beneficiario_contacto_fono_part dbname="producto_beneficiario.contacto_fono_part" )
