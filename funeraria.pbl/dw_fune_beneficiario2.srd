 column=(type=char(40) updatewhereclause=yes name=producto_beneficiario_a_materno dbname="producto_beneficiario.a_materno" )
 column=(type=decimal(4) updatewhereclause=yes name=producto_beneficiario_rut dbname="producto_beneficiario.rut" )
 column=(type=char(1) updatewhereclause=yes name=producto_beneficiario_dv dbname="producto_beneficiario.dv" )
