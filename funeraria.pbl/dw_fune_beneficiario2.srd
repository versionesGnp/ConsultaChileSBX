table(column=(type=decimal(4) updatewhereclause=yes name=producto_beneficiario_tipo_beneficiario dbname="producto_beneficiario.tipo_beneficiario" )
 column=(type=char(40) updatewhereclause=yes name=producto_beneficiario_nombre dbname="producto_beneficiario.nombre" )
