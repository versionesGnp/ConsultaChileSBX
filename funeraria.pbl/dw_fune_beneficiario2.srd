 column=(type=datetime updatewhereclause=yes name=fecha_defuncion dbname="fecha_defuncion" )
 column=(type=char(30) updatewhereclause=yes name=producto_beneficiario_parentesco dbname="producto_beneficiario.parentesco" )
 column=(type=char(100) updatewhereclause=yes name=parentesco_parentesco dbname="parentesco.parentesco" )
 column=(type=char(200) updatewhereclause=yes name=codigo_estado_civil_descripcion dbname="codigo_estado_civil.descripcion" )
 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"revision_contratos~" )  TABLE(NAME=~"producto_beneficiario~" )  TABLE(NAME=~"parentesco~" )  TABLE(NAME=~"codigo_estado_civil~" ) COLUMN(NAME=~"producto_beneficiario.tipo_beneficiario~") COLUMN(NAME=~"producto_beneficiario.nombre~") COLUMN(NAME=~"producto_beneficiario.a_paterno~") COLUMN(NAME=~"producto_beneficiario.a_materno~") COLUMN(NAME=~"producto_beneficiario.rut~") COLUMN(NAME=~"producto_beneficiario.dv~") COLUMN(NAME=~"producto_beneficiario.fecha_nac~") COMPUTE(NAME=~" (SELECT	~~~"FALLECIDOS~~~".~~~"FEC_FALL~~~" FROM ~~~"FALLECIDOS~~~" WHERE ~~~"FALLECIDOS~~~".~~~"RUT~~~" = ~~~"PRODUCTO_BENEFICIARIO~~~".~~~"RUT~~~" AND ~~~"FALLECIDOS~~~".~~~"BASE~~~" = ~~~"PRODUCTO_BENEFICIARIO~~~".~~~"BASE~~~" AND ~~~"FALLECIDOS~~~".~~~"SS~~~" = ~~~"PRODUCTO_BENEFICIARIO~~~".~~~"SERIE~~~" AND ~~~"FALLECIDOS~~~".~~~"CONTRATO~~~" = ~~~"PRODUCTO_BENEFICIARIO~~~".~~~"NUMERO~~~") AS FECHA_DEFUNCION~") COLUMN(NAME=~"producto_beneficiario.parentesco~") COLUMN(NAME=~"parentesco.parentesco~") COLUMN(NAME=~"codigo_estado_civil.descripcion~")    JOIN (LEFT=~"revision_contratos.base~"    OP =~"=~"RIGHT=~"producto_beneficiario.base~" )    JOIN (LEFT=~"revision_contratos.serie~"    OP =~"=~"RIGHT=~"producto_beneficiario.serie~" )    JOIN (LEFT=~"revision_contratos.numero~"    OP =~"=~"RIGHT=~"producto_beneficiario.numero~" )    JOIN (LEFT=~"producto_beneficiario.parentesco~"    OP =~"=~"RIGHT=~"parentesco.codigo~" )    JOIN (LEFT=~"revision_contratos.cod_parque~"    OP =~"=~"RIGHT=~"parentesco.cod_parque~" )    JOIN (LEFT=~"producto_beneficiario.estado_civil~"    OP =~"=~"RIGHT=~"codigo_estado_civil.codigo_estado~" )WHERE(    EXP1 =~"~~~"REVISION_CONTRATOS~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"REVISION_CONTRATOS~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"REVISION_CONTRATOS~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"REVISION_CONTRATOS~~~".~~~"RUT~~~"~"   OP =~"=~"    EXP2 =~":rut~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number)  ARG(NAME = ~"rut~" TYPE = number) " arguments=(("base", string),("serie", string),("numero", number),("rut", number)) )
