event clicked;string	ls_uso,ls_est_valida,ls_string,ls_tipo_infor,ls_moneda
long	ll_tipo_benef,ll_cant_benef,ll_tipo_servicio,ll_cod_parque

SELECT	"PRODUCTO_ANEXO"."TIPO_BENEFICIARIOS",		"PRODUCTO_PAGO"."CAPACIDAD",	"PRODUCTO_PAGO"."CODIGO_SERVICIO",	"CADENA"."COD_PARQUE",	"PRODUCTO_ANEXO"."USO",	"PRODUCTO_PAGO"."MONEDA"
INTO		:ll_tipo_benef,												:ll_cant_benef,								:ll_tipo_servicio,									:ll_cod_parque,					:ls_uso ,								:ls_moneda
FROM		"CADENA","PRODUCTO_ANEXO","PRODUCTO_PAGO"  
WHERE	( "CADENA"."CODIGO" = "PRODUCTO_ANEXO"."BASE" ) and  
      		( "CADENA"."SERIE" = "PRODUCTO_ANEXO"."SERIE" ) and  
         	( "CADENA"."NUMERO" = "PRODUCTO_ANEXO"."NUMERO" ) and  
         	( "PRODUCTO_ANEXO"."BASE" = "PRODUCTO_PAGO"."BASE" ) and  
         	( "PRODUCTO_ANEXO"."SERIE" = "PRODUCTO_PAGO"."SERIE" ) and  
         	( "PRODUCTO_ANEXO"."NUMERO" = "PRODUCTO_PAGO"."NUMERO" ) and  
         	( "PRODUCTO_ANEXO"."ULT_FOLIO" = "PRODUCTO_PAGO"."FOLIO" ) and  
         	( ( "CADENA"."CODIGO" = :gs_base ) AND  
         	( "CADENA"."SERIE" = :gs_serie ) AND  
         	( "CADENA"."NUMERO" = :gi_numero ) )
USING	sqlca;
ls_est_valida						= 'D'
ls_tipo_infor							= 'O'
ls_string								= string(ll_tipo_benef)+'~t'+string(ll_cant_benef)+'~t'+string(ll_tipo_servicio)+'~t'+string(ll_cod_parque)+'~t'+gs_base+'~t'+gs_serie+'~t'+string(gi_numero)+'~t'+ls_uso+'~t'+ls_est_valida+'~t'+ls_tipo_infor+'~t'+ls_moneda
if not isnull(ll_tipo_benef) and not isnull(ll_cant_benef) and not isnull(ll_tipo_servicio) and ll_tipo_servicio>0 and not isnull(ll_cod_parque) and ll_cod_parque>0 and not isnull(ls_uso) and ls_uso<>'' and not isnull(ls_uso) and ls_uso<>'' then
	openwithparm(w_tipo_servicio_detalle,ls_string)
else
	messagebox("Advertencia","No Registra Producto Asociado")
end if
end event

