type m_contratoservicio from menu within m_menu_cuenta_corriente_funeraria
end type

event clicked;String		ls_string,ls_boton_reclamo,ls_area,ls_sector,ls_sepultura,ls_estado
long		ll_parque

gs_base					= w_cuenta_corriente_funeraria.dw_encabezado_cuenta_cte.GetItemString(1, 'cadena_codigo')
gs_serie					= w_cuenta_corriente_funeraria.dw_encabezado_cuenta_cte.GetItemString(1, 'producto_anexo_serie')
gi_numero				= w_cuenta_corriente_funeraria.dw_encabezado_cuenta_cte.GetItemNumber(1, 'producto_anexo_numero')
gi_rut 					= w_cuenta_corriente_funeraria.dw_encabezado_cuenta_cte.GetItemNumber(1, "cliente_rut")
gs_dv						= w_cuenta_corriente_funeraria.dw_encabezado_cuenta_cte.GetItemString(1, "cliente_dv")
ll_parque					= w_cuenta_corriente_funeraria.dw_encabezado_cuenta_cte.GetItemNumber(1, "cadena_cod_parque")
ls_estado				= w_cuenta_corriente_funeraria.dw_estado_cta_cte.getitemstring(1,'cadena_estado')
if gi_numero > 0 and not isnull(gs_base)  and (ls_estado = 'V' or ls_estado = 'C') then
	SELECT	"PAGO_OFERTA"."AREA",  	"PAGO_OFERTA"."SECTOR",  	"PAGO_OFERTA"."SEPULTURA"  
	INTO 		:ls_area,							:ls_sector,							:ls_sepultura  
	FROM 	"OFERTA_V",  	"PAGO_OFERTA"  
	WHERE 	( "OFERTA_V"."SERIE" = "PAGO_OFERTA"."SERIE" ) and  
				( "OFERTA_V"."NRO_OFERTA" = "PAGO_OFERTA"."NRO_OFERTA" ) and  
				( "OFERTA_V"."ULT_FOLIO" = "PAGO_OFERTA"."FOLIO" ) and  
				( "PAGO_OFERTA"."SERIE" = :gs_serie ) AND  
				( "PAGO_OFERTA"."NRO_OFERTA" = :gi_numero ) AND  
				( "PAGO_OFERTA"."BASE" = :gs_base )   ;
	ls_string		= gs_base +'~t'+ gs_serie +'~t'+ string(gi_numero)+'~t'+ string(gi_rut) +'~t'+ gs_dv +'~t'+string(ll_parque) +'~t'+ ls_area +'~t'+ ls_sector +'~t'+ ls_sepultura +'~t'+ 'V'
	if isvalid(w_crear_contrato_de_servicio_basev) then close(w_crear_contrato_de_servicio_basev)
	OpenWithParm (w_crear_contrato_de_servicio_basev,ls_string)
else
	if ls_estado <> 'V' and ls_estado = 'C' then
		messagebox('Advertencia','El Contrato debe estar V-Vigente o C-Pagado')
	end if	
end if
end event

