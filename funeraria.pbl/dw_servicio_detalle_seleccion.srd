 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"producto_tipo_servicio_deta~" ) COMPUTE(NAME=~"0 as marca~") COLUMN(NAME=~"producto_tipo_servicio_deta.codigo_detalle~") COLUMN(NAME=~"producto_tipo_servicio_deta.descripcion~") COLUMN(NAME=~"producto_tipo_servicio_deta.valor~") COLUMN(NAME=~"producto_tipo_servicio_deta.porce_descuento~") COLUMN(NAME=~"producto_tipo_servicio_deta.codigo_servicio~") COLUMN(NAME=~"producto_tipo_servicio_deta.moneda~") COLUMN(NAME=~"producto_tipo_servicio_deta.fecha_vigencia~") COLUMN(NAME=~"producto_tipo_servicio_deta.estado_registro~") COLUMN(NAME=~"producto_tipo_servicio_deta.uso~") COLUMN(NAME=~"producto_tipo_servicio_deta.derecho~")WHERE(    EXP1 =~"~~~"PRODUCTO_TIPO_SERVICIO_DETA~~~".~~~"CODIGO_SERVICIO~~~"~"   OP =~"=~"    EXP2 =~":cod_servicio~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"PRODUCTO_TIPO_SERVICIO_DETA~~~".~~~"USO~~~"~"   OP =~"=~"    EXP2 =~":uso~" ) ) ARG(NAME = ~"cod_servicio~" TYPE = number)  ARG(NAME = ~"uso~" TYPE = string) " update="PRODUCTO_TIPO_SERVICIO_DETA" updatewhere=0 updatekeyinplace=no arguments=(("cod_servicio", number),("uso", string)) )
