 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cliente~" )  TABLE(NAME=~"producto_anexo~" )  TABLE(NAME=~"producto_pago~" ) COLUMN(NAME=~"cliente.rut~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cliente.direccion_p~") COLUMN(NAME=~"cliente.comuna~") COLUMN(NAME=~"cliente.ciudad~") COLUMN(NAME=~"cliente.fono_p~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"cliente.estado_cobranza~") COLUMN(NAME=~"cliente.fecha_cobranza~") COLUMN(NAME=~"cliente.glosa_cobranza~") COLUMN(NAME=~"cliente.numero_particular~") COLUMN(NAME=~"cliente.depto_particular~") COLUMN(NAME=~"cliente.block_particular~") COLUMN(NAME=~"cliente.tipo_via~") COLUMN(NAME=~"producto_anexo.base~") COLUMN(NAME=~"producto_anexo.serie~") COLUMN(NAME=~"producto_anexo.numero~") COLUMN(NAME=~"producto_anexo.ult_folio~") COLUMN(NAME=~"producto_anexo.fecha_ingreso~") COLUMN(NAME=~"producto_anexo.cod_agente~") COLUMN(NAME=~"producto_anexo.cod_super~") COLUMN(NAME=~"producto_anexo.cod_jefe~") COLUMN(NAME=~"producto_anexo.estado_premio~") COLUMN(NAME=~"producto_anexo.u_folio~") COLUMN(NAME=~"producto_anexo.u_fecha~") COLUMN(NAME=~"producto_anexo.estatus_comision~") COLUMN(NAME=~"producto_anexo.estado_comi_sup~") COLUMN(NAME=~"producto_anexo.cierre_venta~") COLUMN(NAME=~"producto_anexo.cierre_venta_semanal~") COLUMN(NAME=~"producto_anexo.ingreso_sistema~") COLUMN(NAME=~"producto_pago.fecha~") COLUMN(NAME=~"producto_pago.precio~") COLUMN(NAME=~"producto_pago.pie~") COLUMN(NAME=~"producto_pago.tasa~") COLUMN(NAME=~"producto_pago.valor_cuota~") COLUMN(NAME=~"producto_pago.plazo~") COLUMN(NAME=~"producto_pago.uf_dia~") COLUMN(NAME=~"producto_pago.moneda~") COLUMN(NAME=~"producto_pago.fecha_prim~") COLUMN(NAME=~"producto_pago.fecha_ult~") COLUMN(NAME=~"producto_pago.fecha_pie~") COLUMN(NAME=~"producto_pago.gasto_adm~") COLUMN(NAME=~"producto_pago.tasa_base~") COLUMN(NAME=~"producto_anexo.estado_comi~") COLUMN(NAME=~"producto_pago.ctas_pie_plazo~") COLUMN(NAME=~"producto_pago.ctas_pie_pagadas~") COLUMN(NAME=~"producto_pago.fecha_pie_prim~") COLUMN(NAME=~"producto_pago.pie_pagado~") COLUMN(NAME=~"producto_pago.precio_venta~") COLUMN(NAME=~"producto_anexo.rut~")    JOIN (LEFT=~"producto_anexo.rut~"    OP =~"=~"RIGHT=~"cliente.rut~"    OUTER1 =~"producto_anexo.rut~" )    JOIN (LEFT=~"producto_anexo.base~"    OP =~"=~"RIGHT=~"producto_pago.base~" )    JOIN (LEFT=~"producto_anexo.serie~"    OP =~"=~"RIGHT=~"producto_pago.serie~" )    JOIN (LEFT=~"producto_anexo.numero~"    OP =~"=~"RIGHT=~"producto_pago.numero~" )    JOIN (LEFT=~"producto_anexo.ult_folio~"    OP =~"=~"RIGHT=~"producto_pago.folio~" )WHERE(    EXP1 =~"~~~"PRODUCTO_ANEXO~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":as_serie~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"PRODUCTO_ANEXO~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":an_numero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"PRODUCTO_ANEXO~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":as_base~" ) ) ARG(NAME = ~"as_serie~" TYPE = string)  ARG(NAME = ~"an_numero~" TYPE = number)  ARG(NAME = ~"as_base~" TYPE = string) " arguments=(("as_serie", string),("an_numero", number),("as_base", string)) )
