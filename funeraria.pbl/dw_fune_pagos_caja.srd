table(column=(type=char(1) updatewhereclause=yes name=producto_pago_moneda dbname="producto_pago.moneda" )
 column=(type=number updatewhereclause=yes name=clp dbname="clp" values="	1/	0" )
 column=(type=number updatewhereclause=yes name=uf dbname="uf" values="	1/	0" )
 column=(type=number updatewhereclause=yes name=ef dbname="ef" values="	1/	0" )
 column=(type=number updatewhereclause=yes name=ta dbname="ta" values="	1/	0" )
 column=(type=number updatewhereclause=yes name=ch dbname="ch" values="	1/	0" )
 column=(type=number updatewhereclause=yes name=tr dbname="tr" values="	1/	0" )
 column=(type=number updatewhereclause=yes name=monto dbname="monto" )
 column=(type=decimal(4) updatewhereclause=yes name=producto_pago_precio dbname="producto_pago.precio" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cadena~" )  TABLE(NAME=~"producto_anexo~" )  TABLE(NAME=~"producto_pago~" ) COLUMN(NAME=~"producto_pago.moneda~") COMPUTE(NAME=~"( CASE WHEN ~~~"PRODUCTO_PAGO~~~".~~~"MONEDA~~~" = '1' THEN 1 ELSE 0 END) as clp~") COMPUTE(NAME=~"( CASE WHEN ~~~"PRODUCTO_PAGO~~~".~~~"MONEDA~~~" = '2' THEN 1 ELSE 0 END)  as uf~") COMPUTE(NAME=~"(CASE WHEN (SELECT COUNT(~~~"DOCUMENTOS~~~".~~~"COD_PAGO~~~") FROM ~~~"DOCUMENTOS~~~",~~~"INGRESO~~~" WHERE ~~~"DOCUMENTOS~~~".~~~"FOLIO~~~" = ~~~"INGRESO~~~".~~~"FOLIO~~~" and ~~~"DOCUMENTOS~~~".~~~"TIPO_COB~~~" = ~~~"INGRESO~~~".~~~"TIPO_COB~~~" and ~~~"INGRESO~~~".~~~"PAGO_HIST~~~" = 'A' and ~~~"INGRESO~~~".~~~"BASE~~~" = ~~~"CADENA~~~".~~~"CODIGO~~~" and ~~~"INGRESO~~~".~~~"SERIE~~~"  = ~~~"CADENA~~~".~~~"SERIE~~~" and ~~~"INGRESO~~~".~~~"CONTRATO~~~" = ~~~"CADENA~~~".~~~"NUMERO~~~" and ~~~"DOCUMENTOS~~~".~~~"COD_PAGO~~~" = 'EF' ) > 0 THEN 1 ELSE 0 END) AS EF~") COMPUTE(NAME=~"(CASE WHEN (SELECT COUNT(~~~"DOCUMENTOS~~~".~~~"COD_PAGO~~~") FROM ~~~"DOCUMENTOS~~~",~~~"INGRESO~~~" WHERE ~~~"DOCUMENTOS~~~".~~~"FOLIO~~~" = ~~~"INGRESO~~~".~~~"FOLIO~~~" and ~~~"DOCUMENTOS~~~".~~~"TIPO_COB~~~" = ~~~"INGRESO~~~".~~~"TIPO_COB~~~" and ~~~"INGRESO~~~".~~~"PAGO_HIST~~~" = 'A' and ~~~"INGRESO~~~".~~~"BASE~~~" = ~~~"CADENA~~~".~~~"CODIGO~~~" and ~~~"INGRESO~~~".~~~"SERIE~~~"  = ~~~"CADENA~~~".~~~"SERIE~~~" and ~~~"INGRESO~~~".~~~"CONTRATO~~~" = ~~~"CADENA~~~".~~~"NUMERO~~~" and (~~~"DOCUMENTOS~~~".~~~"COD_PAGO~~~" = 'TC' OR ~~~"DOCUMENTOS~~~".~~~"COD_PAGO~~~" = 'TD')  ) > 0 THEN 1 ELSE 0 END) AS TA~") COMPUTE(NAME=~"(CASE WHEN (SELECT COUNT(~~~"DOCUMENTOS~~~".~~~"COD_PAGO~~~") FROM ~~~"DOCUMENTOS~~~",~~~"INGRESO~~~" WHERE ~~~"DOCUMENTOS~~~".~~~"FOLIO~~~" = ~~~"INGRESO~~~".~~~"FOLIO~~~" and ~~~"DOCUMENTOS~~~".~~~"TIPO_COB~~~" = ~~~"INGRESO~~~".~~~"TIPO_COB~~~" and ~~~"INGRESO~~~".~~~"PAGO_HIST~~~" = 'A' and ~~~"INGRESO~~~".~~~"BASE~~~" = ~~~"CADENA~~~".~~~"CODIGO~~~" and ~~~"INGRESO~~~".~~~"SERIE~~~"  = ~~~"CADENA~~~".~~~"SERIE~~~" and ~~~"INGRESO~~~".~~~"CONTRATO~~~" = ~~~"CADENA~~~".~~~"NUMERO~~~" and ~~~"DOCUMENTOS~~~".~~~"COD_PAGO~~~" = 'CH' ) > 0 THEN 1 ELSE 0 END) AS CH~") COMPUTE(NAME=~"0 AS TR~") COMPUTE(NAME=~"( SELECT SUM(~~~"INGRESO~~~".~~~"MONTO~~~") FROM ~~~"INGRESO~~~" WHERE ~~~"INGRESO~~~".~~~"PAGO_HIST~~~" = 'A' and ~~~"INGRESO~~~".~~~"BASE~~~" = ~~~"CADENA~~~".~~~"CODIGO~~~" and ~~~"INGRESO~~~".~~~"SERIE~~~"  = ~~~"CADENA~~~".~~~"SERIE~~~" and ~~~"INGRESO~~~".~~~"CONTRATO~~~" = ~~~"CADENA~~~".~~~"NUMERO~~~" ) AS MONTO~") COLUMN(NAME=~"producto_pago.precio~")    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"producto_anexo.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"producto_anexo.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"producto_anexo.numero~" )    JOIN (LEFT=~"producto_anexo.base~"    OP =~"=~"RIGHT=~"producto_pago.base~" )    JOIN (LEFT=~"producto_anexo.serie~"    OP =~"=~"RIGHT=~"producto_pago.serie~" )    JOIN (LEFT=~"producto_anexo.numero~"    OP =~"=~"RIGHT=~"producto_pago.numero~" )    JOIN (LEFT=~"producto_anexo.ult_folio~"    OP =~"=~"RIGHT=~"producto_pago.folio~" )WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number) " arguments=(("base", string),("serie", string),("numero", number)) )
text(band=detail alignment="0" text="  VI. ACTIVACION DEL SERVICIO" border="0" color="33554432" x="0" y="4" height="72" width="1070" html.valueishtml="0"  name=t_1 visible="1"  font.face="Tahoma" font.height="-10" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" background.transparency="0" background.gradient.color="8421504" background.gradient.transparency="0" background.gradient.angle="0" background.brushmode="0" background.gradient.repetition.mode="0" background.gradient.repetition.count="0" background.gradient.repetition.length="100" background.gradient.focus="0" background.gradient.scale="100" background.gradient.spread="100" tooltip.backcolor="134217752" tooltip.delay.initial="0" tooltip.delay.visible="32000" tooltip.enabled="0" tooltip.hasclosebutton="0" tooltip.icon="0" tooltip.isbubble="0" tooltip.maxwidth="0" tooltip.textcolor="134217751" tooltip.transparency="0" transparency="0" )
compute(band=detail alignment="3" expression="'Para realizar este proceso se requiere que el ~"CLIENTE~" tenga su servicio completamente pagado. EL CLIENTE deberá notificar la activación del servicio funerario entregando el numero de Orden de Venta individualizado en este documento y su número de RUT, llamando al teléfono 600 490 9000 o desde celulares al número * 5700 las 24 horas del día.'"border="0" color="0" x="123" y="124" height="224" width="2912" format="[GENERAL]" html.valueishtml="0"  name=compute_3 visible="1"  font.face="Tahoma" font.height="-9" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" background.transparency="0" background.gradient.color="8421504" background.gradient.transparency="0" background.gradient.angle="0" background.brushmode="0" background.gradient.repetition.mode="0" background.gradient.repetition.count="0" background.gradient.repetition.length="100" background.gradient.focus="0" background.gradient.scale="100" background.gradient.spread="100" tooltip.backcolor="134217752" tooltip.delay.initial="0" tooltip.delay.visible="32000" tooltip.enabled="0" tooltip.hasclosebutton="0" tooltip.icon="0" tooltip.isbubble="0" tooltip.maxwidth="0" tooltip.textcolor="134217751" tooltip.transparency="0" transparency="0" )
