table(column=(type=decimal(4) updatewhereclause=yes name=tasa_tasa_int_p dbname="tasa.tasa_int_p" dbalias="TASA_B.tasa_int_p" )
 column=(type=decimal(4) updatewhereclause=yes name=tasa_tasa_int_uf dbname="tasa.tasa_int_uf" dbalias="TASA_B.tasa_int_uf" )
