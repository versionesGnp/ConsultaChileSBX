 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"tasa~" ALIAS=~"tasa_a~" )  TABLE(NAME=~"tasa~" ALIAS=~"tasa_b~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"cadena_mora~" )  TABLE(NAME=~"producto_anexo~" )  TABLE(NAME=~"producto_pago~" ) COLUMN(NAME=~"tasa_b.tasa_int_p~") COLUMN(NAME=~"tasa_b.tasa_int_uf~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"cadena.cod_parque~") COLUMN(NAME=~"cadena.estado_carta~") COLUMN(NAME=~"cadena_mora.mora_cred~") COLUMN(NAME=~"cadena_mora.dias_mora_cred~") COLUMN(NAME=~"cadena_mora.fecha_venc_cred~") COLUMN(NAME=~"producto_anexo.serie~") COLUMN(NAME=~"producto_anexo.numero~") COLUMN(NAME=~"producto_anexo.total_pagado~") COLUMN(NAME=~"producto_anexo.cuotas_pag~") COLUMN(NAME=~"producto_pago.tasa~") COLUMN(NAME=~"producto_pago.valor_cuota~") COLUMN(NAME=~"producto_pago.plazo~") COLUMN(NAME=~"producto_pago.moneda~") COLUMN(NAME=~"producto_pago.fecha_prim~") COLUMN(NAME=~"producto_pago.fecha_ult~") COLUMN(NAME=~"producto_pago.pie~") COLUMN(NAME=~"producto_pago.pie_pagado~")    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"cadena_mora.serie~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"cadena_mora.base~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"cadena_mora.numero~" )    JOIN (LEFT=~"producto_anexo.base~"    OP =~"=~"RIGHT=~"producto_pago.base~" )    JOIN (LEFT=~"producto_anexo.serie~"    OP =~"=~"RIGHT=~"producto_pago.serie~" )    JOIN (LEFT=~"producto_anexo.numero~"    OP =~"=~"RIGHT=~"producto_pago.numero~" )    JOIN (LEFT=~"producto_anexo.ult_folio~"    OP =~"=~"RIGHT=~"producto_pago.folio~" )    JOIN (LEFT=~"producto_anexo.base~"    OP =~"=~"RIGHT=~"cadena.codigo~" )    JOIN (LEFT=~"producto_anexo.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"producto_anexo.numero~"    OP =~"=~"RIGHT=~"cadena.numero~" )WHERE(    EXP1 =~"~~~"PRODUCTO_ANEXO~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":as_serie~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"PRODUCTO_ANEXO~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":an_numero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'F'~" ) ) ARG(NAME = ~"as_serie~" TYPE = string)  ARG(NAME = ~"an_numero~" TYPE = number)  ARG(NAME = ~"uf_dia~" TYPE = number) " arguments=(("as_serie", string),("an_numero", number),("uf_dia", number)) )
