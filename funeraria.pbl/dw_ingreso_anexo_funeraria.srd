a~") COLUMN(NAME=~"producto_pago.valor_cuota~") COLUMN(NAME=~"producto_pago.plazo~") COLUMN(NAME=~"producto_pago.uf_dia~") COLUMN(NAME=~"producto_pago.moneda~") COLUMN(NAME=~"producto_pago.fecha_prim~") COLUMN(NAME=~"producto_pago.fecha_ult~") COLUMN(NAME=~"producto_pago.fecha_pie~") COLUMN(NAME=~"producto_pago.gasto_adm~") COLUMN(NAME=~"producto_pago.ctas_pie_plazo~") COLUMN(NAME=~"producto_pago.ctas_pie_pagadas~") COLUMN(NAME=~"producto_pago.codigo_servicio~") COLUMN(NAME=~"producto_pago.fecha_pie_prim~") COLUMN(NAME=~"producto_pago.usuario_crea~") COLUMN(NAME=~"cadena.cod_parque~") COLUMN(NAME=~"producto_anexo.nro_resc~") COLUMN(NAME=~"producto_pago.tasa_base~") COMPUTE(NAME=~"0 as estado_rut~") COMPUTE(NAME=~"0 as estado_contrato~") COLUMN(NAME=~"producto_anexo.tipo_beneficiarios~") COLUMN(NAME=~"producto_anexo.clasifica_venta~") COLUMN(NAME=~"producto_anexo.tipo_venta~") COLUMN(NAME=~"producto_pago.fecha_entre~") COLUMN(NAME=~"producto_pago.der_esp~") COLUMN(NAME=~"producto_pago.capacidad~") COLUMN(NAME=~"producto_anexo.estado_comi_jef~") COMPUTE(NAME=~"0 as valor_cuota_iva~") COMPUTE(NAME=~"0 as iva_pie~") COMPUTE(NAME=~"0.0 as valor_iva~") COMPUTE(NAME=~"0.0 as cuota_seguros~") COLUMN(NAME=~"producto_anexo.anexo_dacion~") COLUMN(NAME=~"producto_pago.precio_venta~") COLUMN(NAME=~"producto_pago.tasa_interes_cuota~") COMPUTE(NAME=~"'' as modifica~")    JOIN (LEFT=~"producto_anexo.base~"    OP =~"=~"RIGHT=~"producto_pago.base~" )    JOIN (LEFT=~"producto_anexo.serie~"    OP =~"=~"RIGHT=~"producto_pago.serie~" )    JOIN (LEFT=~"producto_anexo.numero~"    OP =~"=~"RIGHT=~"producto_pago.numero~" )    JOIN (LEFT=~"producto_anexo.ult_folio~"    OP =~"=~"RIGHT=~"producto_pago.folio~" )    JOIN (LEFT=~"producto_pago.base~"    OP =~"=~"RIGHT=~"cadena.codigo~" )    JOIN (LEFT=~"producto_pago.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"producto_pago.numero~"    OP =~"=~"RIGHT=~"cadena.numero~" )WHERE(    EXP1 =~"( ( ~~~"PRODUCTO_ANEXO~~~".~~~"BASE~~~"~"   