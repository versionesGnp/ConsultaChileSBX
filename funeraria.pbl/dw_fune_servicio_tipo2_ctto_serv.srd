table(column=(type=decimal(4) updatewhereclause=yes name=producto_pago_precio dbname="producto_pago.precio" )
 column=(type=char(1) updatewhereclause=yes name=cadena_codigo dbname="cadena.codigo" )
 column=(type=char(1) updatewhereclause=yes name=cadena_serie dbname="cadena.serie" )
 column=(type=decimal(4) updatewhereclause=yes name=cadena_numero dbname="cadena.numero" )
 column=(type=char(5) updatewhereclause=yes name=cs_detalle_pagos_codigo_otro dbname="cs_detalle_pagos.codigo_otro" )
 column=(type=char(1) updatewhereclause=yes name=cs_detalle_pagos_moneda dbname="cs_detalle_pagos.moneda" )
 column=(type=decimal(4) updatewhereclause=yes name=cs_detalle_pagos_monto dbname="cs_detalle_pagos.monto" )
 column=(type=decimal(4) updatewhereclause=yes name=cs_detalle_pagos_monto_peso dbname="cs_detalle_pagos.monto_peso" )
 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"cadena~" )  TABLE(NAME=~"producto_anexo~" )  TABLE(NAME=~"producto_pago~" )  TABLE(NAME=~"cs_cabecera~" )  TABLE(NAME=~"cs_detalle_pagos~" ) COLUMN(NAME=~"producto_pago.precio~") COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"cadena.serie~") COLUMN(NAME=~"cadena.numero~") COLUMN(NAME=~"cs_detalle_pagos.codigo_otro~") COLUMN(NAME=~"cs_detalle_pagos.moneda~") COLUMN(NAME=~"cs_detalle_pagos.monto~") COLUMN(NAME=~"cs_detalle_pagos.monto_peso~")    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"producto_anexo.base~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"producto_pago.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"producto_anexo.serie~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"producto_pago.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"producto_anexo.numero~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"producto_pago.numero~" )    JOIN (LEFT=~"producto_anexo.ult_folio~"    OP =~"=~"RIGHT=~"producto_pago.folio~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"cs_cabecera.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"cs_cabecera.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"cs_cabecera.numero~" )    JOIN (LEFT=~"cs_cabecera.base~"    OP =~"=~"RIGHT=~"cs_detalle_pagos.base~" )    JOIN (LEFT=~"cs_cabecera.serie~"    OP =~"=~"RIGHT=~"cs_detalle_pagos.serie~" )    JOIN (LEFT=~"cs_cabecera.numero~"    OP =~"=~"RIGHT=~"cs_detalle_pagos.numero~" )WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number) " arguments=(("base", string),("serie", string),("numero", number)) )
