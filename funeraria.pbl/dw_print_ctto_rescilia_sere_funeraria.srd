 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"sol_estatus~" )  TABLE(NAME=~"sol_rescilia_cliente~" ) COLUMN(NAME=~"sol_rescilia_cliente.rut_titular~") COLUMN(NAME=~"sol_rescilia_cliente.dv~") COLUMN(NAME=~"sol_rescilia_cliente.nombre~") COLUMN(NAME=~"sol_rescilia_cliente.ap_paterno~") COLUMN(NAME=~"sol_rescilia_cliente.ap_materno~") COLUMN(NAME=~"sol_rescilia_cliente.area_sepultura~") COLUMN(NAME=~"sol_rescilia_cliente.sepultura~") COLUMN(NAME=~"sol_rescilia_cliente.capacidad~") COLUMN(NAME=~"sol_rescilia_cliente.base~") COLUMN(NAME=~"sol_rescilia_cliente.serie~") COLUMN(NAME=~"sol_rescilia_cliente.numero~") COLUMN(NAME=~"sol_rescilia_cliente.correlativo~") COLUMN(NAME=~"sol_rescilia_cliente.fecha_contrato~") COLUMN(NAME=~"sol_rescilia_cliente.sector_sepultura~")    JOIN (LEFT=~"sol_estatus.base~"    OP =~"=~"RIGHT=~"sol_rescilia_cliente.base~" )    JOIN (LEFT=~"sol_estatus.serie~"    OP =~"=~"RIGHT=~"sol_rescilia_cliente.serie~" )    JOIN (LEFT=~"sol_estatus.numero~"    OP =~"=~"RIGHT=~"sol_rescilia_cliente.numero~" )    JOIN (LEFT=~"sol_estatus.correlativo~"    OP =~"=~"RIGHT=~"sol_rescilia_cliente.correlativo~" )WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"CORRELATIVO~~~"~"   OP =~"=~"    EXP2 =~":corr~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number)  ARG(NAME = ~"corr~" TYPE = number) " arguments=(("base", string),("serie", string),("numero", number),("corr", number)) )
