 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"producto_bitacora~" ) COLUMN(NAME=~"producto_bitacora.base~") COLUMN(NAME=~"producto_bitacora.serie~") COLUMN(NAME=~"producto_bitacora.dv_titular~") COLUMN(NAME=~"producto_bitacora.orden_compra~") COLUMN(NAME=~"producto_bitacora.codigo_vendedor~") COLUMN(NAME=~"producto_bitacora.telefono_titular~") COLUMN(NAME=~"producto_bitacora.nombre_titular~") COLUMN(NAME=~"producto_bitacora.ap_pat_titular~") COLUMN(NAME=~"producto_bitacora.ap_mat_titular~") COLUMN(NAME=~"producto_bitacora.nombre_fallecido~") COLUMN(NAME=~"producto_bitacora.ap_pat_fallecido~") COLUMN(NAME=~"producto_bitacora.ap_mat_fallecido~") COLUMN(NAME=~"producto_bitacora.funeraria~") COLUMN(NAME=~"producto_bitacora.rut_fallecido~") COLUMN(NAME=~"producto_bitacora.dv_fallecido~") COLUMN(NAME=~"producto_bitacora.coordinador_np~") COLUMN(NAME=~"producto_bitacora.numero~") COLUMN(NAME=~"producto_bitacora.rut_titular~")WHERE(    EXP1 =~"~~~"PRODUCTO_BITACORA~~~".~~~"RUT_TITULAR~~~"~"   OP =~"=~"    EXP2 =~":rut_cliente ~" ) ) ARG(NAME = ~"rut_cliente~" TYPE = number) " update="PRODUCTO_BITACORA" updatewhere=0 updatekeyinplace=yes arguments=(("rut_cliente", number)) )
