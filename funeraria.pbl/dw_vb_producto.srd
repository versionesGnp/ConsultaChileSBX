table(column=(type=char(1) updatewhereclause=yes name=producto_anexo_base dbname="producto_anexo.base" dbalias=".base" )
 column=(type=char(1) updatewhereclause=yes name=producto_anexo_serie dbname="producto_anexo.serie" dbalias=".serie" )
 column=(type=decimal(4) updatewhereclause=yes name=producto_anexo_numero dbname="producto_anexo.numero" dbalias=".numero" )
 column=(type=char(1) updatewhereclause=yes name=cliente_dv dbname="cliente.dv" dbalias=".dv" )
 column=(type=number updatewhereclause=yes name=precio_fact dbname="precio_fact" )
 column=(type=decimal(4) updatewhereclause=yes name=cliente_rut dbname="cliente.rut" dbalias=".rut" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cadena~" )  TABLE(NAME=~"cliente~" )  TABLE(NAME=~"producto_anexo~" )  TABLE(NAME=~"producto_pago~" ) COLUMN(NAME=~"producto_anexo.base~") COLUMN(NAME=~"producto_anexo.serie~") COLUMN(NAME=~"producto_anexo.numero~") COLUMN(NAME=~"cliente.dv~") COMPUTE(NAME=~"(~~~"PRODUCTO_PAGO~~~".~~~"PLAZO~~~"*~~~"PRODUCTO_PAGO~~~".~~~"VALOR_CUOTA~~~")+~~~"PRODUCTO_PAGO~~~".~~~"PIE~~~" as precio_fact~") COLUMN(NAME=~"cliente.rut~")    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"producto_anexo.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"producto_anexo.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"producto_anexo.numero~" )    JOIN (LEFT=~"producto_anexo.base~"    OP =~"=~"RIGHT=~"producto_pago.base~" )    JOIN (LEFT=~"producto_anexo.serie~"    OP =~"=~"RIGHT=~"producto_pago.serie~" )    JOIN (LEFT=~"producto_anexo.numero~"    OP =~"=~"RIGHT=~"producto_pago.numero~" )    JOIN (LEFT=~"producto_anexo.ult_folio~"    OP =~"=~"RIGHT=~"producto_pago.folio~" )    JOIN (LEFT=~"producto_anexo.rut~"    OP =~"=~"RIGHT=~"cliente.rut~" )WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number) " arguments=(("base", string),("serie", string),("numero", number)) )
