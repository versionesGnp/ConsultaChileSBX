 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"cliente~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"cadena_mora~" )  TABLE(NAME=~"producto_anexo~" )  TABLE(NAME=~"producto_pago~" )  TABLE(NAME=~"producto_tipo_servicio~" ) COLUMN(NAME=~"cliente.rut~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cliente.direccion_p~") COLUMN(NAME=~"cliente.comuna~") COLUMN(NAME=~"cliente.ciudad~") COMPUTE(NAME=~"1~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"cadena_mora.mora_cred_pie~") COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"producto_anexo.serie~") COLUMN(NAME=~"producto_anexo.numero~") COLUMN(NAME=~"producto_anexo.uso~") COLUMN(NAME=~"producto_anexo.cuotas_pag~") COLUMN(NAME=~"producto_anexo.total_pagado~") COLUMN(NAME=~"producto_anexo.fecha_ingreso~") COLUMN(NAME=~"producto_anexo.forma_pago~") COLUMN(NAME=~"producto_anexo.cod_agente~") COLUMN(NAME=~"producto_anexo.cod_super~") COLUMN(NAME=~"producto_anexo.cod_jefe~") COLUMN(NAME=~"producto_pago.fecha~") COLUMN(NAME=~"producto_anexo.ingreso_sistema~") COLUMN(NAME=~"producto_pago.precio~") COLUMN(NAME=~"producto_pago.pie~") COLUMN(NAME=~"producto_pago.valor_cuota~") COLUMN(NAME=~"producto_pago.plazo~") COLUMN(NAME=~"producto_pago.moneda~") COLUMN(NAME=~"producto_pago.fecha_prim~") COLUMN(NAME=~"producto_pago.fecha_ult~") COLUMN(NAME=~"producto_pago.fecha_pie~") COLUMN(NAME=~"producto_pago.ctas_pie_plazo~") COLUMN(NAME=~"producto_pago.ctas_pie_pagadas~") COLUMN(NAME=~"producto_anexo.tipo_beneficiarios~") COLUMN(NAME=~"producto_pago.codigo_servicio~") COLUMN(NAME=~"producto_pago.capacidad~") COLUMN(NAME=~"producto_tipo_servicio.cantidad_fc~") COMPUTE(NAME=~"(SELECT COUNT(~~~"FC_CABECERA~~~".~~~"BASE~~~")  FROM ~~~"FC_CABECERA~~~" WHERE ( ~~~"FC_CABECERA~~~".~~~"BASE~~~" = :as_base ) AND ( ~~~"FC_CABECERA~~~".~~~"SERIE~~~" = :as_serie) AND ( ~~~"FC_CABECERA~~~".~~~"NUMERO~~~" = :an_numero ) AND ( ~~~"FC_CABECERA~~~".~~~"ESTADO_REG~~~" <> 'A' ) ) as contar_servicio~")    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"cadena_mora.serie~"    OUTER1 =~"cadena.serie~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"cadena_mora.base~"    OUTER1 =~"cadena.codigo~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"cadena_mora.numero~"    OUTER1 =~"cadena.numero~" )    JOIN (LEFT=~"producto_anexo.base~"    OP =~"=~"RIGHT=~"producto_pago.base~" )    JOIN (LEFT=~"producto_anexo.serie~"    OP =~"=~"RIGHT=~"producto_pago.serie~" )    JOIN (LEFT=~"producto_anexo.numero~"    OP =~"=~"RIGHT=~"producto_pago.numero~" )    JOIN (LEFT=~"producto_anexo.ult_folio~"    OP =~"=~"RIGHT=~"producto_pago.folio~" )    JOIN (LEFT=~"producto_anexo.rut~"    OP =~"=~"RIGHT=~"cliente.rut~" )    JOIN (LEFT=~"producto_pago.base~"    OP =~"=~"RIGHT=~"cadena.codigo~" )    JOIN (LEFT=~"producto_pago.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"producto_pago.numero~"    OP =~"=~"RIGHT=~"cadena.numero~" )    JOIN (LEFT=~"producto_pago.codigo_servicio~"    OP =~"=~"RIGHT=~"producto_tipo_servicio.codigo_servicio~" )WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~":as_base~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":as_serie~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":an_numero~" ) ) ARG(NAME = ~"as_base~" TYPE = string)  ARG(NAME = ~"as_serie~" TYPE = string)  ARG(NAME = ~"an_numero~" TYPE = number) " arguments=(("as_base", string),("as_serie", string),("an_numero", number)) )
