 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"revision_contratos~" )  TABLE(NAME=~"producto_tipo_servicio~" )  TABLE(NAME=~"producto_beneficiario~" ) COLUMN(NAME=~"revision_contratos.codigo_servicio~") COMPUTE(NAME=~"(0) as cod_01~") COLUMN(NAME=~"producto_tipo_servicio.descripcion~") COLUMN(NAME=~"producto_beneficiario.viaje_traslado~") COLUMN(NAME=~"producto_beneficiario.tanatopraxia~") COLUMN(NAME=~"producto_beneficiario.vehiculo_adicional~") COLUMN(NAME=~"producto_beneficiario.urna_largo~") COLUMN(NAME=~"producto_beneficiario.urna_ancho~") COLUMN(NAME=~"producto_beneficiario.urna_alto~") COLUMN(NAME=~"producto_beneficiario.urna_color~") COLUMN(NAME=~"producto_beneficiario.registro_civil_tram~") COLUMN(NAME=~"producto_beneficiario.certificado_medico~") COLUMN(NAME=~"producto_beneficiario.cap_cirios_natural~") COLUMN(NAME=~"producto_beneficiario.cap_cirios_electricos~") COLUMN(NAME=~"producto_beneficiario.cap_libro_condolencia~") COLUMN(NAME=~"producto_beneficiario.cap_cruz~") COLUMN(NAME=~"producto_beneficiario.cap_rozas_urna~") COLUMN(NAME=~"producto_beneficiario.cap_cinta_identifica~") COLUMN(NAME=~"producto_beneficiario.observacion~") COLUMN(NAME=~"producto_beneficiario.serv_adiciona_01~") COLUMN(NAME=~"producto_beneficiario.serv_adiciona_02~") COLUMN(NAME=~"producto_beneficiario.serv_adiciona_03~")    JOIN (LEFT=~"revision_contratos.codigo_servicio~"    OP =~"=~"RIGHT=~"producto_tipo_servicio.codigo_servicio~" )    JOIN (LEFT=~"revision_contratos.base~"    OP =~"=~"RIGHT=~"producto_beneficiario.base~" )    JOIN (LEFT=~"revision_contratos.serie~"    OP =~"=~"RIGHT=~"producto_beneficiario.serie~" )    JOIN (LEFT=~"revision_contratos.numero~"    OP =~"=~"RIGHT=~"producto_beneficiario.numero~" )WHERE(    EXP1 =~"~~~"REVISION_CONTRATOS~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"REVISION_CONTRATOS~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"REVISION_CONTRATOS~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"PRODUCTO_BENEFICIARIO~~~".~~~"RUT~~~"~"   OP =~"=~"    EXP2 =~":rut~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number)  ARG(NAME = ~"rut~" TYPE = number) " arguments=(("base", string),("serie", string),("numero", number),("rut", number)) )
