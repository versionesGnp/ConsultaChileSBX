 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"vista_funeraria_informes~" )  TABLE(NAME=~"estado~" )  TABLE(NAME=~"agentes~" )  TABLE(NAME=~"cod_parq~" )  TABLE(NAME=~"supervisor~" ) COLUMN(NAME=~"vista_funeraria_informes.codigo~") COLUMN(NAME=~"vista_funeraria_informes.serie~") COLUMN(NAME=~"vista_funeraria_informes.numero~") COLUMN(NAME=~"vista_funeraria_informes.estado~") COLUMN(NAME=~"estado.sigla_estado~") COLUMN(NAME=~"vista_funeraria_informes.rut~") COLUMN(NAME=~"vista_funeraria_informes.nombre~") COLUMN(NAME=~"vista_funeraria_informes.a_paterno~") COLUMN(NAME=~"vista_funeraria_informes.a_materno~") COLUMN(NAME=~"vista_funeraria_informes.cod_parque~") COLUMN(NAME=~"vista_funeraria_informes.cod_agente~") COLUMN(NAME=~"vista_funeraria_informes.cod_super~") COLUMN(NAME=~"vista_funeraria_informes.codigo_servicio~") COLUMN(NAME=~"vista_funeraria_informes.descripcion~") COLUMN(NAME=~"vista_funeraria_informes.precio~") COLUMN(NAME=~"vista_funeraria_informes.moneda~") COLUMN(NAME=~"vista_funeraria_informes.uf_dia~") COLUMN(NAME=~"vista_funeraria_informes.fecha~") COLUMN(NAME=~"vista_funeraria_informes.uso~") COLUMN(NAME=~"vista_funeraria_informes.valor_uf~") COLUMN(NAME=~"vista_funeraria_informes.valor_clp~") COLUMN(NAME=~"vista_funeraria_informes.sw_activa_servicio~") COMPUTE(NAME=~"~~~"AGENTES~~~".~~~"COD_AGE~~~"||'-'||~~~"AGENTES~~~".~~~"NOMBRE~~~"||' '||~~~"AGENTES~~~".~~~"A_PATERNO~~~"||' '||~~~"AGENTES~~~".~~~"A_MATERNO~~~" AS AGENTE~") COMPUTE(NAME=~"~~~"SUPERVISOR~~~".~~~"COD_SUP~~~"||'-'||~~~"SUPERVISOR~~~".~~~"NOMBRE~~~"||' '||~~~"SUPERVISOR~~~".~~~"A_PATERNO~~~"||' '||~~~"SUPERVISOR~~~".~~~"A_MATERNO~~~" AS SUPERVISOR~") COMPUTE(NAME=~"~~~"COD_PARQ~~~".~~~"NOMBRE~~~" AS PARQUE_NOMBRE~") COLUMN(NAME=~"vista_funeraria_informes.cod_parque_sepul~") COLUMN(NAME=~"vista_funeraria_informes.monbre_parque_sepul~")    JOIN (LEFT=~"vista_funeraria_informes.estado~"    OP =~"=~"RIGHT=~"estado.cod_estado~" )    JOIN (LEFT=~"vista_funeraria_informes.cod_agente~"    OP =~"=~"RIGHT=~"agentes.cod_age~" )    JOIN (LEFT=~"vista_funeraria_informes.cod_super~"    OP =~"=~"RIGHT=~"supervisor.cod_sup~" )    JOIN (LEFT=~"vista_funeraria_informes.cod_parque~"    OP =~"=~"RIGHT=~"cod_parq.codigo~" )WHERE(    EXP1 =~"~~~"VISTA_FUNERARIA_INFORMES~~~".~~~"FECHA~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"VISTA_FUNERARIA_INFORMES~~~".~~~"FECHA~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = datetime)  ARG(NAME = ~"fecha_fin~" TYPE = datetime) " arguments=(("fecha_ini", datetime),("fecha_fin", datetime)) )
