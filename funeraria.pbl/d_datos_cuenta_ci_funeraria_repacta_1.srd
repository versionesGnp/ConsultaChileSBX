 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cliente~" )  TABLE(NAME=~"tasa~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"cadena_mora~" )  TABLE(NAME=~"producto_anexo~" )  TABLE(NAME=~"producto_pago~" ) COLUMN(NAME=~"cliente.rut~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cliente.direccion_p~") COLUMN(NAME=~"cliente.comuna~") COLUMN(NAME=~"cliente.ciudad~") COLUMN(NAME=~"tasa.tasa_m~") COLUMN(NAME=~"tasa.tasa_a~") COLUMN(NAME=~"tasa.tasa_int_p~") COLUMN(NAME=~"tasa.tasa_int_uf~") COLUMN(NAME=~"tasa.gasto_cob_mora~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"cadena_mora.mora_cred~") COLUMN(NAME=~"cadena_mora.dias_mora_cred~") COLUMN(NAME=~"cadena_mora.fecha_venc_cred~") COLUMN(NAME=~"cadena_mora.fallecidos~") COLUMN(NAME=~"cadena_mora.ctas_pag_s~") COLUMN(NAME=~"cadena.cod_parque~") COLUMN(NAME=~"producto_anexo.base~") COLUMN(NAME=~"producto_anexo.serie~") COLUMN(NAME=~"producto_anexo.numero~") COLUMN(NAME=~"producto_pago.fecha~") COLUMN(NAME=~"producto_anexo.cod_agente~") COLUMN(NAME=~"producto_anexo.cod_super~") COLUMN(NAME=~"producto_anexo.cod_jefe~") COLUMN(NAME=~"producto_anexo.uso~") COLUMN(NAME=~"producto_anexo.total_pagado~") COLUMN(NAME=~"producto_anexo.cuotas_pag~") COLUMN(NAME=~"producto_anexo.estado_comi~") COLUMN(NAME=~"producto_anexo.estado_comi_sup~") COLUMN(NAME=~"producto_pago.precio~") COLUMN(NAME=~"producto_pago.pie~") COLUMN(NAME=~"producto_pago.tasa~") COLUMN(NAME=~"producto_pago.valor_cuota~") COLUMN(NAME=~"producto_pago.plazo~") COLUMN(NAME=~"producto_pago.moneda~") COLUMN(NAME=~"producto_pago.fecha_prim~") COLUMN(NAME=~"producto_pago.fecha_ult~") COLUMN(NAME=~"producto_pago.fecha_pie~") COLUMN(NAME=~"producto_pago.gasto_adm~") COLUMN(NAME=~"producto_pago.pie_pagado~") COLUMN(NAME=~"producto_pago.der_esp~") COLUMN(NAME=~"producto_pago.fecha_entre~")    JOIN (LEFT=~"producto_anexo.rut~"    OP =~"=~"RIGHT=~"cliente.rut~"    OUTER1 =~"producto_anexo.rut~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"cadena_mora.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"cadena_mora.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"cadena_mora.numero~" )    JOIN (LEFT=~"producto_anexo.base~"    OP =~"=~"RIGHT=~"producto_pago.base~" )    JOIN (LEFT=~"producto_anexo.serie~"    OP =~"=~"RIGHT=~"producto_pago.serie~" )    JOIN (LEFT=~"producto_anexo.numero~"    OP =~"=~"RIGHT=~"producto_pago.numero~" )    JOIN (LEFT=~"producto_anexo.base~"    OP =~"=~"RIGHT=~"cadena.codigo~" )    JOIN (LEFT=~"producto_anexo.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"producto_anexo.numero~"    OP =~"=~"RIGHT=~"cadena.numero~" )    JOIN (LEFT=~"producto_anexo.ult_folio~"    OP =~"=~"RIGHT=~"producto_pago.folio~" )WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":as_serie~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":an_numero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'F'~" ) ) ARG(NAME = ~"as_serie~" TYPE = string)  ARG(NAME = ~"an_numero~" TYPE = number) " arguments=(("as_serie", string),("an_numero", number)) )
