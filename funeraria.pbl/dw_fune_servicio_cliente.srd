 column=(type=char(200) updatewhereclause=yes name=codigo_estado_civil_descripcion dbname="codigo_estado_civil.descripcion" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cliente~" )  TABLE(NAME=~"revision_contratos~" )  TABLE(NAME=~"codigo_estado_civil~" ) COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cliente.rut~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"cliente.fecha_nac~") COLUMN(NAME=~"cliente.fono_p~") COLUMN(NAME=~"cliente.fono_c~") COLUMN(NAME=~"cliente.celular~") COLUMN(NAME=~"cliente.email~") COMPUTE(NAME=~"( SELECT MAX(~~~"PRODUCTO_BENEFICIARIO~~~".~~~"PARENTESCO~~~") FROM ~~~"PRODUCTO_BENEFICIARIO~~~" WHERE ~~~"PRODUCTO_BENEFICIARIO~~~".~~~"BASE~~~" = ~~~"REVISION_CONTRATOS~~~".~~~"BASE~~~" AND ~~~"PRODUCTO_BENEFICIARIO~~~".~~~"SERIE~~~" = ~~~"REVISION_CONTRATOS~~~".~~~"SERIE~~~" AND ~~~"PRODUCTO_BENEFICIARIO~~~".~~~"NUMERO~~~" = ~~~"REVISION_CONTRATOS~~~".~~~"NUMERO~~~"  ) AS PARENT~") COLUMN(NAME=~"cliente.esta_civil~") COLUMN(NAME=~"codigo_estado_civil.descripcion~")    JOIN (LEFT=~"cliente.rut~"    OP =~"=~"RIGHT=~"revision_contratos.rut~" )    JOIN (LEFT=~"cliente.esta_civil~"    OP =~"=~"RIGHT=~"codigo_estado_civil.codigo_estado~" )WHERE(    EXP1 =~"~~~"REVISION_CONTRATOS~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"REVISION_CONTRATOS~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"REVISION_CONTRATOS~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number) " arguments=(("base", string),("serie", string),("numero", number)) )
