 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"producto_gestion_servicio~" )  TABLE(NAME=~"producto_estado_activa~" )  TABLE(NAME=~"producto_beneficiario~" )  TABLE(NAME=~"producto_anexo~" )  TABLE(NAME=~"producto_pago~" )  TABLE(NAME=~"revision_contratos~" ) COLUMN(NAME=~"producto_gestion_servicio.estado_registro~") COLUMN(NAME=~"producto_gestion_servicio.sw_activacion~") COLUMN(NAME=~"producto_gestion_servicio.fecha_activacion~") COLUMN(NAME=~"producto_gestion_servicio.usuario_activacion~") COLUMN(NAME=~"producto_estado_activa.descripcion~") COLUMN(NAME=~"producto_beneficiario.base~") COLUMN(NAME=~"producto_beneficiario.serie~") COLUMN(NAME=~"producto_beneficiario.numero~") COLUMN(NAME=~"producto_pago.codigo_servicio~") COLUMN(NAME=~"producto_beneficiario.rut~") COLUMN(NAME=~"producto_beneficiario.dv~") COLUMN(NAME=~"producto_beneficiario.fecha_crea~") COLUMN(NAME=~"producto_beneficiario.estado_reg~") COLUMN(NAME=~"revision_contratos.sw_activa_servicio_1~") COLUMN(NAME=~"revision_contratos.fecha_activacion~") COLUMN(NAME=~"revision_contratos.sw_activa_servicio~") COLUMN(NAME=~"revision_contratos.usuario_crea~")    JOIN (LEFT=~"producto_gestion_servicio.sw_activacion~"    OP =~"=~"RIGHT=~"producto_estado_activa.estado_activa~"    OUTER1 =~"producto_gestion_servicio.sw_activacion~" )    JOIN (LEFT=~"producto_gestion_servicio.base~"    OP =~"=~"RIGHT=~"producto_beneficiario.base~"    OUTER2 =~"producto_beneficiario.base~" )    JOIN (LEFT=~"producto_gestion_servicio.serie~"    OP =~"=~"RIGHT=~"producto_beneficiario.serie~"    OUTER2 =~"producto_beneficiario.serie~" )    JOIN (LEFT=~"producto_gestion_servicio.numero~"    OP =~"=~"RIGHT=~"producto_beneficiario.numero~"    OUTER2 =~"producto_beneficiario.numero~" )    JOIN (LEFT=~"producto_beneficiario.base~"    OP =~"=~"RIGHT=~"revision_contratos.base~"    OUTER1 =~"producto_beneficiario.base~" )    JOIN (LEFT=~"producto_beneficiario.serie~"    OP =~"=~"RIGHT=~"revision_contratos.serie~"    OUTER1 =~"producto_beneficiario.serie~" )    JOIN (LEFT=~"producto_beneficiario.numero~"    OP =~"=~"RIGHT=~"revision_contratos.numero~"    OUTER1 =~"producto_beneficiario.numero~" )    JOIN (LEFT=~"producto_beneficiario.base~"    OP =~"=~"RIGHT=~"producto_anexo.base~" )    JOIN (LEFT=~"producto_anexo.base~"    OP =~"=~"RIGHT=~"producto_pago.base~" )    JOIN (LEFT=~"producto_anexo.serie~"    OP =~"=~"RIGHT=~"producto_pago.serie~" )    JOIN (LEFT=~"producto_anexo.numero~"    OP =~"=~"RIGHT=~"producto_pago.numero~" )    JOIN (LEFT=~"producto_anexo.ult_folio~"    OP =~"=~"RIGHT=~"producto_pago.folio~" )    JOIN (LEFT=~"producto_beneficiario.serie~"    OP =~"=~"RIGHT=~"producto_anexo.serie~" )    JOIN (LEFT=~"producto_beneficiario.numero~"    OP =~"=~"RIGHT=~"producto_anexo.numero~" )WHERE(    EXP1 =~"~~~"PRODUCTO_BENEFICIARIO~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"PRODUCTO_BENEFICIARIO~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"PRODUCTO_BENEFICIARIO~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number) " arguments=(("base", string),("serie", string),("numero", number))  sort="producto_beneficiario_fecha_crea A " )
