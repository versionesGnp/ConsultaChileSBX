 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"web_descuentos_detalle~" ) COLUMN(NAME=~"web_descuentos_detalle.base~") COLUMN(NAME=~"web_descuentos_detalle.serie~") COLUMN(NAME=~"web_descuentos_detalle.numero~") COLUMN(NAME=~"web_descuentos_detalle.codigo_tramo~") COLUMN(NAME=~"web_descuentos_detalle.usuario~") COLUMN(NAME=~"web_descuentos_detalle.fecha_crea~") COLUMN(NAME=~"web_descuentos_detalle.estado_reg~") COLUMN(NAME=~"web_descuentos_detalle.fecha_vig_ini~") COLUMN(NAME=~"web_descuentos_detalle.fecha_vig_fin~") COMPUTE(NAME=~"1 as estado_eliminar~")WHERE(    EXP1 =~"~~~"WEB_DESCUENTOS_DETALLE~~~".~~~"CODIGO_TRAMO~~~"~"   OP =~"=~"    EXP2 =~":tramo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"WEB_DESCUENTOS_DETALLE~~~".~~~"FECHA_VIG_INI~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"WEB_DESCUENTOS_DETALLE~~~".~~~"FECHA_VIG_FIN~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"WEB_DESCUENTOS_DETALLE~~~".~~~"ESTADO_REG~~~"~"   OP =~"<>~"    EXP2 =~"'A'~" ) ) ARG(NAME = ~"tramo~" TYPE = number)  ARG(NAME = ~"fecha_ini~" TYPE = date)  ARG(NAME = ~"fecha_fin~" TYPE = date) " update="WEB_DESCUENTOS_DETALLE" updatewhere=0 updatekeyinplace=yes arguments=(("tramo", number),("fecha_ini", date),("fecha_fin", date))  sort="numero A " )
