table(column=(type=char(1) update=yes updatewhereclause=yes key=yes name=base dbname="web_descuentos_detalle.base" )
 column=(type=char(1) update=yes updatewhereclause=yes key=yes name=serie dbname="web_descuentos_detalle.serie" )
 column=(type=decimal(4) update=yes updatewhereclause=yes key=yes name=numero dbname="web_descuentos_detalle.numero" )
 column=(type=decimal(4) update=yes updatewhereclause=yes key=yes name=codigo_tramo dbname="web_descuentos_detalle.codigo_tramo" )
 column=(type=char(15) update=yes updatewhereclause=yes name=usuario dbname="web_descuentos_detalle.usuario" )
