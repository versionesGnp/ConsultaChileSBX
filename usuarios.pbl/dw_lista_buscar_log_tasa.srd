table(column=(type=datetime update=yes updatewhereclause=yes key=yes name=fecha dbname="log_tasa.fecha" )
 column=(type=decimal(4) update=yes updatewhereclause=yes key=yes name=tasa dbname="log_tasa.tasa" )
