PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME="vista_sap_debe" )  TABLE(NAME="sap_cuentas_contables" )  TABLE(NAME="codigo_cajas" ) COLUMN(NAME="sap_cuentas_contables.cuenta_contable")    JOIN (LEFT="vista_sap_debe.cod_pago"    OP ="="RIGHT="sap_cuentas_contables.cod_pago" )    JOIN (LEFT="vista_sap_debe.cod_caja"    OP ="="RIGHT="sap_cuentas_contables.cod_caja" )    JOIN (LEFT="vista_sap_debe.condicion_pago"    OP ="="RIGHT="sap_cuentas_contables.estado_cheque" )    JOIN (LEFT="sap_cuentas_contables.cod_caja"    OP ="="RIGHT="codigo_cajas.cod_caja" )    JOIN (LEFT="sap_cuentas_contables.cod_parque"    OP ="="RIGHT="codigo_cajas.cod_parque" )WHERE(    EXP1 ="~"VISTA_SAP_DEBE~".~"COD_CAJA~""   OP ="="    EXP2 =":cod_caja"    LOGIC ="And" ) WHERE(    EXP1 ="~"VISTA_SAP_DEBE~".~"FECHA_PAGO~""   OP ="="    EXP2 =":fecha_pago" ) )    UNION (PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME="cadena_mora" )  TABLE(NAME="cliente" )  TABLE(NAME="cod_movi" )  TABLE(NAME="vista_sap_haber" ) COLUMN(NAME="vista_sap_haber.cuenta_contable")    JOIN (LEFT="vista_sap_haber.base"    OP ="="RIGHT="cadena_mora.base"    OUTER1 ="vista_sap_haber.base" )    JOIN (LEFT="vista_sap_haber.serie"    OP ="="RIGHT="cadena_mora.serie"    OUTER1 ="vista_sap_haber.serie" )    JOIN (LEFT="vista_sap_haber.numero"    OP ="="RIGHT="cadena_mora.numero"    OUTER1 ="vista_sap_haber.numero" )    JOIN (LEFT="vista_sap_haber.rut"    OP ="="RIGHT="cliente.rut"    OUTER1 ="vista_sap_haber.rut" )    JOIN (LEFT="vista_sap_haber.tipo_mov"    OP ="="RIGHT="cod_movi.cod_ing" )WHERE(    EXP1 ="~"VISTA_SAP_HABER~".~"CAJA~""   OP ="="    EXP2 =":cod_caja"    LOGIC ="And" ) WHERE(    EXP1 ="~"VISTA_SAP_HABER~".~"FECHA_PAGO~""   OP ="="    EXP2 =":fecha_pago"    LOGIC ="And" ) WHERE(    EXP1 ="~"VISTA_SAP_HABER~".~"TIPO_MOV~""   OP ="="    EXP2 ="'S'" ) )) ARG(NAME = "cod_caja" TYPE = string)  ARG(NAME = "fecha_pago" TYPE = date) 