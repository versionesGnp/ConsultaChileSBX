 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"documentos~" ) COLUMN(NAME=~"documentos.folio~") COLUMN(NAME=~"documentos.tipo_cob~") COLUMN(NAME=~"documentos.n_cheque~") COLUMN(NAME=~"documentos.cod_banco~") COLUMN(NAME=~"documentos.monto~") COLUMN(NAME=~"documentos.fecha_venc~") COLUMN(NAME=~"documentos.cod_pago~") COLUMN(NAME=~"documentos.num_cheques~") COLUMN(NAME=~"documentos.rezago~") COLUMN(NAME=~"documentos.fecha_pago~") COLUMN(NAME=~"documentos.cod_caja~") COLUMN(NAME=~"documentos.estado_ch~") COLUMN(NAME=~"documentos.glosa_ch~") COLUMN(NAME=~"documentos.fecha_estado_ch~") COLUMN(NAME=~"documentos.cod_tarjeta_credito~") COLUMN(NAME=~"documentos.nro_cuotas_credito~") COLUMN(NAME=~"documentos.cod_autorizacion_credito~") COLUMN(NAME=~"documentos.tipo_tarjeta_credito~") COLUMN(NAME=~"documentos.cod_tarjeta_debito~") COLUMN(NAME=~"documentos.cod_autorizacion_debito~") COLUMN(NAME=~"documentos.cod_banco_debito~") COLUMN(NAME=~"documentos.traspado_pago~") COLUMN(NAME=~"documentos.tipo_pago_tarjeta_credito~") COLUMN(NAME=~"documentos.hora_pago~") COLUMN(NAME=~"documentos.minuto_pago~") COLUMN(NAME=~"documentos.tarjeta_empresa~") COLUMN(NAME=~"documentos.tipo_cob_aux~")WHERE(    EXP1 =~"~~~"DOCUMENTOS~~~".~~~"FECHA_PAGO~~~"~"   OP =~"=~"    EXP2 =~"to_date('21/09/2015','dd/mm/yyyy')~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"DOCUMENTOS~~~".~~~"COD_CAJA~~~"~"   OP =~"=~"    EXP2 =~"'21'~" ) ) " update="DOCUMENTOS" updatewhere=1 updatekeyinplace=no )
