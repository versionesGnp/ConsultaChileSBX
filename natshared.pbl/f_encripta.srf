//objectcomments /* Autor: César Vilela~r~n    Función: Envía a DB a encriptar~r~n    Recomendación: NO MODIFICAR~r~n*/
global type f_encripta from function_object
end type

forward prototypes
global function string f_encripta (ref string as_texto)
end prototypes

global function string f_encripta (ref string as_texto);/* f_Encripta( as_texto ) */

uo_DataStore	lds_enc
String			ls_EPW


ls_epw = ProfileString (gs_ini, gs_iniProfile, 'EPW', '1')
If ls_epw = '0' Then Return as_texto


If f_IsOracle( ) Then
	f_CreateDS( lds_enc, 'd_gen_encripta_ora', SqlCa )
Else
	f_CreateDS( lds_enc, 'd_gen_encripta', SqlCa )
End If

If lds_enc.Retrieve( as_texto, '' ) > 0 Then
	as_texto = f_Trim( lds_enc.Object.c_encriptado[ 1] )
Else
	as_texto = ''
End If

Destroy	lds_enc

Return as_texto
end function

