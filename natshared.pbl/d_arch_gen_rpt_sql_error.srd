summary(height=0 color="536870912" )
footer(height=152 color="536870912" )
detail(height=152 color="536870912" height.autosize=yes )
table(column=(type=char(40) updatewhereclause=no name=database dbname="database" )
 column=(type=char(250) updatewhereclause=no name=usertext dbname="usertext" )
 column=(type=char(10) updatewhereclause=no name=sqldbcode dbname="sqldbcode" )
 column=(type=char(1000) updatewhereclause=no name=sqlerrtext dbname="sqlerrtext" )
 column=(type=char(25) updatewhereclause=no name=user dbname="user" )
 column=(type=char(25) updatewhereclause=no name=cgroup dbname="name_1" )
 )
text(band=header alignment="0" text="REPORTE DE ERROR EN TRANSACCION DE BASE CON DATOS" border="0" color="0" x="1088" y="132" height="44" width="1353" html.valueishtml="0"  name=st_title visible="1"  font.face="Arial" font.height="-7" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" font.underline="1" background.mode="1" background.color="536870912" )
