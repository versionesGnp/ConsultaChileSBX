table(column=(type=char(1) updatewhereclause=yes name=c_grupo dbname="c_grupo" )
 column=(type=char(50) updatewhereclause=yes name=c_codigo dbname="c_codigo" )
 column=(type=char(200) updatewhereclause=yes name=v_nombre dbname="v_nombre" )
 column=(type=char(100) updatewhereclause=yes name=v_tabla dbname="v_tabla" )
 column=(type=long updatewhereclause=yes name=n_totrel dbname="n_totrel" initial="0" )
 retrieve="
Select Top 1 
       c_grupo = '1' ,
       c_codigo = Space(50),   
       v_nombre = Space(200),   
       v_tabla = Space(100),   
       n_totrel = 0 
From   genempresa   
Where  c_activo_emp = '1'" )
