global type f_colenableda from function_object
end type

forward prototypes
global subroutine f_colenableda (datawindow adw_mod, string as_col[], boolean ab_enabled)
end prototypes

global subroutine f_colenableda (datawindow adw_mod, string as_col[], boolean ab_enabled);/* Autor: Cesar Vilela v. BL-Eclipse 22/04/2020
	f_ColEnabledA( adw_mod, as_col[], ab_enabled )  */

Integer	i

For i = 1 To UpperBound( as_col[] )
	f_ColEnabled( adw_mod, as_col[ i], ab_enabled )	
Next


end subroutine

