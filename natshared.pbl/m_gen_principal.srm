//objectcomments Autor: César Vilela~r~nMenú Principal del Sistema.
forward
global type m_gen_principal from menu
end type
type m_archivo from menu within m_gen_principal
end type
type m_nuevo from menu within m_archivo
end type
type m_abrir from menu within m_archivo
end type
type m_0 from menu within m_archivo
end type
type m_imprimir from menu within m_archivo
end type
type m_desplazarmenu from menu within m_archivo
end type
type m_páginadeinicio from menu within m_archivo
end type
type m_salir from menu within m_archivo
end type
type m_archivo from menu within m_gen_principal
m_nuevo m_nuevo
m_abrir m_abrir
m_0 m_0
m_imprimir m_imprimir
m_desplazarmenu m_desplazarmenu
m_páginadeinicio m_páginadeinicio
m_salir m_salir
end type
global type m_gen_principal from menu
m_archivo m_archivo
end type
end forward

global type m_gen_principal from menu
m_archivo m_archivo
end type
global m_gen_principal m_gen_principal

on m_gen_principal.create
m_gen_principal=this
call super::create
this.menustyle = contemporarymenu!
this.menutextcolor = 134217735
this.menubackcolor = 134217732
this.menuhighlightcolor = 134217741
this.textsize = -8
this.weight = 400
this.facename = "Tahoma"
this.titlebackcolor = 134217730
this.bitmapbackcolor = 12632256
this.menubitmaps = true
this.titlegradient = true
this.toolbarstyle = contemporarytoolbar!
this.toolbartextcolor = 134217746
this.toolbarbackcolor = 67108864
this.toolbarhighlightcolor = 134217741
this.toolbargradient = true
this.bitmapgradient = true
this.m_archivo=create m_archivo
this.Item[UpperBound(this.Item)+1]=this.m_archivo
end on

on m_gen_principal.destroy
call super::destroy
destroy(this.m_archivo)
end on

type m_archivo from menu within m_gen_principal
m_nuevo m_nuevo
m_abrir m_abrir
m_0 m_0
m_imprimir m_imprimir
m_desplazarmenu m_desplazarmenu
m_páginadeinicio m_páginadeinicio
m_salir m_salir
end type

on m_archivo.create
call super::create
this.text = "&Archivo"
this.menustyle = contemporarymenu!
this.menutextcolor = 134217735
this.menubackcolor = 134217732
this.menuhighlightcolor = 134217741
this.textsize = -8
this.weight = 400
this.facename = "Tahoma"
this.titlebackcolor = 134217730
this.bitmapbackcolor = 12632256
this.menubitmaps = true
this.titlegradient = true
this.toolbarstyle = contemporarytoolbar!
this.toolbartextcolor = 134217746
this.toolbarbackcolor = 67108864
this.toolbarhighlightcolor = 134217741
this.toolbargradient = true
this.bitmapgradient = true
this.m_nuevo=create m_nuevo
this.m_abrir=create m_abrir
this.m_0=create m_0
this.m_imprimir=create m_imprimir
this.m_desplazarmenu=create m_desplazarmenu
this.m_páginadeinicio=create m_páginadeinicio
this.m_salir=create m_salir
this.Item[UpperBound(this.Item)+1]=this.m_nuevo
this.Item[UpperBound(this.Item)+1]=this.m_abrir
this.Item[UpperBound(this.Item)+1]=this.m_0
this.Item[UpperBound(this.Item)+1]=this.m_imprimir
this.Item[UpperBound(this.Item)+1]=this.m_desplazarmenu
this.Item[UpperBound(this.Item)+1]=this.m_páginadeinicio
this.Item[UpperBound(this.Item)+1]=this.m_salir
end on

on m_archivo.destroy
call super::destroy
destroy(this.m_nuevo)
destroy(this.m_abrir)
destroy(this.m_0)
destroy(this.m_imprimir)
destroy(this.m_desplazarmenu)
destroy(this.m_páginadeinicio)
destroy(this.m_salir)
end on

