lsClass = ClassName( adata )
Choose Case lsClass
	Case 'datetime'
		DateTime	ldRet
		
		ldRet = DateTime( aData )
		If f_IsDate( ldRet ) Then 
			Return ldRet
		Else
			Return ldNil
		End If
		
	Case 'string'
		If f_Trim( String( aData )) = '' Then
			Return String( aData )
		Else
			Return lsNil
		End If

End Choose
*/
end function

