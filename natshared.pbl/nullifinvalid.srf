global type nullifinvalid from function_object
end type

forward prototypes
global function datetime nullifinvalid (datetime adata)
end prototypes

global function datetime nullifinvalid (datetime adata);
/* NullIfInvalid( aData ) */

DateTime	ldNil
String	lsNil


SetNull( ldNil )
SetNull( lsNil )
		DateTime	ldRet
		
		ldRet = DateTime( aData )
		If f_IsDate( ldRet ) Then 
			Return ldRet
		Else
			Return ldNil
		End If
		
/*
