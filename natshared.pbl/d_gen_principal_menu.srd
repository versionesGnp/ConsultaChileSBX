table(column=(type=char(100) updatewhereclause=yes name=v_nombre_emp dbname="genempresa.v_nombre_emp" dbalias=".v_nombre_emp" )
 column=(type=char(13) updatewhereclause=yes name=c_rfc_emp dbname="genempresa.c_rfc_emp" dbalias=".c_rfc_emp" )
 column=(type=char(100) updatewhereclause=yes name=v_nombre_usu dbname="v_nombre_usu" )
 column=(type=char(2) updatewhereclause=yes name=v_nombre_tem dbname="v_nombre_tem" )
 column=(type=char(2) updatewhereclause=yes name=c_codigo_tem dbname="c_codigo_tem" )
 column=(type=char(1) updatewhereclause=yes name=c_menu dbname="c_menu" initial="1" )
 column=(type=char(1) updatewhereclause=yes name=c_activo dbname="c_activo" initial="0" values="Activado	1/Desactivado	0/" )
 column=(type=char(1) updatewhereclause=yes name=c_dock dbname="c_dock" values="Desactivado	0/Activado	1/" )
 retrieve="  SELECT genempresa.v_nombre_emp,   
         genempresa.c_rfc_emp,   
         Upper( ( Select v_nombre_usu From genlogin x Where x.c_codigo_usu = :as_usu ) ) As v_nombre_usu,   
         '  ' As v_nombre_tem,   
         '  ' As c_codigo_tem, 
         /*Coalesce( Upper( tem.v_nombre_tem ), '- SIN ASIGNAR -' ) As v_nombre_tem,   
         Coalesce( Upper( genEmpresa.c_codigo_tem ), '-' ) As c_codigo_tem, */
         '1' As c_menu,   
         Coalesce( ( Select c_menustd_usu From genlogin x Where x.c_codigo_usu = :as_usu ), '0' ) As c_activo,  
         Coalesce( ( Select c_dock_usu From genlogin x Where x.c_codigo_usu = :as_usu ), '0' ) As c_dock 
   From  genempresa
   /*
   Left Join genTemporada tem
   On   tem.c_codigo_emp = genEmpresa.c_codigo_emp 
   And  tem.c_codigo_tem = genEmpresa.c_codigo_tem 
   */
   Where genempresa.c_codigo_emp = :as_emp    
" arguments=(("as_emp", string),("as_usu", string)) )
