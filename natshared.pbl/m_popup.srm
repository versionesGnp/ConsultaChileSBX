end type
global m_popup m_popup

on m_popup.create
m_popup=this
call super::create
this.menustyle = contemporarymenu!
this.menutextcolor = 8421504
this.menubackcolor = 1073741824
this.menuhighlightcolor = 134217741
this.textsize = -8
this.weight = 700
this.fontfamily = swiss!
this.facename = "Verdana"
this.titlebackcolor = 67108864
this.bitmapbackcolor = 134217732
this.menutitles = true
this.menubitmaps = true
this.titlegradient = true
this.toolbarstyle = contemporarytoolbar!
this.toolbartextcolor = 134217746
this.toolbarbackcolor = 1073741824
this.toolbarhighlightcolor = 134217741
this.bitmapgradient = true
this.m_opcion=create m_opcion
this.Item[UpperBound(this.Item)+1]=this.m_opcion
end on

on m_popup.destroy
call super::destroy
destroy(this.m_opcion)
end on

