 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"genLogin~" ) COLUMN(NAME=~"genLogin.v_nombre_usu~") COLUMN(NAME=~"genLogin.c_codigo_usu~") COLUMN(NAME=~"genLogin.c_admin_usu~") COMPUTE(NAME=~" ('                                        ' ) As v_nombre_emp~") COMPUTE(NAME=~" Space( 100 ) As v_texto~") COMPUTE(NAME=~"0 As n_mostrar~") COMPUTE(NAME=~"'  ' As c_codigo_emp~") COMPUTE(NAME=~" '  ' As c_codigo_tem~") COMPUTE(NAME=~"Space( 100 ) As v_nombre_tem~") COMPUTE(NAME=~"Space( 100 ) As v_nombre_cnx~")WHERE(    EXP1 =~"genLogin.c_codigo_usu~"   OP =~"=~"    EXP2 =~":as_cod~" ) ) ARG(NAME = ~"as_cod~" TYPE = string) " update="genLogin" updatewhere=0 updatekeyinplace=yes arguments=(("as_cod", string)) )
