 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"genNotificacion~" ) COLUMN(NAME=~"genNotificacion.c_codigo_usu~") COLUMN(NAME=~"genNotificacion.v_nombre_not~") COLUMN(NAME=~"genNotificacion.v_texto_not~") COLUMN(NAME=~"genNotificacion.c_usucrea~") COLUMN(NAME=~"genNotificacion.d_creacion~") COLUMN(NAME=~"genNotificacion.d_modifi~") COLUMN(NAME=~"genNotificacion.c_activo~")WHERE(    EXP1 =~"Trim( genNotificacion.c_codigo_usu )~"   OP =~"=~"    EXP2 =~"Trim(:as_usu )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"genNotificacion.c_activo~"   OP =~"=~"    EXP2 =~"'1'~" ) ) ARG(NAME = ~"as_usu~" TYPE = string) " update="genNotificacion" updatewhere=0 updatekeyinplace=no arguments=(("as_usu", string))  sort="d_creacion A c_codigo_usu A " )
