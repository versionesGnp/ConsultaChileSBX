 column=(type=char(1) updatewhereclause=yes name=c_nivel_sub dbname="c_nivel_sub" )
 column=(type=char(5) updatewhereclause=yes name=c_depende_sub dbname="c_depende_sub" )
 column=(type=char(20) updatewhereclause=yes name=v_color_sub dbname="v_color_sub" )
 column=(type=char(250) updatewhereclause=yes name=v_descripcion_sub dbname="v_descripcion_sub" )
 column=(type=char(5) updatewhereclause=yes name=c_codigo_opc dbname="c_codigo_opc" )
 column=(type=char(100) updatewhereclause=yes name=v_nombre_opc dbname="v_nombre_opc" )
 column=(type=char(1) updatewhereclause=yes name=c_nivel_opc dbname="c_nivel_opc" )
 column=(type=char(5) updatewhereclause=yes name=c_depende_opc dbname="c_depende_opc" )
 column=(type=char(20) updatewhereclause=yes name=v_color_opc dbname="v_color_opc" )
 column=(type=char(250) updatewhereclause=yes name=v_descripcion_opc dbname="v_descripcion_opc" )
 column=(type=char(1) updatewhereclause=yes name=c_menu dbname="c_menu" )
 column=(type=char(1) updatewhereclause=yes name=c_dock dbname="c_dock" )
 retrieve="Select   c_codigo_mod = genopcion.c_codigo_opc,   
         v_nombre_mod = genopcion.v_nombre_opc,   
         c_nivel_mod = genopcion.c_nivel_opc,   
         v_color_mod = genopcion.v_color_opc,   
         v_descripcion_mod = genopcion.v_descripcion_opc,

         c_codigo_sub  = nivel_2.c_codigo_opc,   
         v_nombre_sub  = nivel_2.v_nombre_opc,   
         c_nivel_sub   = nivel_2.c_nivel_opc,   
         c_depende_sub = nivel_2.c_depende_opc,   
         v_color_sub   = nivel_2.v_color_opc,   
         v_descripcion_sub = nivel_2.v_descripcion_opc,

         c_codigo_opc  = nivel_3.c_codigo_opc,   
         v_nombre_opc  = nivel_3.v_nombre_opc,   
         c_nivel_opc   = nivel_3.c_nivel_opc,   
         c_depende_opc = nivel_3.c_depende_opc,   
         v_color_opc   = nivel_3.v_color_opc,   
         v_descripcion_opc = nivel_3.v_descripcion_opc,
         c_menu = '1',
         c_dock = IsNull( ( Select c_dock_usu From genlogin x Where x.c_codigo_usu = :as_usu ), '0' )
From     genopcion, 
             
            ( Select
                     c_codigo_opc,   
                     v_nombre_opc,   
                     c_nivel_opc,   
                     c_depende_opc,   
                     v_color_opc,   
                     v_descripcion_opc
              From   genopcion    
              Where  c_nivel_opc = '2' ) nivel_2,
   
            ( Select
                     c_codigo_opc,   
                     v_nombre_opc,   
                     c_nivel_opc,   
                     c_depende_opc,   
                     v_color_opc,   
                     v_descripcion_opc
              From   genopcion    
              Where  c_nivel_opc = '3' ) nivel_3

Where genopcion.c_nivel_opc = '1'
And   genopcion.c_codigo_opc *= nivel_2.c_depende_opc
And   nivel_2.c_codigo_opc = nivel_3.c_depende_opc

/*
Union

Select   nivel_2.c_codigo_opc,   
         nivel_2.v_nombre_opc,   
         nivel_2.c_nivel_opc,   
         nivel_2.c_depende_opc,   
         nivel_2.v_color_opc,   
         nivel_2.v_descripcion_opc
From     nivel_2 nivel_2   
Where    c_nivel_opc = '2'

Union

Select   nivel_3.c_codigo_opc,   
         nivel_3.v_nombre_opc,   
         nivel_3.c_nivel_opc,   
         nivel_3.c_depende_opc,   
         nivel_3.v_color_opc,   
         nivel_3.v_descripcion_opc
From     nivel_3  nivel_3 
Where    c_nivel_opc = '3'


*/
" arguments=(("as_emp", string),("as_usu", string))  sort="c_codigo_mod A c_codigo_sub A c_codigo_opc A " )
