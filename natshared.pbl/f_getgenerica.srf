	Case 'PAC'
		as_cod = Right( '000000' + as_cod, 6)
		Select	IsNull( v_apellido_pac , '') + ', ' + IsNull( v_nombre_pac, '' )
		Into		:ls_ret
		From		rhuMedPatient
		Where		c_codigo_pac = :as_cod
