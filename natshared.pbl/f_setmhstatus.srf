global function integer f_setmhstatus (integer ai_block, string as_text);/* f_SetMHStatus( ai_block, as_text ) */

If Not IsValid(gw_frame) Then
	Return -1
End If
gw_frame.SetMicroHelp( as_text )


Return 1
end function

