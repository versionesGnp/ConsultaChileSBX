table(column=(type=char(2) update=yes updatewhereclause=yes name=c_codigo_emp dbname="genempresa.c_codigo_emp" dbalias=".c_codigo_emp" )
 column=(type=char(100) update=yes updatewhereclause=yes name=v_nombre_emp dbname="genempresa.v_nombre_emp" dbalias=".v_nombre_emp" )
 column=(type=char(20) update=yes updatewhereclause=yes name=v_nombrcort_emp dbname="genempresa.v_nombrcort_emp" dbalias=".v_nombrcort_emp" )
 column=(type=char(13) update=yes updatewhereclause=yes name=c_rfc_emp dbname="genempresa.c_rfc_emp" dbalias=".c_rfc_emp" )
 column=(type=char(3) updatewhereclause=yes name=c_codigo_pai dbname="genpais.c_codigo_pai" dbalias="pai.c_codigo_pai" )
 column=(type=char(100) updatewhereclause=yes name=v_nombre_pai dbname="genpais.v_nombre_pai" dbalias="pai.v_nombre_pai" )
 column=(type=char(1) updatewhereclause=yes name=c_grupo dbname="c_grupo" )
 retrieve="
Select c_codigo_emp,   
       v_nombre_emp,   
       v_nombrcort_emp,   
       c_rfc_emp,
       pai.c_codigo_pai,
       pai.v_nombre_pai,   
       '1' As c_grupo  
From   genempresa
Join   genpais pai
On     pai.c_codigo_pai = genempresa.c_codigo_pai
Where  c_activo_emp = '1'
And    ( Coalesce( ( Select c_admin_usu From genlogin usu Where usu.c_codigo_usu = :as_usu ), '0' ) = '1' )

Union

Select emp.c_codigo_emp,   
       emp.v_nombre_emp,   
       emp.v_nombrcort_emp,   
       emp.c_rfc_emp,   
       pai.c_codigo_pai,
       pai.v_nombre_pai,   
       '1' As c_grupo  
From   genempresa   emp 
Join   genloginemp  gle
On     emp.c_codigo_emp = gle.c_codigo_emp
Join   genpais pai
On     pai.c_codigo_pai = emp.c_codigo_pai
And    gle.c_codigo_usu = :as_usu 
Where  c_activo_emp = '1'
And    ( Coalesce( ( Select c_admin_usu From genlogin usu Where usu.c_codigo_usu = :as_usu ), '0' ) = '0' )

" arguments=(("as_usu", string)) )
