table(column=(type=char(2) update=yes updatewhereclause=yes key=yes name=c_codigo_emp dbname="genempresa.c_codigo_emp" )
 column=(type=char(100) update=yes updatewhereclause=yes name=v_nombre_emp dbname="genempresa.v_nombre_emp" )
 column=(type=char(20) update=yes updatewhereclause=yes name=v_nombrcort_emp dbname="genempresa.v_nombrcort_emp" )
 column=(type=char(13) update=yes updatewhereclause=yes name=c_rfc_emp dbname="genempresa.c_rfc_emp" )
 column=(type=char(1) updatewhereclause=yes name=c_grupo dbname="c_grupo" )
 retrieve="
Select c_codigo_emp,   
       v_nombre_emp,   
       v_nombrcort_emp,   
       c_rfc_emp,   
       c_grupo = '1'  
From   genempresa   
Where  c_activo_emp = '1'
And    ( IsNull( ( Select c_admin_usu From genlogin usu Where usu.c_codigo_usu = :as_usu ), '0' ) = '1' )

Union

Select emp.c_codigo_emp,   
       emp.v_nombre_emp,   
       emp.v_nombrcort_emp,   
       emp.c_rfc_emp,   
       c_grupo = '1'   
From   genempresa   emp 
Join   genloginemp  gle
On     emp.c_codigo_emp = gle.c_codigo_emp
And    gle.c_codigo_usu = :as_usu 
Where  c_activo_emp = '1'
And    ( IsNull( ( Select c_admin_usu From genlogin usu Where usu.c_codigo_usu = :as_usu ), '0' ) = '0' )

" update="genempresa" updatewhere=1 updatekeyinplace=yes arguments=(("as_usu", string)) )
