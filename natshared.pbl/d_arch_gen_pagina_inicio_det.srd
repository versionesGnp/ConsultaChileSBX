//objectcomments /* Autor: César Vilela~r~n    Función: Diseño Presentación del detalle de opciones predetermiandas selecionadas por usuario~r~n    Recomendación: No Modificar~r~n*/
release 10.5;
datawindow(units=0 timer_interval=0 color=1073741824 processing=1 HTMLDW=no print.printername="" print.documentname="" print.orientation = 0 print.margin.left = 108 print.margin.right = 108 print.margin.top = 94 print.margin.bottom = 94 print.paper.source = 0 print.paper.size = 0 print.canusedefaultprinter=yes print.prompt=no print.buttons=no print.preview.buttons=no print.cliptext=no print.overrideprintjob=no print.collate=yes print.preview.outline=yes hidegrayline=no grid.lines=1 selected.mouse=no )
header(height=84 color="15780518" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=128 color="536870912" )
table(column=(type=number updatewhereclause=no name=n_grupo dbname="n_grupo" )
 column=(type=char(5) updatewhereclause=no name=c_codigo_opc1 dbname="c_codigo_opc1" )
 column=(type=char(100) updatewhereclause=no name=v_nombre_opc1 dbname="v_nombre_opc1" )
 column=(type=char(5) updatewhereclause=no name=c_codigo_opc2 dbname="c_codigo_opc2" )
 column=(type=char(100) updatewhereclause=no name=v_nombre_opc2 dbname="v_nombre_opc2" )
 column=(type=char(5) updatewhereclause=no name=c_nivel1_opc1 dbname="name_1" )
 column=(type=char(100) updatewhereclause=no name=v_nomniv1_opc1 dbname="name_2" )
 column=(type=char(5) updatewhereclause=no name=c_nivel1_opc2 dbname="name_3" )
 column=(type=char(100) updatewhereclause=no name=v_nomniv1_opc2 dbname="name_4" )
 column=(type=char(1) updatewhereclause=no name=c_nivel1 dbname="name_5" )
 column=(type=char(1) updatewhereclause=no name=c_nivel2 dbname="name_6" )
 )
text(band=header alignment="0" text=" Opciones de Acceso Rápido" border="0" color="33554432" x="5" y="20" height="44" width="1467" html.valueishtml="0"  name=t_1 visible="1"  font.face="Tahoma" font.height="-7" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127" )
compute(band=detail alignment="0" expression=" v_nombre_opc1 "border="0" color="33554432~tIf ( c_nivel1 = '1', f_Gen_Color( 'o' ), f_Gen_Color( 't' ) )" x="5" y="20" height="84" width="1467" format="[GENERAL]" html.valueishtml="0"  name=v_xnombre_opc1 pointer="~tIf ( c_nivel1 = '3' And Not f_Trim( v_nombre_opc1 )  = '',  'HyperLink!', '' )" visible="1"  font.face="Tahoma" font.height="-8" font.weight="400~tIf ( c_nivel1 = '1', 700, 400 )"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" )
compute(band=detail alignment="0" expression=" v_nombre_opc2 "border="0" color="33554432~tIf ( c_nivel2 = '1', f_Gen_Color( 'o' ), f_Gen_Color( 't' ) )" x="1481" y="20" height="84" width="1280" format="[GENERAL]" html.valueishtml="0"  name=v_xnombre_opc2 pointer="~tIf ( c_nivel2 = '3' And Not f_Trim( v_nombre_opc2 )  = '',  'HyperLink!', '' )" visible="1"  font.face="Tahoma" font.height="-8" font.weight="400~tIf ( c_nivel2 = '1', 700, 400 )"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" )
htmltable(border="1" )
htmlgen(clientevents="1" clientvalidation="1" clientcomputedfields="1" clientformatting="0" clientscriptable="0" generatejavascript="1" encodeselflinkargs="1" netscapelayers="0" pagingmethod=0 generatedddwframes="1" )
xhtmlgen() cssgen(sessionspecific="0" )
xmlgen(inline="0" )
xsltgen()
jsgen()
export.xml(headgroups="1" includewhitespace="0" metadatatype=0 savemetadata=0 )
import.xml()
export.pdf(method=0 distill.custompostscript="0" xslfop.print="0" )
export.xhtml()
 