global type m_menu_pagos_ventas from menu
m_comisiones m_comisiones
m_2 m_2
m_premios m_premios
end type
global m_menu_pagos_ventas m_menu_pagos_ventas

on m_menu_pagos_ventas.create
m_menu_pagos_ventas=this
call super::create
this.text = "m_menu_pagos_ventas"
this.menutextcolor = 134217735
this.menubackcolor = 134217732
this.menuhighlightcolor = 134217741
this.textsize = 8
this.weight = 400
this.facename = "Tahoma"
this.titlebackcolor = 134217730
this.bitmapbackcolor = 12632256
this.menubitmaps = true
this.titlegradient = true
this.toolbartextcolor = 134217746
this.toolbarbackcolor = 67108864
this.toolbarhighlightcolor = 134217741
this.toolbargradient = true
this.bitmapgradient = true
this.m_comisiones=create m_comisiones
this.m_2=create m_2
this.m_premios=create m_premios
this.Item[UpperBound(this.Item)+1]=this.m_comisiones
this.Item[UpperBound(this.Item)+1]=this.m_2
this.Item[UpperBound(this.Item)+1]=this.m_premios
end on

on m_menu_pagos_ventas.destroy
call super::destroy
destroy(this.m_comisiones)
destroy(this.m_2)
destroy(this.m_premios)
end on

type m_comisiones from menu within m_menu_pagos_ventas
m_procesocomsionesareaventas m_procesocomsionesareaventas
end type

on m_comisiones.create
call super::create
this.text = "Comisiones"
this.menutextcolor = 134217735
this.menubackcolor = 134217732
this.menuhighlightcolor = 134217741
this.textsize = 8
this.weight = 400
this.facename = "Tahoma"
this.titlebackcolor = 134217730
this.bitmapbackcolor = 12632256
this.menubitmaps = true
this.titlegradient = true
this.toolbartextcolor = 134217746
this.toolbarbackcolor = 67108864
this.toolbarhighlightcolor = 134217741
this.toolbargradient = true
this.bitmapgradient = true
this.m_procesocomsionesareaventas=create m_procesocomsionesareaventas
this.Item[UpperBound(this.Item)+1]=this.m_procesocomsionesareaventas
end on

on m_comisiones.destroy
call super::destroy
destroy(this.m_procesocomsionesareaventas)
end on

event clicked;if gs_depto='R' or gs_depto='B' or gs_depto='X' or gs_depto='M' or gs_depto='K' then	
	m_comisiones.m_procesocomsionesareaventas.visible															= true
	m_comisiones.m_procesocomsionesareaventas.m_exportaarchivocomisionesventas.visible				= false
	m_comisiones.m_procesocomsionesareaventas.m_exportaarchivocomisionesejecterreno.visible		= false
	m_comisiones.m_procesocomsionesareaventas.m_resumencomisionesporempresa.visible				= false
else
	m_comisiones.m_procesocomsionesareaventas.visible															= true
	m_comisiones.m_procesocomsionesareaventas.m_exportaarchivocomisionesventas.visible				= true
	m_comisiones.m_procesocomsionesareaventas.m_exportaarchivocomisionesejecterreno.visible		= true
	m_comisiones.m_procesocomsionesareaventas.m_resumencomisionesporempresa.visible				= true
end if
end event

