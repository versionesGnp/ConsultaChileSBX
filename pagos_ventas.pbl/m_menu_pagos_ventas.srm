this.m_exportaarchivocomisionesejecterreno=create m_exportaarchivocomisionesejecterreno
this.Item[UpperBound(this.Item)+1]=this.m_impresióncomisiones
this.Item[UpperBound(this.Item)+1]=this.m_resumencomisionesporempresa
