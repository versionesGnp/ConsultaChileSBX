 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cierre_prod_agente~" )  TABLE(NAME=~"agentes~" ) COLUMN(NAME=~"cierre_prod_agente.fecha_cierre~") COLUMN(NAME=~"cierre_prod_agente.cod_agente~") COLUMN(NAME=~"cierre_prod_agente.cant_promesa~") COLUMN(NAME=~"cierre_prod_agente.uf_promesa~") COLUMN(NAME=~"cierre_prod_agente.cant_liberador~") COLUMN(NAME=~"cierre_prod_agente.uf_liberador~") COLUMN(NAME=~"cierre_prod_agente.cant_aumento~") COLUMN(NAME=~"cierre_prod_agente.uf_aumento~") COLUMN(NAME=~"cierre_prod_agente.cod_supervisor~") COLUMN(NAME=~"cierre_prod_agente.cod_jefe~") COLUMN(NAME=~"agentes.cod_parque~") COLUMN(NAME=~"agentes.canal~")    JOIN (LEFT=~"cierre_prod_agente.cod_agente~"    OP =~"=~"RIGHT=~"agentes.cod_age~" )WHERE(    EXP1 =~"~~~"CIERRE_PROD_AGENTE~~~".~~~"FECHA_CIERRE~~~"~"   OP =~"=~"    EXP2 =~":cierre_venta~" ) ) ARG(NAME = ~"cierre_venta~" TYPE = datetime) " update="CIERRE_PROD_AGENTE" updatewhere=0 updatekeyinplace=yes arguments=(("cierre_venta", datetime))  sort="cod_agente A " )
