 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"vista_rezago_pendiente~" ) COLUMN(NAME=~"vista_rezago_pendiente.rut~") COLUMN(NAME=~"vista_rezago_pendiente.folio~") COLUMN(NAME=~"vista_rezago_pendiente.fecha_pago~") COLUMN(NAME=~"vista_rezago_pendiente.tipo_mov~") COLUMN(NAME=~"vista_rezago_pendiente.monto~") COLUMN(NAME=~"vista_rezago_pendiente.tipo_cob~") COLUMN(NAME=~"vista_rezago_pendiente.base~") COLUMN(NAME=~"vista_rezago_pendiente.serie~") COLUMN(NAME=~"vista_rezago_pendiente.numero~") COLUMN(NAME=~"vista_rezago_pendiente.nombre_cliente~") COLUMN(NAME=~"vista_rezago_pendiente.a_paterno_cliente~") COLUMN(NAME=~"vista_rezago_pendiente.a_materno_cliente~") COLUMN(NAME=~"vista_rezago_pendiente.ult_fecha_estado~") COLUMN(NAME=~"vista_rezago_pendiente.ult_estado~") COLUMN(NAME=~"vista_rezago_pendiente.descripcion~") COLUMN(NAME=~"vista_rezago_pendiente.cod_age~") COLUMN(NAME=~"vista_rezago_pendiente.nombre_age~") COLUMN(NAME=~"vista_rezago_pendiente.nombre_sup~") COLUMN(NAME=~"vista_rezago_pendiente.a_paterno_sup~") COLUMN(NAME=~"vista_rezago_pendiente.a_materno_sup~") COLUMN(NAME=~"vista_rezago_pendiente.cod_sup~") COLUMN(NAME=~"vista_rezago_pendiente.cod_jefe~") COLUMN(NAME=~"vista_rezago_pendiente.fecha_ing~") COLUMN(NAME=~"vista_rezago_pendiente.fecha_ini~")WHERE(    EXP1 =~"( ~~~"VISTA_REZAGO_PENDIENTE~~~".~~~"COD_SUP~~~"~"   OP =~"=~"    EXP2 =~":jefe )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"VISTA_REZAGO_PENDIENTE~~~".~~~"FECHA_PAGO~~~"~"   OP =~"<=~"    EXP2 =~":fecha )~" ) ) ARG(NAME = ~"jefe~" TYPE = string)  ARG(NAME = ~"fecha~" TYPE = datetime) " arguments=(("jefe", string),("fecha", datetime))  sort="cod_sup A fecha_pago A " )
