 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"jefe_ventas~" ) COLUMN(NAME=~"jefe_ventas.jefe_ventas~") COLUMN(NAME=~"jefe_ventas.nombre~") COLUMN(NAME=~"jefe_ventas.a_paterno~") COLUMN(NAME=~"jefe_ventas.a_materno~") COLUMN(NAME=~"jefe_ventas.fecha_ing~") COLUMN(NAME=~"jefe_ventas.fecha_fin~") COLUMN(NAME=~"jefe_ventas.estado~") COLUMN(NAME=~"jefe_ventas.rut~") COLUMN(NAME=~"jefe_ventas.porc_jefe_vta~") COLUMN(NAME=~"jefe_ventas.cod_parque~") COLUMN(NAME=~"jefe_ventas.canal~") COLUMN(NAME=~"jefe_ventas.depto~")WHERE(    EXP1 =~"~~~"JEFE_VENTAS~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'A'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"JEFE_VENTAS~~~".~~~"JEFE_VENTAS~~~"~"   OP =~"<>~"    EXP2 =~"'CJ'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"JEFE_VENTAS~~~".~~~"DEPTO~~~"~"   OP =~"<>~"    EXP2 =~"'E'~" ) ) " update="JEFE_VENTAS" updatewhere=1 updatekeyinplace=no )
