 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"vista_premios_semanales~" )  TABLE(NAME=~"cod_parq~" ) COLUMN(NAME=~"vista_premios_semanales.base~") COLUMN(NAME=~"vista_premios_semanales.serie~") COLUMN(NAME=~"vista_premios_semanales.numero~") COLUMN(NAME=~"vista_premios_semanales.estado_premio~") COLUMN(NAME=~"vista_premios_semanales.cadena_estado~") COLUMN(NAME=~"vista_premios_semanales.ult_estado_folio~") COLUMN(NAME=~"vista_premios_semanales.fecha_estado_folio~") COLUMN(NAME=~"vista_premios_semanales.mora_cred~") COLUMN(NAME=~"vista_premios_semanales.u_folio~") COLUMN(NAME=~"vista_premios_semanales.u_fecha~") COLUMN(NAME=~"vista_premios_semanales.precio~") COLUMN(NAME=~"vista_premios_semanales.uf_dia~") COLUMN(NAME=~"vista_premios_semanales.moneda~") COLUMN(NAME=~"vista_premios_semanales.total_pagado~") COLUMN(NAME=~"vista_premios_semanales.porce_pesos~") COLUMN(NAME=~"vista_premios_semanales.porce_uf~") COLUMN(NAME=~"vista_premios_semanales.uso~") COLUMN(NAME=~"vista_premios_semanales.fecha_ingreso~") COLUMN(NAME=~"vista_premios_semanales.cod_parque~") COLUMN(NAME=~"cod_parq.nombre~")    JOIN (LEFT=~"vista_premios_semanales.cod_parque~"    OP =~"=~"RIGHT=~"cod_parq.codigo~" )WHERE(    EXP1 =~"~~~"VISTA_PREMIOS_SEMANALES~~~".~~~"FECHA_ESTADO_FOLIO~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"VISTA_PREMIOS_SEMANALES~~~".~~~"FECHA_ESTADO_FOLIO~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"VISTA_PREMIOS_SEMANALES~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = date)  ARG(NAME = ~"fecha_fin~" TYPE = date)  ARG(NAME = ~"parque~" TYPE = number) " arguments=(("fecha_ini", date),("fecha_fin", date),("parque", number))  sort="c_porce A " )
