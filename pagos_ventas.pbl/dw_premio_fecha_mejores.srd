 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"promesa_lugar~" )  TABLE(NAME=~"premios_por_caja_mejores~" )  TABLE(NAME=~"agentes~" )  TABLE(NAME=~"supervisor~" ) COLUMN(NAME=~"promesa_lugar.codigo~") COLUMN(NAME=~"promesa_lugar.ufs~") COLUMN(NAME=~"promesa_lugar.uso~") COLUMN(NAME=~"promesa_lugar.lugar~") COLUMN(NAME=~"promesa_lugar.agente~") COLUMN(NAME=~"promesa_lugar.monto~") COLUMN(NAME=~"promesa_lugar.codigo_premio~") COLUMN(NAME=~"promesa_lugar.fecha~") COLUMN(NAME=~"premios_por_caja_mejores.descripcion~") COLUMN(NAME=~"agentes.nombre~") COLUMN(NAME=~"agentes.a_paterno~") COLUMN(NAME=~"agentes.a_materno~") COLUMN(NAME=~"supervisor.nombre~") COLUMN(NAME=~"supervisor.a_paterno~") COLUMN(NAME=~"supervisor.a_materno~")    JOIN (LEFT=~"promesa_lugar.codigo~"    OP =~"=~"RIGHT=~"agentes.cod_age~"    OUTER1 =~"promesa_lugar.codigo~" )    JOIN (LEFT=~"promesa_lugar.codigo~"    OP =~"=~"RIGHT=~"supervisor.cod_sup~"    OUTER1 =~"promesa_lugar.codigo~" )    JOIN (LEFT=~"promesa_lugar.uso~"    OP =~"=~"RIGHT=~"premios_por_caja_mejores.canal~" )    JOIN (LEFT=~"promesa_lugar.agente~"    OP =~"=~"RIGHT=~"premios_por_caja_mejores.tipo_empleado~" )    JOIN (LEFT=~"promesa_lugar.lugar~"    OP =~"=~"RIGHT=~"premios_por_caja_mejores.codigo~" )WHERE(    EXP1 =~"~~~"PROMESA_LUGAR~~~".~~~"FECHA~~~"~"   OP =~"=~"    EXP2 =~":FECHA_FIN~" ) ) ORDER(NAME=~"promesa_lugar.agente~" ASC=yes )  ORDER(NAME=~"promesa_lugar.uso~" ASC=yes )  ORDER(NAME=~"promesa_lugar.lugar~" ASC=yes ) ARG(NAME = ~"FECHA_FIN~" TYPE = date) " arguments=(("FECHA_FIN", date)) )
