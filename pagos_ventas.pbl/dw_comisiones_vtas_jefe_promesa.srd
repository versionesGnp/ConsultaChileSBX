 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"res_comi~" )  TABLE(NAME=~"oferta_v~" )  TABLE(NAME=~"pago_oferta~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"jefe_ventas~" ALIAS=~"jefe_ventas_a~" )  TABLE(NAME=~"jefe_ventas~" ALIAS=~"jefe_ventas_b~" ) COLUMN(NAME=~"res_comi.cod_age_sup~") COLUMN(NAME=~"res_comi.mont_age_sup~") COLUMN(NAME=~"res_comi.cod_contable~") COLUMN(NAME=~"res_comi.mes~") COLUMN(NAME=~"res_comi.fecha~") COLUMN(NAME=~"res_comi.porc_venta~") COLUMN(NAME=~"res_comi.precio~") COLUMN(NAME=~"res_comi.total_pago~") COLUMN(NAME=~"res_comi.valor_uf~") COLUMN(NAME=~"res_comi.haber~") COLUMN(NAME=~"res_comi.moneda~") COLUMN(NAME=~"res_comi.codigo_com~") COLUMN(NAME=~"res_comi.estado_age_sup~") COLUMN(NAME=~"pago_oferta.area~") COLUMN(NAME=~"oferta_v.uso~") COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"jefe_ventas_a.jefe_ventas~") COLUMN(NAME=~"jefe_ventas_a.nombre~") COLUMN(NAME=~"jefe_ventas_a.a_paterno~") COLUMN(NAME=~"jefe_ventas_a.a_materno~") COLUMN(NAME=~"jefe_ventas_a.rut~") COLUMN(NAME=~"cadena.cod_parque~") COLUMN(NAME=~"res_comi.serie~") COLUMN(NAME=~"res_comi.contrato~") COLUMN(NAME=~"oferta_v.rut~") COLUMN(NAME=~"cadena.rut~") COLUMN(NAME=~"oferta_v.clasifica_venta~") COLUMN(NAME=~"oferta_v.porce_ing_cierre~") COLUMN(NAME=~"jefe_ventas_b.depto~")    JOIN (LEFT=~"oferta_v.serie~"    OP =~"=~"RIGHT=~"pago_oferta.serie~" )    JOIN (LEFT=~"res_comi.serie~"    OP =~"=~"RIGHT=~"oferta_v.serie~" )    JOIN (LEFT=~"res_comi.contrato~"    OP =~"=~"RIGHT=~"oferta_v.nro_oferta~" )    JOIN (LEFT=~"oferta_v.nro_oferta~"    OP =~"=~"RIGHT=~"pago_oferta.nro_oferta~" )    JOIN (LEFT=~"oferta_v.ult_folio~"    OP =~"=~"RIGHT=~"pago_oferta.folio~" )    JOIN (LEFT=~"pago_oferta.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"pago_oferta.nro_oferta~"    OP =~"=~"RIGHT=~"cadena.numero~" )    JOIN (LEFT=~"res_comi.cod_age_sup~"    OP =~"=~"RIGHT=~"jefe_ventas_a.jefe_ventas~" )    JOIN (LEFT=~"oferta_v.cod_jef~"    OP =~"=~"RIGHT=~"jefe_ventas_b.jefe_ventas~" )WHERE(    EXP1 =~"~~~"RES_COMI~~~".~~~"FECHA~~~"~"   OP =~"=~"    EXP2 =~":fecha_comi~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"JEFE_VENTAS_A~~~".~~~"DEPTO~~~"~"   OP =~"=~"    EXP2 =~"'K'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"JEFE_VENTAS_A~~~".~~~"DEPTO~~~"~"   OP =~"=~"    EXP2 =~"'M'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"JEFE_VENTAS_A~~~".~~~"DEPTO~~~"~"   OP =~"=~"    EXP2 =~"'R'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"JEFE_VENTAS_A~~~".~~~"DEPTO~~~"~"   OP =~"=~"    EXP2 =~"'B'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"JEFE_VENTAS_A~~~".~~~"DEPTO~~~"~"   OP =~"=~"    EXP2 =~"'X')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"JEFE_VENTAS_A~~~".~~~"CANAL~~~"~"   OP =~"<>~"    EXP2 =~"'NI'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"RES_COMI~~~".~~~"COD_CONTABLE~~~"~"   OP =~"=~"    EXP2 =~"'023'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"RES_COMI~~~".~~~"COD_CONTABLE~~~"~"   OP =~"=~"    EXP2 =~"'037'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"RES_COMI~~~".~~~"COD_CONTABLE~~~"~"   OP =~"=~"    EXP2 =~"'066'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"RES_COMI~~~".~~~"COD_CONTABLE~~~"~"   OP =~"=~"    EXP2 =~"'089'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"RES_COMI~~~".~~~"COD_CONTABLE~~~"~"   OP =~"=~"    EXP2 =~"'090')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'O'~" ) ) ARG(NAME = ~"fecha_comi~" TYPE = datetime) " arguments=(("fecha_comi", datetime))  sort="res_comi_cod_age_sup A res_comi_cod_contable A " )
