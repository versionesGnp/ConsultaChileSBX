 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"agentes~" )  TABLE(NAME=~"oferta_v~" )  TABLE(NAME=~"pago_oferta~" ) COLUMN(NAME=~"oferta_v.serie~") COLUMN(NAME=~"oferta_v.nro_oferta~") COLUMN(NAME=~"pago_oferta.precio~") COLUMN(NAME=~"pago_oferta.uf_dia~") COLUMN(NAME=~"pago_oferta.moneda~") COLUMN(NAME=~"oferta_v.cod_age~") COLUMN(NAME=~"agentes.nombre~") COLUMN(NAME=~"agentes.a_paterno~") COLUMN(NAME=~"agentes.a_materno~") COLUMN(NAME=~"agentes.clasificacion~") COLUMN(NAME=~"agentes.vsp~") COLUMN(NAME=~"agentes.canal~")    JOIN (LEFT=~"agentes.cod_age~"    OP =~"=~"RIGHT=~"oferta_v.cod_age~" )    JOIN (LEFT=~"oferta_v.serie~"    OP =~"=~"RIGHT=~"pago_oferta.serie~" )    JOIN (LEFT=~"oferta_v.nro_oferta~"    OP =~"=~"RIGHT=~"pago_oferta.nro_oferta~" )    JOIN (LEFT=~"oferta_v.ult_folio~"    OP =~"=~"RIGHT=~"pago_oferta.folio~" )WHERE(    EXP1 =~"~~~"OFERTA_V~~~".~~~"U_FECHA~~~"~"   OP =~">=~"    EXP2 =~":FECHA_INI~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"OFERTA_V~~~".~~~"U_FECHA~~~"~"   OP =~"<=~"    EXP2 =~":FECHA_FIN~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"AGENTES~~~".~~~"CANAL~~~"~"   OP =~"=~"    EXP2 =~":CANAL~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"AGENTES~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":PARQUE~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"OFERTA_V~~~".~~~"SERIE~~~"~"   OP =~"<>~"    EXP2 =~"'R'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"AGENTES~~~".~~~"COD_AGE~~~"~"   OP =~"<>~"    EXP2 =~"'CA'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"OFERTA_V~~~".~~~"ESTADO_PREMIO~~~"~"   OP =~"=~"    EXP2 =~"'N'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"OFERTA_V~~~".~~~"CIERRE_VENTA~~~"~"   OP =~"is~"    EXP2 =~"NULL~" ) )    UNION (PBSELECT( VERSION(400) TABLE(NAME=~"agentes~" )  TABLE(NAME=~"anexo_liberador~" )  TABLE(NAME=~"pago_liberador~" ) COLUMN(NAME=~"anexo_liberador.serie_m~") COLUMN(NAME=~"anexo_liberador.nro_liberador~") COLUMN(NAME=~"pago_liberador.precio~") COLUMN(NAME=~"pago_liberador.uf_dia~") COLUMN(NAME=~"pago_liberador.moneda~") COLUMN(NAME=~"anexo_liberador.cod_agente~") COLUMN(NAME=~"agentes.nombre~") COLUMN(NAME=~"agentes.a_paterno~") COLUMN(NAME=~"agentes.a_materno~") COLUMN(NAME=~"agentes.clasificacion~") COLUMN(NAME=~"agentes.vsp~") COLUMN(NAME=~"agentes.canal~")    JOIN (LEFT=~"agentes.cod_age~"    OP =~"=~"RIGHT=~"anexo_liberador.cod_agente~" )    JOIN (LEFT=~"anexo_liberador.serie_m~"    OP =~"=~"RIGHT=~"pago_liberador.serie_m~" )    JOIN (LEFT=~"anexo_liberador.nro_liberador~"    OP =~"=~"RIGHT=~"pago_liberador.nro_liberador~" )    JOIN (LEFT=~"anexo_liberador.ult_folio~"    OP =~"=~"RIGHT=~"pago_liberador.folio~" )WHERE(    EXP1 =~"~~~"ANEXO_LIBERADOR~~~".~~~"U_FECHA~~~"~"   OP =~">=~"    EXP2 =~":FECHA_INI~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"ANEXO_LIBERADOR~~~".~~~"U_FECHA~~~"~"   OP =~"<=~"    EXP2 =~":FECHA_FIN~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"AGENTES~~~".~~~"CANAL~~~"~"   OP =~"=~"    EXP2 =~":CANAL~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"ANEXO_LIBERADOR~~~".~~~"SERIE_M~~~"~"   OP =~"<>~"    EXP2 =~"'R'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"AGENTES~~~".~~~"COD_AGE~~~"~"   OP =~"<>~"    EXP2 =~"'CA'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"ANEXO_LIBERADOR~~~".~~~"ESTADO_PREMIO~~~"~"   OP =~"=~"    EXP2 =~"'N'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"ANEXO_LIBERADOR~~~".~~~"CIERRE_VENTA~~~"~"   OP =~"is~"    EXP2 =~"NULL~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"AGENTES~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":PARQUE~" ) )) ARG(NAME = ~"FECHA_INI~" TYPE = date)  ARG(NAME = ~"FECHA_FIN~" TYPE = date)  ARG(NAME = ~"CANAL~" TYPE = string)  ARG(NAME = ~"PARQUE~" TYPE = number) " arguments=(("FECHA_INI", date),("FECHA_FIN", date),("CANAL", string),("PARQUE", number))  sort="oferta_v_cod_age A " )
