 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"ingreso~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"at_gestion~" )  TABLE(NAME=~"oferta_v~" )  TABLE(NAME=~"pago_oferta~" )  TABLE(NAME=~"encargados~" )  TABLE(NAME=~"comision_atencion_terreno~" ) COLUMN(NAME=~"at_gestion.usuario_asignado~") COLUMN(NAME=~"pago_oferta.nro_cuotas~") COLUMN(NAME=~"encargados.nombre~") COLUMN(NAME=~"encargados.rut~") COLUMN(NAME=~"comision_atencion_terreno.uno~") COLUMN(NAME=~"comision_atencion_terreno.dos~") COLUMN(NAME=~"comision_atencion_terreno.tres~") COLUMN(NAME=~"comision_atencion_terreno.cuatro~") COLUMN(NAME=~"comision_atencion_terreno.cinco~") COLUMN(NAME=~"comision_atencion_terreno.seis~") COLUMN(NAME=~"comision_atencion_terreno.siete~") COLUMN(NAME=~"comision_atencion_terreno.ocho~") COLUMN(NAME=~"comision_atencion_terreno.nueve~") COLUMN(NAME=~"comision_atencion_terreno.dies~") COLUMN(NAME=~"comision_atencion_terreno.once~") COLUMN(NAME=~"comision_atencion_terreno.doce~") COLUMN(NAME=~"ingreso.cuotas_pag~") COLUMN(NAME=~"oferta_v.cta_pag_s~") COLUMN(NAME=~"oferta_v.serie~") COLUMN(NAME=~"oferta_v.nro_oferta~") COLUMN(NAME=~"pago_oferta.moneda~") COLUMN(NAME=~"pago_oferta.precio~") COLUMN(NAME=~"ingreso.cod_caja~") COLUMN(NAME=~"ingreso.monto~") COLUMN(NAME=~"at_gestion.fecha_crea~") COLUMN(NAME=~"ingreso.folio~") COLUMN(NAME=~"ingreso.fecha_pago~") COLUMN(NAME=~"cadena.cod_parque~")    JOIN (LEFT=~"ingreso.base~"    OP =~"=~"RIGHT=~"cadena.codigo~" )    JOIN (LEFT=~"ingreso.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"ingreso.contrato~"    OP =~"=~"RIGHT=~"cadena.numero~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"at_gestion.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"at_gestion.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"at_gestion.numero~" )    JOIN (LEFT=~"oferta_v.serie~"    OP =~"=~"RIGHT=~"pago_oferta.serie~" )    JOIN (LEFT=~"oferta_v.nro_oferta~"    OP =~"=~"RIGHT=~"pago_oferta.nro_oferta~" )    JOIN (LEFT=~"oferta_v.ult_folio~"    OP =~"=~"RIGHT=~"pago_oferta.folio~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"oferta_v.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"oferta_v.nro_oferta~" )    JOIN (LEFT=~"at_gestion.usuario_asignado~"    OP =~"=~"RIGHT=~"encargados.codigo_usuario~" )WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'O'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"CADENA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'V'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'C')~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"(~~~"INGRESO~~~".~~~"FECHA_PAGO~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"FECHA_PAGO~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"PAGO_OFERTA~~~".~~~"NRO_CUOTAS~~~"~"   OP =~">=~"    EXP2 =~"~~~"COMISION_ATENCION_TERRENO~~~".~~~"CRED_MIN~~~"~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"PAGO_OFERTA~~~".~~~"NRO_CUOTAS~~~"~"   OP =~"<=~"    EXP2 =~"~~~"COMISION_ATENCION_TERRENO~~~".~~~"CRED_MAX~~~")~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"PAGO_OFERTA~~~".~~~"NRO_CUOTAS~~~"~"   OP =~">=~"    EXP2 =~"24~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"CONTRATO~~~"~"   OP =~"=~"    EXP2 =~":numero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"CUOTAS_PAG~~~"~"   OP =~"=~"    EXP2 =~"1~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"INGRESO~~~".~~~"TIPO_COB~~~"~"   OP =~"=~"    EXP2 =~"'CI'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"TIPO_COB~~~"~"   OP =~"=~"    EXP2 =~"'CU'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"TIPO_COB~~~"~"   OP =~"=~"    EXP2 =~"'CC'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"TIPO_COB~~~"~"   OP =~"=~"    EXP2 =~"'C0')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"INGRESO~~~".~~~"TIPO_MOV~~~"~"   OP =~"=~"    EXP2 =~"'K'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"TIPO_MOV~~~"~"   OP =~"=~"    EXP2 =~"'E')~" ) ) ORDER(NAME=~"at_gestion.usuario_asignado~" ASC=yes ) ARG(NAME = ~"fecha_ini~" TYPE = datetime)  ARG(NAME = ~"fecha_fin~" TYPE = datetime)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number)  ARG(NAME = ~"ctas_pag_comi~" TYPE = number) " arguments=(("fecha_ini", datetime),("fecha_fin", datetime),("serie", string),("numero", number),("ctas_pag_comi", number))  sort="ingreso_fecha_pago A " )
