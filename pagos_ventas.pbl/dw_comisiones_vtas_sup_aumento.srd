 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"res_comi~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"supervisor~" )  TABLE(NAME=~"anexo_aumento~" )  TABLE(NAME=~"pago_aumento~" ) COLUMN(NAME=~"res_comi.cod_age_sup~") COLUMN(NAME=~"res_comi.mont_age_sup~") COLUMN(NAME=~"res_comi.cod_contable~") COLUMN(NAME=~"res_comi.mes~") COLUMN(NAME=~"res_comi.fecha~") COLUMN(NAME=~"res_comi.porc_venta~") COLUMN(NAME=~"res_comi.precio~") COLUMN(NAME=~"res_comi.total_pago~") COLUMN(NAME=~"res_comi.valor_uf~") COLUMN(NAME=~"res_comi.haber~") COLUMN(NAME=~"res_comi.moneda~") COLUMN(NAME=~"res_comi.codigo_com~") COLUMN(NAME=~"res_comi.estado_age_sup~") COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"supervisor.cod_sup~") COLUMN(NAME=~"supervisor.nombre~") COLUMN(NAME=~"supervisor.a_paterno~") COLUMN(NAME=~"supervisor.a_materno~") COLUMN(NAME=~"supervisor.rut~") COLUMN(NAME=~"supervisor.cod_jefe~") COLUMN(NAME=~"supervisor.canal~") COLUMN(NAME=~"cadena.cod_parque~") COLUMN(NAME=~"res_comi.serie~") COLUMN(NAME=~"res_comi.contrato~") COLUMN(NAME=~"cadena.rut~") COLUMN(NAME=~"anexo_aumento.area~") COLUMN(NAME=~"anexo_aumento.uso~") COLUMN(NAME=~"anexo_aumento.porce_ing_cierre~") COLUMN(NAME=~"anexo_aumento.clasifica_venta~")    JOIN (LEFT=~"supervisor.cod_sup~"    OP =~"=~"RIGHT=~"res_comi.cod_age_sup~" )    JOIN (LEFT=~"res_comi.serie~"    OP =~"=~"RIGHT=~"anexo_aumento.serie_m~" )    JOIN (LEFT=~"res_comi.contrato~"    OP =~"=~"RIGHT=~"anexo_aumento.nro_aumento~" )    JOIN (LEFT=~"anexo_aumento.serie_m~"    OP =~"=~"RIGHT=~"pago_aumento.serie_m~" )    JOIN (LEFT=~"anexo_aumento.nro_aumento~"    OP =~"=~"RIGHT=~"pago_aumento.nro_aumento~" )    JOIN (LEFT=~"anexo_aumento.ult_folio~"    OP =~"=~"RIGHT=~"pago_aumento.folio~" )    JOIN (LEFT=~"pago_aumento.serie_m~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"pago_aumento.nro_aumento~"    OP =~"=~"RIGHT=~"cadena.numero~" )WHERE(    EXP1 =~"~~~"RES_COMI~~~".~~~"FECHA~~~"~"   OP =~"=~"    EXP2 =~":fecha_comi~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"RES_COMI~~~".~~~"COD_CONTABLE~~~"~"   OP =~"=~"    EXP2 =~"'050'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"RES_COMI~~~".~~~"COD_CONTABLE~~~"~"   OP =~"=~"    EXP2 =~"'028')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"SUPERVISOR~~~".~~~"DEPTO~~~"~"   OP =~"=~"    EXP2 =~"'R'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"SUPERVISOR~~~".~~~"DEPTO~~~"~"   OP =~"=~"    EXP2 =~"'X')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'A'~" ) ) ARG(NAME = ~"fecha_comi~" TYPE = datetime) " arguments=(("fecha_comi", datetime))  sort="supervisor_cod_jefe A supervisor_cod_sup A res_comi_cod_contable D " )
