  OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"pago_oferta.nro_oferta~" )    JOIN (LEFT=~"oferta_v.cod_age~"    OP =~"=~"RIGHT=~"agentes.cod_age~" )    JOIN (LEFT=~"oferta_v.cod_sup~"    OP =~"=~"RIGHT=~"supervisor.cod_sup~" )    JOIN (LEFT=~"oferta_v.cod_jef~"    OP =~"=~"RIGHT=~"jefe_ventas.jefe_ventas~" )WHERE(    EXP1 =~"((~~~"INGRESO~~~".~~~"TIPO_MOV~~~"~"   OP =~"=~"    EXP2 =~"'A')~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"( ~~~"INGRESO~~~".~~~"TIPO_MOV~~~"~"   OP =~"=~"    EXP2 =~"'E')~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"( ~~~"INGRESO~~~".~~~"TIPO_MOV~~~"~"   OP =~"=~"    EXP2 =~"'I')~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"( ~~~"INGRESO~~~".~~~"TIPO_MOV~~~"~"   OP =~"=~"    EXP2 =~"'K'))~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"INGRESO~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~"'O')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"((~~~"INGRESO~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~"'M')~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"( ~~~"INGRESO~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~"'S')~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"( ~~~"INGRESO~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~"'I'))~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"CONTRATO~~~"~"   OP =~"<>~"    EXP2 =~"0~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"FECHA_PAGO~~~"~"   OP =~"<=~"    EXP2 =~":fecha~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"OFERTA_V~~~".~~~"ESTADO_COMI~~~"~"   OP =~"<>~"    EXP2 =~"'P'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'O'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"OFERTA_V~~~".~~~"ESTATUS_COMISION~~~"~"   OP =~"=~"    EXP2 =~"'0'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"CADENA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'C'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'V')~" ) ) ORDER(NAME=~"ingreso.serie~" ASC=yes )  ORDER(NAME=~"ingreso.contrato~" ASC=yes ) ARG(NAME = ~"fecha~" TYPE = datetim