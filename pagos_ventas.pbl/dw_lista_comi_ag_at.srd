 column=(type=decimal(0) updatewhereclause=yes name=agentes_rut dbname="agentes.rut" )
 column=(type=char(1) updatewhereclause=yes name=cliente_dv dbname="cliente.dv" )
 column=(type=datetime updatewhereclause=yes name=at_gestion_fecha_crea dbname="at_gestion.fecha_crea" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cadena~" )  TABLE(NAME=~"at_gestion~" )  TABLE(NAME=~"cliente~" )  TABLE(NAME=~"agentes~" ) COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"cadena.serie~") COLUMN(NAME=~"cadena.numero~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"cadena.cod_parque~") COLUMN(NAME=~"at_gestion.codigo_grupo~") COLUMN(NAME=~"at_gestion.estado_gestion~") COLUMN(NAME=~"at_gestion.usuario_asignado~") COLUMN(NAME=~"cliente.rut~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COMPUTE(NAME=~":fecha_fin as fecha_fin~") COMPUTE(NAME=~"0 as monto_comi~") COLUMN(NAME=~"at_gestion.estado_comi~") COLUMN(NAME=~"at_gestion.tipo_gestion~") COLUMN(NAME=~"agentes.rut~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"at_gestion.fecha_crea~")    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"at_gestion.serie~" )    JOIN (LEFT=~"at_gestion.base~"    OP =~"=~"RIGHT=~"cadena.codigo~" )    JOIN (LEFT=~"at_gestion.numero~"    OP =~"=~"RIGHT=~"cadena.numero~" )    JOIN (LEFT=~"cadena.rut~"    OP =~"=~"RIGHT=~"cliente.rut~" )    JOIN (LEFT=~"at_gestion.usuario_asignado~"    OP =~"=~"RIGHT=~"agentes.cod_age~" )WHERE(    EXP1 =~"~~~"AT_GESTION~~~".~~~"FECHA_CREA~~~"~"   OP =~">=~"    EXP2 =~"TO_DATE('01-01-2013 00:00:00','DD-MM-YYYY HH24:MI:SS')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"AT_GESTION~~~".~~~"FECHA_CREA~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"AT_GESTION~~~".~~~"ESTADO_COMI~~~"~"   OP =~"=~"    EXP2 =~"'N'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"AGENTES~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'A'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"AT_GESTION~~~".~~~"ESTADO_GESTION~~~"~"   OP =~"=~"    EXP2 =~"'G'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"(~~~"AT_GESTION~~~".~~~"TIPO_GESTION~~~"~"   OP =~"=~"    EXP2 =~"2~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"AT_GESTION~~~".~~~"TIPO_GESTION~~~"~"   OP =~"=~"    EXP2 =~"3)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"AT_GESTION~~~".~~~"TIPO_COBRANZA~~~"~"   OP =~"=~"    EXP2 =~":tipo_cob~" ) ) ARG(NAME = ~"fecha_fin~" TYPE = datetime)  ARG(NAME = ~"tipo_cob~" TYPE = string) " arguments=(("fecha_fin", datetime),("tipo_cob", string))  sort="at_gestion_usuario_asignado A " )
