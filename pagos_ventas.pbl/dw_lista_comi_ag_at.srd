 column=(type=decimal(4) updatewhereclause=yes name=cadena_cod_parque dbname="cadena.cod_parque" )
 column=(type=decimal(4) updatewhereclause=yes name=at_gestion_codigo_grupo dbname="at_gestion.codigo_grupo" )
 column=(type=char(1) updatewhereclause=yes name=at_gestion_estado_gestion dbname="at_gestion.estado_gestion" )
