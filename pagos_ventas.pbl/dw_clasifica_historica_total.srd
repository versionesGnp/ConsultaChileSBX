st_sup.nombre~") COLUMN(NAME=~"vista_clasifica_hist_sup.a_paterno~") COLUMN(NAME=~"vista_clasifica_hist_sup.a_materno~")WHERE(    EXP1 =~"~~~"VISTA_CLASIFICA_HIST_SUP~~~".~~~"COD_SUP~~~"~"   OP =~"=~"    EXP2 =~":codigo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"VISTA_CLASIFICA_HIST_SUP~~~".~~~"FECHA_CLASIFICA_SUP~~~"~"   OP =~"<=~"    EXP2 =~":fecha~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"VISTA_CLASIFICA_HIST_SUP~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~" ) )) ARG(NAME = ~"codigo~" TYPE = string)  ARG(NAME = ~"fecha~" TYPE = datetime)  ARG(NAME = ~"parque~" TYPE = number) " arguments=(("codigo", string),("fecha", datetime),("parque", number))  sort="fecha_clasifica D " )
