 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"supervisor_heredado~" )  TABLE(NAME=~"supervisor~" ) COLUMN(NAME=~"supervisor.cod_sup~") COLUMN(NAME=~"supervisor.nombre~") COLUMN(NAME=~"supervisor.a_paterno~") COLUMN(NAME=~"supervisor.a_materno~") COLUMN(NAME=~"supervisor_heredado.correl~")    JOIN (LEFT=~"supervisor_heredado.cod_sup_heredado~"    OP =~"=~"RIGHT=~"supervisor.cod_sup~" )WHERE(    EXP1 =~"~~~"SUPERVISOR_HEREDADO~~~".~~~"COD_SUP~~~"~"   OP =~"=~"    EXP2 =~":gs_user~" ) )    UNION (PBSELECT( VERSION(400) TABLE(NAME=~"supervisor_heredado~" )  TABLE(NAME=~"jefe_ventas~" ) COLUMN(NAME=~"jefe_ventas.jefe_ventas~") COLUMN(NAME=~"jefe_ventas.nombre~") COLUMN(NAME=~"jefe_ventas.a_paterno~") COLUMN(NAME=~"jefe_ventas.a_materno~") COLUMN(NAME=~"supervisor_heredado.correl~")    JOIN (LEFT=~"supervisor_heredado.cod_sup_heredado~"    OP =~"=~"RIGHT=~"jefe_ventas.jefe_ventas~" )WHERE(    EXP1 =~"~~~"SUPERVISOR_HEREDADO~~~".~~~"COD_SUP~~~"~"   OP =~"=~"    EXP2 =~":gs_user~" ) )) ARG(NAME = ~"gs_user~" TYPE = string) " arguments=(("gs_user", string))  sort="supervisor_heredado_correl A " )
