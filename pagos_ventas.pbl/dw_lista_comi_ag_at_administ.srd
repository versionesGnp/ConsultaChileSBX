 column=(type=datetime updatewhereclause=yes name=at_gestion_fec_fin dbname="at_gestion.fec_fin" dbalias=".fec_fin" )
 column=(type=decimal(4) updatewhereclause=yes name=at_gestion_monto dbname="at_gestion.monto" dbalias=".monto" )
 column=(type=number updatewhereclause=yes name=mto_min dbname="mto_min" )
 column=(type=char(2) updatewhereclause=yes name=at_gestion_concepto dbname="at_gestion.concepto" dbalias=".concepto" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cadena~" )  TABLE(NAME=~"at_gestion~" )  TABLE(NAME=~"at_lista_gestion~" )  TABLE(NAME=~"cliente~" )  TABLE(NAME=~"agentes~" ) COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"cadena.serie~") COLUMN(NAME=~"cadena.numero~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"cadena.cod_parque~") COLUMN(NAME=~"at_gestion.codigo_grupo~") COLUMN(NAME=~"at_gestion.estado_gestion~") COLUMN(NAME=~"at_gestion.usuario_asignado~") COLUMN(NAME=~"at_lista_gestion.fecha_crea~") COLUMN(NAME=~"cliente.rut~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"at_gestion.estado_comi~") COLUMN(NAME=~"at_gestion.tipo_gestion~") COLUMN(NAME=~"agentes.rut~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"agentes.estado~") COLUMN(NAME=~"at_gestion.tipo_cobranza~") COMPUTE(NAME=~"'' as pasa~") COLUMN(NAME=~"at_gestion.fec_ini~") COLUMN(NAME=~"at_gestion.fec_fin~") COLUMN(NAME=~"at_gestion.monto~") COMPUTE(NAME=~"0 as mto_min~") COLUMN(NAME=~"at_gestion.concepto~")    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"at_gestion.serie~" )    JOIN (LEFT=~"at_gestion.codigo_grupo~"    OP =~"=~"RIGHT=~"at_lista_gestion.codigo_grupo~" )    JOIN (LEFT=~"at_gestion.base~"    OP =~"=~"RIGHT=~"cadena.codigo~" )    JOIN (LEFT=~"at_gestion.numero~"    OP =~"=~"RIGHT=~"cadena.numero~" )    JOIN (LEFT=~"cadena.rut~"    OP =~"=~"RIGHT=~"cliente.rut~" )    JOIN (LEFT=~"at_gestion.usuario_asignado~"    OP =~"=~"RIGHT=~"agentes.cod_age~" )WHERE(    EXP1 =~"~~~"AT_LISTA_GESTION~~~".~~~"FECHA_CREA~~~"~"   OP =~">=~"    EXP2 =~"TO_DATE('01-01-2013 00:00:00','DD-MM-YYYY HH24:MI:SS')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"AT_GESTION~~~".~~~"ESTADO_COMI~~~"~"   OP =~"<>~"    EXP2 =~"'P'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"AT_GESTION~~~".~~~"TIPO_COBRANZA~~~"~"   OP =~"=~"    EXP2 =~":tipo_gestion~" ) ) ARG(NAME = ~"tipo_gestion~" TYPE = string) " filter=" at_gestion_estado_comi <>'X' and  at_gestion_estado_comi <>'P' and agentes_estado='A' "arguments=(("tipo_gestion", string))  sort="at_gestion_usuario_asignado A at_lista_gestion_fecha_crea A " )
