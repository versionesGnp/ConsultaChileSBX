 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"clasifica_hist~" )  TABLE(NAME=~"agentes~" ) COLUMN(NAME=~"clasifica_hist.cod_age~") COLUMN(NAME=~"clasifica_hist.fecha_clasifica~") COLUMN(NAME=~"clasifica_hist.tipo_clasifica~") COLUMN(NAME=~"clasifica_hist.mora_clasifica~") COLUMN(NAME=~"clasifica_hist.contratos_clasifica~") COLUMN(NAME=~"clasifica_hist.porce_clasifica~") COLUMN(NAME=~"clasifica_hist.vsp~") COLUMN(NAME=~"agentes.depto~") COLUMN(NAME=~"agentes.fecha_ini~") COLUMN(NAME=~"agentes.fecha_fin~") COLUMN(NAME=~"agentes.estado~")    JOIN (LEFT=~"clasifica_hist.cod_age~"    OP =~"=~"RIGHT=~"agentes.cod_age~" )WHERE(    EXP1 =~"~~~"CLASIFICA_HIST~~~".~~~"COD_AGE~~~"~"   OP =~"=~"    EXP2 =~":codigo~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CLASIFICA_HIST~~~".~~~"FECHA_CLASIFICA~~~"~"   OP =~"<=~"    EXP2 =~":fecha~" ) )    UNION (PBSELECT( VERSION(400) TABLE(NAME=~"clasifica_hist_sup~" )  TABLE(NAME=~"supervisor~" ) COLUMN(NAME=~"clasifica_hist_sup.cod_sup~") COLUMN(NAME=~"clasifica_hist_sup.fecha_clasifica_sup~") COLUMN(NAME=~"clasifica_hist_sup.tipo_clasifica_sup~") COLUMN(NAME=~"clasifica_hist_sup.mora_clasifica_sup~") COLUMN(NAME=~"clasifica_hist_sup.contratos_clasifica_sup~") COLUMN(NAME=~"clasifica_hist_sup.porce_clasifica_sup~") COLUMN(NAME=~"clasifica_hist_sup.vsp~") COLUMN(NAME=~"supervisor.depto~") COLUMN(NAME=~"supervisor.fecha_ing~") COLUMN(NAME=~"supervisor.fecha_fin~") COLUMN(NAME=~"supervisor.estado~")    JOIN (LEFT=~"clasifica_hist_sup.cod_sup~"    OP =~"=~"RIGHT=~"supervisor.cod_sup~" )WHERE(    EXP1 =~"~~~"CLASIFICA_HIST_SUP~~~".~~~"COD_SUP~~~"~"   OP =~"=~"    EXP2 =~":codigo~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CLASIFICA_HIST_SUP~~~".~~~"FECHA_CLASIFICA_SUP~~~"~"   OP =~"<=~"    EXP2 =~":fecha~" ) )) ARG(NAME = ~"codigo~" TYPE = string)  ARG(NAME = ~"fecha~" TYPE = datetime) " arguments=(("codigo", string),("fecha", datetime))  sort="fecha_clasifica D " )
