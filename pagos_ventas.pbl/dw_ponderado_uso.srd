 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"conven_uso_ponderado~" ) COLUMN(NAME=~"conven_uso_ponderado.uso~") COLUMN(NAME=~"conven_uso_ponderado.cod_parque~") COLUMN(NAME=~"conven_uso_ponderado.tipo~") COLUMN(NAME=~"conven_uso_ponderado.fecha~") COLUMN(NAME=~"conven_uso_ponderado.puntos~")WHERE(    EXP1 =~"~~~"CONVEN_USO_PONDERADO~~~".~~~"FECHA~~~"~"   OP =~"=~"    EXP2 =~":fecha~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CONVEN_USO_PONDERADO~~~".~~~"TIPO~~~"~"   OP =~"=~"    EXP2 =~":tipo~" ) ) ARG(NAME = ~"fecha~" TYPE = datetime)  ARG(NAME = ~"tipo~" TYPE = string) " arguments=(("fecha", datetime),("tipo", string))  sort="cod_parque A uso A " )
