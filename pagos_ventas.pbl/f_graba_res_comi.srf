forward prototypes
global function long f_graba_res_comi (string as_cod_age_sup, long al_rut, long al_monto, string as_cod_contab, string as_mes, datetime adt_fecha, double adb_contrato, string as_serie, double adb_porc_ing_caja, double adb_porc_venta, double adb_precio, long al_total_pago, double adb_valor_uf, string as_haber, string as_moneda, string as_cod_com, string as_estado_age, string as_base, long al_cod_parque, double adb_producc, long al_vtas)
end prototypes

global function long f_graba_res_comi (string as_cod_age_sup, long al_rut, long al_monto, string as_cod_contab, string as_mes, datetime adt_fecha, double adb_contrato, string as_serie, double adb_porc_ing_caja, double adb_porc_venta, double adb_precio, long al_total_pago, double adb_valor_uf, string as_haber, string as_moneda, string as_cod_com, string as_estado_age, string as_base, long al_cod_parque, double adb_producc, long al_vtas);long ll_cont

//f_graba_res_comi(as_cod_age_sup,al_rut,al_monto,as_cod_contab,as_mes,adt_fecha,al_contrato,as_serie,adb_porc_ing_caja,adb_porc_venta,adb_precio,al_total_pago,adb_valor_uf,as_haber,as_moneda,as_cod_com,as_estado_age,as_base,al_cod_parque)
INSERT INTO "RES_COMI"  
   		("COD_AGE_SUP",	"RUT",	"MONT_AGE_SUP",	"COD_CONTABLE",	"MES",	"FECHA",		"CONTRATO",		"SERIE",		"PORC_ING_CAJA",		"PORC_VENTA",		"PRECIO" ,		"TOTAL_PAGO",		"VALOR_UF",		"HABER",		"MONEDA",	"CODIGO_COM",	"ESTADO_AGE_SUP",	"BASE",	"COD_PARQUE",	"PRODUCCION",	"NRO_VENTAS")  
VALUES	(:as_cod_age_sup,	:al_rut,	:al_monto,			:as_cod_contab,	:as_mes,	:adt_fecha,	:adb_contrato,	:as_serie,	:adb_porc_ing_caja,	:adb_porc_venta,	:adb_precio,	:al_total_pago,	:adb_valor_uf,	:as_haber,	:as_moneda,	:as_cod_com,	:as_estado_age,	:as_base,	:al_cod_parque,	:adb_producc,	:al_vtas)  ;
if sqlca.sqlcode = 0 then
	commit;
	return 1
else
	ROLLBACK;
	UPDATE	"RES_COMI"  
   SET 		"RUT" = :al_rut,   
				"MONT_AGE_SUP" = :al_monto,   
				"COD_CONTABLE" = :as_cod_contab,   
				"MES" = :as_mes,   
				"FECHA" = :adt_fecha,   
				"PORC_ING_CAJA" = :adb_porc_ing_caja,   
				"PORC_VENTA" = :adb_porc_venta,   
				"PRECIO" = :adb_precio, 
				"TOTAL_PAGO" =:al_total_pago,
				"VALOR_UF" =:adb_valor_uf,
				"HABER" =:as_haber,
				"MONEDA" =:as_moneda,
				"CODIGO_COM" =:as_cod_com,
				"ESTADO_AGE_SUP" =:as_estado_age,
				"BASE" = :as_base,
				"COD_PARQUE" = :al_cod_parque,
				"PRODUCCION" = :adb_producc,
				"NRO_VENTAS" = :al_vtas
   WHERE	( "RES_COMI"."COD_AGE_SUP" = :as_cod_age_sup ) AND
				( "RES_COMI"."COD_CONTABLE" = :as_cod_contab ) AND
          		( "RES_COMI"."FECHA" = :adt_fecha ) AND
			 	( "RES_COMI"."CONTRATO" = : adb_contrato) AND 
			 	( "RES_COMI"."SERIE" = :as_serie )			 ;
	if sqlca.sqlcode = 0 then
		commit;
		return 1
	else
//		messagebox(gs_app_name,sqlca.SQLErrText,stopsign!)
		ROLLBACK;
		return -1
	end if	
end if
end function

