 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"supervisor~" ) COLUMN(NAME=~"supervisor.cod_sup~") COLUMN(NAME=~"supervisor.cod_jefe~") COLUMN(NAME=~"supervisor.nombre~") COLUMN(NAME=~"supervisor.a_paterno~") COLUMN(NAME=~"supervisor.a_materno~") COLUMN(NAME=~"supervisor.tipo~") COLUMN(NAME=~"supervisor.fecha_ing~") COLUMN(NAME=~"supervisor.fecha_fin~") COLUMN(NAME=~"supervisor.estado~") COLUMN(NAME=~"supervisor.rut~") COLUMN(NAME=~"supervisor.clasifica~") COLUMN(NAME=~"supervisor.canal~") COLUMN(NAME=~"supervisor.vsp~") COLUMN(NAME=~"supervisor.cod_parque~") COLUMN(NAME=~"supervisor.porc_supervisor~") COLUMN(NAME=~"supervisor.depto~")WHERE(    EXP1 =~"~~~"SUPERVISOR~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'A'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"SUPERVISOR~~~".~~~"DEPTO~~~"~"   OP =~"<>~"    EXP2 =~"'E'~" ) ) " update="SUPERVISOR" updatewhere=1 updatekeyinplace=no )
