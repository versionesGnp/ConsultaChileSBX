type cb_print_inf_mejor from commandbutton within tabpage_4
integer x = 2784
integer y = 1600
integer width = 594
integer height = 120
integer taborder = 110
integer textsize = -10
integer weight = 400
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = script!
string facename = "Comic Sans MS"
string text = "&Imprimir Informe"
end type

event clicked;Long		ll_cod_parque
Date		ld_fecha_fin,ld_fecha_clas

ld_fecha_fin											= date(em_fec_sem_fin_fi.text)
ll_cod_parque											= dw_parque.getitemnumber(1,'parque')
ld_fecha_clas 											= RelativeDate(   date('01/'+string(month( date(em_fec_sem_fin_fi.text)),'0#')+'/'+string(year(date(em_fec_sem_fin_fi.text)),'####')), - 1)
if ll_cod_parque>0 then
	if dw_informe_mejor.retrieve(date(em_fec_sem_fin_fi.text),ld_fecha_clas,ll_cod_parque) > 0 then
		if ll_cod_parque=1 then
			dw_informe_mejor.object.t_2.text 	= 'El Prado'
		elseif ll_cod_parque=102 then
			dw_informe_mejor.object.t_2.text 	= 'El Manantial'
		elseif ll_cod_parque=11 then
			dw_informe_mejor.object.t_2.text 	= 'La Foresta'
		elseif ll_cod_parque=801 then
			dw_informe_mejor.object.t_2.text 	= 'Concepción'
		end if
		dw_informe_mejor.object.t_12.text 		= gs_nombre_usuario
		if dw_informe_mejor.rowcount() > 0 then
			f_Print( dw_informe_mejor )
		end if
	end if
else
	messagebox("Advertencia","Debe Seleccionar Parque")
end if
end event

