event clicked;Long		ll_tot_reg,ll_indi,ll_numero,ll_sum
Date		ld_fecha,ld_fecha_fin,ld_fecha_resta
String	ls_base,ls_serie

ld_fecha_fin	= date(em_fecha_fin.text)
ll_tot_reg		= dw_lista_u_fecha.rowcount()
ll_sum			= 0
for ll_indi=1 to ll_tot_reg
	ld_fecha		= date(dw_lista_u_fecha.getitemdatetime(ll_indi,'fecha_ingreso'))
	ls_base		= dw_lista_u_fecha.getitemstring(ll_indi,'base')
	ls_serie		= dw_lista_u_fecha.getitemstring(ll_indi,'serie')
	ll_numero	= dw_lista_u_fecha.getitemnumber(ll_indi,'numero')
	if ld_fecha > ld_fecha_fin then
		ld_fecha_resta	= RelativeDate(ld_fecha_fin,-2)
		dw_lista_u_fecha.setitem(ll_indi,'fecha_ingreso',ld_fecha_resta)
		if ls_base='O' then
			UPDATE	"OFERTA_V" 
			SET 		"FECHA_INGRESO" = :ld_fecha_resta 
			WHERE  ( "OFERTA_V"."SERIE" = :ls_serie ) AND 
					 ( "OFERTA_V"."NRO_OFERTA" = :ll_numero ) 
			USING		sqlca;
			if sqlca.sqlcode = 0 then
				commit;
				ll_sum ++
			else
				rollback;
				messagebox('Error al Grabar','La Promesa Serie: '+ls_serie+', Numero: '+string(ll_numero)+' No se Actualizó SQL:  '+sqlca.sqlerrtext, information!)
			end if
		elseif ls_base='L' then
			UPDATE	"ANEXO_LIBERADOR" 
			SET 		"FECHA_INGRESO" = :ld_fecha_resta 
			WHERE  ( "ANEXO_LIBERADOR"."SERIE_M" = :ls_serie ) AND 
					 ( "ANEXO_LIBERADOR"."NRO_LIBERADOR" = :ll_numero ) 
			USING		sqlca;
			if sqlca.sqlcode = 0 then
				commit;
				ll_sum ++
			else
				rollback;
				messagebox('Error al Grabar','El Anexo Liberador Serie: '+ls_serie+', Numero: '+string(ll_numero)+' No se Actualizó SQL:  '+sqlca.sqlerrtext, information!)
			end if
		end if
	end if
next
if ll_sum>0 then
	messagebox("Grabar","Grabación Exitosa")
end if
dw_lista_u_fecha.accepttext()
end event

