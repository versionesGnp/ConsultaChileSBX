type pb_proc_sem from picturebutton within tabpage_3
integer x = 1719
integer y = 28
integer width = 169
integer height = 148
integer taborder = 10
integer textsize = -8
integer weight = 400
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string picturename = "ok.bmp"
