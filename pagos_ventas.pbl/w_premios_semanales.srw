type pb_ok from picturebutton within tabpage_2
integer x = 1719
integer y = 28
integer width = 169
integer height = 148
integer taborder = 10
integer textsize = -10
integer weight = 400
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string picturename = "ok.bmp"
string disabledname = "ok_no.bmp"
end type

event clicked;Date		ld_fecha_ini,ld_fecha_fin,ld_fecha,ld_fecha_resta
String	ls_dia_nom,ls_base,ls_serie
Long		ll_cod_parque,ll_tot_reg,ll_fila,ll_resp,ll_indi,ll_numero

SetPointer(HourGlass!)
dw_lista_u_fecha.reset()
dw_parque.accepttext()
ld_fecha_ini				= date(em_fecha_ini.text)
ld_fecha_fin				= date(em_fecha_fin.text)
ll_cod_parque				= dw_parque.getitemnumber(1,'parque')
if ll_cod_parque>0 then
	if ld_fecha_ini > ld_fecha_fin then
		Messagebox("Advertencia","Rango de Fecha Inválida")
		em_fecha_ini.setfocus()
	else
		ls_dia_nom				= UPPER(DayName(ld_fecha_ini))
		if ls_dia_nom='LUNES' or ls_dia_nom='MONDAY' then
			ls_dia_nom			= UPPER(DayName(ld_fecha_fin))
			if ls_dia_nom='DOMINGO' or ls_dia_nom='SUNDAY' then
				ll_tot_reg		= dw_lista_u_fecha.retrieve(ld_fecha_ini,ld_fecha_fin,ll_cod_parque)
				if ll_tot_reg=0 then
					messagebox("Advertencia","No Registra Dato")
				else
					ll_fila = dw_lista_u_fecha.Find("fecha_ingreso > date('"+string(ld_fecha_fin,'dd/mm/yyyy')+"')", 1, ll_tot_reg)
					if ll_fila>0 then
						ll_resp	= messagebox("Advertencia","Desea Ajustar y Actualizar Fecha Ingreso de Contratos",Exclamation!,YesNo!,2)
						if ll_resp=1 then
							pb_grabar.enabled	= true
						else
							pb_grabar.enabled	= false
						end if
					else
						pb_grabar.enabled		= false
					end if
				end if
			else
				messagebox("Advertencia","Fecha Termino NO corresponde día Domingo")
				pb_ok.enabled	= false
				em_fecha_fin.setfocus()
			end if
		else
			messagebox("Advertencia","Fecha Termino NO corresponde día Lunes")
			pb_ok.enabled		= false
			em_fecha_ini.setfocus()
		end if
	end if
else
	messagebox("Advertencia","Debe Seleccionar Parque")
	dw_parque.setfocus()
end if
SetPointer(Arrow!)
end event

