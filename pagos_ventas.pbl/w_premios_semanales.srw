//			if ll_cod_parque=1 or ll_cod_parque=102 then //SANTIAGO
//				if ls_uso = 'NF' then
////					if premio_dos = 'X' then// >=10% Y < 15% NF
////						SELECT	"PREMIOS_POR_CAJA"."REPARTIR",	"PREMIOS_POR_CAJA"."TOPE",	"PREMIOS_POR_CAJA"."REDUCE_D"  
////						INTO 		:repartir,								:tope,							:reduce  
