event clicked;Long		ll_cod_parque,ll_numero,ll_u_folio,ll_monto,ll_vsp_age,ll_new,ll_count,&
			ll_sum_dos,ll_sum_tres,ll_sum_cuatro,ll_sum_cinco,ll_sum_seis,ll_sum_siete,&
			ll_sum_ocho
Date		ld_fecha_ini,ld_fecha_fin
String	ls_serie,ls_agente,ls_super,ls_uso,ls_forma_pago,ls_estado_premio,ls_tipo_mov,&
			ls_moneda,ls_clasif_age,ls_estado_agente,ls_canal_agente,ls_base,ls_descrip,&
			ls_premio_dos,ls_premio_tres,ls_premio_cuatro,ls_premio_cinco,&
			ls_premio_seis,ls_premio_siete,ls_premio_ocho
Double	ldb_precio,ldb_pie,ldb_pie_pagado,ldb_valor_uf,ldb_uf_dia,ldb_porce
Datetime	ldt_u_fecha

SetPointer(HourGlass!)
dw_parque.accepttext()
dw_lista_semanal.reset()
ls_base						= 'O'
ld_fecha_ini				= date(em_fec_sem_ini.text)
ld_fecha_fin				= date(em_fec_sem_fin.text)
ll_cod_parque				= dw_parque.getitemnumber(1,'parque')
DECLARE x1 CURSOR FOR  
SELECT DISTINCT	"OFERTA_V"."SERIE",   
						"OFERTA_V"."NRO_OFERTA",   
						"OFERTA_V"."COD_AGE",   
						"OFERTA_V"."COD_SUP",   
						"OFERTA_V"."USO",   
						"OFERTA_V"."FORMA_PAGO",   
						"OFERTA_V"."ESTADO_PREMIO",   
						"PAGO_OFERTA"."PRECIO",   
						"PAGO_OFERTA"."PIE",   
						"PAGO_OFERTA"."PIE_PAGADO",   
						"OFERTA_V"."U_FECHA",   
						"OFERTA_V"."U_FOLIO",   
						"INGRESO"."TIPO_MOV",   
						"INGRESO"."MONTO",   
						"INGRESO"."VALOR_UF",   
						"PAGO_OFERTA"."MONEDA",   
						"PAGO_OFERTA"."UF_DIA",   
						"AGENTES"."CLASIFICACION",   
						"AGENTES"."VSP",   
						"AGENTES"."ESTADO",   
						"AGENTES"."CANAL"
FROM 					"OFERTA_V",   
						"PAGO_OFERTA",   
						"INGRESO",   
						"AGENTES",   
						"CADENA"
WHERE				 ( "OFERTA_V"."SERIE" = "PAGO_OFERTA"."SERIE" ) and  
					 ( "OFERTA_V"."NRO_OFERTA" = "PAGO_OFERTA"."NRO_OFERTA" ) and  
					 ( "OFERTA_V"."ULT_FOLIO" = "PAGO_OFERTA"."FOLIO" ) and  
					 ( "OFERTA_V"."U_FOLIO" = "INGRESO"."FOLIO" ) and  
					 ( "OFERTA_V"."COD_AGE" = "AGENTES"."COD_AGE" ) and  
					 ( "OFERTA_V"."SERIE" = "CADENA"."SERIE" ) and  
					 ( "OFERTA_V"."NRO_OFERTA" = "CADENA"."NUMERO" ) and  
					 ( "OFERTA_V"."U_FECHA" >= :ld_fecha_ini AND  
					   "OFERTA_V"."U_FECHA" <= :ld_fecha_fin) AND  
					 ( "INGRESO"."TIPO_COB" = 'CI' OR "INGRESO"."TIPO_COB" = 'C0') AND  
					 ( "INGRESO"."TIPO_MOV" = 'A' OR  
					   "INGRESO"."TIPO_MOV" = 'E') AND  
						"OFERTA_V"."SERIE" <> 'R' AND  
						"OFERTA_V"."ESTADO_PREMIO" = 'N' AND  
						"OFERTA_V"."COD_AGE" <> 'CA' AND  
						"AGENTES"."ESTADO" = 'A' AND  
						"CADENA"."CODIGO" = :ls_base AND  
					 ( "CADENA"."ESTADO" = 'V' OR  
						"CADENA"."ESTADO" = 'C') AND  
						"CADENA"."COD_PARQUE" = :ll_cod_parque   
ORDER BY 			"OFERTA_V"."USO" ASC,	
						"OFERTA_V"."SERIE" ASC,	
						"OFERTA_V"."NRO_OFERTA" ASC   
USING					sqlca;
open x1;
if sqlca.sqlcode=0 then
	DO WHILE sqlca.sqlcode=0 
		fetch x1 into :ls_serie, :ll_numero, :ls_agente, :ls_super, :ls_uso, :ls_forma_pago, :ls_estado_premio, :ldb_precio, :ldb_pie, :ldb_pie_pagado, :ldt_u_fecha, :ll_u_folio, :ls_tipo_mov, :ll_monto, :ldb_valor_uf, :ls_moneda, :ldb_uf_dia, :ls_clasif_age, :ll_vsp_age, :ls_estado_agente, :ls_canal_agente;
		if not isnull(ls_serie) and ls_serie<>'' and not isnull(ll_numero) and ll_numero > 0 then
			ll_new	= dw_lista_semanal.insertrow(0)
			dw_lista_semanal.setitem(ll_new,'base',ls_base)
			dw_lista_semanal.setitem(ll_new,'serie',ls_serie)
			dw_lista_semanal.setitem(ll_new,'numero',ll_numero)
			dw_lista_semanal.setitem(ll_new,'cod_age',ls_agente)
			dw_lista_semanal.setitem(ll_new,'cod_super',ls_super)
			dw_lista_semanal.setitem(ll_new,'forma_pago',ls_forma_pago)
			dw_lista_semanal.setitem(ll_new,'estado_premio',ls_estado_premio)
			dw_lista_semanal.setitem(ll_new,'precio',ldb_precio)
			dw_lista_semanal.setitem(ll_new,'pie',ldb_pie)
			dw_lista_semanal.setitem(ll_new,'pie_pagado',ldb_pie_pagado)
			dw_lista_semanal.setitem(ll_new,'u_fecha',ldt_u_fecha)
			dw_lista_semanal.setitem(ll_new,'u_folio',ll_u_folio)
			dw_lista_semanal.setitem(ll_new,'tipo_mov',ls_tipo_mov)
			dw_lista_semanal.setitem(ll_new,'valor_uf',ldb_valor_uf)
			dw_lista_semanal.setitem(ll_new,'moneda',ls_moneda)
			dw_lista_semanal.setitem(ll_new,'uf_dia',ldb_uf_dia)
			dw_lista_semanal.setitem(ll_new,'clasifica_agente',ls_clasif_age)
			dw_lista_semanal.setitem(ll_new,'vsp_agente',ll_vsp_age)
			dw_lista_semanal.setitem(ll_new,'estado_agente',ls_estado_agente)
			dw_lista_semanal.setitem(ll_new,'canal_agente',ls_canal_agente)
			dw_lista_semanal.setitem(ll_new,'cod_parque',ll_cod_parque)
			if ls_uso = 'NI' and ls_canal_agente = 'NI' then 
				ls_canal_agente = 'NI'
			ELSE
				ls_canal_agente = 'NF'
			END IF
			dw_lista_semanal.setitem(ll_new,'uso',ls_canal_agente)
			ldb_porce			= wf_porce_ni(ll_u_folio,ldb_precio,ldb_valor_uf,ls_moneda,ls_uso,ls_base,ls_serie,ll_numero,ll_monto)
			dw_lista_semanal.setitem(ll_new,'porcentaje',ldb_porce)
			ll_monto				= il_monto
			dw_lista_semanal.setitem(ll_new,'monto',ll_monto)
		end if
		setnull(ls_serie);setnull(ll_numero)
	LOOP
end if
close x1;
dw_lista_semanal.setfilter ('repetidos = 1')
dw_lista_semanal.filter ()
ll_count	= dw_lista_semanal.rowcount()
if ll_count>0 then
	SELECT	"COD_PARQ"."NOMBRE"  
	INTO 		:ls_descrip  
	FROM 		"COD_PARQ"  
	WHERE 	"COD_PARQ"."CODIGO" = :ll_cod_parque   ;
	dw_lista_semanal.object.t_titulo.text	= 'Premios Semanales por Ingreso a Caja del periodo de '+string( ld_fecha_ini ,'dd/mm/yyyy') +' al '+string( ld_fecha_fin ,'dd/mm/yyyy')+', Parque: '+ ls_descrip 
end if
SetPointer(Arrow!)
end event

