string picturename = "ok.bmp"
alignment htextalign = left!
end type

event ue_mousemove;st_help_ok_nf.visible	= true
st_help_print3.visible	= false
st_help_ok_ni.visible	= false
st_help_print4.visible	= false
end event

event clicked;Date		ld_fecha_ini,ld_fecha_fin,fecha_ini_age
Long		ll_cod_parque,ll_tot_reg,i,reg_grupo,ll_vsp,ll_new,porc,vsp,ll_cod_premio,ll_uno,&
			ll_premio_uno,ll_premio,ll_dos,ll_premio_dos,ll_tres,ll_premio_tres,ll_cuatro,&
			ll_premio_cuatro,dias_antiguedad,ll_suma
String	ls_string,ls_cod,ls_nombre,ls_clasificacion,ls_canal_venta
double   ldb_total_uf,ldb_porc_extra,uf1,uf2,posicion,ufs

SetPointer(HourGlass!)
dw_parque.accepttext()
dw_mejor_nf.setfilter ('')
dw_mejor_nf.filter ()
dw_mejor_nf.reset()
dw_insertar_mejor.setfilter ('')
dw_insertar_mejor.filter ()
dw_insertar_mejor.reset()
ld_fecha_ini										= date(em_fec_sem_ini_fi.text)
ld_fecha_fin										= date(em_fec_sem_fin_fi.text)
ll_cod_parque										= dw_parque.getitemnumber(1,'parque')
ll_suma												= 0
if ll_cod_parque>0 then
//	DELETE FROM 	"PROMESA_LUGAR"  
//	WHERE			(	"PROMESA_LUGAR"."AGENTE" = 'A' ) AND  
//					(	"PROMESA_LUGAR"."USO" = 'NF' ) AND  
//					(	"PROMESA_LUGAR"."FECHA" = :ld_fecha_fin ) AND  
//					(	"PROMESA_LUGAR"."PARQUE" = :ll_cod_parque )   
//	USING				sqlca;
//	if sqlca.sqlcode = 0 then
//		commit;
//	else
//		rollback;
//	end if
	if dw_mejor_nf.retrieve(ld_fecha_ini,ld_fecha_fin,'NF',ll_cod_parque) > 0 then
		dw_mejor_nf.accepttext()
		if ll_cod_parque = 1 then
			ls_string								= "suma >= 150 and agentes_clasificacion <> 'D'"
			dw_mejor_nf.setfilter(ls_string)
			dw_mejor_nf.filter()
			if ll_cod_parque=1 then
				dw_mejor_nf.object.t_9.text	= 'El Prado'
			elseif ll_cod_parque=102 then
				dw_mejor_nf.object.t_9.text	= 'El Manantial'
			elseif ll_cod_parque=11 then
				dw_mejor_nf.object.t_9.text	= 'La Foresta'
			elseif ll_cod_parque=801 then
				dw_mejor_nf.object.t_9.text	= 'Concepción'
			end if
			dw_mejor_nf.object.t_10.text 		= 'Mejores Agentes NF del '+em_fec_sem_ini_fi.text+' al '+em_fec_sem_fin_fi.text
		elseif ll_cod_parque=102 then
			ls_string								= "suma >= 120 and agentes_clasificacion <> 'D'"
			dw_mejor_nf.setfilter(ls_string)
			dw_mejor_nf.filter()
			dw_mejor_nf.object.t_9.text 		= 'El Manantial'
			dw_mejor_nf.object.t_10.text 		= 'Mejores Agentes NF del '+em_fec_sem_ini_fi.text+' al '+em_fec_sem_fin_fi.text
		elseif ll_cod_parque=11 then
			ls_string								= "suma >= 100 and agentes_clasificacion <> 'D'"
			dw_mejor_nf.setfilter(ls_string)
			dw_mejor_nf.filter()
			dw_mejor_nf.object.t_9.text 		= 'La Foresta'
			dw_mejor_nf.object.t_10.text 		= 'Mejores Agentes NF del '+em_fec_sem_ini_fi.text+' al '+em_fec_sem_fin_fi.text
		elseif ll_cod_parque=801 then
			ls_string								= "suma >= 100 and agentes_clasificacion <> 'D'"
			dw_mejor_nf.setfilter(ls_string)
			dw_mejor_nf.filter()
			dw_mejor_nf.object.t_9.text 		= 'Concepción'
			dw_mejor_nf.object.t_10.text 		= 'Mejores Agentes NF del '+em_fec_sem_ini_fi.text+' al '+em_fec_sem_fin_fi.text
		end if
		ll_tot_reg									= dw_mejor_nf.rowcount()
		for i = 1 to ll_tot_reg
			reg_grupo		= dw_mejor_nf.getitemnumber(i,'compute_5')//registros por grupo
			if reg_grupo > 1  and i <= ll_tot_reg then
				i 				= i + reg_grupo - 1
			end if
			ls_cod           	= dw_mejor_nf.getitemstring(i,'oferta_v_cod_age')
			ls_nombre        	= dw_mejor_nf.getitemstring(i,'compute_1')//nombre
			ls_clasificacion 	= dw_mejor_nf.getitemstring(i,'agentes_clasificacion')
			ll_vsp           	= dw_mejor_nf.getitemnumber(i,'agentes_vsp')
			ls_canal_venta   	= dw_mejor_nf.getitemstring(i,'agentes_canal')
			ldb_porc_extra   	= dw_mejor_nf.getitemnumber(i,'compute_7')//25%+
			ldb_total_uf     	= dw_mejor_nf.getitemnumber(i,'suma')//total_uf
			ll_new				= dw_insertar_mejor.insertrow(0)
			dw_insertar_mejor.setitem(ll_new,'cod',ls_cod)
			dw_insertar_mejor.setitem(ll_new,'nombre',ls_nombre)
			dw_insertar_mejor.setitem(ll_new,'clas',ls_clasificacion)
			dw_insertar_mejor.setitem(ll_new,'vsp',ll_vsp)
			dw_insertar_mejor.setitem(ll_new,'canal',ls_canal_venta)
			dw_insertar_mejor.setitem(ll_new,'porc',ldb_porc_extra)
			dw_insertar_mejor.setitem(ll_new,'uf',ldb_total_uf)
		next
		if ll_cod_parque=1 and ls_canal_venta = 'NF' then
			dw_insertar_mejor.setfilter("uf >= 150")
			dw_insertar_mejor.filter()
		elseif ll_cod_parque=102 and ls_canal_venta = 'NF'then
			dw_insertar_mejor.setfilter("uf >= 120")
			dw_insertar_mejor.filter()
		elseif ll_cod_parque=11 and ls_canal_venta='NF' then
			dw_insertar_mejor.setfilter("uf >= 100")
			dw_insertar_mejor.filter()
		elseif ll_cod_parque=801 and ls_canal_venta='NF' then
			dw_insertar_mejor.setfilter("uf >= 100")
			dw_insertar_mejor.filter()
		end if
		dw_insertar_mejor.setsort("uf D")
		dw_insertar_mejor.sort()
		ll_tot_reg				= dw_insertar_mejor.rowcount()
		if ll_tot_reg > 0 then
			dw_insertar_mejor.setitem(1,'posicion',1)
			for i = 2 to ll_tot_reg
				if 1 <= ( i - 1 ) then
					uf1 			= round(dw_insertar_mejor.getitemnumber(i,'uf'),2)
					uf2 			= round(dw_insertar_mejor.getitemnumber(i - 1,'uf'),2)
					if uf1 		= uf2 then
						posicion = dw_insertar_mejor.getitemnumber(i - 1,'posicion')
						dw_insertar_mejor.setitem(i,'posicion',posicion)
					else
						posicion	= dw_insertar_mejor.getitemnumber(i - 1,'posicion') + 1
						dw_insertar_mejor.setitem(i,'posicion',posicion)
					end if
				end if
			next
		end if
		dw_insertar_mejor.setfilter('posicion < 5')
		dw_insertar_mejor.filter()
		ll_tot_reg				= dw_insertar_mejor.rowcount()
		for i = 1 to ll_tot_reg
			posicion 			= dw_insertar_mejor.getitemnumber(i,'posicion')
			porc     			= dw_insertar_mejor.getitemnumber(i,'porc')
			vsp      			= dw_insertar_mejor.getitemnumber(i,'vsp')
			SetNull(ll_cod_premio)
			if posicion = 1 then
				ll_uno 				= dw_insertar_mejor.getitemnumber(i,'uno')
				SELECT  "PREMIOS_POR_CAJA_MEJORES"."MONTO" INTO :ll_premio_uno 
				FROM 	  "PREMIOS_POR_CAJA_MEJORES" 
				WHERE ( "PREMIOS_POR_CAJA_MEJORES"."CODIGO" = 1 ) AND 
						( "PREMIOS_POR_CAJA_MEJORES"."TIPO_EMPLEADO" = 'A' ) AND 
						( "PREMIOS_POR_CAJA_MEJORES"."CANAL" = 'NF' ) AND 
						( "PREMIOS_POR_CAJA_MEJORES"."PARQUE" = :ll_cod_parque );
				ll_premio 			= ( ll_premio_uno / ll_uno )
				ll_cod_premio = 1
			elseif posicion = 2 then
				ll_dos 				= dw_insertar_mejor.getitemnumber(i,'dos')
				SELECT  "PREMIOS_POR_CAJA_MEJORES"."MONTO" INTO :ll_premio_dos 
				FROM    "PREMIOS_POR_CAJA_MEJORES" 
				WHERE ( "PREMIOS_POR_CAJA_MEJORES"."CODIGO" = 2 ) AND 
						( "PREMIOS_POR_CAJA_MEJORES"."TIPO_EMPLEADO" = 'A' ) AND 
						( "PREMIOS_POR_CAJA_MEJORES"."CANAL" = 'NF' ) AND 
						( "PREMIOS_POR_CAJA_MEJORES"."PARQUE" = :ll_cod_parque );
				ll_premio 			= ( ll_premio_dos / ll_dos )
				ll_cod_premio 		= 2
			elseif posicion = 3 then
				ll_tres 				= dw_insertar_mejor.getitemnumber(i,'tres')
				SELECT 	"PREMIOS_POR_CAJA_MEJORES"."MONTO" INTO :ll_premio_tres 
				FROM 		"PREMIOS_POR_CAJA_MEJORES" 
				WHERE  ( "PREMIOS_POR_CAJA_MEJORES"."CODIGO" = 3 ) AND 
						 ( "PREMIOS_POR_CAJA_MEJORES"."TIPO_EMPLEADO" = 'A' ) AND 
						 ( "PREMIOS_POR_CAJA_MEJORES"."CANAL" = 'NF' ) AND 
						 ( "PREMIOS_POR_CAJA_MEJORES"."PARQUE" = :ll_cod_parque );
				ll_premio 			= ( ll_premio_tres / ll_tres )
				ll_cod_premio 		= 3
			elseif posicion = 4 then
				ll_cuatro 			= dw_insertar_mejor.getitemnumber(i,'cuatro')
				SELECT 	"PREMIOS_POR_CAJA_MEJORES"."MONTO" INTO :ll_premio_cuatro 
				FROM 		"PREMIOS_POR_CAJA_MEJORES" 
				WHERE  ( "PREMIOS_POR_CAJA_MEJORES"."CODIGO" = 4 ) AND 
						 ( "PREMIOS_POR_CAJA_MEJORES"."TIPO_EMPLEADO" = 'A' ) AND 
						 ( "PREMIOS_POR_CAJA_MEJORES"."CANAL" = 'NF' ) AND 
						 ( "PREMIOS_POR_CAJA_MEJORES"."PARQUE" = :ll_cod_parque );
				ll_premio 			= ( ll_premio_cuatro / ll_cuatro )
				ll_cod_premio 		= 4
			end if
			ls_cod      			= dw_insertar_mejor.getitemstring(i,'cod')
			SELECT	"AGENTES"."NOMBRE"||' '||"AGENTES"."A_PATERNO"||' '||"AGENTES"."A_MATERNO","AGENTES"."FECHA_INI"  
			INTO 		:ls_nombre,	:fecha_ini_age 
			FROM 		"AGENTES" 
			WHERE 	"AGENTES"."COD_AGE" = :ls_cod ;
			dias_antiguedad		= DaysAfter(date(fecha_ini_age), ld_fecha_fin)		
	//		vsp      				= dw_insertar_mejor.getitemstring(i,'vsp')
			ls_clasificacion		= dw_insertar_mejor.getitemstring(i,'clas')
			ufs      				= dw_insertar_mejor.getitemnumber(i,'uf')
			if porc = 25 and dias_antiguedad >= 180 AND ls_clasificacion = 'A' then 
				ll_premio 			= ll_premio + ( ll_premio * 0.25 )
			end if
			if ll_vsp >= 1 then ll_premio = ll_premio / 2
			dw_insertar_mejor.setitem(i,'monto',ll_premio)
			INSERT INTO "PROMESA_LUGAR"  
					 ( "CODIGO",	"UFS","USO","LUGAR"  ,"AGENTE","MONTO",	"CODIGO_PREMIO",		"FECHA" ,		"PARQUE"   )  
			VALUES ( :ls_cod    ,:ufs ,'NF' ,:posicion,'A'     ,:ll_premio,:ll_cod_premio    ,	:ld_fecha_fin,	:ll_cod_parque )  
			USING		sqlca;
			if sqlca.sqlcode = 0 then
				commit;
				ll_suma ++
			else
				rollback;
			end if
		next
		if ll_suma>0 then
			messagebox("Grabar","Grabación Exitosa")
		end if
	else
		messagebox("Advertencia","No Registra Dato en Rango Fechas Indicadas")
	end if
else
	messagebox("Advertencia","Debe Seleccionar Parque")
	dw_parque.setfocus()
end if
tab_1.tabpage_4.st_titulo_nf.italic		= true
SetPointer(Arrow!)
end event

