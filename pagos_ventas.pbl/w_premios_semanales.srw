on w_premios_semanales.create
this.cb_res_comi=create cb_res_comi
this.st_premios_semanales=create st_premios_semanales
this.pb_premios_semanales=create pb_premios_semanales
this.st_salir=create st_salir
this.st_calculadora=create st_calculadora
this.st_ing_caja=create st_ing_caja
this.st_uf_fecha=create st_uf_fecha
this.pb_salir=create pb_salir
this.pb_calculadora=create pb_calculadora
this.pb_ing_caja=create pb_ing_caja
this.pb_uf_fecha=create pb_uf_fecha
this.ln_1=create ln_1
this.ln_2=create ln_2
this.ln_3=create ln_3
this.ln_4=create ln_4
this.ln_5=create ln_5
this.ln_6=create ln_6
this.ln_7=create ln_7
this.ln_8=create ln_8
this.ln_9=create ln_9
this.ln_10=create ln_10
this.ln_11=create ln_11
this.ln_12=create ln_12
this.ln_15=create ln_15
this.ln_16=create ln_16
this.ln_17=create ln_17
this.ln_18=create ln_18
this.tab_1=create tab_1
this.dw_parque=create dw_parque
this.ln_19=create ln_19
this.ln_20=create ln_20
this.Control[]={this.cb_res_comi,&
this.st_premios_semanales,&
this.pb_premios_semanales,&
this.st_salir,&
this.st_calculadora,&
this.st_ing_caja,&
this.st_uf_fecha,&
this.pb_salir,&
this.pb_calculadora,&
this.pb_ing_caja,&
this.pb_uf_fecha,&
this.ln_1,&
this.ln_2,&
this.ln_3,&
this.ln_4,&
this.ln_5,&
this.ln_6,&
this.ln_7,&
this.ln_8,&
this.ln_9,&
this.ln_10,&
this.ln_11,&
this.ln_12,&
this.ln_15,&
this.ln_16,&
this.ln_17,&
this.ln_18,&
this.tab_1,&
this.dw_parque,&
this.ln_19,&
this.ln_20}
end on

on w_premios_semanales.destroy
destroy(this.cb_res_comi)
destroy(this.st_premios_semanales)
destroy(this.pb_premios_semanales)
destroy(this.st_salir)
destroy(this.st_calculadora)
destroy(this.st_ing_caja)
destroy(this.st_uf_fecha)
destroy(this.pb_salir)
destroy(this.pb_calculadora)
destroy(this.pb_ing_caja)
destroy(this.pb_uf_fecha)
destroy(this.ln_1)
destroy(this.ln_2)
destroy(this.ln_3)
destroy(this.ln_4)
destroy(this.ln_5)
destroy(this.ln_6)
destroy(this.ln_7)
destroy(this.ln_8)
destroy(this.ln_9)
destroy(this.ln_10)
destroy(this.ln_11)
destroy(this.ln_12)
destroy(this.ln_15)
destroy(this.ln_16)
destroy(this.ln_17)
destroy(this.ln_18)
destroy(this.tab_1)
destroy(this.dw_parque)
destroy(this.ln_19)
destroy(this.ln_20)
end on

event open;Datetime	ld_fec_ini,ld_fec_fin
Date		ld_fec_prox

gf_centrar(w_premios_semanales)
st_uf_fecha.visible								= false
st_ing_caja.visible								= false
st_calculadora.visible							= false
st_salir.visible									= false
st_premios_semanales.visible					= false
tab_1.tabpage_2.st_help_print.visible		= false
tab_1.tabpage_2.st_help_exportar.visible	= false
tab_1.tabpage_2.st_help_filtrar.visible	= false
tab_1.tabpage_2.st_help_grabar.visible		= false
tab_1.tabpage_2.pb_grabar.visible			= false
tab_1.tabpage_3.st_help_print2.visible		= false
tab_1.tabpage_3.st_help_exportar2.visible	= false
tab_1.tabpage_3.st_help_filtrar2.visible	= false
tab_1.tabpage_3.st_help_grabar2.visible	= false
tab_1.tabpage_1.st_fondo.visible				= false
tab_1.tabpage_1.hpb_1.visible 				= false
tab_1.tabpage_1.st_porc.visible 				= false
tab_1.tabpage_1.dw_lista.settransobject(sqlca)
dw_parque.settransobject(sqlca)
dw_parque.insertrow(0)
if gs_conexion	= "Parque El Prado" then
	dw_parque.setitem(1,'parque',1)
	tab_1.tabpage_3.dw_lista_semanal.dataobject	= 'dw_proceso_porce_semanal_santiago'
elseif gs_conexion	= "Parque La Foresta" then
	dw_parque.setitem(1,'parque',11)
	tab_1.tabpage_3.dw_lista_semanal.dataobject	= 'dw_proceso_porcentaje_semanal_serena'
elseif gs_conexion	= "Parque Concepción" then
	dw_parque.setitem(1,'parque',801)
	tab_1.tabpage_3.dw_lista_semanal.dataobject	= 'dw_proceso_porcentaje_semanal_serena'
end if
dw_parque.accepttext()
tab_1.tabpage_1.em_fec_ini.text	= string(RelativeDate(today(), -150),"dd/mm/yyyy")
tab_1.tabpage_1.em_fec_fin.text	= string(today(),"dd/mm/yyyy")

//SELECT	"CIERRE_VENTA_SEMANALES"."FECHA_INICIAL",
//			"CIERRE_VENTA_SEMANALES"."FECHA_FINAL"
//INTO 		:ld_fec_ini,
//			:ld_fec_fin
//FROM 		"CIERRE_VENTA_SEMANALES"  
//WHERE  ( "CIERRE_VENTA_SEMANALES"."FECHA_FINAL" = (	SELECT MAX("CIERRE_VENTA_SEMANALES"."FECHA_FINAL") 
//																		FROM 		  "CIERRE_VENTA_SEMANALES" 
//																		WHERE      "CIERRE_VENTA_SEMANALES"."COD_CONTABLE" = '045' ) ) AND  
//		 ( "CIERRE_VENTA_SEMANALES"."COD_CONTABLE" = '045' )   ;
this.title												= 'Ultimo Proceso Premios Semanales del:  '+string(ld_fec_ini,"dd/mm/yyyy")+' al '+string(ld_fec_fin,"dd/mm/yyyy")
ld_fec_prox											= RelativeDate(date(ld_fec_fin), 1)
tab_1.tabpage_2.em_fecha_ini.text			= string(ld_fec_prox)
tab_1.tabpage_3.em_fec_sem_ini.text		= string(ld_fec_prox)
tab_1.tabpage_4.em_fec_sem_ini_fi.text		= string(ld_fec_prox)
tab_1.tabpage_5.em_fec_sem_ini_ch.text	= string(ld_fec_prox)
ld_fec_prox											= RelativeDate(date(ld_fec_fin), 7)
tab_1.tabpage_2.em_fecha_fin.text			= string(ld_fec_prox)
tab_1.tabpage_3.em_fec_sem_fin.text		= string(ld_fec_prox)
tab_1.tabpage_4.em_fec_sem_fin_fi.text		= string(ld_fec_prox)
tab_1.tabpage_5.em_fec_sem_fin_ch.text	= string(ld_fec_prox)
tab_1.tabpage_2.dw_lista_u_fecha.settransobject(sqlca)
tab_1.tabpage_3.dw_lista_semanal.settransobject(sqlca)
tab_1.tabpage_3.dw_informe_semanal.settransobject(sqlca)
tab_1.tabpage_4.dw_mejor_nf.settransobject(sqlca)
tab_1.tabpage_4.dw_mejor_ni.settransobject(sqlca)
tab_1.tabpage_4.dw_insertar_mejor.settransobject(sqlca)
tab_1.tabpage_4.st_titulo_nf.italic		= false
tab_1.tabpage_4.st_titulo_ni.italic		= false
tab_1.tabpage_5.dw_lista_cheques.settransobject(sqlca)
if tab_1.tabpage_5.dw_lista_cheques.retrieve(date(tab_1.tabpage_5.em_fec_sem_fin_ch.text))>0 then
	tab_1.tabpage_5.st_no_cheques.visible		= false
	tab_1.tabpage_5.dw_lista_cheques.visible	= true
else
	tab_1.tabpage_5.st_no_cheques.visible		= true
	tab_1.tabpage_5.dw_lista_cheques.visible	= false
end if
end event

event mousemove;st_uf_fecha.visible								= false
st_ing_caja.visible								= false
st_calculadora.visible							= false
st_salir.visible									= false
st_premios_semanales.visible					= false
