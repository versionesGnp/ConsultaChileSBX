event clicked;Date		ld_fecha_ini,ld_fecha_fin
Long		ll_cod_parque,ll_suma,ll_tot_reg,i,reg_grupo,ll_vsp,ll_new,ll_posicion,&
			ll_porc,ll_uno,ll_premio_uno,ll_premio,ll_cod_premio,ll_dos,ll_premio_dos,&
			ll_dias_antiguedad
String	ls_cod,ls_nombre,ls_clasificacion,ls_canal_venta
Double	ldb_porc_extra,ldb_total_uf,ldb_uf1,ldb_uf2,ldb_ufs
Datetime	ldt_fecha_ini_age
SetPointer(HourGlass!)
dw_parque.accepttext()
dw_mejor_ni.setfilter('')
dw_mejor_ni.filter()
dw_mejor_ni.reset()
ld_fecha_ini										= date(em_fec_sem_ini_fi.text)
ld_fecha_fin										= date(em_fec_sem_fin_fi.text)
ll_cod_parque										= dw_parque.getitemnumber(1,'parque')
ll_suma												= 0
if ll_cod_parque>0 then
//	DELETE FROM 	"PROMESA_LUGAR"  
//	WHERE			(	"PROMESA_LUGAR"."AGENTE" = 'A' ) AND  
//					(	"PROMESA_LUGAR"."USO" = 'NI' ) AND  
//					(	"PROMESA_LUGAR"."FECHA" = :ld_fecha_fin ) AND  
//					(	"PROMESA_LUGAR"."PARQUE" = :ll_cod_parque )   
//	USING				sqlca;
//	if sqlca.sqlcode = 0 then
//		commit;
//	else
//		rollback;
//	end if
	if dw_mejor_ni.retrieve(ld_fecha_ini,ld_fecha_fin,'NI') > 0 then
		dw_mejor_ni.setfilter("suma >= 200 and agentes_clasificacion <> 'D'")
		dw_mejor_ni.filter()
		if dw_mejor_ni.rowcount() > 0 then
			if ll_cod_parque=1 then
				dw_mejor_ni.object.t_9.text = 'El Prado'
			elseif ll_cod_parque=11 then
				dw_mejor_ni.object.t_9.text = 'La Foresta'
			elseif ll_cod_parque=801 then
				dw_mejor_ni.object.t_9.text = 'Concepción'
			end if
			dw_mejor_ni.object.t_10.text = 'Mejores Agentes NI del '+em_fec_sem_ini_fi.text+' al '+em_fec_sem_fin_fi.text
		end if
		ll_tot_reg									= dw_mejor_ni.rowcount()
		for i = 1 to ll_tot_reg
			reg_grupo      	= dw_mejor_ni.getitemnumber(i,'compute_5')//registros por grupo
			if reg_grupo > 1  and i <= ll_tot_reg then
				i 					= i + reg_grupo - 1
			end if
			ls_cod         	= dw_mejor_ni.getitemstring(i,'oferta_v_cod_age')
			ls_nombre			= dw_mejor_ni.getitemstring(i,'compute_1')//nombre
			ls_clasificacion	= dw_mejor_ni.getitemstring(i,'agentes_clasificacion')
			ll_vsp				= dw_mejor_ni.getitemnumber(i,'agentes_vsp')
			ls_canal_venta		= dw_mejor_ni.getitemstring(i,'agentes_canal')
			ldb_porc_extra		= dw_mejor_ni.getitemnumber(i,'compute_7')//25%+
			ldb_total_uf		= dw_mejor_ni.getitemnumber(i,'suma')//total_uf
			
			ll_new				= dw_insertar_mejor_ni.insertrow(0)
			dw_insertar_mejor_ni.setitem(ll_new,'cod',ls_cod)
			dw_insertar_mejor_ni.setitem(ll_new,'nombre',ls_nombre)
			dw_insertar_mejor_ni.setitem(ll_new,'clas',ls_clasificacion)
			dw_insertar_mejor_ni.setitem(ll_new,'vsp',ll_vsp)
			dw_insertar_mejor_ni.setitem(ll_new,'canal',ls_canal_venta)
			dw_insertar_mejor_ni.setitem(ll_new,'porc',ldb_porc_extra)
			dw_insertar_mejor_ni.setitem(ll_new,'uf',ldb_total_uf)
		next
		if (ll_cod_parque=1 or ll_cod_parque=102 ) and ls_canal_venta = 'NI' then
			dw_insertar_mejor_ni.setfilter("uf >= 200")
			dw_insertar_mejor_ni.filter()
		elseif ll_cod_parque=11 and ls_canal_venta = 'NI' then
			dw_insertar_mejor_ni.setfilter("uf >= 200")
			dw_insertar_mejor_ni.filter()
		end if
		dw_insertar_mejor_ni.setsort("uf D")
		dw_insertar_mejor_ni.sort()
		ll_tot_reg				= dw_insertar_mejor_ni.rowcount()
		if ll_tot_reg > 0 then
			dw_insertar_mejor_ni.setitem(1,'posicion',1)
			for i = 2 to ll_tot_reg
				if 1 <= ( i - 1 ) then
					ldb_uf1		= round(dw_insertar_mejor_ni.getitemnumber(i,'uf'),2)
					ldb_uf2 		= round(dw_insertar_mejor_ni.getitemnumber(i - 1,'uf'),2)
					if ldb_uf1 = ldb_uf2 then
						ll_posicion	= dw_insertar_mejor_ni.getitemnumber(i - 1,'posicion')
						dw_insertar_mejor_ni.setitem(i,'posicion',ll_posicion)
					else
						ll_posicion	= dw_insertar_mejor_ni.getitemnumber(i - 1,'posicion') + 1
						dw_insertar_mejor_ni.setitem(i,'posicion',ll_posicion)
					end if
				end if
			next
		end if
		dw_insertar_mejor_ni.setfilter('posicion < 5')
		dw_insertar_mejor_ni.filter()
		ll_tot_reg					= dw_insertar_mejor_ni.rowcount()
		for i = 1 to ll_tot_reg
			ll_posicion				= dw_insertar_mejor_ni.getitemnumber(i,'posicion')
			ll_porc     			= dw_insertar_mejor_ni.getitemnumber(i,'porc')
			ll_vsp					= dw_insertar_mejor_ni.getitemnumber(i,'vsp')
			if ll_posicion = 1 then
				ll_uno 				= dw_insertar_mejor_ni.getitemnumber(i,'uno')
				SELECT 	"PREMIOS_POR_CAJA_MEJORES"."MONTO" INTO :ll_premio_uno 
				FROM 		"PREMIOS_POR_CAJA_MEJORES" 
				WHERE  ( "PREMIOS_POR_CAJA_MEJORES"."CODIGO" = 1 ) AND 
						 ( "PREMIOS_POR_CAJA_MEJORES"."TIPO_EMPLEADO" = 'A' ) AND 
						 ( "PREMIOS_POR_CAJA_MEJORES"."CANAL" = 'NI' ) AND 
						 ( "PREMIOS_POR_CAJA_MEJORES"."PARQUE" = :ll_cod_parque );
				ll_premio			= ( ll_premio_uno / ll_uno )
				ll_cod_premio		= 1
			elseif ll_posicion = 2 then
				ll_dos				= dw_insertar_mejor_ni.getitemnumber(i,'dos')
				SELECT 	"PREMIOS_POR_CAJA_MEJORES"."MONTO" INTO :ll_premio_dos 
				FROM 		"PREMIOS_POR_CAJA_MEJORES" 
				WHERE  ( "PREMIOS_POR_CAJA_MEJORES"."CODIGO" = 2 ) AND 
						 ( "PREMIOS_POR_CAJA_MEJORES"."TIPO_EMPLEADO" = 'A' ) AND 
						 ( "PREMIOS_POR_CAJA_MEJORES"."CANAL" = 'NI' ) AND 
						 ( "PREMIOS_POR_CAJA_MEJORES"."PARQUE" = :ll_cod_parque );
				ll_premio			= ( ll_premio_dos / ll_dos )
				ll_cod_premio		= 2
			end if
	
			SELECT	"AGENTES"."NOMBRE"||' '||"AGENTES"."A_PATERNO"||' '||"AGENTES"."A_MATERNO","AGENTES"."FECHA_INI"  
			INTO 		:ls_nombre,:ldt_fecha_ini_age 
			FROM 		"AGENTES" 
			WHERE 	"AGENTES"."COD_AGE" = :ls_cod ;
			
			ll_dias_antiguedad	= DaysAfter(date(ldt_fecha_ini_age), ld_fecha_fin)		
			ls_clasificacion		= dw_insertar_mejor_ni.getitemstring(i,'clas')
			ldb_ufs					= dw_insertar_mejor_ni.getitemnumber(i,'uf')
			if ll_porc = 25 and ll_dias_antiguedad >= 180 AND ls_clasificacion = 'A' then 
				ll_premio 			= ll_premio + ( ll_premio * 0.25 )
			end if
			if ll_vsp  >= 1 then ll_premio = ll_premio / 2
			dw_insertar_mejor_ni.setitem(i,'monto',ll_premio)
			ls_cod					= dw_insertar_mejor_ni.getitemstring(i,'cod')
			SELECT	"AGENTES"."NOMBRE"||' '||"AGENTES"."A_PATERNO"||' '||"AGENTES"."A_MATERNO"  
			INTO 		:ls_nombre 
			FROM 		"AGENTES" 
			WHERE 	"AGENTES"."COD_AGE" = :ls_cod ;
			SETNULL(ls_clasificacion)
	
//			INSERT INTO	"PROMESA_LUGAR"  
//					 	 ( "CODIGO","UFS",		"USO","LUGAR"  ,		"AGENTE","MONTO",		"CODIGO_PREMIO",	"FECHA",			"PARQUE"    )  
//			VALUES 	 ( :ls_cod,	:ldb_ufs ,	'NI' ,:ll_posicion,	'A'     ,:ll_premio,	:ll_cod_premio,	:ld_fecha_fin,	:ll_cod_parque )  ;
//			if sqlca.sqlcode = 0 then
//				commit;
//			else
//				rollback;
//				MessageBox("SQL error PROMESA_LUGAR", SQLCA.SQLErrText)
//			end if
		next
	end if
else
	messagebox("Advertencia","Debe Seleccionar Parque")
	dw_parque.setfocus()
end if
tab_1.tabpage_4.st_titulo_ni.italic		= true
SetPointer(Arrow!)
end event

