string title = "none"
string dataobject = "dw_premio_fecha_bkp"
boolean livescroll = true
borderstyle borderstyle = stylelowered!
end type

type cb_print_inf_sem from commandbutton within tabpage_3
integer x = 2789
integer y = 1600
integer width = 594
integer height = 120
integer taborder = 110
integer textsize = -10
integer weight = 400
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = script!
string facename = "Comic Sans MS"
string text = "&Imprimir Informe"
end type

event clicked;Long		ll_cod_parque
Date		ld_fecha_fin,ld_fecha_clas

ld_fecha_fin											= date(em_fec_sem_fin.text)
ll_cod_parque											= dw_parque.getitemnumber(1,'parque')
ld_fecha_clas 											= RelativeDate(   date('01/'+string(month( date(em_fec_sem_fin.text)),'0#')+'/'+string(year(date(em_fec_sem_fin.text)),'####')), - 1)
if ll_cod_parque>0 then
	if dw_informe_semanal.retrieve(date(em_fec_sem_fin.text),ld_fecha_clas,ll_cod_parque) > 0 then
		if ll_cod_parque=1 then
			dw_informe_semanal.object.t_2.text 	= 'El Prado'
		elseif ll_cod_parque=102 then
			dw_informe_semanal.object.t_2.text 	= 'El Manantial'
		elseif ll_cod_parque=11 then
			dw_informe_semanal.object.t_2.text 	= 'La Foresta'
		elseif ll_cod_parque=801 then
			dw_informe_semanal.object.t_2.text 	= 'Concepción'
		end if
		dw_informe_semanal.object.t_12.text 	= gs_nombre_usuario
		if dw_informe_semanal.rowcount() > 0 then
			f_Print( dw_informe_semanal )
		end if
	end if
else
	messagebox("Advertencia","Debe Seleccionar Parque")
end if
end event

type pb_grabar2 from picturebutton within tabpage_3
event ue_mousemove pbm_mousemove
integer x = 2281
integer y = 1588
integer width = 169
integer height = 148
integer taborder = 110
integer textsize = -8
integer weight = 400
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string picturename = "grabar.bmp"
string disabledname = "grabar_no.bmp"
alignment htextalign = left!
end type

event ue_mousemove;st_help_print2.visible		= false
st_help_exportar2.visible	= false
st_help_filtrar2.visible	= false
st_help_grabar2.visible		= true
end event

event clicked;String	ls_base,ls_uso,ls_premio_dos,ls_premio_tres,ls_premio_cuatro,ls_premio_cinco,&
			ls_premio_seis,ls_premio_siete,ls_premio_ocho,ls_clas_age,ls_cod_age,ls_serie,&
			ls_moneda,ls_forma,ls_premio_nueve,ls_premio_dies
Long		ll_cod_parque,ll_tot_reg,ll_indi,ll_sum_dos,ll_sum_tres,ll_sum_cuatro,&
			ll_sum_cinco,ll_sum_seis,ll_sum_siete,ll_sum_ocho,ll_vsp,ll_numero,ll_folio,ll_tope,&
			ll_repartir,ll_porcentaje,ll_codigo_premio,ll_sum_nueve,ll_sum_dies
Date		ld_fecha_ini,ld_fecha_fin
Double	ldb_precio,ldb_uf_dia,ldb_reduce

ls_base						= 'O'
ld_fecha_ini				= date(em_fec_sem_ini.text)
ld_fecha_fin				= date(em_fec_sem_fin.text)
dw_parque.accepttext()
ll_cod_parque				= dw_parque.getitemnumber(1,'parque')

//DELETE FROM "PROMESA_PREMIO" 
//WHERE 		"PROMESA_PREMIO"."FECHA" =  :ld_fecha_fin and 
//				"PROMESA_PREMIO"."PARQUE" = :ll_cod_parque 
//USING			sqlca;
//if sqlca.sqlcode=0 then
//	commit;
//else
//	rollback;
//end if

ll_tot_reg					= dw_lista_semanal.rowcount()
if ll_tot_reg>0 then
	for ll_indi=1 to ll_tot_reg
		ls_uso				= dw_lista_semanal.getitemstring(ll_indi,'uso')
		ls_premio_dos		= dw_lista_semanal.getitemstring(ll_indi,'premio_dos')
		ls_premio_tres   	= dw_lista_semanal.getitemstring(ll_indi,'premio_tres')
		ls_premio_cuatro 	= dw_lista_semanal.getitemstring(ll_indi,'premio_cuatro')
		ls_premio_cinco  	= dw_lista_semanal.getitemstring(ll_indi,'premio_cinco')
		ls_premio_seis   	= dw_lista_semanal.getitemstring(ll_indi,'premio_seis')
		ls_premio_siete  	= dw_lista_semanal.getitemstring(ll_indi,'premio_siete')
		ls_premio_ocho   	= dw_lista_semanal.getitemstring(ll_indi,'premio_ocho')
		ll_sum_dos       	= dw_lista_semanal.getitemnumber(ll_indi,'sum_dos')
		ll_sum_tres      	= dw_lista_semanal.getitemnumber(ll_indi,'sum_tres')
		ll_sum_cuatro    	= dw_lista_semanal.getitemnumber(ll_indi,'sum_cuatro')
		ll_sum_cinco     	= dw_lista_semanal.getitemnumber(ll_indi,'sum_cinco')
		ll_sum_seis      	= dw_lista_semanal.getitemnumber(ll_indi,'sum_seis')
		ll_sum_siete     	= dw_lista_semanal.getitemnumber(ll_indi,'sum_siete')
		ll_sum_ocho      	= dw_lista_semanal.getitemnumber(ll_indi,'sum_ocho')
		ls_clas_age      	= dw_lista_semanal.getitemstring(ll_indi,'clasifica_agente')
		ls_cod_age       	= dw_lista_semanal.getitemstring(ll_indi,'cod_age')
		ls_serie         	= dw_lista_semanal.getitemstring(ll_indi,'serie')
		ll_vsp           	= dw_lista_semanal.getitemnumber(ll_indi,'vsp_agente')
		ll_numero			= dw_lista_semanal.getitemnumber(ll_indi,'numero')
		ll_folio			  	= dw_lista_semanal.getitemnumber(ll_indi,'u_folio')
		ldb_precio 		  	= dw_lista_semanal.getitemnumber(ll_indi,'precio')
		ldb_uf_dia 		  	= dw_lista_semanal.getitemnumber(ll_indi,'uf_dia')
		ls_moneda 		  	= dw_lista_semanal.getitemstring(ll_indi,'moneda')
		if ll_cod_parque = 1 or ll_cod_parque=102 then
			if ls_uso = 'NF' then
				if ls_premio_dos = 'X' then// >=10% Y < 15% NF
					SELECT	"PREMIOS_POR_CAJA"."REPARTIR",	"PREMIOS_POR_CAJA"."TOPE",	"PREMIOS_POR_CAJA"."REDUCE_D"  
					INTO 		:ll_repartir,							:ll_tope,						:ldb_reduce  
					FROM 		"PREMIOS_POR_CAJA"  
					WHERE 	"PREMIOS_POR_CAJA"."CODIGO" = 2 and "PREMIOS_POR_CAJA"."PARQUE" = :ll_cod_parque  ;				
					ls_forma				= '2'
					ll_porcentaje		= 10
					ll_codigo_premio	= 2
					if ll_sum_dos > 0 and ((ll_tope * ll_sum_dos ) > ll_repartir) then ll_tope = ll_repartir / ll_sum_dos
					if ls_clas_age = 'D' or ll_vsp > 1 then ll_tope = ll_tope * ldb_reduce
					wf_insertar_contrato_premio(ls_serie,ll_numero,ls_forma,ls_uso,ld_fecha_fin,ll_tope,ll_porcentaje,ll_codigo_premio,ll_cod_parque)
				end if
				if ls_premio_tres = 'X' then// >= 15% Y < 99% NF
					SELECT	"PREMIOS_POR_CAJA"."REPARTIR",	"PREMIOS_POR_CAJA"."TOPE",	"PREMIOS_POR_CAJA"."REDUCE_D"  
					INTO 		:ll_repartir,							:ll_tope,						:ldb_reduce  
					FROM 		"PREMIOS_POR_CAJA"  
					WHERE 	"PREMIOS_POR_CAJA"."CODIGO" = 3 and "PREMIOS_POR_CAJA"."PARQUE" = :ll_cod_parque  ;				
					ls_forma 			= '2'
					ll_porcentaje 		= 15
					ll_codigo_premio	= 3
					if ll_sum_tres > 0 and ((ll_tope * ll_sum_tres ) > ll_repartir) then ll_tope = ll_repartir / ll_sum_tres
					if ls_clas_age = 'D' or ll_vsp > 1 then ll_tope = ll_tope * ldb_reduce
					wf_insertar_contrato_premio(ls_serie,ll_numero,ls_forma,ls_uso,ld_fecha_fin,ll_tope,ll_porcentaje,ll_codigo_premio,ll_cod_parque)
				end if
				if ls_premio_cuatro = 'X' then// Contado s/d NF
					SELECT	"PREMIOS_POR_CAJA"."REPARTIR",	"PREMIOS_POR_CAJA"."TOPE",	"PREMIOS_POR_CAJA"."REDUCE_D"  
					INTO 		:ll_repartir,							:ll_tope,						:ldb_reduce  
					FROM 		"PREMIOS_POR_CAJA"  
					WHERE 	"PREMIOS_POR_CAJA"."CODIGO" = 4 and "PREMIOS_POR_CAJA"."PARQUE" = :ll_cod_parque  ;
					ls_forma 			= '1'
					ll_porcentaje		= 100
					ll_codigo_premio	= 4
					if ll_sum_cuatro > 0 and ((ll_tope * ll_sum_cuatro ) > ll_repartir) then ll_tope = ll_repartir / ll_sum_cuatro
					if ls_clas_age = 'D' or ll_vsp > 1 then ll_tope = ll_tope * ldb_reduce
					wf_insertar_contrato_premio(ls_serie,ll_numero,ls_forma,ls_uso,ld_fecha_fin,ll_tope,ll_porcentaje,ll_codigo_premio,ll_cod_parque)
				end if
				if ls_premio_cinco = 'X' then
					SELECT 	"PREMIOS_POR_CAJA"."REPARTIR",	"PREMIOS_POR_CAJA"."TOPE",	"PREMIOS_POR_CAJA"."REDUCE_D"  
					INTO 		:ll_repartir,							:ll_tope,						:ldb_reduce  
					FROM 		"PREMIOS_POR_CAJA"  
					WHERE 	"PREMIOS_POR_CAJA"."CODIGO" = 5  and "PREMIOS_POR_CAJA"."PARQUE" = :ll_cod_parque  ;
					ls_forma 			= '3'
					ll_porcentaje 		= 100
					ll_codigo_premio 	= 5
					if ll_sum_cinco > 0 and ((ll_tope * ll_sum_cinco ) > ll_repartir) then ll_tope = ll_repartir / ll_sum_cinco
					if ls_clas_age = 'D' or ll_vsp > 1 then ll_tope = ll_tope * ldb_reduce
					wf_insertar_contrato_premio(ls_serie,ll_numero,ls_forma,ls_uso,ld_fecha_fin,ll_tope,ll_porcentaje,ll_codigo_premio,ll_cod_parque)
				end if
			else
				if ls_premio_seis = 'X' then// 15% NI
					SELECT 	"PREMIOS_POR_CAJA"."REPARTIR","PREMIOS_POR_CAJA"."TOPE",	"PREMIOS_POR_CAJA"."REDUCE_D"  
					INTO 		:ll_repartir,						:ll_tope,						:ldb_reduce  
					FROM 		"PREMIOS_POR_CAJA"  
					WHERE 	"PREMIOS_POR_CAJA"."CODIGO" = 6  and "PREMIOS_POR_CAJA"."PARQUE" = :ll_cod_parque  ;
					ls_forma 			= '2'
					ll_porcentaje 		= 15
					ll_codigo_premio 	= 6
					if ll_sum_seis > 0 and ((ll_tope * ll_sum_seis ) > ll_repartir) then ll_tope = ll_repartir / ll_sum_seis
					if ls_clas_age = 'D' or ll_vsp > 1 then ll_tope = ll_tope * ldb_reduce
					wf_insertar_contrato_premio(ls_serie,ll_numero,ls_forma,ls_uso,ld_fecha_fin,ll_tope,ll_porcentaje,ll_codigo_premio,ll_cod_parque)
				end if
				if ls_premio_siete = 'X' then// Contado s/d NI
					SELECT 	"PREMIOS_POR_CAJA"."REPARTIR","PREMIOS_POR_CAJA"."TOPE",	"PREMIOS_POR_CAJA"."REDUCE_D"  
					INTO 		:ll_repartir,						:ll_tope,						:ldb_reduce  
					FROM 		"PREMIOS_POR_CAJA"  
					WHERE 	"PREMIOS_POR_CAJA"."CODIGO" = 7   and "PREMIOS_POR_CAJA"."PARQUE" = :ll_cod_parque ;
					ls_forma 			= '1'
					ll_porcentaje 		= 100
					ll_codigo_premio 	= 7
					if ll_sum_siete > 0 and ((ll_tope * ll_sum_siete ) > ll_repartir) then ll_tope = ll_repartir / ll_sum_siete
					if ls_clas_age = 'D' or ll_vsp > 1 then ll_tope = ll_tope * ldb_reduce
					wf_insertar_contrato_premio(ls_serie,ll_numero,ls_forma,ls_uso,ld_fecha_fin,ll_tope,ll_porcentaje,ll_codigo_premio,ll_cod_parque)
				end if
				if ls_premio_ocho = 'X' then// Contado c/d NI
					SELECT 	"PREMIOS_POR_CAJA"."REPARTIR","PREMIOS_POR_CAJA"."TOPE",	"PREMIOS_POR_CAJA"."REDUCE_D"  
					INTO 		:ll_repartir,						:ll_tope,						:ldb_reduce  
					FROM 		"PREMIOS_POR_CAJA"  
					WHERE 	"PREMIOS_POR_CAJA"."CODIGO" = 8   and "PREMIOS_POR_CAJA"."PARQUE" = :ll_cod_parque ;
					ls_forma 			= '3'
					ll_porcentaje 		= 100
					ll_codigo_premio 	= 8
					if ll_sum_ocho > 0 and ((ll_tope * ll_sum_ocho ) > ll_repartir) then ll_tope = ll_repartir / ll_sum_ocho
					if ls_clas_age = 'D' or ll_vsp > 1 then ll_tope = ll_tope * ldb_reduce
					wf_insertar_contrato_premio(ls_serie,ll_numero,ls_forma,ls_uso,ld_fecha_fin,ll_tope,ll_porcentaje,ll_codigo_premio,ll_cod_parque)
				end if
			end if
		elseif ll_cod_parque=11 then
			ls_premio_nueve  			= dw_lista_semanal.getitemstring(ll_indi,'premio_nueve')
			ls_premio_dies  			= dw_lista_semanal.getitemstring(ll_indi,'premio_dies')
			ll_sum_nueve    			= dw_lista_semanal.getitemnumber(ll_indi,'sum_nueve')
			ll_sum_dies      			= dw_lista_semanal.getitemnumber(ll_indi,'sum_dies')
			if ls_uso = 'NF' then
				if ls_premio_dos  = 'X' then// 10% - 15% NF
					ll_tope 		= 0
					SELECT 	"PREMIOS_POR_CAJA"."REPARTIR","PREMIOS_POR_CAJA"."TOPE",	"PREMIOS_POR_CAJA"."REDUCE_D"  
					INTO 		:ll_repartir,						:ll_tope,						:ldb_reduce  
					FROM 		"PREMIOS_POR_CAJA"  
					WHERE 	"PREMIOS_POR_CAJA"."CODIGO" = 2  and "PREMIOS_POR_CAJA"."PARQUE" = :ll_cod_parque  ;
					ls_forma 			= '2'
					ll_porcentaje 		= 10
					ll_codigo_premio	= 2
					if ll_sum_dos > 0 and ((ll_tope * ll_sum_dos ) > ll_repartir) then ll_tope = ll_repartir / ll_sum_dos
					if ls_clas_age = 'D' or ll_vsp > 1 then ll_tope = ll_tope * ldb_reduce
					wf_insertar_contrato_premio(ls_serie,ll_numero,ls_forma,ls_uso,ld_fecha_fin,ll_tope,ll_porcentaje,ll_codigo_premio,ll_cod_parque)
				end if
				if ls_premio_tres = 'X' then// 15% - 95% NF
					ll_tope 				= 0
					SELECT 	"PREMIOS_POR_CAJA"."REPARTIR","PREMIOS_POR_CAJA"."TOPE",	"PREMIOS_POR_CAJA"."REDUCE_D"  
					INTO 		:ll_repartir,						:ll_tope,						:ldb_reduce  
					FROM 		"PREMIOS_POR_CAJA"  
					WHERE 	"PREMIOS_POR_CAJA"."CODIGO" = 3  and "PREMIOS_POR_CAJA"."PARQUE" = :ll_cod_parque  ;
					ls_forma 			= '2'
					ll_porcentaje 		= 15
					ll_codigo_premio 	= 3
					if ll_sum_tres > 0 and ((ll_tope * ll_sum_tres ) > ll_repartir) then ll_tope = ll_repartir / ll_sum_tres
					if ls_clas_age = 'D' or ll_vsp > 1 then ll_tope = ll_tope * ldb_reduce
					wf_insertar_contrato_premio(ls_serie,ll_numero,ls_forma,ls_uso,ld_fecha_fin,ll_tope,ll_porcentaje,ll_codigo_premio,ll_cod_parque)
				end if
				if ls_premio_cuatro = 'X' then//Contado s/d NF
					ll_tope 				= 0
					SELECT 	"PREMIOS_POR_CAJA"."REPARTIR","PREMIOS_POR_CAJA"."TOPE",	"PREMIOS_POR_CAJA"."REDUCE_D"  
					INTO 		:ll_repartir,						:ll_tope,						:ldb_reduce  
					FROM 		"PREMIOS_POR_CAJA"  
					WHERE 	"PREMIOS_POR_CAJA"."CODIGO" = 4  and "PREMIOS_POR_CAJA"."PARQUE" = :ll_cod_parque  ;
					ls_forma 			= '2'
					ll_porcentaje 		= 5
					ll_codigo_premio 	= 4
					if ll_sum_cuatro > 0 and ((ll_tope * ll_sum_cuatro ) > ll_repartir) then ll_tope = ll_repartir / ll_sum_cuatro
					if ls_clas_age = 'D' or ll_vsp > 1 then ll_tope = ll_tope * ldb_reduce
					wf_insertar_contrato_premio(ls_serie,ll_numero,ls_forma,ls_uso,ld_fecha_fin,ll_tope,ll_porcentaje,ll_codigo_premio,ll_cod_parque)
				end if
				if ls_premio_cinco = 'X' then//Contado c/d NF
					ll_tope 				= 0
					SELECT 	"PREMIOS_POR_CAJA"."REPARTIR","PREMIOS_POR_CAJA"."TOPE",	"PREMIOS_POR_CAJA"."REDUCE_D"  
					INTO 		:ll_repartir,						:ll_tope,						:ldb_reduce  
					FROM 		"PREMIOS_POR_CAJA"  
					WHERE 	"PREMIOS_POR_CAJA"."CODIGO" = 5  and "PREMIOS_POR_CAJA"."PARQUE" = :ll_cod_parque  ;
					ls_forma 			= '2'
					ll_porcentaje 		= 5
					ll_codigo_premio	= 5
					if ll_sum_cinco > 0 and ((ll_tope * ll_sum_cinco ) > ll_repartir) then ll_tope = ll_repartir / ll_sum_cinco
					if ls_clas_age = 'D' or ll_vsp > 1 then ll_tope = ll_tope * ldb_reduce
					wf_insertar_contrato_premio(ls_serie,ll_numero,ls_forma,ls_uso,ld_fecha_fin,ll_tope,ll_porcentaje,ll_codigo_premio,ll_cod_parque)
				end if
			else
				if ls_premio_seis = 'X' then// 15% - 17.99% NI
					ll_tope 				= 0
					SELECT 	"PREMIOS_POR_CAJA"."REPARTIR","PREMIOS_POR_CAJA"."TOPE", "PREMIOS_POR_CAJA"."REDUCE_D"  
					INTO 		:ll_repartir,						:ll_tope,						:ldb_reduce  
					FROM 		"PREMIOS_POR_CAJA"  
					WHERE 	"PREMIOS_POR_CAJA"."CODIGO" = 6  and "PREMIOS_POR_CAJA"."PARQUE" = :ll_cod_parque  ;
					ls_forma 			= '2'
					ll_porcentaje 		= 5
					ll_codigo_premio	= 6
					if ll_sum_seis > 0 and ((ll_tope * ll_sum_seis ) > ll_repartir) then ll_tope = ll_repartir / ll_sum_seis
					if ls_clas_age = 'D' or ll_vsp > 1 then ll_tope = ll_tope * ldb_reduce
					wf_insertar_contrato_premio(ls_serie,ll_numero,ls_forma,ls_uso,ld_fecha_fin,ll_tope,ll_porcentaje,ll_codigo_premio,ll_cod_parque)
				end if
				if ls_premio_siete = 'X' then// 18% - 19.99% NI
					ll_tope 				= 0
					SELECT 	"PREMIOS_POR_CAJA"."REPARTIR","PREMIOS_POR_CAJA"."TOPE",	"PREMIOS_POR_CAJA"."REDUCE_D"  
					INTO 		:ll_repartir,						:ll_tope,						:ldb_reduce  
					FROM 		"PREMIOS_POR_CAJA"  
					WHERE 	"PREMIOS_POR_CAJA"."CODIGO" = 7   and "PREMIOS_POR_CAJA"."PARQUE" = :ll_cod_parque ;
					ls_forma 			= '2'
					ll_porcentaje 		= 5
					ll_codigo_premio	= 7
					if ll_sum_siete > 0 and ((ll_tope * ll_sum_siete ) > ll_repartir) then ll_tope = ll_repartir / ll_sum_siete
					if ls_clas_age = 'D' or ll_vsp > 1 then ll_tope = ll_tope * ldb_reduce
					wf_insertar_contrato_premio(ls_serie,ll_numero,ls_forma,ls_uso,ld_fecha_fin,ll_tope,ll_porcentaje,ll_codigo_premio,ll_cod_parque)
				end if
				if ls_premio_ocho = 'X' then// 20% NI
					ll_tope 				= 0
					SELECT 	"PREMIOS_POR_CAJA"."REPARTIR","PREMIOS_POR_CAJA"."TOPE",	"PREMIOS_POR_CAJA"."REDUCE_D"  
					INTO 		:ll_repartir,						:ll_tope,						:ldb_reduce  
					FROM 		"PREMIOS_POR_CAJA"  
					WHERE 	"PREMIOS_POR_CAJA"."CODIGO" = 8  and "PREMIOS_POR_CAJA"."PARQUE" = :ll_cod_parque  ;
					ls_forma 			= '2'
					ll_porcentaje 		= 5
					ll_codigo_premio	= 8
					if ll_sum_ocho > 0 and ((ll_tope * ll_sum_ocho ) > ll_repartir) then ll_tope = ll_repartir / ll_sum_ocho
					if ls_clas_age = 'D' or ll_vsp > 1 then ll_tope = ll_tope * ldb_reduce
					wf_insertar_contrato_premio(ls_serie,ll_numero,ls_forma,ls_uso,ld_fecha_fin,ll_tope,ll_porcentaje,ll_codigo_premio,ll_cod_parque)
				end if
				if ls_premio_nueve = 'X' then//Contado s/d NI
					ll_tope 				= 0
					SELECT 	"PREMIOS_POR_CAJA"."REPARTIR","PREMIOS_POR_CAJA"."TOPE",	"PREMIOS_POR_CAJA"."REDUCE_D"  
					INTO 		:ll_repartir,						:ll_tope,						:ldb_reduce  
					FROM 		"PREMIOS_POR_CAJA"  
					WHERE 	"PREMIOS_POR_CAJA"."CODIGO" = 9  and "PREMIOS_POR_CAJA"."PARQUE" = :ll_cod_parque  ;
					ls_forma 			= '2'
					ll_porcentaje 		= 5
					ll_codigo_premio 	= 9
					if ll_sum_nueve > 0 and ((ll_tope * ll_sum_nueve ) > ll_repartir) then ll_tope = ll_repartir / ll_sum_nueve
					if ls_clas_age = 'D' or ll_vsp > 1 then ll_tope = ll_tope * ldb_reduce
					wf_insertar_contrato_premio(ls_serie,ll_numero,ls_forma,ls_uso,ld_fecha_fin,ll_tope,ll_porcentaje,ll_codigo_premio,ll_cod_parque)
				end if
				if ls_premio_dies = 'X' then//Contado c/d NI
					ll_tope 				= 0
					SELECT 	"PREMIOS_POR_CAJA"."REPARTIR","PREMIOS_POR_CAJA"."TOPE",	"PREMIOS_POR_CAJA"."REDUCE_D"  
					INTO 		:ll_repartir,						:ll_tope,						:ldb_reduce  
					FROM 		"PREMIOS_POR_CAJA"  
					WHERE 	"PREMIOS_POR_CAJA"."CODIGO" = 10  and "PREMIOS_POR_CAJA"."PARQUE" = :ll_cod_parque  ;
					ls_forma 			= '2'
					ll_porcentaje 		= 5
					ll_codigo_premio	= 10
					if ll_sum_dies > 0 and ((ll_tope * ll_sum_dies ) > ll_repartir) then ll_tope = ll_repartir / ll_sum_dies
					if ls_clas_age = 'D' or ll_vsp > 1 then ll_tope = ll_tope * ldb_reduce
					wf_insertar_contrato_premio(ls_serie,ll_numero,ls_forma,ls_uso,ld_fecha_fin,ll_tope,ll_porcentaje,ll_codigo_premio,ll_cod_parque)
				end if	
			end if
		end if
	next
end if
end event

