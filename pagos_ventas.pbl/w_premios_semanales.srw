type cb_res_comi from commandbutton within w_premios_semanales
integer x = 2075
integer y = 52
integer width = 343
integer height = 96
integer taborder = 50
integer textsize = -8
integer weight = 400
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string text = "&Res - Comi"
end type

event clicked;date fecha

if messagebox('Cambiar de Estado','¿ Desea Cambiar de Estado para Procesos Anteriores ?',stopsign!, OKCancel!, 2) = 1 then
	fecha = date(tab_1.tabpage_2.em_fecha_fin.text)
	UPDATE "OFERTA_V"  
	SET    "ESTADO_PREMIO"        = 'S', 
			 "CIERRE_VENTA_SEMANAL" = :fecha   
			WHERE ( "OFERTA_V"."ESTADO_PREMIO"       = 'N'    ) AND  
			      ( "OFERTA_V"."U_FECHA"            <= :fecha ) AND 
			      ( "OFERTA_V"."FECHA_INGRESO"      <= :fecha ) AND 
			      ( "OFERTA_V"."U_FECHA" IS NOT NULL          ) AND  
			      ( "OFERTA_V"."SERIE"              <> 'R'    ) AND 
			      ( "OFERTA_V"."CIERRE_VENTA_SEMANAL" IS NULL ) ;
	if sqlca.sqlcode = 0 then
		commit;
	else
		MessageBox("SQL error OFERTA_V", SQLCA.SQLErrText,information!)
		rollback;
	end if
	UPDATE "ANEXO_LIBERADOR"  
	SET "ESTADO_PREMIO"        = 'S',   
		 "CIERRE_VENTA_SEMANAL" = :fecha  
	WHERE ( "ANEXO_LIBERADOR"."ESTADO_PREMIO"   = 'N'        ) AND  
			( "ANEXO_LIBERADOR"."U_FECHA"        <= :fecha     ) AND 
			( "ANEXO_LIBERADOR"."FECHA_INGRESO"  <= :fecha     ) AND 
			( "ANEXO_LIBERADOR"."U_FECHA" IS NOT NULL          ) AND 
			( "ANEXO_LIBERADOR"."CIERRE_VENTA_SEMANAL" IS NULL ) ;
	if sqlca.sqlcode = 0 then
		commit;
	else
		MessageBox("SQL error ANEXO_LIBERADOR", SQLCA.SQLErrText,information!)
		rollback;
	end if
end if
end event

