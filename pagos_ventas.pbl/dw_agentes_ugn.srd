 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"agentes~" )  TABLE(NAME=~"ugn_cotizacion_agente~" ) COLUMN(NAME=~"ugn_cotizacion_agente.cod_agente~") COLUMN(NAME=~"agentes.nombre~") COLUMN(NAME=~"agentes.a_paterno~") COLUMN(NAME=~"agentes.a_materno~") COLUMN(NAME=~"agentes.fecha_ini~") COLUMN(NAME=~"ugn_cotizacion_agente.fono~") COLUMN(NAME=~"ugn_cotizacion_agente.fono_comercial~") COLUMN(NAME=~"ugn_cotizacion_agente.celular~") COLUMN(NAME=~"ugn_cotizacion_agente.email~") COLUMN(NAME=~"ugn_cotizacion_agente.orden_datos~") COLUMN(NAME=~"ugn_cotizacion_agente.estado~") COLUMN(NAME=~"agentes.cod_sup~")    JOIN (LEFT=~"agentes.cod_age~"    OP =~"=~"RIGHT=~"ugn_cotizacion_agente.cod_agente~" )WHERE(    EXP1 =~"~~~"AGENTES~~~".~~~"DEPTO~~~"~"   OP =~"=~"    EXP2 =~"'X'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"AGENTES~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'A'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"AGENTES~~~".~~~"CANAL~~~"~"   OP =~"=~"    EXP2 =~"'UG'~" ) ) "  sort="ugn_cotizacion_agente_orden_datos A " )
