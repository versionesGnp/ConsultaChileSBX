 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"agentes~" )  TABLE(NAME=~"oferta_v~" )  TABLE(NAME=~"pago_oferta~" )  TABLE(NAME=~"cadena~" ) COLUMN(NAME=~"agentes.cod_age~") COLUMN(NAME=~"agentes.nombre~") COLUMN(NAME=~"agentes.a_paterno~") COLUMN(NAME=~"agentes.a_materno~") COLUMN(NAME=~"agentes.fecha_ini~") COLUMN(NAME=~"agentes.estado~") COLUMN(NAME=~"agentes.rut~") COLUMN(NAME=~"oferta_v.serie~") COLUMN(NAME=~"oferta_v.nro_oferta~") COLUMN(NAME=~"oferta_v.fecha~") COLUMN(NAME=~"oferta_v.uso~") COLUMN(NAME=~"pago_oferta.moneda~") COLUMN(NAME=~"pago_oferta.precio~") COLUMN(NAME=~"oferta_v.tot_pagado~") COLUMN(NAME=~"pago_oferta.area~") COLUMN(NAME=~"oferta_v.porce_venta~") COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"cadena.cod_parque~") COMPUTE(NAME=~"0~") COMPUTE(NAME=~"''~") COMPUTE(NAME=~"0~") COMPUTE(NAME=~"0~") COMPUTE(NAME=~"0~") COMPUTE(NAME=~"''~") COLUMN(NAME=~"cadena.rut~")    JOIN (LEFT=~"oferta_v.cod_age~"    OP =~"=~"RIGHT=~"agentes.cod_age~" )    JOIN (LEFT=~"oferta_v.serie~"    OP =~"=~"RIGHT=~"pago_oferta.serie~" )    JOIN (LEFT=~"oferta_v.nro_oferta~"    OP =~"=~"RIGHT=~"pago_oferta.nro_oferta~" )    JOIN (LEFT=~"oferta_v.ult_folio~"    OP =~"=~"RIGHT=~"pago_oferta.folio~" )    JOIN (LEFT=~"pago_oferta.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"pago_oferta.nro_oferta~"    OP =~"=~"RIGHT=~"cadena.numero~" )WHERE(    EXP1 =~"~~~"OFERTA_V~~~".~~~"ESTADO_COMI~~~"~"   OP =~"<>~"    EXP2 =~"'P'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'O'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"CADENA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'V'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'C')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"AGENTES~~~".~~~"DEPTO~~~"~"   OP =~"=~"    EXP2 =~"'E'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"OFERTA_V~~~".~~~"SERIE~~~"~"   OP =~"<>~"    EXP2 =~"'R'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"AGENTES~~~".~~~"PAGOS_VENTA~~~"~"   OP =~"=~"    EXP2 =~"'S'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"OFERTA_V~~~".~~~"CIERRE_VENTA~~~"~"   OP =~">=~"    EXP2 =~"to_date('31/01/2017','dd/mm/yyyy')~" ) )    UNION (PBSELECT( VERSION(400) TABLE(NAME=~"agentes~" )  TABLE(NAME=~"anexo_liberador~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"pago_liberador~" ) COLUMN(NAME=~"agentes.cod_age~") COLUMN(NAME=~"agentes.nombre~") COLUMN(NAME=~"agentes.a_paterno~") COLUMN(NAME=~"agentes.a_materno~") COLUMN(NAME=~"agentes.fecha_ini~") COLUMN(NAME=~"agentes.estado~") COLUMN(NAME=~"agentes.rut~") COLUMN(NAME=~"anexo_liberador.serie_m~") COLUMN(NAME=~"anexo_liberador.nro_liberador~") COLUMN(NAME=~"pago_liberador.fecha~") COMPUTE(NAME=~"'NF' AS USO~") COLUMN(NAME=~"pago_liberador.moneda~") COLUMN(NAME=~"pago_liberador.precio~") COLUMN(NAME=~"anexo_liberador.tot_pagado~") COMPUTE(NAME=~"'' AS AREA~") COLUMN(NAME=~"anexo_liberador.porce_age~") COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"cadena.cod_parque~") COMPUTE(NAME=~"0~") COMPUTE(NAME=~"''~") COMPUTE(NAME=~"0~") COMPUTE(NAME=~"0~") COMPUTE(NAME=~"0~") COMPUTE(NAME=~"''~") COLUMN(NAME=~"cadena.rut~")    JOIN (LEFT=~"agentes.cod_age~"    OP =~"=~"RIGHT=~"anexo_liberador.cod_agente~" )    JOIN (LEFT=~"anexo_liberador.serie_m~"    OP =~"=~"RIGHT=~"pago_liberador.serie_m~" )    JOIN (LEFT=~"anexo_liberador.nro_liberador~"    OP =~"=~"RIGHT=~"pago_liberador.nro_liberador~" )    JOIN (LEFT=~"anexo_liberador.ult_folio~"    OP =~"=~"RIGHT=~"pago_liberador.folio~" )    JOIN (LEFT=~"anexo_liberador.serie_m~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"anexo_liberador.nro_liberador~"    OP =~"=~"RIGHT=~"cadena.numero~" )WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'L'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"(~~~"CADENA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'V'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'C')~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"AGENTES~~~".~~~"DEPTO~~~"~"   OP =~"=~"    EXP2 =~"'E'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"AGENTES~~~".~~~"PAGOS_VENTA~~~"~"   OP =~"=~"    EXP2 =~"'S'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"PAGO_LIBERADOR~~~".~~~"FECHA~~~"~"   OP =~">=~"    EXP2 =~"to_date('01/07/2015','dd/mm/yyyy')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"ANEXO_LIBERADOR~~~".~~~"CIERRE_VENTA~~~"~"   OP =~">=~"    EXP2 =~"to_date('31/01/2017','dd/mm/yyyy')~" ) )) " )
