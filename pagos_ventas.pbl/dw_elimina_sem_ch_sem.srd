 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"documentos~" )  TABLE(NAME=~"oferta_v~" )  TABLE(NAME=~"ingreso~" )  TABLE(NAME=~"pago_oferta~" )  TABLE(NAME=~"tab_uf~" )  TABLE(NAME=~"cadena~" ) COLUMN(NAME=~"ingreso.base~") COLUMN(NAME=~"ingreso.serie~") COLUMN(NAME=~"ingreso.contrato~") COLUMN(NAME=~"ingreso.tipo_mov~") COLUMN(NAME=~"documentos.cod_pago~") COLUMN(NAME=~"documentos.estado_ch~") COLUMN(NAME=~"documentos.monto~") COLUMN(NAME=~"oferta_v.estado_premio~") COLUMN(NAME=~"documentos.fecha_venc~") COLUMN(NAME=~"pago_oferta.precio~") COLUMN(NAME=~"tab_uf.valor_uf~") COLUMN(NAME=~"pago_oferta.moneda~")    JOIN (LEFT=~"oferta_v.serie~"    OP =~"=~"RIGHT=~"ingreso.serie~" )    JOIN (LEFT=~"oferta_v.nro_oferta~"    OP =~"=~"RIGHT=~"ingreso.contrato~" )    JOIN (LEFT=~"documentos.folio~"    OP =~"=~"RIGHT=~"ingreso.folio~" )    JOIN (LEFT=~"ingreso.tipo_cob~"    OP =~"=~"RIGHT=~"documentos.tipo_cob~" )    JOIN (LEFT=~"ingreso.fecha_pago~"    OP =~"=~"RIGHT=~"documentos.fecha_pago~" )    JOIN (LEFT=~"pago_oferta.serie~"    OP =~"=~"RIGHT=~"oferta_v.serie~" )    JOIN (LEFT=~"pago_oferta.nro_oferta~"    OP =~"=~"RIGHT=~"oferta_v.nro_oferta~" )    JOIN (LEFT=~"pago_oferta.folio~"    OP =~"=~"RIGHT=~"oferta_v.ult_folio~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"ingreso.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"ingreso.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"ingreso.contrato~" )WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~"'O'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"INGRESO~~~".~~~"TIPO_MOV~~~"~"   OP =~"=~"    EXP2 =~"'A'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"TIPO_MOV~~~"~"   OP =~"=~"    EXP2 =~"'K'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"TIPO_MOV~~~"~"   OP =~"=~"    EXP2 =~"'E')~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"OFERTA_V~~~".~~~"U_FECHA~~~"~"   OP =~"<=~"    EXP2 =~":fecha~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"OFERTA_V~~~".~~~"ESTADO_PREMIO~~~"~"   OP =~"=~"    EXP2 =~"'N'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"TAB_UF~~~".~~~"FECHA_UF~~~"~"   OP =~"=~"    EXP2 =~":fecha~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"CADENA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'V'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'C')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"OFERTA_V~~~".~~~"FECHA~~~"~"   OP =~">=~"    EXP2 =~"sysdate - 90~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"OFERTA_V~~~".~~~"SERIE~~~"~"   OP =~"<>~"    EXP2 =~"'R'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"DOCUMENTOS~~~".~~~"COD_PAGO~~~"~"   OP =~"=~"    EXP2 =~"'CH'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"DOCUMENTOS~~~".~~~"ESTADO_CH~~~"~"   OP =~"<>~"    EXP2 =~"'C'~" ) ) ORDER(NAME=~"ingreso.serie~" ASC=yes )  ORDER(NAME=~"ingreso.contrato~" ASC=yes )  ORDER(NAME=~"documentos.fecha_venc~" ASC=yes ) ARG(NAME = ~"fecha~" TYPE = date) " arguments=(("fecha", date)) )
