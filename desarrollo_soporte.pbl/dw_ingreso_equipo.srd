 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"soporte_equipos~" )  TABLE(NAME=~"tcp_ip_parque~" ) COLUMN(NAME=~"soporte_equipos.id_pc~") COLUMN(NAME=~"soporte_equipos.placa_madre~") COLUMN(NAME=~"soporte_equipos.memoria~") COLUMN(NAME=~"soporte_equipos.disco~") COLUMN(NAME=~"soporte_equipos.lector_grabador~") COLUMN(NAME=~"soporte_equipos.tarjeta_video~") COLUMN(NAME=~"soporte_equipos.tarjeta_sonido~") COLUMN(NAME=~"soporte_equipos.tarjeta_wireless~") COLUMN(NAME=~"soporte_equipos.monitor~") COLUMN(NAME=~"soporte_equipos.parlantes~") COLUMN(NAME=~"soporte_equipos.impresora~") COLUMN(NAME=~"soporte_equipos.ip~") COLUMN(NAME=~"soporte_equipos.depto_usuario~") COLUMN(NAME=~"soporte_equipos.fecha_ingreso~") COLUMN(NAME=~"soporte_equipos.procesador~") COLUMN(NAME=~"soporte_equipos.otros~") COLUMN(NAME=~"soporte_equipos.desc_lector_grabador~") COLUMN(NAME=~"soporte_equipos.correlativo~") COLUMN(NAME=~"tcp_ip_parque.estado~") COLUMN(NAME=~"tcp_ip_parque.glosa_estado~") COLUMN(NAME=~"soporte_equipos.direccion_mac~") COLUMN(NAME=~"soporte_equipos.nombre_usuario~") COLUMN(NAME=~"soporte_equipos.ubicacion~")    JOIN (LEFT=~"soporte_equipos.ip~"    OP =~"=~"RIGHT=~"tcp_ip_parque.tcp_ip~" )WHERE(    EXP1 =~"~~~"SOPORTE_EQUIPOS~~~".~~~"IP~~~"~"   OP =~"=~"    EXP2 =~":ip~" ) ) ARG(NAME = ~"ip~" TYPE = string) " update="SOPORTE_EQUIPOS" updatewhere=1 updatekeyinplace=yes arguments=(("ip", string)) )
