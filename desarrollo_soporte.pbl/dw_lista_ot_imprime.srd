 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"soporte_atencion~" )  TABLE(NAME=~"soporte_detalle_mantencion~" ) COLUMN(NAME=~"soporte_atencion.id_pc~") COLUMN(NAME=~"soporte_atencion.codigo_atencion~") COLUMN(NAME=~"soporte_atencion.fecha_ingreso~") COLUMN(NAME=~"soporte_atencion.fecha_termino~") COLUMN(NAME=~"soporte_atencion.usuario_soporte~") COLUMN(NAME=~"soporte_atencion.depto~") COLUMN(NAME=~"soporte_atencion.observacion_ini~") COLUMN(NAME=~"soporte_atencion.estado_ot~") COLUMN(NAME=~"soporte_atencion.usuario_contacto~") COLUMN(NAME=~"soporte_atencion.observacion_final~") COLUMN(NAME=~"soporte_atencion.correlativo_ot~") COLUMN(NAME=~"soporte_atencion.estado_prioridad~") COLUMN(NAME=~"soporte_atencion.anexos~") COLUMN(NAME=~"soporte_atencion.fecha_asignacion~") COLUMN(NAME=~"soporte_atencion.estado_inicial~") COLUMN(NAME=~"soporte_atencion.usuario_crea~") COLUMN(NAME=~"soporte_detalle_mantencion.descripcion_detalle~") COLUMN(NAME=~"soporte_detalle_mantencion.codigo_des_mantencion~") COLUMN(NAME=~"soporte_detalle_mantencion.estado_mantencion~")    JOIN (LEFT=~"soporte_atencion.correlativo_ot~"    OP =~"=~"RIGHT=~"soporte_detalle_mantencion.correlativo~" )WHERE(    EXP1 =~"~~~"SOPORTE_ATENCION~~~".~~~"CORRELATIVO_OT~~~"~"   OP =~"=~"    EXP2 =~":correlativo~" ) ) ARG(NAME = ~"correlativo~" TYPE = number) " arguments=(("correlativo", number))  sort="soporte_detalle_mantencion_codigo_des_mantencion A " )
