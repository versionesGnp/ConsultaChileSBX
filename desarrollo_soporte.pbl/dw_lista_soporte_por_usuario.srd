 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"soporte_atencion~" ) COLUMN(NAME=~"soporte_atencion.id_pc~") COLUMN(NAME=~"soporte_atencion.codigo_atencion~") COLUMN(NAME=~"soporte_atencion.fecha_ingreso~") COLUMN(NAME=~"soporte_atencion.fecha_termino~") COLUMN(NAME=~"soporte_atencion.usuario_soporte~") COLUMN(NAME=~"soporte_atencion.depto~") COLUMN(NAME=~"soporte_atencion.observacion_ini~") COLUMN(NAME=~"soporte_atencion.estado_ot~") COLUMN(NAME=~"soporte_atencion.usuario_contacto~") COLUMN(NAME=~"soporte_atencion.observacion_final~") COLUMN(NAME=~"soporte_atencion.correlativo_ot~") COLUMN(NAME=~"soporte_atencion.estado_prioridad~") COLUMN(NAME=~"soporte_atencion.estado_inicial~")WHERE(    EXP1 =~"~~~"SOPORTE_ATENCION~~~".~~~"FECHA_INGRESO~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOPORTE_ATENCION~~~".~~~"FECHA_INGRESO~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"SOPORTE_ATENCION~~~".~~~"USUARIO_SOPORTE~~~"~"   OP =~"=~"    EXP2 =~":usuario~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"SOPORTE_ATENCION~~~".~~~"ESTADO_INICIAL~~~"~"   OP =~"=~"    EXP2 =~"'S')~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = datetime)  ARG(NAME = ~"fecha_fin~" TYPE = datetime)  ARG(NAME = ~"usuario~" TYPE = string) " update="SOPORTE_ATENCION" updatewhere=1 updatekeyinplace=no arguments=(("fecha_ini", datetime),("fecha_fin", datetime),("usuario", string))  sort="correlativo_ot A " )
