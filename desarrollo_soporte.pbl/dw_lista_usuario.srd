 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"encargados~" ) COLUMN(NAME=~"encargados.codigo_usuario~") COLUMN(NAME=~"encargados.password~") COLUMN(NAME=~"encargados.fecha_termino~") COLUMN(NAME=~"encargados.fecha_expiracion~") COLUMN(NAME=~"encargados.estado~") COLUMN(NAME=~"encargados.email~") COLUMN(NAME=~"encargados.anexos~") COLUMN(NAME=~"encargados.nombre~")WHERE(    EXP1 =~"(~~~"ENCARGADOS~~~".~~~"DEPTO~~~"~"   OP =~"<>~"    EXP2 =~"'I')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"ENCARGADOS~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'A'~" ) ) "  sort="nombre A " )
