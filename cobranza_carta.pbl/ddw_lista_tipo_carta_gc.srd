 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"gc_tipo_carta~" ) COLUMN(NAME=~"gc_tipo_carta.clasificacion~") COLUMN(NAME=~"gc_tipo_carta.parque~") COLUMN(NAME=~"gc_tipo_carta.accion~") COLUMN(NAME=~"gc_tipo_carta.depto~") COLUMN(NAME=~"gc_tipo_carta.filtro~") COLUMN(NAME=~"gc_tipo_carta.descripcion~")WHERE(    EXP1 =~"~~~"GC_TIPO_CARTA~~~".~~~"PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"GC_TIPO_CARTA~~~".~~~"DEPTO~~~"~"   OP =~"=~"    EXP2 =~"'F'~" ) ) ORDER(NAME=~"gc_tipo_carta.clasificacion~" ASC=yes ) ARG(NAME = ~"parque~" TYPE = number) " update="GC_TIPO_CARTA" updatewhere=1 updatekeyinplace=no arguments=(("parque", number))  sort="clasificacion A " )
