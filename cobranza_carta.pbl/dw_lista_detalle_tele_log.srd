 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cliente~" )  TABLE(NAME=~"tele_log~" ) COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"cliente.fono_p~") COLUMN(NAME=~"cliente.fono_c~") COLUMN(NAME=~"cliente.celular~") COLUMN(NAME=~"tele_log.rut~") COLUMN(NAME=~"tele_log.estado~") COLUMN(NAME=~"tele_log.fecha~") COLUMN(NAME=~"tele_log.glosa~") COLUMN(NAME=~"tele_log.usuario~") COLUMN(NAME=~"tele_log.base~") COLUMN(NAME=~"tele_log.serie~") COLUMN(NAME=~"tele_log.numero~")    JOIN (LEFT=~"cliente.rut~"    OP =~"=~"RIGHT=~"tele_log.rut~" )WHERE(    EXP1 =~"~~~"TELE_LOG~~~".~~~"RUT~~~"~"   OP =~"=~"    EXP2 =~":rut~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"TELE_LOG~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~":estado~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"TELE_LOG~~~".~~~"FECHA~~~"~"   OP =~"=~"    EXP2 =~":fecha~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"TELE_LOG~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"TELE_LOG~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"TELE_LOG~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~" ) ) ARG(NAME = ~"rut~" TYPE = number)  ARG(NAME = ~"estado~" TYPE = string)  ARG(NAME = ~"fecha~" TYPE = datetime)  ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number) " arguments=(("rut", number),("estado", string),("fecha", datetime),("base", string),("serie", string),("numero", number)) )
