 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cliente~" )  TABLE(NAME=~"ciudad~" )  TABLE(NAME=~"comuna~" )  TABLE(NAME=~"tipo_via~" )  TABLE(NAME=~"gc_detalle_gestion~" )  TABLE(NAME=~"gc_lista_gestion~" )  TABLE(NAME=~"gc_tipo_carta~" ) COMPUTE(NAME=~"~~~"CLIENTE~~~".~~~"NOMBRE~~~"||' '||~~~"CLIENTE~~~".~~~"A_PATERNO~~~"||' '||~~~"CLIENTE~~~".~~~"A_MATERNO~~~"~") COLUMN(NAME=~"tipo_via.descripcion~") COLUMN(NAME=~"cliente.direccion_p~") COLUMN(NAME=~"cliente.numero_particular~") COLUMN(NAME=~"cliente.depto_particular~") COLUMN(NAME=~"cliente.block_particular~") COLUMN(NAME=~"cliente.poblacion~") COLUMN(NAME=~"comuna.comuna~") COLUMN(NAME=~"ciudad.sigla_ciudad~") COLUMN(NAME=~"gc_detalle_gestion.base~") COLUMN(NAME=~"gc_detalle_gestion.serie~") COLUMN(NAME=~"gc_detalle_gestion.numero~") COLUMN(NAME=~"gc_detalle_gestion.fecha_carta_envio~") COLUMN(NAME=~"gc_detalle_gestion.clasificacion~") COLUMN(NAME=~"gc_detalle_gestion.cod_parque~") COLUMN(NAME=~"gc_detalle_gestion.correlativo~") COLUMN(NAME=~"gc_detalle_gestion.cod_grupo~") COLUMN(NAME=~"gc_detalle_gestion.rut_cliente~") COLUMN(NAME=~"cliente.estado_titular~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~")    JOIN (LEFT=~"cliente.tipo_via~"    OP =~"=~"RIGHT=~"tipo_via.tipo_via~" )    JOIN (LEFT=~"cliente.comuna~"    OP =~"=~"RIGHT=~"comuna.codigo_comuna~" )    JOIN (LEFT=~"cliente.ciudad~"    OP =~"=~"RIGHT=~"ciudad.codigo_ciudad~" )    JOIN (LEFT=~"gc_detalle_gestion.rut_cliente~"    OP =~"=~"RIGHT=~"cliente.rut~" )    JOIN (LEFT=~"gc_detalle_gestion.cod_grupo~"    OP =~"=~"RIGHT=~"gc_lista_gestion.codigo_grupo~" )    JOIN (LEFT=~"gc_detalle_gestion.clasificacion~"    OP =~"=~"RIGHT=~"gc_tipo_carta.clasificacion~" )    JOIN (LEFT=~"gc_detalle_gestion.cod_parque~"    OP =~"=~"RIGHT=~"gc_tipo_carta.parque~" )WHERE(    EXP1 =~"~~~"GC_DETALLE_GESTION~~~".~~~"FECHA_CARTA_ENVIO~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"GC_DETALLE_GESTION~~~".~~~"FECHA_CARTA_ENVIO~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"GC_DETALLE_GESTION~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"GC_TIPO_CARTA~~~".~~~"DEPTO~~~"~"   OP =~"like~"    EXP2 =~":depto~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"GC_DETALLE_GESTION~~~".~~~"CLASIFICACION~~~"~"   OP =~"<>~"    EXP2 =~"'D8'~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = datetime)  ARG(NAME = ~"fecha_fin~" TYPE = datetime)  ARG(NAME = ~"parque~" TYPE = number)  ARG(NAME = ~"depto~" TYPE = string) " arguments=(("fecha_ini", datetime),("fecha_fin", datetime),("parque", number),("depto", string))  sort="gc_detalle_gestion_cod_grupo A gc_detalle_gestion_correlativo A " )
