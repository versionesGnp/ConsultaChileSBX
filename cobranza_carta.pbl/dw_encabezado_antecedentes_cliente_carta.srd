 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ciudad~" )  TABLE(NAME=~"cliente~" )  TABLE(NAME=~"comuna~" ) COLUMN(NAME=~"cliente.rut~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cliente.direccion_p~") COLUMN(NAME=~"cliente.poblacion~") COLUMN(NAME=~"ciudad.codigo_ciudad~") COLUMN(NAME=~"ciudad.ciudad~") COLUMN(NAME=~"comuna.codigo_comuna~") COLUMN(NAME=~"comuna.comuna~") COLUMN(NAME=~"cliente.fono_p~") COLUMN(NAME=~"cliente.domicilio_c~") COLUMN(NAME=~"cliente.fono_c~") COLUMN(NAME=~"cliente.estado_titular~") COLUMN(NAME=~"cliente.asignado_cobranza~") COLUMN(NAME=~"cliente.fecha_prox_llamado~") COLUMN(NAME=~"cliente.ult_cod_envio_carta~") COLUMN(NAME=~"cliente.ult_estado_envio_carta~") COLUMN(NAME=~"cliente.ult_fecha_envio_carta~") COLUMN(NAME=~"cliente.ult_cod_accion_envio_carta~") COLUMN(NAME=~"cliente.ult_clasificacion_envio_carta~") COLUMN(NAME=~"cliente.tipo_via~") COLUMN(NAME=~"cliente.numero_particular~") COLUMN(NAME=~"cliente.depto_particular~") COLUMN(NAME=~"cliente.block_particular~")    JOIN (LEFT=~"ciudad.codigo_ciudad~"    OP =~"=~"RIGHT=~"cliente.ciudad~" )    JOIN (LEFT=~"cliente.comuna~"    OP =~"=~"RIGHT=~"comuna.codigo_comuna~" )WHERE(    EXP1 =~"~~~"CLIENTE~~~".~~~"RUT~~~"~"   OP =~"=~"    EXP2 =~":rut~" ) ) ARG(NAME = ~"rut~" TYPE = number) " arguments=(("rut", number)) )
