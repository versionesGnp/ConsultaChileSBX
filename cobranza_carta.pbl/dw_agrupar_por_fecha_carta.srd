 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cadena~" )  TABLE(NAME=~"carta_log~" ) COLUMN(NAME=~"carta_log.estado_env~") COLUMN(NAME=~"carta_log.fecha_carta~") COMPUTE(NAME=~"to_date(~~~"CARTA_LOG~~~".~~~"FECHA_CARTA~~~"), to_number(~~~"CARTA_LOG~~~".~~~"ESTADO_ENV~~~")~")    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"carta_log.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"carta_log.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"carta_log.numero~" )WHERE(    EXP1 =~"(~~~"CARTA_LOG~~~".~~~"FECHA_CARTA~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CARTA_LOG~~~".~~~"FECHA_CARTA~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin)~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~" ) ) ORDER(NAME=~"carta_log.fecha_carta~" ASC=no) ARG(NAME = ~"fecha_ini~" TYPE = date)  ARG(NAME = ~"fecha_fin~" TYPE = date)  ARG(NAME = ~"parque~" TYPE = number) " arguments=(("fecha_ini", date),("fecha_fin", date),("parque", number)) )
