_envio_carta~") COLUMN(NAME=~"vista_gc_j.ult_estado_envio_carta~") COLUMN(NAME=~"vista_gc_j.ult_estado_pub~") COLUMN(NAME=~"vista_gc_j.ult_glosa_pub~") COLUMN(NAME=~"vista_gc_j.ult_fecha_pub~") COLUMN(NAME=~"vista_gc_j.tipo_via_descripcion~") COLUMN(NAME=~"vista_gc_j.uso~") COMPUTE(NAME=~"to_date(sysdate)~") COMPUTE(NAME=~"''~") COMPUTE(NAME=~"0~") COLUMN(NAME=~"vista_gc_j.area~") COLUMN(NAME=~"vista_gc_j.sector~") COLUMN(NAME=~"vista_gc_j.sepultura~") COLUMN(NAME=~"vista_gc_j.capacidad~") COLUMN(NAME=~"at_gestion.usuario_asignado~") COLUMN(NAME=~"at_lista_gestion.estado_gestion_lista~")    JOIN (LEFT=~"vista_gc_j.base~"    OP =~"=~"RIGHT=~"at_gestion.base~"    OUTER1 =~"vista_gc_j.base~" )    JOIN (LEFT=~"at_gestion.codigo_grupo~"    OP =~"=~"RIGHT=~"at_lista_gestion.codigo_grupo~"    OUTER1 =~"at_gestion.codigo_grupo~" )    JOIN (LEFT=~"vista_gc_j.serie~"    OP =~"=~"RIGHT=~"at_gestion.serie~"    OUTER1 =~"vista_gc_j.serie~" )    JOIN (LEFT=~"vista_gc_j.numero~"    OP =~"=~"RIGHT=~"at_gestion.numero~"    OUTER1 =~"vista_gc_j.numero~" )WHERE(    EXP1 =~"~~~"VISTA_GC_J~~~".~~~"PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~" ) ) ARG(NAME = ~"parque~" TYPE = number)  ARG(NAME = ~"fecha_hoy~" TYPE = date) " arguments=(("parque", number),("fecha_hoy", date))  sort="base A numero A " )
