 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"carta_log~" ) COLUMN(NAME=~"carta_log.base~") COLUMN(NAME=~"carta_log.serie~") COLUMN(NAME=~"carta_log.numero~") COLUMN(NAME=~"carta_log.rut~") COLUMN(NAME=~"carta_log.cod_envio~") COLUMN(NAME=~"carta_log.estado_env~") COLUMN(NAME=~"carta_log.fecha_carta~") COLUMN(NAME=~"carta_log.mora~") COLUMN(NAME=~"carta_log.cod_accion~") COLUMN(NAME=~"carta_log.correlativo~") COLUMN(NAME=~"carta_log.mora_mant~") COLUMN(NAME=~"carta_log.clasificacion~")WHERE(    EXP1 =~"~~~"CARTA_LOG~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CARTA_LOG~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CARTA_LOG~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CARTA_LOG~~~".~~~"FECHA_CARTA~~~"~"   OP =~"=~"    EXP2 =~":fecha~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CARTA_LOG~~~".~~~"COD_ENVIO~~~"~"   OP =~"=~"    EXP2 =~":cod_envio~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CARTA_LOG~~~".~~~"COD_ACCION~~~"~"   OP =~"=~"    EXP2 =~":cod_accion~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CARTA_LOG~~~".~~~"CORRELATIVO~~~"~"   OP =~"=~"    EXP2 =~":correlativo~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number)  ARG(NAME = ~"fecha~" TYPE = datetime)  ARG(NAME = ~"cod_envio~" TYPE = string)  ARG(NAME = ~"cod_accion~" TYPE = number)  ARG(NAME = ~"correlativo~" TYPE = number) " update="CARTA_LOG" updatewhere=0 updatekeyinplace=yes arguments=(("base", string),("serie", string),("numero", number),("fecha", datetime),("cod_envio", string),("cod_accion", number),("correlativo", number)) )
