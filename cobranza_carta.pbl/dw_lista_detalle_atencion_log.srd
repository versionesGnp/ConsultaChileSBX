 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"atencion_log~" )  TABLE(NAME=~"cliente~" ) COLUMN(NAME=~"atencion_log.rut~") COLUMN(NAME=~"atencion_log.estado~") COLUMN(NAME=~"atencion_log.fecha~") COLUMN(NAME=~"atencion_log.glosa~") COLUMN(NAME=~"atencion_log.usuario~") COLUMN(NAME=~"atencion_log.base~") COLUMN(NAME=~"atencion_log.serie~") COLUMN(NAME=~"atencion_log.numero~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"cliente.fono_p~") COLUMN(NAME=~"cliente.fono_c~") COLUMN(NAME=~"cliente.celular~")    JOIN (LEFT=~"atencion_log.rut~"    OP =~"=~"RIGHT=~"cliente.rut~" )WHERE(    EXP1 =~"~~~"ATENCION_LOG~~~".~~~"RUT~~~"~"   OP =~"=~"    EXP2 =~":rut~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"ATENCION_LOG~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~":estado~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"ATENCION_LOG~~~".~~~"FECHA~~~"~"   OP =~"=~"    EXP2 =~":fecha~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"ATENCION_LOG~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"ATENCION_LOG~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"ATENCION_LOG~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~" ) ) ARG(NAME = ~"rut~" TYPE = number)  ARG(NAME = ~"estado~" TYPE = string)  ARG(NAME = ~"fecha~" TYPE = datetime)  ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number) " arguments=(("rut", number),("estado", string),("fecha", datetime),("base", string),("serie", string),("numero", number)) )
