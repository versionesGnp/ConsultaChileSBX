 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"carta_log~" ) COLUMN(NAME=~"carta_log.cod_envio~") COLUMN(NAME=~"carta_log.estado_env~") COLUMN(NAME=~"carta_log.fecha_carta~") COLUMN(NAME=~"carta_log.mora~") COLUMN(NAME=~"carta_log.cod_accion~") COLUMN(NAME=~"carta_log.mora_mant~") COLUMN(NAME=~"carta_log.clasificacion~") COLUMN(NAME=~"carta_log.usuario~") COLUMN(NAME=~"carta_log.base~") COLUMN(NAME=~"carta_log.serie~") COLUMN(NAME=~"carta_log.numero~") COLUMN(NAME=~"carta_log.rut~") COLUMN(NAME=~"carta_log.correlativo~")WHERE(    EXP1 =~"(~~~"CARTA_LOG~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CARTA_LOG~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CARTA_LOG~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero)~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"(~~~"CARTA_LOG~~~".~~~"RUT~~~"~"   OP =~"=~"    EXP2 =~":rut)~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number)  ARG(NAME = ~"rut~" TYPE = number) " update="CARTA_LOG" updatewhere=0 updatekeyinplace=no arguments=(("base", string),("serie", string),("numero", number),("rut", number))  sort="fecha_carta D " )
