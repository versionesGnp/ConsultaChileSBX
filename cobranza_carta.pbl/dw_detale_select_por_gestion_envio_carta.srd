talle_gestion.fecha_prox_envio~") COLUMN(NAME=~"gc_detalle_gestion.fecha_plazo_cliente~") COLUMN(NAME=~"gc_detalle_gestion.poblacion_part~") COLUMN(NAME=~"gc_detalle_gestion.comuna_part~") COLUMN(NAME=~"gc_detalle_gestion.ciudad_part~") COLUMN(NAME=~"gc_detalle_gestion.mora_cred~") COLUMN(NAME=~"gc_detalle_gestion.dias_mora_cred~") COLUMN(NAME=~"gc_detalle_gestion.fecha_venc_cred~") COLUMN(NAME=~"gc_detalle_gestion.estado_titular~") COLUMN(NAME=~"gc_detalle_gestion.cod_grupo~") COLUMN(NAME=~"gc_lista_gestion.observacion~") COLUMN(NAME=~"at_gestion.usuario_asignado~")    JOIN (LEFT=~"gc_detalle_gestion.base~"    OP =~"=~"RIGHT=~"at_gestion.base~"    OUTER1 =~"gc_detalle_gestion.base~" )    JOIN (LEFT=~"gc_detalle_gestion.serie~"    OP =~"=~"RIGHT=~"at_gestion.serie~"    OUTER1 =~"gc_detalle_gestion.serie~" )    JOIN (LEFT=~"gc_detalle_gestion.numero~"    OP =~"=~"RIGHT=~"at_gestion.numero~"    OUTER1 =~"gc_detalle_gestion.numero~" )   JOIN (LEFT=~"cadena.cod_parque~"    OP =~"=~"RIGHT=~"cod_parq.codigo~" )    JOIN (LEFT=~"gc_detalle_gestion.rut_cliente~"    OP =~"=~"RIGHT=~"cliente.rut~" )    JOIN (LEFT=~"gc_detalle_gestion.base~"    OP =~"=~"RIGHT=~"cadena.codigo~" )    JOIN (LEFT=~"gc_detalle_gestion.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"gc_detalle_gestion.numero~"    OP =~"=~"RIGHT=~"cadena.numero~" )    JOIN (LEFT=~"gc_detalle_gestion.cod_grupo~"    OP =~"=~"RIGHT=~"gc_lista_gestion.codigo_grupo~" ) WHERE(    EXP1 =~"~~~"GC_DETALLE_GESTION~~~".~~~"COD_GRUPO~~~"~"   OP =~"=~"    EXP2 =~":codigo~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"GC_DETALLE_GESTION~~~".~~~"USUARIO_CREADOR~~~"~"   OP =~"=~"    EXP2 =~":usuario~" ) ) ARG(NAME = ~"codigo~" TYPE = number)  ARG(NAME = ~"usuario~" TYPE = string) " arguments=(("codigo", number),("usuario", string)) )
