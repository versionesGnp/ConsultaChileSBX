"cadena.nro_carta~") COLUMN(NAME=~"cadena.fecha_carta~") COLUMN(NAME=~"cadena.estado_carta~") COLUMN(NAME=~"gc_detalle_gestion.total_pagado~")    JOIN (LEFT=~"gc_detalle_gestion.base~"    OP =~"=~"RIGHT=~"ingreso.base~"    OUTER1 =~"gc_detalle_gestion.base~" )    JOIN (LEFT=~"gc_detalle_gestion.serie~"    OP =~"=~"RIGHT=~"ingreso.serie~"    OUTER1 =~"gc_detalle_gestion.serie~" )    JOIN (LEFT=~"gc_detalle_gestion.numero~"    OP =~"=~"RIGHT=~"ingreso.contrato~"    OUTER1 =~"gc_detalle_gestion.numero~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"cadena_mora.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"cadena_mora.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"cadena_mora.numero~" )    JOIN (LEFT=~"gc_detalle_gestion.base~"    OP =~"=~"RIGHT=~"cadena.codigo~" )    JOIN (LEFT=~"gc_detalle_gestion.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"gc_detalle_gestion.numero~"    OP =~"=~"RIGHT=~"cadena.numero~" )    JOIN (LEFT=~"gc_detalle_gestion.rut_cliente~"    OP =~"=~"RIGHT=~"cliente.rut~" )    JOIN (LEFT=~"cliente.comuna~"    OP =~"=~"RIGHT=~"comuna.codigo_comuna~" )    JOIN (LEFT=~"cliente.ciudad~"    OP =~"=~"RIGHT=~"ciudad.codigo_ciudad~" )    JOIN (LEFT=~"cliente.tipo_via~"    OP =~"=~"RIGHT=~"tipo_via.tipo_via~" )WHERE(    EXP1 =~"~~~"GC_DETALLE_GESTION~~~".~~~"FECHA_CREACION~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"GC_DETALLE_GESTION~~~".~~~"FECHA_CREACION~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"TIPO_MOV~~~"~"   OP =~"=~"    EXP2 =~":tipo_mov~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"INGRESO~~~".~~~"TIPO_COB~~~"~"   OP =~"=~"    EXP2 =~"'CI'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"TIPO_COB~~~"~"   OP =~"=~"    EXP2 =~"'C0')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"FECHA_PAGO~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"FECHA_PAGO~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = datetime)  ARG(NAME = ~"fecha_fin~" TYPE = datetime)  ARG(NAME = ~"tipo_mov~" TYPE = string) " arguments=(("fecha_ini", datetime),("fecha_fin", datetime),("tipo_mov", string))  sort="ingreso_fecha_pago A ingreso_tipo_cob A ingreso_folio A ingreso_tipo_mov A " )
