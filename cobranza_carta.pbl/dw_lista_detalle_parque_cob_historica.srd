 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cliente~" )  TABLE(NAME=~"atencion_parque~" ) COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"cliente.fono_p~") COLUMN(NAME=~"cliente.fono_c~") COLUMN(NAME=~"cliente.celular~") COLUMN(NAME=~"atencion_parque.base~") COLUMN(NAME=~"atencion_parque.serie~") COLUMN(NAME=~"atencion_parque.numero~") COLUMN(NAME=~"atencion_parque.rut~") COLUMN(NAME=~"atencion_parque.fecha_crea~") COLUMN(NAME=~"atencion_parque.observacion~") COLUMN(NAME=~"atencion_parque.estado~") COLUMN(NAME=~"atencion_parque.fecha_estado~") COLUMN(NAME=~"atencion_parque.usuario~") COLUMN(NAME=~"atencion_parque.area~") COLUMN(NAME=~"atencion_parque.sector~") COLUMN(NAME=~"atencion_parque.sepultura~")    JOIN (LEFT=~"cliente.rut~"    OP =~"=~"RIGHT=~"atencion_parque.rut~" )WHERE(    EXP1 =~"~~~"ATENCION_PARQUE~~~".~~~"RUT~~~"~"   OP =~"=~"    EXP2 =~":rut~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"ATENCION_PARQUE~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~":estado~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"ATENCION_PARQUE~~~".~~~"FECHA_CREA~~~"~"   OP =~"=~"    EXP2 =~":fecha~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"ATENCION_PARQUE~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"ATENCION_PARQUE~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"ATENCION_PARQUE~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~" ) ) ARG(NAME = ~"rut~" TYPE = number)  ARG(NAME = ~"estado~" TYPE = string)  ARG(NAME = ~"fecha~" TYPE = datetime)  ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number) " arguments=(("rut", number),("estado", string),("fecha", datetime),("base", string),("serie", string),("numero", number)) )
