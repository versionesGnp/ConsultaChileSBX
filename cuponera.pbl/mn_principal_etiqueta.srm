end on

type m_salir from menu within m_proceso
end type

on m_salir.create
call super::create
this.text = "&Salir"
this.microhelp = "Salir del Sistema"
this.toolbaritemname = "Exit!"
this.toolbaritemtext = "Salir del Sistema"
this.toolbaritemorder = 99
this.toolbaritemspace = 10
end on

event clicked;
Close(w_principal_etiqueta)
end event

on m_salir.destroy
