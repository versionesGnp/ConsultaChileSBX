end on

type m_- from menu within m_proceso
end type

on m_-.create
call super::create
this.text = "-"
end on

on m_-.destroy
call super::destroy
end on

type m_c0nfigurarimpresora from menu within m_proceso
end type

event clicked;PrintSetup( )
end event

on m_c0nfigurarimpresora.create
call super::create
this.text = "C&onfigurar Impresora"
end on

on m_c0nfigurarimpresora.destroy
