 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"cadena~" )  TABLE(NAME=~"carta_log~" )  TABLE(NAME=~"cliente~" )  TABLE(NAME=~"factura_oferta~" )  TABLE(NAME=~"anexo_liberador~" )  TABLE(NAME=~"pago_liberador~" )  TABLE(NAME=~"cadena_mora~" ) COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"cadena.serie~") COLUMN(NAME=~"cadena.numero~") COMPUTE(NAME=~"0~") COLUMN(NAME=~"factura_oferta.plazo~") COLUMN(NAME=~"factura_oferta.ctas_pag~") COLUMN(NAME=~"pago_liberador.fecha_prim~") COLUMN(NAME=~"pago_liberador.nro_cuotas~") COLUMN(NAME=~"anexo_liberador.cta_pag_m~") COLUMN(NAME=~"anexo_liberador.u_fecha~") COLUMN(NAME=~"cadena_mora.mora_cred~")    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"carta_log.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"carta_log.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"carta_log.numero~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"factura_oferta.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"factura_oferta.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"factura_oferta.numero~" )    JOIN (LEFT=~"cadena.rut~"    OP =~"=~"RIGHT=~"cliente.rut~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"anexo_liberador.serie_m~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"anexo_liberador.nro_liberador~" )    JOIN (LEFT=~"anexo_liberador.serie_m~"    OP =~"=~"RIGHT=~"pago_liberador.serie_m~" )    JOIN (LEFT=~"anexo_liberador.nro_liberador~"    OP =~"=~"RIGHT=~"pago_liberador.nro_liberador~" )    JOIN (LEFT=~"anexo_liberador.ult_folio~"    OP =~"=~"RIGHT=~"pago_liberador.folio~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"cadena_mora.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"cadena_mora.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"cadena_mora.numero~" )WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'V'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FACTURA_OFERTA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'S'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FACTURA_OFERTA~~~".~~~"FECHA_CIERRE~~~"~"   OP =~"=~" NEST = PBSELECT( VERSION(400) TABLE(NAME=~"factura_oferta~" ) COMPUTE(NAME=~"max(~~~"FACTURA_OFERTA~~~".~~~"FECHA_CIERRE~~~")~"))   LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CARTA_LOG~~~".~~~"COD_ACCION~~~"~"   OP =~"<>~"    EXP2 =~"'6'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CLIENTE~~~".~~~"DIRECCION_P~~~"~"   OP =~"<>~"    EXP2 =~"'-'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'L'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FACTURA_OFERTA~~~".~~~"CTAS_PAG~~~"~"   OP =~"<~"    EXP2 =~"~~~"FACTURA_OFERTA~~~".~~~"PLAZO~~~"~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"EST_CUP~~~"~"   OP =~"=~"    EXP2 =~"0~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"ANEXO_LIBERADOR~~~".~~~"FORMA_PAGO~~~"~"   OP =~"=~"    EXP2 =~"'2'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"ANEXO_LIBERADOR~~~".~~~"FORMA_PAGO~~~"~"   OP =~"=~"    EXP2 =~"'4')~" ) ) "  sort="saldo_cuotas A " )
