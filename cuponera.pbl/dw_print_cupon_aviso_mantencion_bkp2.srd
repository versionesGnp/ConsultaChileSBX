 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"cadena~" )  TABLE(NAME=~"cadena_mora~" )  TABLE(NAME=~"cliente~" )  TABLE(NAME=~"ciudad~" )  TABLE(NAME=~"comuna~" )  TABLE(NAME=~"tipo_via~" )  TABLE(NAME=~"cuponeras~" )  TABLE(NAME=~"cuponeras_detalle~" ) COLUMN(NAME=~"cadena.cod_parque~") COLUMN(NAME=~"cadena_mora.valor_cuota_mant~") COLUMN(NAME=~"cadena_mora.fecha_venc_mant~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cliente.direccion_p~") COLUMN(NAME=~"cliente.poblacion~") COLUMN(NAME=~"cliente.sector~") COLUMN(NAME=~"cliente.numero_particular~") COLUMN(NAME=~"cliente.depto_particular~") COLUMN(NAME=~"cliente.block_particular~") COLUMN(NAME=~"comuna.comuna~") COLUMN(NAME=~"ciudad.ciudad~") COLUMN(NAME=~"tipo_via.descripcion~") COLUMN(NAME=~"cuponeras_detalle.base~") COLUMN(NAME=~"cuponeras_detalle.serie~") COLUMN(NAME=~"cuponeras_detalle.numero~") COLUMN(NAME=~"cuponeras_detalle.nro_cupon~") COLUMN(NAME=~"cuponeras_detalle.rut~") COLUMN(NAME=~"cuponeras_detalle.nro_cuota~") COLUMN(NAME=~"cuponeras_detalle.fecha_venc~") COLUMN(NAME=~"cuponeras_detalle.estado_pago_cupon~") COLUMN(NAME=~"cuponeras_detalle.tipo_mov~") COLUMN(NAME=~"cuponeras_detalle.tipo_cob_pago~") COLUMN(NAME=~"cuponeras_detalle.folio_pago~") COLUMN(NAME=~"cuponeras_detalle.fecha_pago~") COLUMN(NAME=~"cuponeras_detalle.monto_cuota_contrato~") COLUMN(NAME=~"cuponeras_detalle.monto_cuota_peso~") COLUMN(NAME=~"cuponeras_detalle.monto_interes_mora~") COLUMN(NAME=~"cuponeras_detalle.monto_gasto_cobranza~") COLUMN(NAME=~"cuponeras_detalle.nro_cuponera~") COLUMN(NAME=~"cuponeras_detalle.dv~") COLUMN(NAME=~"cuponeras_detalle.ip_print~") COLUMN(NAME=~"cuponeras_detalle.usuario_print~") COLUMN(NAME=~"cuponeras_detalle.numero_grupo_aviso~") COLUMN(NAME=~"cuponeras.moneda_ctto~") COLUMN(NAME=~"cuponeras_detalle.base_asoc~") COLUMN(NAME=~"cuponeras_detalle.serie_asoc~") COLUMN(NAME=~"cuponeras_detalle.numero_asoc~")    JOIN (LEFT=~"comuna.codigo_comuna~"    OP =~"=~"RIGHT=~"cliente.comuna~" )    JOIN (LEFT=~"ciudad.codigo_ciudad~"    OP =~"=~"RIGHT=~"cliente.ciudad~" )    JOIN (LEFT=~"cliente.tipo_via~"    OP =~"=~"RIGHT=~"tipo_via.tipo_via~" )    JOIN (LEFT=~"cliente.rut~"    OP =~"=~"RIGHT=~"cuponeras_detalle.rut~" )    JOIN (LEFT=~"cuponeras_detalle.base~"    OP =~"=~"RIGHT=~"cuponeras.base~" )    JOIN (LEFT=~"cuponeras_detalle.serie~"    OP =~"=~"RIGHT=~"cuponeras.serie~" )    JOIN (LEFT=~"cuponeras_detalle.numero~"    OP =~"=~"RIGHT=~"cuponeras.numero~" )    JOIN (LEFT=~"cuponeras.nro_cuponera~"    OP =~"=~"RIGHT=~"cuponeras_detalle.nro_cuponera~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"cuponeras.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"cuponeras.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"cuponeras.numero~" )    JOIN (LEFT=~"cadena_mora.base~"    OP =~"=~"RIGHT=~"cuponeras.base~" )    JOIN (LEFT=~"cadena_mora.serie~"    OP =~"=~"RIGHT=~"cuponeras.serie~" )    JOIN (LEFT=~"cadena_mora.numero~"    OP =~"=~"RIGHT=~"cuponeras.numero~" )WHERE(    EXP1 =~"~~~"CUPONERAS_DETALLE~~~".~~~"FECHA_VENC~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CUPONERAS_DETALLE~~~".~~~"FECHA_VENC~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CUPONERAS_DETALLE~~~".~~~"ESTADO_PAGO_CUPON~~~"~"   OP =~"=~"    EXP2 =~"'V'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CUPONERAS_DETALLE~~~".~~~"TIPO_MOV~~~"~"   OP =~"=~"    EXP2 =~"'F'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"CADENA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'V'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'C')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA_MORA~~~".~~~"MORA_MANT~~~"~"   OP =~"=~"    EXP2 =~"0~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA_MORA~~~".~~~"MORA_CRED~~~"~"   OP =~"<=~"    EXP2 =~"3~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = datetime)  ARG(NAME = ~"fecha_fin~" TYPE = datetime)  ARG(NAME = ~"parque~" TYPE = number) " arguments=(("fecha_ini", datetime),("fecha_fin", datetime),("parque", number))  sort="cuponeras_detalle_numero A " )
