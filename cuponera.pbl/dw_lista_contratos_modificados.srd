 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cuponeras_modifica~" )  TABLE(NAME=~"cadena~" ) COLUMN(NAME=~"cuponeras_modifica.base~") COLUMN(NAME=~"cuponeras_modifica.serie~") COLUMN(NAME=~"cuponeras_modifica.numero~") COLUMN(NAME=~"cuponeras_modifica.fecha_crea~") COLUMN(NAME=~"cuponeras_modifica.usuario~") COLUMN(NAME=~"cuponeras_modifica.depto_solicita~") COMPUTE(NAME=~"0~") COLUMN(NAME=~"cuponeras_modifica.plazo~") COLUMN(NAME=~"cuponeras_modifica.rut~") COLUMN(NAME=~"cuponeras_modifica.dv~") COLUMN(NAME=~"cuponeras_modifica.valor_cuota_cred~") COLUMN(NAME=~"cuponeras_modifica.valor_cuota_mant~") COLUMN(NAME=~"cuponeras_modifica.cod_parque~") COLUMN(NAME=~"cuponeras_modifica.fecha_prim~") COLUMN(NAME=~"cuponeras_modifica.fec_venc_mant~") COLUMN(NAME=~"cuponeras_modifica.moneda~") COLUMN(NAME=~"cuponeras_modifica.estado_reg~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"cuponeras_modifica.tipo_modificacion~")    JOIN (LEFT=~"cuponeras_modifica.base~"    OP =~"=~"RIGHT=~"cadena.codigo~" )    JOIN (LEFT=~"cuponeras_modifica.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"cuponeras_modifica.numero~"    OP =~"=~"RIGHT=~"cadena.numero~" )WHERE(    EXP1 =~"~~~"CUPONERAS_MODIFICA~~~".~~~"FECHA_CREA~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CUPONERAS_MODIFICA~~~".~~~"FECHA_CREA~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CUPONERAS_MODIFICA~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CUPONERAS_MODIFICA~~~".~~~"ESTADO_REG~~~"~"   OP =~"=~"    EXP2 =~"'V'~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = datetime)  ARG(NAME = ~"fecha_fin~" TYPE = datetime)  ARG(NAME = ~"parque~" TYPE = number) " update="CUPONERAS_MODIFICA" updatewhere=0 updatekeyinplace=yes arguments=(("fecha_ini", datetime),("fecha_fin", datetime),("parque", number))  sort="numero A " )
