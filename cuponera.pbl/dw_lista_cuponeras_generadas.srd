 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cuponeras~" )  TABLE(NAME=~"cadena_mora~" )  TABLE(NAME=~"cadena~" ) COLUMN(NAME=~"cuponeras.base~") COLUMN(NAME=~"cuponeras.serie~") COLUMN(NAME=~"cuponeras.numero~") COLUMN(NAME=~"cuponeras.nro_cuponera~") COLUMN(NAME=~"cuponeras.fecha_crea~") COLUMN(NAME=~"cuponeras.usuario_creador~") COLUMN(NAME=~"cuponeras.cupon_inicial~") COLUMN(NAME=~"cuponeras.cupon_final~") COLUMN(NAME=~"cuponeras.estado_cuponera~") COLUMN(NAME=~"cuponeras.cod_parque~") COMPUTE(NAME=~"0~") COLUMN(NAME=~"cuponeras.moneda_ctto~") COLUMN(NAME=~"cuponeras.plazo~") COLUMN(NAME=~"cadena_mora.ctas_pag_s~") COLUMN(NAME=~"cadena_mora.valor_cuota~") COLUMN(NAME=~"cadena_mora.valor_cuota_mant~") COLUMN(NAME=~"cadena_mora.mora_cred~") COLUMN(NAME=~"cadena_mora.mora_mant~") COLUMN(NAME=~"cadena_mora.dias_mora_cred~") COLUMN(NAME=~"cadena_mora.dias_mora_mant~") COLUMN(NAME=~"cadena_mora.fecha_venc_cred~") COLUMN(NAME=~"cadena_mora.fecha_venc_mant~") COLUMN(NAME=~"cadena_mora.fallecidos~") COLUMN(NAME=~"cuponeras.ult_fecha_venc_cred_print~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"cadena.rut~")    JOIN (LEFT=~"cuponeras.base~"    OP =~"=~"RIGHT=~"cadena_mora.base~"    OUTER1 =~"cuponeras.base~" )    JOIN (LEFT=~"cuponeras.serie~"    OP =~"=~"RIGHT=~"cadena_mora.serie~"    OUTER1 =~"cuponeras.serie~" )    JOIN (LEFT=~"cuponeras.numero~"    OP =~"=~"RIGHT=~"cadena_mora.numero~"    OUTER1 =~"cuponeras.numero~" )    JOIN (LEFT=~"cuponeras.base~"    OP =~"=~"RIGHT=~"cadena.codigo~"    OUTER1 =~"cuponeras.base~" )    JOIN (LEFT=~"cuponeras.serie~"    OP =~"=~"RIGHT=~"cadena.serie~"    OUTER1 =~"cuponeras.serie~" )    JOIN (LEFT=~"cuponeras.numero~"    OP =~"=~"RIGHT=~"cadena.numero~"    OUTER1 =~"cuponeras.numero~" )WHERE(    EXP1 =~"(~~~"CADENA_MORA~~~".~~~"FECHA_VENC_CRED~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CADENA_MORA~~~".~~~"FECHA_VENC_CRED~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CUPONERAS~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CUPONERAS~~~".~~~"ESTADO_CUPONERA~~~"~"   OP =~"=~"    EXP2 =~"'V'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"(~~~"CADENA_MORA~~~".~~~"PLAZO~~~" - ~~~"CADENA_MORA~~~".~~~"CTAS_PAG_S~~~")~"   OP =~">~"    EXP2 =~"0)~" ) )    UNION (PBSELECT( VERSION(400) TABLE(NAME=~"cadena~" )  TABLE(NAME=~"cadena_mora~" )  TABLE(NAME=~"cuponeras~" ) COLUMN(NAME=~"cuponeras.base~") COLUMN(NAME=~"cuponeras.serie~") COLUMN(NAME=~"cuponeras.numero~") COLUMN(NAME=~"cuponeras.nro_cuponera~") COLUMN(NAME=~"cuponeras.fecha_crea~") COLUMN(NAME=~"cuponeras.usuario_creador~") COLUMN(NAME=~"cuponeras.cupon_inicial~") COLUMN(NAME=~"cuponeras.cupon_final~") COLUMN(NAME=~"cuponeras.estado_cuponera~") COLUMN(NAME=~"cuponeras.cod_parque~") COMPUTE(NAME=~"0~") COLUMN(NAME=~"cuponeras.moneda_ctto~") COLUMN(NAME=~"cuponeras.plazo~") COLUMN(NAME=~"cadena_mora.ctas_pag_s~") COLUMN(NAME=~"cadena_mora.valor_cuota~") COLUMN(NAME=~"cadena_mora.valor_cuota_mant~") COLUMN(NAME=~"cadena_mora.mora_cred~") COLUMN(NAME=~"cadena_mora.mora_mant~") COLUMN(NAME=~"cadena_mora.dias_mora_cred~") COLUMN(NAME=~"cadena_mora.dias_mora_mant~") COLUMN(NAME=~"cadena_mora.fecha_venc_cred~") COLUMN(NAME=~"cadena_mora.fecha_venc_mant~") COLUMN(NAME=~"cadena_mora.fallecidos~") COLUMN(NAME=~"cuponeras.ult_fecha_venc_cred_print~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"cadena.rut~")    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"cuponeras.base~"    OUTER2 =~"cuponeras.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"cuponeras.serie~"    OUTER2 =~"cuponeras.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"cuponeras.numero~"    OUTER2 =~"cuponeras.numero~" )    JOIN (LEFT=~"cuponeras.base~"    OP =~"=~"RIGHT=~"cadena_mora.base~"    OUTER1 =~"cuponeras.base~" )    JOIN (LEFT=~"cuponeras.serie~"    OP =~"=~"RIGHT=~"cadena_mora.serie~"    OUTER1 =~"cuponeras.serie~" )    JOIN (LEFT=~"cuponeras.numero~"    OP =~"=~"RIGHT=~"cadena_mora.numero~"    OUTER1 =~"cuponeras.numero~" )WHERE(    EXP1 =~"(~~~"CADENA_MORA~~~".~~~"FECHA_VENC_MANT~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CADENA_MORA~~~".~~~"FECHA_VENC_MANT~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CUPONERAS~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"(~~~"CUPONERAS~~~".~~~"ESTADO_CUPONERA~~~"~"   OP =~"=~"    EXP2 =~"'V'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"CUPONERAS~~~".~~~"ESTADO_CUPONERA~~~"~"   OP =~"=~"    EXP2 =~"'C'))~" ) )) ARG(NAME = ~"fecha_ini~" TYPE = datetime)  ARG(NAME = ~"fecha_fin~" TYPE = datetime)  ARG(NAME = ~"parque~" TYPE = number) " update="CUPONERAS" updatewhere=0 updatekeyinplace=yes arguments=(("fecha_ini", datetime),("fecha_fin", datetime),("parque", number))  sort="numero A " )
