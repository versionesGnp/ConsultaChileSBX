type cb_activar from commandbutton within tabpage_1
event ue_mousemove pbm_mousemove
integer x = 1655
integer y = 1392
integer width = 315
integer height = 100
integer taborder = 30
integer textsize = -9
integer weight = 400
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string text = "Acti&var"
end type

event ue_mousemove;st_8.visible	= false
st_9.visible	= true
end event

event clicked;String	ls_base,ls_serie,ls_estado,ls_descrip,ls_estado_det
Long		ll_numero,ll_indi,ll_tot_reg,ll_fila,ll_pasa_det,ll_error,ll_resp,ll_count_reg

if il_row>0 then
	ll_pasa_det	= 0
	ll_error		= 0
	ll_numero 	= tab_1.tabpage_1.dw_lista.getitemnumber(il_row,'numero')
	ls_base		= tab_1.tabpage_1.dw_lista.getitemstring(il_row,'base')
	ls_serie		= tab_1.tabpage_1.dw_lista.getitemstring(il_row,'serie')
	ls_estado	= tab_1.tabpage_1.dw_lista.getitemstring(il_row,'estado_cuponera')
	SELECT	Count("CUPONERAS"."NUMERO")  
	INTO 		:ll_count_reg  
	FROM 		"CUPONERAS"  
	WHERE  ( "CUPONERAS"."BASE" = :ls_base ) AND  
			 ( "CUPONERAS"."SERIE" = :ls_serie ) AND  
			 ( "CUPONERAS"."NUMERO" = :ll_numero ) AND
			 ( "CUPONERAS"."ESTADO_CUPONERA" = 'V')
	USING		sqlca;
	if ll_count_reg > 0 then
		messagebox("Advertencia","No es Posible Activar Cuponera por Existir "+string(ll_count_reg)+' Cuponera VIGENTE')
		tab_1.tabpage_1.dw_lista.setitem(il_row,'estado',1)
	else
		if ls_estado='A' then
			ll_resp			= messagebox("Advertencia","Está Seguro de ACTIVAR Cuponera del Contrato Nº "+ls_base+'-'+ls_serie+'-'+string(ll_numero,"###,###,###,###,###"),Exclamation!,YesNo!,2)
			if ll_resp=1 then
				tab_1.tabpage_1.dw_lista.setitem(il_row,'estado_cuponera','V')
				tab_1.tabpage_1.dw_lista.accepttext()
				ll_tot_reg	= tab_1.tabpage_2.dw_detalle.rowcount()
				if ll_tot_reg>0 then
					ll_fila	= tab_1.tabpage_2.dw_detalle.Find("cuponeras_detalle_estado_pago_cupon = 'A'", 1, ll_tot_reg)
					if ll_fila > 0 then
						for ll_indi = ll_fila to ll_tot_reg
							ls_estado_det	= tab_1.tabpage_2.dw_detalle.getitemstring(ll_indi,'cuponeras_detalle_estado_pago_cupon')
							if ls_estado_det='A' then
								tab_1.tabpage_2.dw_detalle.setitem(ll_indi,'cuponeras_detalle_estado_pago_cupon','V')
								ll_pasa_det ++
							end if
						next
					else
						ll_pasa_det	= 0
						messagebox("Advertencia","Debe Seleccionar por lo menos UN Contrato")
					end if
				end if
				if ll_pasa_det>0 then
					if tab_1.tabpage_1.dw_lista.update()=1 then
						commit;
					else
						rollback;
						messagebox("Advertencia","Error en Activación SQL: "+sqlca.sqlerrtext)
						ll_error ++
					end if
					if ll_pasa_det > 0 then
						if tab_1.tabpage_2.dw_detalle.update()=1 then
							commit;
						else
							rollback;
							messagebox("Advertencia","Error en Activación Detalle SQL: "+sqlca.sqlerrtext)
							ll_error ++
						end if
					end if
					if ll_error=0 or isnull(ll_error) then
						messagebox("Activar","Activación Exitosa")
					end if
				end if
			end if
		else
			SELECT	"CUPONERAS_ESTADO"."DESCRIPCION"  
			INTO 		:ls_descrip  
			FROM 		"CUPONERAS_ESTADO"  
			WHERE 	"CUPONERAS_ESTADO"."ESTADO_CUPONERA" = :ls_estado   ;
			messagebox("Advertencia","No es posible Activar Cuponera por estar en Estado: "+ls_estado+'-'+ls_descrip)
		end if
	end if
end if
end event

type cb_anular from commandbutton within tabpage_1
event ue_mousemove pbm_mousemove
integer x = 1330
integer y = 1392
integer width = 315
integer height = 100
integer taborder = 30
integer textsize = -9
integer weight = 400
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string text = "&Anular"
end type

event ue_mousemove;st_8.visible	= true
st_9.visible	= false
end event

event clicked;String	ls_base,ls_serie,ls_estado,ls_descrip,ls_estado_det
Long		ll_numero,ll_indi,ll_tot_reg,ll_fila,ll_pasa_det,ll_error,ll_resp

if il_row > 0 then
	ll_pasa_det	= 0
	ll_error		= 0
	ll_numero 	= tab_1.tabpage_1.dw_lista.getitemnumber(il_row,'numero')
	ls_base		= tab_1.tabpage_1.dw_lista.getitemstring(il_row,'base')
	ls_serie		= tab_1.tabpage_1.dw_lista.getitemstring(il_row,'serie')
	ls_estado	= tab_1.tabpage_1.dw_lista.getitemstring(il_row,'estado_cuponera')
	if ls_estado='V' then
		ll_resp			= messagebox("Advertencia","Está Seguro de ANULAR Cuponera del Contrato Nº "+ls_base+'-'+ls_serie+'-'+string(ll_numero,"###,###,###,###,###"),Exclamation!,YesNo!,2)
		if ll_resp = 1 then
			tab_1.tabpage_1.dw_lista.setitem(il_row,'estado_cuponera','A')
			tab_1.tabpage_1.dw_lista.accepttext()
			ll_tot_reg	= tab_1.tabpage_2.dw_detalle.rowcount()
			if ll_tot_reg>0 then
				ll_fila	= tab_1.tabpage_2.dw_detalle.Find("cuponeras_detalle_estado_pago_cupon = 'V'", 1, ll_tot_reg)
				if ll_fila > 0 then
					for ll_indi = ll_fila to ll_tot_reg
						ls_estado_det	= tab_1.tabpage_2.dw_detalle.getitemstring(ll_indi,'cuponeras_detalle_estado_pago_cupon')
						if ls_estado_det='V' then
							tab_1.tabpage_2.dw_detalle.setitem(ll_indi,'cuponeras_detalle_estado_pago_cupon','A')
							ll_pasa_det ++
						end if
					next
				else
					messagebox("Advertencia","Debe Seleccionar por lo menos UN Contrato")
					ll_pasa_det	= 0
				end if
			end if
			if ll_pasa_det > 0 then
				if tab_1.tabpage_1.dw_lista.update()=1 then
					commit;
				else
					rollback;
					messagebox("Advertencia","Error en Anulación SQL: "+sqlca.sqlerrtext)
					ll_error ++
				end if
				if ll_pasa_det > 0 then
					if tab_1.tabpage_2.dw_detalle.update()=1 then
						commit;
					else
						rollback;
						messagebox("Advertencia","Error en Anulación Detalle SQL: "+sqlca.sqlerrtext)
						ll_error ++
					end if
				end if
				if ll_error=0 or isnull(ll_error) then
					messagebox("Anular","Anulación Exitosa")
				end if
			end if
		end if
	else
		SELECT	"CUPONERAS_ESTADO"."DESCRIPCION"  
		INTO 		:ls_descrip  
		FROM 		"CUPONERAS_ESTADO"  
		WHERE 	"CUPONERAS_ESTADO"."ESTADO_CUPONERA" = :ls_estado   ;
		messagebox("Advertencia","No es posible Anular Cuponera por estar en Estado: "+ls_estado+'-'+ls_descrip)
	end if
end if
end event

