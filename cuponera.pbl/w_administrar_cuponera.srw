type cb_mostrar_generadas from commandbutton within tabpage_1
integer x = 951
integer y = 1392
integer width = 315
integer height = 100
integer taborder = 140
integer textsize = -9
integer weight = 400
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string text = "&Mostrar"
end type

event clicked;Datetime		ld_fec_ini,ld_fec_fin,ld_nulo,ldt_fecha_ini_mes,ldt_fecha_fin_mes
time			lt_ini=time('00:00:00'), lt_fin=time('23:59:59')
Long			ll_cod_parque,ll_tot_reg,ll_indi,ll_nulo,ll_mes,ll_year,ll_mes_sgte,ll_numero,ll_corr,&
				ll_tot_porc_aux,ll_tot_porc=0,ll_ctas_pag
String		ls_base,ls_serie,ls_fec_inicial,ls_fec_final

dw_parque.accepttext()
gl_cod_parque_cta		= dw_parque.getitemnumber(1,'cod_parque')
Setnull(ld_nulo);Setnull(ll_nulo)
SetPointer(HourGlass!)
tab_1.tabpage_1.dw_lista.reset()
tab_1.tabpage_2.dw_detalle.reset()
tab_1.tabpage_2.dw_agrupado.reset()
tab_1.tabpage_3.dw_genera.reset()
tab_1.tabpage_4.dw_print_masivo.reset()
tab_1.tabpage_5.dw_carta.reset()
tab_1.tabpage_6.dw_lista_modif.reset()
tab_1.tabpage_3.dw_genera.object.t_marcar.text	= 'Marcar Todo'
st_porc.text												= ''
em_buscar_ctto.text										= ''
ld_fec_ini													= datetime(date(em_fec_ini.text),lt_ini)
ld_fec_fin													= datetime(date(em_fec_fin.text),lt_fin)

if trim(em_fec_ini.text)='00/00/0000' or isnull(em_fec_ini.text) then
	messagebox("Advertencia","Fecha Inicial Inválida")
	em_fec_ini.setfocus()
else
	if trim(em_fec_fin.text)='00/00/0000' or isnull(em_fec_fin.text) then
		messagebox("Advertencia","Fecha Término Inválida")
		em_fec_fin.setfocus()
	else
		if ld_fec_ini>ld_fec_fin then
			messagebox("Advertencia","Rango de Fecha Incorrecta")
			em_fec_ini.setfocus()
		else
			ll_cod_parque	= dw_parque.getitemnumber(1,'cod_parque')
			if ll_cod_parque>0 then
				ll_tot_reg	= tab_1.tabpage_1.dw_lista.retrieve(ld_fec_ini,ld_fec_fin,ll_cod_parque)
				if ll_tot_reg>0 then
					st_fondo.visible					= true
					hpb_1.visible 						= true
					st_porc.visible 					= true
					st_nro_registros.visible		= true
					st_registro.visible				= true
					st_contar.visible					= true
					st_porc.text						= '0 %'
					hpb_1.Position						= ll_tot_porc
					st_nro_registros.text			= " de "+string(ll_tot_reg)
					for ll_indi=1 to ll_tot_reg
						tab_1.tabpage_1.dw_lista.setitem(ll_indi,'estado',1)
						if ll_tot_porc <> ll_tot_porc_aux then 
							st_porc.text				= string(ll_tot_porc)+" %"
							ll_tot_porc_aux			= ll_tot_porc
						end if
						ll_tot_porc						= (ll_indi * 100) / ll_tot_reg
						hpb_1.Position 				= ll_tot_porc
						st_contar.text					= string(ll_indi)
					next
					st_fondo.visible					= false
					hpb_1.visible 						= false
					st_porc.visible 					= false
					st_nro_registros.visible		= false
					st_registro.visible				= false
					st_contar.visible					= false
					tab_1.tabpage_1.dw_lista.accepttext()
					tab_1.tabpage_1.dw_lista.scrolltorow(1)
					ls_base												= tab_1.tabpage_1.dw_lista.getitemstring(1,'base')
					ls_serie												= tab_1.tabpage_1.dw_lista.getitemstring(1,'serie')
					ll_numero											= tab_1.tabpage_1.dw_lista.getitemnumber(1,'numero')
					ll_corr												= tab_1.tabpage_1.dw_lista.getitemnumber(1,'nro_cuponera')
					if tab_1.tabpage_2.dw_detalle.retrieve(ls_base,ls_serie,ll_numero,ll_corr)=0 then
						tab_1.tabpage_2.st_no_existe.visible	= true
						tab_1.tabpage_2.dw_detalle.visible		= false
						tab_1.tabpage_2.dw_agrupado.visible		= false
					else
						tab_1.tabpage_2.dw_agrupado.retrieve(ls_base,ls_serie,ll_numero,ll_corr)
						tab_1.tabpage_2.st_no_existe.visible	= false
						tab_1.tabpage_2.dw_detalle.visible		= true
						tab_1.tabpage_2.dw_agrupado.visible		= true
					end if
					
				end if
			else
				messagebox("Advertencia","Debe Seleccionar Parque")
				dw_parque.setfocus()
			end if
		end if
	end if
end if
SetPointer(Arrow!)
end event

type cb_2 from commandbutton within tabpage_1
integer x = 2560
integer y = 1392
integer width = 375
integer height = 100
integer taborder = 130
integer textsize = -8
integer weight = 400
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string text = "Importar Base"
end type

event clicked;integer 	value
String	docname,named,ls_base,ls_serie,ls_nombres,ls_ap_pat,ls_ap_mat,ls_direc_p,&
			ls_pob,ls_sexo,ls_nro_p,ls_depto_p,ls_block_p,ls_tipo_via,ls_comuna,ls_ciudad,&
			ls_nom_comp,ls_dir_comp,ls_trato,ls_string,ls_string1,ls_string2,ls_string3
Long		ll_tot_reg,ll_indi,ll_numero,ll_rut,ll_new_no,ll_new,ll_fila,ll_tot_reg_cupones
dw_base.reset()
value 	= GetFileOpenName("Seleccione Archivo", docname, named, "DOC", + "Archivos de Texto (*.TXT),*.TXT")//," + "Archivos Doc (*.DOC),*.DOC")
SetPointer(HourGlass!)
If value = 1 Then
	dw_base.ImportFile(docname)
End If
ll_tot_reg	= dw_base.rowcount()
ll_tot_reg_cupones	= tab_1.tabpage_1.dw_lista.rowcount()
if ll_tot_reg>0 then
	for ll_indi=1 to ll_tot_reg
		ls_base		= dw_base.getitemstring(ll_indi,'base')
		ls_serie		= dw_base.getitemstring(ll_indi,'serie')
		ll_numero	= dw_base.getitemnumber(ll_indi,'numero')
		ls_string	= 'base ='+"'"+ls_base+"'"+' and serie='+"'"+ls_serie+"'"+ ' and numero='+string(ll_numero)
		ll_fila 		= tab_1.tabpage_1.dw_lista.Find(ls_string, 1, ll_tot_reg_cupones)
		if ll_fila > 0 then
			tab_1.tabpage_1.dw_lista.setitem(ll_fila,'estado',0)
			tab_1.tabpage_1.dw_lista.scrolltorow(ll_fila)
		end if
	next
	dw_lista.SETSORT('estado A, numero A')
	dw_lista.SORT()
end if
SetPointer(Arrow!)
end event

