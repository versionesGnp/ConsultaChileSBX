type cb_mostrar_imprimir from commandbutton within tabpage_4
integer x = 965
integer y = 1392
integer width = 315
integer height = 100
integer taborder = 100
integer textsize = -9
integer weight = 400
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string text = "&Mostrar"
end type

event clicked;Datetime		ld_fec_ini,ld_fec_fin,ld_nulo,ldt_fecha_ini_mes,ldt_fecha_fin_mes
time			lt_ini=time('00:00:00'), lt_fin=time('23:59:59')
Long			ll_cod_parque,ll_tot_reg,ll_indi,ll_nulo,ll_mes,ll_year,ll_mes_sgte,&
				ll_tot_porc_aux,ll_tot_porc=0,ll_dia
String		ls_base,ls_fec_inicial,ls_fec_final,ls_fecha_ini,ls_fecha_fin
Date			ld_fecha_inicial,ld_fecha_final

dw_parque.accepttext()
gl_cod_parque_cta		= dw_parque.getitemnumber(1,'cod_parque')
Setnull(ld_nulo);Setnull(ll_nulo)
SetPointer(HourGlass!)
tab_1.tabpage_4.dw_print_masivo.reset()
em_buscar_ctto.text			= ''
ll_mes							= month(today())
ll_year							= year(today())
ll_mes ++
if ll_mes > 12 then 
	ll_mes						= 1
	ll_year ++
end if
ls_fecha_ini					= '01/'+string(ll_mes,'00')+'/'+string(ll_year,'0000')
if ll_mes=1 or ll_mes=3 or ll_mes=5 or ll_mes=7 or ll_mes=8 or ll_mes=10 or ll_mes=12 then
	ls_fecha_fin				= '31/'+string(ll_mes,'00')+'/'+string(ll_year,'0000')
elseif ll_mes=2 then	
	if (ll_year / 4) = int(ll_year / 4) then
		ls_fecha_fin			= '29/'+string(ll_mes,'00')+'/'+string(ll_year,'0000')
	else
		ls_fecha_fin			= '28/'+string(ll_mes,'00')+'/'+string(ll_year,'0000')
	end if
elseif ll_mes=4 or ll_mes=6 or ll_mes=9 or ll_mes=11 then
	ls_fecha_fin				= '30/'+string(ll_mes,'00')+'/'+string(ll_year,'0000')
end if
ld_fec_ini						= datetime(date(ls_fecha_ini),lt_ini)
ld_fec_fin						= datetime(date(ls_fecha_fin),lt_fin)
st_porc.text					= ''
em_buscar_ctto.text			= ''
st_6.text						= 'Lista de Contratos para Imprimir Cuponera del '+string(ld_fec_ini,'dd/mm/yyyy')+' al '+string(ld_fec_fin,'dd/mm/yyyy')
if trim(em_fec_ini.text)='00/00/0000' or isnull(em_fec_ini.text) then
	messagebox("Advertencia","Fecha Inicial Inválida")
	em_fec_ini.setfocus()
else
	if trim(em_fec_fin.text)='00/00/0000' or isnull(em_fec_fin.text) then
		messagebox("Advertencia","Fecha Término Inválida")
		em_fec_fin.setfocus()
	else
		if ld_fec_ini>ld_fec_fin then
			messagebox("Advertencia","Rango de Fecha Incorrecta")
			em_fec_ini.setfocus()
		else
			ll_cod_parque	= dw_parque.getitemnumber(1,'cod_parque')
			if ll_cod_parque>0 then
				ll_tot_reg	= tab_1.tabpage_4.dw_print_masivo.retrieve(ld_fec_ini,ld_fec_fin,ll_cod_parque)
				if ll_tot_reg > 0 then
					st_fondo.visible					= true
					hpb_1.visible 						= true
					st_porc.visible 					= true
					st_nro_registros.visible		= true
					st_registro.visible				= true
					st_contar.visible					= true
					st_porc.text						= '0 %'
					st_nro_registros.text			= " de "+string(ll_tot_reg)
					hpb_1.Position						= ll_tot_porc
					for ll_indi=1 to ll_tot_reg
						tab_1.tabpage_4.dw_print_masivo.setitem(ll_indi,'genera',1)
						ls_base	= tab_1.tabpage_4.dw_print_masivo.getitemstring(ll_indi,'cadena_codigo')
						if ls_base='L' or ls_base='A' or ls_base='P' or ls_base='R' or ls_base='D' then
							tab_1.tabpage_4.dw_print_masivo.setitem(ll_indi,'oferta_v_fecha_m',ld_nulo)
							tab_1.tabpage_4.dw_print_masivo.setitem(ll_indi,'oferta_v_valor_cuota_m',0)
						elseif ls_base='C' then
							tab_1.tabpage_4.dw_print_masivo.setitem(ll_indi,'pago_oferta_fecha_prim',ld_nulo)
							tab_1.tabpage_4.dw_print_masivo.setitem(ll_indi,'pago_oferta_valor_cuota',0)
						end if
						if ll_tot_porc <> ll_tot_porc_aux then 
							st_porc.text			= string(ll_tot_porc)+" %"
							ll_tot_porc_aux		= ll_tot_porc
						end if
						ll_tot_porc					= (ll_indi * 100) / ll_tot_reg
						hpb_1.Position 			= ll_tot_porc
						st_contar.text				= string(ll_indi)
					next
					st_fondo.visible				= false
					hpb_1.visible 					= false
					st_porc.visible 				= false
					st_nro_registros.visible	= false
					st_registro.visible			= false
					st_contar.visible				= false
					tab_1.tabpage_4.dw_print_masivo.accepttext()
					tab_1.tabpage_4.dw_print_masivo.scrolltorow(1)
				end if
			else
				messagebox("Advertencia","Debe Seleccionar Parque")
				dw_parque.setfocus()
			end if
		end if
	end if
end if
SetPointer(Arrow!)
end event

