type dw_genera from datawindow within tabpage_3
integer x = 27
integer y = 108
integer width = 2907
integer height = 1252
integer taborder = 20
string title = "none"
string dataobject = "dw_lista_contratos_generar_cuponera_man"
boolean hscrollbar = true
boolean vscrollbar = true
boolean hsplitscroll = true
borderstyle borderstyle = stylelowered!
end type

event clicked;Long		ll_tot_reg,ll_indi,ll_count
String	ls_columna,ls_estado_cuponera

ls_columna			= dwo.name
if row>0 then
	il_row_genera	= row
	This.SelectRow(0, FALSE)
	This.SelectRow(il_row_genera, TRUE)
	gi_rut			= this.getitemnumber(il_row_genera,'cadena_rut')
	if gi_rut>0 then 
		if isvalid(w_aviso_mensajes) then close(w_aviso_mensajes)
		SELECT	COUNT("MENSAJES"."FECHA_CREACION")  
		INTO 		:ll_count  
		FROM 		"MENSAJES"  
		WHERE  ( "MENSAJES"."RUT" = :gi_rut ) and
				 ( "MENSAJES"."ESTADO_GESTION" = 'A' ) AND
				 ( "MENSAJES"."SW_MENSAJE" = 'R' ) and
				 ( "MENSAJES"."FECHA_FIN" > :gdt_fec_sistema )
		USING		sqlca;
		if ll_count>0 then
			OpenWithParm(w_aviso_mensajes, "R")
		else
			SELECT	COUNT("MENSAJES"."FECHA_CREACION")  
			INTO 		:ll_count  
			FROM 		"MENSAJES"  
			WHERE  ( "MENSAJES"."BASE" = :gs_base ) and
					 ( "MENSAJES"."SERIE" = :gs_serie ) and
					 ( "MENSAJES"."NUMERO" = :gi_numero ) and
					 ( "MENSAJES"."ESTADO_GESTION" = 'A' ) AND
					 ( "MENSAJES"."SW_MENSAJE" = 'C' ) and
					 ( "MENSAJES"."FECHA_FIN" > :gdt_fec_sistema )
			USING		sqlca;
			if ll_count>0 then
				OpenWithParm(w_aviso_mensajes, "C")
			end if
		end if
	end if
else
	ll_tot_reg	= dw_genera.rowcount()
	if ll_tot_reg>0 then
		if ls_columna='t_marcar' then
			if rb_credito.checked=true then
				if dw_genera.object.t_marcar.text='Marcar Todo' then
					for ll_indi=1 to ll_tot_reg
						ls_estado_cuponera	= dw_genera.getitemstring(ll_indi,'cuponeras_estado_cuponera')
						if isnull(ls_estado_cuponera) then
							dw_genera.setitem(ll_indi,'genera',0)
						else
							if ls_estado_cuponera <> 'V' then
								dw_genera.setitem(ll_indi,'genera',0)
							else
								dw_genera.setitem(ll_indi,'genera',1)
							end if
						end if
					next
					dw_genera.object.t_marcar.text='Desmarcar Todo'
				else
					for ll_indi=1 to ll_tot_reg
						dw_genera.setitem(ll_indi,'genera',1)
					next
					dw_genera.object.t_marcar.text='Marcar Todo'
				end if
			elseif rb_mantencion.checked=true then
				if dw_genera.object.t_marcar.text='Marcar Todo' then
					for ll_indi=1 to ll_tot_reg
						dw_genera.setitem(ll_indi,'genera',0)
					next
					dw_genera.object.t_marcar.text='Desmarcar Todo'
				else
					for ll_indi=1 to ll_tot_reg
						dw_genera.setitem(ll_indi,'genera',1)
					next
					dw_genera.object.t_marcar.text='Marcar Todo'
				end if
			end if
		end if
	end if
end if
end event

event rowfocuschanged;if getrow()>0 then
	il_row_genera	= getrow()
	This.SelectRow(0, FALSE)
	This.SelectRow(il_row_genera, TRUE)
end if
end event

