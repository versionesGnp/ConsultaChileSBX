event clicked;Long	ll_fila,ll_tot_reg
ll_tot_reg			= w_administrar_cuponera.tab_1.tabpage_1.dw_lista.rowcount()
ll_fila				= w_administrar_cuponera.tab_1.tabpage_1.dw_lista.Find("estado = 0", 1, ll_tot_reg)
if ll_fila>0 then
	gs_cuponera_aviso	= '0'
	f_dejar_nulo_print_usuario(gs_tcp_ip,gs_user)
	if isvalid(w_print_vista_cupones_masiva) then close(w_print_vista_cupones_masiva)
	open(w_print_vista_cupones_masiva)
