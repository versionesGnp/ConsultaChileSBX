type pb_buscar from picturebutton within w_administrar_cuponera
integer x = 2560
integer y = 1884
integer width = 128
integer height = 112
integer taborder = 100
integer textsize = -9
integer weight = 400
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
boolean originalsize = true
string picturename = "LUPA.BMP"
end type

event clicked;Long	ll_numero,ll_fila,ll_tot_reg

ll_numero			= Long(em_buscar_ctto.text)
CHOOSE CASE tab_1.SelectedTab
	CASE 1
		ll_tot_reg	= tab_1.tabpage_1.dw_lista.rowcount()
		ll_fila		= tab_1.tabpage_1.dw_lista.Find("numero = "+string(ll_numero), 1, ll_tot_reg)
		if ll_fila>0 then
			tab_1.tabpage_1.dw_lista.scrolltorow(ll_fila)
		end if
	CASE 3
		ll_tot_reg	= tab_1.tabpage_3.dw_genera.rowcount()
		ll_fila		= tab_1.tabpage_3.dw_genera.Find("cadena_numero = "+string(ll_numero), 1, ll_tot_reg)
		if ll_fila>0 then
			tab_1.tabpage_3.dw_genera.scrolltorow(ll_fila)
		end if
	CASE 4
		ll_tot_reg	= tab_1.tabpage_4.dw_print_masivo.rowcount()
		ll_fila		= tab_1.tabpage_4.dw_print_masivo.Find("cadena_numero = "+string(ll_numero), 1, ll_tot_reg)
		if ll_fila>0 then
			tab_1.tabpage_4.dw_print_masivo.scrolltorow(ll_fila)
		end if
	CASE 5
		ll_tot_reg	= tab_1.tabpage_5.dw_carta.rowcount()
		ll_fila		= tab_1.tabpage_5.dw_carta.Find("cadena_mora_numero = "+string(ll_numero), 1, ll_tot_reg)
		if ll_fila>0 then
			tab_1.tabpage_5.dw_carta.scrolltorow(ll_fila)
		end if
	CASE 6
		ll_tot_reg	= tab_1.tabpage_6.dw_lista_modif.rowcount()
		ll_fila		= tab_1.tabpage_6.dw_lista_modif.Find("numero = "+string(ll_numero), 1, ll_tot_reg)
		if ll_fila>0 then
			tab_1.tabpage_6.dw_lista_modif.scrolltorow(ll_fila)
		end if
END CHOOSE
if ll_fila=0 then
	messagebox("Advertencia","No Existe Nº Contrato "+string(ll_numero,"###,###,###,###"))
end if
end event

