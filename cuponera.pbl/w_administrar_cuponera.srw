type dw_lista_modif from datawindow within tabpage_6
event ue_mousemove pbm_mousemove
integer x = 27
integer y = 108
integer width = 2907
integer height = 1252
integer taborder = 30
string title = "none"
string dataobject = "dw_lista_contratos_modificados"
boolean vscrollbar = true
boolean hsplitscroll = true
borderstyle borderstyle = stylelowered!
end type

event ue_mousemove;st_help_modif.visible	= true
end event

event clicked;Long		ll_tot_reg,ll_indi,ll_count
String	ls_columna,ls_filtro

ls_columna			= dwo.name
if row>0 then
	il_row_modif	= row
	This.SelectRow(0, FALSE)
	This.SelectRow(il_row_modif, TRUE)
	gi_rut			= this.getitemnumber(il_row_modif,'rut')
	if gi_rut>0 then 
		if isvalid(w_aviso_mensajes) then close(w_aviso_mensajes)
		SELECT	COUNT("MENSAJES"."FECHA_CREACION")  
		INTO 		:ll_count  
		FROM 		"MENSAJES"  
		WHERE  ( "MENSAJES"."RUT" = :gi_rut ) and
				 ( "MENSAJES"."ESTADO_GESTION" = 'A' ) AND
				 ( "MENSAJES"."SW_MENSAJE" = 'R' ) and
				 ( "MENSAJES"."FECHA_FIN" > :gdt_fec_sistema )
		USING		sqlca;
		if ll_count>0 then
			OpenWithParm(w_aviso_mensajes, "R")
		else
			SELECT	COUNT("MENSAJES"."FECHA_CREACION")  
			INTO 		:ll_count  
			FROM 		"MENSAJES"  
			WHERE  ( "MENSAJES"."BASE" = :gs_base ) and
					 ( "MENSAJES"."SERIE" = :gs_serie ) and
					 ( "MENSAJES"."NUMERO" = :gi_numero ) and
					 ( "MENSAJES"."ESTADO_GESTION" = 'A' ) AND
					 ( "MENSAJES"."SW_MENSAJE" = 'C' ) and
					 ( "MENSAJES"."FECHA_FIN" > :gdt_fec_sistema )
			USING		sqlca;
			if ll_count>0 then
				OpenWithParm(w_aviso_mensajes, "C")
			end if
		end if
	end if
else
	ll_tot_reg	= dw_lista_modif.rowcount()
	if ll_tot_reg>0 then
		if ls_columna='t_marcar' then
			if dw_lista_modif.object.t_marcar.text='Marcar Todo' then
				for ll_indi=1 to ll_tot_reg
					dw_lista_modif.setitem(ll_indi,'estado',0)
				next
				dw_lista_modif.object.t_marcar.text='Desmarcar Todo'
			else
				for ll_indi=1 to ll_tot_reg
					dw_lista_modif.setitem(ll_indi,'estado',1)
				next
				dw_lista_modif.object.t_marcar.text='Marcar Todo'
			end if
		end if
	end if
	if ls_columna='t_rojo' or ls_columna='t_rojo_x' then
		ls_filtro	= "cuponeras_modifica_tipo_modificacion = 'P'"
	elseif ls_columna='t_amarillo' or ls_columna='t_amarillo_x' then
		ls_filtro	= "cuponeras_modifica_tipo_modificacion = 'E'"
	elseif ls_columna='t_cafe' or ls_columna='t_cafe_x' then
		ls_filtro	= "cuponeras_modifica_tipo_modificacion = 'C'"
	elseif ls_columna='t_azul' or ls_columna='t_azul_x' then
		ls_filtro	= "cuponeras_modifica_tipo_modificacion = 'F'"
	elseif ls_columna='t_verde' or ls_columna='t_verde_x' then
		ls_filtro	= "cuponeras_modifica_tipo_modificacion = 'M'"
	end if
	
	if ls_columna='t_rojo' or ls_columna='t_rojo_x' or ls_columna='t_amarillo' or &
		ls_columna='t_amarillo_x' or ls_columna='t_cafe' or ls_columna='t_cafe_x' or &
		ls_columna='t_azul' or ls_columna='t_azul_x' or ls_columna='t_verde' or &
		ls_columna='t_verde_x' then

		dw_lista_modif.SETfilter(ls_filtro)
		dw_lista_modif.filter()
		if dw_lista_modif.rowcount()>0 then
			dw_lista_modif.scrolltorow(1)
		else
			messagebox("Advertencia","No Registra Dato")
		end if
	end if
end if
end event

event rowfocuschanged;if getrow()>0 then
	il_row_modif	= getrow()
	This.SelectRow(0, FALSE)
	This.SelectRow(il_row_modif, TRUE)
end if
end event

