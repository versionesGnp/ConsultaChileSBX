type dw_lista from datawindow within tabpage_1
event ue_mousemove pbm_mousemove
integer x = 27
integer y = 108
integer width = 2907
integer height = 1252
integer taborder = 20
string title = "none"
string dataobject = "dw_lista_cuponeras_generadas"
boolean vscrollbar = true
boolean hsplitscroll = true
borderstyle borderstyle = stylelowered!
end type

event ue_mousemove;st_8.visible	= false
st_9.visible	= false
end event

event clicked;String	ls_base,ls_serie
Long		ll_numero,ll_corr,ll_count
if row>0 then
	il_row												= row
	This.SelectRow(0, FALSE)
	This.SelectRow(il_row, TRUE)
	ls_base												= this.getitemstring(il_row,'base')
	ls_serie												= this.getitemstring(il_row,'serie')
	ll_numero											= this.getitemnumber(il_row,'numero')
	ll_corr												= this.getitemnumber(il_row,'nro_cuponera')
	gi_rut												= this.getitemnumber(il_row,'cadena_rut')
	if tab_1.tabpage_2.dw_detalle.retrieve(ls_base,ls_serie,ll_numero,ll_corr)=0 then
		tab_1.tabpage_2.st_no_existe.visible	= true
		tab_1.tabpage_2.dw_detalle.visible		= false
		tab_1.tabpage_2.dw_agrupado.visible		= false
	else
		tab_1.tabpage_2.dw_agrupado.retrieve(ls_base,ls_serie,ll_numero,ll_corr)
		tab_1.tabpage_2.st_no_existe.visible	= false
		tab_1.tabpage_2.dw_detalle.visible		= true
		tab_1.tabpage_2.dw_agrupado.visible		= true
	end if
	if gi_rut>0 then 
		if isvalid(w_aviso_mensajes) then close(w_aviso_mensajes)
		SELECT	COUNT("MENSAJES"."FECHA_CREACION")  
		INTO 		:ll_count  
		FROM 		"MENSAJES"  
		WHERE  ( "MENSAJES"."RUT" = :gi_rut ) and
				 ( "MENSAJES"."ESTADO_GESTION" = 'A' ) AND
				 ( "MENSAJES"."SW_MENSAJE" = 'R' ) and
				 ( "MENSAJES"."FECHA_FIN" > :gdt_fec_sistema )
		USING		sqlca;
		if ll_count>0 then
			OpenWithParm(w_aviso_mensajes, "R")
		else
			SELECT	COUNT("MENSAJES"."FECHA_CREACION")  
			INTO 		:ll_count  
			FROM 		"MENSAJES"  
			WHERE  ( "MENSAJES"."BASE" = :gs_base ) and
					 ( "MENSAJES"."SERIE" = :gs_serie ) and
					 ( "MENSAJES"."NUMERO" = :gi_numero ) and
					 ( "MENSAJES"."ESTADO_GESTION" = 'A' ) AND
					 ( "MENSAJES"."SW_MENSAJE" = 'C' ) and
					 ( "MENSAJES"."FECHA_FIN" > :gdt_fec_sistema )
			USING		sqlca;
			if ll_count>0 then
				OpenWithParm(w_aviso_mensajes, "C")
			end if
		end if
	end if
end if
end event

event rowfocuschanged;String	ls_base,ls_serie
Long		ll_numero,ll_corr
if getrow() > 0 then
	il_row												= getrow()
	This.SelectRow(0, FALSE)
	This.SelectRow(il_row, TRUE)
end if
end event

