event open;Long		ll_parque
String	ls_estado_permiso
gf_centrar(w_administrar_cuponera)
tab_1.tabpage_1.dw_lista.settransobject(sqlca)
tab_1.tabpage_2.dw_detalle.settransobject(sqlca)
tab_1.tabpage_2.dw_agrupado.settransobject(sqlca)
dw_mecanizado.settransobject(sqlca)
tab_1.tabpage_3.rb_credito.checked 		= true
tab_1.tabpage_3.dw_genera.dataobject	= 'dw_lista_contratos_generar_cuponera_vig'
tab_1.tabpage_3.dw_genera.settransobject(sqlca)
tab_1.tabpage_4.dw_print_masivo.settransobject(sqlca)
tab_1.tabpage_5.dw_carta.settransobject(sqlca)
tab_1.tabpage_6.dw_lista_modif.settransobject(sqlca)
tab_1.tabpage_7.dwe_actualiza_cadena_mora.settransobject(sqlca)
tab_1.tabpage_7.dwe_actualiza_cadena_mora.getchild('serie',idw_detalle)
idw_detalle.settransobject(sqlca)
idw_detalle.insertrow(0)
tab_1.tabpage_7.cb_pagos_cadena_mora.enabled	= false
tab_1.tabpage_7.dwe_actualiza_cadena_mora.setfocus()
tab_1.tabpage_7.dwe_actualiza_cadena_mora.insertrow(0)
em_buscar_ctto.text	= ''
idt_fecha_hoy			= date(gdt_fec_sistema)
em_fec_ini.text		= string(idt_fecha_hoy)
em_fec_fin.text		= string(idt_fecha_hoy)
dw_parque.settransobject(sqlca)
dw_parque.insertrow(0)
if gs_conexion	= "Parque El Prado" then
	ll_parque			= 1
elseif gs_conexion = "Parque La Foresta" then
	ll_parque			= 11
elseif gs_conexion = "Parque Santiago" then
	ll_parque			= 103
elseif gs_conexion = "Parque Memorial PARK" then
	ll_parque			= 104
end if
gl_cod_parque_cta										= ll_parque
dw_parque.setitem(1,'cod_parque',ll_parque)
SELECT	"CUPONERAS_PERMISO"."ESTADO"  
INTO 		:ls_estado_permiso  
FROM 	"CUPONERAS_PERMISO"  
WHERE  ( "CUPONERAS_PERMISO"."USUARIO" = :gs_user ) AND  
		 ( "CUPONERAS_PERMISO"."ESTADO" = 'A' )   
USING		sqlca;
if sqlca.sqlcode=0 then
	tab_1.tabpage_3.cb_generar.enabled				= true
	tab_1.tabpage_1.cb_anular.enabled				= true
	tab_1.tabpage_1.cb_activar.enabled				= true
	tab_1.tabpage_6.cb_generar_modif.enabled	= true
else
	tab_1.tabpage_3.cb_generar.enabled				= false
	tab_1.tabpage_1.cb_anular.enabled				= false
	tab_1.tabpage_1.cb_activar.enabled				= false
	tab_1.tabpage_6.cb_generar_modif.enabled	= false
end if
st_fondo.visible												= false
hpb_1.visible 												= false
st_porc.visible 												= false
st_nro_registros.visible									= false
st_registro.visible											= false
st_contar.visible											= false
if gs_depto='I' then
	cb_pagos.visible										= true
	tab_1.tabpage_7.visible								= true
else
	cb_pagos.visible										= false
	tab_1.tabpage_7.visible								= false
end if
dw_parque.accepttext()
end event

event mousemove;tab_1.tabpage_1.st_8.visible				= false
tab_1.tabpage_1.st_9.visible				= false
tab_1.tabpage_6.st_help_modif.visible	= false

end event

event close;setnull(gi_rut)
end event

type dw_mecanizado from datawindow within w_administrar_cuponera
boolean visible = false
integer x = 1705
integer y = 1992
integer width = 411
integer height = 432
string title = "none"
string dataobject = "dwe_generar_archivo_mecanizado"
boolean livescroll = true
borderstyle borderstyle = stylelowered!
end type

type cb_mecanizado from commandbutton within w_administrar_cuponera
integer x = 782
integer y = 1880
integer width = 489
integer height = 100
integer taborder = 70
integer textsize = -8
integer weight = 400
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string text = "&Archivo Mecanizado"
end type

event clicked;Long	ll_indi,ll_tot_reg

dw_mecanizado.reset()
if isvalid(w_exporta_mecanizado_arch) then close(w_exporta_mecanizado_arch)
if tab_1.SelectedTab=1 then
	ll_tot_reg	= tab_1.tabpage_1.dw_lista.rowcount()
	if ll_tot_reg > 0 then
		wf_cargar_mecanizado(tab_1.tabpage_1.dw_lista, ll_tot_reg)
	else
		messagebox("Advertencia","No Registra Dato para Generar Archivo")
	end if
elseif tab_1.SelectedTab=2 then
	messagebox("Advertencia","No es Posible Generar Archivo Mecanizado")
elseif tab_1.SelectedTab=3 then
	ll_tot_reg	= tab_1.tabpage_3.dw_genera.rowcount()
	if ll_tot_reg > 0 then
		wf_cargar_mecanizado(tab_1.tabpage_3.dw_genera, ll_tot_reg)
	else
		messagebox("Advertencia","No Registra Dato para Generar Archivo")
	end if
elseif tab_1.SelectedTab=4 then
	ll_tot_reg	= tab_1.tabpage_4.dw_print_masivo.rowcount()
	if ll_tot_reg > 0 then
		wf_cargar_mecanizado(tab_1.tabpage_4.dw_print_masivo, ll_tot_reg)
	else
		messagebox("Advertencia","No Registra Dato para Generar Archivo")
	end if
elseif tab_1.SelectedTab=5 then
	ll_tot_reg	= tab_1.tabpage_5.dw_carta.rowcount()
	if ll_tot_reg > 0 then
		wf_cargar_mecanizado(tab_1.tabpage_5.dw_carta, ll_tot_reg)
	else
		messagebox("Advertencia","No Registra Dato para Generar Archivo")
	end if
elseif tab_1.SelectedTab=6 then
	messagebox("Advertencia","No es Posible Generar Archivo Mecanizado")
end if
end event

