	messagebox("Advertencia","Debe Seleccionar por lo Menos UN Contrato")
end if
end event

type cb_generar from commandbutton within tabpage_3
integer x = 1431
integer y = 1392
integer width = 315
integer height = 100
integer taborder = 30
integer textsize = -9
integer weight = 400
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string text = "&Generar"
end type

event clicked;long 		ll_fila,ll_tot_reg,ll_indi,ll_plazo,ll_rut,ll_cod_parque,ll_numero,ll_opcion,&
			ll_ctas_pag,ll_count_vig,ll_tot_porc_aux,ll_tot_porc=0,ll_num_cuponera
Double	ldb_valor_cuota,ldb_valor_cuota_mant
Datetime	ldt_fecha_prim,ldt_fec_venc_mant
String	ls_dv,ls_base,ls_serie,ls_estado_cadena,ls_moneda,ls_estado_cuponera

SetPointer(HourGlass!)
dw_parque.accepttext()
ll_tot_reg								= dw_genera.rowcount()
if ll_tot_reg>0 then
	st_fondo.visible					= true
	hpb_1.visible 						= true
	st_porc.visible 					= true
	st_nro_registros.visible		= true
	st_registro.visible				= true
	st_contar.visible					= true
	st_porc.text						= '0 %'
	ll_cod_parque						= dw_parque.getitemnumber(1,'cod_parque')
	ll_fila								= dw_genera.Find("genera = 0", 1, ll_tot_reg)
	if ll_fila>0 then
		hpb_1.Position					= ll_tot_porc
		st_nro_registros.text		= " de "+string(ll_tot_reg)
		for ll_indi = ll_fila to ll_tot_reg
			ll_opcion					= dw_genera.getitemnumber(ll_indi,'genera')
			if ll_opcion=0 then
				ls_base					= dw_genera.getitemstring(ll_indi,'cadena_codigo')
				ls_serie					= dw_genera.getitemstring(ll_indi,'cadena_serie')
				ll_numero				= dw_genera.getitemnumber(ll_indi,'cadena_numero')
				ll_plazo					= dw_genera.getitemnumber(ll_indi,'pago_oferta_nro_cuotas')
				ll_rut					= dw_genera.getitemnumber(ll_indi,'cadena_rut')
				ldb_valor_cuota		= dw_genera.getitemnumber(ll_indi,'pago_oferta_valor_cuota')
				ldt_fecha_prim			= dw_genera.getitemdatetime(ll_indi,'pago_oferta_fecha_prim')
				ldt_fec_venc_mant		= dw_genera.getitemdatetime(ll_indi,'oferta_v_fecha_m')
				ldb_valor_cuota_mant	= dw_genera.getitemnumber(ll_indi,'oferta_v_valor_cuota_m')
				ls_dv						= dw_genera.getitemstring(ll_indi,'cliente_dv')
				ls_estado_cadena		= dw_genera.getitemstring(ll_indi,'cadena_estado')
				ls_moneda				= dw_genera.getitemstring(ll_indi,'pago_oferta_moneda')
				ls_estado_cuponera	= dw_genera.getitemstring(ll_indi,'cuponeras_estado_cuponera')
				ll_num_cuponera		= dw_genera.getitemnumber(ll_indi,'cuponeras_nro_cuponera')
				ldt_fecha_prim			= datetime(date(ldt_fecha_prim),time('00:00:00'))
				if isnull(ldt_fec_venc_mant) then ldt_fec_venc_mant=datetime(date(gdt_fec_sistema),time('00:00:00'))
				if rb_credito.checked=true then
					DECLARE sp_proc_genera_cuponera PROCEDURE FOR SP_GENERAR_CUPONERA( :ls_base, :ls_serie, :ll_numero, :ll_plazo, :gs_user, :ll_rut, :ldb_valor_cuota, :ldb_valor_cuota_mant, :ls_dv, :ll_cod_parque, :ldt_fecha_prim, :ldt_fec_venc_mant, :ls_moneda);
    				EXECUTE sp_proc_genera_cuponera;
				elseif rb_mantencion.checked=true then
					DECLARE sp_proc_genera_mantencion PROCEDURE FOR SP_GENERAR_CUPON_MANTENCION( :ls_base, :ls_serie, :ll_numero, :ll_plazo, :gs_user, :ll_rut, :ldb_valor_cuota, :ldb_valor_cuota_mant, :ls_dv, :ll_cod_parque, :ldt_fecha_prim, :ldt_fec_venc_mant, :ls_moneda);
    				EXECUTE sp_proc_genera_mantencion;
				end if
				if ls_estado_cuponera='A' then
					UPDATE	"CUPONERAS"  
					SET 		"ESTADO_CUPONERA" = 'R'  
					WHERE  ( "CUPONERAS"."BASE" = :ls_base ) AND  
							 ( "CUPONERAS"."SERIE" = :ls_serie ) AND  
							 ( "CUPONERAS"."NUMERO" = :ll_numero ) AND  
							 ( "CUPONERAS"."ESTADO_CUPONERA" = :ls_estado_cuponera ) AND  
							 ( "CUPONERAS"."NRO_CUPONERA" = :ll_num_cuponera )   
					USING		sqlca;
					if sqlca.sqlcode=0 then
						commit;
					else
						rollback;
					end if
				end if
			end if
			if ll_tot_porc <> ll_tot_porc_aux then 
				st_porc.text			= string(ll_tot_porc)+" %"
				ll_tot_porc_aux		= ll_tot_porc
			end if
			ll_tot_porc					= (ll_indi * 100) / ll_tot_reg
			hpb_1.Position 			= ll_tot_porc
			st_contar.text				= string(ll_indi)
		next
		st_fondo.visible				= false
		hpb_1.visible 					= false
		st_porc.visible 				= false
		st_nro_registros.visible	= false
		st_registro.visible			= false
		st_contar.visible				= false
		cb_mostrar_generar.triggerevent(clicked!)
		ll_fila							= dw_genera.Find("cadena_codigo='"+ls_base+"' and cadena_serie='"+ls_serie+"' and cadena_numero="+string(ll_numero), 1, ll_tot_reg)
		dw_genera.scrolltorow(ll_fila)
		dw_genera.setfocus()
	else
		messagebox("Advertencia","Debe Seleccionar por lo menos UN Contrato")
	end if
end if
SetPointer(Arrow!)
end event

