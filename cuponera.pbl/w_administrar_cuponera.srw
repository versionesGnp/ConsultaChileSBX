forward prototypes
public subroutine wf_cargar_mecanizado (datawindow adw_dw, long al_total)
end prototypes

public subroutine wf_cargar_mecanizado (datawindow adw_dw, long al_total);Long		ll_indi,ll_new,ll_numero,ll_rut,ll_mes,ll_year,ll_cod_parque
String	ls_nombres,ls_ap_pat,ls_ap_mat,ls_direc_p,ls_pob,ls_sexo,ls_nro_p,ls_depto_p,&
			ls_block_p,ls_tipo_via,ls_comuna,ls_ciudad,ls_base,ls_serie,ls_nom_comp,ls_dir_comp,&
			ls_obs,ls_parque

dw_parque.accepttext()
ll_mes				= month(today())
ll_year				= year(today())
ll_cod_parque		= dw_parque.getitemnumber(1,'cod_parque')
if ll_cod_parque=1 then ls_parque='P'
if ll_cod_parque=102 then ls_parque='M'
if ll_cod_parque=11 then ls_parque='F'
if tab_1.SelectedTab = 4 then
	ll_mes++
	if ll_mes>12 then
		ll_year++
	end if
	ls_obs			= 'AV_VENC_'+string(ll_mes,'00')+'_'+string(ll_year,'0000')+'_'+ls_parque
else
	ls_obs			= 'AV_VENC_'+string(ll_mes,'00')+'_'+string(ll_year,'0000')+'_'+ls_parque
end if
for ll_indi=1 to al_total
	if tab_1.SelectedTab = 1 then
		ll_numero 	= adw_dw.getitemnumber(ll_indi,'numero')
		ls_base		= adw_dw.getitemstring(ll_indi,'base')
		ls_serie		= adw_dw.getitemstring(ll_indi,'serie')
		ll_rut		= adw_dw.getitemnumber(ll_indi,'cadena_rut')
	elseif tab_1.SelectedTab = 3 then
		ll_numero 	= adw_dw.getitemnumber(ll_indi,'cadena_numero')
		ls_base		= adw_dw.getitemstring(ll_indi,'cadena_codigo')
		ls_serie		= adw_dw.getitemstring(ll_indi,'cadena_serie')
		ll_rut		= adw_dw.getitemnumber(ll_indi,'cadena_rut')
	elseif tab_1.SelectedTab = 4 then
		ll_numero 	= adw_dw.getitemnumber(ll_indi,'cadena_numero')
		ls_base		= adw_dw.getitemstring(ll_indi,'cadena_codigo')
		ls_serie		= adw_dw.getitemstring(ll_indi,'cadena_serie')
		ll_rut		= adw_dw.getitemnumber(ll_indi,'cadena_rut')
	elseif tab_1.SelectedTab = 5 then
		ll_numero 	= adw_dw.getitemnumber(ll_indi,'cadena_mora_numero')
		ls_base		= adw_dw.getitemstring(ll_indi,'cadena_mora_base')
		ls_serie		= adw_dw.getitemstring(ll_indi,'cadena_mora_serie')
		ll_rut		= adw_dw.getitemnumber(ll_indi,'cadena_rut')
	elseif tab_1.SelectedTab = 6 then
		ll_numero 	= adw_dw.getitemnumber(ll_indi,'numero')
		ls_base		= adw_dw.getitemstring(ll_indi,'base')
		ls_serie		= adw_dw.getitemstring(ll_indi,'serie')
		ll_rut		= adw_dw.getitemnumber(ll_indi,'rut')
	end if
	SELECT	"CLIENTE"."NOMBRE",	"CLIENTE"."A_PATERNO",	"CLIENTE"."A_MATERNO",	"CLIENTE"."DIRECCION_P",	"CLIENTE"."POBLACION",	"CLIENTE"."SEXO",	"CLIENTE"."NUMERO_PARTICULAR",	"CLIENTE"."DEPTO_PARTICULAR",	"CLIENTE"."BLOCK_PARTICULAR",	"TIPO_VIA"."DESCRIPCION",	"COMUNA"."SIGLA_COMUNA",	"CIUDAD"."SIGLA_CIUDAD"
	INTO 		:ls_nombres,			:ls_ap_pat,					:ls_ap_mat,					:ls_direc_p,					:ls_pob,						:ls_sexo,			:ls_nro_p,								:ls_depto_p,						:ls_block_p,						:ls_tipo_via,					:ls_comuna,						:ls_ciudad
	FROM 		"CLIENTE",   
				"CIUDAD",   
				"COMUNA",   
				"TIPO_VIA"  
	WHERE  ( "CLIENTE"."TIPO_VIA" = "TIPO_VIA"."TIPO_VIA" ) and  
			 ( "CLIENTE"."COMUNA" = "COMUNA"."CODIGO_COMUNA" ) and  
			 ( "CLIENTE"."CIUDAD" = "CIUDAD"."CODIGO_CIUDAD" ) and  
			 (("CLIENTE"."RUT" = :ll_rut ) )   
	USING		sqlca;
	if sqlca.sqlcode=0 then
		ls_nom_comp	= ls_nombres+' '+ls_ap_pat+' '+ls_ap_mat
		if not isnull(ls_tipo_via) and ls_tipo_via<>'' and ls_tipo_via<>'-' then
			ls_dir_comp	= ls_tipo_via+' '+ls_direc_p
		else
			ls_dir_comp	= ls_direc_p
		end if
		if not isnull(ls_nro_p) and ls_nro_p<>'' and ls_nro_p<>'-' then
			ls_dir_comp	= ls_dir_comp+' Nº: '+ls_nro_p
		end if
		if not isnull(ls_depto_p) and ls_depto_p<>'' and ls_depto_p<>'-' then
			ls_dir_comp	= ls_dir_comp+' Depto: '+ls_depto_p
		end if
		if not isnull(ls_block_p) and ls_block_p<>'' and ls_block_p<>'-' then
			ls_dir_comp	= ls_dir_comp+' Block: '+ls_block_p
		end if
		ll_new	= dw_mecanizado.insertrow(0)
		dw_mecanizado.scrolltorow(ll_new)
		dw_mecanizado.setitem(ll_new,'base',ls_base)
		dw_mecanizado.setitem(ll_new,'serie',ls_serie)
		dw_mecanizado.setitem(ll_new,'numero',ll_numero)
		dw_mecanizado.setitem(ll_new,'nombre',ls_nom_comp)
		dw_mecanizado.setitem(ll_new,'direccion',ls_dir_comp)
		dw_mecanizado.setitem(ll_new,'poblacion',ls_pob)
		dw_mecanizado.setitem(ll_new,'ciudad',upper(ls_ciudad))
		dw_mecanizado.setitem(ll_new,'comuna',upper(ls_comuna))
		dw_mecanizado.setitem(ll_new,'fecha_emision',today())
		dw_mecanizado.setitem(ll_new,'correlativo',ll_indi)
		dw_mecanizado.setitem(ll_new,'observacion',ls_obs)
	end if
next
if dw_mecanizado.rowcount() > 0 then
	OpenWithParm(w_exporta_mecanizado_arch, dw_mecanizado)
end if
end subroutine

on w_administrar_cuponera.create
this.dw_mecanizado=create dw_mecanizado
this.cb_mecanizado=create cb_mecanizado
this.dw_base=create dw_base
this.cb_1=create cb_1
this.st_contar=create st_contar
