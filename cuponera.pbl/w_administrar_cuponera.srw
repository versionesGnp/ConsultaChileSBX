this.st_11,&
this.cb_ctacte,&
this.p_fin,&
this.st_3,&
this.p_ini,&
this.em_fec_ini,&
this.st_2,&
this.pb_ok,&
this.dw_parque,&
this.st_16,&
this.cb_cerrar,&
this.em_fec_fin,&
this.tab_1,&
this.st_porc,&
this.st_registro,&
this.st_nro_registros,&
this.hpb_1,&
this.st_fondo}
end on

