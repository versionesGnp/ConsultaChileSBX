event clicked;Long		ll_indi,ll_tot_reg,ll_tot_reg_mitad

ll_tot_reg			= dw_print_masivo.rowcount()
ll_tot_reg_mitad	= INT(ll_tot_reg / 2)
if ll_tot_reg > 0 then
	if cb_mitad.text='Marcar 50%' then
		for ll_indi=1 to ll_tot_reg_mitad
			dw_print_masivo.setitem(ll_indi,'genera',0)
		next
