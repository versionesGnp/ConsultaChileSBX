type cb_mostrar_generar from commandbutton within tabpage_3
integer x = 997
integer y = 1392
integer width = 315
integer height = 100
integer taborder = 100
integer textsize = -9
integer weight = 400
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string text = "&Mostrar"
end type

event clicked;Datetime		ld_fec_ini,ld_fec_fin,ld_nulo,ldt_fecha_ini_mes,ldt_fecha_fin_mes
time			lt_ini=time('00:00:00'), lt_fin=time('23:59:59')
Long			ll_cod_parque,ll_tot_reg,ll_indi,ll_nulo,ll_mes,ll_year,ll_mes_sgte,&
				ll_tot_porc_aux,ll_tot_porc=0,ll_numero,ll_resp
String			ls_base,ls_fec_inicial,ls_fec_final,ls_serie

dw_parque.accepttext()
gl_cod_parque_cta								= dw_parque.getitemnumber(1,'cod_parque')
Setnull(ld_nulo);Setnull(ll_nulo)
SetPointer(HourGlass!)
tab_1.tabpage_3.dw_genera.SETfilter('')
tab_1.tabpage_3.dw_genera.filter()
tab_1.tabpage_3.dw_genera.reset()
tab_1.tabpage_3.dw_genera.object.t_marcar.text	= 'Marcar Todo'
st_porc.text											= ''
em_buscar_ctto.text								= ''
ld_fec_ini											= datetime(date(em_fec_ini.text),lt_ini)
//ld_fec_ini											= datetime(date('01/01/1900'),lt_ini)
ld_fec_fin											= datetime(date(em_fec_fin.text),lt_fin)

if trim(em_fec_ini.text)='00/00/0000' or isnull(em_fec_ini.text) then
	messagebox("Advertencia","Fecha Inicial Inválida")
	em_fec_ini.setfocus()
else
	if trim(em_fec_fin.text)='00/00/0000' or isnull(em_fec_fin.text) then
		messagebox("Advertencia","Fecha Término Inválida")
		em_fec_fin.setfocus()
	else
		if ld_fec_ini>ld_fec_fin then
			messagebox("Advertencia","Rango de Fecha Incorrecta")
			em_fec_ini.setfocus()
		else
			ll_cod_parque							= dw_parque.getitemnumber(1,'cod_parque')
			if ll_cod_parque>0 then
				ll_tot_reg							= tab_1.tabpage_3.dw_genera.retrieve(ld_fec_ini,ld_fec_fin,ll_cod_parque)
				if ll_tot_reg > 0 then
					st_fondo.visible					= true
					hpb_1.visible 					= true
					st_porc.visible 					= true
					st_nro_registros.visible		= true
					st_registro.visible				= true
					hpb_1.Position					= ll_tot_porc
					st_contar.visible				= true
					st_porc.text						= '0 %'
					st_nro_registros.text			= " de "+string(ll_tot_reg)
					for ll_indi=1 to ll_tot_reg
						tab_1.tabpage_3.dw_genera.setitem(ll_indi,'genera',1)
						ls_base						= tab_1.tabpage_3.dw_genera.getitemstring(ll_indi,'cadena_codigo')
						ls_serie						= tab_1.tabpage_3.dw_genera.getitemstring(ll_indi,'cadena_serie')
						ll_numero					= tab_1.tabpage_3.dw_genera.getitemnumber(ll_indi,'cadena_numero')
						if ls_base='L' or ls_base='A' or ls_base='P' or ls_base='R' or ls_base='D' then
							tab_1.tabpage_3.dw_genera.setitem(ll_indi,'oferta_v_fecha_m',ld_nulo)
							tab_1.tabpage_3.dw_genera.setitem(ll_indi,'oferta_v_valor_cuota_m',0)
						elseif ls_base='C' then
							tab_1.tabpage_3.dw_genera.setitem(ll_indi,'pago_oferta_fecha_prim',ld_nulo)
							tab_1.tabpage_3.dw_genera.setitem(ll_indi,'pago_oferta_valor_cuota',0)
						end if
						if rb_mantencion.checked=true then
							ll_resp					= f_contar_cupones_mant(ls_base,ls_serie,ll_numero)
							tab_1.tabpage_3.dw_genera.setitem(ll_indi,'cant_mant',ll_resp)
						end if
						if ll_tot_porc <> ll_tot_porc_aux then 
							st_porc.text				= string(ll_tot_porc)+" %"
							ll_tot_porc_aux			= ll_tot_porc
						end if
						ll_tot_porc					= (ll_indi * 100) / ll_tot_reg
						hpb_1.Position 				= ll_tot_porc
						st_contar.text				= string(ll_indi)
					next
					st_fondo.visible					= false
					hpb_1.visible 					= false
					st_porc.visible 					= false
					st_nro_registros.visible		= false
					st_registro.visible				= false
					st_contar.visible				= false
					if rb_mantencion.checked=true then
						tab_1.tabpage_3.dw_genera.SETfilter('cant_mant < 2')
						tab_1.tabpage_3.dw_genera.filter()
					end if
					tab_1.tabpage_3.dw_genera.accepttext()
					tab_1.tabpage_3.dw_genera.scrolltorow(1)
				end if
			else
				messagebox("Advertencia","Debe Seleccionar Parque")
				dw_parque.setfocus()
			end if
		end if
	end if
end if
SetPointer(Arrow!)
end event

