type st_6 from statictext within tabpage_4
integer x = 41
integer y = 28
integer width = 2569
integer height = 72
integer textsize = -10
integer weight = 400
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
long textcolor = 33554432
long backcolor = 67108864
string text = "Lista de Contratos para Imprimir Cuponera"
boolean focusrectangle = false
end type

type dw_print_masivo from datawindow within tabpage_4
integer x = 27
integer y = 108
integer width = 2907
integer height = 1252
integer taborder = 20
string title = "none"
string dataobject = "dw_contratos_imprimir_cuponera_vencer"
boolean vscrollbar = true
boolean hsplitscroll = true
borderstyle borderstyle = stylelowered!
end type

event clicked;Long		ll_tot_reg,ll_indi,ll_count
String	ls_columna,ls_filtro

if row>0 then
	il_row_print	= row
	This.SelectRow(0, FALSE)
	This.SelectRow(il_row_print, TRUE)
	gi_rut			= this.getitemnumber(il_row_print,'cadena_rut')
	if gi_rut>0 then 
		if isvalid(w_aviso_mensajes) then close(w_aviso_mensajes)
		SELECT	COUNT("MENSAJES"."FECHA_CREACION")  
		INTO 		:ll_count  
		FROM 		"MENSAJES"  
		WHERE  ( "MENSAJES"."RUT" = :gi_rut ) and
				 ( "MENSAJES"."ESTADO_GESTION" = 'A' ) AND
				 ( "MENSAJES"."SW_MENSAJE" = 'R' ) and
				 ( "MENSAJES"."FECHA_FIN" > :gdt_fec_sistema )
		USING		sqlca;
		if ll_count>0 then
			OpenWithParm(w_aviso_mensajes, "R")
		else
			SELECT	COUNT("MENSAJES"."FECHA_CREACION")  
			INTO 		:ll_count  
			FROM 		"MENSAJES"  
			WHERE  ( "MENSAJES"."BASE" = :gs_base ) and
					 ( "MENSAJES"."SERIE" = :gs_serie ) and
					 ( "MENSAJES"."NUMERO" = :gi_numero ) and
					 ( "MENSAJES"."ESTADO_GESTION" = 'A' ) AND
					 ( "MENSAJES"."SW_MENSAJE" = 'C' ) and
					 ( "MENSAJES"."FECHA_FIN" > :gdt_fec_sistema )
			USING		sqlca;
			if ll_count>0 then
				OpenWithParm(w_aviso_mensajes, "C")
			end if
		end if
	end if
else
	ls_columna	= dwo.name
	ll_tot_reg	= dw_print_masivo.rowcount()
	if ll_tot_reg>0 then
		if dw_print_masivo.object.t_marcar.text='Marcar Todo' then
			for ll_indi=1 to ll_tot_reg
				dw_print_masivo.setitem(ll_indi,'genera',0)
			next
			dw_print_masivo.object.t_marcar.text='Desmarcar Todo'
		elseif dw_print_masivo.object.t_marcar.text='Desmarcar Todo' then
			for ll_indi=1 to ll_tot_reg
				dw_print_masivo.setitem(ll_indi,'genera',1)
			next
			dw_print_masivo.object.t_marcar.text='Marcar Todo'
			cb_mitad.text								= 'Marcar 50%'
		elseif ls_columna='t_vigente' or ls_columna='t_v' then
			ls_filtro	= 'cuponeras_estado_cuponera ="V"'
			dw_print_masivo.SETfilter(ls_filtro)
			dw_print_masivo.filter()

		elseif ls_columna='t_cancelado' or ls_columna='t_c' then
			ls_filtro	= 'cuponeras_estado_cuponera ="C"'
			dw_print_masivo.SETfilter(ls_filtro)
			dw_print_masivo.filter()
			
		elseif ls_columna='t_anuladas' or ls_columna='t_a' then
			ls_filtro	= 'cuponeras_estado_cuponera ="A"'
			dw_print_masivo.SETfilter(ls_filtro)
			dw_print_masivo.filter()
		end if
	end if
end if
end event

event rowfocuschanged;if getrow()>0 then
	il_row_print	= getrow()
	This.SelectRow(0, FALSE)
	This.SelectRow(il_row_print, TRUE)
end if
end event

