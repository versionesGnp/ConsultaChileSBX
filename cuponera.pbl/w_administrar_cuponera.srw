end type

event ue_mousemove;tab_1.tabpage_1.st_8.visible				= false
tab_1.tabpage_1.st_9.visible				= false
tab_1.tabpage_6.st_help_modif.visible	= false
end event

event clicked;if tab_1.SelectedTab = 1 then
	if il_row>0 then
		gi_numero 	= tab_1.tabpage_1.dw_lista.getitemnumber(il_row,'numero')
		gs_base		= tab_1.tabpage_1.dw_lista.getitemstring(il_row,'base')
		gs_serie		= tab_1.tabpage_1.dw_lista.getitemstring(il_row,'serie')
	end if
elseif tab_1.SelectedTab = 2 then
	if il_row_detalle>0 then
		gi_numero 	= tab_1.tabpage_2.dw_detalle.getitemnumber(il_row_detalle,'cuponeras_numero')
		gs_base		= tab_1.tabpage_2.dw_detalle.getitemstring(il_row_detalle,'cuponeras_base')
		gs_serie		= tab_1.tabpage_2.dw_detalle.getitemstring(il_row_detalle,'cuponeras_serie')
	end if
elseif tab_1.SelectedTab = 3 then
	if il_row_genera>0 then
		gi_numero 	= tab_1.tabpage_3.dw_genera.getitemnumber(il_row_genera,'cadena_numero')
		gs_base		= tab_1.tabpage_3.dw_genera.getitemstring(il_row_genera,'cadena_codigo')
		gs_serie		= tab_1.tabpage_3.dw_genera.getitemstring(il_row_genera,'cadena_serie')
	end if
elseif tab_1.SelectedTab = 4 then
	if il_row_print > 0 then
		gi_numero 	= tab_1.tabpage_4.dw_print_masivo.getitemnumber(il_row_print,'cadena_numero')
		gs_base		= tab_1.tabpage_4.dw_print_masivo.getitemstring(il_row_print,'cadena_codigo')
		gs_serie		= tab_1.tabpage_4.dw_print_masivo.getitemstring(il_row_print,'cadena_serie')
	end if
elseif tab_1.SelectedTab = 5 then
	if il_row_carta > 0 then
		gi_numero 	= tab_1.tabpage_5.dw_carta.getitemnumber(il_row_carta,'cadena_mora_numero')
		gs_base		= tab_1.tabpage_5.dw_carta.getitemstring(il_row_carta,'cadena_mora_base')
		gs_serie		= tab_1.tabpage_5.dw_carta.getitemstring(il_row_carta,'cadena_mora_serie')
	end if
elseif tab_1.SelectedTab = 6 then
	if il_row_modif > 0 then
		gi_numero 	= tab_1.tabpage_6.dw_lista_modif.getitemnumber(il_row_modif,'numero')
		gs_base		= tab_1.tabpage_6.dw_lista_modif.getitemstring(il_row_modif,'base')
		gs_serie		= tab_1.tabpage_6.dw_lista_modif.getitemstring(il_row_modif,'serie')
	end if
end if
if il_row > 0 or il_row_genera > 0 or il_row_print > 0 or il_row_detalle > 0 or &
	il_row_carta > 0 or il_row_modif > 0 then
	CHOOSE CASE gs_base
		CASE "O" // Oferta
			if isvalid(w_cuenta_corriente_oferta) then close(w_cuenta_corriente_oferta)
			Open(w_cuenta_corriente_oferta)
		CASE "L" // Anexo Liberador
			if isvalid(w_cuenta_corriente_liberador) then close(w_cuenta_corriente_liberador)
			Open(w_cuenta_corriente_liberador)
		CASE "P" // Pagaré
			if isvalid(w_cuenta_corriente_pagare) then close(w_cuenta_corriente_pagare)
			Open(w_cuenta_corriente_pagare)
		CASE "C" // Contrato ISA	
			if isvalid(w_cuenta_corriente_contrato_isa) then close(w_cuenta_corriente_contrato_isa)
			Open(w_cuenta_corriente_contrato_isa)
		CASE "D" // Derecho Especial
			if isvalid(w_cuenta_corriente_derecho) then close(w_cuenta_corriente_derecho)
			Open(w_cuenta_corriente_derecho)
		CASE "R" //Repactación Ctas.Mantencion
			if isvalid(w_cuenta_corriente_repactar_cta_mant) then close(w_cuenta_corriente_repactar_cta_mant)
			Open(w_cuenta_corriente_repactar_cta_mant)
		CASE "A" // Aumento Capacidad
			if isvalid(w_cuenta_corriente_aumento_capacidad) then close(w_cuenta_corriente_aumento_capacidad)
			Open(w_cuenta_corriente_aumento_capacidad)
	END CHOOSE
end if
end event

type p_fin from picture within w_administrar_cuponera
integer x = 1641
integer y = 44
integer width = 78
integer height = 88
string picturename = "DDLB.BMP"
boolean focusrectangle = false
end type

event clicked;string ls_fecha,fech

tab_1.tabpage_1.dw_lista.reset()
tab_1.tabpage_2.dw_detalle.reset()
tab_1.tabpage_2.dw_agrupado.reset()
tab_1.tabpage_3.dw_genera.reset()
tab_1.tabpage_4.dw_print_masivo.reset()
tab_1.tabpage_5.dw_carta.reset()
tab_1.tabpage_6.dw_lista_modif.reset()
em_buscar_ctto.text	= ''
if f_valida_fecha(em_fec_fin.text)=-1 then 
	em_fec_fin.text	= string(idt_fecha_hoy,gs_formato_fecha)
	em_fec_fin.setfocus()
	return
end if	
if em_fec_fin.text<>'00/00/0000' then
	ls_fecha 			= em_fec_fin.text
else
	ls_fecha 			= string(idt_fecha_hoy,gs_formato_fecha)
end if	
OpenWithParm(w_calendar,ls_fecha)

IF Message.StringParm <> ls_fecha THEN
	IF DATE(Message.StringParm)<DATE(em_fec_ini.TEXT) THEN
		MESSAGEBOX(gs_app_name,'La fecha de final debe ser mayor a la inicial.',stopsign!)
		em_fec_fin.setfocus()
		return
	else	
		em_fec_fin.text = Message.StringParm
	end if	
END IF
end event

