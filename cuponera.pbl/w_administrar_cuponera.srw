type cb_generar_modif from commandbutton within tabpage_6
event ue_mousemove pbm_mousemove
integer x = 1655
integer y = 1392
integer width = 315
integer height = 100
integer taborder = 40
integer textsize = -9
integer weight = 400
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string text = "&Generar"
end type

event ue_mousemove;st_help_modif.visible	= false
end event

event clicked;long 		ll_fila,ll_tot_reg,ll_indi,ll_plazo,ll_rut,ll_cod_parque,ll_numero,ll_opcion,&
			ll_ctas_pag,ll_count_vig,ll_num_cuponera,ll_suma_g,ll_tot_porc_aux,ll_tot_porc=0
Double	ldb_valor_cuota,ldb_valor_cuota_mant
Datetime	ldt_fecha_prim,ldt_fec_venc_mant
String	ls_dv,ls_base,ls_serie,ls_estado_cadena,ls_moneda,ls_tipo_modifica

dw_parque.accepttext()
SetPointer(HourGlass!)
ll_suma_g								= 0
ll_tot_reg								= dw_lista_modif.rowcount()
if ll_tot_reg>0 then
	ll_cod_parque						= dw_parque.getitemnumber(1,'cod_parque')
	ll_fila								= dw_lista_modif.Find("estado = 0", 1, ll_tot_reg)
	if ll_fila>0 then
		st_fondo.visible				= true
		hpb_1.visible 					= true
		st_porc.visible 				= true
		st_nro_registros.visible	= true
		st_registro.visible			= true
		st_contar.visible				= true
		st_porc.text					= '0 %'
		hpb_1.Position					= ll_tot_porc
		st_nro_registros.text		= " de "+string(ll_tot_reg)
//		cb_pagos.triggerevent(clicked!)
		for ll_indi = ll_fila to ll_tot_reg
			ll_opcion					= dw_lista_modif.getitemnumber(ll_indi,'estado')
			if ll_opcion=0 then
				ls_base					= dw_lista_modif.getitemstring(ll_indi,'base')
				ls_serie					= dw_lista_modif.getitemstring(ll_indi,'serie')
				ll_numero				= dw_lista_modif.getitemnumber(ll_indi,'numero')
				ll_plazo					= dw_lista_modif.getitemnumber(ll_indi,'plazo')
				ll_rut					= dw_lista_modif.getitemnumber(ll_indi,'rut')
				ldb_valor_cuota		= dw_lista_modif.getitemnumber(ll_indi,'valor_cuota_cred')
				ldt_fecha_prim			= dw_lista_modif.getitemdatetime(ll_indi,'fecha_prim')
				ls_tipo_modifica		= dw_lista_modif.getitemstring(ll_indi,'cuponeras_modifica_tipo_modificacion')
				SELECT	"CADENA_MORA"."FECHA_VENC_MANT"  
				INTO 		:ldt_fec_venc_mant  
				FROM 		"CADENA_MORA"  
				WHERE  ( "CADENA_MORA"."BASE" = :ls_base ) AND  
						 ( "CADENA_MORA"."SERIE" = :ls_serie ) AND  
						 ( "CADENA_MORA"."NUMERO" = :ll_numero )   
				USING		sqlca;
				ldb_valor_cuota_mant	= dw_lista_modif.getitemnumber(ll_indi,'valor_cuota_mant')
				ls_dv						= dw_lista_modif.getitemstring(ll_indi,'dv')
				ls_estado_cadena		= dw_lista_modif.getitemstring(ll_indi,'cadena_estado')
				ls_moneda				= dw_lista_modif.getitemstring(ll_indi,'moneda')
				SELECT	"CUPONERAS"."NUMERO"  
				INTO 		:ll_count_vig  
				FROM 		"CUPONERAS"  
				WHERE  ( "CUPONERAS"."BASE" = :ls_base ) AND  
						 ( "CUPONERAS"."SERIE" = :ls_serie ) AND  
						 ( "CUPONERAS"."NUMERO" = :ll_numero ) AND  
						 ( "CUPONERAS"."ESTADO_CUPONERA" = 'V' )   
				using		SQLCA;
				if sqlca.sqlcode = 0 then
					if ls_estado_cadena='V' then
						DECLARE sp_proc_modifica_cuponera PROCEDURE FOR SP_MODIFICAR_CUPONERA( :ls_base, :ls_serie, :ll_numero, :ll_plazo, :gs_user, :ll_rut, :ldb_valor_cuota, :ldb_valor_cuota_mant, :ls_dv, :ll_cod_parque, :ldt_fecha_prim, :ldt_fec_venc_mant, :ls_moneda, :ls_tipo_modifica );
						EXECUTE sp_proc_modifica_cuponera;
						ll_suma_g ++
					end if
				end if
			end if
			if ll_tot_porc <> ll_tot_porc_aux then 
				st_porc.text			= string(ll_tot_porc)+" %"
				ll_tot_porc_aux		= ll_tot_porc
			end if
			ll_tot_porc					= (ll_indi * 100) / ll_tot_reg
			hpb_1.Position 			= ll_tot_porc
			st_contar.text				= string(ll_indi)
		next
		st_fondo.visible				= false
		hpb_1.visible 					= false
		st_porc.visible 				= false
		st_nro_registros.visible	= false
		st_registro.visible			= false
		st_contar.visible				= false
		if ll_suma_g > 0 then
			messagebox("Grabar","Grabación Exitosa")
		end if
		cb_mostrar_modif.triggerevent(clicked!)
		dw_lista_modif.setfocus()
	else
		messagebox("Advertencia","Debe Seleccionar por lo menos UN Contrato")
	end if
end if
SetPointer(Arrow!)
end event

