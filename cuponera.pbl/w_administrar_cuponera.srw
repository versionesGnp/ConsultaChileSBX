this.st_11=create st_11
this.cb_ctacte=create cb_ctacte
this.p_fin=create p_fin
this.st_3=create st_3
this.p_ini=create p_ini
this.em_fec_ini=create em_fec_ini
this.st_2=create st_2
this.pb_ok=create pb_ok
this.dw_parque=create dw_parque
this.st_16=create st_16
this.cb_cerrar=create cb_cerrar
this.em_fec_fin=create em_fec_fin
this.tab_1=create tab_1
this.st_porc=create st_porc
this.st_registro=create st_registro
this.st_nro_registros=create st_nro_registros
this.hpb_1=create hpb_1
this.st_fondo=create st_fondo
this.Control[]={this.dw_mecanizado,&
this.cb_mecanizado,&
this.dw_base,&
this.cb_1,&
this.st_contar,&
this.cb_pagos,&
this.pb_buscar,&
