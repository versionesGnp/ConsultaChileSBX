table(column=(type=decimal(4) updatewhereclause=yes name=carta_log_cod_accion dbname="carta_log.cod_accion" )
 column=(type=char(1) updatewhereclause=yes name=cadena_codigo dbname="cadena.codigo" )
 column=(type=char(1) updatewhereclause=yes name=cadena_serie dbname="cadena.serie" )
 column=(type=decimal(4) updatewhereclause=yes name=cadena_numero dbname="cadena.numero" )
 column=(type=decimal(4) updatewhereclause=yes name=factura_pagare_plazo dbname="factura_pagare.plazo" )
 column=(type=decimal(4) updatewhereclause=yes name=factura_pagare_ctas_pag dbname="factura_pagare.ctas_pag" )
 column=(type=datetime updatewhereclause=yes name=pagare_fecha_prim dbname="pagare.fecha_prim" )
 column=(type=decimal(4) updatewhereclause=yes name=pagare_plazo dbname="pagare.plazo" )
 column=(type=decimal(5) updatewhereclause=yes name=cuotas_pag dbname="compute_0009" )
 column=(type=decimal(5) updatewhereclause=yes name=linea_estado dbname="compute_0010" values="	0/	1" )
 column=(type=datetime updatewhereclause=yes name=pagare_fecha dbname="pagare.fecha" )
 column=(type=decimal(4) updatewhereclause=yes name=cadena_mora_mora_cred dbname="cadena_mora.mora_cred" )
 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"cadena~" )  TABLE(NAME=~"cliente~" )  TABLE(NAME=~"carta_log~" )  TABLE(NAME=~"pagare~" )  TABLE(NAME=~"factura_pagare~" )  TABLE(NAME=~"cadena_mora~" ) COLUMN(NAME=~"carta_log.cod_accion~") COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"cadena.serie~") COLUMN(NAME=~"cadena.numero~") COLUMN(NAME=~"factura_pagare.plazo~") COLUMN(NAME=~"factura_pagare.ctas_pag~") COLUMN(NAME=~"pagare.fecha_prim~") COLUMN(NAME=~"pagare.plazo~") COMPUTE(NAME=~"0,~~~"PAGARE~~~".~~~"CTA_PAG_LA~~~"+~~~"PAGARE~~~".~~~"CTA_PAG_ISA~~~"~") COLUMN(NAME=~"pagare.fecha~") COLUMN(NAME=~"cadena_mora.mora_cred~")    JOIN (LEFT=~"cadena.rut~"    OP =~"=~"RIGHT=~"cliente.rut~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"carta_log.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"carta_log.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"carta_log.numero~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"pagare.serie_p~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"pagare.nro_pagare~" )    JOIN (LEFT=~"factura_pagare.base~"    OP =~"=~"RIGHT=~"cadena.codigo~" )    JOIN (LEFT=~"factura_pagare.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"factura_pagare.numero~"    OP =~"=~"RIGHT=~"cadena.numero~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"cadena_mora.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"cadena_mora.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"cadena_mora.numero~" )WHERE(    EXP1 =~"~~~"FACTURA_PAGARE~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'N'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FACTURA_PAGARE~~~".~~~"FECHA_CIERRE~~~"~"   OP =~"=~" NEST = PBSELECT( VERSION(400) TABLE(NAME=~"factura_pagare~" ) COMPUTE(NAME=~"MAX(~~~"FACTURA_PAGARE~~~".~~~"FECHA_CIERRE~~~")~"))   LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'V'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CLIENTE~~~".~~~"DIRECCION_P~~~"~"   OP =~"<>~"    EXP2 =~"'-'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FACTURA_PAGARE~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~"'P'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FACTURA_PAGARE~~~".~~~"CTAS_PAG~~~"~"   OP =~"<~"    EXP2 =~"~~~"FACTURA_PAGARE~~~".~~~"PLAZO~~~"~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"EST_CUP~~~"~"   OP =~"=~"    EXP2 =~"0~" ) ) "  sort="carta_log_cod_accion A " )
