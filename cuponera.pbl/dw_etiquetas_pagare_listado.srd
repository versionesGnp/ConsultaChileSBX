 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cliente~" )  TABLE(NAME=~"etiquetas~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"pagare~" )  TABLE(NAME=~"ciudad~" )  TABLE(NAME=~"comuna~" )  TABLE(NAME=~"tipo_via~" ) COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cliente.direccion_p~") COLUMN(NAME=~"cliente.poblacion~") COLUMN(NAME=~"cliente.sector~") COLUMN(NAME=~"cliente.comuna~") COLUMN(NAME=~"cliente.ciudad~") COLUMN(NAME=~"etiquetas.serie~") COLUMN(NAME=~"etiquetas.numero~") COLUMN(NAME=~"etiquetas.correlativo~") COLUMN(NAME=~"comuna.comuna~") COLUMN(NAME=~"ciudad.ciudad~") COLUMN(NAME=~"cliente.tipo_via~") COLUMN(NAME=~"cliente.numero_particular~") COLUMN(NAME=~"cliente.depto_particular~") COLUMN(NAME=~"cliente.block_particular~") COLUMN(NAME=~"tipo_via.descripcion~") COMPUTE(NAME=~"''~") COLUMN(NAME=~"cliente.fono_p~") COLUMN(NAME=~"cliente.fono_c~")    JOIN (LEFT=~"pagare.serie_p~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"pagare.nro_pagare~"    OP =~"=~"RIGHT=~"cadena.numero~" )    JOIN (LEFT=~"etiquetas.serie~"    OP =~"=~"RIGHT=~"pagare.serie_p~" )    JOIN (LEFT=~"etiquetas.numero~"    OP =~"=~"RIGHT=~"pagare.nro_pagare~" )    JOIN (LEFT=~"cliente.rut~"    OP =~"=~"RIGHT=~"pagare.rut~" )    JOIN (LEFT=~"cliente.comuna~"    OP =~"=~"RIGHT=~"comuna.codigo_comuna~" )    JOIN (LEFT=~"cliente.ciudad~"    OP =~"=~"RIGHT=~"ciudad.codigo_ciudad~" )    JOIN (LEFT=~"cliente.tipo_via~"    OP =~"=~"RIGHT=~"tipo_via.tipo_via~" )WHERE(    EXP1 =~"( ( ~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'P' ) )~" ) ) " )
