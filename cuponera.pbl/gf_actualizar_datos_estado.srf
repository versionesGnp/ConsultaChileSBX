global type gf_actualizar_datos_estado from function_object
end type

forward prototypes
global function integer gf_actualizar_datos_estado (string estado)
end prototypes

global function integer gf_actualizar_datos_estado (string estado);
UPDATE "CUPON" SET "CUPON"."ESTADO" = :estado WHERE "CUPON"."USUARIO" = :gs_user using sqlca;
if sqlca.sqlcode = 0 then
	commit;
else
	rollback;
end if

RETURN 0
end function

