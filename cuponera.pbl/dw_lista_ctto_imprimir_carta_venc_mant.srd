 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cadena_mora~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"cliente~" )  TABLE(NAME=~"cuponeras~" )  TABLE(NAME=~"cuponeras_detalle~" )  TABLE(NAME=~"ciudad~" )  TABLE(NAME=~"comuna~" )  TABLE(NAME=~"tipo_via~" ) COLUMN(NAME=~"cadena_mora.base~") COLUMN(NAME=~"cadena_mora.serie~") COLUMN(NAME=~"cadena_mora.numero~") COLUMN(NAME=~"cadena_mora.fecha_venc_mant~") COLUMN(NAME=~"cadena_mora.mora_mant~") COLUMN(NAME=~"cadena_mora.dias_mora_mant~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"cadena.cod_parque~") COMPUTE(NAME=~"0~") COLUMN(NAME=~"cadena_mora.mora_cred~") COLUMN(NAME=~"cadena_mora.dias_mora_cred~") COLUMN(NAME=~"cadena_mora.fecha_venc_cred~") COLUMN(NAME=~"cadena_mora.fallecidos~") COLUMN(NAME=~"cadena_mora.plazo~") COLUMN(NAME=~"cadena.rut~") COLUMN(NAME=~"cadena_mora.valor_cuota_mant~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"cliente.comuna~") COLUMN(NAME=~"cliente.ciudad~")    JOIN (LEFT=~"cadena.rut~"    OP =~"=~"RIGHT=~"cliente.rut~" )    JOIN (LEFT=~"cuponeras_detalle.base~"    OP =~"=~"RIGHT=~"cuponeras.base~" )    JOIN (LEFT=~"cuponeras_detalle.serie~"    OP =~"=~"RIGHT=~"cuponeras.serie~" )    JOIN (LEFT=~"cuponeras_detalle.numero~"    OP =~"=~"RIGHT=~"cuponeras.numero~" )    JOIN (LEFT=~"cuponeras_detalle.nro_cuponera~"    OP =~"=~"RIGHT=~"cuponeras.nro_cuponera~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"cuponeras.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"cuponeras.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"cuponeras.numero~" )    JOIN (LEFT=~"cliente.tipo_via~"    OP =~"=~"RIGHT=~"tipo_via.tipo_via~" )    JOIN (LEFT=~"cliente.comuna~"    OP =~"=~"RIGHT=~"comuna.codigo_comuna~" )    JOIN (LEFT=~"cliente.ciudad~"    OP =~"=~"RIGHT=~"ciudad.codigo_ciudad~" )    JOIN (LEFT=~"cadena_mora.base~"    OP =~"=~"RIGHT=~"cuponeras.base~" )    JOIN (LEFT=~"cadena_mora.serie~"    OP =~"=~"RIGHT=~"cuponeras.serie~" )    JOIN (LEFT=~"cadena_mora.numero~"    OP =~"=~"RIGHT=~"cuponeras.numero~" )WHERE(    EXP1 =~"~~~"CADENA_MORA~~~".~~~"FECHA_VENC_MANT~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CADENA_MORA~~~".~~~"FECHA_VENC_MANT~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CUPONERAS_DETALLE~~~".~~~"FECHA_VENC~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CUPONERAS_DETALLE~~~".~~~"FECHA_VENC~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(((~~~"CADENA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'C'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'V')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'C')~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"(~~~"CADENA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'C'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'O'))~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CUPONERAS_DETALLE~~~".~~~"ESTADO_PAGO_CUPON~~~"~"   OP =~"=~"    EXP2 =~"'V'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CUPONERAS_DETALLE~~~".~~~"TIPO_MOV~~~"~"   OP =~"=~"    EXP2 =~"'F'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA_MORA~~~".~~~"MORA_MANT~~~"~"   OP =~"=~"    EXP2 =~"0~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA_MORA~~~".~~~"MORA_CRED~~~"~"   OP =~"<=~"    EXP2 =~"3~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = datetime)  ARG(NAME = ~"fecha_fin~" TYPE = datetime)  ARG(NAME = ~"parque~" TYPE = number) " arguments=(("fecha_ini", datetime),("fecha_fin", datetime),("parque", number))  sort="c_num_ciudad D c_num_comuna A cadena_mora_numero A " )
