 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cliente~" )  TABLE(NAME=~"etiquetas~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"cliente_contacto~" )  TABLE(NAME=~"anexo_aumento~" )  TABLE(NAME=~"pago_aumento~" ) COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cliente.direccion_p~") COLUMN(NAME=~"cliente.comuna~") COLUMN(NAME=~"cliente.sector~") COLUMN(NAME=~"cadena.est_cup~") COLUMN(NAME=~"etiquetas.correlativo~") COLUMN(NAME=~"cliente_contacto.nombre~") COLUMN(NAME=~"cliente_contacto.a_paterno~") COLUMN(NAME=~"cliente_contacto.a_materno~") COLUMN(NAME=~"cliente_contacto.direccion_p~") COLUMN(NAME=~"cliente_contacto.sector~") COLUMN(NAME=~"cliente_contacto.comuna~") COLUMN(NAME=~"cliente_contacto.rut~") COLUMN(NAME=~"cliente.poblacion~") COLUMN(NAME=~"cliente.tipo_via~") COLUMN(NAME=~"cliente.numero_particular~") COLUMN(NAME=~"cliente.depto_particular~") COLUMN(NAME=~"cliente.block_particular~") COLUMN(NAME=~"anexo_aumento.serie_m~") COLUMN(NAME=~"anexo_aumento.nro_aumento~")    JOIN (LEFT=~"cliente.rut_contacto~"    OP =~"=~"RIGHT=~"cliente_contacto.rut~"    OUTER1 =~"cliente.rut_contacto~" )    JOIN (LEFT=~"etiquetas.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"etiquetas.numero~"    OP =~"=~"RIGHT=~"cadena.numero~" )    JOIN (LEFT=~"cliente.rut~"    OP =~"=~"RIGHT=~"cadena.rut~" )    JOIN (LEFT=~"anexo_aumento.serie_m~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"anexo_aumento.nro_aumento~"    OP =~"=~"RIGHT=~"cadena.numero~" )    JOIN (LEFT=~"anexo_aumento.rut~"    OP =~"=~"RIGHT=~"cadena.rut~" )    JOIN (LEFT=~"anexo_aumento.serie_m~"    OP =~"=~"RIGHT=~"pago_aumento.serie_m~" )    JOIN (LEFT=~"anexo_aumento.nro_aumento~"    OP =~"=~"RIGHT=~"pago_aumento.nro_aumento~" )    JOIN (LEFT=~"anexo_aumento.ult_folio~"    OP =~"=~"RIGHT=~"pago_aumento.folio~" )WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'A'~" ) ) "  sort="etiquetas_correlativo A " )
