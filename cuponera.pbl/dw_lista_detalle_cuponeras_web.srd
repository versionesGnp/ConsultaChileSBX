 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cuponeras_detalle_web~" ) COLUMN(NAME=~"cuponeras_detalle_web.nro_cupon~") COLUMN(NAME=~"cuponeras_detalle_web.tipo_mov~") COLUMN(NAME=~"cuponeras_detalle_web.nro_cuota~") COLUMN(NAME=~"cuponeras_detalle_web.estado_pago_cupon~") COLUMN(NAME=~"cuponeras_detalle_web.monto_cuota_contrato~") COLUMN(NAME=~"cuponeras_detalle_web.fecha_venc~") COLUMN(NAME=~"cuponeras_detalle_web.tipo_moneda~")WHERE(    EXP1 =~"~~~"CUPONERAS_DETALLE_WEB~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CUPONERAS_DETALLE_WEB~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CUPONERAS_DETALLE_WEB~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CUPONERAS_DETALLE_WEB~~~".~~~"ESTADO_PAGO_CUPON~~~"~"   OP =~"<>~"    EXP2 =~"'A'~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number) " arguments=(("base", string),("serie", string),("numero", number))  sort="nro_cupon D " )
