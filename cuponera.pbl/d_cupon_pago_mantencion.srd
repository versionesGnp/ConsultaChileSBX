table(column=(type=char(1) updatewhereclause=yes name=codigo dbname="tem_cupon.codigo" )
 column=(type=char(1) updatewhereclause=yes name=serie dbname="tem_cupon.serie" )
 column=(type=decimal(4) updatewhereclause=yes name=numero dbname="tem_cupon.numero" )
 column=(type=char(50) updatewhereclause=yes name=nombre dbname="tem_cupon.nombre" )
 column=(type=decimal(4) updatewhereclause=yes name=oferta_v_valor_cuota_m dbname="oferta_v.valor_cuota_m" )
 column=(type=datetime updatewhereclause=yes name=oferta_v_fecha_m dbname="oferta_v.fecha_m" )
 column=(type=decimal(4) updatewhereclause=yes name=tem_cupon_lugar dbname="tem_cupon.lugar" )
 column=(type=datetime updatewhereclause=yes name=pago_oferta_fecha_prim dbname="pago_oferta.fecha_prim" )
 column=(type=decimal(4) updatewhereclause=yes name=pago_oferta_nro_cuotas dbname="pago_oferta.nro_cuotas" )
 column=(type=decimal(4) updatewhereclause=yes name=oferta_v_cta_pag_m dbname="oferta_v.cta_pag_m" )
 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"tem_cupon~" )  TABLE(NAME=~"oferta_v~" )  TABLE(NAME=~"pago_oferta~" ) COLUMN(NAME=~"tem_cupon.codigo~") COLUMN(NAME=~"tem_cupon.serie~") COLUMN(NAME=~"tem_cupon.numero~") COLUMN(NAME=~"tem_cupon.nombre~") COLUMN(NAME=~"oferta_v.valor_cuota_m~") COLUMN(NAME=~"oferta_v.fecha_m~") COLUMN(NAME=~"tem_cupon.lugar~") COLUMN(NAME=~"pago_oferta.fecha_prim~") COLUMN(NAME=~"pago_oferta.nro_cuotas~") COLUMN(NAME=~"oferta_v.cta_pag_m~")    JOIN (LEFT=~"tem_cupon.serie~"    OP =~"=~"RIGHT=~"oferta_v.serie~" )    JOIN (LEFT=~"tem_cupon.numero~"    OP =~"=~"RIGHT=~"oferta_v.nro_oferta~" )    JOIN (LEFT=~"oferta_v.serie~"    OP =~"=~"RIGHT=~"pago_oferta.serie~" )    JOIN (LEFT=~"oferta_v.nro_oferta~"    OP =~"=~"RIGHT=~"pago_oferta.nro_oferta~" )    JOIN (LEFT=~"oferta_v.ult_folio~"    OP =~"=~"RIGHT=~"pago_oferta.folio~" )WHERE(    EXP1 =~"( ( :parque~"   OP =~"=~"    EXP2 =~":parque ) )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"TEM_CUPON~~~".~~~"LUGAR~~~"~"   OP =~">~"    EXP2 =~"0~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"TEM_CUPON~~~".~~~"USUARIO~~~"~"   OP =~"=~"    EXP2 =~":usuario~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"OFERTA_V~~~".~~~"CTA_PAG_M~~~"~"   OP =~"<~"    EXP2 =~"99~" ) ) ORDER(NAME=~"tem_cupon.lugar~" ASC=yes ) ARG(NAME = ~"parque~" TYPE = string)  ARG(NAME = ~"usuario~" TYPE = string) " arguments=(("parque", string),("usuario", string)) )
