compute(band=detail alignment="3" expression="if (cuota_atra=0 and oferta_v_cta_pag_m>0,'Sr(a): '+nombre+'~~rRecuerde que la Mantención anual de su Contrato '+ serie +' ' +  String(numero , ~"###,###,###~")+' vence el mes de '+IF(month(  oferta_v_fecha_m  )=1,'Enero',IF(month(  oferta_v_fecha_m  )=2,'Febrero',IF(month(  oferta_v_fecha_m  )=3,'Marzo',IF(month(  oferta_v_fecha_m  )=4,'Abril',IF(month(  oferta_v_fecha_m  )=5,'Mayo',IF(month(  oferta_v_fecha_m  )=6,'Junio',IF(month(  oferta_v_fecha_m  )=7,'Julio',IF(month(  oferta_v_fecha_m  )=8,'Agosto',IF(month(  oferta_v_fecha_m  )=9,'Septiembre',IF(month(  oferta_v_fecha_m  )=10,'Octubre',IF(month(  oferta_v_fecha_m  )=11,'Noviembre','Diciembre')))))))))))+' de cada año y su valor será de '+oferta_v_valor_cuota_m+ ' U.F. y debe ser cancelada exclusivamente en las oficinas del Parque o Estado 360 piso 2 Santiago.'  ,    'Sr(a): '+nombre+'~~rRecuerde que la Mantención anual de su Contrato '+ serie +' ' +  String(numero , ~"###,###,###~")+' vence el mes de '+IF(month(  oferta_v_fecha_m  )=1,'Enero',IF(month(  oferta_v_fecha_m  )=2,'Febrero',IF(month(  oferta_v_fecha_m  )=3,'Marzo',IF(month(  oferta_v_fecha_m  )=4,'Abril',IF(month(  oferta_v_fecha_m  )=5,'Mayo',IF(month(  oferta_v_fecha_m  )=6,'Junio',IF(month(  oferta_v_fecha_m  )=7,'Julio',IF(month(  oferta_v_fecha_m  )=8,'Agosto',IF(month(  oferta_v_fecha_m  )=9,'Septiembre',IF(month(  oferta_v_fecha_m  )=10,'Octubre',IF(month(  oferta_v_fecha_m  )=11,'Noviembre','Diciembre')))))))))))+' de cada año y su valor es de '+oferta_v_valor_cuota_m+ ' U.F. y debe ser cancelada exclusivamente en las oficinas del Parque o Estado 360 piso 2 Santiago.')"border="0" color="0" x="91" y="176" height="324" width="1486" format="[General]" html.valueishtml="0"  name=texto1 visible="1"  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" background.transparency="0" background.gradient.colo