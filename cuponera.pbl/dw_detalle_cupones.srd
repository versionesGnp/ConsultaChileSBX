 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"estadistica_cupon~" ) COLUMN(NAME=~"estadistica_cupon.base~") COLUMN(NAME=~"estadistica_cupon.serie~") COLUMN(NAME=~"estadistica_cupon.numero~") COLUMN(NAME=~"estadistica_cupon.usuario~") COLUMN(NAME=~"estadistica_cupon.nro_cupon~") COLUMN(NAME=~"estadistica_cupon.fecha_cupon~") COLUMN(NAME=~"estadistica_cupon.nro_cuota~") COLUMN(NAME=~"estadistica_cupon.ult_folio~") COLUMN(NAME=~"estadistica_cupon.ult_tipo_cob~") COLUMN(NAME=~"estadistica_cupon.ult_fecha_pago~") COLUMN(NAME=~"estadistica_cupon.det_cuota_pag~") COLUMN(NAME=~"estadistica_cupon.del_plazo~") COLUMN(NAME=~"estadistica_cupon.del_total_cuota~") COLUMN(NAME=~"estadistica_cupon.mora~") COLUMN(NAME=~"estadistica_cupon.estado~") COMPUTE(NAME=~"0~") COLUMN(NAME=~"estadistica_cupon.cod_parque~")WHERE(    EXP1 =~"~~~"ESTADISTICA_CUPON~~~".~~~"USUARIO~~~"~"   OP =~"=~"    EXP2 =~":usuario~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"ESTADISTICA_CUPON~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":cod_parque~" ) ) ARG(NAME = ~"usuario~" TYPE = string)  ARG(NAME = ~"cod_parque~" TYPE = number) " arguments=(("usuario", string),("cod_parque", number))  sort="numero A " )
