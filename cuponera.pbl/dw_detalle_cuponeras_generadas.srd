COLUMN(NAME=~"cuponeras_detalle.numero_asoc~")    JOIN (LEFT=~"cuponeras_detalle.base~"    OP =~"=~"RIGHT=~"cuponeras.base~" )    JOIN (LEFT=~"cuponeras_detalle.serie~"    OP =~"=~"RIGHT=~"cuponeras.serie~" )    JOIN (LEFT=~"cuponeras_detalle.numero~"    OP =~"=~"RIGHT=~"cuponeras.numero~" )    JOIN (LEFT=~"cuponeras_detalle.nro_cuponera~"    OP =~"=~"RIGHT=~"cuponeras.nro_cuponera~" )    JOIN (LEFT=~"cuponeras_detalle.rut~"    OP =~"=~"RIGHT=~"cliente.rut~" )    JOIN (LEFT=~"cliente.tipo_via~"    OP =~"=~"RIGHT=~"tipo_via.tipo_via~" )    JOIN (LEFT=~"cliente.comuna~"    OP =~"=~"RIGHT=~"comuna.codigo_comuna~" )    JOIN (LEFT=~"cliente.ciudad~"    OP =~"=~"RIGHT=~"ciudad.codigo_ciudad~" )WHERE(    EXP1 =~"~~~"CUPONERAS~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CUPONERAS~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CUPONERAS~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CUPONERAS~~~".~~~"NRO_CUPONERA~~~"~"   OP =~"=~"    EXP2 =~":nro_cuponera~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number)  ARG(NAME = ~"nro_cuponera~" TYPE = number) " update="CUPONERAS_DETALLE" updatewhere=0 updatekeyinplace=yes arguments=(("base", string),("serie", string),("numero", number),("nro_cuponera", number))  sort="cuponeras_detalle_tipo_mov A cuponeras_detalle_nro_cuota A " )
