 column=(type=decimal(4) updatewhereclause=yes name=tem_cupon_lugar dbname="tem_cupon.lugar" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"tem_cupon~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"cadena_mora~" ) COLUMN(NAME=~"tem_cupon.num_cup~") COLUMN(NAME=~"tem_cupon.codigo~") COLUMN(NAME=~"tem_cupon.serie~") COLUMN(NAME=~"tem_cupon.numero~") COLUMN(NAME=~"tem_cupon.barra~") COLUMN(NAME=~"tem_cupon.nombre~") COLUMN(NAME=~"tem_cupon.rut~") COLUMN(NAME=~"tem_cupon.dv~") COLUMN(NAME=~"tem_cupon.nro_cuota~") COLUMN(NAME=~"tem_cupon.tot_cuota~") COLUMN(NAME=~"tem_cupon.fecha_pago~") COLUMN(NAME=~"tem_cupon.valor_cuota~") COLUMN(NAME=~"tem_cupon.moneda~") COLUMN(NAME=~"tem_cupon.aux~") COLUMN(NAME=~"cadena.cod_parque~") COLUMN(NAME=~"tem_cupon.tipo_mov~") COLUMN(NAME=~"cadena_mora.valor_cuota_mant~") COLUMN(NAME=~"cadena_mora.fecha_venc_mant~") COLUMN(NAME=~"tem_cupon.lugar~")    JOIN (LEFT=~"tem_cupon.codigo~"    OP =~"=~"RIGHT=~"cadena.codigo~"    OUTER1 =~"tem_cupon.codigo~" )    JOIN (LEFT=~"tem_cupon.serie~"    OP =~"=~"RIGHT=~"cadena.serie~"    OUTER1 =~"tem_cupon.serie~" )    JOIN (LEFT=~"tem_cupon.numero~"    OP =~"=~"RIGHT=~"cadena.numero~"    OUTER1 =~"tem_cupon.numero~" )    JOIN (LEFT=~"tem_cupon.codigo~"    OP =~"=~"RIGHT=~"cadena_mora.base~"    OUTER1 =~"tem_cupon.codigo~" )    JOIN (LEFT=~"tem_cupon.serie~"    OP =~"=~"RIGHT=~"cadena_mora.serie~"    OUTER1 =~"tem_cupon.serie~" )    JOIN (LEFT=~"tem_cupon.numero~"    OP =~"=~"RIGHT=~"cadena_mora.numero~"    OUTER1 =~"tem_cupon.numero~" )WHERE(    EXP1 =~":parque~"   OP =~"=~"    EXP2 =~":parque~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"TEM_CUPON~~~".~~~"USUARIO~~~"~"   OP =~"=~"    EXP2 =~":usuario~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"TEM_CUPON~~~".~~~"IP_PRINT~~~"~"   OP =~"=~"    EXP2 =~":ip~" ) ) ORDER(NAME=~"tem_cupon.aux~" ASC=yes ) ARG(NAME = ~"parque~" TYPE = string)  ARG(NAME = ~"usuario~" TYPE = string)  ARG(NAME = ~"ip~" TYPE = string) " arguments=(("parque", string),("usuario", string),("ip", string))  sort="aux A tem_cupon_lugar A " )
