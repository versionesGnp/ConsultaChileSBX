 column=(type=char(10) updatewhereclause=yes name=barra dbname="tem_cupon.barra" )
 column=(type=char(80) updatewhereclause=yes name=nombre dbname="tem_cupon.nombre" )
 column=(type=decimal(4) updatewhereclause=yes name=rut dbname="tem_cupon.rut" )
