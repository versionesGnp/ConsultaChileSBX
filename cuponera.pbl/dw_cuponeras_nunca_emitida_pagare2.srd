 column=(type=decimal(0) updatewhereclause=yes name=pagare_cta_pag_isa dbname="pagare.cta_pag_isa" )
 column=(type=decimal(4) updatewhereclause=yes name=cadena_mora_mora_cred dbname="cadena_mora.mora_cred" )
 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"cadena~" )  TABLE(NAME=~"cliente~" )  TABLE(NAME=~"pagare~" )  TABLE(NAME=~"cadena_mora~" ) COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"cadena.serie~") COLUMN(NAME=~"cadena.numero~") COLUMN(NAME=~"pagare.fecha_prim~") COLUMN(NAME=~"pagare.plazo~") COLUMN(NAME=~"pagare.fecha~") COMPUTE(NAME=~"0~") COLUMN(NAME=~"pagare.cta_pag_la~") COLUMN(NAME=~"pagare.cta_pag_isa~") COLUMN(NAME=~"cadena_mora.mora_cred~")    JOIN (LEFT=~"cadena.rut~"    OP =~"=~"RIGHT=~"cliente.rut~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"pagare.serie_p~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"pagare.nro_pagare~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"cadena_mora.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"cadena_mora.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"cadena_mora.numero~" )WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'V'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CLIENTE~~~".~~~"DIRECCION_P~~~"~"   OP =~"<>~"    EXP2 =~"'-'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'P'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"EST_CUP~~~"~"   OP =~"=~"    EXP2 =~"0~" ) ) "  sort="cadena_codigo A cadena_serie A cadena_numero A " )
