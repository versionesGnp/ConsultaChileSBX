 column=(type=decimal(4) updatewhereclause=yes name=cadena_cod_parque dbname="cadena.cod_parque" )
 column=(type=char(1) updatewhereclause=yes name=tem_cupon_tipo_mov dbname="tem_cupon.tipo_mov" )
 column=(type=decimal(4) updatewhereclause=yes name=cadena_mora_valor_cuota_mant dbname="cadena_mora.valor_cuota_mant" )
 column=(type=datetime updatewhereclause=yes name=cadena_mora_fecha_venc_mant dbname="cadena_mora.fecha_venc_mant" )
 column=(type=char(40) updatewhereclause=yes name=cliente_nombre dbname="cliente.nombre" )
 column=(type=char(40) updatewhereclause=yes name=cliente_a_paterno dbname="cliente.a_paterno" )
 column=(type=char(40) updatewhereclause=yes name=cliente_a_materno dbname="cliente.a_materno" )
 column=(type=char(60) updatewhereclause=yes name=cliente_direccion_p dbname="cliente.direccion_p" )
 column=(type=char(60) updatewhereclause=yes name=cliente_poblacion dbname="cliente.poblacion" )
 column=(type=char(60) updatewhereclause=yes name=cliente_sector dbname="cliente.sector" )
 column=(type=char(15) updatewhereclause=yes name=cliente_numero_particular dbname="cliente.numero_particular" )
 column=(type=char(15) updatewhereclause=yes name=cliente_depto_particular dbname="cliente.depto_particular" )
 column=(type=char(15) updatewhereclause=yes name=cliente_block_particular dbname="cliente.block_particular" )
 column=(type=char(90) updatewhereclause=yes name=comuna_comuna dbname="comuna.comuna" )
 column=(type=char(90) updatewhereclause=yes name=ciudad_ciudad dbname="ciudad.ciudad" )
 column=(type=char(100) updatewhereclause=yes name=tipo_via_descripcion dbname="tipo_via.descripcion" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"tem_cupon~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"cadena_mora~" )  TABLE(NAME=~"cliente~" )  TABLE(NAME=~"ciudad~" )  TABLE(NAME=~"comuna~" )  TABLE(NAME=~"tipo_via~" ) COLUMN(NAME=~"tem_cupon.num_cup~") COLUMN(NAME=~"tem_cupon.codigo~") COLUMN(NAME=~"tem_cupon.serie~") COLUMN(NAME=~"tem_cupon.numero~") COLUMN(NAME=~"tem_cupon.barra~") COLUMN(NAME=~"tem_cupon.nombre~") COLUMN(NAME=~"tem_cupon.rut~") COLUMN(NAME=~"tem_cupon.dv~") COLUMN(NAME=~"tem_cupon.nro_cuota~") COLUMN(NAME=~"tem_cupon.tot_cuota~") COLUMN(NAME=~"tem_cupon.fecha_pago~") COLUMN(NAME=~"tem_cupon.valor_cuota~") COLUMN(NAME=~"tem_cupon.moneda~") COLUMN(NAME=~"tem_cupon.aux~") COLUMN(NAME=~"cadena.cod_parque~") COLUMN(NAME=~"tem_cupon.tipo_mov~") COLUMN(NAME=~"cadena_mora.valor_cuota_mant~") COLUMN(NAME=~"cadena_mora.fecha_venc_mant~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cliente.direccion_p~") COLUMN(NAME=~"cliente.poblacion~") COLUMN(NAME=~"cliente.sector~") COLUMN(NAME=~"cliente.numero_particular~") COLUMN(NAME=~"cliente.depto_particular~") COLUMN(NAME=~"cliente.block_particular~") COLUMN(NAME=~"comuna.comuna~") COLUMN(NAME=~"ciudad.ciudad~") COLUMN(NAME=~"tipo_via.descripcion~")    JOIN (LEFT=~"tem_cupon.codigo~"    OP =~"=~"RIGHT=~"cadena.codigo~"    OUTER1 =~"tem_cupon.codigo~" )    JOIN (LEFT=~"tem_cupon.serie~"    OP =~"=~"RIGHT=~"cadena.serie~"    OUTER1 =~"tem_cupon.serie~" )    JOIN (LEFT=~"tem_cupon.numero~"    OP =~"=~"RIGHT=~"cadena.numero~"    OUTER1 =~"tem_cupon.numero~" )    JOIN (LEFT=~"tem_cupon.codigo~"    OP =~"=~"RIGHT=~"cadena_mora.base~"    OUTER1 =~"tem_cupon.codigo~" )    JOIN (LEFT=~"tem_cupon.serie~"    OP =~"=~"RIGHT=~"cadena_mora.serie~"    OUTER1 =~"tem_cupon.serie~" )    JOIN (LEFT=~"tem_cupon.numero~"    OP =~"=~"RIGHT=~"cadena_mora.numero~"    OUTER1 =~"tem_cupon.numero~" )    JOIN (LEFT=~"tem_cupon.rut~"    OP =~"=~"RIGHT=~"cliente.rut~" )    JOIN (LEFT=~"comuna.codigo_comuna~"    OP =~"=~"RIGHT=~"cliente.comuna~" )    JOIN (LEFT=~"ciudad.codigo_ciudad~"    OP =~"=~"RIGHT=~"cliente.ciudad~" )    JOIN (LEFT=~"cliente.tipo_via~"    OP =~"=~"RIGHT=~"tipo_via.tipo_via~" )WHERE(    EXP1 =~":parque~"   OP =~"=~"    EXP2 =~":parque~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"TEM_CUPON~~~".~~~"USUARIO~~~"~"   OP =~"=~"    EXP2 =~":usuario~" ) ) ORDER(NAME=~"tem_cupon.codigo~" ASC=yes )  ORDER(NAME=~"tem_cupon.serie~" ASC=yes )  ORDER(NAME=~"tem_cupon.numero~" ASC=yes ) ARG(NAME = ~"parque~" TYPE = string)  ARG(NAME = ~"usuario~" TYPE = string) " arguments=(("parque", string),("usuario", string)) )
