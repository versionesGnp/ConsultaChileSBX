table(column=(type=decimal(4) updatewhereclause=yes name=num_cup dbname="tem_cupon.num_cup" )
 column=(type=char(1) updatewhereclause=yes name=codigo dbname="tem_cupon.codigo" )
 column=(type=char(1) updatewhereclause=yes name=serie dbname="tem_cupon.serie" )
 column=(type=decimal(4) updatewhereclause=yes name=numero dbname="tem_cupon.numero" )
 column=(type=char(10) updatewhereclause=yes name=barra dbname="tem_cupon.barra" )
 column=(type=char(50) updatewhereclause=yes name=nombre dbname="tem_cupon.nombre" )
 column=(type=decimal(4) updatewhereclause=yes name=rut dbname="tem_cupon.rut" )
 column=(type=char(1) updatewhereclause=yes name=dv dbname="tem_cupon.dv" )
