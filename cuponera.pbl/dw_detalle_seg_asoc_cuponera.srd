 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"seguro_asociados~" )  TABLE(NAME=~"tipo_seguro~" ) COLUMN(NAME=~"tipo_seguro.glosa~") COLUMN(NAME=~"seguro_asociados.cod_seguro~") COLUMN(NAME=~"seguro_asociados.monto_prima~") COLUMN(NAME=~"seguro_asociados.moneda~")    JOIN (LEFT=~"seguro_asociados.cod_seguro~"    OP =~"=~"RIGHT=~"tipo_seguro.codigo~" )WHERE(    EXP1 =~"~~~"SEGURO_ASOCIADOS~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SEGURO_ASOCIADOS~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SEGURO_ASOCIADOS~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SEGURO_ASOCIADOS~~~".~~~"ESTADO_REG~~~"~"   OP =~"=~"    EXP2 =~"0~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SEGURO_ASOCIADOS~~~".~~~"ESTADO_SEGURO~~~"~"   OP =~"=~"    EXP2 =~"'A'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"SEGURO_ASOCIADOS~~~".~~~"MONTO_PRIMA~~~"~"   OP =~">~"    EXP2 =~"0~" ) )    UNION (PBSELECT( VERSION(400) TABLE(NAME=~"cadena~" )  TABLE(NAME=~"oferta_v~" )  TABLE(NAME=~"pago_oferta~" ) COMPUTE(NAME=~"'VALOR CUOTA'~") COMPUTE(NAME=~"0~") COLUMN(NAME=~"pago_oferta.valor_cuota~") COLUMN(NAME=~"pago_oferta.moneda~")    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"oferta_v.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"oferta_v.nro_oferta~" )    JOIN (LEFT=~"oferta_v.serie~"    OP =~"=~"RIGHT=~"pago_oferta.serie~" )    JOIN (LEFT=~"oferta_v.nro_oferta~"    OP =~"=~"RIGHT=~"pago_oferta.nro_oferta~" )    JOIN (LEFT=~"oferta_v.ult_folio~"    OP =~"=~"RIGHT=~"pago_oferta.folio~" )    JOIN (LEFT=~"cadena.rut~"    OP =~"=~"RIGHT=~"oferta_v.rut~" )WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~" ) ))    UNION (PBSELECT( VERSION(400) TABLE(NAME=~"pagare~" )  TABLE(NAME=~"cadena~" ) COMPUTE(NAME=~"'VALOR CUOTA'~") COMPUTE(NAME=~"0~") COLUMN(NAME=~"pagare.valor_cuo~") COLUMN(NAME=~"pagare.moneda~")    JOIN (LEFT=~"pagare.serie_p~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"pagare.nro_pagare~"    OP =~"=~"RIGHT=~"cadena.numero~" )    JOIN (LEFT=~"pagare.rut~"    OP =~"=~"RIGHT=~"cadena.rut~" )WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~" ) ))    UNION (PBSELECT( VERSION(400) TABLE(NAME=~"repacta_mantencion~" )  TABLE(NAME=~"cadena~" ) COMPUTE(NAME=~"'VALOR CUOTA'~") COMPUTE(NAME=~"0~") COLUMN(NAME=~"repacta_mantencion.valor_cuota_uf~") COLUMN(NAME=~"repacta_mantencion.tipo_moneda~")    JOIN (LEFT=~"repacta_mantencion.numero~"    OP =~"=~"RIGHT=~"cadena.numero~" )    JOIN (LEFT=~"repacta_mantencion.base~"    OP =~"=~"RIGHT=~"cadena.codigo~" )    JOIN (LEFT=~"repacta_mantencion.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"repacta_mantencion.rut_cliente~"    OP =~"=~"RIGHT=~"cadena.rut~" )WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~" ) ))    UNION (PBSELECT( VERSION(400) TABLE(NAME=~"cadena~" )  TABLE(NAME=~"derecho~" ) COMPUTE(NAME=~"'VALOR CUOTA'~") COMPUTE(NAME=~"0~") COLUMN(NAME=~"derecho.valor_cuo~") COLUMN(NAME=~"derecho.moneda~")    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"derecho.serie_p~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"derecho.nro_pagare~" )    JOIN (LEFT=~"cadena.rut~"    OP =~"=~"RIGHT=~"derecho.rut~" )WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~" ) ))    UNION (PBSELECT( VERSION(400) TABLE(NAME=~"anexo_aumento~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"pago_aumento~" ) COMPUTE(NAME=~"'VALOR CUOTA'~") COMPUTE(NAME=~"0~") COLUMN(NAME=~"pago_aumento.valor_cuota~") COLUMN(NAME=~"pago_aumento.moneda~")    JOIN (LEFT=~"anexo_aumento.nro_aumento~"    OP =~"=~"RIGHT=~"pago_aumento.nro_aumento~" )    JOIN (LEFT=~"anexo_aumento.ult_folio~"    OP =~"=~"RIGHT=~"pago_aumento.folio~" )    JOIN (LEFT=~"anexo_aumento.serie_m~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"anexo_aumento.nro_aumento~"    OP =~"=~"RIGHT=~"cadena.numero~" )    JOIN (LEFT=~"anexo_aumento.serie_m~"    OP =~"=~"RIGHT=~"pago_aumento.serie_m~" )    JOIN (LEFT=~"anexo_aumento.rut~"    OP =~"=~"RIGHT=~"cadena.rut~" )WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~" ) ))    UNION (PBSELECT( VERSION(400) TABLE(NAME=~"anexo_liberador~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"pago_liberador~" ) COMPUTE(NAME=~"'VALOR CUOTA'~") COMPUTE(NAME=~"0~") COLUMN(NAME=~"pago_liberador.valor_cuota~") COLUMN(NAME=~"pago_liberador.moneda~")    JOIN (LEFT=~"anexo_liberador.serie_m~"    OP =~"=~"RIGHT=~"pago_liberador.serie_m~" )    JOIN (LEFT=~"anexo_liberador.nro_liberador~"    OP =~"=~"RIGHT=~"pago_liberador.nro_liberador~" )    JOIN (LEFT=~"anexo_liberador.ult_folio~"    OP =~"=~"RIGHT=~"pago_liberador.folio~" )    JOIN (LEFT=~"anexo_liberador.serie_m~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"anexo_liberador.nro_liberador~"    OP =~"=~"RIGHT=~"cadena.numero~" )    JOIN (LEFT=~"anexo_liberador.rut~"    OP =~"=~"RIGHT=~"cadena.rut~" )WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~" ) )) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number) " arguments=(("base", string),("serie", string),("numero", number))  sort="seguro_asociados_cod_seguro A " )
