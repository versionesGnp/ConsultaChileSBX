 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cadena~" )  TABLE(NAME=~"cadena_mora~" )  TABLE(NAME=~"cuponeras~" )  TABLE(NAME=~"cuponeras_detalle~" )  TABLE(NAME=~"cliente~" ) COLUMN(NAME=~"cadena.cod_parque~") COLUMN(NAME=~"cadena_mora.valor_cuota_mant~") COLUMN(NAME=~"cadena_mora.fecha_venc_mant~") COLUMN(NAME=~"cuponeras_detalle.base~") COLUMN(NAME=~"cuponeras_detalle.serie~") COLUMN(NAME=~"cuponeras_detalle.numero~") COLUMN(NAME=~"cuponeras_detalle.nro_cupon~") COLUMN(NAME=~"cuponeras_detalle.rut~") COLUMN(NAME=~"cuponeras_detalle.nro_cuota~") COLUMN(NAME=~"cuponeras_detalle.fecha_venc~") COLUMN(NAME=~"cuponeras_detalle.estado_pago_cupon~") COLUMN(NAME=~"cuponeras_detalle.tipo_mov~") COLUMN(NAME=~"cuponeras_detalle.tipo_cob_pago~") COLUMN(NAME=~"cuponeras_detalle.folio_pago~") COLUMN(NAME=~"cuponeras_detalle.fecha_pago~") COLUMN(NAME=~"cuponeras_detalle.monto_cuota_contrato~") COLUMN(NAME=~"cuponeras_detalle.monto_cuota_peso~") COLUMN(NAME=~"cuponeras_detalle.monto_interes_mora~") COLUMN(NAME=~"cuponeras_detalle.monto_gasto_cobranza~") COLUMN(NAME=~"cuponeras_detalle.nro_cuponera~") COLUMN(NAME=~"cuponeras_detalle.dv~") COLUMN(NAME=~"cuponeras_detalle.ip_print~") COLUMN(NAME=~"cuponeras_detalle.usuario_print~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cuponeras.moneda_ctto~") COLUMN(NAME=~"cuponeras.plazo~")    JOIN (LEFT=~"cadena_mora.base~"    OP =~"=~"RIGHT=~"cuponeras_detalle.base~"    OUTER2 =~"cuponeras_detalle.base~" )    JOIN (LEFT=~"cadena_mora.serie~"    OP =~"=~"RIGHT=~"cuponeras_detalle.serie~"    OUTER2 =~"cuponeras_detalle.serie~" )    JOIN (LEFT=~"cadena_mora.numero~"    OP =~"=~"RIGHT=~"cuponeras_detalle.numero~"    OUTER2 =~"cuponeras_detalle.numero~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"cuponeras_detalle.base~"    OUTER2 =~"cuponeras_detalle.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"cuponeras_detalle.serie~"    OUTER2 =~"cuponeras_detalle.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"cuponeras_detalle.numero~"    OUTER2 =~"cuponeras_detalle.numero~" )    JOIN (LEFT=~"cuponeras_detalle.base~"    OP =~"=~"RIGHT=~"cuponeras.base~" )    JOIN (LEFT=~"cuponeras_detalle.serie~"    OP =~"=~"RIGHT=~"cuponeras.serie~" )    JOIN (LEFT=~"cuponeras_detalle.numero~"    OP =~"=~"RIGHT=~"cuponeras.numero~" )    JOIN (LEFT=~"cuponeras_detalle.nro_cuponera~"    OP =~"=~"RIGHT=~"cuponeras.nro_cuponera~" )    JOIN (LEFT=~"cuponeras_detalle.rut~"    OP =~"=~"RIGHT=~"cliente.rut~" )WHERE(    EXP1 =~"~~~"CUPONERAS~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CUPONERAS_DETALLE~~~".~~~"USUARIO_PRINT~~~"~"   OP =~"=~"    EXP2 =~":usuario~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CUPONERAS_DETALLE~~~".~~~"IP_PRINT~~~"~"   OP =~"=~"    EXP2 =~":ip~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CUPONERAS~~~".~~~"ESTADO_CUPONERA~~~"~"   OP =~"=~"    EXP2 =~"'V'~" ) ) ARG(NAME = ~"parque~" TYPE = number)  ARG(NAME = ~"usuario~" TYPE = string)  ARG(NAME = ~"ip~" TYPE = string) " arguments=(("parque", number),("usuario", string),("ip", string))  sort="cuponeras_detalle_base A cuponeras_detalle_serie A cuponeras_detalle_numero A cuponeras_detalle_fecha_venc A " )
