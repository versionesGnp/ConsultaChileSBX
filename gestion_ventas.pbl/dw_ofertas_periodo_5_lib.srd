 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"agentes~" )  TABLE(NAME=~"meta_super~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"anexo_liberador~" )  TABLE(NAME=~"pago_liberador~" ) COLUMN(NAME=~"meta_super.tipo_canal~") COLUMN(NAME=~"meta_super.abono~") COLUMN(NAME=~"agentes.cod_sup~") COLUMN(NAME=~"agentes.cod_age~") COLUMN(NAME=~"agentes.fecha_ini~") COLUMN(NAME=~"agentes.nombre~") COLUMN(NAME=~"agentes.a_paterno~") COLUMN(NAME=~"agentes.a_materno~") COLUMN(NAME=~"anexo_liberador.serie_m~") COLUMN(NAME=~"anexo_liberador.nro_liberador~") COLUMN(NAME=~"pago_liberador.fecha~") COLUMN(NAME=~"anexo_liberador.porce_age~") COLUMN(NAME=~"anexo_liberador.porce_sup~") COLUMN(NAME=~"anexo_liberador.tot_pagado~") COLUMN(NAME=~"anexo_liberador.u_folio~") COLUMN(NAME=~"anexo_liberador.u_fecha~") COLUMN(NAME=~"pago_liberador.precio~") COLUMN(NAME=~"pago_liberador.uf_dia~") COLUMN(NAME=~"pago_liberador.moneda~")    JOIN (LEFT=~"agentes.cod_sup~"    OP =~"=~"RIGHT=~"meta_super.cod_sup~" )    JOIN (LEFT=~"anexo_liberador.serie_m~"    OP =~"=~"RIGHT=~"pago_liberador.serie_m~" )    JOIN (LEFT=~"anexo_liberador.nro_liberador~"    OP =~"=~"RIGHT=~"pago_liberador.nro_liberador~" )    JOIN (LEFT=~"pago_liberador.folio~"    OP =~"=~"RIGHT=~"anexo_liberador.ult_folio~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"anexo_liberador.serie_m~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"anexo_liberador.nro_liberador~" )    JOIN (LEFT=~"agentes.cod_age~"    OP =~"=~"RIGHT=~"anexo_liberador.cod_agente~" )WHERE(    EXP1 =~"((~~~"ANEXO_LIBERADOR~~~".~~~"U_FECHA~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"ANEXO_LIBERADOR~~~".~~~"U_FECHA~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin ))~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'L'  )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"META_SUPER~~~".~~~"COD_SUP~~~"~"   OP =~"=~"    EXP2 =~":cod~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"CADENA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'V'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'C')~" ) ) ORDER(NAME=~"meta_super.tipo_canal~" ASC=yes )  ORDER(NAME=~"agentes.cod_sup~" ASC=yes ) ARG(NAME = ~"fecha_ini~" TYPE = date)  ARG(NAME = ~"fecha_fin~" TYPE = date)  ARG(NAME = ~"cod~" TYPE = string) " arguments=(("fecha_ini", date),("fecha_fin", date),("cod", string))  sort="count_o A " )
