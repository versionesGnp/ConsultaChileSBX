 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"res_comi~" ) COLUMN(NAME=~"res_comi.cod_contable~") COLUMN(NAME=~"res_comi.fecha~") COLUMN(NAME=~"res_comi.porc_venta~") COLUMN(NAME=~"res_comi.precio~") COLUMN(NAME=~"res_comi.total_pago~") COLUMN(NAME=~"res_comi.moneda~") COLUMN(NAME=~"res_comi.estado_age_sup~") COLUMN(NAME=~"res_comi.contrato~") COLUMN(NAME=~"res_comi.serie~")WHERE(    EXP1 =~"( RES_COMI.COD_AGE_SUP~"   OP =~"=~"    EXP2 =~":as_age )~" ) ) ORDER(NAME=~"res_comi.fecha~" ASC=no) ARG(NAME = ~"as_age~" TYPE = string) " arguments=(("as_age", string)) )
