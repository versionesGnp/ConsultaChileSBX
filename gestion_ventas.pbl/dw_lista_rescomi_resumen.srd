 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"res_comi~" ) COLUMN(NAME=~"res_comi.total_pago~") COLUMN(NAME=~"res_comi.fecha~")WHERE(    EXP1 =~"~~~"RES_COMI~~~".~~~"COD_AGE_SUP~~~"~"   OP =~"=~"    EXP2 =~":codigo~" ) ) ORDER(NAME=~"res_comi.fecha~" ASC=no) ARG(NAME = ~"codigo~" TYPE = string) " arguments=(("codigo", string))  sort="fecha D " )
