 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"agentes~" )  TABLE(NAME=~"jefe_ventas~" )  TABLE(NAME=~"supervisor~" ) COLUMN(NAME=~"jefe_ventas.jefe_ventas~") COLUMN(NAME=~"jefe_ventas.nombre~") COLUMN(NAME=~"jefe_ventas.a_paterno~") COLUMN(NAME=~"jefe_ventas.a_materno~") COLUMN(NAME=~"jefe_ventas.rut~") COLUMN(NAME=~"jefe_ventas.estado~") COLUMN(NAME=~"supervisor.cod_sup~") COLUMN(NAME=~"supervisor.nombre~") COLUMN(NAME=~"supervisor.a_paterno~") COLUMN(NAME=~"supervisor.a_materno~") COLUMN(NAME=~"supervisor.rut~") COLUMN(NAME=~"supervisor.estado~") COLUMN(NAME=~"supervisor.clasifica~") COLUMN(NAME=~"jefe_ventas.cod_parque~") COLUMN(NAME=~"supervisor.cod_parque~")    JOIN (LEFT=~"jefe_ventas.jefe_ventas~"    OP =~"=~"RIGHT=~"supervisor.cod_jefe~" )    JOIN (LEFT=~"supervisor.cod_sup~"    OP =~"=~"RIGHT=~"agentes.cod_sup~" )WHERE(    EXP1 =~"~~~"AGENTES~~~".~~~"COD_AGE~~~"~"   OP =~"=~"    EXP2 =~":agente~" ) ) ARG(NAME = ~"agente~" TYPE = string) " arguments=(("agente", string)) )
