global type f_color_titulo from function_object
end type

forward prototypes
global subroutine f_color_titulo (datawindow adw_muestra, string as_columna)
end prototypes

global subroutine f_color_titulo (datawindow adw_muestra, string as_columna);string ls_te
CHOOSE CASE as_columna
	CASE 'tot_vtas','c_cien','tot_vtas_t','ts_1'
		
		ls_te = "DataWindow.Bands DataWindow.Objects tot_vtas_t.Band"
		adw_muestra.Describe(ls_te)
		adw_muestra.object.tot_vtas_t.color			= 2500 //40
//		adw_muestra.object.tot_vtas_t.background	= 255
		adw_muestra.object.tot_nulas_n_t.color		= 0
		adw_muestra.object.tot_resueltas_t.color	= 0
		adw_muestra.object.tot_nulas_p_t.color		= 0
		adw_muestra.object.tot_canceladas_t.color	= 0
		adw_muestra.object.tot_vigentes_t.color	= 0
		adw_muestra.object.tot_al_dia_t.color		= 0
		adw_muestra.object.tot_en_mora_t.color		= 0
		adw_muestra.object.canc_vte_t.color			= 0

	CASE 'tot_nulas_n','c_por_resciliados','tot_nulas_n_t','c_1_resc2','c_1_resc1'
