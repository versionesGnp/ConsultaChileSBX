 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"agentes~" )  TABLE(NAME=~"jefe_ventas~" )  TABLE(NAME=~"supervisor~" )  TABLE(NAME=~"meta_super~" ) COLUMN(NAME=~"agentes.cod_age~") COLUMN(NAME=~"agentes.nombre~") COLUMN(NAME=~"agentes.a_paterno~") COLUMN(NAME=~"agentes.a_materno~") COLUMN(NAME=~"agentes.fecha_ini~") COLUMN(NAME=~"agentes.fecha_fin~") COLUMN(NAME=~"agentes.estado~") COLUMN(NAME=~"agentes.nro_de_cont~") COLUMN(NAME=~"supervisor.cod_sup~") COLUMN(NAME=~"supervisor.cod_jefe~") COLUMN(NAME=~"meta_super.tipo_canal~") COLUMN(NAME=~"agentes.cod_parque~")    JOIN (LEFT=~"agentes.cod_sup~"    OP =~"=~"RIGHT=~"supervisor.cod_sup~" )    JOIN (LEFT=~"supervisor.cod_jefe~"    OP =~"=~"RIGHT=~"jefe_ventas.jefe_ventas~" )    JOIN (LEFT=~"supervisor.cod_sup~"    OP =~"=~"RIGHT=~"meta_super.cod_sup~" )) ORDER(NAME=~"agentes.fecha_ini~" ASC=yes ) "  sort="agentes_estado A agentes_cod_age A " )
