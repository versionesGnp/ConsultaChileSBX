global type f_meta from function_object
end type

forward prototypes
global function integer f_meta (string canal, long meta)
end prototypes

global function integer f_meta (string canal, long meta);integer cont=0

if canal='PV' then
	select distinct supint_top into :cont from punto_venta where  supint_top <=:meta;
	return cont
elseif canal='VD' then
	select distinct supint_top into :cont from venta_directa where  supint_top <=:meta;
elseif canal='NI' then
	cont=1
end if
return cont
end function

