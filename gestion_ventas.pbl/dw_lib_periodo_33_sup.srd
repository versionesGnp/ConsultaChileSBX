compute(band=detail alignment="1" expression=" if( empresa =1,if((if(  anexo_liberador_estado_comi  ='N' or  anexo_liberador_estado_comi  ='C',round(((  pago_liberador_precio  * (0.07) )-  anexo_liberador_tot_pagado  )/  pago_liberador_valor_cuota ,0 ),0))<0,0,(if(  anexo_liberador_estado_comi  ='N' or  anexo_liberador_estado_comi  ='C',round(((  pago_liberador_precio  * (0.07) )-  anexo_liberador_tot_pagado  )/  pago_liberador_valor_cuota ,0 ),0))),              if((if(  anexo_liberador_estado_comi  ='N' or  anexo_liberador_estado_comi  ='C',round(((  pago_liberador_precio  * (0.10) )-  anexo_liberador_tot_pagado  )/  pago_liberador_valor_cuota ,0 ),0))<0,0,(if(  anexo_liberador_estado_comi  ='N' or  anexo_liberador_estado_comi  ='C',round(((  pago_liberador_precio  * (0.10) )-  anexo_liberador_tot_pagado  )/  pago_liberador_valor_cuota ,0 ),0)))) "border="0" color="0" x="2866" y="88" height="52" width="727" format=""  name=formula  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
