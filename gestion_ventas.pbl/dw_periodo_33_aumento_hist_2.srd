 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"agentes~" )  TABLE(NAME=~"meta_super~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"supervisor~" )  TABLE(NAME=~"anexo_aumento~" )  TABLE(NAME=~"pago_aumento~" ) COLUMN(NAME=~"meta_super.tipo_canal~") COLUMN(NAME=~"meta_super.abono~") COLUMN(NAME=~"agentes.cod_sup~") COLUMN(NAME=~"agentes.cod_age~") COLUMN(NAME=~"agentes.fecha_ini~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"supervisor.nombre~") COLUMN(NAME=~"supervisor.a_paterno~") COLUMN(NAME=~"supervisor.a_materno~") COLUMN(NAME=~"supervisor.fecha_ing~") COLUMN(NAME=~"agentes.clasificacion~") COLUMN(NAME=~"anexo_aumento.serie_m~") COLUMN(NAME=~"anexo_aumento.nro_aumento~") COLUMN(NAME=~"anexo_aumento.tot_pagado~") COLUMN(NAME=~"anexo_aumento.cta_pag_m~") COLUMN(NAME=~"anexo_aumento.fecha_ingreso~") COLUMN(NAME=~"anexo_aumento.fecha_com~") COLUMN(NAME=~"anexo_aumento.cod_agente~") COLUMN(NAME=~"anexo_aumento.cod_super~") COLUMN(NAME=~"anexo_aumento.estado_comi~") COLUMN(NAME=~"anexo_aumento.porce_age~") COLUMN(NAME=~"anexo_aumento.u_folio~") COLUMN(NAME=~"anexo_aumento.u_fecha~") COLUMN(NAME=~"pago_aumento.fecha~") COLUMN(NAME=~"pago_aumento.precio~") COLUMN(NAME=~"pago_aumento.pie~") COLUMN(NAME=~"pago_aumento.valor_cuota~") COLUMN(NAME=~"pago_aumento.nro_cuotas~") COLUMN(NAME=~"pago_aumento.uf_dia~") COLUMN(NAME=~"pago_aumento.moneda~") COLUMN(NAME=~"pago_aumento.fecha_prim~")    JOIN (LEFT=~"agentes.cod_sup~"    OP =~"=~"RIGHT=~"meta_super.cod_sup~" )    JOIN (LEFT=~"anexo_aumento.serie_m~"    OP =~"=~"RIGHT=~"pago_aumento.serie_m~" )    JOIN (LEFT=~"anexo_aumento.nro_aumento~"    OP =~"=~"RIGHT=~"pago_aumento.nro_aumento~" )    JOIN (LEFT=~"anexo_aumento.ult_folio~"    OP =~"=~"RIGHT=~"pago_aumento.folio~" )    JOIN (LEFT=~"anexo_aumento.serie_m~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"anexo_aumento.nro_aumento~"    OP =~"=~"RIGHT=~"cadena.numero~" )    JOIN (LEFT=~"anexo_aumento.cod_super~"    OP =~"=~"RIGHT=~"supervisor.cod_sup~" )    JOIN (LEFT=~"anexo_aumento.cod_agente~"    OP =~"=~"RIGHT=~"agentes.cod_age~" )WHERE(    EXP1 =~"((~~~"ANEXO_AUMENTO~~~".~~~"U_FECHA~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"ANEXO_AUMENTO~~~".~~~"U_FECHA~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin ))~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'A'  )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"ANEXO_AUMENTO~~~".~~~"COD_SUPER~~~"~"   OP =~"=~"    EXP2 =~":cod~" ) ) ORDER(NAME=~"meta_super.tipo_canal~" ASC=yes )  ORDER(NAME=~"agentes.cod_sup~" ASC=yes ) ARG(NAME = ~"fecha_ini~" TYPE = date)  ARG(NAME = ~"fecha_fin~" TYPE = date)  ARG(NAME = ~"cod~" TYPE = string)  ARG(NAME = ~"empresa~" TYPE = number) " arguments=(("fecha_ini", date),("fecha_fin", date),("cod", string),("empresa", number))  sort="meta_super_tipo_canal A agentes_cod_sup A agentes_cod_age A " )
