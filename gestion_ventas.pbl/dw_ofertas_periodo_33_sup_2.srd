    JOIN (LEFT=~"oferta_v.nro_oferta~"    OP =~"=~"RIGHT=~"cadena.numero~" )    JOIN (LEFT=~"agentes.cod_sup~"    OP =~"=~"RIGHT=~"supervisor.cod_sup~" )WHERE(    EXP1 =~"((~~~"OFERTA_V~~~".~~~"U_FECHA~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"OFERTA_V~~~".~~~"U_FECHA~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin ))~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'O'  )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"AGENTES~~~".~~~"COD_SUP~~~"~"   OP =~"=~"    EXP2 =~":cod~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"OFERTA_V~~~".~~~"SERIE~~~"~"   OP =~"<>~"    EXP2 =~"'R'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"CADENA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'C'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'V')~" ) ) ORDER(NAME=~"meta_super.tipo_canal~" ASC=yes )  ORDER(NAME=~"agentes.cod_sup~" ASC=yes )  ORDER(NAME=~"oferta_v.u_fecha~" ASC=yes ) ARG(NAME = ~"fecha_ini~" TYPE = date)  ARG(NAME = ~"fecha_fin~" TYPE = date)  ARG(NAME = ~"cod~" TYPE = string)  ARG(NAME = ~"empresa~" TYPE = number) " arguments=(("fecha_ini", date),("fecha_fin", date),("cod", string),("empresa", number))  sort="meta_super_tipo_canal A agentes_cod_age A oferta_v_u_fecha A " )
