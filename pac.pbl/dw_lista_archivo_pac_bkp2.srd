 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"sol_estatus~" )  TABLE(NAME=~"sol_pac~" )  TABLE(NAME=~"cadena_mora~" )  TABLE(NAME=~"ciudad~" )  TABLE(NAME=~"comuna~" )  TABLE(NAME=~"tipo_via~" ) COLUMN(NAME=~"sol_pac.fecha_cobro_pac~") COLUMN(NAME=~"sol_pac.rut_titular~") COLUMN(NAME=~"sol_pac.dv~") COLUMN(NAME=~"sol_pac.ap_paterno~") COLUMN(NAME=~"sol_pac.ap_materno~") COLUMN(NAME=~"sol_pac.nombre~") COLUMN(NAME=~"sol_pac.tipo_via~") COLUMN(NAME=~"sol_pac.direccion_p~") COLUMN(NAME=~"sol_pac.numero_particular~") COLUMN(NAME=~"sol_pac.depto_particular~") COLUMN(NAME=~"sol_pac.block_particular~") COLUMN(NAME=~"sol_pac.monto_cuota_cred~") COLUMN(NAME=~"sol_pac.monto_cuota_mant~") COLUMN(NAME=~"cadena_mora.fecha_venc_cred~") COLUMN(NAME=~"cadena_mora.fecha_venc_mant~") COLUMN(NAME=~"ciudad.ciudad~") COLUMN(NAME=~"comuna.comuna~") COLUMN(NAME=~"tipo_via.descripcion~") COLUMN(NAME=~"sol_pac.base~") COLUMN(NAME=~"sol_pac.serie~") COLUMN(NAME=~"sol_pac.numero~") COLUMN(NAME=~"sol_pac.cod_banco~") COLUMN(NAME=~"sol_pac.tipo_cuenta~") COLUMN(NAME=~"sol_pac.numero_cuenta~") COMPUTE(NAME=~"''~") COMPUTE(NAME=~"to_date('01/01/1900','dd/mm/yyyy')~") COMPUTE(NAME=~"to_date('01/01/1901','dd/mm/yyyy')~")    JOIN (LEFT=~"sol_estatus.base~"    OP =~"=~"RIGHT=~"sol_pac.base~" )    JOIN (LEFT=~"sol_estatus.serie~"    OP =~"=~"RIGHT=~"sol_pac.serie~" )    JOIN (LEFT=~"sol_estatus.numero~"    OP =~"=~"RIGHT=~"sol_pac.numero~" )    JOIN (LEFT=~"sol_pac.base~"    OP =~"=~"RIGHT=~"cadena_mora.base~" )    JOIN (LEFT=~"sol_pac.serie~"    OP =~"=~"RIGHT=~"cadena_mora.serie~" )    JOIN (LEFT=~"sol_pac.numero~"    OP =~"=~"RIGHT=~"cadena_mora.numero~" )    JOIN (LEFT=~"sol_pac.ciudad~"    OP =~"=~"RIGHT=~"ciudad.codigo_ciudad~" )    JOIN (LEFT=~"sol_pac.comuna~"    OP =~"=~"RIGHT=~"comuna.codigo_comuna~" )    JOIN (LEFT=~"sol_pac.tipo_via~"    OP =~"=~"RIGHT=~"tipo_via.tipo_via~" )WHERE(    EXP1 =~"(~~~"SOL_ESTATUS~~~".~~~"CODIGO_SOLICITUD~~~"~"   OP =~"=~"    EXP2 =~"'20'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"ESTADO_REG~~~"~"   OP =~"=~"    EXP2 =~"'A'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"SOL_PAC~~~".~~~"ESTATUS_OPERACION~~~"~"   OP =~"=~"    EXP2 =~"0~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"SOL_PAC~~~".~~~"ESTATUS_INFORMATICA~~~"~"   OP =~"=~"    EXP2 =~"0~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"SOL_PAC~~~".~~~"FOLIO_MANDATO~~~"~"   OP =~">~"    EXP2 =~"0~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"((~~~"CADENA_MORA~~~".~~~"CTAS_PAG_S~~~"~"   OP =~"<~"    EXP2 =~"~~~"CADENA_MORA~~~".~~~"PLAZO~~~"~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA_MORA~~~".~~~"FECHA_VENC_CRED~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA_MORA~~~".~~~"FECHA_VENC_CRED~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"SOL_PAC~~~".~~~"MONTO_CUOTA_CRED~~~"~"   OP =~">~"    EXP2 =~"0~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"SOL_PAC~~~".~~~"FECHA_COBRO_PAC~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin )~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"(~~~"CADENA_MORA~~~".~~~"FECHA_VENC_MANT~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CADENA_MORA~~~".~~~"FECHA_VENC_MANT~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"SOL_PAC~~~".~~~"MONTO_CUOTA_MANT~~~"~"   OP =~">~"    EXP2 =~"0~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"SOL_PAC~~~".~~~"FECHA_COBRO_PAC_MANT~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin)) )~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = datetime)  ARG(NAME = ~"fecha_fin~" TYPE = datetime) " arguments=(("fecha_ini", datetime),("fecha_fin", datetime))  sort="cadena_mora_fecha_venc_cred A cadena_mora_fecha_venc_mant A " )
