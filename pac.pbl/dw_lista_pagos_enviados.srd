=~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_PAC_RECUPERA_RECHAZO~~~".~~~"FECHA_PAGO~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~" ) )) ARG(NAME = ~"fecha_ini~" TYPE = datetime)  ARG(NAME = ~"fecha_fin~" TYPE = datetime) " arguments=(("fecha_ini", datetime),("fecha_fin", datetime))  sort="sol_pac_recupera_codigo_grupo D sol_pac_recupera_fecha_pago D " )
