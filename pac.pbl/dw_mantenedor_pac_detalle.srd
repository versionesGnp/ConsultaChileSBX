 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"pac_detalle~" ) COLUMN(NAME=~"pac_detalle.base~") COLUMN(NAME=~"pac_detalle.serie~") COLUMN(NAME=~"pac_detalle.numero~") COLUMN(NAME=~"pac_detalle.fecha_envio~") COLUMN(NAME=~"pac_detalle.fecha_pago~") COLUMN(NAME=~"pac_detalle.monto_pago~") COLUMN(NAME=~"pac_detalle.cupon~") COLUMN(NAME=~"pac_detalle.usuario~") COLUMN(NAME=~"pac_detalle.codigo_oe_bci~") COLUMN(NAME=~"pac_detalle.tipo_mov~")WHERE(    EXP1 =~"~~~"PAC_DETALLE~~~".~~~"FECHA_PAGO~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"PAC_DETALLE~~~".~~~"FECHA_PAGO~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = date)  ARG(NAME = ~"fecha_fin~" TYPE = date) " update="PAC_DETALLE" updatewhere=0 updatekeyinplace=yes arguments=(("fecha_ini", date),("fecha_fin", date))  sort="fecha_envio A tipo_mov A " )
