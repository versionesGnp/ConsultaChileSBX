 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"sol_pac_recupera~" )  TABLE(NAME=~"sol_pac_recupera_archivo~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"cuponeras_detalle~" ) COLUMN(NAME=~"sol_pac_recupera.codigo_rechazo~") COLUMN(NAME=~"sol_pac_recupera.fecha_cargo~") COLUMN(NAME=~"sol_pac_recupera.fecha_cargo_ori~") COLUMN(NAME=~"sol_pac_recupera.rut~") COLUMN(NAME=~"sol_pac_recupera.dv~") COLUMN(NAME=~"sol_pac_recupera.base~") COLUMN(NAME=~"sol_pac_recupera.serie~") COLUMN(NAME=~"sol_pac_recupera.numero~") COLUMN(NAME=~"sol_pac_recupera.numero_cupon~") COLUMN(NAME=~"sol_pac_recupera.monto_pago~") COLUMN(NAME=~"sol_pac_recupera.fecha_pago~") COLUMN(NAME=~"sol_pac_recupera.estado~") COLUMN(NAME=~"sol_pac_recupera.cuenta_cargo~") COLUMN(NAME=~"sol_pac_recupera.cod_banco~") COLUMN(NAME=~"sol_pac_recupera.codigo_grupo~") COLUMN(NAME=~"sol_pac_recupera_archivo.nombre_archivo~") COLUMN(NAME=~"sol_pac_recupera_archivo.fecha_carga~") COLUMN(NAME=~"sol_pac_recupera.fecha_sistema~") COLUMN(NAME=~"cadena.cod_parque~") COLUMN(NAME=~"cuponeras_detalle.tipo_mov~")    JOIN (LEFT=~"sol_pac_recupera.numero_cupon~"    OP =~"=~"RIGHT=~"cuponeras_detalle.nro_cupon~"    OUTER1 =~"sol_pac_recupera.numero_cupon~" )   JOIN (LEFT=~"sol_pac_recupera.codigo_grupo~"    OP =~"=~"RIGHT=~"sol_pac_recupera_archivo.codigo_grupo~" )    JOIN (LEFT=~"sol_pac_recupera.base~"    OP =~"=~"RIGHT=~"cadena.codigo~" )    JOIN (LEFT=~"sol_pac_recupera.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"sol_pac_recupera.numero~"    OP =~"=~"RIGHT=~"cadena.numero~" ) WHERE(    EXP1 =~"~~~"SOL_PAC_RECUPERA~~~".~~~"CODIGO_GRUPO~~~"~"   OP =~"=~"    EXP2 =~":grupo~" ) ) ARG(NAME = ~"grupo~" TYPE = number) " update="SOL_PAC_RECUPERA" updatewhere=0 updatekeyinplace=yes arguments=(("grupo", number))  sort="fecha_pago D " )
