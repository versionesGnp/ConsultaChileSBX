 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cadena~" )  TABLE(NAME=~"sol_pac~" )  TABLE(NAME=~"sol_estatus~" )  TABLE(NAME=~"cadena_mora~" )  TABLE(NAME=~"cliente~" ) COLUMN(NAME=~"sol_pac.base~") COLUMN(NAME=~"sol_pac.serie~") COLUMN(NAME=~"sol_pac.numero~") COLUMN(NAME=~"sol_pac.base_mandato~") COLUMN(NAME=~"sol_pac.serie_mandato~") COLUMN(NAME=~"sol_pac.folio_mandato~") COLUMN(NAME=~"sol_pac.rut_titular~") COLUMN(NAME=~"sol_pac.dv~") COLUMN(NAME=~"sol_pac.nombre~") COLUMN(NAME=~"sol_pac.ap_paterno~") COLUMN(NAME=~"sol_pac.ap_materno~") COLUMN(NAME=~"cliente.fono_p~") COLUMN(NAME=~"cliente.fono_c~") COLUMN(NAME=~"cliente.celular~") COLUMN(NAME=~"cadena_mora.mora_cred~") COLUMN(NAME=~"cadena_mora.dias_mora_cred~") COLUMN(NAME=~"cadena_mora.fecha_venc_cred~") COLUMN(NAME=~"cadena_mora.mora_mant~") COLUMN(NAME=~"cadena_mora.dias_mora_mant~") COLUMN(NAME=~"cadena_mora.fecha_venc_mant~") COLUMN(NAME=~"cadena.cod_parque~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"cadena_mora.plazo~") COLUMN(NAME=~"cadena_mora.ctas_pag_s~") COLUMN(NAME=~"cadena_mora.valor_cuota~") COLUMN(NAME=~"cadena_mora.valor_cuota_mant~") COLUMN(NAME=~"cadena_mora.fallecidos~")    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"sol_pac.serie~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"sol_pac.base~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"sol_pac.numero~" )    JOIN (LEFT=~"sol_pac.base~"    OP =~"=~"RIGHT=~"sol_estatus.base~" )    JOIN (LEFT=~"sol_pac.serie~"    OP =~"=~"RIGHT=~"sol_estatus.serie~" )    JOIN (LEFT=~"sol_pac.numero~"    OP =~"=~"RIGHT=~"sol_estatus.numero~" )    JOIN (LEFT=~"sol_pac.correlativo~"    OP =~"=~"RIGHT=~"sol_estatus.correlativo~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"cadena_mora.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"cadena_mora.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"cadena_mora.numero~" )    JOIN (LEFT=~"sol_pac.rut_titular~"    OP =~"=~"RIGHT=~"cliente.rut~" )WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"CODIGO_SOLICITUD~~~"~"   OP =~"=~"    EXP2 =~"'20'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_ESTATUS~~~".~~~"ESTADO_REG~~~"~"   OP =~"=~"    EXP2 =~"'A'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"SOL_PAC~~~".~~~"ESTATUS_INFORMATICA~~~"~"   OP =~"=~"    EXP2 =~"0~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"SOL_PAC~~~".~~~"ESTATUS_OPERACION~~~"~"   OP =~"=~"    EXP2 =~"0~" ) ) "  sort="cadena_mora_mora_cred D cadena_mora_dias_mora_cred D cadena_mora_mora_mant D cadena_mora_dias_mora_mant D cadena_mora_fecha_venc_cred D cadena_mora_fecha_venc_mant D " )
