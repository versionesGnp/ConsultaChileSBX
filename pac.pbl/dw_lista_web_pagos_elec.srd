table(column=(type=char(1) update=yes updatewhereclause=yes name=base dbname="web_pagos.base" dbalias=".base" )
 column=(type=char(1) update=yes updatewhereclause=yes name=serie dbname="web_pagos.serie" dbalias=".serie" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=numero dbname="web_pagos.numero" dbalias=".numero" )
 column=(type=datetime update=yes updatewhereclause=yes name=fecha_pago dbname="web_pagos.fecha_pago" dbalias=".fecha_pago" )
 column=(type=decimal(4) update=yes updatewhereclause=yes key=yes name=numero_cupon dbname="web_pagos.numero_cupon" dbalias=".numero_cupon" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=monto dbname="web_pagos.monto" dbalias=".monto" )
 column=(type=datetime update=yes updatewhereclause=yes name=fecha_venc dbname="web_pagos.fecha_venc" dbalias=".fecha_venc" )
 column=(type=char(1) update=yes updatewhereclause=yes name=estado_pago dbname="web_pagos.estado_pago" dbalias=".estado_pago" values="P - Pendiente	P/G - Gestionado	G/" )
 column=(type=char(1) update=yes updatewhereclause=yes name=actualiza_ingreso dbname="web_pagos.actualiza_ingreso" dbalias=".actualiza_ingreso" values="No	N/Si	S/" )
 column=(type=decimal(4) update=yes updatewhereclause=yes key=yes name=id_pago dbname="web_pagos.id_pago" dbalias=".id_pago" )
 column=(type=char(250) update=yes updatewhereclause=yes name=firma_eps dbname="web_pagos.firma_eps" dbalias=".firma_eps" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=id_sub dbname="web_pagos.id_sub" dbalias=".id_sub" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=grupo dbname="web_pagos.grupo" dbalias=".grupo" )
 column=(type=datetime update=yes updatewhereclause=yes name=fecha_crea dbname="web_pagos.fecha_crea" dbalias=".fecha_crea" )
 column=(type=char(20) update=yes updatewhereclause=yes name=ip dbname="web_pagos.ip" dbalias=".ip" )
 column=(type=decimal(4) updatewhereclause=yes name=cadena_rut dbname="cadena.rut" dbalias=".rut" )
 column=(type=number updatewhereclause=yes name=c_est_reg dbname="c_est_reg" values="	0/	1" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=web_pagos_monto_descuento dbname="web_pagos.monto_descuento" dbalias=".monto_descuento" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=web_pagos_codigo_tramo dbname="web_pagos.codigo_tramo" dbalias=".codigo_tramo" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"web_pagos~" )  TABLE(NAME=~"cadena~" ) COLUMN(NAME=~"web_pagos.base~") COLUMN(NAME=~"web_pagos.serie~") COLUMN(NAME=~"web_pagos.numero~") COLUMN(NAME=~"web_pagos.fecha_pago~") COLUMN(NAME=~"web_pagos.numero_cupon~") COLUMN(NAME=~"web_pagos.monto~") COLUMN(NAME=~"web_pagos.fecha_venc~") COLUMN(NAME=~"web_pagos.estado_pago~") COLUMN(NAME=~"web_pagos.actualiza_ingreso~") COLUMN(NAME=~"web_pagos.id_pago~") COLUMN(NAME=~"web_pagos.firma_eps~") COLUMN(NAME=~"web_pagos.id_sub~") COLUMN(NAME=~"web_pagos.grupo~") COLUMN(NAME=~"web_pagos.fecha_crea~") COLUMN(NAME=~"web_pagos.ip~") COLUMN(NAME=~"cadena.rut~") COMPUTE(NAME=~"0 as c_est_reg~") COLUMN(NAME=~"web_pagos.monto_descuento~") COLUMN(NAME=~"web_pagos.codigo_tramo~")    JOIN (LEFT=~"web_pagos.base~"    OP =~"=~"RIGHT=~"cadena.codigo~" )    JOIN (LEFT=~"web_pagos.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"web_pagos.numero~"    OP =~"=~"RIGHT=~"cadena.numero~" )WHERE(    EXP1 =~"~~~"WEB_PAGOS~~~".~~~"ACTUALIZA_INGRESO~~~"~"   OP =~"=~"    EXP2 =~"'N'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"WEB_PAGOS~~~".~~~"ESTADO_PAGO~~~"~"   OP =~"=~"    EXP2 =~"'P'~" ) ) " update="WEB_PAGOS" updatewhere=0 updatekeyinplace=yes  sort="fecha_pago A grupo A id_sub A " )
