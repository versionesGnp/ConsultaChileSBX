 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"pac_detalle~" )  TABLE(NAME=~"cuponeras~" )  TABLE(NAME=~"cuponeras_detalle~" )  TABLE(NAME=~"ingreso~" )  TABLE(NAME=~"sol_pac_recupera~" ) COLUMN(NAME=~"pac_detalle.base~") COLUMN(NAME=~"pac_detalle.serie~") COLUMN(NAME=~"pac_detalle.numero~") COLUMN(NAME=~"pac_detalle.tipo_mov~") COLUMN(NAME=~"pac_detalle.fecha_pago~") COLUMN(NAME=~"pac_detalle.monto_pago~") COLUMN(NAME=~"pac_detalle.fecha_envio~") COLUMN(NAME=~"ingreso.monto~") COLUMN(NAME=~"ingreso.cod_caja~") COLUMN(NAME=~"ingreso.fecha_pago~") COLUMN(NAME=~"pac_detalle.cupon~") COLUMN(NAME=~"sol_pac_recupera.estado~") COLUMN(NAME=~"sol_pac_recupera.codigo_rechazo~")    JOIN (LEFT=~"pac_detalle.cupon~"    OP =~"=~"RIGHT=~"ingreso.folio~"    OUTER1 =~"pac_detalle.cupon~" )    JOIN (LEFT=~"pac_detalle.tipo_mov~"    OP =~"=~"RIGHT=~"ingreso.tipo_mov~"    OUTER1 =~"pac_detalle.tipo_mov~" )    JOIN (LEFT=~"pac_detalle.fecha_pago~"    OP =~"=~"RIGHT=~"sol_pac_recupera.fecha_pago~"    OUTER1 =~"pac_detalle.fecha_pago~" )    JOIN (LEFT=~"pac_detalle.cupon~"    OP =~"=~"RIGHT=~"sol_pac_recupera.numero_cupon~"    OUTER1 =~"pac_detalle.cupon~" )    JOIN (LEFT=~"pac_detalle.base~"    OP =~"=~"RIGHT=~"sol_pac_recupera.base~"    OUTER1 =~"pac_detalle.base~" )    JOIN (LEFT=~"pac_detalle.serie~"    OP =~"=~"RIGHT=~"sol_pac_recupera.serie~"    OUTER1 =~"pac_detalle.serie~" )    JOIN (LEFT=~"pac_detalle.numero~"    OP =~"=~"RIGHT=~"sol_pac_recupera.numero~"    OUTER1 =~"pac_detalle.numero~" )   JOIN (LEFT=~"cuponeras.base~"    OP =~"=~"RIGHT=~"cuponeras_detalle.base~" )    JOIN (LEFT=~"cuponeras.serie~"    OP =~"=~"RIGHT=~"cuponeras_detalle.serie~" )    JOIN (LEFT=~"cuponeras.numero~"    OP =~"=~"RIGHT=~"cuponeras_detalle.numero~" )    JOIN (LEFT=~"cuponeras.nro_cuponera~"    OP =~"=~"RIGHT=~"cuponeras_detalle.nro_cuponera~" )    JOIN (LEFT=~"pac_detalle.base~"    OP =~"=~"RIGHT=~"cuponeras_detalle.base~" )    JOIN (LEFT=~"pac_detalle.serie~"    OP =~"=~"RIGHT=~"cuponeras_detalle.serie~" )    JOIN (LEFT=~"pac_detalle.numero~"    OP =~"=~"RIGHT=~"cuponeras_detalle.numero~" )    JOIN (LEFT=~"pac_detalle.cupon~"    OP =~"=~"RIGHT=~"cuponeras_detalle.nro_cupon~" ) WHERE(    EXP1 =~"~~~"CUPONERAS~~~".~~~"ESTADO_CUPONERA~~~"~"   OP =~"=~"    EXP2 =~"'V'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"PAC_DETALLE~~~".~~~"FECHA_PAGO~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"PAC_DETALLE~~~".~~~"FECHA_PAGO~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = datetime)  ARG(NAME = ~"fecha_fin~" TYPE = datetime) " arguments=(("fecha_ini", datetime),("fecha_fin", datetime))  sort="fecha_pago D numero A " )
