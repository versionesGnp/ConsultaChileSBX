 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"sol_pac_recupera_rechazo~" )  TABLE(NAME=~"cliente~" ) COLUMN(NAME=~"sol_pac_recupera_rechazo.codigo_rechazo~") COLUMN(NAME=~"sol_pac_recupera_rechazo.fecha_cargo~") COLUMN(NAME=~"sol_pac_recupera_rechazo.fecha_cargo_ori~") COLUMN(NAME=~"sol_pac_recupera_rechazo.rut~") COLUMN(NAME=~"sol_pac_recupera_rechazo.dv~") COLUMN(NAME=~"sol_pac_recupera_rechazo.base~") COLUMN(NAME=~"sol_pac_recupera_rechazo.serie~") COLUMN(NAME=~"sol_pac_recupera_rechazo.numero~") COLUMN(NAME=~"sol_pac_recupera_rechazo.numero_cupon~") COLUMN(NAME=~"sol_pac_recupera_rechazo.monto_pago~") COLUMN(NAME=~"sol_pac_recupera_rechazo.fecha_pago~") COLUMN(NAME=~"sol_pac_recupera_rechazo.estado~") COLUMN(NAME=~"sol_pac_recupera_rechazo.cuenta_cargo~") COLUMN(NAME=~"sol_pac_recupera_rechazo.cod_banco~") COLUMN(NAME=~"sol_pac_recupera_rechazo.codigo_grupo~") COLUMN(NAME=~"sol_pac_recupera_rechazo.fecha_pago_reintento~") COLUMN(NAME=~"sol_pac_recupera_rechazo.fecha_pago_reintento_mant~") COLUMN(NAME=~"sol_pac_recupera_rechazo.estado_reg~") COLUMN(NAME=~"cliente.fono_p~") COLUMN(NAME=~"cliente.fono_c~") COLUMN(NAME=~"cliente.celular~")    JOIN (LEFT=~"sol_pac_recupera_rechazo.rut~"    OP =~"=~"RIGHT=~"cliente.rut~" )WHERE(    EXP1 =~"~~~"SOL_PAC_RECUPERA_RECHAZO~~~".~~~"FECHA_PAGO~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"SOL_PAC_RECUPERA_RECHAZO~~~".~~~"FECHA_PAGO~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = datetime)  ARG(NAME = ~"fecha_fin~" TYPE = datetime) " update="SOL_PAC_RECUPERA_RECHAZO" updatewhere=0 updatekeyinplace=yes arguments=(("fecha_ini", datetime),("fecha_fin", datetime))  sort="fecha_pago D codigo_grupo D " )
