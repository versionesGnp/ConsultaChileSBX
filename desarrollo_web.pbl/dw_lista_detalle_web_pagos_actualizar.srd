 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"web_pagos~" ) COLUMN(NAME=~"web_pagos.base~") COLUMN(NAME=~"web_pagos.serie~") COLUMN(NAME=~"web_pagos.numero~") COLUMN(NAME=~"web_pagos.fecha_pago~") COLUMN(NAME=~"web_pagos.numero_cupon~") COLUMN(NAME=~"web_pagos.monto~") COLUMN(NAME=~"web_pagos.fecha_venc~") COLUMN(NAME=~"web_pagos.estado_pago~") COLUMN(NAME=~"web_pagos.actualiza_ingreso~") COLUMN(NAME=~"web_pagos.id_pago~") COLUMN(NAME=~"web_pagos.firma_eps~") COLUMN(NAME=~"web_pagos.id_sub~") COLUMN(NAME=~"web_pagos.grupo~") COLUMN(NAME=~"web_pagos.fecha_crea~") COLUMN(NAME=~"web_pagos.ip~") COMPUTE(NAME=~"0~")WHERE(    EXP1 =~"~~~"WEB_PAGOS~~~".~~~"ESTADO_PAGO~~~"~"   OP =~"=~"    EXP2 =~"'P'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"WEB_PAGOS~~~".~~~"ACTUALIZA_INGRESO~~~"~"   OP =~"=~"    EXP2 =~"'N'~" ) ) "  sort="fecha_crea D " )
