 column=(type=char(10) update=yes updatewhereclause=yes name=v_codpos_emp dbname="genEmpresa.v_codpos_emp" )
 column=(type=char(20) update=yes updatewhereclause=yes name=c_codigo_usu dbname="genEmpresa.c_codigo_usu" )
 column=(type=datetime update=yes updatewhereclause=yes name=d_creacion dbname="genEmpresa.d_creacion_emp" )
 column=(type=char(20) update=yes updatewhereclause=yes name=c_usumod dbname="genEmpresa.c_usumod_emp" )
 column=(type=datetime update=yes updatewhereclause=yes name=d_modifi dbname="genEmpresa.d_modifi_emp" )
 column=(type=char(1) update=yes updatewhereclause=yes name=c_activo dbname="genEmpresa.c_activo_emp" )
 column=(type=char(3) update=yes updatewhereclause=yes name=c_codigo_pai dbname="genEmpresa.c_codigo_pai" )
 column=(type=char(100) update=yes updatewhereclause=yes name=v_etiquetaclase_emp dbname="genEmpresa.v_etiquetaclase_emp" )
 column=(type=char(2) updatewhereclause=yes name=c_codigo_edo dbname="genEmpresa.c_codigo_edo" )
 column=(type=char(100) updatewhereclause=yes name=v_nombre_edo dbname="genEstado.v_nombre_edo" )
 column=(type=char(5) updatewhereclause=yes name=c_codigo_loc dbname="genEmpresa.c_codigo_loc" )
 column=(type=char(100) updatewhereclause=yes name=v_nombre_loc dbname="genLocalidad.v_nombre_loc" )
 column=(type=char(100) updatewhereclause=yes name=v_nombre dbname="v_nombre" )
 column=(type=char(30) updatewhereclause=yes name=v_nombre_tem dbname="v_nombre_tem" )
 retrieve="  SELECT genempresa.c_codigo_emp,   
         genempresa.v_nombre_emp,   
         genempresa.v_nombrcort_emp,   
         genempresa.v_calle_emp,   
         genempresa.v_numext_emp,   
         genempresa.v_colonia_emp,   
         genempresa.v_direccion_emp,   
         genempresa.v_localidad_emp,   
         genempresa.v_municipio_emp,   
         genempresa.v_estado_emp,   
         genempresa.v_telefono1_emp,   
         genempresa.v_telefono2_emp,   
         genempresa.v_fax_emp,   
         genempresa.c_rfc_emp,   
         genempresa.v_codpos_emp,   
         genempresa.c_codigo_usu,   
         genempresa.d_creacion_emp,   
         genempresa.c_usumod_emp,   
         genempresa.d_modifi_emp,   
         genempresa.c_activo_emp,   
         genempresa.c_codigo_pai,   
         genempresa.v_etiquetaclase_emp,   
         genempresa.c_codigo_edo,   
         Edo.v_nombre_edo,
         genempresa.c_codigo_loc,   
         Loc.v_nombre_loc,
         v_nombre_emp As v_nombre,   
         Coalesce( gentemporada.v_nombre_tem, '- Sin Asignar -' ) As v_nombre_tem 
    From genempresa 
    
    Left Join gentemporada 
    On   genempresa.c_codigo_emp = gentemporada.c_codigo_emp
    And  genempresa.c_codigo_tem = gentemporada.c_codigo_tem
    
    Left Join genEstado Edo
    On   Edo.c_codigo_pai = genEmpresa.c_codigo_pai
    And  Edo.c_codigo_edo = genEmpresa.c_codigo_edo
    
    Left Join genLocalidad Loc
    On   Loc.c_codigo_pai = genEmpresa.c_codigo_pai
    And  Loc.c_codigo_loc = genEmpresa.c_codigo_loc


   

"  sort="c_codigo A " )
