table(column=(type=char(5) update=yes updatewhereclause=yes key=yes name=c_codigo_opc dbname="genopcion.c_codigo_opc" dbalias=".c_codigo_opc" )
 column=(type=char(100) update=yes updatewhereclause=yes name=v_nombre_opc dbname="genopcion.v_nombre_opc" dbalias=".v_nombre_opc" )
 column=(type=char(20) update=yes updatewhereclause=yes name=v_color_opc dbname="genopcion.v_color_opc" dbalias=".v_color_opc" )
 column=(type=char(250) update=yes updatewhereclause=yes name=v_descripcion_opc dbname="genopcion.v_descripcion_opc" dbalias=".v_descripcion_opc" )
 column=(type=char(100) updatewhereclause=yes name=v_modulo dbname="v_modulo" )
 retrieve="  SELECT genopcion.c_codigo_opc,   
         genopcion.v_nombre_opc,   
         genopcion.v_color_opc,   
         genopcion.v_descripcion_opc,
         ( Select x.v_nombre_opc From genopcion x Where x.c_codigo_opc = genopcion.c_depende_opc ) As v_modulo
    FROM genopcion  
   WHERE genopcion.c_nivel_opc = :as_niv
   And   Coalesce( c_depende_opc, '' ) = :as_opc
And :as_usu = :as_usu
            
" update="genopcion" updatewhere=1 updatekeyinplace=no arguments=(("as_niv", string),("as_opc", string),("as_usu", string)) )
compute(band=header alignment="0" expression="If( as_niv = '1', 'ECLIPSE - Sistema de Administración',  v_modulo[ 0] ) "border="0" color="8421504~tf_Gen_Color( 'o' )" x="155" y="56" height="156" width="2651" format="[GENERAL]" html.valueishtml="0"  name=st_title visible="1"  font.face="Tahoma" font.height="-24" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" background.transparency="0" background.gradient.color="8421504" background.gradient.transparency="0" background.gradient.angle="0" background.brushmode="0" background.gradient.repetition.mode="0" background.gradient.repetition.count="0" background.gradient.repetition.length="100" background.gradient.focus="0" background.gradient.scale="100" background.gradient.spread="100" tooltip.backcolor="134217752" tooltip.delay.initial="0" tooltip.delay.visible="32000" tooltip.enabled="0" tooltip.hasclosebutton="0" tooltip.icon="0" tooltip.isbubble="0" tooltip.maxwidth="0" tooltip.textcolor="134217751" tooltip.transparency="0" transparency="0" )
