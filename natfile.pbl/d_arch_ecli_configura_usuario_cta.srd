 column=(type=char(20) update=yes updatewhereclause=yes name=c_codigo_usu dbname="genlogin.c_codcrea_usu" dbalias=".c_codcrea_usu" )
 column=(type=char(2) update=yes updatewhereclause=yes name=c_codigo_tma dbname="genlogin.c_codigo_tma" dbalias=".c_codigo_tma" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"genlogin~" ) COLUMN(NAME=~"genlogin.v_nombre_usu~") COLUMN(NAME=~"genlogin.v_password_usu~") COLUMN(NAME=~"genlogin.v_email_usu~") COLUMN(NAME=~"genlogin.c_admin_usu~") COLUMN(NAME=~"genlogin.c_codigo_wks~") COMPUTE(NAME=~"v_password_usu As v_xpassword~") COMPUTE(NAME=~"Space( 100) As v_confirma~") COLUMN(NAME=~"genlogin.d_creacion_usu~") COLUMN(NAME=~"genlogin.c_usumod_usu~") COLUMN(NAME=~"genlogin.d_modifi_usu~") COLUMN(NAME=~"genlogin.c_activo_usu~") COLUMN(NAME=~"genlogin.c_codigo_usu~") COLUMN(NAME=~"genlogin.c_codcrea_usu~") COLUMN(NAME=~"genlogin.c_codigo_tma~")WHERE(    EXP1 =~"genlogin.c_codigo_usu~"   OP =~"=~"    EXP2 =~":as_cod~" ) ) ARG(NAME = ~"as_cod~" TYPE = string) " update="genlogin" updatewhere=0 updatekeyinplace=no arguments=(("as_cod", string)) )
