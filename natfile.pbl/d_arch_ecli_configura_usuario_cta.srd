table(column=(type=char(100) update=yes updatewhereclause=yes name=v_nombre_usu dbname="genlogin.v_nombre_usu" dbalias=".v_nombre_usu" )
 column=(type=char(100) update=yes updatewhereclause=yes name=v_password_usu dbname="genlogin.v_password_usu" dbalias=".v_password_usu" )
 column=(type=char(100) update=yes updatewhereclause=yes name=v_email_usu dbname="genlogin.v_email_usu" dbalias=".v_email_usu" )
 column=(type=char(1) update=yes updatewhereclause=yes name=c_admin_usu dbname="genlogin.c_admin_usu" dbalias=".c_admin_usu" initial="0" values="Es Administrador del Sistema	1/Es Administrador del Sistema	0" )
 column=(type=char(20) update=yes updatewhereclause=yes name=c_codigo_wks dbname="genlogin.c_codigo_wks" dbalias=".c_codigo_wks" )
 column=(type=char(100) updatewhereclause=yes name=v_xpassword dbname="genlogin.v_xpassword" dbalias=".v_xpassword" )
 column=(type=char(4000) updatewhereclause=yes name=v_confirma dbname="v_confirma" )
 column=(type=datetime update=yes updatewhereclause=yes name=d_creacion dbname="genlogin.d_creacion_usu" dbalias=".d_creacion_usu" )
 column=(type=char(20) update=yes updatewhereclause=yes name=c_usumod dbname="genlogin.c_usumod_usu" dbalias=".c_usumod_usu" )
 column=(type=datetime update=yes updatewhereclause=yes name=d_modifi dbname="genlogin.d_modifi_usu" dbalias=".d_modifi_usu" )
 column=(type=char(1) update=yes updatewhereclause=yes name=c_activo dbname="genlogin.c_activo_usu" dbalias=".c_activo_usu" initial="1" )
