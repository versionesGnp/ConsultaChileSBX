table(column=(type=char(100) update=yes updatewhereclause=yes name=v_nombre dbname="genlogin.v_nombre_usu" dbalias=".v_nombre_usu" )
 column=(type=char(100) update=yes updatewhereclause=yes name=v_password_usu dbname="genlogin.v_password_usu" dbalias=".v_password_usu" )
 column=(type=char(100) update=yes updatewhereclause=yes name=v_email_usu dbname="genlogin.v_email_usu" dbalias=".v_email_usu" )
 column=(type=char(1) update=yes updatewhereclause=yes name=c_admin_usu dbname="genlogin.c_admin_usu" dbalias=".c_admin_usu" initial="0" values="Es Administrador del Sistema	1/Es Administrador del Sistema	0" )
 column=(type=char(20) update=yes updatewhereclause=yes name=c_codigo_wks dbname="genlogin.c_codigo_wks" dbalias=".c_codigo_wks" )
 column=(type=char(100) updatewhereclause=yes name=v_xpassword dbname="genlogin.v_xpassword" dbalias=".v_xpassword" )
 column=(type=char(4000) updatewhereclause=yes name=v_confirma dbname="v_confirma" )
 column=(type=datetime update=yes updatewhereclause=yes name=d_creacion dbname="genlogin.d_creacion_usu" dbalias=".d_creacion_usu" )
 column=(type=char(20) update=yes updatewhereclause=yes name=c_usumod dbname="genlogin.c_usumod_usu" dbalias=".c_usumod_usu" )
 column=(type=datetime update=yes updatewhereclause=yes name=d_modifi dbname="genlogin.d_modifi_usu" dbalias=".d_modifi_usu" )
 column=(type=char(1) update=yes updatewhereclause=yes name=c_activo dbname="genlogin.c_activo_usu" dbalias=".c_activo_usu" initial="1" )
 column=(type=char(20) update=yes updatewhereclause=yes key=yes name=c_codigo dbname="genlogin.c_codigo_usu" dbalias=".c_codigo_usu" )
 column=(type=char(20) update=yes updatewhereclause=yes name=c_codigo_usu dbname="genlogin.c_codcrea_usu" dbalias=".c_codcrea_usu" )
 column=(type=char(2) update=yes updatewhereclause=yes name=c_codigo_tma dbname="genlogin.c_codigo_tma" dbalias=".c_codigo_tma" )
 column=(type=char(1) update=yes updatewhereclause=yes name=c_rol_usu dbname="genlogin.c_rol_usu" dbalias=".c_rol_usu" initial="0" values="Es Usuario Tipo Rol	1/Es Usuario Tipo Rol	0" )
 column=(type=char(20) update=yes updatewhereclause=yes name=c_codrol_usu dbname="genlogin.c_codrol_usu" dbalias=".c_codrol_usu" )
 column=(type=number updatewhereclause=yes name=n_usersxrol dbname="n_usersxrol" )
 column=(type=char(4) update=yes updatewhereclause=yes name=c_codigo_dep dbname="genlogin.c_codigo_dep" dbalias=".c_codigo_dep" )
 column=(type=char(2) update=yes updatewhereclause=yes name=c_codigo_emp dbname="genlogin.c_codigo_emp" dbalias=".c_codigo_emp" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"genlogin~" ) COLUMN(NAME=~"genlogin.v_nombre_usu~") COLUMN(NAME=~"genlogin.v_password_usu~") COLUMN(NAME=~"genlogin.v_email_usu~") COLUMN(NAME=~"genlogin.c_admin_usu~") COLUMN(NAME=~"genlogin.c_codigo_wks~") COMPUTE(NAME=~"v_password_usu As v_xpassword~") COMPUTE(NAME=~"Space( 100) As v_confirma~") COLUMN(NAME=~"genlogin.d_creacion_usu~") COLUMN(NAME=~"genlogin.c_usumod_usu~") COLUMN(NAME=~"genlogin.d_modifi_usu~") COLUMN(NAME=~"genlogin.c_activo_usu~") COLUMN(NAME=~"genlogin.c_codigo_usu~") COLUMN(NAME=~"genlogin.c_codcrea_usu~") COLUMN(NAME=~"genlogin.c_codigo_tma~") COLUMN(NAME=~"genlogin.c_rol_usu~") COLUMN(NAME=~"genlogin.c_codrol_usu~") COMPUTE(NAME=~"(Select Count(*) from genlogin x Where x.c_codrol_usu = :as_cod ) As n_usersxrol~") COLUMN(NAME=~"genlogin.c_codigo_dep~") COLUMN(NAME=~"genlogin.c_codigo_emp~")WHERE(    EXP1 =~"genlogin.c_codigo_usu~"   OP =~"=~"    EXP2 =~":as_cod~" ) ) ARG(NAME = ~"as_cod~" TYPE = string) " update="genlogin" updatewhere=0 updatekeyinplace=yes arguments=(("as_cod", string)) )
