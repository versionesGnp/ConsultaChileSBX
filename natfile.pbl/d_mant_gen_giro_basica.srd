table(column=(type=char(3) update=yes updatewhereclause=yes name=c_codigo_pai dbname="genGiro.c_codigo_pai" dbalias="Gir.c_codigo_pai" )
 column=(type=char(6) update=yes updatewhereclause=yes name=c_codigo dbname="genGiro.c_codigo_gir" dbalias="Gir.c_codigo_gir" )
 column=(type=char(100) update=yes updatewhereclause=yes name=v_nombre dbname="genGiro.v_nombre_gir" dbalias="Gir.v_nombre_gir" )
 column=(type=char(1) update=yes updatewhereclause=yes name=c_nivel_gir dbname="genGiro.c_nivel_gir" dbalias="Gir.c_nivel_gir" )
 column=(type=char(6) update=yes updatewhereclause=yes name=c_depende_gir dbname="genGiro.c_depende_gir" dbalias="Gir.c_depende_gir" )
 column=(type=char(1) update=yes updatewhereclause=yes name=c_activo dbname="genGiro.c_activo_gir" dbalias="Gir.c_activo_gir" values="	1/	0" )
 column=(type=char(2) updatewhereclause=yes name=c_codigo_emp dbname="genEmpresa.c_codigo_emp" dbalias="Emp.c_codigo_emp" )
 column=(type=char(1009) updatewhereclause=yes name=c_orden dbname="c_orden" )
 column=(type=char(100) updatewhereclause=yes name=v_nombre_rub dbname="v_nombre_rub" )
 retrieve="

  Select Gir.c_codigo_pai,   
         Gir.c_codigo_gir,   
         Gir.v_nombre_gir,   
         Gir.c_nivel_gir,   
         Gir.c_depende_gir,   
         Gir.c_activo_gir,   
         emp.c_codigo_emp,
         c_orden = Gir.c_codigo_pai + dbo.f_Trim( Gir.c_depende_gir ) + Gir.c_codigo_gir,  
         v_nombre_rub = Rub.v_nombre_gir
   From  genGiro     Gir    

   Join  genEmpresa  Emp
   On    Gir.c_codigo_pai = Emp.c_codigo_pai 
   
   Join  genGiro  Rub
   On    Rub.c_codigo_pai = Gir.c_codigo_pai 
   And   Rub.c_codigo_gir = Gir.c_depende_gir 
   
   Where emp.c_codigo_emp = :as_emp
   And   Gir.c_nivel_gir = '2'   
   And   Gir.c_activo_gir = '1'
   And   ( ( Gir.v_nombre_gir Like :as_txt ) Or 
           ( Rub.v_nombre_gir Like :as_txt ) Or 
           ( Gir.c_codigo_gir Like :as_txt ) )
" arguments=(("as_txt", string),("as_emp", string))  sort="c_orden A " )
