 column=(type=char(6) update=yes updatewhereclause=yes key=yes name=c_codigo dbname="gengiro.c_codigo_gir" )
 column=(type=char(100) update=yes updatewhereclause=yes name=v_nombre dbname="gengiro.v_nombre_gir" )
