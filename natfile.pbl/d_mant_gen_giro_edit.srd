 column=(type=char(2) updatewhereclause=yes name=c_codigo_emp dbname="genempresa.c_codigo_emp" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"gengiro~" )  TABLE(NAME=~"genempresa~" ) COLUMN(NAME=~"gengiro.c_codigo_pai~") COLUMN(NAME=~"gengiro.c_codigo_gir~") COLUMN(NAME=~"gengiro.v_nombre_gir~") COLUMN(NAME=~"gengiro.c_nivel_gir~") COLUMN(NAME=~"gengiro.c_depende_gir~") COLUMN(NAME=~"gengiro.c_codigo_usu~") COLUMN(NAME=~"gengiro.d_creacion_gir~") COLUMN(NAME=~"gengiro.c_usumod_gir~") COLUMN(NAME=~"gengiro.d_modifi_gir~") COLUMN(NAME=~"gengiro.c_activo_gir~") COLUMN(NAME=~"genempresa.c_codigo_emp~")    JOIN (LEFT=~"gengiro.c_codigo_pai~"    OP =~"=~"RIGHT=~"genempresa.c_codigo_pai~" )WHERE(    EXP1 =~"genempresa.c_codigo_emp~"   OP =~"=~"    EXP2 =~":as_emp~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"gengiro.c_codigo_gir~"   OP =~"=~"    EXP2 =~":as_cod~" ) ) ARG(NAME = ~"as_emp~" TYPE = string)  ARG(NAME = ~"as_cod~" TYPE = string) " update="gengiro" updatewhere=1 updatekeyinplace=no arguments=(("as_emp", string),("as_cod", string)) )
