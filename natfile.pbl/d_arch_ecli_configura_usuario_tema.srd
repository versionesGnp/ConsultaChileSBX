 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"genlogin~" ) COLUMN(NAME=~"genlogin.v_nombre_usu~") COLUMN(NAME=~"genlogin.v_password_usu~") COLUMN(NAME=~"genlogin.v_email_usu~") COLUMN(NAME=~"genlogin.c_admin_usu~") COLUMN(NAME=~"genlogin.c_codigo_wks~") COMPUTE(NAME=~"v_xpassword = v_password_usu~") COMPUTE(NAME=~"v_confirma = Space( 100)~") COLUMN(NAME=~"genlogin.d_creacion_usu~") COLUMN(NAME=~"genlogin.c_usumod_usu~") COLUMN(NAME=~"genlogin.d_modifi_usu~") COLUMN(NAME=~"genlogin.c_activo_usu~") COLUMN(NAME=~"genlogin.c_codigo_usu~") COLUMN(NAME=~"genlogin.c_codcrea_usu~") COLUMN(NAME=~"genlogin.c_codigo_tma~") COMPUTE(NAME=~"v_password_ori = v_password_usu~")WHERE(    EXP1 =~"genlogin.c_codigo_usu~"   OP =~"=~"    EXP2 =~":as_cod~" ) ) ARG(NAME = ~"as_cod~" TYPE = string) " update="genlogin" updatewhere=0 updatekeyinplace=no arguments=(("as_cod", string)) )
