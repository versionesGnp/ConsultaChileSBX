 column=(type=char(5) updatewhereclause=yes name=c_depende_sub dbname="genopcion.c_depende_sub" dbalias=".c_depende_sub" )
 column=(type=char(20) updatewhereclause=yes name=v_color_sub dbname="genopcion.v_color_sub" dbalias=".v_color_sub" )
 column=(type=char(250) updatewhereclause=yes name=v_descripcion_sub dbname="genopcion.v_descripcion_sub" dbalias=".v_descripcion_sub" )
 column=(type=char(5) updatewhereclause=yes key=yes name=c_codigo_opc dbname="genopcion.c_codigo_opc" dbalias=".c_codigo_opc" )
 column=(type=char(100) updatewhereclause=yes name=v_nombre_opc dbname="genopcion.v_nombre_opc" dbalias=".v_nombre_opc" )
 column=(type=char(1) updatewhereclause=yes name=c_nivel_opc dbname="genopcion.c_nivel_opc" dbalias=".c_nivel_opc" )
 column=(type=char(5) updatewhereclause=yes name=c_depende_opc dbname="genopcion.c_depende_opc" dbalias=".c_depende_opc" )
 column=(type=char(20) updatewhereclause=yes name=v_color_opc dbname="genopcion.v_color_opc" dbalias=".v_color_opc" )
 column=(type=char(250) updatewhereclause=yes name=v_descripcion_opc dbname="genopcion.v_descripcion_opc" dbalias=".v_descripcion_opc" )
 column=(type=char(1) updatewhereclause=yes name=c_asignado dbname="c_asignado" values="	1/	0" )
 column=(type=number updatewhereclause=yes name=n_dock_opc dbname="n_dock_opc" )
 column=(type=char(1) updatewhereclause=yes name=c_sub dbname="c_sub" values="	1/	0" )
 retrieve="Select   genopcion.c_codigo_opc c_codigo_mod,   
         genopcion.v_nombre_opc v_nombre_mod,   
         genopcion.c_nivel_opc  c_nivel_mod,   
         genopcion.v_color_opc  v_color_mod,   
         genopcion.v_descripcion_opc v_descripcion_mod,

         nivel_2.c_codigo_opc  c_codigo_sub,   
         nivel_2.v_nombre_opc  v_nombre_sub,   
         nivel_2.c_nivel_opc   c_nivel_sub,   
         nivel_2.c_depende_opc c_depende_sub,   
         nivel_2.v_color_opc   v_color_sub,   
         nivel_2.v_descripcion_opc v_descripcion_sub,

         nivel_3.c_codigo_opc  c_codigo_opc,   
         nivel_3.v_nombre_opc  v_nombre_opc,   
         nivel_3.c_nivel_opc   c_nivel_opc,   
         nivel_3.c_depende_opc c_depende_opc,   
         nivel_3.v_color_opc   v_color_opc,   
         nivel_3.v_descripcion_opc v_descripcion_opc,
         
         ( Case When ( Select Count(*) From genloginopc x Where x.c_codigo_usu = :as_usu 
                                                          And   x.c_codigo_opc = nivel_3.c_codigo_opc ) > 0 Then '1' 
                               Else '0' End ) As c_asignado,
         ( Select n_dock_opc From genloginopc x Where x.c_codigo_usu = :as_usu 
                                                          And   x.c_codigo_opc = nivel_3.c_codigo_opc ) As n_dock_opc,

         '0' As c_sub
From     genopcion 
             
Left Join   ( Select
                     c_codigo_opc,   
                     v_nombre_opc,   
                     c_nivel_opc,   
                     c_depende_opc,   
                     v_color_opc,   
                     v_descripcion_opc
              From   genopcion    
              Where  c_nivel_opc = '2' 
              And    c_eclipse_opc = '1'  ) nivel_2
On    genopcion.c_codigo_opc = nivel_2.c_depende_opc
   
Join        ( Select
                     c_codigo_opc,   
                     v_nombre_opc,   
                     c_nivel_opc,   
                     c_depende_opc,   
                     v_color_opc,   
                     v_descripcion_opc
              From   genopcion    
              Where  c_nivel_opc = '3' 
              And    c_eclipse_opc = '1'  ) nivel_3
On    nivel_2.c_codigo_opc = nivel_3.c_depende_opc

Where genopcion.c_nivel_opc = '1'
And   genopcion.c_eclipse_opc = '1'  

" update="genopcion" updatewhere=0 updatekeyinplace=no arguments=(("as_usu", string))  sort="c_codigo_mod A c_codigo_sub A c_codigo_opc A " )
