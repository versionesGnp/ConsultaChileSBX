 column=(type=char(4000) updatewhereclause=yes name=c_admrol dbname="c_admrol" values="Administrador	10/Rol	01/ 	00/Administrador//Rol	11/" )
 column=(type=number updatewhereclause=yes name=n_usersxrol dbname="n_usersxrol" )
 column=(type=char(4) updatewhereclause=yes name=c_codigo_dep dbname="genlogin.c_codigo_dep" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"genlogin~" ) COLUMN(NAME=~"genlogin.c_codigo_usu~") COLUMN(NAME=~"genlogin.v_nombre_usu~") COLUMN(NAME=~"genlogin.v_password_usu~") COLUMN(NAME=~"genlogin.v_email_usu~") COLUMN(NAME=~"genlogin.c_admin_usu~") COLUMN(NAME=~"genlogin.c_codigo_wks~") COLUMN(NAME=~"genlogin.c_codcrea_usu~") COLUMN(NAME=~"genlogin.d_creacion_usu~") COLUMN(NAME=~"genlogin.c_usumod_usu~") COLUMN(NAME=~"genlogin.d_modifi_usu~") COLUMN(NAME=~"genlogin.c_activo_usu~") COLUMN(NAME=~"genlogin.c_codigo_emp~") COLUMN(NAME=~"genlogin.d_conexion_usu~") COLUMN(NAME=~"genlogin.c_rol_usu~") COLUMN(NAME=~"genlogin.c_codrol_usu~") COMPUTE(NAME=~"Concat( fn_IsEmpty( c_admin_usu, '0' ) , fn_IsEmpty( c_rol_usu, '0' ) ) As c_admrol~") COMPUTE(NAME=~" (Select Count(*) from genlogin x Where x.c_codrol_usu = genLogin.c_codigo_usu ) As n_usersxrol~") COLUMN(NAME=~"genlogin.c_codigo_dep~")) " update="genlogin" updatewhere=0 updatekeyinplace=no  sort="c_codigo A " )
