 column=(type=char(20) update=yes updatewhereclause=yes name=c_usumod dbname="genlogin.c_usumod_usu" )
 column=(type=datetime update=yes updatewhereclause=yes name=d_modifi dbname="genlogin.d_modifi_usu" )
 column=(type=char(1) update=yes updatewhereclause=yes name=c_activo dbname="genlogin.c_activo_usu" values="Inactivo	0/	1/" )
 column=(type=char(2) update=yes updatewhereclause=yes name=c_codigo_emp dbname="genlogin.c_codigo_emp" )
 column=(type=datetime update=yes updatewhereclause=yes name=d_conexion_usu dbname="genlogin.d_conexion_usu" )
