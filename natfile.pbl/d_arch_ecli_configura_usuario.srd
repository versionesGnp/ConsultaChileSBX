table(column=(type=char(20) update=yes updatewhereclause=yes key=yes name=c_codigo dbname="genlogin.c_codigo_usu" )
 column=(type=char(100) update=yes updatewhereclause=yes name=v_nombre dbname="genlogin.v_nombre_usu" )
 column=(type=char(100) update=yes updatewhereclause=yes name=v_password_usu dbname="genlogin.v_password_usu" )
 column=(type=char(100) update=yes updatewhereclause=yes name=v_email_usu dbname="genlogin.v_email_usu" )
 column=(type=char(1) update=yes updatewhereclause=yes name=c_admin_usu dbname="genlogin.c_admin_usu" values="Administrador	1/	0/" )
