release 10.5;
datawindow(units=0 timer_interval=0 color=1073741824 processing=0 HTMLDW=no print.printername="" print.documentname="" print.orientation = 0 print.margin.left = 108 print.margin.right = 108 print.margin.top = 94 print.margin.bottom = 94 print.paper.source = 0 print.paper.size = 0 print.canusedefaultprinter=yes print.prompt=no print.buttons=no print.preview.buttons=no print.cliptext=no print.overrideprintjob=no print.collate=yes print.preview.outline=yes hidegrayline=no rows_per_detail = 2 )
header(height=279 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=230 color="536870912" )
table(column=(type=char(5) update=yes updatewhereclause=yes key=yes name=c_codigo_opc dbname="genopcion.c_codigo_opc" )
 column=(type=char(100) update=yes updatewhereclause=yes name=v_nombre_opc dbname="genopcion.v_nombre_opc" )
 column=(type=char(20) update=yes updatewhereclause=yes name=v_color_opc dbname="genopcion.v_color_opc" )
 column=(type=char(250) update=yes updatewhereclause=yes name=v_descripcion_opc dbname="genopcion.v_descripcion_opc" )
 column=(type=char(100) updatewhereclause=yes name=v_modulo dbname="v_modulo" )
 retrieve="  SELECT genopcion.c_codigo_opc,   
         genopcion.v_nombre_opc,   
         genopcion.v_color_opc,   
         genopcion.v_descripcion_opc,
         v_modulo = ( Select x.v_nombre_opc From genopcion x Where x.c_codigo_opc = genopcion.c_depende_opc )  
    FROM genopcion  
   WHERE genopcion.c_nivel_opc = :as_niv
   And   ISNull( c_depende_opc, '' ) = :as_opc
And :as_usu = :as_usu
            
" update="genopcion" updatewhere=1 updatekeyinplace=no arguments=(("as_niv", string),("as_opc", string),("as_usu", string)) )
compute(band=header alignment="0" expression="If( as_niv = '1', 'ECLIPSE - Sistema de Administración',  v_modulo[ 0] ) "border="0" color="8421504" x="156" y="84" height="157" width="2653" format="[GENERAL]" html.valueishtml="0"  name=co_titulo visible="1"  font.face="Tahoma" font.height="-24" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" )
