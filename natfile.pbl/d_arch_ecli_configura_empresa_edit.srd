 column=(type=char(100) update=yes updatewhereclause=yes name=v_representante_emp dbname="genempresa.v_representante_emp" )
 column=(type=char(3) update=yes updatewhereclause=yes name=c_codigo_pai dbname="genempresa.c_codigo_pai" )
 column=(type=char(2) update=yes updatewhereclause=yes name=c_codigo_edo dbname="genempresa.c_codigo_edo" )
 column=(type=char(5) update=yes updatewhereclause=yes name=c_codigo_loc dbname="genempresa.c_codigo_loc" )
