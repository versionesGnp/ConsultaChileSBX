 column=(type=char(1) update=yes updatewhereclause=yes name=c_mostraruf_emp dbname="genempresa.c_mostraruf_emp" values="Mostrar Unidad de Fomento (UF) en Principal	1/Mostrar Unidad de Fomento (UF) en Principal	0" )
 column=(type=char(6) updatewhereclause=yes name=c_depende_gir dbname="gengiro.c_depende_gir" )
 retrieve="  SELECT genempresa.c_codigo_emp,   
         genempresa.v_nombre_emp,   
         genempresa.v_nombrcort_emp,   
         genempresa.v_calle_emp,   
         genempresa.v_numext_emp,   
         genempresa.v_colonia_emp,   
         genempresa.v_direccion_emp,   
         genempresa.v_localidad_emp,   
         genempresa.v_municipio_emp,   
         genempresa.v_estado_emp,   
         genempresa.v_telefono1_emp,   
         genempresa.v_telefono2_emp,   
         genempresa.v_fax_emp,   
         genempresa.c_rfc_emp,   
         genempresa.v_codpos_emp,   
         genempresa.v_cfdiid_emp,   
         genempresa.v_cfdirfc_emp,   
         genempresa.v_cfdicertificado_emp,   
         genempresa.v_cfdiusuario_emp,   
         genempresa.v_cfdipassword_emp,   
         genempresa.c_codigo_usu,   
         genempresa.d_creacion_emp,   
         genempresa.c_usumod_emp,   
         genempresa.d_modifi_emp,   
         genempresa.c_activo_emp,   
         genempresa.v_representante_emp,   
         genempresa.c_codigo_pai,   
         genempresa.c_codigo_edo,   
         genempresa.c_codigo_loc,   
         genempresa.v_etiquetaclase_emp,   
         genempresa.c_codigo_tem,   
         genempresa.v_dateformat_emp,   
         genempresa.v_gerente_emp,   
         genempresa.c_codigo_gir,   
         genempresa.v_dominio_emp,   
         genempresa.c_mostrarUF_emp,   
         gengiro.c_depende_gir    
    FROM genempresa   
    
    Left Join gengiro  
    On   genempresa.c_codigo_gir = gengiro.c_codigo_gir 
    And  genempresa.c_codigo_pai = gengiro.c_codigo_pai 

    Where genempresa.c_codigo_emp = :as_cod    
" update="genempresa" updatewhere=0 updatekeyinplace=yes arguments=(("as_cod", string)) )
