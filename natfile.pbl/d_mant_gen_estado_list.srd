table(column=(type=char(3) update=yes updatewhereclause=yes key=yes name=c_codigo_pai dbname="genEstado.c_codigo_pai" )
 column=(type=char(100) updatewhereclause=yes name=v_nombre_pai dbname="genPais.v_nombre_pai" )
 column=(type=char(2) update=yes updatewhereclause=yes key=yes name=c_codigo_edo dbname="genEstado.c_codigo_edo" )
 column=(type=char(100) update=yes updatewhereclause=yes name=v_nombre dbname="genEstado.v_nombre_edo" )
 column=(type=char(20) update=yes updatewhereclause=yes name=c_codigo_usu dbname="genEstado.c_codigo_usu" )
 column=(type=datetime update=yes updatewhereclause=yes name=d_creacion_edo dbname="genEstado.d_creacion_edo" )
 column=(type=char(20) update=yes updatewhereclause=yes name=c_usumod_edo dbname="genEstado.c_usumod_edo" )
 column=(type=datetime update=yes updatewhereclause=yes name=d_modifi_edo dbname="genEstado.d_modifi_edo" )
 column=(type=char(1) update=yes updatewhereclause=yes name=c_activo dbname="genEstado.c_activo_edo" values="	1/	0" )
 column=(type=char(5) updatewhereclause=yes name=c_codigo dbname="c_codigo" )
 retrieve="  SELECT genestado.c_codigo_pai,   
         genpais.v_nombre_pai,   
         genestado.c_codigo_edo,   
         genestado.v_nombre_edo,   
         genestado.c_codigo_usu,   
         genestado.d_creacion_edo,   
         genestado.c_usumod_edo,   
         genestado.d_modifi_edo,   
         genestado.c_activo_edo,   
         Concat( genEstado.c_codigo_pai, genEstado.c_codigo_edo ) As c_codigo  
    FROM genestado,   
         genpais  
   WHERE ( genestado.c_codigo_pai = genpais.c_codigo_pai )    
" update="genestado" updatewhere=0 updatekeyinplace=no  sort="c_codigo_pai A c_codigo_edo A " )
