 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"genetiqueta~" ) COLUMN(NAME=~"genetiqueta.c_codigo_emp~") COLUMN(NAME=~"genetiqueta.c_codigo_ett~") COLUMN(NAME=~"genetiqueta.v_nombre_ett~") COLUMN(NAME=~"genetiqueta.n_color_ett~") COLUMN(NAME=~"genetiqueta.n_r_ett~") COLUMN(NAME=~"genetiqueta.n_g_ett~") COLUMN(NAME=~"genetiqueta.n_b_ett~") COLUMN(NAME=~"genetiqueta.c_codigo_usu~") COLUMN(NAME=~"genetiqueta.d_creacion_ett~") COLUMN(NAME=~"genetiqueta.c_usumod_ett~") COLUMN(NAME=~"genetiqueta.d_modifi_ett~") COLUMN(NAME=~"genetiqueta.c_activo_ett~")WHERE(    EXP1 =~"genetiqueta.c_codigo_emp~"   OP =~"=~"    EXP2 =~":as_cod~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"genetiqueta.c_codigo_ett~"   OP =~"=~"    EXP2 =~":as_cod~" ) ) ARG(NAME = ~"as_cod~" TYPE = string) " update="genetiqueta" updatewhere=0 updatekeyinplace=yes arguments=(("as_cod", string)) )
