table(column=(type=char(20) update=yes updatewhereclause=yes key=yes name=c_codigo_wks dbname="genworkstation.c_codigo_wks" )
 column=(type=char(2) update=yes updatewhereclause=yes name=c_codigo_epq dbname="genworkstation.c_codigo_epq" )
 column=(type=char(10) update=yes updatewhereclause=yes name=c_prefijopalet_wks dbname="genworkstation.c_prefijopalet_wks" )
 column=(type=char(2) updatewhereclause=yes name=c_codigo_tem dbname="c_codigo_tem" )
 column=(type=char(2) update=yes updatewhereclause=yes name=c_codigo_caj dbname="genworkstation.c_codigo_caj" )
 column=(type=char(1) update=yes updatewhereclause=yes name=c_posactivo_wks dbname="genworkstation.c_posactivo_wks" values="	1/	0" )
 column=(type=char(1) update=yes updatewhereclause=yes name=c_imprimir_wks dbname="genworkstation.c_imprimir_wks" initial="1" values="	1/	0" )
 column=(type=char(20) update=yes updatewhereclause=yes name=c_codigo_usu dbname="genworkstation.c_codigo_usu" )
 column=(type=datetime update=yes updatewhereclause=yes name=d_creacion dbname="genworkstation.d_creacion_wks" )
 column=(type=char(20) update=yes updatewhereclause=yes name=c_usumod dbname="genworkstation.c_usumod_wks" )
 column=(type=datetime update=yes updatewhereclause=yes name=d_modifi dbname="genworkstation.d_modifi_wks" )
