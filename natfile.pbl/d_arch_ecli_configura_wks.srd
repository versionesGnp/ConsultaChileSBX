 column=(type=char(2000) update=yes updatewhereclause=yes name=v_urlservice_wks dbname="genworkstation.v_urlservice_wks" )
 column=(type=char(5) update=yes updatewhereclause=yes name=c_posmetodo_wks dbname="genworkstation.c_posmetodo_wks" values="Local Host	LHOST/TNCAS	TNCAS/" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=n_possecuencia_wks dbname="genworkstation.n_possecuencia_wks" )
 column=(type=char(2000) update=yes updatewhereclause=yes name=v_urlheader_wks dbname="genworkstation.v_urlheader_wks" )
 column=(type=char(2000) update=yes updatewhereclause=yes name=v_urlvalue_wks dbname="genworkstation.v_urlvalue_wks" )
 column=(type=number update=yes updatewhereclause=yes name=n_timeoutseconds_wks dbname="genworkstation.n_timeoutseconds_wks" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"genWorkstation~" ) COLUMN(NAME=~"genWorkstation.c_codigo_wks~") COLUMN(NAME=~"genWorkstation.c_codigo_epq~") COLUMN(NAME=~"genWorkstation.c_prefijopalet_wks~") COMPUTE(NAME=~" '01' As c_codigo_tem~") COLUMN(NAME=~"genWorkstation.c_codigo_caj~") COLUMN(NAME=~"genWorkstation.c_posactivo_wks~") COLUMN(NAME=~"genWorkstation.c_imprimir_wks~") COLUMN(NAME=~"genWorkstation.c_codigo_usu~") COLUMN(NAME=~"genWorkstation.d_creacion_wks~") COLUMN(NAME=~"genWorkstation.c_usumod_wks~") COLUMN(NAME=~"genWorkstation.d_modifi_wks~") COLUMN(NAME=~"genWorkstation.c_activo_wks~") COMPUTE(NAME=~" '01' As c_codigo_emp~") COLUMN(NAME=~"genWorkstation.v_urlservice_wks~") COLUMN(NAME=~"genWorkstation.c_posmetodo_wks~") COLUMN(NAME=~"genWorkstation.n_possecuencia_wks~") COLUMN(NAME=~"genWorkstation.v_urlheader_wks~") COLUMN(NAME=~"genWorkstation.v_urlvalue_wks~") COLUMN(NAME=~"genWorkstation.n_timeoutseconds_wks~")) " update="genWorkstation" updatewhere=0 updatekeyinplace=yes )
