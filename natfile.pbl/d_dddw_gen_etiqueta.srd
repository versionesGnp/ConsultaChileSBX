table(column=(type=char(2) update=yes updatewhereclause=yes key=yes name=c_codigo_ett dbname="genetiqueta.c_codigo_ett" )
 column=(type=char(500) update=yes updatewhereclause=yes name=v_nombre_ett dbname="v_nombre_ett" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=n_r_ett dbname="genetiqueta.n_r_ett" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=n_g_ett dbname="genetiqueta.n_g_ett" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=n_b_ett dbname="genetiqueta.n_b_ett" )
 retrieve="  SELECT c_codigo_ett,   
         v_nombre_ett = dbo.fn_WordCap( v_nombre_ett ),   
         n_r_ett,   
         n_g_ett,   
         n_b_ett  
    FROM genetiqueta  
   WHERE c_activo_ett = '1'    
" update="genetiqueta" updatewhere=1 updatekeyinplace=no )
