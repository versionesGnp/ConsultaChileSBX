 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cliente~" )  TABLE(NAME=~"cod_parq~" )  TABLE(NAME=~"derecho~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"estado_envio~" )  TABLE(NAME=~"cadena_mora~" ) COLUMN(NAME=~"cod_parq.nombre~") COLUMN(NAME=~"cod_parq.ciudad~") COLUMN(NAME=~"cliente.rut~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cliente.direccion_p~") COLUMN(NAME=~"cliente.comuna~") COLUMN(NAME=~"cliente.ciudad~") COLUMN(NAME=~"cliente.fono_p~") COLUMN(NAME=~"derecho.serie_p~") COLUMN(NAME=~"derecho.nro_pagare~") COLUMN(NAME=~"derecho.fecha~") COLUMN(NAME=~"derecho.serie~") COLUMN(NAME=~"derecho.nro_oferta~") COLUMN(NAME=~"derecho.kapital~") COLUMN(NAME=~"derecho.tasa~") COLUMN(NAME=~"derecho.valor_cuo~") COLUMN(NAME=~"derecho.fecha_prim~") COLUMN(NAME=~"derecho.fecha_ult~") COLUMN(NAME=~"derecho.plazo~") COLUMN(NAME=~"derecho.tot_pagado~") COLUMN(NAME=~"derecho.pie_pagado~") COLUMN(NAME=~"derecho.cta_pag_la~") COLUMN(NAME=~"derecho.cta_pag_isa~") COLUMN(NAME=~"derecho.abono_pag~") COLUMN(NAME=~"derecho.estado~") COLUMN(NAME=~"derecho.dueno~") COLUMN(NAME=~"derecho.moneda~") COLUMN(NAME=~"derecho.sepultura~") COLUMN(NAME=~"derecho.pie~") COLUMN(NAME=~"cliente.estado_titular~") COLUMN(NAME=~"derecho.base~") COLUMN(NAME=~"derecho.sector~") COLUMN(NAME=~"cliente.tipo_via~") COLUMN(NAME=~"cliente.numero_particular~") COLUMN(NAME=~"cliente.depto_particular~") COLUMN(NAME=~"cliente.block_particular~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"cliente.tipo_cliente~") COLUMN(NAME=~"cadena.cod_parque~") COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"cadena.serie~") COLUMN(NAME=~"cadena.numero~") COLUMN(NAME=~"cliente.lat_geo~") COLUMN(NAME=~"cliente.lon_geo~") COLUMN(NAME=~"cliente.status_geo~") COLUMN(NAME=~"cadena.estado_carta~") COLUMN(NAME=~"estado_envio.descripcion~") COLUMN(NAME=~"cliente.estado_cobranza~") COLUMN(NAME=~"cadena_mora.mora_cred~") COLUMN(NAME=~"cadena_mora.dias_mora_cred~") COLUMN(NAME=~"cadena_mora.fecha_venc_cred~") COLUMN(NAME=~"cadena.objeto_id~") COLUMN(NAME=~"cadena.objeto_id_estado~") COLUMN(NAME=~"cadena.estado_mora_credito~") COLUMN(NAME=~"cadena.estado_mora_mantencion~")    JOIN (LEFT=~"derecho.rut~"    OP =~"=~"RIGHT=~"cliente.rut~"    OUTER1 =~"derecho.rut~" )    JOIN (LEFT=~"cadena.estado_carta~"    OP =~"=~"RIGHT=~"estado_envio.codigo_num~"    OUTER1 =~"cadena.estado_carta~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"cadena_mora.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"cadena_mora.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"cadena_mora.numero~" )    JOIN (LEFT=~"derecho.serie_p~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"derecho.nro_pagare~"    OP =~"=~"RIGHT=~"cadena.numero~" )    JOIN (LEFT=~"cod_parq.codigo~"    OP =~"=~"RIGHT=~"derecho.parque~" )WHERE(    EXP1 =~"~~~"DERECHO~~~".~~~"SERIE_P~~~"~"   OP =~"=~"    EXP2 =~":as_serie~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"DERECHO~~~".~~~"NRO_PAGARE~~~"~"   OP =~"=~"    EXP2 =~":an_numero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'D'~" ) ) ARG(NAME = ~"as_serie~" TYPE = string)  ARG(NAME = ~"an_numero~" TYPE = number) " arguments=(("as_serie", string),("an_numero", number)) )
