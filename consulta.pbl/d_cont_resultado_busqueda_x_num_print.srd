table(column=(type=char(1) updatewhereclause=yes name=cadena_codigo dbname="cadena.codigo" )
 column=(type=char(1) updatewhereclause=yes name=cadena_serie dbname="cadena.serie" )
 column=(type=decimal(4) updatewhereclause=yes name=cadena_numero dbname="cadena.numero" )
 column=(type=char(1) updatewhereclause=yes name=cadena_estado dbname="cadena.estado" )
 column=(type=char(15) updatewhereclause=yes name=cliente_a_paterno dbname="cliente.a_paterno" )
 column=(type=char(15) updatewhereclause=yes name=cliente_a_materno dbname="cliente.a_materno" )
 column=(type=char(20) updatewhereclause=yes name=cliente_nombre dbname="cliente.nombre" )
 column=(type=decimal(4) updatewhereclause=yes name=cliente_rut dbname="cliente.rut" )
 column=(type=char(1) updatewhereclause=yes name=cliente_dv dbname="cliente.dv" )
 column=(type=decimal(4) updatewhereclause=yes name=cadena_cod_parque dbname="cadena.cod_parque" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cadena~" )  TABLE(NAME=~"cliente~" ) COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"cadena.serie~") COLUMN(NAME=~"cadena.numero~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.rut~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"cadena.cod_parque~")    JOIN (LEFT=~"cadena.rut~"    OP =~"=~"RIGHT=~"cliente.rut~"    OUTER1 =~"cadena.rut~" )WHERE(    EXP1 =~"( ( ~~~"CADENA~~~".~~~"RUT~~~"~"   OP =~"=~"    EXP2 =~":rutx ) )~" ) ) ARG(NAME = ~"rutx~" TYPE = number) " arguments=(("rutx", number))  sort="cadena_codigo A cadena_serie A cadena_numero A " )
