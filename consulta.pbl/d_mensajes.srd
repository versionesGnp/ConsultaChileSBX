 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cliente~" ) COLUMN(NAME=~"cliente.rut~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"cliente.tipo~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cliente.direccion_p~") COLUMN(NAME=~"cliente.poblacion~") COLUMN(NAME=~"cliente.sector~") COLUMN(NAME=~"cliente.comuna~") COLUMN(NAME=~"cliente.ciudad~") COLUMN(NAME=~"cliente.fono_p~") COLUMN(NAME=~"cliente.sexo~") COLUMN(NAME=~"cliente.fecha_nac~") COLUMN(NAME=~"cliente.esta_civil~") COLUMN(NAME=~"cliente.domicilio_c~") COLUMN(NAME=~"cliente.fono_c~") COLUMN(NAME=~"cliente.fecha_ingr~") COLUMN(NAME=~"cliente.total_rent~") COLUMN(NAME=~"cliente.grupo_f~") COLUMN(NAME=~"cliente.tipo_via~") COLUMN(NAME=~"cliente.numero_particular~") COLUMN(NAME=~"cliente.depto_particular~") COLUMN(NAME=~"cliente.block_particular~")WHERE(    EXP1 =~"~~~"CLIENTE~~~".~~~"RUT~~~"~"   OP =~"=~"    EXP2 =~":an_rut~" ) ) ARG(NAME = ~"an_rut~" TYPE = number) " update="CLIENTE" updatewhere=0 updatekeyinplace=yes arguments=(("an_rut", number)) )
