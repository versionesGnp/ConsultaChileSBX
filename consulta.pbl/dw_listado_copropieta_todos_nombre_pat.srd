 column=(type=char(1) updatewhereclause=yes name=cadena_codigo dbname="cadena.codigo" values="Promesa	O/Contrato IsaCruz	C/" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"co_prop~" )  TABLE(NAME=~"cadena~" ) COLUMN(NAME=~"co_prop.serie~") COLUMN(NAME=~"co_prop.nro_oferta~") COLUMN(NAME=~"co_prop.rut~") COLUMN(NAME=~"co_prop.nombre~") COLUMN(NAME=~"co_prop.a_paterno~") COLUMN(NAME=~"co_prop.a_materno~") COLUMN(NAME=~"cadena.codigo~")    JOIN (LEFT=~"co_prop.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"co_prop.nro_oferta~"    OP =~"=~"RIGHT=~"cadena.numero~" )WHERE(    EXP1 =~"~~~"CO_PROP~~~".~~~"NOMBRE~~~"~"   OP =~"like~"    EXP2 =~":as_nombre~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CO_PROP~~~".~~~"A_PATERNO~~~"~"   OP =~"like~"    EXP2 =~":as_ape_pat~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'O'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'C')~" ) )    UNION (PBSELECT( VERSION(400) TABLE(NAME=~"coprop_isacruz~" )  TABLE(NAME=~"cadena~" ) COLUMN(NAME=~"coprop_isacruz.serie~") COLUMN(NAME=~"coprop_isacruz.numero~") COLUMN(NAME=~"coprop_isacruz.rut~") COLUMN(NAME=~"coprop_isacruz.nombres~") COLUMN(NAME=~"coprop_isacruz.apaterno~") COLUMN(NAME=~"coprop_isacruz.amaterno~") COLUMN(NAME=~"cadena.codigo~")    JOIN (LEFT=~"coprop_isacruz.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"coprop_isacruz.numero~"    OP =~"=~"RIGHT=~"cadena.numero~" )WHERE(    EXP1 =~"~~~"COPROP_ISACRUZ~~~".~~~"NOMBRES~~~"~"   OP =~"like~"    EXP2 =~":as_nombre~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"COPROP_ISACRUZ~~~".~~~"APATERNO~~~"~"   OP =~"like~"    EXP2 =~":as_ape_pat~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'O'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'C')~" ) )) ARG(NAME = ~"as_nombre~" TYPE = string)  ARG(NAME = ~"as_ape_pat~" TYPE = string) " arguments=(("as_nombre", string),("as_ape_pat", string))  sort="a_paterno A a_materno A nombre A " )
