 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cadena~" )  TABLE(NAME=~"cliente~" )  TABLE(NAME=~"vista_buscar_ejecutivos_ctto~" ) COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"cadena.serie~") COLUMN(NAME=~"cadena.numero~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.rut~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"cadena.cod_parque~") COLUMN(NAME=~"vista_buscar_ejecutivos_ctto.cod_age~") COLUMN(NAME=~"vista_buscar_ejecutivos_ctto.cod_sup~") COLUMN(NAME=~"vista_buscar_ejecutivos_ctto.cod_jefe~")    JOIN (LEFT=~"cadena.rut~"    OP =~"=~"RIGHT=~"cliente.rut~"    OUTER2 =~"cliente.rut~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"vista_buscar_ejecutivos_ctto.base~"    OUTER1 =~"cadena.codigo~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"vista_buscar_ejecutivos_ctto.serie~"    OUTER1 =~"cadena.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"vista_buscar_ejecutivos_ctto.numero~"    OUTER1 =~"cadena.numero~" )WHERE(    EXP1 =~"~~~"CLIENTE~~~".~~~"A_PATERNO~~~"~"   OP =~"like~"    EXP2 =~":as_apellido_paterno~" ) ) ORDER(NAME=~"cliente.nombre~" ASC=yes ) ARG(NAME = ~"as_apellido_paterno~" TYPE = string) " arguments=(("as_apellido_paterno", string))  sort="cliente_a_paterno A cliente_a_materno A cliente_nombre A cadena_codigo A cadena_serie A cadena_numero A " )
