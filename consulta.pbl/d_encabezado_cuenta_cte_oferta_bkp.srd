ra_credito~") COLUMN(NAME=~"cadena.estado_mora_mantencion~") COLUMN(NAME=~"oferta_v.estado_beneficio~")    JOIN (LEFT=~"oferta_v.rut~"    OP =~"=~"RIGHT=~"cliente.rut~"    OUTER1 =~"oferta_v.rut~" )    JOIN (LEFT=~"oferta_v.cod_age~"    OP =~"=~"RIGHT=~"agentes.cod_age~"    OUTER1 =~"oferta_v.cod_age~" )    JOIN (LEFT=~"oferta_v.cod_sup~"    OP =~"=~"RIGHT=~"supervisor.cod_sup~"    OUTER1 =~"oferta_v.cod_sup~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"vista_existe_en_fosa_comun.base~"    OUTER1 =~"cadena.codigo~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"vista_existe_en_fosa_comun.serie~"    OUTER1 =~"cadena.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"vista_existe_en_fosa_comun.numero~"    OUTER1 =~"cadena.numero~" )    JOIN (LEFT=~"oferta_v.cod_convenio~"    OP =~"=~"RIGHT=~"convenio_retiro.cod_convenio~"    OUTER1 =~"oferta_v.cod_convenio~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"cadena_mora.serie~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"cadena_mora.base~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"cadena_mora.numero~" )    JOIN (LEFT=~"oferta_v.serie~"    OP =~"=~"RIGHT=~"pago_oferta.serie~" )    JOIN (LEFT=~"oferta_v.nro_oferta~"    OP =~"=~"RIGHT=~"pago_oferta.nro_oferta~" )    JOIN (LEFT=~"oferta_v.ult_folio~"    OP =~"=~"RIGHT=~"pago_oferta.folio~" )    JOIN (LEFT=~"oferta_v.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"oferta_v.nro_oferta~"    OP =~"=~"RIGHT=~"cadena.numero~" )WHERE(    EXP1 =~"~~~"OFERTA_V~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":as_serie~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"OFERTA_V~~~".~~~"NRO_OFERTA~~~"~"   OP =~"=~"    EXP2 =~":an_numero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'O'~" ) ) ARG(NAME = ~"as_serie~" TYPE = string)  ARG(NAME = ~"an_numero~" TYPE = number) " arguments=(("as_serie", string),("an_numero", number)) )
