table(column=(type=char(1) update=yes updatewhereclause=yes name=base dbname="carta_log.base" )
 column=(type=char(1) update=yes updatewhereclause=yes name=serie dbname="carta_log.serie" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=numero dbname="carta_log.numero" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=rut dbname="carta_log.rut" )
 column=(type=char(3) update=yes updatewhereclause=yes name=cod_envio dbname="carta_log.cod_envio" )
 column=(type=char(3) update=yes updatewhereclause=yes name=estado_env dbname="carta_log.estado_env" )
 column=(type=datetime update=yes updatewhereclause=yes name=fecha_carta dbname="carta_log.fecha_carta" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=mora dbname="carta_log.mora" )
 column=(type=decimal(4) updatewhereclause=yes name=cod_accion dbname="carta_log.cod_accion" )
 column=(type=char(20) updatewhereclause=yes name=cod_parq_nombre dbname="cod_parq.nombre" )
 column=(type=char(15) updatewhereclause=yes name=carta_log_usuario dbname="carta_log.usuario" )
 column=(type=char(10) updatewhereclause=yes name=carta_log_clasificacion dbname="carta_log.clasificacion" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"carta_log~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"cod_parq~" ) COLUMN(NAME=~"carta_log.base~") COLUMN(NAME=~"carta_log.serie~") COLUMN(NAME=~"carta_log.numero~") COLUMN(NAME=~"carta_log.rut~") COLUMN(NAME=~"carta_log.cod_envio~") COLUMN(NAME=~"carta_log.estado_env~") COLUMN(NAME=~"carta_log.fecha_carta~") COLUMN(NAME=~"carta_log.mora~") COLUMN(NAME=~"carta_log.cod_accion~") COLUMN(NAME=~"cod_parq.nombre~") COLUMN(NAME=~"carta_log.usuario~") COLUMN(NAME=~"carta_log.clasificacion~")    JOIN (LEFT=~"carta_log.base~"    OP =~"=~"RIGHT=~"cadena.codigo~" )    JOIN (LEFT=~"carta_log.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"carta_log.numero~"    OP =~"=~"RIGHT=~"cadena.numero~" )    JOIN (LEFT=~"cadena.cod_parque~"    OP =~"=~"RIGHT=~"cod_parq.codigo~" )WHERE(    EXP1 =~"~~~"CARTA_LOG~~~".~~~"RUT~~~"~"   OP =~"=~"    EXP2 =~":rut~" ) ) ARG(NAME = ~"rut~" TYPE = number) " arguments=(("rut", number))  sort="fecha_carta D " )
