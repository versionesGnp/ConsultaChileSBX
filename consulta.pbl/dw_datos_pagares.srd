 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cliente~" )  TABLE(NAME=~"pagare~" )  TABLE(NAME=~"contrato~" )  TABLE(NAME=~"convenio_retiro~" ) COLUMN(NAME=~"cliente.rut~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cliente.direccion_p~") COLUMN(NAME=~"cliente.fono_p~") COLUMN(NAME=~"cliente.fono_c~") COLUMN(NAME=~"pagare.serie_p~") COLUMN(NAME=~"pagare.nro_pagare~") COLUMN(NAME=~"pagare.fecha~") COLUMN(NAME=~"pagare.tasa~") COLUMN(NAME=~"pagare.valor_cuo~") COLUMN(NAME=~"pagare.fecha_prim~") COLUMN(NAME=~"pagare.fecha_ult~") COLUMN(NAME=~"pagare.plazo~") COLUMN(NAME=~"pagare.tot_pagado~") COLUMN(NAME=~"pagare.pie_pagado~") COLUMN(NAME=~"pagare.cta_pag_la~") COLUMN(NAME=~"pagare.cta_pag_isa~") COLUMN(NAME=~"pagare.fechas_ingreso~") COLUMN(NAME=~"pagare.sector~") COLUMN(NAME=~"pagare.sepultura~") COLUMN(NAME=~"cliente.estado_cobranza~") COLUMN(NAME=~"cliente.fecha_cobranza~") COLUMN(NAME=~"cliente.glosa_cobranza~") COLUMN(NAME=~"cliente.tipo_via~") COLUMN(NAME=~"cliente.numero_particular~") COLUMN(NAME=~"cliente.depto_particular~") COLUMN(NAME=~"cliente.block_particular~") COLUMN(NAME=~"contrato.cod_convenio~") COLUMN(NAME=~"convenio_retiro.glosa~") COLUMN(NAME=~"convenio_retiro.vigencia_descripcion~") COLUMN(NAME=~"pagare.parque~") COLUMN(NAME=~"pagare.base~")    JOIN (LEFT=~"cliente.rut~"    OP =~"=~"RIGHT=~"pagare.rut~"    OUTER2 =~"pagare.rut~" )    JOIN (LEFT=~"pagare.serie~"    OP =~"=~"RIGHT=~"contrato.serie_c~"    OUTER1 =~"pagare.serie~" )    JOIN (LEFT=~"pagare.nro_oferta~"    OP =~"=~"RIGHT=~"contrato.nro_contrato~"    OUTER1 =~"pagare.nro_oferta~" )    JOIN (LEFT=~"contrato.cod_convenio~"    OP =~"=~"RIGHT=~"convenio_retiro.cod_convenio~"    OUTER1 =~"contrato.cod_convenio~" )WHERE(    EXP1 =~"~~~"PAGARE~~~".~~~"SERIE_P~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"PAGARE~~~".~~~"NRO_PAGARE~~~"~"   OP =~"=~"    EXP2 =~":numero~" ) ) ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number) " arguments=(("serie", string),("numero", number)) )
