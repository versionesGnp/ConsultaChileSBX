 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"fallecidos~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"cliente~" ) COLUMN(NAME=~"fallecidos.rut~") COLUMN(NAME=~"fallecidos.ap_paterno~") COLUMN(NAME=~"fallecidos.ap_materno~") COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"cadena.serie~") COLUMN(NAME=~"cadena.numero~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.rut~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"fallecidos.nombres~") COLUMN(NAME=~"fallecidos.llave~") COLUMN(NAME=~"fallecidos.sector~") COLUMN(NAME=~"fallecidos.n_sep~") COLUMN(NAME=~"fallecidos.nivel~") COLUMN(NAME=~"fallecidos.n_tec~") COLUMN(NAME=~"cadena.cod_parque~")    JOIN (LEFT=~"cadena.rut~"    OP =~"=~"RIGHT=~"cliente.rut~"    OUTER1 =~"cadena.rut~" )    JOIN (LEFT=~"fallecidos.base~"    OP =~"=~"RIGHT=~"cadena.codigo~"    OUTER1 =~"fallecidos.base~" )    JOIN (LEFT=~"fallecidos.ss~"    OP =~"=~"RIGHT=~"cadena.serie~"    OUTER1 =~"fallecidos.ss~" )    JOIN (LEFT=~"fallecidos.contrato~"    OP =~"=~"RIGHT=~"cadena.numero~"    OUTER1 =~"fallecidos.contrato~" )WHERE(    EXP1 =~"~~~"FALLECIDOS~~~".~~~"RUT~~~"~"   OP =~"=~"    EXP2 =~":rutx ~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"(~~~"FALLECIDOS~~~".~~~"NOMBRES~~~"~"   OP =~"like~"    EXP2 =~":as_nombres~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FALLECIDOS~~~".~~~"AP_PATERNO~~~"~"   OP =~"like~"    EXP2 =~":as_apaterno~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FALLECIDOS~~~".~~~"AP_MATERNO~~~"~"   OP =~"like~"    EXP2 =~":as_amaterno~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FALLECIDOS~~~".~~~"SECTOR~~~"~"   OP =~"like~"    EXP2 =~":as_sector~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FALLECIDOS~~~".~~~"N_SEP~~~"~"   OP =~"like~"    EXP2 =~":as_sepultura~"    LOGIC =~"and~" ) WHERE(    EXP1 =~":rutx~"   OP =~"=~"    EXP2 =~"0)~" ) ) ORDER(NAME=~"fallecidos.ap_paterno~" ASC=yes )  ORDER(NAME=~"fallecidos.ap_materno~" ASC=yes )  ORDER(NAME=~"fallecidos.nombres~" ASC=yes ) ARG(NAME = ~"rutx~" TYPE = number)  ARG(NAME = ~"as_nombres~" TYPE = string)  ARG(NAME = ~"as_apaterno~" TYPE = string)  ARG(NAME = ~"as_amaterno~" TYPE = string)  ARG(NAME = ~"as_sector~" TYPE = string)  ARG(NAME = ~"as_sepultura~" TYPE = string) " arguments=(("rutx", number),("as_nombres", string),("as_apaterno", string),("as_amaterno", string),("as_sector", string),("as_sepultura", string))  sort="cadena_codigo A cadena_serie A cadena_numero A " )
