table(column=(type=decimal(4) updatewhereclause=yes name=rut dbname="atencion_log.rut" )
 column=(type=char(10) updatewhereclause=yes name=estado dbname="atencion_log.estado" )
 column=(type=datetime updatewhereclause=yes name=fecha dbname="atencion_log.fecha" )
 column=(type=char(500) updatewhereclause=yes name=glosa dbname="atencion_log.glosa" )
 column=(type=char(15) updatewhereclause=yes name=usuario dbname="atencion_log.usuario" )
 column=(type=char(1) updatewhereclause=yes name=base dbname="atencion_log.base" )
 column=(type=char(1) updatewhereclause=yes name=serie dbname="atencion_log.serie" )
 column=(type=decimal(4) updatewhereclause=yes name=numero dbname="atencion_log.numero" )
 column=(type=char(20) updatewhereclause=yes name=cod_parq_nombre dbname="cod_parq.nombre" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"atencion_log~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"cod_parq~" ) COLUMN(NAME=~"atencion_log.rut~") COLUMN(NAME=~"atencion_log.estado~") COLUMN(NAME=~"atencion_log.fecha~") COLUMN(NAME=~"atencion_log.glosa~") COLUMN(NAME=~"atencion_log.usuario~") COLUMN(NAME=~"atencion_log.base~") COLUMN(NAME=~"atencion_log.serie~") COLUMN(NAME=~"atencion_log.numero~") COLUMN(NAME=~"cod_parq.nombre~")    JOIN (LEFT=~"atencion_log.base~"    OP =~"=~"RIGHT=~"cadena.codigo~" )    JOIN (LEFT=~"atencion_log.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"atencion_log.numero~"    OP =~"=~"RIGHT=~"cadena.numero~" )    JOIN (LEFT=~"cadena.cod_parque~"    OP =~"=~"RIGHT=~"cod_parq.codigo~" )WHERE(    EXP1 =~"~~~"ATENCION_LOG~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"ATENCION_LOG~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"ATENCION_LOG~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number) " arguments=(("base", string),("serie", string),("numero", number))  sort="fecha D " )
