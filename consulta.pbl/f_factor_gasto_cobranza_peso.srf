global type f_factor_gasto_cobranza_peso from function_object
end type

forward prototypes
global function double f_factor_gasto_cobranza_peso ()
end prototypes

global function double f_factor_gasto_cobranza_peso ();Double	ld_factor_gc

SELECT DISTINCT MAX("INTERES_CUOTAS"."FACTOR_GC_PESO") 
INTO 		:ld_factor_gc  
FROM 		"INTERES_CUOTAS"  
using		sqlca;
if date(gdt_fec_sistema) >= date('01/10/2013') then
	ld_factor_gc		= 0
end if
return 	ld_factor_gc
end function

