table(column=(type=decimal(4) updatewhereclause=yes name=folio dbname="ingreso.folio" )
 column=(type=char(2) updatewhereclause=yes name=tipo_cob dbname="ingreso.tipo_cob" )
 column=(type=datetime updatewhereclause=yes name=fecha_pago dbname="ingreso.fecha_pago" )
 column=(type=char(2) updatewhereclause=yes name=tipo_mov dbname="ingreso.tipo_mov" )
 column=(type=decimal(2) updatewhereclause=yes name=cuotas_pag dbname="ingreso.cuotas_pag" )
 column=(type=decimal(4) updatewhereclause=yes name=monto dbname="ingreso.monto" )
 column=(type=char(1) updatewhereclause=yes name=pago_hist dbname="ingreso.pago_hist" )
 column=(type=decimal(4) updatewhereclause=yes name=valor_uf dbname="ingreso.valor_uf" )
 column=(type=char(10) updatewhereclause=yes name=cod_pago_descripcion dbname="cod_pago.descripcion" )
 column=(type=char(7) updatewhereclause=yes name=cod_movi_sigla dbname="cod_movi.sigla" )
 column=(type=char(2) updatewhereclause=yes name=ingreso_cod_caja dbname="ingreso.cod_caja" )
 column=(type=char(5) updatewhereclause=yes name=ingreso_codigo_otro dbname="ingreso.codigo_otro" )
 column=(type=datetime updatewhereclause=yes name=ingreso_fecha_sistema dbname="ingreso.fecha_sistema" )
 column=(type=char(15) updatewhereclause=yes name=ingreso_viene_de dbname="ingreso.viene_de" )
 column=(type=decimal(4) updatewhereclause=yes name=ingreso_nro_cupon dbname="ingreso.nro_cupon" )
 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"ingreso~" )  TABLE(NAME=~"cod_movi~" )  TABLE(NAME=~"cod_pago~" ) COLUMN(NAME=~"ingreso.folio~") COLUMN(NAME=~"ingreso.tipo_cob~") COLUMN(NAME=~"ingreso.fecha_pago~") COLUMN(NAME=~"ingreso.tipo_mov~") COLUMN(NAME=~"ingreso.cuotas_pag~") COLUMN(NAME=~"ingreso.monto~") COLUMN(NAME=~"ingreso.pago_hist~") COLUMN(NAME=~"ingreso.valor_uf~") COLUMN(NAME=~"cod_pago.descripcion~") COLUMN(NAME=~"cod_movi.sigla~") COLUMN(NAME=~"ingreso.cod_caja~") COLUMN(NAME=~"ingreso.codigo_otro~") COLUMN(NAME=~"ingreso.fecha_sistema~") COLUMN(NAME=~"ingreso.viene_de~") COLUMN(NAME=~"ingreso.nro_cupon~")    JOIN (LEFT=~"ingreso.tipo_cob~"    OP =~"=~"RIGHT=~"cod_pago.tipo_cob~"    OUTER1 =~"ingreso.tipo_cob~" )    JOIN (LEFT=~"ingreso.tipo_mov~"    OP =~"=~"RIGHT=~"cod_movi.cod_ing~"    OUTER1 =~"ingreso.tipo_mov~" )WHERE(    EXP1 =~"( ( ~~~"INGRESO~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":as_serie )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"INGRESO~~~".~~~"CONTRATO~~~"~"   OP =~"=~"    EXP2 =~":an_numero )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"INGRESO~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":as_base ) )~" ) ) ORDER(NAME=~"ingreso.fecha_pago~" ASC=yes ) ARG(NAME = ~"as_serie~" TYPE = string)  ARG(NAME = ~"an_numero~" TYPE = number)  ARG(NAME = ~"as_base~" TYPE = string) " arguments=(("as_serie", string),("an_numero", number),("as_base", string))  sort="fecha_pago D folio A tipo_mov A " )
