 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cadena~" )  TABLE(NAME=~"oferta_v~" )  TABLE(NAME=~"pago_oferta~" )  TABLE(NAME=~"estado~" )  TABLE(NAME=~"convenio_retiro~" )  TABLE(NAME=~"mpproducto~" ) COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"oferta_v.ult_folio~") COLUMN(NAME=~"cadena.fecha_res~") COLUMN(NAME=~"cadena.nro_carta~") COLUMN(NAME=~"cadena.fecha_carta~") COLUMN(NAME=~"cadena.estado_carta~") COLUMN(NAME=~"oferta_v.cta_pag_s~") COLUMN(NAME=~"pago_oferta.nro_cuotas~") COLUMN(NAME=~"oferta_v.estado_comi~") COLUMN(NAME=~"oferta_v.fecha_com~") COLUMN(NAME=~"cadena.estado_titulo~") COLUMN(NAME=~"cadena.fecha_titulo~") COLUMN(NAME=~"estado.nombre_estado~") COLUMN(NAME=~"oferta_v.estado_seguro~") COLUMN(NAME=~"oferta_v.ult_fecha_seg~") COLUMN(NAME=~"oferta_v.fecha_ingreso~") COLUMN(NAME=~"cadena.cod_parque~") COLUMN(NAME=~"oferta_v.anexo_aumento~") COLUMN(NAME=~"oferta_v.cta_aumento~") COLUMN(NAME=~"oferta_v.descuento_por~") COLUMN(NAME=~"oferta_v.tipo_descuento~") COLUMN(NAME=~"oferta_v.promocion~") COLUMN(NAME=~"oferta_v.anexo_dacion~") COLUMN(NAME=~"oferta_v.anexo_repacta~") COLUMN(NAME=~"oferta_v.cta_repacta~") COLUMN(NAME=~"oferta_v.anexo_lib~") COLUMN(NAME=~"oferta_v.cod_convenio~") COLUMN(NAME=~"convenio_retiro.glosa~") COLUMN(NAME=~"oferta_v.clasifica_venta~") COLUMN(NAME=~"cadena.estado_mora_credito~") COLUMN(NAME=~"cadena.estado_mora_mantencion~") COLUMN(NAME=~"oferta_v.beneficio_complementario~") COLUMN(NAME=~"oferta_v.estado_beneficio~") COLUMN(NAME=~"mpproducto.codigomp~") COLUMN(NAME=~"mpproducto.nombremp~") COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"cadena.serie~") COLUMN(NAME=~"cadena.numero~")    JOIN (LEFT=~"oferta_v.cod_convenio~"    OP =~"=~"RIGHT=~"convenio_retiro.cod_convenio~"    OUTER1 =~"oferta_v.cod_convenio~" )    JOIN (LEFT=~"cadena.codigomp~"    OP =~"=~"RIGHT=~"mpproducto.codigomp~"    OUTER1 =~"cadena.codigomp~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"oferta_v.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"oferta_v.nro_oferta~" )    JOIN (LEFT=~"oferta_v.serie~"    OP =~"=~"RIGHT=~"pago_oferta.serie~" )    JOIN (LEFT=~"oferta_v.nro_oferta~"    OP =~"=~"RIGHT=~"pago_oferta.nro_oferta~" )    JOIN (LEFT=~"oferta_v.ult_folio~"    OP =~"=~"RIGHT=~"pago_oferta.folio~" )    JOIN (LEFT=~"cadena.estado~"    OP =~"=~"RIGHT=~"estado.cod_estado~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"oferta_v.base~" )    JOIN (LEFT=~"oferta_v.base~"    OP =~"=~"RIGHT=~"pago_oferta.base~" )WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":as_serie~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":an_numero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~":as_base~" ) ) ARG(NAME = ~"as_serie~" TYPE = string)  ARG(NAME = ~"an_numero~" TYPE = number)  ARG(NAME = ~"as_base~" TYPE = string) " arguments=(("as_serie", string),("an_numero", number),("as_base", string)) )
