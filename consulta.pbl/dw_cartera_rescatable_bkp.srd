 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"agentes~" )  TABLE(NAME=~"geo_prado_crescatable~" )  TABLE(NAME=~"jefe_ventas~" )  TABLE(NAME=~"supervisor~" ) COLUMN(NAME=~"geo_prado_crescatable.codigo~") COLUMN(NAME=~"geo_prado_crescatable.serie~") COLUMN(NAME=~"geo_prado_crescatable.numero~") COLUMN(NAME=~"geo_prado_crescatable.status~") COLUMN(NAME=~"geo_prado_crescatable.fecha_base~") COLUMN(NAME=~"geo_prado_crescatable.rut~") COLUMN(NAME=~"geo_prado_crescatable.dv~") COLUMN(NAME=~"geo_prado_crescatable.nombre_titular~") COLUMN(NAME=~"agentes.cod_age~") COLUMN(NAME=~"agentes.nombre~") COLUMN(NAME=~"agentes.a_paterno~") COLUMN(NAME=~"agentes.a_materno~") COLUMN(NAME=~"agentes.estado~") COLUMN(NAME=~"supervisor.cod_sup~") COLUMN(NAME=~"supervisor.nombre~") COLUMN(NAME=~"supervisor.a_paterno~") COLUMN(NAME=~"supervisor.a_materno~") COLUMN(NAME=~"supervisor.estado~") COLUMN(NAME=~"jefe_ventas.jefe_ventas~") COLUMN(NAME=~"jefe_ventas.nombre~") COLUMN(NAME=~"jefe_ventas.a_paterno~") COLUMN(NAME=~"jefe_ventas.a_materno~") COLUMN(NAME=~"jefe_ventas.estado~") COLUMN(NAME=~"geo_prado_crescatable.base~") COLUMN(NAME=~"geo_prado_crescatable.folio~")    JOIN (LEFT=~"agentes.cod_age~"    OP =~"=~"RIGHT=~"geo_prado_crescatable.cod_age~" )    JOIN (LEFT=~"agentes.cod_sup~"    OP =~"=~"RIGHT=~"supervisor.cod_sup~" )    JOIN (LEFT=~"supervisor.cod_jefe~"    OP =~"=~"RIGHT=~"jefe_ventas.jefe_ventas~" )WHERE(    EXP1 =~"~~~"GEO_PRADO_CRESCATABLE~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"GEO_PRADO_CRESCATABLE~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"GEO_PRADO_CRESCATABLE~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number) " arguments=(("base", string),("serie", string),("numero", number)) )
