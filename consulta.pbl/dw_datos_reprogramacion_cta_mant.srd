 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cliente~" )  TABLE(NAME=~"repacta_mantencion~" ) COLUMN(NAME=~"cliente.rut~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cliente.direccion_p~") COLUMN(NAME=~"cliente.fono_p~") COLUMN(NAME=~"cliente.fono_c~") COLUMN(NAME=~"repacta_mantencion.base~") COLUMN(NAME=~"repacta_mantencion.serie~") COLUMN(NAME=~"repacta_mantencion.numero~") COLUMN(NAME=~"repacta_mantencion.base_original~") COLUMN(NAME=~"repacta_mantencion.serie_original~") COLUMN(NAME=~"repacta_mantencion.numero_original~") COLUMN(NAME=~"repacta_mantencion.correlativo~") COLUMN(NAME=~"repacta_mantencion.estado_pago~") COLUMN(NAME=~"repacta_mantencion.fecha_primera_cta~") COLUMN(NAME=~"repacta_mantencion.cuotas_en_mora~") COLUMN(NAME=~"repacta_mantencion.usuario~") COLUMN(NAME=~"repacta_mantencion.ctas_pagadas~") COLUMN(NAME=~"repacta_mantencion.valor_cuota_uf~") COLUMN(NAME=~"repacta_mantencion.factor_aplicado~") COLUMN(NAME=~"repacta_mantencion.total_pagado~") COLUMN(NAME=~"repacta_mantencion.cta_mora_original~") COLUMN(NAME=~"repacta_mantencion.fecha_crea~") COLUMN(NAME=~"repacta_mantencion.fecha_ult~") COLUMN(NAME=~"repacta_mantencion.cuotas_pactadas~") COLUMN(NAME=~"cliente.estado_cobranza~") COLUMN(NAME=~"cliente.fecha_cobranza~") COLUMN(NAME=~"cliente.glosa_cobranza~") COLUMN(NAME=~"cliente.tipo_via~") COLUMN(NAME=~"cliente.numero_particular~") COLUMN(NAME=~"cliente.depto_particular~") COLUMN(NAME=~"cliente.block_particular~")    JOIN (LEFT=~"cliente.rut~"    OP =~"=~"RIGHT=~"repacta_mantencion.rut_cliente~"    OUTER2 =~"repacta_mantencion.rut_cliente~" )WHERE(    EXP1 =~"~~~"REPACTA_MANTENCION~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"REPACTA_MANTENCION~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~" ) ) ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number) " arguments=(("serie", string),("numero", number)) )
