table(column=(type=char(1) updatewhereclause=yes name=cadena_estado dbname="cadena.estado" dbalias=".estado" )
 column=(type=datetime updatewhereclause=yes name=cadena_fecha_res dbname="cadena.fecha_res" dbalias=".fecha_res" )
 column=(type=char(5) updatewhereclause=yes name=cadena_nro_carta dbname="cadena.nro_carta" dbalias=".nro_carta" )
 column=(type=datetime updatewhereclause=yes name=cadena_fecha_carta dbname="cadena.fecha_carta" dbalias=".fecha_carta" )
 column=(type=decimal(4) updatewhereclause=yes name=cadena_estado_carta dbname="cadena.estado_carta" dbalias=".estado_carta" )
 column=(type=char(1) updatewhereclause=yes name=estado_titulo dbname="cadena.estado_titulo" dbalias=".estado_titulo" )
 column=(type=datetime updatewhereclause=yes name=fecha_titulo dbname="cadena.fecha_titulo" dbalias=".fecha_titulo" )
 column=(type=char(20) updatewhereclause=yes name=estado_nombre_estado dbname="estado.nombre_estado" dbalias=".nombre_estado" )
 column=(type=datetime updatewhereclause=yes name=repacta_mantencion_fecha_crea dbname="repacta_mantencion.fecha_crea" dbalias=".fecha_crea" )
 column=(type=decimal(4) updatewhereclause=yes name=cadena_cod_parque dbname="cadena.cod_parque" dbalias=".cod_parque" )
 column=(type=char(1) updatewhereclause=yes name=cadena_estado_contrato_aux dbname="cadena.estado_contrato_aux" dbalias=".estado_contrato_aux" )
 column=(type=decimal(4) updatewhereclause=yes name=cadena_codigo_tramo dbname="cadena.codigo_tramo" dbalias=".codigo_tramo" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cadena~" )  TABLE(NAME=~"estado~" )  TABLE(NAME=~"repacta_mantencion~" ) COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"cadena.fecha_res~") COLUMN(NAME=~"cadena.nro_carta~") COLUMN(NAME=~"cadena.fecha_carta~") COLUMN(NAME=~"cadena.estado_carta~") COLUMN(NAME=~"cadena.estado_titulo~") COLUMN(NAME=~"cadena.fecha_titulo~") COLUMN(NAME=~"estado.nombre_estado~") COLUMN(NAME=~"repacta_mantencion.fecha_crea~") COLUMN(NAME=~"cadena.cod_parque~") COLUMN(NAME=~"cadena.estado_contrato_aux~") COLUMN(NAME=~"cadena.codigo_tramo~")    JOIN (LEFT=~"cadena.estado~"    OP =~"=~"RIGHT=~"estado.cod_estado~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"repacta_mantencion.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"repacta_mantencion.numero~" )WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":as_serie~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":an_numero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'R'~" ) ) ARG(NAME = ~"as_serie~" TYPE = string)  ARG(NAME = ~"an_numero~" TYPE = number) " arguments=(("as_serie", string),("an_numero", number)) )
