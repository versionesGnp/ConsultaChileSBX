 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cadena~" )  TABLE(NAME=~"ciudad~" )  TABLE(NAME=~"cliente~" )  TABLE(NAME=~"comuna~" )  TABLE(NAME=~"cupon~" ) COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"cadena.serie~") COLUMN(NAME=~"cadena.numero~") COLUMN(NAME=~"cliente.rut~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cliente.direccion_p~") COLUMN(NAME=~"cliente.poblacion~") COLUMN(NAME=~"cliente.comuna~") COLUMN(NAME=~"comuna.comuna~") COLUMN(NAME=~"cliente.ciudad~") COLUMN(NAME=~"ciudad.ciudad~") COLUMN(NAME=~"cliente.fono_p~") COLUMN(NAME=~"cliente.domicilio_c~") COLUMN(NAME=~"cliente.fono_c~") COLUMN(NAME=~"cliente.estado_cobranza~") COLUMN(NAME=~"cliente.fecha_cobranza~") COLUMN(NAME=~"cliente.glosa_cobranza~") COLUMN(NAME=~"cliente.estado_titular~") COLUMN(NAME=~"cliente.fecha_prox_llamado~") COLUMN(NAME=~"cliente.asignado_cobranza~") COLUMN(NAME=~"cliente.estado_cob_prostventa~") COLUMN(NAME=~"cliente.fecha_cob_postventa~") COLUMN(NAME=~"cliente.glosa_cob_postventa~") COLUMN(NAME=~"cliente.estado_postventa~") COLUMN(NAME=~"cliente.ult_cod_envio_carta~") COLUMN(NAME=~"cliente.ult_estado_envio_carta~") COLUMN(NAME=~"cliente.ult_fecha_envio_carta~") COLUMN(NAME=~"cliente.ult_cod_accion_envio_carta~") COLUMN(NAME=~"cliente.ult_clasificacion_envio_carta~") COLUMN(NAME=~"cliente.fecha_prox_envio_carta~") COLUMN(NAME=~"cupon.codigo~") COLUMN(NAME=~"cupon.serie~") COLUMN(NAME=~"cupon.numero~") COLUMN(NAME=~"cupon.barra~") COLUMN(NAME=~"cupon.num_cup~") COLUMN(NAME=~"cupon.fecha_pago~") COLUMN(NAME=~"cupon.cuota~") COLUMN(NAME=~"cupon.pagada~") COLUMN(NAME=~"cupon.usuario~") COLUMN(NAME=~"cupon.fecha_prim~") COLUMN(NAME=~"cupon.estado~") COLUMN(NAME=~"cliente.tipo_via~") COLUMN(NAME=~"cliente.numero_particular~") COLUMN(NAME=~"cliente.depto_particular~") COLUMN(NAME=~"cliente.block_particular~") COLUMN(NAME=~"cadena.cod_parque~")    JOIN (LEFT=~"cadena.rut~"    OP =~"=~"RIGHT=~"cliente.rut~" )    JOIN (LEFT=~"ciudad.codigo_ciudad~"    OP =~"=~"RIGHT=~"cliente.ciudad~" )    JOIN (LEFT=~"cliente.comuna~"    OP =~"=~"RIGHT=~"comuna.codigo_comuna~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"cupon.codigo~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"cupon.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"cupon.numero~" )WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number) " arguments=(("base", string),("serie", string),("numero", number)) )
