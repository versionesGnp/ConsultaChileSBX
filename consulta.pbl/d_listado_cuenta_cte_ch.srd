 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"ingreso~" )  TABLE(NAME=~"cod_pago~" )  TABLE(NAME=~"documentos~" )  TABLE(NAME=~"bancos~" ) COLUMN(NAME=~"ingreso.folio~") COLUMN(NAME=~"ingreso.tipo_cob~") COLUMN(NAME=~"cod_pago.descripcion~") COLUMN(NAME=~"ingreso.cod_caja~") COLUMN(NAME=~"documentos.cod_pago~") COLUMN(NAME=~"documentos.n_cheque~") COLUMN(NAME=~"documentos.cod_banco~") COLUMN(NAME=~"bancos.descripcion~") COLUMN(NAME=~"documentos.monto~") COLUMN(NAME=~"documentos.fecha_pago~") COLUMN(NAME=~"documentos.fecha_venc~") COLUMN(NAME=~"ingreso.base~") COLUMN(NAME=~"ingreso.serie~") COLUMN(NAME=~"ingreso.contrato~") COLUMN(NAME=~"documentos.estado_ch~") COLUMN(NAME=~"ingreso.rut~") COLUMN(NAME=~"documentos.fecha_estado_ch~")    JOIN (LEFT=~"ingreso.tipo_cob~"    OP =~"=~"RIGHT=~"cod_pago.tipo_cob~"    OUTER1 =~"ingreso.tipo_cob~" )    JOIN (LEFT=~"ingreso.folio~"    OP =~"=~"RIGHT=~"documentos.folio~"    OUTER1 =~"ingreso.folio~" )    JOIN (LEFT=~"ingreso.tipo_cob~"    OP =~"=~"RIGHT=~"documentos.tipo_cob~"    OUTER1 =~"ingreso.tipo_cob~" )    JOIN (LEFT=~"documentos.cod_banco~"    OP =~"=~"RIGHT=~"bancos.cod_banco~" )WHERE(    EXP1 =~"(~~~"INGRESO~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":as_serie~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"CONTRATO~~~"~"   OP =~"=~"    EXP2 =~":an_numero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":as_base)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"DOCUMENTOS~~~".~~~"COD_PAGO~~~"~"   OP =~"=~"    EXP2 =~"'CH'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"INGRESO~~~".~~~"TIPO_MOV~~~"~"   OP =~"=~"    EXP2 =~"'A'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"TIPO_MOV~~~"~"   OP =~"=~"    EXP2 =~"'E'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"TIPO_MOV~~~"~"   OP =~"=~"    EXP2 =~"'I'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"TIPO_MOV~~~"~"   OP =~"=~"    EXP2 =~"'F'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"TIPO_MOV~~~"~"   OP =~"=~"    EXP2 =~"'K'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"TIPO_MOV~~~"~"   OP =~"=~"    EXP2 =~"'M'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"TIPO_MOV~~~"~"   OP =~"=~"    EXP2 =~"'L')~" ) ) ARG(NAME = ~"as_serie~" TYPE = string)  ARG(NAME = ~"an_numero~" TYPE = number)  ARG(NAME = ~"as_base~" TYPE = string) " arguments=(("as_serie", string),("an_numero", number),("as_base", string))  sort="documentos_fecha_venc A " )
