_c~") COLUMN(NAME=~"cliente.domicilio_c~") COLUMN(NAME=~"contrato.obs_sepultura~") COLUMN(NAME=~"contrato.agente~") COLUMN(NAME=~"contrato.anexo_repacta~") COLUMN(NAME=~"contrato.cta_repacta~") COLUMN(NAME=~"contrato.tot_pagado~") COLUMN(NAME=~"contrato.cta_pag_la~") COLUMN(NAME=~"contrato.cta_pag_isa~") COLUMN(NAME=~"contrato.pie~") COLUMN(NAME=~"contrato.pie_pagado~") COLUMN(NAME=~"cadena.cod_parque~") COLUMN(NAME=~"cadena_mora.mora_mant~") COLUMN(NAME=~"cadena_mora.dias_mora_mant~") COLUMN(NAME=~"cadena_mora.fecha_venc_mant~") COLUMN(NAME=~"cadena_mora.fallecidos~") COMPUTE(NAME=~"''~") COMPUTE(NAME=~"0~") COLUMN(NAME=~"contrato.cod_convenio~") COLUMN(NAME=~"convenio_retiro.glosa~") COLUMN(NAME=~"convenio_retiro.vigencia_descripcion~") COLUMN(NAME=~"contrato.uso~") COLUMN(NAME=~"contrato.forma_pago~") COLUMN(NAME=~"cliente.email~") COLUMN(NAME=~"contrato.sepultura~") COLUMN(NAME=~"cliente.celular~") COLUMN(NAME=~"inventario_plani.ubs~")    JOIN (LEFT=~"cadena.rut~"    OP =~"=~"RIGHT=~"cliente.rut~"    OUTER1 =~"cadena.rut~" )    JOIN (LEFT=~"contrato.cod_convenio~"    OP =~"=~"RIGHT=~"convenio_retiro.cod_convenio~"    OUTER1 =~"contrato.cod_convenio~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"inventario_plani.base~"    OUTER1 =~"cadena.codigo~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"inventario_plani.serie~"    OUTER1 =~"cadena.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"inventario_plani.numero~"    OUTER1 =~"cadena.numero~" )   JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"contrato.serie_c~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"contrato.nro_contrato~" )    JOIN (LEFT=~"cliente.comuna~"    OP =~"=~"RIGHT=~"comuna.codigo_comuna~" )    JOIN (LEFT=~"cliente.ciudad~"    OP =~"=~"RIGHT=~"ciudad.codigo_ciudad~" )    JOIN (LEFT=~"cliente.tipo_via~"    OP =~"=~"RIGHT=~"tipo_via.tipo_via~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"cadena_mora.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"cadena_mora.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"cadena_mora.numero~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'C'~" ) ) " )
