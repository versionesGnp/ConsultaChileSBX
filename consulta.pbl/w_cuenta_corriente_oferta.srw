event open;String		ls_cod_usuario,ls_nom_usuario,ls_base_aux,ls_descrip,ls_fono_p,ls_estado_cob,ls_sector,ls_sepult,ls_pac,ls_tipo_cobro,ls_usuario,ls_nombre,ls_descrip_depto,&
			ls_dv,ls_estado,ls_nombre_sol,ls_string,ls_titulo,ls_mp_base,ls_mp_serie,ls_anexo_titulo,ls_base_h, ls_serie_h
Long		ll_count_reg_seg,ll_estado_cob,ll_count_reclamo,ll_prue,ll_cta,ll_count_fune,ll_obj_id_estado,ll_count_asoc,ll_cod_parque,ll_count_hist,&
			ll_count_reg,ll_count,ll_count_conv,ll_status,ll_count_cup,ll_estado_carta,ll_correlativo,ll_cuotas_pie,ll_plazo,ll_mora_original,ll_ctas_pag_m
Double	ll_rut,ll_monto_pie,ldb_valor_cuota,ldb_interes,ldb_gasto,ldb_uf_dia,ll_mp_numero, ll_numero_h
Datetime	ldt_fecha_sol,ldt_fecha_prim


if gs_base='O' then
	ls_titulo								= 'Cuenta Corriente PROMESA (Base O)'
	this.title								= ls_titulo
	pb_ficha_sepul.enabled			= true
	pb_ficha_columbario.enabled	= false
elseif gs_base='U' then
	ls_titulo								= 'Cuenta Corriente COLUMBARIO (Base U)'
	this.title								= ls_titulo
	pb_ficha_sepul.enabled			= false
	pb_ficha_columbario.enabled	= true
elseif gs_base='M' then
	ls_titulo								= 'Cuenta Corriente MULTIPRODUCTO (Base M)'
	this.title								= ls_titulo
	pb_ficha_sepul.enabled			= false
	pb_ficha_columbario.enabled	= true
end if
if gs_serie<>'' and gi_numero>0 and gs_base<>'' then
	DECLARE sp_cadena_mora_cta_cte PROCEDURE FOR sp_nuevo_cadena_mora(:gs_base,:gs_serie,:gi_numero,'M');
	EXECUTE sp_cadena_mora_cta_cte;
	
	DECLARE sp_actualizar_cuponeras_1 PROCEDURE FOR sp_actualizar_cuponeras_1(:gs_base,:gs_serie,:gi_numero);
	EXECUTE sp_actualizar_cuponeras_1;
	if gs_base='M' then
		DECLARE x2 CURSOR FOR  
		SELECT 	"CADENA"."CODIGO",   	"CADENA"."SERIE",   	"CADENA"."NUMERO"  
		FROM 	"CADENA"  
		WHERE 	( "CADENA"."MPBASE" = :gs_base ) AND  
					( "CADENA"."MPSERIE" = :gs_serie ) AND  
					( "CADENA"."MPNUMERO" = :gi_numero )   
		USING	sqlca;
		open x2;
		if sqlca.sqlcode=0 then
			DO WHILE sqlca.sqlcode=0
				fetch x2 into :ls_base_h, :ls_serie_h, :ll_numero_h ;
				if not isnull(ls_base_h) then
					DECLARE sp_actualizar_cuponeras_h1 PROCEDURE FOR sp_actualizar_cuponeras_1(:ls_base_h,:ls_serie_h,:ll_numero_h);
					EXECUTE sp_actualizar_cuponeras_h1;
					
					DECLARE sp_nuevo_cadena_mora_h2 PROCEDURE FOR sp_nuevo_cadena_mora(:ls_base_h,:ls_serie_h,:ll_numero_h,'M');
					EXECUTE sp_nuevo_cadena_mora_h2;
				end if
				Setnull(ls_base_h)
			LOOP
		end if
		close x2;
	end if
	st_ap.visible							= false
	gf_centrar (w_cuenta_corriente_oferta)
	dw_encabezado_cuenta_cte.SetTransObject(SQLCA)
	dw_abono.SetTransObject(SQLCA)
	if dw_encabezado_cuenta_cte.Retrieve(gs_serie, gi_numero,gs_base)=0 then
		messagebox("Advertencia","No Registra Datos Promesa "+gs_base+'-'+gs_serie+'-'+string(gi_numero,"###,###,###,###"))
		close(w_cuenta_corriente_oferta)
	else
		il_abono						= dw_abono.retrieve(gs_base,gs_serie,gi_numero)
		if il_abono > 0 then
			st_pago_ist_canaan.visible	= true
		else
			st_pago_ist_canaan.visible	= false
		end if
		ll_estado_carta				= dw_encabezado_cuenta_cte.getitemnumber(1,'cadena_estado_carta')
		ls_sector						= trim(dw_encabezado_cuenta_cte.getitemstring(1,'pago_oferta_sector'))
		ls_sepult						= trim(dw_encabezado_cuenta_cte.getitemstring(1,'pago_oferta_sepultura'))
		ll_obj_id_estado			= dw_encabezado_cuenta_cte.GetItemNumber(1, 'cadena_objeto_id_estado')
		if ll_obj_id_estado=0 or isnull(ll_obj_id_estado) then
			pb_documento.enabled	= false
		else
			pb_documento.enabled	= true
		end if
		SELECT 	Count( "TIPO_PROMOCION_ASOCIADOS"."COD_BENEFICIO"  )
		INTO 		:ll_count_asoc  
		FROM 	"TIPO_PROMOCION_ASOCIADOS"  
		WHERE ( "TIPO_PROMOCION_ASOCIADOS"."BASE" = :gs_base ) AND  
				  ( "TIPO_PROMOCION_ASOCIADOS"."SERIE" = :gs_serie ) AND  
				  ( "TIPO_PROMOCION_ASOCIADOS"."NUMERO" = :gi_numero )   ;
		if ll_count_asoc > 0 then
			pb_benef_asoc.enabled																					= true
			m_menu_cuenta_corriente_promesa.m_mantenedor.m_gestionarpromoción.enabled		= true
		else
			pb_benef_asoc.enabled																					= false
			m_menu_cuenta_corriente_promesa.m_mantenedor.m_gestionarpromoción.enabled		= false
		end if
		SELECT	COUNT("WEB_RECLAMOS"."ID_RECLAMO")  
		INTO 		:ll_count_reclamo  
		FROM 	"WEB_RECLAMOS"  
		WHERE  ( "WEB_RECLAMOS"."SECTOR" = :ls_sector ) AND  
				 ( "WEB_RECLAMOS"."SEPULTURA" = :ls_sepult )   
		USING		sqlca;
		if ll_count_reclamo > 0 then
			pb_web_reclamos.enabled	= true
		else
			pb_web_reclamos.enabled	= false
		end if
		SELECT	"ESTADO_ENVIO"."DESCRIPCION"  
		INTO 		:ls_descrip  
		FROM 		"ESTADO_ENVIO"  
		WHERE 	"ESTADO_ENVIO"."CODIGO_NUM" = :ll_estado_carta   ;
		if ll_estado_carta=1 or ll_estado_carta=2 or ll_estado_carta=4 or ll_estado_carta=6 or ll_estado_carta=8 then
			st_ap.text				= 'Cliente debe Regularizar Antecedentes ESTADO: '+ ls_descrip
			st_ap.visible			= true
		else
			ls_estado_cob			= trim(dw_encabezado_cuenta_cte.getitemstring(1,'cliente_estado_cobranza'))
			if ls_estado_cob='4' or ls_estado_cob='5' or ls_estado_cob='9' or ls_estado_cob='17' then
				ll_estado_cob		= long(ls_estado_cob)
				SELECT	"ESTADO_COBRANZA"."GLOSA_ESTADO"  
				INTO 		:ls_descrip  
				FROM 		"ESTADO_COBRANZA"  
				WHERE 	"ESTADO_COBRANZA"."COD_ESATDO" = :ll_estado_cob   
				USING		sqlca;
				if sqlca.sqlcode=0 then
					st_ap.text		= 'Cliente debe Regularizar Antecedentes ESTADO: '+ls_estado_cob+'-'+ls_descrip
					st_ap.visible	= true
				end if
			else
				ls_fono_p		= dw_encabezado_cuenta_cte.getitemstring(1,'cliente_fono_p')
				if len(ls_fono_p) <= 5 then
					st_ap.text		= 'Cliente debe Regularizar Antecedentes ESTADO: TELEFONO PARTICULAR INCOMPLETO'
					st_ap.visible	= true
				end if
			end if
		end if
		SELECT	Count("RECLAMO_SOLICITUD"."NUMERO_RECLAMO")
		INTO 		:ll_count_reclamo  
		FROM 	"RECLAMO_SOLICITUD"  
		WHERE ( "RECLAMO_SOLICITUD"."BASE" = :gs_base ) AND  
				  ( "RECLAMO_SOLICITUD"."SERIE" = :gs_serie ) AND  
				  ( "RECLAMO_SOLICITUD"."NUMERO" = :gi_numero ) AND  
				  ( "RECLAMO_SOLICITUD"."COD_ESTADO_REG" <> 'A' )   
		USING	sqlca;
		if ll_count_reclamo > 0 then
			pb_requerimientos.enabled		= true
		else
			pb_requerimientos.enabled		= false
		end if
		if dw_encabezado_cuenta_cte.getitemnumber(1,'c_cuotas_mora_m')>0 or &
			len(dw_encabezado_cuenta_cte.getitemstring(1,'oferta_v_anexo_repacta'))>0 then
			cb_7.enabled	= true
		else
			cb_7.enabled	= false
		end if
		if gs_conexion	= "Parque El Prado" then
			SELECT	"GEO_PRADO_CRESCATABLE"."FECHA_BASE",   
						"GEO_PRADO_CRESCATABLE"."COD_AGE",   
						"GEO_PRADO_CRESCATABLE"."STATUS"  
			INTO 		:idt_fecha_base,   
						:is_cod_age,   
						:il_status  
			FROM 		"GEO_PRADO_CRESCATABLE"  
			WHERE  ( "GEO_PRADO_CRESCATABLE"."CODIGO" = :gs_base ) AND  
					 ( "GEO_PRADO_CRESCATABLE"."SERIE" = :gs_serie ) AND  
					 ( "GEO_PRADO_CRESCATABLE"."NUMERO" = :gi_numero )   
			USING		sqlca;
			if sqlca.sqlcode=0 then
				cb_cartera.enabled	= True
			else
				cb_cartera.enabled	= False
			end if
		end if
		SELECT	COUNT("DOCUMENTOS"."FOLIO")  
		INTO 		:ll_count  
		FROM 		"DOCUMENTOS",   
					"INGRESO"  
		WHERE  ( "DOCUMENTOS"."FOLIO" = "INGRESO"."FOLIO" ) and  
				 ( "DOCUMENTOS"."TIPO_COB" = "INGRESO"."TIPO_COB" ) and  
				 ( "DOCUMENTOS"."FECHA_PAGO" = "INGRESO"."FECHA_PAGO" ) and  
				 ( "INGRESO"."BASE" = :gs_base ) AND  
				 ( "INGRESO"."SERIE" = :gs_serie ) AND  
				 ( "INGRESO"."CONTRATO" = :gi_numero ) AND
				 ( "DOCUMENTOS"."ESTADO_CH" = 'P' OR "DOCUMENTOS"."ESTADO_CH" = 'T' ) AND
				 ( "DOCUMENTOS"."COD_PAGO" = 'CH');
		if ll_count>0 then
			cb_est_cheque.enabled	= true
		else
			cb_est_cheque.enabled	= false
		end if		
		dw_estado_cta_cte.SetTransObject(SQLCA)
		dw_estado_cta_cte.Retrieve(gs_serie, gi_numero,gs_base)
		dw_listado_cuenta_cte.SetTransObject(SQLCA)
		dw_listado_cuenta_cte.Retrieve(gs_serie, gi_numero,gs_base)
		
		ll_prue							= dw_encabezado_cuenta_cte.getitemnumber(1,'oferta_v_beneficio_complementario')
		
		if dw_encabezado_cuenta_cte.getitemnumber(1,'oferta_v_beneficio_complementario')>0 then
			pb_beneficios.enabled	= false
		else
			pb_beneficios.enabled	= false
		end if
		SELECT	COUNT("BENEFICIARIOS_SEGURO"."BASE")  
		INTO 		:ll_count_reg_seg  
		FROM 		"BENEFICIARIOS_SEGURO"  
		WHERE  ( "BENEFICIARIOS_SEGURO"."BASE" = :gs_base ) AND  
				 ( "BENEFICIARIOS_SEGURO"."SERIE" = :gs_serie ) AND  
				 ( "BENEFICIARIOS_SEGURO"."NUMERO" = :gi_numero ) AND  
				 ( "BENEFICIARIOS_SEGURO"."CODIGO_SEGURO" = 3 )   ;
		if ll_count_reg_seg > 0 then
			pb_2_beneficiario.enabled	= true
		else
			pb_2_beneficiario.enabled	= false
		end if

		gs_ventana	= 'w_cuenta_corriente_oferta'
		f_valida_objeto()	
		ls_pac							= f_buscar_pac(gs_base, gs_serie, gi_numero)
		st_pac.text						= ls_pac
		SELECT	COUNT("DETALLE_CONVENIO_PROTESTO"."BASE_ORIGINAL")  
		INTO 		:ll_count_conv  
		FROM 		"DETALLE_CONVENIO_PROTESTO"  
		WHERE  ( "DETALLE_CONVENIO_PROTESTO"."BASE_ORIGINAL" = :gs_base ) AND  
				 ( "DETALLE_CONVENIO_PROTESTO"."SERIE_ORIGINAL" = :gs_serie ) AND  
				 ( "DETALLE_CONVENIO_PROTESTO"."NUMERO_ORIGINAL" = :gi_numero )   
		USING		sqlca;
		if ll_count_conv>0 then
			cb_convenio.enabled		= true
		else
			cb_convenio.enabled		= false
		end if
//		if gs_depto = 'V' or gs_depto='G' or gs_depto='P' or gs_depto='I' or gs_depto='O' or  gs_depto='E' or &
//			gs_depto='T' or gs_depto='D' or gs_depto = 'R' or gs_depto='B' or gs_depto='K' then
			cb_agente.enabled 		= true
			cb_rescomi_vta.enabled 	= true
//		else
//			cb_agente.enabled 		= false
//			cb_rescomi_vta.enabled 	= false
//		end if
		SELECT	COUNT("BENEFICIARIOS_SEGURO"."BASE")
		INTO 		:ll_count_reg  
		FROM 		"BENEFICIARIOS_SEGURO"  
		WHERE  ( "BENEFICIARIOS_SEGURO"."BASE" = :gs_base ) AND  
				 ( "BENEFICIARIOS_SEGURO"."SERIE" = :gs_serie ) AND  
				 ( "BENEFICIARIOS_SEGURO"."NUMERO" = :gi_numero ) AND  
				 ( "BENEFICIARIOS_SEGURO"."CODIGO_SEGURO" > 0 )   
		USING		sqlca;
		if ll_count_reg>0 then
			cb_seguro.enabled			= true
		else
			cb_seguro.enabled			= false
		end if
		
		ll_cod_parque	= dw_estado_cta_cte.getitemnumber(1,'cadena_cod_parque')
		if ll_cod_parque=101 then
			SELECT	COUNT("PAGO_HISTORICO_CANAAN"."TIPO_PAGO")
			INTO 		:ll_count_hist  
			FROM 	"PAGO_HISTORICO_CANAAN"  
			WHERE ( "PAGO_HISTORICO_CANAAN"."BASE" = :gs_base ) AND  
					  ( "PAGO_HISTORICO_CANAAN"."SERIE" = :gs_serie ) AND  
					  ( "PAGO_HISTORICO_CANAAN"."CONTRATO" = :gi_numero )  
			USING	sqlca;
			if ll_count_hist > 0 then
				st_pago_ist_canaan.visible	= true
			else
				st_pago_ist_canaan.visible	= false
			end if
		end if
		SELECT	MAX("SOL_ESTATUS"."CORRELATIVO")  
		INTO 		:il_corre_max  
		FROM 		"SOL_ESTATUS",   
					"SOL_ULTIMA_VOLUNTAD"  
		WHERE  ( "SOL_ESTATUS"."BASE" = "SOL_ULTIMA_VOLUNTAD"."BASE" ) and  
				 ( "SOL_ESTATUS"."SERIE" = "SOL_ULTIMA_VOLUNTAD"."SERIE" ) and  
				 ( "SOL_ESTATUS"."NUMERO" = "SOL_ULTIMA_VOLUNTAD"."NUMERO" ) and  
				 ( "SOL_ESTATUS"."CORRELATIVO" = "SOL_ULTIMA_VOLUNTAD"."CORRELATIVO" ) and  
				 (("SOL_ESTATUS"."BASE" = :gs_base ) AND  
				 ( "SOL_ESTATUS"."SERIE" = :gs_serie ) AND  
				 ( "SOL_ESTATUS"."NUMERO" = :gi_numero ) AND  
				 ( "SOL_ESTATUS"."CODIGO_SOLICITUD" = '18' ) AND  
				 ( "SOL_ESTATUS"."ESTADO_REG" = 'A' ) )   
		USING		sqlca;
		if il_corre_max > 0 then
			pb_ultima_voluntad.enabled			= true
		else
			pb_ultima_voluntad.enabled			= false
		end if
		SELECT	MAX("SOL_ESTATUS"."CORRELATIVO")  
		INTO 		:il_corre_coprop  
		FROM 		"SOL_ESTATUS",   
					"SOL_COPROP_PROMESA"  
		WHERE  ( "SOL_ESTATUS"."BASE" = "SOL_COPROP_PROMESA"."BASE" ) and  
				 ( "SOL_ESTATUS"."SERIE" = "SOL_COPROP_PROMESA"."SERIE" ) and  
				 ( "SOL_ESTATUS"."NUMERO" = "SOL_COPROP_PROMESA"."NUMERO" ) and  
				 ( "SOL_ESTATUS"."CORRELATIVO" = "SOL_COPROP_PROMESA"."CORRELATIVO" ) and  
				 (("SOL_ESTATUS"."BASE" = :gs_base ) AND  
				 ( "SOL_ESTATUS"."SERIE" = :gs_serie ) AND  
				 ( "SOL_ESTATUS"."NUMERO" = :gi_numero ) AND  
				 ( "SOL_ESTATUS"."CODIGO_SOLICITUD" = '17' ) AND  
				 ( "SOL_ESTATUS"."ESTADO_REG" = 'A' ) )   
		USING		sqlca;
		if il_corre_max > 0 then
			pb_coprop_promesa.enabled			= true
		else
			pb_coprop_promesa.enabled			= false
		end if
		SELECT 	Count("BENEFICIARIO_FUNERARIA"."SERIE")
		INTO		:ll_count_fune  
		FROM		"BENEFICIARIO_FUNERARIA"  
		WHERE ( "BENEFICIARIO_FUNERARIA"."SERIE" = :gs_serie ) AND  
				  ( "BENEFICIARIO_FUNERARIA"."NRO_OFERTA" = :gi_numero )  
		USING	sqlca;
		if ll_count_fune > 0 then
			pb_benef_funeraria.enabled		= true
		else
			pb_benef_funeraria.enabled		= false
		end if

		SELECT	COUNT("CUPONERAS"."NUMERO")  
		INTO 		:ll_count_cup  
		FROM 		"CUPONERAS",   
					"CUPONERAS_DETALLE"  
		WHERE  ( "CUPONERAS"."BASE" = "CUPONERAS_DETALLE"."BASE" ) and  
				 ( "CUPONERAS"."SERIE" = "CUPONERAS_DETALLE"."SERIE" ) and  
				 ( "CUPONERAS"."NUMERO" = "CUPONERAS_DETALLE"."NUMERO" ) and  
				 ( "CUPONERAS"."NRO_CUPONERA" = "CUPONERAS_DETALLE"."NRO_CUPONERA" ) and  
				 (("CUPONERAS"."BASE" = :gs_base ) AND  
				 ( "CUPONERAS"."SERIE" = :gs_serie ) AND  
				 ( "CUPONERAS"."NUMERO" = :gi_numero ) AND  
				 ( "CUPONERAS"."ESTADO_CUPONERA" = 'V' or "CUPONERAS"."ESTADO_CUPONERA" = 'C') AND  
				 ( "CUPONERAS_DETALLE"."ESTADO_PAGO_CUPON" = 'V' ) )   
		USING		sqlca;
		if ll_count_cup > 0 and ( gs_depto = 'E' or gs_depto = 'I' or gs_depto = 'P' or (gs_depto = 'O' and gs_digita='1')) then
			pb_print_cuponera.enabled																	= true
			m_menu_cuenta_corriente_promesa.m_imprimircuponera.enabled						= true
		else
			pb_print_cuponera.enabled																	= false
			m_menu_cuenta_corriente_promesa.m_imprimircuponera.enabled						= false
		end if
		if cb_7.enabled=true then
			m_menu_cuenta_corriente_promesa.m_mantenedor.m_cuotasmantención.enabled		= true
		else
			m_menu_cuenta_corriente_promesa.m_mantenedor.m_cuotasmantención.enabled		= false
		end if
		if cb_cartera.enabled=true then
			m_menu_cuenta_corriente_promesa.m_consultar.m_carterarescatable.enabled		= True
		else
			m_menu_cuenta_corriente_promesa.m_consultar.m_carterarescatable.enabled		= false
		end if
		if cb_est_cheque.enabled=true then
			m_menu_cuenta_corriente_promesa.m_consultar.m_estadocheques.enabled			= true
		else
			m_menu_cuenta_corriente_promesa.m_consultar.m_estadocheques.enabled			= false
		end if
		if cb_convenio.enabled=true then
			m_menu_cuenta_corriente_promesa.m_consultar.m_conveniopagocheuqe.enabled	= true
		else
			m_menu_cuenta_corriente_promesa.m_consultar.m_conveniopagocheuqe.enabled	= false
		end if
		if cb_agente.enabled=true then
			m_menu_cuenta_corriente_promesa.m_consultar.m_pagoscomisiónagente.enabled 	= true
		else
			m_menu_cuenta_corriente_promesa.m_consultar.m_pagoscomisiónagente.enabled 	= false
		end if
		if cb_rescomi_vta.enabled=true then
			m_menu_cuenta_corriente_promesa.m_consultar.m_pagosventas.enabled 			= true	
		else
			m_menu_cuenta_corriente_promesa.m_consultar.m_pagosventas.enabled 			= false
		end if
		if cb_seguro.enabled=true then
			m_menu_cuenta_corriente_promesa.m_consultar.m_segurocomplementario.enabled	= true
		else
			m_menu_cuenta_corriente_promesa.m_consultar.m_segurocomplementario.enabled	= false
		end if
		if f_fallecido(gs_serie, gi_numero, gs_base)>0 then
			cb_fallecidos.enabled	=  true
			m_menu_cuenta_corriente_promesa.m_consultar.m_fallecidos.enabled				= true
		else
			cb_fallecidos.enabled	=  false
			m_menu_cuenta_corriente_promesa.m_consultar.m_fallecidos.enabled				= false
		end if
		
		ll_status						= dw_encabezado_cuenta_cte.GetItemNumber(1, "cliente_status_geo")
		if ll_status>0 then
			pb_ubicacion.enabled		= true
			m_menu_cuenta_corriente_promesa.m_consultar.m_geo-referenciación.enabled	= true
		else
			pb_ubicacion.enabled		= false
			m_menu_cuenta_corriente_promesa.m_consultar.m_geo-referenciación.enabled	= false
		end if	
		if f_regitra_sepul(gs_base,gs_serie, gi_numero )<>'' then
			pb_planimetria.enabled	=  true
		else
			pb_planimetria.enabled	=  false
		end if
		if date(dw_encabezado_cuenta_cte.getitemdatetime(1,'oferta_v_cierre_venta')) >= date('31/01/2011') then
			pb_clasif_promesa.enabled		= true
			m_menu_cuenta_corriente_promesa.m_consultar.m_clasificaciónventa.enabled	= true
		else
			pb_clasif_promesa.enabled		= false
			m_menu_cuenta_corriente_promesa.m_consultar.m_clasificaciónventa.enabled	= false
		end if
		
		SELECT	"CADENA"."EJECUTIVO_CYBER",	"ENCARGADOS"."NOMBRE",		"CODIGO_DEPTO"."DESCRIPCION",	"CADENA"."MPBASE",	  	"CADENA"."MPSERIE",	"CADENA"."MPNUMERO"
		INTO 		:ls_usuario,   							:ls_nombre,   						:ls_descrip_depto  ,						:ls_mp_base,				:ls_mp_serie,				:ll_mp_numero
		FROM 	"CADENA",	"CODIGO_DEPTO", 	"ENCARGADOS"  
		WHERE 	( "CADENA"."EJECUTIVO_CYBER" = "ENCARGADOS"."CODIGO_USUARIO" (+)) and  
					( "ENCARGADOS"."DEPTO" = "CODIGO_DEPTO"."CODIGO" (+)) and  
					( ( "CADENA"."CODIGO" = :gs_base ) AND  
					( "CADENA"."SERIE" = :gs_serie ) AND  
					( "CADENA"."NUMERO" = :gi_numero ) ) 
		USING	sqlca;
		if sqlca.sqlcode=0 then
			if not isnull(ls_mp_base) then
				ls_anexo_titulo		= ' Contrato Multiproducto N° '+ls_mp_base+'-'+ls_mp_serie+'-'+string(ll_mp_numero,'###,###,###,###,###')
				this.title				= ls_titulo+'                 '+ls_anexo_titulo
			end if
			if isnull(ls_descrip_depto) then ls_nombre = ls_usuario
			if isnull(ls_nombre) then ls_nombre = ''
			if isnull(ls_descrip_depto) then ls_descrip_depto = ''
			st_at_gestion.text		= 'EJEC. '+ ls_descrip_depto + ': ' + ls_usuario +' - '+ls_nombre
		else
			st_at_gestion.text		= ''
		end if
		
		SELECT	count("COMISION_COMPARTIDA"."BASE")
		INTO		:ll_cta
		FROM		"COMISION_COMPARTIDA"  
		WHERE	( "COMISION_COMPARTIDA"."BASE" = :gs_base ) AND  
					( "COMISION_COMPARTIDA"."SERIE" = :gs_serie ) AND  
					( "COMISION_COMPARTIDA"."NUMERO" = :gi_numero ) AND
					( "COMISION_COMPARTIDA"."ESTADO" = 'V' )
		USING	sqlca;
		if sqlca.sqlcode=0 then
			if ll_cta>0 then
				pb_comi_compartida.enabled		= true
			else
				pb_comi_compartida.enabled		= false
			end if
		end if
		
		if gs_depto='I' then
			pb_actualiza_mora.visible																	= true
		else
			pb_actualiza_mora.visible																	= true
		end if
		cb_2.triggerevent(clicked!)
		if gi_rut > 0 then 
			if isvalid(w_aviso_mensajes) then close(w_aviso_mensajes)
			if not isvalid(w_ingreso_gestion_ejecutivo_terreno) or not isvalid(w_ingreso_gestion_ejecutivo_terreno_cob) then
				SELECT	COUNT("MENSAJES"."FECHA_CREACION")  
				INTO 		:ll_count  
				FROM 		"MENSAJES"  
				WHERE  ( "MENSAJES"."RUT" = :gi_rut ) and
						 ( "MENSAJES"."ESTADO_GESTION" = 'A' ) AND
						 ( "MENSAJES"."SW_MENSAJE" = 'R' ) and
						 ( "MENSAJES"."FECHA_FIN" > :gdt_fec_sistema )
				USING		sqlca;
				if ll_count>0 then
					OpenWithParm(w_aviso_mensajes, "R")
				else
					SELECT	COUNT("MENSAJES"."FECHA_CREACION")  
					INTO 		:ll_count  
					FROM 		"MENSAJES"  
					WHERE  ( "MENSAJES"."BASE" = :gs_base ) and
							 ( "MENSAJES"."SERIE" = :gs_serie ) and
							 ( "MENSAJES"."NUMERO" = :gi_numero ) and
							 ( "MENSAJES"."ESTADO_GESTION" = 'A' ) AND
							 ( "MENSAJES"."SW_MENSAJE" = 'C' ) and
							 ( "MENSAJES"."FECHA_FIN" > :gdt_fec_sistema )
					USING		sqlca;
					if ll_count>0 then
						OpenWithParm(w_aviso_mensajes, "C")
					end if
				end if
			end if
		end if
		if today() <> date(gdt_fec_sistema) then
			messagebox("Advertencia","Debe Revisar Fecha del Computador NO Corresponde al día de Hoy "+string(gdt_fec_sistema,'dd/mm/yyyy'))
		end if
		if not isvalid(w_traspaso_rezago) then
			f_validar_mensaje_mod_antece(gs_base,gs_serie,gi_numero,gi_rut)
			
			ll_ctas_pag_m			= dw_encabezado_cuenta_cte.getitemnumber(1,'oferta_v_cta_pag_m')
			SELECT 	"SOL_ESTATUS"."CORRELATIVO",		"SOL_COMPROMISO_PAGO"."RUT_TITULAR",	"SOL_COMPROMISO_PAGO"."DV",		"SOL_COMPROMISO_PAGO"."FECHA_SOLICITUD",		"SOL_ESTATUS"."ESTADO_REG",	"SOL_COMPROMISO_PAGO"."NOMBRE_CLIENTE",	"SOL_COMPROMISO_PAGO"."FECHA_PRIM_MANT",	"SOL_COMPROMISO_PAGO"."MONTO_PIE_MANT",	"SOL_COMPROMISO_PAGO"."CUOTAS_PIE_MANT",	"SOL_COMPROMISO_PAGO"."PLAZO_MANT",	"SOL_COMPROMISO_PAGO"."MONTO_CUOTA_MANT",	"SOL_COMPROMISO_PAGO"."MORA_PAGAR_MANT",		"SOL_COMPROMISO_PAGO"."GASTO_PAGAR_MANT",	"SOL_COMPROMISO_PAGO"."UF_DIA",	"SOL_COMPROMISO_PAGO"."CUOTAS_MORA_ORIGINAL"
			INTO 		:ll_correlativo,								:ll_rut,													:ls_dv,										:ldt_fecha_sol,													:ls_estado,								:ls_nombre_sol,											:ldt_fecha_prim,												:ll_monto_pie,													:ll_cuotas_pie,													:ll_plazo,													:ldb_valor_cuota,													:ldb_interes,														:ldb_gasto,															:ldb_uf_dia,										:ll_mora_original
			FROM 	"SOL_COMPROMISO_PAGO",   	"SOL_ESTATUS"  
			WHERE 	( "SOL_COMPROMISO_PAGO"."BASE" = "SOL_ESTATUS"."BASE" ) and  
						( "SOL_COMPROMISO_PAGO"."SERIE" = "SOL_ESTATUS"."SERIE" ) and  
						( "SOL_COMPROMISO_PAGO"."NUMERO" = "SOL_ESTATUS"."NUMERO" ) and  
						( "SOL_COMPROMISO_PAGO"."CORRELATIVO" = "SOL_ESTATUS"."CORRELATIVO" ) and  
						( ( "SOL_COMPROMISO_PAGO"."BASE" = :gs_base ) AND  
						( "SOL_COMPROMISO_PAGO"."SERIE" = :gs_serie ) AND  
						( "SOL_COMPROMISO_PAGO"."NUMERO" = :gi_numero ) AND  
						( "SOL_ESTATUS"."CODIGO_SOLICITUD" = '27' ) AND  
						( "SOL_ESTATUS"."ESTADO_REG" = 'A' ) AND  
						( "SOL_COMPROMISO_PAGO"."CORRELATIVO" = (	SELECT 	"SOL_ESTATUS"."CORRELATIVO" 
																							FROM 	"SOL_ESTATUS" 
																							WHERE 	( "SOL_ESTATUS"."BASE" = :gs_base ) AND 
																										( "SOL_ESTATUS"."SERIE" = :gs_serie ) AND 
																										( "SOL_ESTATUS"."NUMERO" = :gi_numero ) AND
																										( "SOL_ESTATUS"."CODIGO_SOLICITUD" = '27' ) AND 
																										( "SOL_ESTATUS"."ESTADO_REG" = 'A' ) ) ) )  
			USING	sqlca;
			if sqlca.sqlcode=0 then
				if isnull(ldb_interes) then ldb_interes=0
				if isnull(ldb_gasto) then ldb_gasto=0
				ls_string	= gs_base+'~t'+gs_serie+'~t'+string(gi_numero)+'~t'+string(ll_rut)+'~t'+string(ll_correlativo)+'~t'+ls_dv+'~t'+ls_estado+'~t'+'27'+'~t'+ls_nombre_sol+'~t'+string(ldt_fecha_prim,'dd/mm/yyyy')+'~t'+string(ll_cuotas_pie)+'~t'+string(ll_monto_pie)+'~t'+string(ldb_uf_dia)+'~t'+ string(ldb_valor_cuota)+'~t'+string(ll_mora_original)+'~t'+string(ldb_interes)+'~t'+string(ldb_gasto)+'~t'+string(ll_ctas_pag_m)+'~t'+string(ll_plazo)+'~t'+string(ldt_fecha_sol,'dd/mm/yyyy')
				openwithparm(w_detalle_compromiso_pago,ls_string)
			end if			
		end if
	end if
	if isvalid(w_aviso_mensajes) then w_aviso_mensajes.setfocus()
else
	close(w_cuenta_corriente_oferta)
end if

end event

event close;if gs_serie<>'' and gi_numero>0 and gs_base<>'' and dw_encabezado_cuenta_cte.rowcount()>0 then
	gs_base 					= dw_encabezado_cuenta_cte.GetItemString(1, "cadena_codigo")
	gs_serie 					= dw_encabezado_cuenta_cte.GetItemString(1, "oferta_v_serie")
	gi_numero 				= dw_encabezado_cuenta_cte.GetItemNumber(1, "oferta_v_nro_oferta")
	gi_rut 					= dw_encabezado_cuenta_cte.GetItemNumber(1, "cliente_rut")
	gs_apellido_paterno	= dw_encabezado_cuenta_cte.GetItemString(1, "cliente_a_paterno")
	gs_apellido_materno	= dw_encabezado_cuenta_cte.GetItemString(1, "cliente_a_materno")
	gs_nombres				= dw_encabezado_cuenta_cte.GetItemString(1, "cliente_nombre")
	gs_dv						= dw_encabezado_cuenta_cte.GetItemString(1, "cliente_dv")
	gs_estado				= dw_encabezado_cuenta_cte.GetItemString(1, "cadena_estado")
	gl_cod_parque_cta		= dw_encabezado_cuenta_cte.GetItemNumber(1, "cadena_cod_parque")
	if isvalid(w_plano_sector_parque) then w_plano_sector_parque.dw_plano_sector_parque.enabled	= true
	INSERT INTO 	"LOG_CONSULTA"  
					( 	"BASE",   	"SERIE",   	"NUMERO",	"FECHA",   				"RUT_CLIENTE",	"USUARIO",	"NRO_PRINT" ,		"TCP_IP",		"USUARIO_WIN")  
	VALUES 		( 	:gs_base,	:gs_serie,	:gi_numero,	:gdt_fec_sistema,		:gi_rut,   		:gs_user,	:il_count_print,	:gs_tcp_ip,		:gs_user_maq )  
	USING				sqlca;
	if sqlca.sqlcode=0 then
		commit;
	else
		rollback;
	end if
end if
f_limpiar_caja_de_ctacte()
end event

event mousemove;wf_invisible_help()

end event

type mdi_1 from mdiclient within w_cuenta_corriente_oferta
long BackColor=268435456
end type

type mditbb_1 from tabbedbar within w_cuenta_corriente_oferta
int X=0
int Y=0
int Width=0
int Height=104
end type

type mdirbb_1 from ribbonbar within w_cuenta_corriente_oferta
int X=0
int Y=0
int Width=0
int Height=596
end type

type pb_1 from picturebutton within w_cuenta_corriente_oferta
event ue_mousemove pbm_mousemove
integer x = 2930
