event clicked;string	ls_orig_venta,ls_tipo_info,ls_string
gs_base				= dw_encabezado_cuenta_cte.GetItemString(1, 'cadena_codigo')
gs_serie				= dw_encabezado_cuenta_cte.GetItemString(1, 'oferta_v_serie')
gi_numero			= dw_encabezado_cuenta_cte.GetItemNumber(1, 'oferta_v_nro_oferta')
SELECT	"COMISION_COMPARTIDA"."CODIGO_TIPO_VTA"
INTO		:ls_orig_venta
FROM		"COMISION_COMPARTIDA"  
WHERE	( "COMISION_COMPARTIDA"."BASE" = :gs_base ) AND  
			( "COMISION_COMPARTIDA"."SERIE" = :gs_serie ) AND  
			( "COMISION_COMPARTIDA"."NUMERO" = :gi_numero ) AND
			( "COMISION_COMPARTIDA"."ESTADO" = 'V' )
USING	sqlca;
ls_tipo_info						= 'O'

if ls_orig_venta='3' or ls_orig_venta= 'C' or ls_orig_venta= 'U' then
	ls_orig_venta				= ls_orig_venta		
else
	ls_orig_venta				= '5'
end if
if ls_orig_venta = '5' or ls_orig_venta = '3' or ls_orig_venta = 'C' or ls_orig_venta = 'U' then
	if (ls_orig_venta = '5' and (gs_depto='P' or gs_depto='I')) or ((ls_orig_venta = '3' or ls_orig_venta = 'C' or ls_orig_venta = 'U') and (gs_depto='X' or gs_depto='I' )) then
		if not isnull(gs_base) and gs_base<>'' and not isnull(gs_serie) and gs_serie<>'' and gi_numero>0 then
			ls_string				= gs_base+'~t'+gs_serie+'~t'+string(gi_numero)+'~t'+ls_orig_venta+'~t'+ls_tipo_info
			if isvalid(w_comision_comp_asignacion) then close(w_comision_comp_asignacion)
				OpenWithParm (w_comision_comp_asignacion,ls_string)
		end if
	end if
end if
end event

