event clicked;Long		ll_num_aux,ll_res

gs_base		= dw_encabezado_cuenta_cte.GetItemString(1, 'cadena_codigo')
gs_serie		= dw_encabezado_cuenta_cte.GetItemString(1, 'oferta_v_serie')
gi_numero	= dw_encabezado_cuenta_cte.GetItemNumber(1, 'oferta_v_nro_oferta')
if gi_numero > 0 then
	ll_res	= messagebox("Advertencia","Está seguro Actualizar CADENA MORA Contrato Nº "+gs_base+'-'+gs_serie+'-'+string(gi_numero,'###,###,###,###,###'),Exclamation!,YesNo!,2)
	if ll_res=1 then
		SELECT	"CADENA"."NUMERO"  
		INTO 		:ll_num_aux  
		FROM 		"CADENA"  
		WHERE  ( "CADENA"."CODIGO" = :gs_base ) AND  
				 ( "CADENA"."SERIE" = :gs_serie ) AND  
				 ( "CADENA"."NUMERO" = :gi_numero )   
		USING		sqlca;
		if sqlca.sqlcode=0 then
			DECLARE sp_cadena_mora_cta_cte PROCEDURE FOR sp_nuevo_cadena_mora(:gs_base,:gs_serie,:gi_numero,'M');
			EXECUTE sp_cadena_mora_cta_cte;
			
			DECLARE sp_actualizar_cuponeras_1 PROCEDURE FOR sp_actualizar_cuponeras_1(:gs_base,:gs_serie,:gi_numero);
			EXECUTE sp_actualizar_cuponeras_1;
													
			w_cuenta_corriente_oferta.triggerevent(open!)
			messagebox("Grabar","Actualización Exitosa")
		else
			messagebox("Error","Error al Buscar Contrato Nº "+gs_base+'-'+gs_serie+'-'+string(gi_numero,'###,###,###,###,###')+ " SQL: "+sqlca.sqlerrtext)
		end if
	end if
end if
end event

