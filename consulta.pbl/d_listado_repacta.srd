 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"pago_oferta~" ) COLUMN(NAME=~"pago_oferta.serie~") COLUMN(NAME=~"pago_oferta.nro_oferta~") COLUMN(NAME=~"pago_oferta.fecha~") COLUMN(NAME=~"pago_oferta.folio~") COLUMN(NAME=~"pago_oferta.precio~") COLUMN(NAME=~"pago_oferta.pie~") COLUMN(NAME=~"pago_oferta.capacidad~") COLUMN(NAME=~"pago_oferta.valor_cuota~") COLUMN(NAME=~"pago_oferta.des_esp~") COLUMN(NAME=~"pago_oferta.nro_cuotas~") COLUMN(NAME=~"pago_oferta.moneda~") COLUMN(NAME=~"pago_oferta.fecha_prim~") COLUMN(NAME=~"pago_oferta.fecha_ult~") COLUMN(NAME=~"pago_oferta.fecha_pie~") COLUMN(NAME=~"pago_oferta.area~") COLUMN(NAME=~"pago_oferta.sector~")WHERE(    EXP1 =~"~~~"PAGO_OFERTA~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":as_serie~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"PAGO_OFERTA~~~".~~~"NRO_OFERTA~~~"~"   OP =~"=~"    EXP2 =~":an_numero~" ) ) ORDER(NAME=~"pago_oferta.folio~" ASC=yes ) ARG(NAME = ~"as_serie~" TYPE = string)  ARG(NAME = ~"an_numero~" TYPE = number) " update="PAGO_OFERTA" updatewhere=0 updatekeyinplace=no arguments=(("as_serie", string),("an_numero", number)) )
