 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"pagare~" )  TABLE(NAME=~"cod_parq~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"contrato~" )  TABLE(NAME=~"convenio_retiro~" )  TABLE(NAME=~"cadena_mora~" ) COLUMN(NAME=~"pagare.serie_p~") COLUMN(NAME=~"pagare.nro_pagare~") COLUMN(NAME=~"pagare.fecha~") COLUMN(NAME=~"pagare.serie~") COLUMN(NAME=~"pagare.nro_oferta~") COLUMN(NAME=~"pagare.kapital~") COLUMN(NAME=~"pagare.tasa~") COLUMN(NAME=~"pagare.valor_cuo~") COLUMN(NAME=~"pagare.fecha_prim~") COLUMN(NAME=~"pagare.fecha_ult~") COLUMN(NAME=~"pagare.plazo~") COLUMN(NAME=~"pagare.tot_pagado~") COLUMN(NAME=~"pagare.cta_pag_la~") COLUMN(NAME=~"pagare.cta_pag_isa~") COLUMN(NAME=~"pagare.estado~") COLUMN(NAME=~"pagare.nro_resc~") COLUMN(NAME=~"pagare.rut~") COLUMN(NAME=~"pagare.parque~") COLUMN(NAME=~"pagare.dueno~") COLUMN(NAME=~"pagare.origen~") COLUMN(NAME=~"pagare.moneda~") COLUMN(NAME=~"pagare.sector~") COLUMN(NAME=~"pagare.sepultura~") COLUMN(NAME=~"cod_parq.nombre~") COLUMN(NAME=~"pagare.base~") COLUMN(NAME=~"pagare.fechas_ingreso~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"pagare.estado_credito~") COLUMN(NAME=~"contrato.cod_convenio~") COLUMN(NAME=~"convenio_retiro.glosa~") COLUMN(NAME=~"pagare.forma_pago~") COLUMN(NAME=~"pagare.glosa_ficha~") COLUMN(NAME=~"cadena_mora.mora_cred~") COLUMN(NAME=~"cadena_mora.dias_mora_cred~") COLUMN(NAME=~"cadena_mora.fecha_venc_cred~")    JOIN (LEFT=~"pagare.serie~"    OP =~"=~"RIGHT=~"contrato.serie_c~"    OUTER1 =~"pagare.serie~" )    JOIN (LEFT=~"pagare.nro_oferta~"    OP =~"=~"RIGHT=~"contrato.nro_contrato~"    OUTER1 =~"pagare.nro_oferta~" )    JOIN (LEFT=~"contrato.cod_convenio~"    OP =~"=~"RIGHT=~"convenio_retiro.cod_convenio~"    OUTER1 =~"contrato.cod_convenio~" )    JOIN (LEFT=~"pagare.parque~"    OP =~"=~"RIGHT=~"cod_parq.codigo~" )    JOIN (LEFT=~"pagare.serie_p~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"pagare.nro_pagare~"    OP =~"=~"RIGHT=~"cadena.numero~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"cadena_mora.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"cadena_mora.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"cadena_mora.numero~" )WHERE(    EXP1 =~"~~~"PAGARE~~~".~~~"SERIE_P~~~"~"   OP =~"=~"    EXP2 =~":as_serie~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"PAGARE~~~".~~~"NRO_PAGARE~~~"~"   OP =~"=~"    EXP2 =~":an_numeo~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'P'~" ) ) ARG(NAME = ~"as_serie~" TYPE = string)  ARG(NAME = ~"an_numeo~" TYPE = number) " arguments=(("as_serie", string),("an_numeo", number)) )
