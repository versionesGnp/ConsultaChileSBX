l~") COLUMN(NAME=~"cuponeras_detalle.nro_cupon~") COLUMN(NAME=~"cuponeras_detalle.fecha_pago~") COLUMN(NAME=~"cuponeras_detalle.nro_cuota~") COLUMN(NAME=~"cuponeras_detalle.fecha_venc~") COLUMN(NAME=~"cuponeras_detalle.tipo_mov~") COLUMN(NAME=~"cuponeras_detalle.estado_pago_cupon~") COLUMN(NAME=~"cuponeras_detalle.monto_cuota_peso~") COLUMN(NAME=~"cuponeras_detalle.monto_interes_mora~") COLUMN(NAME=~"cuponeras_detalle.monto_gasto_cobranza~") COLUMN(NAME=~"cuponeras_detalle.tipo_cob_pago~") COLUMN(NAME=~"cuponeras_detalle.folio_pago~") COLUMN(NAME=~"cuponeras_detalle.monto_cuota_contrato~")    JOIN (LEFT=~"detalle_cupon_ci.tipo_mov~"    OP =~"=~"RIGHT=~"cuponeras_detalle.tipo_mov~"    OUTER2 =~"cuponeras_detalle.tipo_mov~" )    JOIN (LEFT=~"detalle_cupon_ci.num_cupon~"    OP =~"=~"RIGHT=~"cuponeras_detalle.nro_cupon~"    OUTER2 =~"cuponeras_detalle.nro_cupon~" )    JOIN (LEFT=~"cadena.rut~"    OP =~"=~"RIGHT=~"cliente.rut~" )    JOIN (LEFT=~"ciudad.codigo_ciudad~"    OP =~"=~"RIGHT=~"cliente.ciudad~" )    JOIN (LEFT=~"cliente.comuna~"    OP =~"=~"RIGHT=~"comuna.codigo_comuna~" )    JOIN (LEFT=~"cuponeras.base~"    OP =~"=~"RIGHT=~"cuponeras_detalle.base~" )    JOIN (LEFT=~"cuponeras.serie~"    OP =~"=~"RIGHT=~"cuponeras_detalle.serie~" )    JOIN (LEFT=~"cuponeras.numero~"    OP =~"=~"RIGHT=~"cuponeras_detalle.numero~" )    JOIN (LEFT=~"cuponeras.nro_cuponera~"    OP =~"=~"RIGHT=~"cuponeras_detalle.nro_cuponera~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"cuponeras.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"cuponeras.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"cuponeras.numero~" )WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CUPONERAS~~~".~~~"ESTADO_CUPONERA~~~"~"   OP =~"=~"    EXP2 =~"'V'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CUPONERAS_DETALLE~~~".~~~"ESTADO_PAGO_CUPON~~~"~"   OP =~"<>~"    EXP2 =~"'A'~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number) " arguments=(("base", string),("serie", string),("numero", number))  sort="cuponeras_detalle_fecha_venc A " )
