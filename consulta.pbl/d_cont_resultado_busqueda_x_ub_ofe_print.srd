table(column=(type=char(1) updatewhereclause=yes name=cadena_codigo dbname="cadena.codigo" )
 column=(type=char(1) updatewhereclause=yes name=cadena_serie dbname="cadena.serie" )
 column=(type=decimal(4) updatewhereclause=yes name=cadena_numero dbname="cadena.numero" )
 column=(type=char(1) updatewhereclause=yes name=cadena_estado dbname="cadena.estado" )
 column=(type=char(40) updatewhereclause=yes name=cliente_a_paterno dbname="cliente.a_paterno" )
 column=(type=char(40) updatewhereclause=yes name=cliente_a_materno dbname="cliente.a_materno" )
 column=(type=char(40) updatewhereclause=yes name=cliente_nombre dbname="cliente.nombre" )
 column=(type=decimal(4) updatewhereclause=yes name=cliente_rut dbname="cliente.rut" )
 column=(type=char(1) updatewhereclause=yes name=cliente_dv dbname="cliente.dv" )
 column=(type=char(2) updatewhereclause=yes name=pago_oferta_area dbname="pago_oferta.area" )
 column=(type=char(8) updatewhereclause=yes name=pago_oferta_sector dbname="pago_oferta.sector" )
 column=(type=char(8) updatewhereclause=yes name=pago_oferta_sepultura dbname="pago_oferta.sepultura" )
 column=(type=decimal(4) updatewhereclause=yes name=pago_oferta_capacidad dbname="pago_oferta.capacidad" )
 column=(type=decimal(4) updatewhereclause=yes name=cadena_cod_parque dbname="cadena.cod_parque" )
 column=(type=char(10) updatewhereclause=yes name=vista_existe_en_fosa_comun_fosa_comun dbname="vista_existe_en_fosa_comun.fosa_comun" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cadena~" )  TABLE(NAME=~"cliente~" )  TABLE(NAME=~"oferta_v~" )  TABLE(NAME=~"pago_oferta~" )  TABLE(NAME=~"vista_existe_en_fosa_comun~" ) COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"cadena.serie~") COLUMN(NAME=~"cadena.numero~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.rut~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"pago_oferta.area~") COLUMN(NAME=~"pago_oferta.sector~") COLUMN(NAME=~"pago_oferta.sepultura~") COLUMN(NAME=~"pago_oferta.capacidad~") COLUMN(NAME=~"cadena.cod_parque~") COLUMN(NAME=~"vista_existe_en_fosa_comun.fosa_comun~")    JOIN (LEFT=~"cadena.rut~"    OP =~"=~"RIGHT=~"cliente.rut~"    OUTER1 =~"cadena.rut~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"vista_existe_en_fosa_comun.base~"    OUTER1 =~"cadena.codigo~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"vista_existe_en_fosa_comun.serie~"    OUTER1 =~"cadena.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"vista_existe_en_fosa_comun.numero~"    OUTER1 =~"cadena.numero~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"oferta_v.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"oferta_v.nro_oferta~" )    JOIN (LEFT=~"oferta_v.serie~"    OP =~"=~"RIGHT=~"pago_oferta.serie~" )    JOIN (LEFT=~"oferta_v.nro_oferta~"    OP =~"=~"RIGHT=~"pago_oferta.nro_oferta~" )    JOIN (LEFT=~"oferta_v.ult_folio~"    OP =~"=~"RIGHT=~"pago_oferta.folio~" )WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"like~"    EXP2 =~":base~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"PAGO_OFERTA~~~".~~~"SECTOR~~~"~"   OP =~"like~"    EXP2 =~":as_sector~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"PAGO_OFERTA~~~".~~~"SEPULTURA~~~"~"   OP =~"like~"    EXP2 =~":as_sepultura~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"PAGO_OFERTA~~~".~~~"AREA~~~"~"   OP =~"like~"    EXP2 =~":as_area~" ) )    UNION (PBSELECT( VERSION(400) TABLE(NAME=~"cadena~" )  TABLE(NAME=~"cliente~" )  TABLE(NAME=~"contrato~" )  TABLE(NAME=~"vista_existe_en_fosa_comun~" ) COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"cadena.serie~") COLUMN(NAME=~"cadena.numero~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.rut~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"contrato.zona~") COLUMN(NAME=~"contrato.sector~") COLUMN(NAME=~"contrato.sepultura~") COLUMN(NAME=~"contrato.capacidad~") COLUMN(NAME=~"cadena.cod_parque~") COLUMN(NAME=~"vista_existe_en_fosa_comun.fosa_comun~")    JOIN (LEFT=~"cadena.rut~"    OP =~"=~"RIGHT=~"cliente.rut~"    OUTER1 =~"cadena.rut~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"vista_existe_en_fosa_comun.base~"    OUTER1 =~"cadena.codigo~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"vista_existe_en_fosa_comun.serie~"    OUTER1 =~"cadena.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"vista_existe_en_fosa_comun.numero~"    OUTER1 =~"cadena.numero~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"contrato.serie_c~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"contrato.nro_contrato~" )WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"like~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CONTRATO~~~".~~~"ZONA~~~"~"   OP =~"like~"    EXP2 =~":as_area~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CONTRATO~~~".~~~"SECTOR~~~"~"   OP =~"like~"    EXP2 =~":as_sector~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CONTRATO~~~".~~~"SEPULTURA~~~"~"   OP =~"like~"    EXP2 =~":as_sepultura~" ) )) ORDER(NAME=~"11~" ASC=yes )  ORDER(NAME=~"12~" ASC=yes ) ARG(NAME = ~"as_sector~" TYPE = string)  ARG(NAME = ~"as_sepultura~" TYPE = string)  ARG(NAME = ~"as_area~" TYPE = string)  ARG(NAME = ~"base~" TYPE = string) " arguments=(("as_sector", string),("as_sepultura", string),("as_area", string),("base", string))  sort="cadena_codigo A cadena_serie A cadena_numero A " )
