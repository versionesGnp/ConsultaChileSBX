 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cliente~" )  TABLE(NAME=~"comuna~" )  TABLE(NAME=~"ciudad~" )  TABLE(NAME=~"repacta_mantencion_l~" ) COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.direccion_p~") COLUMN(NAME=~"cliente.poblacion~") COLUMN(NAME=~"cliente.sector~") COLUMN(NAME=~"cliente.comuna~") COLUMN(NAME=~"cliente.ciudad~") COLUMN(NAME=~"cliente.fono_p~") COLUMN(NAME=~"cliente.fecha_nac~") COLUMN(NAME=~"cliente.estado_titular~") COLUMN(NAME=~"cliente.domicilio_c~") COLUMN(NAME=~"cliente.fono_c~") COLUMN(NAME=~"comuna.comuna~") COLUMN(NAME=~"ciudad.ciudad~") COLUMN(NAME=~"cliente.tipo_via~") COLUMN(NAME=~"cliente.numero_particular~") COLUMN(NAME=~"cliente.depto_particular~") COLUMN(NAME=~"cliente.block_particular~") COLUMN(NAME=~"cliente.email~") COLUMN(NAME=~"cliente.celular~") COLUMN(NAME=~"repacta_mantencion_l.base~") COLUMN(NAME=~"repacta_mantencion_l.serie~") COLUMN(NAME=~"repacta_mantencion_l.numero~") COLUMN(NAME=~"repacta_mantencion_l.base_original~") COLUMN(NAME=~"repacta_mantencion_l.serie_original~") COLUMN(NAME=~"repacta_mantencion_l.numero_original~") COLUMN(NAME=~"repacta_mantencion_l.correlativo~") COLUMN(NAME=~"repacta_mantencion_l.fecha_crea~") COLUMN(NAME=~"repacta_mantencion_l.total_deuda~") COLUMN(NAME=~"repacta_mantencion_l.cuotas_pactadas~") COLUMN(NAME=~"repacta_mantencion_l.estado_pago~") COLUMN(NAME=~"repacta_mantencion_l.valor_cuota~") COLUMN(NAME=~"repacta_mantencion_l.fecha_primera_cta~") COLUMN(NAME=~"repacta_mantencion_l.cuotas_en_mora~") COLUMN(NAME=~"repacta_mantencion_l.usuario~") COLUMN(NAME=~"repacta_mantencion_l.ctas_pagadas~") COLUMN(NAME=~"repacta_mantencion_l.abono~") COLUMN(NAME=~"repacta_mantencion_l.saldo~") COLUMN(NAME=~"repacta_mantencion_l.rut_cliente~") COLUMN(NAME=~"repacta_mantencion_l.dv_cliente~") COLUMN(NAME=~"repacta_mantencion_l.uf_dia~") COLUMN(NAME=~"repacta_mantencion_l.tipo_moneda~") COLUMN(NAME=~"repacta_mantencion_l.total_deuda_uf~") COLUMN(NAME=~"repacta_mantencion_l.valor_cuota_uf~") COLUMN(NAME=~"repacta_mantencion_l.interes_cuota_pesos~") COLUMN(NAME=~"repacta_mantencion_l.interes_deuda_pesos~") COLUMN(NAME=~"repacta_mantencion_l.interes_adm_pesos~") COLUMN(NAME=~"repacta_mantencion_l.por_descuento~") COLUMN(NAME=~"repacta_mantencion_l.factor_aplicado~") COLUMN(NAME=~"repacta_mantencion_l.total_pagado~") COLUMN(NAME=~"repacta_mantencion_l.fecha_ult~") COLUMN(NAME=~"repacta_mantencion_l.cta_mora_original~") COLUMN(NAME=~"repacta_mantencion_l.cant_print~")    JOIN (LEFT=~"cliente.comuna~"    OP =~"=~"RIGHT=~"comuna.codigo_comuna~" )    JOIN (LEFT=~"cliente.ciudad~"    OP =~"=~"RIGHT=~"ciudad.codigo_ciudad~" )    JOIN (LEFT=~"cliente.rut~"    OP =~"=~"RIGHT=~"repacta_mantencion_l.rut_cliente~" )) "  sort="repacta_mantencion_l_fecha_crea D repacta_mantencion_l_numero A " )
