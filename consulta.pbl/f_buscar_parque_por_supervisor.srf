global type f_buscar_parque_por_supervisor from function_object
end type

forward prototypes
global function string f_buscar_parque_por_supervisor (string as_supervisor)
end prototypes

global function string f_buscar_parque_por_supervisor (string as_supervisor);String	ls_parque
Long		ll_cod_parque

SELECT	"SUPERVISOR"."COD_PARQUE"  
INTO 		:ll_cod_parque  
FROM 		"SUPERVISOR"  
WHERE 	"SUPERVISOR"."COD_SUP" = :as_supervisor   
USING		sqlca;
if sqlca.sqlcode=0 then
	SELECT	"COD_PARQ"."NOMBRE"  
	INTO 		:ls_parque  
	FROM 		"COD_PARQ"  
	WHERE 	"COD_PARQ"."CODIGO" = :ll_cod_parque   
	USING		sqlca;
	if sqlca.sqlcode<>0 then
		ls_parque	= 'XXX'
	end if
else
	ls_parque		= 'XXX'
end if
return ls_parque
end function

