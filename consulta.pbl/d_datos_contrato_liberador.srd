nexo_liberador.estatus_comision~") COLUMN(NAME=~"anexo_liberador.base_liberador~")    JOIN (LEFT=~"anexo_liberador.rut~"    OP =~"=~"RIGHT=~"cliente.rut~"    OUTER1 =~"anexo_liberador.rut~" )    JOIN (LEFT=~"anexo_liberador.serie_m~"    OP =~"=~"RIGHT=~"pago_liberador.serie_m~" )    JOIN (LEFT=~"anexo_liberador.nro_liberador~"    OP =~"=~"RIGHT=~"pago_liberador.nro_liberador~" )WHERE(    EXP1 =~"~~~"ANEXO_LIBERADOR~~~".~~~"SERIE_M~~~"~"   OP =~"=~"    EXP2 =~":as_serie~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"ANEXO_LIBERADOR~~~".~~~"NRO_LIBERADOR~~~"~"   OP =~"=~"    EXP2 =~":an_numero~" ) ) ARG(NAME = ~"as_serie~" TYPE = string)  ARG(NAME = ~"an_numero~" TYPE = number) " arguments=(("as_serie", string),("an_numero", number)) )
