te.lon_geo~") COLUMN(NAME=~"cliente.status_geo~") COLUMN(NAME=~"cadena.estado_carta~") COLUMN(NAME=~"estado_envio.descripcion~") COLUMN(NAME=~"cliente.estado_cobranza~") COLUMN(NAME=~"cadena_mora.mora_cred~") COLUMN(NAME=~"cadena_mora.dias_mora_cred~") COLUMN(NAME=~"cadena_mora.fecha_venc_cred~") COLUMN(NAME=~"cadena.objeto_id~") COLUMN(NAME=~"cadena.objeto_id_estado~") COLUMN(NAME=~"pago_liberador.anno_liberar~") COLUMN(NAME=~"cadena.estado_mora_credito~") COLUMN(NAME=~"cadena.estado_mora_mantencion~") COLUMN(NAME=~"anexo_liberador.cierre_venta~")    JOIN (LEFT=~"anexo_liberador.rut~"    OP =~"=~"RIGHT=~"cliente.rut~"    OUTER1 =~"anexo_liberador.rut~" )    JOIN (LEFT=~"cadena.estado_carta~"    OP =~"=~"RIGHT=~"estado_envio.codigo_num~"    OUTER1 =~"cadena.estado_carta~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"cadena_mora.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"cadena_mora.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"cadena_mora.numero~" )    JOIN (LEFT=~"anexo_liberador.serie_m~"    OP =~"=~"RIGHT=~"pago_liberador.serie_m~" )    JOIN (LEFT=~"anexo_liberador.nro_liberador~"    OP =~"=~"RIGHT=~"pago_liberador.nro_liberador~" )    JOIN (LEFT=~"anexo_liberador.ult_folio~"    OP =~"=~"RIGHT=~"pago_liberador.folio~" )    JOIN (LEFT=~"anexo_liberador.serie_m~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"anexo_liberador.nro_liberador~"    OP =~"=~"RIGHT=~"cadena.numero~" )WHERE(    EXP1 =~"~~~"ANEXO_LIBERADOR~~~".~~~"SERIE_M~~~"~"   OP =~"=~"    EXP2 =~":as_serie~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"ANEXO_LIBERADOR~~~".~~~"NRO_LIBERADOR~~~"~"   OP =~"=~"    EXP2 =~":an_numero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'L'~" ) ) ARG(NAME = ~"as_serie~" TYPE = string)  ARG(NAME = ~"an_numero~" TYPE = number) " arguments=(("as_serie", string),("an_numero", number)) )
