 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cliente_contacto~" )  TABLE(NAME=~"cliente~" ) COLUMN(NAME=~"cliente_contacto.rut~") COLUMN(NAME=~"cliente_contacto.dv~") COLUMN(NAME=~"cliente_contacto.nombre~") COLUMN(NAME=~"cliente_contacto.a_paterno~") COLUMN(NAME=~"cliente_contacto.a_materno~") COLUMN(NAME=~"cliente_contacto.direccion_p~") COLUMN(NAME=~"cliente_contacto.poblacion~") COLUMN(NAME=~"cliente_contacto.sector~") COLUMN(NAME=~"cliente_contacto.comuna~") COLUMN(NAME=~"cliente_contacto.ciudad~") COLUMN(NAME=~"cliente_contacto.fono_p~") COLUMN(NAME=~"cliente_contacto.sexo~") COLUMN(NAME=~"cliente_contacto.fecha_nac~") COLUMN(NAME=~"cliente_contacto.esta_civil~") COLUMN(NAME=~"cliente.estado_cobranza~") COLUMN(NAME=~"cliente.fecha_cobranza~") COLUMN(NAME=~"cliente.glosa_cobranza~")    JOIN (LEFT=~"cliente_contacto.rut~"    OP =~"=~"RIGHT=~"cliente.rut_contacto~" )WHERE(    EXP1 =~"~~~"CLIENTE~~~".~~~"RUT~~~"~"   OP =~"=~"    EXP2 =~":an_rut~" ) ) ARG(NAME = ~"an_rut~" TYPE = number) " arguments=(("an_rut", number)) )
