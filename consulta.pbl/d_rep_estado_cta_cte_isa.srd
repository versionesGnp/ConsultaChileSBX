 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cadena~" )  TABLE(NAME=~"estado~" ) COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"cadena.fecha_res~") COLUMN(NAME=~"cadena.nro_carta~") COLUMN(NAME=~"cadena.fecha_carta~") COLUMN(NAME=~"cadena.estado_carta~") COLUMN(NAME=~"cadena.estado_titulo~") COLUMN(NAME=~"cadena.fecha_titulo~") COLUMN(NAME=~"estado.nombre_estado~") COLUMN(NAME=~"cadena.cod_parque~") COLUMN(NAME=~"cadena.estado_mora_credito~") COLUMN(NAME=~"cadena.estado_mora_mantencion~")    JOIN (LEFT=~"cadena.estado~"    OP =~"=~"RIGHT=~"estado.cod_estado~" )WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":as_serie~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":an_numero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'C'~" ) ) ARG(NAME = ~"as_serie~" TYPE = string)  ARG(NAME = ~"an_numero~" TYPE = number) " arguments=(("as_serie", string),("an_numero", number)) )
