table(column=(type=char(30) updatewhereclause=yes name=nombre dbname="co_prop.nombre" )
 column=(type=char(15) updatewhereclause=yes name=a_paterno dbname="co_prop.a_paterno" )
 column=(type=char(15) updatewhereclause=yes name=a_materno dbname="co_prop.a_materno" )
 column=(type=decimal(4) updatewhereclause=yes name=rut dbname="co_prop.rut" )
 column=(type=char(1) updatewhereclause=yes name=serie dbname="co_prop.serie" )
 column=(type=decimal(4) updatewhereclause=yes name=nro_oferta dbname="co_prop.nro_oferta" )
 column=(type=char(1) updatewhereclause=yes name=dv dbname="co_prop.dv" )
 column=(type=datetime updatewhereclause=yes name=fecha_nac dbname="co_prop.fecha_nac" )
 column=(type=char(1) updatewhereclause=yes name=sexo dbname="co_prop.sexo" )
 column=(type=char(1) updatewhereclause=yes name=base dbname="co_prop.base" )
 column=(type=char(30) updatewhereclause=yes name=tipo_beneficiario dbname="co_prop.tipo_beneficiario" )
 column=(type=char(30) updatewhereclause=yes name=parentesco dbname="co_prop.parentesco" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"co_prop~" ) COLUMN(NAME=~"co_prop.nombre~") COLUMN(NAME=~"co_prop.a_paterno~") COLUMN(NAME=~"co_prop.a_materno~") COLUMN(NAME=~"co_prop.rut~") COLUMN(NAME=~"co_prop.serie~") COLUMN(NAME=~"co_prop.nro_oferta~") COLUMN(NAME=~"co_prop.dv~") COLUMN(NAME=~"co_prop.fecha_nac~") COLUMN(NAME=~"co_prop.sexo~") COLUMN(NAME=~"co_prop.base~") COLUMN(NAME=~"co_prop.tipo_beneficiario~") COLUMN(NAME=~"co_prop.parentesco~")WHERE(    EXP1 =~"~~~"CO_PROP~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":as_serie~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CO_PROP~~~".~~~"NRO_OFERTA~~~"~"   OP =~"=~"    EXP2 =~":an_numero~" ) ) ARG(NAME = ~"as_serie~" TYPE = string)  ARG(NAME = ~"an_numero~" TYPE = number) " arguments=(("as_serie", string),("an_numero", number))  sort="tipo_beneficiario A a_paterno A nombre A a_materno A " )
