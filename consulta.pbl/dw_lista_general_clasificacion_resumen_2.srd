column(band=header.1 id=15 alignment="0" tabsequence=32766 border="0" color="0~tif ( c_evaluacion='Alto',rgb(0,0,0),   if (  c_evaluacion='Medio',rgb(255,255,255),if ( c_evaluacion='Bajo',rgb(0,0,0),rgb(0,0,0) ) ) )" x="347" y="24" height="84" width="686" format="[general]"  name=parque dddw.name=ddw_lista_parque_nuestro dddw.displaycolumn=nombre dddw.datacolumn=codigo dddw.percentwidth=0 dddw.lines=0 dddw.limit=0 dddw.allowedit=no dddw.useasborder=no dddw.case=any  font.face="Arial" font.height="-12" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="0" background.color="553648127~tif ( c_evaluacion='Alto',rgb(255,255,0),   if (  c_evaluacion='Medio',rgb(0,0,255),if ( c_evaluacion='Bajo',rgb(255,0,0),rgb(255,255,255) ) ) )" )
