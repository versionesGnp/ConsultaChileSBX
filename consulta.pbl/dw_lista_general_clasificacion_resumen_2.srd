compute(band=detail alignment="2" expression=" op_pie + op_justifica_renta + op_comp_domicilio + op_plazo +  at_electrodomestico "border="5" color="0~tif ( c_evaluacion='Alto',rgb(0,0,0),   if (  c_evaluacion='Medio',rgb(255,255,255),if ( c_evaluacion='Bajo',rgb(0,0,0),rgb(0,0,0) ) ) )" x="46" y="212" height="68" width="178" format="###,###,###,##0.0###"  name=c_suma_op  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="0" background.color="16777215~tif ( c_evaluacion='Alto',rgb(255,255,0),   if (  c_evaluacion='Medio',rgb(0,0,255),if ( c_evaluacion='Bajo',rgb(255,0,0),rgb(255,255,255) ) ) )" )
compute(band=detail alignment="2" expression=" at_tipo_vivienda + at_telecomunicaciones + at_interes_cliente +  at_automovil "border="5" color="0~tif ( c_evaluacion='Alto',rgb(0,0,0),   if (  c_evaluacion='Medio',rgb(255,255,255),if ( c_evaluacion='Bajo',rgb(0,0,0),rgb(0,0,0) ) ) )" x="251" y="220" height="68" width="210" format="###,###,###,##0.0###"  name=c_suma_at  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="0" background.color="16777215~tif ( c_evaluacion='Alto',rgb(255,255,0),   if (  c_evaluacion='Medio',rgb(0,0,255),if ( c_evaluacion='Bajo',rgb(255,0,0),rgb(255,255,255) ) ) )" )
