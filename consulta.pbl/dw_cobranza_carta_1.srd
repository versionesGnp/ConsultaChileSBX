 column=(type=decimal(4) updatewhereclause=yes name=cod_accion dbname="carta_log.cod_accion" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"carta_log~" ) COLUMN(NAME=~"carta_log.base~") COLUMN(NAME=~"carta_log.serie~") COLUMN(NAME=~"carta_log.numero~") COLUMN(NAME=~"carta_log.rut~") COLUMN(NAME=~"carta_log.cod_envio~") COLUMN(NAME=~"carta_log.estado_env~") COLUMN(NAME=~"carta_log.fecha_carta~") COLUMN(NAME=~"carta_log.mora~") COLUMN(NAME=~"carta_log.cod_accion~")WHERE(    EXP1 =~"~~~"CARTA_LOG~~~".~~~"RUT~~~"~"   OP =~"=~"    EXP2 =~":rut~" ) ) ARG(NAME = ~"rut~" TYPE = number) " update="CARTA_LOG" updatewhere=1 updatekeyinplace=no arguments=(("rut", number))  sort="fecha_carta D " )
