 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cliente~" )  TABLE(NAME=~"contrato~" )  TABLE(NAME=~"convenio_retiro~" )  TABLE(NAME=~"vista_existe_en_fosa_comun~" )  TABLE(NAME=~"cadena~" ) COLUMN(NAME=~"cliente.rut~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"contrato.serie_c~") COLUMN(NAME=~"contrato.nro_contrato~") COLUMN(NAME=~"contrato.fecha~") COLUMN(NAME=~"contrato.tasa~") COLUMN(NAME=~"contrato.valor_cuo~") COLUMN(NAME=~"contrato.fecha_prim~") COLUMN(NAME=~"contrato.fecha_ult~") COLUMN(NAME=~"contrato.plazo~") COLUMN(NAME=~"contrato.tot_pagado~") COLUMN(NAME=~"contrato.cta_pag_la~") COLUMN(NAME=~"contrato.cta_pag_isa~") COLUMN(NAME=~"contrato.fechas_ingreso~") COLUMN(NAME=~"contrato.sector~") COLUMN(NAME=~"contrato.sepultura~") COLUMN(NAME=~"contrato.zona~") COLUMN(NAME=~"contrato.capacidad~") COLUMN(NAME=~"contrato.fecha_m~") COLUMN(NAME=~"contrato.valor_cuota_m~") COLUMN(NAME=~"contrato.u_folio~") COLUMN(NAME=~"contrato.u_fecha~") COLUMN(NAME=~"contrato.cta_pag_m~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"contrato.anexo_lib~") COLUMN(NAME=~"contrato.nro_tec~") COLUMN(NAME=~"contrato.pie~") COLUMN(NAME=~"contrato.nro_resc~") COLUMN(NAME=~"cliente.estado_cobranza~") COLUMN(NAME=~"cliente.fecha_cobranza~") COLUMN(NAME=~"cliente.glosa_cobranza~") COLUMN(NAME=~"cliente.direccion_p~") COLUMN(NAME=~"cliente.tipo_via~") COLUMN(NAME=~"cliente.numero_particular~") COLUMN(NAME=~"cliente.depto_particular~") COLUMN(NAME=~"cliente.block_particular~") COLUMN(NAME=~"cliente.comuna~") COLUMN(NAME=~"cliente.ciudad~") COLUMN(NAME=~"cliente.fono_p~") COLUMN(NAME=~"contrato.cod_convenio~") COLUMN(NAME=~"convenio_retiro.glosa~") COLUMN(NAME=~"convenio_retiro.moneda~") COLUMN(NAME=~"convenio_retiro.valor~") COLUMN(NAME=~"convenio_retiro.notas~") COLUMN(NAME=~"convenio_retiro.vigencia_descripcion~") COLUMN(NAME=~"convenio_retiro.vigencia_codigo~") COLUMN(NAME=~"convenio_retiro.fono~") COLUMN(NAME=~"contrato.uso~") COLUMN(NAME=~"convenio_retiro.direccion~") COLUMN(NAME=~"cliente.poblacion~") COLUMN(NAME=~"cliente.sector~") COLUMN(NAME=~"cliente.fecha_nac~") COLUMN(NAME=~"cliente.fono_c~") COLUMN(NAME=~"cliente.estado_titular~") COLUMN(NAME=~"cliente.email~") COLUMN(NAME=~"cliente.celular~") COLUMN(NAME=~"contrato.kapital~") COLUMN(NAME=~"contrato.parque~") COLUMN(NAME=~"contrato.forma_pago~") COLUMN(NAME=~"vista_existe_en_fosa_comun.fosa_comun~")    JOIN (LEFT=~"cliente.rut~"    OP =~"=~"RIGHT=~"contrato.rut~"    OUTER2 =~"contrato.rut~" )    JOIN (LEFT=~"contrato.cod_convenio~"    OP =~"=~"RIGHT=~"convenio_retiro.cod_convenio~"    OUTER1 =~"contrato.cod_convenio~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"vista_existe_en_fosa_comun.base~"    OUTER1 =~"cadena.codigo~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"vista_existe_en_fosa_comun.serie~"    OUTER1 =~"cadena.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"vista_existe_en_fosa_comun.numero~"    OUTER1 =~"cadena.numero~" )   JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"contrato.serie_c~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"contrato.nro_contrato~" ) WHERE(    EXP1 =~"~~~"CONTRATO~~~".~~~"SERIE_C~~~"~"   OP =~"=~"    EXP2 =~":as_serie~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CONTRATO~~~".~~~"NRO_CONTRATO~~~"~"   OP =~"=~"    EXP2 =~":an_numero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'C'~" ) ) ARG(NAME = ~"as_serie~" TYPE = string)  ARG(NAME = ~"an_numero~" TYPE = number) " arguments=(("as_serie", string),("an_numero", number)) )
