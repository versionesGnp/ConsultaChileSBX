 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"documentos~" )  TABLE(NAME=~"ingreso~" ) COLUMN(NAME=~"documentos.folio~") COLUMN(NAME=~"documentos.tipo_cob~") COLUMN(NAME=~"documentos.n_cheque~") COLUMN(NAME=~"documentos.cod_banco~") COLUMN(NAME=~"documentos.monto~") COLUMN(NAME=~"documentos.fecha_venc~") COLUMN(NAME=~"documentos.num_cheques~") COLUMN(NAME=~"documentos.rezago~") COLUMN(NAME=~"documentos.cod_caja~") COLUMN(NAME=~"documentos.fecha_pago~") COLUMN(NAME=~"documentos.cod_pago~")    JOIN (LEFT=~"documentos.folio~"    OP =~"=~"RIGHT=~"ingreso.folio~" )    JOIN (LEFT=~"documentos.tipo_cob~"    OP =~"=~"RIGHT=~"ingreso.tipo_cob~" )WHERE(    EXP1 =~"( ( ~~~"DOCUMENTOS~~~".~~~"COD_PAGO~~~"~"   OP =~"=~"    EXP2 =~"'CH' ) )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"DOCUMENTOS~~~".~~~"FOLIO~~~"~"   OP =~"=~"    EXP2 =~":follio~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"RUT~~~"~"   OP =~"=~"    EXP2 =~":rut~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"DOCUMENTOS~~~".~~~"N_CHEQUE~~~"~"   OP =~"=~"    EXP2 =~":num_cheque~" ) ) ARG(NAME = ~"follio~" TYPE = number)  ARG(NAME = ~"rut~" TYPE = number)  ARG(NAME = ~"num_cheque~" TYPE = number) " arguments=(("follio", number),("rut", number),("num_cheque", number)) )
