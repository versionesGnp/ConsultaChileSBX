this.menubackcolor = 134217732
this.menuhighlightcolor = 134217741
this.textsize = 8
this.weight = 400
this.facename = "Tahoma"
this.titlebackcolor = 134217730
this.bitmapbackcolor = 12632256
this.menubitmaps = true
this.titlegradient = true
this.toolbartextcolor = 134217746
this.toolbarbackcolor = 67108864
this.toolbarhighlightcolor = 134217741
this.toolbargradient = true
this.bitmapgradient = true
this.m_promesas=create m_promesas
this.m_liberadores=create m_liberadores
this.m_aumentocapacidad4=create m_aumentocapacidad4
this.m_informegestiónactual=create m_informegestiónactual
this.m_informegestiónhistórica=create m_informegestiónhistórica
this.m_estructuradeventa=create m_estructuradeventa
this.m_cierreventas=create m_cierreventas
this.m_licenciasmédicas=create m_licenciasmédicas
this.m_consultas0=create m_consultas0
this.m_estadocartera=create m_estadocartera
this.m_promesasperiodo=create m_promesasperiodo
this.m_moraagente=create m_moraagente
