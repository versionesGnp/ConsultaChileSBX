type m_ingresar_individual_cobranza from menu within m_cobranzatelefónica0
event clicked ( )
end type

event clicked;long       ll_cta

SELECT  COUNT("ENCARGADOS"."CODIGO_USUARIO")
INTO                     :ll_cta
FROM                   "AGENTES","ENCARGADOS"  
WHERE "AGENTES"."RUT" = "ENCARGADOS"."RUT" and  
                "AGENTES"."ESTADO" = 'A' AND  
                "AGENTES"."CANAL" = 'EC' AND  
                                               "ENCARGADOS"."CODIGO_USUARIO" = :gs_user AND
                "ENCARGADOS"."ESTADO" = 'A'    
ORDER BY "AGENTES"."FECHA_INI" ASC
USING  sqlca;
if isnull(ll_cta) then ll_cta=0
if ll_cta=1 then
                if isvalid(w_ingreso_individual_cobranza) then close(w_ingreso_individual_cobranza)
                open(w_ingreso_individual_cobranza)
else
                if isvalid(w_total_ctto_asignados) then close(w_total_ctto_asignados)
                open(w_total_ctto_asignados)
end if

end event

on m_ingresar_individual_cobranza.create
call super::create
this.text = "&Ingresar Cobranza"
