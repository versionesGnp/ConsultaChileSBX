m_sap m_sap
m_mantenedordeprecios m_mantenedordeprecios
m_anulacióndecontratosvigentes m_anulacióndecontratosvigentes
end type

on m_herramienta.create
call super::create
this.text = "&Herramienta"
this.microhelp = "MODULO HERRAMIENTA"
this.menutextcolor = 134217735
this.menubackcolor = 134217732
this.menuhighlightcolor = 134217741
this.textsize = 8
this.weight = 400
this.facename = "Tahoma"
this.titlebackcolor = 134217730
this.bitmapbackcolor = 12632256
this.menubitmaps = true
this.titlegradient = true
this.toolbartextcolor = 134217746
this.toolbarbackcolor = 67108864
this.toolbarhighlightcolor = 134217741
this.toolbargradient = true
this.bitmapgradient = true
this.m_cambiaconexion=create m_cambiaconexion
this.m_cambiopassword=create m_cambiopassword
this.m_perfilusuario=create m_perfilusuario
this.m_solicitudusuario=create m_solicitudusuario
this.m_mantenedortablas=create m_mantenedortablas
this.m_mantenedorsoporte=create m_mantenedorsoporte
this.m_validaciónlogonclave=create m_validaciónlogonclave
this.m_sap=create m_sap
this.m_mantenedordeprecios=create m_mantenedordeprecios
this.m_anulacióndecontratosvigentes=create m_anulacióndecontratosvigentes
this.Item[UpperBound(this.Item)+1]=this.m_cambiaconexion
this.Item[UpperBound(this.Item)+1]=this.m_cambiopassword
this.Item[UpperBound(this.Item)+1]=this.m_perfilusuario
this.Item[UpperBound(this.Item)+1]=this.m_solicitudusuario
this.Item[UpperBound(this.Item)+1]=this.m_mantenedortablas
this.Item[UpperBound(this.Item)+1]=this.m_mantenedorsoporte
this.Item[UpperBound(this.Item)+1]=this.m_validaciónlogonclave
this.Item[UpperBound(this.Item)+1]=this.m_sap
this.Item[UpperBound(this.Item)+1]=this.m_mantenedordeprecios
this.Item[UpperBound(this.Item)+1]=this.m_anulacióndecontratosvigentes
end on

on m_herramienta.destroy
call super::destroy
destroy(this.m_cambiaconexion)
destroy(this.m_cambiopassword)
destroy(this.m_perfilusuario)
destroy(this.m_solicitudusuario)
destroy(this.m_mantenedortablas)
destroy(this.m_mantenedorsoporte)
destroy(this.m_validaciónlogonclave)
destroy(this.m_sap)
destroy(this.m_mantenedordeprecios)
destroy(this.m_anulacióndecontratosvigentes)
end on

