type m_mantenedorcaja from menu within m_caja0
end type

event clicked;String		ls_codigo_sol,ls_usuario,ls_estado

SELECT     	"SOL_PERMISOS_USUARIO"."CODIGO_SOLICITUD",   
             		"SOL_PERMISOS_USUARIO"."USUARIO",   
             		"SOL_PERMISOS_USUARIO"."ESTADO"  
INTO        	:ls_codigo_sol,   
             		:ls_usuario,   
             		:ls_estado
FROM     	"SOL_PERMISOS_USUARIO"  
WHERE     	( "SOL_PERMISOS_USUARIO"."USUARIO" = :gs_user ) AND  
             		( "SOL_PERMISOS_USUARIO"."CODIGO_SOLICITUD" = 'CC' )    ;
if sqlca.sqlcode=0 then
    if ls_estado='A' then
        if isvalid(w_modifica_caja_ingreso) then close(w_modifica_caja_ingreso)
        open(w_modifica_caja_ingreso)
    else
        messagebox("Advertencia","Usuario No tiene Acceso - Estado Inactivo")
    end if
else
    messagebox("Advertencia","Usuario No tiene Acceso")
end if
end event

on m_mantenedorcaja.create
call super::create
this.text = "Mantenedor Caja"
this.menutextcolor = 134217735
this.menubackcolor = 134217732
this.menuhighlightcolor = 134217741
this.textsize = 8
