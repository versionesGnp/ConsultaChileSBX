type m_comisionesadicionales from menu within m_fichasepultación
end type

event clicked;Long ll_count=0

SELECT	count("SOL_PERMISOS_USUARIO"."CODIGO_SOLICITUD")
INTO		:ll_count 
FROM		"SOL_PERMISOS_USUARIO" 
WHERE	( "SOL_PERMISOS_USUARIO"."USUARIO" = :gs_user ) AND 
			( "SOL_PERMISOS_USUARIO"."ESTADO" = 'A' ) AND
			( "SOL_PERMISOS_USUARIO"."CODIGO_SOLICITUD" = 'SA' ) ;
if ll_count > 0 then
//	if isvalid(w_lista_ventas_adicionales) then close(w_lista_ventas_adicionales)
//	open(w_lista_ventas_adicionales)
else
	messagebox("Advertencia","Ud. No tiene Acceso")
end if
end event

