type m_cambioejecutivo from menu within m_reclamos
end type

event clicked;long ll_count

if gs_depto='I' then
	if isvalid(w_reemplazo_usuario_requerimiento) then close(w_reemplazo_usuario_requerimiento)
	OpenWithParm(w_reemplazo_usuario_requerimiento, gs_depto)
else
	ll_count               = 0 
	SELECT 	count("SOL_PERMISOS_USUARIO"."CODIGO_SOLICITUD")
	INTO 		:ll_count  
	FROM 	"SOL_PERMISOS_USUARIO"  
	WHERE 	( "SOL_PERMISOS_USUARIO"."USUARIO" = :gs_user ) AND  
		 		( "SOL_PERMISOS_USUARIO"."ESTADO" = 'A' )  anD
		 		( "SOL_PERMISOS_USUARIO"."CODIGO_SOLICITUD" = 'RC' );
	if ll_count > 0 then
		 if isvalid(w_reemplazo_usuario_requerimiento) then close(w_reemplazo_usuario_requerimiento)
		 OpenWithParm(w_reemplazo_usuario_requerimiento, gs_depto)
	else       
		 messagebox("Advertencia","Ud. No tiene Acceso")
	end if    
end if

end event

on m_cambioejecutivo.create
call super::create
this.text = "Cambio Ejecutivo"
this.menutextcolor = 134217735
this.menubackcolor = 134217732
this.menuhighlightcolor = 134217741
this.textsize = 8
this.weight = 400
this.facename = "Tahoma"
this.titlebackcolor = 134217730
this.bitmapbackcolor = 12632256
this.menubitmaps = true
this.titlegradient = true
this.toolbartextcolor = 134217746
this.toolbarbackcolor = 67108864
this.toolbarhighlightcolor = 134217741
this.toolbargradient = true
this.bitmapgradient = true
end on

on m_cambioejecutivo.destroy
call super::destroy
end on

type m_ingresocovid from menu within m_reclamos
end type

event clicked;Long		ll_count

SELECT 	COUNT("SOL_PERMISOS_USUARIO"."CODIGO_SOLICITUD")  
INTO 		:ll_count  
FROM 	"SOL_PERMISOS_USUARIO"  
WHERE 	( "SOL_PERMISOS_USUARIO"."CODIGO_SOLICITUD" = 'CV' ) AND  
			( "SOL_PERMISOS_USUARIO"."USUARIO" = :gs_user ) AND  
			( "SOL_PERMISOS_USUARIO"."ESTADO" = 'A' )   ;
if ll_count > 0 or gs_depto = 'I' then
	if isvalid(w_ingreso_covid) then close(w_ingreso_covid)
	open(w_ingreso_covid)
end if
end event

