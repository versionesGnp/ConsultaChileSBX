type m_mantenedortasa0 from menu within m_operaciones0
end type

event clicked;String		ls_estadoreg

SELECT	"ACCESO_MOD_TASA"."ESTADOREG" 	
INTO 		:ls_estadoreg 	
FROM 	"ACCESO_MOD_TASA" 	
WHERE 	"ACCESO_MOD_TASA"."USUARIO" = :gs_user  
USING	sqlca;
if sqlca.sqlcode=0 then
	if ls_estadoreg='A' then
		if isvalid(w_mantenedor_tasa) then close(w_mantenedor_tasa)
		open(w_mantenedor_tasa)
	else
		messagebox("Advertencia","Usuario No tiene Acceso - Estado Inactivo")
	end if
else
	messagebox("Advertencia","Usuario No tiene Acceso")
end if
end event

