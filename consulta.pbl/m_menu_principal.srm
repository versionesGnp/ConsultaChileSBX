type m_mantenedordescuentoweb from menu within m_operaciones0
end type

event clicked;String		ls_codigo_sol,ls_usuario,ls_estado

if isvalid(w_mantenedor_descuento_web) then close(w_mantenedor_descuento_web)
if gs_depto='O' or gs_depto='F' or gs_depto='I' or gs_depto='P' then
	SELECT	"SOL_PERMISOS_USUARIO"."CODIGO_SOLICITUD",   
				"SOL_PERMISOS_USUARIO"."USUARIO",   
				"SOL_PERMISOS_USUARIO"."ESTADO"  
	INTO     	:ls_codigo_sol,   
				:ls_usuario,   
				:ls_estado
	FROM     "SOL_PERMISOS_USUARIO"  
	WHERE ( "SOL_PERMISOS_USUARIO"."USUARIO" = :gs_user ) AND  
			   ( "SOL_PERMISOS_USUARIO"."CODIGO_SOLICITUD" = 'WD' )   
	USING	sqlca;
	if sqlca.sqlcode=0 then
		 if ls_estado='A' then open(w_mantenedor_descuento_web)
	end if
else
	messagebox("Advertencia","Ud. No tiene Acceso a Mantenedor Descuento Web")
end if
end event

