this.Item[UpperBound(this.Item)+1]=this.m_liberadores
this.Item[UpperBound(this.Item)+1]=this.m_aumentocapacidad4
this.Item[UpperBound(this.Item)+1]=this.m_informegestiónactual
this.Item[UpperBound(this.Item)+1]=this.m_informegestiónhistórica
this.Item[UpperBound(this.Item)+1]=this.m_estructuradeventa
this.Item[UpperBound(this.Item)+1]=this.m_cierreventas
this.Item[UpperBound(this.Item)+1]=this.m_licenciasmédicas
this.Item[UpperBound(this.Item)+1]=this.m_consultas0
this.Item[UpperBound(this.Item)+1]=this.m_estadocartera
this.Item[UpperBound(this.Item)+1]=this.m_promesasperiodo
