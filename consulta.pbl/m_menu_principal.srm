end on

event clicked;String ls_estado,ls_codigo_sol,ls_usuario

SELECT     "SOL_PERMISOS_USUARIO"."CODIGO_SOLICITUD",   
             "SOL_PERMISOS_USUARIO"."USUARIO",   
             "SOL_PERMISOS_USUARIO"."ESTADO"  
INTO         :ls_codigo_sol,   
             :ls_usuario,   
             :ls_estado
FROM     "SOL_PERMISOS_USUARIO"  
WHERE     ( "SOL_PERMISOS_USUARIO"."USUARIO" = :gs_user ) AND  
             ( "SOL_PERMISOS_USUARIO"."CODIGO_SOLICITUD" = 'MD' )    ;
if sqlca.sqlcode=0 then
    if ls_estado='A' then
        if isvalid(w_mantenedor_descuento_web_pre) then close(w_mantenedor_descuento_web_pre)
        open(w_mantenedor_descuento_web_pre)
    else
        messagebox("Advertencia","Usuario No tiene Acceso - Estado Inactivo")
    end if
else
    messagebox("Advertencia","Usuario No tiene Acceso")
end if
end event

