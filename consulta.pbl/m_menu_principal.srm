type m_mantenedorrequerimiento from menu within m_reclamos
end type

event clicked;long ll_count

if gs_depto='I' then
	if isvalid(w_mant_reclamos_x_requerimiento) then close(w_mant_reclamos_x_requerimiento)
	open(w_mant_reclamos_x_requerimiento)
else
	ll_count               = 0 
	SELECT 	count("SOL_PERMISOS_USUARIO"."CODIGO_SOLICITUD")
	INTO 		:ll_count  
	FROM 	"SOL_PERMISOS_USUARIO"  
	WHERE 	( "SOL_PERMISOS_USUARIO"."USUARIO" = :gs_user ) AND  
		 		( "SOL_PERMISOS_USUARIO"."ESTADO" = 'A' )  anD
		 		( "SOL_PERMISOS_USUARIO"."CODIGO_SOLICITUD" = 'RC' );
	if ll_count > 0 then
		 if isvalid(w_mant_reclamos_x_requerimiento) then close(w_mant_reclamos_x_requerimiento)
		 open(w_mant_reclamos_x_requerimiento)
	else       
		 messagebox("Advertencia","Ud. No tiene Acceso")
	end if    
end if

end event

on m_mantenedorrequerimiento.create
call super::create
this.text = "Mantenedor Requerimiento"
