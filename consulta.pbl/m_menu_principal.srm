type m_anularcuponmantención from menu within m_cupones
end type

event clicked;Long		ll_count

SELECT 	COUNT("SOL_PERMISOS_USUARIO"."CODIGO_SOLICITUD")  
INTO 		:ll_count  
FROM 	"SOL_PERMISOS_USUARIO"  
WHERE 	( "SOL_PERMISOS_USUARIO"."CODIGO_SOLICITUD" = 'CM' ) AND  
			( "SOL_PERMISOS_USUARIO"."USUARIO" = :gs_user ) AND  
			( "SOL_PERMISOS_USUARIO"."ESTADO" = 'A' )   ;
if ll_count > 0 then
	if isvalid(w_anular_cuponera_mant) then close(w_anular_cuponera_mant)
	open(w_anular_cuponera_mant)
else
	messagebox('Mensaje','Usuario sin permiso para acceder')
end if

end event

