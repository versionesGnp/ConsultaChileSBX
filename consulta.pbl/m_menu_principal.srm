type m_actualizar from menu within m_nuevaasignación
end type

event clicked;string select_string,estado,base,serie,estado_cadena
long llave,contrato,ret,i,a
if gs_acceso ="3" then
	ret = messagebox(gs_app_name,'          ¿ Esta seguro que desea actualizar ?~n~r~n~r~n~rLa Actualización cambiará de estado todos los Contratos',Question!,okCancel! ,2) 
	if ret > 1 then
		return
	end if	
	open(w_conteo_registros)
	w_conteo_registros.st_ini.text = String(Today( ), "dd/mm/yyyy hh:mm:ss")
	SetPointer(HourGlass!)
	DECLARE SP_ASIGNA_FALL PROCEDURE FOR SP_ASIGNA_FALL;
	execute SP_ASIGNA_FALL;
	SetPointer(Arrow!)
	w_conteo_registros.st_fin.text = String(Today( ), "dd/mm/yyyy hh:mm:ss")
ELSE
	messageBox("Usuario ", "Sin Acceso a esta aplicación ",  information!)
end if


end event

on m_actualizar.create
call super::create
this.text = "Actualizar"
this.microhelp = "Actualizar Asignación Fallecidos"
this.menutextcolor = 134217735
