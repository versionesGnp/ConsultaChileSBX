 column=(type=char(10) updatewhereclause=yes name=electronica_fb_detalle_tipo_doc_asoc dbname="electronica_fb_detalle.tipo_doc_asoc" )
 column=(type=decimal(4) updatewhereclause=yes name=electronica_fb_detalle_folio_asoc dbname="electronica_fb_detalle.folio_asoc" )
 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"ingreso~" )  TABLE(NAME=~"cod_movi~" )  TABLE(NAME=~"cod_pago~" )  TABLE(NAME=~"electronica_fb_detalle~" ) COLUMN(NAME=~"ingreso.folio~") COLUMN(NAME=~"ingreso.tipo_cob~") COLUMN(NAME=~"ingreso.fecha_pago~") COLUMN(NAME=~"ingreso.tipo_mov~") COLUMN(NAME=~"ingreso.cuotas_pag~") COLUMN(NAME=~"ingreso.monto~") COLUMN(NAME=~"ingreso.pago_hist~") COLUMN(NAME=~"ingreso.valor_uf~") COLUMN(NAME=~"cod_pago.descripcion~") COLUMN(NAME=~"cod_movi.sigla~") COLUMN(NAME=~"ingreso.cod_caja~") COLUMN(NAME=~"ingreso.codigo_otro~") COLUMN(NAME=~"ingreso.fecha_sistema~") COLUMN(NAME=~"electronica_fb_detalle.tipo_doc_asoc~") COLUMN(NAME=~"electronica_fb_detalle.folio_asoc~")    JOIN (LEFT=~"ingreso.tipo_cob~"    OP =~"=~"RIGHT=~"cod_pago.tipo_cob~"    OUTER1 =~"ingreso.tipo_cob~" )    JOIN (LEFT=~"ingreso.tipo_mov~"    OP =~"=~"RIGHT=~"cod_movi.cod_ing~"    OUTER1 =~"ingreso.tipo_mov~" )    JOIN (LEFT=~"ingreso.folio~"    OP =~"=~"RIGHT=~"electronica_fb_detalle.nro_documento~"    OUTER1 =~"ingreso.folio~" )    JOIN (LEFT=~"ingreso.tipo_cob~"    OP =~"=~"RIGHT=~"electronica_fb_detalle.tipo_documento~"    OUTER1 =~"ingreso.tipo_cob~" )    JOIN (LEFT=~"ingreso.fecha_pago~"    OP =~"=~"RIGHT=~"electronica_fb_detalle.fecha_pago~"    OUTER1 =~"ingreso.fecha_pago~" )WHERE(    EXP1 =~"(~~~"INGRESO~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":as_serie~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"CONTRATO~~~"~"   OP =~"=~"    EXP2 =~":an_numero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":as_base)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"TIPO_MOV~~~"~"   OP =~"=~"    EXP2 =~"'F'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"PAGO_HIST~~~"~"   OP =~"<>~"    EXP2 =~"'R'~" ) ) ORDER(NAME=~"ingreso.fecha_pago~" ASC=yes ) ARG(NAME = ~"as_serie~" TYPE = string)  ARG(NAME = ~"an_numero~" TYPE = number)  ARG(NAME = ~"as_base~" TYPE = string) " arguments=(("as_serie", string),("an_numero", number),("as_base", string))  sort="fecha_pago D folio A tipo_mov A " )
