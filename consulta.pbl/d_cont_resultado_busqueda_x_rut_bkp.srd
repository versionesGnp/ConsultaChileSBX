 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"cadena~" )  TABLE(NAME=~"cliente~" )  TABLE(NAME=~"cliente_deudor_tercero~" ) COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"cadena.serie~") COLUMN(NAME=~"cadena.numero~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.rut~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"cadena.cod_parque~") COLUMN(NAME=~"cliente_deudor_tercero.rut~") COLUMN(NAME=~"cliente_deudor_tercero.dv~") COLUMN(NAME=~"cliente_deudor_tercero.nombre~") COLUMN(NAME=~"cliente_deudor_tercero.a_paterno~") COLUMN(NAME=~"cliente_deudor_tercero.a_materno~")    JOIN (LEFT=~"cadena.rut~"    OP =~"=~"RIGHT=~"cliente.rut~"    OUTER1 =~"cadena.rut~" )    JOIN (LEFT=~"cadena.rut~"    OP =~"=~"RIGHT=~"cliente_deudor_tercero.rut_titular~"    OUTER1 =~"cadena.rut~" )WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"RUT~~~"~"   OP =~"=~"    EXP2 =~":an_rut~" ) ) ARG(NAME = ~"an_rut~" TYPE = number) " arguments=(("an_rut", number))  sort="cadena_codigo A cadena_serie A cadena_numero A " )
