global type f_vp_bkp from function_object
end type

forward prototypes
global function double f_vp_bkp (double periodo, double tasa, double valor_cuota)
end prototypes

global function double f_vp_bkp (double periodo, double tasa, double valor_cuota);
//calculo valor presente va


double tasa_porc, paso1, paso2, paso3, paso4, paso5, paso6

tasa_porc = tasa/100

paso1 = valor_cuota/tasa_porc

paso2 = 1 + tasa_porc

paso3 = (paso2)^periodo

paso4 = 1/paso3

paso5 = 1 - paso4

paso6 = paso1 * paso5

//messagebox(string(paso6),string(paso6))
return paso6
end function

