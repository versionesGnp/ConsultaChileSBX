type m_beterminadadepagar from menu within m_mantenedor
end type

event clicked;if isvalid(w_listado_be_terminadas_de_pagar) then 
	if w_listado_be_terminadas_de_pagar.dw_lista.dataobject	= 'dw_listado_terminadas_de_pagar_be' then
		messagebox("Advertencia","No es posible Ver Individualmente BE Terminada de Pagar, por tener habilitada Ventana BE Masiva")
		
	elseif w_listado_be_terminadas_de_pagar.dw_lista.dataobject	= 'dw_terminadas_de_pagar_be_por_ctto' then
		close(w_listado_be_terminadas_de_pagar)
		OpenWithParm(w_listado_be_terminadas_de_pagar, 'I')
	end if
else
	OpenWithParm(w_listado_be_terminadas_de_pagar, 'I')
end if

end event

