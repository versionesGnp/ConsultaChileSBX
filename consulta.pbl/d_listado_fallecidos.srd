 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"fallecidos~" )  TABLE(NAME=~"vista_existe_en_fosa_comun~" ) COLUMN(NAME=~"fallecidos.nombres~") COLUMN(NAME=~"fallecidos.ap_paterno~") COLUMN(NAME=~"fallecidos.ap_materno~") COLUMN(NAME=~"fallecidos.fec_sep~") COLUMN(NAME=~"fallecidos.n_l~") COLUMN(NAME=~"fallecidos.sector~") COLUMN(NAME=~"fallecidos.n_sep~") COLUMN(NAME=~"fallecidos.n_tec~") COLUMN(NAME=~"fallecidos.fec_fall~") COLUMN(NAME=~"fallecidos.llave~") COLUMN(NAME=~"fallecidos.nivel~") COLUMN(NAME=~"fallecidos.cod_parque~") COLUMN(NAME=~"fallecidos.base~") COLUMN(NAME=~"fallecidos.ss~") COLUMN(NAME=~"fallecidos.contrato~") COLUMN(NAME=~"vista_existe_en_fosa_comun.fosa_comun~")    JOIN (LEFT=~"fallecidos.base~"    OP =~"=~"RIGHT=~"vista_existe_en_fosa_comun.base~"    OUTER1 =~"fallecidos.base~" )    JOIN (LEFT=~"fallecidos.ss~"    OP =~"=~"RIGHT=~"vista_existe_en_fosa_comun.serie~"    OUTER1 =~"fallecidos.ss~" )    JOIN (LEFT=~"fallecidos.contrato~"    OP =~"=~"RIGHT=~"vista_existe_en_fosa_comun.numero~"    OUTER1 =~"fallecidos.contrato~" )WHERE(    EXP1 =~"~~~"FALLECIDOS~~~".~~~"SS~~~"~"   OP =~"=~"    EXP2 =~":as_serie~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FALLECIDOS~~~".~~~"CONTRATO~~~"~"   OP =~"=~"    EXP2 =~":an_numero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FALLECIDOS~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":as_base~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FALLECIDOS~~~".~~~"ESTADO_REG~~~"~"   OP =~"=~"    EXP2 =~"'A'~" ) ) ORDER(NAME=~"fallecidos.fec_sep~" ASC=yes ) ARG(NAME = ~"as_serie~" TYPE = string)  ARG(NAME = ~"an_numero~" TYPE = number)  ARG(NAME = ~"as_base~" TYPE = string) " arguments=(("as_serie", string),("an_numero", number),("as_base", string))  sort="fec_sep D " )
