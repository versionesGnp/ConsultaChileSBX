table(column=(type=decimal(4) updatewhereclause=yes name=documentos_folio dbname="documentos.folio" )
 column=(type=char(2) updatewhereclause=yes name=documentos_tipo_cob dbname="documentos.tipo_cob" )
 column=(type=decimal(4) updatewhereclause=yes name=documentos_n_cheque dbname="documentos.n_cheque" )
 column=(type=decimal(4) updatewhereclause=yes name=documentos_cod_banco dbname="documentos.cod_banco" )
 column=(type=decimal(4) updatewhereclause=yes name=documentos_monto dbname="documentos.monto" )
 column=(type=datetime updatewhereclause=yes name=documentos_fecha_venc dbname="documentos.fecha_venc" )
 column=(type=decimal(4) updatewhereclause=yes name=documentos_num_cheques dbname="documentos.num_cheques" )
 column=(type=datetime updatewhereclause=yes name=documentos_fecha_pago dbname="documentos.fecha_pago" )
 column=(type=char(1) updatewhereclause=yes name=documentos_estado_ch dbname="documentos.estado_ch" )
 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"documentos~" )  TABLE(NAME=~"ingreso~" ) COLUMN(NAME=~"documentos.folio~") COLUMN(NAME=~"documentos.tipo_cob~") COLUMN(NAME=~"documentos.n_cheque~") COLUMN(NAME=~"documentos.cod_banco~") COLUMN(NAME=~"documentos.monto~") COLUMN(NAME=~"documentos.fecha_venc~") COLUMN(NAME=~"documentos.num_cheques~") COLUMN(NAME=~"documentos.fecha_pago~") COLUMN(NAME=~"documentos.estado_ch~")    JOIN (LEFT=~"documentos.folio~"    OP =~"=~"RIGHT=~"ingreso.folio~" )    JOIN (LEFT=~"documentos.tipo_cob~"    OP =~"=~"RIGHT=~"ingreso.tipo_cob~" )WHERE(    EXP1 =~"~~~"DOCUMENTOS~~~".~~~"COD_PAGO~~~"~"   OP =~"=~"    EXP2 =~"'CH'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"INGRESO~~~".~~~"CONTRATO~~~"~"   OP =~"=~"    EXP2 =~":numero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"DOCUMENTOS~~~".~~~"ESTADO_CH~~~"~"   OP =~"=~"    EXP2 =~"'P'~" ) ) ORDER(NAME=~"documentos.fecha_pago~" ASC=yes ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number) " arguments=(("base", string),("serie", string),("numero", number))  sort="documentos_fecha_pago D documentos_fecha_venc D " )
