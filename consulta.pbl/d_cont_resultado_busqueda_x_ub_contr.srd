table(column=(type=char(1) updatewhereclause=yes name=cadena_codigo dbname="cadena.codigo" )
 column=(type=char(1) updatewhereclause=yes name=cadena_serie dbname="cadena.serie" )
 column=(type=decimal(4) updatewhereclause=yes name=cadena_numero dbname="cadena.numero" )
 column=(type=char(1) updatewhereclause=yes name=cadena_estado dbname="cadena.estado" )
 column=(type=char(15) updatewhereclause=yes name=cliente_a_paterno dbname="cliente.a_paterno" )
 column=(type=char(15) updatewhereclause=yes name=cliente_a_materno dbname="cliente.a_materno" )
 column=(type=char(20) updatewhereclause=yes name=cliente_nombre dbname="cliente.nombre" )
 column=(type=decimal(4) updatewhereclause=yes name=cliente_rut dbname="cliente.rut" )
 column=(type=char(1) updatewhereclause=yes name=cliente_dv dbname="cliente.dv" )
 column=(type=decimal(4) updatewhereclause=yes name=contrato_ubs dbname="contrato.ubs" )
 column=(type=char(8) updatewhereclause=yes name=contrato_sector dbname="contrato.sector" )
 column=(type=char(8) updatewhereclause=yes name=contrato_sepultura dbname="contrato.sepultura" )
 column=(type=decimal(4) updatewhereclause=yes name=contrato_nro_tec dbname="contrato.nro_tec" )
 column=(type=char(5) updatewhereclause=yes name=contrato_zona dbname="contrato.zona" )
 column=(type=decimal(4) updatewhereclause=yes name=contrato_capacidad dbname="contrato.capacidad" )
 column=(type=decimal(4) updatewhereclause=yes name=cadena_cod_parque dbname="cadena.cod_parque" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cadena~" )  TABLE(NAME=~"cliente~" )  TABLE(NAME=~"contrato~" ) COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"cadena.serie~") COLUMN(NAME=~"cadena.numero~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.rut~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"contrato.ubs~") COLUMN(NAME=~"contrato.sector~") COLUMN(NAME=~"contrato.sepultura~") COLUMN(NAME=~"contrato.nro_tec~") COLUMN(NAME=~"contrato.zona~") COLUMN(NAME=~"contrato.capacidad~") COLUMN(NAME=~"cadena.cod_parque~")    JOIN (LEFT=~"cadena.rut~"    OP =~"=~"RIGHT=~"cliente.rut~"    OUTER1 =~"cadena.rut~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"contrato.serie_c~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"contrato.nro_contrato~" )WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'C'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CONTRATO~~~".~~~"SECTOR~~~"~"   OP =~"=~"    EXP2 =~":as_sector~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"CONTRATO~~~".~~~"SEPULTURA~~~"~"   OP =~"=~"    EXP2 =~":as_sepultura~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"CONTRATO~~~".~~~"ZONA~~~"~"   OP =~"like~"    EXP2 =~":as_zona~" ) ) ORDER(NAME=~"contrato.sector~" ASC=yes )  ORDER(NAME=~"contrato.sepultura~" ASC=yes )  ORDER(NAME=~"contrato.nro_tec~" ASC=yes ) ARG(NAME = ~"as_sector~" TYPE = string)  ARG(NAME = ~"as_sepultura~" TYPE = string)  ARG(NAME = ~"as_zona~" TYPE = string) " arguments=(("as_sector", string),("as_sepultura", string),("as_zona", string))  sort="cadena_codigo A cadena_serie A cadena_numero A " )
