 column=(type=char(10) update=yes updatewhereclause=yes name=posteo dbname="pago_historico_canaan.posteo" )
 column=(type=char(1) update=yes updatewhereclause=yes name=base dbname="pago_historico_canaan.base" )
 column=(type=char(1) update=yes updatewhereclause=yes name=serie dbname="pago_historico_canaan.serie" )
 column=(type=char(20) update=yes updatewhereclause=yes name=tipo_contrato dbname="pago_historico_canaan.tipo_contrato" )
 column=(type=decimal(4) updatewhereclause=yes name=cadena_cod_parque dbname="cadena.cod_parque" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"pago_historico_canaan~" )  TABLE(NAME=~"cadena~" ) COLUMN(NAME=~"pago_historico_canaan.fecha_pago~") COLUMN(NAME=~"pago_historico_canaan.batch~") COLUMN(NAME=~"pago_historico_canaan.tipo_pago~") COLUMN(NAME=~"pago_historico_canaan.neto~") COLUMN(NAME=~"pago_historico_canaan.mora~") COLUMN(NAME=~"pago_historico_canaan.total~") COLUMN(NAME=~"pago_historico_canaan.pesos~") COLUMN(NAME=~"pago_historico_canaan.folio~") COLUMN(NAME=~"pago_historico_canaan.contrato~") COLUMN(NAME=~"pago_historico_canaan.referencia~") COLUMN(NAME=~"pago_historico_canaan.fecha_carga~") COLUMN(NAME=~"pago_historico_canaan.hora_carga~") COLUMN(NAME=~"pago_historico_canaan.posteo~") COLUMN(NAME=~"pago_historico_canaan.base~") COLUMN(NAME=~"pago_historico_canaan.serie~") COLUMN(NAME=~"pago_historico_canaan.tipo_contrato~") COLUMN(NAME=~"cadena.cod_parque~")    JOIN (LEFT=~"pago_historico_canaan.base~"    OP =~"=~"RIGHT=~"cadena.codigo~" )    JOIN (LEFT=~"pago_historico_canaan.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"pago_historico_canaan.contrato~"    OP =~"=~"RIGHT=~"cadena.numero~" )WHERE(    EXP1 =~"~~~"PAGO_HISTORICO_CANAAN~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"PAGO_HISTORICO_CANAAN~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"PAGO_HISTORICO_CANAAN~~~".~~~"CONTRATO~~~"~"   OP =~"=~"    EXP2 =~":numero~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number) " arguments=(("base", string),("serie", string),("numero", number))  sort="fecha_pago A tipo_pago A " )
