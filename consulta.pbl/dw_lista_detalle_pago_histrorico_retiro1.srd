 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"pago_historico~" ) COLUMN(NAME=~"pago_historico.rut_cliente~") COLUMN(NAME=~"pago_historico.digito~") COLUMN(NAME=~"pago_historico.correlativo~") COLUMN(NAME=~"pago_historico.tipo_documento~") COLUMN(NAME=~"pago_historico.nro_documento~") COLUMN(NAME=~"pago_historico.fecha_vencto~") COLUMN(NAME=~"pago_historico.fecha_pago~") COLUMN(NAME=~"pago_historico.valor_cobro_uf~") COLUMN(NAME=~"pago_historico.valor_cobro_pe~") COLUMN(NAME=~"pago_historico.su_codend~") COLUMN(NAME=~"pago_historico.nro_ingreso_caja~") COLUMN(NAME=~"pago_historico.valor_pagado~") COLUMN(NAME=~"pago_historico.valor_pagado_uf~") COLUMN(NAME=~"pago_historico.base~") COLUMN(NAME=~"pago_historico.serie~") COLUMN(NAME=~"pago_historico.contrato~")WHERE(    EXP1 =~"~~~"PAGO_HISTORICO~~~".~~~"RUT_CLIENTE~~~"~"   OP =~"=~"    EXP2 =~":rut~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"PAGO_HISTORICO~~~".~~~"CORRELATIVO~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"(~~~"PAGO_HISTORICO~~~".~~~"TIPO_DOCUMENTO~~~"~"   OP =~"=~"    EXP2 =~"10~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"PAGO_HISTORICO~~~".~~~"TIPO_DOCUMENTO~~~"~"   OP =~"=~"    EXP2 =~"4~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"PAGO_HISTORICO~~~".~~~"TIPO_DOCUMENTO~~~"~"   OP =~"=~"    EXP2 =~"5)~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"PAGO_HISTORICO~~~".~~~"FECHA_PAGO~~~"~"   OP =~"is not~"    EXP2 =~"Null~" ) ) ARG(NAME = ~"rut~" TYPE = number)  ARG(NAME = ~"serie~" TYPE = string) " arguments=(("rut", number),("serie", string))  sort="fecha_vencto D " )
