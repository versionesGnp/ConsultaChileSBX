 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"pagare~" )  TABLE(NAME=~"cliente~" )  TABLE(NAME=~"cod_parq~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"estado_envio~" )  TABLE(NAME=~"contrato~" )  TABLE(NAME=~"convenio_retiro~" )  TABLE(NAME=~"cadena_mora~" ) COLUMN(NAME=~"pagare.serie_p~") COLUMN(NAME=~"pagare.nro_pagare~") COLUMN(NAME=~"pagare.fecha~") COLUMN(NAME=~"pagare.serie~") COLUMN(NAME=~"pagare.nro_oferta~") COLUMN(NAME=~"pagare.kapital~") COLUMN(NAME=~"pagare.valor_cuo~") COLUMN(NAME=~"pagare.fecha_prim~") COLUMN(NAME=~"pagare.fecha_ult~") COLUMN(NAME=~"pagare.plazo~") COLUMN(NAME=~"pagare.tot_pagado~") COLUMN(NAME=~"pagare.pie_pagado~") COLUMN(NAME=~"pagare.cta_pag_la~") COLUMN(NAME=~"pagare.cta_pag_isa~") COLUMN(NAME=~"pagare.abono_pag~") COLUMN(NAME=~"pagare.fechas_ingreso~") COLUMN(NAME=~"pagare.estado~") COLUMN(NAME=~"pagare.dueno~") COLUMN(NAME=~"pagare.origen~") COLUMN(NAME=~"pagare.moneda~") COLUMN(NAME=~"pagare.sector~") COLUMN(NAME=~"pagare.sepultura~") COLUMN(NAME=~"pagare.pie~") COLUMN(NAME=~"cod_parq.nombre~") COLUMN(NAME=~"cod_parq.ciudad~") COLUMN(NAME=~"cliente.rut~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cliente.direccion_p~") COLUMN(NAME=~"cliente.comuna~") COLUMN(NAME=~"cliente.ciudad~") COLUMN(NAME=~"cliente.fono_p~") COLUMN(NAME=~"pagare.parque~") COLUMN(NAME=~"cliente.estado_titular~") COLUMN(NAME=~"pagare.tasa~") COLUMN(NAME=~"cliente.tipo_via~") COLUMN(NAME=~"cliente.numero_particular~") COLUMN(NAME=~"cliente.depto_particular~") COLUMN(NAME=~"cliente.block_particular~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"cliente.tipo_cliente~") COLUMN(NAME=~"cadena.cod_parque~") COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"pagare.estado_credito~") COLUMN(NAME=~"cadena.serie~") COLUMN(NAME=~"cadena.numero~") COLUMN(NAME=~"cliente.lat_geo~") COLUMN(NAME=~"cliente.lon_geo~") COLUMN(NAME=~"cliente.status_geo~") COLUMN(NAME=~"cadena.estado_carta~") COLUMN(NAME=~"estado_envio.descripcion~") COLUMN(NAME=~"cliente.estado_cobranza~") COLUMN(NAME=~"convenio_retiro.glosa~") COLUMN(NAME=~"convenio_retiro.vigencia_descripcion~") COLUMN(NAME=~"contrato.cod_convenio~") COLUMN(NAME=~"cadena_mora.mora_cred~") COLUMN(NAME=~"cadena_mora.dias_mora_cred~") COLUMN(NAME=~"cadena_mora.fecha_venc_cred~") COLUMN(NAME=~"pagare.glosa_ficha~") COLUMN(NAME=~"pagare.forma_pago~") COLUMN(NAME=~"cadena.objeto_id~") COLUMN(NAME=~"cadena.objeto_id_estado~") COLUMN(NAME=~"cadena.estado_mora_credito~") COLUMN(NAME=~"cadena.estado_mora_mantencion~")    JOIN (LEFT=~"pagare.rut~"    OP =~"=~"RIGHT=~"cliente.rut~"    OUTER1 =~"pagare.rut~" )    JOIN (LEFT=~"pagare.parque~"    OP =~"=~"RIGHT=~"cod_parq.codigo~"    OUTER1 =~"pagare.parque~" )    JOIN (LEFT=~"cadena.estado_carta~"    OP =~"=~"RIGHT=~"estado_envio.codigo_num~"    OUTER1 =~"cadena.estado_carta~" )    JOIN (LEFT=~"pagare.serie~"    OP =~"=~"RIGHT=~"contrato.serie_c~"    OUTER1 =~"pagare.serie~" )    JOIN (LEFT=~"pagare.nro_oferta~"    OP =~"=~"RIGHT=~"contrato.nro_contrato~"    OUTER1 =~"pagare.nro_oferta~" )    JOIN (LEFT=~"contrato.cod_convenio~"    OP =~"=~"RIGHT=~"convenio_retiro.cod_convenio~"    OUTER1 =~"contrato.cod_convenio~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"cadena_mora.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"cadena_mora.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"cadena_mora.numero~" )    JOIN (LEFT=~"pagare.serie_p~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"pagare.nro_pagare~"    OP =~"=~"RIGHT=~"cadena.numero~" )WHERE(    EXP1 =~"~~~"PAGARE~~~".~~~"SERIE_P~~~"~"   OP =~"=~"    EXP2 =~":as_serie~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"PAGARE~~~".~~~"NRO_PAGARE~~~"~"   OP =~"=~"    EXP2 =~":an_numero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'P'~" ) ) ARG(NAME = ~"as_serie~" TYPE = string)  ARG(NAME = ~"an_numero~" TYPE = number) " arguments=(("as_serie", string),("an_numero", number)) )
