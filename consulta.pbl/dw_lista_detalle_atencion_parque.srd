 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"atencion_parque~" ) COLUMN(NAME=~"atencion_parque.base~") COLUMN(NAME=~"atencion_parque.serie~") COLUMN(NAME=~"atencion_parque.numero~") COLUMN(NAME=~"atencion_parque.rut~") COLUMN(NAME=~"atencion_parque.fecha_crea~") COLUMN(NAME=~"atencion_parque.observacion~") COLUMN(NAME=~"atencion_parque.estado~") COLUMN(NAME=~"atencion_parque.fecha_estado~") COLUMN(NAME=~"atencion_parque.usuario~") COLUMN(NAME=~"atencion_parque.area~") COLUMN(NAME=~"atencion_parque.sector~") COLUMN(NAME=~"atencion_parque.sepultura~")WHERE(    EXP1 =~"~~~"ATENCION_PARQUE~~~".~~~"RUT~~~"~"   OP =~"=~"    EXP2 =~":rut~" ) ) ARG(NAME = ~"rut~" TYPE = number) " update="ATENCION_PARQUE" updatewhere=1 updatekeyinplace=no arguments=(("rut", number))  sort="fecha_crea D " )
