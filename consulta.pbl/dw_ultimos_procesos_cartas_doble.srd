 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"carta_log~" )  TABLE(NAME=~"proceso_carta~" ) COLUMN(NAME=~"carta_log.base~") COLUMN(NAME=~"carta_log.serie~") COLUMN(NAME=~"carta_log.numero~") COLUMN(NAME=~"carta_log.rut~") COLUMN(NAME=~"proceso_carta.fecha~") COLUMN(NAME=~"proceso_carta.cod_accion~") COLUMN(NAME=~"proceso_carta.clasificacion~") COLUMN(NAME=~"proceso_carta.descripcion~") COLUMN(NAME=~"proceso_carta.glosa_reg~") COLUMN(NAME=~"proceso_carta.glosa_reg_reprog~")    JOIN (LEFT=~"carta_log.cod_accion~"    OP =~"=~"RIGHT=~"proceso_carta.cod_accion~" )    JOIN (LEFT=~"carta_log.clasificacion~"    OP =~"=~"RIGHT=~"proceso_carta.clasificacion~" )WHERE(    EXP1 =~"~~~"CARTA_LOG~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CARTA_LOG~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CARTA_LOG~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CARTA_LOG~~~".~~~"RUT~~~"~"   OP =~"=~"    EXP2 =~":rut~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"PROCESO_CARTA~~~".~~~"FECHA~~~"~"   OP =~"=~"    EXP2 =~":fecha~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CARTA_LOG~~~".~~~"CLASIFICACION~~~"~"   OP =~"=~"    EXP2 =~":clasi~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CARTA_LOG~~~".~~~"COD_ACCION~~~"~"   OP =~"=~"    EXP2 =~":cod_accion~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number)  ARG(NAME = ~"rut~" TYPE = number)  ARG(NAME = ~"fecha~" TYPE = date)  ARG(NAME = ~"clasi~" TYPE = string)  ARG(NAME = ~"cod_accion~" TYPE = number) " arguments=(("base", string),("serie", string),("numero", number),("rut", number),("fecha", date),("clasi", string),("cod_accion", number)) )
