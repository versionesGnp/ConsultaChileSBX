 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"fallecidos~" )  TABLE(NAME=~"vista_existe_en_fosa_comun~" ) COLUMN(NAME=~"fallecidos.llave~") COLUMN(NAME=~"fallecidos.folio~") COLUMN(NAME=~"fallecidos.n_l~") COLUMN(NAME=~"fallecidos.n_m~") COLUMN(NAME=~"fallecidos.base~") COLUMN(NAME=~"fallecidos.ss~") COLUMN(NAME=~"fallecidos.contrato~") COLUMN(NAME=~"fallecidos.sector~") COLUMN(NAME=~"fallecidos.n_sep~") COLUMN(NAME=~"fallecidos.nombres~") COLUMN(NAME=~"fallecidos.ap_paterno~") COLUMN(NAME=~"fallecidos.ap_materno~") COLUMN(NAME=~"fallecidos.fec_sep~") COLUMN(NAME=~"fallecidos.est~") COLUMN(NAME=~"fallecidos.op~") COLUMN(NAME=~"fallecidos.rut~") COLUMN(NAME=~"fallecidos.dv~") COLUMN(NAME=~"fallecidos.sexo~") COLUMN(NAME=~"fallecidos.edad~") COLUMN(NAME=~"fallecidos.periodo~") COLUMN(NAME=~"fallecidos.fec_nac~") COLUMN(NAME=~"fallecidos.fec_fall~") COLUMN(NAME=~"fallecidos.pase~") COLUMN(NAME=~"fallecidos.reg_civil~") COLUMN(NAME=~"fallecidos.causa_fall~") COLUMN(NAME=~"fallecidos.enf_obl~") COLUMN(NAME=~"fallecidos.funeraria~") COLUMN(NAME=~"fallecidos.boleta~") COLUMN(NAME=~"fallecidos.carta_aut~") COLUMN(NAME=~"fallecidos.rg_est~") COLUMN(NAME=~"fallecidos.n_tec~") COLUMN(NAME=~"fallecidos.nivel~") COLUMN(NAME=~"fallecidos.vta~") COLUMN(NAME=~"fallecidos.observaciones~") COLUMN(NAME=~"fallecidos.estado_contrato~") COLUMN(NAME=~"fallecidos.resolucion_traslado_nro~") COLUMN(NAME=~"fallecidos.otorgado_por~") COLUMN(NAME=~"fallecidos.cementerio_origen~") COLUMN(NAME=~"fallecidos.cod_parque~") COLUMN(NAME=~"vista_existe_en_fosa_comun.fosa_comun~")    JOIN (LEFT=~"fallecidos.base~"    OP =~"=~"RIGHT=~"vista_existe_en_fosa_comun.base~"    OUTER1 =~"fallecidos.base~" )    JOIN (LEFT=~"fallecidos.ss~"    OP =~"=~"RIGHT=~"vista_existe_en_fosa_comun.serie~"    OUTER1 =~"fallecidos.ss~" )    JOIN (LEFT=~"fallecidos.contrato~"    OP =~"=~"RIGHT=~"vista_existe_en_fosa_comun.numero~"    OUTER1 =~"fallecidos.contrato~" )WHERE(    EXP1 =~"~~~"FALLECIDOS~~~".~~~"LLAVE~~~"~"   OP =~"=~"    EXP2 =~":an_llave~" ) ) ARG(NAME = ~"an_llave~" TYPE = number) " update="FALLECIDOS" updatewhere=0 updatekeyinplace=yes arguments=(("an_llave", number)) )
