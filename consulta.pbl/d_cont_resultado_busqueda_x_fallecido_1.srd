 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"fallecidos~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"cliente~" )  TABLE(NAME=~"vista_existe_en_fosa_comun~" ) COLUMN(NAME=~"fallecidos.rut~") COLUMN(NAME=~"fallecidos.ap_paterno~") COLUMN(NAME=~"fallecidos.ap_materno~") COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"cadena.serie~") COLUMN(NAME=~"cadena.numero~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.rut~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"fallecidos.nombres~") COLUMN(NAME=~"fallecidos.llave~") COLUMN(NAME=~"fallecidos.sector~") COLUMN(NAME=~"fallecidos.n_sep~") COLUMN(NAME=~"fallecidos.nivel~") COLUMN(NAME=~"fallecidos.n_tec~") COLUMN(NAME=~"cadena.cod_parque~") COLUMN(NAME=~"fallecidos.cod_parque~") COLUMN(NAME=~"vista_existe_en_fosa_comun.fosa_comun~")    JOIN (LEFT=~"cadena.rut~"    OP =~"=~"RIGHT=~"cliente.rut~"    OUTER1 =~"cadena.rut~" )    JOIN (LEFT=~"fallecidos.base~"    OP =~"=~"RIGHT=~"cadena.codigo~"    OUTER1 =~"fallecidos.base~" )    JOIN (LEFT=~"fallecidos.ss~"    OP =~"=~"RIGHT=~"cadena.serie~"    OUTER1 =~"fallecidos.ss~" )    JOIN (LEFT=~"fallecidos.contrato~"    OP =~"=~"RIGHT=~"cadena.numero~"    OUTER1 =~"fallecidos.contrato~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"vista_existe_en_fosa_comun.base~"    OUTER1 =~"cadena.codigo~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"vista_existe_en_fosa_comun.serie~"    OUTER1 =~"cadena.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"vista_existe_en_fosa_comun.numero~"    OUTER1 =~"cadena.numero~" )) "  sort="fallecidos_ap_paterno A fallecidos_ap_materno A fallecidos_nombres A " )
