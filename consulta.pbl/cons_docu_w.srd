 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"DOCUMENTOS~" ) COLUMN(NAME=~"DOCUMENTOS.folio~") COLUMN(NAME=~"DOCUMENTOS.n_cheque~") COLUMN(NAME=~"DOCUMENTOS.cod_banco~") COLUMN(NAME=~"DOCUMENTOS.monto~") COLUMN(NAME=~"DOCUMENTOS.fecha_venc~") COLUMN(NAME=~"DOCUMENTOS.cod_pago~") COLUMN(NAME=~"DOCUMENTOS.estado_ch~") COLUMN(NAME=~"DOCUMENTOS.glosa_ch~") COLUMN(NAME=~"DOCUMENTOS.fecha_estado_ch~") COLUMN(NAME=~"DOCUMENTOS.fecha_pago~") COLUMN(NAME=~"DOCUMENTOS.tipo_tarjeta_credito~")WHERE(    EXP1 =~"~~~"DOCUMENTOS~~~".~~~"FOLIO~~~"~"   OP =~"=~"    EXP2 =~":folio~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"DOCUMENTOS~~~".~~~"TIPO_COB~~~"~"   OP =~"=~"    EXP2 =~":tcom~" ) ) ARG(NAME = ~"folio~" TYPE = number)  ARG(NAME = ~"tcom~" TYPE = string) " arguments=(("folio", number),("tcom", string))  sort="cod_pago A fecha_pago D fecha_venc D tipo_tarjeta_credito A " )
