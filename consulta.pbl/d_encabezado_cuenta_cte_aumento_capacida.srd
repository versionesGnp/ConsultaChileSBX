 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cliente~" )  TABLE(NAME=~"anexo_aumento~" )  TABLE(NAME=~"pago_aumento~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"estado_envio~" )  TABLE(NAME=~"cadena_mora~" ) COLUMN(NAME=~"cliente.rut~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cliente.direccion_p~") COLUMN(NAME=~"cliente.comuna~") COLUMN(NAME=~"cliente.ciudad~") COLUMN(NAME=~"cliente.fono_p~") COLUMN(NAME=~"cliente.estado_titular~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"cliente.tipo_via~") COLUMN(NAME=~"cliente.numero_particular~") COLUMN(NAME=~"cliente.depto_particular~") COLUMN(NAME=~"cliente.block_particular~") COLUMN(NAME=~"anexo_aumento.serie_m~") COLUMN(NAME=~"anexo_aumento.nro_aumento~") COLUMN(NAME=~"anexo_aumento.ult_folio~") COLUMN(NAME=~"anexo_aumento.base~") COLUMN(NAME=~"anexo_aumento.serie~") COLUMN(NAME=~"anexo_aumento.nro_oferta~") COLUMN(NAME=~"anexo_aumento.tot_pagado~") COLUMN(NAME=~"anexo_aumento.cta_pag_m~") COLUMN(NAME=~"anexo_aumento.abono_m~") COLUMN(NAME=~"anexo_aumento.cod_agente~") COLUMN(NAME=~"anexo_aumento.cod_super~") COLUMN(NAME=~"pago_aumento.fecha~") COLUMN(NAME=~"pago_aumento.precio~") COLUMN(NAME=~"pago_aumento.pie_pagado~") COLUMN(NAME=~"pago_aumento.pie~") COLUMN(NAME=~"pago_aumento.valor_cuota~") COLUMN(NAME=~"pago_aumento.nro_cuotas~") COLUMN(NAME=~"pago_aumento.moneda~") COLUMN(NAME=~"pago_aumento.fecha_prim~") COLUMN(NAME=~"pago_aumento.fecha_ult~") COLUMN(NAME=~"pago_aumento.fecha_pie~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"anexo_aumento.cod_jef~") COLUMN(NAME=~"anexo_aumento.porce_age~") COLUMN(NAME=~"anexo_aumento.porce_sup~") COLUMN(NAME=~"anexo_aumento.porce_jefe~") COLUMN(NAME=~"cliente.tipo_cliente~") COLUMN(NAME=~"cadena.cod_parque~") COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"cadena.serie~") COLUMN(NAME=~"cadena.numero~") COLUMN(NAME=~"cliente.status_geo~") COLUMN(NAME=~"cliente.lon_geo~") COLUMN(NAME=~"cliente.lat_geo~") COLUMN(NAME=~"cadena.estado_carta~") COLUMN(NAME=~"estado_envio.descripcion~") COLUMN(NAME=~"cliente.estado_cobranza~") COLUMN(NAME=~"cadena_mora.mora_cred~") COLUMN(NAME=~"cadena_mora.dias_mora_cred~") COLUMN(NAME=~"cadena_mora.fecha_venc_cred~") COLUMN(NAME=~"cadena.objeto_id~") COLUMN(NAME=~"cadena.objeto_id_estado~") COLUMN(NAME=~"anexo_aumento.uso~") COLUMN(NAME=~"cadena.estado_mora_credito~") COLUMN(NAME=~"cadena.estado_mora_mantencion~") COLUMN(NAME=~"anexo_aumento.cierre_venta~") COLUMN(NAME=~"anexo_aumento.rut_aval~")    JOIN (LEFT=~"cliente.rut~"    OP =~"=~"RIGHT=~"anexo_aumento.rut~"    OUTER2 =~"anexo_aumento.rut~" )    JOIN (LEFT=~"cadena.estado_carta~"    OP =~"=~"RIGHT=~"estado_envio.codigo_num~"    OUTER1 =~"cadena.estado_carta~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"cadena_mora.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"cadena_mora.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"cadena_mora.numero~" )    JOIN (LEFT=~"anexo_aumento.serie_m~"    OP =~"=~"RIGHT=~"pago_aumento.serie_m~" )    JOIN (LEFT=~"anexo_aumento.nro_aumento~"    OP =~"=~"RIGHT=~"pago_aumento.nro_aumento~" )    JOIN (LEFT=~"anexo_aumento.ult_folio~"    OP =~"=~"RIGHT=~"pago_aumento.folio~" )    JOIN (LEFT=~"anexo_aumento.serie_m~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"anexo_aumento.nro_aumento~"    OP =~"=~"RIGHT=~"cadena.numero~" )WHERE(    EXP1 =~"~~~"ANEXO_AUMENTO~~~".~~~"SERIE_M~~~"~"   OP =~"=~"    EXP2 =~":as_serie~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"ANEXO_AUMENTO~~~".~~~"NRO_AUMENTO~~~"~"   OP =~"=~"    EXP2 =~":an_numero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'A'~" ) ) ARG(NAME = ~"as_serie~" TYPE = string)  ARG(NAME = ~"an_numero~" TYPE = number) " arguments=(("as_serie", string),("an_numero", number)) )
