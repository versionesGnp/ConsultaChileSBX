table(column=(type=char(20) updatewhereclause=yes name=cod_parq_nombre dbname="cod_parq.nombre" )
 column=(type=decimal(4) updatewhereclause=yes name=atencion_log_rut dbname="atencion_log.rut" )
 column=(type=char(10) updatewhereclause=yes name=atencion_log_estado dbname="atencion_log.estado" )
 column=(type=datetime updatewhereclause=yes name=atencion_log_fecha dbname="atencion_log.fecha" )
 column=(type=char(500) updatewhereclause=yes name=atencion_log_glosa dbname="atencion_log.glosa" )
 column=(type=char(15) updatewhereclause=yes name=atencion_log_usuario dbname="atencion_log.usuario" )
 column=(type=char(1) updatewhereclause=yes name=atencion_log_base dbname="atencion_log.base" )
 column=(type=char(1) updatewhereclause=yes name=atencion_log_serie dbname="atencion_log.serie" )
 column=(type=decimal(4) updatewhereclause=yes name=atencion_log_numero dbname="atencion_log.numero" )
 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"cadena~" )  TABLE(NAME=~"cod_parq~" )  TABLE(NAME=~"atencion_log~" )  TABLE(NAME=~"at_gestion~" )  TABLE(NAME=~"encargados~" ) COLUMN(NAME=~"cod_parq.nombre~") COLUMN(NAME=~"atencion_log.rut~") COLUMN(NAME=~"atencion_log.estado~") COLUMN(NAME=~"atencion_log.fecha~") COLUMN(NAME=~"atencion_log.glosa~") COLUMN(NAME=~"atencion_log.usuario~") COLUMN(NAME=~"atencion_log.base~") COLUMN(NAME=~"atencion_log.serie~") COLUMN(NAME=~"atencion_log.numero~")    JOIN (LEFT=~"cadena.cod_parque~"    OP =~"=~"RIGHT=~"cod_parq.codigo~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"at_gestion.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"at_gestion.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"at_gestion.numero~" )    JOIN (LEFT=~"cadena.rut~"    OP =~"=~"RIGHT=~"at_gestion.rut_cliente~" )    JOIN (LEFT=~"at_gestion.rut_cliente~"    OP =~"=~"RIGHT=~"atencion_log.rut~" )    JOIN (LEFT=~"at_gestion.base~"    OP =~"=~"RIGHT=~"atencion_log.base~" )    JOIN (LEFT=~"at_gestion.serie~"    OP =~"=~"RIGHT=~"atencion_log.serie~" )    JOIN (LEFT=~"at_gestion.numero~"    OP =~"=~"RIGHT=~"atencion_log.numero~" )    JOIN (LEFT=~"atencion_log.usuario~"    OP =~"=~"RIGHT=~"encargados.codigo_usuario~" )WHERE(    EXP1 =~"~~~"ATENCION_LOG~~~".~~~"RUT~~~"~"   OP =~"=~"    EXP2 =~":rut~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"ENCARGADOS~~~".~~~"DEPTO~~~"~"   OP =~"=~"    EXP2 =~"'E'~" ) ) ARG(NAME = ~"rut~" TYPE = number) " arguments=(("rut", number))  sort="atencion_log_fecha D " )
