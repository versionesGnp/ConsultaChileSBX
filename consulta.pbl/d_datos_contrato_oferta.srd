~"cliente.dv~") COLUMN(NAME=~"cliente.estado_cobranza~") COLUMN(NAME=~"cliente.fecha_cobranza~") COLUMN(NAME=~"cliente.glosa_cobranza~") COLUMN(NAME=~"cliente.direccion_p~") COLUMN(NAME=~"cliente.poblacion~") COLUMN(NAME=~"cliente.sector~") COLUMN(NAME=~"cliente.fono_p~") COLUMN(NAME=~"cliente.fono_c~") COLUMN(NAME=~"oferta_v.ingreso_sistema~") COLUMN(NAME=~"cliente.tipo_via~") COLUMN(NAME=~"cliente.numero_particular~") COLUMN(NAME=~"cliente.depto_particular~") COLUMN(NAME=~"cliente.block_particular~") COLUMN(NAME=~"pago_oferta.tasa_base~") COLUMN(NAME=~"pago_oferta.codigo_tipo_seguro~") COLUMN(NAME=~"oferta_v.estado_comi_sup~") COLUMN(NAME=~"pago_oferta.nro_tecnico~") COLUMN(NAME=~"vista_existe_en_fosa_comun.fosa_comun~") COLUMN(NAME=~"oferta_v.cod_convenio~") COLUMN(NAME=~"convenio_retiro.glosa~") COLUMN(NAME=~"cadena.cod_parque~") COLUMN(NAME=~"pago_oferta.pie_pagado~") COLUMN(NAME=~"oferta_v.clasifica_venta~") COLUMN(NAME=~"oferta_v.base~")    JOIN (LEFT=~"oferta_v.rut~"    OP =~"=~"RIGHT=~"cliente.rut~"    OUTER1 =~"oferta_v.rut~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"vista_existe_en_fosa_comun.base~"    OUTER1 =~"cadena.codigo~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"vista_existe_en_fosa_comun.serie~"    OUTER1 =~"cadena.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"vista_existe_en_fosa_comun.numero~"    OUTER1 =~"cadena.numero~" )    JOIN (LEFT=~"oferta_v.cod_convenio~"    OP =~"=~"RIGHT=~"convenio_retiro.cod_convenio~"    OUTER1 =~"oferta_v.cod_convenio~" )    JOIN (LEFT=~"oferta_v.ult_folio~"    OP =~"=~"RIGHT=~"pago_oferta.folio~" )    JOIN (LEFT=~"oferta_v.serie~"    OP =~"=~"RIGHT=~"pago_oferta.serie~" )    JOIN (LEFT=~"oferta_v.nro_oferta~"    OP =~"=~"RIGHT=~"pago_oferta.nro_oferta~" )    JOIN (LEFT=~"oferta_v.serie~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"oferta_v.nro_oferta~"    OP =~"=~"RIGHT=~"cadena.numero~" )WHERE(    EXP1 =~"~~~"OFERTA_V~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":as_serie~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"OFERTA_V~~~".~~~"NRO_OFERTA~~~"~"   OP =~"=~"    EXP2 =~":an_numero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'O'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'U')~" ) ) ARG(NAME = ~"as_serie~" TYPE = string)  ARG(NAME = ~"an_numero~" TYPE = number) " arguments=(("as_serie", string),("an_numero", number)) )
