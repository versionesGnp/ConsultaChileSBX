 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cliente~" )  TABLE(NAME=~"derecho~" ) COLUMN(NAME=~"cliente.rut~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cliente.direccion_p~") COLUMN(NAME=~"cliente.fono_p~") COLUMN(NAME=~"cliente.fono_c~") COLUMN(NAME=~"derecho.serie_p~") COLUMN(NAME=~"derecho.nro_pagare~") COLUMN(NAME=~"derecho.fecha~") COLUMN(NAME=~"derecho.tasa~") COLUMN(NAME=~"derecho.valor_cuo~") COLUMN(NAME=~"derecho.fecha_prim~") COLUMN(NAME=~"derecho.fecha_ult~") COLUMN(NAME=~"derecho.plazo~") COLUMN(NAME=~"derecho.tot_pagado~") COLUMN(NAME=~"derecho.pie_pagado~") COLUMN(NAME=~"derecho.cta_pag_la~") COLUMN(NAME=~"derecho.cta_pag_isa~") COLUMN(NAME=~"derecho.sector~") COLUMN(NAME=~"derecho.sepultura~") COLUMN(NAME=~"derecho.pie~") COLUMN(NAME=~"derecho.fechas_ingreso~") COLUMN(NAME=~"cliente.estado_cobranza~") COLUMN(NAME=~"cliente.fecha_cobranza~") COLUMN(NAME=~"cliente.glosa_cobranza~") COLUMN(NAME=~"cliente.tipo_via~") COLUMN(NAME=~"cliente.numero_particular~") COLUMN(NAME=~"cliente.depto_particular~") COLUMN(NAME=~"cliente.block_particular~") COLUMN(NAME=~"derecho.base~")    JOIN (LEFT=~"cliente.rut~"    OP =~"=~"RIGHT=~"derecho.rut~"    OUTER2 =~"derecho.rut~" )WHERE(    EXP1 =~"~~~"DERECHO~~~".~~~"SERIE_P~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"DERECHO~~~".~~~"NRO_PAGARE~~~"~"   OP =~"=~"    EXP2 =~":numero~" ) ) ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number) " arguments=(("serie", string),("numero", number)) )
