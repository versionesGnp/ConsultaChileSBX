 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"temp_pago_cupon~" ) COLUMN(NAME=~"temp_pago_cupon.num_cupon~") COLUMN(NAME=~"temp_pago_cupon.monto_cuota~") COLUMN(NAME=~"temp_pago_cupon.int_mora~") COLUMN(NAME=~"temp_pago_cupon.g_cobranza~") COLUMN(NAME=~"temp_pago_cupon.n_caja~") COLUMN(NAME=~"temp_pago_cupon.c_mora~") COLUMN(NAME=~"temp_pago_cupon.tipo_mov~")WHERE(    EXP1 =~"~~~"TEMP_PAGO_CUPON~~~".~~~"N_CAJA~~~"~"   OP =~"=~"    EXP2 =~":as_n_caja~" ) ) ARG(NAME = ~"as_n_caja~" TYPE = string) " arguments=(("as_n_caja", string)) )
