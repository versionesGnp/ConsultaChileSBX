 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"vista_buscar_ejecutivos_ctto~" )  TABLE(NAME=~"facturas_cadena~" )  TABLE(NAME=~"facturas_cliente_exentas~" ) COLUMN(NAME=~"vista_buscar_ejecutivos_ctto.cod_age~") COLUMN(NAME=~"vista_buscar_ejecutivos_ctto.cod_sup~") COLUMN(NAME=~"vista_buscar_ejecutivos_ctto.cod_jefe~") COLUMN(NAME=~"facturas_cadena.codigo~") COLUMN(NAME=~"facturas_cadena.serie~") COLUMN(NAME=~"facturas_cadena.numero~") COLUMN(NAME=~"facturas_cadena.estado~") COLUMN(NAME=~"facturas_cliente_exentas.nombre~") COLUMN(NAME=~"facturas_cliente_exentas.a_paterno~") COLUMN(NAME=~"facturas_cliente_exentas.a_materno~") COLUMN(NAME=~"facturas_cliente_exentas.rut~") COLUMN(NAME=~"facturas_cliente_exentas.dv~") COLUMN(NAME=~"facturas_cadena.cod_parque~")    JOIN (LEFT=~"facturas_cadena.codigo~"    OP =~"=~"RIGHT=~"vista_buscar_ejecutivos_ctto.base~"    OUTER1 =~"facturas_cadena.codigo~" )    JOIN (LEFT=~"facturas_cadena.serie~"    OP =~"=~"RIGHT=~"vista_buscar_ejecutivos_ctto.serie~"    OUTER1 =~"facturas_cadena.serie~" )    JOIN (LEFT=~"facturas_cadena.numero~"    OP =~"=~"RIGHT=~"vista_buscar_ejecutivos_ctto.numero~"    OUTER1 =~"facturas_cadena.numero~" )    JOIN (LEFT=~"facturas_cadena.rut~"    OP =~"=~"RIGHT=~"facturas_cliente_exentas.rut~"    OUTER1 =~"facturas_cadena.rut~" )WHERE(    EXP1 =~"~~~"FACTURAS_CLIENTE_EXENTAS~~~".~~~"A_PATERNO~~~"~"   OP =~"like~"    EXP2 =~":as_apellido_paterno~" ) ) ARG(NAME = ~"as_apellido_paterno~" TYPE = string) " arguments=(("as_apellido_paterno", string))  sort="facturas_cliente_exentas_a_paterno A facturas_cadena_numero A " )
