 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cadena~" )  TABLE(NAME=~"detalle_cupon_ci~" )  TABLE(NAME=~"cuponeras~" )  TABLE(NAME=~"cuponeras_detalle~" ) COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"cadena.serie~") COLUMN(NAME=~"cadena.numero~") COLUMN(NAME=~"cadena.cod_parque~") COLUMN(NAME=~"detalle_cupon_ci.tipo_cob~") COLUMN(NAME=~"detalle_cupon_ci.folio~") COLUMN(NAME=~"detalle_cupon_ci.fecha~") COLUMN(NAME=~"detalle_cupon_ci.monto~") COLUMN(NAME=~"detalle_cupon_ci.monto_mora~") COLUMN(NAME=~"detalle_cupon_ci.monto_gasto_cob~") COLUMN(NAME=~"detalle_cupon_ci.monto_total~") COLUMN(NAME=~"cuponeras_detalle.nro_cupon~") COLUMN(NAME=~"cuponeras_detalle.estado_pago_cupon~") COLUMN(NAME=~"cuponeras_detalle.nro_cuota~") COLUMN(NAME=~"cuponeras_detalle.fecha_venc~") COLUMN(NAME=~"cuponeras_detalle.tipo_mov~") COLUMN(NAME=~"cuponeras_detalle.fecha_pago~") COLUMN(NAME=~"cuponeras_detalle.tipo_cob_pago~") COLUMN(NAME=~"cuponeras_detalle.folio_pago~") COLUMN(NAME=~"cuponeras_detalle.monto_cuota_peso~") COLUMN(NAME=~"cuponeras_detalle.monto_interes_mora~") COLUMN(NAME=~"cuponeras_detalle.monto_gasto_cobranza~") COLUMN(NAME=~"cuponeras_detalle.monto_cuota_contrato~") COLUMN(NAME=~"cuponeras_detalle.sw_gran_cupon~") COLUMN(NAME=~"cuponeras_detalle.base~") COLUMN(NAME=~"cuponeras_detalle.serie~") COLUMN(NAME=~"cuponeras_detalle.numero~") COLUMN(NAME=~"cuponeras_detalle.nro_cuponera~") COLUMN(NAME=~"cuponeras_detalle.cupon_web~") COLUMN(NAME=~"cuponeras.moneda_ctto~")    JOIN (LEFT=~"detalle_cupon_ci.tipo_mov~"    OP =~"=~"RIGHT=~"cuponeras_detalle.tipo_mov~"    OUTER2 =~"cuponeras_detalle.tipo_mov~" )    JOIN (LEFT=~"detalle_cupon_ci.num_cupon~"    OP =~"=~"RIGHT=~"cuponeras_detalle.nro_cupon~"    OUTER2 =~"cuponeras_detalle.nro_cupon~" )    JOIN (LEFT=~"cuponeras.base~"    OP =~"=~"RIGHT=~"cuponeras_detalle.base~" )    JOIN (LEFT=~"cuponeras.serie~"    OP =~"=~"RIGHT=~"cuponeras_detalle.serie~" )    JOIN (LEFT=~"cuponeras.numero~"    OP =~"=~"RIGHT=~"cuponeras_detalle.numero~" )    JOIN (LEFT=~"cuponeras.nro_cuponera~"    OP =~"=~"RIGHT=~"cuponeras_detalle.nro_cuponera~" )    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"cuponeras.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"cuponeras.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"cuponeras.numero~" )WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"CUPONERAS~~~".~~~"ESTADO_CUPONERA~~~"~"   OP =~"=~"    EXP2 =~"'V'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"CUPONERAS~~~".~~~"ESTADO_CUPONERA~~~"~"   OP =~"=~"    EXP2 =~"'C')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CUPONERAS_DETALLE~~~".~~~"ESTADO_PAGO_CUPON~~~"~"   OP =~"<>~"    EXP2 =~"'A'~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number) " update="CUPONERAS_DETALLE" updatewhere=0 updatekeyinplace=yes arguments=(("base", string),("serie", string),("numero", number))  sort="cuponeras_detalle_fecha_venc A " )
