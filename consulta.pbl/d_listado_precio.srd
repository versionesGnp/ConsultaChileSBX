 column=(type=char(50) updatewhereclause=yes name=cod_parq_nombre dbname="cod_parq.nombre" dbalias=".nombre" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"lista_precio~" )  TABLE(NAME=~"cod_parq~" ) COLUMN(NAME=~"lista_precio.sector~") COLUMN(NAME=~"lista_precio.capacidad~") COLUMN(NAME=~"lista_precio.canal~") COLUMN(NAME=~"lista_precio.valor~") COLUMN(NAME=~"lista_precio.t_const~") COLUMN(NAME=~"lista_precio.t_sepult~") COLUMN(NAME=~"lista_precio.derecho~") COLUMN(NAME=~"lista_precio.mantencion~") COLUMN(NAME=~"lista_precio.liberador~") COLUMN(NAME=~"lista_precio.cod_parque~") COLUMN(NAME=~"cod_parq.nombre~")    JOIN (LEFT=~"lista_precio.cod_parque~"    OP =~"=~"RIGHT=~"cod_parq.codigo~" )WHERE(    EXP1 =~"~~~"LISTA_PRECIO~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":cod_parque~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"LISTA_PRECIO~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'A'~" ) ) ORDER(NAME=~"lista_precio.t_sepult~" ASC=yes )  ORDER(NAME=~"lista_precio.sector~" ASC=yes )  ORDER(NAME=~"lista_precio.capacidad~" ASC=yes )  ORDER(NAME=~"lista_precio.canal~" ASC=yes ) ARG(NAME = ~"cod_parque~" TYPE = number) " arguments=(("cod_parque", number)) )
