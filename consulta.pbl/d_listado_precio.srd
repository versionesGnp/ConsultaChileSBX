table(column=(type=char(2) update=yes updatewhereclause=yes name=sector dbname="lista_precio.sector" dbalias=".sector" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=capacidad dbname="lista_precio.capacidad" dbalias=".capacidad" )
 column=(type=char(2) update=yes updatewhereclause=yes name=canal dbname="lista_precio.canal" dbalias=".canal" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=valor dbname="lista_precio.valor" dbalias=".valor" )
 column=(type=char(1) update=yes updatewhereclause=yes name=t_const dbname="lista_precio.t_const" dbalias=".t_const" )
 column=(type=char(1) update=yes updatewhereclause=yes name=t_sepult dbname="lista_precio.t_sepult" dbalias=".t_sepult" )
