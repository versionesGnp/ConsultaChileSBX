compute(band=detail alignment="0" expression="if ( pago_oferta_precio < 350, pago_oferta_precio - vp  - ( (  pago_oferta_nro_cuotas -  oferta_v_cta_pag_s  )/10 ), pago_oferta_precio - vp  - ( (  pago_oferta_nro_cuotas -  oferta_v_cta_pag_s  )*1500 ))"border="0" color="0" x="3132" y="4" height="77" width="636"  font.face="Arial" font.height="-12" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
