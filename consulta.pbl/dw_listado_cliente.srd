 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cliente~" )  TABLE(NAME=~"ciudad~" )  TABLE(NAME=~"comuna~" ) COLUMN(NAME=~"cliente.rut~") COLUMN(NAME=~"cliente.tipo~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cliente.direccion_p~") COLUMN(NAME=~"cliente.poblacion~") COLUMN(NAME=~"cliente.sector~") COLUMN(NAME=~"cliente.comuna~") COLUMN(NAME=~"cliente.ciudad~") COLUMN(NAME=~"cliente.fono_p~") COLUMN(NAME=~"cliente.sexo~") COLUMN(NAME=~"cliente.fecha_nac~") COLUMN(NAME=~"cliente.esta_civil~") COLUMN(NAME=~"cliente.domicilio_c~") COLUMN(NAME=~"cliente.fono_c~") COLUMN(NAME=~"cliente.fecha_ingr~") COLUMN(NAME=~"cliente.total_rent~") COLUMN(NAME=~"cliente.grupo_f~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"cliente.estado_cobranza~") COLUMN(NAME=~"cliente.fecha_cobranza~") COLUMN(NAME=~"cliente.glosa_cobranza~") COLUMN(NAME=~"cliente.usuario~") COLUMN(NAME=~"cliente.estado_titular~") COLUMN(NAME=~"cliente.rut_contacto~") COLUMN(NAME=~"cliente.estado_responso~") COLUMN(NAME=~"comuna.comuna~") COLUMN(NAME=~"ciudad.ciudad~") COLUMN(NAME=~"cliente.tipo_via~") COLUMN(NAME=~"cliente.numero_particular~") COLUMN(NAME=~"cliente.depto_particular~") COLUMN(NAME=~"cliente.block_particular~")    JOIN (LEFT=~"cliente.comuna~"    OP =~"=~"RIGHT=~"comuna.codigo_comuna~" )    JOIN (LEFT=~"cliente.ciudad~"    OP =~"=~"RIGHT=~"ciudad.codigo_ciudad~" )WHERE(    EXP1 =~"~~~"CLIENTE~~~".~~~"ESTADO_TITULAR~~~"~"   OP =~"=~"    EXP2 =~"'1'~" ) ) "  sort="a_paterno A a_materno A nombre A " )
