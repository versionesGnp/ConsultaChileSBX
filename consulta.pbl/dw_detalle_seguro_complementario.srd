 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"beneficiarios_seguro~" )  TABLE(NAME=~"tipo_seguro~" )  TABLE(NAME=~"tipo_seguro_detalle~" )  TABLE(NAME=~"tipo_via~" ) COLUMN(NAME=~"beneficiarios_seguro.base~") COLUMN(NAME=~"beneficiarios_seguro.serie~") COLUMN(NAME=~"beneficiarios_seguro.numero~") COLUMN(NAME=~"beneficiarios_seguro.rut~") COLUMN(NAME=~"beneficiarios_seguro.dv~") COLUMN(NAME=~"beneficiarios_seguro.codigo_seguro~") COLUMN(NAME=~"beneficiarios_seguro.nombres~") COLUMN(NAME=~"beneficiarios_seguro.ap_paterno~") COLUMN(NAME=~"beneficiarios_seguro.ap_materno~") COLUMN(NAME=~"beneficiarios_seguro.codigo_seguro_detalle~") COLUMN(NAME=~"beneficiarios_seguro.fono_contacto~") COLUMN(NAME=~"beneficiarios_seguro.tipo_via~") COLUMN(NAME=~"beneficiarios_seguro.direccion_particular~") COLUMN(NAME=~"beneficiarios_seguro.numero_particular~") COLUMN(NAME=~"beneficiarios_seguro.depto_particular~") COLUMN(NAME=~"beneficiarios_seguro.block_particular~") COLUMN(NAME=~"beneficiarios_seguro.comuna_particular~") COLUMN(NAME=~"beneficiarios_seguro.ciudad_particular~") COLUMN(NAME=~"beneficiarios_seguro.villa_poblacion~") COLUMN(NAME=~"tipo_seguro.descripcion~") COLUMN(NAME=~"tipo_seguro_detalle.descripcion~") COLUMN(NAME=~"tipo_via.descripcion~")    JOIN (LEFT=~"beneficiarios_seguro.codigo_seguro~"    OP =~"=~"RIGHT=~"tipo_seguro.codigo~" )    JOIN (LEFT=~"tipo_seguro.codigo~"    OP =~"=~"RIGHT=~"tipo_seguro_detalle.codigo_seguro~" )    JOIN (LEFT=~"beneficiarios_seguro.codigo_seguro_detalle~"    OP =~"=~"RIGHT=~"tipo_seguro_detalle.codigo_tipo~" )    JOIN (LEFT=~"beneficiarios_seguro.tipo_via~"    OP =~"=~"RIGHT=~"tipo_via.tipo_via~" )WHERE(    EXP1 =~"~~~"BENEFICIARIOS_SEGURO~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"BENEFICIARIOS_SEGURO~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"BENEFICIARIOS_SEGURO~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":numero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"BENEFICIARIOS_SEGURO~~~".~~~"CODIGO_SEGURO~~~"~"   OP =~"=~"    EXP2 =~":codig_seguro~" ) ) ARG(NAME = ~"base~" TYPE = string)  ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number)  ARG(NAME = ~"codig_seguro~" TYPE = number) " arguments=(("base", string),("serie", string),("numero", number),("codig_seguro", number)) )
