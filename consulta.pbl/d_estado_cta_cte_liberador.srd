 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cadena~" )  TABLE(NAME=~"anexo_liberador~" )  TABLE(NAME=~"estado~" ) COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"cadena.fecha_res~") COLUMN(NAME=~"cadena.nro_carta~") COLUMN(NAME=~"cadena.fecha_carta~") COLUMN(NAME=~"cadena.estado_carta~") COLUMN(NAME=~"anexo_liberador.ult_folio~") COLUMN(NAME=~"anexo_liberador.estado_comi~") COLUMN(NAME=~"anexo_liberador.fecha_com~") COLUMN(NAME=~"estado.nombre_estado~") COLUMN(NAME=~"cadena.cod_parque~") COLUMN(NAME=~"anexo_liberador.estado_seguro~") COLUMN(NAME=~"anexo_liberador.ult_fecha_seg~") COLUMN(NAME=~"cadena.estado_contrato_aux~") COLUMN(NAME=~"cadena.codigo_tramo~")    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"anexo_liberador.serie_m~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"anexo_liberador.nro_liberador~" )    JOIN (LEFT=~"cadena.estado~"    OP =~"=~"RIGHT=~"estado.cod_estado~" )WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":as_serie~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":an_numero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'L'~" ) ) ARG(NAME = ~"as_serie~" TYPE = string)  ARG(NAME = ~"an_numero~" TYPE = number) " arguments=(("as_serie", string),("an_numero", number)) )
