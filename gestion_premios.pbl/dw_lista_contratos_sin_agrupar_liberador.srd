 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cadena~" )  TABLE(NAME=~"jefe_ventas~" )  TABLE(NAME=~"agentes~" )  TABLE(NAME=~"supervisor~" )  TABLE(NAME=~"comision_promesa~" )  TABLE(NAME=~"anexo_liberador~" )  TABLE(NAME=~"pago_liberador~" ) COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"jefe_ventas.nombre~") COLUMN(NAME=~"jefe_ventas.a_paterno~") COLUMN(NAME=~"jefe_ventas.a_materno~") COLUMN(NAME=~"supervisor.nombre~") COLUMN(NAME=~"supervisor.a_paterno~") COLUMN(NAME=~"supervisor.a_materno~") COLUMN(NAME=~"agentes.nombre~") COLUMN(NAME=~"agentes.a_paterno~") COLUMN(NAME=~"agentes.a_materno~") COLUMN(NAME=~"agentes.fecha_ini~") COLUMN(NAME=~"agentes.clasificacion~") COLUMN(NAME=~"agentes.estado~") COLUMN(NAME=~"jefe_ventas.fecha_ing~") COLUMN(NAME=~"jefe_ventas.estado~") COLUMN(NAME=~"supervisor.fecha_ing~") COLUMN(NAME=~"supervisor.estado~") COLUMN(NAME=~"supervisor.clasifica~") COLUMN(NAME=~"comision_promesa.c_pie~") COLUMN(NAME=~"comision_promesa.c_primera~") COLUMN(NAME=~"comision_promesa.c_segunda~") COLUMN(NAME=~"comision_promesa.c_tercera~") COLUMN(NAME=~"comision_promesa.c_cuarta~") COLUMN(NAME=~"comision_promesa.c_quinta~") COLUMN(NAME=~"comision_promesa.c_sexta~") COLUMN(NAME=~"anexo_liberador.cod_agente~") COLUMN(NAME=~"anexo_liberador.cod_super~") COLUMN(NAME=~"anexo_liberador.tot_pagado~") COLUMN(NAME=~"anexo_liberador.cta_pag_m~") COLUMN(NAME=~"anexo_liberador.estado_comi~") COLUMN(NAME=~"anexo_liberador.forma_pago~") COLUMN(NAME=~"anexo_liberador.fecha_com~") COLUMN(NAME=~"anexo_liberador.cod_jef~") COLUMN(NAME=~"pago_liberador.nro_cuotas~") COLUMN(NAME=~"pago_liberador.uf_dia~") COLUMN(NAME=~"pago_liberador.moneda~") COLUMN(NAME=~"pago_liberador.fecha_prim~") COLUMN(NAME=~"pago_liberador.pie_pagado~") COLUMN(NAME=~"cadena.serie~") COLUMN(NAME=~"cadena.numero~") COMPUTE(NAME=~"0,0,0,''~") COLUMN(NAME=~"anexo_liberador.estatus_comision~") COLUMN(NAME=~"anexo_liberador.estado_comi_sup~")    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"comision_promesa.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"comision_promesa.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"comision_promesa.numero~" )    JOIN (LEFT=~"anexo_liberador.serie_m~"    OP =~"=~"RIGHT=~"pago_liberador.serie_m~" )    JOIN (LEFT=~"anexo_liberador.nro_liberador~"    OP =~"=~"RIGHT=~"pago_liberador.nro_liberador~" )    JOIN (LEFT=~"anexo_liberador.ult_folio~"    OP =~"=~"RIGHT=~"pago_liberador.folio~" )    JOIN (LEFT=~"anexo_liberador.cod_jef~"    OP =~"=~"RIGHT=~"jefe_ventas.jefe_ventas~" )    JOIN (LEFT=~"anexo_liberador.cod_agente~"    OP =~"=~"RIGHT=~"agentes.cod_age~" )    JOIN (LEFT=~"anexo_liberador.cod_super~"    OP =~"=~"RIGHT=~"supervisor.cod_sup~" )    JOIN (LEFT=~"anexo_liberador.serie_m~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"anexo_liberador.nro_liberador~"    OP =~"=~"RIGHT=~"cadena.numero~" )WHERE(    EXP1 =~"~~~"ANEXO_LIBERADOR~~~".~~~"ESTATUS_COMISION~~~"~"   OP =~"=~"    EXP2 =~"'1'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'L'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"ANEXO_LIBERADOR~~~".~~~"ESTADO_COMI~~~"~"   OP =~"=~"    EXP2 =~"'C'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"ANEXO_LIBERADOR~~~".~~~"ESTADO_COMI~~~"~"   OP =~"=~"    EXP2 =~"'N'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"ANEXO_LIBERADOR~~~".~~~"ESTADO_COMI~~~"~"   OP =~"=~"    EXP2 =~"'S'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"ANEXO_LIBERADOR~~~".~~~"ESTADO_COMI~~~"~"   OP =~"=~"    EXP2 =~"'P')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"CADENA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'V'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'C')~" ) ) " )
