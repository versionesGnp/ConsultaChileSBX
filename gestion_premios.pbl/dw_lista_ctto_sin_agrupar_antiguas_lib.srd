 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cadena~" )  TABLE(NAME=~"jefe_ventas~" )  TABLE(NAME=~"agentes~" )  TABLE(NAME=~"supervisor~" )  TABLE(NAME=~"anexo_liberador~" )  TABLE(NAME=~"pago_liberador~" ) COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"jefe_ventas.nombre~") COLUMN(NAME=~"jefe_ventas.a_paterno~") COLUMN(NAME=~"jefe_ventas.a_materno~") COLUMN(NAME=~"supervisor.nombre~") COLUMN(NAME=~"supervisor.a_paterno~") COLUMN(NAME=~"supervisor.a_materno~") COLUMN(NAME=~"agentes.nombre~") COLUMN(NAME=~"agentes.a_paterno~") COLUMN(NAME=~"agentes.a_materno~") COLUMN(NAME=~"agentes.fecha_ini~") COLUMN(NAME=~"agentes.clasificacion~") COLUMN(NAME=~"agentes.estado~") COLUMN(NAME=~"jefe_ventas.fecha_ing~") COLUMN(NAME=~"jefe_ventas.estado~") COLUMN(NAME=~"supervisor.fecha_ing~") COLUMN(NAME=~"supervisor.estado~") COLUMN(NAME=~"supervisor.clasifica~") COLUMN(NAME=~"cadena.serie~") COLUMN(NAME=~"cadena.numero~") COMPUTE(NAME=~"0,0,0,''~") COLUMN(NAME=~"anexo_liberador.nro_oferta~") COLUMN(NAME=~"anexo_liberador.cod_agente~") COLUMN(NAME=~"anexo_liberador.cod_super~") COLUMN(NAME=~"anexo_liberador.tot_pagado~") COLUMN(NAME=~"anexo_liberador.cta_pag_m~") COLUMN(NAME=~"anexo_liberador.estado_comi~") COLUMN(NAME=~"anexo_liberador.forma_pago~") COLUMN(NAME=~"anexo_liberador.fecha_com~") COLUMN(NAME=~"anexo_liberador.porce_age~") COLUMN(NAME=~"anexo_liberador.porce_sup~") COLUMN(NAME=~"anexo_liberador.por_ingre~") COLUMN(NAME=~"anexo_liberador.cod_jef~") COLUMN(NAME=~"pago_liberador.precio~") COLUMN(NAME=~"pago_liberador.valor_cuota~") COLUMN(NAME=~"pago_liberador.nro_cuotas~") COLUMN(NAME=~"pago_liberador.uf_dia~") COLUMN(NAME=~"pago_liberador.moneda~") COLUMN(NAME=~"pago_liberador.fecha_prim~") COLUMN(NAME=~"pago_liberador.pie_pagado~")    JOIN (LEFT=~"anexo_liberador.serie_m~"    OP =~"=~"RIGHT=~"pago_liberador.serie_m~" )    JOIN (LEFT=~"anexo_liberador.nro_liberador~"    OP =~"=~"RIGHT=~"pago_liberador.nro_liberador~" )    JOIN (LEFT=~"anexo_liberador.ult_folio~"    OP =~"=~"RIGHT=~"pago_liberador.folio~" )    JOIN (LEFT=~"jefe_ventas.jefe_ventas~"    OP =~"=~"RIGHT=~"anexo_liberador.cod_jef~" )    JOIN (LEFT=~"anexo_liberador.cod_agente~"    OP =~"=~"RIGHT=~"agentes.cod_age~" )    JOIN (LEFT=~"anexo_liberador.cod_super~"    OP =~"=~"RIGHT=~"supervisor.cod_sup~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"anexo_liberador.serie_m~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"anexo_liberador.nro_liberador~" )WHERE(    EXP1 =~"~~~"ANEXO_LIBERADOR~~~".~~~"ESTATUS_COMISION~~~"~"   OP =~"=~"    EXP2 =~"'0'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'L'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"ANEXO_LIBERADOR~~~".~~~"U_FECHA~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"ANEXO_LIBERADOR~~~".~~~"U_FECHA~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = date)  ARG(NAME = ~"fecha_fin~" TYPE = date)  ARG(NAME = ~"empresa~" TYPE = number) " arguments=(("fecha_ini", date),("fecha_fin", date),("empresa", number))  sort="anexo_liberador_cod_jef A anexo_liberador_cod_super A anexo_liberador_cod_agente A " )
