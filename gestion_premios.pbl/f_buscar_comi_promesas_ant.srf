global type f_buscar_comi_promesas_ant from function_object
end type

forward prototypes
global function long f_buscar_comi_promesas_ant (string as_base, string as_serie, double al_numero)
end prototypes

global function long f_buscar_comi_promesas_ant (string as_base, string as_serie, double al_numero);long	ll_suma
SELECT sum("INGRESO"."MONTO") 
INTO :ll_suma  
FROM "INGRESO",   
		"CADENA"  
WHERE ( "INGRESO"."SERIE" = "CADENA"."SERIE" ) and  
		( "INGRESO"."CONTRATO" = "CADENA"."NUMERO" ) and
		( ( "CADENA"."CODIGO" = :as_base) AND  
		( "INGRESO"."SERIE" = :as_serie ) AND  
		( "INGRESO"."CONTRATO" = :al_numero ) )   
USING	sqlca	;
if sqlca.sqlcode=0 then
	if ll_suma<=0 or isnull(ll_suma) then ll_suma=0
else
	ll_suma=0
end if
return(ll_suma)
end function

