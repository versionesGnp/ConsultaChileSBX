 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cadena~" )  TABLE(NAME=~"jefe_ventas~" )  TABLE(NAME=~"agentes~" )  TABLE(NAME=~"supervisor~" )  TABLE(NAME=~"comision_promesa~" )  TABLE(NAME=~"anexo_aumento~" )  TABLE(NAME=~"pago_aumento~" ) COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"jefe_ventas.nombre~") COLUMN(NAME=~"jefe_ventas.a_paterno~") COLUMN(NAME=~"jefe_ventas.a_materno~") COLUMN(NAME=~"supervisor.nombre~") COLUMN(NAME=~"supervisor.a_paterno~") COLUMN(NAME=~"supervisor.a_materno~") COLUMN(NAME=~"agentes.nombre~") COLUMN(NAME=~"agentes.a_paterno~") COLUMN(NAME=~"agentes.a_materno~") COLUMN(NAME=~"agentes.fecha_ini~") COLUMN(NAME=~"agentes.clasificacion~") COLUMN(NAME=~"agentes.estado~") COLUMN(NAME=~"jefe_ventas.fecha_ing~") COLUMN(NAME=~"jefe_ventas.estado~") COLUMN(NAME=~"supervisor.fecha_ing~") COLUMN(NAME=~"supervisor.estado~") COLUMN(NAME=~"supervisor.clasifica~") COLUMN(NAME=~"comision_promesa.c_pie~") COLUMN(NAME=~"comision_promesa.c_primera~") COLUMN(NAME=~"comision_promesa.c_segunda~") COLUMN(NAME=~"comision_promesa.c_tercera~") COLUMN(NAME=~"comision_promesa.c_cuarta~") COLUMN(NAME=~"comision_promesa.c_quinta~") COLUMN(NAME=~"comision_promesa.c_sexta~") COLUMN(NAME=~"cadena.serie~") COLUMN(NAME=~"cadena.numero~") COMPUTE(NAME=~"0,0,0,''~") COLUMN(NAME=~"anexo_aumento.serie_m~") COLUMN(NAME=~"anexo_aumento.nro_aumento~") COLUMN(NAME=~"anexo_aumento.cod_agente~") COLUMN(NAME=~"anexo_aumento.cod_super~") COLUMN(NAME=~"anexo_aumento.tot_pagado~") COLUMN(NAME=~"anexo_aumento.cta_pag_m~") COLUMN(NAME=~"anexo_aumento.estado_comi~") COLUMN(NAME=~"anexo_aumento.forma_pago~") COLUMN(NAME=~"anexo_aumento.fecha_com~") COLUMN(NAME=~"anexo_aumento.cod_jef~") COLUMN(NAME=~"anexo_aumento.estatus_comision~") COLUMN(NAME=~"anexo_aumento.estado_comi_sup~") COLUMN(NAME=~"pago_aumento.precio~") COLUMN(NAME=~"pago_aumento.pie~") COLUMN(NAME=~"pago_aumento.nro_cuotas~") COLUMN(NAME=~"pago_aumento.uf_dia~") COLUMN(NAME=~"pago_aumento.moneda~") COLUMN(NAME=~"pago_aumento.fecha_prim~") COLUMN(NAME=~"pago_aumento.pie_pagado~")    JOIN (LEFT=~"cadena.codigo~"    OP =~"=~"RIGHT=~"comision_promesa.base~" )    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"comision_promesa.serie~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"comision_promesa.numero~" )    JOIN (LEFT=~"anexo_aumento.serie_m~"    OP =~"=~"RIGHT=~"pago_aumento.serie_m~" )    JOIN (LEFT=~"anexo_aumento.nro_aumento~"    OP =~"=~"RIGHT=~"pago_aumento.nro_aumento~" )    JOIN (LEFT=~"anexo_aumento.ult_folio~"    OP =~"=~"RIGHT=~"pago_aumento.folio~" )    JOIN (LEFT=~"anexo_aumento.serie_m~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"anexo_aumento.nro_aumento~"    OP =~"=~"RIGHT=~"cadena.numero~" )    JOIN (LEFT=~"anexo_aumento.cod_agente~"    OP =~"=~"RIGHT=~"agentes.cod_age~" )    JOIN (LEFT=~"anexo_aumento.cod_super~"    OP =~"=~"RIGHT=~"supervisor.cod_sup~" )    JOIN (LEFT=~"anexo_aumento.cod_jef~"    OP =~"=~"RIGHT=~"jefe_ventas.jefe_ventas~" )WHERE(    EXP1 =~"~~~"ANEXO_AUMENTO~~~".~~~"ESTATUS_COMISION~~~"~"   OP =~"=~"    EXP2 =~"'1'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'O'~" ) ) " )
