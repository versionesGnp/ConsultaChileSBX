 COLUMN(NAME=~"ficha_carta_sepultacion.depto_direccion_titular~") COLUMN(NAME=~"ficha_carta_sepultacion.block_direccion_titular~") COLUMN(NAME=~"ficha_carta_sepultacion.poblacion_villa_titular~") COLUMN(NAME=~"ficha_carta_sepultacion.sector_titular~") COLUMN(NAME=~"ficha_carta_sepultacion.hora_sepultacion~") COLUMN(NAME=~"ficha_carta_sepultacion.minuto_sepultacion~") COLUMN(NAME=~"tipo_via.descripcion~") COLUMN(NAME=~"ficha_carta_sepultacion.codigo_funeraria~") COLUMN(NAME=~"ficha_carta_sepultacion.nombre_titular~") COLUMN(NAME=~"ficha_carta_sepultacion.apellido_paterno_titular~") COLUMN(NAME=~"ficha_carta_sepultacion.apellido_materno_titular~") COLUMN(NAME=~"ficha_carta_sepultacion.rut_titular~") COLUMN(NAME=~"ficha_carta_sepultacion.dv_titular~") COLUMN(NAME=~"ficha_carta_sepultacion.fecha_sepultacion~") COLUMN(NAME=~"ficha_traslado.tipo_traslado~") COLUMN(NAME=~"ficha_carta_sepultacion.folio~") COLUMN(NAME=~"ficha_grabacion_lapida.folio~") COLUMN(NAME=~"ficha_grabacion_lapida.correlativo~") COLUMN(NAME=~"ficha_grabacion_lapida.tipo_construccion~") COLUMN(NAME=~"membrete_empresa.ciudad~") COLUMN(NAME=~"membrete_empresa.parque~") COLUMN(NAME=~"ficha_grabacion_lapida.familia~")    JOIN (LEFT=~"ficha_carta_sepultacion.correlativo~"    OP =~"=~"RIGHT=~"ficha_traslado.folio~"    OUTER1 =~"ficha_carta_sepultacion.correlativo~" )    JOIN (LEFT=~"ficha_carta_sepultacion.base~"    OP =~"=~"RIGHT=~"ficha_traslado.base_origen~"    OUTER1 =~"ficha_carta_sepultacion.base~" )    JOIN (LEFT=~"ficha_carta_sepultacion.serie~"    OP =~"=~"RIGHT=~"ficha_traslado.serie_origen~"    OUTER1 =~"ficha_carta_sepultacion.serie~" )    JOIN (LEFT=~"ficha_carta_sepultacion.numero~"    OP =~"=~"RIGHT=~"ficha_traslado.numero_origen~"    OUTER1 =~"ficha_carta_sepultacion.numero~" )    JOIN (LEFT=~"ficha_carta_sepultacion.fecha_sepultacion~"    OP =~"=~"RIGHT=~"ficha_traslado.fecha_traslado~"    OUTER1 =~"ficha_carta_sepultacion.fecha_sepultacion~" )    JOIN (LEFT=~"ficha_carta_sepultacion.cod_parque~"    OP =~"=~"RIGHT=~"ficha_traslado.cod_parque~"    OUTER1 =~"ficha_carta_sepultacion.cod_parque~" )    JOIN (LEFT=~"ficha_grabacion_lapida.sector~"    OP =~"=~"RIGHT=~"ficha_carta_sepultacion.sector~" )    JOIN (LEFT=~"ficha_grabacion_lapida.sepultura~"    OP =~"=~"RIGHT=~"ficha_carta_sepultacion.sepultura~" )    JOIN (LEFT=~"ficha_grabacion_lapida.cod_parque~"    OP =~"=~"RIGHT=~"ficha_carta_sepultacion.cod_parque~" )    JOIN (LEFT=~"ficha_carta_sepultacion.tipo_via_titular~"    OP =~"=~"RIGHT=~"tipo_via.tipo_via~" )    JOIN (LEFT=~"ficha_grabacion_lapida.fecha~"    OP =~"=~"RIGHT=~"ficha_carta_sepultacion.fecha_carta~" )    JOIN (LEFT=~"ficha_grabacion_lapida.folio~"    OP =~"=~"RIGHT=~"ficha_carta_sepultacion.correlativo~" )    JOIN (LEFT=~"ficha_grabacion_lapida.cod_parque~"    OP =~"=~"RIGHT=~"membrete_empresa.cod_parque~" )WHERE(    EXP1 =~"(~~~"FICHA_GRABACION_LAPIDA~~~".~~~"SECTOR~~~"~"   OP =~"=~"    EXP2 =~":sector~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FICHA_GRABACION_LAPIDA~~~".~~~"SEPULTURA~~~"~"   OP =~"=~"    EXP2 =~":sepultura~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FICHA_GRABACION_LAPIDA~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FICHA_GRABACION_LAPIDA~~~".~~~"FECHA_SEPULTACION~~~"~"   OP =~"=~"    EXP2 =~":fecha_sepult~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FICHA_CARTA_SEPULTACION~~~".~~~"FOLIO~~~"~"   OP =~"=~"    EXP2 =~":correlativo)~" ) ) ARG(NAME = ~"sector~" TYPE = string)  ARG(NAME = ~"sepultura~" TYPE = string)  ARG(NAME = ~"parque~" TYPE = number)  ARG(NAME = ~"fecha_sepult~" TYPE = datetime)  ARG(NAME = ~"correlativo~" TYPE = number) " arguments=(("sector", string),("sepultura", string),("parque", number),("fecha_sepult", datetime),("correlativo", number)) )
