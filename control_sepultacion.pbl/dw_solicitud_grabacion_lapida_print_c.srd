compute(band=detail alignment="3" expression="'Domiciliado en '+ tipo_via_descripcion +' '+  ficha_carta_sepultacion_direccion_titula +' Nº '+  ficha_carta_sepultacion_numero_direccion +' ' +if (isnull( ficha_carta_sepultacion_depto_direccion_ ) or  ficha_carta_sepultacion_depto_direccion_ ='' or  ficha_carta_sepultacion_depto_direccion_ ='-','',' Depto. '+ ficha_carta_sepultacion_depto_direccion_ ) + if( isnull( ficha_carta_sepultacion_block_direccion_ ) or  ficha_carta_sepultacion_block_direccion_ ='' or  ficha_carta_sepultacion_block_direccion_ ='-', '','Block '+  ficha_carta_sepultacion_block_direccion_ ) +' '+ if (isnull( ficha_carta_sepultacion_poblacion_villa_ ) or  ficha_carta_sepultacion_poblacion_villa_ ='' or  ficha_carta_sepultacion_poblacion_villa_ ='-','',' Población '+   ficha_carta_sepultacion_poblacion_villa_ ) +if (isnull( ficha_carta_sepultacion_sector_titular ) or  ficha_carta_sepultacion_sector_titular  ='' or  ficha_carta_sepultacion_sector_titular  ='-','',' Sector '+ ficha_carta_sepultacion_sector_titular  )"border="0" color="0" x="18" y="832" height="140" width="2930" format="[GENERAL]" html.valueishtml="0"  name=compute_12 visible="1"  font.face="Arial" font.height="-10" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" background.transparency="0" background.gradient.color="8421504" background.gradient.transparency="0" background.gradient.angle="0" background.brushmode="0" background.gradient.repetition.mode="0" background.gradient.repetition.count="0" background.gradient.repetition.length="100" background.gradient.focus="0" background.gradient.scale="100" background.gradient.spread="100" tooltip.backcolor="134217752" tooltip.delay.initial="0" tooltip.delay.visible="32000" tooltip.enabled="0" tooltip.hasclosebutton="0" tooltip.icon="0" tooltip.isbubble="0" tooltip.maxwidth="0" tooltip.textcolor="134217751" tooltip.transparency="0" transparency="0" )
