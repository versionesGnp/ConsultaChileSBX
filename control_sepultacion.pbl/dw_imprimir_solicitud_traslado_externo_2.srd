 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ficha_traslado~" )  TABLE(NAME=~"membrete_empresa~" )  TABLE(NAME=~"cod_parq~" ALIAS=~"cod_parq_a~" )  TABLE(NAME=~"cod_parq~" ALIAS=~"cod_parq_b~" ) COLUMN(NAME=~"ficha_traslado.tipo_traslado~") COLUMN(NAME=~"ficha_traslado.rut_titular_origen~") COLUMN(NAME=~"ficha_traslado.dv_titular_origen~") COLUMN(NAME=~"ficha_traslado.cod_parque~") COLUMN(NAME=~"ficha_traslado.sector_origen~") COLUMN(NAME=~"ficha_traslado.sepultura_origen~") COLUMN(NAME=~"ficha_traslado.nombre_fallecido~") COLUMN(NAME=~"ficha_traslado.apellido_paterno_fall~") COLUMN(NAME=~"ficha_traslado.apellido_materno_fall~") COLUMN(NAME=~"ficha_traslado.nombre_titular_origen~") COLUMN(NAME=~"ficha_traslado.apellido_pat_titular_origen~") COLUMN(NAME=~"ficha_traslado.apellido_mat_titular_origen~") COLUMN(NAME=~"ficha_traslado.cod_parque_destino~") COLUMN(NAME=~"ficha_traslado.nombre_titular_destino~") COLUMN(NAME=~"ficha_traslado.apellido_pat_titular_destino~") COLUMN(NAME=~"ficha_traslado.apellido_mat_titular_destino~") COLUMN(NAME=~"ficha_traslado.rut_titular_destino~") COLUMN(NAME=~"ficha_traslado.dv_titular_destino~") COLUMN(NAME=~"ficha_traslado.sector_destino~") COLUMN(NAME=~"ficha_traslado.sepultura_destino~") COLUMN(NAME=~"membrete_empresa.parque~") COLUMN(NAME=~"membrete_empresa.ciudad~") COLUMN(NAME=~"cod_parq_a.nombre~") COLUMN(NAME=~"ficha_traslado.destino_parque~") COLUMN(NAME=~"cod_parq_b.nombre~")    JOIN (LEFT=~"ficha_traslado.cod_parque~"    OP =~"=~"RIGHT=~"membrete_empresa.cod_parque~" )    JOIN (LEFT=~"ficha_traslado.cod_parque_destino~"    OP =~"=~"RIGHT=~"cod_parq_a.codigo~" )    JOIN (LEFT=~"ficha_traslado.cod_parque_origen~"    OP =~"=~"RIGHT=~"cod_parq_b.codigo~" )WHERE(    EXP1 =~"~~~"FICHA_TRASLADO~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FICHA_TRASLADO~~~".~~~"SECTOR_ORIGEN~~~"~"   OP =~"=~"    EXP2 =~":sector~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FICHA_TRASLADO~~~".~~~"SEPULTURA_ORIGEN~~~"~"   OP =~"=~"    EXP2 =~":sepultura~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FICHA_TRASLADO~~~".~~~"FECHA_TRASLADO~~~"~"   OP =~"=~"    EXP2 =~":fecha_traslado~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FICHA_TRASLADO~~~".~~~"TIPO_TRASLADO~~~"~"   OP =~"=~"    EXP2 =~":tipo_traslado~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FICHA_TRASLADO~~~".~~~"ESTADO_REG~~~"~"   OP =~"<>~"    EXP2 =~"'A'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FICHA_TRASLADO~~~".~~~"NOMBRE_FALLECIDO~~~"~"   OP =~"=~"    EXP2 =~":nom_fall~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FICHA_TRASLADO~~~".~~~"APELLIDO_PATERNO_FALL~~~"~"   OP =~"=~"    EXP2 =~":ap_pat_fall~" ) ) ARG(NAME = ~"parque~" TYPE = number)  ARG(NAME = ~"sector~" TYPE = string)  ARG(NAME = ~"sepultura~" TYPE = string)  ARG(NAME = ~"fecha_traslado~" TYPE = datetime)  ARG(NAME = ~"tipo_traslado~" TYPE = string)  ARG(NAME = ~"nom_fall~" TYPE = string)  ARG(NAME = ~"ap_pat_fall~" TYPE = string) " arguments=(("parque", number),("sector", string),("sepultura", string),("fecha_traslado", datetime),("tipo_traslado", string),("nom_fall", string),("ap_pat_fall", string)) )
