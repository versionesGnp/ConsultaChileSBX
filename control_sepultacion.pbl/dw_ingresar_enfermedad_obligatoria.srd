") COLUMN(NAME=~"ficha_registro.estado_reg~") COLUMN(NAME=~"ficha_registro.cod_parque~") COLUMN(NAME=~"ficha_registro.destino_parque~") COLUMN(NAME=~"ficha_registro.cod_parque_destino~") COLUMN(NAME=~"membrete_empresa.parque~") COLUMN(NAME=~"membrete_empresa.ciudad~")    JOIN (LEFT=~"ficha_registro.cod_parque~"    OP =~"=~"RIGHT=~"membrete_empresa.cod_parque~" )WHERE(    EXP1 =~"~~~"FICHA_REGISTRO~~~".~~~"CORRELATIVO_MENSUAL~~~"~"   OP =~"=~"    EXP2 =~":corr_mensual~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FICHA_REGISTRO~~~".~~~"CORRELATIVO_ANUAL~~~"~"   OP =~"=~"    EXP2 =~":corr_anual~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FICHA_REGISTRO~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FICHA_REGISTRO~~~".~~~"FECHA_SEPULTACION~~~"~"   OP =~"=~"    EXP2 =~":fecha_sep~" ) ) ARG(NAME = ~"corr_mensual~" TYPE = number)  ARG(NAME = ~"corr_anual~" TYPE = number)  ARG(NAME = ~"parque~" TYPE = number)  ARG(NAME = ~"fecha_sep~" TYPE = datetime) " update="FICHA_REGISTRO" updatewhere=0 updatekeyinplace=yes arguments=(("corr_mensual", number),("corr_anual", number),("parque", number),("fecha_sep", datetime)) )
