 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"ficha_grabacion_lapida~" )  TABLE(NAME=~"ficha_carta_sepultacion~" )  TABLE(NAME=~"tipo_via~" ) COLUMN(NAME=~"ficha_grabacion_lapida.base~") COLUMN(NAME=~"ficha_grabacion_lapida.serie~") COLUMN(NAME=~"ficha_grabacion_lapida.numero~") COLUMN(NAME=~"ficha_grabacion_lapida.fecha~") COLUMN(NAME=~"ficha_grabacion_lapida.nombre_titular~") COLUMN(NAME=~"ficha_grabacion_lapida.apellido_paterno_titular~") COLUMN(NAME=~"ficha_grabacion_lapida.apellido_materno_titular~") COLUMN(NAME=~"ficha_grabacion_lapida.rut_titular~") COLUMN(NAME=~"ficha_grabacion_lapida.dv_titular~") COLUMN(NAME=~"ficha_grabacion_lapida.sector~") COLUMN(NAME=~"ficha_grabacion_lapida.sepultura~") COLUMN(NAME=~"ficha_grabacion_lapida.numero_tecnico~") COLUMN(NAME=~"ficha_grabacion_lapida.capacidad~") COLUMN(NAME=~"ficha_grabacion_lapida.nombre_fallecido~") COLUMN(NAME=~"ficha_grabacion_lapida.apellido_paterno_fall~") COLUMN(NAME=~"ficha_grabacion_lapida.apellido_materno_fall~") COLUMN(NAME=~"ficha_grabacion_lapida.fecha_nacimiento_fall~") COLUMN(NAME=~"ficha_grabacion_lapida.fecha_fallecimiento~") COLUMN(NAME=~"ficha_grabacion_lapida.codigo_religion~") COLUMN(NAME=~"ficha_grabacion_lapida.codigo_imagen~") COLUMN(NAME=~"ficha_grabacion_lapida.nombre_fallecido_lapida~") COLUMN(NAME=~"ficha_grabacion_lapida.fecha_defuncion_lapida~") COLUMN(NAME=~"ficha_grabacion_lapida.fecha_nacimiento_lapida~") COLUMN(NAME=~"ficha_grabacion_lapida.folio~") COLUMN(NAME=~"ficha_grabacion_lapida.rut_fallecido~") COLUMN(NAME=~"ficha_grabacion_lapida.dv_fallecido~") COLUMN(NAME=~"ficha_grabacion_lapida.cod_parque~") COLUMN(NAME=~"ficha_grabacion_lapida.estado_reg~") COLUMN(NAME=~"ficha_grabacion_lapida.primera_sepultura~") COLUMN(NAME=~"ficha_grabacion_lapida.fecha_recepcion~") COLUMN(NAME=~"ficha_carta_sepultacion.fecha_carta~") COLUMN(NAME=~"ficha_carta_sepultacion.direccion_titular~") COLUMN(NAME=~"ficha_carta_sepultacion.numero_direccion_titular~") COLUMN(NAME=~"ficha_carta_sepultacion.depto_direccion_titular~") COLUMN(NAME=~"ficha_carta_sepultacion.block_direccion_titular~") COLUMN(NAME=~"ficha_carta_sepultacion.poblacion_villa_titular~") COLUMN(NAME=~"ficha_carta_sepultacion.sector_titular~") COLUMN(NAME=~"ficha_carta_sepultacion.hora_sepultacion~") COLUMN(NAME=~"ficha_carta_sepultacion.minuto_sepultacion~") COLUMN(NAME=~"tipo_via.descripcion~") COLUMN(NAME=~"ficha_carta_sepultacion.codigo_funeraria~") COLUMN(NAME=~"ficha_carta_sepultacion.nombre_titular~") COLUMN(NAME=~"ficha_carta_sepultacion.apellido_paterno_titular~") COLUMN(NAME=~"ficha_carta_sepultacion.apellido_materno_titular~") COLUMN(NAME=~"ficha_carta_sepultacion.rut_titular~") COLUMN(NAME=~"ficha_carta_sepultacion.dv_titular~")    JOIN (LEFT=~"ficha_grabacion_lapida.sector~"    OP =~"=~"RIGHT=~"ficha_carta_sepultacion.sector~" )    JOIN (LEFT=~"ficha_grabacion_lapida.sepultura~"    OP =~"=~"RIGHT=~"ficha_carta_sepultacion.sepultura~" )    JOIN (LEFT=~"ficha_grabacion_lapida.folio~"    OP =~"=~"RIGHT=~"ficha_carta_sepultacion.correlativo~" )    JOIN (LEFT=~"ficha_grabacion_lapida.cod_parque~"    OP =~"=~"RIGHT=~"ficha_carta_sepultacion.cod_parque~" )    JOIN (LEFT=~"ficha_carta_sepultacion.tipo_via_titular~"    OP =~"=~"RIGHT=~"tipo_via.tipo_via~" )    JOIN (LEFT=~"ficha_grabacion_lapida.fecha~"    OP =~"=~"RIGHT=~"ficha_carta_sepultacion.fecha_sepultacion~" )WHERE(    EXP1 =~"(~~~"FICHA_GRABACION_LAPIDA~~~".~~~"SECTOR~~~"~"   OP =~"=~"    EXP2 =~":sector~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FICHA_GRABACION_LAPIDA~~~".~~~"SEPULTURA~~~"~"   OP =~"=~"    EXP2 =~":sepultura~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FICHA_GRABACION_LAPIDA~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FICHA_GRABACION_LAPIDA~~~".~~~"FECHA~~~"~"   OP =~"=~"    EXP2 =~":fecha_sepult~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FICHA_GRABACION_LAPIDA~~~".~~~"FOLIO~~~"~"   OP =~"=~"    EXP2 =~":correlativo)~" ) ) ARG(NAME = ~"sector~" TYPE = string)  ARG(NAME = ~"sepultura~" TYPE = string)  ARG(NAME = ~"parque~" TYPE = number)  ARG(NAME = ~"fecha_sepult~" TYPE = datetime)  ARG(NAME = ~"correlativo~" TYPE = number) " arguments=(("sector", string),("sepultura", string),("parque", number),("fecha_sepult", datetime),("correlativo", number)) )
