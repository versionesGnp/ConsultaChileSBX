 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"fc_documentos_detalle~" ) COLUMN(NAME=~"fc_documentos_detalle.folio_crematorio~") COLUMN(NAME=~"fc_documentos_detalle.base~") COLUMN(NAME=~"fc_documentos_detalle.serie~") COLUMN(NAME=~"fc_documentos_detalle.numero~") COLUMN(NAME=~"fc_documentos_detalle.estado_reg~") COLUMN(NAME=~"fc_documentos_detalle.codigo_documento~") COLUMN(NAME=~"fc_documentos_detalle.categoria~") COLUMN(NAME=~"fc_documentos_detalle.url~") COLUMN(NAME=~"fc_documentos_detalle.fecha_crea~") COLUMN(NAME=~"fc_documentos_detalle.usuario_crea~") COLUMN(NAME=~"fc_documentos_detalle.rut_tercero~") COLUMN(NAME=~"fc_documentos_detalle.estado_carga~") COLUMN(NAME=~"fc_documentos_detalle.estado_ficha~") COLUMN(NAME=~"fc_documentos_detalle.autoriza_seremi~") COLUMN(NAME=~"fc_documentos_detalle.usuario_valida~") COLUMN(NAME=~"fc_documentos_detalle.fecha_valida~") COLUMN(NAME=~"fc_documentos_detalle.observacion_valida~")WHERE(    EXP1 =~"~~~"FC_DOCUMENTOS_DETALLE~~~".~~~"FOLIO_CREMATORIO~~~"~"   OP =~"=~"    EXP2 =~":folio~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FC_DOCUMENTOS_DETALLE~~~".~~~"ESTADO_REG~~~"~"   OP =~"=~"    EXP2 =~"'A'~" ) ) ARG(NAME = ~"folio~" TYPE = number) " update="FC_DOCUMENTOS_DETALLE" updatewhere=0 updatekeyinplace=yes arguments=(("folio", number))  sort="categoria A rut_tercero A codigo_documento A " )
