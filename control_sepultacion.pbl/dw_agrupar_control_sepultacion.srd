 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"ficha_traslado~" ) COLUMN(NAME=~"ficha_traslado.cod_parque~") COLUMN(NAME=~"ficha_traslado.fecha_traslado~") COLUMN(NAME=~"ficha_traslado.tipo_traslado~") COLUMN(NAME=~"ficha_traslado.destino_parque~") COMPUTE(NAME=~"'FT'~") COLUMN(NAME=~"ficha_traslado.nombre_fallecido~")WHERE(    EXP1 =~"~~~"FICHA_TRASLADO~~~".~~~"FECHA_TRASLADO~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FICHA_TRASLADO~~~".~~~"FECHA_TRASLADO~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FICHA_TRASLADO~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FICHA_TRASLADO~~~".~~~"ESTADO_REG~~~"~"   OP =~"<>~"    EXP2 =~"'A'~" ) )    UNION (PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"ficha_sepultacion~" ) COLUMN(NAME=~"ficha_sepultacion.cod_parque~") COLUMN(NAME=~"ficha_sepultacion.fecha_sepultacion~") COLUMN(NAME=~"ficha_sepultacion.base~") COLUMN(NAME=~"ficha_sepultacion.serie~") COMPUTE(NAME=~"'FS'~") COLUMN(NAME=~"ficha_sepultacion.nombre_fallecido~")WHERE(    EXP1 =~"~~~"FICHA_SEPULTACION~~~".~~~"FECHA_SEPULTACION~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FICHA_SEPULTACION~~~".~~~"FECHA_SEPULTACION~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FICHA_SEPULTACION~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FICHA_SEPULTACION~~~".~~~"ESTADO_REG~~~"~"   OP =~"<>~"    EXP2 =~"'A'~" ) ))    UNION (PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"ficha_reduccion~" ) COLUMN(NAME=~"ficha_reduccion.cod_parque~") COLUMN(NAME=~"ficha_reduccion.fecha_sepultacion~") COLUMN(NAME=~"ficha_reduccion.base~") COLUMN(NAME=~"ficha_reduccion.serie~") COMPUTE(NAME=~"'FR'~") COLUMN(NAME=~"ficha_reduccion.nombre_fallecido~")WHERE(    EXP1 =~"~~~"FICHA_REDUCCION~~~".~~~"FECHA_SEPULTACION~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FICHA_REDUCCION~~~".~~~"FECHA_SEPULTACION~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FICHA_REDUCCION~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FICHA_REDUCCION~~~".~~~"ESTADO_REG~~~"~"   OP =~"<>~"    EXP2 =~"'A'~" ) )) ARG(NAME = ~"fecha_ini~" TYPE = datetime)  ARG(NAME = ~"fecha_fin~" TYPE = datetime)  ARG(NAME = ~"parque~" TYPE = number) " arguments=(("fecha_ini", datetime),("fecha_fin", datetime),("parque", number))  sort="fecha_traslado A c_tipo_ficha A tipo_traslado A destino_parque A " )
