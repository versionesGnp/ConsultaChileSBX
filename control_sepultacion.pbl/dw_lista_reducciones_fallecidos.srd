 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"fallecidos~" ) COLUMN(NAME=~"fallecidos.llave~") COLUMN(NAME=~"fallecidos.folio~") COLUMN(NAME=~"fallecidos.n_l~") COLUMN(NAME=~"fallecidos.n_m~") COLUMN(NAME=~"fallecidos.base~") COLUMN(NAME=~"fallecidos.ss~") COLUMN(NAME=~"fallecidos.contrato~") COLUMN(NAME=~"fallecidos.sector~") COLUMN(NAME=~"fallecidos.n_sep~") COLUMN(NAME=~"fallecidos.nombres~") COLUMN(NAME=~"fallecidos.ap_paterno~") COLUMN(NAME=~"fallecidos.ap_materno~") COLUMN(NAME=~"fallecidos.fec_sep~") COLUMN(NAME=~"fallecidos.est~") COLUMN(NAME=~"fallecidos.op~") COLUMN(NAME=~"fallecidos.rut~") COLUMN(NAME=~"fallecidos.dv~") COLUMN(NAME=~"fallecidos.sexo~") COLUMN(NAME=~"fallecidos.edad~") COLUMN(NAME=~"fallecidos.periodo~") COLUMN(NAME=~"fallecidos.fec_nac~") COLUMN(NAME=~"fallecidos.fec_fall~") COLUMN(NAME=~"fallecidos.pase~") COLUMN(NAME=~"fallecidos.reg_civil~") COLUMN(NAME=~"fallecidos.causa_fall~") COLUMN(NAME=~"fallecidos.enf_obl~") COLUMN(NAME=~"fallecidos.funeraria~") COLUMN(NAME=~"fallecidos.boleta~") COLUMN(NAME=~"fallecidos.carta_aut~") COLUMN(NAME=~"fallecidos.rg_est~") COLUMN(NAME=~"fallecidos.n_tec~") COLUMN(NAME=~"fallecidos.nivel~") COLUMN(NAME=~"fallecidos.vta~") COLUMN(NAME=~"fallecidos.observaciones~") COLUMN(NAME=~"fallecidos.estado_contrato~") COLUMN(NAME=~"fallecidos.resolucion_traslado_nro~") COLUMN(NAME=~"fallecidos.otorgado_por~") COLUMN(NAME=~"fallecidos.cementerio_origen~") COLUMN(NAME=~"fallecidos.cod_parque~") COLUMN(NAME=~"fallecidos.fecha_sistema~") COLUMN(NAME=~"fallecidos.llave_anterior~")WHERE(    EXP1 =~"~~~"FALLECIDOS~~~".~~~"FEC_SEP~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FALLECIDOS~~~".~~~"FEC_SEP~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FALLECIDOS~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FALLECIDOS~~~".~~~"EST~~~"~"   OP =~"=~"    EXP2 =~"'RE'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FALLECIDOS~~~".~~~"ESTADO_REG~~~"~"   OP =~"=~"    EXP2 =~"'A'~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = datetime)  ARG(NAME = ~"fecha_fin~" TYPE = datetime)  ARG(NAME = ~"parque~" TYPE = number) " update="FALLECIDOS" updatewhere=0 updatekeyinplace=yes arguments=(("fecha_ini", datetime),("fecha_fin", datetime),("parque", number))  sort="llave A " )
