        FROM ~"FICHA_SEPULTACION~"      
        WHERE ( ~"FICHA_SEPULTACION~".~"FECHA_SEPULTACION~" = :ldt_fecha ) And          ( ~"FICHA_SEPULTACION~".~"COD_PARQUE~" = :cod_parque ) And          ( ~"FICHA_SEPULTACION~".~"SECTOR~" = :sector ) And          ( ~"FICHA_SEPULTACION~".~"SEPULTURA~" = :sepultura )   " update="FICHA_SEPULTACION" updatewhere=0 updatekeyinplace=yes arguments=(("ldt_fecha", datetime),("cod_parque", number),("sector", string),("sepultura", string))  sort="correlativo_interno A " )
