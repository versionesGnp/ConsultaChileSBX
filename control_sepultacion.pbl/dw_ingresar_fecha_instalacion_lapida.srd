N(NAME=~"ficha_grabacion_lapida.fecha_sepultacion~") COLUMN(NAME=~"ficha_grabacion_lapida.grabacion_manual~") COLUMN(NAME=~"ficha_grabacion_lapida.tipo_construccion~")WHERE(    EXP1 =~"~~~"FICHA_GRABACION_LAPIDA~~~".~~~"SECTOR~~~"~"   OP =~"=~"    EXP2 =~":sector~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FICHA_GRABACION_LAPIDA~~~".~~~"SEPULTURA~~~"~"   OP =~"=~"    EXP2 =~":sepultura~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FICHA_GRABACION_LAPIDA~~~".~~~"CORRELATIVO~~~"~"   OP =~"=~"    EXP2 =~":corre~" ) ) ARG(NAME = ~"sector~" TYPE = string)  ARG(NAME = ~"sepultura~" TYPE = string)  ARG(NAME = ~"corre~" TYPE = number) " update="FICHA_GRABACION_LAPIDA" updatewhere=0 updatekeyinplace=yes arguments=(("sector", string),("sepultura", string),("corre", number)) )
