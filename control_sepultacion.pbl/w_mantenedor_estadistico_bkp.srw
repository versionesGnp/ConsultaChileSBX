event clicked;Datetime	ld_fec_ini,ld_fec_fin,ldt_fecha_def
time		lt_ini=time('00:00:00'), lt_fin=time('23:59:59')
Long		ll_cod_parque,ll_tot_reg,ll_indi,ll_max_llave
Date		ldt_fecha_hoy
String	ls_sector,ls_sepultura,ls_nom,ls_ap_pat,ls_ap_mat,ls_nom_ult,ls_ap_pat_ult,ls_ap_mat_ult,&
			ls_nom_comp_ult

if dw_lista.rowcount() > 0 then
	dw_print_ficha.dataobject	= 'dw_lista_grabacion_lapida_por_proveedor'
	dw_print_ficha.settransobject(sqlca)
	ld_fec_ini						= datetime(date(em_fec_ini.text),lt_ini)
	ld_fec_fin						= datetime(date(em_fec_fin.text),lt_fin)
	ldt_fecha_hoy					= date(gdt_fec_sistema)
	if trim(em_fec_ini.text)='00/00/0000' or isnull(em_fec_ini.text) then
		messagebox("Advertencia","Fecha Inicial Inválida")
		em_fec_ini.setfocus()
	else
		if trim(em_fec_fin.text)='00/00/0000' or isnull(em_fec_fin.text) then
			messagebox("Advertencia","Fecha Término Inválida")
			em_fec_fin.setfocus()
		else
			if ld_fec_ini>ld_fec_fin then
				messagebox("Advertencia","Rango de Fecha Incorrecta")
				em_fec_ini.setfocus()
			else
				ll_cod_parque	= dw_parque.getitemnumber(1,'cod_parque')
				if ll_cod_parque>0 then
					ll_tot_reg	= dw_print_ficha.retrieve(ld_fec_ini,ld_fec_fin,ll_cod_parque,gs_user,ldt_fecha_hoy)
					if ll_tot_reg=0 then
						messagebox("Advertencia","No Registra Dato Vencimiento entrega Lápida")
					else
						SetPointer(HourGlass!)
						for ll_indi=1 to ll_tot_reg
							ls_sector		= dw_print_ficha.getitemstring(ll_indi,'ficha_grabacion_lapida_sector')
							ls_sepultura	= dw_print_ficha.getitemstring(ll_indi,'ficha_grabacion_lapida_sepultura')
							ldt_fecha_def	= dw_print_ficha.getitemdatetime(ll_indi,'ficha_grabacion_lapida_fecha_defuncion_l')
							ls_nom			= dw_print_ficha.getitemstring(ll_indi,'ficha_grabacion_lapida_nombre_fallecido')
							ls_ap_pat		= dw_print_ficha.getitemstring(ll_indi,'ficha_grabacion_lapida_apellido_paterno_')
							ls_ap_mat		= dw_print_ficha.getitemstring(ll_indi,'ficha_grabacion_lapida_apellido_materno_')
							SELECT	MAX("FALLECIDOS"."LLAVE")  
							INTO 		:ll_max_llave  
							FROM 		"FALLECIDOS"  
							WHERE  ( "FALLECIDOS"."SECTOR" = :ls_sector ) AND  
									 ( "FALLECIDOS"."N_SEP" = :ls_sepultura ) AND  
									 ( "FALLECIDOS"."COD_PARQUE" = :ll_cod_parque ) AND  
									 ( "FALLECIDOS"."NOMBRES" <> :ls_nom ) AND  
									 ( "FALLECIDOS"."AP_PATERNO" <> :ls_ap_pat ) AND  
									 ( "FALLECIDOS"."AP_MATERNO" <> :ls_ap_mat )   
							USING		sqlca;
							if ll_max_llave>0 then
								SELECT	"FALLECIDOS"."NOMBRES",	"FALLECIDOS"."AP_PATERNO",	"FALLECIDOS"."AP_MATERNO"  
								INTO 		:ls_nom_ult,				:ls_ap_pat_ult,				:ls_ap_mat_ult  
								FROM 		"FALLECIDOS"  
								WHERE 	"FALLECIDOS"."LLAVE" = :ll_max_llave   
								USING		sqlca;
								if sqlca.sqlcode=0 then
									ls_nom_comp_ult	= ls_nom_ult+' '+ls_ap_pat_ult+' '+ls_ap_mat_ult
									dw_print_ficha.setitem(ll_indi,'ultimo_fall',ls_nom_comp_ult)
								end if
							end if
						next
						SetPointer(Arrow!)
						dw_print_ficha.object.t_nro5.visible				= false
						dw_print_ficha.object.t_falta5.visible				= false
						dw_print_ficha.object.t_nro4.visible				= false
						dw_print_ficha.object.t_falta4.visible				= false
						dw_print_ficha.object.t_nro3.visible				= false
						dw_print_ficha.object.t_falta3.visible				= false
						dw_print_ficha.object.t_nro2.visible				= false
						dw_print_ficha.object.t_falta2.visible				= false
						dw_print_ficha.object.t_nro1.visible				= false
						dw_print_ficha.object.t_falta1.visible				= false
						dw_print_ficha.object.t_nro_venc.visible			= false
						dw_print_ficha.object.t_falta_venc.visible		= false
						dw_print_ficha.object.t_mostrar_todo.visible		= false
						f_Print( dw_print_ficha )
						dw_print_ficha.object.t_nro5.visible				= true
						dw_print_ficha.object.t_falta5.visible				= true
						dw_print_ficha.object.t_nro4.visible				= true
						dw_print_ficha.object.t_falta4.visible				= true
						dw_print_ficha.object.t_nro3.visible				= true
						dw_print_ficha.object.t_falta3.visible				= true
						dw_print_ficha.object.t_nro2.visible				= true
						dw_print_ficha.object.t_falta2.visible				= true
						dw_print_ficha.object.t_nro1.visible				= true
						dw_print_ficha.object.t_falta1.visible				= true
						dw_print_ficha.object.t_nro_venc.visible			= true
						dw_print_ficha.object.t_falta_venc.visible		= true
						dw_print_ficha.object.t_mostrar_todo.visible		= true
					end if
				else
					messagebox("Advertencia","Debe Seleccionar Parque")
					dw_parque.setfocus()
				end if
			end if
		end if
	end if
end if
end event

