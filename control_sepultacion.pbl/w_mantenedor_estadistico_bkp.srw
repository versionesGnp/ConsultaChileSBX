//					messagebox("Advertencia","Debe Ingresar FUNERARIA en Fila Nº "+string(il_row,'###,###,###,###,##0'))
//					dw_lista.setitem(il_row,'c_estatus',1)
				elseif isnull(ls_nom_fall) or ls_nom_fall='-' or ls_nom_fall='' then
					messagebox("Advertencia","Debe Ingresar NOMBRE FALLECIDO en Fila Nº "+string(il_row,'###,###,###,###,##0'))
					dw_lista.setitem(il_row,'c_estatus',1)
				elseif isnull(ls_ap_pat_fall) or ls_ap_pat_fall='-' or ls_ap_pat_fall='' then
					messagebox("Advertencia","Debe Ingresar APELLIDO PATERNO FALLECIDO en Fila Nº "+string(il_row,'###,###,###,###,##0'))
					dw_lista.setitem(il_row,'c_estatus',1)
				elseif isnull(ls_ap_mat_fall) or ls_ap_mat_fall='' then
					messagebox("Advertencia","Debe Ingresar APELLIDO MATERNO FALLECIDO en Fila Nº "+string(il_row,'###,###,###,###,##0'))
					dw_lista.setitem(il_row,'c_estatus',1)
				elseif isnull(ldt_fec_fac_fall) then
					messagebox("Advertencia","Debe Ingresar FECHA FALLECIMIENTO en Fila Nº "+string(il_row,'###,###,###,###,##0'))
					dw_lista.setitem(il_row,'c_estatus',1)
				elseif isnull(ll_rut_fall) or ll_rut_fall=0 then
