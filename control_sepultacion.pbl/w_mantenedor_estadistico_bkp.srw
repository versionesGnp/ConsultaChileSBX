event clicked;Long		ll_corr_mensual,ll_corr_anual
String	ls_tipo_traslado,ls_destino_parque,ls_tipo_ficha

//il_row							= dw_lista.getrow()
if il_row>0 and dw_lista.rowcount()>0 then
	ls_tipo_ficha							= dw_lista.getitemstring(il_row,'c_tipo_ficha')
	ls_tipo_traslado						= dw_lista.getitemstring(il_row,'c_tipo_traslado')
	ls_destino_parque						= dw_lista.getitemstring(il_row,'c_destino_parque')
	if ls_tipo_ficha = 'FS' or ls_tipo_ficha = 'FT' then
		gl_corr_mensual				= dw_lista.getitemnumber(il_row,'correlativo_mensual')
		gl_corr_anual					= dw_lista.getitemnumber(il_row,'correlativo_anual')
		
		if gl_corr_mensual>0 and gl_corr_anual>0 then
			if isvalid(w_ingresar_enfermedad_obligatoria) then close(w_ingresar_enfermedad_obligatoria)
			Open(w_ingresar_enfermedad_obligatoria)
		end if
	end if
end if
end event

