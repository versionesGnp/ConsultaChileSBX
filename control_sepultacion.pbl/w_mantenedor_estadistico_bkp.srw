event clicked;Long		ll_tot_reg,ll_cod_parque,ll_corr_int,ll_corr_mensual,ll_corr_anual,&
			ll_res,ll_grabar,ll_grabar_t
String	ls_base,ls_serie,ls_sector,ls_sepultura,ls_cod_est_ctto,ls_tipo_ficha,ls_estado_ctto,&
			ls_base_ori,ls_serie_ori,ls_estado_ctto_ori,ls_base_des,ls_serie_des,ls_estado_ctto_des
datetime	ldt_fecha_sepult,ldt_fecha_ctto_ori,ldt_fecha_ctto_des  
Double	ll_numero,ll_numero_ori,ll_numero_des
ll_tot_reg			= dw_lista.rowcount()
if ll_tot_reg > 0 then
	ll_res			= messagebox("Advertencia","Desea Actualizará Estado de Contrato en F.S. y F.T. que esten NULO o en Estado NO EXISTE (recuerde sólo a los que tengan Generado REGISTRO ESTADISTICO)",exclamation!,YesNo!,2)
	if ll_res=1 then
		ll_grabar	= 0
		ll_grabar_t	= 0
		DECLARE X1 CURSOR FOR  
		SELECT	"FICHA_SEPULTACION"."BASE",   
					"FICHA_SEPULTACION"."SERIE",   
					"FICHA_SEPULTACION"."NUMERO",   
					"FICHA_SEPULTACION"."COD_PARQUE",   
					"FICHA_SEPULTACION"."FECHA_SEPULTACION",   
					"FICHA_SEPULTACION"."SECTOR",   
					"FICHA_SEPULTACION"."SEPULTURA",   
					"FICHA_SEPULTACION"."CORRELATIVO_INTERNO",   
					"FICHA_SEPULTACION"."CORRELATIVO_MENSUAL",   
					"FICHA_SEPULTACION"."CORRELATIVO_ANUAL",   
					"FICHA_SEPULTACION"."COD_ESTADO_CONTRATO",   
					'FS'  
		FROM		"FICHA_SEPULTACION"  
		WHERE  ( "FICHA_SEPULTACION"."COD_ESTADO_CONTRATO" is Null  OR  "FICHA_SEPULTACION"."COD_ESTADO_CONTRATO" = 'E' ) AND 
				 ( "FICHA_SEPULTACION"."CORRELATIVO_MENSUAL" > 0 ) AND
				 (	"FICHA_SEPULTACION"."CORRELATIVO_ANUAL" > 0 )   
				 
		UNION   
		
		SELECT	"FICHA_TRASLADO"."BASE_ORIGEN",   
					"FICHA_TRASLADO"."SERIE_ORIGEN",   
					"FICHA_TRASLADO"."NUMERO_ORIGEN",  
					"FICHA_TRASLADO"."COD_PARQUE",   
					"FICHA_TRASLADO"."FECHA_TRASLADO",   
					"FICHA_TRASLADO"."SECTOR_ORIGEN",   
					"FICHA_TRASLADO"."SEPULTURA_ORIGEN",   
					"FICHA_TRASLADO"."FOLIO",   
					"FICHA_TRASLADO"."CORRELATIVO_MENSUAL",   
					"FICHA_TRASLADO"."CORRELATIVO_ANUAL",   
					"FICHA_TRASLADO"."ESTADO_CONTRATO_ORIGEN",   
					'FT'  
		FROM		"FICHA_TRASLADO"  
		WHERE  ( "FICHA_TRASLADO"."COD_ESTADO_CONTRATO_ORIGEN" is Null  OR  
					"FICHA_TRASLADO"."COD_ESTADO_CONTRATO_ORIGEN" = 'E'  OR 
					"FICHA_TRASLADO"."COD_ESTADO_CONTRATO_DESTINO" is Null  OR  
					"FICHA_TRASLADO"."COD_ESTADO_CONTRATO_DESTINO" = 'E' ) AND
				 ( "FICHA_TRASLADO"."CORRELATIVO_MENSUAL" > 0 ) AND 
				 ( "FICHA_TRASLADO"."CORRELATIVO_ANUAL" > 0 )
		USING		SQLCA;
		if sqlca.sqlcode=0 then
			open x1;
			DO WHILE sqlca.sqlcode=0
				fetch x1 into :ls_base, :ls_serie, :ll_numero, :ll_cod_parque, :ldt_fecha_sepult, :ls_sector, :ls_sepultura, :ll_corr_int, :ll_corr_mensual, :ll_corr_anual, :ls_cod_est_ctto, :ls_tipo_ficha;
				if ll_numero > 0 and not isnull(ll_numero) then
					if ls_tipo_ficha='FS' then
						SELECT	"CADENA"."ESTADO"  
						INTO		:ls_estado_ctto  
						FROM		"CADENA"  
						WHERE  ( "CADENA"."CODIGO" = :ls_base ) AND  
								 ( "CADENA"."SERIE" = :ls_serie ) AND  
								 ( "CADENA"."NUMERO" = :ll_numero )   
						USING		Trans_1;
						if Trans_1.sqlcode=0 then
							UPDATE	"FICHA_SEPULTACION"  
							SET 		"COD_ESTADO_CONTRATO" = :ls_cod_est_ctto  
							WHERE  ( "FICHA_SEPULTACION"."CORRELATIVO_MENSUAL" = :ll_corr_mensual ) AND  
									 ( "FICHA_SEPULTACION"."CORRELATIVO_ANUAL" = :ll_corr_anual )   
							USING		Trans_1;
							if Trans_1.sqlcode=0 then
								commit using Trans_1;
								ll_grabar ++
							else
								rollback using Trans_1;
							end if
						end if
	
					elseif ls_tipo_ficha='FT' then
						SELECT	"FICHA_TRASLADO"."BASE_ORIGEN",	"FICHA_TRASLADO"."SERIE_ORIGEN",	"FICHA_TRASLADO"."NUMERO_ORIGEN",	"FICHA_TRASLADO"."COD_ESTADO_CONTRATO_ORIGEN",	"FICHA_TRASLADO"."FECHA_CONTRATO_ORIGEN",	"FICHA_TRASLADO"."BASE_DESTINO",	"FICHA_TRASLADO"."SERIE_DESTINO",	"FICHA_TRASLADO"."NUMERO_DESTINO",	"FICHA_TRASLADO"."COD_ESTADO_CONTRATO_DESTINO",	"FICHA_TRASLADO"."FECHA_CONTRATO_DESTINO"  
						INTO 		:ls_base_ori,							:ls_serie_ori,							:ll_numero_ori,							:ls_estado_ctto_ori,										:ldt_fecha_ctto_ori,								:ls_base_des,							:ls_serie_des,								:ll_numero_des,							:ls_estado_ctto_des,										:ldt_fecha_ctto_des  
						FROM 		"FICHA_TRASLADO"  
						WHERE  ( "FICHA_TRASLADO"."CORRELATIVO_MENSUAL" = :ll_corr_mensual ) AND  
								 ( "FICHA_TRASLADO"."CORRELATIVO_ANUAL" = :ll_corr_anual )   
						USING		Trans_1;
						if not isnull(ls_base_ori) and not isnull(ls_serie_ori) and ll_numero_ori > 0 and (ls_estado_ctto_ori='' or isnull(ls_estado_ctto_ori)) then
							SELECT	"CADENA"."ESTADO"  
							INTO 		:ls_estado_ctto  
							FROM 		"CADENA"  
							WHERE  ( "CADENA"."CODIGO" = :ls_base_ori ) AND  
									 ( "CADENA"."SERIE" = :ls_serie_ori ) AND  
									 ( "CADENA"."NUMERO" = :ll_numero_ori )   
							USING		Trans_1;
							if Trans_1.sqlcode=0 and not isnull(ls_estado_ctto) then
								UPDATE	"FICHA_TRASLADO"  
								SET 	 	"COD_ESTADO_CONTRATO_ORIGEN" = :ls_estado_ctto
								WHERE  ( "FICHA_TRASLADO"."CORRELATIVO_MENSUAL" = :ll_corr_mensual ) AND  
										 ( "FICHA_TRASLADO"."CORRELATIVO_ANUAL" = :ll_corr_anual )   
								USING		Trans_1;
								if Trans_1.sqlcode=0 then
									commit using Trans_1;
									ll_grabar_t ++
								else
									rollback using Trans_1;
								end if
							end if
						end if
	
						if not isnull(ls_base_des) and not isnull(ls_serie_des) and ll_numero_des > 0 and (ls_estado_ctto_des='' or isnull(ls_estado_ctto_des)) then
							SELECT	"CADENA"."ESTADO"  
							INTO 		:ls_estado_ctto  
							FROM 		"CADENA"  
							WHERE  ( "CADENA"."CODIGO" = :ls_base_des ) AND  
									 ( "CADENA"."SERIE" = :ls_serie_des ) AND  
									 ( "CADENA"."NUMERO" = :ll_numero_des )   
							USING		Trans_1;
							if Trans_1.sqlcode=0 and not isnull(ls_estado_ctto) then
								UPDATE	"FICHA_TRASLADO"  
								SET 	 	"COD_ESTADO_CONTRATO_DESTINO" = :ls_estado_ctto
								WHERE  ( "FICHA_TRASLADO"."CORRELATIVO_MENSUAL" = :ll_corr_mensual ) AND  
										 ( "FICHA_TRASLADO"."CORRELATIVO_ANUAL" = :ll_corr_anual )   
								USING		Trans_1;
								if Trans_1.sqlcode=0 then
									commit using Trans_1;
									ll_grabar_t ++
								else
									rollback using Trans_1;
								end if
							end if
						end if
					end if
				end if
				Setnull(ll_numero)
			LOOP
			close x1;
			if ll_grabar > 0 and ll_grabar_t > 0 then
				messagebox("Actualización","Se Actualizó "+string(ll_grabar,'###,###,###,###,##0')+" F.S. y "+string(ll_grabar_t,'###,###,###,###,##0')+ " F.T.")
			elseif ll_grabar > 0 and ll_grabar_t = 0 then
				messagebox("Actualización","Se Actualizó "+string(ll_grabar,'###,###,###,###,##0'))
			elseif ll_grabar = 0 and ll_grabar_t > 0 then
				messagebox("Actualización","Se Actualizó "+string(ll_grabar_t,'###,###,###,###,##0')+ " F.T.")
			elseif ll_grabar = 0 and ll_grabar_t = 0 then
				messagebox("Advertencia","No se Actualizó Ningún Estado Contrato")
			end if
		end if
	end if
end if
end event

