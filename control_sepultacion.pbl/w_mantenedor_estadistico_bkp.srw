end type

event ue_mousemove;st_registro.visible						= true
st_print_registro.visible				= false
st_ver_ficha.visible						= false
st_ver_carta.visible						= false
st_ver_lapida.visible					= false
st_ingresar_obligatoria.visible		= false
st_generar_libro.visible				= false
st_obituario.visible						= false
st_fallecido.visible						= false
st_print.visible							= false
st_print_proveedor.visible				= false
st_mantenedor.visible					= false
st_actualizar.visible					= false
st_generar_libro_exh_tras.visible	= false
st_generar_libro_red.visible			= false
st_generar_libro_voluntad.visible	= false
st_generar_libro_transito.visible	= false
end event

event clicked;long 		ll_fila,ll_tot_reg,ll_max_corr_mensual,ll_max_corr_anual,ll_indi,ll_estatus,ll_cod_parque,&
			ll_folio,ll_cod_funeraria,ll_edad_fall,ll_cod_parque_desde,ll_max_corr_interno,ll_numero,&
			ll_count_carta,ll_count_lapida,ll_cap,ll_rut_fall,ll_contar,ll_boleta,ll_parque,ll_anno_max,&
			ll_anno_hoy,ll_mes_max,ll_mes_hoy,ll_numero_des,ll_rut_tit_des,ll_boleta_des,ll_cap_des,&
			ll_cod_parque_des,ll_reg_anual,ll_reg_mensual,ll_llave,ll_max_corr_mensual_mae,ll_max_corr_anual_mae,&
			ll_max_corr_mensual_exh,ll_max_corr_anual_exh,ll_max_corr_mensual_red,ll_max_corr_anual_red,&
			ll_edad,ll_n_l,ll_n_m,ll_rut,ll_mes_ant,ll_anno_ant
String	ls_estado_reg,ls_sector,ls_sepultura,ls_tipo_ficha,ls_causa_fall,ls_estado_cuerpo,&
			ls_sexo_fall,ls_pase_sepult,ls_cod_reg_pase,ls_inscrip_pase,ls_registro_pase,ls_tipo_traslado,&
			ls_base,ls_serie,ls_nom_fall,ls_ap_pat_fall,ls_ap_mat_fall,ls_nro_tecnico,ls_nivel,&
			ls_dv_fall,ls_vb,ls_pasa1,ls_destino_parque,ls_base_des,ls_serie_des,ls_sector_des,&
			ls_sepult_des,ls_nivel_des,ls_dv_tit_des,ls_nro_tec_des,ls_tipo_traslado_def,ls_dv,ls_sexo,ls_periodo,&
			ls_n_sep,ls_nombre,ls_ap_pat,ls_ap_mat,ls_est,ls_op,ls_pase,ls_reg_civil,ls_enf_obl,ls_rg_est,&
			ls_funeraria,ls_boleta,ls_carta_aut,ls_reg_est,ls_n_tec,ls_vta,ls_obs,ls_est_ctto,ls_resol_tras,&
			ls_otorgado,ls_cementerio_ori,ls_mes_ant,ls_anno_ant,ls_string_ant,ls_pasa_nulo='N'
Datetime	ldt_fecha_sep,ldt_fec_nac_fall,ldt_fecha_pase,ldt_fec_defuncion,ldt_fecha_crea_max,ldt_fec_nac,&
			ldt_fec_fall,ldt_fec_sep
Date		ldt_fec_max

dw_parque.accepttext()
ls_pasa1							= 'N'
ll_tot_reg						= dw_lista.rowcount()
if ll_tot_reg>0 then
	ll_fila						= dw_lista.Find("c_estatus = 0", 1, ll_tot_reg)
	if ll_fila > 0 then
		SELECT	sysdate	INTO :gdt_fec_sistema	FROM "TASA"	WHERE "TASA"."LOOK" = 1   ;
		ll_parque				= dw_parque.getitemnumber(1,'cod_parque')
		ll_contar				= 0
		for ll_indi=ll_fila to ll_tot_reg
			ll_estatus			= dw_lista.getitemnumber(ll_indi,'c_estatus')
			ls_estado_reg		= dw_lista.getitemstring(ll_indi,'estado_reg')
			if ls_estado_reg='P' and ll_estatus=0 then
				ll_cod_parque	= dw_lista.getitemnumber(ll_indi,'cod_parque')
				ls_sector		= dw_lista.getitemstring(ll_indi,'sector')
				ls_sepultura	= dw_lista.getitemstring(ll_indi,'sepultura')
				ldt_fecha_sep	= dw_lista.getitemdatetime(ll_indi,'fecha_sepultacion')
				ll_folio			= dw_lista.getitemnumber(ll_indi,'correlativo_interno')
				ls_tipo_ficha	= dw_lista.getitemstring(ll_indi,'c_tipo_ficha')
				ls_base			= dw_lista.getitemstring(ll_indi,'base')
				ls_serie			= dw_lista.getitemstring(ll_indi,'serie')
				ll_numero		= dw_lista.getitemnumber(ll_indi,'numero')
				ls_nom_fall		= dw_lista.getitemstring(ll_indi,'nombre_fallecido')
				ls_ap_pat_fall	= dw_lista.getitemstring(ll_indi,'ap_paterno_fall')
				ls_ap_mat_fall	= dw_lista.getitemstring(ll_indi,'ap_materno_fall')
				ls_nro_tecnico	= dw_lista.getitemstring(ll_indi,'numero_tecnico')
				ll_cap			= dw_lista.getitemnumber(ll_indi,'capacidad')
				ls_nivel			= dw_lista.getitemstring(ll_indi,'nivel')
				ll_rut_fall		= dw_lista.getitemnumber(ll_indi,'rut_fallecido')
				ls_dv_fall		= dw_lista.getitemstring(ll_indi,'dv_fallecido')
				if not isnull(ls_nom_fall) and ls_nom_fall<>'' and ls_nom_fall<>'-' and &
					not isnull(ls_ap_pat_fall) and ls_ap_pat_fall<>'' and ls_ap_pat_fall<>'-' and &
					not isnull(ls_ap_mat_fall) and ls_ap_mat_fall<>'' and ls_ap_mat_fall<>'-' and &
					not isnull(ldt_fecha_sep) then
					if ls_tipo_ficha = 'FS' then
						SELECT	MAX("FICHA_SEPULTACION"."FECHA_SEPULTACION")  
						INTO 		:ldt_fec_max  
						FROM 		"FICHA_SEPULTACION"  
						USING		sqlca;
						
					elseif ls_tipo_ficha = 'FT' then
						SELECT	MAX("FICHA_TRASLADO"."FECHA_TRASLADO")  
						INTO 		:ldt_fec_max  
						FROM 		"FICHA_TRASLADO"  
						USING		sqlca;

					elseif ls_tipo_ficha = 'FR' then
						SELECT	MAX("FICHA_REDUCCION"."FECHA_SEPULTACION")  
						INTO 		:ldt_fec_max  
						FROM 		"FICHA_REDUCCION"  
						USING		sqlca;

					elseif ls_tipo_ficha = 'CT' then
						SELECT	MAX("FICHA_REDUCCION"."FECHA_SEPULTACION")  
						INTO 		:ldt_fec_max  
						FROM		"FICHA_REDUCCION" 
						USING		sqlca;
					end if
					if isnull(ldt_fec_max) then
						ldt_fec_max					= date(gdt_fec_sistema)
					end if					
					
					ls_tipo_traslado	= dw_lista.getitemstring(ll_indi,'c_tipo_traslado')
					ls_destino_parque	= dw_lista.getitemstring(ll_indi,'c_destino_parque')
					ll_anno_hoy			= year(date(ldt_fec_max))
					ll_anno_ant			= ll_anno_hoy
					ll_mes_hoy			= month(date(ldt_fec_max))
					ll_mes_ant			= ll_mes_hoy
					if ((ls_tipo_ficha = 'FS') OR (ls_tipo_ficha = 'FT' AND ls_tipo_traslado = 'E' AND ls_destino_parque = 'E')) then
					//		Correlativo Maestro		
						SELECT 	Max("FICHA_REGISTRO"."CORRELATIVO_MENSUAL"),	Max("FICHA_REGISTRO"."FECHA_SEPULTACION")
						INTO 		:ll_max_corr_mensual,								:ldt_fecha_crea_max
						FROM 		"FICHA_REGISTRO"
						WHERE		"FICHA_REGISTRO"."COD_PARQUE" = :ll_parque AND
									substr(TO_CHAR("FICHA_REGISTRO"."FECHA_SEPULTACION",'dd/mm/yyyy'),4,7) = substr(to_char(sysdate,'dd/mm/yyyy'),4,7) AND
									(("FICHA_REGISTRO"."TIPO_FICHA" = 'FS') OR ("FICHA_REGISTRO"."TIPO_FICHA" = 'FT' AND "FICHA_REGISTRO"."TIPO_OPERACION_TRASLADO" = 'IN' AND "FICHA_REGISTRO"."DESTINO_PARQUE" = 'E'))
						USING		sqlca;
						if isnull(ll_max_corr_mensual) or ll_max_corr_mensual=0 then
							ls_pasa_nulo	= 'S'
							ll_mes_ant		= ll_mes_hoy - 1
							if ll_mes_ant = 0 then
								ll_mes_ant	= 12
								ll_anno_ant	= ll_anno_hoy - 1
							else
								ll_anno_ant	= ll_anno_hoy
							end if
							ls_mes_ant		= string(ll_mes_ant,'00')
							ls_anno_ant		= string(ll_anno_ant,'0000')
							ls_string_ant	= ls_mes_ant+'/'+ls_anno_ant
							if ll_mes_hoy <> ll_mes_ant then
								
							end if
							SELECT 	Max("FICHA_REGISTRO"."CORRELATIVO_MENSUAL"),	Max("FICHA_REGISTRO"."FECHA_SEPULTACION")
							INTO 		:ll_max_corr_mensual,								:ldt_fecha_crea_max
							FROM 		"FICHA_REGISTRO"
							WHERE		"FICHA_REGISTRO"."COD_PARQUE" = :ll_parque AND
										substr(TO_CHAR("FICHA_REGISTRO"."FECHA_SEPULTACION",'dd/mm/yyyy'),4,7) = :ls_string_ant AND
										(("FICHA_REGISTRO"."TIPO_FICHA" = 'FS') OR ("FICHA_REGISTRO"."TIPO_FICHA" = 'FT' AND "FICHA_REGISTRO"."TIPO_OPERACION_TRASLADO" = 'IN' AND "FICHA_REGISTRO"."DESTINO_PARQUE" = 'E'))
							USING		sqlca;
						end if
						
						SELECT 	Max("FICHA_REGISTRO"."CORRELATIVO_ANUAL")
						INTO 		:ll_max_corr_anual
						FROM 		"FICHA_REGISTRO"
						WHERE		"FICHA_REGISTRO"."COD_PARQUE" = :ll_parque AND
									substr(TO_CHAR("FICHA_REGISTRO"."FECHA_SEPULTACION",'dd/mm/yyyy'),7,4) = substr(to_char(sysdate,'dd/mm/yyyy'),7,4) AND
									(("FICHA_REGISTRO"."TIPO_FICHA" = 'FS') OR ("FICHA_REGISTRO"."TIPO_FICHA" = 'FT' AND "FICHA_REGISTRO"."TIPO_OPERACION_TRASLADO" = 'IN' AND "FICHA_REGISTRO"."DESTINO_PARQUE" = 'E'))
						USING		sqlca;
						if isnull(ll_max_corr_anual) or ll_max_corr_anual=0 then
							SELECT 	Max("FICHA_REGISTRO"."CORRELATIVO_ANUAL")
							INTO 		:ll_max_corr_anual
							FROM 		"FICHA_REGISTRO"
							WHERE		"FICHA_REGISTRO"."COD_PARQUE" = :ll_parque AND
										substr(TO_CHAR("FICHA_REGISTRO"."FECHA_SEPULTACION",'dd/mm/yyyy'),7,4) = :ls_anno_ant AND
										(("FICHA_REGISTRO"."TIPO_FICHA" = 'FS') OR ("FICHA_REGISTRO"."TIPO_FICHA" = 'FT' AND "FICHA_REGISTRO"."TIPO_OPERACION_TRASLADO" = 'IN' AND "FICHA_REGISTRO"."DESTINO_PARQUE" = 'E'))
							USING		sqlca;
						end if
						ls_tipo_traslado_def	= 'IN'
						
					end if
					if ((ls_tipo_ficha = 'FT' AND ls_tipo_traslado = 'E' AND ls_destino_parque = 'S') OR (ls_tipo_ficha = 'FT' AND ls_tipo_traslado = 'I' )) then
					//		Correlativo Exhumacion y Traslado		
						SELECT 	Max("FICHA_REGISTRO"."CORRELATIVO_MENSUAL"),	Max("FICHA_REGISTRO"."FECHA_CREA")
						INTO 		:ll_max_corr_mensual,								:ldt_fecha_crea_max
						FROM 		"FICHA_REGISTRO"
						WHERE		"FICHA_REGISTRO"."COD_PARQUE" = :ll_parque AND
									substr(TO_CHAR("FICHA_REGISTRO"."FECHA_CREA",'dd/mm/yyyy'),4,7) = substr(to_char(sysdate,'dd/mm/yyyy'),4,7) AND
									(("FICHA_REGISTRO"."TIPO_FICHA" = 'FT' AND "FICHA_REGISTRO"."TIPO_OPERACION_TRASLADO" = 'EX' AND "FICHA_REGISTRO"."DESTINO_PARQUE" = 'S') OR ("FICHA_REGISTRO"."TIPO_FICHA" = 'FT' AND "FICHA_REGISTRO"."TIPO_OPERACION_TRASLADO" = 'TI' ))
						USING		sqlca;
						if isnull(ll_max_corr_mensual) or ll_max_corr_mensual=0 then
							ls_pasa_nulo	= 'S'
							ll_mes_ant		= ll_mes_hoy - 1
							if ll_mes_ant = 0 then
								ll_mes_ant	= 12
								ll_anno_ant	= ll_anno_hoy - 1
							else
								ll_anno_ant	= ll_anno_hoy
							end if
							ls_mes_ant		= string(ll_mes_ant,'00')
							ls_anno_ant		= string(ll_anno_ant,'0000')
							ls_string_ant	= ls_mes_ant+'/'+ls_anno_ant
							SELECT 	Max("FICHA_REGISTRO"."CORRELATIVO_MENSUAL"),	Max("FICHA_REGISTRO"."FECHA_SEPULTACION")
							INTO 		:ll_max_corr_mensual,								:ldt_fecha_crea_max
							FROM 		"FICHA_REGISTRO"
							WHERE		"FICHA_REGISTRO"."COD_PARQUE" = :ll_parque AND
										substr(TO_CHAR("FICHA_REGISTRO"."FECHA_SEPULTACION",'dd/mm/yyyy'),4,7) = :ls_string_ant AND
										(("FICHA_REGISTRO"."TIPO_FICHA" = 'FT' AND "FICHA_REGISTRO"."TIPO_OPERACION_TRASLADO" = 'EX' AND "FICHA_REGISTRO"."DESTINO_PARQUE" = 'S') OR ("FICHA_REGISTRO"."TIPO_FICHA" = 'FT' AND "FICHA_REGISTRO"."TIPO_OPERACION_TRASLADO" = 'TI' ))
							USING		sqlca;
						end if
						SELECT 	Max("FICHA_REGISTRO"."CORRELATIVO_ANUAL")
						INTO 		:ll_max_corr_anual
						FROM 		"FICHA_REGISTRO"
						WHERE		"FICHA_REGISTRO"."COD_PARQUE" = :ll_parque AND
									substr(TO_CHAR("FICHA_REGISTRO"."FECHA_CREA",'dd/mm/yyyy'),7,4) = substr(to_char(sysdate,'dd/mm/yyyy'),7,4) AND
									(("FICHA_REGISTRO"."TIPO_FICHA" = 'FT' AND "FICHA_REGISTRO"."TIPO_OPERACION_TRASLADO" = 'EX' AND "FICHA_REGISTRO"."DESTINO_PARQUE" = 'S') OR ("FICHA_REGISTRO"."TIPO_FICHA" = 'FT' AND "FICHA_REGISTRO"."TIPO_OPERACION_TRASLADO" = 'TI' ))
						USING		sqlca;
						if isnull(ll_max_corr_anual) or ll_max_corr_anual=0 then
							SELECT 	Max("FICHA_REGISTRO"."CORRELATIVO_ANUAL")
							INTO 		:ll_max_corr_anual
							FROM 		"FICHA_REGISTRO"
							WHERE		"FICHA_REGISTRO"."COD_PARQUE" = :ll_parque AND
										substr(TO_CHAR("FICHA_REGISTRO"."FECHA_SEPULTACION",'dd/mm/yyyy'),7,4) = :ls_anno_ant AND
										(("FICHA_REGISTRO"."TIPO_FICHA" = 'FT' AND "FICHA_REGISTRO"."TIPO_OPERACION_TRASLADO" = 'EX' AND "FICHA_REGISTRO"."DESTINO_PARQUE" = 'S') OR ("FICHA_REGISTRO"."TIPO_FICHA" = 'FT' AND "FICHA_REGISTRO"."TIPO_OPERACION_TRASLADO" = 'TI' ))
							USING		sqlca;
						end if
						if ls_tipo_ficha = 'FT' AND ls_tipo_traslado = 'I' then
							ls_tipo_traslado_def	= 'TI'
						else
							ls_tipo_traslado_def	= 'EX'
						end if
					end if
					if ls_tipo_ficha = 'FR' then
				//		Correlativo Reducción
						SELECT 	Max("FICHA_REGISTRO"."CORRELATIVO_MENSUAL"),	Max("FICHA_REGISTRO"."FECHA_CREA")
						INTO 		:ll_max_corr_mensual,								:ldt_fecha_crea_max
						FROM 		"FICHA_REGISTRO"
						WHERE		"FICHA_REGISTRO"."COD_PARQUE" = :ll_parque AND
									substr(TO_CHAR("FICHA_REGISTRO"."FECHA_CREA",'dd/mm/yyyy'),4,7) = substr(to_char(sysdate,'dd/mm/yyyy'),4,7) AND
									"FICHA_REGISTRO"."TIPO_FICHA" = 'FR'
						USING		sqlca;
						if isnull(ll_max_corr_mensual) or ll_max_corr_mensual=0 then
							ls_pasa_nulo	= 'S'
							ll_mes_ant		= ll_mes_hoy - 1
							if ll_mes_ant = 0 then
								ll_mes_ant	= 12
								ll_anno_ant	= ll_anno_hoy - 1
							else
								ll_anno_ant	= ll_anno_hoy
							end if
							ls_mes_ant		= string(ll_mes_ant,'00')
							ls_anno_ant		= string(ll_anno_ant,'0000')
							ls_string_ant	= ls_mes_ant+'/'+ls_anno_ant
							SELECT 	Max("FICHA_REGISTRO"."CORRELATIVO_MENSUAL"),	Max("FICHA_REGISTRO"."FECHA_SEPULTACION")
							INTO 		:ll_max_corr_mensual,								:ldt_fecha_crea_max
							FROM 		"FICHA_REGISTRO"
							WHERE		"FICHA_REGISTRO"."COD_PARQUE" = :ll_parque AND
										substr(TO_CHAR("FICHA_REGISTRO"."FECHA_SEPULTACION",'dd/mm/yyyy'),4,7) = :ls_string_ant AND
										"FICHA_REGISTRO"."TIPO_FICHA" = 'FR'
							USING		sqlca;
						end if
						
						SELECT 	Max("FICHA_REGISTRO"."CORRELATIVO_ANUAL")
						INTO 		:ll_max_corr_anual
						FROM 		"FICHA_REGISTRO"
						WHERE		"FICHA_REGISTRO"."COD_PARQUE" = :ll_parque AND
									substr(TO_CHAR("FICHA_REGISTRO"."FECHA_CREA",'dd/mm/yyyy'),7,4) = substr(to_char(sysdate,'dd/mm/yyyy'),7,4) AND
									"FICHA_REGISTRO"."TIPO_FICHA" = 'FR'
						USING		sqlca;
						if isnull(ll_max_corr_anual) or ll_max_corr_anual=0 then
							SELECT 	Max("FICHA_REGISTRO"."CORRELATIVO_ANUAL")
							INTO 		:ll_max_corr_anual
							FROM 		"FICHA_REGISTRO"
							WHERE		"FICHA_REGISTRO"."COD_PARQUE" = :ll_parque AND
										substr(TO_CHAR("FICHA_REGISTRO"."FECHA_SEPULTACION",'dd/mm/yyyy'),7,4) = :ls_anno_ant AND
										"FICHA_REGISTRO"."TIPO_FICHA" = 'FR'
							USING		sqlca;
						end if
						ls_tipo_traslado_def	= 'RE'
					end if
					if ls_tipo_ficha = 'CT' then
				//		Correlativo Reducción
						SELECT 	Max("FICHA_REGISTRO"."CORRELATIVO_MENSUAL"),	Max("FICHA_REGISTRO"."FECHA_CREA")
						INTO 		:ll_max_corr_mensual,								:ldt_fecha_crea_max
						FROM 		"FICHA_REGISTRO"
						WHERE		"FICHA_REGISTRO"."COD_PARQUE" = :ll_parque AND
									substr(TO_CHAR("FICHA_REGISTRO"."FECHA_CREA",'dd/mm/yyyy'),4,7) = substr(to_char(sysdate,'dd/mm/yyyy'),4,7) AND
									"FICHA_REGISTRO"."TIPO_FICHA" = 'CT'
						USING		sqlca;
						if isnull(ll_max_corr_mensual) or ll_max_corr_mensual=0 then
							ls_pasa_nulo	= 'S'
							ll_mes_ant		= ll_mes_hoy - 1
							if ll_mes_ant = 0 then
								ll_mes_ant	= 12
								ll_anno_ant	= ll_anno_hoy - 1
							else
								ll_anno_ant	= ll_anno_hoy
							end if
							ls_mes_ant		= string(ll_mes_ant,'00')
							ls_anno_ant		= string(ll_anno_ant,'0000')
							ls_string_ant	= ls_mes_ant+'/'+ls_anno_ant
							SELECT 	Max("FICHA_REGISTRO"."CORRELATIVO_MENSUAL"),	Max("FICHA_REGISTRO"."FECHA_SEPULTACION")
							INTO 		:ll_max_corr_mensual,								:ldt_fecha_crea_max
							FROM 		"FICHA_REGISTRO"
							WHERE		"FICHA_REGISTRO"."COD_PARQUE" = :ll_parque AND
										substr(TO_CHAR("FICHA_REGISTRO"."FECHA_SEPULTACION",'dd/mm/yyyy'),4,7) = :ls_string_ant AND
										"FICHA_REGISTRO"."TIPO_FICHA" = 'CT'
							USING		sqlca;
						end if
						SELECT 	Max("FICHA_REGISTRO"."CORRELATIVO_ANUAL")
						INTO 		:ll_max_corr_anual
						FROM 		"FICHA_REGISTRO"
						WHERE		"FICHA_REGISTRO"."COD_PARQUE" = :ll_parque AND
									substr(TO_CHAR("FICHA_REGISTRO"."FECHA_CREA",'dd/mm/yyyy'),7,4) = substr(to_char(sysdate,'dd/mm/yyyy'),7,4) AND
									"FICHA_REGISTRO"."TIPO_FICHA" = 'CT'
						USING		sqlca;
						if isnull(ll_max_corr_anual) or ll_max_corr_anual=0 then
							SELECT 	Max("FICHA_REGISTRO"."CORRELATIVO_ANUAL")
							INTO 		:ll_max_corr_anual
							FROM 		"FICHA_REGISTRO"
							WHERE		"FICHA_REGISTRO"."COD_PARQUE" = :ll_parque AND
										substr(TO_CHAR("FICHA_REGISTRO"."FECHA_SEPULTACION",'dd/mm/yyyy'),7,4) = :ls_anno_ant AND
										"FICHA_REGISTRO"."TIPO_FICHA" = 'CT'
							USING		sqlca;
						end if
						ls_tipo_traslado_def	= 'CT'
					end if
			//		Correlativo Interno
					SELECT 	Max("FICHA_REGISTRO"."CORRELATIVO_INTERNO")
					INTO 		:ll_max_corr_interno
					FROM 		"FICHA_REGISTRO"
					WHERE		"FICHA_REGISTRO"."COD_PARQUE" = :ll_parque 
					USING		sqlca;
					
					ll_anno_max					= year(date(ldt_fecha_crea_max))
					ll_mes_max					= month(date(ldt_fecha_crea_max))
					
					if ls_pasa_nulo='S' and ll_mes_hoy <> ll_mes_ant then
						ll_max_corr_mensual = 0
					end if
					if (isnull(ll_max_corr_mensual) or ll_max_corr_mensual=0 or ll_mes_max = ll_mes_hoy or ll_mes_hoy <> ll_mes_ant) and ll_max_corr_mensual = 0 then 
						ll_max_corr_mensual	= 1
					else
						ll_max_corr_mensual ++
					end if
					if ls_pasa_nulo='S' and ll_anno_hoy <> ll_anno_ant then
						ll_max_corr_anual		= 0
					end if
					if (isnull(ll_max_corr_anual) or ll_max_corr_anual=0 or ll_anno_max = ll_anno_hoy or ll_anno_hoy <> ll_anno_ant) and ll_max_corr_anual = 0 then 
						ll_max_corr_anual		= 1
					else
						ll_max_corr_anual ++
					end if
					if isnull(ll_max_corr_interno) or ll_max_corr_interno=0 then 
						ll_max_corr_interno	= 1
					else
						ll_max_corr_interno ++
					end if
					if ls_tipo_ficha='FT' then
						SELECT	"FICHA_TRASLADO"."CODIGO_FUNERARIA",	"FICHA_TRASLADO"."OBSERVACION_FALLECIDO",	"FICHA_TRASLADO"."COD_ESTADO_FALLECIDO",	"FICHA_TRASLADO"."EDAD_FALLECIDO",	"FICHA_TRASLADO"."SEXO_FALLECIDO",	"FICHA_TRASLADO"."FECHA_NACIMIENTO_FALLECIDO",	"FICHA_TRASLADO"."PASE_SEPULTACION",	"FICHA_TRASLADO"."COD_REGISTRO_PASE",	"FICHA_TRASLADO"."INSCRIPCION_PASE",	"FICHA_TRASLADO"."REGISTRO_PASE",	"FICHA_TRASLADO"."FECHA_PASE",	"FICHA_TRASLADO"."TIPO_TRASLADO",	"FICHA_TRASLADO"."BOLETA_NRO_ORIGEN",	"FICHA_TRASLADO"."DESTINO_PARQUE",	"FICHA_TRASLADO"."BASE_DESTINO",	"FICHA_TRASLADO"."SERIE_DESTINO",	"FICHA_TRASLADO"."NUMERO_DESTINO",	"FICHA_TRASLADO"."SECTOR_DESTINO",	"FICHA_TRASLADO"."SEPULTURA_DESTINO",	"FICHA_TRASLADO"."NUMERO_TECNICO_DESTINO",	"FICHA_TRASLADO"."NIVEL_SEPULTURA_DESTINO",	"FICHA_TRASLADO"."RUT_TITULAR_DESTINO",	"FICHA_TRASLADO"."DV_TITULAR_DESTINO",	"FICHA_TRASLADO"."BOLETA_NRO_DESTINO",	"FICHA_TRASLADO"."CAPACIDAD_DESTINO",	"FICHA_TRASLADO"."COD_PARQUE_DESTINO",	"FICHA_TRASLADO"."FECHA_DEFUNCION"
						INTO 		:ll_cod_funeraria,							:ls_causa_fall,									:ls_estado_cuerpo,								:ll_edad_fall,								:ls_sexo_fall,								:ldt_fec_nac_fall,										:ls_pase_sepult,								:ls_cod_reg_pase,								:ls_inscrip_pase,								:ls_registro_pase,						:ldt_fecha_pase,						:ls_tipo_traslado,						:ll_boleta,										:ls_destino_parque,						:ls_base_des,							:ls_serie_des,								:ll_numero_des,							:ls_sector_des,							:ls_sepult_des,								:ls_nro_tec_des,										:ls_nivel_des,											:ll_rut_tit_des,									:ls_dv_tit_des,								:ll_boleta_des,								:ll_cap_des,									:ll_cod_parque_des,							:ldt_fec_defuncion
						FROM 		"FICHA_TRASLADO"  
						WHERE  ( "FICHA_TRASLADO"."COD_PARQUE" = :ll_cod_parque ) AND  
								 ( "FICHA_TRASLADO"."FECHA_TRASLADO" = :ldt_fecha_sep ) AND  
								 ( "FICHA_TRASLADO"."SECTOR_ORIGEN" = :ls_sector ) AND  
								 ( "FICHA_TRASLADO"."SEPULTURA_ORIGEN" = :ls_sepultura ) AND  
								 ( "FICHA_TRASLADO"."FOLIO" = :ll_folio )   
						USING		sqlca;
						if sqlca.sqlcode=0 then
							if (ls_tipo_traslado='I') or (ls_tipo_traslado='E' and ls_destino_parque='E') then
								ll_cod_parque		= ll_cod_parque_des
								ls_sector			= ls_sector_des
								ls_sepultura		= ls_sepult_des
								ls_base				= ls_base_des
								ls_serie				= ls_serie_des
								ll_numero			= ll_numero_des
								ls_nro_tecnico		= ls_nro_tec_des
								ll_cap				= ll_cap_des
								ls_nivel				= ls_nivel_des
								ll_boleta			= ll_boleta_des
							end if
							if isnull(ll_cod_funeraria) then
								messagebox("Advertencia","En Fila Nº "+string(ll_indi)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar FUNERARIA" )
							elseif isnull(ls_causa_fall) or ls_causa_fall='-' then
								messagebox("Advertencia","En Fila Nº "+string(ll_indi)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar CAUSA FALLECIMIENTO" )
							elseif isnull(ls_estado_cuerpo) or ls_estado_cuerpo='-' then
								messagebox("Advertencia","En Fila Nº "+string(ll_indi)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar ESTADO CUERPO" )
							elseif isnull(ll_edad_fall) or ll_edad_fall<0 then
								messagebox("Advertencia","En Fila Nº "+string(ll_indi)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar EDAD FALLECIDO" )
							elseif isnull(ls_sexo_fall) or ls_sexo_fall='-' then
								messagebox("Advertencia","En Fila Nº "+string(ll_indi)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar SEXO FALLECIDO" )
							elseif isnull(ldt_fec_nac_fall) then
								messagebox("Advertencia","En Fila Nº "+string(ll_indi)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar FECHA NACIMIENTO FALLECIDO" )
							elseif isnull(ls_cod_reg_pase) or ls_cod_reg_pase='-' then
								messagebox("Advertencia","En Fila Nº "+string(ll_indi)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar OTORGADO POR" )
							elseif (isnull(ls_registro_pase) or ls_registro_pase='-') and ls_tipo_traslado='E' then
								messagebox("Advertencia","En Fila Nº "+string(ll_indi)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar NUMERO RESOLUCION" )
							elseif isnull(ldt_fecha_pase) and ls_tipo_traslado='E' then
								messagebox("Advertencia","En Fila Nº "+string(ll_indi)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar FECHA PASE SEPULTACION" )
							else
								ls_pasa1	= 'S'
							end if
						end if
		
					elseif ls_tipo_ficha='FS' then
						SELECT	"FICHA_SEPULTACION"."CODIGO_FUNERARIA",	"FICHA_SEPULTACION"."FECHA_DEFUNCION",	"FICHA_SEPULTACION"."CAUSA_FALLECIMIENTO",	"FICHA_SEPULTACION"."PASE_SEPULTACION",	"FICHA_SEPULTACION"."EDAD_FALLECIDO",	"FICHA_SEPULTACION"."SEXO_FALLECIDO",	"FICHA_SEPULTACION"."COD_REGISTRO_PASE",	"FICHA_SEPULTACION"."INSCRIPCION_PASE",	"FICHA_SEPULTACION"."REGISTRO_PASE",	"FICHA_SEPULTACION"."FECHA_PASE",	"FICHA_SEPULTACION"."COD_ESTADO_FALL",	"FICHA_SEPULTACION"."COD_PARQUE_DESDE",	"FICHA_SEPULTACION"."FECHA_NACIMIENTO_FALL",	"FICHA_SEPULTACION"."FOLIO_COMPROBANTE"
						INTO 		:ll_cod_funeraria,								:ldt_fec_defuncion,							:ls_causa_fall,										:ls_pase_sepult,									:ll_edad_fall,									:ls_sexo_fall,									:ls_cod_reg_pase,									:ls_inscrip_pase,									:ls_registro_pase,							:ldt_fecha_pase,							:ls_estado_cuerpo,							:ll_cod_parque_desde,							:ldt_fec_nac_fall,									:ll_boleta
						FROM 		"FICHA_SEPULTACION"  
						WHERE  ( "FICHA_SEPULTACION"."FECHA_SEPULTACION" = :ldt_fecha_sep ) AND  
								 ( "FICHA_SEPULTACION"."SECTOR" = :ls_sector ) AND  
								 ( "FICHA_SEPULTACION"."SEPULTURA" = :ls_sepultura ) AND  
								 ( "FICHA_SEPULTACION"."CORRELATIVO_INTERNO" = :ll_folio ) 
						USING		sqlca;
						if sqlca.sqlcode=0 then
							ls_destino_parque	= 'X'
//							ls_tipo_traslado	= 'IN'
							if isnull(ll_cod_funeraria) or ll_cod_funeraria=0 then
								messagebox("Advertencia","En Fila Nº "+string(ll_indi)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar FUNERARIA")
							elseif isnull(ldt_fec_defuncion) then
								messagebox("Advertencia","En Fila Nº "+string(ll_indi)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar FECHA DEFUNCION")
							elseif isnull(ls_causa_fall) or ls_causa_fall='' or ls_causa_fall='-' then
								messagebox("Advertencia","En Fila Nº "+string(ll_indi)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar CAUSA FALLECIMIENTO" )
							elseif isnull(ls_pase_sepult) or ls_pase_sepult='' or ls_pase_sepult='-' then
								messagebox("Advertencia","En Fila Nº "+string(ll_indi)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar NUMERO PASE SEPULTACION" )
							elseif isnull(ll_edad_fall) or ll_edad_fall<0 then
								messagebox("Advertencia","En Fila Nº "+string(ll_indi)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar EDAD FALLECIDO" )
							elseif isnull(ls_sexo_fall) or ls_sexo_fall='' or ls_sexo_fall='-' then
								messagebox("Advertencia","En Fila Nº "+string(ll_indi)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar SEXO FALLECIDO" )
							elseif isnull(ls_cod_reg_pase) or ls_cod_reg_pase='' or ls_cod_reg_pase='-' then
								messagebox("Advertencia","En Fila Nº "+string(ll_indi)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar REGISTRO CIVIL PASE SEPULTACION" )
							elseif isnull(ls_inscrip_pase) or ls_inscrip_pase='' or ls_inscrip_pase='-' then
								messagebox("Advertencia","En Fila Nº "+string(ll_indi)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar INSCRIPCION PASE SEPULTACION" )
							elseif isnull(ls_registro_pase) or ls_registro_pase='' or ls_registro_pase='-' then
								messagebox("Advertencia","En Fila Nº "+string(ll_indi)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar NUMERO REGISTRO PASE SEPULTACION" )
							elseif isnull(ldt_fecha_pase) then
								messagebox("Advertencia","En Fila Nº "+string(ll_indi)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar FECHA PASE SEPULTACION" )
							elseif isnull(ls_estado_cuerpo) or ls_estado_cuerpo='' or ls_estado_cuerpo='-' then
								messagebox("Advertencia","En Fila Nº "+string(ll_indi)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar ESTADO CUERPO" )
							elseif isnull(ldt_fec_nac_fall) then 
								messagebox("Advertencia","En Fila Nº "+string(ll_indi)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar FECHA NACIMIENTO FALLECIDO" )
							else
								ls_pasa1	= 'S'
							end if
						end if
						
					elseif ls_tipo_ficha='FR' then
						SELECT	"FICHA_REDUCCION"."CODIGO_FUNERARIA",	"FICHA_REDUCCION"."FECHA_DEFUNCION",	"FICHA_REDUCCION"."CAUSA_FALLECIMIENTO",	"FICHA_REDUCCION"."PASE_SEPULTACION",	"FICHA_REDUCCION"."EDAD_FALLECIDO",	"FICHA_REDUCCION"."SEXO_FALLECIDO",	"FICHA_REDUCCION"."COD_REGISTRO_PASE",	"FICHA_REDUCCION"."INSCRIPCION_PASE",	"FICHA_REDUCCION"."REGISTRO_PASE",	"FICHA_REDUCCION"."FECHA_PASE",	"FICHA_REDUCCION"."COD_ESTADO_FALL",	"FICHA_REDUCCION"."COD_PARQUE_DESDE",	"FICHA_REDUCCION"."FECHA_NACIMIENTO_FALL",	"FICHA_REDUCCION"."FOLIO_COMPROBANTE"
						INTO 		:ll_cod_funeraria,							:ldt_fec_defuncion,							:ls_causa_fall,									:ls_pase_sepult,								:ll_edad_fall,								:ls_sexo_fall,								:ls_cod_reg_pase,								:ls_inscrip_pase,								:ls_registro_pase,						:ldt_fecha_pase,						:ls_estado_cuerpo,							:ll_cod_parque_desde,						:ldt_fec_nac_fall,									:ll_boleta
						FROM 		"FICHA_REDUCCION"  
						WHERE  ( "FICHA_REDUCCION"."FECHA_SEPULTACION" = :ldt_fecha_sep ) AND  
								 ( "FICHA_REDUCCION"."SECTOR" = :ls_sector ) AND  
								 ( "FICHA_REDUCCION"."SEPULTURA" = :ls_sepultura ) AND  
								 ( "FICHA_REDUCCION"."CORRELATIVO_INTERNO" = :ll_folio ) 
						USING		sqlca;
						if sqlca.sqlcode=0 then
							ls_destino_parque	= 'X'
//							ls_tipo_traslado	= 'I'
							if isnull(ll_cod_funeraria) or ll_cod_funeraria=0 then
								messagebox("Advertencia","En Fila Nº "+string(ll_indi)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar FUNERARIA")
							elseif isnull(ldt_fec_defuncion) then
								messagebox("Advertencia","En Fila Nº "+string(ll_indi)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar FECHA DEFUNCION")
							elseif isnull(ls_causa_fall) or ls_causa_fall='' or ls_causa_fall='-' then
								messagebox("Advertencia","En Fila Nº "+string(ll_indi)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar CAUSA FALLECIMIENTO" )
							elseif isnull(ls_pase_sepult) or ls_pase_sepult='' or ls_pase_sepult='-' then
								messagebox("Advertencia","En Fila Nº "+string(ll_indi)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar NUMERO PASE SEPULTACION" )
							elseif isnull(ll_edad_fall) or ll_edad_fall<0 then
								messagebox("Advertencia","En Fila Nº "+string(ll_indi)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar EDAD FALLECIDO" )
							elseif isnull(ls_sexo_fall) or ls_sexo_fall='' or ls_sexo_fall='-' then
								messagebox("Advertencia","En Fila Nº "+string(ll_indi)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar SEXO FALLECIDO" )
							elseif isnull(ls_estado_cuerpo) or ls_estado_cuerpo='' or ls_estado_cuerpo='-' then
								messagebox("Advertencia","En Fila Nº "+string(ll_indi)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar ESTADO CUERPO" )
							elseif isnull(ldt_fec_nac_fall) then 
								messagebox("Advertencia","En Fila Nº "+string(ll_indi)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar FECHA NACIMIENTO FALLECIDO" )
							else
								ls_pasa1	= 'S'
							end if
						end if
						
					elseif ls_tipo_ficha='CT' then
						SELECT	"FICHA_TRANSITO"."CODIGO_FUNERARIA",	"FICHA_TRANSITO"."FECHA_DEFUNCION",	"FICHA_TRANSITO"."CAUSA_FALLECIMIENTO",	"FICHA_TRANSITO"."PASE_SEPULTACION",	"FICHA_TRANSITO"."EDAD_FALLECIDO",	"FICHA_TRANSITO"."SEXO_FALLECIDO",	"FICHA_TRANSITO"."COD_REGISTRO_PASE",	"FICHA_TRANSITO"."INSCRIPCION_PASE",	"FICHA_TRANSITO"."REGISTRO_PASE",	"FICHA_TRANSITO"."FECHA_PASE",	"FICHA_TRANSITO"."COD_ESTADO_FALL",	"FICHA_TRANSITO"."COD_PARQUE_DESDE",	"FICHA_TRANSITO"."FECHA_NACIMIENTO_FALL",	"FICHA_TRANSITO"."FOLIO_COMPROBANTE"
						INTO 		:ll_cod_funeraria,							:ldt_fec_defuncion,						:ls_causa_fall,									:ls_pase_sepult,								:ll_edad_fall,								:ls_sexo_fall,								:ls_cod_reg_pase,								:ls_inscrip_pase,								:ls_registro_pase,						:ldt_fecha_pase,						:ls_estado_cuerpo,						:ll_cod_parque_desde,						:ldt_fec_nac_fall,								:ll_boleta
						FROM 		"FICHA_TRANSITO"  
						WHERE  ( "FICHA_TRANSITO"."FECHA_SEPULTACION" = :ldt_fecha_sep ) AND  
								 ( "FICHA_TRANSITO"."SECTOR" = :ls_sector ) AND  
								 ( "FICHA_TRANSITO"."SEPULTURA" = :ls_sepultura ) AND  
								 ( "FICHA_TRANSITO"."CORRELATIVO_INTERNO" = :ll_folio ) 
						USING		sqlca;
						if sqlca.sqlcode=0 then
							ls_destino_parque	= 'X'
//							ls_tipo_traslado	= 'I'
							if isnull(ll_cod_funeraria) or ll_cod_funeraria=0 then
								messagebox("Advertencia","En Fila Nº "+string(ll_indi)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar FUNERARIA")
							elseif isnull(ldt_fec_defuncion) then
								messagebox("Advertencia","En Fila Nº "+string(ll_indi)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar FECHA DEFUNCION")
							elseif isnull(ls_causa_fall) or ls_causa_fall='' or ls_causa_fall='-' then
								messagebox("Advertencia","En Fila Nº "+string(ll_indi)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar CAUSA FALLECIMIENTO" )
//							elseif isnull(ls_pase_sepult) or ls_pase_sepult='' or ls_pase_sepult='-' then
//								messagebox("Advertencia","En Fila Nº "+string(ll_indi)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar NUMERO PASE SEPULTACION" )
							elseif isnull(ll_edad_fall) or ll_edad_fall<0 then
								messagebox("Advertencia","En Fila Nº "+string(ll_indi)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar EDAD FALLECIDO" )
							elseif isnull(ls_sexo_fall) or ls_sexo_fall='' or ls_sexo_fall='-' then
								messagebox("Advertencia","En Fila Nº "+string(ll_indi)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar SEXO FALLECIDO" )
							elseif isnull(ls_estado_cuerpo) or ls_estado_cuerpo='' or ls_estado_cuerpo='-' then
								messagebox("Advertencia","En Fila Nº "+string(ll_indi)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar ESTADO CUERPO" )
							elseif isnull(ldt_fec_nac_fall) then 
								messagebox("Advertencia","En Fila Nº "+string(ll_indi)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar FECHA NACIMIENTO FALLECIDO" )
							else
								ls_pasa1	= 'S'
							end if
						end if
					end if
					if ls_pasa1='S' then
						SELECT	"FICHA_CARTA_SEPULTACION"."FOLIO"  
						INTO 		:ll_count_carta  
						FROM 		"FICHA_CARTA_SEPULTACION"  
						WHERE  ( "FICHA_CARTA_SEPULTACION"."SECTOR" = :ls_sector ) AND  
								 ( "FICHA_CARTA_SEPULTACION"."SEPULTURA" = :ls_sepultura ) AND  
								 ( "FICHA_CARTA_SEPULTACION"."COD_PARQUE" = :ll_cod_parque )  AND
								 ( "FICHA_CARTA_SEPULTACION"."CORRELATIVO" = :ll_folio )	 ;
						if isnull(ll_count_carta) then ll_count_carta=0
						ls_vb		= string(ll_max_corr_mensual)
						SELECT	"FICHA_GRABACION_LAPIDA"."CORRELATIVO"
						INTO 		:ll_count_lapida  
						FROM 		"FICHA_GRABACION_LAPIDA"  
						WHERE  ( "FICHA_GRABACION_LAPIDA"."SECTOR" = :ls_sector ) AND  
								 ( "FICHA_GRABACION_LAPIDA"."SEPULTURA" = :ls_sepultura ) AND  
								 ( "FICHA_GRABACION_LAPIDA"."COD_PARQUE" = :ll_cod_parque )  AND
								 ( "FICHA_GRABACION_LAPIDA"."FOLIO" = :ll_folio )					 ;
						if isnull(ll_count_lapida) then ll_count_lapida=0

						INSERT INTO "FICHA_REGISTRO"  
									( "CORRELATIVO_INTERNO",	"CORRELATIVO_MENSUAL",	"CORRELATIVO_ANUAL",	"FECHA_CREA",		"BASE",		"SERIE",		"NUMERO",	"NOMBRE_FALLECIDO",	"AP_PAT_FALLECIDO",	"AP_MAT_FALLECIDO",	"TIPO_FICHA",		"FOLIO_FICHA",	"FOLIO_CARTA_AUTORIZACION",	"FOLIO_GRABA_LAPIDA",	"SECTOR",	"SEPULTURA",	"NRO_TECNICO",		"NIVEL",		"CAPACIDAD",	"RUT_FALLECIDO",	"DV_FALLECIDO",	"COD_ESTADO_CUERPO",	"FECHA_NAC_FALLECIDO",	"EDAD",			"FECHA_FALLECIMIENTO",	"SEXO",			"FECHA_SEPULTACION",	"TIPO_OPERACION_TRASLADO",	"COD_PARQUE_ORIGEN",	"COD_FUNERARIA",		"CAUSA_MUERTE",	"COD_REGISTRO_PASE",	"INSCRIPCION_PASE",	"REGISTRO_PASE",		"FECHA_PASE",		"FOLIO_BOLETA",	"ESTADO_REG",	"COD_PARQUE",		"DESTINO_PARQUE",		"COD_PARQUE_DESTINO" )  
						VALUES 	( :ll_max_corr_interno,		:ll_max_corr_mensual,	:ll_max_corr_anual,	:gdt_fec_sistema,	:ls_base,	:ls_serie,	:ll_numero,	:ls_nom_fall,			:ls_ap_pat_fall,		:ls_ap_mat_fall,		:ls_tipo_ficha,	:ll_folio,		:ll_count_carta,					:ll_count_lapida,			:ls_sector,	:ls_sepultura,	:ls_nro_tecnico,	:ls_nivel,	:ll_cap,			:ll_rut_fall,		:ls_dv_fall,		:ls_estado_cuerpo,	:ldt_fec_nac_fall,		:ll_edad_fall,	:ldt_fec_defuncion,		:ls_sexo_fall,	:ldt_fecha_sep,		:ls_tipo_traslado_def,			:ll_cod_parque,		:ll_cod_funeraria,	:ls_causa_fall,	:ls_cod_reg_pase,		:ls_inscrip_pase,		:ls_registro_pase,	:ldt_fecha_pase,	:ll_boleta,			'G',				:ll_cod_parque,	:ls_destino_parque,	:ll_cod_parque_des	)  
						USING		sqlca;
						if sqlca.sqlcode=0 then
							commit;
							SELECT	"FALLECIDOS"."N_L",
										"FALLECIDOS"."N_M",
										"FALLECIDOS"."LLAVE"
							INTO 		:ll_reg_anual,
										:ll_reg_mensual,
										:ll_llave
							FROM 		"FALLECIDOS"  
							WHERE  ( "FALLECIDOS"."BASE" = :ls_base ) AND  
									 ( "FALLECIDOS"."SS" = :ls_serie ) AND  
									 ( "FALLECIDOS"."CONTRATO" = :ll_numero ) AND  
									 ( "FALLECIDOS"."SECTOR" = :ls_sector ) AND  
									 ( "FALLECIDOS"."N_SEP" = :ls_sepultura ) AND  
									 ( "FALLECIDOS"."NOMBRES" = :ls_nom_fall ) AND  
									 ( "FALLECIDOS"."AP_PATERNO" = :ls_ap_pat_fall ) AND  
									 ( "FALLECIDOS"."AP_MATERNO" = :ls_ap_mat_fall )  
							USING		sqlca;
							if sqlca.sqlcode=0 then
								if ll_reg_anual=0 or isnull(ll_reg_anual) or isnull(ll_reg_mensual) or ll_reg_mensual=0 then
									if (ls_tipo_ficha = 'FT' AND ls_tipo_traslado = 'E' AND ls_destino_parque = 'S') then
										SELECT 	"FALLECIDOS"."FOLIO",	"FALLECIDOS"."N_L",	"FALLECIDOS"."N_M",	"FALLECIDOS"."BASE",	"FALLECIDOS"."SS",	"FALLECIDOS"."CONTRATO",	"FALLECIDOS"."SECTOR",	"FALLECIDOS"."N_SEP",	"FALLECIDOS"."NOMBRES",	"FALLECIDOS"."AP_PATERNO",	"FALLECIDOS"."AP_MATERNO",	"FALLECIDOS"."FEC_SEP",	"FALLECIDOS"."EST",	"FALLECIDOS"."OP",	"FALLECIDOS"."RUT",	"FALLECIDOS"."DV",	"FALLECIDOS"."SEXO",	"FALLECIDOS"."EDAD",	"FALLECIDOS"."PERIODO",	"FALLECIDOS"."FEC_NAC",	"FALLECIDOS"."FEC_FALL",	"FALLECIDOS"."PASE",	"FALLECIDOS"."REG_CIVIL",	"FALLECIDOS"."CAUSA_FALL",	"FALLECIDOS"."ENF_OBL",	"FALLECIDOS"."FUNERARIA",	"FALLECIDOS"."BOLETA",	"FALLECIDOS"."CARTA_AUT",	"FALLECIDOS"."RG_EST",	"FALLECIDOS"."N_TEC",	"FALLECIDOS"."NIVEL",	"FALLECIDOS"."VTA",	"FALLECIDOS"."OBSERVACIONES",	"FALLECIDOS"."ESTADO_CONTRATO",	"FALLECIDOS"."RESOLUCION_TRASLADO_NRO",	"FALLECIDOS"."OTORGADO_POR",	"FALLECIDOS"."CEMENTERIO_ORIGEN",	"FALLECIDOS"."COD_PARQUE"
										INTO		:ll_folio,					:ll_n_l,					:ll_n_m,					:ls_base,				:ls_serie,				:ll_numero,						:ls_sector,					:ls_n_sep,					:ls_nombre,					:ls_ap_pat,						:ls_ap_mat,						:ldt_fec_sep,				:ls_est, 				:ls_op,					:ll_rut,					:ls_dv,					:ls_sexo,				:ll_edad,				:ls_periodo,				:ldt_fec_nac,				:ldt_fec_fall,   				:ls_pase,				:ls_reg_civil,					:ls_causa_fall,				:ls_enf_obl,				:ls_funeraria,					:ls_boleta,					:ls_carta_aut,					:ls_rg_est,					:ls_n_tec,					:ls_nivel,					:ls_vta,					:ls_obs, 							:ls_est_ctto,							:ls_resol_tras,									:ls_otorgado,						:ls_cementerio_ori,						:ll_cod_parque
										FROM 		"FALLECIDOS"  
										WHERE 	"FALLECIDOS"."LLAVE" = :ll_llave   
										USING		sqlca;
										if sqlca.sqlcode=0 then
											INSERT INTO "LOG_FALLECIDOS"  
														 ( "LLAVE",		"FOLIO",		"N_L",	"N_M",	"BASE",		"SS",			"CONTRATO",	"SECTOR",	"N_SEP",		"NOMBRES",	"AP_PATERNO",	"AP_MATERNO",	"FEC_SEP",		"EST",	"OP",		"RUT",	"DV",		"SEXO",		"EDAD",		"PERIODO",		"FEC_NAC",		"FEC_FALL",		"PASE",		"REG_CIVIL",	"CAUSA_FALL",		"ENF_OBL",		"FUNERARIA",	"BOLETA",	"CARTA_AUT",	"RG_EST",	"N_TEC",		"NIVEL",		"VTA",	"OBSERVACIONES",	"ESTADO_CONTRATO",	"RESOLUCION_TRASLADO_NRO",	"OTORGADO_POR",	"CEMENTERIO_ORIGEN",	"COD_PARQUE" )  
											VALUES 	 ( :ll_llave,	:ll_folio,	:ll_n_l,	:ll_n_m,	:ls_base,	:ls_serie,	:ll_numero,	:ls_sector,	:ls_n_sep,	:ls_nombre,	:ls_ap_pat,		:ls_ap_mat,		:ldt_fec_sep,	:ls_est, :ls_op,	:ll_rut,	:ls_dv,	:ls_sexo,	:ll_edad,	:ls_periodo,	:ldt_fec_nac,	:ldt_fec_fall, :ls_pase,	:ls_reg_civil,	:ls_causa_fall,	:ls_enf_obl,	:ls_funeraria,	:ls_boleta,	:ls_carta_aut,	:ls_rg_est,	:ls_n_tec,	:ls_nivel,	:ls_vta,	:ls_obs, 			:ls_est_ctto,			:ls_resol_tras,				:ls_otorgado,		:ls_cementerio_ori,	:ll_cod_parque )  
											USING		sqlca;
											if sqlca.sqlcode=0 then
												commit;

												DELETE FROM	"FALLECIDOS"  
												WHERE 		"FALLECIDOS"."LLAVE" = :ll_llave   
												USING			sqlca;
												if sqlca.sqlcode=0 then
													commit;
												else
													rollback;
												end if
											else
												rollback;
												messagebox("Error Grabar","Error al Grabar Log_Fallecido SQL: "+sqlca.sqlerrtext)
											end if
										else
											messagebox("Advertencia","No Existe Fallecido LLave Nº "+string(ll_llave,'###,###,###,###,###')+", No es posible Eliminarlo")
										end if
									else
										UPDATE	"FALLECIDOS"  
										SET 		"N_L" = :ll_max_corr_anual,   
													"N_M" = :ll_max_corr_mensual  
										WHERE 	"FALLECIDOS"."LLAVE" = :ll_llave   
										USING		sqlca;
										if sqlca.sqlcode=0 then
											commit;
										else
											rollback;
										end if
									end if
								end if
								
							end if
							
							if ls_tipo_ficha='FT' then
								if not isnull(ls_sector_des) and not isnull(ls_sepult_des) and ll_cod_parque_des > 0 then
									UPDATE	"FICHA_TRASLADO"
									SET 		"FICHA_TRASLADO"."ESTADO_REG" = 'G',
												"FICHA_TRASLADO"."CORRELATIVO_MENSUAL" = :ll_max_corr_mensual,
												"FICHA_TRASLADO"."CORRELATIVO_ANUAL" = :ll_max_corr_anual,
												"FICHA_TRASLADO"."VB_ESTADISTICO" = :ls_vb
									WHERE  ( "FICHA_TRASLADO"."COD_PARQUE" = :ll_cod_parque ) AND  
											 ( "FICHA_TRASLADO"."FECHA_TRASLADO" = :ldt_fecha_sep ) AND  
											 ( "FICHA_TRASLADO"."SECTOR_DESTINO" = :ls_sector ) AND  
											 ( "FICHA_TRASLADO"."SEPULTURA_DESTINO" = :ls_sepultura ) AND  
											 ( "FICHA_TRASLADO"."FOLIO" = :ll_folio )   
									USING		sqlca;
								else
									UPDATE	"FICHA_TRASLADO"
									SET 		"FICHA_TRASLADO"."ESTADO_REG" = 'G',
												"FICHA_TRASLADO"."CORRELATIVO_MENSUAL" = :ll_max_corr_mensual,
												"FICHA_TRASLADO"."CORRELATIVO_ANUAL" = :ll_max_corr_anual,
												"FICHA_TRASLADO"."VB_ESTADISTICO" = :ls_vb
									WHERE  ( "FICHA_TRASLADO"."COD_PARQUE" = :ll_cod_parque ) AND  
											 ( "FICHA_TRASLADO"."FECHA_TRASLADO" = :ldt_fecha_sep ) AND  
											 ( "FICHA_TRASLADO"."SECTOR_ORIGEN" = :ls_sector ) AND  
											 ( "FICHA_TRASLADO"."SEPULTURA_ORIGEN" = :ls_sepultura ) AND  
											 ( "FICHA_TRASLADO"."FOLIO" = :ll_folio )   
									USING		sqlca;
								end if
								if sqlca.sqlcode=0 then
									commit;
									UPDATE	"FICHA_CARTA_SEPULTACION"  
									SET 		"ESTADO_REG" = 'G'  
									WHERE  ( "FICHA_CARTA_SEPULTACION"."FECHA_SEPULTACION" = :ldt_fecha_sep ) AND  
											 ( "FICHA_CARTA_SEPULTACION"."SECTOR" = :ls_sector ) AND  
											 ( "FICHA_CARTA_SEPULTACION"."SEPULTURA" = :ls_sepultura ) AND  
											 ( "FICHA_CARTA_SEPULTACION"."COD_PARQUE" = :ll_cod_parque ) AND  
											 ( "FICHA_CARTA_SEPULTACION"."CORRELATIVO" = :ll_folio )   
									USING		sqlca;
									if sqlca.sqlcode=0 then
										commit;
									else
										rollback;
										messagebox("Error Grabar FT","Error al Grabar Estado FICHA CARTA SEPULTACION SQL: "+sqlca.sqlerrtext)
									end if
									UPDATE	"FICHA_GRABACION_LAPIDA"  
									SET 		"ESTADO_REG" = 'G'  
									WHERE  ( "FICHA_GRABACION_LAPIDA"."FECHA_SEPULTACION" = :ldt_fecha_sep ) AND  
											 ( "FICHA_GRABACION_LAPIDA"."SECTOR" = :ls_sector ) AND  
											 ( "FICHA_GRABACION_LAPIDA"."SEPULTURA" = :ls_sepultura ) AND  
											 ( "FICHA_GRABACION_LAPIDA"."FOLIO" = :ll_folio ) AND  
											 ( "FICHA_GRABACION_LAPIDA"."COD_PARQUE" = :ll_cod_parque )   
									USING		sqlca;
									if sqlca.sqlcode=0 then
										commit;
									else
										rollback;
										messagebox("Error Grabar FT","Error al Grabar Estado FICHA GRABACION LAPIDA SQL: "+sqlca.sqlerrtext)
									end if
								else
									rollback;
									messagebox("Error Grabar","Error Grabar Tabla FICHA_TRASLADO SQL: "+sqlca.sqlerrtext)
								end if
				
							elseif ls_tipo_ficha='FS' then
								UPDATE	"FICHA_SEPULTACION"
								SET		"FICHA_SEPULTACION"."ESTADO_REG" = 'G',
											"FICHA_SEPULTACION"."CORRELATIVO_MENSUAL" = :ll_max_corr_mensual,
											"FICHA_SEPULTACION"."CORRELATIVO_ANUAL" = :ll_max_corr_anual,
											"FICHA_SEPULTACION"."VB_ESTADISTICO" = :ls_vb
								WHERE  ( "FICHA_SEPULTACION"."FECHA_SEPULTACION" = :ldt_fecha_sep ) AND  
										 ( "FICHA_SEPULTACION"."SECTOR" = :ls_sector ) AND  
										 ( "FICHA_SEPULTACION"."SEPULTURA" = :ls_sepultura ) AND  
										 ( "FICHA_SEPULTACION"."CORRELATIVO_INTERNO" = :ll_folio ) 
								USING		sqlca;
								if sqlca.sqlcode=0 then
									commit;
									UPDATE	"FICHA_CARTA_SEPULTACION"  
									SET 		"ESTADO_REG" = 'G'  
									WHERE  ( "FICHA_CARTA_SEPULTACION"."FECHA_SEPULTACION" = :ldt_fecha_sep ) AND  
											 ( "FICHA_CARTA_SEPULTACION"."SECTOR" = :ls_sector ) AND  
											 ( "FICHA_CARTA_SEPULTACION"."SEPULTURA" = :ls_sepultura ) AND  
											 ( "FICHA_CARTA_SEPULTACION"."COD_PARQUE" = :ll_cod_parque ) AND  
											 ( "FICHA_CARTA_SEPULTACION"."CORRELATIVO" = :ll_folio )   
									USING		sqlca;
									if sqlca.sqlcode=0 then
										commit;
									else
										rollback;
										messagebox("Error Grabar FS","Error al Grabar Estado FICHA CARTA SEPULTACION SQL: "+sqlca.sqlerrtext)
									end if
									UPDATE	"FICHA_GRABACION_LAPIDA"  
									SET 		"ESTADO_REG" = 'G'  
									WHERE  ( "FICHA_GRABACION_LAPIDA"."FECHA_SEPULTACION" = :ldt_fecha_sep ) AND  
											 ( "FICHA_GRABACION_LAPIDA"."SECTOR" = :ls_sector ) AND  
											 ( "FICHA_GRABACION_LAPIDA"."SEPULTURA" = :ls_sepultura ) AND  
											 ( "FICHA_GRABACION_LAPIDA"."FOLIO" = :ll_folio ) AND  
											 ( "FICHA_GRABACION_LAPIDA"."COD_PARQUE" = :ll_cod_parque )   
									USING		sqlca;
									if sqlca.sqlcode=0 then
										commit;
									else
										rollback;
										messagebox("Error Grabar FS","Error al Grabar Estado FICHA GRABACION LAPIDA SQL: "+sqlca.sqlerrtext)
									end if
								else
									rollback;
									messagebox("Error Grabar","Error Grabar Tabla FICHA_SEPULTACION SQL: "+sqlca.sqlerrtext)
								end if
								
							elseif ls_tipo_ficha='FR' then
								UPDATE	"FICHA_REDUCCION"
								SET		"FICHA_REDUCCION"."ESTADO_REG" = 'G',
											"FICHA_REDUCCION"."CORRELATIVO_MENSUAL" = :ll_max_corr_mensual,
											"FICHA_REDUCCION"."CORRELATIVO_ANUAL" = :ll_max_corr_anual,
											"FICHA_REDUCCION"."VB_ESTADISTICO" = :ls_vb
								WHERE  ( "FICHA_REDUCCION"."FECHA_SEPULTACION" = :ldt_fecha_sep ) AND  
										 ( "FICHA_REDUCCION"."SECTOR" = :ls_sector ) AND  
										 ( "FICHA_REDUCCION"."SEPULTURA" = :ls_sepultura ) AND  
										 ( "FICHA_REDUCCION"."CORRELATIVO_INTERNO" = :ll_folio ) 
								USING		sqlca;
								if sqlca.sqlcode=0 then
									commit;
								else
									rollback;
									messagebox("Error Grabar","Error Grabar Tabla FICHA_REDUCCION SQL: "+sqlca.sqlerrtext)
								end if
								
							elseif ls_tipo_ficha='CT' then
								UPDATE	"FICHA_TRANSITO"
								SET		"FICHA_TRANSITO"."ESTADO_REG" = 'G',
											"FICHA_TRANSITO"."CORRELATIVO_MENSUAL" = :ll_max_corr_mensual,
											"FICHA_TRANSITO"."CORRELATIVO_ANUAL" = :ll_max_corr_anual,
											"FICHA_TRANSITO"."VB_ESTADISTICO" = :ls_vb
								WHERE  ( "FICHA_TRANSITO"."FECHA_SEPULTACION" = :ldt_fecha_sep ) AND  
										 ( "FICHA_TRANSITO"."SECTOR" = :ls_sector ) AND  
										 ( "FICHA_TRANSITO"."SEPULTURA" = :ls_sepultura ) AND  
										 ( "FICHA_TRANSITO"."CORRELATIVO_INTERNO" = :ll_folio ) 
								USING		sqlca;
								if sqlca.sqlcode=0 then
									commit;
								else
									rollback;
									messagebox("Error Grabar","Error Grabar Tabla FICHA_TRANSITO SQL: "+sqlca.sqlerrtext)
								end if
							end if
//							ll_max_corr_interno ++
//							ll_max_corr_mensual ++
//							ll_max_corr_anual ++
							ll_contar ++
						else
							rollback;
							messagebox("Error Grabar","Error Grabar Tabla FICHA_REGISTRO SQL: "+sqlca.sqlerrtext)
						end if
					end if
				else
					if isnull(ls_nom_fall) or ls_nom_fall='' or ls_nom_fall='-' then
						messagebox("Advertencia","En Fila Nº "+string(ll_indi)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar NOMBRE FALLECIDO" )
					elseif isnull(ls_ap_pat_fall) or ls_ap_pat_fall='' or ls_ap_pat_fall='-' then
						messagebox("Advertencia","En Fila Nº "+string(ll_indi)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar APELLIDO PATERNO FALLECIDO" )
					elseif isnull(ls_ap_mat_fall) or ls_ap_mat_fall='' or ls_ap_mat_fall='-' then
						messagebox("Advertencia","En Fila Nº "+string(ll_indi)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar APELLIDO MATERNO FALLECIDO" )
					elseif isnull(ls_nro_tecnico) or ls_nro_tecnico='' or ls_nro_tecnico='-' then
						messagebox("Advertencia","En Fila Nº "+string(ll_indi)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar NUMERO TECNICO" )
					elseif isnull(ldt_fecha_sep)  then
						messagebox("Advertencia","En Fila Nº "+string(ll_indi)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar FECHA SEPULTACION" )
					elseif isnull(ls_nivel) or ls_nivel='' or ls_nivel='-' then
						messagebox("Advertencia","En Fila Nº "+string(ll_indi)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar NIVEL" )
					end if
				end if
			end if
		next
		if ll_contar>0 then
			messagebox("Grabar","Grabación Exitosa")
			pb_ok.triggerevent(clicked!)
		end if
	else
		messagebox("Advertencia","Debe Marcar por lo Menos UNA Ficha")
	end if
end if
end event

type p_fin from picture within w_mantenedor_estadistico_bkp
integer x = 1563
integer y = 56
integer width = 78
integer height = 88
string picturename = "DDLB.BMP"
boolean focusrectangle = false
end type

event clicked;string ls_fecha,fech

dw_lista.reset()
if f_valida_fecha(em_fec_fin.text)=-1 then 
	em_fec_fin.text	= string(gdt_fec_sistema,gs_formato_fecha)
	em_fec_fin.setfocus()
	return
end if	
if em_fec_fin.text<>'00/00/0000' then
	ls_fecha 			= em_fec_fin.text
else
	ls_fecha 			= string(gdt_fec_sistema,gs_formato_fecha)
end if	
OpenWithParm(w_calendar,ls_fecha)

IF Message.StringParm <> ls_fecha THEN
	IF DATE(Message.StringParm)<DATE(em_fec_ini.TEXT) THEN
		MESSAGEBOX(gs_app_name,'La fecha de final debe ser mayor a la inicial.',stopsign!)
		em_fec_fin.setfocus()
		return
	else	
		em_fec_fin.text = Message.StringParm
	end if	
END IF
end event

