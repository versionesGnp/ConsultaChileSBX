					dw_lista.setitem(il_row,'c_estatus',1)
				elseif isnull(ls_ap_pat_tit) or ls_ap_pat_tit='-' or ls_ap_pat_tit='' then
					messagebox("Advertencia","Debe Ingresar APELLIDO PATERNO TIULAR en Fila Nº "+string(il_row,'###,###,###,###,##0'))
					dw_lista.setitem(il_row,'c_estatus',1)
				elseif isnull(ls_ap_mat_tit) or ls_ap_mat_tit='' then
					messagebox("Advertencia","Debe Ingresar APELLIDO MATERNO TITULAR en Fila Nº "+string(il_row,'###,###,###,###,##0'))
					dw_lista.setitem(il_row,'c_estatus',1)
				elseif isnull(ldt_fec_recep) then
					messagebox("Advertencia","Debe Ingresar FECHA RECEPCION en Fila Nº "+string(il_row,'###,###,###,###,##0'))
					dw_lista.setitem(il_row,'c_estatus',1)
				elseif isnull(ll_hora_recep) or ll_hora_recep=0 then
					messagebox("Advertencia","Debe Ingresar HORA RECEPCION en Fila Nº "+string(il_row,'###,###,###,###,##0'))
					dw_lista.setitem(il_row,'c_estatus',1)
				elseif isnull(ll_min_recep) then
					messagebox("Advertencia","Debe Ingresar MINUTOS RECEPCION en Fila Nº "+string(il_row,'###,###,###,###,##0'))
					dw_lista.setitem(il_row,'c_estatus',1)
				elseif isnull(ll_rut_tit) or ll_rut_tit=0 then
					messagebox("Advertencia","Debe Ingresar RUT TITULAR en Fila Nº "+string(il_row,'###,###,###,###,##0'))
					dw_lista.setitem(il_row,'c_estatus',1)
				elseif isnull(ls_dv_tit) or ls_dv_tit='-' or ls_dv_tit='' then
					messagebox("Advertencia","Debe Ingresar DIGITO VERIFICADOR TITULAR en Fila Nº "+string(il_row,'###,###,###,###,##0'))
					dw_lista.setitem(il_row,'c_estatus',1)
				elseif isnull(ls_cod_est_ctto) or ls_cod_est_ctto='-' or ls_cod_est_ctto='' then
					messagebox("Advertencia","Debe Ingresar ESTADO CONTRATO en Fila Nº "+string(il_row,'###,###,###,###,##0'))
					dw_lista.setitem(il_row,'c_estatus',1)
				elseif isnull(ll_edad_fall) or ll_edad_fall=0 then
					messagebox("Advertencia","Debe Ingresar EDAD FALLECIDO en Fila Nº "+string(il_row,'###,###,###,###,##0'))
					dw_lista.setitem(il_row,'c_estatus',1)
				elseif isnull(ls_sexo_fall) or ls_sexo_fall='-' or ls_sexo_fall='' then
					messagebox("Advertencia","Debe Ingresar SEXO FALLECIDO en Fila Nº "+string(il_row,'###,###,###,###,##0'))
					dw_lista.setitem(il_row,'c_estatus',1)
				elseif isnull(ls_estado_r) or ls_estado_r='-' or ls_estado_r='' then
					messagebox("Advertencia","Debe Ingresar ESTADO FICHA en Fila Nº "+string(il_row,'###,###,###,###,##0'))
					dw_lista.setitem(il_row,'c_estatus',1)
				elseif isnull(ls_cod_registro_pase) or ls_cod_registro_pase='-' or ls_cod_registro_pase='' then
					messagebox("Advertencia","Debe Ingresar REGISTRO CIVIL PASE SEPULTACION en Fila Nº "+string(il_row,'###,###,###,###,##0'))
					dw_lista.setitem(il_row,'c_estatus',1)
				elseif isnull(ls_inscrip_pase) or ls_inscrip_pase='-' or ls_inscrip_pase='' then
					messagebox("Advertencia","Debe Ingresar INSCRIPCION PASE SEPULTACION en Fila Nº "+string(il_row,'###,###,###,###,##0'))
					dw_lista.setitem(il_row,'c_estatus',1)
				elseif isnull(ls_registro_pase) or ls_registro_pase='-' or ls_registro_pase='' then
					messagebox("Advertencia","Debe Ingresar REGISTRO PASE SEPULTACION en Fila Nº "+string(il_row,'###,###,###,###,##0'))
					dw_lista.setitem(il_row,'c_estatus',1)
				elseif isnull(ll_anno_pase) or ll_anno_pase=0 then
					messagebox("Advertencia","Debe Ingresar AÑO PASE SEPULTACION en Fila Nº "+string(il_row,'###,###,###,###,##0'))
					dw_lista.setitem(il_row,'c_estatus',1)
				elseif isnull(ldt_fecha_pase) then
					messagebox("Advertencia","Debe Ingresar FECHA PASE SEPULTACION en Fila Nº "+string(il_row,'###,###,###,###,##0'))
					dw_lista.setitem(il_row,'c_estatus',1)
				elseif isnull(ls_tamano) or ls_tamano='-' or ls_tamano='' then
					messagebox("Advertencia","Debe Ingresar TAMAÑO CUERPO FALLECIDO en Fila Nº "+string(il_row,'###,###,###,###,##0'))
					dw_lista.setitem(il_row,'c_estatus',1)
				else
					ls_pasa					= 'S'
				end if
			end if
			
		elseif ls_c_tipo_ficha='FR' then
			SELECT	"FICHA_REDUCCION"."CODIGO_EJECUTIVO",	"FICHA_REDUCCION"."FECHA_SEPULTACION",	"FICHA_REDUCCION"."HORA",	"FICHA_REDUCCION"."CODIGO_FUNERARIA",	"FICHA_REDUCCION"."NOMBRE_FALLECIDO",	"FICHA_REDUCCION"."AP_PATERNO_FALL",	"FICHA_REDUCCION"."AP_MATERNO_FALL",	"FICHA_REDUCCION"."FECHA_NACIMIENTO_FALL",	"FICHA_REDUCCION"."RUT_FALLECIDO",	"FICHA_REDUCCION"."DV_FALLECIDO",	"FICHA_REDUCCION"."COD_ESTADO_FALL",	"FICHA_REDUCCION"."PASE_SEPULTACION",	"FICHA_REDUCCION"."CAUSA_FALLECIMIENTO",	"FICHA_REDUCCION"."CODIGO_PARENTESCO",	"FICHA_REDUCCION"."MONTO_CANCELAR",	"FICHA_REDUCCION"."BASE",	"FICHA_REDUCCION"."SERIE",	"FICHA_REDUCCION"."NUMERO",	"FICHA_REDUCCION"."SECTOR",	"FICHA_REDUCCION"."SEPULTURA",	"FICHA_REDUCCION"."NUMERO_TECNICO",	"FICHA_REDUCCION"."NIVEL",	"FICHA_REDUCCION"."COD_PARQUE",	"FICHA_REDUCCION"."NOMBRE_TITULAR",	"FICHA_REDUCCION"."AP_PATERNO_TITULAR",	"FICHA_REDUCCION"."AP_MATERNO_TITULAR",	"FICHA_REDUCCION"."FECHA_RECEPCION",	"FICHA_REDUCCION"."HORA_RECEPCION",	"FICHA_REDUCCION"."MINUTO_RECEPCION",	"FICHA_REDUCCION"."RUT_TITULAR",	"FICHA_REDUCCION"."DV_TITULAR",	"FICHA_REDUCCION"."COD_ESTADO_CONTRATO",	"FICHA_REDUCCION"."EDAD_FALLECIDO",	"FICHA_REDUCCION"."SEXO_FALLECIDO",	"FICHA_REDUCCION"."ESTADO_REG",	"FICHA_REDUCCION"."COD_REGISTRO_PASE",	"FICHA_REDUCCION"."INSCRIPCION_PASE",	"FICHA_REDUCCION"."REGISTRO_PASE",	"FICHA_REDUCCION"."ANNO_PASE",	"FICHA_REDUCCION"."FECHA_PASE",	"FICHA_REDUCCION"."COD_TAMANO_CUERPO",	"FICHA_REDUCCION"."OBSERVACION_FALLECIDO",	"FICHA_REDUCCION"."SW_PAGO_LIBERADO"
			INTO 		:ls_codigo_ejecutivo,						:ldt_fec_sepult,								:ll_hora,						:ll_cod_funeraria,							:ls_nom_fall,									:ls_ap_pat_fall,								:ls_ap_mat_fall,								:ldt_fec_fac_fall,									:ll_rut_fall,								:ls_dv_fall,								:ls_cod_estado_fall,							:ls_pase_sepult,								:ls_causa_fall,									:ls_cod_parentesco,							:ll_monto_cancelar,						:ls_base,						:ls_serie,						:ll_numero,							:ls_sector,							:ls_sepultura,							:ls_nro_tecnico,							:ls_nivel,						:ll_cod_parque,						:ls_nom_tit,								:ls_ap_pat_tit,									:ls_ap_mat_tit,									:ldt_fec_recep,								:ll_hora_recep,							:ll_min_recep,									:ll_rut_tit,							:ls_dv_tit,								:ls_cod_est_ctto,									:ll_edad_fall,								:ls_sexo_fall,								:ls_estado_r,							:ls_cod_registro_pase,						:ls_inscrip_pase,								:ls_registro_pase,						:ll_anno_pase,							:ldt_fecha_pase,						:ls_tamano,										:ls_obs_fall,											:ll_sw_pago_lib
			FROM 		"FICHA_REDUCCION"  
			WHERE 	"FICHA_REDUCCION"."CORRELATIVO_INTERNO" = :ll_corr_interno  AND
						"FICHA_REDUCCION"."COD_PARQUE" = :ll_cod_parque_ing AND
						"FICHA_REDUCCION"."SECTOR" = :ls_sector_ing AND
						"FICHA_REDUCCION"."SEPULTURA" = :ls_sepultura_ing AND
						"FICHA_REDUCCION"."FECHA_SEPULTACION" = :ldt_fecha_sepult_ing
			USING		sqlca;
			if sqlca.sqlcode=0 then
				if isnull(ls_codigo_ejecutivo) or ls_codigo_ejecutivo='' or ls_codigo_ejecutivo='-' then
					messagebox("Advertencia","Debe Ingresar EJECUTIVO en Fila Nº "+string(il_row,'###,###,###,###,##0'))
					dw_lista.setitem(il_row,'c_estatus',1)
				elseif isnull(ldt_fec_sepult) then
					messagebox("Advertencia","Debe Ingresar FECHA SEPULTACION en Fila Nº "+string(il_row,'###,###,###,###,##0'))
					dw_lista.setitem(il_row,'c_estatus',1)
				elseif isnull(ll_hora) or ll_hora=0 then
					messagebox("Advertencia","Debe Ingresar HORA SEPULTACION en Fila Nº "+string(il_row,'###,###,###,###,##0'))
					dw_lista.setitem(il_row,'c_estatus',1)
