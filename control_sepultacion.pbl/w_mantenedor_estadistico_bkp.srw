event clicked;String	ls_fecha,ls_nom_fall,ls_hora_dep,ls_area,ls_sector,ls_sepultura,ls_loghora,ls_fecha_dia,&
			ls_tipo_ficha,ls_causa_fall,ls_estado_cuerpo,ls_sexo_fall,ls_pase_sepult,ls_cod_reg_pase,&
			ls_inscrip_pase,ls_registro_pase,ls_tipo_traslado,ls_destino_parque,ls_base_des,ls_serie_des,&
			ls_sector_des,ls_sepult_des,ls_nro_tec_des,ls_nivel_des,ls_dv_tit_des,ls_base,ls_serie,&
			ls_nro_tecnico,ls_nivel
Long		ll_cod_parque,ll_correlatico,ll_dia,ll_mes,ll_anno,ll_res,ll_count,ll_folio,ll_cod_funeraria,&
			ll_edad_fall,ll_boleta,ll_numero_des,ll_rut_tit_des,ll_boleta_des,ll_cap_des,ll_cod_parque_des,&
			ll_numero,ll_cap
datetime	ldt_fecha,ldt_fecha_sep,ldt_fec_nac_fall,ldt_fecha_pase

if dw_lista.rowcount() > 0 then
//	il_row			= dw_lista.getrow()
	ll_cod_parque	= dw_lista.getitemnumber(il_row,'cod_parque')
	ls_sector		= dw_lista.getitemstring(il_row,'sector')
	ls_sepultura	= dw_lista.getitemstring(il_row,'sepultura')
	ldt_fecha_sep	= dw_lista.getitemdatetime(il_row,'fecha_sepultacion')
	ll_folio			= dw_lista.getitemnumber(il_row,'correlativo_interno')
	ls_tipo_ficha	= dw_lista.getitemstring(il_row,'c_tipo_ficha')
	ls_nom_fall		= dw_lista.getitemstring(il_row,'nombre_fallecido')+' '+dw_lista.getitemstring(il_row,'ap_paterno_fall')+' '+dw_lista.getitemstring(il_row,'ap_materno_fall')
	if ls_tipo_ficha='FT' then
		SELECT	"FICHA_TRASLADO"."CODIGO_FUNERARIA",	"FICHA_TRASLADO"."OBSERVACION_FALLECIDO",	"FICHA_TRASLADO"."COD_ESTADO_FALLECIDO",	"FICHA_TRASLADO"."EDAD_FALLECIDO",	"FICHA_TRASLADO"."SEXO_FALLECIDO",	"FICHA_TRASLADO"."FECHA_NACIMIENTO_FALLECIDO",	"FICHA_TRASLADO"."PASE_SEPULTACION",	"FICHA_TRASLADO"."COD_REGISTRO_PASE",	"FICHA_TRASLADO"."INSCRIPCION_PASE",	"FICHA_TRASLADO"."REGISTRO_PASE",	"FICHA_TRASLADO"."FECHA_PASE",	"FICHA_TRASLADO"."TIPO_TRASLADO",	"FICHA_TRASLADO"."BOLETA_NRO_ORIGEN",	"FICHA_TRASLADO"."DESTINO_PARQUE",	"FICHA_TRASLADO"."BASE_DESTINO",	"FICHA_TRASLADO"."SERIE_DESTINO",	"FICHA_TRASLADO"."NUMERO_DESTINO",	"FICHA_TRASLADO"."SECTOR_DESTINO",	"FICHA_TRASLADO"."SEPULTURA_DESTINO",	"FICHA_TRASLADO"."NUMERO_TECNICO_DESTINO",	"FICHA_TRASLADO"."NIVEL_SEPULTURA_DESTINO",	"FICHA_TRASLADO"."RUT_TITULAR_DESTINO",	"FICHA_TRASLADO"."DV_TITULAR_DESTINO",	"FICHA_TRASLADO"."BOLETA_NRO_DESTINO",	"FICHA_TRASLADO"."CAPACIDAD_DESTINO",	"FICHA_TRASLADO"."COD_PARQUE_DESTINO"
		INTO 		:ll_cod_funeraria,							:ls_causa_fall,									:ls_estado_cuerpo,								:ll_edad_fall,								:ls_sexo_fall,								:ldt_fec_nac_fall,										:ls_pase_sepult,								:ls_cod_reg_pase,								:ls_inscrip_pase,								:ls_registro_pase,						:ldt_fecha_pase,						:ls_tipo_traslado,						:ll_boleta,										:ls_destino_parque,						:ls_base_des,							:ls_serie_des,								:ll_numero_des,							:ls_sector_des,							:ls_sepult_des,								:ls_nro_tec_des,										:ls_nivel_des,											:ll_rut_tit_des,									:ls_dv_tit_des,								:ll_boleta_des,								:ll_cap_des,									:ll_cod_parque_des
		FROM 		"FICHA_TRASLADO"  
		WHERE  ( "FICHA_TRASLADO"."COD_PARQUE" = :ll_cod_parque ) AND  
				 ( "FICHA_TRASLADO"."FECHA_TRASLADO" = :ldt_fecha_sep ) AND  
				 ( "FICHA_TRASLADO"."SECTOR_ORIGEN" = :ls_sector ) AND  
				 ( "FICHA_TRASLADO"."SEPULTURA_ORIGEN" = :ls_sepultura ) AND  
				 ( "FICHA_TRASLADO"."FOLIO" = :ll_folio )   
		USING		sqlca;
		if sqlca.sqlcode=0 then
			if (ls_tipo_traslado='I') or (ls_tipo_traslado='E' and ls_destino_parque='E') then
				ll_cod_parque		= ll_cod_parque_des
				ls_sector			= ls_sector_des
				ls_sepultura		= ls_sepult_des
				ls_base				= ls_base_des
				ls_serie				= ls_serie_des
				ll_numero			= ll_numero_des
				ls_nro_tecnico		= ls_nro_tec_des
				ll_cap				= ll_cap_des
				ls_nivel				= ls_nivel_des
				ll_boleta			= ll_boleta_des
			end if
		end if
	end if		
//	ll_cod_parque	= dw_lista.getitemnumber(il_row,'cod_parque')
//	ls_sector		= dw_lista.getitemstring(il_row,'sector')
//	ls_sepultura	= dw_lista.getitemstring(il_row,'sepultura')
	if not isnull(ls_nom_fall) and mid(ls_nom_fall,1,1)<>'-' and ls_nom_fall<>'' and ll_cod_parque>0 and &
		not isnull(ls_sector) and ls_sector<>'' and ls_sector<>'-' and not isnull(ls_sepultura) and &
		ls_sepultura<>'-' and ls_sepultura<>'' then
		if il_row>0 and dw_lista.rowcount()>0 then
			if dw_lista.getitemnumber(il_row,'hora')>0 then
				ldt_fecha		= dw_lista.getitemdatetime(il_row,'fecha_sepultacion')
				ll_dia			= day(date(ldt_fecha))
				ll_mes			= month(date(ldt_fecha))
				ll_anno			= year(date(ldt_fecha))
				ls_fecha			= string(ll_dia)
				if ll_mes=1 then
					ls_fecha			= ls_fecha+' ENERO '
				elseif ll_mes=2 then
					ls_fecha			= ls_fecha+' FEBRERO '
				elseif ll_mes=3 then
					ls_fecha			= ls_fecha+' MARZO '
				elseif ll_mes=4 then
					ls_fecha			= ls_fecha+' ABRIL '
				elseif ll_mes=5 then
					ls_fecha			= ls_fecha+' MAYO '
				elseif ll_mes=6 then
					ls_fecha			= ls_fecha+' JUNIO '
				elseif ll_mes=7 then
					ls_fecha			= ls_fecha+' JULIO '
				elseif ll_mes=8 then
					ls_fecha			= ls_fecha+' AGOSTO '
				elseif ll_mes=9 then
					ls_fecha			= ls_fecha+' SEPTIEMBRE '
				elseif ll_mes=10 then
					ls_fecha			= ls_fecha+' OCTUBRE '
				elseif ll_mes=11 then
					ls_fecha			= ls_fecha+' NOVIEMBRE '
				elseif ll_mes=12 then
					ls_fecha			= ls_fecha+' DICIEMBRE '
				end if
				ls_fecha				= ls_fecha+string(ll_anno)
				ls_hora_dep			= string(dw_lista.getitemnumber(il_row,'hora'),'00')+':'+string(dw_lista.getitemnumber(il_row,'minutos'),'00')
				SELECT	Count("OBITUARIO"."NOMBRE_FALL")  
				INTO 		:ll_count  
				FROM 		"OBITUARIO"  
				WHERE  (("OBITUARIO"."FECHA" = :ls_fecha ) AND  
						 ( "OBITUARIO"."NOMBRE_FALL" = :ls_nom_fall )) OR 
						 ( "OBITUARIO"."NOMBRE_FALL" = :ls_nom_fall )  
				USING		sqlca;
				if ll_count=0 or isnull(ll_count) then
					ll_res	= messagebox("Advertencia","Está Seguro de Ingresar Horario a OBITUARIO",Exclamation!,YesNo!,2)
					if ll_res=1 then
						SELECT "TASA"."LOOK"  INTO :gdt_fec_sistema  FROM "TASA"  WHERE "TASA"."LOOK" = 1   ;
						SELECT 	MAX("OBITUARIO"."CORRELATIVO")  
						INTO 		:ll_correlatico  
						FROM 		"OBITUARIO"  
						USING		sqlca;
						if isnull(ll_correlatico) or ll_correlatico=0 then
							ll_correlatico	= 1
						else
							ll_correlatico ++
						end if
						ls_loghora		= mid(string(gdt_fec_sistema),12)
						
						SELECT	"BASE_PLANI"."AREA" 
						INTO 		:ls_area 
						FROM 		"BASE_PLANI"
						WHERE  ( "BASE_PLANI"."COD_PARQUE" = :ll_cod_parque ) AND  
								 ( "BASE_PLANI"."SECTOR" = :ls_sector )   
						USING		sqlca;
						if sqlca.sqlcode=0 then
							
							INSERT INTO "OBITUARIO"  
										( "FECHA",		"NOMBRE_FALL",	"HORA_SEP",	"AREA",			"SECTOR",	"SEPULTURA",	"IP",			"LOG_NICK",	"LOGHORA",		"COD_PARQUE",		"FECHA_SYS",		"CORRELATIVO" ) 
							VALUES 	( :ls_fecha,	:ls_nom_fall,	:ls_area,	:ls_hora_dep,	:ls_sector,	:ls_sepultura,	:gs_tcp_ip,	:gs_user,	:ls_loghora,	:ll_cod_parque,	:gdt_fec_sistema,	:ll_correlatico )  
							USING		sqlca;
							if sqlca.sqlcode=0 then
								commit;
								messagebox("Grabar Obituario","Grabación Exitosa")
							else
								Rollback;
								messagebox("Error Grabar Obituario","Error al Grabar Obituario SQL: "+sqlca.sqlerrtext)
							end if
						else
							messagebox("Advertencia","No Registra Area")
						end if
					end if
				else
					messagebox("Advertencia","Fallecido ya Existe en Obituario")
				end if
			else
				messagebox("Advertencia","Debe Ingresar Horario Funeral")
			end if
		else
			messagebox("Advertencia","Debe Seleccionar UN Registro")
		end if
	else
		if isnull(ls_nom_fall) or mid(ls_nom_fall,1,1)='-' or ls_nom_fall='' then
			messagebox("Advertencia","Debe Ingresar NOMBRE FALLECIDO")
		elseif ll_cod_parque=0 or isnull(ll_cod_parque) then
			messagebox("Advertencia","Debe Ingresar PARQUE")
		elseif isnull(ls_sector) or ls_sector<>'-' or ls_sector='' then
			messagebox("Advertencia","Debe Ingresar SECTOR")
		elseif isnull(ls_sepultura) or ls_sepultura<>'-' or ls_sepultura='' then
			messagebox("Advertencia","Debe Ingresar SEPULTURA")
		end if
	end if
end if
end event

