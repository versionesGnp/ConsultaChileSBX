			ls_base_des,ls_ciudad_ori,ls_ciudad_des,ls_sector_des,ls_tipo_ficha,ls_estado_reg
datetime	ldt_fecha_sepult
datawindowchild	idw_detalle_55,idw_detalle6,idw_detalle7,idw_detalle8,idw_detalle9,idw_detalle10,&
						idw_detalle11	//,idw_detalle12,idw_detalle13,idw_detalle14

//il_row						= dw_lista.getrow()
if dw_lista.rowcount()>0 and il_row>0 then
	ls_tipo_ficha			= dw_lista.getitemstring(il_row,'c_tipo_ficha')
