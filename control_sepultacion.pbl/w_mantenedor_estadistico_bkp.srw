event open;Long	ll_parque,ll_count_usuario

Connect Using Trans_1;
gf_centrar(w_mantenedor_estadistico)
dw_lista.settransobject(sqlca)
dw_parque.settransobject(sqlca)
SELECT	COUNT("FICHA_USUARIO_ESTADISTICO"."USUARIO")  
INTO 		:ll_count_usuario  
FROM 		"FICHA_USUARIO_ESTADISTICO"  
WHERE  ( "FICHA_USUARIO_ESTADISTICO"."ESTADO" = 'A' ) AND  
		 ( "FICHA_USUARIO_ESTADISTICO"."USUARIO" = :gs_user )   
USING		sqlca;
if ll_count_usuario=1 then
	is_usuario_esta	= 'S'
else
	is_usuario_esta	= 'N'
end if
em_fec_ini.text	= string(gdt_fec_sistema,'dd/mm/yyyy')
em_fec_fin.text	= string(gdt_fec_sistema,'dd/mm/yyyy')
dw_parque.insertrow(0)
if gs_conexion	= "Parque El Prado" then
	ll_parque		= 1
elseif gs_conexion = "Parque La Foresta" then
	ll_parque		= 11
end if
dw_parque.setitem(1,'cod_parque',ll_parque)
gs_ventana	= 'w_mantenedor_estadistico'
f_valida_objeto2()
wf_limpiar_help()
end event

event mousemove;wf_limpiar_help()
end event

event close;Disconnect Using Trans_1;
end event

type pb_libro_transito from picturebutton within w_mantenedor_estadistico_bkp
event ue_mousemove pbm_mousemove
integer x = 2775
integer y = 1880
integer width = 142
integer height = 116
integer taborder = 240
integer textsize = -8
integer weight = 700
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
