			w_ingreso_ficha_sepultacion.tab_1.tabpage_2.dw_ant_titular.enabled	= false
			w_ingreso_ficha_sepultacion.tab_1.tabpage_1.dw_ant_fall.enabled		= false
			w_ingreso_ficha_sepultacion.tab_1.tabpage_4.dw_aranceles.enabled		= false
