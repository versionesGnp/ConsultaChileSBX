				else
					ls_pasa					= 'S'
				end if
			end if

		elseif ls_c_tipo_ficha='FT' then
			SELECT	"FICHA_TRASLADO"."CODIGO_EJECUTIVO",	"FICHA_TRASLADO"."FECHA_TRASLADO",	"FICHA_TRASLADO"."HORA_FIJADA",	"FICHA_TRASLADO"."CODIGO_FUNERARIA",	"FICHA_TRASLADO"."NOMBRE_FALLECIDO",	"FICHA_TRASLADO"."APELLIDO_PATERNO_FALL",	"FICHA_TRASLADO"."APELLIDO_MATERNO_FALL",	"FICHA_TRASLADO"."RUT_FALLECIDO",	"FICHA_TRASLADO"."DV_FALLECIDO",	"FICHA_TRASLADO"."COD_ESTADO_FALLECIDO",	"FICHA_TRASLADO"."REGISTRO_PASE",	"FICHA_TRASLADO"."PASE_SEPULTACION",	"FICHA_TRASLADO"."DERECHO_SEPULTACION_ORIGEN",	"FICHA_TRASLADO"."DERECHO_SEPULTACION_DESTINO",	"FICHA_TRASLADO"."CODIGO_PARENTESCO",	"FICHA_TRASLADO"."MONTO_CANCELAR_ORIGEN",	"FICHA_TRASLADO"."MONTO_CANCELAR_DESTINO",	"FICHA_TRASLADO"."BASE_ORIGEN",	"FICHA_TRASLADO"."BASE_DESTINO",	"FICHA_TRASLADO"."SERIE_ORIGEN",	"FICHA_TRASLADO"."SERIE_DESTINO",	"FICHA_TRASLADO"."NUMERO_ORIGEN",	"FICHA_TRASLADO"."NUMERO_DESTINO",	"FICHA_TRASLADO"."SECTOR_ORIGEN",	"FICHA_TRASLADO"."SECTOR_DESTINO",	"FICHA_TRASLADO"."SEPULTURA_ORIGEN",	"FICHA_TRASLADO"."SEPULTURA_DESTINO",	"FICHA_TRASLADO"."NUMERO_TECNICO_ORIGEN",	"FICHA_TRASLADO"."NUMERO_TECNICO_DESTINO",	"FICHA_TRASLADO"."NIVEL_SEPULTURA_ORIGEN",	"FICHA_TRASLADO"."NIVEL_SEPULTURA_DESTINO",	"FICHA_TRASLADO"."COD_PARQUE",	"FICHA_TRASLADO"."NOMBRE_TITULAR_ORIGEN",	"FICHA_TRASLADO"."NOMBRE_TITULAR_DESTINO",	"FICHA_TRASLADO"."APELLIDO_PAT_TITULAR_ORIGEN",	"FICHA_TRASLADO"."APELLIDO_PAT_TITULAR_DESTINO",	"FICHA_TRASLADO"."APELLIDO_MAT_TITULAR_ORIGEN",	"FICHA_TRASLADO"."APELLIDO_MAT_TITULAR_DESTINO",	"FICHA_TRASLADO"."FECHA_RECEPCION",	"FICHA_TRASLADO"."HORA_RECEPCION",	"FICHA_TRASLADO"."MINUTO_RECEPCION",	"FICHA_TRASLADO"."RUT_TITULAR_ORIGEN",	"FICHA_TRASLADO"."RUT_TITULAR_DESTINO",	"FICHA_TRASLADO"."DV_TITULAR_ORIGEN",	"FICHA_TRASLADO"."DV_TITULAR_DESTINO",	"FICHA_TRASLADO"."EDAD_FALLECIDO",	"FICHA_TRASLADO"."SEXO_FALLECIDO",	"FICHA_TRASLADO"."ESTADO_REG",	"FICHA_TRASLADO"."COD_REGISTRO_PASE",	"FICHA_TRASLADO"."REGISTRO_PASE",	"FICHA_TRASLADO"."ESTADO_CONTRATO_ORIGEN",	"FICHA_TRASLADO"."ESTADO_CONTRATO_DESTINO",	"FICHA_TRASLADO"."ANNO_PASO",	"FICHA_TRASLADO"."FECHA_PASE",	"FICHA_TRASLADO"."FECHA_DEFUNCION",	"FICHA_TRASLADO"."COD_TAMANO_CUERPO",	"FICHA_TRASLADO"."OBSERVACION_FALLECIDO",	"SW_PAGO_LIBERADO",	"TIPO_TRASLADO",		"SW_DERECHO_SEPULT"
			INTO 		:ls_codigo_ejecutivo,						:ldt_fec_sepult,							:ll_hora,								:ll_cod_funeraria,							:ls_nom_fall,									:ls_ap_pat_fall,									:ls_ap_mat_fall,									:ll_rut_fall,								:ls_dv_fall,							:ls_cod_estado_fall,								:ls_cod_reg_pase,							:ls_causa_fall,								:ldb_valor_derecho_sepult,								:ldb_valor_derecho_sepult_dest,						:ls_cod_parentesco,							:ll_monto_cancelar,								:ll_monto_cancelar_dest,							:ls_base,								:ls_base_dest,							:ls_serie,								:ls_serie_dest,							:ll_numero,									:ll_numero_dest,							:ls_sector,									:ls_sector_dest,							:ls_sepultura,									:ls_sepultura_dest,							:ls_nro_tecnico,									:ls_nro_tecnico_dest,								:ls_nivel,												:ls_nivel_dest,										:ll_cod_parque,						:ls_nom_tit,										:ls_nom_tit_dest,										:ls_ap_pat_tit,											:ls_ap_pat_tit_dest,											:ls_ap_mat_tit,											:ls_ap_mat_tit_dest,											:ldt_fec_recep,							:ll_hora_recep,							:ll_min_recep,									:ll_rut_tit,									:ll_rut_tit_dest,									:ls_dv_tit,										:ls_dv_tit_dest,								:ll_edad_fall,								:ls_sexo_fall,								:ls_estado_r,							:ls_cod_registro_pase,						:ls_inscrip_pase,							:ls_estado_ctto,										:ls_estado_ctto_dest,								:ll_anno_pase,						:ldt_fecha_pase,						:ldt_fec_fac_fall,						:ls_tamano,										:ls_obs_fall,										:ll_sw_pago_lib,		:ls_tipo_traslado,	:ll_sw_der_sepult
			FROM 		"FICHA_TRASLADO"  
			WHERE 	"FICHA_TRASLADO"."FOLIO" = :ll_corr_interno   AND
						"FICHA_TRASLADO"."COD_PARQUE" = :ll_cod_parque_ing AND
						"FICHA_TRASLADO"."SECTOR_ORIGEN" = :ls_sector_ing AND
						"FICHA_TRASLADO"."SEPULTURA_ORIGEN" = :ls_sepultura_ing AND
						"FICHA_TRASLADO"."FECHA_TRASLADO" = :ldt_fecha_sepult_ing
			USING		sqlca;
			if sqlca.sqlcode=0 then
				if isnull(ls_codigo_ejecutivo) or ls_codigo_ejecutivo='' or ls_codigo_ejecutivo='-' then
					messagebox("Advertencia","Debe Ingresar EJECUTIVO en Fila Nº "+string(il_row,'###,###,###,###,##0'))
					dw_lista.setitem(il_row,'c_estatus',1)
				elseif isnull(ldt_fec_sepult) then
					messagebox("Advertencia","Debe Ingresar FECHA TRASLADO en Fila Nº "+string(il_row,'###,###,###,###,##0'))
					dw_lista.setitem(il_row,'c_estatus',1)
				elseif isnull(ll_hora) or ll_hora=0 then
					messagebox("Advertencia","Debe Ingresar HORA FIJADA en Fila Nº "+string(il_row,'###,###,###,###,##0'))
					dw_lista.setitem(il_row,'c_estatus',1)
				elseif isnull(ll_cod_funeraria) then
					messagebox("Advertencia","Debe Ingresar FUNERARIA en Fila Nº "+string(il_row,'###,###,###,###,##0'))
					dw_lista.setitem(il_row,'c_estatus',1)			
				elseif isnull(ls_nom_fall) or ls_nom_fall='' or ls_nom_fall='-' then
					messagebox("Advertencia","Debe Ingresar NOMBRE FALLECIDO en Fila Nº "+string(il_row,'###,###,###,###,##0'))
					dw_lista.setitem(il_row,'c_estatus',1)
				elseif isnull(ls_ap_pat_fall) or ls_ap_pat_fall='' or ls_ap_pat_fall='-' then
					messagebox("Advertencia","Debe Ingresar APELLIDO PATERNO FALLECIDO en Fila Nº "+string(il_row,'###,###,###,###,##0'))
					dw_lista.setitem(il_row,'c_estatus',1)
				elseif isnull(ls_ap_mat_fall) or ls_ap_mat_fall='' then
					messagebox("Advertencia","Debe Ingresar APELLIDO MATERNO FALLECIDO en Fila Nº "+string(il_row,'###,###,###,###,##0'))
					dw_lista.setitem(il_row,'c_estatus',1)
				elseif isnull(ll_rut_fall) or ll_rut_fall=0 then
					messagebox("Advertencia","Debe Ingresar RUT FALLECIDO en Fila Nº "+string(il_row,'###,###,###,###,##0'))
					dw_lista.setitem(il_row,'c_estatus',1)
				elseif isnull(ls_dv_fall) or ls_dv_fall='' or ls_dv_fall='-' then
					messagebox("Advertencia","Debe Ingresar DIGITO VERIFICADOR FALLECIDO en Fila Nº "+string(il_row,'###,###,###,###,##0'))
					dw_lista.setitem(il_row,'c_estatus',1)
				elseif isnull(ls_cod_estado_fall) or ls_cod_estado_fall='' or ls_cod_estado_fall='-' then
					messagebox("Advertencia","Debe Ingresar ESTADO CUERPO en Fila Nº "+string(il_row,'###,###,###,###,##0'))
					dw_lista.setitem(il_row,'c_estatus',1)
				elseif isnull(ls_cod_reg_pase) or ls_cod_reg_pase='' or ls_cod_reg_pase='-' then
					messagebox("Advertencia","Debe Ingresar NUMERO REGISTRO PASE en Fila Nº "+string(il_row,'###,###,###,###,##0'))
					dw_lista.setitem(il_row,'c_estatus',1)
				elseif isnull(ls_causa_fall) or ls_causa_fall='' or ls_causa_fall='-' then
					messagebox("Advertencia","Debe Ingresar CAUSA FALLECIMIENTO en Fila Nº "+string(il_row,'###,###,###,###,##0'))
					dw_lista.setitem(il_row,'c_estatus',1)
				elseif ((isnull(ldb_valor_derecho_sepult) or ldb_valor_derecho_sepult=0) and (isnull(ldb_valor_derecho_sepult_dest) or ldb_valor_derecho_sepult_dest=0)) and ll_sw_der_sepult = 0 and ll_sw_pago_lib=1 then
					messagebox("Advertencia","Debe Ingresar VALOR DERECHO SEPULTACION en Fila Nº "+string(il_row,'###,###,###,###,##0'))
					dw_lista.setitem(il_row,'c_estatus',1)
				elseif isnull(ls_cod_parentesco) or ls_cod_parentesco='' or ls_cod_parentesco='-' then
					messagebox("Advertencia","Debe Ingresar PARENTESCO en Fila Nº "+string(il_row,'###,###,###,###,##0'))
					dw_lista.setitem(il_row,'c_estatus',1)
				elseif ((isnull(ll_monto_cancelar) or ll_monto_cancelar=0) and (isnull(ll_monto_cancelar_dest) or ll_monto_cancelar_dest=0)) and ll_sw_pago_lib=1 then
					messagebox("Advertencia","Debe Ingresar MONTO A CANCELAR en Fila Nº "+string(il_row,'###,###,###,###,##0'))
					dw_lista.setitem(il_row,'c_estatus',1)
				elseif (isnull(ls_base) or ls_base='' or ls_base='-') and (isnull(ls_base_dest) or ls_base_dest='' or ls_base_dest='-') then
					messagebox("Advertencia","Debe Ingresar BASE en Fila Nº "+string(il_row,'###,###,###,###,##0'))
					dw_lista.setitem(il_row,'c_estatus',1)
				elseif (isnull(ls_serie) or ls_serie='' or ls_serie='-') and (isnull(ls_serie_dest) or ls_serie_dest='' or ls_serie_dest='-') then
					messagebox("Advertencia","Debe Ingresar SERIE en Fila Nº "+string(il_row,'###,###,###,###,##0'))
					dw_lista.setitem(il_row,'c_estatus',1)
				elseif (isnull(ls_sector) or ls_sector='' or ls_sector='-') and (isnull(ls_sector_dest) or ls_sector_dest='' or ls_sector_dest='-') then
					messagebox("Advertencia","Debe Ingresar SECTOR en Fila Nº "+string(il_row,'###,###,###,###,##0'))
					dw_lista.setitem(il_row,'c_estatus',1)
				elseif (isnull(ls_sepultura) or ls_sepultura='' or ls_sepultura='-') and (isnull(ls_sepultura_dest) or ls_sepultura_dest='' or ls_sepultura_dest='-') then
					messagebox("Advertencia","Debe Ingresar SEPULTURA en Fila Nº "+string(il_row,'###,###,###,###,##0'))
					dw_lista.setitem(il_row,'c_estatus',1)
				elseif (isnull(ls_nro_tecnico) or ls_nro_tecnico='' or ls_nro_tecnico='-') and (isnull(ls_nro_tecnico_dest) or ls_nro_tecnico_dest='' or ls_nro_tecnico_dest='-') then
					messagebox("Advertencia","Debe Ingresar NUMERO TECNICO en Fila Nº "+string(il_row,'###,###,###,###,##0'))
					dw_lista.setitem(il_row,'c_estatus',1)
				elseif (isnull(ls_nivel) or ls_nivel='' or ls_nivel='-') and (isnull(ls_nivel_dest) or ls_nivel_dest='' or ls_nivel_dest='-') then
					messagebox("Advertencia","Debe Ingresar NIVEL en Fila Nº "+string(il_row,'###,###,###,###,##0'))
					dw_lista.setitem(il_row,'c_estatus',1)
				elseif isnull(ll_cod_parque) or ll_cod_parque=0 then
					messagebox("Advertencia","Debe Ingresar PARQUE en Fila Nº "+string(il_row,'###,###,###,###,##0'))
					dw_lista.setitem(il_row,'c_estatus',1)
				elseif (isnull(ls_nom_tit) or ls_nom_tit='' or ls_nom_tit='-') and (isnull(ls_nom_tit_dest) or ls_nom_tit_dest='' or ls_nom_tit_dest='-') then
					messagebox("Advertencia","Debe Ingresar NOMBRE TITULAR en Fila Nº "+string(il_row,'###,###,###,###,##0'))
					dw_lista.setitem(il_row,'c_estatus',1)
				elseif (isnull(ls_ap_pat_tit) or ls_ap_pat_tit='' or ls_ap_pat_tit='-') and (isnull(ls_ap_pat_tit_dest) or ls_ap_pat_tit_dest='' or ls_ap_pat_tit_dest='-') then
					messagebox("Advertencia","Debe Ingresar APELLIDO PATERNO TITULAR en Fila Nº "+string(il_row,'###,###,###,###,##0'))
					dw_lista.setitem(il_row,'c_estatus',1)
				elseif (isnull(ls_ap_mat_tit) or ls_ap_mat_tit='') and (isnull(ls_ap_mat_tit_dest) or ls_ap_mat_tit_dest='') then
					messagebox("Advertencia","Debe Ingresar APELLIDO MATERNO TITULAR en Fila Nº "+string(il_row,'###,###,###,###,##0'))
					dw_lista.setitem(il_row,'c_estatus',1)
				elseif isnull(ldt_fec_recep) then
					messagebox("Advertencia","Debe Ingresar FECHA RECEPCION en Fila Nº "+string(il_row,'###,###,###,###,##0'))
					dw_lista.setitem(il_row,'c_estatus',1)
				elseif isnull(ll_hora_recep) or ll_hora_recep=0 then
					messagebox("Advertencia","Debe Ingresar HORA RECEPCION en Fila Nº "+string(il_row,'###,###,###,###,##0'))
					dw_lista.setitem(il_row,'c_estatus',1)
				elseif isnull(ll_min_recep) then
					messagebox("Advertencia","Debe Ingresar MINUTOS RECEPCION en Fila Nº "+string(il_row,'###,###,###,###,##0'))
					dw_lista.setitem(il_row,'c_estatus',1)
				elseif (isnull(ll_rut_tit) or ll_rut_tit=0) and (isnull(ll_rut_tit_dest) or ll_rut_tit_dest=0) then
					messagebox("Advertencia","Debe Ingresar RUT TITULAR en Fila Nº "+string(il_row,'###,###,###,###,##0'))
					dw_lista.setitem(il_row,'c_estatus',1)
				elseif (isnull(ls_dv_tit) or ls_dv_tit='' or ls_dv_tit='-') and (isnull(ls_dv_tit_dest) or ls_dv_tit_dest='' or ls_dv_tit_dest='-') then
					messagebox("Advertencia","Debe Ingresar DIGITO VERIFICADOR TITULAR en Fila Nº "+string(il_row,'###,###,###,###,##0'))
					dw_lista.setitem(il_row,'c_estatus',1)
				elseif isnull(ll_edad_fall) or ll_edad_fall=0 then
					messagebox("Advertencia","Debe Ingresar EDAD FALLECIDO en Fila Nº "+string(il_row,'###,###,###,###,##0'))
					dw_lista.setitem(il_row,'c_estatus',1)
				elseif isnull(ls_sexo_fall) or ls_sexo_fall='' or ls_sexo_fall='-' then
					messagebox("Advertencia","Debe Ingresar SEXO FALLECIDO en Fila Nº "+string(il_row,'###,###,###,###,##0'))
					dw_lista.setitem(il_row,'c_estatus',1)
				elseif isnull(ls_estado_r) or ls_estado_r='' or ls_estado_r='-' then
					messagebox("Advertencia","Debe Ingresar ESTADO FICHA en Fila Nº "+string(il_row,'###,###,###,###,##0'))
					dw_lista.setitem(il_row,'c_estatus',1)
				elseif isnull(ls_cod_registro_pase) or ls_cod_registro_pase='' or ls_cod_registro_pase='-' then
					messagebox("Advertencia","Debe Ingresar OTORGADO POR en Fila Nº "+string(il_row,'###,###,###,###,##0'))
					dw_lista.setitem(il_row,'c_estatus',1)
				elseif isnull(ls_inscrip_pase) or ls_inscrip_pase='' or ls_inscrip_pase='-' then
					messagebox("Advertencia","Debe Ingresar Nº RESOLUCION en Fila Nº "+string(il_row,'###,###,###,###,##0'))
					dw_lista.setitem(il_row,'c_estatus',1)
				elseif (isnull(ls_estado_ctto) or ls_estado_ctto='' or ls_estado_ctto='-') and (isnull(ls_estado_ctto_dest) or ls_estado_ctto_dest='' or ls_estado_ctto_dest='-') then
					messagebox("Advertencia","Debe Ingresar ESTADO CONTRATO en Fila Nº "+string(il_row,'###,###,###,###,##0'))
					dw_lista.setitem(il_row,'c_estatus',1)
				elseif (isnull(ll_anno_pase) or ll_anno_pase=0) AND ls_tipo_traslado='E' then
					messagebox("Advertencia","Debe Ingresar AÑO PASE en Fila Nº "+string(il_row,'###,###,###,###,##0'))
					dw_lista.setitem(il_row,'c_estatus',1)
				elseif isnull(ldt_fecha_pase) AND ls_tipo_traslado='E' then
					messagebox("Advertencia","Debe Ingresar FECHA RESOLUCION en Fila Nº "+string(il_row,'###,###,###,###,##0'))
					dw_lista.setitem(il_row,'c_estatus',1)
				elseif isnull(ldt_fec_fac_fall) then
					messagebox("Advertencia","Debe Ingresar FECHA DEFUNCION en Fila Nº "+string(il_row,'###,###,###,###,##0'))
					dw_lista.setitem(il_row,'c_estatus',1)
				elseif isnull(ls_tamano) or ls_tamano='-' or ls_tamano='' then
					messagebox("Advertencia","Debe Ingresar TAMAÑO CUERPO FALLECIDO en Fila Nº "+string(il_row,'###,###,###,###,##0'))
					dw_lista.setitem(il_row,'c_estatus',1)
				else
					ls_pasa					= 'S'
				end if
			end if
		end if
		dw_lista.accepttext()
	end if
	if ls_pasa='S' then
		ll_corr_mensual					= this.getitemnumber(il_row,'correlativo_mensual')
		ll_corr_anual						= this.getitemnumber(il_row,'correlativo_anual')
		ll_cod_parque						= this.getitemnumber(il_row,'cod_parque')
		ls_nom_fall							= this.getitemstring(il_row,'nombre_fallecido')+' '+this.getitemstring(il_row,'ap_paterno_fall')+' '+this.getitemstring(il_row,'ap_materno_fall')
		if ll_corr_mensual>0 and ll_corr_anual>0 then
			pb_print_registro.enabled	= true
			pb_enfermedades.enabled		= true
		else
			pb_print_registro.enabled	= false
			pb_enfermedades.enabled		= false
		end if
		ldt_fecha							= this.getitemdatetime(il_row,'fecha_sepultacion')
		ll_dia								= day(date(ldt_fecha))
		ll_mes								= month(date(ldt_fecha))
		ll_anno								= year(date(ldt_fecha))
		ls_fecha								= string(ll_dia)
		if ll_mes=1 then
			ls_fecha							= ls_fecha+' ENERO '
		elseif ll_mes=2 then
			ls_fecha							= ls_fecha+' FEBRERO '
		elseif ll_mes=3 then
			ls_fecha							= ls_fecha+' MARZO '
		elseif ll_mes=4 then
			ls_fecha							= ls_fecha+' ABRIL '
		elseif ll_mes=5 then
			ls_fecha							= ls_fecha+' MAYO '
		elseif ll_mes=6 then
			ls_fecha							= ls_fecha+' JUNIO '
		elseif ll_mes=7 then
			ls_fecha							= ls_fecha+' JULIO '
		elseif ll_mes=8 then
			ls_fecha							= ls_fecha+' AGOSTO '
		elseif ll_mes=9 then
			ls_fecha							= ls_fecha+' SEPTIEMBRE '
		elseif ll_mes=10 then
			ls_fecha							= ls_fecha+' OCTUBRE '
		elseif ll_mes=11 then
			ls_fecha							= ls_fecha+' NOVIEMBRE '
		elseif ll_mes=12 then
			ls_fecha							= ls_fecha+' DICIEMBRE '
		end if
		ls_fecha								= ls_fecha+string(ll_anno)
		SELECT	Count("OBITUARIO"."FECHA")  
		INTO 		:ll_count  
		FROM 		"OBITUARIO"  
		WHERE  ( "OBITUARIO"."FECHA" = :ls_fecha ) AND  
				 ( "OBITUARIO"."NOMBRE_FALL" = :ls_nom_fall) AND
				 ( "OBITUARIO"."COD_PARQUE" = :ll_cod_parque )   
		USING		sqlca;
		if ll_count > 0 then
			pb_obituario.enabled			= false
		else
			pb_obituario.enabled			= true
		end if
		SELECT	COUNT("FALLECIDOS"."LLAVE")  
		INTO 		:ll_count  
		FROM 		"FALLECIDOS"  
		WHERE  ( "FALLECIDOS"."SECTOR" = :ls_sector ) AND  
				 ( "FALLECIDOS"."N_SEP" = :ls_sepultura ) AND  
				 ( "FALLECIDOS"."FEC_SEP" = :ldt_fec_sepult ) AND
				 ( "FALLECIDOS"."PASE" = :ls_registro_pase )
		USING		sqlca;
		if ll_count>0 then
			pb_fallecido.enabled			= false
		else
			pb_fallecido.enabled			= true
		end if
		gs_ventana							= 'w_mantenedor_estadistico'
		f_valida_objeto2()
	else
		if isnull(ldt_fec_sepult) or isnull(ll_hora) or isnull(ls_nom_fall) or isnull(ls_ap_pat_fall) or &
			isnull(ls_ap_mat_fall) or isnull(ls_base) or isnull(ls_serie) or isnull(ll_numero) or &
			isnull(ls_sector) or isnull(ls_sepultura) or isnull(ll_cod_parque) or isnull(ll_cod_parque) then
			
			pb_obituario.enabled			= false
		else
			pb_obituario.enabled			= true
		end if
		pb_print_registro.enabled		= false
		pb_enfermedades.enabled			= false
	end if
	
end if
end event

event clicked;String	ls_columna,ls_estado_reg,ls_filtro
Long		ll_tot_reg,ll_indi

ls_pasa	= 'N'
ls_columna				= dwo.name
if row>0 then
	il_row				= row
	This.SelectRow(0, FALSE)
	This.SelectRow(il_row, TRUE)
//	TriggerEvent(ue_validar_datos!)
	if isnull(ls_pasa) or ls_pasa='N' or ls_pasa='' then PostEvent("ue_validar_datos")
else
	CHOOSE CASE ls_columna
		CASE 't_marcar'
			if this.object.t_marcar.text = 'Marcar Todo' then
				ll_tot_reg					= this.rowcount()
				for ll_indi=1 to ll_tot_reg
					ls_estado_reg			= dw_lista.getitemstring(ll_indi,'estado_reg')
					if ls_estado_reg='P' then
						dw_lista.setitem(ll_indi,'c_estatus',0)
					else
						dw_lista.setitem(ll_indi,'c_estatus',1)
					end if
				next
				this.object.t_marcar.text = 'Desmarcar Todo'
			elseif this.object.t_marcar.text = 'Desmarcar Todo' then
				ll_tot_reg					= this.rowcount()
				for ll_indi=1 to ll_tot_reg
					dw_lista.setitem(ll_indi,'c_estatus',1)
				next
				this.object.t_marcar.text = 'Marcar Todo'
			end if
			
		CASE 't_blanco','t_pendiente'
			ls_filtro						= "estado_reg ='P'"
			dw_lista.SETfilter(ls_filtro)
			dw_lista.filter()
			
		CASE 't_rojo','t_anulado'
			ls_filtro						= "estado_reg ='A'"
			dw_lista.SETfilter(ls_filtro)
			dw_lista.filter()
			
		CASE 't_amarillo','t_gestionado'
			ls_filtro						= "estado_reg ='G'"
			dw_lista.SETfilter(ls_filtro)
			dw_lista.filter()
			
		CASE 't_todo'
			ls_filtro						= ""
			dw_lista.SETfilter(ls_filtro)
			dw_lista.filter()
	END CHOOSE
end if
end event

event rowfocuschanged;ls_pasa	= 'N'
if getrow()>0 and getrow() <> il_row then
	il_row		= getrow()
	This.SelectRow(0, FALSE)
	This.SelectRow(il_row, TRUE)
	if isnull(ls_pasa) or ls_pasa='N' or ls_pasa='' then PostEvent("ue_validar_datos")
end if
end event

event itemchanged;String		ls_columna,ls_nom_fall,ls_fecha,ls_ap_pat_fall,ls_ap_mat_fall,ls_base,ls_serie,&
				ls_sector,ls_sepultura
Long			ll_c_estatus,ll_corr_mensual,ll_corr_anual,ll_cod_parque,ll_dia,ll_mes,ll_anno,&
				ll_count,ll_hora,ll_numero
Datetime		ldt_fecha,ldt_fec_sepult

this.accepttext()
ls_columna										= dwo.name
if il_row > 0 then
	if ls_columna='c_estatus' then
//		if isnull(ls_pasa) or ls_pasa='N' or ls_pasa='' then PostEvent("ue_validar_datos")
	end if
end if
this.accepttext()
end event

