event ue_mousemove pbm_mousemove
event ue_validar_datos ( )
integer x = 41
integer y = 204
integer width = 3598
integer height = 1632
integer taborder = 90
string title = "none"
string dataobject = "dw_lista_fecha_estadistico"
boolean hscrollbar = true
boolean vscrollbar = true
boolean hsplitscroll = true
borderstyle borderstyle = stylelowered!
end type

event ue_mousemove;wf_limpiar_help()
end event

event ue_validar_datos;String	ls_columna,ls_estado_reg,ls_fecha,ls_c_tipo_ficha,ls_codigo_ejecutivo,ls_nom_fall,&
			ls_ap_pat_fall,ls_ap_mat_fall,ls_dv_fall,ls_cod_estado_fall,ls_pase_sepult,ls_causa_fall,&
			ls_cod_parentesco,ls_base,ls_serie,ls_sector,ls_sepultura,ls_nro_tecnico,ls_nivel,&
			ls_nom_tit,ls_ap_pat_tit,ls_ap_mat_tit,ls_dv_tit,ls_cod_est_ctto,ls_sexo_fall,ls_estado_r,&
			ls_cod_registro_pase,ls_inscrip_pase,ls_registro_pase,ls_cod_reg_pase,ls_estado_ctto,&
			ls_filtro,ls_sector_ing,ls_sepultura_ing,ls_tamano,ls_obs_fall,ls_base_dest,ls_serie_dest,&
			ls_sector_dest,ls_sepultura_dest,ls_nro_tecnico_dest,ls_nivel_dest,ls_nom_tit_dest,ls_ap_mat_tit_dest,&
			ls_ap_pat_tit_dest,ls_dv_tit_dest,ls_estado_ctto_dest,ls_tipo_traslado
Long		ll_tot_reg,ll_indi,ll_corr_mensual,ll_corr_anual,ll_dia,ll_mes,ll_anno,ll_cod_parque,&
			ll_count,ll_corr_interno,ll_hora,ll_cod_funeraria,ll_rut_fall,ll_monto_cancelar,ll_numero,&
			ll_hora_recep,ll_min_recep,ll_rut_tit,ll_edad_fall,ll_anno_pase,ll_cod_parque_ing,ll_sw_pago_lib,&
			ll_numero_dest,ll_rut_tit_dest,ll_sw_der_sepult
datetime	ldt_fecha,ldt_fec_sepult,ldt_fec_fac_fall,ldt_fec_recep,ldt_fecha_pase,ldt_fecha_sepult_ing
Double	ldb_valor_derecho_sepult,ldb_valor_derecho_sepult_dest,ll_monto_cancelar_dest

ls_columna								= dw_lista.getColumnName()
if il_row > 0 then
//	il_row								= this.getrow()
	ls_pasa								= 'N'
	This.SelectRow(0, FALSE)
	This.SelectRow(il_row, TRUE)
	ls_c_tipo_ficha					= this.getitemstring(il_row,'c_tipo_ficha')
	ll_corr_interno					= this.getitemnumber(il_row,'correlativo_interno')
	ll_cod_parque_ing					= this.getitemnumber(il_row,'cod_parque')
	ls_sector_ing						= this.getitemstring(il_row,'sector')
	ls_sepultura_ing					= this.getitemstring(il_row,'sepultura')
	ldt_fecha_sepult_ing				= this.getitemdatetime(il_row,'fecha_sepultacion')
	if ll_corr_interno>0 and not isnull(ls_c_tipo_ficha) then
		if ls_c_tipo_ficha='FS' then
			SELECT	"FICHA_SEPULTACION"."CODIGO_EJECUTIVO",	"FICHA_SEPULTACION"."FECHA_SEPULTACION",	"FICHA_SEPULTACION"."HORA",	"FICHA_SEPULTACION"."CODIGO_FUNERARIA",	"FICHA_SEPULTACION"."NOMBRE_FALLECIDO",	"FICHA_SEPULTACION"."AP_PATERNO_FALL",	"FICHA_SEPULTACION"."AP_MATERNO_FALL",	"FICHA_SEPULTACION"."FECHA_NACIMIENTO_FALL",	"FICHA_SEPULTACION"."RUT_FALLECIDO",	"FICHA_SEPULTACION"."DV_FALLECIDO",	"FICHA_SEPULTACION"."COD_ESTADO_FALL",	"FICHA_SEPULTACION"."PASE_SEPULTACION",	"FICHA_SEPULTACION"."CAUSA_FALLECIMIENTO",	"FICHA_SEPULTACION"."VALOR_DERECHO_SEPULTACION_UF",	"FICHA_SEPULTACION"."CODIGO_PARENTESCO",	"FICHA_SEPULTACION"."MONTO_CANCELAR",	"FICHA_SEPULTACION"."BASE",	"FICHA_SEPULTACION"."SERIE",	"FICHA_SEPULTACION"."NUMERO",	"FICHA_SEPULTACION"."SECTOR",	"FICHA_SEPULTACION"."SEPULTURA",	"FICHA_SEPULTACION"."NUMERO_TECNICO",	"FICHA_SEPULTACION"."NIVEL",	"FICHA_SEPULTACION"."COD_PARQUE",	"FICHA_SEPULTACION"."NOMBRE_TITULAR",	"FICHA_SEPULTACION"."AP_PATERNO_TITULAR",	"FICHA_SEPULTACION"."AP_MATERNO_TITULAR",	"FICHA_SEPULTACION"."FECHA_RECEPCION",	"FICHA_SEPULTACION"."HORA_RECEPCION",	"FICHA_SEPULTACION"."MINUTO_RECEPCION",	"FICHA_SEPULTACION"."RUT_TITULAR",	"FICHA_SEPULTACION"."DV_TITULAR",	"FICHA_SEPULTACION"."COD_ESTADO_CONTRATO",	"FICHA_SEPULTACION"."EDAD_FALLECIDO",	"FICHA_SEPULTACION"."SEXO_FALLECIDO",	"FICHA_SEPULTACION"."ESTADO_REG",	"FICHA_SEPULTACION"."COD_REGISTRO_PASE",	"FICHA_SEPULTACION"."INSCRIPCION_PASE",	"FICHA_SEPULTACION"."REGISTRO_PASE",	"FICHA_SEPULTACION"."ANNO_PASE",	"FICHA_SEPULTACION"."FECHA_PASE",	"FICHA_SEPULTACION"."COD_TAMANO_CUERPO",	"FICHA_SEPULTACION"."OBSERVACION_FALLECIDO",	"FICHA_SEPULTACION"."SW_PAGO_LIBERADO"
			INTO 		:ls_codigo_ejecutivo,							:ldt_fec_sepult,									:ll_hora,							:ll_cod_funeraria,								:ls_nom_fall,										:ls_ap_pat_fall,								:ls_ap_mat_fall,								:ldt_fec_fac_fall,									:ll_rut_fall,									:ls_dv_fall,								:ls_cod_estado_fall,							:ls_pase_sepult,									:ls_causa_fall,										:ldb_valor_derecho_sepult,										:ls_cod_parentesco,								:ll_monto_cancelar,							:ls_base,							:ls_serie,							:ll_numero,							:ls_sector,							:ls_sepultura,							:ls_nro_tecnico,								:ls_nivel,							:ll_cod_parque,							:ls_nom_tit,									:ls_ap_pat_tit,									:ls_ap_mat_tit,									:ldt_fec_recep,								:ll_hora_recep,								:ll_min_recep,										:ll_rut_tit,								:ls_dv_tit,									:ls_cod_est_ctto,										:ll_edad_fall,									:ls_sexo_fall,									:ls_estado_r,								:ls_cod_registro_pase,							:ls_inscrip_pase,									:ls_registro_pase,							:ll_anno_pase,							:ldt_fecha_pase,							:ls_tamano,											:ls_obs_fall,											:ll_sw_pago_lib
			FROM 		"FICHA_SEPULTACION"  
			WHERE 	"FICHA_SEPULTACION"."CORRELATIVO_INTERNO" = :ll_corr_interno  AND
						"FICHA_SEPULTACION"."COD_PARQUE" = :ll_cod_parque_ing AND
						"FICHA_SEPULTACION"."SECTOR" = :ls_sector_ing AND
						"FICHA_SEPULTACION"."SEPULTURA" = :ls_sepultura_ing AND
						"FICHA_SEPULTACION"."FECHA_SEPULTACION" = :ldt_fecha_sepult_ing
			USING		sqlca;
			if sqlca.sqlcode=0 then
				if isnull(ls_codigo_ejecutivo) or ls_codigo_ejecutivo='' or ls_codigo_ejecutivo='-' then
					messagebox("Advertencia","Debe Ingresar EJECUTIVO en Fila Nº "+string(il_row,'###,###,###,###,##0'))
