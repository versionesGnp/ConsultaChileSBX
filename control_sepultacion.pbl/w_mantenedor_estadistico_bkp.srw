st_generar_libro_red.visible			= false
st_generar_libro_voluntad.visible	= false
st_generar_libro_transito.visible	= true
end event

event clicked;Long		ll_parque
String	ls_string

if isvalid(w_generar_libro_maestro_sepultacion) then close(w_generar_libro_maestro_sepultacion)
ll_parque				= dw_parque.getitemnumber(1,'cod_parque')
if ll_parque > 0 then
	ls_string			= 'T'+'~t'+string(ll_parque)
	OpenWithParm(w_generar_libro_maestro_sepultacion,ls_string)
else
	messagebox("Advertencia","Debe Seleccionar Parque")
end if
end event

