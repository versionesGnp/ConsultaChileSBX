event clicked;String	ls_llave,ls_base,ls_serie,ls_sector,ls_sepultura,ls_nombre,ls_ap_pat,ls_ap_mat,&
			ls_est,ls_op,ls_dv,ls_sexo,ls_periodo,ls_pase,ls_reg_civil,ls_causa_fall,ls_enf_obl,&
			ls_funeraria,ls_boleta,ls_carta_aut,ls_rg_est,ls_n_tec,ls_nivel,ls_vta,ls_observaciones,&
			ls_estado_contrato,ls_resol_traslado_nro,ls_otorgado_por,ls_cementerio_origen,&
			ls_tipo_ficha,ls_enf_des_obl,ls_cod_reg_pase,ls_inscrip_pase,ls_tipo_traslado,&
			ls_registro_pase,ls_pasa1,ls_cod_enf_1,ls_cod_enf_2,ls_cod_enf_3,ls_cod_enf_4,ls_cod_enf_5,&
			ls_nombre_archivo
Long		ll_folio,ll_n_l,ll_n_m,ll_numero,ll_rut,ll_edad,ll_cod_parque,ll_max,ll_cod_funeraria,&
			ll_corr_interno,ll_folio_carta_aut,ll_folio_lapida,ll_cod_parque_origen,&
			ll_boleta,ll_cod_parque_desde,ll_count_parque,ll_count,ll_res,ll_imagen
Datetime	ldt_fec_sepult,ldt_fec_nac,ldt_fec_fall,ldt_fecha_pase,ldt_fecha

if dw_lista.rowcount() > 0 then
	ls_pasa1				= 'N'
	il_row				= dw_lista.getrow()
	ll_n_l				= dw_lista.getitemnumber(il_row,'correlativo_anual')
	ll_n_m				= dw_lista.getitemnumber(il_row,'correlativo_mensual')
	ll_corr_interno	= dw_lista.getitemnumber(il_row,'correlativo_interno')
	if il_row>0 then
		if ll_n_l>0 and ll_n_m>0 then
			ls_tipo_ficha	= dw_lista.getitemstring(il_row,'c_tipo_ficha')
			ll_cod_parque	= dw_lista.getitemnumber(il_row,'cod_parque')
			ls_sector		= dw_lista.getitemstring(il_row,'sector')
			ls_sepultura	= dw_lista.getitemstring(il_row,'sepultura')
			ldt_fec_sepult	= dw_lista.getitemdatetime(il_row,'fecha_sepultacion')
			ll_folio			= dw_lista.getitemnumber(il_row,'correlativo_interno')
			ls_base			= dw_lista.getitemstring(il_row,'base')
			ls_serie			= dw_lista.getitemstring(il_row,'serie')
			ll_numero		= dw_lista.getitemnumber(il_row,'numero')
			ls_nombre		= dw_lista.getitemstring(il_row,'nombre_fallecido')
			ls_ap_pat		= dw_lista.getitemstring(il_row,'ap_paterno_fall')
			ls_ap_mat		= dw_lista.getitemstring(il_row,'ap_materno_fall')
			ls_n_tec			= dw_lista.getitemstring(il_row,'numero_tecnico')
			ls_nivel			= dw_lista.getitemstring(il_row,'nivel')
			ll_rut			= dw_lista.getitemnumber(il_row,'rut_fallecido')
			ls_dv				= dw_lista.getitemstring(il_row,'dv_fallecido')
		
			if not isnull(ls_nombre) and ls_nombre<>'' and ls_nombre<>'-' and &
				not isnull(ls_ap_pat) and ls_ap_pat<>'' and ls_ap_pat<>'-' and &
				not isnull(ls_ap_mat) and ls_ap_mat<>'' and ls_ap_mat<>'-' and &
				not isnull(ldt_fec_sepult) and not isnull(ls_n_tec) and ls_n_tec<>'' and &
				ls_n_tec<>'-' and not isnull(ls_nivel) and ls_nivel<>'' and ls_nivel<>'-' then
			
				if ls_tipo_ficha='FT' then
					SELECT	"FICHA_TRASLADO"."CODIGO_FUNERARIA",	"FICHA_TRASLADO"."OBSERVACIONES_ORIGEN",	"FICHA_TRASLADO"."COD_ESTADO_FALLECIDO",	"FICHA_TRASLADO"."EDAD_FALLECIDO",	"FICHA_TRASLADO"."SEXO_FALLECIDO",	"FICHA_TRASLADO"."FECHA_NACIMIENTO_FALLECIDO",	"FICHA_TRASLADO"."PASE_SEPULTACION",	"FICHA_TRASLADO"."COD_REGISTRO_PASE",	"FICHA_TRASLADO"."INSCRIPCION_PASE",	"FICHA_TRASLADO"."REGISTRO_PASE",	"FICHA_TRASLADO"."FECHA_PASE",	"FICHA_TRASLADO"."TIPO_TRASLADO",	"FICHA_TRASLADO"."BOLETA_NRO_ORIGEN",	"FICHA_TRASLADO"."PERIODO_NACIMIENTO",	"FICHA_TRASLADO"."FECHA_DEFUNCION",	"FICHA_TRASLADO"."OBSERVACIONES_ORIGEN",	"FICHA_TRASLADO"."ESTADO_CONTRATO_ORIGEN",	"FICHA_TRASLADO"."COD_PARQUE_ORIGEN"
					INTO 		:ll_cod_funeraria,							:ls_causa_fall,									:ls_est,												:ll_edad,									:ls_sexo,									:ldt_fec_nac,												:ls_pase,										:ls_cod_reg_pase,								:ls_inscrip_pase,								:ls_registro_pase,						:ldt_fecha_pase,						:ls_tipo_traslado,						:ll_boleta,										:ls_periodo,									:ldt_fec_fall,								:ls_observaciones,								:ls_estado_contrato,									:ll_cod_parque_origen
					FROM 		"FICHA_TRASLADO"  
					WHERE  ( "FICHA_TRASLADO"."COD_PARQUE" = :ll_cod_parque ) AND  
							 ( "FICHA_TRASLADO"."FECHA_TRASLADO" = :ldt_fec_sepult ) AND  
							 ( "FICHA_TRASLADO"."SECTOR_ORIGEN" = :ls_sector ) AND  
							 ( "FICHA_TRASLADO"."SEPULTURA_ORIGEN" = :ls_sepultura ) AND  
							 ( "FICHA_TRASLADO"."FOLIO" = :ll_folio )   
					USING		sqlca;
					if sqlca.sqlcode=0 then
						if isnull(ll_cod_funeraria) or ll_cod_funeraria=0 then
							messagebox("Advertencia","En Fila Nº "+string(il_row)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar FUNERARIA" )
						elseif isnull(ls_causa_fall) or ls_causa_fall='-' then
							messagebox("Advertencia","En Fila Nº "+string(il_row)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar CAUSA FALLECIMIENTO" )
						elseif isnull(ls_est) or ls_est='-' or ls_est='' then
							messagebox("Advertencia","En Fila Nº "+string(il_row)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar ESTADO CUERPO" )
						elseif isnull(ll_edad) or ll_edad=0 then
							messagebox("Advertencia","En Fila Nº "+string(il_row)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar EDAD FALLECIDO" )
						elseif isnull(ls_sexo) or ls_sexo='-' then
							messagebox("Advertencia","En Fila Nº "+string(il_row)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar SEXO FALLECIDO" )
						elseif isnull(ldt_fec_nac) then
							messagebox("Advertencia","En Fila Nº "+string(il_row)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar FECHA NACIMIENTO FALLECIDO" )
						elseif isnull(ls_pase) or ls_pase='-' then
							messagebox("Advertencia","En Fila Nº "+string(il_row)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar PASE SEPULTACION" )
						elseif isnull(ls_cod_reg_pase) or ls_cod_reg_pase='-' then
							messagebox("Advertencia","En Fila Nº "+string(il_row)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar REGISTRO CIVIL PASE SEPULTACION" )
						elseif isnull(ls_inscrip_pase) or ls_inscrip_pase='-' then
							messagebox("Advertencia","En Fila Nº "+string(il_row)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar INSCRIPCION PASE SEPULTACION" )
						elseif isnull(ls_registro_pase) or ls_registro_pase='-' then
							messagebox("Advertencia","En Fila Nº "+string(il_row)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar NUMERO REGISTRO PASE SEPULTACION" )
						elseif isnull(ldt_fecha_pase) then
							messagebox("Advertencia","En Fila Nº "+string(il_row)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar FECHA PASE SEPULTACION" )
						elseif isnull(ll_boleta) or ll_boleta=0 then
							messagebox("Advertencia","En Fila Nº "+string(il_row)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar NUMERO COMPROBANTE DE PAGO" )
						else
							ls_pasa1	= 'S'
						end if
					end if
			
				elseif ls_tipo_ficha='FS' then
					SELECT	"FICHA_SEPULTACION"."CODIGO_FUNERARIA",	"FICHA_SEPULTACION"."FECHA_DEFUNCION",	"FICHA_SEPULTACION"."CAUSA_FALLECIMIENTO",	"FICHA_SEPULTACION"."PASE_SEPULTACION",	"FICHA_SEPULTACION"."EDAD_FALLECIDO",	"FICHA_SEPULTACION"."SEXO_FALLECIDO",	"FICHA_SEPULTACION"."COD_REGISTRO_PASE",	"FICHA_SEPULTACION"."INSCRIPCION_PASE",	"FICHA_SEPULTACION"."REGISTRO_PASE",	"FICHA_SEPULTACION"."FECHA_PASE",	"FICHA_SEPULTACION"."COD_ESTADO_FALL",	"FICHA_SEPULTACION"."COD_PARQUE_DESDE",	"FICHA_SEPULTACION"."FECHA_NACIMIENTO_FALL",	"FICHA_SEPULTACION"."FOLIO_COMPROBANTE",	"FICHA_SEPULTACION"."PERIODO_NACIMIENTO",	"FICHA_SEPULTACION"."OBSERVACION_SEPULTURA_COMPLETA",	"FICHA_SEPULTACION"."COD_ESTADO_CONTRATO",	"FICHA_SEPULTACION"."REGISTRO_PASE"
					INTO 		:ll_cod_funeraria,								:ldt_fec_fall,									:ls_causa_fall,										:ls_pase,											:ll_edad,										:ls_sexo,										:ls_cod_reg_pase,									:ls_inscrip_pase,									:ls_resol_traslado_nro,						:ldt_fecha_pase,							:ls_est,											:ll_cod_parque_desde,							:ldt_fec_nac,											:ll_boleta,											:ls_periodo,										:ls_observaciones,												:ls_estado_contrato,									:ls_registro_pase
					FROM 		"FICHA_SEPULTACION"  
					WHERE  ( "FICHA_SEPULTACION"."FECHA_SEPULTACION" = :ldt_fec_sepult ) AND  
							 ( "FICHA_SEPULTACION"."SECTOR" = :ls_sector ) AND  
							 ( "FICHA_SEPULTACION"."SEPULTURA" = :ls_sepultura ) AND  
							 ( "FICHA_SEPULTACION"."CORRELATIVO_INTERNO" = :ll_folio ) 
					USING		sqlca;
					if sqlca.sqlcode=0 then
						if isnull(ll_cod_funeraria) or ll_cod_funeraria=0 then
							messagebox("Advertencia","En Fila Nº "+string(il_row)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar FUNERARIA")
						elseif isnull(ldt_fec_fall) then
							messagebox("Advertencia","En Fila Nº "+string(il_row)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar FECHA DEFUNCION")
						elseif isnull(ls_causa_fall) or ls_causa_fall='' or ls_causa_fall='-' then
							messagebox("Advertencia","En Fila Nº "+string(il_row)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar CAUSA FALLECIMIENTO" )
						elseif isnull(ls_pase) or ls_pase='' or ls_pase='-' then
							messagebox("Advertencia","En Fila Nº "+string(il_row)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar NUMERO PASE SEPULTACION" )
						elseif isnull(ll_edad) or ll_edad=0 then
							messagebox("Advertencia","En Fila Nº "+string(il_row)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar EDAD FALLECIDO" )
						elseif isnull(ls_sexo) or ls_sexo='' or ls_sexo='-' then
							messagebox("Advertencia","En Fila Nº "+string(il_row)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar SEXO FALLECIDO" )
						elseif isnull(ls_cod_reg_pase) or ls_cod_reg_pase='' or ls_cod_reg_pase='-' then
							messagebox("Advertencia","En Fila Nº "+string(il_row)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar REGISTRO CIVIL PASE SEPULTACION" )
						elseif isnull(ls_inscrip_pase) or ls_inscrip_pase='' or ls_inscrip_pase='-' then
							messagebox("Advertencia","En Fila Nº "+string(il_row)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar INSCRIPCION PASE SEPULTACION" )
						elseif isnull(ls_registro_pase) or ls_registro_pase='' or ls_registro_pase='-' then
							messagebox("Advertencia","En Fila Nº "+string(il_row)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar NUMERO REGISTRO PASE SEPULTACION" )
						elseif isnull(ldt_fecha_pase) then
							messagebox("Advertencia","En Fila Nº "+string(il_row)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar FECHA PASE SEPULTACION" )
						elseif isnull(ls_est) or ls_est='' or ls_est='-' then
							messagebox("Advertencia","En Fila Nº "+string(il_row)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar ESTADO CUERPO" )
						elseif isnull(ldt_fec_nac) then 
							messagebox("Advertencia","En Fila Nº "+string(il_row)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar FECHA NACIMIENTO FALLECIDO" )
						elseif isnull(ll_boleta) or ll_boleta=0 then
							messagebox("Advertencia","En Fila Nº "+string(il_row)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar NUMERO COMPROBANTE DE PAGO" )
						else
							ls_pasa1	= 'S'
						end if
					end if
				end if
				if ls_pasa1='S' then
					if ls_tipo_ficha='FS' then
						dw_print_ficha.dataobject	= 'dw_ingreso_ficha_print'
						dw_print_ficha.settransobject(sqlca)
						dw_print_ficha.reset()
						dw_print_ficha.getchild('codigo_parentesco',idw_detalle4)
						idw_detalle4.settransobject(sqlca)
						idw_detalle4.retrieve(ll_cod_parque)
						dw_print_ficha.retrieve(ll_cod_parque,ls_sector,ls_sepultura,ldt_fec_sepult)
						if dw_print_ficha.rowcount() > 0 then 
							f_Print( dw_print_ficha )
						end if
	
					elseif ls_tipo_ficha='FT' then
						dw_print_ficha.dataobject	= 'dw_ingreso_traslado_print'
						dw_print_ficha.settransobject(sqlca)
						dw_print_ficha.reset()
						dw_print_ficha.getchild('codigo_parentesco',idw_detalle4)
						idw_detalle4.settransobject(sqlca)
						idw_detalle4.retrieve(ll_cod_parque)
						dw_print_ficha.retrieve(ll_cod_parque,ls_sector,ls_sepultura,ldt_fec_sepult)
						if dw_print_ficha.rowcount() > 0 then 
							f_Print( dw_print_ficha )
						end if
					end if
					
					dw_print_ficha.dataobject	= 'dw_imprimir_registro_sepultacion'
					dw_print_ficha.settransobject(sqlca)
					dw_print_ficha.reset()
					if dw_print_ficha.retrieve(ll_n_m,ll_n_l,ll_cod_parque)>0 then
						dw_print_ficha.print()
					else
						messagebox("Advertencia","No fue Posible Imprimir Registro Estadístico")
					end if
					
					dw_print_ficha.dataobject	= 'dw_ingresar_enfermedad_obligatoria'
					dw_print_ficha.settransobject(sqlca)
					dw_print_ficha.reset()
					if dw_print_ficha.retrieve(ll_n_m,ll_n_l,ll_cod_parque)>0 then
						ls_cod_enf_2	= dw_print_ficha.getitemstring(1,'cod_enfermedad_2')
						ls_cod_enf_3	= dw_print_ficha.getitemstring(1,'cod_enfermedad_3')
						ls_cod_enf_4	= dw_print_ficha.getitemstring(1,'cod_enfermedad_4')
						ls_cod_enf_5	= dw_print_ficha.getitemstring(1,'cod_enfermedad_5')
						if isnull(ls_cod_enf_1) or ls_cod_enf_1='' then
							dw_print_ficha.object.cod_enfermedad_1.visible	= false
							dw_print_ficha.object.t_uno.visible					= false
						end if
						if isnull(ls_cod_enf_2) or ls_cod_enf_2='' then
							dw_print_ficha.object.cod_enfermedad_2.visible	= false
							dw_print_ficha.object.t_dos.visible					= false
						end if
						if isnull(ls_cod_enf_3) or ls_cod_enf_3='' then
							dw_print_ficha.object.cod_enfermedad_3.visible	= false
							dw_print_ficha.object.t_tres.visible				= false
						end if
						if isnull(ls_cod_enf_4) or ls_cod_enf_4='' then
							dw_print_ficha.object.cod_enfermedad_4.visible	= false
							dw_print_ficha.object.t_cuatro.visible				= false
						end if
						if isnull(ls_cod_enf_5) or ls_cod_enf_5='' then
							dw_print_ficha.object.cod_enfermedad_5.visible	= false
							dw_print_ficha.object.t_cinco.visible				= false
						end if
						dw_print_ficha.print()
					end if
					dw_print_ficha.dataobject	= 'dw_solicitud_grabacion_lapida_print'
					dw_print_ficha.settransobject(sqlca)
					dw_print_ficha.reset()
					SELECT	"FICHA_CARTA_SEPULTACION"."FECHA_CARTA"  
					INTO 		:ldt_fecha  
					FROM 		"FICHA_CARTA_SEPULTACION"  
					WHERE  ( "FICHA_CARTA_SEPULTACION"."SECTOR" = :ls_sector ) AND  
							 ( "FICHA_CARTA_SEPULTACION"."SEPULTURA" = :ls_sepultura ) AND  
							 ( "FICHA_CARTA_SEPULTACION"."COD_PARQUE" = :ll_cod_parque ) AND  
							 ( "FICHA_CARTA_SEPULTACION"."CORRELATIVO" = :ll_corr_interno )   
					USING		sqlca;
					if sqlca.sqlcode=0 then
						if dw_print_ficha.retrieve(ls_sector,ls_sepultura,ll_cod_parque,ldt_fecha,ll_corr_interno)>0 then
							ll_imagen	= dw_print_ficha.getitemnumber(1,'codigo_imagen')
							SELECT	"FICHA_CUNOS"."NOMBRE_ARCHIVO"  
							INTO 		:ls_nombre_archivo  
							FROM 		"FICHA_CUNOS"  
							WHERE 	"FICHA_CUNOS"."CODIGO" = :ll_imagen   
							USING		sqlca;
							if sqlca.sqlcode=0 then
								dw_print_ficha.object.p_1.Filename 	= ls_nombre_archivo
							else
								dw_print_ficha.object.p_1.Filename 	= ''
							end if
							dw_print_ficha.print()
						end if
					else
						messagebox("Advertencia","No fue Posible Imprimir Carta Autorización & Solicitud Grabación de Lápida")
					end if
				end if
			else
				if isnull(ls_nombre) or ls_nombre='' or ls_nombre='-' then
					messagebox("Advertencia","En Fila Nº "+string(il_row)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar NOMBRE FALLECIDO" )
				elseif isnull(ls_ap_pat) or ls_ap_pat='' or ls_ap_pat='-' then
					messagebox("Advertencia","En Fila Nº "+string(il_row)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar APELLIDO PATERNO FALLECIDO" )
				elseif isnull(ls_ap_mat) or ls_ap_mat='' or ls_ap_mat='-' then
					messagebox("Advertencia","En Fila Nº "+string(il_row)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar APELLIDO MATERNO FALLECIDO" )
				elseif isnull(ls_n_tec) or ls_n_tec='' or ls_n_tec='-' then
					messagebox("Advertencia","En Fila Nº "+string(il_row)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar NUMERO TECNICO" )
				elseif isnull(ldt_fec_sepult)  then
					messagebox("Advertencia","En Fila Nº "+string(il_row)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar FECHA SEPULTACION" )
				elseif isnull(ls_nivel) or ls_nivel='' or ls_nivel='-' then
					messagebox("Advertencia","En Fila Nº "+string(il_row)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar NIVEL" )
				end if
			end if
		else
			messagebox("Advertencia","Debe Generar Registro")
		end if
	end if
end if
end event

type pb_fallecido from picturebutton within w_mantenedor_estadistico_bkp
event ue_mousemove pbm_mousemove
integer x = 1175
integer y = 1880
integer width = 142
integer height = 116
integer taborder = 170
integer textsize = -8
integer weight = 700
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string picturename = "ver_institucion.bmp"
string disabledname = "ver_institucion_no.bmp"
alignment htextalign = left!
end type

event ue_mousemove;st_registro.visible						= false
st_print_registro.visible				= false
st_ver_ficha.visible						= false
st_ver_carta.visible						= false
st_ver_lapida.visible					= false
st_ingresar_obligatoria.visible		= false
st_generar_libro.visible				= false
st_obituario.visible						= false
st_fallecido.visible						= true
st_print.visible							= false
st_print_proveedor.visible				= false
st_mantenedor.visible					= false
st_actualizar.visible					= false
st_generar_libro_exh_tras.visible	= false
st_generar_libro_red.visible			= false
st_generar_libro_voluntad.visible	= false
st_generar_libro_transito.visible	= false
end event

event clicked;String	ls_llave,ls_base,ls_serie,ls_sector,ls_sepultura,ls_nombre,ls_ap_pat,ls_ap_mat,&
			ls_est,ls_op,ls_dv,ls_sexo,ls_periodo,ls_pase,ls_reg_civil,ls_causa_fall,ls_enf_obl,&
			ls_funeraria,ls_boleta,ls_carta_aut,ls_rg_est,ls_n_tec,ls_nivel,ls_vta,ls_observaciones,&
			ls_estado_contrato,ls_resol_traslado_nro,ls_otorgado_por,ls_cementerio_origen,&
			ls_tipo_ficha,ls_enf_des_obl,ls_cod_reg_pase,ls_inscrip_pase,ls_tipo_traslado,&
			ls_registro_pase,ls_pasa1,ls_estado_tit,ls_sector_des,ls_sepult_des,ls_base_des,&
			ls_serie_des,ls_nro_tec_des,ls_nivel_des,ls_destino_parque,ls_nro_tecnico,ls_causa_fall_des,&
			ls_estado_contrato_des
Long		ll_folio,ll_n_l,ll_n_m,ll_numero,ll_rut,ll_edad,ll_cod_parque,ll_max,ll_cod_funeraria,&
			ll_corr_interno,ll_folio_carta_aut,ll_folio_lapida,ll_cod_parque_origen,ll_rg,&
			ll_boleta,ll_cod_parque_desde,ll_count_parque,ll_count,ll_res,ll_sw_liberado,ll_corr_hist_reg,&
			ll_cod_parque_des,ll_numero_des,ll_cap_des,ll_boleta_des,ll_cap
Datetime	ldt_fec_sepult,ldt_fec_nac,ldt_fec_fall,ldt_fecha_pase

if dw_lista.rowcount() > 0 then
	ls_pasa1					= 'N'
	ll_res					= 1
	ll_rg						= 0
//	il_row					= dw_lista.getrow()
	ll_n_l					= dw_lista.getitemnumber(il_row,'correlativo_anual')
	ll_n_m					= dw_lista.getitemnumber(il_row,'correlativo_mensual')
	ll_corr_interno		= dw_lista.getitemnumber(il_row,'correlativo_interno')
	if il_row > 0 then
		if ll_n_l=0 or ll_n_m=0 or isnull(ll_n_l) or isnull(ll_n_m) then
			ll_res			= messagebox("Advertencia","Recuerde No Está Generado Registro Estadístico, desea Crear Fallecido",Exclamation!,YesNo!,2)
			ll_rg ++
		end if
		if ll_res = 1 then
			
			ls_tipo_ficha	= dw_lista.getitemstring(il_row,'c_tipo_ficha')
			ll_cod_parque	= dw_lista.getitemnumber(il_row,'cod_parque')
			ls_sector		= dw_lista.getitemstring(il_row,'sector')
			ls_sepultura	= dw_lista.getitemstring(il_row,'sepultura')
			ldt_fec_sepult	= dw_lista.getitemdatetime(il_row,'fecha_sepultacion')
			ll_folio			= dw_lista.getitemnumber(il_row,'correlativo_interno')
			ls_tipo_ficha	= dw_lista.getitemstring(il_row,'c_tipo_ficha')
			ls_base			= dw_lista.getitemstring(il_row,'base')
			ls_serie			= dw_lista.getitemstring(il_row,'serie')
			ll_numero		= dw_lista.getitemnumber(il_row,'numero')
			ls_nombre		= dw_lista.getitemstring(il_row,'nombre_fallecido')
			ls_ap_pat		= dw_lista.getitemstring(il_row,'ap_paterno_fall')
			ls_ap_mat		= dw_lista.getitemstring(il_row,'ap_materno_fall')
			ls_n_tec			= dw_lista.getitemstring(il_row,'numero_tecnico')
			ls_nivel			= dw_lista.getitemstring(il_row,'nivel')
			ll_rut			= dw_lista.getitemnumber(il_row,'rut_fallecido')
			ls_dv				= dw_lista.getitemstring(il_row,'dv_fallecido')
			ll_sw_liberado	= dw_lista.getitemnumber(il_row,'sw_pago_liberado')
//			SELECT	"FICHA_REGISTRO"."CORRELATIVO_INTERNO"  
//			INTO 		:ll_corr  
//			FROM 		"FICHA_REGISTRO"  
//			WHERE  ( "FICHA_REGISTRO"."CORRELATIVO_MENSUAL" = :ll_mensual ) AND  
//					 ( "FICHA_REGISTRO"."CORRELATIVO_ANUAL" = :ll_anual ) AND  
//					 ( "FICHA_REGISTRO"."COD_PARQUE" = :ll_cod_parque )   ;

			if not isnull(ls_nombre) and ls_nombre<>'' and ls_nombre<>'-' and &
				not isnull(ls_ap_pat) and ls_ap_pat<>'' and ls_ap_pat<>'-' and &
				not isnull(ls_ap_mat) and ls_ap_mat<>'' and ls_ap_mat<>'-' and &
				not isnull(ldt_fec_sepult) then
			
				if ls_tipo_ficha='FT' then
					SELECT	"FICHA_TRASLADO"."CODIGO_FUNERARIA",	"FICHA_TRASLADO"."OBSERVACIONES_ORIGEN",	"FICHA_TRASLADO"."COD_ESTADO_FALLECIDO",	"FICHA_TRASLADO"."EDAD_FALLECIDO",	"FICHA_TRASLADO"."SEXO_FALLECIDO",	"FICHA_TRASLADO"."FECHA_NACIMIENTO_FALLECIDO",	"FICHA_TRASLADO"."PASE_SEPULTACION",	"FICHA_TRASLADO"."COD_REGISTRO_PASE",	"FICHA_TRASLADO"."INSCRIPCION_PASE",	"FICHA_TRASLADO"."REGISTRO_PASE",	"FICHA_TRASLADO"."FECHA_PASE",	"FICHA_TRASLADO"."TIPO_TRASLADO",	"FICHA_TRASLADO"."BOLETA_NRO_ORIGEN",	"FICHA_TRASLADO"."PERIODO_NACIMIENTO",	"FICHA_TRASLADO"."FECHA_DEFUNCION",	"FICHA_TRASLADO"."OBSERVACIONES_ORIGEN",	"FICHA_TRASLADO"."ESTADO_CONTRATO_ORIGEN",	"FICHA_TRASLADO"."COD_PARQUE_ORIGEN",	"FICHA_TRASLADO"."COD_PARQUE_DESTINO",	"FICHA_TRASLADO"."SECTOR_DESTINO",	"FICHA_TRASLADO"."SEPULTURA_DESTINO",	"FICHA_TRASLADO"."BASE_DESTINO",	"FICHA_TRASLADO"."SERIE_DESTINO",	"FICHA_TRASLADO"."NUMERO_DESTINO",	"FICHA_TRASLADO"."NUMERO_TECNICO_DESTINO",	"FICHA_TRASLADO"."NIVEL_SEPULTURA_DESTINO",	"FICHA_TRASLADO"."BOLETA_NRO_DESTINO",	"FICHA_TRASLADO"."CAPACIDAD_DESTINO",	"FICHA_TRASLADO"."TIPO_TRASLADO",	"FICHA_TRASLADO"."DESTINO_PARQUE",	"FICHA_TRASLADO"."OBSERVACIONES_DESTINO",	"FICHA_TRASLADO"."ESTADO_CONTRATO_DESTINO",	"FICHA_TRASLADO"."NUMERO_TECNICO_ORIGEN",	"FICHA_TRASLADO"."NUMERO_TECNICO_DESTINO"
					INTO 		:ll_cod_funeraria,							:ls_causa_fall,									:ls_est,												:ll_edad,									:ls_sexo,									:ldt_fec_nac,												:ls_pase,										:ls_cod_reg_pase,								:ls_inscrip_pase,								:ls_registro_pase,						:ldt_fecha_pase,						:ls_tipo_traslado,						:ll_boleta,										:ls_periodo,									:ldt_fec_fall,								:ls_observaciones,								:ls_estado_contrato,									:ll_cod_parque_origen,						:ll_cod_parque_des,							:ls_sector_des,							:ls_sepult_des,								:ls_base_des,							:ls_serie_des,								:ll_numero_des,							:ls_nro_tec_des,										:ls_nivel_des,											:ll_boleta_des,								:ll_cap_des,									:ls_tipo_traslado,						:ls_destino_parque,						:ls_causa_fall_des,								:ls_estado_contrato_des,							:ls_n_tec,											:ls_nro_tec_des
					FROM 		"FICHA_TRASLADO"  
					WHERE  ( "FICHA_TRASLADO"."COD_PARQUE" = :ll_cod_parque ) AND  
							 ( "FICHA_TRASLADO"."FECHA_TRASLADO" = :ldt_fec_sepult ) AND  
							 ( "FICHA_TRASLADO"."SECTOR_ORIGEN" = :ls_sector ) AND  
							 ( "FICHA_TRASLADO"."SEPULTURA_ORIGEN" = :ls_sepultura ) AND  
							 ( "FICHA_TRASLADO"."FOLIO" = :ll_folio )   
					USING		sqlca;
					if sqlca.sqlcode=0 then
						if (ls_tipo_traslado='I') or (ls_tipo_traslado='E' and ls_destino_parque='E') then
//							ll_cod_parque			= ll_cod_parque_des
							ls_sector				= ls_sector_des
							ls_sepultura			= ls_sepult_des
							ls_base					= ls_base_des
							ls_serie					= ls_serie_des
							ll_numero				= ll_numero_des
							ls_n_tec					= ls_nro_tec_des
							ll_cap					= ll_cap_des
							ls_nivel					= ls_nivel_des
							ll_boleta				= ll_boleta_des
							ls_causa_fall			= ls_causa_fall_des
							ls_estado_contrato	= ls_estado_contrato_des
						end if
						
						if isnull(ll_cod_funeraria) then
							messagebox("Advertencia","En Fila Nº "+string(il_row)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar FUNERARIA" )
						elseif isnull(ls_causa_fall) or ls_causa_fall='-' then
							messagebox("Advertencia","En Fila Nº "+string(il_row)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar CAUSA FALLECIMIENTO" )
						elseif isnull(ls_est) or ls_est='-' or ls_est='' then
							messagebox("Advertencia","En Fila Nº "+string(il_row)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar ESTADO CUERPO" )
						elseif isnull(ll_edad) or ll_edad=0 then
							messagebox("Advertencia","En Fila Nº "+string(il_row)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar EDAD FALLECIDO" )
						elseif isnull(ls_sexo) or ls_sexo='-' then
							messagebox("Advertencia","En Fila Nº "+string(il_row)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar SEXO FALLECIDO" )
						elseif isnull(ldt_fec_nac) then
							messagebox("Advertencia","En Fila Nº "+string(il_row)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar FECHA NACIMIENTO FALLECIDO" )
						elseif isnull(ls_cod_reg_pase) or ls_cod_reg_pase='-' then
							messagebox("Advertencia","En Fila Nº "+string(il_row)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar OTORGADO POR" )
						elseif isnull(ls_estado_contrato) or ls_estado_contrato='-' then
							messagebox("Advertencia","En Fila Nº "+string(il_row)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar ESTADO CONTRATO" )
						elseif (isnull(ls_registro_pase) or ls_registro_pase='-') and ls_tipo_traslado='E' then
							messagebox("Advertencia","En Fila Nº "+string(il_row)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar NUMERO RESOLUCION" )
						elseif isnull(ldt_fecha_pase) and ls_tipo_traslado='E' then
							messagebox("Advertencia","En Fila Nº "+string(il_row)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar FECHA PASE SEPULTACION" )
//						elseif isnull(ll_boleta) or ll_boleta=0 then
//							messagebox("Advertencia","En Fila Nº "+string(il_row)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar NUMERO COMPROBANTE DE PAGO" )
						else
							ls_pasa1	= 'S'
						end if
					end if
			
				elseif ls_tipo_ficha='FS' then
					SELECT	"FICHA_SEPULTACION"."CODIGO_FUNERARIA",	"FICHA_SEPULTACION"."FECHA_DEFUNCION",	"FICHA_SEPULTACION"."CAUSA_FALLECIMIENTO",	"FICHA_SEPULTACION"."PASE_SEPULTACION",	"FICHA_SEPULTACION"."EDAD_FALLECIDO",	"FICHA_SEPULTACION"."SEXO_FALLECIDO",	"FICHA_SEPULTACION"."COD_REGISTRO_PASE",	"FICHA_SEPULTACION"."INSCRIPCION_PASE",	"FICHA_SEPULTACION"."REGISTRO_PASE",	"FICHA_SEPULTACION"."FECHA_PASE",	"FICHA_SEPULTACION"."COD_ESTADO_FALL",	"FICHA_SEPULTACION"."COD_PARQUE_DESDE",	"FICHA_SEPULTACION"."FECHA_NACIMIENTO_FALL",	"FICHA_SEPULTACION"."FOLIO_COMPROBANTE",	"FICHA_SEPULTACION"."PERIODO_NACIMIENTO",	"FICHA_SEPULTACION"."OBSERVACION_SEPULTURA_COMPLETA",	"FICHA_SEPULTACION"."COD_ESTADO_CONTRATO",	"FICHA_SEPULTACION"."REGISTRO_PASE"
					INTO 		:ll_cod_funeraria,								:ldt_fec_fall,									:ls_causa_fall,										:ls_pase,											:ll_edad,										:ls_sexo,										:ls_cod_reg_pase,									:ls_inscrip_pase,									:ls_resol_traslado_nro,						:ldt_fecha_pase,							:ls_est,											:ll_cod_parque_desde,							:ldt_fec_nac,											:ll_boleta,											:ls_periodo,										:ls_observaciones,												:ls_estado_contrato,									:ls_registro_pase
					FROM 		"FICHA_SEPULTACION"  
					WHERE  ( "FICHA_SEPULTACION"."FECHA_SEPULTACION" = :ldt_fec_sepult ) AND  
							 ( "FICHA_SEPULTACION"."SECTOR" = :ls_sector ) AND  
							 ( "FICHA_SEPULTACION"."SEPULTURA" = :ls_sepultura ) AND  
							 ( "FICHA_SEPULTACION"."CORRELATIVO_INTERNO" = :ll_folio ) 
					USING		sqlca;
					if sqlca.sqlcode=0 then
						if isnull(ll_cod_funeraria) then
							messagebox("Advertencia","En Fila Nº "+string(il_row)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar FUNERARIA")
						elseif isnull(ldt_fec_fall) then
							messagebox("Advertencia","En Fila Nº "+string(il_row)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar FECHA DEFUNCION")
						elseif isnull(ls_causa_fall) or ls_causa_fall='' or ls_causa_fall='-' then
							messagebox("Advertencia","En Fila Nº "+string(il_row)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar CAUSA FALLECIMIENTO" )
						elseif isnull(ls_pase) or ls_pase='' or ls_pase='-' then
							messagebox("Advertencia","En Fila Nº "+string(il_row)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar NUMERO PASE SEPULTACION" )
						elseif isnull(ll_edad) or ll_edad=0 then
							messagebox("Advertencia","En Fila Nº "+string(il_row)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar EDAD FALLECIDO" )
						elseif isnull(ls_sexo) or ls_sexo='' or ls_sexo='-' then
							messagebox("Advertencia","En Fila Nº "+string(il_row)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar SEXO FALLECIDO" )
						elseif isnull(ls_cod_reg_pase) or ls_cod_reg_pase='' or ls_cod_reg_pase='-' then
							messagebox("Advertencia","En Fila Nº "+string(il_row)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar REGISTRO CIVIL PASE SEPULTACION" )
						elseif isnull(ls_inscrip_pase) or ls_inscrip_pase='' or ls_inscrip_pase='-' then
							messagebox("Advertencia","En Fila Nº "+string(il_row)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar INSCRIPCION PASE SEPULTACION" )
						elseif isnull(ls_registro_pase) or ls_registro_pase='' or ls_registro_pase='-' then
							messagebox("Advertencia","En Fila Nº "+string(il_row)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar NUMERO REGISTRO PASE SEPULTACION" )
						elseif isnull(ldt_fecha_pase) then
							messagebox("Advertencia","En Fila Nº "+string(il_row)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar FECHA PASE SEPULTACION" )
						elseif isnull(ls_est) or ls_est='' or ls_est='-' then
							messagebox("Advertencia","En Fila Nº "+string(il_row)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar ESTADO CUERPO" )
						elseif isnull(ldt_fec_nac) then 
							messagebox("Advertencia","En Fila Nº "+string(il_row)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar FECHA NACIMIENTO FALLECIDO" )
						elseif isnull(ls_estado_contrato) or ls_estado_contrato='-' then
							messagebox("Advertencia","En Fila Nº "+string(il_row)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar ESTADO CONTRATO" )
						else
							ls_pasa1	= 'S'
						end if
					end if
				end if
				if ls_pasa1='S' then
					SELECT MAX("FALLECIDOS"."LLAVE")  
					INTO 	:ll_max  
					FROM 	"FALLECIDOS"  ;
					if isnull(ll_max) or ll_max=0 then
						ll_max					= 1
					else
						ll_max ++
					end if
					SELECT	MAX("FALLECIDOS"."FOLIO")
					INTO 		:ll_count_parque  
					FROM 		"FALLECIDOS"  
					WHERE 	"FALLECIDOS"."COD_PARQUE" = :ll_cod_parque   ;
					if isnull(ll_count_parque) or ll_count_parque=0 then
						ll_count_parque					= 1
					else
						ll_count_parque ++
					end if
					
					SELECT	"FUNERARIA"."NOMBRE"  
					INTO 		:ls_funeraria  
					FROM 		"FUNERARIA"  
					WHERE 	"FUNERARIA"."RUT" = :ll_cod_funeraria   ;
					if isnull(ls_funeraria) or ls_funeraria='' then ls_funeraria='-'
					ls_llave				= string(ll_max)
					if ls_tipo_ficha='FS' or (ls_tipo_ficha='FT' and ls_tipo_traslado='E' and ls_destino_parque='E') then
						ls_op				= 'IN'
					elseif ls_tipo_ficha='FT' and ls_tipo_traslado='I' then
						ls_op				= 'TI'
					elseif ls_tipo_ficha='FT' and ls_tipo_traslado='E' and ls_destino_parque='S' then
						ls_op				= 'EX'
					end if
					if ls_tipo_ficha='FS' then
						SELECT	"COMUNA"."COMUNA"  
						INTO 		:ls_otorgado_por  
						FROM 		"COMUNA"  
						WHERE 	"COMUNA"."CODIGO_COMUNA" = :ls_cod_reg_pase   
						USING		sqlca;
					elseif ls_tipo_ficha='FT' then
						SELECT	"FICHA_OTORGADO_POR"."DESCRIPCION"  
						INTO 		:ls_otorgado_por  
						FROM 		"FICHA_OTORGADO_POR"  
						WHERE 	"FICHA_OTORGADO_POR"."CODIGO" = :ls_cod_reg_pase   
						USING		sqlca;
					end if

					SELECT	"FICHA_REGISTRO"."COD_ENFERMEDAD_1",
								"FICHA_REGISTRO"."FOLIO_CARTA_AUTORIZACION",
								"FICHA_REGISTRO"."FOLIO_GRABA_LAPIDA",
								"FICHA_REGISTRO"."CORRELATIVO_INTERNO"
					INTO 		:ls_enf_des_obl,
								:ll_folio_carta_aut,
								:ll_folio_lapida,
								:ll_corr_hist_reg
					FROM 		"FICHA_REGISTRO"  
					WHERE  ( "FICHA_REGISTRO"."CORRELATIVO_MENSUAL" = :ll_n_m ) AND  
							 ( "FICHA_REGISTRO"."CORRELATIVO_ANUAL" = :ll_n_l )  AND
							 ( "FICHA_REGISTRO"."COD_PARQUE" = :ll_cod_parque )
					USING		sqlca;
					if isnull(ls_enf_des_obl) or ls_enf_des_obl='' or ls_enf_des_obl='-' then
						ls_enf_obl				= 'NO'
					else
						ls_enf_obl				= 'SI'
					end if
					ls_boleta					= string(ll_boleta)
					ls_rg_est					= string(ll_n_l)
					
					SELECT	"FICHA_CARTA_SEPULTACION"."FOLIO"  
					INTO 		:ll_folio_carta_aut  
					FROM 		"FICHA_CARTA_SEPULTACION"  
					WHERE 	"FICHA_CARTA_SEPULTACION"."SECTOR" = :ls_sector   AND
							 ( "FICHA_CARTA_SEPULTACION"."SEPULTURA" = :ls_sepultura ) AND  
							 ( "FICHA_CARTA_SEPULTACION"."FECHA_SEPULTACION" = :ldt_fec_sepult ) AND  
							 ( "FICHA_CARTA_SEPULTACION"."CORRELATIVO" = :ll_corr_interno ) AND  
							 ( "FICHA_CARTA_SEPULTACION"."COD_PARQUE" = :ll_cod_parque )  
					USING		sqlca;
					if sqlca.sqlcode=0 then 
						ls_carta_aut	= string(ll_folio_carta_aut)
					else
						ls_carta_aut	= 'S/C'
					end if
					if ls_base='O' then
						SELECT	"OFERTA_V"."USO"  
						INTO 		:ls_vta  
						FROM 		"OFERTA_V",   "PAGO_OFERTA"  
						WHERE  ( "OFERTA_V"."SERIE" = "PAGO_OFERTA"."SERIE" ) and  
								 ( "OFERTA_V"."NRO_OFERTA" = "PAGO_OFERTA"."NRO_OFERTA" ) and  
								 ( "OFERTA_V"."ULT_FOLIO" = "PAGO_OFERTA"."FOLIO" ) and  
								 (("OFERTA_V"."SERIE" = :ls_serie ) AND  
								 ( "OFERTA_V"."NRO_OFERTA" = :ll_numero ) )   
						USING		sqlca;
	
					elseif ls_base='C' then
						if ls_serie='A' or ls_serie='B' or ls_serie='C' then
							ls_vta				= 'NI'
						else
							ls_vta				= 'NF'
						end if
					end if
					if ls_tipo_ficha='FT' then
						SELECT	"COD_PARQ"."NOMBRE"  
						INTO 		:ls_cementerio_origen  
						FROM 		"COD_PARQ"  
						WHERE 	"COD_PARQ"."CODIGO" = :ll_cod_parque_origen   ;
					else
						ls_cementerio_origen		= ''
					end if
					if ls_tipo_ficha='FT' and ls_tipo_traslado='I' then
						SELECT	"FALLECIDOS"."LLAVE"
						INTO 		:ll_count
						FROM 		"FALLECIDOS"  
						WHERE  ( "FALLECIDOS"."NOMBRES" = :ls_nombre ) AND  
								 ( "FALLECIDOS"."AP_PATERNO" = :ls_ap_pat ) AND  
								 ( "FALLECIDOS"."AP_MATERNO" = :ls_ap_mat )  
						USING		sqlca;
						if sqlca.sqlcode=0 then
							if ll_count > 0 then
								UPDATE	"FALLECIDOS"  
								SET 		"BASE" = :ls_base,   
											"SS" = :ls_serie,   
											"CONTRATO" = :ll_numero,   
											"SECTOR" = :ls_sector,   
											"N_SEP" = :ls_sepultura,   
											"EST" = :ls_est  
								WHERE		"FALLECIDOS"."LLAVE" = :ll_count   
								USING		sqlca;
								if sqlca.sqlcode=0 then
									commit;
									messagebox("Grabar","Actualización Exitosa")
								else
									rollback;
									messagebox("Error Grabar","Error al Actualizar Fallecido SQL: "+sqlca.sqlerrtext)
								end if

							else
								messagebox("Advertencia","Fallecido No Encontrado, debe realizar los Cambios en Mantenedor de FALLECIDO")
							end if
						else
							messagebox("Advertencia","Fallecido No Encontrado, debe realizar los Cambios en Mantenedor de FALLECIDO")
							
						end if
					else
						SELECT	"FALLECIDOS"."LLAVE"
						INTO 		:ll_count
						FROM 		"FALLECIDOS"  
						WHERE  ( "FALLECIDOS"."BASE" = :ls_base ) AND  
								 ( "FALLECIDOS"."SS" = :ls_serie ) AND  
								 ( "FALLECIDOS"."CONTRATO" = :ll_numero ) AND  
								 ( "FALLECIDOS"."SECTOR" = :ls_sector ) AND  
								 ( "FALLECIDOS"."N_SEP" = :ls_sepultura ) AND  
								 ( "FALLECIDOS"."NOMBRES" = :ls_nombre ) AND  
								 ( "FALLECIDOS"."AP_PATERNO" = :ls_ap_pat ) AND  
								 ( "FALLECIDOS"."AP_MATERNO" = :ls_ap_mat )  
						USING		sqlca;
						if ll_count > 0 then
							messagebox("Advertencia","Fallecido Ya Existe, Llave Nº "+string(ll_count))
						elseif sqlca.sqlcode = 100 then
							if ll_rg = 0 then
								ll_res	= messagebox("Advertencia","Está Seguro de Ingresar FALLECIDO",Exclamation!,YesNo!,2)
							end if
							if ll_res=1 then
								if len(ls_funeraria) > 50 then ls_funeraria = mid(ls_funeraria,1,50)
								if len(ls_causa_fall) > 50 then ls_causa_fall = mid(ls_causa_fall,1,50)
								INSERT INTO   "FALLECIDOS"  
												( "LLAVE",		"FOLIO",				"N_L",	"N_M",	"BASE",		"SS",			"CONTRATO",	"SECTOR",	"N_SEP",			"NOMBRES",	"AP_PATERNO",	"AP_MATERNO",	"FEC_SEP",			"EST",	"OP",		"RUT",	"DV",		"SEXO",		"EDAD",		"PERIODO",		"FEC_NAC",		"FEC_FALL",		"PASE",				"REG_CIVIL",		"CAUSA_FALL",		"ENF_OBL",		"FUNERARIA",	"BOLETA",	"CARTA_AUT",	"RG_EST",				"N_TEC",		"NIVEL",		"VTA",		"OBSERVACIONES",		"ESTADO_CONTRATO",	"RESOLUCION_TRASLADO_NRO",	"OTORGADO_POR",	"CEMENTERIO_ORIGEN",		"COD_PARQUE",		"FECHA_SISTEMA")
								VALUES 		( :ls_llave,	:ll_count_parque,	:ll_n_l,	:ll_n_m,	:ls_base,	:ls_serie,	:ll_numero,	:ls_sector,	:ls_sepultura,	:ls_nombre,	:ls_ap_pat,		:ls_ap_mat,		:ldt_fec_sepult,	:ls_est,	:ls_op,	:ll_rut,	:ls_dv,	:ls_sexo,	:ll_edad,	:ls_periodo,	:ldt_fec_nac,	:ldt_fec_fall,	:ls_inscrip_pase,	:ls_otorgado_por,	:ls_causa_fall,	:ls_enf_obl,	:ls_funeraria,	:ls_boleta,	:ls_carta_aut,	:ll_corr_hist_reg,	:ls_n_tec,	:ls_nivel,	:ls_vta,		:ls_observaciones,   :ls_estado_contrato,	:ls_registro_pase,			:ls_otorgado_por,	:ls_cementerio_origen,	:ll_cod_parque,	:gdt_fec_sistema )  
								USING			sqlca;
								if sqlca.sqlcode=0 then
									commit;
									if ll_rut>0 then
										SELECT	"CLIENTE"."ESTADO_TITULAR"  
										INTO 		:ls_estado_tit  
										FROM 		"CLIENTE"  
										WHERE 	"CLIENTE"."RUT" = :ll_rut   
										USING		sqlca;
										if sqlca.sqlcode=0 then
											UPDATE	"CLIENTE"  
											SET 		"ESTADO_TITULAR" = '1'  
											WHERE 	"CLIENTE"."RUT" = :ll_rut   
											USING		sqlca;
											if sqlca.sqlcode=0 then
												commit;
											else
												rollback;
											end if
										end if
									end if
									messagebox("Grabar","Grabación Exitosa")
								else
									rollback;
									messagebox("Error Grabar","Error al Grabar Fallecido SQL: "+sqlca.sqlerrtext)
								end if
							end if
						end if
					end if
				end if
			else
				if isnull(ls_nombre) or ls_nombre='' or ls_nombre='-' then
					messagebox("Advertencia","En Fila Nº "+string(il_row)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar NOMBRE FALLECIDO" )
				elseif isnull(ls_ap_pat) or ls_ap_pat='' or ls_ap_pat='-' then
					messagebox("Advertencia","En Fila Nº "+string(il_row)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar APELLIDO PATERNO FALLECIDO" )
				elseif isnull(ls_ap_mat) or ls_ap_mat='' or ls_ap_mat='-' then
					messagebox("Advertencia","En Fila Nº "+string(il_row)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar APELLIDO MATERNO FALLECIDO" )
				elseif isnull(ls_n_tec) or ls_n_tec='' or ls_n_tec='-' then
					messagebox("Advertencia","En Fila Nº "+string(il_row)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar NUMERO TECNICO" )
				elseif isnull(ldt_fec_sepult)  then
					messagebox("Advertencia","En Fila Nº "+string(il_row)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar FECHA SEPULTACION" )
				elseif isnull(ls_nivel) or ls_nivel='' or ls_nivel='-' then
					messagebox("Advertencia","En Fila Nº "+string(il_row)+" Sector "+ls_sector+ " Sepultura Nº "+ls_sepultura+" Falta Ingresar NIVEL" )
				end if
			end if
		end if
	end if
end if
end event

