compute(band=detail alignment="3" expression="'Con fecha '+ date(fecha_carta) +'Don(a) '+  ficha_sepultacion_nombre_tercero +' '+  ficha_sepultacion_ap_paterno_tercero +' '+     ficha_sepultacion_ap_materno_tercero +' domiciliado en '+    ficha_sepultacion_direccion_tercero +',  procede a realizar los trámites para la sepultación  y la grabación de lápida de '+ nombre_titular +' '+ apellido_paterno_titular +' '+  apellido_materno_titular +' a fin de que sea sepultado en ubicada en el Sector '+ if (isnull(sector ) or sector='' or sector='-','XXX',sector) +', Sepultura '+ if ( isnull(sepultura) or sepultura='' or sepultura='-','XXXXX',sepultura) +' de '+if ( isnull( capacidad ) or capacidad=0,'XXX',string(capacidad,'##0'))+' compartimientos del Cementerio '+ membrete_empresa_parque +', que tiene derecho a ser sepultado según Art. 30 del DS 357 Reglamento General de Cementerios, respecto de '+ nombre_titular +' '+ serie +' '+ numero +' (QEPD), titular del contrato '+base+' '+ serie +' '+ numero"border="0" color="0" x="69" y="860" height="460" width="3223" format="[GENERAL]" html.valueishtml="0"  name=compute_8 visible="1~tif ( (rut_titular >0 and not isnull( rut_titular )) and  (tipo_formato_carta = 7 or tipo_formato_carta = 8 ),1,0)"  font.face="Arial" font.height="-11" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" background.transparency="0" background.gradient.color="8421504" background.gradient.transparency="0" background.gradient.angle="0" background.brushmode="0" background.gradient.repetition.mode="0" background.gradient.repetition.count="0" background.gradient.repetition.length="100" background.gradient.focus="0" background.gradient.scale="100" background.gradient.spread="100" tooltip.backcolor="134217752" tooltip.delay.initial="0" tooltip.delay.visible="32000" tooltip.enabled="0" tooltip.hasclosebutton="0" tooltip.icon="0" tooltip.isbubble="0" tooltip.maxwidth="0" tooltip.textcolor="134217751" tooltip.transparency="0" transparency="0" )
