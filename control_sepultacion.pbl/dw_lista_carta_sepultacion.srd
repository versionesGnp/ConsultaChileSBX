 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ficha_carta_sepultacion~" ) COLUMN(NAME=~"ficha_carta_sepultacion.fecha_carta~") COLUMN(NAME=~"ficha_carta_sepultacion.nombre_titular~") COLUMN(NAME=~"ficha_carta_sepultacion.apellido_paterno_titular~") COLUMN(NAME=~"ficha_carta_sepultacion.apellido_materno_titular~") COLUMN(NAME=~"ficha_carta_sepultacion.rut_titular~") COLUMN(NAME=~"ficha_carta_sepultacion.dv_titular~") COLUMN(NAME=~"ficha_carta_sepultacion.direccion_titular~") COLUMN(NAME=~"ficha_carta_sepultacion.numero_direccion_titular~") COLUMN(NAME=~"ficha_carta_sepultacion.depto_direccion_titular~") COLUMN(NAME=~"ficha_carta_sepultacion.block_direccion_titular~") COLUMN(NAME=~"ficha_carta_sepultacion.poblacion_villa_titular~") COLUMN(NAME=~"ficha_carta_sepultacion.sector_titular~") COLUMN(NAME=~"ficha_carta_sepultacion.sector~") COLUMN(NAME=~"ficha_carta_sepultacion.sepultura~") COLUMN(NAME=~"ficha_carta_sepultacion.numero_tecnico~") COLUMN(NAME=~"ficha_carta_sepultacion.capacidad~") COLUMN(NAME=~"ficha_carta_sepultacion.nombre_fallecido~") COLUMN(NAME=~"ficha_carta_sepultacion.apellido_paterno_fall~") COLUMN(NAME=~"ficha_carta_sepultacion.apellido_materno_fall~") COLUMN(NAME=~"ficha_carta_sepultacion.fecha_sepultacion~") COLUMN(NAME=~"ficha_carta_sepultacion.hora_sepultacion~") COLUMN(NAME=~"ficha_carta_sepultacion.minuto_sepultacion~") COLUMN(NAME=~"ficha_carta_sepultacion.codigo_funeraria~") COLUMN(NAME=~"ficha_carta_sepultacion.folio~") COLUMN(NAME=~"ficha_carta_sepultacion.base~") COLUMN(NAME=~"ficha_carta_sepultacion.serie~") COLUMN(NAME=~"ficha_carta_sepultacion.numero~") COLUMN(NAME=~"ficha_carta_sepultacion.rut_fallecido~") COLUMN(NAME=~"ficha_carta_sepultacion.dv_fallecido~") COLUMN(NAME=~"ficha_carta_sepultacion.correlativo~") COLUMN(NAME=~"ficha_carta_sepultacion.cod_parque~") COLUMN(NAME=~"ficha_carta_sepultacion.estado_reg~") COLUMN(NAME=~"ficha_carta_sepultacion.tipo_ficha~")WHERE(    EXP1 =~"~~~"FICHA_CARTA_SEPULTACION~~~".~~~"FECHA_SEPULTACION~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FICHA_CARTA_SEPULTACION~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = datetime)  ARG(NAME = ~"parque~" TYPE = number) " update="FICHA_CARTA_SEPULTACION" updatewhere=0 updatekeyinplace=yes arguments=(("fecha_ini", datetime),("parque", number))  sort="fecha_sepultacion D hora_sepultacion A minuto_sepultacion A " )
