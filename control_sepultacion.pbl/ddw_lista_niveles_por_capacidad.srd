 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ficha_niveles~" ) COLUMN(NAME=~"ficha_niveles.correlativo~") COLUMN(NAME=~"ficha_niveles.capacidad~") COLUMN(NAME=~"ficha_niveles.nivel~") COLUMN(NAME=~"ficha_niveles.nivel_sepultura~") COLUMN(NAME=~"ficha_niveles.grupo~") COLUMN(NAME=~"ficha_niveles.cod_parque~") COLUMN(NAME=~"ficha_niveles.tipo_cons~")WHERE(    EXP1 =~"~~~"FICHA_NIVELES~~~".~~~"CAPACIDAD~~~"~"   OP =~"=~"    EXP2 =~":capacidad~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FICHA_NIVELES~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FICHA_NIVELES~~~".~~~"TIPO_CONS~~~"~"   OP =~"=~"    EXP2 =~":cons~" ) ) ARG(NAME = ~"capacidad~" TYPE = number)  ARG(NAME = ~"parque~" TYPE = number)  ARG(NAME = ~"cons~" TYPE = string) " update="FICHA_NIVELES" updatewhere=1 updatekeyinplace=no arguments=(("capacidad", number),("parque", number),("cons", string))  sort="grupo A correlativo A " )
