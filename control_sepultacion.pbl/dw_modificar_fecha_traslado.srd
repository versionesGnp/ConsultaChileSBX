 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ficha_traslado~" ) COLUMN(NAME=~"ficha_traslado.base_origen~") COLUMN(NAME=~"ficha_traslado.serie_origen~") COLUMN(NAME=~"ficha_traslado.numero_origen~") COLUMN(NAME=~"ficha_traslado.sector_origen~") COLUMN(NAME=~"ficha_traslado.sepultura_origen~") COLUMN(NAME=~"ficha_traslado.numero_tecnico_origen~") COLUMN(NAME=~"ficha_traslado.cod_parque_origen~") COLUMN(NAME=~"ficha_traslado.folio~") COLUMN(NAME=~"ficha_traslado.base_destino~") COLUMN(NAME=~"ficha_traslado.serie_destino~") COLUMN(NAME=~"ficha_traslado.numero_destino~") COLUMN(NAME=~"ficha_traslado.sector_destino~") COLUMN(NAME=~"ficha_traslado.sepultura_destino~") COLUMN(NAME=~"ficha_traslado.numero_tecnico_destino~") COLUMN(NAME=~"ficha_traslado.cod_parque_destino~") COLUMN(NAME=~"ficha_traslado.tipo_traslado~") COLUMN(NAME=~"ficha_traslado.fecha_traslado~") COLUMN(NAME=~"ficha_traslado.cod_parque~") COLUMN(NAME=~"ficha_traslado.estado_reg~")WHERE(    EXP1 =~"(~~~"FICHA_TRASLADO~~~".~~~"SECTOR_ORIGEN~~~"~"   OP =~"=~"    EXP2 =~":sector~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FICHA_TRASLADO~~~".~~~"SEPULTURA_ORIGEN~~~"~"   OP =~"=~"    EXP2 =~":sepultura~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FICHA_TRASLADO~~~".~~~"FECHA_TRASLADO~~~"~"   OP =~"=~"    EXP2 =~":fecha)~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"(~~~"FICHA_TRASLADO~~~".~~~"SECTOR_DESTINO~~~"~"   OP =~"=~"    EXP2 =~":sector~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FICHA_TRASLADO~~~".~~~"SEPULTURA_DESTINO~~~"~"   OP =~"=~"    EXP2 =~":sepultura~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FICHA_TRASLADO~~~".~~~"FECHA_TRASLADO~~~"~"   OP =~"=~"    EXP2 =~":fecha)~" ) ) ARG(NAME = ~"sector~" TYPE = string)  ARG(NAME = ~"sepultura~" TYPE = string)  ARG(NAME = ~"fecha~" TYPE = datetime) " update="FICHA_TRASLADO" updatewhere=0 updatekeyinplace=yes arguments=(("sector", string),("sepultura", string),("fecha", datetime)) )
