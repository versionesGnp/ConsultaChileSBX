 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"fc_agenda_capilla~" ) COLUMN(NAME=~"fc_agenda_capilla.folio_crematorio~") COLUMN(NAME=~"fc_agenda_capilla.fecha_cremacion~") COLUMN(NAME=~"fc_agenda_capilla.hora_cineracion~") COLUMN(NAME=~"fc_agenda_capilla.minuto_cineracion~") COLUMN(NAME=~"fc_agenda_capilla.rut_fallecido~") COLUMN(NAME=~"fc_agenda_capilla.nombre_fallecido~") COLUMN(NAME=~"fc_agenda_capilla.ap_paterno_fallecido~") COLUMN(NAME=~"fc_agenda_capilla.ap_materno_fallecido~") COLUMN(NAME=~"fc_agenda_capilla.fecha_defuncion~") COLUMN(NAME=~"fc_agenda_capilla.estado_gestion~") COLUMN(NAME=~"fc_agenda_capilla.cod_parque~") COLUMN(NAME=~"fc_agenda_capilla.base~") COLUMN(NAME=~"fc_agenda_capilla.serie~") COLUMN(NAME=~"fc_agenda_capilla.numero~") COLUMN(NAME=~"fc_agenda_capilla.rut_titular~")WHERE(    EXP1 =~"~~~"FC_AGENDA_CAPILLA~~~".~~~"FECHA_CREMACION~~~"~"   OP =~">=~"    EXP2 =~":fecha_ini~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FC_AGENDA_CAPILLA~~~".~~~"FECHA_CREMACION~~~"~"   OP =~"<=~"    EXP2 =~":fecha_fin~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FC_AGENDA_CAPILLA~~~".~~~"SW_INGRESO_PARQUE~~~"~"   OP =~"=~"    EXP2 =~"'S'~" ) ) ARG(NAME = ~"fecha_ini~" TYPE = date)  ARG(NAME = ~"fecha_fin~" TYPE = date) " arguments=(("fecha_ini", date),("fecha_fin", date))  sort="fecha_cremacion A folio_crematorio A " )
