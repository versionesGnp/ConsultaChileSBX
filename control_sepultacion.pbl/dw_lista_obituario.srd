 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"obituario~" ) COLUMN(NAME=~"obituario.fecha~") COLUMN(NAME=~"obituario.nombre_fall~") COLUMN(NAME=~"obituario.hora_sep~") COLUMN(NAME=~"obituario.area~") COLUMN(NAME=~"obituario.sector~") COLUMN(NAME=~"obituario.sepultura~") COLUMN(NAME=~"obituario.ip~") COLUMN(NAME=~"obituario.log_nick~") COLUMN(NAME=~"obituario.loghora~") COLUMN(NAME=~"obituario.cod_parque~") COLUMN(NAME=~"obituario.fecha_sys~") COLUMN(NAME=~"obituario.correlativo~")WHERE(    EXP1 =~"~~~"OBITUARIO~~~".~~~"FECHA~~~"~"   OP =~"=~"    EXP2 =~":fecha~" ) ) ARG(NAME = ~"fecha~" TYPE = string) " update="OBITUARIO" updatewhere=0 updatekeyinplace=yes arguments=(("fecha", string))  sort="correlativo D " )
