global type f_blobaarchivo from function_object
end type

forward prototypes
global function boolean f_blobaarchivo (blob ablb_archivo, string as_dirarchivo)
end prototypes

global function boolean f_blobaarchivo (blob ablb_archivo, string as_dirarchivo);Long		ll_TamañoArchivo			//Almacena el tamaño del archivo
Long		ll_Escrito						//Almacena la cantidad de bytes escritos en el archivo
Integer	li_FileNum					//Almacena el numero del archivo abierto

li_FileNum = FileOpen( as_dirarchivo, StreamMode!, Write!, Shared!, Replace!)
ll_TamañoArchivo = f_zero(Len(ablb_archivo))
If ll_TamañoArchivo <= 0 Then
	Return False
End IF


FileWriteEx(li_FileNum,ablb_archivo)
//Do While ll_escrito < ll_TamañoArchivo
//	ll_escrito += FileWrite(li_FileNum, ablb_archivo)
//Loop
//
FileClose(li_FileNum)

Return True
end function

