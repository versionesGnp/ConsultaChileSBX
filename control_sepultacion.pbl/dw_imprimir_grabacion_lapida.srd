 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"ficha_grabacion_lapida~" )  TABLE(NAME=~"membrete_empresa~" ) COLUMN(NAME=~"ficha_grabacion_lapida.base~") COLUMN(NAME=~"ficha_grabacion_lapida.serie~") COLUMN(NAME=~"ficha_grabacion_lapida.numero~") COLUMN(NAME=~"ficha_grabacion_lapida.fecha~") COLUMN(NAME=~"ficha_grabacion_lapida.nombre_titular~") COLUMN(NAME=~"ficha_grabacion_lapida.apellido_paterno_titular~") COLUMN(NAME=~"ficha_grabacion_lapida.apellido_materno_titular~") COLUMN(NAME=~"ficha_grabacion_lapida.rut_titular~") COLUMN(NAME=~"ficha_grabacion_lapida.dv_titular~") COLUMN(NAME=~"ficha_grabacion_lapida.sector~") COLUMN(NAME=~"ficha_grabacion_lapida.sepultura~") COLUMN(NAME=~"ficha_grabacion_lapida.numero_tecnico~") COLUMN(NAME=~"ficha_grabacion_lapida.capacidad~") COLUMN(NAME=~"ficha_grabacion_lapida.nombre_fallecido~") COLUMN(NAME=~"ficha_grabacion_lapida.apellido_paterno_fall~") COLUMN(NAME=~"ficha_grabacion_lapida.apellido_materno_fall~") COLUMN(NAME=~"ficha_grabacion_lapida.fecha_nacimiento_fall~") COLUMN(NAME=~"ficha_grabacion_lapida.fecha_fallecimiento~") COLUMN(NAME=~"ficha_grabacion_lapida.codigo_religion~") COLUMN(NAME=~"ficha_grabacion_lapida.codigo_imagen~") COLUMN(NAME=~"ficha_grabacion_lapida.nombre_fallecido_lapida~") COLUMN(NAME=~"ficha_grabacion_lapida.fecha_defuncion_lapida~") COLUMN(NAME=~"ficha_grabacion_lapida.fecha_nacimiento_lapida~") COLUMN(NAME=~"ficha_grabacion_lapida.folio~") COLUMN(NAME=~"ficha_grabacion_lapida.rut_fallecido~") COLUMN(NAME=~"ficha_grabacion_lapida.dv_fallecido~") COLUMN(NAME=~"ficha_grabacion_lapida.cod_parque~") COLUMN(NAME=~"ficha_grabacion_lapida.estado_reg~") COLUMN(NAME=~"ficha_grabacion_lapida.primera_sepultura~") COLUMN(NAME=~"ficha_grabacion_lapida.fecha_recepcion~") COLUMN(NAME=~"ficha_grabacion_lapida.correlativo~") COLUMN(NAME=~"ficha_grabacion_lapida.tipo_construccion~") COLUMN(NAME=~"membrete_empresa.parque~") COLUMN(NAME=~"membrete_empresa.ciudad~")    JOIN (LEFT=~"ficha_grabacion_lapida.cod_parque~"    OP =~"=~"RIGHT=~"membrete_empresa.cod_parque~" )WHERE(    EXP1 =~"(~~~"FICHA_GRABACION_LAPIDA~~~".~~~"SECTOR~~~"~"   OP =~"=~"    EXP2 =~":sector~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FICHA_GRABACION_LAPIDA~~~".~~~"SEPULTURA~~~"~"   OP =~"=~"    EXP2 =~":sepultura~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FICHA_GRABACION_LAPIDA~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FICHA_GRABACION_LAPIDA~~~".~~~"FECHA~~~"~"   OP =~"=~"    EXP2 =~":fecha_sepult~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FICHA_GRABACION_LAPIDA~~~".~~~"FOLIO~~~"~"   OP =~"=~"    EXP2 =~":corr)~" ) ) ARG(NAME = ~"sector~" TYPE = string)  ARG(NAME = ~"sepultura~" TYPE = string)  ARG(NAME = ~"parque~" TYPE = number)  ARG(NAME = ~"fecha_sepult~" TYPE = datetime)  ARG(NAME = ~"corr~" TYPE = number) " update="FICHA_GRABACION_LAPIDA" updatewhere=0 updatekeyinplace=yes arguments=(("sector", string),("sepultura", string),("parque", number),("fecha_sepult", datetime),("corr", number)) )
