 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ficha_reduccion~" ) COLUMN(NAME=~"ficha_reduccion.fecha_sepultacion~") COLUMN(NAME=~"ficha_reduccion.base~") COLUMN(NAME=~"ficha_reduccion.serie~") COLUMN(NAME=~"ficha_reduccion.numero~") COLUMN(NAME=~"ficha_reduccion.sector~") COLUMN(NAME=~"ficha_reduccion.sepultura~") COLUMN(NAME=~"ficha_reduccion.numero_tecnico~") COLUMN(NAME=~"ficha_reduccion.capacidad~") COLUMN(NAME=~"ficha_reduccion.cod_parque~") COLUMN(NAME=~"ficha_reduccion.correlativo_interno~") COLUMN(NAME=~"ficha_reduccion.estado_reg~")WHERE(    EXP1 =~"~~~"FICHA_REDUCCION~~~".~~~"SECTOR~~~"~"   OP =~"=~"    EXP2 =~":sector~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FICHA_REDUCCION~~~".~~~"SEPULTURA~~~"~"   OP =~"=~"    EXP2 =~":sepultura~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FICHA_REDUCCION~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FICHA_REDUCCION~~~".~~~"FECHA_SEPULTACION~~~"~"   OP =~"=~"    EXP2 =~":fecha_sepult~" ) ) ARG(NAME = ~"sector~" TYPE = string)  ARG(NAME = ~"sepultura~" TYPE = string)  ARG(NAME = ~"parque~" TYPE = number)  ARG(NAME = ~"fecha_sepult~" TYPE = datetime) " update="FICHA_REDUCCION" updatewhere=0 updatekeyinplace=yes arguments=(("sector", string),("sepultura", string),("parque", number),("fecha_sepult", datetime))  sort="fecha_sepultacion A correlativo_interno A " )
