compute(band=detail alignment="3" expression=" membrete_empresa_ciudad +string( fecha_sepultacion ,'dd/mm/yyyy')+' Con esta Fecha se ha practicado la Sepultación de don(ña)  '+ nombre_fallecido + ' '+ ap_pat_fallecido +' '+ ap_mat_fallecido +'  Cuyos restos se han inhumado en la Sepultura ubicada en el Sector  '+ sector +'  Número  '+ sepultura +'  Código  '+ nro_tecnico +'  Nivel  '+ if (isnull(nivel) or nivel='','0', nivel ) +'  Capacidad  '+if ( isnull(capacidad) or capacidad=0,'0',  string( capacidad ,~"###,###,###,##0~"))+'  del Cementerio  '+ membrete_empresa_parque +'.'"border="0" color="0" x="539" y="908" height="436" width="2674" format="[GENERAL]" html.valueishtml="0"  name=compute_2 visible="1"  font.face="Arial" font.height="-14" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" background.transparency="0" background.gradient.color="8421504" background.gradient.transparency="0" background.gradient.angle="0" background.brushmode="0" background.gradient.repetition.mode="0" background.gradient.repetition.count="0" background.gradient.repetition.length="100" background.gradient.focus="0" background.gradient.scale="100" background.gradient.spread="100" tooltip.backcolor="134217752" tooltip.delay.initial="0" tooltip.delay.visible="32000" tooltip.enabled="0" tooltip.hasclosebutton="0" tooltip.icon="0" tooltip.isbubble="0" tooltip.maxwidth="0" tooltip.textcolor="134217751" tooltip.transparency="0" transparency="0" )
