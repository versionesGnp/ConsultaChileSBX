 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ficha_registro~" )  TABLE(NAME=~"membrete_empresa~" ) COLUMN(NAME=~"ficha_registro.correlativo_interno~") COLUMN(NAME=~"ficha_registro.correlativo_mensual~") COLUMN(NAME=~"ficha_registro.correlativo_anual~") COLUMN(NAME=~"ficha_registro.fecha_crea~") COLUMN(NAME=~"ficha_registro.base~") COLUMN(NAME=~"ficha_registro.serie~") COLUMN(NAME=~"ficha_registro.numero~") COLUMN(NAME=~"ficha_registro.nombre_fallecido~") COLUMN(NAME=~"ficha_registro.ap_pat_fallecido~") COLUMN(NAME=~"ficha_registro.ap_mat_fallecido~") COLUMN(NAME=~"ficha_registro.tipo_ficha~") COLUMN(NAME=~"ficha_registro.folio_ficha~") COLUMN(NAME=~"ficha_registro.folio_carta_autorizacion~") COLUMN(NAME=~"ficha_registro.folio_graba_lapida~") COLUMN(NAME=~"ficha_registro.sector~") COLUMN(NAME=~"ficha_registro.sepultura~") COLUMN(NAME=~"ficha_registro.nro_tecnico~") COLUMN(NAME=~"ficha_registro.nivel~") COLUMN(NAME=~"ficha_registro.capacidad~") COLUMN(NAME=~"ficha_registro.rut_fallecido~") COLUMN(NAME=~"ficha_registro.dv_fallecido~") COLUMN(NAME=~"ficha_registro.cod_estado_cuerpo~") COLUMN(NAME=~"ficha_registro.fecha_nac_fallecido~") COLUMN(NAME=~"ficha_registro.edad~") COLUMN(NAME=~"ficha_registro.fecha_fallecimiento~") COLUMN(NAME=~"ficha_registro.sexo~") COLUMN(NAME=~"ficha_registro.fecha_sepultacion~") COLUMN(NAME=~"ficha_registro.tipo_operacion_traslado~") COLUMN(NAME=~"ficha_registro.cod_parque_origen~") COLUMN(NAME=~"ficha_registro.cod_funeraria~") COLUMN(NAME=~"ficha_registro.causa_muerte~") COLUMN(NAME=~"ficha_registro.cod_registro_pase~") COLUMN(NAME=~"ficha_registro.inscripcion_pase~") COLUMN(NAME=~"ficha_registro.registro_pase~") COLUMN(NAME=~"ficha_registro.fecha_pase~") COLUMN(NAME=~"membrete_empresa.parque~") COLUMN(NAME=~"membrete_empresa.ciudad~")    JOIN (LEFT=~"ficha_registro.cod_parque~"    OP =~"=~"RIGHT=~"membrete_empresa.cod_parque~" )WHERE(    EXP1 =~"~~~"FICHA_REGISTRO~~~".~~~"CORRELATIVO_MENSUAL~~~"~"   OP =~"=~"    EXP2 =~":corr_mensual~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FICHA_REGISTRO~~~".~~~"CORRELATIVO_ANUAL~~~"~"   OP =~"=~"    EXP2 =~":corr_anual~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FICHA_REGISTRO~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FICHA_REGISTRO~~~".~~~"FECHA_SEPULTACION~~~"~"   OP =~"=~"    EXP2 =~":fecha_sep~" ) ) ARG(NAME = ~"corr_mensual~" TYPE = number)  ARG(NAME = ~"corr_anual~" TYPE = number)  ARG(NAME = ~"parque~" TYPE = number)  ARG(NAME = ~"fecha_sep~" TYPE = datetime) " arguments=(("corr_mensual", number),("corr_anual", number),("parque", number),("fecha_sep", datetime)) )
