 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ficha_ultima_voluntad~" )  TABLE(NAME=~"cliente~" ) COLUMN(NAME=~"ficha_ultima_voluntad.rut~") COLUMN(NAME=~"ficha_ultima_voluntad.base~") COLUMN(NAME=~"ficha_ultima_voluntad.serie~") COLUMN(NAME=~"ficha_ultima_voluntad.numero~") COLUMN(NAME=~"ficha_ultima_voluntad.fecha_crea~") COLUMN(NAME=~"ficha_ultima_voluntad.correlativo~") COLUMN(NAME=~"ficha_ultima_voluntad.sector~") COLUMN(NAME=~"ficha_ultima_voluntad.sepultura~") COLUMN(NAME=~"ficha_ultima_voluntad.cod_parque~") COLUMN(NAME=~"ficha_ultima_voluntad.observacion~") COLUMN(NAME=~"ficha_ultima_voluntad.estado_reg~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"cliente.dv~") COLUMN(NAME=~"cliente.fono_p~") COLUMN(NAME=~"cliente.fono_c~") COLUMN(NAME=~"cliente.celular~") COLUMN(NAME=~"cliente.email~")    JOIN (LEFT=~"ficha_ultima_voluntad.rut~"    OP =~"=~"RIGHT=~"cliente.rut~" )WHERE(    EXP1 =~"~~~"FICHA_ULTIMA_VOLUNTAD~~~".~~~"RUT~~~"~"   OP =~"=~"    EXP2 =~":rut~" ) ) ARG(NAME = ~"rut~" TYPE = number) " update="FICHA_ULTIMA_VOLUNTAD" updatewhere=0 updatekeyinplace=yes arguments=(("rut", number))  sort="correlativo A " )
