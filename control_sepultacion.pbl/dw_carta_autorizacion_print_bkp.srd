 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ficha_carta_sepultacion~" )  TABLE(NAME=~"tipo_via~" ) COLUMN(NAME=~"ficha_carta_sepultacion.fecha_carta~") COLUMN(NAME=~"ficha_carta_sepultacion.nombre_titular~") COLUMN(NAME=~"ficha_carta_sepultacion.apellido_paterno_titular~") COLUMN(NAME=~"ficha_carta_sepultacion.apellido_materno_titular~") COLUMN(NAME=~"ficha_carta_sepultacion.rut_titular~") COLUMN(NAME=~"ficha_carta_sepultacion.dv_titular~") COLUMN(NAME=~"ficha_carta_sepultacion.direccion_titular~") COLUMN(NAME=~"ficha_carta_sepultacion.numero_direccion_titular~") COLUMN(NAME=~"ficha_carta_sepultacion.depto_direccion_titular~") COLUMN(NAME=~"ficha_carta_sepultacion.block_direccion_titular~") COLUMN(NAME=~"ficha_carta_sepultacion.poblacion_villa_titular~") COLUMN(NAME=~"ficha_carta_sepultacion.sector_titular~") COLUMN(NAME=~"ficha_carta_sepultacion.sector~") COLUMN(NAME=~"ficha_carta_sepultacion.sepultura~") COLUMN(NAME=~"ficha_carta_sepultacion.numero_tecnico~") COLUMN(NAME=~"ficha_carta_sepultacion.capacidad~") COLUMN(NAME=~"ficha_carta_sepultacion.nombre_fallecido~") COLUMN(NAME=~"ficha_carta_sepultacion.apellido_paterno_fall~") COLUMN(NAME=~"ficha_carta_sepultacion.apellido_materno_fall~") COLUMN(NAME=~"ficha_carta_sepultacion.fecha_sepultacion~") COLUMN(NAME=~"ficha_carta_sepultacion.hora_sepultacion~") COLUMN(NAME=~"ficha_carta_sepultacion.minuto_sepultacion~") COLUMN(NAME=~"ficha_carta_sepultacion.codigo_funeraria~") COLUMN(NAME=~"ficha_carta_sepultacion.folio~") COLUMN(NAME=~"ficha_carta_sepultacion.base~") COLUMN(NAME=~"ficha_carta_sepultacion.serie~") COLUMN(NAME=~"ficha_carta_sepultacion.numero~") COLUMN(NAME=~"ficha_carta_sepultacion.rut_fallecido~") COLUMN(NAME=~"ficha_carta_sepultacion.dv_fallecido~") COLUMN(NAME=~"ficha_carta_sepultacion.correlativo~") COLUMN(NAME=~"ficha_carta_sepultacion.cod_parque~") COLUMN(NAME=~"ficha_carta_sepultacion.estado_reg~") COLUMN(NAME=~"ficha_carta_sepultacion.tipo_ficha~") COLUMN(NAME=~"tipo_via.descripcion~")    JOIN (LEFT=~"ficha_carta_sepultacion.tipo_via_titular~"    OP =~"=~"RIGHT=~"tipo_via.tipo_via~" )WHERE(    EXP1 =~"~~~"FICHA_CARTA_SEPULTACION~~~".~~~"FECHA_SEPULTACION~~~"~"   OP =~"=~"    EXP2 =~":fec_sepult~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FICHA_CARTA_SEPULTACION~~~".~~~"SECTOR~~~"~"   OP =~"=~"    EXP2 =~":sector~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FICHA_CARTA_SEPULTACION~~~".~~~"SEPULTURA~~~"~"   OP =~"=~"    EXP2 =~":sepult~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FICHA_CARTA_SEPULTACION~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FICHA_CARTA_SEPULTACION~~~".~~~"CORRELATIVO~~~"~"   OP =~"=~"    EXP2 =~":corr~" ) ) ARG(NAME = ~"sector~" TYPE = string)  ARG(NAME = ~"sepult~" TYPE = string)  ARG(NAME = ~"fec_sepult~" TYPE = datetime)  ARG(NAME = ~"parque~" TYPE = number)  ARG(NAME = ~"corr~" TYPE = number) " update="FICHA_CARTA_SEPULTACION" updatewhere=0 updatekeyinplace=yes arguments=(("sector", string),("sepult", string),("fec_sepult", datetime),("parque", number),("corr", number)) )
