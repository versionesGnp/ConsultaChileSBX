compute(band=detail alignment="3" expression="'El propietario autoriza y confiere mandato a ADMINISTRADORA DEL PRADO Y LA FORESTA SpA para que proceda a realizar todas las acciones en el terreno donde se emplaza la sepultura, que sean necesarias para proceder la inhumación de los restos antes referidos, especialmente le autoriza para que en caso que sea necesario profundizar la sepultura para la inhumación, proceda a retirar y volver a colocar los restos que existieran con anterioridad en la sepultura, liberándola al efecto de toda responsabilidad civil por la manipulación que deberá efectuar de los restos existentes.'"border="0" color="0" x="69" y="2304" height="704" width="3223" format="[GENERAL]" html.valueishtml="0"  name=compute_3 visible="1"  font.face="Arial" font.height="-12" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" background.transparency="0" background.gradient.color="8421504" background.gradient.transparency="0" background.gradient.angle="0" background.brushmode="0" background.gradient.repetition.mode="0" background.gradient.repetition.count="0" background.gradient.repetition.length="100" background.gradient.focus="0" background.gradient.scale="100" background.gradient.spread="100" tooltip.backcolor="134217752" tooltip.delay.initial="0" tooltip.delay.visible="32000" tooltip.enabled="0" tooltip.hasclosebutton="0" tooltip.icon="0" tooltip.isbubble="0" tooltip.maxwidth="0" tooltip.textcolor="134217751" tooltip.transparency="0" transparency="0" )
