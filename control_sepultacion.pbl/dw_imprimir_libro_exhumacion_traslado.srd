o.cod_enfermedad_4~") COLUMN(NAME=~"ficha_registro.cod_enfermedad_5~") COLUMN(NAME=~"ficha_registro.cod_parque~") COLUMN(NAME=~"ficha_registro.destino_parque~") COLUMN(NAME=~"ficha_registro.cod_parque_destino~") COLUMN(NAME=~"cod_parq.nombre~") COLUMN(NAME=~"ficha_traslado.sector_origen~") COLUMN(NAME=~"ficha_traslado.sepultura_origen~") COLUMN(NAME=~"ficha_traslado.numero_tecnico_origen~") COLUMN(NAME=~"ficha_traslado.capacidad_origen~")    JOIN (LEFT=~"ficha_registro.cod_parque_destino~"    OP =~"=~"RIGHT=~"cod_parq.codigo~"    OUTER1 =~"ficha_registro.cod_parque_destino~" )    JOIN (LEFT=~"ficha_registro.correlativo_mensual~"    OP =~"=~"RIGHT=~"ficha_traslado.correlativo_mensual~"    OUTER1 =~"ficha_registro.correlativo_mensual~" )    JOIN (LEFT=~"ficha_registro.correlativo_anual~"    OP =~"=~"RIGHT=~"ficha_traslado.correlativo_anual~"    OUTER1 =~"ficha_registro.correlativo_anual~" )    JOIN (LEFT=~"ficha_registro.nombre_fallecido~"    OP =~"=~"RIGHT=~"ficha_traslado.nombre_fallecido~"    OUTER1 =~"ficha_registro.nombre_fallecido~" )    JOIN (LEFT=~"ficha_registro.ap_pat_fallecido~"    OP =~"=~"RIGHT=~"ficha_traslado.apellido_paterno_fall~"    OUTER1 =~"ficha_registro.ap_pat_fallecido~" )    JOIN (LEFT=~"ficha_registro.ap_mat_fallecido~"    OP =~"=~"RIGHT=~"ficha_traslado.apellido_materno_fall~"    OUTER1 =~"ficha_registro.ap_mat_fallecido~" )    JOIN (LEFT=~"ficha_registro.fecha_sepultacion~"    OP =~"=~"RIGHT=~"ficha_traslado.fecha_traslado~"    OUTER1 =~"ficha_registro.fecha_sepultacion~" )    JOIN (LEFT=~"ficha_registro.cod_parque~"    OP =~"=~"RIGHT=~"ficha_traslado.cod_parque~"    OUTER1 =~"ficha_registro.cod_parque~" )WHERE(    EXP1 =~"(~~~"FICHA_REGISTRO~~~".~~~"ESTADO_REG~~~"~"   OP =~"=~"    EXP2 =~"'P'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"FICHA_REGISTRO~~~".~~~"ESTADO_REG~~~"~"   OP =~"=~"    EXP2 =~"'G')~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FICHA_REGISTRO~~~".~~~"CORRELATIVO_ANUAL~~~"~"   OP =~">~"    EXP2 =~"0~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"((~~~"FICHA_REGISTRO~~~".~~~"TIPO_FICHA~~~"~"   OP =~"=~"    EXP2 =~"'FT'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FICHA_REGISTRO~~~".~~~"TIPO_OPERACION_TRASLADO~~~"~"   OP =~"=~"    EXP2 =~"'TI')~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"(~~~"FICHA_REGISTRO~~~".~~~"TIPO_FICHA~~~"~"   OP =~"=~"    EXP2 =~"'FT'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FICHA_REGISTRO~~~".~~~"TIPO_OPERACION_TRASLADO~~~"~"   OP =~"=~"    EXP2 =~"'IN'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FICHA_REGISTRO~~~".~~~"DESTINO_PARQUE~~~"~"   OP =~"=~"    EXP2 =~"'S'))~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FICHA_REGISTRO~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~" ) ) ARG(NAME = ~"parque~" TYPE = number) " arguments=(("parque", number))  sort="correlativo_anual A correlativo_mensual A " )
