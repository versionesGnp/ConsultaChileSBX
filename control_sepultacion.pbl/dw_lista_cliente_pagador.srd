 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cliente_pagador~" ) COLUMN(NAME=~"cliente_pagador.base~") COLUMN(NAME=~"cliente_pagador.serie~") COLUMN(NAME=~"cliente_pagador.numero~") COLUMN(NAME=~"cliente_pagador.rut_titular~") COLUMN(NAME=~"cliente_pagador.dv_titular~") COLUMN(NAME=~"cliente_pagador.rut_pagador~") COLUMN(NAME=~"cliente_pagador.dv_rut~") COLUMN(NAME=~"cliente_pagador.nombres_pagador~") COLUMN(NAME=~"cliente_pagador.apellido_p_pagador~") COLUMN(NAME=~"cliente_pagador.apellido_m_pagador~") COLUMN(NAME=~"cliente_pagador.tipo_via~") COLUMN(NAME=~"cliente_pagador.direccion~") COLUMN(NAME=~"cliente_pagador.numero_particular~") COLUMN(NAME=~"cliente_pagador.block_particular~") COLUMN(NAME=~"cliente_pagador.poblacion~") COLUMN(NAME=~"cliente_pagador.sector~") COLUMN(NAME=~"cliente_pagador.comuna~") COLUMN(NAME=~"cliente_pagador.ciudad~") COLUMN(NAME=~"cliente_pagador.fono_particular~") COLUMN(NAME=~"cliente_pagador.celular~") COLUMN(NAME=~"cliente_pagador.observacion~") COLUMN(NAME=~"cliente_pagador.correlativo_ingreso~") COLUMN(NAME=~"cliente_pagador.fecha_sistema~") COLUMN(NAME=~"cliente_pagador.parentesco~") COLUMN(NAME=~"cliente_pagador.email~") COLUMN(NAME=~"cliente_pagador.depto_pagador~")WHERE(    EXP1 =~"~~~"CLIENTE_PAGADOR~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":as_base~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CLIENTE_PAGADOR~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":as_serie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"CLIENTE_PAGADOR~~~".~~~"NUMERO~~~"~"   OP =~"=~"    EXP2 =~":al_numero~" ) ) ARG(NAME = ~"as_base~" TYPE = string)  ARG(NAME = ~"as_serie~" TYPE = string)  ARG(NAME = ~"al_numero~" TYPE = number) " update="CLIENTE_PAGADOR" updatewhere=1 updatekeyinplace=no arguments=(("as_base", string),("as_serie", string),("al_numero", number))  sort="fecha_sistema A " )
