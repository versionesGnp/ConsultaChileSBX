text(band=summary alignment="2" text=""border="0" color="0" x="307" y="32" height="81" width="2698"  name=titulo  font.face="Arial" font.height="-12" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
text(band=summary alignment="0" text="Nro. Ofertas :"border="2" color="0" x="737" y="208" height="81" width="1770"  font.face="Arial" font.height="-12" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="12632256" )
text(band=summary alignment="0" text="Facturado :"border="2" color="0" x="737" y="300" height="81" width="1770"  name=facturado_t  font.face="Arial" font.height="-12" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="12632256" )
text(band=summary alignment="0" text="Capital :"border="2" color="0" x="737" y="392" height="81" width="1770"  name=capital_t  font.face="Arial" font.height="-12" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="12632256" )
text(band=summary alignment="0" text="Interes :"border="2" color="0" x="737" y="484" height="81" width="1770"  name=interes_t  font.face="Arial" font.height="-12" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="12632256" )
text(band=summary alignment="0" text="Gastos de Cobranza :"border="2" color="0" x="737" y="576" height="81" width="1770"  name=gc_t  font.face="Arial" font.height="-12" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="12632256" )
compute(band=summary alignment="1" expression="sum(  gc  for all )"border="2" color="0" x="1715" y="576" height="81" width="791" format="###,###,###,###"  name=s_gc  font.face="Arial" font.height="-12" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127" )
compute(band=summary alignment="1" expression="sum(  interes  for all )"border="2" color="0" x="1715" y="484" height="81" width="791" format="###,###,###,###"  name=s_interes  font.face="Arial" font.height="-12" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127" )
compute(band=summary alignment="1" expression=" s_facturado -  s_interes -  s_gc "border="2" color="0" x="1715" y="392" height="81" width="791" format="###,###,###,###"  font.face="Arial" font.height="-12" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127" )
compute(band=summary alignment="1" expression="sum(  facturado  for all )"border="2" color="0" x="1715" y="300" height="81" width="791" format="###,###,###,###"  name=s_facturado  font.face="Arial" font.height="-12" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127" )
compute(band=summary alignment="1" expression="rowcount()"border="2" color="0" x="1715" y="208" height="81" width="791" format="[general]"  font.face="Arial" font.height="-12" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127" )
compute(band=footer alignment="2" expression="'Pagina ' + page() + ' de ' + pageCount()"border="0" color="0" x="1125" y="4" height="81" width="1061" format="[general]"  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
