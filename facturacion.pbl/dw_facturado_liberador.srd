release 5;
datawindow(units=0 timer_interval=60000 color=16777215 processing=0 print.documentname="" print.orientation = 2 print.margin.left = 257 print.margin.right = 110 print.margin.top = 201 print.margin.bottom = 97 print.paper.source = 0 print.paper.size = 0 print.prompt=no )
header(height=729 color="536870912" )
summary(height=721 color="536870912" )
footer(height=89 color="536870912" )
detail(height=1 color="536870912" )
table(column=(type=decimal(4) updatewhereclause=yes name=facturado dbname="factura_oferta.facturado" )
 column=(type=decimal(4) updatewhereclause=yes name=interes dbname="factura_oferta.interes" )
 column=(type=decimal(4) updatewhereclause=yes name=gc dbname="factura_oferta.gc" )
 column=(type=decimal(4) updatewhereclause=yes name=capital dbname="factura_oferta.capital" )
 column=(type=decimal(4) updatewhereclause=yes name=saldo_total dbname="factura_oferta.saldo_total" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"factura_oferta~" ) COLUMN(NAME=~"factura_oferta.facturado~") COLUMN(NAME=~"factura_oferta.interes~") COLUMN(NAME=~"factura_oferta.gc~") COLUMN(NAME=~"factura_oferta.capital~") COLUMN(NAME=~"factura_oferta.saldo_total~")WHERE(    EXP1 =~"~~~"FACTURA_OFERTA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'N'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FACTURA_OFERTA~~~".~~~"FECHA_CIERRE~~~"~"   OP =~"=~"    EXP2 =~":fecha~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FACTURA_OFERTA~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~"'L'~" ) ) ARG(NAME = ~"fecha~" TYPE = date) " arguments=(("fecha", date)) )
compute(band=header alignment="1" expression="today()"border="0" color="0" x="2291" y="12" height="85" width="732" format="dd/mm/yyyy hh:mm"  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
column(band=detail id=3 alignment="1" tabsequence=32766 border="2" color="0" x="1084" y="52" height="65" width="517" format="[General]"  name=gc edit.limit=0 edit.case=any edit.autoselect=yes edit.autohscroll=yes  font.face="Arial" font.height="-10" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" )
