global type f_primera_facturacion from function_object
end type

forward prototypes
global function date f_primera_facturacion (string base, string serie, long numero)
end prototypes

global function date f_primera_facturacion (string base, string serie, long numero);datetime fecha_cierre
  
  SELECT "FACTURA_OFERTA"."FECHA_CIERRE"  
    INTO :fecha_cierre  
    FROM "FACTURA_OFERTA"  
   WHERE ( "FACTURA_OFERTA"."BASE" = :base ) AND  
         ( "FACTURA_OFERTA"."SERIE" = :serie ) AND  
         ( "FACTURA_OFERTA"."NUMERO" = :numero ) AND  
         ( "FACTURA_OFERTA"."ESTADO" = 'N' )   
           ;
return date(fecha_cierre)
end function

