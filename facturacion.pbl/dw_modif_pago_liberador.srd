 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"pago_liberador~" )  TABLE(NAME=~"anexo_liberador~" ) COLUMN(NAME=~"pago_liberador.serie_m~") COLUMN(NAME=~"pago_liberador.nro_liberador~") COLUMN(NAME=~"pago_liberador.fecha~") COLUMN(NAME=~"pago_liberador.pie~") COLUMN(NAME=~"pago_liberador.tasa~") COLUMN(NAME=~"pago_liberador.valor_cuota~") COLUMN(NAME=~"pago_liberador.nro_cuotas~") COLUMN(NAME=~"pago_liberador.uf_dia~") COLUMN(NAME=~"pago_liberador.moneda~") COLUMN(NAME=~"pago_liberador.fecha_prim~") COLUMN(NAME=~"pago_liberador.fecha_ult~") COLUMN(NAME=~"pago_liberador.gastos_adm~") COLUMN(NAME=~"pago_liberador.folio~") COLUMN(NAME=~"pago_liberador.precio~") COLUMN(NAME=~"pago_liberador.pie_pagado~") COLUMN(NAME=~"pago_liberador.fecha_pie~") COLUMN(NAME=~"pago_liberador.fecha_mod~") COLUMN(NAME=~"pago_liberador.modificado~")    JOIN (LEFT=~"pago_liberador.serie_m~"    OP =~"=~"RIGHT=~"anexo_liberador.serie_m~" )    JOIN (LEFT=~"pago_liberador.nro_liberador~"    OP =~"=~"RIGHT=~"anexo_liberador.nro_liberador~" )    JOIN (LEFT=~"pago_liberador.folio~"    OP =~"=~"RIGHT=~"anexo_liberador.ult_folio~" )WHERE(    EXP1 =~"~~~"ANEXO_LIBERADOR~~~".~~~"SERIE_M~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"ANEXO_LIBERADOR~~~".~~~"NRO_LIBERADOR~~~"~"   OP =~"=~"    EXP2 =~":numero~" ) ) ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number) " update="PAGO_LIBERADOR" updatewhere=1 updatekeyinplace=yes arguments=(("serie", string),("numero", number)) )
