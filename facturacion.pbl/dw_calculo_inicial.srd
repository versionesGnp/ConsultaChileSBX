 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"factura_oferta~" )  TABLE(NAME=~"oferta_v~" )  TABLE(NAME=~"pago_oferta~" ) COLUMN(NAME=~"factura_oferta.base~") COLUMN(NAME=~"factura_oferta.serie~") COLUMN(NAME=~"factura_oferta.numero~") COLUMN(NAME=~"factura_oferta.plazo~") COLUMN(NAME=~"factura_oferta.valor_cta~") COLUMN(NAME=~"factura_oferta.estado~") COLUMN(NAME=~"factura_oferta.fecha_cierre~") COLUMN(NAME=~"pago_oferta.tasa~") COLUMN(NAME=~"pago_oferta.moneda~") COLUMN(NAME=~"pago_oferta.gastos_adm~") COLUMN(NAME=~"factura_oferta.valor_uf~") COLUMN(NAME=~"factura_oferta.facturado~") COLUMN(NAME=~"pago_oferta.precio~") COLUMN(NAME=~"factura_oferta.pie_pagado~")    JOIN (LEFT=~"oferta_v.serie~"    OP =~"=~"RIGHT=~"pago_oferta.serie~" )    JOIN (LEFT=~"oferta_v.nro_oferta~"    OP =~"=~"RIGHT=~"pago_oferta.nro_oferta~" )    JOIN (LEFT=~"oferta_v.ult_folio~"    OP =~"=~"RIGHT=~"pago_oferta.folio~" )    JOIN (LEFT=~"factura_oferta.serie~"    OP =~"=~"RIGHT=~"oferta_v.serie~" )    JOIN (LEFT=~"factura_oferta.numero~"    OP =~"=~"RIGHT=~"oferta_v.nro_oferta~" )WHERE(    EXP1 =~"~~~"FACTURA_OFERTA~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~"'O'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"FACTURA_OFERTA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'R'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"FACTURA_OFERTA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'N'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"FACTURA_OFERTA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'S')~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"FACTURA_OFERTA~~~".~~~"FECHA_CIERRE~~~"~"   OP =~"=~"    EXP2 =~":fecha~" ) ) ORDER(NAME=~"factura_oferta.fecha_cierre~" ASC=yes )  ORDER(NAME=~"factura_oferta.base~" ASC=yes )  ORDER(NAME=~"factura_oferta.serie~" ASC=yes )  ORDER(NAME=~"factura_oferta.numero~" ASC=yes )  ORDER(NAME=~"factura_oferta.estado~" ASC=yes ) ARG(NAME = ~"fecha~" TYPE = date) " arguments=(("fecha", date)) )
