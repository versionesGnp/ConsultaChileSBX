 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"factura_oferta_dv~" )  TABLE(NAME=~"factura_oferta_dv_m~" ) COLUMN(NAME=~"factura_oferta_dv.base~") COLUMN(NAME=~"factura_oferta_dv.serie~") COLUMN(NAME=~"factura_oferta_dv.numero~") COLUMN(NAME=~"factura_oferta_dv.fec_ofe~") COLUMN(NAME=~"factura_oferta_dv.mora~") COLUMN(NAME=~"factura_oferta_dv.saldo_total~") COLUMN(NAME=~"factura_oferta_dv.saldo_cp~") COLUMN(NAME=~"factura_oferta_dv.saldo_lp~") COLUMN(NAME=~"factura_oferta_dv.capital~") COLUMN(NAME=~"factura_oferta_dv.capital_cp~") COLUMN(NAME=~"factura_oferta_dv.capital_lp~") COLUMN(NAME=~"factura_oferta_dv.interes~") COLUMN(NAME=~"factura_oferta_dv.interes_cp~") COLUMN(NAME=~"factura_oferta_dv.interes_lp~") COLUMN(NAME=~"factura_oferta_dv.gc~") COLUMN(NAME=~"factura_oferta_dv.gc_cp~") COLUMN(NAME=~"factura_oferta_dv.gc_lp~") COLUMN(NAME=~"factura_oferta_dv.fecha_prim~") COLUMN(NAME=~"factura_oferta_dv.ctas_pag~") COLUMN(NAME=~"factura_oferta_dv.plazo~") COLUMN(NAME=~"factura_oferta_dv.monto_mora~") COLUMN(NAME=~"factura_oferta_dv.pie~") COLUMN(NAME=~"factura_oferta_dv.valor_cta~") COLUMN(NAME=~"factura_oferta_dv.facturado~") COLUMN(NAME=~"factura_oferta_dv.fecha_uf~") COLUMN(NAME=~"factura_oferta_dv.fecha_cierre~") COLUMN(NAME=~"factura_oferta_dv.moneda~") COLUMN(NAME=~"factura_oferta_dv.valor_uf~") COLUMN(NAME=~"factura_oferta_dv_m.saldo_total~") COLUMN(NAME=~"factura_oferta_dv_m.saldo_cp~") COLUMN(NAME=~"factura_oferta_dv_m.saldo_lp~") COLUMN(NAME=~"factura_oferta_dv_m.capital~") COLUMN(NAME=~"factura_oferta_dv_m.capital_cp~") COLUMN(NAME=~"factura_oferta_dv_m.capital_lp~") COLUMN(NAME=~"factura_oferta_dv_m.interes~") COLUMN(NAME=~"factura_oferta_dv_m.interes_cp~") COLUMN(NAME=~"factura_oferta_dv_m.interes_lp~") COLUMN(NAME=~"factura_oferta_dv_m.gc~") COLUMN(NAME=~"factura_oferta_dv_m.gc_cp~") COLUMN(NAME=~"factura_oferta_dv_m.gc_lp~")    JOIN (LEFT=~"factura_oferta_dv.base~"    OP =~"=~"RIGHT=~"factura_oferta_dv_m.base~" )    JOIN (LEFT=~"factura_oferta_dv.serie~"    OP =~"=~"RIGHT=~"factura_oferta_dv_m.serie~" )    JOIN (LEFT=~"factura_oferta_dv.numero~"    OP =~"=~"RIGHT=~"factura_oferta_dv_m.numero~" )WHERE(    EXP1 =~"~~~"FACTURA_OFERTA_DV~~~".~~~"FECHA_CIERRE~~~"~"   OP =~"=~"    EXP2 =~":fecha~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FACTURA_OFERTA_DV~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~"'A'~" ) ) ARG(NAME = ~"fecha~" TYPE = date) " arguments=(("fecha", date)) )
