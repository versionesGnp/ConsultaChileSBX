 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"factura_oferta~" )  TABLE(NAME=~"pago_liberador~" ) COLUMN(NAME=~"factura_oferta.base~") COLUMN(NAME=~"factura_oferta.serie~") COLUMN(NAME=~"factura_oferta.numero~") COLUMN(NAME=~"factura_oferta.mora~") COLUMN(NAME=~"factura_oferta.ctas_pag~") COLUMN(NAME=~"factura_oferta.valor_cta~") COLUMN(NAME=~"factura_oferta.fecha_cierre~") COMPUTE(NAME=~"0~")    JOIN (LEFT=~"factura_oferta.serie~"    OP =~"=~"RIGHT=~"pago_liberador.serie_m~" )    JOIN (LEFT=~"factura_oferta.numero~"    OP =~"=~"RIGHT=~"pago_liberador.nro_liberador~" )WHERE(    EXP1 =~"( ~~~"FACTURA_OFERTA~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~"'L' )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"FACTURA_OFERTA~~~".~~~"CTAS_PAG~~~"+~~~"FACTURA_OFERTA~~~".~~~"MORA~~~"~"   OP =~">~"    EXP2 =~"0 )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"FACTURA_OFERTA~~~".~~~"PLAZO~~~"-(~~~"FACTURA_OFERTA~~~".~~~"CTAS_PAG~~~"+~~~"FACTURA_OFERTA~~~".~~~"MORA~~~")~"   OP =~">~"    EXP2 =~"0)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"FACTURA_OFERTA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'S')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"FACTURA_OFERTA~~~".~~~"FECHA_CIERRE~~~"~"   OP =~">=~"    EXP2 =~":fecha~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FACTURA_OFERTA~~~".~~~"FECHA_CIERRE~~~"~"   OP =~"<=~"    EXP2 =~":fecha1)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"PAGO_LIBERADOR~~~".~~~"FECHA~~~"~"   OP =~"<=~"    EXP2 =~"TO_DATE('30-Apr-1999 00:00:00','DD-MON-YY HH24:MI:SS')~" ) )    UNION (PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"factura_oferta~" )  TABLE(NAME=~"pago_liberador~" ) COLUMN(NAME=~"factura_oferta.base~") COLUMN(NAME=~"factura_oferta.serie~") COLUMN(NAME=~"factura_oferta.numero~") COLUMN(NAME=~"factura_oferta.mora~") COLUMN(NAME=~"factura_oferta.ctas_pag~") COLUMN(NAME=~"factura_oferta.valor_cta~") COLUMN(NAME=~"factura_oferta.fecha_cierre~") COMPUTE(NAME=~"0~")    JOIN (LEFT=~"factura_oferta.serie~"    OP =~"=~"RIGHT=~"pago_liberador.serie_m~" )    JOIN (LEFT=~"factura_oferta.numero~"    OP =~"=~"RIGHT=~"pago_liberador.nro_liberador~" )WHERE(    EXP1 =~"~~~"FACTURA_OFERTA~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~"'L'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"FACTURA_OFERTA~~~".~~~"CTAS_PAG~~~"+~~~"FACTURA_OFERTA~~~".~~~"MORA~~~"~"   OP =~">~"    EXP2 =~"0)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"FACTURA_OFERTA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'N')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"FACTURA_OFERTA~~~".~~~"FECHA_CIERRE~~~"~"   OP =~">=~"    EXP2 =~":fecha~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FACTURA_OFERTA~~~".~~~"FECHA_CIERRE~~~"~"   OP =~"<=~"    EXP2 =~":fecha1)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"PAGO_LIBERADOR~~~".~~~"FECHA~~~"~"   OP =~"<=~"    EXP2 =~"TO_DATE('30-Apr-1999 00:00:00','DD-MON-YY HH24:MI:SS')~" ) )) ORDER(NAME=~"7~" ASC=yes ) ARG(NAME = ~"fecha~" TYPE = date)  ARG(NAME = ~"fecha1~" TYPE = date) " arguments=(("fecha", date),("fecha1", date)) )
