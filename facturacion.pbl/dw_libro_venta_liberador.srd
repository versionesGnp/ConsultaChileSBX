table(column=(type=char(1) updatewhereclause=yes name=factura_oferta_base dbname="factura_oferta.base" )
 column=(type=char(1) updatewhereclause=yes name=factura_oferta_serie dbname="factura_oferta.serie" )
 column=(type=decimal(4) updatewhereclause=yes name=factura_oferta_numero dbname="factura_oferta.numero" )
 column=(type=decimal(4) updatewhereclause=yes name=cliente_rut dbname="cliente.rut" )
 column=(type=char(20) updatewhereclause=yes name=cliente_nombre dbname="cliente.nombre" )
 column=(type=char(15) updatewhereclause=yes name=cliente_a_paterno dbname="cliente.a_paterno" )
 column=(type=char(15) updatewhereclause=yes name=cliente_a_materno dbname="cliente.a_materno" )
 column=(type=decimal(4) updatewhereclause=yes name=factura_oferta_facturado dbname="factura_oferta.facturado" )
 column=(type=char(1) updatewhereclause=yes name=cliente_dv dbname="cliente.dv" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"anexo_liberador~" )  TABLE(NAME=~"cliente~" )  TABLE(NAME=~"factura_oferta~" ) COLUMN(NAME=~"factura_oferta.base~") COLUMN(NAME=~"factura_oferta.serie~") COLUMN(NAME=~"factura_oferta.numero~") COLUMN(NAME=~"cliente.rut~") COLUMN(NAME=~"cliente.nombre~") COLUMN(NAME=~"cliente.a_paterno~") COLUMN(NAME=~"cliente.a_materno~") COLUMN(NAME=~"factura_oferta.facturado~") COLUMN(NAME=~"cliente.dv~")    JOIN (LEFT=~"anexo_liberador.serie_m~"    OP =~"=~"RIGHT=~"factura_oferta.serie~" )    JOIN (LEFT=~"anexo_liberador.nro_liberador~"    OP =~"=~"RIGHT=~"factura_oferta.numero~" )    JOIN (LEFT=~"cliente.rut~"    OP =~"=~"RIGHT=~"anexo_liberador.rut~" )WHERE(    EXP1 =~"( ( ~~~"FACTURA_OFERTA~~~".~~~"FECHA_CIERRE~~~"~"   OP =~"=~"    EXP2 =~":fecha )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"FACTURA_OFERTA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'N' )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"FACTURA_OFERTA~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~"'L' ) )~" ) ) ARG(NAME = ~"fecha~" TYPE = date) " arguments=(("fecha", date)) )
