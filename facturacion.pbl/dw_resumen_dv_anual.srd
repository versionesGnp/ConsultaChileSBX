 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"factura_oferta~" ) COLUMN(NAME=~"factura_oferta.base~") COLUMN(NAME=~"factura_oferta.serie~") COLUMN(NAME=~"factura_oferta.numero~") COLUMN(NAME=~"factura_oferta.mora~") COLUMN(NAME=~"factura_oferta.ctas_pag~") COLUMN(NAME=~"factura_oferta.valor_cta~") COLUMN(NAME=~"factura_oferta.fecha_cierre~") COMPUTE(NAME=~"0~") COLUMN(NAME=~"factura_oferta.cod_parque~")WHERE(    EXP1 =~"( ~~~"FACTURA_OFERTA~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~"'O' )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"FACTURA_OFERTA~~~".~~~"CTAS_PAG~~~"+~~~"FACTURA_OFERTA~~~".~~~"MORA~~~"~"   OP =~">~"    EXP2 =~"0 )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"FACTURA_OFERTA~~~".~~~"PLAZO~~~"-(~~~"FACTURA_OFERTA~~~".~~~"CTAS_PAG~~~"+~~~"FACTURA_OFERTA~~~".~~~"MORA~~~")~"   OP =~">~"    EXP2 =~"0)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"FACTURA_OFERTA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'S')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"FACTURA_OFERTA~~~".~~~"FECHA_CIERRE~~~"~"   OP =~">=~"    EXP2 =~":fecha~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FACTURA_OFERTA~~~".~~~"FECHA_CIERRE~~~"~"   OP =~"<=~"    EXP2 =~":fecha1)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FACTURA_OFERTA~~~".~~~"COD_PARQUE~~~"~"   OP =~"=~"    EXP2 =~":parque~" ) )    UNION (PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"factura_oferta~" ) COLUMN(NAME=~"factura_oferta.base~") COLUMN(NAME=~"factura_oferta.serie~") COLUMN(NAME=~"factura_oferta.numero~") COLUMN(NAME=~"factura_oferta.mora~") COLUMN(NAME=~"factura_oferta.ctas_pag~") COLUMN(NAME=~"factura_oferta.valor_cta~") COLUMN(NAME=~"factura_oferta.fecha_cierre~") COMPUTE(NAME=~"0~") COLUMN(NAME=~"factura_oferta.cod_parque~")WHERE(    EXP1 =~"(~~~"FACTURA_OFERTA~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~"'O')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"FACTURA_OFERTA~~~".~~~"CTAS_PAG~~~"+~~~"FACTURA_OFERTA~~~".~~~"MORA~~~"~"   OP =~">~"    EXP2 =~"0)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"FACTURA_OFERTA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'N')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"FACTURA_OFERTA~~~".~~~"FECHA_CIERRE~~~"~"   OP =~">=~"    EXP2 =~":fecha~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FACTURA_OFERTA~~~".~~~"FECHA_CIERRE~~~"~"   OP =~"<=~"    EXP2 =~":fecha1)~" ) )) ORDER(NAME=~"7~" ASC=yes ) ARG(NAME = ~"fecha~" TYPE = date)  ARG(NAME = ~"fecha1~" TYPE = date)  ARG(NAME = ~"parque~" TYPE = number) " arguments=(("fecha", date),("fecha1", date),("parque", number)) )
