 retrieve="  SELECT ~"ANEXO_AUMENTO~".~"SERIE_M~",   
         ~"ANEXO_AUMENTO~".~"NRO_AUMENTO~",   
         ~"ANEXO_AUMENTO~".~"CTA_PAG_M~",   
         ~"ANEXO_AUMENTO~".~"ESTADO_COMI~",   
         ~"ANEXO_AUMENTO~".~"PORCE_SUP~",   
         ~"ANEXO_AUMENTO~".~"PORCE_AGE~",   
         ~"PAGO_AUMENTO~".~"PRECIO~",   
         ~"PAGO_AUMENTO~".~"PIE~",   
         ~"PAGO_AUMENTO~".~"TASA~",   
         ~"PAGO_AUMENTO~".~"VALOR_CUOTA~",   
         ~"PAGO_AUMENTO~".~"NRO_CUOTAS~",   
         ~"PAGO_AUMENTO~".~"UF_DIA~",   
         ~"PAGO_AUMENTO~".~"MONEDA~",   
         ~"PAGO_AUMENTO~".~"FECHA_PRIM~",   
         ~"PAGO_AUMENTO~".~"FECHA_ULT~",   
         ~"PAGO_AUMENTO~".~"GASTOS_ADM~",   
         ~"CADENA~".~"ESTADO~",   
         ~"PAGO_AUMENTO~".~"FECHA~"  
    FROM ~"ANEXO_AUMENTO~",   
         ~"CADENA~",   
         ~"PAGO_AUMENTO~"  
   WHERE ( ~"ANEXO_AUMENTO~".~"SERIE_M~" = ~"PAGO_AUMENTO~".~"SERIE_M~" ) and  
         ( ~"ANEXO_AUMENTO~".~"NRO_AUMENTO~" = ~"PAGO_AUMENTO~".~"NRO_AUMENTO~" ) and  
         ( ~"ANEXO_AUMENTO~".~"ULT_FOLIO~" = ~"PAGO_AUMENTO~".~"FOLIO~" ) and  
         ( ~"PAGO_AUMENTO~".~"SERIE_M~" = ~"CADENA~".~"SERIE~" ) and  
         ( ~"PAGO_AUMENTO~".~"NRO_AUMENTO~" = ~"CADENA~".~"NUMERO~" ) and  
         ((~"CADENA~".~"ESTADO~" = 'N') OR  
         (~"CADENA~".~"ESTADO~" = 'R') OR  
         (~"CADENA~".~"ESTADO~" = 'P')) AND  
         (~"CADENA~".~"ESTADO_CONTABLE~" <> 'C') AND  
         ~"ANEXO_AUMENTO~".~"NRO_RESC~" = 99 AND  
         ~"PAGO_AUMENTO~".~"TASA~" <> 0 AND  
         ~"CADENA~".~"CODIGO~" = 'A'    " )
