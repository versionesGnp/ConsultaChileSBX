 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cadena~" )  TABLE(NAME=~"pagare~" ) COLUMN(NAME=~"cadena.codigo~") COLUMN(NAME=~"cadena.serie~") COLUMN(NAME=~"cadena.numero~") COLUMN(NAME=~"pagare.fecha_prim~") COLUMN(NAME=~"pagare.cta_pag_la~") COLUMN(NAME=~"pagare.cta_pag_isa~") COLUMN(NAME=~"pagare.valor_cuo~") COLUMN(NAME=~"pagare.plazo~") COLUMN(NAME=~"pagare.tasa~") COLUMN(NAME=~"pagare.pie_pagado~") COLUMN(NAME=~"pagare.moneda~") COLUMN(NAME=~"pagare.fecha~") COLUMN(NAME=~"pagare.fechas_ingreso~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"pagare.parque~") COLUMN(NAME=~"pagare.pie~")    JOIN (LEFT=~"cadena.serie~"    OP =~"=~"RIGHT=~"pagare.serie_p~" )    JOIN (LEFT=~"cadena.numero~"    OP =~"=~"RIGHT=~"pagare.nro_pagare~" )WHERE(    EXP1 =~"( ( ~~~"CADENA~~~".~~~"CODIGO~~~"~"   OP =~"=~"    EXP2 =~"'P' )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"CADENA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'P'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'R'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'D'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"ESTADO~~~"~"   OP =~"=~"    EXP2 =~"'A')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"CADENA~~~".~~~"ESTADO_CONTABLE~~~"~"   OP =~"=~"    EXP2 =~"'A' )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"PAGARE~~~".~~~"ESTADO_CREDITO~~~"~"   OP =~"=~"    EXP2 =~"0~" ) ) ORDER(NAME=~"cadena.codigo~" ASC=yes )  ORDER(NAME=~"cadena.serie~" ASC=yes )  ORDER(NAME=~"cadena.numero~" ASC=yes ) " )
