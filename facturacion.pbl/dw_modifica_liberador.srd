 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"anexo_liberador~" )  TABLE(NAME=~"cadena~" )  TABLE(NAME=~"factura_oferta~" )  TABLE(NAME=~"pago_liberador~" ) COLUMN(NAME=~"anexo_liberador.serie_m~") COLUMN(NAME=~"anexo_liberador.nro_liberador~") COLUMN(NAME=~"pago_liberador.fecha~") COLUMN(NAME=~"anexo_liberador.cta_pag_m~") COLUMN(NAME=~"anexo_liberador.estado_comi~") COLUMN(NAME=~"anexo_liberador.porce_age~") COLUMN(NAME=~"anexo_liberador.porce_sup~") COLUMN(NAME=~"pago_liberador.precio~") COLUMN(NAME=~"pago_liberador.pie~") COLUMN(NAME=~"pago_liberador.tasa~") COLUMN(NAME=~"pago_liberador.valor_cuota~") COLUMN(NAME=~"pago_liberador.nro_cuotas~") COLUMN(NAME=~"pago_liberador.uf_dia~") COLUMN(NAME=~"pago_liberador.moneda~") COLUMN(NAME=~"pago_liberador.fecha_prim~") COLUMN(NAME=~"pago_liberador.fecha_ult~") COLUMN(NAME=~"pago_liberador.gastos_adm~") COLUMN(NAME=~"cadena.estado~") COLUMN(NAME=~"factura_oferta.base~") COLUMN(NAME=~"factura_oferta.serie~") COLUMN(NAME=~"factura_oferta.numero~")    JOIN (LEFT=~"anexo_liberador.serie_m~"    OP =~"=~"RIGHT=~"pago_liberador.serie_m~" )    JOIN (LEFT=~"anexo_liberador.nro_liberador~"    OP =~"=~"RIGHT=~"pago_liberador.nro_liberador~" )    JOIN (LEFT=~"anexo_liberador.ult_folio~"    OP =~"=~"RIGHT=~"pago_liberador.folio~" )    JOIN (LEFT=~"pago_liberador.serie_m~"    OP =~"=~"RIGHT=~"cadena.serie~" )    JOIN (LEFT=~"pago_liberador.nro_liberador~"    OP =~"=~"RIGHT=~"cadena.numero~" )    JOIN (LEFT=~"anexo_liberador.serie_m~"    OP =~"=~"RIGHT=~"factura_oferta.serie~" )    JOIN (LEFT=~"anexo_liberador.nro_liberador~"    OP =~"=~"RIGHT=~"factura_oferta.numero~" )WHERE(    EXP1 =~"~~~"FACTURA_OFERTA~~~".~~~"FECHA_CIERRE~~~"~"   OP =~"=~"    EXP2 =~":fecha~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"FACTURA_OFERTA~~~".~~~"BASE~~~"~"   OP =~"=~"    EXP2 =~":base~" ) ) ARG(NAME = ~"fecha~" TYPE = date)  ARG(NAME = ~"base~" TYPE = string) " arguments=(("fecha", date),("base", string)) )
