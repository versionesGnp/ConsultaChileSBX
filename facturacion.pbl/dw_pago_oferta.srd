 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"pago_oferta~" )  TABLE(NAME=~"oferta_v~" ) COLUMN(NAME=~"pago_oferta.serie~") COLUMN(NAME=~"pago_oferta.nro_oferta~") COLUMN(NAME=~"pago_oferta.precio~") COLUMN(NAME=~"pago_oferta.pie~") COLUMN(NAME=~"pago_oferta.tasa~") COLUMN(NAME=~"pago_oferta.valor_cuota~") COLUMN(NAME=~"pago_oferta.nro_cuotas~") COLUMN(NAME=~"pago_oferta.uf_dia~") COLUMN(NAME=~"pago_oferta.moneda~") COLUMN(NAME=~"pago_oferta.fecha_prim~") COLUMN(NAME=~"pago_oferta.fecha_ult~") COLUMN(NAME=~"pago_oferta.gastos_adm~") COLUMN(NAME=~"pago_oferta.sepultura~") COLUMN(NAME=~"pago_oferta.derecho_lib~") COLUMN(NAME=~"pago_oferta.factura~") COLUMN(NAME=~"pago_oferta.fecha_fact~") COLUMN(NAME=~"pago_oferta.total_fact~") COLUMN(NAME=~"pago_oferta.carta_bienv~") COLUMN(NAME=~"pago_oferta.pie_pagado~") COLUMN(NAME=~"pago_oferta.nro_tecnico~") COLUMN(NAME=~"pago_oferta.fecha~") COLUMN(NAME=~"pago_oferta.folio~") COLUMN(NAME=~"pago_oferta.capacidad~") COLUMN(NAME=~"pago_oferta.n_reduccion~") COLUMN(NAME=~"pago_oferta.des_esp~") COLUMN(NAME=~"pago_oferta.fecha_entre~") COLUMN(NAME=~"pago_oferta.fecha_pie~") COLUMN(NAME=~"pago_oferta.modificado~") COLUMN(NAME=~"pago_oferta.fecha_mod~") COLUMN(NAME=~"pago_oferta.area~") COLUMN(NAME=~"pago_oferta.parque~") COLUMN(NAME=~"pago_oferta.sector~")    JOIN (LEFT=~"pago_oferta.serie~"    OP =~"=~"RIGHT=~"oferta_v.serie~" )    JOIN (LEFT=~"pago_oferta.nro_oferta~"    OP =~"=~"RIGHT=~"oferta_v.nro_oferta~" )    JOIN (LEFT=~"pago_oferta.folio~"    OP =~"=~"RIGHT=~"oferta_v.ult_folio~" )WHERE(    EXP1 =~"~~~"OFERTA_V~~~".~~~"SERIE~~~"~"   OP =~"=~"    EXP2 =~":serie~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"OFERTA_V~~~".~~~"NRO_OFERTA~~~"~"   OP =~"=~"    EXP2 =~":numero~" ) ) ARG(NAME = ~"serie~" TYPE = string)  ARG(NAME = ~"numero~" TYPE = number) " update="PAGO_OFERTA" updatewhere=1 updatekeyinplace=yes arguments=(("serie", string),("numero", number)) )
